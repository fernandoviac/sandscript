    (local.set $saved_index (global.get $proof_current_declaration_index))
    (global.set $proof_current_universe_context
      (call $proof_array_get (local.get $b) (local.get $s) (i32.const 7)))
    (local.set $empty (call $proof_make_array (local.get $b) (i32.const 0)))
    (if (i32.eqz (local.get $empty)) (then
      (global.set $proof_current_universe_context (local.get $saved_scope))
      (global.set $proof_current_declaration_index (local.get $saved_index))
      (return (i32.const 0))))
    (local.set $i (i32.const 0))
    (block $checked_done (loop $checked_next
      (br_if $checked_done (i32.ge_u (local.get $i) (local.get $m)))
      (global.set $proof_current_declaration_index (call $proof_array_get (local.get $b)
        (call $proof_array_get (local.get $b) (local.get $s) (i32.const 8)) (local.get $i)))
