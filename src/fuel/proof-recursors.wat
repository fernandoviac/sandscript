          (call $proof_array_get (local.get $b) (local.get $ctors) (local.get $i)) (i32.const 8)))
        (local.get $empty) (i32.const 0) (i32.const 0) (local.get $work)))
      (if (i32.eqz (local.get $t)) (then (return (i32.const 0))))
      (local.set $t (call $proof_weak_head_normalize (local.get $b) (local.get $t)
        (local.get $empty) (i32.const 0) (i32.const 0) (local.get $work)))
      (if (i32.eqz (local.get $t)) (then (return (i32.const 0))))
      (if (i32.ne (call $proof_load (local.get $b) (i32.add (local.get $t) (i32.const 4))) (global.get $PROOF_TERM_SORT))
        (then (return (i32.const 0))))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $next)))
    (i32.const 1))

  ;; Generalizing a builder's family universes changes the independently
  ;; bound recursor universe telescope. Rebuild only the new suffix; imported
  ;; declarations retain their exact references and every declaration index
  ;; stays fixed. Failure leaves the artifact header and all old arrays intact.
  (func $proof_regenerate_new_recursors
    (param $b i32) (param $first_new i32) (param $work i32) (result i32)
    (local $old i32) (local $out i32) (local $count i32) (local $i i32)
    (local $d i32) (local $group i32) (local $s i32) (local $j i32)
    (local $m i32) (local $owner i32) (local $index i32) (local $generated i32)
    (local.set $old (call $proof_load (local.get $b) (i32.const 12)))
    (local.set $count (call $proof_array_count (local.get $b) (local.get $old)))
    (if (i32.gt_u (local.get $first_new) (local.get $count))
      (then (return (i32.const 0))))
    (local.set $i (local.get $first_new))
    (block $done (loop $next
      (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
      (if (i32.eqz (call $proof_work_debit (local.get $b) (local.get $work)))
        (then (return (i32.const 0))))
      (local.set $d (call $proof_array_get (local.get $b) (local.get $old) (local.get $i)))
      (if (i32.eq
        (call $proof_load (local.get $b) (i32.add (local.get $d) (i32.const 4)))
        (global.get $PROOF_RECORD_INDUCTIVE_DECLARATION)) (then
        (local.set $group
          (call $proof_load (local.get $b) (i32.add (local.get $d) (i32.const 28))))
        (if (i32.eq
          (call $proof_array_get (local.get $b) (local.get $group) (i32.const 0))
          (local.get $i)) (then
          (local.set $s
            (call $proof_rec_state (local.get $b) (local.get $group) (i32.const -1) (local.get $work)))
          (if (i32.eqz (local.get $s)) (then (return (i32.const 0))))
          (if (i32.eqz (local.get $out)) (then
            (local.set $out (call $proof_make_array (local.get $b) (local.get $count)))
            (if (i32.eqz (local.get $out)) (then (return (i32.const 0))))
            (call $proof_copy_bytes (local.get $b)
              (i32.add (local.get $out) (i32.const 12))
              (i32.add (local.get $old) (i32.const 12))
              (i32.mul (local.get $count) (i32.const 4)))))
          (local.set $m (call $proof_array_count (local.get $b) (local.get $group)))
          (local.set $j (i32.const 0))
          (block $members_done (loop $members_next
            (br_if $members_done (i32.ge_u (local.get $j) (local.get $m)))
            (local.set $owner (call $proof_array_get (local.get $b) (local.get $group) (local.get $j)))
            (local.set $index (call $proof_find_recursor (local.get $b) (local.get $owner)))
            (if (i32.or
              (i32.lt_u (local.get $owner) (local.get $first_new))
              (i32.or (i32.lt_s (local.get $index) (i32.const 0))
                (i32.lt_u (local.get $index) (local.get $first_new))))
              (then (return (i32.const 0))))
            (local.set $generated
              (call $proof_rec_declaration (local.get $b) (local.get $s) (local.get $j) (local.get $work)))
            (if (i32.eqz (local.get $generated)) (then (return (i32.const 0))))
            (call $proof_array_set (local.get $b) (local.get $out) (local.get $index) (local.get $generated))
            (local.set $j (i32.add (local.get $j) (i32.const 1))) (br $members_next)))))))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $next)))
    (if (i32.eqz (local.get $out)) (then (return (local.get $old))))
    (call $proof_store (local.get $b) (i32.const 12) (local.get $out))
    (local.get $out))
