        (local.get $empty) (i32.const 0) (i32.const 0) (local.get $work)))
      (if (local.get $type) (then
        (local.set $type (call $proof_weak_head_normalize (local.get $b) (local.get $type)
          (local.get $empty) (i32.const 0) (i32.const 0) (local.get $work)))))
      (if (i32.or (i32.eqz (local.get $type))
        (i32.ne (call $proof_load (local.get $b) (i32.add (local.get $type) (i32.const 4))) (global.get $PROOF_TERM_SORT)))
        (then (br $checked_done)))
