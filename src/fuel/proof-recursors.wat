    (local $expected i32) (local $actual i32) (local $rules i32) (local $rule i32)
    (local $empty i32) (local $type i32) (local $saved_scope i32) (local $saved_index i32)
    (local.set $owner (call $proof_load (local.get $b) (i32.add (local.get $d) (i32.const 16))))
    (if (i32.ge_u (local.get $owner) (local.get $index)) (then (return (i32.const 0))))
    (local.set $family (call $proof_declaration_reference (local.get $b) (local.get $owner)))
    (if (i32.ne (call $proof_load (local.get $b) (i32.add (local.get $family) (i32.const 4)))
      (global.get $PROOF_RECORD_INDUCTIVE_DECLARATION)) (then (return (i32.const 0))))
    (local.set $group (call $proof_load (local.get $b) (i32.add (local.get $family) (i32.const 28))))
