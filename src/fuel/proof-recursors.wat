    ;; group members have matched independently generated graphs.
    (block $graphs_done (loop $graphs_next
      (br_if $graphs_done (i32.ge_u (local.get $i) (local.get $m)))
      (local.set $expected (call $proof_rec_declaration (local.get $b) (local.get $s) (local.get $i) (local.get $work)))
      (local.set $actual (call $proof_declaration_reference (local.get $b)
