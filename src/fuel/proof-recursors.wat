  ;; Adapted for SandScript by DevBlanket AB, 2026.
  ;; Lean src/kernel/inductive.cpp: mk_rec_infos, mk_rec_rules, check_recursors,
  ;; init_K_target; revision 6a10ac8c22beadecabdbb0919c2b50214762f91d.
  ;; Binder annotation consumption follows Lean src/Lean/Expr.lean,
  ;; consumeTypeAnnotations, at the same revision.
  ;;
  ;; Generation uses de Bruijn telescopes, never assumptions or exported rules.
  ;; State slots: group, parameter count, motive count, minor count, prefix
  ;; domains, family levels, recursor levels, universe context, recursor indices,
  ;; motive sort, shared work. All generated references live in the proof arena.

  (func $proof_rec_bound (param $b i32) (param $n i32) (result i32)
    (call $proof_make_one (local.get $b) (global.get $PROOF_TERM_BOUND) (local.get $n)))

  (func $proof_rec_apply (param $b i32) (param $f i32) (param $x i32) (result i32)
    (if (i32.or (i32.eqz (local.get $f)) (i32.eqz (local.get $x)))
      (then (return (i32.const 0))))
    (call $proof_make_two (local.get $b) (global.get $PROOF_TERM_APPLICATION)
      (local.get $f) (local.get $x)))

  (func $proof_rec_drop_products (param $b i32) (param $t i32) (param $n i32) (result i32)
    (block $done (loop $next
      (br_if $done (i32.eqz (local.get $n)))
      (if (i32.ne (call $proof_load (local.get $b) (i32.add (local.get $t) (i32.const 4)))
        (global.get $PROOF_TERM_PRODUCT)) (then (return (i32.const 0))))
      (local.set $t (call $proof_load (local.get $b) (i32.add (local.get $t) (i32.const 12))))
      (local.set $n (i32.sub (local.get $n) (i32.const 1)))
      (br $next)))
    (local.get $t))

  ;; Apply variables at absolute binder positions [start,start+count), where
  ;; depth is the complete surrounding telescope length.
  (func $proof_rec_apply_vars
    (param $b i32) (param $t i32) (param $depth i32) (param $start i32) (param $count i32)
    (result i32) (local $i i32)
    (block $done (loop $next
      (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
      (local.set $t (call $proof_rec_apply (local.get $b) (local.get $t)
        (call $proof_rec_bound (local.get $b)
          (i32.sub (i32.sub (local.get $depth) (i32.add (local.get $start) (local.get $i))) (i32.const 1)))))
      (if (i32.eqz (local.get $t)) (then (return (i32.const 0))))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $next)))
    (local.get $t))

  ;; Lean consumes only head annotations when introducing a telescope local;
  ;; it does not normalize arbitrary aliases or descend beneath other terms.
  ;; This changes generated syntax, not reduction authority: the resulting
  ;; recursor type and rules still pass the ordinary typed checks.
  (func $proof_rec_consume_type_annotations
    (param $b i32) (param $t i32) (result i32)
    (local $head i32) (local $target i32) (local $arity i32)
    (local $tag i32) (local $decl i32) (local $name i32) (local $ctors i32)
    (loop $next
      (if (i32.ne (call $proof_load (local.get $b) (i32.add (local.get $t) (i32.const 4)))
        (global.get $PROOF_TERM_APPLICATION)) (then (return (local.get $t))))
      (local.set $head (call $proof_load (local.get $b) (i32.add (local.get $t) (i32.const 8))))
      (local.set $target (call $proof_load (local.get $b) (i32.add (local.get $t) (i32.const 12))))
      (local.set $arity (i32.const 1))
      (if (i32.eq (call $proof_load (local.get $b) (i32.add (local.get $head) (i32.const 4)))
        (global.get $PROOF_TERM_APPLICATION))
        (then
          (local.set $target (call $proof_load (local.get $b) (i32.add (local.get $head) (i32.const 12))))
          (local.set $head (call $proof_load (local.get $b) (i32.add (local.get $head) (i32.const 8))))
          (local.set $arity (i32.const 2))))
      (local.set $tag (call $proof_load (local.get $b) (i32.add (local.get $head) (i32.const 4))))
      (if (i32.or (i32.lt_u (local.get $tag) (global.get $PROOF_TERM_GLOBAL))
        (i32.gt_u (local.get $tag) (global.get $PROOF_TERM_CONSTRUCTOR)))
        (then (return (local.get $t))))
      (local.set $decl (call $proof_declaration_reference (local.get $b)
        (call $proof_load (local.get $b) (i32.add (local.get $head) (i32.const 8)))))
      (if (i32.eqz (local.get $decl)) (then (return (local.get $t))))
      (if (i32.eq (local.get $tag) (global.get $PROOF_TERM_CONSTRUCTOR))
        (then
          (local.set $ctors (call $proof_load (local.get $b) (i32.add (local.get $decl) (i32.const 24))))
          (local.set $decl (call $proof_array_get (local.get $b) (local.get $ctors)
            (call $proof_load (local.get $b) (i32.add (local.get $head) (i32.const 12)))))))
      (local.set $name (call $proof_declaration_name (local.get $b) (local.get $decl)))
      (if (i32.eqz (local.get $name)) (then (return (local.get $t))))
      (if (call $proof_load (local.get $b) (i32.add (local.get $name) (i32.const 8)))
        (then (return (local.get $t))))
      (if (i32.eq (local.get $arity) (i32.const 1))
        (then
          (if (i32.eqz (i32.or
            (call $proof_name_segment_matches (local.get $b) (local.get $name) (i32.const 8)
              (i32.const 0x5074756f) (i32.const 0x6d617261) (i32.const 0))
            (call $proof_name_segment_matches (local.get $b) (local.get $name) (i32.const 12)
              (i32.const 0x696d6573) (i32.const 0x5074754f) (i32.const 0x6d617261))))
            (then (return (local.get $t)))))
        (else
          (if (i32.eqz (i32.or
            (call $proof_name_segment_matches (local.get $b) (local.get $name) (i32.const 8)
              (i32.const 0x5074706f) (i32.const 0x6d617261) (i32.const 0))
            (call $proof_name_segment_matches (local.get $b) (local.get $name) (i32.const 9)
              (i32.const 0x6f747561) (i32.const 0x61726150) (i32.const 0x0000006d))))
            (then (return (local.get $t))))))
      (local.set $t (local.get $target))
      (br $next))
    (local.get $t))

  (func $proof_rec_wrap
    (param $b i32) (param $domains i32) (param $n i32) (param $t i32) (param $tag i32)
    (result i32)
    (block $done (loop $next
      (br_if $done (i32.eqz (local.get $n)))
      (local.set $n (i32.sub (local.get $n) (i32.const 1)))
      (local.set $t (call $proof_make_two (local.get $b) (local.get $tag)
        (call $proof_rec_consume_type_annotations (local.get $b)
          (call $proof_array_get (local.get $b) (local.get $domains) (local.get $n))) (local.get $t)))
      (if (i32.eqz (local.get $t)) (then (return (i32.const 0)))) (br $next)))
    (local.get $t))

  (func $proof_rec_group_position (param $b i32) (param $group i32) (param $owner i32)
    (result i32) (local $i i32)
    (block $done (loop $next
      (br_if $done (i32.ge_u (local.get $i) (call $proof_array_count (local.get $b) (local.get $group))))
      (if (i32.eq (call $proof_array_get (local.get $b) (local.get $group) (local.get $i)) (local.get $owner))
        (then (return (local.get $i))))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $next)))
    (i32.const -1))

  (func $proof_find_recursor (param $b i32) (param $owner i32) (result i32)
    (local $ds i32) (local $d i32) (local $group i32) (local $position i32)
    (local $count i32) (local $index i32)
    (local.set $ds (call $proof_load (local.get $b) (i32.const 12)))
    (local.set $count (call $proof_array_count (local.get $b) (local.get $ds)))
    (if (i32.ge_u (local.get $owner) (local.get $count)) (then (return (i32.const -1))))
    (local.set $d (call $proof_array_get (local.get $b) (local.get $ds) (local.get $owner)))
    (if (i32.ne (call $proof_load (local.get $b) (i32.add (local.get $d) (i32.const 4)))
      (global.get $PROOF_RECORD_INDUCTIVE_DECLARATION)) (then (return (i32.const -1))))
    (local.set $group (call $proof_load (local.get $b) (i32.add (local.get $d) (i32.const 28))))
    (local.set $position (call $proof_rec_group_position (local.get $b) (local.get $group) (local.get $owner)))
    (if (i32.lt_s (local.get $position) (i32.const 0)) (then (return (i32.const -1))))
    (local.set $index (i32.add (i32.add
      (call $proof_array_get (local.get $b) (local.get $group) (i32.const 0))
      (call $proof_array_count (local.get $b) (local.get $group))) (local.get $position)))
    (if (i32.ge_u (local.get $index) (local.get $count)) (then (return (i32.const -1))))
    (local.set $d (call $proof_array_get (local.get $b) (local.get $ds) (local.get $index)))
    (if (i32.or
      (i32.ne (call $proof_load (local.get $b) (i32.add (local.get $d) (i32.const 4)))
        (global.get $PROOF_RECORD_RECURSOR_DECLARATION))
      (i32.ne (call $proof_load (local.get $b) (i32.add (local.get $d) (i32.const 16))) (local.get $owner)))
      (then (return (i32.const -1))))
    (local.get $index))

  ;; Motive type at prefix depth params+extra. Original family indices remain
  ;; bound while the newly inserted motives/minors shift only the parameters.
  (func $proof_rec_motive
    (param $b i32) (param $s i32) (param $owner i32) (param $extra i32) (param $work i32) (result i32)
    (local $d i32) (local $p i32) (local $n i32) (local $t i32)
    (local $domains i32) (local $i i32) (local $major i32)
    (local.set $d (call $proof_declaration_reference (local.get $b) (local.get $owner)))
    (local.set $p (call $proof_array_get (local.get $b) (local.get $s) (i32.const 1)))
    (local.set $n (call $proof_load (local.get $b) (i32.add (local.get $d) (i32.const 20))))
    (local.set $t (call $proof_instantiate_term_universes (local.get $b)
      (call $proof_load (local.get $b) (i32.add (local.get $d) (i32.const 12)))
      (call $proof_array_get (local.get $b) (local.get $s) (i32.const 5)) (local.get $work)))
    (local.set $t (call $proof_rec_drop_products (local.get $b) (local.get $t) (local.get $p)))
    (local.set $t (call $proof_shift (local.get $b) (local.get $t) (local.get $extra) (i32.const 0) (i32.const 0)))
    (local.set $domains (call $proof_make_array (local.get $b) (local.get $n)))
    (if (i32.or (i32.eqz (local.get $t)) (i32.eqz (local.get $domains))) (then (return (i32.const 0))))
    (block $done (loop $next
      (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
      (call $proof_array_set (local.get $b) (local.get $domains) (local.get $i)
        (call $proof_load (local.get $b) (i32.add (local.get $t) (i32.const 8))))
      (local.set $t (call $proof_load (local.get $b) (i32.add (local.get $t) (i32.const 12))))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $next)))
    (local.set $major (call $proof_make_two (local.get $b) (global.get $PROOF_TERM_INDUCTIVE)
      (local.get $owner) (call $proof_array_get (local.get $b) (local.get $s) (i32.const 5))))
    (local.set $major (call $proof_rec_apply_vars (local.get $b) (local.get $major)
      (i32.add (i32.add (local.get $p) (local.get $extra)) (local.get $n)) (i32.const 0) (local.get $p)))
    (local.set $major (call $proof_rec_apply_vars (local.get $b) (local.get $major)
      (local.get $n) (i32.const 0) (local.get $n)))
    (local.set $t (call $proof_make_two (local.get $b) (global.get $PROOF_TERM_PRODUCT)
      (local.get $major) (call $proof_array_get (local.get $b) (local.get $s) (i32.const 9))))
    (call $proof_rec_wrap (local.get $b) (local.get $domains) (local.get $n) (local.get $t)
      (global.get $PROOF_TERM_PRODUCT)))

  ;; Apply the family's motive to the indices of a checked family application
  ;; and its inhabitant. Both input terms live at the supplied prefix depth.
  (func $proof_rec_motive_application
    (param $b i32) (param $s i32) (param $family i32) (param $value i32) (param $depth i32)
    (result i32) (local $head i32) (local $position i32) (local $p i32) (local $i i32) (local $t i32)
    (local.set $head (call $proof_application_head (local.get $b) (local.get $family)))
    (local.set $position (call $proof_rec_group_position (local.get $b)
      (call $proof_array_get (local.get $b) (local.get $s) (i32.const 0))
      (call $proof_load (local.get $b) (i32.add (local.get $head) (i32.const 8)))))
    (if (i32.or (i32.lt_s (local.get $position) (i32.const 0))
      (i32.ne (call $proof_load (local.get $b) (i32.add (local.get $head) (i32.const 4)))
        (global.get $PROOF_TERM_INDUCTIVE))) (then (return (i32.const 0))))
    (local.set $p (call $proof_array_get (local.get $b) (local.get $s) (i32.const 1)))
    (local.set $t (call $proof_rec_bound (local.get $b)
      (i32.sub (i32.sub (local.get $depth) (i32.add (local.get $p) (local.get $position))) (i32.const 1))))
    (local.set $i (local.get $p))
    (block $done (loop $next
      (br_if $done (i32.ge_u (local.get $i) (call $proof_application_count (local.get $b) (local.get $family))))
      (local.set $t (call $proof_rec_apply (local.get $b) (local.get $t)
        (call $proof_application_argument (local.get $b) (local.get $family) (local.get $i))))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $next)))
    (call $proof_rec_apply (local.get $b) (local.get $t) (local.get $value)))

  ;; An induction hypothesis, or its recursive proof, for a strictly positive
  ;; recursive field. Function-valued fields get a Pi/lambda over their domain.
  (func $proof_rec_hypothesis
    (param $b i32) (param $s i32) (param $type i32) (param $value i32)
    (param $depth i32) (param $rhs i32) (result i32)
    (local $n i32) (local $domains i32) (local $i i32) (local $t i32)
    (local $head i32) (local $pos i32) (local $p i32) (local $prefix i32)
    (local.set $n (call $proof_product_count (local.get $b) (local.get $type)))
    (local.set $domains (call $proof_make_array (local.get $b) (local.get $n)))
    (if (i32.eqz (local.get $domains)) (then (return (i32.const 0))))
    (block $done (loop $next
      (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
      (call $proof_array_set (local.get $b) (local.get $domains) (local.get $i)
        (call $proof_load (local.get $b) (i32.add (local.get $type) (i32.const 8))))
      (local.set $type (call $proof_load (local.get $b) (i32.add (local.get $type) (i32.const 12))))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $next)))
    (local.set $value (call $proof_shift (local.get $b) (local.get $value) (local.get $n) (i32.const 0) (i32.const 0)))
    (local.set $value (call $proof_rec_apply_vars (local.get $b) (local.get $value) (local.get $n) (i32.const 0) (local.get $n)))
    (local.set $depth (i32.add (local.get $depth) (local.get $n)))
    (if (local.get $rhs) (then
      (local.set $head (call $proof_application_head (local.get $b) (local.get $type)))
      (local.set $pos (call $proof_rec_group_position (local.get $b)
        (call $proof_array_get (local.get $b) (local.get $s) (i32.const 0))
        (call $proof_load (local.get $b) (i32.add (local.get $head) (i32.const 8)))))
      (if (i32.lt_s (local.get $pos) (i32.const 0)) (then (return (i32.const 0))))
      (local.set $t (call $proof_make_two (local.get $b) (global.get $PROOF_TERM_GLOBAL)
        (call $proof_array_get (local.get $b)
          (call $proof_array_get (local.get $b) (local.get $s) (i32.const 8)) (local.get $pos))
        (call $proof_array_get (local.get $b) (local.get $s) (i32.const 6))))
      (local.set $p (call $proof_array_get (local.get $b) (local.get $s) (i32.const 1)))
      (local.set $prefix (i32.add (local.get $p) (i32.add
        (call $proof_array_get (local.get $b) (local.get $s) (i32.const 2))
        (call $proof_array_get (local.get $b) (local.get $s) (i32.const 3)))))
      (local.set $t (call $proof_rec_apply_vars (local.get $b) (local.get $t) (local.get $depth) (i32.const 0) (local.get $prefix)))
      (local.set $i (local.get $p))
      (block $args_done (loop $args_next
        (br_if $args_done (i32.ge_u (local.get $i) (call $proof_application_count (local.get $b) (local.get $type))))
        (local.set $t (call $proof_rec_apply (local.get $b) (local.get $t)
          (call $proof_application_argument (local.get $b) (local.get $type) (local.get $i))))
        (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $args_next)))
      (local.set $t (call $proof_rec_apply (local.get $b) (local.get $t) (local.get $value))))
    (else (local.set $t (call $proof_rec_motive_application (local.get $b) (local.get $s)
      (local.get $type) (local.get $value) (local.get $depth)))))
    (call $proof_rec_wrap (local.get $b) (local.get $domains) (local.get $n) (local.get $t)
      (if (result i32) (local.get $rhs) (then (global.get $PROOF_TERM_LAMBDA)) (else (global.get $PROOF_TERM_PRODUCT)))))

  ;; mode 0: minor-premise type; 1: computation RHS; 2: required RHS type.
  ;; Prefix contains params, all motives, and either preceding or all minors.
  (func $proof_rec_constructor
    (param $b i32) (param $s i32) (param $owner i32) (param $ordinal i32)
    (param $minor i32) (param $mode i32) (param $work i32) (result i32)
    (local $d i32) (local $ctor i32) (local $t i32) (local $fields i32) (local $domains i32)
    (local $ihs i32) (local $ihcount i32) (local $i i32) (local $p i32) (local $m i32)
    (local $prefix i32) (local $depth i32) (local $domain i32) (local $value i32)
    (local $result i32) (local $ih i32) (local $group i32)
    (local.set $d (call $proof_declaration_reference (local.get $b) (local.get $owner)))
    (local.set $ctor (call $proof_array_get (local.get $b)
      (call $proof_load (local.get $b) (i32.add (local.get $d) (i32.const 24))) (local.get $ordinal)))
    (local.set $p (call $proof_array_get (local.get $b) (local.get $s) (i32.const 1)))
    (local.set $m (call $proof_array_get (local.get $b) (local.get $s) (i32.const 2)))
    (local.set $group (call $proof_array_get (local.get $b) (local.get $s) (i32.const 0)))
    (local.set $prefix (i32.add (i32.add (local.get $p) (local.get $m))
      (if (result i32) (local.get $mode)
        (then (call $proof_array_get (local.get $b) (local.get $s) (i32.const 3))) (else (local.get $minor)))))
    (local.set $t (call $proof_instantiate_term_universes (local.get $b)
      (call $proof_load (local.get $b) (i32.add (local.get $ctor) (i32.const 8)))
      (call $proof_array_get (local.get $b) (local.get $s) (i32.const 5)) (local.get $work)))
    (local.set $t (call $proof_rec_drop_products (local.get $b) (local.get $t) (local.get $p)))
    (local.set $t (call $proof_shift (local.get $b) (local.get $t) (i32.sub (local.get $prefix) (local.get $p)) (i32.const 0) (i32.const 0)))
    (local.set $fields (call $proof_product_count (local.get $b) (local.get $t)))
    (local.set $domains (call $proof_make_array (local.get $b) (local.get $fields)))
    (local.set $ihs (call $proof_make_array (local.get $b) (local.get $fields)))
    (if (i32.or (i32.eqz (local.get $domains)) (i32.eqz (local.get $ihs))) (then (return (i32.const 0))))
    (block $fields_done (loop $fields_next
      (br_if $fields_done (i32.ge_u (local.get $i) (local.get $fields)))
      (call $proof_array_set (local.get $b) (local.get $domains) (local.get $i)
        (call $proof_load (local.get $b) (i32.add (local.get $t) (i32.const 8))))
      (local.set $t (call $proof_load (local.get $b) (i32.add (local.get $t) (i32.const 12))))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $fields_next)))
    (local.set $depth (i32.add (local.get $prefix) (local.get $fields)))
    (if (i32.eq (local.get $mode) (i32.const 1))
      (then (local.set $result (call $proof_rec_bound (local.get $b)
        (i32.sub (i32.sub (local.get $depth) (i32.add (i32.add (local.get $p) (local.get $m)) (local.get $minor))) (i32.const 1))))
        (local.set $result (call $proof_rec_apply_vars (local.get $b) (local.get $result)
          (local.get $depth) (local.get $prefix) (local.get $fields))))
      (else
        (local.set $value (call $proof_make_three (local.get $b) (global.get $PROOF_TERM_CONSTRUCTOR)
          (local.get $owner) (local.get $ordinal) (call $proof_array_get (local.get $b) (local.get $s) (i32.const 5))))
        (local.set $value (call $proof_rec_apply_vars (local.get $b) (local.get $value)
          (local.get $depth) (i32.const 0) (local.get $p)))
        (local.set $value (call $proof_rec_apply_vars (local.get $b) (local.get $value)
