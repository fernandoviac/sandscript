    (local.set $ac (call $proof_array_count (local.get $a) (call $proof_load (local.get $a) (i32.const 12))))
    (local.set $bc (call $proof_array_count (local.get $b) (call $proof_load (local.get $b) (i32.const 12))))
    (local.set $chosen (i32.ge_u (local.get $ac) (local.get $bc)))
    (local.set $count (select (local.get $ac) (local.get $bc) (local.get $chosen)))
    (local.set $alen (call $proof_native_term_records_length (local.get $left)))
