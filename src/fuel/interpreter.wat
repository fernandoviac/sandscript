                            (i32.or
                              (i32.eq (local.get $result_type) (global.get $TYPE_BOOLEAN))
                              (i32.eq (local.get $result_type) (global.get $TYPE_STRING))))
                          (i32.or
                            (i32.or
                              (i32.eq (local.get $result_type) (global.get $TYPE_INTEGER))
                              (i32.eq (local.get $result_type) (global.get $TYPE_FLOAT)))
                            (i32.or
                              (i32.eq (local.get $result_type) (global.get $TYPE_BIGINT))
