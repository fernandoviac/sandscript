                            (if (call $check_heap_overflow
                                  (i32.add (call $estimate_scope_size) (global.get $FUNCTION_HEADER_SIZE)))
                              (then
                                (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                                (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                                (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                                (br $exit)))
                            ;; Holder scope: parent = the callback's captured
                            ;; scope, binding `this` = thisArg.
                            (local.set $new_scope (call $scope_create
                              (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 40))))))
                            (local.set $value_pointer4 (i32.add (local.get $value_pointer)
                              (i32.mul (i32.const 2) (global.get $VALUE_SIZE))))
                            (call $scope_define (local.get $new_scope)
                              (call $read_builtin (i32.const 0x18))   ;; BUILTIN_NAME.THIS
                              (call $value_type (local.get $value_pointer4))
                              (i32.load (call $abs (i32.add (local.get $value_pointer4) (i32.const 4))))
                              (call $value_data_lo (local.get $value_pointer4))
                              (call $value_data_hi (local.get $value_pointer4)))
