          (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 12))))
          (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 16)))))
      (then
        (if (call $check_heap_overflow
              (call $estimate_collection_grow_size
