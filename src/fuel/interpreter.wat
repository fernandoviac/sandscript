                      (i32.eq (local.get $opcode) (global.get $OP_CALL_METHOD))
                      (i32.or
                        (i32.or
                          (i32.eq (local.get $method_id) (global.get $METHOD_MAP))
                          (i32.eq (local.get $method_id) (global.get $METHOD_UINT8ARRAY_MAP)))
                        (i32.or
                          (i32.eq (local.get $method_id) (global.get $METHOD_FILTER))
                          (i32.eq (local.get $method_id) (global.get $METHOD_UINT8ARRAY_FILTER)))))
                  (then
                    (local.set $result_i32 (call $map_filter_method
                      (local.get $receiver_type) (local.get $receiver_pointer)
                      (local.get $method_id) (local.get $operand1) (local.get $value_pointer2)))
