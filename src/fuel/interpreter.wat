      (then
        (local.set $array_pointer (call $value_data_lo (local.get $argument1_pointer)))
        (local.set $val_lo (i32.load (call $abs (local.get $array_pointer))))
        (local.set $val_hi (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 4)))))
        (local.set $arr_len (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 8)))))
        (local.set $src_count (call $get_bytes_per_element (local.get $arg1_type)))
        (if (call $check_heap_overflow
              (i32.add
                (call $estimate_arraybuffer_size (i32.mul (local.get $arr_len) (local.get $bytes_per_element)))
                (call $estimate_typed_array_descriptor_size)))
          (then (return (i32.const 0))))
        (local.set $data_pointer (call $allocate_arraybuffer
          (i32.mul (local.get $arr_len) (local.get $bytes_per_element))))
        (local.set $source_pointer (call $abs (i32.add
          (i32.add (local.get $val_lo) (i32.const 4))
          (local.get $val_hi))))
        (local.set $dest (call $abs (i32.add (local.get $data_pointer) (i32.const 4))))
        (local.set $i (i32.const 0))
        (block $copy_done2
          (loop $copy_loop2
            (br_if $copy_done2 (i32.ge_u (local.get $i) (local.get $arr_len)))
            (if (i32.and
                  (i32.or
                    (i32.eq (local.get $val_type) (global.get $TYPE_BIGINT64ARRAY))
                    (i32.eq (local.get $val_type) (global.get $TYPE_BIGUINT64ARRAY)))
                  (i32.or
                    (i32.eq (local.get $arg1_type) (global.get $TYPE_BIGINT64ARRAY))
                    (i32.eq (local.get $arg1_type) (global.get $TYPE_BIGUINT64ARRAY))))
              (then
                (i64.store
                  (i32.add (local.get $dest) (i32.mul (local.get $i) (local.get $bytes_per_element)))
                  (i64.load
                    (i32.add (local.get $source_pointer) (i32.mul (local.get $i) (local.get $src_count))))))
              (else
                (local.set $result_f64 (call $read_typed_element
                  (local.get $arg1_type)
