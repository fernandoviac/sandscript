        (local.set $arg1_hi (i32.const 0))
      )
    )

    (local.set $i32_result (call $allocate_promise))
    (local.set $data_pointer (i32.add (local.get $i32_result) (global.get $GC_HEADER_SIZE)))
    (i32.store (call $abs (i32.add (local.get $data_pointer) (global.get $PROMISE_STATUS)))
      (global.get $PROMISE_STATUS_REJECTED))
    (i32.store (call $abs (i32.add (local.get $data_pointer) (i32.const 4)))
      (local.get $arg1_type))
    (i32.store (call $abs (i32.add (local.get $data_pointer) (i32.const 8)))
      (i32.const 0))
    (i32.store (call $abs (i32.add (local.get $data_pointer) (i32.const 12)))
      (local.get $arg1_lo))
    (i32.store (call $abs (i32.add (local.get $data_pointer) (i32.const 16)))
      (local.get $arg1_hi))

    (call $pending_push (global.get $TYPE_PROMISE) (i32.const 0) (local.get $i32_result) (i32.const 0))
    (return (i32.const 0))
  )

  ;; constructor_method_id_to_prototype(method_id) -> prototype pointer, or
  ;; 0 if method_id isn't a recognized built-in constructor / conversion
  ;; function id.
  ;;
  ;; Batch 20 (dispatch-table migration, task #10): extracted
  ;; from OP_INSTANCEOF's TYPE_CONSTRUCTOR sub-ladder in $run. The
  ;; error-throw-and-loop-control on an unrecognized id stays inline in
  ;; $run (it needs $exit/$loop, which aren't reachable from a called
  ;; function) — this helper only returns the resolved pointer or the 0
  ;; sentinel; the caller decides what "not found" means.
  (func $constructor_method_id_to_prototype
    (param $method_id i32)
    (result i32)
    (if (i32.eq (local.get $method_id) (global.get $METHOD_ARRAY_CONSTRUCTOR))
      (then (return (call $read_state (global.get $STATE_ARRAY_PROTOTYPE)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_OBJECT_CONSTRUCTOR))
      (then (return (call $read_state (global.get $STATE_OBJECT_PROTOTYPE)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_MAP_CONSTRUCTOR))
      (then (return (call $read_state (global.get $STATE_MAP_PROTOTYPE)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_SET_CONSTRUCTOR))
      (then (return (call $read_state (global.get $STATE_SET_PROTOTYPE)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_ERROR_CONSTRUCTOR))
      (then (return (call $read_state (global.get $STATE_ERROR_PROTOTYPE)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_TYPE_ERROR_CONSTRUCTOR))
      (then (return (call $read_state (global.get $STATE_TYPE_ERROR_PROTOTYPE)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_REFERENCE_ERROR_CONSTRUCTOR))
      (then (return (call $read_state (global.get $STATE_REFERENCE_ERROR_PROTOTYPE)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_RANGE_ERROR_CONSTRUCTOR))
      (then (return (call $read_state (global.get $STATE_RANGE_ERROR_PROTOTYPE)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_SYNTAX_ERROR_CONSTRUCTOR))
      (then (return (call $read_state (global.get $STATE_SYNTAX_ERROR_PROTOTYPE)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_FUNCTION_CONSTRUCTOR))
      (then (return (call $read_state (global.get $STATE_FUNCTION_PROTOTYPE)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_ARRAYBUFFER_CONSTRUCTOR))
      (then (return (call $read_state (global.get $STATE_ARRAYBUFFER_PROTOTYPE)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_UINT8ARRAY_CONSTRUCTOR))
      (then (return (call $read_state (global.get $STATE_UINT8ARRAY_PROTOTYPE)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_DATAVIEW_CONSTRUCTOR))
      (then (return (call $read_state (global.get $STATE_DATAVIEW_PROTOTYPE)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_TEXT_ENCODER_CONSTRUCTOR))
      (then (return (call $read_state (global.get $STATE_TEXT_ENCODER_PROTOTYPE)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_TEXT_DECODER_CONSTRUCTOR))
      (then (return (call $read_state (global.get $STATE_TEXT_DECODER_PROTOTYPE)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_REGEXP_CONSTRUCTOR))
      (then (return (call $read_state (global.get $STATE_REGEXP_PROTOTYPE)))))
    (if (i32.or
          (i32.eq (local.get $method_id) (global.get $METHOD_TO_STRING))
          (i32.or
            (i32.eq (local.get $method_id) (global.get $METHOD_TO_NUMBER))
            (i32.eq (local.get $method_id) (global.get $METHOD_TO_BOOLEAN))))
      (then (return (call $read_state (global.get $STATE_OBJECT_PROTOTYPE)))))
    (return (i32.const 0))
  )

  ;; foreach_method — indexed-collection callback entry.
  ;; A non-empty receiver publishes a native-continuation frame and its first
  ;; callback arguments, then returns STATUS_NATIVE_CONTINUATION_STAGED. $run
  ;; enters the callback from the frame; request scratch is not involved.
  (func $foreach_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $closure_pointer i32)
    (local $mp_addr i32)
    (local $mp_end i32)
    (local $array_pointer i32)
    (local $arr_len i32)
    (local $stack_pointer i32)
    (local $frame_pointer i32)
    (local $start_instr i32)
    (local $param_count i32)
    (local $data_pointer i32)
    (local $element_pointer i32)
    (local $float_result f64)
    (local $count i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))

    ;; Receiver-type validation (array, typed array, or msgpack array ref).
    (if (i32.and
          (i32.and
            (i32.ne (local.get $receiver_type) (global.get $TYPE_ARRAY))
            (i32.eqz (call $is_typed_array (local.get $receiver_type))))
          (i32.ne (i32.and (local.get $receiver_type) (i32.const 0xff)) (global.get $TYPE_MSGPACK_REF)))
      (then
        (call $set_error (global.get $ERR_TYPE_ERROR) (local.get $receiver_type))
        (return (i32.const 2))
      )
    )

    ;; Materialize msgpack array receivers to a heap array first.
    (if (i32.eq (i32.and (local.get $receiver_type) (i32.const 0xff)) (global.get $TYPE_MSGPACK_REF))
      (then
        (local.set $mp_addr
          (call $msgpack_ref_absolute
            (local.get $receiver_pointer)
            (i32.shr_u (local.get $receiver_type) (i32.const 8))))
        (local.set $mp_end
          (call $msgpack_ref_parent_end (local.get $receiver_pointer)))
        (if (i32.eq
              (call $msgpack_peek_type (local.get $mp_addr) (local.get $mp_end))
              (global.get $MSGPACK_ARRAY))
          (then
            (if (call $check_heap_overflow
                  (call $estimate_array_size (call $msgpack_scratch_count)))
              (then (return (i32.const 0))))
          )
        )
        (local.set $receiver_pointer
          (call $msgpack_to_array (local.get $mp_addr) (local.get $mp_end) (local.get $receiver_pointer)))
        (if (i32.eqz (local.get $receiver_pointer))
          (then
            (if (call $throw_from_set_error)
              (then (return (i32.const 2)))
              (else (return (i32.const 1)))
            )
          )
        )
        (local.set $receiver_type (global.get $TYPE_ARRAY))
      )
    )

    (if (i32.lt_u (local.get $argc) (i32.const 1))
      (then
        (call $set_error (global.get $ERR_ARITY) (i32.const 1))
        (return (i32.const 2))
      )
    )

    (local.set $closure_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
    (if (i32.ne (call $value_type (local.get $closure_pointer)) (global.get $TYPE_FUNCTION))
      (then
        (if (call $throw_type_error_with_type (global.get $BUILTIN_MSG_NOT_A_FUNCTION) (i32.const 0))
          (then (return (i32.const 2)))
          (else (return (i32.const 1)))
        )
      )
    )
    (local.set $closure_pointer (call $value_data_lo (local.get $closure_pointer)))

    (local.set $array_pointer (local.get $receiver_pointer))
    (local.set $arr_len (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 8)))))

    (if (i32.eqz (local.get $arr_len))
      (then
        (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
        (call $pending_push (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))
        (return (i32.const 0))
      )
    )

    ;; Non-empty: push the iteration frame.
    (local.set $stack_pointer (call $read_ctx (global.get $CTX_CALL_STACK_POINTER)))
    (local.set $frame_pointer (call $abs (local.get $stack_pointer)))
    ;; $callback_staged_argc takes the closure HEADER pointer (it does
    ;; its own +FUNCTION_CLOSURE_OFFSET dereference internally) — pass
    ;; $closure_pointer, not the already-dereferenced instruction index.
    (local.set $param_count (call $callback_staged_argc (local.get $closure_pointer) (i32.const 3)))
    (local.set $start_instr (i32.load (call $abs (i32.add (local.get $closure_pointer) (global.get $FUNCTION_CLOSURE_OFFSET)))))

    (if (call $check_heap_overflow
          (global.get $NATIVE_CONTINUATION_STATE_SIZE))
      (then (return (i32.const 0))))
    (call $publish_native_continuation_frame
      (local.get $frame_pointer) (local.get $stack_pointer)
      (local.get $stack_base) (i32.const 1) (local.get $param_count)
      (i32.const 0) (local.get $arr_len) (i32.const 0)
      (call $continuation_kind_from_callback_method (local.get $method_id))
      (local.get $array_pointer) (local.get $closure_pointer)
      (local.get $receiver_type) (i32.const 0))

    ;; Push callback args for element 0 (only as many as declared).
    (if (call $is_uint8array_callback_method (local.get $method_id))
      (then
        (local.set $data_pointer (i32.load (call $abs (local.get $array_pointer))))
        (local.set $count (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 4)))))
        (local.set $element_pointer (i32.add
          (i32.add (local.get $data_pointer) (i32.const 4))
          (local.get $count)))
        (local.set $float_result
          (call $read_typed_element
            (local.get $receiver_type)
            (call $abs (local.get $element_pointer))))
        (if (i32.ge_u (local.get $param_count) (i32.const 1))
          (then (call $push_f64 (local.get $float_result))))
        (if (i32.ge_u (local.get $param_count) (i32.const 2))
          (then (call $push_f64 (f64.const 0))))
        (if (i32.ge_u (local.get $param_count) (i32.const 3))
          (then (call $pending_push (local.get $receiver_type) (i32.const 0) (local.get $array_pointer) (i32.const 0))))
      )
      (else
        (local.set $data_pointer (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 16)))))
        (local.set $element_pointer (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE)))
        (if (i32.ge_u (local.get $param_count) (i32.const 1))
          (then
            (call $pending_push
              (call $value_type (local.get $element_pointer))
              (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 4))))
              (call $value_data_lo (local.get $element_pointer))
              (call $value_data_hi (local.get $element_pointer)))
          )
        )
        (if (i32.ge_u (local.get $param_count) (i32.const 2))
          (then (call $push_rational_inline (i64.const 0))))
        (if (i32.ge_u (local.get $param_count) (i32.const 3))
          (then (call $pending_push (global.get $TYPE_ARRAY) (i32.const 0) (local.get $array_pointer) (i32.const 0))))
      )
    )

    ;; Signal that the frame and first callback arguments are complete.
    (return (global.get $STATUS_NATIVE_CONTINUATION_STAGED))
  )

  ;; find_like_method — batch 22, same shape as $foreach_method (linear
  ;; ascending, no result container, index=0) but for find/findIndex/
  ;; some/every (+ Uint8Array mirrors). Only the empty-receiver default
  ;; differs per method_id: find→undefined, findIndex→-1, some→false,
  ;; every→true. The OP_RETURN/OP_RETURN_UNDEFINED continuation for
  ;; these four (early-exit on a truthy/falsy check, or the exhausted
  ;; default) is already fully generic by method_id — untouched here.
  ;; Also serves the findLast family (findLast/findLastIndex + typed
  ;; mirrors): identical entry except the walk is DESCENDING — the
  ;; iteration index starts at len-1 and the continuations decrement it
  ;; (see $is_find_last_method); defaults findLast→undefined,
  ;; findLastIndex→-1.
  (func $find_like_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $closure_pointer i32)
    (local $mp_addr i32)
    (local $mp_end i32)
    (local $array_pointer i32)
    (local $arr_len i32)
    (local $stack_pointer i32)
    (local $frame_pointer i32)
    (local $start_instr i32)
    (local $param_count i32)
    (local $data_pointer i32)
    (local $element_pointer i32)
    (local $float_result f64)
    (local $count i32)
    (local $start_index i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))

    (if (i32.and
          (i32.and
            (i32.ne (local.get $receiver_type) (global.get $TYPE_ARRAY))
            (i32.eqz (call $is_typed_array (local.get $receiver_type))))
          (i32.ne (i32.and (local.get $receiver_type) (i32.const 0xff)) (global.get $TYPE_MSGPACK_REF)))
      (then
        (call $set_error (global.get $ERR_TYPE_ERROR) (local.get $receiver_type))
        (return (i32.const 2))
      )
    )

    (if (i32.eq (i32.and (local.get $receiver_type) (i32.const 0xff)) (global.get $TYPE_MSGPACK_REF))
      (then
        (local.set $mp_addr
          (call $msgpack_ref_absolute
            (local.get $receiver_pointer)
            (i32.shr_u (local.get $receiver_type) (i32.const 8))))
        (local.set $mp_end
          (call $msgpack_ref_parent_end (local.get $receiver_pointer)))
        (if (i32.eq
              (call $msgpack_peek_type (local.get $mp_addr) (local.get $mp_end))
              (global.get $MSGPACK_ARRAY))
          (then
            (if (call $check_heap_overflow
                  (call $estimate_array_size (call $msgpack_scratch_count)))
              (then (return (i32.const 0))))
          )
        )
        (local.set $receiver_pointer
          (call $msgpack_to_array (local.get $mp_addr) (local.get $mp_end) (local.get $receiver_pointer)))
        (if (i32.eqz (local.get $receiver_pointer))
          (then
            (if (call $throw_from_set_error)
              (then (return (i32.const 2)))
              (else (return (i32.const 1)))
            )
          )
        )
        (local.set $receiver_type (global.get $TYPE_ARRAY))
      )
    )

    (if (i32.lt_u (local.get $argc) (i32.const 1))
      (then
        (call $set_error (global.get $ERR_ARITY) (i32.const 1))
        (return (i32.const 2))
      )
    )

    (local.set $closure_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
    (if (i32.ne (call $value_type (local.get $closure_pointer)) (global.get $TYPE_FUNCTION))
      (then
        (if (call $throw_type_error_with_type (global.get $BUILTIN_MSG_NOT_A_FUNCTION) (i32.const 0))
          (then (return (i32.const 2)))
          (else (return (i32.const 1)))
        )
      )
    )
    (local.set $closure_pointer (call $value_data_lo (local.get $closure_pointer)))

    (local.set $array_pointer (local.get $receiver_pointer))
    (local.set $arr_len (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 8)))))

    (if (i32.eqz (local.get $arr_len))
      (then
        (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
        (if (i32.or
              (i32.or
                (i32.eq (local.get $method_id) (global.get $METHOD_FIND))
                (i32.eq (local.get $method_id) (global.get $METHOD_UINT8ARRAY_FIND)))
              (i32.or
                (i32.eq (local.get $method_id) (global.get $METHOD_FIND_LAST))
                (i32.eq (local.get $method_id) (global.get $METHOD_UINT8ARRAY_FIND_LAST))))
          (then (call $pending_push (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0)))
          (else
            (if (i32.or
                  (i32.or
                    (i32.eq (local.get $method_id) (global.get $METHOD_FIND_INDEX))
                    (i32.eq (local.get $method_id) (global.get $METHOD_UINT8ARRAY_FIND_INDEX)))
                  (i32.or
                    (i32.eq (local.get $method_id) (global.get $METHOD_FIND_LAST_INDEX))
                    (i32.eq (local.get $method_id) (global.get $METHOD_UINT8ARRAY_FIND_LAST_INDEX))))
              (then (call $push_f64 (f64.const -1)))
              (else
                (if (i32.or
                      (i32.eq (local.get $method_id) (global.get $METHOD_SOME))
                      (i32.eq (local.get $method_id) (global.get $METHOD_UINT8ARRAY_SOME)))
                  (then (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (i32.const 0) (i32.const 0)))
                  (else
                    ;; every
                    (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (i32.const 1) (i32.const 0))
                  )
                )
              )
            )
          )
        )
        (return (i32.const 0))
      )
    )

    ;; Non-empty: push the iteration frame. The findLast family walks
    ;; DESCENDING — it starts at len-1; everything else starts at 0.
    (local.set $start_index (i32.const 0))
    (if (call $is_find_last_method (local.get $method_id))
      (then (local.set $start_index (i32.sub (local.get $arr_len) (i32.const 1)))))
    (local.set $stack_pointer (call $read_ctx (global.get $CTX_CALL_STACK_POINTER)))
    (local.set $frame_pointer (call $abs (local.get $stack_pointer)))
    (local.set $param_count (call $callback_staged_argc (local.get $closure_pointer) (i32.const 3)))
    (local.set $start_instr (i32.load (call $abs (i32.add (local.get $closure_pointer) (global.get $FUNCTION_CLOSURE_OFFSET)))))

    (if (call $check_heap_overflow
          (global.get $NATIVE_CONTINUATION_STATE_SIZE))
      (then (return (i32.const 0))))
    (call $publish_native_continuation_frame
      (local.get $frame_pointer) (local.get $stack_pointer)
      (local.get $stack_base) (i32.const 1) (local.get $param_count)
      (local.get $start_index) (local.get $arr_len) (i32.const 0)
      (call $continuation_kind_from_callback_method (local.get $method_id))
      (local.get $array_pointer) (local.get $closure_pointer)
      (local.get $receiver_type) (i32.const 0))

    (if (call $is_uint8array_callback_method (local.get $method_id))
      (then
        (local.set $data_pointer (i32.load (call $abs (local.get $array_pointer))))
        (local.set $count (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 4)))))
        (local.set $element_pointer (i32.add
          (i32.add
            (i32.add (local.get $data_pointer) (i32.const 4))
            (local.get $count))
          (i32.mul (local.get $start_index) (call $get_bytes_per_element (local.get $receiver_type)))))
        (local.set $float_result (call $read_typed_element (local.get $receiver_type) (call $abs (local.get $element_pointer))))
        (if (i32.ge_u (local.get $param_count) (i32.const 1))
          (then (call $push_f64 (local.get $float_result))))
        (if (i32.ge_u (local.get $param_count) (i32.const 2))
          (then (call $push_f64 (f64.convert_i32_s (local.get $start_index)))))
        (if (i32.ge_u (local.get $param_count) (i32.const 3))
          (then (call $pending_push (local.get $receiver_type) (i32.const 0) (local.get $array_pointer) (i32.const 0))))
      )
      (else
        (local.set $data_pointer (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 16)))))
        (local.set $element_pointer (i32.add
          (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
          (i32.mul (local.get $start_index) (global.get $VALUE_SIZE))))
        (if (i32.ge_u (local.get $param_count) (i32.const 1))
          (then
            (call $pending_push
              (call $value_type (local.get $element_pointer))
              (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 4))))
              (call $value_data_lo (local.get $element_pointer))
              (call $value_data_hi (local.get $element_pointer)))
          )
        )
        (if (i32.ge_u (local.get $param_count) (i32.const 2))
          (then (call $push_rational_inline (i64.extend_i32_s (local.get $start_index)))))
        (if (i32.ge_u (local.get $param_count) (i32.const 3))
          (then (call $pending_push (global.get $TYPE_ARRAY) (i32.const 0) (local.get $array_pointer) (i32.const 0))))
      )
    )

    (return (global.get $STATUS_NATIVE_CONTINUATION_STAGED))
  )

  ;; map_filter_method — batch 23. Same entry shape as $find_like_method
  ;; but allocates a result container (array or, for a typed-array
  ;; receiver, an ArrayBuffer + descriptor) sized to arr_len, pressure-
  ;; checked before allocating (returns 0 with memory_pressure_signaled
  ;; set on overflow — same convention $run's intercept already handles
  ;; for $find_like_method). filter/Uint8Array-filter start the result
  ;; at length 0 (grown by the RETURN continuation, already generic);
  ;; map fills every slot. FRAME_CONTINUATION_STATE_1 holds the container.
  (func $map_filter_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $closure_pointer i32)
    (local $mp_addr i32)
    (local $mp_end i32)
    (local $array_pointer i32)
    (local $arr_len i32)
    (local $stack_pointer i32)
    (local $frame_pointer i32)
    (local $start_instr i32)
    (local $param_count i32)
    (local $data_pointer i32)
    (local $element_pointer i32)
    (local $float_result f64)
    (local $count i32)
    (local $heap_pointer i32)
    (local $new_data_pointer i32)
    (local $result_lo i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))

    (if (i32.and
          (i32.and
            (i32.ne (local.get $receiver_type) (global.get $TYPE_ARRAY))
            (i32.eqz (call $is_typed_array (local.get $receiver_type))))
          (i32.ne (i32.and (local.get $receiver_type) (i32.const 0xff)) (global.get $TYPE_MSGPACK_REF)))
      (then
        (call $set_error (global.get $ERR_TYPE_ERROR) (local.get $receiver_type))
        (return (i32.const 2))
      )
    )

    (if (i32.eq (i32.and (local.get $receiver_type) (i32.const 0xff)) (global.get $TYPE_MSGPACK_REF))
      (then
        (local.set $mp_addr
          (call $msgpack_ref_absolute
            (local.get $receiver_pointer)
            (i32.shr_u (local.get $receiver_type) (i32.const 8))))
        (local.set $mp_end
          (call $msgpack_ref_parent_end (local.get $receiver_pointer)))
        (if (i32.eq
              (call $msgpack_peek_type (local.get $mp_addr) (local.get $mp_end))
              (global.get $MSGPACK_ARRAY))
          (then
            (if (call $check_heap_overflow
                  (call $estimate_array_size (call $msgpack_scratch_count)))
              (then (return (i32.const 0))))
          )
        )
        (local.set $receiver_pointer
          (call $msgpack_to_array (local.get $mp_addr) (local.get $mp_end) (local.get $receiver_pointer)))
        (if (i32.eqz (local.get $receiver_pointer))
          (then
            (if (call $throw_from_set_error)
              (then (return (i32.const 2)))
              (else (return (i32.const 1)))
            )
          )
        )
        (local.set $receiver_type (global.get $TYPE_ARRAY))
      )
    )

    (if (i32.lt_u (local.get $argc) (i32.const 1))
      (then
        (call $set_error (global.get $ERR_ARITY) (i32.const 1))
        (return (i32.const 2))
      )
    )

    (local.set $closure_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
    (if (i32.ne (call $value_type (local.get $closure_pointer)) (global.get $TYPE_FUNCTION))
      (then
        (if (call $throw_type_error_with_type (global.get $BUILTIN_MSG_NOT_A_FUNCTION) (i32.const 0))
          (then (return (i32.const 2)))
          (else (return (i32.const 1)))
        )
      )
    )
    (local.set $closure_pointer (call $value_data_lo (local.get $closure_pointer)))

    (local.set $array_pointer (local.get $receiver_pointer))
    (local.set $arr_len (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 8)))))

    (if (i32.eqz (local.get $arr_len))
      (then
        (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
        (if (call $is_uint8array_callback_method (local.get $method_id))
          (then
            (local.set $heap_pointer (call $allocate_arraybuffer (i32.const 0)))
            (local.set $new_data_pointer (call $allocate_typed_array_descriptor
              (local.get $heap_pointer) (i32.const 0) (i32.const 0)))
            (call $pending_push (local.get $receiver_type) (i32.const 0) (local.get $new_data_pointer) (i32.const 0))
          )
          (else
            (local.set $heap_pointer (call $allocate_array (i32.const 0)))
            (call $pending_push (global.get $TYPE_ARRAY) (i32.const 0) (local.get $heap_pointer) (i32.const 0))
          )
        )
        (return (i32.const 0))
      )
    )

    ;; Pressure pre-check: result container sized to arr_len.
    (if (call $is_uint8array_callback_method (local.get $method_id))
      (then
        (if (call $check_heap_overflow
              (i32.add
                (call $estimate_arraybuffer_size
                  (i32.mul (local.get $arr_len) (call $get_bytes_per_element (local.get $receiver_type))))
                (call $estimate_typed_array_descriptor_size)))
          (then (return (i32.const 0))))
      )
      (else
        (if (call $check_heap_overflow (call $estimate_array_size (local.get $arr_len)))
          (then (return (i32.const 0))))
      )
    )

    ;; Allocate the result container.
    (if (call $is_uint8array_callback_method (local.get $method_id))
      (then
        (local.set $heap_pointer (call $allocate_arraybuffer
          (i32.mul (local.get $arr_len) (call $get_bytes_per_element (local.get $receiver_type)))))
        (local.set $new_data_pointer (call $allocate_typed_array_descriptor
          (local.get $heap_pointer) (i32.const 0) (local.get $arr_len)))
        (if (i32.eq (local.get $method_id) (global.get $METHOD_UINT8ARRAY_FILTER))
          (then
            (i32.store (call $abs (i32.add (local.get $new_data_pointer) (i32.const 8))) (i32.const 0))
          )
        )
        (local.set $result_lo (local.get $new_data_pointer))
      )
      (else
        (local.set $new_data_pointer (call $allocate_array (local.get $arr_len)))
        (if (i32.eq (local.get $method_id) (global.get $METHOD_FILTER))
          (then
            (i32.store (call $abs (i32.add (local.get $new_data_pointer) (i32.const 8))) (i32.const 0))
          )
        )
        (local.set $result_lo (local.get $new_data_pointer))
      )
    )

    ;; Push the iteration frame.
    (local.set $stack_pointer (call $read_ctx (global.get $CTX_CALL_STACK_POINTER)))
    (local.set $frame_pointer (call $abs (local.get $stack_pointer)))
    (local.set $param_count (call $callback_staged_argc (local.get $closure_pointer) (i32.const 3)))
    (local.set $start_instr (i32.load (call $abs (i32.add (local.get $closure_pointer) (global.get $FUNCTION_CLOSURE_OFFSET)))))

    (if (call $check_heap_overflow
          (global.get $NATIVE_CONTINUATION_STATE_SIZE))
      (then (return (i32.const 0))))
    (call $publish_native_continuation_frame
      (local.get $frame_pointer) (local.get $stack_pointer)
      (local.get $stack_base) (i32.const 1) (local.get $param_count)
      (i32.const 0) (local.get $arr_len) (local.get $result_lo)
      (call $continuation_kind_from_callback_method (local.get $method_id))
      (local.get $array_pointer) (local.get $closure_pointer)
      (local.get $receiver_type) (i32.const 0))

    (if (call $is_uint8array_callback_method (local.get $method_id))
      (then
        (local.set $data_pointer (i32.load (call $abs (local.get $array_pointer))))
        (local.set $count (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 4)))))
        (local.set $element_pointer (i32.add
          (i32.add (local.get $data_pointer) (i32.const 4))
          (local.get $count)))
        (local.set $float_result (call $read_typed_element (local.get $receiver_type) (call $abs (local.get $element_pointer))))
        (if (i32.ge_u (local.get $param_count) (i32.const 1))
          (then (call $push_f64 (local.get $float_result))))
        (if (i32.ge_u (local.get $param_count) (i32.const 2))
          (then (call $push_f64 (f64.const 0))))
        (if (i32.ge_u (local.get $param_count) (i32.const 3))
          (then (call $pending_push (local.get $receiver_type) (i32.const 0) (local.get $array_pointer) (i32.const 0))))
      )
      (else
        (local.set $data_pointer (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 16)))))
        (local.set $element_pointer (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE)))
        (if (i32.ge_u (local.get $param_count) (i32.const 1))
          (then
            (call $pending_push
              (call $value_type (local.get $element_pointer))
              (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 4))))
              (call $value_data_lo (local.get $element_pointer))
              (call $value_data_hi (local.get $element_pointer)))
          )
        )
        (if (i32.ge_u (local.get $param_count) (i32.const 2))
          (then (call $push_rational_inline (i64.const 0))))
        (if (i32.ge_u (local.get $param_count) (i32.const 3))
          (then (call $pending_push (global.get $TYPE_ARRAY) (i32.const 0) (local.get $array_pointer) (i32.const 0))))
      )
    )

    (return (global.get $STATUS_NATIVE_CONTINUATION_STAGED))
  )

  ;; reduce_method — batch 24. Covers reduce/reduceRight (+ Uint8Array
  ;; mirrors). Unlike the previous three entry functions, the closure's
  ;; optional second argument (the initial value) matters, and the
  ;; accumulator is stored in a heap-allocated 1-element array (like the
  ;; original inline code) rather than pushed as a plain iter slot,
  ;; since it can be any value type. Direction: reduceRight walks
  ;; descending from arr_len-1; the shared "more iterations?" check
  ;; `index < arr_len` (unsigned) wraps at -1 so both directions share
  ;; one completion test (already true in the untouched RETURN
  ;; continuation). The "single-element array, no initial" case
  ;; short-circuits before ever entering the iteration frame — matches
  ;; the original inline code exactly.
  (func $reduce_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $closure_pointer i32)
    (local $argument2_pointer i32)
    (local $mp_addr i32)
    (local $mp_end i32)
    (local $array_pointer i32)
    (local $arr_len i32)
    (local $stack_pointer i32)
    (local $frame_pointer i32)
    (local $start_instr i32)
    (local $param_count i32)
    (local $data_pointer i32)
    (local $element_pointer i32)
    (local $float_result f64)
    (local $count i32)
    (local $new_data_pointer i32)
    (local $result_lo i32)
    (local $result_type i32)
    (local $result_hi i32)
    (local $entry_pointer i32)
    (local $index i32)
    (local $dest i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))

    (if (i32.and
          (i32.and
            (i32.ne (local.get $receiver_type) (global.get $TYPE_ARRAY))
            (i32.eqz (call $is_typed_array (local.get $receiver_type))))
          (i32.ne (i32.and (local.get $receiver_type) (i32.const 0xff)) (global.get $TYPE_MSGPACK_REF)))
      (then
        (call $set_error (global.get $ERR_TYPE_ERROR) (local.get $receiver_type))
        (return (i32.const 2))
      )
    )

    (if (i32.eq (i32.and (local.get $receiver_type) (i32.const 0xff)) (global.get $TYPE_MSGPACK_REF))
      (then
        (local.set $mp_addr
          (call $msgpack_ref_absolute
            (local.get $receiver_pointer)
            (i32.shr_u (local.get $receiver_type) (i32.const 8))))
        (local.set $mp_end
          (call $msgpack_ref_parent_end (local.get $receiver_pointer)))
        (if (i32.eq
              (call $msgpack_peek_type (local.get $mp_addr) (local.get $mp_end))
              (global.get $MSGPACK_ARRAY))
          (then
            (if (call $check_heap_overflow
                  (call $estimate_array_size (call $msgpack_scratch_count)))
              (then (return (i32.const 0))))
          )
        )
        (local.set $receiver_pointer
          (call $msgpack_to_array (local.get $mp_addr) (local.get $mp_end) (local.get $receiver_pointer)))
        (if (i32.eqz (local.get $receiver_pointer))
          (then
            (if (call $throw_from_set_error)
              (then (return (i32.const 2)))
              (else (return (i32.const 1)))
            )
          )
        )
        (local.set $receiver_type (global.get $TYPE_ARRAY))
      )
    )

    (if (i32.lt_u (local.get $argc) (i32.const 1))
      (then
        (call $set_error (global.get $ERR_ARITY) (i32.const 1))
        (return (i32.const 2))
      )
    )

    (local.set $closure_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
    (if (i32.ne (call $value_type (local.get $closure_pointer)) (global.get $TYPE_FUNCTION))
      (then
        (if (call $throw_type_error_with_type (global.get $BUILTIN_MSG_NOT_A_FUNCTION) (i32.const 0))
          (then (return (i32.const 2)))
          (else (return (i32.const 1)))
        )
      )
    )
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then (local.set $argument2_pointer (i32.add (local.get $closure_pointer) (global.get $VALUE_SIZE)))))
    (local.set $closure_pointer (call $value_data_lo (local.get $closure_pointer)))

    (local.set $array_pointer (local.get $receiver_pointer))
    (local.set $arr_len (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 8)))))

    (if (i32.eqz (local.get $arr_len))
      (then
        (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
        (if (i32.ge_u (local.get $argc) (i32.const 2))
          (then
            (call $pending_push
              (call $value_type (local.get $argument2_pointer))
              (i32.load (call $abs (i32.add (local.get $argument2_pointer) (i32.const 4))))
              (call $value_data_lo (local.get $argument2_pointer))
              (call $value_data_hi (local.get $argument2_pointer)))
          )
          (else
            (call $set_error (global.get $ERR_TYPE_ERROR) (i32.const 0))
            (return (i32.const 2))
          )
        )
        (return (i32.const 0))
      )
    )

    ;; Pressure pre-check: 1-element accumulator array.
    (if (call $check_heap_overflow (call $estimate_array_size (i32.const 1)))
      (then (return (i32.const 0))))

    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then
        ;; Initial value provided.
        (local.set $result_type (call $value_type (local.get $argument2_pointer)))
        (local.set $result_lo (call $value_data_lo (local.get $argument2_pointer)))
        (local.set $result_hi (call $value_data_hi (local.get $argument2_pointer)))
        (local.set $new_data_pointer (call $allocate_array (i32.const 1)))
        (local.set $data_pointer (i32.load (call $abs (i32.add (local.get $new_data_pointer) (i32.const 16)))))
        (call $write_value (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
          (local.get $result_type)
          (i32.load (call $abs (i32.add (local.get $argument2_pointer) (i32.const 4))))
          (local.get $result_lo)
          (local.get $result_hi))
        (local.set $result_lo (local.get $new_data_pointer))
        (if (i32.or
              (i32.eq (local.get $method_id) (global.get $METHOD_ARRAY_REDUCE_RIGHT))
              (i32.eq (local.get $method_id) (global.get $METHOD_UINT8ARRAY_REDUCE_RIGHT)))
          (then (local.set $index (i32.sub (local.get $arr_len) (i32.const 1))))
          (else (local.set $index (i32.const 0))))
      )
      (else
        ;; No initial value — seed is arr[0] (reduceRight: arr[len-1]).
        (if (i32.or
              (i32.eq (local.get $method_id) (global.get $METHOD_ARRAY_REDUCE_RIGHT))
              (i32.eq (local.get $method_id) (global.get $METHOD_UINT8ARRAY_REDUCE_RIGHT)))
          (then (local.set $index (i32.sub (local.get $arr_len) (i32.const 1))))
          (else (local.set $index (i32.const 0))))
        (if (call $is_uint8array_callback_method (local.get $method_id))
          (then
            (local.set $data_pointer (i32.load (call $abs (local.get $array_pointer))))
            (local.set $count (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 4)))))
            (local.set $element_pointer (i32.add
              (i32.add
                (i32.add (local.get $data_pointer) (i32.const 4))
                (local.get $count))
              (i32.mul (local.get $index) (call $get_bytes_per_element (local.get $receiver_type)))))
            (local.set $float_result (call $read_typed_element (local.get $receiver_type) (call $abs (local.get $element_pointer))))
            (local.set $new_data_pointer (call $allocate_array (i32.const 1)))
            (local.set $dest (i32.add
              (i32.load (call $abs (i32.add (local.get $new_data_pointer) (i32.const 16))))
              (global.get $GC_HEADER_SIZE)))
            (call $write_value (local.get $dest)
              (global.get $TYPE_FLOAT) (i32.const 0)
              (i32.wrap_i64 (i64.reinterpret_f64 (local.get $float_result)))
              (i32.wrap_i64 (i64.shr_u (i64.reinterpret_f64 (local.get $float_result)) (i64.const 32))))
            (local.set $result_lo (local.get $new_data_pointer))
            (if (i32.or
                  (i32.eq (local.get $method_id) (global.get $METHOD_ARRAY_REDUCE_RIGHT))
                  (i32.eq (local.get $method_id) (global.get $METHOD_UINT8ARRAY_REDUCE_RIGHT)))
              (then (local.set $index (i32.sub (local.get $index) (i32.const 1))))
              (else (local.set $index (i32.const 1))))
            (if (i32.eq (local.get $arr_len) (i32.const 1))
              (then
                (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
                (call $push_f64 (local.get $float_result))
                (return (i32.const 0))
              )
            )
          )
          (else
            (local.set $data_pointer (i32.add
              (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 16))))
              (global.get $GC_HEADER_SIZE)))
            (local.set $element_pointer (i32.add
              (local.get $data_pointer)
              (i32.mul (local.get $index) (global.get $VALUE_SIZE))))
            (local.set $new_data_pointer (call $allocate_array (i32.const 1)))
            (local.set $dest (i32.add
              (i32.load (call $abs (i32.add (local.get $new_data_pointer) (i32.const 16))))
              (global.get $GC_HEADER_SIZE)))
            (i32.store (call $abs (local.get $dest)) (i32.load (call $abs (local.get $element_pointer))))
            (i32.store (call $abs (i32.add (local.get $dest) (i32.const 4))) (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 4)))))
            (i32.store (call $abs (i32.add (local.get $dest) (i32.const 8))) (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 8)))))
            (i32.store (call $abs (i32.add (local.get $dest) (i32.const 12))) (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 12)))))
            (local.set $result_lo (local.get $new_data_pointer))
            (if (i32.eq (local.get $method_id) (global.get $METHOD_ARRAY_REDUCE_RIGHT))
              (then (local.set $index (i32.sub (local.get $index) (i32.const 1))))
              (else (local.set $index (i32.const 1))))
            (if (i32.eq (local.get $arr_len) (i32.const 1))
              (then
                (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
                (call $pending_push
                  (call $value_type (local.get $element_pointer))
                  (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 4))))
                  (call $value_data_lo (local.get $element_pointer))
                  (call $value_data_hi (local.get $element_pointer)))
                (return (i32.const 0))
              )
            )
          )
        )
      )
    )

    ;; Push the iteration frame.
    (local.set $stack_pointer (call $read_ctx (global.get $CTX_CALL_STACK_POINTER)))
    (local.set $frame_pointer (call $abs (local.get $stack_pointer)))
    (local.set $param_count (call $callback_staged_argc (local.get $closure_pointer) (i32.const 4)))
    (local.set $start_instr (i32.load (call $abs (i32.add (local.get $closure_pointer) (global.get $FUNCTION_CLOSURE_OFFSET)))))

    (if (call $check_heap_overflow
          (global.get $NATIVE_CONTINUATION_STATE_SIZE))
      (then (return (i32.const 0))))
    (call $publish_native_continuation_frame
      (local.get $frame_pointer) (local.get $stack_pointer)
      (local.get $stack_base) (i32.const 1) (local.get $param_count)
      (local.get $index) (local.get $arr_len) (local.get $result_lo)
      (call $continuation_kind_from_callback_method (local.get $method_id))
      (local.get $array_pointer) (local.get $closure_pointer)
      (local.get $receiver_type) (i32.const 0))

    ;; Push args: acc (from result_lo), elem, idx, arr.
    (if (call $is_uint8array_callback_method (local.get $method_id))
      (then
        (local.set $data_pointer (i32.load (call $abs (local.get $array_pointer))))
        (local.set $count (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 4)))))
        (local.set $element_pointer (i32.add
          (i32.add (local.get $data_pointer) (i32.const 4))
          (i32.mul (local.get $index) (call $get_bytes_per_element (local.get $receiver_type)))))
        (local.set $float_result (call $read_typed_element (local.get $receiver_type) (call $abs (local.get $element_pointer))))
        (if (i32.ge_u (local.get $param_count) (i32.const 1))
          (then
            (local.set $dest (i32.add
              (i32.load (call $abs (i32.add (local.get $result_lo) (i32.const 16))))
              (global.get $GC_HEADER_SIZE)))
            (call $pending_push
              (call $value_type (local.get $dest))
              (i32.load (call $abs (i32.add (local.get $dest) (i32.const 4))))
              (call $value_data_lo (local.get $dest))
              (call $value_data_hi (local.get $dest)))
          )
        )
        (if (i32.ge_u (local.get $param_count) (i32.const 2))
          (then (call $push_f64 (local.get $float_result))))
        (if (i32.ge_u (local.get $param_count) (i32.const 3))
          (then (call $push_f64 (f64.convert_i32_s (local.get $index)))))
        (if (i32.ge_u (local.get $param_count) (i32.const 4))
          (then (call $pending_push (local.get $receiver_type) (i32.const 0) (local.get $array_pointer) (i32.const 0))))
      )
      (else
        (local.set $data_pointer (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 16)))))
        (local.set $element_pointer (i32.add
          (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
          (i32.mul (local.get $index) (global.get $VALUE_SIZE))))
        (if (i32.ge_u (local.get $param_count) (i32.const 1))
          (then
            (local.set $dest (i32.add
              (i32.load (call $abs (i32.add (local.get $result_lo) (i32.const 16))))
              (global.get $GC_HEADER_SIZE)))
            (call $pending_push
              (call $value_type (local.get $dest))
              (i32.load (call $abs (i32.add (local.get $dest) (i32.const 4))))
              (call $value_data_lo (local.get $dest))
              (call $value_data_hi (local.get $dest)))
          )
        )
        (if (i32.ge_u (local.get $param_count) (i32.const 2))
          (then
            (call $pending_push
              (call $value_type (local.get $element_pointer))
              (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 4))))
              (call $value_data_lo (local.get $element_pointer))
              (call $value_data_hi (local.get $element_pointer)))
          )
        )
        (if (i32.ge_u (local.get $param_count) (i32.const 3))
          (then (call $push_f64 (f64.convert_i32_s (local.get $index)))))
        (if (i32.ge_u (local.get $param_count) (i32.const 4))
          (then (call $pending_push (global.get $TYPE_ARRAY) (i32.const 0) (local.get $array_pointer) (i32.const 0))))
      )
    )

    (return (global.get $STATUS_NATIVE_CONTINUATION_STAGED))
  )

  ;; sort_method — batch 25. Comparator-form Array.prototype.sort only
  ;; (the no-comparator numeric-sort default stays in
  ;; dispatch_builtin_method's $array_sort_method, batch 16 — the
  ;; caller must still fall back there when argc==0 or arg1 isn't a
  ;; function). Insertion sort: ITER_INDEX = outer i (starts at 1),
  ;; ITER_RESULT = a 1-element temp array holding the "key" being
  ;; inserted, FRAME_ASYNC_PROMISE reused as the inner index j (safe:
  ;; sort's frame is never async). This function only implements the
  ;; FIRST comparator call (i=1, j=0); the entire multi-comparison
  ;; insertion-sort walk (both the "shift right, compare again" inner
  ;; loop and the "advance i" outer loop) lives in OP_RETURN's existing
  ;; sort-specific continuation, untouched here — sort's comparator
  ;; always returns an explicit value (`(a,b) => a-b` or a block with
  ;; `return`), so OP_RETURN, not OP_RETURN_UNDEFINED, drives it.
  ;;
  (func $sort_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $closure_pointer i32)
    (local $array_pointer i32)
    (local $arr_len i32)
    (local $stack_pointer i32)
    (local $frame_pointer i32)
    (local $start_instr i32)
    (local $param_count i32)
    (local $data_pointer i32)
    (local $element_pointer i32)
    (local $new_data_pointer i32)
    (local $dest i32)
    (local $index i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))

    (local.set $closure_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
    (local.set $closure_pointer (call $value_data_lo (local.get $closure_pointer)))
    (local.set $array_pointer (local.get $receiver_pointer))
    (local.set $arr_len (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 8)))))

    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))

    (if (i32.le_u (local.get $arr_len) (i32.const 1))
      (then
        (call $pending_push (global.get $TYPE_ARRAY) (i32.const 0) (local.get $array_pointer) (i32.const 0))
        (return (i32.const 0))
      )
    )

    ;; Pressure pre-check: 1-element temp array to hold the key.
    (if (call $check_heap_overflow (call $estimate_array_size (i32.const 1)))
      (then (return (i32.const 0))))
    (local.set $new_data_pointer (call $allocate_array (i32.const 1)))

    ;; Copy arr[1] (the first key to insert) into the temp array.
    (local.set $data_pointer (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 16)))))
    (local.set $element_pointer (i32.add
      (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
      (global.get $VALUE_SIZE)))
    (local.set $dest (i32.add
      (i32.load (call $abs (i32.add (local.get $new_data_pointer) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (i32.store (call $abs (local.get $dest)) (i32.load (call $abs (local.get $element_pointer))))
    (i32.store (call $abs (i32.add (local.get $dest) (i32.const 4)))
      (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 4)))))
    (i32.store (call $abs (i32.add (local.get $dest) (i32.const 8)))
      (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 8)))))
    (i32.store (call $abs (i32.add (local.get $dest) (i32.const 12)))
      (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 12)))))

    ;; Push the iteration frame. ITER_INDEX=1 (outer i), ITER_RESULT =
    ;; temp key array, ASYNC_PROMISE reused as inner j (=0, i.e. i-1).
    (local.set $index (i32.const 1))
    (local.set $start_instr (i32.load (call $abs (i32.add (local.get $closure_pointer) (global.get $FUNCTION_CLOSURE_OFFSET)))))
    (local.set $stack_pointer (call $read_ctx (global.get $CTX_CALL_STACK_POINTER)))
    (local.set $frame_pointer (call $abs (local.get $stack_pointer)))

    (local.set $param_count
      (call $callback_staged_argc (local.get $closure_pointer) (i32.const 2)))
    (if (call $check_heap_overflow
          (global.get $NATIVE_CONTINUATION_STATE_SIZE))
      (then (return (i32.const 0))))
    (call $publish_native_continuation_frame
      (local.get $frame_pointer) (local.get $stack_pointer)
      (local.get $stack_base)
      (i32.const 1) (local.get $param_count) (local.get $index)
      (local.get $arr_len) (local.get $new_data_pointer)
      (call $continuation_kind_from_callback_method (local.get $method_id))
      (local.get $array_pointer) (local.get $closure_pointer)
      (local.get $receiver_type) (i32.const 0))

    ;; Push first comparison args: comparator(arr[1], arr[0]).
    (if (i32.ge_u (local.get $param_count) (i32.const 1))
      (then
        (call $pending_push
          (call $value_type (local.get $dest))
          (i32.load (call $abs (i32.add (local.get $dest) (i32.const 4))))
          (call $value_data_lo (local.get $dest))
          (call $value_data_hi (local.get $dest)))
      )
    )
    (if (i32.ge_u (local.get $param_count) (i32.const 2))
      (then
        (local.set $element_pointer (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE)))
        (call $pending_push
          (call $value_type (local.get $element_pointer))
          (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 4))))
          (call $value_data_lo (local.get $element_pointer))
          (call $value_data_hi (local.get $element_pointer)))
      )
    )

    (return (global.get $STATUS_NATIVE_CONTINUATION_STAGED))
  )

  ;; typed_array_sort_comparator_method — comparator-form TypedArray
  ;; .prototype.sort. Same insertion-sort staging as $sort_method
  ;; (ITER_INDEX = outer i starting at 1, ITER_RESULT = a 1-element
  ;; temp array holding the key being inserted, FRAME_ASYNC_PROMISE
  ;; reused as inner j), but elements live in the descriptor's typed
  ;; window, so the key is materialized as a TYPE_FLOAT value in the
  ;; temp array and comparator arguments are pushed via $push_f64. The
  ;; multi-comparison walk lives in OP_RETURN's (and, for block-bodied
  ;; comparators, OP_RETURN_UNDEFINED's) METHOD_UINT8ARRAY_SORT
  ;; continuation. Reached only from OP_CALL_METHOD's intercept, which
  ;; guarantees a typed receiver and a function comparator.
  (func $typed_array_sort_comparator_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $closure_pointer i32)
    (local $arr_len i32)
    (local $stack_pointer i32)
    (local $frame_pointer i32)
    (local $param_count i32)
    (local $element_base i32)
    (local $new_data_pointer i32)
    (local $dest i32)
    (local $key_bits i64)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))

    (local.set $closure_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
    (local.set $closure_pointer (call $value_data_lo (local.get $closure_pointer)))
    (local.set $arr_len (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 8)))))

    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))

    (if (i32.le_u (local.get $arr_len) (i32.const 1))
      (then
        (call $pending_push (local.get $receiver_type) (i32.const 0) (local.get $receiver_pointer) (i32.const 0))
        (return (i32.const 0))
      )
    )

    ;; Pressure pre-check: 1-element temp array to hold the key.
    (if (call $check_heap_overflow (call $estimate_array_size (i32.const 1)))
      (then (return (i32.const 0))))
    (local.set $new_data_pointer (call $allocate_array (i32.const 1)))

    ;; Elements start at buffer_ptr + 4 (past byteLength) + byte_offset.
    (local.set $element_base (i32.add
      (i32.add (i32.load (call $abs (local.get $receiver_pointer))) (i32.const 4))
      (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 4))))))

    ;; key = arr[1] (the first key to insert), stored as a TYPE_FLOAT
    ;; value in the temp array.
    (local.set $key_bits (i64.reinterpret_f64
      (call $read_typed_element (local.get $receiver_type)
        (call $abs (i32.add (local.get $element_base)
          (call $get_bytes_per_element (local.get $receiver_type)))))))
    (local.set $dest (i32.add
      (i32.load (call $abs (i32.add (local.get $new_data_pointer) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (i32.store (call $abs (local.get $dest)) (global.get $TYPE_FLOAT))
    (i32.store (call $abs (i32.add (local.get $dest) (i32.const 4))) (i32.const 0))
    (i32.store (call $abs (i32.add (local.get $dest) (i32.const 8))) (i32.wrap_i64 (local.get $key_bits)))
    (i32.store (call $abs (i32.add (local.get $dest) (i32.const 12)))
      (i32.wrap_i64 (i64.shr_u (local.get $key_bits) (i64.const 32))))

    ;; Push the iteration frame. ITER_INDEX=1 (outer i), ITER_RESULT =
    ;; temp key array, ASYNC_PROMISE reused as inner j (=0, i.e. i-1).
    (local.set $stack_pointer (call $read_ctx (global.get $CTX_CALL_STACK_POINTER)))
    (local.set $frame_pointer (call $abs (local.get $stack_pointer)))

    (local.set $param_count
      (call $callback_staged_argc (local.get $closure_pointer) (i32.const 2)))
    (if (call $check_heap_overflow
          (global.get $NATIVE_CONTINUATION_STATE_SIZE))
      (then (return (i32.const 0))))
    (call $publish_native_continuation_frame
      (local.get $frame_pointer) (local.get $stack_pointer)
      (local.get $stack_base)
      (i32.const 1) (local.get $param_count) (i32.const 1)
      (local.get $arr_len) (local.get $new_data_pointer)
      (call $continuation_kind_from_callback_method (local.get $method_id))
      (local.get $receiver_pointer) (local.get $closure_pointer)
      (local.get $receiver_type) (i32.const 0))

    ;; Push first comparison args: comparator(arr[1], arr[0]).
    (if (i32.ge_u (local.get $param_count) (i32.const 1))
      (then
        (call $pending_push
          (call $value_type (local.get $dest))
          (i32.load (call $abs (i32.add (local.get $dest) (i32.const 4))))
          (call $value_data_lo (local.get $dest))
          (call $value_data_hi (local.get $dest)))
      )
    )
    (if (i32.ge_u (local.get $param_count) (i32.const 2))
      (then
        (call $push_f64 (call $read_typed_element (local.get $receiver_type)
          (call $abs (local.get $element_base))))
      )
    )

    (return (global.get $STATUS_NATIVE_CONTINUATION_STAGED))
  )

  ;; ==========================================================================
  ;; Copying methods:
  ;; toReversed / toSorted / with / toSpliced on arrays, toReversed /
  ;; toSorted / with on typed arrays. All allocate the copy FIRST
  ;; (pressure pre-checked), then transform. toSorted delegates to the
  ;; existing sort entries with the copy as the receiver: the default
  ;; form runs $array_sort_method / $typed_array_sort_method's in-place
  ;; loop on the copy, and the comparator form stages the existing sort
  ;; continuation frames (`CONTINUATION_KIND_ARRAY_SORT` or
  ;; `CONTINUATION_KIND_TYPED_ARRAY_SORT`) against the copy — completion
  ;; pushes FRAME_CONTINUATION_STATE_2, i.e. the copy, which is exactly
  ;; toSorted's contract. The copy is unobservable mid-sort, so the borrowed
  ;; in-place machinery is invisible.
  ;; ==========================================================================

  ;; copy_array_values(receiver_pointer, arr_len) → header pointer of a
  ;; fresh length-arr_len array with all value slots copied. Caller must
  ;; have pre-checked $estimate_array_size(arr_len).
  (func $copy_array_values (param $receiver_pointer i32) (param $arr_len i32) (result i32)
    (local $copy_pointer i32)
    (local $source_base i32)
    (local $dest_base i32)
    (local $i i32)
    (local $source_pointer i32)
    (local $dest_pointer i32)
    (local.set $copy_pointer (call $allocate_array (local.get $arr_len)))
    (local.set $source_base (i32.add
      (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (local.set $dest_base (i32.add
      (i32.load (call $abs (i32.add (local.get $copy_pointer) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (local.set $i (i32.const 0))
    (block $copy_done
      (loop $copy_loop
        (br_if $copy_done (i32.ge_u (local.get $i) (local.get $arr_len)))
        (local.set $source_pointer (i32.add (local.get $source_base) (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
        (local.set $dest_pointer (i32.add (local.get $dest_base) (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
        (i32.store (call $abs (local.get $dest_pointer))
          (i32.load (call $abs (local.get $source_pointer))))
        (i32.store (call $abs (i32.add (local.get $dest_pointer) (i32.const 4)))
          (i32.load (call $abs (i32.add (local.get $source_pointer) (i32.const 4)))))
        (i32.store (call $abs (i32.add (local.get $dest_pointer) (i32.const 8)))
          (i32.load (call $abs (i32.add (local.get $source_pointer) (i32.const 8)))))
        (i32.store (call $abs (i32.add (local.get $dest_pointer) (i32.const 12)))
          (i32.load (call $abs (i32.add (local.get $source_pointer) (i32.const 12)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $copy_loop)
      )
    )
    (local.get $copy_pointer)
  )

  ;; copy_typed_array_window(receiver_type, receiver_pointer) → fresh
  ;; descriptor pointer over a fresh zero-offset ArrayBuffer holding the
  ;; receiver's window bytes (subarray receivers copy only the window).
  ;; Byte-wise per element, so BigInt64/BigUint64 lanes copy exactly.
  ;; Caller must have pre-checked estimate_arraybuffer_size(len * bpe) +
  ;; estimate_typed_array_descriptor_size.
  (func $copy_typed_array_window (param $receiver_type i32) (param $receiver_pointer i32) (result i32)
    (local $arr_len i32)
    (local $bytes_per_element i32)
    (local $byte_count i32)
    (local $new_buffer i32)
    (local $source_pointer i32)
    (local $dest_pointer i32)
    (local $j i32)
    (local.set $arr_len (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 8)))))
    (local.set $bytes_per_element (call $get_bytes_per_element (local.get $receiver_type)))
    (local.set $byte_count (i32.mul (local.get $arr_len) (local.get $bytes_per_element)))
    (local.set $new_buffer (call $allocate_arraybuffer (local.get $byte_count)))
    ;; Source bytes: buffer_ptr + 4 (past byteLength) + byte_offset.
    (local.set $source_pointer (call $abs (i32.add
      (i32.add (i32.load (call $abs (local.get $receiver_pointer))) (i32.const 4))
      (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 4)))))))
    (local.set $dest_pointer (call $abs (i32.add (local.get $new_buffer) (i32.const 4))))
    (local.set $j (i32.const 0))
    (block $copy_done
      (loop $copy_loop
        (br_if $copy_done (i32.ge_u (local.get $j) (local.get $byte_count)))
        (i32.store8
          (i32.add (local.get $dest_pointer) (local.get $j))
          (i32.load8_u (i32.add (local.get $source_pointer) (local.get $j))))
        (local.set $j (i32.add (local.get $j) (i32.const 1)))
        (br $copy_loop)
      )
    )
    (call $allocate_typed_array_descriptor
      (local.get $new_buffer) (i32.const 0) (local.get $arr_len))
  )

  (func $array_to_reversed_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $materialize_result i32)
    (local $arr_len i32)
    (local $copy_pointer i32)
    (local $source_base i32)
    (local $dest_base i32)
    (local $i i32)
    (local $source_pointer i32)
    (local $dest_pointer i32)
    (local.set $materialize_result (call $array_method_materialize (local.get $receiver_type) (local.get $receiver_pointer)))
    (if (i32.eq (local.get $materialize_result) (i32.const -1)) (then (return (i32.const 0))))
    (if (i32.eq (local.get $materialize_result) (i32.const -2)) (then (return (i32.const 2))))
    (local.set $receiver_pointer (local.get $materialize_result))
    (local.set $arr_len (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 8)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (call $check_heap_overflow (call $estimate_array_size (local.get $arr_len)))
      (then (return (i32.const 0))))
    (local.set $copy_pointer (call $allocate_array (local.get $arr_len)))
    (local.set $source_base (i32.add
      (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (local.set $dest_base (i32.add
      (i32.load (call $abs (i32.add (local.get $copy_pointer) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (local.set $i (i32.const 0))
    (block $reverse_done
      (loop $reverse_loop
        (br_if $reverse_done (i32.ge_u (local.get $i) (local.get $arr_len)))
        (local.set $source_pointer (i32.add (local.get $source_base) (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
        (local.set $dest_pointer (i32.add (local.get $dest_base)
          (i32.mul (i32.sub (i32.sub (local.get $arr_len) (i32.const 1)) (local.get $i)) (global.get $VALUE_SIZE))))
        (i32.store (call $abs (local.get $dest_pointer))
          (i32.load (call $abs (local.get $source_pointer))))
        (i32.store (call $abs (i32.add (local.get $dest_pointer) (i32.const 4)))
          (i32.load (call $abs (i32.add (local.get $source_pointer) (i32.const 4)))))
        (i32.store (call $abs (i32.add (local.get $dest_pointer) (i32.const 8)))
          (i32.load (call $abs (i32.add (local.get $source_pointer) (i32.const 8)))))
        (i32.store (call $abs (i32.add (local.get $dest_pointer) (i32.const 12)))
          (i32.load (call $abs (i32.add (local.get $source_pointer) (i32.const 12)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $reverse_loop)
      )
    )
    (call $pending_push (global.get $TYPE_ARRAY) (i32.const 0) (local.get $copy_pointer) (i32.const 0))
    (return (i32.const 0))
  )

  (func $array_with_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $argument2_pointer i32)
    (local $materialize_result i32)
    (local $arr_len i32)
    (local $index i32)
    (local $copy_pointer i32)
    (local $dest_pointer i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))))
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then (local.set $argument2_pointer (i32.add (local.get $argument1_pointer) (global.get $VALUE_SIZE)))))
    (local.set $materialize_result (call $array_method_materialize (local.get $receiver_type) (local.get $receiver_pointer)))
    (if (i32.eq (local.get $materialize_result) (i32.const -1)) (then (return (i32.const 0))))
    (if (i32.eq (local.get $materialize_result) (i32.const -2)) (then (return (i32.const 2))))
    (local.set $receiver_pointer (local.get $materialize_result))
    (local.set $arr_len (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 8)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))

    (local.set $index (i32.const 0))
    (if (i32.and (i32.ge_u (local.get $argc) (i32.const 1))
          (call $value_is_numeric (local.get $argument1_pointer)))
      (then (local.set $index (i32.trunc_sat_f64_s (call $value_to_f64 (local.get $argument1_pointer))))))
    (if (i32.lt_s (local.get $index) (i32.const 0))
      (then (local.set $index (i32.add (local.get $arr_len) (local.get $index)))))
    (if (i32.or
          (i32.lt_s (local.get $index) (i32.const 0))
          (i32.ge_s (local.get $index) (local.get $arr_len)))
      (then
        (return (i32.add (i32.const 1) (call $throw_range_error_with_message
          (global.get $BUILTIN_MSG_INVALID_INDEX))))))

    (if (call $check_heap_overflow (call $estimate_array_size (local.get $arr_len)))
      (then (return (i32.const 0))))
    (local.set $copy_pointer (call $copy_array_values (local.get $receiver_pointer) (local.get $arr_len)))
    (local.set $dest_pointer (i32.add
      (i32.add
        (i32.load (call $abs (i32.add (local.get $copy_pointer) (i32.const 16))))
        (global.get $GC_HEADER_SIZE))
      (i32.mul (local.get $index) (global.get $VALUE_SIZE))))
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then
        (call $write_value (local.get $dest_pointer)
          (call $value_type (local.get $argument2_pointer))
          (i32.load (call $abs (i32.add (local.get $argument2_pointer) (i32.const 4))))
          (call $value_data_lo (local.get $argument2_pointer))
          (call $value_data_hi (local.get $argument2_pointer)))
      )
      (else
        (call $write_value (local.get $dest_pointer)
          (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))
      )
    )
    (call $pending_push (global.get $TYPE_ARRAY) (i32.const 0) (local.get $copy_pointer) (i32.const 0))
    (return (i32.const 0))
  )

  (func $array_to_spliced_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $args_base i32)
    (local $argument1_pointer i32)
    (local $argument2_pointer i32)
    (local $materialize_result i32)
    (local $arr_len i32)
    (local $start i32)
    (local $delete_count i32)
    (local $item_count i32)
    (local $new_len i32)
    (local $copy_pointer i32)
    (local $source_base i32)
    (local $dest_base i32)
    (local $i i32)
    (local $write_index i32)
    (local $source_pointer i32)
    (local $dest_pointer i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $args_base (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $argument1_pointer (local.get $args_base))))
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then (local.set $argument2_pointer (i32.add (local.get $argument1_pointer) (global.get $VALUE_SIZE)))))
    (local.set $materialize_result (call $array_method_materialize (local.get $receiver_type) (local.get $receiver_pointer)))
    (if (i32.eq (local.get $materialize_result) (i32.const -1)) (then (return (i32.const 0))))
    (if (i32.eq (local.get $materialize_result) (i32.const -2)) (then (return (i32.const 2))))
    (local.set $receiver_pointer (local.get $materialize_result))
    (local.set $arr_len (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 8)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))

    ;; start: ToIntegerOrInfinity(arg1), negative wraps, clamp [0, len].
    (local.set $start (i32.const 0))
    (if (i32.and (i32.ge_u (local.get $argc) (i32.const 1))
          (call $value_is_numeric (local.get $argument1_pointer)))
      (then (local.set $start (i32.trunc_sat_f64_s (call $value_to_f64 (local.get $argument1_pointer))))))
    (if (i32.lt_s (local.get $start) (i32.const 0))
      (then
        (local.set $start (i32.add (local.get $arr_len) (local.get $start)))
        (if (i32.lt_s (local.get $start) (i32.const 0))
          (then (local.set $start (i32.const 0))))))
    (if (i32.gt_s (local.get $start) (local.get $arr_len))
      (then (local.set $start (local.get $arr_len))))

    ;; deleteCount (per spec): absent both → 0; only start present →
    ;; len - start; else clamp [0, len - start].
    (if (i32.eqz (local.get $argc))
      (then (local.set $delete_count (i32.const 0)))
      (else
        (if (i32.lt_u (local.get $argc) (i32.const 2))
          (then (local.set $delete_count (i32.sub (local.get $arr_len) (local.get $start))))
          (else
            (local.set $delete_count (i32.const 0))
            (if (call $value_is_numeric (local.get $argument2_pointer))
              (then (local.set $delete_count (i32.trunc_sat_f64_s (call $value_to_f64 (local.get $argument2_pointer))))))
            (if (i32.lt_s (local.get $delete_count) (i32.const 0))
              (then (local.set $delete_count (i32.const 0))))
            (if (i32.gt_s (local.get $delete_count) (i32.sub (local.get $arr_len) (local.get $start)))
              (then (local.set $delete_count (i32.sub (local.get $arr_len) (local.get $start)))))
          )
        )
      )
    )

    (local.set $item_count (i32.const 0))
    (if (i32.ge_u (local.get $argc) (i32.const 3))
      (then (local.set $item_count (i32.sub (local.get $argc) (i32.const 2)))))
    (local.set $new_len (i32.add
      (i32.sub (local.get $arr_len) (local.get $delete_count))
      (local.get $item_count)))

    (if (call $check_heap_overflow (call $estimate_array_size (local.get $new_len)))
      (then (return (i32.const 0))))
    (local.set $copy_pointer (call $allocate_array (local.get $new_len)))
    (local.set $source_base (i32.add
      (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (local.set $dest_base (i32.add
      (i32.load (call $abs (i32.add (local.get $copy_pointer) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))

    ;; [0, start) from the source.
    (local.set $write_index (i32.const 0))
    (local.set $i (i32.const 0))
    (block $head_done
      (loop $head_loop
        (br_if $head_done (i32.ge_s (local.get $i) (local.get $start)))
        (local.set $source_pointer (i32.add (local.get $source_base) (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
        (local.set $dest_pointer (i32.add (local.get $dest_base) (i32.mul (local.get $write_index) (global.get $VALUE_SIZE))))
        (call $write_value (local.get $dest_pointer)
          (call $value_type (local.get $source_pointer))
          (i32.load (call $abs (i32.add (local.get $source_pointer) (i32.const 4))))
          (call $value_data_lo (local.get $source_pointer))
          (call $value_data_hi (local.get $source_pointer)))
        (local.set $write_index (i32.add (local.get $write_index) (i32.const 1)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $head_loop)
      )
    )

    ;; Inserted items from the pending-stack args (args 2..argc-1). The
    ;; args are still in place above stack_base — pending was rewound,
    ;; not overwritten.
    (local.set $i (i32.const 0))
    (block $items_done
      (loop $items_loop
        (br_if $items_done (i32.ge_s (local.get $i) (local.get $item_count)))
        (local.set $source_pointer (i32.add (local.get $args_base)
          (i32.mul (i32.add (local.get $i) (i32.const 2)) (global.get $VALUE_SIZE))))
        (local.set $dest_pointer (i32.add (local.get $dest_base) (i32.mul (local.get $write_index) (global.get $VALUE_SIZE))))
        (call $write_value (local.get $dest_pointer)
          (call $value_type (local.get $source_pointer))
          (i32.load (call $abs (i32.add (local.get $source_pointer) (i32.const 4))))
          (call $value_data_lo (local.get $source_pointer))
          (call $value_data_hi (local.get $source_pointer)))
        (local.set $write_index (i32.add (local.get $write_index) (i32.const 1)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $items_loop)
      )
    )

    ;; Tail [start + deleteCount, len) from the source.
    (local.set $i (i32.add (local.get $start) (local.get $delete_count)))
    (block $tail_done
      (loop $tail_loop
        (br_if $tail_done (i32.ge_s (local.get $i) (local.get $arr_len)))
        (local.set $source_pointer (i32.add (local.get $source_base) (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
        (local.set $dest_pointer (i32.add (local.get $dest_base) (i32.mul (local.get $write_index) (global.get $VALUE_SIZE))))
        (call $write_value (local.get $dest_pointer)
          (call $value_type (local.get $source_pointer))
          (i32.load (call $abs (i32.add (local.get $source_pointer) (i32.const 4))))
          (call $value_data_lo (local.get $source_pointer))
          (call $value_data_hi (local.get $source_pointer)))
        (local.set $write_index (i32.add (local.get $write_index) (i32.const 1)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $tail_loop)
      )
    )

    (call $pending_push (global.get $TYPE_ARRAY) (i32.const 0) (local.get $copy_pointer) (i32.const 0))
    (return (i32.const 0))
  )

  ;; toSorted, default form (reached from dispatch_builtin_method — no
  ;; function comparator; the comparator form is intercepted at
  ;; OP_CALL_METHOD and lands in $array_to_sorted_comparator_method).
  ;; Copy, then delegate to $array_sort_method with the copy as the
  ;; receiver: it sorts the copy in place and pushes it. The real argc
  ;; is passed through so the call/apply table path with a function
  ;; comparator degrades exactly like sort does there (pushes
  ;; undefined — the documented wart).
  (func $array_to_sorted_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $materialize_result i32)
    (local $arr_len i32)
    (local $copy_pointer i32)
    (local.set $materialize_result (call $array_method_materialize (local.get $receiver_type) (local.get $receiver_pointer)))
    (if (i32.eq (local.get $materialize_result) (i32.const -1)) (then (return (i32.const 0))))
    (if (i32.eq (local.get $materialize_result) (i32.const -2)) (then (return (i32.const 2))))
    (local.set $receiver_pointer (local.get $materialize_result))
    (local.set $arr_len (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 8)))))
    (if (call $check_heap_overflow (call $estimate_array_size (local.get $arr_len)))
      (then (return (i32.const 0))))
    (local.set $copy_pointer (call $copy_array_values (local.get $receiver_pointer) (local.get $arr_len)))
    (return (call $array_sort_method
      (global.get $TYPE_ARRAY) (local.get $copy_pointer)
      (global.get $METHOD_SORT) (local.get $argc) (local.get $stack_base)))
  )

  ;; toSorted, comparator form (reached only from OP_CALL_METHOD's
  ;; intercept, which guarantees a function comparator). Copy, then
  ;; stage the existing sort continuation against the copy via $sort_method.
  ;; Its ARRAY_SORT kind drives the walk; completion pushes the copy.
  (func $array_to_sorted_comparator_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $materialize_result i32)
    (local $arr_len i32)
    (local $copy_pointer i32)
    (local.set $materialize_result (call $array_method_materialize (local.get $receiver_type) (local.get $receiver_pointer)))
    (if (i32.eq (local.get $materialize_result) (i32.const -1)) (then (return (i32.const 0))))
    (if (i32.eq (local.get $materialize_result) (i32.const -2)) (then (return (i32.const 2))))
    (local.set $receiver_pointer (local.get $materialize_result))
    (local.set $arr_len (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 8)))))
    (if (call $check_heap_overflow (call $estimate_array_size (local.get $arr_len)))
      (then (return (i32.const 0))))
    (local.set $copy_pointer (call $copy_array_values (local.get $receiver_pointer) (local.get $arr_len)))
    (return (call $sort_method
      (global.get $TYPE_ARRAY) (local.get $copy_pointer)
      (global.get $METHOD_SORT) (local.get $argc) (local.get $stack_base)))
  )

  (func $typed_array_to_reversed_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $arr_len i32)
    (local $bytes_per_element i32)
    (local $copy_descriptor i32)
    (local $base_pointer i32)
    (local $i i32)
    (local $j i32)
    (local $left_pointer i32)
    (local $right_pointer i32)
    (local $scratch_byte i32)
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (local.set $arr_len (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 8)))))
    (local.set $bytes_per_element (call $get_bytes_per_element (local.get $receiver_type)))
    (if (call $check_heap_overflow
          (i32.add
            (call $estimate_arraybuffer_size (i32.mul (local.get $arr_len) (local.get $bytes_per_element)))
            (call $estimate_typed_array_descriptor_size)))
      (then (return (i32.const 0))))
    (local.set $copy_descriptor (call $copy_typed_array_window (local.get $receiver_type) (local.get $receiver_pointer)))
    ;; Reverse the copy in place, element-wise byte swaps (exact for
    ;; every lane type including the 8-byte BigInt lanes).
    (local.set $base_pointer (call $abs (i32.add
      (i32.load (call $abs (local.get $copy_descriptor)))
      (i32.const 4))))
    (local.set $i (i32.const 0))
    (block $reverse_done
      (loop $reverse_loop
        (br_if $reverse_done (i32.ge_u
          (i32.add (local.get $i) (i32.const 1))
          (i32.sub (local.get $arr_len) (local.get $i))))
        (local.set $left_pointer (i32.add (local.get $base_pointer)
          (i32.mul (local.get $i) (local.get $bytes_per_element))))
        (local.set $right_pointer (i32.add (local.get $base_pointer)
          (i32.mul (i32.sub (i32.sub (local.get $arr_len) (i32.const 1)) (local.get $i)) (local.get $bytes_per_element))))
        (local.set $j (i32.const 0))
        (block $swap_done
          (loop $swap_loop
            (br_if $swap_done (i32.ge_u (local.get $j) (local.get $bytes_per_element)))
            (local.set $scratch_byte (i32.load8_u (i32.add (local.get $left_pointer) (local.get $j))))
            (i32.store8 (i32.add (local.get $left_pointer) (local.get $j))
              (i32.load8_u (i32.add (local.get $right_pointer) (local.get $j))))
            (i32.store8 (i32.add (local.get $right_pointer) (local.get $j)) (local.get $scratch_byte))
            (local.set $j (i32.add (local.get $j) (i32.const 1)))
            (br $swap_loop)
          )
        )
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $reverse_loop)
      )
    )
    (call $pending_push (local.get $receiver_type) (i32.const 0) (local.get $copy_descriptor) (i32.const 0))
    (return (i32.const 0))
  )

  (func $typed_array_with_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $argument2_pointer i32)
    (local $arr_len i32)
    (local $bytes_per_element i32)
    (local $index i32)
    (local $copy_descriptor i32)
    (local $value_f64 f64)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))))
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then (local.set $argument2_pointer (i32.add (local.get $argument1_pointer) (global.get $VALUE_SIZE)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (local.set $arr_len (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 8)))))
    (local.set $bytes_per_element (call $get_bytes_per_element (local.get $receiver_type)))

    (local.set $index (i32.const 0))
    (if (i32.and (i32.ge_u (local.get $argc) (i32.const 1))
          (call $value_is_numeric (local.get $argument1_pointer)))
      (then (local.set $index (i32.trunc_sat_f64_s (call $value_to_f64 (local.get $argument1_pointer))))))
    (if (i32.lt_s (local.get $index) (i32.const 0))
      (then (local.set $index (i32.add (local.get $arr_len) (local.get $index)))))
    (if (i32.or
          (i32.lt_s (local.get $index) (i32.const 0))
          (i32.ge_s (local.get $index) (local.get $arr_len)))
      (then
        (return (i32.add (i32.const 1) (call $throw_range_error_with_message
          (global.get $BUILTIN_MSG_INVALID_INDEX))))))

    ;; Value coercion mirrors typed fill: numeric → f64, else 0.
    (local.set $value_f64 (f64.const 0))
    (if (i32.and (i32.ge_u (local.get $argc) (i32.const 2))
          (call $value_is_numeric (local.get $argument2_pointer)))
      (then (local.set $value_f64 (call $value_to_f64 (local.get $argument2_pointer)))))

    (if (call $check_heap_overflow
          (i32.add
            (call $estimate_arraybuffer_size (i32.mul (local.get $arr_len) (local.get $bytes_per_element)))
            (call $estimate_typed_array_descriptor_size)))
      (then (return (i32.const 0))))
    (local.set $copy_descriptor (call $copy_typed_array_window (local.get $receiver_type) (local.get $receiver_pointer)))
    (call $write_typed_element (local.get $receiver_type)
      (call $abs (i32.add
        (i32.add (i32.load (call $abs (local.get $copy_descriptor))) (i32.const 4))
        (i32.mul (local.get $index) (local.get $bytes_per_element))))
      (local.get $value_f64))
    (call $pending_push (local.get $receiver_type) (i32.const 0) (local.get $copy_descriptor) (i32.const 0))
    (return (i32.const 0))
  )

  ;; toSorted, typed default form — copy the window, then delegate to
  ;; $typed_array_sort_method with the copy descriptor as the receiver
  ;; (sorts the copy in place, pushes it). Real argc passes through for
  ;; the same table-path degradation as sort.
  (func $typed_array_to_sorted_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $arr_len i32)
    (local $bytes_per_element i32)
    (local $copy_descriptor i32)
    (local.set $arr_len (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 8)))))
    (local.set $bytes_per_element (call $get_bytes_per_element (local.get $receiver_type)))
    (if (call $check_heap_overflow
          (i32.add
            (call $estimate_arraybuffer_size (i32.mul (local.get $arr_len) (local.get $bytes_per_element)))
            (call $estimate_typed_array_descriptor_size)))
      (then (return (i32.const 0))))
    (local.set $copy_descriptor (call $copy_typed_array_window (local.get $receiver_type) (local.get $receiver_pointer)))
    (return (call $typed_array_sort_method
      (local.get $receiver_type) (local.get $copy_descriptor)
      (global.get $METHOD_UINT8ARRAY_SORT) (local.get $argc) (local.get $stack_base)))
  )

  ;; toSorted, typed comparator form (reached only from OP_CALL_METHOD's
  ;; intercept). Copy, then stage the existing typed-array sort continuation
  ;; against the copy. Its TYPED_ARRAY_SORT kind drives the walk and pushes
  ;; the copy.
  (func $typed_array_to_sorted_comparator_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $arr_len i32)
    (local $bytes_per_element i32)
    (local $copy_descriptor i32)
    (local.set $arr_len (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 8)))))
    (local.set $bytes_per_element (call $get_bytes_per_element (local.get $receiver_type)))
    (if (call $check_heap_overflow
          (i32.add
            (call $estimate_arraybuffer_size (i32.mul (local.get $arr_len) (local.get $bytes_per_element)))
            (call $estimate_typed_array_descriptor_size)))
      (then (return (i32.const 0))))
    (local.set $copy_descriptor (call $copy_typed_array_window (local.get $receiver_type) (local.get $receiver_pointer)))
    (return (call $typed_array_sort_comparator_method
      (local.get $receiver_type) (local.get $copy_descriptor)
      (global.get $METHOD_UINT8ARRAY_SORT) (local.get $argc) (local.get $stack_base)))
  )

  ;; flatmap_method — batch 26. Array-only (no Uint8Array mirror exists
  ;; for flatMap). Unlike map/filter, the result container starts at a
  ;; fixed capacity-4 array and grows incrementally via $flat_into /
  ;; $array_push_value (both have their own internal pressure
  ;; handling), so there's no arr_len-sized pressure pre-check here —
  ;; only the fixed initial allocation is pre-checked. The
  ;; OP_RETURN/OP_RETURN_UNDEFINED continuation (flatten one level via
  ;; $flat_into if the callback returned an array, else push directly)
  ;; is already fully generic and untouched.
  (func $flatmap_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $closure_pointer i32)
    (local $mp_addr i32)
    (local $mp_end i32)
    (local $array_pointer i32)
    (local $arr_len i32)
    (local $stack_pointer i32)
    (local $frame_pointer i32)
    (local $start_instr i32)
    (local $param_count i32)
    (local $data_pointer i32)
    (local $element_pointer i32)
    (local $new_data_pointer i32)
    (local $result_lo i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))

    (if (i32.and
          (i32.ne (local.get $receiver_type) (global.get $TYPE_ARRAY))
          (i32.ne (i32.and (local.get $receiver_type) (i32.const 0xff)) (global.get $TYPE_MSGPACK_REF)))
      (then
        (call $set_error (global.get $ERR_TYPE_ERROR) (local.get $receiver_type))
        (return (i32.const 2))
      )
    )

    (if (i32.eq (i32.and (local.get $receiver_type) (i32.const 0xff)) (global.get $TYPE_MSGPACK_REF))
      (then
        (local.set $mp_addr
          (call $msgpack_ref_absolute
            (local.get $receiver_pointer)
            (i32.shr_u (local.get $receiver_type) (i32.const 8))))
        (local.set $mp_end
          (call $msgpack_ref_parent_end (local.get $receiver_pointer)))
        (if (i32.eq
              (call $msgpack_peek_type (local.get $mp_addr) (local.get $mp_end))
              (global.get $MSGPACK_ARRAY))
          (then
            (if (call $check_heap_overflow
                  (call $estimate_array_size (call $msgpack_scratch_count)))
              (then (return (i32.const 0))))
          )
        )
        (local.set $receiver_pointer
          (call $msgpack_to_array (local.get $mp_addr) (local.get $mp_end) (local.get $receiver_pointer)))
        (if (i32.eqz (local.get $receiver_pointer))
          (then
            (if (call $throw_from_set_error)
              (then (return (i32.const 2)))
              (else (return (i32.const 1)))
            )
          )
        )
        (local.set $receiver_type (global.get $TYPE_ARRAY))
      )
    )

    (if (i32.lt_u (local.get $argc) (i32.const 1))
      (then
        (call $set_error (global.get $ERR_ARITY) (i32.const 1))
        (return (i32.const 2))
      )
    )

    (local.set $closure_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
    (if (i32.ne (call $value_type (local.get $closure_pointer)) (global.get $TYPE_FUNCTION))
      (then
        (if (call $throw_type_error_with_type (global.get $BUILTIN_MSG_NOT_A_FUNCTION) (i32.const 0))
          (then (return (i32.const 2)))
          (else (return (i32.const 1)))
        )
      )
    )
    (local.set $closure_pointer (call $value_data_lo (local.get $closure_pointer)))

    (local.set $array_pointer (local.get $receiver_pointer))
    (local.set $arr_len (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 8)))))

    (if (i32.eqz (local.get $arr_len))
      (then
        (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
        (local.set $new_data_pointer (call $allocate_array (i32.const 0)))
        (i32.store (call $abs (i32.add (local.get $new_data_pointer) (i32.const 8))) (i32.const 0))
        (call $pending_push (global.get $TYPE_ARRAY) (i32.const 0) (local.get $new_data_pointer) (i32.const 0))
        (return (i32.const 0))
      )
    )

    ;; Pressure pre-check: fixed capacity-4 initial result array.
    (if (call $check_heap_overflow (call $estimate_array_size (i32.const 4)))
      (then (return (i32.const 0))))
    (local.set $new_data_pointer (call $allocate_array (i32.const 4)))
    (i32.store (call $abs (i32.add (local.get $new_data_pointer) (i32.const 8))) (i32.const 0))
    (local.set $result_lo (local.get $new_data_pointer))

    ;; Push the iteration frame.
    (local.set $stack_pointer (call $read_ctx (global.get $CTX_CALL_STACK_POINTER)))
    (local.set $frame_pointer (call $abs (local.get $stack_pointer)))
    (local.set $param_count (call $callback_staged_argc (local.get $closure_pointer) (i32.const 3)))
    (local.set $start_instr (i32.load (call $abs (i32.add (local.get $closure_pointer) (global.get $FUNCTION_CLOSURE_OFFSET)))))

    (if (call $check_heap_overflow
          (global.get $NATIVE_CONTINUATION_STATE_SIZE))
      (then (return (i32.const 0))))
    (call $publish_native_continuation_frame
      (local.get $frame_pointer) (local.get $stack_pointer)
      (local.get $stack_base) (i32.const 1) (local.get $param_count)
      (i32.const 0) (local.get $arr_len) (local.get $result_lo)
      (call $continuation_kind_from_callback_method (local.get $method_id))
      (local.get $array_pointer) (local.get $closure_pointer)
      (local.get $receiver_type) (i32.const 0))

    ;; Push args: elem, idx, arr (Array-only — no Uint8Array flatMap).
    (local.set $data_pointer (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 16)))))
    (local.set $element_pointer (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE)))
    (if (i32.ge_u (local.get $param_count) (i32.const 1))
      (then
        (call $pending_push
          (call $value_type (local.get $element_pointer))
          (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 4))))
          (call $value_data_lo (local.get $element_pointer))
          (call $value_data_hi (local.get $element_pointer)))
      )
    )
    (if (i32.ge_u (local.get $param_count) (i32.const 2))
      (then (call $push_rational_inline (i64.const 0))))
    (if (i32.ge_u (local.get $param_count) (i32.const 3))
      (then (call $pending_push (global.get $TYPE_ARRAY) (i32.const 0) (local.get $array_pointer) (i32.const 0))))

    (return (global.get $STATUS_NATIVE_CONTINUATION_STAGED))
  )

  ;; generator_self_method — batch 27, task #11's last group (the 9th
  ;; of the plan's original "9 shared-branch groups", GENERATOR_NEXT/
  ;; RETURN/THROW). Unlike the 19 callback methods, generators were
  ;; ALREADY sitting inside dispatch_builtin_method (a $builtin_sig
  ;; function since batches 1-20) — this is a plain mechanical
  ;; extraction-and-register, the same pattern as every earlier batch,
  ;; not the harder $run-frame-push pattern the 19 callback methods
  ;; needed. gen[Symbol.iterator]() just returns the generator itself.
  (func $generator_self_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (call $pending_push (global.get $TYPE_OBJECT) (i32.const 0)
      (local.get $receiver_pointer) (i32.const 0))
    (return (i32.const 0))
  )

  ;; generator_next_return_throw_method — next/return/throw all park
  ;; the caller with a request the airlock consumes:
  ;;   [generatorObjectPointer:4][operation:4]
  ;;   [argType:4][argFlags:4][argLo:4][argHi:4]
  ;; operation: 0 = next, 1 = return, 2 = throw. Return code 4 tells
  ;; $run's dispatch loop the exit condition is prepared — it saves
  ;; pc+1/scope and exits (EXIT_GENERATOR_NEXT). This code path was
  ;; already correct as plain inline dispatch_builtin_method logic
  ;; (receiver_type/receiver_pointer/argc/stack_base are all it needs,
  ;; already part of the standard preamble every extracted function
  ;; reproduces) — moving it here changes nothing behaviorally.
  (func $generator_next_return_throw_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $arg1_type i32)
    (local $arg1_flags i32)
    (local $arg1_lo i32)
    (local $arg1_hi i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $arg1_type (call $value_type (local.get $argument1_pointer)))
        (local.set $arg1_flags (call $value_flags (local.get $argument1_pointer)))
        (local.set $arg1_lo (call $value_data_lo (local.get $argument1_pointer)))
        (local.set $arg1_hi (call $value_data_hi (local.get $argument1_pointer)))
      )
    )

    (if (i32.ne (local.get $receiver_type) (global.get $TYPE_OBJECT))
      (then
        (if (call $throw_type_error)
          (then (return (i32.const 2)))
          (else (return (i32.const 1))))))

    (i32.store (call $abs (global.get $external_request_base))
      (local.get $receiver_pointer))
    (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 4)))
      (select
        (i32.const 0)
        (select
          (i32.const 1)
          (i32.const 2)
          (i32.eq (local.get $method_id) (global.get $METHOD_GENERATOR_RETURN)))
        (i32.eq (local.get $method_id) (global.get $METHOD_GENERATOR_NEXT))))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 8)))
          (local.get $arg1_type))
        (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 12)))
          (local.get $arg1_flags))
        (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 16)))
          (local.get $arg1_lo))
        (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 20)))
          (local.get $arg1_hi))
      )
      (else
        (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 8)))
          (global.get $TYPE_UNDEFINED))
        (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 12)))
          (i32.const 0))
        (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 16)))
          (i32.const 0))
        (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 20)))
          (i32.const 0))
      )
    )
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_GENERATOR_NEXT))
    (return (i32.const 4))
  )

  ;; ==========================================================================
  ;; dispatch_builtin_method
  ;;
  ;; Dispatch a built-in method call (TYPE_BOUND_METHOD).
  ;;
  ;; Parameters:
  ;;   receiver_type: TYPE_ARRAY or TYPE_STRING
  ;;   receiver_pointer: pointer to the receiver (array ptr or string table offset)
  ;;   method_id: which method to call (METHOD_* constant)
  ;;   argc: number of arguments
  ;;   stack_base: position on pending stack where receiver was (for cleanup)
  ;; ==========================================================================
  ;; dispatch_builtin_method returns:
  ;;   0 = normal completion
  ;;   1 = exception caught (caller should reload instruction index and continue)
  ;;   2 = uncaught error (caller should exit)
  (func $dispatch_builtin_method
    (param $receiver_type i32)
    (param $receiver_pointer i32)
    (param $method_id i32)
    (param $argc i32)
    (param $stack_base i32)
    (result i32)

    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $arg1_type i32)
    (local $arg1_flags i32)
    (local $arg1_lo i32)
    (local $arg1_hi i32)
    (local $argument2_pointer i32)
    (local $arg2_type i32)
    (local $arg2_lo i32)
    (local $i32_result i32)
    (local $f64_result f64)
    (local $f64_arg2 f64)
    (local $str_len i32)
    (local $char_code i32)
    (local $byte_pointer i32)
    (local $i i32)
    (local $found i32)
    (local $arr_len i32)
    (local $arr_cap i32)
    (local $data_pointer i32)
    (local $element_pointer i32)
    (local $new_arr i32)
    (local $new_data i32)
    (local $heap_pointer i32)
    (local $new_string_pointer i32)
    (local $string_pointer i32)
    (local $scratch_pointer i32)
    (local $search_len i32)
    (local $search_pointer i32)
    (local $start_idx i32)
    (local $end_idx i32)
    (local $slice_len i32)
    (local $count i32)
    (local $match_pos i32)
    (local $j i32)
    (local $target_len i32)
    (local $pad_len i32)
    (local $fill_pointer i32)
    (local $fill_len i32)
    (local $replacement_pointer i32)
    (local $repl_len i32)
    (local $char_count i32)
    (local $start_byte i32)
    (local $end_byte i32)
    (local $argument_pointer i32)
    (local $arg_type i32)
    (local $code_point i32)
    (local $dest i32)
    (local $object_pointer i32)
    (local $entries_pointer i32)
    (local $entry_pointer i32)
    (local $key_offset i32)
    (local $array_pointer i32)
    (local $source_pointer i32)
    (local $src_count i32)
    (local $src_entries i32)
    (local $val_type i32)
    (local $val_flags i32)
    (local $val_lo i32)
    (local $val_hi i32)
    (local $actual_receiver_type i32)
    (local $actual_receiver_pointer i32)
    (local $argument3_pointer i32)
    (local $arg3_type i32)
    (local $arg3_lo i32)
    (local $result_i64 i64)
    (local $result_f64 f64)
    (local $bytes_per_element i32)
    ;; Slice 3 (built-in iterator NEXT methods): scratch locals for reading
    ;; the iterator's @buffer slot (the original typed-array value's type
    ;; tag + descriptor pointer) and computing the f64 element bits.
    (local $iter_type i32)
    (local $iter_i64 i64)
    ;; Slice 5 (msgpack stream-processor pre-checks): scratch local for the
    ;; peeked msgpack type tag.
    (local $msgpack_type i32)

    ;; Get argument pointers if present
    ;; JS args are pushed left-to-right, so first JS arg is deepest on stack
    ;; For argc=1: arg1 is at pending_pointer - VALUE_SIZE
    ;; For argc=2: arg1 is at pending_pointer - 2*VALUE_SIZE, arg2 is at pending_pointer - VALUE_SIZE
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))

    ;; arg1 (first JS argument)
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        ;; arg1 is at pending_pointer - argc * VALUE_SIZE (deepest)
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer)
          (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $arg1_type (call $value_type (local.get $argument1_pointer)))
        (local.set $arg1_flags (call $value_flags (local.get $argument1_pointer)))
        (local.set $arg1_lo (call $value_data_lo (local.get $argument1_pointer)))
        (local.set $arg1_hi (call $value_data_hi (local.get $argument1_pointer)))
      )
    )

    ;; arg2 (second JS argument)
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then
        ;; arg2 is at argument1_pointer + VALUE_SIZE (one above arg1)
        (local.set $argument2_pointer (i32.add (local.get $argument1_pointer) (global.get $VALUE_SIZE)))
        (local.set $arg2_type (call $value_type (local.get $argument2_pointer)))
        (local.set $arg2_lo (call $value_data_lo (local.get $argument2_pointer)))
      )
    )

    ;; arg3 (third JS argument)
    (if (i32.ge_u (local.get $argc) (i32.const 3))
      (then
        ;; arg3 is at argument2_pointer + VALUE_SIZE
        (local.set $argument3_pointer (i32.add (local.get $argument2_pointer) (global.get $VALUE_SIZE)))
        (local.set $arg3_type (call $value_type (local.get $argument3_pointer)))
        (local.set $arg3_lo (call $value_data_lo (local.get $argument3_pointer)))
      )
    )

    ;; Dispatch based on receiver type and method ID

    ;; RegExp exec/test and the step-5 string-method/iterator ids never
    ;; dispatch here — their fuel-resumable steps run inline in
    ;; CALL/CALL_METHOD. A call routed through this fuelless path
    ;; (Function.prototype.call/apply on the bound method) cannot pause,
    ;; so it fails loud instead of silently returning undefined through
    ;; the unknown-method fallback. (SPLIT/REPLACE/REPLACE_ALL are NOT
    ;; here: their string-argument forms legitimately dispatch fuelless;
    ;; the regexp-argument forms only arise through the inline arms.)
    (if (i32.or
          (i32.or
            (i32.eq (local.get $method_id) (global.get $METHOD_REGEXP_EXEC))
            (i32.eq (local.get $method_id) (global.get $METHOD_REGEXP_TEST)))
          (i32.or
            (i32.or
              (i32.eq (local.get $method_id) (global.get $METHOD_STRING_MATCH))
              (i32.eq (local.get $method_id) (global.get $METHOD_STRING_MATCH_ALL)))
            (i32.or
              (i32.eq (local.get $method_id) (global.get $METHOD_STRING_SEARCH))
              (i32.eq (local.get $method_id) (global.get $METHOD_REGEXP_STRING_ITERATOR_NEXT)))))
      (then
        (if (call $raise_error
              (global.get $ERR_NOT_SUPPORTED)
              (global.get $NOT_SUPPORTED_FEATURE_REGEXP))
          (then (return (i32.const 2)))
          (else (return (i32.const 1))))))
    ;; Schema's fuel-carrying arms likewise only dispatch inline.
    (if (i32.or (call $is_schema_inline_method (local.get $method_id))
                (i32.eq (local.get $method_id) (global.get $METHOD_SCHEMA_CONSTRUCTOR)))
      (then
        (if (call $raise_error
              (global.get $ERR_NOT_SUPPORTED)
              (global.get $NOT_SUPPORTED_FEATURE_SCHEMA))
          (then (return (i32.const 2)))
          (else (return (i32.const 1))))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_SCHEMA_IS_SCHEMA))
      (then (return (call $schema_is_schema_method (local.get $receiver_type) (local.get $receiver_pointer)
                          (local.get $method_id) (local.get $argc) (local.get $stack_base)))))

    ;; ============================================
    ;; Built-in iterator .next() methods (slice 3).
    ;; Dispatch by method ID alone; receiver is always TYPE_OBJECT (the
    ;; iterator object) but method-id uniqueness lets us bypass the
    ;; receiver-type cascade. Each iterator object was built by the
    ;; matching factory with a fixed property layout: slot 0 holds the
    ;; receiver-specific source (array, string, or buffer), slot 1 holds
    ;; the current index/byteOffset, slot 2 is the bound `next` method.
    ;; ============================================

    ;; ============================================
    ;; Map / Set instance methods — migrated to the dispatch table
    ;; (batch 2). Each of these ids
    ;; is registered in $builtin_table; called directly here (not via
    ;; $dispatch_via_table's null-check) since this call site already
    ;; knows unconditionally that they are migrated.
    (if (i32.eq (local.get $method_id) (global.get $METHOD_MAP_GET))
      (then (return (call $map_get (local.get $receiver_type) (local.get $receiver_pointer) (local.get $method_id) (local.get $argc) (local.get $stack_base)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_MAP_HAS))
      (then (return (call $map_has (local.get $receiver_type) (local.get $receiver_pointer) (local.get $method_id) (local.get $argc) (local.get $stack_base)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_MAP_SET))
      (then (return (call $map_set_method (local.get $receiver_type) (local.get $receiver_pointer) (local.get $method_id) (local.get $argc) (local.get $stack_base)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_MAP_DELETE))
      (then (return (call $map_delete_method (local.get $receiver_type) (local.get $receiver_pointer) (local.get $method_id) (local.get $argc) (local.get $stack_base)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_MAP_CLEAR))
      (then (return (call $map_clear_method (local.get $receiver_type) (local.get $receiver_pointer) (local.get $method_id) (local.get $argc) (local.get $stack_base)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_ITERATOR_RETURN_SELF))
      (then (return (call $iterator_return_self (local.get $receiver_type) (local.get $receiver_pointer) (local.get $method_id) (local.get $argc) (local.get $stack_base)))))
    (if (i32.or
          (i32.eq (local.get $method_id) (global.get $METHOD_MAP_KEYS))
          (i32.or
            (i32.eq (local.get $method_id) (global.get $METHOD_MAP_VALUES))
            (i32.eq (local.get $method_id) (global.get $METHOD_MAP_ENTRIES_M))))
      (then (return (call $map_iterator_factory (local.get $receiver_type) (local.get $receiver_pointer) (local.get $method_id) (local.get $argc) (local.get $stack_base)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_MAP_ITERATOR_NEXT))
      (then (return (call $map_iterator_next_method (local.get $receiver_type) (local.get $receiver_pointer) (local.get $method_id) (local.get $argc) (local.get $stack_base)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_SET_HAS))
      (then (return (call $set_has (local.get $receiver_type) (local.get $receiver_pointer) (local.get $method_id) (local.get $argc) (local.get $stack_base)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_SET_ADD))
      (then (return (call $set_add_method (local.get $receiver_type) (local.get $receiver_pointer) (local.get $method_id) (local.get $argc) (local.get $stack_base)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_SET_DELETE))
      (then (return (call $set_delete_method (local.get $receiver_type) (local.get $receiver_pointer) (local.get $method_id) (local.get $argc) (local.get $stack_base)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_SET_CLEAR))
      (then (return (call $set_clear_method (local.get $receiver_type) (local.get $receiver_pointer) (local.get $method_id) (local.get $argc) (local.get $stack_base)))))
    (if (i32.or
          (i32.eq (local.get $method_id) (global.get $METHOD_SET_VALUES))
          (i32.eq (local.get $method_id) (global.get $METHOD_SET_ENTRIES_M)))
      (then (return (call $set_iterator_factory (local.get $receiver_type) (local.get $receiver_pointer) (local.get $method_id) (local.get $argc) (local.get $stack_base)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_SET_ITERATOR_NEXT))
      (then (return (call $set_iterator_next_method (local.get $receiver_type) (local.get $receiver_pointer) (local.get $method_id) (local.get $argc) (local.get $stack_base)))))
    (if (i32.or
          (i32.or
            (i32.eq (local.get $method_id) (global.get $METHOD_SET_UNION))
            (i32.or
              (i32.eq (local.get $method_id) (global.get $METHOD_SET_INTERSECTION))
              (i32.eq (local.get $method_id) (global.get $METHOD_SET_DIFFERENCE))))
          (i32.or
            (i32.eq (local.get $method_id) (global.get $METHOD_SET_SYMMETRIC_DIFFERENCE))
            (i32.or
              (i32.eq (local.get $method_id) (global.get $METHOD_SET_IS_SUBSET_OF))
              (i32.or
