                            (local.set $entry_pointer (call $object_find_symbol_entry
                              (local.get $object_pointer)
                              (call $read_state (global.get $STATE_WELL_KNOWN_ITERATOR_SYMBOL))))
                            (if (call $entry_value_is_function (local.get $entry_pointer))
                              (then
                                (local.set $closure_pointer
                                  (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 12)))))
                                ;; Pre-check: empty collection only; per-entry
                                ;; growth is pressure-checked in the RETURN
                                ;; continuation (iterable length is unknown).
                                ;; Nothing is popped or written yet, so the
                                ;; yield retries this OP_NEW cleanly.
                                (if (call $check_heap_overflow
                                      (call $estimate_collection_size (global.get $MAP_SLOT_STRIDE) (i32.const 4)))
                                  (then
                                    (call $new_pressure_restore_pending (local.get $opcode) (local.get $pending_pointer) (local.get $new_packed_pending) (local.get $new_spread_array_pointer))
                                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                                    (br $exit)))
                                (local.set $heap_pointer (call $allocate_collection
                                  (global.get $OBJ_MAP) (global.get $OBJ_MAP_ENTRIES)
                                  (global.get $MAP_SLOT_STRIDE) (i32.const 4)))
                                ;; The finished Map lands at the constructor's
                                ;; slot (the seeding frame's pending base).
