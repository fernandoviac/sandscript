  (global $EXIT_PROMISE_SETTLE i32 (i32.const 14))
  ;; Memory-pressure yield: the executing instruction needed to allocate
  ;; in the string table (or the heap-tail scratch used for concat) and
  ;; the bounds check would have overflowed. The instruction yields
  ;; WITHOUT consuming its operands and WITHOUT advancing the
  ;; instruction pointer, so on resume the slot retries the same op.
  ;; The host's responsibility is to decide whether to garbage-collect
  ;; and resume, or treat the yield as fatal. The interpreter never
  ;; collects on its own.
  (global $EXIT_MEMORY_PRESSURE i32 (i32.const 15))
  ;; Free-span floor for the dispatcher's per-instruction heap-slack
  ;; safepoint: execution yields
  ;; EXIT_MEMORY_PRESSURE whenever code_pointer - heap_pointer drops
  ;; below this, so bump-then-write carves bounded by one instruction's
  ;; burst can never reach the code block. The value must exceed the
  ;; worst FIXED-shape per-instruction carve total (scopes, error
  ;; objects, promises, expression nodes — hundreds of bytes each);
  ;; 64KB is generous for those while costing only the heap's top 64KB
  ;; as a permanent red zone. Size-parametrized carves larger than this
  ;; per instruction still need per-site guards.
  (global $HEAP_SLACK_HEADROOM i32 (i32.const 65536))
  ;; Member-assignment on an external handle (`external.prop = v`). The host
  ;; runs a registered setter; fire-and-forget from the drone's view (the
  ;; assignment resumes with the assigned value). Write-side twin of
  ;; EXIT_EXTERNAL_PROPERTY (13).
  (global $EXIT_EXTERNAL_PROPERTY_SET i32 (i32.const 16))
  ;; A generator is a parked context
  ;; driven by its generator object's next/return/throw methods.
  (global $EXIT_GENERATOR_CALL i32 (i32.const 17))
  (global $EXIT_GENERATOR_NEXT i32 (i32.const 18))
  (global $EXIT_GENERATOR_YIELD i32 (i32.const 19))
  (global $EXIT_GENERATOR_COMPLETE i32 (i32.const 20))
  (global $EXIT_GENERATOR_THROW i32 (i32.const 21))

  ;; External class links and
  ;; instanceof against a TYPE_EXTERNAL need membrane state (constructible
  ;; registration, surrogate binding) the interpreter cannot read. Both
  ;; yield with the SAME pc; the airlock stages the surrogate pointer in
  ;; the per-context request block and resumes the instruction. No
  ;; host/capability code runs.
  (global $EXIT_CLASS_LINK_EXTERNAL i32 (i32.const 22))
  (global $EXIT_INSTANCEOF_EXTERNAL i32 (i32.const 23))
  ;; Branded-instance forwarding (D5): string-key presence probes and
  ;; deletes against the backing external value.
  (global $EXIT_EXTERNAL_HAS_PROPERTY i32 (i32.const 24))
  (global $EXIT_EXTERNAL_DELETE_PROPERTY i32 (i32.const 25))

  ;; extends-externals D3: per-context construction state.
  ;; CTX_CONSTRUCTION_DUTY holds the HEAP header pointer of a branded
  ;; receiver whose abortConstruction is owed (0 = none). Staged by the
  ;; unwind walk / different-object validation, drained at the dispatch
  ;; loop head, chained through the receivers' own @constructionLink
  ;; hidden entries (LIFO). A GC root in both collectors.

  ;; Response type (host → interpreter, input)
  (global $RESPONSE_NORMAL i32 (i32.const 0))
  (global $RESPONSE_THROW i32 (i32.const 1))
  ;; Resume with a RETURN completion: the prepared value is on the
  ;; pending stack; run() enters at the sentinel RETURN so the v11
  ;; return walk runs finallys (generator.return()).
  (global $RESPONSE_RETURN i32 (i32.const 2))

  ;; Error codes
  (global $ERR_NONE i32 (i32.const 0))
  (global $ERR_UNDEFINED_VARIABLE i32 (i32.const 1))
  (global $ERR_ASSIGN_UNDEFINED i32 (i32.const 2))
  (global $ERR_NOT_CALLABLE i32 (i32.const 3))
  (global $ERR_NOT_ITERABLE i32 (i32.const 4))
  (global $ERR_PROPERTY_NULL i32 (i32.const 5))
