              (else
                (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (i32.const 0) (i32.const 0))
              )
            )
            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        (if (i32.eq (local.get $opcode) (global.get $OP_LT))
          (then
            (local.set $value_pointer2 (call $pending_pop))
            (local.set $value_pointer (call $pending_pop))
            (local.set $type1 (call $value_type (local.get $value_pointer)))
            (local.set $type2 (call $value_type (local.get $value_pointer2)))

            ;; AlgebraicNumber comparison (Ring 6d): exact three-way
            ;; compare; pressure restores the popped operands and
            ;; yields for the gc-retry.
            (if (call $algebraic_pair_dispatchable (local.get $type1) (local.get $type2))
              (then
                (local.set $result_i32 (call $algebraic_operator_compare
                  (local.get $value_pointer) (local.get $value_pointer2)))
                (if (i32.eq (local.get $result_i32) (i32.const -2))
                  (then
                    (call $write_ctx (global.get $CTX_PENDING_POINTER)
                      (i32.add (local.get $value_pointer)
                        (i32.mul (global.get $VALUE_SIZE) (i32.const 2))))
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)))
                (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0)
                  (i32.lt_s (local.get $result_i32) (i32.const 0))
                  (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)))

            ;; BigInt < BigInt
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_BIGINT))
                  (i32.eq (local.get $type2) (global.get $TYPE_BIGINT)))
              (then
                (call $pending_push
                  (global.get $TYPE_BOOLEAN) (i32.const 0)
                  (i32.lt_s (call $bigint_compare
                    (call $value_data_lo (local.get $value_pointer))
                    (call $value_data_lo (local.get $value_pointer2)))
                    (i32.const 0))
                  (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
