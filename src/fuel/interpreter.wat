        (local.set $argument2_pointer (i32.add (local.get $argument1_pointer) (global.get $VALUE_SIZE)))))
    (if (i32.ge_u (local.get $argc) (i32.const 3))
      (then
        (local.set $argument3_pointer (i32.add (local.get $argument2_pointer) (global.get $VALUE_SIZE)))))
    (local.set $materialize_result (call $array_method_materialize (local.get $receiver_type) (local.get $receiver_pointer)))
    (if (i32.eq (local.get $materialize_result) (i32.const -1)) (then (return (i32.const 0))))
    (if (i32.eq (local.get $materialize_result) (i32.const -2)) (then (return (i32.const 2))))
    (local.set $receiver_pointer (local.get $materialize_result))
    (local.set $arr_len (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 8)))))
    (local.set $data_pointer (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 16)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))

    (if (call $array_is_frozen (local.get $receiver_pointer))
      (then
        (if (call $throw_type_error_with_type (global.get $BUILTIN_MSG_FROZEN_OBJECT) (i32.const 0))
          (then (return (i32.const 2)))
          (else (return (i32.const 1)))
        )
      )
    )
    (if (call $value_is_numeric (local.get $argument1_pointer))
      (then (local.set $i32_result (i32.trunc_sat_f64_s (call $value_to_f64 (local.get $argument1_pointer)))))
      (else (local.set $i32_result (i32.const 0)))
    )
    (if (i32.lt_s (local.get $i32_result) (i32.const 0))
      (then
        (local.set $i32_result (i32.add (local.get $arr_len) (local.get $i32_result)))
        (if (i32.lt_s (local.get $i32_result) (i32.const 0))
          (then (local.set $i32_result (i32.const 0))))
      )
    )
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then
        (if (call $value_is_numeric (local.get $argument2_pointer))
          (then (local.set $start_idx (i32.trunc_sat_f64_s (call $value_to_f64 (local.get $argument2_pointer)))))
          (else (local.set $start_idx (i32.const 0)))
        )
        (if (i32.lt_s (local.get $start_idx) (i32.const 0))
          (then
            (local.set $start_idx (i32.add (local.get $arr_len) (local.get $start_idx)))
            (if (i32.lt_s (local.get $start_idx) (i32.const 0))
              (then (local.set $start_idx (i32.const 0))))
          )
        )
      )
      (else (local.set $start_idx (i32.const 0)))
    )
    (if (i32.ge_u (local.get $argc) (i32.const 3))
      (then
        (if (call $value_is_numeric (local.get $argument3_pointer))
          (then (local.set $end_idx (i32.trunc_sat_f64_s (call $value_to_f64 (local.get $argument3_pointer)))))
          (else (local.set $end_idx (local.get $arr_len)))
        )
        (if (i32.lt_s (local.get $end_idx) (i32.const 0))
          (then
            (local.set $end_idx (i32.add (local.get $arr_len) (local.get $end_idx)))
            (if (i32.lt_s (local.get $end_idx) (i32.const 0))
              (then (local.set $end_idx (i32.const 0))))
          )
        )
      )
      (else (local.set $end_idx (local.get $arr_len)))
    )
    (if (i32.gt_s (local.get $i32_result) (local.get $arr_len))
      (then (local.set $i32_result (local.get $arr_len))))
    (if (i32.gt_s (local.get $start_idx) (local.get $arr_len))
      (then (local.set $start_idx (local.get $arr_len))))
    (if (i32.gt_s (local.get $end_idx) (local.get $arr_len))
      (then (local.set $end_idx (local.get $arr_len))))
    (local.set $count (i32.sub (local.get $end_idx) (local.get $start_idx)))
    (if (i32.lt_s (local.get $count) (i32.const 0))
      (then (local.set $count (i32.const 0))))
    (if (i32.gt_s (local.get $count) (i32.sub (local.get $arr_len) (local.get $i32_result)))
      (then (local.set $count (i32.sub (local.get $arr_len) (local.get $i32_result)))))
    (if (i32.and
          (i32.gt_s (local.get $i32_result) (local.get $start_idx))
          (i32.lt_s (local.get $i32_result) (i32.add (local.get $start_idx) (local.get $count))))
      (then
        (local.set $i (i32.sub (local.get $count) (i32.const 1)))
        (block $cw_done
          (loop $cw_loop
            (br_if $cw_done (i32.lt_s (local.get $i) (i32.const 0)))
            (local.set $element_pointer (i32.add
              (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
              (i32.mul (i32.add (local.get $start_idx) (local.get $i)) (global.get $VALUE_SIZE))))
            (local.set $string_pointer (i32.add
              (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
              (i32.mul (i32.add (local.get $i32_result) (local.get $i)) (global.get $VALUE_SIZE))))
            (i32.store (call $abs (local.get $string_pointer))
              (i32.load (call $abs (local.get $element_pointer))))
            (i32.store (call $abs (i32.add (local.get $string_pointer) (i32.const 4)))
              (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 4)))))
            (i32.store (call $abs (i32.add (local.get $string_pointer) (i32.const 8)))
              (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 8)))))
            (i32.store (call $abs (i32.add (local.get $string_pointer) (i32.const 12)))
              (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 12)))))
            (local.set $i (i32.sub (local.get $i) (i32.const 1)))
            (br $cw_loop)
