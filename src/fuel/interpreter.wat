                        (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_INSTRUCTION_INDEX))
                          (i32.add (local.get $pc) (i32.const 1)))
                        (local.set $pc
                          (call $enter_staged_native_continuation_callback
                            (local.get $frame_pointer)))
                        (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                        (br $loop)
                      )
                    )
                    (if (i32.eq (local.get $result_i32) (i32.const 2))
                      (then
                        (if (global.get $throw_already_searched)
                          (then
                            (global.set $throw_already_searched (i32.const 0))
                            (br $exit)))
                        (if (call $throw_from_set_error) (then (br $exit)))
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop)
