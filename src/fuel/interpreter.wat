  (global $BUILTIN_MSG_SCHEMA_SOURCE i32 (i32.const 0x73C))
  (global $BUILTIN_MSG_SCHEMA_OPTIONS i32 (i32.const 0x740))
  (global $BUILTIN_MSG_SCHEMA_RECEIVER i32 (i32.const 0x744))
  (global $BUILTIN_MSG_SCHEMA_ASSERT i32 (i32.const 0x748))
  (global $BUILTIN_MSG_SCHEMA_INVALID i32 (i32.const 0x74C))
  (global $BUILTIN_MSG_SCHEMA_BUNDLE i32 (i32.const 0x750))
  (global $BUILTIN_MSG_SCHEMA_LIMIT i32 (i32.const 0x754))
  ;; Former diagnostic fragment slots 0x758..0x7E0 remain reserved in the
