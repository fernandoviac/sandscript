                ;; callback and skip this block — idempotent) all run
                ;; unchanged. reduce/reduceRight (their arg2 is the initial
                ;; value!) and sort (no thisArg in spec) are excluded.
                (if (i32.and
                      (i32.and
                        (i32.or
                          (i32.and
                            (call $is_indexed_collection_callback_method (local.get $method_id))
                            (i32.and
                              (i32.and
                                (i32.and (i32.ne (local.get $method_id) (global.get $METHOD_REDUCE)) (i32.ne (local.get $method_id) (global.get $METHOD_ARRAY_REDUCE_RIGHT)))
                                (i32.ne (local.get $method_id) (global.get $METHOD_UINT8ARRAY_REDUCE)))
                              (i32.and
