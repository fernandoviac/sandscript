  (global $CONTINUATION_KIND_ARRAY_SORT i32 (i32.const 0x14))
  (global $CONTINUATION_KIND_ARRAY_FLAT_MAP i32 (i32.const 0x16))
  (global $CONTINUATION_KIND_TYPED_ARRAY_FOR_EACH i32 (i32.const 0x117))
  (global $CONTINUATION_KIND_TYPED_ARRAY_MAP i32 (i32.const 0x118))
