      (then (return (i32.const 0))))
    (call $pending_push (global.get $TYPE_STRING) (i32.const 0) (local.get $key_offset) (i32.const 0))
    (return (i32.const 0))
  )

  (func $typed_array_at
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $count i32)
    (local $i i32)
    (local $element_pointer i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (i32.or
          (i32.eq (local.get $receiver_type) (global.get $TYPE_BIGINT64ARRAY))
          (i32.eq (local.get $receiver_type) (global.get $TYPE_BIGUINT64ARRAY)))
      (then
        (if (call $check_heap_overflow (call $estimate_bigint_size (i32.const 2)))
          (then (return (i32.const 0))))))
    (local.set $count (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 8)))))
    (local.set $i (i32.const 0))
    (if (i32.and (i32.ge_u (local.get $argc) (i32.const 1))
          (call $value_is_numeric (local.get $argument1_pointer)))
      (then (local.set $i (i32.trunc_sat_f64_s (call $value_to_f64 (local.get $argument1_pointer))))))
    (if (i32.lt_s (local.get $i) (i32.const 0))
      (then (local.set $i (i32.add (local.get $i) (local.get $count)))))
    (if (i32.or (i32.lt_s (local.get $i) (i32.const 0)) (i32.ge_s (local.get $i) (local.get $count)))
      (then
        (call $pending_push (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))
        (return (i32.const 0))))
    (local.set $element_pointer (call $abs (i32.add
      (i32.add
        (i32.add (i32.load (call $abs (local.get $receiver_pointer))) (i32.const 4))
        (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 4)))))
      (i32.mul (local.get $i) (call $get_bytes_per_element (local.get $receiver_type))))))
    (if (i32.or
          (i32.eq (local.get $receiver_type) (global.get $TYPE_BIGINT64ARRAY))
          (i32.eq (local.get $receiver_type) (global.get $TYPE_BIGUINT64ARRAY)))
      (then
        (call $pending_push (global.get $TYPE_BIGINT) (i32.const 0)
          (call $bigint_from_typed_i64 (local.get $receiver_type) (local.get $element_pointer))
          (i32.const 0)))
      (else
        (call $push_f64 (call $read_typed_element (local.get $receiver_type) (local.get $element_pointer)))))
    (return (i32.const 0))
  )

  (func $array_from_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $arg1_type i32)
    (local $arg1_lo i32)
    (local $arg1_hi i32)
    (local $count i32)
    (local $new_arr i32)
    (local $new_data i32)
    (local $entries_pointer i32)
    (local $i i32)
    (local $element_pointer i32)
    (local $entry_pointer i32)
    (local $string_pointer i32)
    (local $str_len i32)
    (local $char_count i32)
    (local $byte_pointer i32)
    (local $slice_len i32)
    (local $char_id i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $arg1_type (call $value_type (local.get $argument1_pointer)))
        (local.set $arg1_lo (call $value_data_lo (local.get $argument1_pointer)))
        (local.set $arg1_hi (call $value_data_hi (local.get $argument1_pointer)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))

    (if (i32.eq (local.get $arg1_type) (global.get $TYPE_ARRAY))
      (then
        (local.set $count (i32.load (call $abs (i32.add (local.get $arg1_lo) (i32.const 8)))))
        (if (call $check_heap_overflow
              (call $estimate_array_size (local.get $count)))
          (then (return (i32.const 0))))
      )
      (else
        (if (call $check_heap_overflow (call $estimate_array_size (i32.const 0)))
          (then (return (i32.const 0))))
      )
    )

    (if (i32.eq (local.get $arg1_type) (global.get $TYPE_ARRAY))
      (then
        (local.set $new_arr (call $allocate_array (local.get $count)))
        (local.set $new_data (i32.load (call $abs (i32.add (local.get $new_arr) (i32.const 16)))))
        (local.set $entries_pointer (i32.load (call $abs (i32.add (local.get $arg1_lo) (i32.const 16)))))

        (local.set $i (i32.const 0))
        (block $copy_done
          (loop $copy_loop
            (br_if $copy_done (i32.ge_u (local.get $i) (local.get $count)))
            (local.set $element_pointer (i32.add
              (i32.add (local.get $entries_pointer) (global.get $GC_HEADER_SIZE))
              (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
            (local.set $entry_pointer (i32.add
              (i32.add (local.get $new_data) (global.get $GC_HEADER_SIZE))
              (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
            (i32.store (call $abs (local.get $entry_pointer))
              (i32.load (call $abs (local.get $element_pointer))))
            (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 4)))
              (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 4)))))
            (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 8)))
              (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 8)))))
            (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 12)))
              (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 12)))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $copy_loop)
          )
        )
        (call $pending_push (global.get $TYPE_ARRAY) (i32.const 0) (local.get $new_arr) (i32.const 0))
        (return (i32.const 0))
      )
    )

    (if (i32.eq (local.get $arg1_type) (global.get $TYPE_MSGPACK_REF))
      (then
        (if (i32.eq
              (call $msgpack_peek_type
                (call $msgpack_ref_absolute (local.get $arg1_lo) (local.get $arg1_hi))
                (call $msgpack_ref_parent_end (local.get $arg1_lo)))
              (global.get $MSGPACK_ARRAY))
          (then
            (if (call $check_heap_overflow
                  (call $estimate_array_size (call $msgpack_scratch_count)))
              (then (return (i32.const 0))))
            (local.set $new_arr (call $msgpack_to_array
              (call $msgpack_ref_absolute (local.get $arg1_lo) (local.get $arg1_hi))
              (call $msgpack_ref_parent_end (local.get $arg1_lo))
              (local.get $arg1_lo)))
          )
          (else
            (if (call $check_heap_overflow (call $estimate_array_size (i32.const 0)))
              (then (return (i32.const 0))))
            (local.set $new_arr (call $allocate_array (i32.const 0)))
          )
        )
        (call $pending_push (global.get $TYPE_ARRAY) (i32.const 0) (local.get $new_arr) (i32.const 0))
        (return (i32.const 0))
      )
    )

    (if (i32.eq (local.get $arg1_type) (global.get $TYPE_STRING))
      (then
        (local.set $string_pointer (call $string_id_to_seg (local.get $arg1_lo)))
        (local.set $str_len (i32.load (call $abs (local.get $string_pointer))))
        (local.set $char_count (call $utf8_char_count (local.get $arg1_lo)))
        (if (call $check_heap_overflow (call $estimate_array_size (local.get $char_count)))
          (then (return (i32.const 0))))
        (local.set $new_arr (call $allocate_array (local.get $char_count)))
        (i32.store (call $abs (i32.add (local.get $new_arr) (i32.const 8))) (local.get $char_count))
        (local.set $new_data (i32.load (call $abs (i32.add (local.get $new_arr) (i32.const 16)))))
        (local.set $i (i32.const 0))
        (local.set $byte_pointer (i32.const 0))
        (block $sf_done
          (loop $sf_loop
            (br_if $sf_done (i32.ge_u (local.get $i) (local.get $char_count)))
            (local.set $slice_len (call $utf8_char_byte_len (local.get $string_pointer) (local.get $byte_pointer)))
            ;; Intern the char directly from the source string's bytes —
            ;; the $string_iterator_next_method pattern. Dedups, and the
            ;; capacity check lives in $intern_string.
            (local.set $char_id (call $intern_string
              (call $abs (i32.add
                (i32.add (local.get $string_pointer) (i32.const 4))
                (local.get $byte_pointer)))
              (local.get $slice_len)))
            (if (global.get $memory_pressure_signaled)
              (then (return (i32.const 0))))
            (local.set $entry_pointer (i32.add
              (i32.add (local.get $new_data) (global.get $GC_HEADER_SIZE))
              (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
            (i32.store (call $abs (local.get $entry_pointer)) (global.get $TYPE_STRING))
            (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 4))) (i32.const 0))
            (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 8)))
              (local.get $char_id))
            (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 12))) (i32.const 0))
            (local.set $byte_pointer (i32.add (local.get $byte_pointer) (local.get $slice_len)))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $sf_loop)
          )
        )
        (call $pending_push (global.get $TYPE_ARRAY) (i32.const 0) (local.get $new_arr) (i32.const 0))
        (return (i32.const 0))
      )
    )

    (local.set $new_arr (call $allocate_array (i32.const 0)))
    (i32.store (call $abs (i32.add (local.get $new_arr) (i32.const 8))) (i32.const 0))
    (call $pending_push (global.get $TYPE_ARRAY) (i32.const 0) (local.get $new_arr) (i32.const 0))
    (return (i32.const 0))
  )

  ;; Batch 16: Array instance methods + array/typed-array/string iterator
  ;; .next() methods. Hex values verified against each METHOD_* global's
  ;; own declaration.
  ;;
  ;; Every ARRAY-instance method shares this preamble in the original
  ;; inline code: if the receiver is a msgpack array ref, materialize it
  ;; to a real TYPE_ARRAY first (reassigning receiver_type/receiver_pointer
  ;; in place — WAT params are just mutable locals), then read
  ;; arr_len/arr_cap/data_pointer from the (possibly-reassigned) receiver.
  ;; Reproduced verbatim in each extracted function below.

  (func $array_iterator_next_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $entries_pointer i32)
    (local $array_pointer i32)
    (local $i i32)
    (local $arr_len i32)
    (local $object_pointer i32)
    (local $element_pointer i32)
    (local $kind i32)
    (local $pair_pointer i32)
    (local $pair_element_pointer i32)
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    ;; Pre-check worst-case: result object (cap 2) plus, on the entries
    ;; kind, a pair array (cap 2). Always reserve both — the same
    ;; over-reservation $map_iterator_next documents.
    (if (call $check_heap_overflow
          (i32.add
            (call $estimate_object_size (i32.const 2))
            (call $estimate_array_size (i32.const 2))))
      (then (return (i32.const 0))))
    (local.set $entries_pointer
      (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 24)))))
    (local.set $array_pointer
      (i32.load (call $abs (i32.add (local.get $entries_pointer) (i32.const 20)))))
    (local.set $i
      (i32.load (call $abs (i32.add (local.get $entries_pointer) (i32.const 40)))))
    ;; Slot 3 (@kind): data_lo at +80. Iterators are always built by
    ;; $array_iterator_factory_method, which writes the slot
    ;; unconditionally (kind 1 for values/Symbol.iterator).
    (local.set $kind
      (i32.load (call $abs (i32.add (local.get $entries_pointer) (i32.const 80)))))
    (local.set $arr_len
      (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 8)))))
    (local.set $object_pointer (call $allocate_object (i32.const 2)))
    (if (i32.ge_u (local.get $i) (local.get $arr_len))
      (then
        (drop (call $object_set_property
          (local.get $object_pointer)
          (call $read_builtin (global.get $BUILTIN_ITER_VALUE_KEY))
          (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0)))
        (drop (call $object_set_property
          (local.get $object_pointer)
          (call $read_builtin (global.get $BUILTIN_ITER_DONE_KEY))
          (global.get $TYPE_BOOLEAN) (i32.const 0) (i32.const 1) (i32.const 0)))
      )
      (else
        (local.set $element_pointer
          (i32.add
            (i32.add (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 16)))) (global.get $GC_HEADER_SIZE))
            (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
        (if (i32.eq (local.get $kind) (i32.const 0))
          (then
            ;; keys → value is the index
            (drop (call $object_set_property
              (local.get $object_pointer)
              (call $read_builtin (global.get $BUILTIN_ITER_VALUE_KEY))
              (global.get $TYPE_RATIONAL)
              (global.get $FLAG_RATIONAL_INLINE)
              (local.get $i) (i32.const 0)))
          )
          (else
            (if (i32.eq (local.get $kind) (i32.const 1))
              (then
                ;; values → value is the element
                (drop (call $object_set_property
                  (local.get $object_pointer)
                  (call $read_builtin (global.get $BUILTIN_ITER_VALUE_KEY))
                  (i32.load (call $abs (local.get $element_pointer)))
                  (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 4))))
                  (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 8))))
                  (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 12))))))
              )
              (else
                ;; entries → value is [index, element] (a fresh array)
                (local.set $pair_pointer (call $allocate_array (i32.const 2)))
                (local.set $pair_element_pointer
                  (i32.add
                    (i32.load (call $abs (i32.add (local.get $pair_pointer) (i32.const 16))))
                    (global.get $GC_HEADER_SIZE)))
                (call $write_value (local.get $pair_element_pointer)
                  (global.get $TYPE_RATIONAL)
                  (global.get $FLAG_RATIONAL_INLINE)
                  (local.get $i) (i32.const 0))
                (local.set $pair_element_pointer
                  (i32.add (local.get $pair_element_pointer) (global.get $VALUE_SIZE)))
                (call $write_value (local.get $pair_element_pointer)
                  (i32.load (call $abs (local.get $element_pointer)))
                  (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 4))))
                  (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 8))))
                  (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 12)))))
                (i32.store (call $abs (i32.add (local.get $pair_pointer) (i32.const 8))) (i32.const 2))
                (drop (call $object_set_property
                  (local.get $object_pointer)
                  (call $read_builtin (global.get $BUILTIN_ITER_VALUE_KEY))
                  (global.get $TYPE_ARRAY) (i32.const 0)
                  (local.get $pair_pointer) (i32.const 0)))
              )
            )
          )
        )
        (drop (call $object_set_property
          (local.get $object_pointer)
          (call $read_builtin (global.get $BUILTIN_ITER_DONE_KEY))
          (global.get $TYPE_BOOLEAN) (i32.const 0) (i32.const 0) (i32.const 0)))
        (i32.store (call $abs (i32.add (local.get $entries_pointer) (i32.const 40)))
          (i32.add (local.get $i) (i32.const 1)))
      )
    )
    (call $pending_push
      (global.get $TYPE_OBJECT) (i32.const 0)
      (local.get $object_pointer) (i32.const 0))
    (return (i32.const 0))
  )

  (func $typed_array_iterator_next_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $entries_pointer i32)
    (local $iter_type i32)
    (local $element_pointer i32)
    (local $i i32)
    (local $data_pointer i32)
    (local $arr_cap i32)
    (local $arr_len i32)
    (local $object_pointer i32)
    (local $bytes_per_element i32)
    (local $byte_pointer i32)
    (local $f64_result f64)
    (local $iter_i64 i64)
    (local $kind i32)
    (local $value_type i32)
    (local $value_lo i32)
    (local $value_hi i32)
    (local $pair_pointer i32)
    (local $pair_element_pointer i32)
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (local.set $entries_pointer
      (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 24)))))
    (local.set $iter_type
      (i32.load (call $abs (i32.add (local.get $entries_pointer) (i32.const 12)))))
    ;; Pre-check worst-case: result object (cap 2), a bigint element on
    ;; the BigInt64/BigUint64 kinds, and (entries kind) a pair array
    ;; (cap 2). Always reserve everything — the same over-reservation
    ;; $map_iterator_next documents.
    (if (call $check_heap_overflow
          (i32.add
            (i32.add
              (call $estimate_object_size (i32.const 2))
              (call $estimate_array_size (i32.const 2)))
            (if (result i32)
              (i32.or
                (i32.eq (local.get $iter_type) (global.get $TYPE_BIGINT64ARRAY))
                (i32.eq (local.get $iter_type) (global.get $TYPE_BIGUINT64ARRAY)))
              (then (call $estimate_bigint_size (i32.const 2)))
              (else (i32.const 0)))))
      (then (return (i32.const 0))))
    (local.set $element_pointer
      (i32.load (call $abs (i32.add (local.get $entries_pointer) (i32.const 20)))))
    (local.set $i
      (i32.load (call $abs (i32.add (local.get $entries_pointer) (i32.const 40)))))
    ;; Slot 3 (@kind): data_lo at +80 — written unconditionally by
    ;; $typed_array_iterator_factory (kind 1 for values/Symbol.iterator).
    (local.set $kind
      (i32.load (call $abs (i32.add (local.get $entries_pointer) (i32.const 80)))))

    (local.set $data_pointer (i32.load (call $abs (local.get $element_pointer))))
    (local.set $arr_cap (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 4)))))
    (local.set $arr_len (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 8)))))

    (local.set $object_pointer (call $allocate_object (i32.const 2)))

    (if (i32.ge_u (local.get $i) (local.get $arr_len))
      (then
        (drop (call $object_set_property
          (local.get $object_pointer)
          (call $read_builtin (global.get $BUILTIN_ITER_VALUE_KEY))
          (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0)))
        (drop (call $object_set_property
          (local.get $object_pointer)
          (call $read_builtin (global.get $BUILTIN_ITER_DONE_KEY))
          (global.get $TYPE_BOOLEAN) (i32.const 0) (i32.const 1) (i32.const 0)))
      )
      (else
        (if (i32.eq (local.get $kind) (i32.const 0))
          (then
            ;; keys → value is the index; no element read needed.
            (drop (call $object_set_property
              (local.get $object_pointer)
              (call $read_builtin (global.get $BUILTIN_ITER_VALUE_KEY))
              (global.get $TYPE_RATIONAL)
              (global.get $FLAG_RATIONAL_INLINE)
              (local.get $i) (i32.const 0)))
          )
          (else
            ;; Read the element into a value quad (bigint arrays
            ;; allocate a heap bigint; the rest are floats).
            (local.set $bytes_per_element (call $get_bytes_per_element (local.get $iter_type)))
            (local.set $byte_pointer (call $abs (i32.add
              (i32.add
                (i32.add (local.get $data_pointer) (i32.const 4))
                (local.get $arr_cap))
              (i32.mul (local.get $i) (local.get $bytes_per_element)))))
            (if (i32.or
                  (i32.eq (local.get $iter_type) (global.get $TYPE_BIGINT64ARRAY))
                  (i32.eq (local.get $iter_type) (global.get $TYPE_BIGUINT64ARRAY)))
              (then
                (local.set $value_type (global.get $TYPE_BIGINT))
                (local.set $value_lo (call $bigint_from_typed_i64 (local.get $iter_type) (local.get $byte_pointer)))
                (local.set $value_hi (i32.const 0))
              )
              (else
                (local.set $f64_result (call $read_typed_element (local.get $iter_type) (local.get $byte_pointer)))
                (local.set $iter_i64 (i64.reinterpret_f64 (local.get $f64_result)))
                (local.set $value_type (global.get $TYPE_FLOAT))
                (local.set $value_lo (i32.wrap_i64 (local.get $iter_i64)))
                (local.set $value_hi (i32.wrap_i64 (i64.shr_u (local.get $iter_i64) (i64.const 32))))
              )
            )
            (if (i32.eq (local.get $kind) (i32.const 1))
              (then
                ;; values → value is the element
                (drop (call $object_set_property
                  (local.get $object_pointer)
                  (call $read_builtin (global.get $BUILTIN_ITER_VALUE_KEY))
                  (local.get $value_type) (i32.const 0)
                  (local.get $value_lo) (local.get $value_hi)))
              )
              (else
                ;; entries → value is [index, element] (a fresh array)
                (local.set $pair_pointer (call $allocate_array (i32.const 2)))
                (local.set $pair_element_pointer
                  (i32.add
                    (i32.load (call $abs (i32.add (local.get $pair_pointer) (i32.const 16))))
                    (global.get $GC_HEADER_SIZE)))
                (call $write_value (local.get $pair_element_pointer)
                  (global.get $TYPE_RATIONAL)
                  (global.get $FLAG_RATIONAL_INLINE)
                  (local.get $i) (i32.const 0))
                (local.set $pair_element_pointer
                  (i32.add (local.get $pair_element_pointer) (global.get $VALUE_SIZE)))
                (call $write_value (local.get $pair_element_pointer)
                  (local.get $value_type) (i32.const 0)
                  (local.get $value_lo) (local.get $value_hi))
                (i32.store (call $abs (i32.add (local.get $pair_pointer) (i32.const 8))) (i32.const 2))
                (drop (call $object_set_property
                  (local.get $object_pointer)
