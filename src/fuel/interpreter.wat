  (global $BUILTIN_KEY_DIAGNOSTIC i32 (i32.const 0x7E4))
  (global $BUILTIN_COMPILE_SET i32 (i32.const 0x7E8))
  (global $BUILTIN_LIT_SET i32 (i32.const 0x7EC))
  (global $BUILTIN_MSG_SCHEMA_SET_METHOD i32 (i32.const 0x7F0))
  (global $BUILTIN_MSG_SCHEMA_ROUTE_INDEX i32 (i32.const 0x7F4))
  (global $BUILTIN_MSG_SCHEMA_SET_SOURCE i32 (i32.const 0x7F8))
  (global $SCHEMA_STATUS_OK i32 (i32.const 0))
  (global $SCHEMA_STATUS_PAUSED i32 (i32.const 1))
  (global $SCHEMA_STATUS_VALID i32 (i32.const 2))
  (global $SCHEMA_STATUS_INVALID i32 (i32.const 3))
  (global $SCHEMA_STATUS_SYNTAX_ERROR i32 (i32.const 4))
  (global $SCHEMA_STATUS_UNSUPPORTED i32 (i32.const 5))
  (global $SCHEMA_STATUS_LIMIT_EXCEEDED i32 (i32.const 6))
  (global $SCHEMA_STATUS_BUFFER_TOO_SMALL i32 (i32.const 7))
  (global $SCHEMA_STATUS_CORRUPT_PROGRAM i32 (i32.const 8))
  (global $SCHEMA_STATUS_CORRUPT_DOCUMENT i32 (i32.const 9))
  (global $SCHEMA_STATUS_INVALID_UTF8 i32 (i32.const 10))
  (global $SCHEMA_OPT_STRICT i32 (i32.const 1))
  (global $SCHEMA_OPT_FORMAT_ANNOTATE i32 (i32.const 2))
  (global $SCHEMA_OPT_DIALECT_07 i32 (i32.const 4))
  (global $SCHEMA_OPT_DIALECT_04 i32 (i32.const 8))
  (global $SCHEMA_OPT_SET i32 (i32.const 16))
  (global $SCHEMA_MODE_TEST i32 (i32.const 0))
  (global $SCHEMA_MODE_VALIDATE i32 (i32.const 1))
  (global $SCHEMA_MODE_TRUSTED i32 (i32.const 2))
  (global $SCHEMA_CH_RESULT i32 (i32.const 92))
  (global $SCHEMA_CH_ARENA_REQUIRED i32 (i32.const 104))
  (global $SCHEMA_CH_ARENA_CAPACITY i32 (i32.const 60))
  (global $SCHEMA_WH_DIAGNOSTIC_DETAIL i32 (i32.const 140))
