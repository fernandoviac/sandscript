        (if (i32.and
              (i32.eq (call $bigint_length (local.get $i32_result)) (i32.const 1))
              (i32.eq (call $bigint_limb (local.get $i32_result) (i32.const 0)) (i32.const 1)))
          (then
            (call $pending_push (global.get $TYPE_STRING) (i32.const 0)
              (call $read_builtin (global.get $BUILTIN_EXACT_TYPEOF_INTEGER))
              (i32.const 0)))
          (else
            (call $pending_push (global.get $TYPE_STRING) (i32.const 0)
              (call $read_builtin (global.get $BUILTIN_EXACT_TYPEOF_RATIONAL))
              (i32.const 0))))
        (return (i32.const 0))))
    (if (i32.eq (local.get $arg1_type) (global.get $TYPE_COMPLEX))
      (then
        (call $pending_push (global.get $TYPE_STRING) (i32.const 0)
          (call $read_builtin (global.get $BUILTIN_EXACT_TYPEOF_COMPLEX))
          (i32.const 0))
        (return (i32.const 0))))
    (if (i32.eq (local.get $arg1_type) (global.get $TYPE_BIGINT))
      (then
        (call $pending_push (global.get $TYPE_STRING) (i32.const 0)
          (call $read_builtin (global.get $BUILTIN_TYPEOF_BIGINT))
          (i32.const 0))
        (return (i32.const 0))))
    (if (i32.eq (local.get $arg1_type) (global.get $TYPE_FLOAT))
      (then
        (call $pending_push (global.get $TYPE_STRING) (i32.const 0)
          (call $read_builtin (global.get $BUILTIN_EXACT_TYPEOF_FLOAT))
          (i32.const 0))
        (return (i32.const 0))))
    (if (i32.eq (local.get $arg1_type) (global.get $TYPE_SYMBOL))
      (then
        (call $pending_push (global.get $TYPE_STRING) (i32.const 0)
          (call $read_builtin (global.get $BUILTIN_TYPEOF_SYMBOL))
          (i32.const 0))
        (return (i32.const 0))))
    (if (i32.eq (local.get $arg1_type) (global.get $TYPE_EXPRESSION))
      (then
        (call $pending_push (global.get $TYPE_STRING) (i32.const 0)
          (call $read_builtin (global.get $BUILTIN_EXACT_TYPEOF_EXPRESSION))
          (i32.const 0))
        (return (i32.const 0))))
    (if (i32.eq (local.get $arg1_type) (global.get $TYPE_MATRIX))
      (then
