                (if (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_PROOF_UNIVERSES)) (then (if (i32.ne (local.get $index) (global.get $PROOF_UNIVERSES_PHASE_PUBLISHED)) (then (unreachable))) (local.set $stack_pointer (i32.sub (local.get $stack_pointer) (global.get $FRAME_SIZE))) (call $write_ctx (global.get $CTX_CALL_STACK_POINTER) (local.get $stack_pointer)) (local.set $return_pc (i32.load (i32.add (local.get $frame_pointer) (global.get $FRAME_INSTRUCTION_INDEX)))) (local.set $caller_scope (i32.load (i32.add (local.get $frame_pointer) (global.get $FRAME_SCOPE_POINTER)))) (call $write_ctx (global.get $CTX_PENDING_POINTER) (call $load_frame_pending_base (local.get $frame_pointer))) (global.set $current_scope (local.get $caller_scope)) (call $pending_push (local.get $result_type) (local.get $result_flags) (local.get $result_lo) (local.get $result_hi)) (local.set $pc (local.get $return_pc))  (br $loop)))

