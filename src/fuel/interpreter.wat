(module
  ;; ==========================================================================
  ;; Fuel-Based SandScript Interpreter
  ;;
  ;; Phase 0: String interning only
  ;; Phase 1+: Full interpreter with run(), gc()
  ;; ==========================================================================

  ;; Memory is imported from JS (allows segment model - multiple interpreters
  ;; can share a single WebAssembly.Memory with different base offsets)
  (import "env" "memory" (memory 1 16384 shared))

  ;; ==========================================================================
  ;; Standalone RegExp engine imports
  ;;
  ;; regex-engine.wat is instantiated against this same shared memory BEFORE
  ;; the interpreter; the generated wrapper (interpreter.wasm.js) passes the
  ;; engine instance's exports here and fails construction loudly when the
  ;; engine is missing, an export is absent (LinkError), or the engine's
  ;; format_version disagrees with regex-engine-contract.js. All addresses
  ;; are absolute offsets into the shared memory. Signatures must match
  ;; regex-engine.wat exactly.
  ;; ==========================================================================
  (import "regex" "scan_workspace_size"
    (func $regex_scan_workspace_size (param i32) (result i32)))
  (import "regex" "scan_pattern"
    (func $regex_scan_pattern (param i32 i32 i32 i32 i32 i32) (result i32 i32)))
  (import "regex" "measured_program_size"
    (func $regex_measured_program_size (param i32 i32 i32) (result i32)))
  (import "regex" "emission_workspace_size"
    (func $regex_emission_workspace_size (param i32) (result i32)))
  (import "regex" "initialize_program_emission"
    (func $regex_initialize_program_emission
      (param i32 i32 i32 i32 i32 i32) (result i32)))
  (import "regex" "initialize_emission_workspace"
    (func $regex_initialize_emission_workspace
      (param i32 i32 i32 i32 i32 i32 i32) (result i32)))
  (import "regex" "emit_pattern"
    (func $regex_emit_pattern (param i32 i32 i32) (result i32 i32)))
  (import "regex" "validate_program"
    (func $regex_validate_program (param i32 i32) (result i32)))
  (import "regex" "continuation_size"
    (func $regex_continuation_size (param i32 i32 i32) (result i32)))
  (import "regex" "initialize_match"
    (func $regex_initialize_match
      (param i32 i32 i32 i32 i32 i32 i32 i32) (result i32)))
  (import "regex" "run_match"
    (func $regex_run_match (param i32 i32 i32) (result i32 i32)))

  ;; ==========================================================================
  ;; Standalone JSON Schema engine imports (schema-engine.wat). Same
  ;; discipline as the regex engine: memory-less, absolute addresses,
  ;; fuel-resumable entry points returning (status, fuelRemaining).
  ;; ==========================================================================
  (import "schema" "compile_workspace_size"
    (func $schema_compile_workspace_size (param i32) (result i32)))
  (import "schema" "measure_schema"
    (func $schema_measure_schema (param i32 i32 i32 i32 i32 i32 i32) (result i32 i32)))
  (import "schema" "measured_program_size"
    (func $schema_measured_program_size (param i32) (result i32)))
  (import "schema" "emission_workspace_size"
    (func $schema_emission_workspace_size (param i32) (result i32)))
  (import "schema" "initialize_emission"
    (func $schema_initialize_emission (param i32 i32 i32 i32 i32) (result i32)))
  (import "schema" "emit_program"
    (func $schema_emit_program (param i32 i32 i32 i32 i32) (result i32 i32)))
  (import "schema" "compile_work_charged"
    (func $schema_compile_work_charged (param i32) (result i64)))
  (import "schema" "compile_work_overflow"
    (func $schema_compile_work_overflow (param i32) (result i32)))
  (import "schema" "compile_diagnostic"
    (func $schema_compile_diagnostic (param i32) (result i32 i32 i32)))
  (import "schema" "keyword_name"
    (func $schema_keyword_name (param i32 i32 i32) (result i32)))
  (import "schema" "continuation_size"
    (func $schema_continuation_size (param i32 i32 i32 i32 i32) (result i32)))
  (import "schema" "initialize_validation"
    (func $schema_initialize_validation (param i32 i32 i32 i32 i32 i32 i32 i32 i32 i32) (result i32)))
  (import "schema" "rebind_validation"
    (func $schema_rebind_validation (param i32 i32 i32) (result i32)))
  (import "schema" "run_validation"
    (func $schema_run_validation (param i32 i32 i32) (result i32 i32)))
  (import "schema" "validation_work_charged"
    (func $schema_validation_work_charged (param i32) (result i64)))
  (import "schema" "validation_work_overflow"
    (func $schema_validation_work_overflow (param i32) (result i32)))
  (import "schema" "error_stored"
    (func $schema_error_stored (param i32) (result i32)))
  (import "schema" "error_count"
    (func $schema_error_count (param i32) (result i32)))
  (import "schema" "render_error_complete"
    (func $schema_render_error_complete (param i32 i32 i32 i32 i32) (result i32 i64 i32)))
  (import "schema" "program_route_count"
    (func $schema_program_route_count (param i32) (result i32)))
  (import "schema" "route_result"
    (func $schema_route_result (param i32 i32) (result i32)))

  ;; ==========================================================================
  ;; Built-in dispatch table
  ;;
  ;; Every built-in method previously reached via an if/else chain on
  ;; method_id inside dispatch_builtin_method (or, for constructors,
  ;; inside $run's several TYPE_CONSTRUCTOR ladders) gets a table slot
  ;; here as it migrates to a standalone function. Slot index == the
  ;; method's METHOD_* id. Ring 4 filled the original 512 slots to
  ;; 0x1FB; Ring 5 grew the table to 0x400 (1024) — method ids are
  ;; stored as full u32s everywhere (bound-method data_hi, dispatch
  ;; params), so the table bound is the only width that matters.
  ;; Unmigrated ids keep 0 (null) — the old
  ;; if/else chains remain authoritative for those until each is
  ;; migrated in turn. $builtin_sig matches dispatch_builtin_method's
  ;; existing (receiver_type, receiver_pointer, method_id, argc,
  ;; stack_base) -> result i32 signature, so migrated functions are
  ;; drop-in call_indirect targets without a calling-convention change.
  (type $builtin_sig (func
    (param $receiver_type i32)
    (param $receiver_pointer i32)
    (param $method_id i32)
    (param $argc i32)
    (param $stack_base i32)
    (result i32)))
  (table $builtin_table 1024 1024 funcref)

  ;; Populated table slots. Each entry here is one method_id that has
  ;; completed migration to a standalone $builtin_sig-shaped function.
  ;; METHOD_FUNCTION_CALL/APPLY/BIND = 0x1D6/0x1D7/0x1D8, all three
  ;; slots pointing at the same $call_apply_bind function (it branches
  ;; on method_id internally, same as the pre-migration inline code did).
  (elem (i32.const 0x1D6) $call_apply_bind)
  (elem (i32.const 0x1D7) $call_apply_bind)
  (elem (i32.const 0x1D8) $call_apply_bind)

  ;; Batch 2: Map / Set instance methods. Hex values verified against
  ;; each METHOD_* global's own declaration, not hand-copied, since
  ;; elem offsets must be literal constants (WASM only allows an
  ;; imported global in a const-expr context, and these are internal).
  (elem (i32.const 0x1A1) $map_get)                  ;; METHOD_MAP_GET
  (elem (i32.const 0x1A3) $map_has)                  ;; METHOD_MAP_HAS
  (elem (i32.const 0x1A2) $map_set_method)           ;; METHOD_MAP_SET
  (elem (i32.const 0x1A4) $map_delete_method)        ;; METHOD_MAP_DELETE
  (elem (i32.const 0x1A5) $map_clear_method)         ;; METHOD_MAP_CLEAR
  (elem (i32.const 0x1C2) $iterator_return_self)     ;; METHOD_ITERATOR_RETURN_SELF
  (elem (i32.const 0x1A7) $map_iterator_factory)     ;; METHOD_MAP_KEYS
  (elem (i32.const 0x1A8) $map_iterator_factory)     ;; METHOD_MAP_VALUES
  (elem (i32.const 0x1A9) $map_iterator_factory)     ;; METHOD_MAP_ENTRIES_M
  (elem (i32.const 0x1AB) $map_iterator_next_method) ;; METHOD_MAP_ITERATOR_NEXT
  (elem (i32.const 0x1B2) $set_has)                  ;; METHOD_SET_HAS
  (elem (i32.const 0x1B1) $set_add_method)           ;; METHOD_SET_ADD
  (elem (i32.const 0x1B3) $set_delete_method)        ;; METHOD_SET_DELETE
  (elem (i32.const 0x1B4) $set_clear_method)         ;; METHOD_SET_CLEAR
  (elem (i32.const 0x1B7) $set_iterator_factory)     ;; METHOD_SET_VALUES
  (elem (i32.const 0x1B8) $set_iterator_factory)     ;; METHOD_SET_ENTRIES_M
  (elem (i32.const 0x1BA) $set_iterator_next_method) ;; METHOD_SET_ITERATOR_NEXT
  (elem (i32.const 0x1BB) $set_theoretic_ops)        ;; METHOD_SET_UNION
  (elem (i32.const 0x1BC) $set_theoretic_ops)        ;; METHOD_SET_INTERSECTION
  (elem (i32.const 0x1BD) $set_theoretic_ops)        ;; METHOD_SET_DIFFERENCE
  (elem (i32.const 0x1BE) $set_theoretic_ops)        ;; METHOD_SET_SYMMETRIC_DIFFERENCE
  (elem (i32.const 0x1BF) $set_theoretic_ops)        ;; METHOD_SET_IS_SUBSET_OF
  (elem (i32.const 0x1C0) $set_theoretic_ops)        ;; METHOD_SET_IS_SUPERSET_OF
  (elem (i32.const 0x1C1) $set_theoretic_ops)        ;; METHOD_SET_IS_DISJOINT_FROM

  ;; Batch 3: Math static methods. Hex values verified against each
  ;; METHOD_* global's own declaration (see note on batch 2's elem
  ;; block for why literal constants are required here).
  (elem (i32.const 0x40) $math_abs)  ;; METHOD_MATH_ABS
  (elem (i32.const 0x41) $math_floor)  ;; METHOD_MATH_FLOOR
  (elem (i32.const 0x42) $math_ceil)  ;; METHOD_MATH_CEIL
  (elem (i32.const 0x43) $math_round)  ;; METHOD_MATH_ROUND
  (elem (i32.const 0x44) $math_trunc)  ;; METHOD_MATH_TRUNC
  (elem (i32.const 0x49) $math_sqrt)  ;; METHOD_MATH_SQRT
  (elem (i32.const 0x48) $math_pow)  ;; METHOD_MATH_POW
  (elem (i32.const 0x46) $math_min)  ;; METHOD_MATH_MIN
  (elem (i32.const 0x47) $math_max)  ;; METHOD_MATH_MAX
  (elem (i32.const 0x45) $math_sign)  ;; METHOD_MATH_SIGN
  (elem (i32.const 0x4A) $math_cbrt)  ;; METHOD_MATH_CBRT
  (elem (i32.const 0x59) $math_log)  ;; METHOD_MATH_LOG
  (elem (i32.const 0x5D) $math_exp)  ;; METHOD_MATH_EXP
  (elem (i32.const 0x5A) $math_log10)  ;; METHOD_MATH_LOG10
  (elem (i32.const 0x5B) $math_log2)  ;; METHOD_MATH_LOG2
  (elem (i32.const 0x5C) $math_log1p)  ;; METHOD_MATH_LOG1P
  (elem (i32.const 0x5E) $math_expm1)  ;; METHOD_MATH_EXPM1
  (elem (i32.const 0x5F) $math_clz32)  ;; METHOD_MATH_CLZ32
  (elem (i32.const 0x60) $math_imul)  ;; METHOD_MATH_IMUL
  (elem (i32.const 0x61) $math_fround)  ;; METHOD_MATH_FROUND
  (elem (i32.const 0x4B) $math_hypot)  ;; METHOD_MATH_HYPOT
  (elem (i32.const 0x4C) $math_sin)  ;; METHOD_MATH_SIN
  (elem (i32.const 0x4D) $math_cos)  ;; METHOD_MATH_COS
  (elem (i32.const 0x4E) $math_tan)  ;; METHOD_MATH_TAN
  (elem (i32.const 0x4F) $math_asin)  ;; METHOD_MATH_ASIN
  (elem (i32.const 0x50) $math_acos)  ;; METHOD_MATH_ACOS
  (elem (i32.const 0x51) $math_atan)  ;; METHOD_MATH_ATAN
  (elem (i32.const 0x52) $math_atan2)  ;; METHOD_MATH_ATAN2
  (elem (i32.const 0x53) $math_sinh)  ;; METHOD_MATH_SINH
  (elem (i32.const 0x54) $math_cosh)  ;; METHOD_MATH_COSH
  (elem (i32.const 0x55) $math_tanh)  ;; METHOD_MATH_TANH
  (elem (i32.const 0x56) $math_asinh)  ;; METHOD_MATH_ASINH
  (elem (i32.const 0x57) $math_acosh)  ;; METHOD_MATH_ACOSH
  (elem (i32.const 0x58) $math_atanh)  ;; METHOD_MATH_ATANH
  (elem (i32.const 0x3E) $math_random_unsupported)  ;; METHOD_MATH_RANDOM_UNSUPPORTED

  ;; Batch 4: Exact namespace. Hex values verified against each
  ;; METHOD_* global's own declaration.
  (elem (i32.const 0x62) $exact_rational)  ;; METHOD_EXACT_RATIONAL
  (elem (i32.const 0x63) $exact_is_rational)  ;; METHOD_EXACT_IS_RATIONAL
  (elem (i32.const 0x67) $exact_is_integer)  ;; METHOD_EXACT_IS_INTEGER
  (elem (i32.const 0x64) $exact_numerator)  ;; METHOD_EXACT_NUMERATOR
  (elem (i32.const 0x65) $exact_denominator)  ;; METHOD_EXACT_DENOMINATOR
  (elem (i32.const 0x66) $exact_equal)  ;; METHOD_EXACT_EQUAL
  (elem (i32.const 0x68) $exact_complex)  ;; METHOD_EXACT_COMPLEX
  (elem (i32.const 0x69) $exact_is_complex)  ;; METHOD_EXACT_IS_COMPLEX
  (elem (i32.const 0x6A) $exact_real)  ;; METHOD_EXACT_REAL
  (elem (i32.const 0x6B) $exact_imaginary)  ;; METHOD_EXACT_IMAGINARY
  (elem (i32.const 0x6C) $exact_realize)  ;; METHOD_EXACT_REALIZE
  (elem (i32.const 0x6D) $exact_try_realize)  ;; METHOD_EXACT_TRY_REALIZE
  (elem (i32.const 0x6E) $exact_type_of)  ;; METHOD_EXACT_TYPE_OF
  (elem (i32.const 0x6F) $exact_to_string_method)  ;; METHOD_EXACT_TO_STRING

  ;; Batch 5: Typed array methods. Hex values verified against each
  ;; METHOD_* global's own declaration.
  (elem (i32.const 0x194) $typed_array_iterator_factory)  ;; METHOD_TYPED_ARRAY_ITERATOR_FACTORY
  (elem (i32.const 0x125) $typed_array_iterator_factory)   ;; METHOD_TYPED_ARRAY_KEYS
  (elem (i32.const 0x126) $typed_array_iterator_factory)   ;; METHOD_TYPED_ARRAY_ENTRIES
  (elem (i32.const 0x127) $typed_array_to_reversed_method)  ;; METHOD_TYPED_ARRAY_TO_REVERSED
  (elem (i32.const 0x128) $typed_array_to_sorted_method)    ;; METHOD_TYPED_ARRAY_TO_SORTED
  (elem (i32.const 0x129) $typed_array_with_method)         ;; METHOD_TYPED_ARRAY_WITH
  (elem (i32.const 0xC5) $typed_array_subarray)  ;; METHOD_UINT8ARRAY_SUBARRAY
  (elem (i32.const 0xC6) $typed_array_slice)  ;; METHOD_UINT8ARRAY_SLICE
  (elem (i32.const 0x110) $typed_array_fill)  ;; METHOD_UINT8ARRAY_FILL
  (elem (i32.const 0x113) $typed_array_reverse)  ;; METHOD_UINT8ARRAY_REVERSE
  (elem (i32.const 0x114) $typed_array_index_of)  ;; METHOD_UINT8ARRAY_INDEX_OF
  (elem (i32.const 0x115) $typed_array_last_index_of)  ;; METHOD_UINT8ARRAY_LAST_INDEX_OF
  (elem (i32.const 0x116) $typed_array_includes)  ;; METHOD_UINT8ARRAY_INCLUDES
  (elem (i32.const 0x111) $typed_array_set)  ;; METHOD_UINT8ARRAY_SET
  (elem (i32.const 0x112) $typed_array_copy_within)  ;; METHOD_UINT8ARRAY_COPY_WITHIN
  (elem (i32.const 0x120) $typed_array_join)  ;; METHOD_UINT8ARRAY_JOIN
  (elem (i32.const 0x121) $typed_array_to_string_method)  ;; METHOD_UINT8ARRAY_TO_STRING
  (elem (i32.const 0x122) $typed_array_sort_method)  ;; METHOD_UINT8ARRAY_SORT

  ;; Batch 6: DataView methods. Hex values verified against each
  ;; METHOD_* global's own declaration.
  (elem (i32.const 0xC8) $dataview_get_int8)  ;; METHOD_DATAVIEW_GET_INT8
  (elem (i32.const 0xC9) $dataview_get_uint8)  ;; METHOD_DATAVIEW_GET_UINT8
  (elem (i32.const 0xCA) $dataview_get_int16)  ;; METHOD_DATAVIEW_GET_INT16
  (elem (i32.const 0xCB) $dataview_get_uint16)  ;; METHOD_DATAVIEW_GET_UINT16
  (elem (i32.const 0xCC) $dataview_get_int32)  ;; METHOD_DATAVIEW_GET_INT32
  (elem (i32.const 0xCD) $dataview_get_uint32)  ;; METHOD_DATAVIEW_GET_UINT32
  (elem (i32.const 0xCE) $dataview_get_float32)  ;; METHOD_DATAVIEW_GET_FLOAT32
  (elem (i32.const 0xCF) $dataview_get_float64)  ;; METHOD_DATAVIEW_GET_FLOAT64
  (elem (i32.const 0xD8) $dataview_set_int8)  ;; METHOD_DATAVIEW_SET_INT8
  (elem (i32.const 0xD9) $dataview_set_uint8)  ;; METHOD_DATAVIEW_SET_UINT8
  (elem (i32.const 0xDA) $dataview_set_int16)  ;; METHOD_DATAVIEW_SET_INT16
  (elem (i32.const 0xDB) $dataview_set_uint16)  ;; METHOD_DATAVIEW_SET_UINT16
  (elem (i32.const 0xDC) $dataview_set_int32)  ;; METHOD_DATAVIEW_SET_INT32
  (elem (i32.const 0xDD) $dataview_set_uint32)  ;; METHOD_DATAVIEW_SET_UINT32
  (elem (i32.const 0xDE) $dataview_set_float32)  ;; METHOD_DATAVIEW_SET_FLOAT32
  (elem (i32.const 0xDF) $dataview_set_float64)  ;; METHOD_DATAVIEW_SET_FLOAT64

  ;; Batch 7: Global functions. Hex values verified against each
  ;; METHOD_* global's own declaration.
  (elem (i32.const 0xB5) $global_is_nan)  ;; METHOD_IS_NAN
  (elem (i32.const 0xB6) $global_is_finite)  ;; METHOD_IS_FINITE
  (elem (i32.const 0xB3) $global_parse_int)  ;; METHOD_PARSE_INT
  (elem (i32.const 0xB4) $global_parse_float)  ;; METHOD_PARSE_FLOAT
  (elem (i32.const 0xFA) $global_btoa)  ;; METHOD_BTOA
  (elem (i32.const 0xFB) $global_atob)  ;; METHOD_ATOB

  ;; Batch 8: Type conversion functions. Hex values verified against
  ;; each METHOD_* global's own declaration.
  (elem (i32.const 0xB0) $to_string_conversion)  ;; METHOD_TO_STRING
  (elem (i32.const 0xB1) $to_number_conversion)  ;; METHOD_TO_NUMBER
  (elem (i32.const 0xB2) $to_boolean_conversion)  ;; METHOD_TO_BOOLEAN
  (elem (i32.const 0xB7) $to_bigint_conversion)  ;; METHOD_TO_BIGINT
  (elem (i32.const 0xB8) $bigint_fixed_width_method)  ;; METHOD_BIGINT_AS_INT_N
  (elem (i32.const 0xB9) $bigint_fixed_width_method)  ;; METHOD_BIGINT_AS_UINT_N
  (elem (i32.const 0xBB) $bigint_prototype_method)  ;; METHOD_BIGINT_TO_STRING
  (elem (i32.const 0xBC) $bigint_prototype_method)  ;; METHOD_BIGINT_VALUE_OF
  (elem (i32.const 0xBD) $bigint_prototype_method)  ;; METHOD_BIGINT_TO_LOCALE_STRING
  (elem (i32.const 0xC1) $object_conversion_method)  ;; METHOD_OBJECT_CONSTRUCTOR

  ;; Batch 9: Symbol methods. Hex values verified against each
  ;; METHOD_* global's own declaration.
  (elem (i32.const 0x170) $symbol_constructor_method)  ;; METHOD_SYMBOL_CONSTRUCTOR
  (elem (i32.const 0x171) $symbol_for)  ;; METHOD_SYMBOL_FOR
  (elem (i32.const 0x172) $symbol_key_for)  ;; METHOD_SYMBOL_KEY_FOR
  (elem (i32.const 0x173) $symbol_to_string_method)  ;; METHOD_SYMBOL_TO_STRING

  ;; Batch 10: Expression construction + inspection. Hex values
  ;; verified against each METHOD_* global's own declaration.
  (elem (i32.const 0x180) $expression_make)  ;; METHOD_EXACT_EXPRESSION_MAKE
  (elem (i32.const 0x186) $expression_negate)  ;; METHOD_EXACT_EXPRESSION_NEGATE
  (elem (i32.const 0x187) $expression_kind)  ;; METHOD_EXACT_EXPRESSION_KIND
  (elem (i32.const 0x188) $expression_args_method)  ;; METHOD_EXACT_EXPRESSION_ARGS
  (elem (i32.const 0x189) $expression_argument_count)  ;; METHOD_EXACT_EXPRESSION_ARGUMENT_COUNT
  (elem (i32.const 0x18A) $expression_is_expression)  ;; METHOD_EXACT_EXPRESSION_IS_EXPRESSION
  (elem (i32.const 0x18B) $expression_is_atom)  ;; METHOD_EXACT_EXPRESSION_IS_ATOM
  (elem (i32.const 0x18C) $expression_equal)  ;; METHOD_EXACT_EXPRESSION_EQUAL
  (elem (i32.const 0x18E) $expression_simplify)  ;; METHOD_EXACT_EXPRESSION_SIMPLIFY
  (elem (i32.const 0x18D) $expression_substitute)  ;; METHOD_EXACT_EXPRESSION_SUBSTITUTE
  ;; Ring 3 (3a): polynomial predicate.
  (elem (i32.const 0x18F) $expression_is_polynomial)  ;; METHOD_EXACT_EXPRESSION_IS_POLYNOMIAL
  ;; Ring 3 (3b): uncapped expansion.
  (elem (i32.const 0x1E1) $expression_expand)  ;; METHOD_EXACT_EXPRESSION_EXPAND
  ;; Ring 3 (3c): polynomial algebra.
  (elem (i32.const 0x1E2) $expression_polynomial_gcd)     ;; METHOD_EXACT_EXPRESSION_POLYNOMIAL_GCD
  (elem (i32.const 0x1E3) $expression_polynomial_divide)  ;; METHOD_EXACT_EXPRESSION_POLYNOMIAL_DIVIDE
  (elem (i32.const 0x1E4) $expression_collect)            ;; METHOD_EXACT_EXPRESSION_COLLECT
  ;; Ring 4 (4a): Exact.Matrix construction + inspection
  (elem (i32.const 0x1E5) $matrix_make)          ;; METHOD_EXACT_MATRIX_MAKE
  (elem (i32.const 0x1E6) $matrix_identity)      ;; METHOD_EXACT_MATRIX_IDENTITY
  (elem (i32.const 0x1E7) $matrix_zero)          ;; METHOD_EXACT_MATRIX_ZERO
  (elem (i32.const 0x1E8) $matrix_diagonal)      ;; METHOD_EXACT_MATRIX_DIAGONAL
  (elem (i32.const 0x1E9) $matrix_from_columns)  ;; METHOD_EXACT_MATRIX_FROM_COLUMNS
  (elem (i32.const 0x1EA) $matrix_rows_method)   ;; METHOD_EXACT_MATRIX_ROWS
  (elem (i32.const 0x1EB) $matrix_columns_method) ;; METHOD_EXACT_MATRIX_COLUMNS
  (elem (i32.const 0x1EC) $matrix_get_method)    ;; METHOD_EXACT_MATRIX_GET
  (elem (i32.const 0x1ED) $matrix_is_matrix)     ;; METHOD_EXACT_MATRIX_IS_MATRIX
  (elem (i32.const 0x1EE) $matrix_is_square)     ;; METHOD_EXACT_MATRIX_IS_SQUARE
  (elem (i32.const 0x1EF) $matrix_equal_method)  ;; METHOD_EXACT_MATRIX_EQUAL
  ;; Ring 4 (4b): element-wise arithmetic + transpose
  (elem (i32.const 0x1F0) $matrix_add_subtract)  ;; METHOD_EXACT_MATRIX_ADD
  (elem (i32.const 0x1F1) $matrix_add_subtract)  ;; METHOD_EXACT_MATRIX_SUBTRACT
  (elem (i32.const 0x1F2) $matrix_scale)         ;; METHOD_EXACT_MATRIX_SCALE
  (elem (i32.const 0x1F3) $matrix_negate)        ;; METHOD_EXACT_MATRIX_NEGATE
  (elem (i32.const 0x1F4) $matrix_transpose)     ;; METHOD_EXACT_MATRIX_TRANSPOSE
  (elem (i32.const 0x1F5) $matrix_conjugate_transpose)  ;; METHOD_EXACT_MATRIX_CONJUGATE_TRANSPOSE
  ;; Ring 4 (4c): multiplication + simple linear algebra
  (elem (i32.const 0x1F6) $matrix_multiply)      ;; METHOD_EXACT_MATRIX_MULTIPLY
  (elem (i32.const 0x1F7) $matrix_trace)         ;; METHOD_EXACT_MATRIX_TRACE
  (elem (i32.const 0x1F8) $matrix_determinant)   ;; METHOD_EXACT_MATRIX_DETERMINANT
  ;; Ring 4 (4d): inverse, solve, rank
  (elem (i32.const 0x1F9) $matrix_inverse)       ;; METHOD_EXACT_MATRIX_INVERSE
  (elem (i32.const 0x1FA) $matrix_solve)         ;; METHOD_EXACT_MATRIX_SOLVE
  (elem (i32.const 0x1FB) $matrix_rank)          ;; METHOD_EXACT_MATRIX_RANK

  ;; Ring 5 (5a): pattern matching
  (elem (i32.const 0x200) $expression_match)     ;; METHOD_EXACT_EXPRESSION_MATCH


  ;; Ring 6 (6a): Exact.AlgebraicNumber
  (elem (i32.const 0x214) $algebraic_roots_of_polynomial)  ;; METHOD_EXACT_ALGEBRAIC_ROOTS_OF_POLYNOMIAL
