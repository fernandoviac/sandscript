  (global $SCHEMA_LIMITS_DEFAULT_ARENA_BYTES i32 (i32.const 16384))
  (global $NOT_SUPPORTED_FEATURE_SCHEMA i32 (i32.const 6))


  ;; Map/Set layout (data-relative, after 8-byte GC header):
  ;;   header: [size:4][slotCount:4][capacity:4][entriesHeader:4][sym_entries:4] = 20 bytes
  ;; sym_entries: own symbol-keyed properties (same block format objects
  ;; use); added for symbol-key parity on exotic receivers.
  (global $MAP_HEADER_DATA_SIZE i32 (i32.const 20))
  (global $MAP_SIZE_OFFSET           i32 (i32.const 0))
  (global $MAP_SLOT_COUNT_OFFSET     i32 (i32.const 4))
  (global $MAP_CAPACITY_OFFSET       i32 (i32.const 8))
  (global $MAP_ENTRIES_PTR_OFFSET    i32 (i32.const 12))
  (global $MAP_SYM_ENTRIES_OFFSET    i32 (i32.const 16))

  ;; Map entry slot layout: [tombstone:4][keyValue:16][valueValue:16] = 36 bytes
  ;; Set entry slot layout: [tombstone:4][valueValue:16] = 20 bytes
  (global $MAP_SLOT_STRIDE i32 (i32.const 36))
  (global $SET_SLOT_STRIDE i32 (i32.const 20))
  (global $MAP_SLOT_TOMBSTONE_OFFSET i32 (i32.const 0))
  (global $MAP_SLOT_KEY_OFFSET       i32 (i32.const 4))
  (global $MAP_SLOT_VALUE_OFFSET     i32 (i32.const 20))
  (global $SET_SLOT_TOMBSTONE_OFFSET i32 (i32.const 0))
  (global $SET_SLOT_VALUE_OFFSET     i32 (i32.const 4))

  ;; Sizes
  (global $VALUE_SIZE i32 (i32.const 16))
  ;; INSTRUCTION_SIZE: instruction layout is
  ;;   [opcode:1][flags:1][reserved:2][astNode:4][operand1:4][operand2:4]
  ;; operand1 (offset 8) and operand2 (offset 12) are unchanged from the
  ;; original layout, so read_operand1 / read_operand2 don't shift. The
  ;; legacy srcStart/srcEnd u16 pair is gone — source attribution lives
  ;; entirely in astNode now (offset 4). WAT does not read astNode itself.
  (global $INSTRUCTION_SIZE i32 (i32.const 16))
  (global $GC_HEADER_SIZE i32 (i32.const 8))
  (global $FRAME_SIZE i32 (i32.const 60))  ;; v10: added FRAME_ARGC at 0x38 for RECONCILE_PARAMS

  ;; Header sizes for heap objects
  ;; Array header layout (28 bytes): [GC:8][length:4][capacity:4][data_pointer:4][flags:4][sym_entries:4]
  ;; Ring 2 grew this from 20 → 24 to add a flags field at offset 20, which
  ;; holds Object.freeze / Array.freeze status. The same freeze mechanism
  ;; that Objects already use (via OBJECT_FLAG_FROZEN) now applies to Arrays.
  ;; Grown again 24 → 28 for sym_entries at offset 24: own symbol-keyed
  ;; properties (same block format objects use at OBJECT_SYM_ENTRIES_OFFSET).
  (global $ARRAY_HEADER_SIZE i32 (i32.const 28))
  (global $ARRAY_FLAGS_OFFSET i32 (i32.const 20))
  (global $ARRAY_SYM_ENTRIES_OFFSET i32 (i32.const 24))
  ;; TypedArray descriptor sym_entries slot (data-relative): claims the
  ;; former 4-byte pad in [bufferPtr:4][byteOffset:4][length:4][sym_entries:4].
  (global $TYPED_ARRAY_SYM_ENTRIES_OFFSET i32 (i32.const 12))
  (global $ARRAY_FLAG_FROZEN i32 (i32.const 0x01))  ;; Array is immutable
  (global $OBJECT_HEADER_SIZE i32 (i32.const 32))  ;; [GC:8][prototype:4][count:4][capacity:4][flags:4][entries:4][sym_entries:4]
  (global $FUNCTION_HEADER_SIZE i32 (i32.const 48)) ;; [object:32][start_instruction:4][end_instruction:4][scope:4][function_flags:4]
  (global $FUNCTION_CLOSURE_OFFSET i32 (i32.const 32)) ;; Offset from header ptr to closure fields (GC:8 + obj:24)
  (global $OBJECT_SYM_ENTRIES_OFFSET i32 (i32.const 28)) ;; Offset from header ptr to sym-entries pointer slot
  (global $ENTRY_SIZE i32 (i32.const 20))          ;; [name:4][value:16] - object/scope entry stride

  ;; Object flags
  (global $OBJECT_FLAG_FROZEN i32 (i32.const 0x01)) ;; Object is immutable
  (global $OBJECT_FLAG_EXTERNAL_BACKED i32 (i32.const 0x02)) ;; branded by external super(); forwards string-key misses to its backing handle
  (global $OBJECT_FLAG_CONSTRUCTION_PENDING i32 (i32.const 0x04)) ;; external super() ran; completeConstruction has not

  ;; Prototype chain
  (global $MAX_PROTO_DEPTH i32 (i32.const 100))    ;; Max prototype chain depth (prevents infinite loops)

  ;; Frame field offsets (v6: CODE_BLOCK removed, offsets shifted down by 4)
  (global $FRAME_INSTRUCTION_INDEX i32 (i32.const 0x00))
  (global $FRAME_SCOPE_POINTER i32 (i32.const 0x04))
  (global $FRAME_PENDING_POINTER i32 (i32.const 0x08))
  (global $FRAME_PENDING_COUNT i32 (i32.const 0x0C))
  (global $FRAME_FLAGS i32 (i32.const 0x10))
  (global $FRAME_AST_NODE i32 (i32.const 0x14))   ;; AST region offset (0 = no attribution)
  ;; Native continuation fields. KIND selects the operation state machine;
  ;; PHASE is fixed control data; STATE_HANDLE owns operation-specific state.
  (global $FRAME_CONTINUATION_PHASE i32 (i32.const 0x18))
  (global $FRAME_CONTINUATION_STATE_HANDLE i32 (i32.const 0x1C))
  (global $FRAME_CONTINUATION_STATE_1 i32 (i32.const 0x20))
  (global $FRAME_CONTINUATION_KIND i32 (i32.const 0x24))
  (global $FRAME_CONTINUATION_STATE_2 i32 (i32.const 0x28))
  (global $FRAME_CONTINUATION_CALLBACK i32 (i32.const 0x2C))
  (global $FRAME_CONTINUATION_STATE_3 i32 (i32.const 0x30))
  (global $FRAME_CONTINUATION_STATE_4 i32 (i32.const 0x34))
  ;; Ordinary async-call frame meaning of the shared final slot.
  (global $FRAME_ASYNC_PROMISE i32 (i32.const 0x34))
  ;; Argument count (written by every call-path at frame push; read by RECONCILE_PARAMS)
  (global $FRAME_ARGC i32 (i32.const 0x38))

  ;; dispatch_builtin_method result codes. See constants.js for the full
  ;; rationale and the ad-hoc-registry warning.
  (global $STATUS_SUCCESS i32 (i32.const 0))
  (global $STATUS_THROW_CAUGHT i32 (i32.const 1))
  (global $STATUS_THROW_UNCAUGHT i32 (i32.const 2))
  (global $STATUS_NATIVE_CONTINUATION_STAGED i32 (i32.const 5))

  ;; Frame flags
  (global $FRAME_FLAG_TAIL i32 (i32.const 0x02))
  (global $FRAME_FLAG_NATIVE_CONTINUATION i32 (i32.const 0x04))
  (global $FRAME_FLAG_CONSTRUCTOR i32 (i32.const 0x08))
  ;; Discard the callee's return value on RETURN/RETURN_UNDEFINED: restore
  ;; the pending base and push nothing. Used for accessor setter calls,
  ;; where the assignment's result value already sits below the frame base.
  (global $FRAME_FLAG_DISCARD_RESULT i32 (i32.const 0x10))

  ;; Opcodes
  (global $OP_LIT_INT i32 (i32.const 0x01))
  (global $OP_LIT_FLOAT i32 (i32.const 0x02))
  (global $OP_LIT_STRING i32 (i32.const 0x03))
  (global $OP_LIT_NULL i32 (i32.const 0x04))
  (global $OP_LIT_UNDEFINED i32 (i32.const 0x05))
  (global $OP_LIT_TRUE i32 (i32.const 0x06))
  (global $OP_LIT_FALSE i32 (i32.const 0x07))
  (global $OP_LIT_BIGINT i32 (i32.const 0x08))
  (global $OP_LIT_RATIONAL_INTEGER i32 (i32.const 0x09))
  (global $OP_LIT_RATIONAL_BIGINT i32 (i32.const 0x0A))
  (global $OP_LIT_WELL_KNOWN_SYMBOL i32 (i32.const 0x0B))
  (global $OP_LIT_REGEXP i32 (i32.const 0x0C))

  (global $OP_GET_VAR i32 (i32.const 0x10))
  (global $OP_SET_VAR i32 (i32.const 0x11))
  (global $OP_LET_VAR i32 (i32.const 0x12))

  (global $OP_ADD i32 (i32.const 0x20))
  (global $OP_SUB i32 (i32.const 0x21))
  (global $OP_MUL i32 (i32.const 0x22))
  (global $OP_DIV i32 (i32.const 0x23))
  (global $OP_MOD i32 (i32.const 0x24))
  (global $OP_NEG i32 (i32.const 0x25))
  (global $OP_POW i32 (i32.const 0x26))
  (global $OP_UPLUS i32 (i32.const 0x2E))
  (global $OP_BAND i32 (i32.const 0x27))
  (global $OP_BOR i32 (i32.const 0x28))
  (global $OP_BXOR i32 (i32.const 0x29))
  (global $OP_BNOT i32 (i32.const 0x2A))
  (global $OP_SHL i32 (i32.const 0x2B))
  (global $OP_SHR i32 (i32.const 0x2C))
  (global $OP_USHR i32 (i32.const 0x2D))

  (global $OP_EQ i32 (i32.const 0x30))
  (global $OP_NEQ i32 (i32.const 0x31))
  (global $OP_LT i32 (i32.const 0x32))
  (global $OP_GT i32 (i32.const 0x33))
  (global $OP_LTE i32 (i32.const 0x34))
  (global $OP_GTE i32 (i32.const 0x35))

  (global $OP_NOT i32 (i32.const 0x40))
  (global $OP_AND i32 (i32.const 0x41))
  (global $OP_OR i32 (i32.const 0x42))
  (global $OP_NULLISH i32 (i32.const 0x43))
  (global $OP_TYPEOF i32 (i32.const 0x91))
  (global $OP_INSTANCEOF i32 (i32.const 0x92))
  (global $OP_VOID i32 (i32.const 0x93))
  (global $OP_DELETE i32 (i32.const 0x94))
  (global $OP_IN i32 (i32.const 0x95))
  (global $OP_GET_SUPER i32 (i32.const 0x96))  ;; super property read: [receiver, start] -> [receiver, value]
  (global $OP_SET_SUPER i32 (i32.const 0x97))  ;; super property write: [receiver, start, value] -> [value]

  (global $OP_JUMP i32 (i32.const 0x50))
  (global $OP_JUMP_IF_FALSE i32 (i32.const 0x51))
  (global $OP_JUMP_IF_TRUE i32 (i32.const 0x52))

  (global $OP_SCOPE_PUSH i32 (i32.const 0x60))
  (global $OP_SCOPE_POP i32 (i32.const 0x61))

  (global $OP_MAKE_CLOSURE i32 (i32.const 0x70))
  (global $OP_CALL i32 (i32.const 0x71))
  (global $OP_RETURN i32 (i32.const 0x72))
  (global $OP_RETURN_UNDEFINED i32 (i32.const 0x73))
  (global $OP_MAKE_ARROW_CLOSURE i32 (i32.const 0x74))
  (global $OP_CALL_METHOD i32 (i32.const 0x75))
  (global $OP_NEW i32 (i32.const 0x76))           ;; new Constructor(args)
  (global $OP_MAKE_ASYNC_CLOSURE i32 (i32.const 0x77))        ;; async function
  (global $OP_MAKE_ASYNC_ARROW_CLOSURE i32 (i32.const 0x78))  ;; async arrow function
  (global $OP_AWAIT i32 (i32.const 0x79))                     ;; await expression
  (global $OP_MAKE_GENERATOR_CLOSURE i32 (i32.const 0x7A))    ;; function* closure
  (global $OP_MAKE_ASYNC_GENERATOR_CLOSURE i32 (i32.const 0x7C)) ;; async function* closure
  (global $OP_YIELD i32 (i32.const 0x7B))                     ;; yield expression (generator bodies)

  (global $OP_MAKE_ARRAY i32 (i32.const 0x80))
  (global $OP_MAKE_OBJECT i32 (i32.const 0x81))
  (global $OP_GET_PROP i32 (i32.const 0x82))
  (global $OP_SET_PROP i32 (i32.const 0x83))
  (global $OP_GET_INDEX i32 (i32.const 0x84))
  (global $OP_SET_INDEX i32 (i32.const 0x85))
  ;; Spread (Cluster 2)
  (global $OP_ARRAY_PUSH_ONE i32 (i32.const 0x86))
  (global $OP_OBJ_MERGE_SPREAD i32 (i32.const 0x87))
  (global $OP_CALL_SPREAD i32 (i32.const 0x88))
  (global $OP_CALL_METHOD_SPREAD i32 (i32.const 0x89))
  (global $OP_WRAP_GETTER i32 (i32.const 0x8A))
  (global $OP_WRAP_SETTER i32 (i32.const 0x8B))
  (global $OP_NEW_SPREAD i32 (i32.const 0x8C))
  (global $OP_DELETE_PROP i32 (i32.const 0x8D))
  (global $OP_DELETE_INDEX i32 (i32.const 0x8E))
  (global $OP_CLASS_LINK i32 (i32.const 0x8F))

  ;; Iterator-protocol assertions
  (global $OP_ASSERT_ITER_RESULT i32 (i32.const 0xA3))
  (global $OP_ASSERT_ITERABLE i32 (i32.const 0xA4))

  (global $OP_THROW i32 (i32.const 0xB0))
  (global $OP_TRY_PUSH i32 (i32.const 0xB1))
  (global $OP_TRY_POP i32 (i32.const 0xB2))
  (global $OP_FINALLY_END i32 (i32.const 0xB3))
  (global $OP_UNWIND_JUMP i32 (i32.const 0xB4))
  (global $OP_PUSH_COMPLETION_KIND i32 (i32.const 0xB5))

  ;; Grant opcodes
  (global $OP_GRANT_START i32 (i32.const 0xC0))   ;; operand1 = denied addr, operand2 = grant count
  (global $OP_GRANT_END i32 (i32.const 0xC1))     ;; operand1 = count of entries to pop
  (global $OP_GRANT_DENIED i32 (i32.const 0xC2))  ;; operand1 = param name (0 if none)

  (global $OP_POP i32 (i32.const 0xF0))
  (global $OP_DUP i32 (i32.const 0xF1))
  (global $OP_SWAP i32 (i32.const 0xF2))
  (global $OP_RECONCILE_PARAMS i32 (i32.const 0xF3)) ;; operand1=paramCount, operand2=hasRest
  (global $OP_NOP i32 (i32.const 0xFF))

  ;; Region base offsets (mutable, read from STATE at init)
  ;; v6: Stack bases removed - now computed from current context
  (global $external_request_base (mut i32) (i32.const 0))
  (global $error_info_base (mut i32) (i32.const 0))
  (global $builtins_base (mut i32) (i32.const 0))

  ;; Cached segment-relative start of the string table. Populated by
  ;; init_regions; updated by the SS-region-resize primitive when the
  ;; table moves. Used by $string_id_to_abs to convert table-relative
  ;; interned-string ids to absolute addresses without a per-deref
  ;; read_state call on the hot path.
  (global $string_start (mut i32) (i32.const 0))

  ;; Cached segment size. Populated by init_regions; updated by the
  ;; SS-region-resize primitive when the segment grows or shrinks. Used
  ;; by the string-table overflow check in the dispatcher to decide
  ;; whether an upcoming allocation would push STATE_STRING_POINTER past
  ;; the segment end.
  (global $segment_size (mut i32) (i32.const 0))

  ;; Memory-pressure signal. Set to 1 by $intern_string or $string_concat
  ;; when a bounds check would overflow the string table or the
  ;; concat-scratch region; cleared by the dispatcher at the top of each
  ;; loop iteration. The chokepoint design: any string-allocating
  ;; opcode handler checks this flag immediately after its allocation
  ;; chain. If set, the handler must NOT consume its operands and must
  ;; NOT advance the instruction pointer — it instead writes
  ;; EXIT_MEMORY_PRESSURE and br $exit. On resume the dispatcher
  ;; re-executes the same instruction.
  ;;
  ;; Why a global flag rather than threading a sentinel return value
  ;; through every helper: $intern_string and $string_concat are called
  ;; from deep chains ($complex_to_decimal → $rational_to_decimal →
  ;; many $string_concat). A return-value sentinel would require audit
  ;; at every link. A global flag is read-only to all callers and
  ;; checked once at the opcode boundary — the natural granularity
  ;; for retry, since opcodes own the operand-on-pending-stack contract.
  (global $memory_pressure_signaled (mut i32) (i32.const 0))
  ;; Xorshift32 state for
  ;; gf_edf_zassenhaus's randomized equal-degree splitting (odd-p
  ;; branch). Deterministic-but-well-distributed by design -- EDF's
  ;; correctness never depends on WHICH splitting polynomial is found,
  ;; only on eventually finding one, so a fixed, advancing sequence is
  ;; appropriate (and keeps factorization results reproducible across
  ;; runs, unlike a true entropy source). Never 0 (xorshift's fixed
  ;; point); reseeded to a fixed nonzero constant only if it somehow
  ;; reaches 0.
  (global $galois_prng_state (mut i32) (i32.const 88172645))
  ;; Set by $json_stringify_value when its walk meets a TYPE_ACCESSOR
  ;; entry: the serializer unwinds and dispatch returns code 3 so the
  ;; caller can run the JSON_TRANSFORM driver (which invokes the getters)
  ;; and re-run stringify on the transformed copy.
  (global $json_met_accessor (mut i32) (i32.const 0))
  (global $throw_already_searched (mut i32) (i32.const 0))

  ;; Diagnostic: PC of the instruction currently being executed.
  ;; Written by the main dispatcher on every iteration; read by
  ;; set_error and stamped into error_info_base+8 so JS-side
  ;; diagnostics can identify which instruction triggered the error.
  (global $current_executing_pc (mut i32) (i32.const 0))

  ;; Current context base (mutable, set when context changes)
  ;; v6: All stack operations are relative to this base
  (global $current_context_base (mut i32) (i32.const 0))

  ;; Try entry layout (56 bytes — v17 added catchable engine-error
  ;; provenance for THROW completions; v12 added grant depth; v11 added
  ;; the per-entry completion; v9 added the saved pending position)
  (global $TRY_ENTRY_SIZE i32 (i32.const 56))
  (global $TRY_CATCH_INDEX i32 (i32.const 0))
  (global $TRY_FINALLY_INDEX i32 (i32.const 4))
  (global $TRY_FRAME_DEPTH i32 (i32.const 8))
  (global $TRY_SCOPE i32 (i32.const 12))
  ;; Layout v12: grant-stack depth (entry count) snapshot at try entry.
  ;; Handler entry and every entry pop clamp the grant stack back to it.
  (global $TRY_GRANT_DEPTH i32 (i32.const 40))
  ;; Pending position at try entry, BLOCK-RELATIVE (offset from pending
  ;; base — relocation-proof, same discipline as FRAME_PENDING_BASE).
  ;; Abnormal handler entries restore the pending pointer to it.
  (global $TRY_PENDING_POSITION i32 (i32.const 16))
  ;; v11: the entry's own pending completion. Entering a handler DISARMS
  ;; the entry in place (catch entry zeroes CATCH_INDEX; finally entry
  ;; zeroes both index fields) and, for finally entries, stores the
  ;; completion that resumes when the finally ends. FINALLY_END reads
  ;; the top entry's completion, pops the entry, and re-dispatches.
  ;; COMPLETION_VALUE is a 16-byte value slot for THROW (exception) and
  ;; RETURN (return value); for COMPLETION_JUMP its lo word is the jump
  ;; target and its hi word the remaining unwind count. THROW/RETURN
  ;; completion values are GC roots (marked and forwarded).
  (global $TRY_COMPLETION_TYPE i32 (i32.const 20))
  (global $TRY_COMPLETION_VALUE i32 (i32.const 24))
  ;; Layout v17: provenance for catchable engine errors diverted through
  ;; finally. ERROR_CODE 0 identifies an ordinary language-level throw.
  (global $TRY_ERROR_CODE i32 (i32.const 44))
  (global $TRY_ERROR_DETAIL i32 (i32.const 48))
  (global $TRY_ERROR_INSTRUCTION_INDEX i32 (i32.const 52))

  ;; Grant entry layout (32 bytes)
  ;; [identifierValue: 16 bytes][grantId: u32][deniedAddr: u32][scopePointer: u32][frameDepth: u32]
  (global $GRANT_ENTRY_SIZE i32 (i32.const 32))
  (global $GRANT_IDENTIFIER i32 (i32.const 0))   ;; 16-byte value slot
  (global $GRANT_GRANT_ID i32 (i32.const 16))    ;; u32
  (global $GRANT_DENIED_ADDR i32 (i32.const 20)) ;; u32
  (global $GRANT_SCOPE_POINTER i32 (i32.const 24)) ;; u32
  (global $GRANT_FRAME_DEPTH i32 (i32.const 28))   ;; u32

  ;; Current scope (mutable, set during execution)
  (global $current_scope (mut i32) (i32.const 0))

  ;; Scope recycling cache.
  ;; $scope_cache_list: intrusive LIFO free list of dead, never-
  ;; closure-captured scopes (a dead scope's parent field doubles as
  ;; the list link), fed by OP_SCOPE_POP. $scope_cache_pending: one
  ;; non-mutating note of the scope departed at OP_RETURN /
  ;; OP_RETURN_UNDEFINED dispatch — it may still be the live current
  ;; scope if that RETURN's continuation parks before replacing it,
  ;; so $scope_create's take path guards on inequality with
  ;; $current_scope. Both are zeroed at $run entry: collections only
  ;; run between run() calls, so stale heads never survive into use.
  (global $scope_cache_list (mut i32) (i32.const 0))
  (global $scope_cache_pending (mut i32) (i32.const 0))

  ;; Step ring — cached region metadata, refreshed at the top of $run.
  ;; The u32 write head is scoped by the ring header's nonzero segment
  ;; generation. Generation zero is the atomic wrap-transition seqlock;
  ;; terminal generation exhaustion disables only ring publication.
  (global $step_ring_base (mut i32) (i32.const 0))
  (global $step_ring_capacity (mut i32) (i32.const 0))
  ;; Ring 5 (5b): out-cursor for $expression_harvest_fill (the
  ;; denominator-condition collector). Same out-param-global idiom as
  ;; $matrix_reduce_rank.
  (global $harvest_cursor (mut i32) (i32.const 0))
  (global $step_ring_write_head (mut i32) (i32.const 0))

  ;; Header-event ring — cached region metadata, refreshed at the top of
  ;; $gc_collect. It follows the same segment-generation and terminal
  ;; exhaustion contract as the step ring.
  (global $header_event_ring_base (mut i32) (i32.const 0))
  (global $header_event_ring_capacity (mut i32) (i32.const 0))
  (global $header_event_ring_write_head (mut i32) (i32.const 0))

  ;; DIAGNOSTIC watchpoint (watch_pending_base_enable): per-instruction
  ;; check of the TYPE word at the current context's pending base+0.
  ;; When it transitions to TYPE_ARRAY while the operand stack is
  ;; non-empty, a sentinel step-ring entry (pc 0xFEFE, opcode 0xFE) is
  ;; written at the detection point — the previous ring entry is the
  ;; writer. Off by default (one branch per dispatch when disabled).
  (global $watch_pending_enabled (mut i32) (i32.const 0))
  (global $watch_pending_prev_type (mut i32) (i32.const 0))

  ;; Operand-stack underflow tripwire state (see $pending_pop). The
  ;; counter is always live; strict mode upgrades a NORMAL-execution
  ;; underflow from sentinel to fatal trap. STRICT BY DEFAULT since the
  ;; terminal-state guard landed (the only known clamp-dependent shape
  ;; was a double-driven finished slot re-executing trailing code);
  ;; SS_STRICT_STACK=0 opts out via strict_stack_disable.
  (global $stack_underflow_count (mut i32) (i32.const 0))
  (global $strict_stack_enabled (mut i32) (i32.const 1))
  (global $STEP_RING_HEADER_SIZE i32 (i32.const 16))
  (global $STEP_RING_ENTRY_SIZE i32 (i32.const 40))
  (global $HEADER_EVENT_RING_HEADER_SIZE i32 (i32.const 16))
  (global $HEADER_EVENT_RING_ENTRY_SIZE i32 (i32.const 32))
  (global $RING_FLAG_SEGMENT_SPACE_EXHAUSTED i32 (i32.const 1))

  ;; Header-event kinds (must match HEADER_EVENT_KIND in constants.js).
  (global $HEADER_EVENT_KIND_FIELD_WRITE i32 (i32.const 0))
  (global $HEADER_EVENT_KIND_GC_CYCLE_START i32 (i32.const 1))
  (global $HEADER_EVENT_KIND_GC_CYCLE_END i32 (i32.const 2))
  (global $HEADER_EVENT_KIND_CONTEXT_TABLE_GROWTH i32 (i32.const 3))
  (global $HEADER_EVENT_KIND_GC_CYCLE_PARKED_SLOTS i32 (i32.const 5))
  ;; Inline parked-slot bitmap capacity (must match
  ;; HEADER_EVENT_PARKED_BITMAP_BITS in constants.js): the entry's 16
  ;; RESERVED bytes, one bit per slot index.
  (global $HEADER_EVENT_PARKED_BITMAP_BITS i32 (i32.const 128))

  ;; Header-event fields (must match HEADER_EVENT_FIELD in constants.js).
  (global $HEADER_EVENT_FIELD_NONE i32 (i32.const 0))
  (global $HEADER_EVENT_FIELD_CONTEXT_TABLE_POINTER i32 (i32.const 1))
  (global $HEADER_EVENT_FIELD_ROOT_SCOPE i32 (i32.const 2))
  (global $HEADER_EVENT_FIELD_HEAP_POINTER i32 (i32.const 3))

  ;; Header-event sites (must match HEADER_EVENT_SITE in constants.js).
  ;; No WAT_GROW_CONTEXT_TABLE site: interpreter.wat never grows the
  ;; context table itself (allocateContext/_growContextTable are
  ;; JS-only — see memory-image.js); WAT only reads/forwards the
  ;; existing table's cell during GC compaction.
  (global $HEADER_EVENT_SITE_WAT_GC_UPDATE_POINTERS i32 (i32.const 1))
  (global $HEADER_EVENT_SITE_WAT_GC_MOVE_OBJECTS i32 (i32.const 2))
  (global $HEADER_EVENT_SITE_WAT_GC_COLLECT i32 (i32.const 8))

  ;; ==========================================================================
  ;; Helper: abs(offset) → absolute address
  ;; ==========================================================================
  (func $abs (param $offset i32) (result i32)
    (i32.add (global.get $base_offset) (local.get $offset))
  )

  ;; ==========================================================================
  ;; Helper: read state field
  ;; ==========================================================================
  (func $read_state (param $field i32) (result i32)
    (i32.load (call $abs (local.get $field)))
  )

  (func $write_state (param $field i32) (param $value i32)
    (i32.store (call $abs (local.get $field)) (local.get $value))
  )

  ;; Helper: read from BUILTINS segment
  ;; ==========================================================================
  (func $read_builtin (param $offset i32) (result i32)
    (i32.load (call $abs (i32.add (global.get $builtins_base) (local.get $offset))))
  )

  ;; ==========================================================================
  ;; Helper: scratch_ptr(offset, bytes) → absolute address into SCRATCH
  ;;
  ;; The ONLY path into the scratch region — build-enforced: no other
  ;; function may reference $STATE_SCRATCH_BASE (see
  ;; tools/verify-region-write-discipline.js). Callers declare the
  ;; extent [offset, offset+bytes) they are about to touch. A bounds
  ;; violation traps: every WAT scratch use has a static extent, so an
  ;; overflow here is an interpreter defect, never program-dependent
  ;; pressure (the pressure protocol is for data-dependent sizes —
  ;; interning, heap allocation). computeVatLayout enforces
  ;; SCRATCH_MINIMUM_SIZE so legal sessions never reach this trap.
  ;; ==========================================================================
  (func $scratch_ptr (param $offset i32) (param $bytes i32) (result i32)
    (if (i32.gt_u
          (i32.add (local.get $offset) (local.get $bytes))
          (call $read_state (global.get $STATE_SCRATCH_REGION_SIZE)))
      (then unreachable))
    (call $abs (i32.add (call $read_state (global.get $STATE_SCRATCH_BASE)) (local.get $offset)))
  )

  ;; ==========================================================================
  ;; f64_to_string: Convert a float to an interned string
  ;; Handles: NaN, Infinity, -Infinity, integers, and decimal floats
  ;; ==========================================================================
  ;; Convert a finite f64 with |x| >= 2^52 (always integral at that
  ;; magnitude) into a BigInt header, exactly: decompose into
  ;; mantissa × 2^exponent and shift. Callers use this where an
  ;; i64.trunc would trap (|x| >= 2^63 — String(1e300) and
  ;; BigInt(1e300) used to kill the module).
  (func $bigint_from_f64 (param $x f64) (result i32)
    (local $bits i64)
    (local $sign i32)
    (local $exponent i32)
    (local $mantissa i64)
    (local $mant_bigint i32)
    (local $shift_bigint i32)
    (local.set $sign (i32.const 0))
    (if (f64.lt (local.get $x) (f64.const 0))
      (then
        (local.set $sign (i32.const 1))
        (local.set $x (f64.neg (local.get $x)))))
    (local.set $bits (i64.reinterpret_f64 (local.get $x)))
    ;; Unbiased exponent minus mantissa width: x = mantissa * 2^exponent.
    (local.set $exponent (i32.sub
      (i32.wrap_i64 (i64.and (i64.shr_u (local.get $bits) (i64.const 52)) (i64.const 0x7FF)))
      (i32.const 1075)))
    ;; 53-bit significand with the implicit leading bit (|x| >= 2^52
    ;; is always a normal number).
    (local.set $mantissa (i64.or
      (i64.and (local.get $bits) (i64.const 0xFFFFFFFFFFFFF))
      (i64.const 0x10000000000000)))
    ;; Integral values below 2^53 carry a negative exponent; the
    ;; right-shift is exact because the value is integral.
    (if (i32.lt_s (local.get $exponent) (i32.const 0))
      (then
        (local.set $mantissa (i64.shr_u (local.get $mantissa)
          (i64.extend_i32_u (i32.sub (i32.const 0) (local.get $exponent)))))
        (local.set $exponent (i32.const 0))))
    (local.set $mant_bigint (call $bigint_alloc (local.get $sign) (i32.const 2)))
    (call $bigint_set_limb (local.get $mant_bigint) (i32.const 0)
      (i32.wrap_i64 (local.get $mantissa)))
    (call $bigint_set_limb (local.get $mant_bigint) (i32.const 1)
      (i32.wrap_i64 (i64.shr_u (local.get $mantissa) (i64.const 32))))
    (call $bigint_normalize (local.get $mant_bigint))
    (if (i32.eqz (local.get $exponent))
      (then (return (local.get $mant_bigint))))
    (local.set $shift_bigint (call $bigint_alloc (i32.const 0) (i32.const 1)))
    (call $bigint_set_limb (local.get $shift_bigint) (i32.const 0) (local.get $exponent))
    (call $bigint_shift_left (local.get $mant_bigint) (local.get $shift_bigint))
  )

  ;; Number.prototype.toString(radix) for radix 2-36. Digits build in
  ;; scratch: integer part exactly via i64 (values beyond 2^53 have no
  ;; exact decimal anyway), fractional part by repeated multiplication,
  ;; capped at 20 digits (long binary tails may print shorter than V8's
  ;; full expansion — documented divergence). Returns the interned
  ;; string id; the caller checks the pressure flag.
  (func $number_to_string_radix (param $val f64) (param $radix i32) (result i32)
    (local $scratch i32)
    (local $write_position i32)
    (local $digit_start i32)
    (local $integer_part i64)
    (local $fraction f64)
    (local $digit i32)
    (local $swap_left i32)
    (local $swap_right i32)
    (local $swap_byte i32)
    (local $radix_i64 i64)
    (local.set $scratch (call $scratch_ptr (i32.const 0) (i32.const 96)))
    (local.set $write_position (i32.const 0))
    ;; Sign
    (if (f64.lt (local.get $val) (f64.const 0))
      (then
        (i32.store8 (i32.add (local.get $scratch) (local.get $write_position)) (i32.const 45))  ;; '-'
        (local.set $write_position (i32.add (local.get $write_position) (i32.const 1)))
        (local.set $val (f64.neg (local.get $val)))))
    ;; Integer part digits, built forward then reversed in place.
    (local.set $integer_part (i64.trunc_sat_f64_u (local.get $val)))
    (local.set $fraction (f64.sub (local.get $val) (f64.convert_i64_u (local.get $integer_part))))
    (local.set $radix_i64 (i64.extend_i32_u (local.get $radix)))
    (local.set $digit_start (local.get $write_position))
    (if (i64.eqz (local.get $integer_part))
      (then
        (i32.store8 (i32.add (local.get $scratch) (local.get $write_position)) (i32.const 48))  ;; '0'
        (local.set $write_position (i32.add (local.get $write_position) (i32.const 1))))
      (else
        (block $radix_int_done
          (loop $radix_int_digits
            (br_if $radix_int_done (i64.eqz (local.get $integer_part)))
            (local.set $digit (i32.wrap_i64 (i64.rem_u (local.get $integer_part) (local.get $radix_i64))))
            (i32.store8 (i32.add (local.get $scratch) (local.get $write_position))
              (i32.add (local.get $digit)
                (if (result i32) (i32.lt_u (local.get $digit) (i32.const 10))
                  (then (i32.const 48))          ;; '0'
                  (else (i32.const 87)))))       ;; 'a' - 10
            (local.set $write_position (i32.add (local.get $write_position) (i32.const 1)))
            (local.set $integer_part (i64.div_u (local.get $integer_part) (local.get $radix_i64)))
            (br $radix_int_digits)
          )
        )
        ;; Reverse the digit run [digit_start, write_position).
        (local.set $swap_left (local.get $digit_start))
        (local.set $swap_right (i32.sub (local.get $write_position) (i32.const 1)))
        (block $radix_reverse_done
          (loop $radix_reverse
            (br_if $radix_reverse_done (i32.ge_s (local.get $swap_left) (local.get $swap_right)))
            (local.set $swap_byte (i32.load8_u (i32.add (local.get $scratch) (local.get $swap_left))))
            (i32.store8 (i32.add (local.get $scratch) (local.get $swap_left))
              (i32.load8_u (i32.add (local.get $scratch) (local.get $swap_right))))
            (i32.store8 (i32.add (local.get $scratch) (local.get $swap_right)) (local.get $swap_byte))
            (local.set $swap_left (i32.add (local.get $swap_left) (i32.const 1)))
            (local.set $swap_right (i32.sub (local.get $swap_right) (i32.const 1)))
            (br $radix_reverse)
          )
        )
      )
    )
    ;; Fractional digits (up to 20; stop when the remainder hits zero).
    (if (f64.gt (local.get $fraction) (f64.const 0))
      (then
        (i32.store8 (i32.add (local.get $scratch) (local.get $write_position)) (i32.const 46))  ;; '.'
        (local.set $write_position (i32.add (local.get $write_position) (i32.const 1)))
        (local.set $digit_start (i32.const 0))   ;; reuse as the fraction-digit counter
        (block $radix_frac_done
          (loop $radix_frac_digits
            (br_if $radix_frac_done (i32.ge_u (local.get $digit_start) (i32.const 20)))
            (br_if $radix_frac_done (f64.eq (local.get $fraction) (f64.const 0)))
            (local.set $fraction (f64.mul (local.get $fraction) (f64.convert_i32_u (local.get $radix))))
            (local.set $digit (i32.trunc_sat_f64_u (f64.floor (local.get $fraction))))
            (local.set $fraction (f64.sub (local.get $fraction) (f64.floor (local.get $fraction))))
            (i32.store8 (i32.add (local.get $scratch) (local.get $write_position))
              (i32.add (local.get $digit)
                (if (result i32) (i32.lt_u (local.get $digit) (i32.const 10))
                  (then (i32.const 48))
                  (else (i32.const 87)))))
            (local.set $write_position (i32.add (local.get $write_position) (i32.const 1)))
            (local.set $digit_start (i32.add (local.get $digit_start) (i32.const 1)))
            (br $radix_frac_digits)
          )
        )
      )
    )
    (call $intern_string (local.get $scratch) (local.get $write_position))
  )

  ;; Number.prototype.toFixed(digits) for 0 <= digits <= 100. Spec: round
  ;; half away from zero at the digits-th decimal (floor(scaled + 0.5) on
  ;; the absolute value). Digits beyond i64 precision (or scaled values
  ;; past 2^63) pad with zeros — exact only within double precision,
  ;; matching practical usage. |val| >= 1e21 falls back to the plain
  ;; stringification, per spec. Returns the interned string id; the
  ;; caller checks the pressure flag.
  (func $number_to_fixed (param $val f64) (param $digits i32) (result i32)
    (local $scratch i32)
    (local $write_position i32)
    (local $digit_start i32)
    (local $scaled f64)
    (local $rounded i64)
    (local $power i64)
    (local $power_count i32)
    (local $integer_part i64)
    (local $fraction_part i64)
    (local $effective_digits i32)
    (local $pad_zeros i32)
    (local $digit i32)
    (local $swap_left i32)
    (local $swap_right i32)
    (local $swap_byte i32)
    (local $negative i32)
    (if (f64.ge (f64.abs (local.get $val)) (f64.const 1e21))
      (then (return (call $f64_to_string (local.get $val)))))
    (local.set $negative (f64.lt (local.get $val) (f64.const 0)))
    (if (local.get $negative)
      (then (local.set $val (f64.neg (local.get $val)))))
    ;; Digits past 17 exceed double precision — compute 17, pad the rest.
    (local.set $effective_digits (local.get $digits))
    (local.set $pad_zeros (i32.const 0))
    (if (i32.gt_u (local.get $effective_digits) (i32.const 17))
      (then
        (local.set $pad_zeros (i32.sub (local.get $effective_digits) (i32.const 17)))
        (local.set $effective_digits (i32.const 17))))
    ;; power = 10^effective_digits (fits i64 for <= 18)
    (local.set $power (i64.const 1))
    (local.set $power_count (i32.const 0))
    (block $fixed_power_done
      (loop $fixed_power
        (br_if $fixed_power_done (i32.ge_u (local.get $power_count) (local.get $effective_digits)))
        (local.set $power (i64.mul (local.get $power) (i64.const 10)))
        (local.set $power_count (i32.add (local.get $power_count) (i32.const 1)))
        (br $fixed_power)
      )
    )
    (local.set $scaled (f64.mul (local.get $val) (f64.convert_i64_u (local.get $power))))
    ;; Beyond i64: give up on rounding precision, print the plain form.
    (if (f64.ge (local.get $scaled) (f64.const 9.2e18))
      (then (return (call $f64_to_string (if (result f64) (local.get $negative) (then (f64.neg (local.get $val))) (else (local.get $val)))))))
    (local.set $rounded (i64.trunc_sat_f64_u (f64.floor (f64.add (local.get $scaled) (f64.const 0.5)))))
    (local.set $integer_part (i64.div_u (local.get $rounded) (local.get $power)))
    (local.set $fraction_part (i64.rem_u (local.get $rounded) (local.get $power)))
    (local.set $scratch (call $scratch_ptr (i32.const 0) (i32.const 160)))
    (local.set $write_position (i32.const 0))
    ;; The sign follows the input's strict negativity, even when the
    ;; rounded value is zero: (-0.004).toFixed(2) is "-0.00" in JS
    ;; (while (-0).toFixed(2) is "0.00" — f64.lt(-0, 0) is false).
    (if (local.get $negative)
      (then
        (i32.store8 (i32.add (local.get $scratch) (local.get $write_position)) (i32.const 45))
        (local.set $write_position (i32.add (local.get $write_position) (i32.const 1)))))
    ;; Integer part (forward-build + reverse).
    (local.set $digit_start (local.get $write_position))
    (if (i64.eqz (local.get $integer_part))
      (then
        (i32.store8 (i32.add (local.get $scratch) (local.get $write_position)) (i32.const 48))
        (local.set $write_position (i32.add (local.get $write_position) (i32.const 1))))
      (else
        (block $fixed_int_done
          (loop $fixed_int_digits
            (br_if $fixed_int_done (i64.eqz (local.get $integer_part)))
            (i32.store8 (i32.add (local.get $scratch) (local.get $write_position))
              (i32.add (i32.wrap_i64 (i64.rem_u (local.get $integer_part) (i64.const 10))) (i32.const 48)))
            (local.set $write_position (i32.add (local.get $write_position) (i32.const 1)))
            (local.set $integer_part (i64.div_u (local.get $integer_part) (i64.const 10)))
            (br $fixed_int_digits)
          )
        )
        (local.set $swap_left (local.get $digit_start))
        (local.set $swap_right (i32.sub (local.get $write_position) (i32.const 1)))
        (block $fixed_reverse_done
          (loop $fixed_reverse
            (br_if $fixed_reverse_done (i32.ge_s (local.get $swap_left) (local.get $swap_right)))
            (local.set $swap_byte (i32.load8_u (i32.add (local.get $scratch) (local.get $swap_left))))
            (i32.store8 (i32.add (local.get $scratch) (local.get $swap_left))
              (i32.load8_u (i32.add (local.get $scratch) (local.get $swap_right))))
            (i32.store8 (i32.add (local.get $scratch) (local.get $swap_right)) (local.get $swap_byte))
            (local.set $swap_left (i32.add (local.get $swap_left) (i32.const 1)))
            (local.set $swap_right (i32.sub (local.get $swap_right) (i32.const 1)))
            (br $fixed_reverse)
          )
        )
      )
    )
    ;; Fraction: exactly effective_digits digits, zero-padded on the
    ;; left, plus pad_zeros trailing zeros.
    (if (local.get $digits)
      (then
        (i32.store8 (i32.add (local.get $scratch) (local.get $write_position)) (i32.const 46))  ;; '.'
        (local.set $write_position (i32.add (local.get $write_position) (i32.const 1)))
        ;; Build the fraction digits at fixed width (write backwards from
        ;; the end of the run).
        (local.set $digit_start (local.get $write_position))
        (local.set $write_position (i32.add (local.get $write_position) (local.get $effective_digits)))
        (local.set $swap_left (i32.sub (local.get $write_position) (i32.const 1)))
        (block $fixed_frac_done
          (loop $fixed_frac_digits
            (br_if $fixed_frac_done (i32.lt_s (local.get $swap_left) (local.get $digit_start)))
            (i32.store8 (i32.add (local.get $scratch) (local.get $swap_left))
              (i32.add (i32.wrap_i64 (i64.rem_u (local.get $fraction_part) (i64.const 10))) (i32.const 48)))
            (local.set $fraction_part (i64.div_u (local.get $fraction_part) (i64.const 10)))
            (local.set $swap_left (i32.sub (local.get $swap_left) (i32.const 1)))
            (br $fixed_frac_digits)
          )
        )
        (block $fixed_pad_done
          (loop $fixed_pad
            (br_if $fixed_pad_done (i32.eqz (local.get $pad_zeros)))
            (i32.store8 (i32.add (local.get $scratch) (local.get $write_position)) (i32.const 48))
            (local.set $write_position (i32.add (local.get $write_position) (i32.const 1)))
            (local.set $pad_zeros (i32.sub (local.get $pad_zeros) (i32.const 1)))
            (br $fixed_pad)
          )
        )
      )
    )
    (call $intern_string (local.get $scratch) (local.get $write_position))
  )

  (func $f64_to_string (param $val f64) (result i32)
    (local $int_part i64)
    (local $frac_part f64)
    (local $is_negative i32)
    (local $temporary_pointer i32)
    (local $len i32)
    (local $digit i32)
    (local $abs_val f64)
    (local $i i32)
    (local $frac_digits i32)
    (local $temp i64)
    (local $byte_pointer i32)

    ;; Check for NaN
    (if (f64.ne (local.get $val) (local.get $val))
      (then
        (return (call $read_builtin (global.get $BUILTIN_LIT_NAN)))
      )
    )

    ;; Check for positive infinity
    (if (f64.eq (local.get $val) (f64.const inf))
      (then
        (return (call $read_builtin (global.get $BUILTIN_LIT_INFINITY)))
      )
    )

    ;; Check for negative infinity
    (if (f64.eq (local.get $val) (f64.const -inf))
      (then
        (return (call $read_builtin (global.get $BUILTIN_LIT_NEG_INFINITY)))
      )
    )

    ;; |val| >= 2^63 doesn't fit the i64 integer-part path below (the
    ;; trunc would trap) — values at that magnitude are integral, so
    ;; print the exact digits via the BigInt decimal converter.
    ;; Pressure pre-check for $bigint_from_f64's throwaway bigints
    ;; (mantissa 2-limb + shift 1-limb + shifted result ≤33 limbs ≈
    ;; 224 aligned bytes; 512 with slop). Unguarded, this carve
    ;; compounds under stringify/join-driven loops, so the allocation
    ;; must be refused when it cannot fit. Refusal returns 0
    ;; with the flag set; callers already check the flag.
    (if (f64.ge (f64.abs (local.get $val)) (f64.const 9223372036854775808))
      (then
        (if (call $check_heap_overflow (i32.const 512))
          (then (return (i32.const 0))))
        (return (call $bigint_to_decimal (call $bigint_from_f64 (local.get $val))))
      )
    )

    ;; Build the string in the dedicated scratch region. Static max
    ;; extent: [len:4][sign:1][int digits:≤20][.:1][frac digits:≤10] = 36.
    (local.set $temporary_pointer (call $scratch_ptr (i32.const 0) (i32.const 36)))
    (local.set $byte_pointer (i32.add (local.get $temporary_pointer) (i32.const 4))) ;; skip length prefix

    ;; Handle negative
    (local.set $is_negative (i32.const 0))
    (if (f64.lt (local.get $val) (f64.const 0))
      (then
        (local.set $is_negative (i32.const 1))
        (local.set $val (f64.neg (local.get $val)))
      )
    )
    (local.set $abs_val (local.get $val))

    ;; Check if it's an integer (no fractional part)
    (local.set $int_part (i64.trunc_f64_s (local.get $val)))
    (local.set $frac_part (f64.sub (local.get $val) (f64.convert_i64_s (local.get $int_part))))

    ;; If negative, write '-'
    (if (local.get $is_negative)
      (then
        (i32.store8 (local.get $byte_pointer) (i32.const 45)) ;; '-'
        (local.set $byte_pointer (i32.add (local.get $byte_pointer) (i32.const 1)))
        (local.set $len (i32.const 1))
      )
      (else
        (local.set $len (i32.const 0))
      )
    )

    ;; Handle zero specially
    (if (i64.eqz (local.get $int_part))
      (then
        (i32.store8 (local.get $byte_pointer) (i32.const 48)) ;; '0'
        (local.set $byte_pointer (i32.add (local.get $byte_pointer) (i32.const 1)))
        (local.set $len (i32.add (local.get $len) (i32.const 1)))
      )
      (else
        ;; Convert integer part - write digits in reverse, then reverse
        (local.set $i (local.get $len))
        (local.set $temp (local.get $int_part))
        (block $int_done
          (loop $int_loop
            (br_if $int_done (i64.eqz (local.get $temp)))
            (local.set $digit (i32.wrap_i64 (i64.rem_u (local.get $temp) (i64.const 10))))
            (i32.store8 (local.get $byte_pointer) (i32.add (i32.const 48) (local.get $digit)))
            (local.set $byte_pointer (i32.add (local.get $byte_pointer) (i32.const 1)))
            (local.set $len (i32.add (local.get $len) (i32.const 1)))
            (local.set $temp (i64.div_u (local.get $temp) (i64.const 10)))
            (br $int_loop)
          )
        )
        ;; Reverse the integer digits (from position $i to $len-1)
        (call $reverse_bytes
          (i32.add (i32.add (local.get $temporary_pointer) (i32.const 4)) (local.get $i))
          (i32.sub (local.get $len) (local.get $i)))
        (local.set $byte_pointer (i32.add (i32.add (local.get $temporary_pointer) (i32.const 4)) (local.get $len)))
      )
    )

    ;; Add fractional part if present (only if abs(frac) > 1e-10)
    (if (f64.gt (f64.abs (local.get $frac_part)) (f64.const 1e-10))
      (then
        ;; Add decimal point
        (i32.store8 (local.get $byte_pointer) (i32.const 46)) ;; '.'
        (local.set $byte_pointer (i32.add (local.get $byte_pointer) (i32.const 1)))
        (local.set $len (i32.add (local.get $len) (i32.const 1)))

        ;; Add fractional digits (up to 10, trimming trailing zeros)
        (local.set $frac_digits (i32.const 0))
        (block $frac_done
          (loop $frac_loop
            (br_if $frac_done (i32.ge_u (local.get $frac_digits) (i32.const 10)))
            (local.set $frac_part (f64.mul (local.get $frac_part) (f64.const 10)))
            (local.set $digit (i32.trunc_f64_s (local.get $frac_part)))
            (local.set $frac_part (f64.sub (local.get $frac_part) (f64.convert_i32_s (local.get $digit))))
            (i32.store8 (local.get $byte_pointer) (i32.add (i32.const 48) (local.get $digit)))
            (local.set $byte_pointer (i32.add (local.get $byte_pointer) (i32.const 1)))
            (local.set $len (i32.add (local.get $len) (i32.const 1)))
            (local.set $frac_digits (i32.add (local.get $frac_digits) (i32.const 1)))
            ;; Stop if remaining fraction is negligible
            (br_if $frac_done (f64.lt (f64.abs (local.get $frac_part)) (f64.const 1e-10)))
            (br $frac_loop)
          )
        )

        ;; Trim trailing zeros (but keep at least one digit after decimal)
        (block $trim_done
          (loop $trim_loop
            ;; Stop if we're at the decimal point + 1 digit
            (br_if $trim_done (i32.le_u (local.get $len) (i32.add (local.get $i) (i32.const 2))))
            ;; Check last byte
            (local.set $byte_pointer (i32.sub (local.get $byte_pointer) (i32.const 1)))
            (br_if $trim_done (i32.ne (i32.load8_u (local.get $byte_pointer)) (i32.const 48)))
            (local.set $len (i32.sub (local.get $len) (i32.const 1)))
            (br $trim_loop)
          )
        )
      )
    )

    ;; Store length at temp_pointer
    (i32.store (local.get $temporary_pointer) (local.get $len))

    ;; Intern the string
    (call $intern_string (i32.add (local.get $temporary_pointer) (i32.const 4)) (local.get $len))
  )

  ;; Helper: reverse bytes in place
  (func $reverse_bytes (param $pointer i32) (param $len i32)
    (local $left i32)
    (local $right i32)
    (local $tmp i32)

    (local.set $left (local.get $pointer))
    (local.set $right (i32.sub (i32.add (local.get $pointer) (local.get $len)) (i32.const 1)))

    (block $done
      (loop $loop
        (br_if $done (i32.ge_u (local.get $left) (local.get $right)))
        (local.set $tmp (i32.load8_u (local.get $left)))
        (i32.store8 (local.get $left) (i32.load8_u (local.get $right)))
        (i32.store8 (local.get $right) (local.get $tmp))
        (local.set $left (i32.add (local.get $left) (i32.const 1)))
        (local.set $right (i32.sub (local.get $right) (i32.const 1)))
        (br $loop)
      )
    )
  )

  ;; ==========================================================================
  ;; bigint_to_decimal: exact decimal string for a BigInt header pointer.
  ;; Algorithm: clone the magnitude onto the GC heap, then repeatedly
  ;; divmod by 10 from the most-significant limb down, emitting the
  ;; remainder as a digit. Digits are written in reverse into heap-tail
  ;; scratch, then reversed in place. Interned result is returned.
  ;;
  ;; Limbs are unsigned 32-bit; divmod uses i64 to carry across limbs.
  ;; The clone is a throwaway BigInt — on the next GC cycle it is collected.
  ;;
  ;; Scratch placement: the digit buffer lives at the bytes past
  ;; STATE_HEAP_POINTER (same pattern as $string_concat and the 8 string
  ;; methods). A 32-bit limb produces at most 10 decimal digits, so the
  ;; output is bounded by length*10 + 1 (sign byte). We pre-check that
  ;; budget against STATE_CODE_POINTER and signal memory pressure if
  ;; it would overflow. The decimal buffer cannot use the fixed SCRATCH
  ;; region because bigints may require more than 256 digits; its bytes
  ;; must remain inside the heap/code free span.
  ;; ==========================================================================
  (func $bigint_to_radix (param $header i32) (param $radix i32) (result i32)
    (local $length i32)
    (local $sign i32)
    (local $work i32)
    (local $scratch_base i32)
    (local $byte_pointer i32)
    (local $str_len i32)
    (local $i i32)
    (local $carry i64)
    (local $limb i64)
    (local $acc i64)
    (local $is_zero i32)
    (local $top_limb i32)
    (local $byte_budget i32)
    (local $digit i32)

    (local.set $length (call $bigint_length (local.get $header)))
    (local.set $sign (call $bigint_sign (local.get $header)))

    ;; Zero case — empty magnitude means value is 0. Use the empty-string
    ;; builtin "0" via direct intern of a single literal byte. The
    ;; budget check below would pass trivially, but handling the case
    ;; first avoids the $bigint_alloc round-trip on a hot path.
    (if (i32.eqz (local.get $length))
      (then
        (local.set $scratch_base
          (call $abs (call $read_state (global.get $STATE_HEAP_POINTER))))
        (if (call $check_concat_scratch_overflow (i32.const 1))
          (then (return (i32.const 0)))
        )
        (i32.store8 (local.get $scratch_base) (i32.const 48)) ;; '0'
        (return (call $intern_string (local.get $scratch_base) (i32.const 1)))
      )
    )

    ;; Clone magnitude onto the heap so we can mutate. This bumps
    ;; STATE_HEAP_POINTER — so we MUST read scratch_base AFTER the
    ;; allocation, otherwise our scratch would overlap the bigint's
    ;; own bytes.
    ;;
    ;; Pressure pre-check with the clone's honest aligned size —
    ;; $bigint_alloc is unguarded, and this conversion runs many times
    ;; inside one instruction under JSON.stringify / array join
    ;; and therefore require an allocation refusal. Refusal returns 0
    ;; with the flag set, same contract as the scratch refusals below.
    (if (call $check_heap_overflow
          (i32.and
            (i32.add
              (i32.add (global.get $GC_HEADER_SIZE)
                (i32.add (i32.const 8) (i32.mul (local.get $length) (i32.const 4))))
              (i32.const 15))
            (i32.const -16)))
      (then (return (i32.const 0))))
    (local.set $work (call $bigint_alloc (i32.const 0) (local.get $length)))
    (local.set $i (i32.const 0))
    (block $copy_done
      (loop $copy_loop
        (br_if $copy_done (i32.ge_u (local.get $i) (local.get $length)))
        (call $bigint_set_limb (local.get $work) (local.get $i)
          (call $bigint_limb (local.get $header) (local.get $i)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $copy_loop)
      )
    )

    ;; Pre-check scratch overflow now that heap_pointer has been bumped
    ;; past the work bigint. Binary is the longest supported rendering:
    ;; at most 32 digits per limb plus one sign.
    (local.set $byte_budget
      (i32.add (i32.mul (local.get $length) (i32.const 32)) (i32.const 2)))
    (if (call $check_concat_scratch_overflow (local.get $byte_budget))
      (then (return (i32.const 0)))
    )

    ;; Heap-tail scratch (absolute address), past the work bigint.
    ;; Digits are written least-significant-first; we reverse at the end.
    (local.set $scratch_base
      (call $abs (call $read_state (global.get $STATE_HEAP_POINTER))))
    (local.set $byte_pointer (local.get $scratch_base))
    (local.set $str_len (i32.const 0))

    ;; Extract digits by repeated division by the requested radix.
    (block $digits_done
      (loop $digits_loop
        ;; Divide $work in place, walking from the top limb down.
        (local.set $carry (i64.const 0))
        (local.set $i (local.get $length))
        (block $div_done
          (loop $div_loop
            (br_if $div_done (i32.eqz (local.get $i)))
            (local.set $i (i32.sub (local.get $i) (i32.const 1)))
            (local.set $limb (i64.extend_i32_u
              (call $bigint_limb (local.get $work) (local.get $i))))
            (local.set $acc (i64.or
              (i64.shl (local.get $carry) (i64.const 32))
              (local.get $limb)))
            (call $bigint_set_limb (local.get $work) (local.get $i)
              (i32.wrap_i64
                (i64.div_u (local.get $acc) (i64.extend_i32_u (local.get $radix)))))
            (local.set $carry
              (i64.rem_u (local.get $acc) (i64.extend_i32_u (local.get $radix))))
            (br $div_loop)
          )
        )

        ;; Remainder is the next lowercase digit, emitted in reverse.
        (local.set $digit (i32.wrap_i64 (local.get $carry)))
        (i32.store8 (local.get $byte_pointer)
          (select
            (i32.add (i32.const 48) (local.get $digit))
            (i32.add (i32.const 87) (local.get $digit))
            (i32.lt_u (local.get $digit) (i32.const 10))))
        (local.set $byte_pointer (i32.add (local.get $byte_pointer) (i32.const 1)))
        (local.set $str_len (i32.add (local.get $str_len) (i32.const 1)))

        ;; Check if any limb is non-zero; also shrink length when top limb
        ;; falls to zero to avoid unnecessary iterations.
        (local.set $top_limb (call $bigint_limb (local.get $work)
          (i32.sub (local.get $length) (i32.const 1))))
        (block $shrink_done
          (loop $shrink_loop
            (br_if $shrink_done (i32.eqz (local.get $length)))
            (br_if $shrink_done (i32.ne (local.get $top_limb) (i32.const 0)))
            (local.set $length (i32.sub (local.get $length) (i32.const 1)))
            (if (i32.eqz (local.get $length))
              (then (br $shrink_done))
            )
            (local.set $top_limb (call $bigint_limb (local.get $work)
              (i32.sub (local.get $length) (i32.const 1))))
            (br $shrink_loop)
          )
        )

        (br_if $digits_done (i32.eqz (local.get $length)))
        (br $digits_loop)
      )
    )

    ;; Minus sign for negative values.
    (if (local.get $sign)
      (then
        (i32.store8 (local.get $byte_pointer) (i32.const 45)) ;; '-'
        (local.set $str_len (i32.add (local.get $str_len) (i32.const 1)))
      )
    )

    ;; Reverse digits (and sign) to produce most-significant-first.
    (call $reverse_bytes
      (local.get $scratch_base)
      (local.get $str_len))

    (call $intern_string (local.get $scratch_base) (local.get $str_len))
  )

  (func $bigint_to_decimal (param $header i32) (result i32)
    (call $bigint_to_radix (local.get $header) (i32.const 10))
  )

  ;; ==========================================================================
  ;; rational_to_decimal: exact decimal string for a Rational value.
  ;; Inline rationals are integer-valued; stringify via a throwaway BigInt.
  ;; Heap rationals print numerator; append "/denominator" only when the
  ;; denominator is not 1 (the canonical reduced form always has positive
  ;; denominator, so we never need to hide a sign there).
  ;; ==========================================================================
  (func $rational_to_decimal (param $value_pointer i32) (result i32)
    (local $header i32)
    (local $numerator i32)
    (local $denominator i32)
    (local $numerator_str i32)
    (local $denominator_str i32)

    ;; Pressure pre-check for temporary BigInts created while converting
    ;; rationals to strings. The inline arm uses $bigint_from_i64
    ;; (at most two limbs, 32 aligned bytes; 96 bytes includes slop).
    ;; BigInt allocation is intentionally unguarded on arithmetic-hot paths,
    ;; but a single stringify or join instruction can perform many
    ;; conversions and exhaust the heap/code free span. Refuse before
    ;; carving; return 0 with the pressure flag set so every driver exits
    ;; to the opcode boundary and yields EXIT_MEMORY_PRESSURE without
    ;; mutation. Resume can then retry after collection.






    (if (call $check_heap_overflow (i32.const 96))
      (then (return (i32.const 0))))

    (if (call $rational_is_inline (local.get $value_pointer))
      (then
        (return (call $bigint_to_decimal
          (call $bigint_from_i64
            (call $rational_read_inline (local.get $value_pointer)))))
      )
    )
    (local.set $header (call $value_data_lo (local.get $value_pointer)))
    (local.set $numerator (call $rational_numerator (local.get $header)))
    (local.set $denominator (call $rational_denominator (local.get $header)))
    (local.set $numerator_str (call $bigint_to_decimal (local.get $numerator)))
    ;; Denominator == 1 → integer form.
    (if (i32.and
          (i32.eq (call $bigint_length (local.get $denominator)) (i32.const 1))
          (i32.eq (call $bigint_limb (local.get $denominator) (i32.const 0)) (i32.const 1)))
      (then (return (local.get $numerator_str)))
    )
    (local.set $denominator_str (call $bigint_to_decimal (local.get $denominator)))
    (call $string_concat
      (call $string_concat (local.get $numerator_str)
        (call $read_builtin (global.get $BUILTIN_EXACT_SLASH)))
      (local.get $denominator_str))
  )

  ;; ==========================================================================
  ;; rational_is_zero / rational_is_one / rational_is_neg_one:
  ;; cheap predicates used by complex_to_decimal to pick a format.
  ;; Operate on a value_pointer (handles inline and heap forms).
  ;; ==========================================================================
  (func $rational_is_zero (param $value_pointer i32) (result i32)
    (local $numerator i32)
    (if (call $rational_is_inline (local.get $value_pointer))
      (then (return (i64.eqz (call $rational_read_inline (local.get $value_pointer)))))
    )
    (local.set $numerator (call $rational_numerator
      (call $value_data_lo (local.get $value_pointer))))
    (i32.eqz (call $bigint_length (local.get $numerator)))
  )

  ;; Returns 1 if the Rational equals +1 (inline or heap form with num=1, denom=1).
  (func $rational_is_one (param $value_pointer i32) (result i32)
    (local $header i32)
    (local $numerator i32)
    (local $denominator i32)
    (if (call $rational_is_inline (local.get $value_pointer))
      (then
        (return (i64.eq
          (call $rational_read_inline (local.get $value_pointer))
          (i64.const 1)))
      )
    )
    (local.set $header (call $value_data_lo (local.get $value_pointer)))
    (local.set $numerator (call $rational_numerator (local.get $header)))
    (local.set $denominator (call $rational_denominator (local.get $header)))
    (i32.and
      (i32.and
        (i32.eqz (call $bigint_sign (local.get $numerator)))
        (i32.and
          (i32.eq (call $bigint_length (local.get $numerator)) (i32.const 1))
          (i32.eq (call $bigint_limb (local.get $numerator) (i32.const 0)) (i32.const 1))))
      (i32.and
        (i32.eq (call $bigint_length (local.get $denominator)) (i32.const 1))
        (i32.eq (call $bigint_limb (local.get $denominator) (i32.const 0)) (i32.const 1))))
  )

  ;; Returns 1 if the Rational equals -1.
  (func $rational_is_neg_one (param $value_pointer i32) (result i32)
    (local $header i32)
    (local $numerator i32)
    (local $denominator i32)
    (if (call $rational_is_inline (local.get $value_pointer))
      (then
        (return (i64.eq
          (call $rational_read_inline (local.get $value_pointer))
          (i64.const -1)))
      )
    )
    (local.set $header (call $value_data_lo (local.get $value_pointer)))
    (local.set $numerator (call $rational_numerator (local.get $header)))
    (local.set $denominator (call $rational_denominator (local.get $header)))
    (i32.and
      (i32.and
        (call $bigint_sign (local.get $numerator))
        (i32.and
          (i32.eq (call $bigint_length (local.get $numerator)) (i32.const 1))
          (i32.eq (call $bigint_limb (local.get $numerator) (i32.const 0)) (i32.const 1))))
      (i32.and
        (i32.eq (call $bigint_length (local.get $denominator)) (i32.const 1))
        (i32.eq (call $bigint_limb (local.get $denominator) (i32.const 0)) (i32.const 1))))
  )

  ;; Returns 1 if the Rational is negative (sign bit set on numerator).
  (func $rational_is_negative (param $value_pointer i32) (result i32)
    (local $numerator i32)
    (if (call $rational_is_inline (local.get $value_pointer))
      (then (return (i64.lt_s
        (call $rational_read_inline (local.get $value_pointer))
        (i64.const 0))))
    )
    (local.set $numerator (call $rational_numerator
      (call $value_data_lo (local.get $value_pointer))))
    (call $bigint_sign (local.get $numerator))
  )

  ;; ==========================================================================
  ;; rational_abs_decimal: like rational_to_decimal but always drops the sign.
  ;; Complex printing uses this so we can emit "a - |b|i" cleanly.
  ;; Builds a synthetic positive Rational on the heap when needed.
  ;; ==========================================================================
  (func $rational_abs_decimal (param $value_pointer i32) (result i32)
    (local $inline i64)
    (local $header i32)
    (local $numerator i32)
    (local $denominator i32)
    (local $positive_numerator i32)
    (local $i i32)
    (local $length i32)
    (local $numerator_str i32)
    (local $denominator_str i32)

    (if (call $rational_is_inline (local.get $value_pointer))
      (then
        ;; Pressure pre-check for the throwaway $bigint_from_i64 (≤32
        ;; aligned bytes; 96 with slop) — unguarded conversions compound
        ;; under stringify/join driven loops
        ;; and therefore require the same fixed-size pre-check.
        (if (call $check_heap_overflow (i32.const 96))
          (then (return (i32.const 0))))
        (local.set $inline (call $rational_read_inline (local.get $value_pointer)))
        (if (i64.lt_s (local.get $inline) (i64.const 0))
          (then (local.set $inline (i64.sub (i64.const 0) (local.get $inline))))
        )
        (return (call $bigint_to_decimal
          (call $bigint_from_i64 (local.get $inline))))
      )
    )
    (local.set $header (call $value_data_lo (local.get $value_pointer)))
    (local.set $numerator (call $rational_numerator (local.get $header)))
    (local.set $denominator (call $rational_denominator (local.get $header)))

    ;; Clone numerator with positive sign. The clone is sized by the
    ;; numerator, so pre-check before the carve
    ;; before the heap/code free span is consumed; sentinel 0 with the
    ;; pressure flag set matches $bigint_to_decimal's own refusal path
    ;; — the to-string chain's callers check the flag.
    (local.set $length (call $bigint_length (local.get $numerator)))
    (if (call $check_heap_overflow
          (call $estimate_bigint_size (i32.add (local.get $length) (i32.const 1))))
      (then (return (i32.const 0))))
    (local.set $positive_numerator (call $bigint_alloc (i32.const 0) (local.get $length)))
    (local.set $i (i32.const 0))
    (block $copy_done
      (loop $copy_loop
        (br_if $copy_done (i32.ge_u (local.get $i) (local.get $length)))
        (call $bigint_set_limb (local.get $positive_numerator) (local.get $i)
          (call $bigint_limb (local.get $numerator) (local.get $i)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $copy_loop)
      )
    )
    (local.set $numerator_str (call $bigint_to_decimal (local.get $positive_numerator)))
    (if (i32.and
          (i32.eq (call $bigint_length (local.get $denominator)) (i32.const 1))
          (i32.eq (call $bigint_limb (local.get $denominator) (i32.const 0)) (i32.const 1)))
      (then (return (local.get $numerator_str)))
    )
    (local.set $denominator_str (call $bigint_to_decimal (local.get $denominator)))
    (call $string_concat
      (call $string_concat (local.get $numerator_str)
        (call $read_builtin (global.get $BUILTIN_EXACT_SLASH)))
      (local.get $denominator_str))
  )

  ;; ==========================================================================
  ;; complex_to_decimal: pretty-print a Complex value.
  ;;   real == 0, imag == 1            → "i"
  ;;   real == 0, imag == -1           → "-i"
  ;;   real == 0                       → "<imag>i"
  ;;   imag > 0                        → "<real> + <imag>i"     (imag != 1 else drop coefficient)
  ;;   imag < 0                        → "<real> - <|imag|>i"
  ;; No-collapse invariant: imag is never 0 for a Complex (phase 1b).
  ;; ==========================================================================
  (func $complex_to_decimal (param $header i32) (result i32)
    (local $real_pointer i32)
    (local $imag_pointer i32)
    (local $real_value i32)
    (local $imag_value i32)
    (local $real_str i32)
    (local $imag_str i32)
    (local $result i32)
    (local $stack_base i32)

    ;; complex_real / complex_imaginary return Rational heap pointers;
    ;; build Rational value_pointers by pushing them onto pending stack.
    ;; Simpler: synthesize value_pointers on the stack as pending values so
    ;; rational_* helpers work. But those helpers consume value_pointers,
    ;; which are slots in the pending stack. Push them, then read back.
    (local.set $stack_base (call $read_ctx (global.get $CTX_PENDING_POINTER)))

    (call $push_rational (call $complex_real (local.get $header)))
    (local.set $real_pointer (i32.sub
      (call $read_ctx (global.get $CTX_PENDING_POINTER))
      (global.get $VALUE_SIZE)))

    (call $push_rational (call $complex_imaginary (local.get $header)))
    (local.set $imag_pointer (i32.sub
      (call $read_ctx (global.get $CTX_PENDING_POINTER))
      (global.get $VALUE_SIZE)))

    (if (call $rational_is_zero (local.get $real_pointer))
      (then
        ;; Pure imaginary: "i", "-i", or "<imag>i".
        (if (call $rational_is_one (local.get $imag_pointer))
          (then
            (local.set $result (call $read_builtin (global.get $BUILTIN_EXACT_IMAGINARY_UNIT)))
          )
          (else (if (call $rational_is_neg_one (local.get $imag_pointer))
            (then
              (local.set $result (call $read_builtin (global.get $BUILTIN_EXACT_NEG_IMAGINARY_UNIT)))
            )
            (else
              (local.set $imag_str (call $rational_to_decimal (local.get $imag_pointer)))
              (local.set $result (call $string_concat (local.get $imag_str)
                (call $read_builtin (global.get $BUILTIN_EXACT_IMAGINARY_UNIT))))
            )
          ))
        )
      )
      (else
        ;; Mixed: "<real> + <imag>i" or "<real> - <|imag|>i"; drop the
        ;; coefficient when |imag| == 1.
        (local.set $real_str (call $rational_to_decimal (local.get $real_pointer)))
        (if (call $rational_is_negative (local.get $imag_pointer))
          (then
            (if (call $rational_is_neg_one (local.get $imag_pointer))
              (then
                (local.set $result (call $string_concat
                  (call $string_concat (local.get $real_str)
                    (call $read_builtin (global.get $BUILTIN_EXACT_MINUS_SEP)))
                  (call $read_builtin (global.get $BUILTIN_EXACT_IMAGINARY_UNIT))))
              )
              (else
                (local.set $imag_str (call $rational_abs_decimal (local.get $imag_pointer)))
                (local.set $result (call $string_concat
                  (call $string_concat
                    (call $string_concat (local.get $real_str)
                      (call $read_builtin (global.get $BUILTIN_EXACT_MINUS_SEP)))
                    (local.get $imag_str))
                  (call $read_builtin (global.get $BUILTIN_EXACT_IMAGINARY_UNIT))))
              )
            )
          )
          (else
            (if (call $rational_is_one (local.get $imag_pointer))
              (then
                (local.set $result (call $string_concat
                  (call $string_concat (local.get $real_str)
                    (call $read_builtin (global.get $BUILTIN_EXACT_PLUS_SEP)))
                  (call $read_builtin (global.get $BUILTIN_EXACT_IMAGINARY_UNIT))))
              )
              (else
                (local.set $imag_str (call $rational_to_decimal (local.get $imag_pointer)))
                (local.set $result (call $string_concat
                  (call $string_concat
                    (call $string_concat (local.get $real_str)
                      (call $read_builtin (global.get $BUILTIN_EXACT_PLUS_SEP)))
                    (local.get $imag_str))
                  (call $read_builtin (global.get $BUILTIN_EXACT_IMAGINARY_UNIT))))
              )
            )
          )
        )
      )
    )

    ;; Drop scratch pending slots.
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (local.get $result)
  )

  ;; ==========================================================================
  ;; UTF-8 helpers
  ;; ==========================================================================

  ;; Count UTF-8 characters in a string
  ;; string_pointer: string table offset (layout: [byte_len:4][bytes:N])
  ;; Returns: number of Unicode characters
  (func $utf8_char_count (param $string_id i32) (result i32)
    (local $byte_len i32)
    (local $i i32)
    (local $count i32)
    (local $byte i32)
    (local $bytes_seg i32)

    ;; $string_id is a table-relative interned-string id.
    (local.set $byte_len (i32.load (call $string_id_to_abs (local.get $string_id))))
    (local.set $bytes_seg (call $string_id_bytes_seg (local.get $string_id)))
    (local.set $i (i32.const 0))
    (local.set $count (i32.const 0))

    (block $done
      (loop $loop
        (br_if $done (i32.ge_u (local.get $i) (local.get $byte_len)))

        (local.set $byte (i32.load8_u (call $abs (i32.add
          (local.get $bytes_seg)
          (local.get $i)))))

        ;; Count this byte as a character start if:
        ;; - It's ASCII (0x00-0x7F), or
        ;; - It's a UTF-8 leading byte (0xC0-0xFF)
        ;; Skip continuation bytes (0x80-0xBF)
        (if (i32.or
              (i32.lt_u (local.get $byte) (i32.const 0x80))
              (i32.ge_u (local.get $byte) (i32.const 0xC0)))
          (then
            (local.set $count (i32.add (local.get $count) (i32.const 1)))
          )
        )

        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $loop)
      )
    )

    (local.get $count)
  )

  ;; Get byte offset for character index in UTF-8 string
  ;; string_pointer: string table offset
  ;; char_idx: character index (0-based)
  ;; Returns: byte offset from start of string data, or -1 if out of bounds
  (func $utf8_char_to_byte_offset (param $string_id i32) (param $char_idx i32) (result i32)
    (local $byte_len i32)
    (local $i i32)
    (local $char_count i32)
    (local $byte i32)
    (local $bytes_seg i32)

    ;; $string_id is a table-relative interned-string id.
    (local.set $byte_len (i32.load (call $string_id_to_abs (local.get $string_id))))
    (local.set $bytes_seg (call $string_id_bytes_seg (local.get $string_id)))
    (local.set $i (i32.const 0))
    (local.set $char_count (i32.const 0))

    (block $done
      (loop $loop
        (br_if $done (i32.ge_u (local.get $i) (local.get $byte_len)))

        (local.set $byte (i32.load8_u (call $abs (i32.add
          (local.get $bytes_seg)
          (local.get $i)))))

        ;; Check if this is a character start (ASCII or UTF-8 leading byte)
        (if (i32.or
              (i32.lt_u (local.get $byte) (i32.const 0x80))
              (i32.ge_u (local.get $byte) (i32.const 0xC0)))
          (then
            ;; If we've found the target character, return this byte offset
            (if (i32.eq (local.get $char_count) (local.get $char_idx))
              (then (return (local.get $i)))
            )
            ;; Otherwise increment character count
            (local.set $char_count (i32.add (local.get $char_count) (i32.const 1)))
          )
        )

        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $loop)
      )
    )

    ;; Check if char_idx equals total count (pointing to end)
    (if (i32.eq (local.get $char_count) (local.get $char_idx))
      (then (return (local.get $byte_len)))
    )

    ;; Out of bounds
    (i32.const -1)
  )

  ;; Decode UTF-8 code point at byte offset
  ;; string_pointer: string table offset
  ;; byte_offset: offset into string data
  ;; Returns: Unicode code point
  (func $utf8_decode_at (param $string_id i32) (param $byte_offset i32) (result i32)
    (local $byte_len i32)
    (local $b0 i32)
    (local $b1 i32)
    (local $b2 i32)
    (local $b3 i32)
    (local $data_pointer i32)

    ;; $string_id is a table-relative interned-string id.
    (local.set $byte_len (i32.load (call $string_id_to_abs (local.get $string_id))))
    (local.set $data_pointer (call $string_id_bytes_seg (local.get $string_id)))

    ;; Out of bounds check
    (if (i32.ge_u (local.get $byte_offset) (local.get $byte_len))
      (then (return (i32.const -1)))
    )

    (local.set $b0 (i32.load8_u (call $abs (i32.add (local.get $data_pointer) (local.get $byte_offset)))))

    ;; ASCII (0x00-0x7F): 1 byte
    (if (i32.lt_u (local.get $b0) (i32.const 0x80))
      (then (return (local.get $b0)))
    )

    ;; 2-byte sequence (110xxxxx 10xxxxxx): 0xC0-0xDF
    (if (i32.and
          (i32.ge_u (local.get $b0) (i32.const 0xC0))
          (i32.lt_u (local.get $b0) (i32.const 0xE0)))
      (then
        (if (i32.ge_u (i32.add (local.get $byte_offset) (i32.const 1)) (local.get $byte_len))
          (then (return (i32.const -1)))
        )
        (local.set $b1 (i32.load8_u (call $abs (i32.add (local.get $data_pointer)
          (i32.add (local.get $byte_offset) (i32.const 1))))))
        (return (i32.or
          (i32.shl (i32.and (local.get $b0) (i32.const 0x1F)) (i32.const 6))
          (i32.and (local.get $b1) (i32.const 0x3F))))
      )
    )

    ;; 3-byte sequence (1110xxxx 10xxxxxx 10xxxxxx): 0xE0-0xEF
    (if (i32.and
          (i32.ge_u (local.get $b0) (i32.const 0xE0))
          (i32.lt_u (local.get $b0) (i32.const 0xF0)))
      (then
        (if (i32.ge_u (i32.add (local.get $byte_offset) (i32.const 2)) (local.get $byte_len))
          (then (return (i32.const -1)))
        )
        (local.set $b1 (i32.load8_u (call $abs (i32.add (local.get $data_pointer)
          (i32.add (local.get $byte_offset) (i32.const 1))))))
        (local.set $b2 (i32.load8_u (call $abs (i32.add (local.get $data_pointer)
          (i32.add (local.get $byte_offset) (i32.const 2))))))
        (return (i32.or
          (i32.or
            (i32.shl (i32.and (local.get $b0) (i32.const 0x0F)) (i32.const 12))
            (i32.shl (i32.and (local.get $b1) (i32.const 0x3F)) (i32.const 6)))
          (i32.and (local.get $b2) (i32.const 0x3F))))
      )
    )

    ;; 4-byte sequence (11110xxx 10xxxxxx 10xxxxxx 10xxxxxx): 0xF0-0xF7
    (if (i32.and
          (i32.ge_u (local.get $b0) (i32.const 0xF0))
          (i32.lt_u (local.get $b0) (i32.const 0xF8)))
      (then
        (if (i32.ge_u (i32.add (local.get $byte_offset) (i32.const 3)) (local.get $byte_len))
          (then (return (i32.const -1)))
        )
        (local.set $b1 (i32.load8_u (call $abs (i32.add (local.get $data_pointer)
          (i32.add (local.get $byte_offset) (i32.const 1))))))
        (local.set $b2 (i32.load8_u (call $abs (i32.add (local.get $data_pointer)
          (i32.add (local.get $byte_offset) (i32.const 2))))))
        (local.set $b3 (i32.load8_u (call $abs (i32.add (local.get $data_pointer)
          (i32.add (local.get $byte_offset) (i32.const 3))))))
        (return (i32.or
          (i32.or
            (i32.or
              (i32.shl (i32.and (local.get $b0) (i32.const 0x07)) (i32.const 18))
              (i32.shl (i32.and (local.get $b1) (i32.const 0x3F)) (i32.const 12)))
            (i32.shl (i32.and (local.get $b2) (i32.const 0x3F)) (i32.const 6)))
          (i32.and (local.get $b3) (i32.const 0x3F))))
      )
    )

    ;; Invalid UTF-8, return the byte as-is
    (local.get $b0)
  )

  ;; Get byte length of UTF-8 character at byte offset
  ;; Returns: 1, 2, 3, or 4
  (func $utf8_char_byte_len (param $string_pointer i32) (param $byte_offset i32) (result i32)
    (local $b0 i32)

    (local.set $b0 (i32.load8_u (call $abs (i32.add
      (i32.add (local.get $string_pointer) (i32.const 4))
      (local.get $byte_offset)))))

    ;; ASCII
    (if (i32.lt_u (local.get $b0) (i32.const 0x80))
      (then (return (i32.const 1)))
    )
    ;; 2-byte
    (if (i32.lt_u (local.get $b0) (i32.const 0xE0))
      (then (return (i32.const 2)))
    )
    ;; 3-byte
    (if (i32.lt_u (local.get $b0) (i32.const 0xF0))
      (then (return (i32.const 3)))
    )
    ;; 4-byte
    (i32.const 4)
  )

  ;; Encode a Unicode code point to UTF-8 at destination_pointer
  ;; Returns: number of bytes written (1-4)
  (func $utf8_encode_at (param $destination_pointer i32) (param $code_point i32) (result i32)
    ;; ASCII (0x00-0x7F): 1 byte
    (if (i32.lt_u (local.get $code_point) (i32.const 0x80))
      (then
        (i32.store8 (call $abs (local.get $destination_pointer)) (local.get $code_point))
        (return (i32.const 1))
      )
    )
    ;; 2-byte (0x80-0x7FF): 110xxxxx 10xxxxxx
    (if (i32.lt_u (local.get $code_point) (i32.const 0x800))
      (then
        (i32.store8 (call $abs (local.get $destination_pointer))
          (i32.or (i32.const 0xC0) (i32.shr_u (local.get $code_point) (i32.const 6))))
        (i32.store8 (call $abs (i32.add (local.get $destination_pointer) (i32.const 1)))
          (i32.or (i32.const 0x80) (i32.and (local.get $code_point) (i32.const 0x3F))))
        (return (i32.const 2))
      )
    )
    ;; 3-byte (0x800-0xFFFF): 1110xxxx 10xxxxxx 10xxxxxx
    (if (i32.lt_u (local.get $code_point) (i32.const 0x10000))
      (then
        (i32.store8 (call $abs (local.get $destination_pointer))
          (i32.or (i32.const 0xE0) (i32.shr_u (local.get $code_point) (i32.const 12))))
        (i32.store8 (call $abs (i32.add (local.get $destination_pointer) (i32.const 1)))
          (i32.or (i32.const 0x80) (i32.and (i32.shr_u (local.get $code_point) (i32.const 6)) (i32.const 0x3F))))
        (i32.store8 (call $abs (i32.add (local.get $destination_pointer) (i32.const 2)))
          (i32.or (i32.const 0x80) (i32.and (local.get $code_point) (i32.const 0x3F))))
        (return (i32.const 3))
      )
    )
    ;; 4-byte (0x10000-0x10FFFF): 11110xxx 10xxxxxx 10xxxxxx 10xxxxxx
    (i32.store8 (call $abs (local.get $destination_pointer))
      (i32.or (i32.const 0xF0) (i32.shr_u (local.get $code_point) (i32.const 18))))
    (i32.store8 (call $abs (i32.add (local.get $destination_pointer) (i32.const 1)))
      (i32.or (i32.const 0x80) (i32.and (i32.shr_u (local.get $code_point) (i32.const 12)) (i32.const 0x3F))))
    (i32.store8 (call $abs (i32.add (local.get $destination_pointer) (i32.const 2)))
      (i32.or (i32.const 0x80) (i32.and (i32.shr_u (local.get $code_point) (i32.const 6)) (i32.const 0x3F))))
    (i32.store8 (call $abs (i32.add (local.get $destination_pointer) (i32.const 3)))
      (i32.or (i32.const 0x80) (i32.and (local.get $code_point) (i32.const 0x3F))))
    (i32.const 4)
  )

  ;; Convert code point to uppercase
  ;; Returns: transformed code point
  (func $to_upper_code_point (param $cp i32) (result i32)
    ;; ASCII lowercase a-z (0x61-0x7A) -> A-Z (0x41-0x5A)
    (if (i32.and
          (i32.ge_u (local.get $cp) (i32.const 0x61))
          (i32.le_u (local.get $cp) (i32.const 0x7A)))
      (then (return (i32.sub (local.get $cp) (i32.const 32))))
    )
    ;; Latin-1 lowercase: à-ö (0xE0-0xF6) -> À-Ö (0xC0-0xD6)
    (if (i32.and
          (i32.ge_u (local.get $cp) (i32.const 0xE0))
          (i32.le_u (local.get $cp) (i32.const 0xF6)))
      (then (return (i32.sub (local.get $cp) (i32.const 32))))
    )
    ;; Latin-1 lowercase: ø-þ (0xF8-0xFE) -> Ø-Þ (0xD8-0xDE)
    (if (i32.and
          (i32.ge_u (local.get $cp) (i32.const 0xF8))
          (i32.le_u (local.get $cp) (i32.const 0xFE)))
      (then (return (i32.sub (local.get $cp) (i32.const 32))))
    )
    ;; No transformation
    (local.get $cp)
  )

  ;; Convert code point to lowercase
  ;; Returns: transformed code point
  (func $to_lower_code_point (param $cp i32) (result i32)
    ;; ASCII uppercase A-Z (0x41-0x5A) -> a-z (0x61-0x7A)
    (if (i32.and
          (i32.ge_u (local.get $cp) (i32.const 0x41))
          (i32.le_u (local.get $cp) (i32.const 0x5A)))
      (then (return (i32.add (local.get $cp) (i32.const 32))))
    )
    ;; Latin-1 uppercase: À-Ö (0xC0-0xD6) -> à-ö (0xE0-0xF6)
    (if (i32.and
          (i32.ge_u (local.get $cp) (i32.const 0xC0))
          (i32.le_u (local.get $cp) (i32.const 0xD6)))
      (then (return (i32.add (local.get $cp) (i32.const 32))))
    )
    ;; Latin-1 uppercase: Ø-Þ (0xD8-0xDE) -> ø-þ (0xF8-0xFE)
    (if (i32.and
          (i32.ge_u (local.get $cp) (i32.const 0xD8))
          (i32.le_u (local.get $cp) (i32.const 0xDE)))
      (then (return (i32.add (local.get $cp) (i32.const 32))))
    )
    ;; No transformation
    (local.get $cp)
  )

  ;; ==========================================================================
  ;; parseInt helper: parse integer from string with radix
  ;; string_pointer: string table offset
  ;; radix: 2-36 (0 means auto-detect)
  ;; Returns: parsed integer as f64, or NaN on failure
  ;; ==========================================================================
  (func $parse_int (param $string_id i32) (param $radix i32) (result f64)
    (local $len i32) (local $data_pointer i32) (local $i i32) (local $byte i32)
    (local $sign f64) (local $result f64) (local $digit i32) (local $has_digits i32)

    ;; $string_id is a table-relative interned-string id.
    (local.set $len (i32.load (call $string_id_to_abs (local.get $string_id))))
    (local.set $data_pointer (call $string_id_bytes_seg (local.get $string_id)))
    (local.set $i (i32.const 0))
    (local.set $sign (f64.const 1))
    (local.set $result (f64.const 0))
    (local.set $has_digits (i32.const 0))

    ;; Skip leading whitespace
    (block $skip_ws_done
      (loop $skip_ws
        (br_if $skip_ws_done (i32.ge_u (local.get $i) (local.get $len)))
        (local.set $byte (i32.load8_u (call $abs (i32.add (local.get $data_pointer) (local.get $i)))))
        ;; Space, tab, newline, carriage return
        (br_if $skip_ws_done (i32.and
          (i32.ne (local.get $byte) (i32.const 0x20))
          (i32.and
            (i32.ne (local.get $byte) (i32.const 0x09))
            (i32.and
              (i32.ne (local.get $byte) (i32.const 0x0A))
              (i32.ne (local.get $byte) (i32.const 0x0D))))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $skip_ws)
      )
    )

    ;; Check for sign
    (if (i32.lt_u (local.get $i) (local.get $len))
      (then
        (local.set $byte (i32.load8_u (call $abs (i32.add (local.get $data_pointer) (local.get $i)))))
        (if (i32.eq (local.get $byte) (i32.const 0x2D)) ;; '-'
          (then
            (local.set $sign (f64.const -1))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
          )
          (else
            (if (i32.eq (local.get $byte) (i32.const 0x2B)) ;; '+'
              (then (local.set $i (i32.add (local.get $i) (i32.const 1))))
            )
          )
        )
      )
    )

    ;; Auto-detect radix if 0
    (if (i32.eqz (local.get $radix))
      (then
        (local.set $radix (i32.const 10))
        (if (i32.lt_u (local.get $i) (local.get $len))
          (then
            (local.set $byte (i32.load8_u (call $abs (i32.add (local.get $data_pointer) (local.get $i)))))
            (if (i32.eq (local.get $byte) (i32.const 0x30)) ;; '0'
              (then
                (if (i32.lt_u (i32.add (local.get $i) (i32.const 1)) (local.get $len))
                  (then
                    (local.set $byte (i32.load8_u (call $abs (i32.add (local.get $data_pointer) (i32.add (local.get $i) (i32.const 1))))))
                    (if (i32.or (i32.eq (local.get $byte) (i32.const 0x78)) (i32.eq (local.get $byte) (i32.const 0x58))) ;; 'x' or 'X'
                      (then
                        (local.set $radix (i32.const 16))
                        (local.set $i (i32.add (local.get $i) (i32.const 2)))
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
      (else
        ;; Skip 0x prefix for explicit radix 16
        (if (i32.eq (local.get $radix) (i32.const 16))
          (then
            (if (i32.lt_u (i32.add (local.get $i) (i32.const 1)) (local.get $len))
              (then
                (local.set $byte (i32.load8_u (call $abs (i32.add (local.get $data_pointer) (local.get $i)))))
                (if (i32.eq (local.get $byte) (i32.const 0x30)) ;; '0'
                  (then
                    (local.set $byte (i32.load8_u (call $abs (i32.add (local.get $data_pointer) (i32.add (local.get $i) (i32.const 1))))))
                    (if (i32.or (i32.eq (local.get $byte) (i32.const 0x78)) (i32.eq (local.get $byte) (i32.const 0x58)))
                      (then (local.set $i (i32.add (local.get $i) (i32.const 2))))
                    )
                  )
                )
              )
            )
          )
        )
      )
    )

    ;; Validate radix
    (if (i32.or (i32.lt_s (local.get $radix) (i32.const 2)) (i32.gt_s (local.get $radix) (i32.const 36)))
      (then (return (f64.div (f64.const 0) (f64.const 0)))) ;; NaN
    )

    ;; Parse digits
    (block $parse_done
      (loop $parse
        (br_if $parse_done (i32.ge_u (local.get $i) (local.get $len)))
        (local.set $byte (i32.load8_u (call $abs (i32.add (local.get $data_pointer) (local.get $i)))))

        ;; Convert to digit value
        (if (i32.and (i32.ge_u (local.get $byte) (i32.const 0x30)) (i32.le_u (local.get $byte) (i32.const 0x39)))
          (then (local.set $digit (i32.sub (local.get $byte) (i32.const 0x30)))) ;; 0-9
          (else
            (if (i32.and (i32.ge_u (local.get $byte) (i32.const 0x41)) (i32.le_u (local.get $byte) (i32.const 0x5A)))
              (then (local.set $digit (i32.add (i32.sub (local.get $byte) (i32.const 0x41)) (i32.const 10)))) ;; A-Z
              (else
                (if (i32.and (i32.ge_u (local.get $byte) (i32.const 0x61)) (i32.le_u (local.get $byte) (i32.const 0x7A)))
                  (then (local.set $digit (i32.add (i32.sub (local.get $byte) (i32.const 0x61)) (i32.const 10)))) ;; a-z
                  (else (br $parse_done)) ;; Not a digit, stop parsing
                )
              )
            )
          )
        )

        ;; Check digit is valid for radix
        (br_if $parse_done (i32.ge_s (local.get $digit) (local.get $radix)))

        ;; Accumulate: result = result * radix + digit
        (local.set $result (f64.add
          (f64.mul (local.get $result) (f64.convert_i32_s (local.get $radix)))
          (f64.convert_i32_s (local.get $digit))))
        (local.set $has_digits (i32.const 1))

        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $parse)
      )
    )

    ;; If no digits parsed, return NaN
    (if (i32.eqz (local.get $has_digits))
      (then (return (f64.div (f64.const 0) (f64.const 0))))
    )

    ;; Apply sign and return
    (f64.mul (local.get $sign) (local.get $result))
  )

  ;; ==========================================================================
  ;; parseFloat helper: parse float from string
  ;; string_pointer: string table offset
  ;; Returns: parsed float, or NaN on failure
  ;; ==========================================================================
  (func $parse_float (param $string_id i32) (result f64)
    (local $len i32) (local $data_pointer i32) (local $i i32) (local $byte i32)
    (local $sign f64) (local $int_part f64) (local $frac_part f64) (local $frac_div f64)
    (local $exp_sign i32) (local $exp_val i32) (local $has_digits i32) (local $has_dot i32)

    ;; $string_id is a table-relative interned-string id.
    (local.set $len (i32.load (call $string_id_to_abs (local.get $string_id))))
    (local.set $data_pointer (call $string_id_bytes_seg (local.get $string_id)))
    (local.set $i (i32.const 0))
    (local.set $sign (f64.const 1))
    (local.set $int_part (f64.const 0))
    (local.set $frac_part (f64.const 0))
    (local.set $frac_div (f64.const 1))
    (local.set $exp_sign (i32.const 1))
    (local.set $exp_val (i32.const 0))
    (local.set $has_digits (i32.const 0))
    (local.set $has_dot (i32.const 0))

    ;; Skip leading whitespace
    (block $skip_ws_done
      (loop $skip_ws
        (br_if $skip_ws_done (i32.ge_u (local.get $i) (local.get $len)))
        (local.set $byte (i32.load8_u (call $abs (i32.add (local.get $data_pointer) (local.get $i)))))
        (br_if $skip_ws_done (i32.and
          (i32.ne (local.get $byte) (i32.const 0x20))
          (i32.and
            (i32.ne (local.get $byte) (i32.const 0x09))
            (i32.and
              (i32.ne (local.get $byte) (i32.const 0x0A))
              (i32.ne (local.get $byte) (i32.const 0x0D))))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $skip_ws)
      )
    )

    ;; Check for sign
    (if (i32.lt_u (local.get $i) (local.get $len))
      (then
        (local.set $byte (i32.load8_u (call $abs (i32.add (local.get $data_pointer) (local.get $i)))))
        (if (i32.eq (local.get $byte) (i32.const 0x2D))
          (then
            (local.set $sign (f64.const -1))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
          )
          (else
            (if (i32.eq (local.get $byte) (i32.const 0x2B))
              (then (local.set $i (i32.add (local.get $i) (i32.const 1))))
            )
          )
        )
      )
    )

    ;; Check for Infinity
    (if (i32.ge_u (i32.sub (local.get $len) (local.get $i)) (i32.const 8))
      (then
        (if (i32.and
              (i32.eq (i32.load8_u (call $abs (i32.add (local.get $data_pointer) (local.get $i)))) (i32.const 0x49)) ;; I
              (i32.and
                (i32.eq (i32.load8_u (call $abs (i32.add (local.get $data_pointer) (i32.add (local.get $i) (i32.const 1))))) (i32.const 0x6E)) ;; n
                (i32.and
                  (i32.eq (i32.load8_u (call $abs (i32.add (local.get $data_pointer) (i32.add (local.get $i) (i32.const 2))))) (i32.const 0x66)) ;; f
                  (i32.and
                    (i32.eq (i32.load8_u (call $abs (i32.add (local.get $data_pointer) (i32.add (local.get $i) (i32.const 3))))) (i32.const 0x69)) ;; i
                    (i32.and
                      (i32.eq (i32.load8_u (call $abs (i32.add (local.get $data_pointer) (i32.add (local.get $i) (i32.const 4))))) (i32.const 0x6E)) ;; n
                      (i32.and
                        (i32.eq (i32.load8_u (call $abs (i32.add (local.get $data_pointer) (i32.add (local.get $i) (i32.const 5))))) (i32.const 0x69)) ;; i
                        (i32.and
                          (i32.eq (i32.load8_u (call $abs (i32.add (local.get $data_pointer) (i32.add (local.get $i) (i32.const 6))))) (i32.const 0x74)) ;; t
                          (i32.eq (i32.load8_u (call $abs (i32.add (local.get $data_pointer) (i32.add (local.get $i) (i32.const 7))))) (i32.const 0x79))))))))) ;; y
          (then
            (return (f64.mul (local.get $sign) (f64.div (f64.const 1) (f64.const 0))))
          )
        )
      )
    )

    ;; Parse integer part
    (block $int_done
      (loop $int_loop
        (br_if $int_done (i32.ge_u (local.get $i) (local.get $len)))
        (local.set $byte (i32.load8_u (call $abs (i32.add (local.get $data_pointer) (local.get $i)))))

        ;; Check for decimal point
        (if (i32.eq (local.get $byte) (i32.const 0x2E)) ;; '.'
          (then
            (local.set $has_dot (i32.const 1))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $int_done)
          )
        )

        ;; Check for exponent
        (if (i32.or (i32.eq (local.get $byte) (i32.const 0x65)) (i32.eq (local.get $byte) (i32.const 0x45))) ;; 'e' or 'E'
          (then (br $int_done))
        )

        ;; Check for digit 0-9
        (if (i32.and (i32.ge_u (local.get $byte) (i32.const 0x30)) (i32.le_u (local.get $byte) (i32.const 0x39)))
          (then
            (local.set $int_part (f64.add
              (f64.mul (local.get $int_part) (f64.const 10))
              (f64.convert_i32_s (i32.sub (local.get $byte) (i32.const 0x30)))))
            (local.set $has_digits (i32.const 1))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $int_loop)
          )
          (else (br $int_done))
        )
      )
    )

    ;; Parse fractional part
    (if (local.get $has_dot)
      (then
        (block $frac_done
          (loop $frac_loop
            (br_if $frac_done (i32.ge_u (local.get $i) (local.get $len)))
            (local.set $byte (i32.load8_u (call $abs (i32.add (local.get $data_pointer) (local.get $i)))))

            ;; Check for exponent
            (if (i32.or (i32.eq (local.get $byte) (i32.const 0x65)) (i32.eq (local.get $byte) (i32.const 0x45)))
              (then (br $frac_done))
            )

            ;; Check for digit
            (if (i32.and (i32.ge_u (local.get $byte) (i32.const 0x30)) (i32.le_u (local.get $byte) (i32.const 0x39)))
              (then
                (local.set $frac_div (f64.mul (local.get $frac_div) (f64.const 10)))
                (local.set $frac_part (f64.add (local.get $frac_part)
                  (f64.div (f64.convert_i32_s (i32.sub (local.get $byte) (i32.const 0x30))) (local.get $frac_div))))
                (local.set $has_digits (i32.const 1))
                (local.set $i (i32.add (local.get $i) (i32.const 1)))
                (br $frac_loop)
              )
              (else (br $frac_done))
            )
          )
        )
      )
    )

    ;; Parse exponent
    (if (i32.lt_u (local.get $i) (local.get $len))
      (then
        (local.set $byte (i32.load8_u (call $abs (i32.add (local.get $data_pointer) (local.get $i)))))
        (if (i32.or (i32.eq (local.get $byte) (i32.const 0x65)) (i32.eq (local.get $byte) (i32.const 0x45)))
          (then
            (local.set $i (i32.add (local.get $i) (i32.const 1)))

            ;; Check exponent sign
            (if (i32.lt_u (local.get $i) (local.get $len))
              (then
                (local.set $byte (i32.load8_u (call $abs (i32.add (local.get $data_pointer) (local.get $i)))))
                (if (i32.eq (local.get $byte) (i32.const 0x2D))
                  (then
                    (local.set $exp_sign (i32.const -1))
                    (local.set $i (i32.add (local.get $i) (i32.const 1)))
                  )
                  (else
                    (if (i32.eq (local.get $byte) (i32.const 0x2B))
                      (then (local.set $i (i32.add (local.get $i) (i32.const 1))))
                    )
                  )
                )
              )
            )

            ;; Parse exponent digits
            (block $exp_done
              (loop $exp_loop
                (br_if $exp_done (i32.ge_u (local.get $i) (local.get $len)))
                (local.set $byte (i32.load8_u (call $abs (i32.add (local.get $data_pointer) (local.get $i)))))
                (if (i32.and (i32.ge_u (local.get $byte) (i32.const 0x30)) (i32.le_u (local.get $byte) (i32.const 0x39)))
                  (then
                    (local.set $exp_val (i32.add
                      (i32.mul (local.get $exp_val) (i32.const 10))
                      (i32.sub (local.get $byte) (i32.const 0x30))))
                    (local.set $i (i32.add (local.get $i) (i32.const 1)))
                    (br $exp_loop)
                  )
                  (else (br $exp_done))
                )
              )
            )
          )
        )
      )
    )

    ;; If no digits parsed, return NaN
    (if (i32.eqz (local.get $has_digits))
      (then (return (f64.div (f64.const 0) (f64.const 0))))
    )

    ;; Compute final result: sign * (int + frac) * 10^exp
    (f64.mul
      (local.get $sign)
      (f64.mul
        (f64.add (local.get $int_part) (local.get $frac_part))
        (call $f64_pow (f64.const 10) (f64.convert_i32_s (i32.mul (local.get $exp_sign) (local.get $exp_val))))))
  )

  ;; ==========================================================================
  ;; MsgPack parsing functions
  ;; ==========================================================================

  ;; MsgPack type codes (returned by $msgpack_peek_type)
  (global $MSGPACK_NIL i32 (i32.const 0))
  (global $MSGPACK_BOOL i32 (i32.const 1))
  (global $MSGPACK_INT i32 (i32.const 2))
  (global $MSGPACK_FLOAT i32 (i32.const 3))
  (global $MSGPACK_STRING i32 (i32.const 4))
  (global $MSGPACK_ARRAY i32 (i32.const 5))
  (global $MSGPACK_MAP i32 (i32.const 6))
  ;; bin8/16/32 (0xc4-0xc6). Our own encoder emits these for
  ;; Uint8Array, and the decoder used to REJECT them (encode/decode
  ;; asymmetry — a decoded bin field raised ERR_MSGPACK_INVALID at
  ;; every read). Bin values materialize as Uint8Array at every read
  ;; site; they never become TYPE_MSGPACK_REF.
  (global $MSGPACK_BIN i32 (i32.const 7))
  (global $MSGPACK_ERROR i32 (i32.const -1))

  ;; Read u16 big-endian from absolute address
  (func $read_u16_be (param $addr i32) (result i32)
    (i32.or
      (i32.shl (i32.load8_u (local.get $addr)) (i32.const 8))
      (i32.load8_u (i32.add (local.get $addr) (i32.const 1))))
  )

  ;; Read u32 big-endian from absolute address
  (func $read_u32_be (param $addr i32) (result i32)
    (i32.or
      (i32.or
        (i32.shl (i32.load8_u (local.get $addr)) (i32.const 24))
        (i32.shl (i32.load8_u (i32.add (local.get $addr) (i32.const 1))) (i32.const 16)))
      (i32.or
        (i32.shl (i32.load8_u (i32.add (local.get $addr) (i32.const 2))) (i32.const 8))
        (i32.load8_u (i32.add (local.get $addr) (i32.const 3)))))
  )

  ;; Read i16 big-endian (sign-extended) from absolute address
  (func $read_i16_be (param $addr i32) (result i32)
    (i32.extend16_s
      (i32.or
        (i32.shl (i32.load8_u (local.get $addr)) (i32.const 8))
        (i32.load8_u (i32.add (local.get $addr) (i32.const 1)))))
  )

  ;; Read i32 big-endian from absolute address
  (func $read_i32_be (param $addr i32) (result i32)
    (call $read_u32_be (local.get $addr))
  )

  ;; Read f32 big-endian from absolute address
  (func $read_f32_be (param $addr i32) (result f32)
    (f32.reinterpret_i32 (call $read_u32_be (local.get $addr)))
  )

  ;; Read f64 big-endian from absolute address
  (func $read_f64_be (param $addr i32) (result f64)
    (local $hi i32)
    (local $lo i32)
    (local.set $hi (call $read_u32_be (local.get $addr)))
    (local.set $lo (call $read_u32_be (i32.add (local.get $addr) (i32.const 4))))
    (f64.reinterpret_i64
      (i64.or
        (i64.shl (i64.extend_i32_u (local.get $hi)) (i64.const 32))
        (i64.extend_i32_u (local.get $lo))))
  )

  ;; Write u16 big-endian to absolute address
  (func $write_u16_be (param $addr i32) (param $val i32)
    (i32.store8 (local.get $addr)
      (i32.shr_u (local.get $val) (i32.const 8)))
    (i32.store8 (i32.add (local.get $addr) (i32.const 1))
      (i32.and (local.get $val) (i32.const 0xff)))
  )

  ;; Write u32 big-endian to absolute address
  (func $write_u32_be (param $addr i32) (param $val i32)
    (i32.store8 (local.get $addr)
      (i32.shr_u (local.get $val) (i32.const 24)))
    (i32.store8 (i32.add (local.get $addr) (i32.const 1))
      (i32.and (i32.shr_u (local.get $val) (i32.const 16)) (i32.const 0xff)))
    (i32.store8 (i32.add (local.get $addr) (i32.const 2))
      (i32.and (i32.shr_u (local.get $val) (i32.const 8)) (i32.const 0xff)))
    (i32.store8 (i32.add (local.get $addr) (i32.const 3))
      (i32.and (local.get $val) (i32.const 0xff)))
  )

  ;; Write f64 big-endian to absolute address
  (func $write_f64_be (param $addr i32) (param $val f64)
    (local $bits i64)
    (local.set $bits (i64.reinterpret_f64 (local.get $val)))
    (call $write_u32_be (local.get $addr)
      (i32.wrap_i64 (i64.shr_u (local.get $bits) (i64.const 32))))
    (call $write_u32_be (i32.add (local.get $addr) (i32.const 4))
      (i32.wrap_i64 (local.get $bits)))
  )

  ;; Peek msgpack type at address
  ;; Returns: type (MSGPACK_* constant), -1 on error
  ;; Also stores in scratch: header_size, data_size, count (for arrays/maps)
  ;; Scratch layout: [type:i32][header_size:i32][data_size:i32][count:i32]
  (func $msgpack_peek_type (param $addr i32) (param $end_addr i32) (result i32)
    (local $byte i32)
    (local $type i32)
    (local $header_size i32)
    (local $data_size i32)
    (local $count i32)
    (local $scratch i32)

    ;; Bounds check - need at least 1 byte
    (if (i32.ge_u (local.get $addr) (local.get $end_addr))
      (then (return (global.get $MSGPACK_ERROR))))

    (local.set $byte (i32.load8_u (local.get $addr)))
    (local.set $scratch (call $scratch_ptr (i32.const 0) (i32.const 16)))

    ;; Positive fixint (0x00-0x7f): value = byte
    (if (i32.le_u (local.get $byte) (i32.const 0x7f))
      (then
        (local.set $type (global.get $MSGPACK_INT))
        (local.set $header_size (i32.const 1))
        (local.set $data_size (i32.const 0))
        (local.set $count (local.get $byte))  ;; Use count field to store the value
        (i32.store (local.get $scratch) (local.get $type))
        (i32.store (i32.add (local.get $scratch) (i32.const 4)) (local.get $header_size))
        (i32.store (i32.add (local.get $scratch) (i32.const 8)) (local.get $data_size))
        (i32.store (i32.add (local.get $scratch) (i32.const 12)) (local.get $count))
        (return (local.get $type))
      )
    )

    ;; Negative fixint (0xe0-0xff): value = byte as signed
    (if (i32.ge_u (local.get $byte) (i32.const 0xe0))
      (then
        (local.set $type (global.get $MSGPACK_INT))
        (local.set $header_size (i32.const 1))
        (local.set $data_size (i32.const 0))
        ;; Sign-extend from 8 bits: (byte | 0xffffff00) for negative
        (local.set $count (i32.or (local.get $byte) (i32.const 0xffffff00)))
        (i32.store (local.get $scratch) (local.get $type))
        (i32.store (i32.add (local.get $scratch) (i32.const 4)) (local.get $header_size))
        (i32.store (i32.add (local.get $scratch) (i32.const 8)) (local.get $data_size))
        (i32.store (i32.add (local.get $scratch) (i32.const 12)) (local.get $count))
        (return (local.get $type))
      )
    )

    ;; Fixmap (0x80-0x8f): count = byte & 0x0f
    (if (i32.and (i32.ge_u (local.get $byte) (i32.const 0x80))
                 (i32.le_u (local.get $byte) (i32.const 0x8f)))
      (then
        (local.set $type (global.get $MSGPACK_MAP))
        (local.set $header_size (i32.const 1))
        (local.set $count (i32.and (local.get $byte) (i32.const 0x0f)))
        (i32.store (local.get $scratch) (local.get $type))
        (i32.store (i32.add (local.get $scratch) (i32.const 4)) (local.get $header_size))
        (i32.store (i32.add (local.get $scratch) (i32.const 8)) (i32.const 0))
        (i32.store (i32.add (local.get $scratch) (i32.const 12)) (local.get $count))
        (return (local.get $type))
      )
    )

    ;; Fixarray (0x90-0x9f): count = byte & 0x0f
    (if (i32.and (i32.ge_u (local.get $byte) (i32.const 0x90))
                 (i32.le_u (local.get $byte) (i32.const 0x9f)))
      (then
        (local.set $type (global.get $MSGPACK_ARRAY))
        (local.set $header_size (i32.const 1))
        (local.set $count (i32.and (local.get $byte) (i32.const 0x0f)))
        (i32.store (local.get $scratch) (local.get $type))
        (i32.store (i32.add (local.get $scratch) (i32.const 4)) (local.get $header_size))
        (i32.store (i32.add (local.get $scratch) (i32.const 8)) (i32.const 0))
        (i32.store (i32.add (local.get $scratch) (i32.const 12)) (local.get $count))
        (return (local.get $type))
      )
    )

    ;; Fixstr (0xa0-0xbf): length = byte & 0x1f
    (if (i32.and (i32.ge_u (local.get $byte) (i32.const 0xa0))
                 (i32.le_u (local.get $byte) (i32.const 0xbf)))
      (then
        (local.set $type (global.get $MSGPACK_STRING))
        (local.set $header_size (i32.const 1))
        (local.set $data_size (i32.and (local.get $byte) (i32.const 0x1f)))
        ;; Bounds check
        (if (i32.gt_u (i32.add (local.get $addr) (i32.add (local.get $header_size) (local.get $data_size)))
                      (local.get $end_addr))
          (then (return (global.get $MSGPACK_ERROR))))
        (i32.store (local.get $scratch) (local.get $type))
        (i32.store (i32.add (local.get $scratch) (i32.const 4)) (local.get $header_size))
        (i32.store (i32.add (local.get $scratch) (i32.const 8)) (local.get $data_size))
        (i32.store (i32.add (local.get $scratch) (i32.const 12)) (i32.const 0))
        (return (local.get $type))
      )
    )

    ;; nil (0xc0)
    (if (i32.eq (local.get $byte) (i32.const 0xc0))
      (then
        (i32.store (local.get $scratch) (global.get $MSGPACK_NIL))
        (i32.store (i32.add (local.get $scratch) (i32.const 4)) (i32.const 1))
        (i32.store (i32.add (local.get $scratch) (i32.const 8)) (i32.const 0))
        (i32.store (i32.add (local.get $scratch) (i32.const 12)) (i32.const 0))
        (return (global.get $MSGPACK_NIL))
      )
    )

    ;; 0xc1 is reserved - error
    (if (i32.eq (local.get $byte) (i32.const 0xc1))
      (then (return (global.get $MSGPACK_ERROR))))

    ;; false (0xc2)
    (if (i32.eq (local.get $byte) (i32.const 0xc2))
      (then
        (i32.store (local.get $scratch) (global.get $MSGPACK_BOOL))
        (i32.store (i32.add (local.get $scratch) (i32.const 4)) (i32.const 1))
        (i32.store (i32.add (local.get $scratch) (i32.const 8)) (i32.const 0))
        (i32.store (i32.add (local.get $scratch) (i32.const 12)) (i32.const 0))
        (return (global.get $MSGPACK_BOOL))
      )
    )

    ;; true (0xc3)
    (if (i32.eq (local.get $byte) (i32.const 0xc3))
      (then
        (i32.store (local.get $scratch) (global.get $MSGPACK_BOOL))
        (i32.store (i32.add (local.get $scratch) (i32.const 4)) (i32.const 1))
        (i32.store (i32.add (local.get $scratch) (i32.const 8)) (i32.const 0))
        (i32.store (i32.add (local.get $scratch) (i32.const 12)) (i32.const 1))  ;; 1 = true
        (return (global.get $MSGPACK_BOOL))
      )
    )

    ;; bin8 (0xc4) — same bounds discipline as str8: header readable,
    ;; then declared payload within the input.
    (if (i32.eq (local.get $byte) (i32.const 0xc4))
      (then
        (if (i32.gt_u (i32.add (local.get $addr) (i32.const 2)) (local.get $end_addr))
          (then (return (global.get $MSGPACK_ERROR))))
        (local.set $data_size (i32.load8_u (i32.add (local.get $addr) (i32.const 1))))
        (if (i32.gt_u (i32.add (local.get $addr) (i32.add (i32.const 2) (local.get $data_size)))
                      (local.get $end_addr))
          (then (return (global.get $MSGPACK_ERROR))))
        (i32.store (local.get $scratch) (global.get $MSGPACK_BIN))
        (i32.store (i32.add (local.get $scratch) (i32.const 4)) (i32.const 2))
        (i32.store (i32.add (local.get $scratch) (i32.const 8)) (local.get $data_size))
        (i32.store (i32.add (local.get $scratch) (i32.const 12)) (local.get $data_size))
        (return (global.get $MSGPACK_BIN))
      )
    )

    ;; bin16 (0xc5)
    (if (i32.eq (local.get $byte) (i32.const 0xc5))
      (then
        (if (i32.gt_u (i32.add (local.get $addr) (i32.const 3)) (local.get $end_addr))
          (then (return (global.get $MSGPACK_ERROR))))
        (local.set $data_size (call $read_u16_be (i32.add (local.get $addr) (i32.const 1))))
        (if (i32.gt_u (i32.add (local.get $addr) (i32.add (i32.const 3) (local.get $data_size)))
                      (local.get $end_addr))
          (then (return (global.get $MSGPACK_ERROR))))
        (i32.store (local.get $scratch) (global.get $MSGPACK_BIN))
        (i32.store (i32.add (local.get $scratch) (i32.const 4)) (i32.const 3))
        (i32.store (i32.add (local.get $scratch) (i32.const 8)) (local.get $data_size))
        (i32.store (i32.add (local.get $scratch) (i32.const 12)) (local.get $data_size))
        (return (global.get $MSGPACK_BIN))
      )
    )

    ;; bin32 (0xc6)
    (if (i32.eq (local.get $byte) (i32.const 0xc6))
      (then
        (if (i32.gt_u (i32.add (local.get $addr) (i32.const 5)) (local.get $end_addr))
          (then (return (global.get $MSGPACK_ERROR))))
        (local.set $data_size (call $read_u32_be (i32.add (local.get $addr) (i32.const 1))))
        ;; Wrap-safe payload bound: addr+5+size can wrap i32 for a
        ;; hostile 32-bit length; compare size against the REMAINING
        ;; input instead (end - (addr+5) cannot wrap — checked above).
        (if (i32.gt_u (local.get $data_size)
                      (i32.sub (local.get $end_addr) (i32.add (local.get $addr) (i32.const 5))))
          (then (return (global.get $MSGPACK_ERROR))))
        (i32.store (local.get $scratch) (global.get $MSGPACK_BIN))
        (i32.store (i32.add (local.get $scratch) (i32.const 4)) (i32.const 5))
        (i32.store (i32.add (local.get $scratch) (i32.const 8)) (local.get $data_size))
        (i32.store (i32.add (local.get $scratch) (i32.const 12)) (local.get $data_size))
        (return (global.get $MSGPACK_BIN))
      )
    )

    ;; ext8, ext16, ext32 (0xc7-0xc9) - unsupported
    (if (i32.and (i32.ge_u (local.get $byte) (i32.const 0xc7))
                 (i32.le_u (local.get $byte) (i32.const 0xc9)))
      (then (return (global.get $MSGPACK_ERROR))))

    ;; float32 (0xca)
    (if (i32.eq (local.get $byte) (i32.const 0xca))
      (then
        (if (i32.gt_u (i32.add (local.get $addr) (i32.const 5)) (local.get $end_addr))
          (then (return (global.get $MSGPACK_ERROR))))
        (i32.store (local.get $scratch) (global.get $MSGPACK_FLOAT))
        (i32.store (i32.add (local.get $scratch) (i32.const 4)) (i32.const 1))
        (i32.store (i32.add (local.get $scratch) (i32.const 8)) (i32.const 4))
        (i32.store (i32.add (local.get $scratch) (i32.const 12)) (i32.const 0))
        (return (global.get $MSGPACK_FLOAT))
      )
    )

    ;; float64 (0xcb)
    (if (i32.eq (local.get $byte) (i32.const 0xcb))
      (then
        (if (i32.gt_u (i32.add (local.get $addr) (i32.const 9)) (local.get $end_addr))
          (then (return (global.get $MSGPACK_ERROR))))
        (i32.store (local.get $scratch) (global.get $MSGPACK_FLOAT))
        (i32.store (i32.add (local.get $scratch) (i32.const 4)) (i32.const 1))
        (i32.store (i32.add (local.get $scratch) (i32.const 8)) (i32.const 8))
        (i32.store (i32.add (local.get $scratch) (i32.const 12)) (i32.const 0))
        (return (global.get $MSGPACK_FLOAT))
      )
    )

    ;; uint8 (0xcc)
    (if (i32.eq (local.get $byte) (i32.const 0xcc))
      (then
        (if (i32.gt_u (i32.add (local.get $addr) (i32.const 2)) (local.get $end_addr))
          (then (return (global.get $MSGPACK_ERROR))))
        (i32.store (local.get $scratch) (global.get $MSGPACK_INT))
        (i32.store (i32.add (local.get $scratch) (i32.const 4)) (i32.const 2))  ;; header + 1 byte
        (i32.store (i32.add (local.get $scratch) (i32.const 8)) (i32.const 0))
        (i32.store (i32.add (local.get $scratch) (i32.const 12))
          (i32.load8_u (i32.add (local.get $addr) (i32.const 1))))
        (return (global.get $MSGPACK_INT))
      )
    )

    ;; uint16 (0xcd)
    (if (i32.eq (local.get $byte) (i32.const 0xcd))
      (then
        (if (i32.gt_u (i32.add (local.get $addr) (i32.const 3)) (local.get $end_addr))
          (then (return (global.get $MSGPACK_ERROR))))
        (i32.store (local.get $scratch) (global.get $MSGPACK_INT))
        (i32.store (i32.add (local.get $scratch) (i32.const 4)) (i32.const 3))
        (i32.store (i32.add (local.get $scratch) (i32.const 8)) (i32.const 0))
        (i32.store (i32.add (local.get $scratch) (i32.const 12))
          (call $read_u16_be (i32.add (local.get $addr) (i32.const 1))))
        (return (global.get $MSGPACK_INT))
      )
    )

    ;; uint32 (0xce)
    (if (i32.eq (local.get $byte) (i32.const 0xce))
      (then
        (if (i32.gt_u (i32.add (local.get $addr) (i32.const 5)) (local.get $end_addr))
          (then (return (global.get $MSGPACK_ERROR))))
        (i32.store (local.get $scratch) (global.get $MSGPACK_INT))
        (i32.store (i32.add (local.get $scratch) (i32.const 4)) (i32.const 5))
        (i32.store (i32.add (local.get $scratch) (i32.const 8)) (i32.const 0))
        (i32.store (i32.add (local.get $scratch) (i32.const 12))
          (call $read_u32_be (i32.add (local.get $addr) (i32.const 1))))
        (return (global.get $MSGPACK_INT))
      )
    )

    ;; uint64 (0xcf) - treat as float since JS numbers are f64
    (if (i32.eq (local.get $byte) (i32.const 0xcf))
      (then
        (if (i32.gt_u (i32.add (local.get $addr) (i32.const 9)) (local.get $end_addr))
          (then (return (global.get $MSGPACK_ERROR))))
        ;; uint64 needs special handling - we'll read it as float
        (i32.store (local.get $scratch) (global.get $MSGPACK_INT))
        (i32.store (i32.add (local.get $scratch) (i32.const 4)) (i32.const 9))
        (i32.store (i32.add (local.get $scratch) (i32.const 8)) (i32.const 8))  ;; Mark as 8-byte int
        (i32.store (i32.add (local.get $scratch) (i32.const 12)) (i32.const 0))
        (return (global.get $MSGPACK_INT))
      )
    )

    ;; int8 (0xd0)
    (if (i32.eq (local.get $byte) (i32.const 0xd0))
      (then
        (if (i32.gt_u (i32.add (local.get $addr) (i32.const 2)) (local.get $end_addr))
          (then (return (global.get $MSGPACK_ERROR))))
        (i32.store (local.get $scratch) (global.get $MSGPACK_INT))
        (i32.store (i32.add (local.get $scratch) (i32.const 4)) (i32.const 2))
        (i32.store (i32.add (local.get $scratch) (i32.const 8)) (i32.const 0))
        (i32.store (i32.add (local.get $scratch) (i32.const 12))
          (i32.extend8_s (i32.load8_u (i32.add (local.get $addr) (i32.const 1)))))
        (return (global.get $MSGPACK_INT))
      )
    )

    ;; int16 (0xd1)
    (if (i32.eq (local.get $byte) (i32.const 0xd1))
      (then
        (if (i32.gt_u (i32.add (local.get $addr) (i32.const 3)) (local.get $end_addr))
          (then (return (global.get $MSGPACK_ERROR))))
        (i32.store (local.get $scratch) (global.get $MSGPACK_INT))
        (i32.store (i32.add (local.get $scratch) (i32.const 4)) (i32.const 3))
        (i32.store (i32.add (local.get $scratch) (i32.const 8)) (i32.const 0))
        (i32.store (i32.add (local.get $scratch) (i32.const 12))
          (call $read_i16_be (i32.add (local.get $addr) (i32.const 1))))
        (return (global.get $MSGPACK_INT))
      )
    )

    ;; int32 (0xd2)
    (if (i32.eq (local.get $byte) (i32.const 0xd2))
      (then
        (if (i32.gt_u (i32.add (local.get $addr) (i32.const 5)) (local.get $end_addr))
          (then (return (global.get $MSGPACK_ERROR))))
        (i32.store (local.get $scratch) (global.get $MSGPACK_INT))
        (i32.store (i32.add (local.get $scratch) (i32.const 4)) (i32.const 5))
        (i32.store (i32.add (local.get $scratch) (i32.const 8)) (i32.const 0))
        (i32.store (i32.add (local.get $scratch) (i32.const 12))
          (call $read_i32_be (i32.add (local.get $addr) (i32.const 1))))
        (return (global.get $MSGPACK_INT))
      )
    )

    ;; int64 (0xd3) - treat as float since JS numbers are f64
    (if (i32.eq (local.get $byte) (i32.const 0xd3))
      (then
        (if (i32.gt_u (i32.add (local.get $addr) (i32.const 9)) (local.get $end_addr))
          (then (return (global.get $MSGPACK_ERROR))))
        ;; int64 needs special handling - we'll read it as float
        (i32.store (local.get $scratch) (global.get $MSGPACK_INT))
        (i32.store (i32.add (local.get $scratch) (i32.const 4)) (i32.const 9))
        (i32.store (i32.add (local.get $scratch) (i32.const 8)) (i32.const -8))  ;; Mark as signed 8-byte int
        (i32.store (i32.add (local.get $scratch) (i32.const 12)) (i32.const 0))
        (return (global.get $MSGPACK_INT))
      )
    )

    ;; fixext1-fixext16 (0xd4-0xd8) - unsupported
    (if (i32.and (i32.ge_u (local.get $byte) (i32.const 0xd4))
                 (i32.le_u (local.get $byte) (i32.const 0xd8)))
      (then (return (global.get $MSGPACK_ERROR))))

    ;; str8 (0xd9)
    (if (i32.eq (local.get $byte) (i32.const 0xd9))
      (then
        (if (i32.gt_u (i32.add (local.get $addr) (i32.const 2)) (local.get $end_addr))
          (then (return (global.get $MSGPACK_ERROR))))
        (local.set $data_size (i32.load8_u (i32.add (local.get $addr) (i32.const 1))))
        (if (i32.gt_u (i32.add (local.get $addr) (i32.add (i32.const 2) (local.get $data_size)))
                      (local.get $end_addr))
          (then (return (global.get $MSGPACK_ERROR))))
        (i32.store (local.get $scratch) (global.get $MSGPACK_STRING))
        (i32.store (i32.add (local.get $scratch) (i32.const 4)) (i32.const 2))
        (i32.store (i32.add (local.get $scratch) (i32.const 8)) (local.get $data_size))
        (i32.store (i32.add (local.get $scratch) (i32.const 12)) (i32.const 0))
        (return (global.get $MSGPACK_STRING))
      )
    )

    ;; str16 (0xda)
    (if (i32.eq (local.get $byte) (i32.const 0xda))
      (then
        (if (i32.gt_u (i32.add (local.get $addr) (i32.const 3)) (local.get $end_addr))
          (then (return (global.get $MSGPACK_ERROR))))
        (local.set $data_size (call $read_u16_be (i32.add (local.get $addr) (i32.const 1))))
        (if (i32.gt_u (i32.add (local.get $addr) (i32.add (i32.const 3) (local.get $data_size)))
                      (local.get $end_addr))
          (then (return (global.get $MSGPACK_ERROR))))
        (i32.store (local.get $scratch) (global.get $MSGPACK_STRING))
        (i32.store (i32.add (local.get $scratch) (i32.const 4)) (i32.const 3))
        (i32.store (i32.add (local.get $scratch) (i32.const 8)) (local.get $data_size))
        (i32.store (i32.add (local.get $scratch) (i32.const 12)) (i32.const 0))
        (return (global.get $MSGPACK_STRING))
      )
    )

    ;; str32 (0xdb)
    (if (i32.eq (local.get $byte) (i32.const 0xdb))
      (then
        (if (i32.gt_u (i32.add (local.get $addr) (i32.const 5)) (local.get $end_addr))
          (then (return (global.get $MSGPACK_ERROR))))
        (local.set $data_size (call $read_u32_be (i32.add (local.get $addr) (i32.const 1))))
        ;; Wrap-safe payload bound (same hazard as bin32: a hostile
        ;; 32-bit length wraps addr+5+size past the comparison).
        (if (i32.gt_u (local.get $data_size)
                      (i32.sub (local.get $end_addr) (i32.add (local.get $addr) (i32.const 5))))
          (then (return (global.get $MSGPACK_ERROR))))
        (i32.store (local.get $scratch) (global.get $MSGPACK_STRING))
        (i32.store (i32.add (local.get $scratch) (i32.const 4)) (i32.const 5))
        (i32.store (i32.add (local.get $scratch) (i32.const 8)) (local.get $data_size))
        (i32.store (i32.add (local.get $scratch) (i32.const 12)) (i32.const 0))
        (return (global.get $MSGPACK_STRING))
      )
    )

    ;; array16 (0xdc)
    (if (i32.eq (local.get $byte) (i32.const 0xdc))
      (then
        (if (i32.gt_u (i32.add (local.get $addr) (i32.const 3)) (local.get $end_addr))
          (then (return (global.get $MSGPACK_ERROR))))
        (local.set $count (call $read_u16_be (i32.add (local.get $addr) (i32.const 1))))
        ;; A container's count elements occupy at least count bytes; a
        ;; declared count beyond the remaining input is malformed — and
        ;; unchecked it feeds count*16 size math downstream, which can
        ;; wrap past every heap estimate for hostile 32-bit counts.
        (if (i32.gt_u (local.get $count)
              (i32.sub (local.get $end_addr) (i32.add (local.get $addr) (i32.const 3))))
          (then (return (global.get $MSGPACK_ERROR))))
        (i32.store (local.get $scratch) (global.get $MSGPACK_ARRAY))
        (i32.store (i32.add (local.get $scratch) (i32.const 4)) (i32.const 3))
        (i32.store (i32.add (local.get $scratch) (i32.const 8)) (i32.const 0))
        (i32.store (i32.add (local.get $scratch) (i32.const 12)) (local.get $count))
        (return (global.get $MSGPACK_ARRAY))
      )
    )

    ;; array32 (0xdd)
    (if (i32.eq (local.get $byte) (i32.const 0xdd))
      (then
        (if (i32.gt_u (i32.add (local.get $addr) (i32.const 5)) (local.get $end_addr))
          (then (return (global.get $MSGPACK_ERROR))))
        (local.set $count (call $read_u32_be (i32.add (local.get $addr) (i32.const 1))))
        ;; Count sanity — see array16 above.
        (if (i32.gt_u (local.get $count)
              (i32.sub (local.get $end_addr) (i32.add (local.get $addr) (i32.const 5))))
          (then (return (global.get $MSGPACK_ERROR))))
        (i32.store (local.get $scratch) (global.get $MSGPACK_ARRAY))
        (i32.store (i32.add (local.get $scratch) (i32.const 4)) (i32.const 5))
        (i32.store (i32.add (local.get $scratch) (i32.const 8)) (i32.const 0))
        (i32.store (i32.add (local.get $scratch) (i32.const 12)) (local.get $count))
        (return (global.get $MSGPACK_ARRAY))
      )
    )

    ;; map16 (0xde)
    (if (i32.eq (local.get $byte) (i32.const 0xde))
      (then
        (if (i32.gt_u (i32.add (local.get $addr) (i32.const 3)) (local.get $end_addr))
          (then (return (global.get $MSGPACK_ERROR))))
        (local.set $count (call $read_u16_be (i32.add (local.get $addr) (i32.const 1))))
        ;; Count sanity — see array16 above (map entries need ≥2 bytes,
        ;; but ≥1 is enough to keep the downstream size math safe).
        (if (i32.gt_u (local.get $count)
              (i32.sub (local.get $end_addr) (i32.add (local.get $addr) (i32.const 3))))
          (then (return (global.get $MSGPACK_ERROR))))
        (i32.store (local.get $scratch) (global.get $MSGPACK_MAP))
        (i32.store (i32.add (local.get $scratch) (i32.const 4)) (i32.const 3))
        (i32.store (i32.add (local.get $scratch) (i32.const 8)) (i32.const 0))
        (i32.store (i32.add (local.get $scratch) (i32.const 12)) (local.get $count))
        (return (global.get $MSGPACK_MAP))
      )
    )

    ;; map32 (0xdf)
    (if (i32.eq (local.get $byte) (i32.const 0xdf))
      (then
        (if (i32.gt_u (i32.add (local.get $addr) (i32.const 5)) (local.get $end_addr))
          (then (return (global.get $MSGPACK_ERROR))))
        (local.set $count (call $read_u32_be (i32.add (local.get $addr) (i32.const 1))))
        ;; Count sanity — see array16 above.
        (if (i32.gt_u (local.get $count)
              (i32.sub (local.get $end_addr) (i32.add (local.get $addr) (i32.const 5))))
          (then (return (global.get $MSGPACK_ERROR))))
        (i32.store (local.get $scratch) (global.get $MSGPACK_MAP))
        (i32.store (i32.add (local.get $scratch) (i32.const 4)) (i32.const 5))
        (i32.store (i32.add (local.get $scratch) (i32.const 8)) (i32.const 0))
        (i32.store (i32.add (local.get $scratch) (i32.const 12)) (local.get $count))
        (return (global.get $MSGPACK_MAP))
      )
    )

    ;; Unknown type byte - error
    (global.get $MSGPACK_ERROR)
  )

  ;; Read msgpack scratch field (after calling $msgpack_peek_type)
  (func $msgpack_scratch_header_size (result i32)
    (i32.load (call $scratch_ptr (i32.const 4) (i32.const 4)))
  )

  (func $msgpack_scratch_data_size (result i32)
    (i32.load (call $scratch_ptr (i32.const 8) (i32.const 4)))
  )

  (func $msgpack_scratch_count (result i32)
    (i32.load (call $scratch_ptr (i32.const 12) (i32.const 4)))
  )

  ;; ==========================================================================
  ;; MSGPACK_REF value layout
  ;;
  ;; Layout: [type:4][flags:4][data_ptr:4][offset:4]
  ;;   data_ptr — segment-relative DATA pointer to an OBJ.ARRAYBUFFER
  ;;              with internal layout [length:4][bytes...]
  ;;   offset   — byte offset within the bytes region where this
  ;;              sub-region starts
  ;;
  ;; Absolute addresses for reading bytes:
  ;;   start = abs(data_ptr) + 4 + offset
  ;;   end   = abs(data_ptr) + 4 + parent_byteLength
  ;;          (parent_byteLength is at i32 offset 0 of the data block)
  ;;
  ;; "end" is the parent blob's end, not the sub-region's end. The
  ;; overshoot is fine for msgpack helpers — they stop at each
  ;; value's natural boundary; end_addr is only a malformed-input
  ;; bound, preserving segment-relative reference decoding.
  ;; ==========================================================================

  ;; Compute absolute start address from a (data_ptr, offset) pair.
  (func $msgpack_ref_absolute (param $data_ptr i32) (param $offset i32) (result i32)
    (i32.add
      (i32.add (call $abs (local.get $data_ptr)) (i32.const 4))
      (local.get $offset))
  )

  ;; Compute absolute parent-end address from data_ptr.
  (func $msgpack_ref_parent_end (param $data_ptr i32) (result i32)
    (i32.add
      (i32.add (call $abs (local.get $data_ptr)) (i32.const 4))
      (i32.load (call $abs (local.get $data_ptr))))
  )

  ;; Compute offset within parent given an absolute address and the
  ;; parent's data_ptr.
  ;;   offset = absolute_addr - (abs(data_ptr) + 4)
  (func $msgpack_ref_offset_of (param $absolute_addr i32) (param $data_ptr i32) (result i32)
    (i32.sub
      (local.get $absolute_addr)
      (i32.add (call $abs (local.get $data_ptr)) (i32.const 4)))
  )

  ;; True for msgpack types that read directly to a VALUE (via
  ;; $msgpack_read_primitive) rather than becoming a container
  ;; TYPE_MSGPACK_REF: nil, bool, int, float, string, bin. Every
  ;; primitive-vs-container ladder must use this — a type left out of
  ;; a hand-rolled ladder falls into the container arm and mints a
  ;; ref for a non-container node (the pre-fix fate of bin).
  (func $msgpack_is_direct_type (param $type i32) (result i32)
    (i32.or
      (i32.or
        (i32.or
          (i32.eq (local.get $type) (global.get $MSGPACK_NIL))
          (i32.eq (local.get $type) (global.get $MSGPACK_BOOL)))
        (i32.or
          (i32.eq (local.get $type) (global.get $MSGPACK_INT))
          (i32.eq (local.get $type) (global.get $MSGPACK_FLOAT))))
      (i32.or
        (i32.eq (local.get $type) (global.get $MSGPACK_STRING))
        (i32.eq (local.get $type) (global.get $MSGPACK_BIN)))))

  ;; Skip over a complete msgpack value
  ;; Returns: next address after value, or -1 on error
  (func $msgpack_skip_value (param $addr i32) (param $end_addr i32) (result i32)
    (local $type i32)
    (local $header_size i32)
    (local $data_size i32)
    (local $count i32)
    (local $i i32)
    (local $next i32)

    (local.set $type (call $msgpack_peek_type (local.get $addr) (local.get $end_addr)))
    (if (i32.eq (local.get $type) (global.get $MSGPACK_ERROR))
      (then (return (i32.const -1))))

    (local.set $header_size (call $msgpack_scratch_header_size))
    (local.set $data_size (call $msgpack_scratch_data_size))
    (local.set $count (call $msgpack_scratch_count))

    ;; For simple types (nil, bool, int with value in count, fixint)
    (if (i32.or
          (i32.eq (local.get $type) (global.get $MSGPACK_NIL))
          (i32.eq (local.get $type) (global.get $MSGPACK_BOOL)))
      (then
        (return (i32.add (local.get $addr) (local.get $header_size)))
      )
    )

    ;; For int, check if value was stored in count (fixint, uint8-32, int8-32)
    ;; or if it's a 64-bit value (data_size = 8 or -8)
    (if (i32.eq (local.get $type) (global.get $MSGPACK_INT))
      (then
        (if (i32.or (i32.eq (local.get $data_size) (i32.const 8))
                    (i32.eq (local.get $data_size) (i32.const -8)))
          (then
            ;; 64-bit int: header (1 byte type code) + 8 bytes data
            (return (i32.add (local.get $addr) (i32.const 9)))
          )
          (else
            ;; Value stored in count field, just skip header
            (return (i32.add (local.get $addr) (local.get $header_size)))
          )
        )
      )
    )

    ;; For float, skip header + data
    (if (i32.eq (local.get $type) (global.get $MSGPACK_FLOAT))
      (then
        (return (i32.add (local.get $addr) (i32.add (local.get $header_size) (local.get $data_size))))
      )
    )

    ;; For string, skip header + data
    (if (i32.eq (local.get $type) (global.get $MSGPACK_STRING))
      (then
        (return (i32.add (local.get $addr) (i32.add (local.get $header_size) (local.get $data_size))))
      )
    )

    ;; For bin, skip header + payload (same shape as string)
    (if (i32.eq (local.get $type) (global.get $MSGPACK_BIN))
      (then
        (return (i32.add (local.get $addr) (i32.add (local.get $header_size) (local.get $data_size))))
      )
    )

    ;; For array, skip header then skip each element
    (if (i32.eq (local.get $type) (global.get $MSGPACK_ARRAY))
      (then
        (local.set $next (i32.add (local.get $addr) (local.get $header_size)))
        (local.set $i (i32.const 0))
        (block $array_done
          (loop $array_loop
            (br_if $array_done (i32.ge_u (local.get $i) (local.get $count)))
            (local.set $next (call $msgpack_skip_value (local.get $next) (local.get $end_addr)))
            (if (i32.eq (local.get $next) (i32.const -1))
              (then (return (i32.const -1))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $array_loop)
          )
        )
        (return (local.get $next))
      )
    )

    ;; For map, skip header then skip 2*count values (key-value pairs)
    (if (i32.eq (local.get $type) (global.get $MSGPACK_MAP))
      (then
        (local.set $next (i32.add (local.get $addr) (local.get $header_size)))
        (local.set $i (i32.const 0))
        (block $map_done
          (loop $map_loop
            (br_if $map_done (i32.ge_u (local.get $i) (local.get $count)))
            ;; Skip key
            (local.set $next (call $msgpack_skip_value (local.get $next) (local.get $end_addr)))
            (if (i32.eq (local.get $next) (i32.const -1))
              (then (return (i32.const -1))))
            ;; Skip value
            (local.set $next (call $msgpack_skip_value (local.get $next) (local.get $end_addr)))
            (if (i32.eq (local.get $next) (i32.const -1))
              (then (return (i32.const -1))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $map_loop)
          )
        )
        (return (local.get $next))
      )
    )

    ;; Unknown type
    (i32.const -1)
  )

  ;; Intern a msgpack string from an absolute address
  ;; The $intern_string function takes an absolute pointer to the bytes
  ;; Returns: string table offset
  (func $msgpack_intern_string (param $addr i32) (param $len i32) (result i32)
    ;; $intern_string expects absolute pointer to bytes (not length-prefixed)
    (call $intern_string (local.get $addr) (local.get $len))
  )

  ;; Read a msgpack primitive and push to pending stack
  ;; Assumes $msgpack_peek_type was already called
  ;; Returns: 0 on success, -1 on error
  (func $msgpack_read_primitive (param $addr i32) (param $end_addr i32) (result i32)
    (local $type i32)
    (local $header_size i32)
    (local $data_size i32)
    (local $count i32)
    (local $str_offset i32)
    (local $buffer_ptr i32)
    (local $float_val f64)
    (local $byte i32)
    (local $hi i32)
    (local $lo i32)

    (local.set $type (call $msgpack_peek_type (local.get $addr) (local.get $end_addr)))
    (if (i32.eq (local.get $type) (global.get $MSGPACK_ERROR))
      (then (return (i32.const -1))))

    (local.set $header_size (call $msgpack_scratch_header_size))
    (local.set $data_size (call $msgpack_scratch_data_size))
    (local.set $count (call $msgpack_scratch_count))

    ;; nil
    (if (i32.eq (local.get $type) (global.get $MSGPACK_NIL))
      (then
        (call $pending_push (global.get $TYPE_NULL) (i32.const 0) (i32.const 0) (i32.const 0))
        (return (i32.const 0))
      )
    )

    ;; bool
    (if (i32.eq (local.get $type) (global.get $MSGPACK_BOOL))
      (then
        (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (local.get $count) (i32.const 0))
        (return (i32.const 0))
      )
    )

    ;; int (for most ints, value is in count; for 64-bit, need special handling).
    ;; Msgpack integers land as Rational to be consistent with integer literals
    ;; in source code; this way msgpack-sourced and literal-sourced integers
    ;; compare equal under === and exact arithmetic.
    (if (i32.eq (local.get $type) (global.get $MSGPACK_INT))
      (then
        (if (i32.eq (local.get $data_size) (i32.const 8))
          (then
            ;; uint64 - read as i64 into inline Rational (fits unless > i64 max)
            (local.set $hi (call $read_u32_be (i32.add (local.get $addr) (i32.const 1))))
            (local.set $lo (call $read_u32_be (i32.add (local.get $addr) (i32.const 5))))
            (call $push_rational_inline
              (i64.or
                (i64.shl (i64.extend_i32_u (local.get $hi)) (i64.const 32))
                (i64.extend_i32_u (local.get $lo))))
            (return (i32.const 0))
          )
        )
        (if (i32.eq (local.get $data_size) (i32.const -8))
          (then
            ;; int64 - read as signed i64 into inline Rational
            (local.set $hi (call $read_i32_be (i32.add (local.get $addr) (i32.const 1))))
            (local.set $lo (call $read_u32_be (i32.add (local.get $addr) (i32.const 5))))
            (call $push_rational_inline
              (i64.or
                (i64.shl (i64.extend_i32_s (local.get $hi)) (i64.const 32))
                (i64.extend_i32_u (local.get $lo))))
            (return (i32.const 0))
          )
        )
        ;; Regular int - value is in count (signed i32)
        (call $push_rational_inline (i64.extend_i32_s (local.get $count)))
        (return (i32.const 0))
      )
    )

    ;; float
    (if (i32.eq (local.get $type) (global.get $MSGPACK_FLOAT))
      (then
        (if (i32.eq (local.get $data_size) (i32.const 4))
          (then
            ;; float32
            (call $push_f64 (f64.promote_f32
              (call $read_f32_be (i32.add (local.get $addr) (i32.const 1)))))
          )
          (else
            ;; float64
            (call $push_f64 (call $read_f64_be (i32.add (local.get $addr) (i32.const 1))))
          )
        )
        (return (i32.const 0))
      )
    )

    ;; string - intern and push
    (if (i32.eq (local.get $type) (global.get $MSGPACK_STRING))
      (then
        (local.set $str_offset
          (call $msgpack_intern_string
            (i32.add (local.get $addr) (local.get $header_size))
            (local.get $data_size)))
        ;; A refused intern (string region full) returns the sentinel
        ;; id 0 with the pressure flag set. Pushing it would hand the
        ;; program an invalid string id — return -1 with NO error set
        ;; instead; callers distinguish pressure (flag set → yield and
        ;; retry) from malformed input (flag clear → ERR_MSGPACK_INVALID).
        (if (global.get $memory_pressure_signaled)
          (then (return (i32.const -1))))
        (call $pending_push (global.get $TYPE_STRING) (i32.const 0) (local.get $str_offset) (i32.const 0))
        (return (i32.const 0))
      )
    )

    ;; bin - materialize a Uint8Array (buffer + descriptor) and push.
    ;; Bin never becomes a TYPE_MSGPACK_REF: every read site produces a
    ;; real Uint8Array, mirroring what our encoder accepts.
    (if (i32.eq (local.get $type) (global.get $MSGPACK_BIN))
      (then
        ;; Pressure pre-check for both allocations (buffer + 24-byte
        ;; descriptor). On refusal: -1 with NO error set, flag set —
        ;; same convention as the string arm above.
        (if (call $check_heap_overflow
              (i32.add
                (call $estimate_arraybuffer_size (local.get $data_size))
                (i32.const 24)))
          (then (return (i32.const -1))))
        (local.set $buffer_ptr (call $allocate_arraybuffer (local.get $data_size)))
        (memory.copy
          (call $abs (i32.add (local.get $buffer_ptr) (i32.const 4)))
          (i32.add (local.get $addr) (local.get $header_size))
          (local.get $data_size))
        (call $pending_push
          (global.get $TYPE_UINT8ARRAY)
          (i32.const 0)
          (call $allocate_typed_array_descriptor
            (local.get $buffer_ptr) (i32.const 0) (local.get $data_size))
          (i32.const 0))
        (return (i32.const 0))
      )
    )

    ;; array or map — containers should be handled by the caller (which
    ;; has the parent_data_ptr needed to construct a Layout-A
    ;; MSGPACK_REF). If we reach here, the caller used the wrong helper.
    (if (i32.or
          (i32.eq (local.get $type) (global.get $MSGPACK_ARRAY))
          (i32.eq (local.get $type) (global.get $MSGPACK_MAP)))
      (then
        (call $set_error (global.get $ERR_MSGPACK_INVALID) (i32.const 0))
        (return (i32.const -1))
      )
    )

    ;; Unknown type
    (i32.const -1)
  )

  ;; Search a msgpack map for a key (string table offset)
  ;; Returns: address of value if found, -1 if not found
  (func $msgpack_map_get (param $addr i32) (param $end_addr i32) (param $key_str_offset i32) (result i32)
    (local $type i32)
    (local $header_size i32)
    (local $count i32)
    (local $i i32)
    (local $pos i32)
    (local $key_type i32)
    (local $key_header_size i32)
    (local $key_data_size i32)
    (local $key_addr i32)
    (local $value_addr i32)
    (local $key_str_len i32)
    (local $mp_str_len i32)
    (local $j i32)
    (local $match i32)
    (local $key_bytes_addr i32)
    (local $mp_bytes_addr i32)

    ;; Peek map type
    (local.set $type (call $msgpack_peek_type (local.get $addr) (local.get $end_addr)))
    (if (i32.ne (local.get $type) (global.get $MSGPACK_MAP))
      (then (return (i32.const -1))))

    (local.set $header_size (call $msgpack_scratch_header_size))
    (local.set $count (call $msgpack_scratch_count))

    ;; Position after map header
    (local.set $pos (i32.add (local.get $addr) (local.get $header_size)))

    ;; Get the key string bytes from string table. $key_str_offset is
    ;; a table-relative interned-string id.
    ;; String table format: [len:4][bytes...]
    (local.set $key_bytes_addr (i32.add (call $string_id_to_abs (local.get $key_str_offset)) (i32.const 4)))
    (local.set $key_str_len (i32.load (call $string_id_to_abs (local.get $key_str_offset))))

    ;; Iterate through key-value pairs
    (local.set $i (i32.const 0))
    (block $found
      (block $not_found
        (loop $map_loop
          (br_if $not_found (i32.ge_u (local.get $i) (local.get $count)))
          (br_if $not_found (i32.ge_u (local.get $pos) (local.get $end_addr)))

          ;; Peek key type
          (local.set $key_type (call $msgpack_peek_type (local.get $pos) (local.get $end_addr)))
          (if (i32.eq (local.get $key_type) (global.get $MSGPACK_ERROR))
            (then (return (i32.const -1))))

          (local.set $key_header_size (call $msgpack_scratch_header_size))
          (local.set $key_data_size (call $msgpack_scratch_data_size))

          ;; Check if key is a string
          (if (i32.eq (local.get $key_type) (global.get $MSGPACK_STRING))
            (then
              ;; Compare string bytes
              (local.set $mp_str_len (local.get $key_data_size))
              (local.set $mp_bytes_addr (i32.add (local.get $pos) (local.get $key_header_size)))

              ;; Length check first
              (if (i32.eq (local.get $key_str_len) (local.get $mp_str_len))
                (then
                  ;; Compare bytes
                  (local.set $match (i32.const 1))
                  (local.set $j (i32.const 0))
                  (block $cmp_done
                    (loop $cmp_loop
                      (br_if $cmp_done (i32.ge_u (local.get $j) (local.get $key_str_len)))
                      (if (i32.ne
                            (i32.load8_u (i32.add (local.get $key_bytes_addr) (local.get $j)))
                            (i32.load8_u (i32.add (local.get $mp_bytes_addr) (local.get $j))))
                        (then
                          (local.set $match (i32.const 0))
                          (br $cmp_done)
                        )
                      )
                      (local.set $j (i32.add (local.get $j) (i32.const 1)))
                      (br $cmp_loop)
                    )
                  )

                  (if (local.get $match)
                    (then
                      ;; Found! Return address of value
                      (local.set $value_addr
                        (i32.add (local.get $pos)
                          (i32.add (local.get $key_header_size) (local.get $key_data_size))))
                      (return (local.get $value_addr))
                    )
                  )
                )
              )
            )
          )

          ;; Skip this key
          (local.set $pos (call $msgpack_skip_value (local.get $pos) (local.get $end_addr)))
          (if (i32.eq (local.get $pos) (i32.const -1))
            (then (return (i32.const -1))))

          ;; Skip the value
          (local.set $pos (call $msgpack_skip_value (local.get $pos) (local.get $end_addr)))
          (if (i32.eq (local.get $pos) (i32.const -1))
            (then (return (i32.const -1))))

          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $map_loop)
        )
      )
    )

    ;; Not found
    (i32.const -1)
  )

  ;; Get element at index from msgpack array
  ;; Returns: address of element, or -1 if out of bounds/error
  (func $msgpack_array_get (param $addr i32) (param $end_addr i32) (param $index i32) (result i32)
    (local $type i32)
    (local $header_size i32)
    (local $count i32)
    (local $i i32)
    (local $pos i32)

    ;; Peek array type
    (local.set $type (call $msgpack_peek_type (local.get $addr) (local.get $end_addr)))
    (if (i32.ne (local.get $type) (global.get $MSGPACK_ARRAY))
      (then (return (i32.const -1))))

    (local.set $header_size (call $msgpack_scratch_header_size))
    (local.set $count (call $msgpack_scratch_count))

    ;; Bounds check
    (if (i32.ge_u (local.get $index) (local.get $count))
      (then (return (i32.const -1))))

    ;; Position after array header
    (local.set $pos (i32.add (local.get $addr) (local.get $header_size)))

    ;; Skip to the requested index
    (local.set $i (i32.const 0))
    (block $done
      (loop $skip_loop
        (br_if $done (i32.ge_u (local.get $i) (local.get $index)))
        (local.set $pos (call $msgpack_skip_value (local.get $pos) (local.get $end_addr)))
        (if (i32.eq (local.get $pos) (i32.const -1))
          (then (return (i32.const -1))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $skip_loop)
      )
    )

    ;; pos now points to element at index
    (local.get $pos)
  )

  ;; ==========================================================================
  ;; msgpack_to_array
  ;;
  ;; Materializes a msgpack array to a heap array.
  ;; Returns pointer to new TYPE_ARRAY, or 0 on error (error already set).
  ;;
  ;; $parent_data_ptr is the segment-relative DATA pointer of the
  ;; OBJ.ARRAYBUFFER owning the msgpack bytes that $addr points into.
  ;; It's used to construct sub-region MSGPACK_REF values for any
  ;; container elements: those refs share the parent's data_ptr and
  ;; carry an offset within the parent's bytes region.
  ;; ==========================================================================
  (func $msgpack_to_array (param $addr i32) (param $end_addr i32) (param $parent_data_ptr i32) (result i32)
    (local $type i32)
    (local $header_size i32)
    (local $count i32)
    (local $array_pointer i32)
    (local $data_pointer i32)
    (local $data_size i32)
    (local $heap_pointer i32)
    (local $elem_addr i32)
    (local $i i32)
    (local $elem_type i32)
    (local $value_pointer i32)
    (local $elem_len i32)
    (local $dest i32)

    ;; Peek type - must be array
    (local.set $type (call $msgpack_peek_type (local.get $addr) (local.get $end_addr)))
    (if (i32.ne (local.get $type) (global.get $MSGPACK_ARRAY))
      (then
        (call $set_error (global.get $ERR_TYPE_ERROR) (local.get $type))
        (return (i32.const 0))
      )
    )

    (local.set $header_size (call $msgpack_scratch_header_size))
    (local.set $count (call $msgpack_scratch_count))

    ;; Proportional pressure pre-check: one array of count elements,
    ;; allocated blindly below. The op-level materialization sites
    ;; pre-check the same estimate before calling (this is then a
    ;; no-op); the recursive callers — msgpack_decode_any and
    ;; msgpack_to_object's array-value branch — rely on THIS check.
    ;; On refusal: return 0 with NO error set; the pressure flag
    ;; distinguishes it from the error returns above, and the caller
    ;; chain unwinds to a pressure yield + post-GC retry.
    (if (call $check_heap_overflow (call $estimate_array_size (local.get $count)))
      (then (return (i32.const 0))))

    ;; Allocate array inline (same layout as OP_MAKE_ARRAY)
    (local.set $heap_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))
    (local.set $array_pointer (local.get $heap_pointer))

    ;; Data block: GC header (8) + count * 16 bytes
    (local.set $data_size (i32.add (global.get $GC_HEADER_SIZE)
                                   (i32.mul (local.get $count) (global.get $VALUE_SIZE))))
    (local.set $data_pointer (call $write_array_header
      (local.get $array_pointer) (local.get $count) (local.get $count) (local.get $data_size)))

    ;; Update heap pointer
    (call $write_state (global.get $STATE_HEAP_POINTER)
      (i32.add (local.get $data_pointer) (local.get $data_size)))

    ;; Point to first element in msgpack
    (local.set $elem_addr (i32.add (local.get $addr) (local.get $header_size)))

    ;; Iterate and copy elements
    ;; Elements start at data_pointer + GC_HEADER_SIZE
    (local.set $i (i32.const 0))
    (block $done
      (loop $iter
        (br_if $done (i32.ge_u (local.get $i) (local.get $count)))

        ;; Peek element type
        (local.set $elem_type (call $msgpack_peek_type (local.get $elem_addr) (local.get $end_addr)))
        (if (i32.eq (local.get $elem_type) (global.get $MSGPACK_ERROR))
          (then
            (call $set_error (global.get $ERR_MSGPACK_INVALID) (i32.const 0))
            (return (i32.const 0))
          )
        )

        ;; Destination in heap array: data_pointer + GC_HEADER_SIZE + i * 16
        (local.set $dest (i32.add
          (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
          (i32.mul (local.get $i) (global.get $VALUE_SIZE))))

        ;; Check if primitive or container
        (if (call $msgpack_is_direct_type (local.get $elem_type))
          (then
            ;; Primitive - read directly using msgpack_read_primitive
            ;; It pushes to pending stack, so we need to pop and copy to dest.
            ;; -1 = nothing was pushed: refused allocation (pressure flag
            ;; set — caller yields and retries) or malformed input (flag
            ;; clear — name it). Popping regardless would copy garbage.
            (if (i32.eq (call $msgpack_read_primitive (local.get $elem_addr) (local.get $end_addr))
                        (i32.const -1))
              (then
                (if (i32.eqz (global.get $memory_pressure_signaled))
                  (then (call $set_error (global.get $ERR_MSGPACK_INVALID) (i32.const 0))))
                (return (i32.const 0))
              )
            )
            ;; Pop from pending stack
            (local.set $value_pointer (call $pending_pop))
            ;; Copy 16 bytes to dest
            (i32.store (call $abs (local.get $dest))
              (i32.load (call $abs (local.get $value_pointer))))
            (i32.store (call $abs (i32.add (local.get $dest) (i32.const 4)))
              (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 4)))))
            (i32.store (call $abs (i32.add (local.get $dest) (i32.const 8)))
              (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 8)))))
            (i32.store (call $abs (i32.add (local.get $dest) (i32.const 12)))
              (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 12)))))
          )
          (else
            ;; Container - write TYPE_MSGPACK_REF
            ;; Layout (segment-relative): [type][flags=0][data_ptr][offset]
            ;; data_ptr is the parent ArrayBuffer's data pointer; offset
            ;; is computed from the absolute element address.
            (i32.store (call $abs (local.get $dest)) (global.get $TYPE_MSGPACK_REF))
            (i32.store (call $abs (i32.add (local.get $dest) (i32.const 4))) (i32.const 0))
            (i32.store (call $abs (i32.add (local.get $dest) (i32.const 8))) (local.get $parent_data_ptr))
            (i32.store (call $abs (i32.add (local.get $dest) (i32.const 12)))
              (call $msgpack_ref_offset_of (local.get $elem_addr) (local.get $parent_data_ptr)))
          )
        )

        ;; Advance to next element
        (local.set $elem_addr (call $msgpack_skip_value (local.get $elem_addr) (local.get $end_addr)))
        (if (i32.eq (local.get $elem_addr) (i32.const -1))
          (then
            (call $set_error (global.get $ERR_MSGPACK_INVALID) (i32.const 0))
            (return (i32.const 0))
          )
        )

        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $iter)
      )
    )

    (local.get $array_pointer)
  )

  ;; ==========================================================================
  ;; msgpack_map_keys
  ;;
  ;; Returns heap array of interned key strings from a msgpack map.
  ;; Returns 0 on error (not a map, or invalid msgpack).
  ;; ==========================================================================
  (func $msgpack_map_keys (param $addr i32) (param $end_addr i32) (result i32)
    (local $type i32)
    (local $header_size i32)
    (local $count i32)
    (local $array_pointer i32)
    (local $data_pointer i32)
    (local $data_size i32)
    (local $heap_pointer i32)
    (local $pos i32)
    (local $i i32)
    (local $key_type i32)
    (local $key_header_size i32)
    (local $key_data_size i32)
    (local $key_offset i32)
    (local $dest i32)

    ;; Peek type - must be map
    (local.set $type (call $msgpack_peek_type (local.get $addr) (local.get $end_addr)))
    (if (i32.ne (local.get $type) (global.get $MSGPACK_MAP))
      (then
        (return (i32.const 0))
      )
    )

    (local.set $header_size (call $msgpack_scratch_header_size))
    (local.set $count (call $msgpack_scratch_count))

    ;; Allocate array inline (same layout as OP_MAKE_ARRAY)
    (local.set $heap_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))
    (local.set $array_pointer (local.get $heap_pointer))

    ;; Header + data block via the array-header chokepoint
    (local.set $data_size (i32.add (global.get $GC_HEADER_SIZE)
                                   (i32.mul (local.get $count) (global.get $VALUE_SIZE))))

    ;; Bounds check BEFORE the first store: write_array_header is a pure
    ;; writer, and this carve used to bump-then-write with no check —
    ;; under heap pressure the header + values landed in the code block
    ;; (which grows down into this same span), zeroing late-program
    ;; bytecode BEFORE the dispatcher's per-instruction collision
    ;; backstop could raise OUT_OF_MEMORY
    ;; because the check helper, despite its "concat" name, is the generic
    ;; "would heap_pointer + N cross code_pointer" test.

    (if (call $check_concat_scratch_overflow
          (i32.add (global.get $ARRAY_HEADER_SIZE) (local.get $data_size)))
      (then (return (i32.const 0))))

    (local.set $data_pointer (call $write_array_header
      (local.get $array_pointer) (local.get $count) (local.get $count) (local.get $data_size)))

    ;; Update heap pointer
    (call $write_state (global.get $STATE_HEAP_POINTER)
      (i32.add (local.get $data_pointer) (local.get $data_size)))

    ;; Iterate map entries and collect keys
    (local.set $pos (i32.add (local.get $addr) (local.get $header_size)))
    (local.set $i (i32.const 0))
    (block $done
      (loop $iter
        (br_if $done (i32.ge_u (local.get $i) (local.get $count)))

        ;; Peek key type - must be string
        (local.set $key_type (call $msgpack_peek_type (local.get $pos) (local.get $end_addr)))
        (if (i32.ne (local.get $key_type) (global.get $MSGPACK_STRING))
          (then
            ;; Non-string key - error
            (call $set_error (global.get $ERR_TYPE_ERROR) (local.get $key_type))
            (return (i32.const 0))
          )
        )

        (local.set $key_header_size (call $msgpack_scratch_header_size))
        (local.set $key_data_size (call $msgpack_scratch_data_size))

        ;; Intern the key string
        (local.set $key_offset (call $msgpack_intern_string
          (i32.add (local.get $pos) (local.get $key_header_size))
          (local.get $key_data_size)))

        ;; Write TYPE_STRING to array slot
        (local.set $dest (i32.add
          (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
          (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
        (i32.store (call $abs (local.get $dest)) (global.get $TYPE_STRING))
        (i32.store (call $abs (i32.add (local.get $dest) (i32.const 4))) (i32.const 0))
        (i32.store (call $abs (i32.add (local.get $dest) (i32.const 8))) (local.get $key_offset))
        (i32.store (call $abs (i32.add (local.get $dest) (i32.const 12))) (i32.const 0))

        ;; Skip key
        (local.set $pos (call $msgpack_skip_value (local.get $pos) (local.get $end_addr)))
        ;; Skip value
        (local.set $pos (call $msgpack_skip_value (local.get $pos) (local.get $end_addr)))

        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $iter)
      )
    )

    (local.get $array_pointer)
  )

  ;; ==========================================================================
  ;; msgpack_array_keys
  ;;
  ;; Returns heap array of string indices ["0", "1", "2", ...] for a msgpack array.
  ;; Returns 0 if not an array.
  ;; ==========================================================================
  (func $msgpack_array_keys (param $addr i32) (param $end_addr i32) (result i32)
    (local $type i32)
    (local $header_size i32)
    (local $count i32)
    (local $array_pointer i32)
    (local $data_pointer i32)
    (local $data_size i32)
    (local $heap_pointer i32)
    (local $i i32)
    (local $key_offset i32)
    (local $dest i32)

    ;; Peek type - must be array
    (local.set $type (call $msgpack_peek_type (local.get $addr) (local.get $end_addr)))
    (if (i32.ne (local.get $type) (global.get $MSGPACK_ARRAY))
      (then
        (return (i32.const 0))
      )
    )

    (local.set $header_size (call $msgpack_scratch_header_size))
    (local.set $count (call $msgpack_scratch_count))

    ;; Allocate array inline (same layout as OP_MAKE_ARRAY)
    (local.set $heap_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))
    (local.set $array_pointer (local.get $heap_pointer))

    ;; Header + data block via the array-header chokepoint
    (local.set $data_size (i32.add (global.get $GC_HEADER_SIZE)
                                   (i32.mul (local.get $count) (global.get $VALUE_SIZE))))

    ;; Bounds check BEFORE the first store: write_array_header is a pure
    ;; writer, and this carve used to bump-then-write with no check —
    ;; under heap pressure the header + values landed in the code block
    ;; (which grows down into this same span), zeroing late-program
    ;; bytecode BEFORE the dispatcher's per-instruction collision
    ;; backstop could raise OUT_OF_MEMORY
    ;; because the check helper, despite its "concat" name, is the generic
    ;; "would heap_pointer + N cross code_pointer" test.

    (if (call $check_concat_scratch_overflow
          (i32.add (global.get $ARRAY_HEADER_SIZE) (local.get $data_size)))
      (then (return (i32.const 0))))

    (local.set $data_pointer (call $write_array_header
      (local.get $array_pointer) (local.get $count) (local.get $count) (local.get $data_size)))

    ;; Update heap pointer
    (call $write_state (global.get $STATE_HEAP_POINTER)
      (i32.add (local.get $data_pointer) (local.get $data_size)))

    ;; Generate index strings ["0", "1", "2", ...]
    (local.set $i (i32.const 0))
    (block $done
      (loop $iter
        (br_if $done (i32.ge_u (local.get $i) (local.get $count)))

        ;; Convert index to interned string
        (local.set $key_offset (call $f64_to_string (f64.convert_i32_u (local.get $i))))

        ;; Write TYPE_STRING to array slot
        (local.set $dest (i32.add
          (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
          (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
        (i32.store (call $abs (local.get $dest)) (global.get $TYPE_STRING))
        (i32.store (call $abs (i32.add (local.get $dest) (i32.const 4))) (i32.const 0))
        (i32.store (call $abs (i32.add (local.get $dest) (i32.const 8))) (local.get $key_offset))
        (i32.store (call $abs (i32.add (local.get $dest) (i32.const 12))) (i32.const 0))

        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $iter)
      )
    )

    (local.get $array_pointer)
  )

  ;; ==========================================================================
  ;; msgpack_map_values
  ;;
  ;; Returns heap array of values from a msgpack map.
  ;; Primitives are converted; containers become TYPE_MSGPACK_REF.
  ;; Returns 0 on error.
  ;; $parent_data_ptr is the segment-relative DATA pointer of the
  ;; OBJ.ARRAYBUFFER owning the msgpack bytes — needed to construct
  ;; sub-region MSGPACK_REF values for container map values.
  ;; ==========================================================================
  (func $msgpack_map_values (param $addr i32) (param $end_addr i32) (param $parent_data_ptr i32) (result i32)
    (local $type i32)
    (local $header_size i32)
    (local $count i32)
    (local $array_pointer i32)
    (local $data_pointer i32)
    (local $data_size i32)
    (local $heap_pointer i32)
    (local $pos i32)
    (local $i i32)
    (local $val_addr i32)
    (local $val_type i32)
    (local $value_pointer i32)
    (local $dest i32)

    ;; Peek type - must be map
    (local.set $type (call $msgpack_peek_type (local.get $addr) (local.get $end_addr)))
    (if (i32.ne (local.get $type) (global.get $MSGPACK_MAP))
      (then
        (return (i32.const 0))
      )
    )

    (local.set $header_size (call $msgpack_scratch_header_size))
    (local.set $count (call $msgpack_scratch_count))

    ;; Bounds check BEFORE the first store — write_array_header is a
    ;; pure writer. Same guard as the keys twin above
    ;; to keep all array output within the heap/code free span.
    (if (call $check_heap_overflow (call $estimate_array_size (local.get $count)))
      (then (return (i32.const 0))))

    ;; Allocate array
    (local.set $heap_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))
    (local.set $array_pointer (local.get $heap_pointer))

    (local.set $data_size (i32.add (global.get $GC_HEADER_SIZE)
                                   (i32.mul (local.get $count) (global.get $VALUE_SIZE))))
    (local.set $data_pointer (call $write_array_header
      (local.get $array_pointer) (local.get $count) (local.get $count) (local.get $data_size)))

    (call $write_state (global.get $STATE_HEAP_POINTER)
      (i32.add (local.get $data_pointer) (local.get $data_size)))

    ;; Iterate map entries and collect values
    (local.set $pos (i32.add (local.get $addr) (local.get $header_size)))
    (local.set $i (i32.const 0))
    (block $done
      (loop $iter
        (br_if $done (i32.ge_u (local.get $i) (local.get $count)))

        ;; Skip key
        (local.set $pos (call $msgpack_skip_value (local.get $pos) (local.get $end_addr)))

        ;; pos now points to value
        (local.set $val_addr (local.get $pos))
        (local.set $val_type (call $msgpack_peek_type (local.get $val_addr) (local.get $end_addr)))

        ;; Destination in array
        (local.set $dest (i32.add
          (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
          (i32.mul (local.get $i) (global.get $VALUE_SIZE))))

        ;; Check if primitive or container
        (if (call $msgpack_is_direct_type (local.get $val_type))
          (then
            ;; Primitive - read and copy from pending stack. -1 =
            ;; nothing pushed (pressure or malformed) — bail rather
            ;; than pop garbage.
            (if (i32.eq (call $msgpack_read_primitive (local.get $val_addr) (local.get $end_addr))
                        (i32.const -1))
              (then
                (if (i32.eqz (global.get $memory_pressure_signaled))
                  (then (call $set_error (global.get $ERR_MSGPACK_INVALID) (i32.const 0))))
                (return (i32.const 0))
              )
            )
            (local.set $value_pointer (call $pending_pop))
            (i32.store (call $abs (local.get $dest))
              (i32.load (call $abs (local.get $value_pointer))))
            (i32.store (call $abs (i32.add (local.get $dest) (i32.const 4)))
              (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 4)))))
            (i32.store (call $abs (i32.add (local.get $dest) (i32.const 8)))
              (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 8)))))
            (i32.store (call $abs (i32.add (local.get $dest) (i32.const 12)))
              (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 12)))))
          )
          (else
            ;; Container - write TYPE_MSGPACK_REF (Layout A)
            (i32.store (call $abs (local.get $dest)) (global.get $TYPE_MSGPACK_REF))
            (i32.store (call $abs (i32.add (local.get $dest) (i32.const 4))) (i32.const 0))
            (i32.store (call $abs (i32.add (local.get $dest) (i32.const 8))) (local.get $parent_data_ptr))
            (i32.store (call $abs (i32.add (local.get $dest) (i32.const 12)))
              (call $msgpack_ref_offset_of (local.get $val_addr) (local.get $parent_data_ptr)))
          )
        )

        ;; Skip value
        (local.set $pos (call $msgpack_skip_value (local.get $pos) (local.get $end_addr)))

        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $iter)
      )
    )

    (local.get $array_pointer)
  )

  ;; ==========================================================================
  ;; msgpack_map_entries
  ;;
  ;; Returns heap array of [key, value] pairs from a msgpack map.
  ;; Returns 0 on error.
  ;; $parent_data_ptr is the segment-relative DATA pointer of the
  ;; OBJ.ARRAYBUFFER owning the msgpack bytes — needed to construct
  ;; sub-region MSGPACK_REF values for container map values.
  ;; ==========================================================================
  (func $msgpack_map_entries (param $addr i32) (param $end_addr i32) (param $parent_data_ptr i32) (result i32)
    (local $type i32)
    (local $header_size i32)
    (local $count i32)
    (local $array_pointer i32)
    (local $data_pointer i32)
    (local $data_size i32)
    (local $heap_pointer i32)
    (local $pos i32)
    (local $i i32)
    (local $key_type i32)
    (local $key_header_size i32)
    (local $key_data_size i32)
    (local $key_offset i32)
    (local $val_addr i32)
    (local $val_type i32)
    (local $value_pointer i32)
    (local $pair_pointer i32)
    (local $pair_data i32)
    (local $pair_size i32)
    (local $dest i32)
    (local $element_pointer i32)

    ;; Peek type - must be map
    (local.set $type (call $msgpack_peek_type (local.get $addr) (local.get $end_addr)))
    (if (i32.ne (local.get $type) (global.get $MSGPACK_MAP))
      (then
        (return (i32.const 0))
      )
    )

    (local.set $header_size (call $msgpack_scratch_header_size))
    (local.set $count (call $msgpack_scratch_count))

    ;; Bounds check BEFORE the first store — write_array_header is a
    ;; pure writer. One upfront check covering the outer array PLUS the
    ;; per-entry [key, value] pair arrays carved in the loop below
    ;; and must be included in the pressure budget.
    (if (call $check_heap_overflow
          (i32.add
            (call $estimate_array_size (local.get $count))
            (i32.mul (local.get $count) (call $estimate_array_size (i32.const 2)))))
      (then (return (i32.const 0))))

    ;; Allocate outer array
    (local.set $heap_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))
    (local.set $array_pointer (local.get $heap_pointer))

    (local.set $data_size (i32.add (global.get $GC_HEADER_SIZE)
                                   (i32.mul (local.get $count) (global.get $VALUE_SIZE))))
    (local.set $data_pointer (call $write_array_header
      (local.get $array_pointer) (local.get $count) (local.get $count) (local.get $data_size)))

    (local.set $heap_pointer (i32.add (local.get $data_pointer) (local.get $data_size)))
    (call $write_state (global.get $STATE_HEAP_POINTER) (local.get $heap_pointer))

    ;; Iterate map entries
    (local.set $pos (i32.add (local.get $addr) (local.get $header_size)))
    (local.set $i (i32.const 0))
    (block $done
      (loop $iter
        (br_if $done (i32.ge_u (local.get $i) (local.get $count)))

        ;; Peek key type - must be string
        (local.set $key_type (call $msgpack_peek_type (local.get $pos) (local.get $end_addr)))
        (if (i32.ne (local.get $key_type) (global.get $MSGPACK_STRING))
          (then
            (call $set_error (global.get $ERR_TYPE_ERROR) (local.get $key_type))
            (return (i32.const 0))
          )
        )

        (local.set $key_header_size (call $msgpack_scratch_header_size))
        (local.set $key_data_size (call $msgpack_scratch_data_size))

        ;; Intern the key
        (local.set $key_offset (call $msgpack_intern_string
          (i32.add (local.get $pos) (local.get $key_header_size))
          (local.get $key_data_size)))

        ;; Skip key
        (local.set $pos (call $msgpack_skip_value (local.get $pos) (local.get $end_addr)))

        ;; pos now points to value
        (local.set $val_addr (local.get $pos))
        (local.set $val_type (call $msgpack_peek_type (local.get $val_addr) (local.get $end_addr)))

        ;; Allocate [key, value] pair array (2 elements). Pre-budgeted
        ;; by the upfront bounds check above (count × pair size).
        (local.set $heap_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))
        (local.set $pair_pointer (local.get $heap_pointer))

        (local.set $pair_size (i32.add (global.get $GC_HEADER_SIZE)
                                       (i32.mul (i32.const 2) (global.get $VALUE_SIZE))))
        (local.set $pair_data (call $write_array_header
          (local.get $pair_pointer) (i32.const 2) (i32.const 2) (local.get $pair_size)))

        (call $write_state (global.get $STATE_HEAP_POINTER)
          (i32.add (local.get $pair_data) (local.get $pair_size)))

        ;; Write key at index 0
        (local.set $element_pointer (i32.add (local.get $pair_data) (global.get $GC_HEADER_SIZE)))
        (i32.store (call $abs (local.get $element_pointer)) (global.get $TYPE_STRING))
        (i32.store (call $abs (i32.add (local.get $element_pointer) (i32.const 4))) (i32.const 0))
        (i32.store (call $abs (i32.add (local.get $element_pointer) (i32.const 8))) (local.get $key_offset))
        (i32.store (call $abs (i32.add (local.get $element_pointer) (i32.const 12))) (i32.const 0))

        ;; Write value at index 1
        (local.set $element_pointer (i32.add (local.get $element_pointer) (global.get $VALUE_SIZE)))
        (if (call $msgpack_is_direct_type (local.get $val_type))
          (then
            ;; Primitive. -1 = nothing pushed (pressure or malformed) —
            ;; bail rather than pop garbage.
            (if (i32.eq (call $msgpack_read_primitive (local.get $val_addr) (local.get $end_addr))
                        (i32.const -1))
              (then
                (if (i32.eqz (global.get $memory_pressure_signaled))
                  (then (call $set_error (global.get $ERR_MSGPACK_INVALID) (i32.const 0))))
                (return (i32.const 0))
              )
            )
            (local.set $value_pointer (call $pending_pop))
            (i32.store (call $abs (local.get $element_pointer))
              (i32.load (call $abs (local.get $value_pointer))))
            (i32.store (call $abs (i32.add (local.get $element_pointer) (i32.const 4)))
              (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 4)))))
            (i32.store (call $abs (i32.add (local.get $element_pointer) (i32.const 8)))
              (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 8)))))
            (i32.store (call $abs (i32.add (local.get $element_pointer) (i32.const 12)))
              (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 12)))))
          )
          (else
            ;; Container — write TYPE_MSGPACK_REF (Layout A)
            (i32.store (call $abs (local.get $element_pointer)) (global.get $TYPE_MSGPACK_REF))
            (i32.store (call $abs (i32.add (local.get $element_pointer) (i32.const 4))) (i32.const 0))
            (i32.store (call $abs (i32.add (local.get $element_pointer) (i32.const 8))) (local.get $parent_data_ptr))
            (i32.store (call $abs (i32.add (local.get $element_pointer) (i32.const 12)))
              (call $msgpack_ref_offset_of (local.get $val_addr) (local.get $parent_data_ptr)))
          )
        )

        ;; Store pair reference in outer array
        (local.set $dest (i32.add
          (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
          (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
        (i32.store (call $abs (local.get $dest)) (global.get $TYPE_ARRAY))
        (i32.store (call $abs (i32.add (local.get $dest) (i32.const 4))) (i32.const 0))
        (i32.store (call $abs (i32.add (local.get $dest) (i32.const 8))) (local.get $pair_pointer))
        (i32.store (call $abs (i32.add (local.get $dest) (i32.const 12))) (i32.const 0))

        ;; Skip value
        (local.set $pos (call $msgpack_skip_value (local.get $pos) (local.get $end_addr)))

        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $iter)
      )
    )

    (local.get $array_pointer)
  )

  ;; ==========================================================================
  ;; msgpack_assign_to_object
  ;;
  ;; Copies a msgpack container's contents to a target heap object: a
  ;; map contributes its key-value pairs; an array contributes its
  ;; elements under decimal string keys ("0", "1", …) — the same shape
  ;; JS object spread gives an array source. Returns 0 on success
  ;; (including the not-a-container and bad-key early outs, which
  ;; assign nothing further — pre-existing behavior), or 1 if an
  ;; allocation was refused under memory pressure (flag set): the
  ;; target's entries block grows blindly inside object_set_property,
  ;; so each entry is pre-checked here, and the array path's decimal
  ;; keys intern via $f64_to_string, which self-signals on string-table
  ;; overflow. A pressure return may leave EARLIER entries already
  ;; assigned — safe, because the post-GC retry re-runs the whole
  ;; assign and object_set_property updates existing keys in place.
  ;; ==========================================================================
  (func $msgpack_assign_to_object (param $object_pointer i32) (param $addr i32) (param $end_addr i32) (param $parent_data_ptr i32) (result i32)
    (local $type i32)
    (local $header_size i32)
    (local $count i32)
    (local $pos i32)
    (local $i i32)
    (local $key_type i32)
    (local $key_header_size i32)
    (local $key_data_size i32)
    (local $key_offset i32)
    (local $val_addr i32)
    (local $val_type i32)
    (local $value_pointer i32)
    (local $val_flags i32)
    (local $val_lo i32)
    (local $val_hi i32)

    (local.set $type (call $msgpack_peek_type (local.get $addr) (local.get $end_addr)))

    ;; Array source: elements land under decimal string keys.
    (if (i32.eq (local.get $type) (global.get $MSGPACK_ARRAY))
      (then
        (local.set $header_size (call $msgpack_scratch_header_size))
        (local.set $count (call $msgpack_scratch_count))
        (local.set $pos (i32.add (local.get $addr) (local.get $header_size)))
        (local.set $i (i32.const 0))
        (block $arr_done
          (loop $arr_iter
            (br_if $arr_done (i32.ge_u (local.get $i) (local.get $count)))

            ;; Decimal index key. $f64_to_string interns and self-signals
            ;; pressure (sentinel id 0) on string-table overflow.
            (local.set $key_offset (call $f64_to_string (f64.convert_i32_u (local.get $i))))
            (if (global.get $memory_pressure_signaled)
              (then (return (i32.const 1))))

            (local.set $val_addr (local.get $pos))
            (local.set $val_type (call $msgpack_peek_type (local.get $val_addr) (local.get $end_addr)))

            ;; Read value (same primitive/container split as the map path).
            (if (call $msgpack_is_direct_type (local.get $val_type))
              (then
                ;; -1 = nothing pushed: pressure (return 1, the caller
                ;; yields and retries) or malformed (name it, return 0).
                (if (i32.eq (call $msgpack_read_primitive (local.get $val_addr) (local.get $end_addr))
                            (i32.const -1))
                  (then
                    (if (global.get $memory_pressure_signaled)
                      (then (return (i32.const 1))))
                    (call $set_error (global.get $ERR_MSGPACK_INVALID) (i32.const 0))
                    (return (i32.const 0))
                  )
                )
                (local.set $value_pointer (call $pending_pop))
                (local.set $val_type (i32.load (call $abs (local.get $value_pointer))))
                (local.set $val_flags (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 4)))))
                (local.set $val_lo (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 8)))))
                (local.set $val_hi (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 12)))))
              )
              (else
                ;; Container - create TYPE_MSGPACK_REF (Layout A: segment-relative)
                (local.set $val_type (global.get $TYPE_MSGPACK_REF))
                (local.set $val_flags (i32.const 0))
                (local.set $val_lo (local.get $parent_data_ptr))
                (local.set $val_hi
                  (call $msgpack_ref_offset_of (local.get $val_addr) (local.get $parent_data_ptr)))
              )
            )

            ;; Set property on target object — grow pre-budgeted just
            ;; above, so the status is droppable.
            (if (call $check_heap_overflow (call $estimate_object_grow_size
                  (i32.load (call $abs (i32.add (local.get $object_pointer) (i32.const 16))))))
              (then (return (i32.const 1))))
            (drop (call $object_set_property
              (local.get $object_pointer)
              (local.get $key_offset)
              (local.get $val_type)
              (local.get $val_flags)
              (local.get $val_lo)
              (local.get $val_hi)))

            (local.set $pos (call $msgpack_skip_value (local.get $pos) (local.get $end_addr)))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $arr_iter)
          )
        )
        (return (i32.const 0))
      )
    )

    ;; Map source below; anything else contributes nothing.
    (if (i32.ne (local.get $type) (global.get $MSGPACK_MAP))
      (then (return (i32.const 0)))
    )

    (local.set $header_size (call $msgpack_scratch_header_size))
    (local.set $count (call $msgpack_scratch_count))

    ;; Iterate map entries
    (local.set $pos (i32.add (local.get $addr) (local.get $header_size)))
    (local.set $i (i32.const 0))
    (block $done
      (loop $iter
        (br_if $done (i32.ge_u (local.get $i) (local.get $count)))

        ;; Peek key type - must be string
        (local.set $key_type (call $msgpack_peek_type (local.get $pos) (local.get $end_addr)))
        (if (i32.ne (local.get $key_type) (global.get $MSGPACK_STRING))
          (then (return (i32.const 0)))
        )

        (local.set $key_header_size (call $msgpack_scratch_header_size))
        (local.set $key_data_size (call $msgpack_scratch_data_size))

        ;; Intern the key
        (local.set $key_offset (call $msgpack_intern_string
          (i32.add (local.get $pos) (local.get $key_header_size))
          (local.get $key_data_size)))

        ;; Skip key
        (local.set $pos (call $msgpack_skip_value (local.get $pos) (local.get $end_addr)))

        ;; pos now points to value
        (local.set $val_addr (local.get $pos))
        (local.set $val_type (call $msgpack_peek_type (local.get $val_addr) (local.get $end_addr)))

        ;; Read value
        (if (call $msgpack_is_direct_type (local.get $val_type))
          (then
            ;; Primitive - read from pending stack. -1 = nothing pushed:
            ;; pressure (return 1, caller yields) or malformed (name it).
            (if (i32.eq (call $msgpack_read_primitive (local.get $val_addr) (local.get $end_addr))
                        (i32.const -1))
              (then
                (if (global.get $memory_pressure_signaled)
                  (then (return (i32.const 1))))
                (call $set_error (global.get $ERR_MSGPACK_INVALID) (i32.const 0))
                (return (i32.const 0))
              )
            )
            (local.set $value_pointer (call $pending_pop))
            (local.set $val_type (i32.load (call $abs (local.get $value_pointer))))
            (local.set $val_flags (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 4)))))
            (local.set $val_lo (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 8)))))
            (local.set $val_hi (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 12)))))
          )
          (else
            ;; Container - create TYPE_MSGPACK_REF (Layout A: segment-relative)
            (local.set $val_type (global.get $TYPE_MSGPACK_REF))
            (local.set $val_flags (i32.const 0))
            (local.set $val_lo (local.get $parent_data_ptr))
            (local.set $val_hi
              (call $msgpack_ref_offset_of (local.get $val_addr) (local.get $parent_data_ptr)))
          )
        )

        ;; Set property on target object — grow pre-budgeted just
        ;; above, so the status is droppable.
        (if (call $check_heap_overflow (call $estimate_object_grow_size
              (i32.load (call $abs (i32.add (local.get $object_pointer) (i32.const 16))))))
          (then (return (i32.const 1))))
        (drop (call $object_set_property
          (local.get $object_pointer)
          (local.get $key_offset)
          (local.get $val_type)
          (local.get $val_flags)
          (local.get $val_lo)
          (local.get $val_hi)))

        ;; Skip value
        (local.set $pos (call $msgpack_skip_value (local.get $pos) (local.get $end_addr)))

        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $iter)
      )
    )
    (i32.const 0)
  )

  ;; ==========================================================================
  ;; Helper: set error and status
  ;; ==========================================================================
  (func $set_error (param $code i32) (param $detail i32)
    (local $stack_pointer i32)
    (local $frame_pointer i32)
    (local $async_promise i32)
    (call $stamp_error_info
      (local.get $code) (local.get $detail) (global.get $current_executing_pc))
    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
    ;; If the current slot is an async body, set EXIT_ASYNC_REJECTED
    ;; so the promise rejects instead of leaking as pending.
    (local.set $stack_pointer (call $read_ctx (global.get $CTX_CALL_STACK_POINTER)))
    (if (i32.gt_u (local.get $stack_pointer)
                  (call $call_stack_base_seg))
      (then
        (local.set $frame_pointer (call $abs
          (call $call_stack_base_seg)))
        (local.set $async_promise (i32.load (i32.add (local.get $frame_pointer) (global.get $FRAME_ASYNC_PROMISE))))
        (if (i32.ne (local.get $async_promise) (i32.const 0))
          (then
            (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_ASYNC_REJECTED))
            (return)))))
    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_ERROR))
  )

  ;; ==========================================================================
  ;; Helper: throw error with given prototype (catchable runtime error)
  ;; Creates an error object and does full exception handling.
  ;; Returns: 0 = handler found (caller should reload instruction index and continue)
  ;;          1 = no handler (caller should exit)
  ;; ==========================================================================
  (func $throw_error_with_prototype
    (param $prototype i32)
    (param $error_code i32)
    (param $error_detail i32)
    (param $error_instruction_index i32)
    (result i32)
    (local $heap_pointer i32)
    (local $object_pointer i32)
    (local $entries_pointer i32)
    (local $stack_pointer i32)
    (local $frame_pointer i32)
    (local $async_promise i32)

    ;; If the heap can't fit an error object, skip allocation and jump
    ;; straight to the no-handler path (which does the async check).
    (if (call $check_heap_overflow (call $estimate_error_object_size))
      (then
        (local.set $stack_pointer (call $read_ctx (global.get $CTX_CALL_STACK_POINTER)))
        (if (i32.gt_u (local.get $stack_pointer)
                      (call $call_stack_base_seg))
          (then
            (local.set $frame_pointer (call $abs
              (call $call_stack_base_seg)))
            (local.set $async_promise (i32.load (i32.add (local.get $frame_pointer) (global.get $FRAME_ASYNC_PROMISE))))
            (if (i32.ne (local.get $async_promise) (i32.const 0))
              (then
                (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_ASYNC_REJECTED))
                (return (i32.const 1))))))
        (call $set_error (global.get $ERR_OUT_OF_MEMORY) (i32.const 0))
        (return (i32.const 1))))

    ;; Clear the flag so callers can detect whether we searched
    (global.set $throw_already_searched (i32.const 0))

    ;; Allocate error object: header + entries for 1 property (message)
    (local.set $heap_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))
    (local.set $object_pointer (local.get $heap_pointer))

    ;; Object header: 32 bytes [GC:8][prototype:4][count:4][capacity:4][flags:4][entries:4][sym_entries:4]
    (i32.store (call $abs (local.get $object_pointer))
      (i32.or (global.get $OBJECT_HEADER_SIZE) (i32.shl (global.get $OBJ_OBJECT) (i32.const 24))))
    (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 4))) (i32.const 0))

    ;; Entries block: 8 + 2 * ENTRY_SIZE = 48 bytes (capacity 2)
    (local.set $entries_pointer (i32.add (local.get $object_pointer) (global.get $OBJECT_HEADER_SIZE)))
    (i32.store (call $abs (local.get $entries_pointer))
      (i32.or (i32.const 48) (i32.shl (global.get $OBJ_OBJECT_DATA) (i32.const 24))))
    (i32.store (call $abs (i32.add (local.get $entries_pointer) (i32.const 4))) (i32.const 0))

    ;; Object fields: prototype, count=0, capacity=2, flags=0, entries_pointer, sym_entries=0
    (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 8))) (local.get $prototype))
    (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 12))) (i32.const 0))
    (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 16))) (i32.const 2))
    (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 20))) (i32.const 0))
    (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 24))) (local.get $entries_pointer))
    (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 28))) (i32.const 0))

    ;; Update heap pointer
    (call $write_state (global.get $STATE_HEAP_POINTER)
      (i32.add (local.get $entries_pointer) (i32.const 48)))

    ;; Set message property to empty string (fresh object, count 0 <
    ;; capacity 2 — grow unreachable, status droppable)
    (drop (call $object_set_property
      (local.get $object_pointer)
      (call $read_builtin (global.get $BUILTIN_MESSAGE))
      (global.get $TYPE_STRING)
      (i32.const 0)
      (call $read_builtin (global.get $BUILTIN_LIT_EMPTY_STRING))
      (i32.const 0)))

    ;; Save error to completion value slot
    (call $pending_push (global.get $TYPE_OBJECT) (i32.const 0) (local.get $object_pointer) (i32.const 0))
    (call $save_completion_value)
    (drop (call $pending_pop))

    ;; Set completion type to throw
    (call $write_ctx (global.get $CTX_COMPLETION_TYPE) (global.get $COMPLETION_THROW))

    ;; Unified v11 handler walk (keep+disarm semantics). On no-handler,
    ;; flag that the try stack was already searched — native-method
    ;; dispatch sites consume the flag to exit without re-searching.
    (if (call $throw_dispatch
          (local.get $error_code)
          (local.get $error_detail)
          (local.get $error_instruction_index))
      (then
        (global.set $throw_already_searched (i32.const 1))
        (return (i32.const 1))))
    (i32.const 0)
  )

  ;; Convenience wrappers for specific error types
  (func $throw_type_error (result i32)
    (call $throw_error_with_prototype
      (call $read_state (global.get $STATE_TYPE_ERROR_PROTOTYPE))
      (i32.const 0) (i32.const 0) (i32.const 0))
  )

  (func $throw_reference_error (result i32)
    (call $throw_error_with_prototype
      (call $read_state (global.get $STATE_REFERENCE_ERROR_PROTOTYPE))
      (i32.const 0) (i32.const 0) (i32.const 0))
  )

  (func $throw_range_error (result i32)
    (call $throw_error_with_prototype
      (call $read_state (global.get $STATE_RANGE_ERROR_PROTOTYPE))
      (i32.const 0) (i32.const 0) (i32.const 0))
  )

  (func $throw_syntax_error (result i32)
    (call $throw_error_with_prototype
      (call $read_state (global.get $STATE_SYNTAX_ERROR_PROTOTYPE))
      (global.get $ERR_SYNTAX_ERROR) (i32.const 0) (i32.const 0))
  )

  ;; Map error code to the appropriate Error prototype pointer.
  ;; TypeError covers most codes; ReferenceError, RangeError, and
  ;; generic Error cover the rest.
  (func $error_code_to_prototype (param $code i32) (result i32)
    (if (i32.or
          (i32.eq (local.get $code) (global.get $ERR_UNDEFINED_VARIABLE))
          (i32.eq (local.get $code) (global.get $ERR_ASSIGN_UNDEFINED)))
      (then (return (call $read_state (global.get $STATE_REFERENCE_ERROR_PROTOTYPE)))))
    (if (i32.eq (local.get $code) (global.get $ERR_SYNTAX_ERROR))
      (then (return (call $read_state (global.get $STATE_SYNTAX_ERROR_PROTOTYPE)))))
    (if (i32.or (i32.or
          (i32.eq (local.get $code) (global.get $ERR_STACK_OVERFLOW))
          (i32.eq (local.get $code) (global.get $ERR_RANGE_ERROR)))
          (i32.eq (local.get $code) (global.get $ERR_OUT_OF_MEMORY)))
      (then (return (call $read_state (global.get $STATE_RANGE_ERROR_PROTOTYPE)))))
    (call $read_state (global.get $STATE_TYPE_ERROR_PROTOTYPE))
  )

  ;; Raise a catchable error: set the error info, then route through the
  ;; full throw machinery (try-stack search, async rejection).
  ;; Returns 0 if a handler caught it (caller should reload PC and loop),
  ;;         1 if uncaught (caller should br $exit).
  (func $stamp_error_info
    (param $code i32)
    (param $detail i32)
    (param $instruction_index i32)
    (i32.store (call $abs (global.get $error_info_base)) (local.get $code))
    (i32.store (call $abs (i32.add (global.get $error_info_base) (i32.const 4))) (local.get $detail))
    (i32.store (call $abs (i32.add (global.get $error_info_base) (i32.const 8))) (local.get $instruction_index))
  )

  ;; The only readers of the error-info region ($stamp_error_info is
  ;; the only writer) — build-enforced, see
  ;; tools/verify-region-write-discipline.js.
  (func $error_info_code (result i32)
    (i32.load (call $abs (global.get $error_info_base)))
  )

  (func $error_info_detail (result i32)
    (i32.load (call $abs (i32.add (global.get $error_info_base) (i32.const 4))))
  )

  (func $error_info_instruction_index (result i32)
    (i32.load (call $abs (i32.add (global.get $error_info_base) (i32.const 8))))
  )

  (func $raise_error (param $code i32) (param $detail i32) (result i32)
    (local $result i32)
    (call $set_error (local.get $code) (local.get $detail))
    (local.set $result
      (call $throw_error_with_prototype
        (call $error_code_to_prototype (local.get $code))
        (local.get $code)
        (local.get $detail)
        (global.get $current_executing_pc)))
    (if (local.get $result)
      (then
        (call $stamp_error_info
          (local.get $code) (local.get $detail) (global.get $current_executing_pc)))
      (else
        (call $write_ctx (global.get $CTX_EXIT_CONDITION) (i32.const 0))))
    (local.get $result)
  )

  ;; Vat-fault raise: the execution substrate itself is broken (unknown
  ;; opcode, corrupt operand, heap/code collision). NOT routed through
  ;; the catchable-throw machinery — sandboxed code can neither cause
  ;; nor repair substrate corruption, so guest catch/finally must not
  ;; observe, swallow, or relabel these (a finally rethrow re-labels
  ;; engine errors as USER_THROW, which would blind host-side fault
  ;; classification). Exits the drive with EXIT_ERROR unconditionally —
  ;; including for async bodies: a substrate fault is not a value to
  ;; inject into the guest's promise graph. Callers br $exit
  ;; immediately after.
  (func $fault_error (param $code i32) (param $detail i32) (param $pc i32)
    (call $stamp_error_info (local.get $code) (local.get $detail) (local.get $pc))
    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_ERROR))
  )

  ;; Route an already-set error through the throw machinery.
  ;; Called when a subroutine already called $set_error and the main
  ;; loop needs to make it catchable / async-aware.
  ;; Returns 0 (caught) or 1 (uncaught), same as $raise_error.
  (func $throw_from_set_error (result i32)
    (local $code i32)
    (local $detail i32)
    (local $result i32)
    (local $instruction_index i32)
    (local.set $code (call $error_info_code))
    (local.set $detail (call $error_info_detail))
    (local.set $instruction_index (call $error_info_instruction_index))
    (local.set $result
      (call $throw_error_with_prototype
        (call $error_code_to_prototype (local.get $code))
        (local.get $code)
        (local.get $detail)
        (local.get $instruction_index)))
    (if (local.get $result)
      (then
        (call $stamp_error_info
          (local.get $code) (local.get $detail) (local.get $instruction_index)))
      (else
        (call $write_ctx (global.get $CTX_EXIT_CONDITION) (i32.const 0))))
    (local.get $result)
  )

  ;; estimate_error_object_size() → bytes
  ;; Worst-case heap consumption of $allocate_error_object:
  ;;   32 (object header, OBJECT_HEADER_SIZE) + 176 (entries block)
  ;; The entries block is sized at capacity 8 so that EVERY error-object
  ;; writer (the largest, $throw_call_not_function_diagnostic, sets
  ;; message + 6 forensic properties = 7) stays inside capacity — the
  ;; $object_set_property grow branch is unreachable on error objects
  ;; and their set-property statuses are droppable. Opcode handlers
  ;; that call this should pre-check this size, not a smaller one.
  (func $estimate_error_object_size (result i32)
    (i32.const 208)
  )

  ;; ==========================================================================
  ;; Allocate error object with message (does NOT do try-stack walk)
  ;; Returns the object pointer for further property setting
  ;; ==========================================================================
  (func $allocate_error_object (param $prototype i32) (param $message_builtin i32) (result i32)
    (local $heap_pointer i32)
    (local $object_pointer i32)
    (local $entries_pointer i32)

    (local.set $heap_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))
    (local.set $object_pointer (local.get $heap_pointer))

    ;; Object header: 32 bytes
    (i32.store (call $abs (local.get $object_pointer))
      (i32.or (global.get $OBJECT_HEADER_SIZE) (i32.shl (global.get $OBJ_OBJECT) (i32.const 24))))
    (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 4))) (i32.const 0))

    ;; Entries block: 8 + 8 * ENTRY_SIZE = 168, padded to 176 (16-grid).
    ;; Capacity 8 keeps every error-object writer (largest: the
    ;; call-not-function diagnostic's message + 6 forensic props)
    ;; inside capacity — the set-property grow branch is unreachable.
    (local.set $entries_pointer (i32.add (local.get $object_pointer) (global.get $OBJECT_HEADER_SIZE)))
    (i32.store (call $abs (local.get $entries_pointer))
      (i32.or (i32.const 176) (i32.shl (global.get $OBJ_OBJECT_DATA) (i32.const 24))))
    (i32.store (call $abs (i32.add (local.get $entries_pointer) (i32.const 4))) (i32.const 0))

    ;; Object fields: prototype, count=0, capacity=8, flags=0, entries_pointer, sym_entries=0
    (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 8))) (local.get $prototype))
    (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 12))) (i32.const 0))
    (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 16))) (i32.const 8))
    (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 20))) (i32.const 0))
    (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 24))) (local.get $entries_pointer))
    (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 28))) (i32.const 0))

    ;; Update heap pointer (32 header + 176 entries)
    (call $write_state (global.get $STATE_HEAP_POINTER)
      (i32.add (local.get $entries_pointer) (i32.const 176)))

    ;; Set message property (count 0 < capacity 8 — status droppable)
    (drop (call $object_set_property
      (local.get $object_pointer)
      (call $read_builtin (global.get $BUILTIN_MESSAGE))
      (global.get $TYPE_STRING)
      (i32.const 0)
      (call $read_builtin (local.get $message_builtin))
      (i32.const 0)))

    (local.get $object_pointer)
  )

  ;; ==========================================================================
  ;; Throw a pre-allocated error object (does the try-stack walk)
  ;; ==========================================================================
  (func $throw_allocated_error (param $object_pointer i32) (result i32)
    ;; Save error to completion value slot
    (call $pending_push (global.get $TYPE_OBJECT) (i32.const 0) (local.get $object_pointer) (i32.const 0))
    (call $save_completion_value)
    (drop (call $pending_pop))

    ;; Set completion type to throw
    (call $write_ctx (global.get $CTX_COMPLETION_TYPE) (global.get $COMPLETION_THROW))

    ;; Unified v11 handler walk (keep+disarm semantics). On no-handler,
    ;; flag that the try stack was already searched — native-method
    ;; dispatch sites consume the flag to exit without re-searching.
    (if (call $throw_dispatch (i32.const 0) (i32.const 0) (i32.const 0))
      (then
        (global.set $throw_already_searched (i32.const 1))
        (return (i32.const 1))))
    (i32.const 0)
  )

  ;; ==========================================================================
  ;; Context-carrying throw helpers
  ;; ==========================================================================

  ;; RangeError with offset/bufferLength/elementSize properties
  (func $throw_range_error_with_context
    (param $message_builtin i32) (param $offset i32) (param $buffer_length i32) (param $element_size i32)
    (result i32)
    (local $obj i32)
    (local.set $obj (call $allocate_error_object
      (call $read_state (global.get $STATE_RANGE_ERROR_PROTOTYPE))
      (local.get $message_builtin)))
    ;; Context properties land in the error object's capacity-8 entries
    ;; block — grow unreachable, statuses droppable.
    (drop (call $object_set_property (local.get $obj)
      (call $read_builtin (global.get $BUILTIN_PROP_OFFSET))
      (global.get $TYPE_INTEGER) (i32.const 0) (local.get $offset) (i32.const 0)))
    (drop (call $object_set_property (local.get $obj)
      (call $read_builtin (global.get $BUILTIN_PROP_BUFFER_LENGTH))
      (global.get $TYPE_INTEGER) (i32.const 0) (local.get $buffer_length) (i32.const 0)))
    (drop (call $object_set_property (local.get $obj)
      (call $read_builtin (global.get $BUILTIN_PROP_ELEMENT_SIZE))
      (global.get $TYPE_INTEGER) (i32.const 0) (local.get $element_size) (i32.const 0)))
    (call $throw_allocated_error (local.get $obj))
  )

  ;; TypeError with just a builtin message (no context properties).
  (func $throw_type_error_with_message (param $message_builtin i32) (result i32)
    (call $throw_allocated_error
      (call $allocate_error_object
        (call $read_state (global.get $STATE_TYPE_ERROR_PROTOTYPE))
        (local.get $message_builtin)))
  )

  ;; RangeError with just a builtin message (no context properties).
  (func $throw_range_error_with_message (param $message_builtin i32) (result i32)
    (call $throw_allocated_error
      (call $allocate_error_object
        (call $read_state (global.get $STATE_RANGE_ERROR_PROTOTYPE))
        (local.get $message_builtin)))
  )

  ;; TypeError with type property
  (func $throw_type_error_with_type (param $message_builtin i32) (param $type_tag i32) (result i32)
    (call $throw_type_error_with_type_and_value
      (local.get $message_builtin) (local.get $type_tag) (i32.const 0))
  )

  ;; Variant that also records the offending value's data_lo as `valueLo`
  ;; (0 = not recorded). Lets an uncaught "Not a function (received array)"
  ;; name WHICH object sat in the callee slot — the corpse's address for a
  ;; post-mortem heap walk.
  (func $throw_type_error_with_type_and_value
        (param $message_builtin i32) (param $type_tag i32) (param $value_lo i32)
        (result i32)
    (local $obj i32)
    (local.set $obj (call $allocate_error_object
      (call $read_state (global.get $STATE_TYPE_ERROR_PROTOTYPE))
      (local.get $message_builtin)))
    ;; Diagnostic properties land in the capacity-8 entries block —
    ;; grow unreachable, statuses droppable.
    (drop (call $object_set_property (local.get $obj)
      (call $read_builtin (global.get $BUILTIN_PROP_TYPE))
      (global.get $TYPE_INTEGER) (i32.const 0) (local.get $type_tag) (i32.const 0)))
    (if (local.get $value_lo)
      (then
        (drop (call $object_set_property (local.get $obj)
          (call $read_builtin (global.get $BUILTIN_PROP_VALUE_LO))
          (global.get $TYPE_INTEGER) (i32.const 0) (local.get $value_lo) (i32.const 0)))))
    (call $throw_allocated_error (local.get $obj))
  )

  ;; OP_CALL's not-a-function diagnostic: full slot forensics. Attaches the
  ;; callee slot's four raw words (type/flags/lo/hi), the slot's segment
  ;; address, and the context's pending base — a catch handler (or the
  ;; uncaught formatter) can reconstruct exactly WHAT sat in the callee
  ;; slot and WHERE the slot was relative to the operand-stack block.
  (func $throw_call_not_function_diagnostic (param $value_pointer i32) (result i32)
    (local $obj i32)
    (local.set $obj (call $allocate_error_object
      (call $read_state (global.get $STATE_TYPE_ERROR_PROTOTYPE))
      (global.get $BUILTIN_MSG_NOT_A_FUNCTION)))
    ;; Six forensic properties + message = 7, inside the capacity-8
    ;; entries block — grow unreachable, statuses droppable.
    (drop (call $object_set_property (local.get $obj)
      (call $read_builtin (global.get $BUILTIN_PROP_TYPE))
      (global.get $TYPE_INTEGER) (i32.const 0)
      (call $value_type (local.get $value_pointer)) (i32.const 0)))
    (drop (call $object_set_property (local.get $obj)
      (call $read_builtin (global.get $BUILTIN_PROP_VALUE_LO))
      (global.get $TYPE_INTEGER) (i32.const 0)
      (call $value_data_lo (local.get $value_pointer)) (i32.const 0)))
    (drop (call $object_set_property (local.get $obj)
      (call $read_builtin (global.get $BUILTIN_PROP_VALUE_FLAGS))
      (global.get $TYPE_INTEGER) (i32.const 0)
      (call $value_flags (local.get $value_pointer)) (i32.const 0)))
    (drop (call $object_set_property (local.get $obj)
      (call $read_builtin (global.get $BUILTIN_PROP_VALUE_HI))
      (global.get $TYPE_INTEGER) (i32.const 0)
      (call $value_data_hi (local.get $value_pointer)) (i32.const 0)))
    (drop (call $object_set_property (local.get $obj)
      (call $read_builtin (global.get $BUILTIN_PROP_VALUE_ADDR))
      (global.get $TYPE_INTEGER) (i32.const 0)
      (local.get $value_pointer) (i32.const 0)))
    (drop (call $object_set_property (local.get $obj)
      (call $read_builtin (global.get $BUILTIN_PROP_STACK_BASE))
      (global.get $TYPE_INTEGER) (i32.const 0)
      (call $read_ctx (global.get $CTX_PENDING_BASE)) (i32.const 0)))
    (call $throw_allocated_error (local.get $obj))
  )

  ;; ReferenceError with name property
  (func $throw_reference_error_with_name (param $message_builtin i32) (param $name_offset i32) (result i32)
    (local $obj i32)
    (local.set $obj (call $allocate_error_object
      (call $read_state (global.get $STATE_REFERENCE_ERROR_PROTOTYPE))
      (local.get $message_builtin)))
    ;; Set identifier property (string) — separate prop to avoid
    ;; overwriting error .name; capacity-8 block, status droppable.
    (drop (call $object_set_property (local.get $obj)
      (call $read_builtin (global.get $BUILTIN_PROP_IDENTIFIER))
      (global.get $TYPE_STRING) (i32.const 0) (local.get $name_offset) (i32.const 0)))
    (call $throw_allocated_error (local.get $obj))
  )

  ;; InvalidCharacterError for btoa/atob. Real JS throws a DOMException
  ;; named "InvalidCharacterError"; sandscript has no DOMException, so the
  ;; closest observable match is a plain-Error-prototype object with an own
  ;; `name` property — instanceof Error true, instanceof TypeError false,
  ;; name === "InvalidCharacterError".
  (func $throw_invalid_character_error (param $message_builtin i32) (result i32)
    (local $obj i32)
    (local.set $obj (call $allocate_error_object
      (call $read_state (global.get $STATE_ERROR_PROTOTYPE))
      (local.get $message_builtin)))
    ;; Own `name` overrides Error.prototype's "Error" (capacity-8
    ;; block, status droppable).
    (drop (call $object_set_property (local.get $obj)
      (call $read_builtin (global.get $BUILTIN_NAME))
      (global.get $TYPE_STRING) (i32.const 0)
      (call $read_builtin (global.get $BUILTIN_LIT_INVALID_CHARACTER_ERROR)) (i32.const 0)))
    (call $throw_allocated_error (local.get $obj))
  )

  ;; ==========================================================================
  ;; Base64 (btoa / atob)
  ;; ==========================================================================

  ;; Map a 6-bit value (0-63) to its base64 alphabet ASCII code.
  (func $base64_char_code (param $value i32) (result i32)
    (if (i32.lt_u (local.get $value) (i32.const 26))
      (then (return (i32.add (i32.const 65) (local.get $value)))))   ;; 'A'..'Z'
    (if (i32.lt_u (local.get $value) (i32.const 52))
      (then (return (i32.add (i32.const 71) (local.get $value)))))   ;; 'a'..'z' (97 - 26)
    (if (i32.lt_u (local.get $value) (i32.const 62))
      (then (return (i32.sub (local.get $value) (i32.const 4)))))    ;; '0'..'9' (48 - 52)
    (if (i32.eq (local.get $value) (i32.const 62))
      (then (return (i32.const 43))))                                ;; '+'
    (i32.const 47)                                                   ;; '/'
  )

  ;; Map an ASCII code to its 6-bit base64 value, or -1 if not in the alphabet.
  (func $base64_char_value (param $char_code i32) (result i32)
    (if (i32.and (i32.ge_u (local.get $char_code) (i32.const 65))
                 (i32.le_u (local.get $char_code) (i32.const 90)))
      (then (return (i32.sub (local.get $char_code) (i32.const 65)))))
    (if (i32.and (i32.ge_u (local.get $char_code) (i32.const 97))
                 (i32.le_u (local.get $char_code) (i32.const 122)))
      (then (return (i32.sub (local.get $char_code) (i32.const 71)))))
    (if (i32.and (i32.ge_u (local.get $char_code) (i32.const 48))
                 (i32.le_u (local.get $char_code) (i32.const 57)))
      (then (return (i32.add (local.get $char_code) (i32.const 4)))))
    (if (i32.eq (local.get $char_code) (i32.const 43))
      (then (return (i32.const 62))))
    (if (i32.eq (local.get $char_code) (i32.const 47))
      (then (return (i32.const 63))))
    (i32.const -1)
  )

  ;; Is this byte ASCII whitespace per the WHATWG forgiving-base64 strip set
  ;; (tab, newline, form feed, carriage return, space)?
  (func $is_base64_whitespace (param $char_code i32) (result i32)
    (i32.or
      (i32.or
        (i32.eq (local.get $char_code) (i32.const 0x09))
        (i32.eq (local.get $char_code) (i32.const 0x0A)))
      (i32.or
        (i32.or
          (i32.eq (local.get $char_code) (i32.const 0x0C))
          (i32.eq (local.get $char_code) (i32.const 0x0D)))
        (i32.eq (local.get $char_code) (i32.const 0x20))))
  )

  ;; ==========================================================================
  ;; Pending stack operations
  ;; ==========================================================================

  ;; Push a 16-byte value to pending stack
  (func $pending_push (param $type i32) (param $flags i32) (param $data_lo i32) (param $data_hi i32)
    (local $pointer i32)
    (local.set $pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))

    ;; Write value: [type:4][flags:4][data_lo:4][data_hi:4]
    (i32.store (call $abs (local.get $pointer)) (local.get $type))
    (i32.store (call $abs (i32.add (local.get $pointer) (i32.const 4))) (local.get $flags))
    (i32.store (call $abs (i32.add (local.get $pointer) (i32.const 8))) (local.get $data_lo))
    (i32.store (call $abs (i32.add (local.get $pointer) (i32.const 12))) (local.get $data_hi))

    ;; Advance pointer
    (call $write_ctx (global.get $CTX_PENDING_POINTER)
      (i32.add (local.get $pointer) (global.get $VALUE_SIZE)))
  )

  ;; Pop and return pointer to the value (doesn't copy, just returns location)
  ;; Pop the top operand. Clamps at the stack base: the pending pointer must
  ;; never drop below its block base. The error-unwind path can over-pop (it
  ;; discards operands a failed opcode already consumed); without this clamp the
  ;; pointer underflows past base, and a later push then writes into the stack
  ;; block's GC header — corrupting the heap the collector walks. On an empty
  ;; stack this returns the base slot and leaves the pointer at base.
  ;;
  ;; LOUDNESS TRIPWIRE: during NORMAL execution (completion type is not
  ;; THROW), a pop at base is a codegen/dispatch/resume bug (the
  ;; deferred-POP class: an orphaned POP silently ate one operand per
  ;; execution for weeks because this clamp was unconditional). Every
  ;; such clamp (1) increments an exported counter and (2) drops a
  ;; step-ring sentinel (pc 0xFDFD) naming the site; under strict mode
  ;; it stamps ERR_STACK_UNDERFLOW with the pc and TRAPS. Strict IS
  ;; the default ($strict_stack_enabled starts 1; SS_STRICT_STACK=0 is
  ;; the opt-out escape hatch) — the async-await resume shape that
  ;; once relied on this clamp's base-slot aliasing was fixed before
  ;; the default flipped; the counter and sentinel remain for the
  ;; opted-out mode. Unwind over-pops (COMPLETION_THROW) keep the
  ;; silent clamp with no counting.
  (func $pending_pop (result i32)
    (local $pointer i32)
    (if (i32.le_u
          (call $read_ctx (global.get $CTX_PENDING_POINTER))
          (call $pending_base_seg))
      (then
        (if (i32.ne (call $read_ctx (global.get $CTX_COMPLETION_TYPE))
                    (global.get $COMPLETION_THROW))
          (then
            (global.set $stack_underflow_count
              (i32.add (global.get $stack_underflow_count) (i32.const 1)))
            (call $step_ring_write (i32.const 0)
              (i32.const 0xFDFD) (i32.const 0xFD))
            (if (global.get $strict_stack_enabled)
              (then
                (call $set_error (global.get $ERR_STACK_UNDERFLOW)
                  (global.get $current_executing_pc))
                (unreachable)))))
        (return (call $pending_base_seg))))
    (local.set $pointer
      (i32.sub
        (call $read_ctx (global.get $CTX_PENDING_POINTER))
        (global.get $VALUE_SIZE)))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $pointer))
    (local.get $pointer)
  )

  ;; Peek top value (return pointer without popping)
  (func $pending_peek (result i32)
    (i32.sub
      (call $read_ctx (global.get $CTX_PENDING_POINTER))
      (global.get $VALUE_SIZE))
  )

  ;; Read type tag from value at pointer
  (func $value_type (param $pointer i32) (result i32)
    (i32.load (call $abs (local.get $pointer)))
  )

  ;; Read data_lo from value at pointer
  (func $value_data_lo (param $pointer i32) (result i32)
    (i32.load (call $abs (i32.add (local.get $pointer) (i32.const 8))))
  )

  ;; Read data_hi from value at pointer
  (func $value_data_hi (param $pointer i32) (result i32)
    (i32.load (call $abs (i32.add (local.get $pointer) (i32.const 12))))
  )

  ;; Write a 16-byte value to a given address
  (func $write_value (param $pointer i32) (param $type i32) (param $flags i32) (param $data_lo i32) (param $data_hi i32)
    (i32.store (call $abs (local.get $pointer)) (local.get $type))
    (i32.store (call $abs (i32.add (local.get $pointer) (i32.const 4))) (local.get $flags))
    (i32.store (call $abs (i32.add (local.get $pointer) (i32.const 8))) (local.get $data_lo))
    (i32.store (call $abs (i32.add (local.get $pointer) (i32.const 12))) (local.get $data_hi))
  )

  ;; Read f64 from value at pointer (combines data_lo and data_hi)
  (func $read_f64 (param $pointer i32) (result f64)
    (local $lo i32)
    (local $hi i32)
    (local.set $lo (call $value_data_lo (local.get $pointer)))
    (local.set $hi (call $value_data_hi (local.get $pointer)))
    (f64.reinterpret_i64
      (i64.or
        (i64.extend_i32_u (local.get $lo))
        (i64.shl (i64.extend_i32_u (local.get $hi)) (i64.const 32))))
  )

  ;; Push f64 to pending stack as TYPE_FLOAT
  (func $push_f64 (param $val f64)
    (local $bits i64)
    (local.set $bits (i64.reinterpret_f64 (local.get $val)))
    (call $pending_push
      (global.get $TYPE_FLOAT)
      (i32.const 0)
      (i32.wrap_i64 (local.get $bits))
      (i32.wrap_i64 (i64.shr_u (local.get $bits) (i64.const 32))))
  )

  ;; estimate_array_size(capacity) → bytes
  ;; Worst-case heap consumption of $allocate_array(capacity):
  ;;   ARRAY_HEADER_SIZE (24) + 8 (data GC header) + capacity * VALUE_SIZE (16)
  (func $estimate_array_size (param $capacity i32) (result i32)
    (i32.add
      (global.get $ARRAY_HEADER_SIZE)
      (i32.add
        (i32.const 8)
        (i32.mul (local.get $capacity) (global.get $VALUE_SIZE))))
  )

  ;; ==========================================================================
  ;; write_array_header
  ;;
  ;; Writes a complete array header at $array_pointer plus the GC header of
  ;; the contiguous data block at $array_pointer + ARRAY_HEADER_SIZE. The
  ;; single chokepoint for array-header initialization: every field —
  ;; including flags and the sym_entries slot — is zeroed here, so no
  ;; allocation site can leave the symbol slot as heap garbage.
  ;; Does NOT touch the heap pointer; callers reserve
  ;; ARRAY_HEADER_SIZE + data_size themselves.
  ;; Returns the data block pointer (= array_pointer + ARRAY_HEADER_SIZE,
  ;; includes the data GC header).
  ;; ==========================================================================
  (func $write_array_header
    (param $array_pointer i32) (param $length i32) (param $capacity i32) (param $data_size i32)
    (result i32)
    (local $data_pointer i32)
    (local.set $data_pointer (i32.add (local.get $array_pointer) (global.get $ARRAY_HEADER_SIZE)))

    ;; GC header: size=$ARRAY_HEADER_SIZE, type=OBJ_ARRAY
    (i32.store (call $abs (local.get $array_pointer))
      (i32.or (global.get $ARRAY_HEADER_SIZE) (i32.shl (global.get $OBJ_ARRAY) (i32.const 24))))
    (i32.store (call $abs (i32.add (local.get $array_pointer) (i32.const 4))) (i32.const 0))

    ;; GC header for the data block
    (i32.store (call $abs (local.get $data_pointer))
      (i32.or (local.get $data_size) (i32.shl (global.get $OBJ_ARRAY_DATA) (i32.const 24))))
    (i32.store (call $abs (i32.add (local.get $data_pointer) (i32.const 4))) (i32.const 0))

    ;; Array fields: length, capacity, data_pointer, flags=0, sym_entries=0
    (i32.store (call $abs (i32.add (local.get $array_pointer) (i32.const 8))) (local.get $length))
    (i32.store (call $abs (i32.add (local.get $array_pointer) (i32.const 12))) (local.get $capacity))
    (i32.store (call $abs (i32.add (local.get $array_pointer) (i32.const 16))) (local.get $data_pointer))
    (i32.store (call $abs (i32.add (local.get $array_pointer) (global.get $ARRAY_FLAGS_OFFSET))) (i32.const 0))
    (i32.store (call $abs (i32.add (local.get $array_pointer) (global.get $ARRAY_SYM_ENTRIES_OFFSET))) (i32.const 0))

    (local.get $data_pointer)
  )

  ;; ==========================================================================
  ;; allocate_array
  ;;
  ;; Allocates a new array with given capacity. Returns pointer to array header.
  ;; Array structure: [GC:8][len:4][cap:4][data_pointer:4][flags:4][sym_entries:4]
  ;; Data structure: [GC header 8][values...]
  ;; ==========================================================================
  (func $allocate_array (param $capacity i32) (result i32)
    (local $array_pointer i32)
    (local $data_size i32)

    (local.set $array_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))
    (local.set $data_size (i32.add (i32.const 8) (i32.mul (local.get $capacity) (global.get $VALUE_SIZE))))

    ;; length = capacity (for map)
    (drop (call $write_array_header
      (local.get $array_pointer) (local.get $capacity) (local.get $capacity) (local.get $data_size)))

    (call $write_state (global.get $STATE_HEAP_POINTER)
      (i32.add
        (i32.add (local.get $array_pointer) (global.get $ARRAY_HEADER_SIZE))
        (local.get $data_size)))

    (local.get $array_pointer)
  )

  ;; estimate_promise_size() → bytes
  ;; Worst-case heap consumption of $allocate_promise: 48 bytes
  ;; (GC header 8 + status 4 + value 16 + waiters 4 + handlers 4, padded).
  (func $estimate_promise_size (result i32)
    (i32.const 48)
  )

  ;; ==========================================================================
  ;; allocate_promise
  ;;
  ;; Allocates a pending promise on the heap. Returns header pointer.
  ;; Promise structure: [GC header 8][status:4][value:16][waiters:4][handlers:4] = 48 bytes
  ;; ==========================================================================
  (func $allocate_promise (result i32)
    (local $heap_pointer i32)
    (local $header_pointer i32)
    (local $data_pointer i32)

    (local.set $heap_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))
    (local.set $header_pointer (local.get $heap_pointer))

    ;; GC header: size = 8 + 40 = 48, type = OBJ_PROMISE
    (i32.store (call $abs (local.get $header_pointer))
      (i32.or (i32.const 48) (i32.shl (global.get $OBJ_PROMISE) (i32.const 24))))
    (i32.store (call $abs (i32.add (local.get $header_pointer) (i32.const 4))) (i32.const 0))

    (local.set $data_pointer (i32.add (local.get $header_pointer) (global.get $GC_HEADER_SIZE)))

    ;; status = PENDING (0)
    (i32.store (call $abs (i32.add (local.get $data_pointer) (global.get $PROMISE_STATUS))) (i32.const 0))
    ;; value = undefined (16 bytes: type=undefined, flags=0, lo=0, hi=0)
    (i32.store (call $abs (i32.add (local.get $data_pointer) (global.get $PROMISE_VALUE))) (global.get $TYPE_UNDEFINED))
    (i32.store (call $abs (i32.add (local.get $data_pointer) (i32.const 8))) (i32.const 0))
    (i32.store (call $abs (i32.add (local.get $data_pointer) (i32.const 12))) (i32.const 0))
    (i32.store (call $abs (i32.add (local.get $data_pointer) (i32.const 16))) (i32.const 0))
    ;; waiters = 0 (empty PromiseWaiter data-pointer list)
    (i32.store (call $abs (i32.add (local.get $data_pointer) (global.get $PROMISE_WAITERS))) (i32.const 0))
    ;; handlers = -1 (empty)
    (i32.store (call $abs (i32.add (local.get $data_pointer) (global.get $PROMISE_HANDLERS))) (i32.const -1))

    ;; Update heap pointer
    (call $write_state (global.get $STATE_HEAP_POINTER)
      (i32.add (local.get $header_pointer) (i32.const 48)))

    (local.get $header_pointer)
  )

  (func $allocate_promise_waiter
    (param $context_slot i32)
    (param $context_generation i32)
    (param $next i32)
    (result i32)
    (local $header_pointer i32)
    (local $data_pointer i32)
    (local.set $header_pointer
      (call $read_state (global.get $STATE_HEAP_POINTER)))
    (i32.store (call $abs (local.get $header_pointer))
      (i32.or
        (global.get $PROMISE_WAITER_TOTAL_SIZE)
        (i32.shl (global.get $OBJ_PROMISE_WAITER) (i32.const 24))))
    (i32.store
      (call $abs (i32.add (local.get $header_pointer) (i32.const 4)))
      (i32.const 0))
    (local.set $data_pointer
      (i32.add (local.get $header_pointer) (global.get $GC_HEADER_SIZE)))
    (i32.store
      (call $abs (i32.add
        (local.get $data_pointer)
        (global.get $PROMISE_WAITER_CONTEXT_SLOT)))
      (local.get $context_slot))
    (i32.store
      (call $abs (i32.add
        (local.get $data_pointer)
        (global.get $PROMISE_WAITER_CONTEXT_GENERATION)))
      (local.get $context_generation))
    (i32.store
      (call $abs (i32.add
        (local.get $data_pointer)
        (global.get $PROMISE_WAITER_NEXT)))
      (local.get $next))
    (call $write_state
      (global.get $STATE_HEAP_POINTER)
      (i32.add
        (local.get $header_pointer)
        (global.get $PROMISE_WAITER_TOTAL_SIZE)))
    (local.get $data_pointer)
  )

  ;; ==========================================================================
  ;; BigInt multi-precision arithmetic
  ;;
  ;; BigInt heap layout: [GC:8][sign:4][length:4][limbs: length*4]
  ;; Limbs are 32-bit unsigned words in little-endian order.
  ;; Sign: 0 = positive/zero, 1 = negative. Zero has length 0.
  ;; ==========================================================================

  ;; Read BigInt sign from header pointer
  (func $bigint_sign (param $header i32) (result i32)
    (i32.load (call $abs (i32.add (local.get $header) (global.get $GC_HEADER_SIZE))))
  )

  ;; Read BigInt length (limb count) from header pointer
  (func $bigint_length (param $header i32) (result i32)
    (i32.load (call $abs (i32.add
      (i32.add (local.get $header) (global.get $GC_HEADER_SIZE))
      (i32.const 4))))
  )

  ;; Read BigInt limb at index from header pointer
  (func $bigint_limb (param $header i32) (param $index i32) (result i32)
    (i32.load (call $abs (i32.add
      (i32.add (local.get $header) (global.get $GC_HEADER_SIZE))
      (i32.add (i32.const 8) (i32.mul (local.get $index) (i32.const 4))))))
  )

  ;; estimate_bigint_size(length) → bytes
  ;; Worst-case heap consumption of $bigint_alloc(sign, length):
  ;;   GC_HEADER_SIZE (8) + 8 (sign + length fields) + length * 4 (limbs),
  ;;   rounded up to 16-byte alignment.
  (func $estimate_bigint_size (param $length i32) (result i32)
    (i32.and
      (i32.add
        (i32.add
          (global.get $GC_HEADER_SIZE)
          (i32.add (i32.const 8) (i32.mul (local.get $length) (i32.const 4))))
        (i32.const 15))
      (i32.const -16))
  )

  ;; Allocate a BigInt with given sign and limb count. Limbs are uninitialized.
  ;; Returns header pointer.
  (func $bigint_alloc (param $sign i32) (param $length i32) (result i32)
    (local $heap_pointer i32)
    (local $header i32)
    (local $data_size i32)
    (local $total_size i32)
    (local $aligned i32)

    (local.set $heap_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))
    (local.set $header (local.get $heap_pointer))
    (local.set $data_size (i32.add (i32.const 8) (i32.mul (local.get $length) (i32.const 4))))
    (local.set $total_size (i32.add (global.get $GC_HEADER_SIZE) (local.get $data_size)))
    (local.set $aligned (i32.and
      (i32.add (local.get $total_size) (i32.const 15))
      (i32.const -16)))

    ;; GC header — store aligned size so heap-walk stride matches allocator stride.
    (i32.store (call $abs (local.get $header))
      (i32.or (local.get $aligned) (i32.shl (global.get $OBJ_BIGINT) (i32.const 24))))
    (i32.store (call $abs (i32.add (local.get $header) (i32.const 4))) (i32.const 0))

    ;; sign and length
    (i32.store (call $abs (i32.add (local.get $header) (global.get $GC_HEADER_SIZE)))
      (local.get $sign))
    (i32.store (call $abs (i32.add
      (i32.add (local.get $header) (global.get $GC_HEADER_SIZE))
      (i32.const 4)))
      (local.get $length))

    ;; Zero the limb data. This is an INVARIANT, not hygiene: fresh
    ;; heap pages are zero, but gc compaction leaves stale object
    ;; bytes above the compacted heap pointer, so any routine that
    ;; claims limbs it does not write (add_magnitude's carry limb) or
    ;; accumulates with += (schoolbook mul) would otherwise absorb
    ;; garbage limbs — silently wrong VALUES, post-gc only. That
    ;; exact corruption shipped: $bigint_normalize read add's
    ;; unwritten carry limb, found a stale heap pointer, and kept it
    ;; as a significant limb (caught 2026-07-19 via the
    ;; heap_pressure_number_tower recovery test).
    (memory.fill
      (call $abs (i32.add
        (i32.add (local.get $header) (global.get $GC_HEADER_SIZE))
        (i32.const 8)))
      (i32.const 0)
      (i32.mul (local.get $length) (i32.const 4)))

    (call $write_state (global.get $STATE_HEAP_POINTER)
      (i32.add (local.get $header) (local.get $aligned)))

    (local.get $header)
  )

  ;; Write a limb to a BigInt at index
  (func $bigint_set_limb (param $header i32) (param $index i32) (param $value i32)
    (i32.store (call $abs (i32.add
      (i32.add (local.get $header) (global.get $GC_HEADER_SIZE))
      (i32.add (i32.const 8) (i32.mul (local.get $index) (i32.const 4)))))
      (local.get $value))
  )

  ;; Set BigInt length (for normalization)
  (func $bigint_set_length (param $header i32) (param $length i32)
    (i32.store (call $abs (i32.add
      (i32.add (local.get $header) (global.get $GC_HEADER_SIZE))
      (i32.const 4)))
      (local.get $length))
  )

  ;; Normalize: trim leading zero limbs. If result is zero, set sign=0.
  (func $bigint_normalize (param $header i32)
    (local $len i32)
    (local.set $len (call $bigint_length (local.get $header)))
    (block $done
      (loop $trim
        (br_if $done (i32.eqz (local.get $len)))
        (br_if $done (i32.ne
          (call $bigint_limb (local.get $header) (i32.sub (local.get $len) (i32.const 1)))
          (i32.const 0)))
        (local.set $len (i32.sub (local.get $len) (i32.const 1)))
        (br $trim)
      )
    )
    (call $bigint_set_length (local.get $header) (local.get $len))
    ;; If zero, set sign to 0
    (if (i32.eqz (local.get $len))
      (then
        (i32.store (call $abs (i32.add (local.get $header) (global.get $GC_HEADER_SIZE)))
          (i32.const 0))
      )
    )
  )

  ;; Return the UTF-8 byte length of the ECMAScript WhiteSpace or
  ;; LineTerminator code point beginning at index, or zero when the next
  ;; code point is not whitespace.
  (func $string_integer_whitespace_length
    (param $string_id i32) (param $index i32) (param $end i32) (result i32)
    (local $pointer i32)
    (local $first i32)
    (local $second i32)
    (local $third i32)
    (local.set $pointer
      (call $abs
        (i32.add (call $string_id_bytes_seg (local.get $string_id))
          (local.get $index))))
    (local.set $first (i32.load8_u (local.get $pointer)))
    (if (i32.or
          (i32.and (i32.ge_u (local.get $first) (i32.const 0x09))
            (i32.le_u (local.get $first) (i32.const 0x0D)))
          (i32.eq (local.get $first) (i32.const 0x20)))
      (then (return (i32.const 1))))
    (if (i32.and
          (i32.eq (local.get $first) (i32.const 0xC2))
          (i32.lt_u (i32.add (local.get $index) (i32.const 1)) (local.get $end)))
      (then
        (local.set $second (i32.load8_u (i32.add (local.get $pointer) (i32.const 1))))
        (if (i32.eq (local.get $second) (i32.const 0xA0))
          (then (return (i32.const 2))))))
    (if (i32.lt_u (i32.add (local.get $index) (i32.const 2)) (local.get $end))
      (then
        (local.set $second (i32.load8_u (i32.add (local.get $pointer) (i32.const 1))))
        (local.set $third (i32.load8_u (i32.add (local.get $pointer) (i32.const 2))))
        (if (i32.and
              (i32.eq (local.get $first) (i32.const 0xE1))
              (i32.and (i32.eq (local.get $second) (i32.const 0x9A))
                (i32.eq (local.get $third) (i32.const 0x80))))
          (then (return (i32.const 3))))
        (if (i32.and
              (i32.eq (local.get $first) (i32.const 0xE2))
              (i32.and
                (i32.eq (local.get $second) (i32.const 0x80))
                (i32.or
                  (i32.and (i32.ge_u (local.get $third) (i32.const 0x80))
                    (i32.le_u (local.get $third) (i32.const 0x8A)))
                  (i32.or
                    (i32.eq (local.get $third) (i32.const 0xA8))
                    (i32.or
                      (i32.eq (local.get $third) (i32.const 0xA9))
                      (i32.eq (local.get $third) (i32.const 0xAF)))))))
          (then (return (i32.const 3))))
        (if (i32.and
              (i32.eq (local.get $first) (i32.const 0xE2))
              (i32.and (i32.eq (local.get $second) (i32.const 0x81))
                (i32.eq (local.get $third) (i32.const 0x9F))))
          (then (return (i32.const 3))))
        (if (i32.and
              (i32.eq (local.get $first) (i32.const 0xE3))
              (i32.and (i32.eq (local.get $second) (i32.const 0x80))
                (i32.eq (local.get $third) (i32.const 0x80))))
          (then (return (i32.const 3))))
        (if (i32.and
              (i32.eq (local.get $first) (i32.const 0xEF))
              (i32.and (i32.eq (local.get $second) (i32.const 0xBB))
                (i32.eq (local.get $third) (i32.const 0xBF))))
          (then (return (i32.const 3))))))
    (i32.const 0)
  )

  ;; Parse the complete ECMAScript StringIntegerLiteral grammar into a
  ;; canonical sign-magnitude BigInt. Returns -1 for invalid grammar and
  ;; zero only when memory pressure was signalled.
  (func $string_to_bigint (param $string_id i32) (result i32)
    (local $length i32)
    (local $start i32)
    (local $end i32)
    (local $index i32)
    (local $whitespace_length i32)
    (local $byte i32)
    (local $sign i32)
    (local $radix i32)
    (local $digit i32)
    (local $digit_count i32)
    (local $capacity i32)
    (local $result i32)
    (local $limb_index i32)
    (local $accumulator i64)
    (local $carry i64)

    (local.set $length (call $read_string_len (local.get $string_id)))
    (local.set $start (i32.const 0))
    (block $leading_done
      (loop $leading_loop
        (br_if $leading_done (i32.ge_u (local.get $start) (local.get $length)))
        (local.set $whitespace_length
          (call $string_integer_whitespace_length
            (local.get $string_id) (local.get $start) (local.get $length)))
        (br_if $leading_done (i32.eqz (local.get $whitespace_length)))
        (local.set $start (i32.add (local.get $start) (local.get $whitespace_length)))
        (br $leading_loop)))

    (local.set $end (local.get $start))
    (local.set $index (local.get $start))
    (block $trailing_scan_done
      (loop $trailing_scan
        (br_if $trailing_scan_done (i32.ge_u (local.get $index) (local.get $length)))
        (local.set $whitespace_length
          (call $string_integer_whitespace_length
            (local.get $string_id) (local.get $index) (local.get $length)))
        (if (local.get $whitespace_length)
          (then
            (local.set $index (i32.add (local.get $index) (local.get $whitespace_length))))
          (else
            (local.set $index (i32.add (local.get $index) (i32.const 1)))
            (local.set $end (local.get $index))))
        (br $trailing_scan)))

    (if (i32.eq (local.get $start) (local.get $end))
      (then
        (if (call $check_heap_overflow (call $estimate_bigint_size (i32.const 0)))
          (then (return (i32.const 0))))
        (return (call $bigint_alloc (i32.const 0) (i32.const 0)))))

    (local.set $index (local.get $start))
    (local.set $byte
      (i32.load8_u
        (call $abs
          (i32.add (call $string_id_bytes_seg (local.get $string_id))
            (local.get $index)))))
    (if (i32.or (i32.eq (local.get $byte) (i32.const 0x2B))
          (i32.eq (local.get $byte) (i32.const 0x2D)))
      (then
        (local.set $sign (i32.eq (local.get $byte) (i32.const 0x2D)))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (if (i32.ge_u (local.get $index) (local.get $end))
          (then (return (i32.const -1))))))

    (local.set $radix (i32.const 10))
    (if (i32.lt_u (i32.add (local.get $index) (i32.const 1)) (local.get $end))
      (then
        (local.set $byte
          (i32.load8_u
            (call $abs
              (i32.add (call $string_id_bytes_seg (local.get $string_id))
                (local.get $index)))))
        (if (i32.eq (local.get $byte) (i32.const 0x30))
          (then
            (local.set $byte
              (i32.load8_u
                (call $abs
                  (i32.add
                    (call $string_id_bytes_seg (local.get $string_id))
                    (i32.add (local.get $index) (i32.const 1))))))
            (if (i32.or (i32.eq (local.get $byte) (i32.const 0x78))
                  (i32.eq (local.get $byte) (i32.const 0x58)))
              (then (local.set $radix (i32.const 16))))
            (if (i32.or (i32.eq (local.get $byte) (i32.const 0x6F))
                  (i32.eq (local.get $byte) (i32.const 0x4F)))
              (then (local.set $radix (i32.const 8))))
            (if (i32.or (i32.eq (local.get $byte) (i32.const 0x62))
                  (i32.eq (local.get $byte) (i32.const 0x42)))
              (then (local.set $radix (i32.const 2))))
            (if (i32.ne (local.get $radix) (i32.const 10))
              (then
                (if (i32.ne (local.get $index) (local.get $start))
                  (then (return (i32.const -1))))
                (local.set $index (i32.add (local.get $index) (i32.const 2)))
                (if (i32.ge_u (local.get $index) (local.get $end))
                  (then (return (i32.const -1))))))))))

    (local.set $start (local.get $index))
    (block $validation_done
      (loop $validation_loop
        (br_if $validation_done (i32.ge_u (local.get $index) (local.get $end)))
        (local.set $byte
          (i32.load8_u
            (call $abs
              (i32.add (call $string_id_bytes_seg (local.get $string_id))
                (local.get $index)))))
        (local.set $digit (i32.const -1))
        (if (i32.and (i32.ge_u (local.get $byte) (i32.const 0x30))
              (i32.le_u (local.get $byte) (i32.const 0x39)))
          (then (local.set $digit (i32.sub (local.get $byte) (i32.const 0x30)))))
        (if (i32.and (i32.ge_u (local.get $byte) (i32.const 0x41))
              (i32.le_u (local.get $byte) (i32.const 0x46)))
          (then (local.set $digit (i32.add
            (i32.sub (local.get $byte) (i32.const 0x41)) (i32.const 10)))))
        (if (i32.and (i32.ge_u (local.get $byte) (i32.const 0x61))
              (i32.le_u (local.get $byte) (i32.const 0x66)))
          (then (local.set $digit (i32.add
            (i32.sub (local.get $byte) (i32.const 0x61)) (i32.const 10)))))
        (if (i32.or (i32.lt_s (local.get $digit) (i32.const 0))
              (i32.ge_s (local.get $digit) (local.get $radix)))
          (then (return (i32.const -1))))
        (local.set $digit_count (i32.add (local.get $digit_count) (i32.const 1)))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $validation_loop)))

    (local.set $capacity
      (i32.shr_u (i32.add (local.get $digit_count) (i32.const 7)) (i32.const 3)))
    (if (call $check_heap_overflow (call $estimate_bigint_size (local.get $capacity)))
      (then (return (i32.const 0))))
    (local.set $result
      (call $bigint_alloc (local.get $sign) (local.get $capacity)))
    (local.set $index (local.get $start))
    (block $parse_done
      (loop $parse_loop
        (br_if $parse_done (i32.ge_u (local.get $index) (local.get $end)))
        (local.set $byte
          (i32.load8_u
            (call $abs
              (i32.add (call $string_id_bytes_seg (local.get $string_id))
                (local.get $index)))))
        (if (i32.le_u (local.get $byte) (i32.const 0x39))
          (then (local.set $digit (i32.sub (local.get $byte) (i32.const 0x30))))
          (else
            (if (i32.le_u (local.get $byte) (i32.const 0x46))
              (then (local.set $digit (i32.add
                (i32.sub (local.get $byte) (i32.const 0x41)) (i32.const 10))))
              (else (local.set $digit (i32.add
                (i32.sub (local.get $byte) (i32.const 0x61)) (i32.const 10)))))))
        (local.set $carry (i64.extend_i32_u (local.get $digit)))
        (local.set $limb_index (i32.const 0))
        (block $limbs_done
          (loop $limbs_loop
            (br_if $limbs_done
              (i32.ge_u (local.get $limb_index) (local.get $capacity)))
            (local.set $accumulator
              (i64.add
                (i64.mul
                  (i64.extend_i32_u
                    (call $bigint_limb (local.get $result) (local.get $limb_index)))
                  (i64.extend_i32_u (local.get $radix)))
                (local.get $carry)))
            (call $bigint_set_limb
              (local.get $result) (local.get $limb_index)
              (i32.wrap_i64 (local.get $accumulator)))
            (local.set $carry (i64.shr_u (local.get $accumulator) (i64.const 32)))
            (local.set $limb_index
              (i32.add (local.get $limb_index) (i32.const 1)))
            (br $limbs_loop)))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $parse_loop)))
    (call $bigint_normalize (local.get $result))
    (local.get $result)
  )

  ;; Compare magnitudes of two BigInts. Returns -1, 0, or 1.
  ;; Does NOT consider sign.
  (func $bigint_compare_magnitude (param $a i32) (param $b i32) (result i32)
    (local $la i32)
    (local $lb i32)
    (local $i i32)
    (local $limb_a i32)
    (local $limb_b i32)

    (local.set $la (call $bigint_length (local.get $a)))
    (local.set $lb (call $bigint_length (local.get $b)))

    ;; Different lengths → longer is bigger
    (if (i32.gt_u (local.get $la) (local.get $lb))
      (then (return (i32.const 1))))
    (if (i32.lt_u (local.get $la) (local.get $lb))
      (then (return (i32.const -1))))

    ;; Same length → compare from most significant limb
    (local.set $i (local.get $la))
    (block $done
      (loop $cmp
        (br_if $done (i32.eqz (local.get $i)))
        (local.set $i (i32.sub (local.get $i) (i32.const 1)))
        (local.set $limb_a (call $bigint_limb (local.get $a) (local.get $i)))
        (local.set $limb_b (call $bigint_limb (local.get $b) (local.get $i)))
        (if (i32.gt_u (local.get $limb_a) (local.get $limb_b))
          (then (return (i32.const 1))))
        (if (i32.lt_u (local.get $limb_a) (local.get $limb_b))
          (then (return (i32.const -1))))
        (br $cmp)
      )
    )
    (i32.const 0)
  )

  ;; Add magnitudes: |a| + |b|. Returns header pointer to result.
  ;; Result sign is set by caller.
  (func $bigint_add_magnitude (param $a i32) (param $b i32) (result i32)
    (local $la i32)
    (local $lb i32)
    (local $max_len i32)
    (local $result i32)
    (local $i i32)
    (local $carry i64)
    (local $sum i64)
    (local $limb_a i32)
    (local $limb_b i32)

    (local.set $la (call $bigint_length (local.get $a)))
    (local.set $lb (call $bigint_length (local.get $b)))
    (local.set $max_len (select (local.get $la) (local.get $lb)
      (i32.gt_u (local.get $la) (local.get $lb))))

    ;; Allocate result with max_len + 1 limbs (for possible carry)
    (local.set $result (call $bigint_alloc (i32.const 0)
      (i32.add (local.get $max_len) (i32.const 1))))

    (local.set $carry (i64.const 0))
    (local.set $i (i32.const 0))
    (block $done
      (loop $add_loop
        (br_if $done (i32.ge_u (local.get $i) (local.get $max_len)))

        (local.set $limb_a (select
          (call $bigint_limb (local.get $a) (local.get $i))
          (i32.const 0)
          (i32.lt_u (local.get $i) (local.get $la))))
        (local.set $limb_b (select
          (call $bigint_limb (local.get $b) (local.get $i))
          (i32.const 0)
          (i32.lt_u (local.get $i) (local.get $lb))))

        (local.set $sum (i64.add
          (i64.add
            (i64.extend_i32_u (local.get $limb_a))
            (i64.extend_i32_u (local.get $limb_b)))
          (local.get $carry)))

        (call $bigint_set_limb (local.get $result) (local.get $i)
          (i32.wrap_i64 (local.get $sum)))
        (local.set $carry (i64.shr_u (local.get $sum) (i64.const 32)))

        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $add_loop)
      )
    )

    ;; Final carry
    (if (i64.ne (local.get $carry) (i64.const 0))
      (then
        (call $bigint_set_limb (local.get $result) (local.get $max_len)
          (i32.wrap_i64 (local.get $carry)))
      )
    )

    (call $bigint_normalize (local.get $result))
    (local.get $result)
  )

  ;; Subtract magnitudes: |a| - |b| where |a| >= |b|. Returns header pointer.
  (func $bigint_sub_magnitude (param $a i32) (param $b i32) (result i32)
    (local $la i32)
    (local $lb i32)
    (local $result i32)
    (local $i i32)
    (local $borrow i64)
    (local $diff i64)
    (local $limb_a i32)
    (local $limb_b i32)

    (local.set $la (call $bigint_length (local.get $a)))
    (local.set $lb (call $bigint_length (local.get $b)))

    (local.set $result (call $bigint_alloc (i32.const 0) (local.get $la)))

    (local.set $borrow (i64.const 0))
    (local.set $i (i32.const 0))
    (block $done
      (loop $sub_loop
        (br_if $done (i32.ge_u (local.get $i) (local.get $la)))

        (local.set $limb_a (call $bigint_limb (local.get $a) (local.get $i)))
        (local.set $limb_b (select
          (call $bigint_limb (local.get $b) (local.get $i))
          (i32.const 0)
          (i32.lt_u (local.get $i) (local.get $lb))))

        (local.set $diff (i64.sub
          (i64.sub
            (i64.extend_i32_u (local.get $limb_a))
            (i64.extend_i32_u (local.get $limb_b)))
          (local.get $borrow)))

        (call $bigint_set_limb (local.get $result) (local.get $i)
          (i32.wrap_i64 (local.get $diff)))
        ;; Borrow = 1 if diff < 0 (high bits set in i64)
        (local.set $borrow (i64.and
          (i64.shr_u (local.get $diff) (i64.const 63))
          (i64.const 1)))

        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $sub_loop)
      )
    )

    (call $bigint_normalize (local.get $result))
    (local.get $result)
  )

  ;; Multiply magnitudes: |a| * |b|. Schoolbook O(n*m). Returns header pointer.
  (func $bigint_mul_magnitude (param $a i32) (param $b i32) (result i32)
    (local $la i32)
    (local $lb i32)
    (local $result i32)
    (local $i i32)
    (local $j i32)
    (local $carry i64)
    (local $product i64)
    (local $existing i64)
    (local $k i32)

    (local.set $la (call $bigint_length (local.get $a)))
    (local.set $lb (call $bigint_length (local.get $b)))

    ;; Zero check
    (if (i32.or (i32.eqz (local.get $la)) (i32.eqz (local.get $lb)))
      (then (return (call $bigint_alloc (i32.const 0) (i32.const 0)))))

    ;; Result has at most la + lb limbs; $bigint_alloc zeroes the
    ;; limbs (the accumulator invariant schoolbook += relies on).
    (local.set $result (call $bigint_alloc (i32.const 0)
      (i32.add (local.get $la) (local.get $lb))))

    ;; Schoolbook multiplication
    (local.set $i (i32.const 0))
    (block $outer_done
      (loop $outer
        (br_if $outer_done (i32.ge_u (local.get $i) (local.get $la)))

        (local.set $carry (i64.const 0))
        (local.set $j (i32.const 0))
        (block $inner_done
          (loop $inner
            (br_if $inner_done (i32.ge_u (local.get $j) (local.get $lb)))

            (local.set $k (i32.add (local.get $i) (local.get $j)))
            (local.set $product (i64.add
              (i64.add
                (i64.mul
                  (i64.extend_i32_u (call $bigint_limb (local.get $a) (local.get $i)))
                  (i64.extend_i32_u (call $bigint_limb (local.get $b) (local.get $j))))
                (i64.extend_i32_u (call $bigint_limb (local.get $result) (local.get $k))))
              (local.get $carry)))

            (call $bigint_set_limb (local.get $result) (local.get $k)
              (i32.wrap_i64 (local.get $product)))
            (local.set $carry (i64.shr_u (local.get $product) (i64.const 32)))

            (local.set $j (i32.add (local.get $j) (i32.const 1)))
            (br $inner)
          )
        )

        ;; Store final carry
        (if (i64.ne (local.get $carry) (i64.const 0))
          (then
            (call $bigint_set_limb (local.get $result)
              (i32.add (local.get $i) (local.get $lb))
              (i32.wrap_i64 (local.get $carry)))
          )
        )

        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $outer)
      )
    )

    (call $bigint_normalize (local.get $result))
    (local.get $result)
  )

  ;; Add two BigInts with sign handling. Returns header pointer.
  (func $bigint_add (param $a i32) (param $b i32) (result i32)
    (local $sa i32)
    (local $sb i32)
    (local $result i32)
    (local $cmp i32)

    (local.set $sa (call $bigint_sign (local.get $a)))
    (local.set $sb (call $bigint_sign (local.get $b)))

    ;; Same sign: add magnitudes, keep sign
    (if (i32.eq (local.get $sa) (local.get $sb))
      (then
        (local.set $result (call $bigint_add_magnitude (local.get $a) (local.get $b)))
        ;; Set sign
        (i32.store (call $abs (i32.add (local.get $result) (global.get $GC_HEADER_SIZE)))
          (local.get $sa))
        (return (local.get $result))
      )
    )

    ;; Different signs: subtract smaller magnitude from larger
    (local.set $cmp (call $bigint_compare_magnitude (local.get $a) (local.get $b)))
    (if (i32.eqz (local.get $cmp))
      (then
        ;; Equal magnitudes, different signs → zero
        (return (call $bigint_alloc (i32.const 0) (i32.const 0)))
      )
    )

    (if (i32.gt_s (local.get $cmp) (i32.const 0))
      (then
        ;; |a| > |b| → result = |a| - |b|, sign = sign(a)
        (local.set $result (call $bigint_sub_magnitude (local.get $a) (local.get $b)))
        (i32.store (call $abs (i32.add (local.get $result) (global.get $GC_HEADER_SIZE)))
          (local.get $sa))
        (return (local.get $result))
      )
    )

    ;; |b| > |a| → result = |b| - |a|, sign = sign(b)
    (local.set $result (call $bigint_sub_magnitude (local.get $b) (local.get $a)))
    (i32.store (call $abs (i32.add (local.get $result) (global.get $GC_HEADER_SIZE)))
      (local.get $sb))
    (local.get $result)
  )

  ;; Subtract two BigInts: a - b. Returns header pointer.
  (func $bigint_sub (param $a i32) (param $b i32) (result i32)
    (local $sb i32)
    (local $neg_b i32)

    ;; a - b = a + (-b), so flip sign of b and add
    ;; But we don't want to mutate b, so use inline sign flip logic
    (local.set $sb (call $bigint_sign (local.get $b)))

    ;; If b is zero, return a copy of a — WITH a's sign. The original
    ;; shortcut returned the bare magnitude copy, silently flipping
    ;; every negative minuend: (-5n) - 0n evaluated to 5n, and
    ;; complex_pow's square-and-multiply (1 × (-1) via a - 0 in the
    ;; real-part cross terms) returned i² = +1. Pinned by
    ;; tests/fuel/bigint_test.js ("subtracting zero preserves sign").
    (if (i32.eqz (call $bigint_length (local.get $b)))
      (then
        (local.set $neg_b (call $bigint_add_magnitude (local.get $a) (local.get $b)))
        (i32.store (call $abs (i32.add (local.get $neg_b) (global.get $GC_HEADER_SIZE)))
          (call $bigint_sign (local.get $a)))
        (return (local.get $neg_b))
      )
    )

    ;; Temporarily flip b's sign
    (i32.store (call $abs (i32.add (local.get $b) (global.get $GC_HEADER_SIZE)))
      (i32.xor (local.get $sb) (i32.const 1)))

    ;; Add (which handles signs)
    (local.set $neg_b (call $bigint_add (local.get $a) (local.get $b)))

    ;; Restore b's sign
    (i32.store (call $abs (i32.add (local.get $b) (global.get $GC_HEADER_SIZE)))
      (local.get $sb))

    (local.get $neg_b)
  )

  ;; Multiply two BigInts with sign handling. Returns header pointer.
  (func $bigint_mul (param $a i32) (param $b i32) (result i32)
    (local $result i32)
    (local $result_sign i32)

    (local.set $result (call $bigint_mul_magnitude (local.get $a) (local.get $b)))

    ;; Sign: negative if exactly one operand is negative
    (local.set $result_sign (i32.xor
      (call $bigint_sign (local.get $a))
      (call $bigint_sign (local.get $b))))

    ;; Don't set negative sign on zero
    (if (i32.and
          (i32.ne (local.get $result_sign) (i32.const 0))
          (i32.ne (call $bigint_length (local.get $result)) (i32.const 0)))
      (then
        (i32.store (call $abs (i32.add (local.get $result) (global.get $GC_HEADER_SIZE)))
          (i32.const 1))
      )
    )

    (local.get $result)
  )

  ;; Push a BigInt value to the pending stack (header pointer)
  (func $push_bigint (param $header i32)
    (call $pending_push (global.get $TYPE_BIGINT) (i32.const 0) (local.get $header) (i32.const 0))
  )

  ;; Divide magnitude by single limb: |a| / d. Returns quotient header.
  ;; Remainder stored in scratch base (first 4 bytes).
  (func $bigint_div_single_limb (param $a i32) (param $divisor i32) (result i32)
    (local $la i32)
    (local $result i32)
    (local $i i32)
    (local $remainder i64)
    (local $current i64)
    (local $q i32)

    (local.set $la (call $bigint_length (local.get $a)))
    (local.set $result (call $bigint_alloc (i32.const 0) (local.get $la)))
    (local.set $remainder (i64.const 0))

    ;; Process from most significant limb down
    (local.set $i (local.get $la))
    (block $done
      (loop $div_loop
        (br_if $done (i32.eqz (local.get $i)))
        (local.set $i (i32.sub (local.get $i) (i32.const 1)))

        (local.set $current (i64.or
          (i64.shl (local.get $remainder) (i64.const 32))
          (i64.extend_i32_u (call $bigint_limb (local.get $a) (local.get $i)))))

        (local.set $q (i32.wrap_i64
          (i64.div_u (local.get $current) (i64.extend_i32_u (local.get $divisor)))))
        (local.set $remainder
          (i64.rem_u (local.get $current) (i64.extend_i32_u (local.get $divisor))))

        (call $bigint_set_limb (local.get $result) (local.get $i) (local.get $q))
        (br $div_loop)
      )
    )

    ;; Store remainder in scratch base
    (i32.store (call $scratch_ptr (i32.const 0) (i32.const 4))
      (i32.wrap_i64 (local.get $remainder)))

    (call $bigint_normalize (local.get $result))
    (local.get $result)
  )

  ;; Left-shift a BigInt by one bit in place (for binary division).
  ;; Assumes there is room for an extra limb.
  (func $bigint_shl1_inplace (param $header i32)
    (local $len i32)
    (local $i i32)
    (local $carry i32)
    (local $limb i32)
    (local $new_carry i32)

    (local.set $len (call $bigint_length (local.get $header)))
    (local.set $carry (i32.const 0))
    (local.set $i (i32.const 0))
    (block $done
      (loop $shl_loop
        (br_if $done (i32.ge_u (local.get $i) (local.get $len)))
        (local.set $limb (call $bigint_limb (local.get $header) (local.get $i)))
        (local.set $new_carry (i32.shr_u (local.get $limb) (i32.const 31)))
        (call $bigint_set_limb (local.get $header) (local.get $i)
          (i32.or (i32.shl (local.get $limb) (i32.const 1)) (local.get $carry)))
        (local.set $carry (local.get $new_carry))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $shl_loop)
      )
    )
    (if (i32.ne (local.get $carry) (i32.const 0))
      (then
        (call $bigint_set_limb (local.get $header) (local.get $len) (local.get $carry))
        (call $bigint_set_length (local.get $header) (i32.add (local.get $len) (i32.const 1)))
      )
    )
  )

  ;; Subtract magnitude in place: a -= b. Assumes |a| >= |b|.
  ;; Returns 1 if borrow occurred (underflow), 0 otherwise.
  (func $bigint_sub_inplace (param $a i32) (param $b i32) (result i32)
    (local $la i32)
    (local $lb i32)
    (local $i i32)
    (local $borrow i64)
    (local $diff i64)
    (local $limb_a i32)
    (local $limb_b i32)

    (local.set $la (call $bigint_length (local.get $a)))
    (local.set $lb (call $bigint_length (local.get $b)))
    (local.set $borrow (i64.const 0))
    (local.set $i (i32.const 0))
    (block $done
      (loop $sub_loop
        (br_if $done (i32.ge_u (local.get $i) (local.get $la)))

        (local.set $limb_a (call $bigint_limb (local.get $a) (local.get $i)))
        (local.set $limb_b (select
          (call $bigint_limb (local.get $b) (local.get $i))
          (i32.const 0)
          (i32.lt_u (local.get $i) (local.get $lb))))

        (local.set $diff (i64.sub
          (i64.sub
            (i64.extend_i32_u (local.get $limb_a))
            (i64.extend_i32_u (local.get $limb_b)))
          (local.get $borrow)))

        (call $bigint_set_limb (local.get $a) (local.get $i)
          (i32.wrap_i64 (local.get $diff)))
        (local.set $borrow (i64.and
          (i64.shr_u (local.get $diff) (i64.const 63))
          (i64.const 1)))

        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $sub_loop)
      )
    )
    (i32.wrap_i64 (local.get $borrow))
  )

  ;; General division: |a| / |b|. Returns quotient header.
  ;; Uses single-limb fast path or binary long division for multi-limb.
  ;; Remainder is returned as a separate BigInt via scratch pointer.
  (func $bigint_div_magnitude (param $a i32) (param $b i32) (result i32)
    (local $la i32)
    (local $lb i32)
    (local $cmp i32)
    (local $quotient i32)
    (local $remainder i32)
    (local $bit_count i32)
    (local $i i32)
    (local $bit i32)
    (local $limb_idx i32)
    (local $bit_idx i32)
    (local $scratch_base i32)
    (local $rem_single i32)

    (local.set $la (call $bigint_length (local.get $a)))
    (local.set $lb (call $bigint_length (local.get $b)))
    ;; Remainder slot: [remainder ptr:4][zero flag:4]. $scratch_base is
    ;; ABSOLUTE (returned by $scratch_ptr).
    (local.set $scratch_base (call $scratch_ptr (i32.const 0) (i32.const 8)))

    ;; Division by zero check
    (if (i32.eqz (local.get $lb))
      (then
        ;; Store zero remainder
        (i32.store (local.get $scratch_base) (i32.const 0))
        (i32.store (i32.add (local.get $scratch_base) (i32.const 4)) (i32.const 0))
        ;; Return zero (will be caught by caller as div-by-zero)
        (return (call $bigint_alloc (i32.const 0) (i32.const 0)))
      )
    )

    ;; If |a| < |b|, quotient is 0, remainder is a
    (local.set $cmp (call $bigint_compare_magnitude (local.get $a) (local.get $b)))
    (if (i32.lt_s (local.get $cmp) (i32.const 0))
      (then
        ;; Store remainder = copy of a (we store header pointer in scratch)
        (local.set $remainder (call $bigint_add_magnitude
          (local.get $a) (call $bigint_alloc (i32.const 0) (i32.const 0))))
        (i32.store (local.get $scratch_base) (local.get $remainder))
        (return (call $bigint_alloc (i32.const 0) (i32.const 0)))
      )
    )

    ;; Equal magnitudes: quotient is 1, remainder is 0
    (if (i32.eqz (local.get $cmp))
      (then
        (local.set $quotient (call $bigint_alloc (i32.const 0) (i32.const 1)))
        (call $bigint_set_limb (local.get $quotient) (i32.const 0) (i32.const 1))
        (local.set $remainder (call $bigint_alloc (i32.const 0) (i32.const 0)))
        (i32.store (local.get $scratch_base) (local.get $remainder))
        (return (local.get $quotient))
      )
    )

    ;; Single-limb divisor: use fast path
    (if (i32.eq (local.get $lb) (i32.const 1))
      (then
        (local.set $quotient (call $bigint_div_single_limb
          (local.get $a) (call $bigint_limb (local.get $b) (i32.const 0))))
        ;; Remainder was stored as u32 in scratch; convert to BigInt
        (local.set $rem_single (i32.load (local.get $scratch_base)))
        (if (i32.eqz (local.get $rem_single))
          (then
            (local.set $remainder (call $bigint_alloc (i32.const 0) (i32.const 0)))
          )
          (else
            (local.set $remainder (call $bigint_alloc (i32.const 0) (i32.const 1)))
            (call $bigint_set_limb (local.get $remainder) (i32.const 0) (local.get $rem_single))
          )
        )
        (i32.store (local.get $scratch_base) (local.get $remainder))
        (return (local.get $quotient))
      )
    )

    ;; Multi-limb division: binary long division (shift-subtract)
    ;; Total bits in dividend
    (local.set $bit_count (i32.mul (local.get $la) (i32.const 32)))

    ;; Allocate quotient (same size as dividend)
    (local.set $quotient (call $bigint_alloc (i32.const 0) (local.get $la)))
    (local.set $i (i32.const 0))
    (block $qinit_done
      (loop $qinit
        (br_if $qinit_done (i32.ge_u (local.get $i) (local.get $la)))
        (call $bigint_set_limb (local.get $quotient) (local.get $i) (i32.const 0))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $qinit)
      )
    )

    ;; Allocate remainder (needs room for lb+1 limbs for shift)
    (local.set $remainder (call $bigint_alloc (i32.const 0)
      (i32.add (local.get $lb) (i32.const 1))))
    (local.set $i (i32.const 0))
    (block $rinit_done
      (loop $rinit
        (br_if $rinit_done (i32.ge_u (local.get $i)
          (i32.add (local.get $lb) (i32.const 1))))
        (call $bigint_set_limb (local.get $remainder) (local.get $i) (i32.const 0))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $rinit)
      )
    )
    (call $bigint_set_length (local.get $remainder) (i32.const 0))

    ;; Process bits from most significant to least
    (local.set $i (i32.sub (local.get $bit_count) (i32.const 1)))
    (block $bits_done
      (loop $bits_loop
        (br_if $bits_done (i32.lt_s (local.get $i) (i32.const 0)))

        ;; Shift remainder left by 1
        (call $bigint_shl1_inplace (local.get $remainder))

        ;; Get bit i of dividend
        (local.set $limb_idx (i32.div_u (local.get $i) (i32.const 32)))
        (local.set $bit_idx (i32.rem_u (local.get $i) (i32.const 32)))
        (local.set $bit (i32.and
          (i32.shr_u
            (call $bigint_limb (local.get $a) (local.get $limb_idx))
            (local.get $bit_idx))
          (i32.const 1)))

        ;; Set lowest bit of remainder
        (if (i32.ne (local.get $bit) (i32.const 0))
          (then
            ;; If remainder has no limbs, add one
            (if (i32.eqz (call $bigint_length (local.get $remainder)))
              (then
                (call $bigint_set_length (local.get $remainder) (i32.const 1))
                (call $bigint_set_limb (local.get $remainder) (i32.const 0) (i32.const 1))
              )
              (else
                (call $bigint_set_limb (local.get $remainder) (i32.const 0)
                  (i32.or
                    (call $bigint_limb (local.get $remainder) (i32.const 0))
                    (i32.const 1)))
              )
            )
          )
        )

        ;; If remainder >= divisor, subtract and set quotient bit
        (if (i32.ge_s
              (call $bigint_compare_magnitude (local.get $remainder) (local.get $b))
              (i32.const 0))
          (then
            (drop (call $bigint_sub_inplace (local.get $remainder) (local.get $b)))
            (call $bigint_normalize (local.get $remainder))
            ;; Set bit i of quotient
            (call $bigint_set_limb (local.get $quotient) (local.get $limb_idx)
              (i32.or
                (call $bigint_limb (local.get $quotient) (local.get $limb_idx))
                (i32.shl (i32.const 1) (local.get $bit_idx))))
          )
        )

        (local.set $i (i32.sub (local.get $i) (i32.const 1)))
        (br $bits_loop)
      )
    )

    (call $bigint_normalize (local.get $quotient))
    (call $bigint_normalize (local.get $remainder))
    (i32.store (local.get $scratch_base) (local.get $remainder))

    (local.get $quotient)
  )

  ;; Divide two BigInts with sign handling: a / b.
  ;; Returns quotient. Truncates toward zero.
  ;; Remainder stored in scratch (accessible for MOD).
  (func $bigint_div (param $a i32) (param $b i32) (result i32)
    (local $result i32)
    (local $result_sign i32)
    (local $remainder i32)

    (local.set $result (call $bigint_div_magnitude (local.get $a) (local.get $b)))

    ;; Sign: negative if exactly one operand is negative
    (local.set $result_sign (i32.xor
      (call $bigint_sign (local.get $a))
      (call $bigint_sign (local.get $b))))

    (if (i32.and
          (i32.ne (local.get $result_sign) (i32.const 0))
          (i32.ne (call $bigint_length (local.get $result)) (i32.const 0)))
      (then
        (i32.store (call $abs (i32.add (local.get $result) (global.get $GC_HEADER_SIZE)))
          (i32.const 1))
      )
    )

    ;; Set remainder sign to match dividend sign
    (local.set $remainder (i32.load (call $scratch_ptr (i32.const 0) (i32.const 4))))
    (if (i32.and
          (i32.ne (call $bigint_sign (local.get $a)) (i32.const 0))
          (i32.ne (call $bigint_length (local.get $remainder)) (i32.const 0)))
      (then
        (i32.store (call $abs (i32.add (local.get $remainder) (global.get $GC_HEADER_SIZE)))
          (i32.const 1))
      )
    )

    (local.get $result)
  )

  ;; Get the remainder from the last bigint_div call (stored in scratch).
  (func $bigint_last_remainder (result i32)
    (i32.load (call $scratch_ptr (i32.const 0) (i32.const 4)))
  )

  ;; Exponentiation: a ** b. b must be non-negative.
  ;; Uses repeated squaring.
  (func $bigint_pow (param $base i32) (param $exp i32) (result i32)
    (local $result i32)
    (local $current_base i32)
    (local $exp_len i32)
    (local $i i32)
    (local $limb i32)
    (local $bit i32)

    (local.set $exp_len (call $bigint_length (local.get $exp)))

    ;; exp == 0 → return 1n
    (if (i32.eqz (local.get $exp_len))
      (then
        (local.set $result (call $bigint_alloc (i32.const 0) (i32.const 1)))
        (call $bigint_set_limb (local.get $result) (i32.const 0) (i32.const 1))
        (return (local.get $result))
      )
    )

    ;; base == 0 → return 0n
    (if (i32.eqz (call $bigint_length (local.get $base)))
      (then
        (return (call $bigint_alloc (i32.const 0) (i32.const 0)))
      )
    )

    ;; Repeated squaring: iterate through significant bits of exponent only
    ;; Find highest set bit to avoid unnecessary squaring
    ;; result = 1, current = base
    (local.set $result (call $bigint_alloc (i32.const 0) (i32.const 1)))
    (call $bigint_set_limb (local.get $result) (i32.const 0) (i32.const 1))
    (local.set $current_base (local.get $base))

    ;; Find the total significant bit count: (exp_len - 1) * 32 + highest_bit_in_top_limb
    (local.set $limb (call $bigint_limb (local.get $exp)
      (i32.sub (local.get $exp_len) (i32.const 1))))
    ;; Count bits in top limb (find highest set bit)
    (local.set $bit (i32.const 0))
    (block $count_done
      (loop $count_bits
        (br_if $count_done (i32.eqz (local.get $limb)))
        (local.set $limb (i32.shr_u (local.get $limb) (i32.const 1)))
        (local.set $bit (i32.add (local.get $bit) (i32.const 1)))
        (br $count_bits)
      )
    )
    ;; Total significant bits
    (local.set $bit (i32.add
      (i32.mul (i32.sub (local.get $exp_len) (i32.const 1)) (i32.const 32))
      (local.get $bit)))

    ;; For each significant bit of exponent
    (local.set $i (i32.const 0))
    (block $exp_done
      (loop $exp_loop
        (br_if $exp_done (i32.ge_u (local.get $i) (local.get $bit)))

        ;; Get bit i of exponent
        (local.set $limb (call $bigint_limb (local.get $exp)
          (i32.div_u (local.get $i) (i32.const 32))))

        (if (i32.ne
              (i32.and
                (i32.shr_u (local.get $limb) (i32.rem_u (local.get $i) (i32.const 32)))
                (i32.const 1))
              (i32.const 0))
          (then
            (local.set $result (call $bigint_mul (local.get $result) (local.get $current_base)))
          )
        )

        (local.set $current_base (call $bigint_mul (local.get $current_base) (local.get $current_base)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $exp_loop)
      )
    )

    ;; Sign: negative if base is negative AND exponent is odd
    (if (i32.and
          (i32.ne (call $bigint_sign (local.get $base)) (i32.const 0))
          (i32.ne
            (i32.and (call $bigint_limb (local.get $exp) (i32.const 0)) (i32.const 1))
            (i32.const 0)))
      (then
        (i32.store (call $abs (i32.add (local.get $result) (global.get $GC_HEADER_SIZE)))
          (i32.const 1))
      )
    )

    (local.get $result)
  )

  ;; Compare two BigInts considering sign. Returns -1, 0, or 1.
  (func $bigint_compare (param $a i32) (param $b i32) (result i32)
    (local $sa i32)
    (local $sb i32)
    (local $la i32)
    (local $lb i32)

    (local.set $sa (call $bigint_sign (local.get $a)))
    (local.set $sb (call $bigint_sign (local.get $b)))
    (local.set $la (call $bigint_length (local.get $a)))
    (local.set $lb (call $bigint_length (local.get $b)))

    ;; Both zero
    (if (i32.and (i32.eqz (local.get $la)) (i32.eqz (local.get $lb)))
      (then (return (i32.const 0))))

    ;; Different signs
    (if (i32.and (i32.eqz (local.get $sa)) (i32.ne (local.get $sb) (i32.const 0)))
      (then (return (i32.const 1))))  ;; positive > negative
    (if (i32.and (i32.ne (local.get $sa) (i32.const 0)) (i32.eqz (local.get $sb)))
      (then (return (i32.const -1)))) ;; negative < positive

    ;; Same sign: compare magnitudes
    ;; If both positive: bigger magnitude is bigger
    ;; If both negative: bigger magnitude is smaller
    (if (i32.eqz (local.get $sa))
      (then (return (call $bigint_compare_magnitude (local.get $a) (local.get $b))))
    )
    ;; Both negative: reverse comparison
    (return (i32.sub (i32.const 0)
      (call $bigint_compare_magnitude (local.get $a) (local.get $b))))
  )

  ;; ==========================================================================
  ;; Rational arithmetic — Phase 1a of the exact-numbers extension.
  ;; Layout: [GC header: 8][numeratorPointer: 4][denominatorPointer: 4]
  ;; Both pointers point at BigInt heap objects. Invariants (enforced at
  ;; construction): denominator > 0; gcd(|numerator|, denominator) == 1;
  ;; zero is canonical (numerator == 0 → denominator == 1).
  ;; ==========================================================================

  ;; Allocate a BigInt heap object holding the scalar 1 (single limb, sign 0).
  (func $bigint_one (result i32)
    (local $header i32)
    (local.set $header (call $bigint_alloc (i32.const 0) (i32.const 1)))
    (call $bigint_set_limb (local.get $header) (i32.const 0) (i32.const 1))
    (local.get $header)
  )

  ;; Allocate a BigInt heap object holding zero (length 0, sign 0).
  (func $bigint_zero (result i32)
    (call $bigint_alloc (i32.const 0) (i32.const 0))
  )

  ;; Absolute-value copy of a BigInt (sign forced to 0).
  (func $bigint_abs_copy (param $a i32) (result i32)
    (local $la i32)
    (local $result i32)
    (local $i i32)
    (local.set $la (call $bigint_length (local.get $a)))
    (local.set $result (call $bigint_alloc (i32.const 0) (local.get $la)))
    (local.set $i (i32.const 0))
    (block $done
      (loop $copy_loop
        (br_if $done (i32.ge_u (local.get $i) (local.get $la)))
        (call $bigint_set_limb (local.get $result) (local.get $i)
          (call $bigint_limb (local.get $a) (local.get $i)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $copy_loop)
      )
    )
    (local.get $result)
  )

  ;; Trailing zero bits of a BigInt magnitude (0 for the zero BigInt).
  (func $bigint_trailing_zero_bits (param $header i32) (result i32)
    (local $len i32)
    (local $i i32)
    (local $limb i32)
    (local.set $len (call $bigint_length (local.get $header)))
    (local.set $i (i32.const 0))
    (block $done
      (loop $scan
        (br_if $done (i32.ge_u (local.get $i) (local.get $len)))
        (local.set $limb (call $bigint_limb (local.get $header) (local.get $i)))
        (if (i32.ne (local.get $limb) (i32.const 0))
          (then (return (i32.add
            (i32.mul (local.get $i) (i32.const 32))
            (i32.ctz (local.get $limb))))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $scan)
      )
    )
    (i32.const 0)
  )

  ;; Shift a BigInt magnitude right by $bits IN PLACE (no allocation),
  ;; updating the length field and normalizing. The over-read of the
  ;; limb above the current length in the select arm is discarded when
  ;; out of range — same guarded-select pattern as $bigint_sub_inplace.
  (func $bigint_shr_bits_inplace (param $header i32) (param $bits i32)
    (local $len i32)
    (local $word i32)
    (local $bit i32)
    (local $i i32)
    (local $src i32)
    (local $low i32)
    (local $high i32)
    (if (i32.eqz (local.get $bits)) (then (return)))
    (local.set $len (call $bigint_length (local.get $header)))
    (local.set $word (i32.shr_u (local.get $bits) (i32.const 5)))
    (local.set $bit (i32.and (local.get $bits) (i32.const 31)))
    (if (i32.ge_u (local.get $word) (local.get $len))
      (then
        (call $bigint_set_length (local.get $header) (i32.const 0))
        (call $bigint_normalize (local.get $header))
        (return)))
    (local.set $i (i32.const 0))
    (block $done
      (loop $shift
        (local.set $src (i32.add (local.get $i) (local.get $word)))
        (br_if $done (i32.ge_u (local.get $src) (local.get $len)))
        (local.set $low (call $bigint_limb (local.get $header) (local.get $src)))
        (local.set $high (select
          (call $bigint_limb (local.get $header) (i32.add (local.get $src) (i32.const 1)))
          (i32.const 0)
          (i32.lt_u (i32.add (local.get $src) (i32.const 1)) (local.get $len))))
        (if (i32.eqz (local.get $bit))
          (then (call $bigint_set_limb (local.get $header) (local.get $i) (local.get $low)))
          (else (call $bigint_set_limb (local.get $header) (local.get $i)
            (i32.or
              (i32.shr_u (local.get $low) (local.get $bit))
              (i32.shl (local.get $high) (i32.sub (i32.const 32) (local.get $bit)))))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $shift)
      )
    )
    (call $bigint_set_length (local.get $header) (i32.sub (local.get $len) (local.get $word)))
    (call $bigint_normalize (local.get $header))
  )

  ;; Binary (Stein) gcd of two BigInt magnitudes. Inputs may have any
  ;; sign; output is always non-negative. Returns a fresh BigInt header.
  ;;
  ;; The allocation profile is LOAD-BEARING: exactly two abs copies
  ;; plus the final shift pair (shift-count bigint + shifted result) —
  ;; the loop itself mutates the copies in place and never allocates.
  ;; The arithmetic budget estimators ($estimate_rational_add_budget
  ;; and family) rely on this O(operand-limbs) profile. A quotient/remainder
  ;; Euclidean loop allocates a pair per iteration —
  ;; Θ(limbs²) bytes worst case (Fibonacci-shaped inputs shrink ~0.7
  ;; bits per step) — which forced those budgets quadratic and made
  ;; small heaps permanently refuse legitimate multi-limb arithmetic.
  ;; The non-allocating Stein loop preserves the linear estimator; if it
  ;; ever allocates inside the loop, the estimators must grow with it.
  (func $bigint_gcd (param $a i32) (param $b i32) (result i32)
    (local $x i32)
    (local $y i32)
    (local $temp i32)
    (local $shift i32)
    (local $tz i32)
    (local $cmp i32)
    (local.set $x (call $bigint_abs_copy (local.get $a)))
    (local.set $y (call $bigint_abs_copy (local.get $b)))
    (if (i32.eqz (call $bigint_length (local.get $x)))
      (then (return (local.get $y))))
    (if (i32.eqz (call $bigint_length (local.get $y)))
      (then (return (local.get $x))))
    ;; Strip both to odd; the shared power of two is min of the strips.
    (local.set $shift (call $bigint_trailing_zero_bits (local.get $x)))
    (call $bigint_shr_bits_inplace (local.get $x) (local.get $shift))
    (local.set $tz (call $bigint_trailing_zero_bits (local.get $y)))
    (call $bigint_shr_bits_inplace (local.get $y) (local.get $tz))
    (if (i32.lt_u (local.get $tz) (local.get $shift))
      (then (local.set $shift (local.get $tz))))
    (block $done
      (loop $gcd_loop
        ;; x and y are both odd and nonzero here.
        (local.set $cmp (call $bigint_compare_magnitude (local.get $x) (local.get $y)))
        (br_if $done (i32.eqz (local.get $cmp)))
        (if (i32.lt_s (local.get $cmp) (i32.const 0))
          (then
            (local.set $temp (local.get $x))
            (local.set $x (local.get $y))
            (local.set $y (local.get $temp))))
        ;; x > y, both odd: x -= y leaves x even and nonzero; strip to odd.
        (drop (call $bigint_sub_inplace (local.get $x) (local.get $y)))
        (call $bigint_normalize (local.get $x))
        (call $bigint_shr_bits_inplace (local.get $x)
          (call $bigint_trailing_zero_bits (local.get $x)))
        (br $gcd_loop)
      )
    )
    ;; gcd = odd core << shift. gcd(|a|,|b|) ≤ min(|a|,|b|), so the
    ;; allocating shift stays O(min operand limbs).
    (call $bigint_shift_left_bits (local.get $x) (local.get $shift))
  )

  ;; Read the numeratorPointer field of a Rational heap object.
  (func $rational_numerator (param $header i32) (result i32)
    (i32.load (call $abs (i32.add (local.get $header) (global.get $GC_HEADER_SIZE))))
  )

  ;; Read the denominatorPointer field of a Rational heap object.
  (func $rational_denominator (param $header i32) (result i32)
    (i32.load (call $abs (i32.add
      (i32.add (local.get $header) (global.get $GC_HEADER_SIZE))
      (i32.const 4))))
  )

  ;; estimate_rational_size() → bytes
  ;; Worst-case heap consumption of $rational_allocate: 16 bytes
  ;; (GC header 8 + numeratorPointer 4 + denominatorPointer 4, already 16-aligned).
  ;; NOTE: this is just the Rational wrapper; the numerator/denominator
  ;; BigInts are counted separately by their own estimators.
  (func $estimate_rational_size (result i32)
    (i32.const 16)
  )

  ;; Allocate a Rational heap object with the given numerator/denominator
  ;; BigInt pointers. Does NOT normalize — caller must ensure the inputs are
  ;; already reduced and denominator > 0. Use $rational_new for normalization.
  (func $rational_allocate (param $numeratorPointer i32) (param $denominatorPointer i32) (result i32)
    (local $heap_pointer i32)
    (local $header i32)
    (local $total_size i32)
    (local $aligned i32)

    (local.set $heap_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))
    (local.set $header (local.get $heap_pointer))
    ;; Size: 8 GC header + 8 payload = 16 bytes
    (local.set $total_size (i32.const 16))
    (local.set $aligned (i32.and
      (i32.add (local.get $total_size) (i32.const 15))
      (i32.const -16)))

    ;; GC header: low 24 bits = size, upper byte = OBJ_RATIONAL
    (i32.store (call $abs (local.get $header))
      (i32.or (local.get $aligned) (i32.shl (global.get $OBJ_RATIONAL) (i32.const 24))))
    (i32.store (call $abs (i32.add (local.get $header) (i32.const 4))) (i32.const 0))

    ;; Write numerator and denominator pointers
    (i32.store (call $abs (i32.add (local.get $header) (global.get $GC_HEADER_SIZE)))
      (local.get $numeratorPointer))
    (i32.store (call $abs (i32.add
      (i32.add (local.get $header) (global.get $GC_HEADER_SIZE))
      (i32.const 4)))
      (local.get $denominatorPointer))

    (call $write_state (global.get $STATE_HEAP_POINTER)
      (i32.add (local.get $header) (local.get $aligned)))

    (local.get $header)
  )

  ;; Construct a normalized Rational from raw numerator/denominator BigInts.
  ;; Normalization:
  ;;   - If denominator is zero → returns 0 (caller must pre-check and throw).
  ;;   - Ensures denominator > 0 (sign flips moved onto numerator).
  ;;   - Divides both by gcd(|numerator|, denominator).
  ;;   - If numerator is zero → forces denominator to 1.
  (func $rational_new (param $numeratorPointer i32) (param $denominatorPointer i32) (result i32)
    (local $numerator i32)
    (local $denominator i32)
    (local $gcd i32)
    (local $numeratorSign i32)
    (local $denominatorSign i32)
    (local $resultSign i32)

    (local.set $numerator (local.get $numeratorPointer))
    (local.set $denominator (local.get $denominatorPointer))

    ;; Zero numerator → canonical 0/1
    (if (i32.eqz (call $bigint_length (local.get $numerator)))
      (then
        (return (call $rational_allocate (call $bigint_zero) (call $bigint_one)))
      )
    )

    ;; Compute result sign (xor of the two signs) and take absolute values.
    (local.set $numeratorSign (call $bigint_sign (local.get $numerator)))
    (local.set $denominatorSign (call $bigint_sign (local.get $denominator)))
    (local.set $resultSign (i32.xor (local.get $numeratorSign) (local.get $denominatorSign)))
    (local.set $numerator (call $bigint_abs_copy (local.get $numerator)))
    (local.set $denominator (call $bigint_abs_copy (local.get $denominator)))

    ;; Reduce by gcd
    (local.set $gcd (call $bigint_gcd (local.get $numerator) (local.get $denominator)))
    ;; Only divide if gcd > 1 (gcd is always >= 1 here since both magnitudes > 0)
    (if (i32.and
          (i32.eq (call $bigint_length (local.get $gcd)) (i32.const 1))
          (i32.eq (call $bigint_limb (local.get $gcd) (i32.const 0)) (i32.const 1)))
      (then
        ;; gcd == 1, no reduction needed
      )
      (else
        (local.set $numerator (call $bigint_div (local.get $numerator) (local.get $gcd)))
        (local.set $denominator (call $bigint_div (local.get $denominator) (local.get $gcd)))
      )
    )

    ;; Apply result sign to the numerator (denominator stays positive).
    (if (i32.ne (local.get $resultSign) (i32.const 0))
      (then
        (i32.store (call $abs (i32.add (local.get $numerator) (global.get $GC_HEADER_SIZE)))
          (i32.const 1))
      )
    )

    (call $rational_allocate (local.get $numerator) (local.get $denominator))
  )

  ;; Negate a Rational. Returns a fresh Rational with negated numerator.
  (func $rational_negate (param $a i32) (result i32)
    (local $numerator i32)
    (local $numeratorCopy i32)
    (local $numeratorSign i32)
    (local.set $numerator (call $rational_numerator (local.get $a)))
    ;; Zero stays zero
    (if (i32.eqz (call $bigint_length (local.get $numerator)))
      (then (return (local.get $a))))
    (local.set $numeratorCopy (call $bigint_abs_copy (local.get $numerator)))
    (local.set $numeratorSign (call $bigint_sign (local.get $numerator)))
    ;; Flip sign
    (i32.store (call $abs (i32.add (local.get $numeratorCopy) (global.get $GC_HEADER_SIZE)))
      (i32.xor (local.get $numeratorSign) (i32.const 1)))
    (call $rational_allocate (local.get $numeratorCopy) (call $rational_denominator (local.get $a)))
  )

  ;; Promote a BigInt to a Rational (denominator = 1). The BigInt header is
  ;; reused directly as the numerator pointer (safe because Rationals are
  ;; immutable).
  (func $rational_from_bigint (param $bigintHeader i32) (result i32)
    (call $rational_allocate (local.get $bigintHeader) (call $bigint_one))
  )

  ;; Add two Rationals: (a/b) + (c/d) = (a*d + c*b) / (b*d)
  ;; estimate_bigint_value_limbs(value_pointer) → i32
  ;; Returns the limb count of a TYPE_BIGINT value's heap header.
  (func $estimate_bigint_value_limbs (param $value_pointer i32) (result i32)
    (call $bigint_length (call $value_data_lo (local.get $value_pointer)))
  )

  ;; estimate_bigint_add_budget(left, right) → bytes
  ;; Bound for $bigint_add/$bigint_sub: a single bigint of
  ;; max(la, lb) + 1 limbs, plus the wrapper rational the result is
  ;; promoted to if it becomes inline-fits — most commonly nothing
  ;; beyond the bigint itself. We use 2 × estimate_bigint_size for
  ;; safety covering normalization scratch.
  (func $estimate_bigint_add_budget (param $left i32) (param $right i32) (result i32)
    (local $la i32)
    (local $lb i32)
    (local $maxLen i32)
    (local.set $la (call $estimate_bigint_value_limbs (local.get $left)))
    (local.set $lb (call $estimate_bigint_value_limbs (local.get $right)))
    (local.set $maxLen (select (local.get $la) (local.get $lb)
      (i32.gt_u (local.get $la) (local.get $lb))))
    (i32.mul (i32.const 2)
      (call $estimate_bigint_size (i32.add (local.get $maxLen) (i32.const 1))))
  )

  ;; estimate_bigint_mul_budget(left, right) → bytes
  ;; Bound for $bigint_mul: result of la + lb limbs, doubled for
  ;; normalization scratch.
  (func $estimate_bigint_mul_budget (param $left i32) (param $right i32) (result i32)
    (i32.mul (i32.const 2)
      (call $estimate_bigint_size
        (i32.add
          (call $estimate_bigint_value_limbs (local.get $left))
          (call $estimate_bigint_value_limbs (local.get $right)))))
  )

  ;; ==========================================================================
  ;; POW / SHIFT budget estimators.
  ;; POW budgets the complete square-and-multiply because $bigint_pow
  ;; runs it inside one instruction. SHL budgets from the shift amount's
  ;; value because limb count alone does not bound output size.
  ;; Unguarded interior carves could otherwise cross into the code block
  ;; before the dispatcher's collision backstop. Both estimators bound
  ;; result size and saturate on absurd inputs so refusal is clean
  ;; instead of wrapping i32.



  ;; ==========================================================================

  ;; bigint_bit_length(header) → bits of the magnitude (0 for zero).
  (func $bigint_bit_length (param $header i32) (result i32)
    (local $len i32)
    (local.set $len (call $bigint_length (local.get $header)))
    (if (i32.eqz (local.get $len)) (then (return (i32.const 0))))
    (i32.add
      (i32.mul (i32.sub (local.get $len) (i32.const 1)) (i32.const 32))
      (i32.sub (i32.const 32)
        (i32.clz (call $bigint_limb (local.get $header)
          (i32.sub (local.get $len) (i32.const 1))))))
  )

  ;; pow_exponent_value(exp_header) → saturating u31 exponent value.
  ;; Negative → 0 (the RangeError path allocates nothing; a saturated
  ;; budget there would turn a clean throw into a pressure loop).
  ;; ≥ 2 limbs or > 2^31-1 → saturate: the result-limb estimate then
  ;; saturates too and the check refuses.
  (func $pow_exponent_value (param $header i32) (result i32)
    (local $len i32)
    (local $v i32)
    (if (i32.ne (call $bigint_sign (local.get $header)) (i32.const 0))
      (then (return (i32.const 0))))
    (local.set $len (call $bigint_length (local.get $header)))
    (if (i32.eqz (local.get $len)) (then (return (i32.const 0))))
    (if (i32.ge_u (local.get $len) (i32.const 2))
      (then (return (i32.const 0x7FFFFFFF))))
    (local.set $v (call $bigint_limb (local.get $header) (i32.const 0)))
    (if (i32.gt_u (local.get $v) (i32.const 0x7FFFFFFF))
      (then (return (i32.const 0x7FFFFFFF))))
    (local.get $v)
  )

  ;; rational_exponent_value(value_pointer) → saturating u31 value of a
  ;; TYPE_RATIONAL exponent (inline i64 or heap numerator; the POW
  ;; dispatch rejects non-integer exponents before any allocation).
  (func $rational_exponent_value (param $value_pointer i32) (result i32)
    (local $v i64)
    (if (call $rational_is_inline (local.get $value_pointer))
      (then
        (local.set $v (call $rational_read_inline (local.get $value_pointer)))
        (if (i64.lt_s (local.get $v) (i64.const 0))
          (then (return (i32.const 0))))
        (if (i64.gt_u (local.get $v) (i64.const 0x7FFFFFFF))
          (then (return (i32.const 0x7FFFFFFF))))
        (return (i32.wrap_i64 (local.get $v)))))
    (call $pow_exponent_value
      (call $rational_numerator (call $value_data_lo (local.get $value_pointer))))
  )

  ;; estimate_pow_result_limbs(base_bits, exp_value) → saturating limb
  ;; count of base**exp ≈ ceil(exp × base_bits / 32) + 2. Base of 0 or
  ;; 1 bit (0, ±1) never grows. Caps at 16M limbs (64MB — larger than
  ;; any vat, so downstream size math stays inside i32 and the budget
  ;; check refuses).
  (func $estimate_pow_result_limbs (param $base_bits i32) (param $exp_value i32) (result i32)
    (local $bits64 i64)
    (if (i32.le_u (local.get $base_bits) (i32.const 1))
      (then (return (i32.const 1))))
    (local.set $bits64
      (i64.mul (i64.extend_i32_u (local.get $base_bits))
               (i64.extend_i32_u (local.get $exp_value))))
    (if (i64.gt_u (local.get $bits64) (i64.const 0x10000000))
      (then (return (i32.const 0xFFFFFF))))
    (i32.add (i32.wrap_i64 (i64.div_u (local.get $bits64) (i64.const 32))) (i32.const 2))
  )

  ;; sat_budget_mul(count, size) → bytes. i64-saturating count × size,
  ;; capped at 512MB so budget sums stay inside i32 while still
  ;; refusing on any real vat.
  (func $sat_budget_mul (param $count i32) (param $size i32) (result i32)
    (local $p i64)
    (local.set $p
      (i64.mul (i64.extend_i32_u (local.get $count)) (i64.extend_i32_u (local.get $size))))
    (if (i64.gt_u (local.get $p) (i64.const 0x20000000))
      (then (return (i32.const 0x20000000))))
    (i32.wrap_i64 (local.get $p))
  )

  ;; estimate_rational_pow_budget(base_value_pointer, exp_sat) → bytes.
  ;; rational_pow = bigint_pow(num) + bigint_pow(den) + rational_new.
  ;; The square-and-multiply chains' intermediates grow geometrically,
  ;; so their total is bounded by 8 × the final size each. rational_new
  ;; runs the (binary, allocation-free-loop) gcd on the two powers:
  ;; denominator-1 bases (the common integer-valued case) make it a
  ;; single trivial division; true fractions get the same
  ;; constant-count bound the add/mul budgets use, evaluated at the
  ;; RESULT sizes.
  (func $estimate_rational_pow_budget (param $base_vp i32) (param $exp_sat i32) (result i32)
    (local $num_bits i32)
    (local $den_bits i32)
    (local $rn i32)
    (local $rd i32)
    (local $max_limbs i32)
    (local $budget i32)
    (local $v i64)
    (if (call $rational_is_inline (local.get $base_vp))
      (then
        (local.set $v (call $rational_read_inline (local.get $base_vp)))
        (if (i64.lt_s (local.get $v) (i64.const 0))
          (then (local.set $v (i64.sub (i64.const 0) (local.get $v)))))
        (local.set $num_bits (i32.wrap_i64 (i64.sub (i64.const 64) (i64.clz (local.get $v)))))
        (local.set $den_bits (i32.const 1)))
      (else
        (local.set $num_bits (call $bigint_bit_length
          (call $rational_numerator (call $value_data_lo (local.get $base_vp)))))
        (local.set $den_bits (call $bigint_bit_length
          (call $rational_denominator (call $value_data_lo (local.get $base_vp)))))))
    (local.set $rn (call $estimate_pow_result_limbs (local.get $num_bits) (local.get $exp_sat)))
    (local.set $rd (call $estimate_pow_result_limbs (local.get $den_bits) (local.get $exp_sat)))
    (local.set $budget
      (i32.add
        (call $sat_budget_mul (i32.const 8) (call $estimate_bigint_size (local.get $rn)))
        (call $sat_budget_mul (i32.const 8) (call $estimate_bigint_size (local.get $rd)))))
    (if (i32.le_u (local.get $rd) (i32.const 1))
      (then
        (local.set $budget (i32.add (local.get $budget)
          (call $sat_budget_mul (i32.const 4) (call $estimate_bigint_size (local.get $rn))))))
      (else
        (local.set $max_limbs (select (local.get $rn) (local.get $rd)
          (i32.gt_u (local.get $rn) (local.get $rd))))
        ;; True-fraction base: rational_new's gcd + reduction at the
        ;; result sizes — constant object count now that the binary
        ;; gcd loop is allocation-free (see $bigint_gcd).
        (local.set $budget (i32.add (local.get $budget)
          (call $sat_budget_mul (i32.const 32)
            (call $estimate_bigint_size (i32.add (local.get $max_limbs) (i32.const 2))))))))
    (i32.add (local.get $budget) (i32.mul (i32.const 3) (call $estimate_rational_size)))
  )

  ;; estimate_complex_pow_budget(base_value_pointer, exp_sat) → bytes.
  ;; complex_pow square-and-multiplies via complex_mul (~6 rational
  ;; ops per multiply, each ≤ ~17 bigints of ≤ 4r + 4 limbs at result
  ;; component size r — the cross products of component products; see
  ;; $estimate_rational_add_budget's accounting). One complex_mul at
  ;; the result size is therefore ≤ 128 slots; the chain's sizes grow
  ;; geometrically and its per-step cost is linear in size, so the
  ;; whole series is ≤ 4 × the final multiply.
  (func $estimate_complex_pow_budget (param $base_vp i32) (param $exp_sat i32) (result i32)
    (local $header i32)
    (local $bits i32)
    (local $b i32)
    (local $r i32)
    (local.set $header (call $value_data_lo (local.get $base_vp)))
    (local.set $bits (call $bigint_bit_length
      (call $rational_numerator (call $complex_real (local.get $header)))))
    (local.set $b (call $bigint_bit_length
      (call $rational_denominator (call $complex_real (local.get $header)))))
    (if (i32.gt_u (local.get $b) (local.get $bits)) (then (local.set $bits (local.get $b))))
    (local.set $b (call $bigint_bit_length
      (call $rational_numerator (call $complex_imaginary (local.get $header)))))
    (if (i32.gt_u (local.get $b) (local.get $bits)) (then (local.set $bits (local.get $b))))
    (local.set $b (call $bigint_bit_length
      (call $rational_denominator (call $complex_imaginary (local.get $header)))))
    (if (i32.gt_u (local.get $b) (local.get $bits)) (then (local.set $bits (local.get $b))))
    (local.set $r (call $estimate_pow_result_limbs (local.get $bits) (local.get $exp_sat)))
    (i32.add
      (call $sat_budget_mul (i32.const 512)
        (call $estimate_bigint_size
          (i32.add (i32.mul (i32.const 4) (local.get $r)) (i32.const 4))))
      (i32.add
        (i32.mul (i32.const 8) (call $estimate_rational_size))
        (i32.mul (i32.const 2) (call $estimate_complex_size))))
  )

  ;; estimate_pow_budget(base_value_pointer, exp_value_pointer) → bytes.
  ;; Type-dispatching bound for every allocating OP_POW combo
  ;; (bigint**bigint, rational**bigint, rational**rational,
  ;; complex**bigint). Non-allocating combos (f64 fallbacks) cost 0;
  ;; combos that only reach a throw keep the generic cross-type bound.
  (func $estimate_pow_budget (param $vp1 i32) (param $vp2 i32) (result i32)
    (local $type1 i32)
    (local $type2 i32)
    (local $exp_sat i32)
    (local.set $type1 (call $value_type (local.get $vp1)))
    (local.set $type2 (call $value_type (local.get $vp2)))
    (if (i32.eq (local.get $type2) (global.get $TYPE_BIGINT))
      (then (local.set $exp_sat (call $pow_exponent_value (call $value_data_lo (local.get $vp2)))))
      (else
        (if (i32.eq (local.get $type2) (global.get $TYPE_RATIONAL))
          (then (local.set $exp_sat (call $rational_exponent_value (local.get $vp2))))
          (else
            ;; Complex (or other) exponent: no allocating combo — keep
            ;; the generic cross-type bound for the throw paths.
            (return (call $estimate_cross_type_arith_budget (local.get $vp1) (local.get $vp2)))))))
    (if (i32.eq (local.get $type1) (global.get $TYPE_BIGINT))
      (then
        (return (call $sat_budget_mul (i32.const 8)
          (call $estimate_bigint_size
            (call $estimate_pow_result_limbs
              (call $bigint_bit_length (call $value_data_lo (local.get $vp1)))
              (local.get $exp_sat)))))))
    (if (i32.eq (local.get $type1) (global.get $TYPE_RATIONAL))
      (then (return (call $estimate_rational_pow_budget (local.get $vp1) (local.get $exp_sat)))))
    (if (i32.eq (local.get $type1) (global.get $TYPE_COMPLEX))
      (then (return (call $estimate_complex_pow_budget (local.get $vp1) (local.get $exp_sat)))))
    ;; Integer/Float base with bigint/rational exponent: f64 fallback.
    (i32.const 0)
  )

  ;; estimate_bigint_shift_budget(value_pointer, shift_pointer) → bytes.
  ;; Mirrors $bigint_shift_left's own allocation formula: it reads ONLY
  ;; limb 0 of a non-negative shift amount and allocates
  ;; old_len + limb0/32 + 1 limbs. A negative shift delegates to
  ;; shift_right (≤ old_len limbs), which this bound also covers.
  (func $estimate_bigint_shift_budget (param $value_vp i32) (param $shift_vp i32) (result i32)
    (local $shift_header i32)
    (local $extra_limbs i32)
    (local.set $shift_header (call $value_data_lo (local.get $shift_vp)))
    (local.set $extra_limbs (i32.const 0))
    (if (i32.and
          (i32.ne (call $bigint_length (local.get $shift_header)) (i32.const 0))
          (i32.eqz (call $bigint_sign (local.get $shift_header))))
      (then (local.set $extra_limbs
        (i32.div_u (call $bigint_limb (local.get $shift_header) (i32.const 0)) (i32.const 32)))))
    (i32.mul (i32.const 2)
      (call $estimate_bigint_size
        (i32.add
          (i32.add
            (call $bigint_length (call $value_data_lo (local.get $value_vp)))
            (local.get $extra_limbs))
          (i32.const 2))))
  )

  ;; estimate_bigint_neg_budget(value_pointer) → bytes
  ;; Bound for $bigint negate: copies the magnitude into a new bigint
  ;; via $bigint_add_magnitude (one bigint of N+1 limbs).
  (func $estimate_bigint_neg_budget (param $value_pointer i32) (result i32)
    (i32.mul (i32.const 2)
      (call $estimate_bigint_size
        (i32.add (call $estimate_bigint_value_limbs (local.get $value_pointer))
                 (i32.const 1))))
  )

  ;; estimate_rational_neg_budget(value_pointer) → bytes
  ;; Bound for $rational_negate after $rational_materialize: at most
  ;; one materialize (bigint + rational) + bigint_abs_copy + rational
  ;; wrapper. Use a generous bound — 4 bigints of N+1 limbs + 3
  ;; rationals.
  (func $estimate_rational_neg_budget (param $value_pointer i32) (result i32)
    (local $maxLen i32)
    (local.set $maxLen (call $estimate_rational_value_limbs (local.get $value_pointer)))
    (i32.add
      (i32.mul (i32.const 4)
        (call $estimate_bigint_size (i32.add (local.get $maxLen) (i32.const 1))))
      (i32.mul (i32.const 3) (call $estimate_rational_size)))
  )

  ;; estimate_complex_neg_budget(value_pointer) → bytes
  ;; Bound for $complex_negate: 2 × $rational_negate (one per
  ;; component) + 1 × $complex_allocate (the result wrapper). The
  ;; per-component rational_negate uses the larger of the real and
  ;; imaginary parts as the limb count, so we pass through
  ;; $estimate_numeric_value_limbs to get the larger of the two and
  ;; bound from there.
  (func $estimate_complex_neg_budget (param $value_pointer i32) (result i32)
    (local $maxLen i32)
    (local.set $maxLen (call $estimate_numeric_value_limbs (local.get $value_pointer)))
    (i32.add
      ;; 2 × rational_negate worth of bigint allocations (8 bigints of N+1 limbs).
      (i32.mul (i32.const 8)
        (call $estimate_bigint_size (i32.add (local.get $maxLen) (i32.const 1))))
      ;; 2 × rational wrappers + 1 × complex header.
      (i32.add
        (i32.mul (i32.const 2) (call $estimate_rational_size))
        (call $estimate_complex_size)))
  )

  ;; estimate_rational_value_limbs(value_pointer) → i32
  ;; Returns the larger of (numerator limbs, denominator limbs) for a
  ;; Rational value. Inline rationals are bounded by 2 limbs (i64 fits
  ;; in at most 2 limbs). Heap rationals use the actual BigInt lengths.
  (func $estimate_rational_value_limbs (param $value_pointer i32) (result i32)
    (local $header i32)
    (local $numLen i32)
    (local $denLen i32)
    (if (call $rational_is_inline (local.get $value_pointer))
      (then (return (i32.const 2))))
    (local.set $header (call $value_data_lo (local.get $value_pointer)))
    (local.set $numLen (call $bigint_length (call $rational_numerator (local.get $header))))
    (local.set $denLen (call $bigint_length (call $rational_denominator (local.get $header))))
    (select (local.get $numLen) (local.get $denLen)
      (i32.gt_u (local.get $numLen) (local.get $denLen)))
  )

  ;; estimate_numeric_value_limbs(value_pointer) → i32
  ;; Type-agnostic limb estimator for any numeric value used as an
  ;; operand of cross-type arithmetic. For TYPE_RATIONAL: max of
  ;; numerator and denominator limbs. For TYPE_BIGINT: bigint length.
  ;; For TYPE_COMPLEX: max of real and imaginary parts. For
  ;; TYPE_INTEGER / TYPE_FLOAT / other: 2 limbs (i64 fits).
  (func $estimate_numeric_value_limbs (param $value_pointer i32) (result i32)
    (local $type i32)
    (local $header i32)
    (local $realLen i32)
    (local $imagLen i32)
    (local.set $type (call $value_type (local.get $value_pointer)))
    (if (i32.eq (local.get $type) (global.get $TYPE_RATIONAL))
      (then (return (call $estimate_rational_value_limbs (local.get $value_pointer)))))
    (if (i32.eq (local.get $type) (global.get $TYPE_BIGINT))
      (then (return (call $bigint_length (call $value_data_lo (local.get $value_pointer))))))
    (if (i32.eq (local.get $type) (global.get $TYPE_COMPLEX))
      (then
        (local.set $header (call $value_data_lo (local.get $value_pointer)))
        ;; Complex stores realPointer + imaginaryPointer (both Rational headers).
        (local.set $realLen (call $bigint_length
          (call $rational_numerator (call $complex_real (local.get $header)))))
        (local.set $imagLen (call $bigint_length
          (call $rational_numerator (call $complex_imaginary (local.get $header)))))
        (return (select (local.get $realLen) (local.get $imagLen)
          (i32.gt_u (local.get $realLen) (local.get $imagLen))))))
    ;; Default for Integer/Float/other: bounded by i64.
    (i32.const 2)
  )

  ;; estimate_cross_type_arith_budget(left, right) → bytes
  ;; Conservative bound for any cross-type rational/bigint/complex
  ;; arithmetic op (OP_ADD/SUB/MUL/DIV/MOD/POW with mixed-type
  ;; operands), including compound consumers (numeric gcd/lcm,
  ;; expression numeric folds). Per rational op, allocation is ~17
  ;; bigints of ≤ (combined-limbs + 2) each ($estimate_rational_add_
  ;; budget's accounting — binary gcd allocates nothing per
  ;; iteration); intermediates of compound ops can hold products, so
  ;; combined limbs here is 2 × sumLen. Count: 128 slots covers ~7
  ;; rational ops. COMPLEX operands quadruple it (complex_div is ~11
  ;; rational ops at component sizes; 4 × 128 covers it with margin).
  (func $estimate_cross_type_arith_budget (param $left i32) (param $right i32) (result i32)
    (local $sumLen i32)
    (local $bigintCount i32)
    (local.set $sumLen
      (i32.add
        (call $estimate_numeric_value_limbs (local.get $left))
        (call $estimate_numeric_value_limbs (local.get $right))))
    (local.set $bigintCount (i32.const 128))
    (if (i32.or
          (i32.eq (call $value_type (local.get $left)) (global.get $TYPE_COMPLEX))
          (i32.eq (call $value_type (local.get $right)) (global.get $TYPE_COMPLEX)))
      (then (local.set $bigintCount (i32.const 512))))
    (i32.add
      (call $sat_budget_mul (local.get $bigintCount)
        (call $estimate_bigint_size
          (i32.add (i32.mul (i32.const 2) (local.get $sumLen)) (i32.const 2))))
      (i32.mul (i32.const 8) (call $estimate_rational_size)))
  )

  ;; estimate_expression_op_budget() → bytes
  ;; Conservative budget for any Expression.* binary operation
  ;; (add/subtract/multiply/divide/power) and unary (negate).
  ;;
  ;; Each Expression op allocates:
  ;;   - 1 args array (allocate_array cap 2): ~64 bytes.
  ;;   - 1 Expression node (16 bytes) via expression_allocate.
  ;;   - Simplifier recursion: builds intermediate Expression nodes +
  ;;     args arrays, possibly desugars (subtract → Negate+Add adds 4
  ;;     allocations; divide → Power+Multiply adds 4).
  ;;
  ;; Use a fixed generous budget (~6 KB = ~80 Expression nodes worth)
  ;; that covers typical simplifications. Walking the input expression
  ;; to count slots would require a pure-counting walk that does not
  ;; allocate. Pathological deeply nested expressions therefore surface
  ;; as persistent pressure and eventually OOM.



  (func $estimate_expression_op_budget (result i32)
    ;; 80 × (estimate_expression_size + estimate_array_size(2))
    ;; = 80 × (16 + 24 + 8 + 32) = 80 × 80 = 6400 bytes.
    (i32.mul (i32.const 80)
      (i32.add
        (call $estimate_expression_size)
        (call $estimate_array_size (i32.const 2))))
  )

  ;; estimate_rational_add_budget(left, right) → bytes
  ;; Worst-case heap budget for any heap-path rational arithmetic op
  ;; (add/sub/mul/div/mod). With sumLen the combined operand limbs,
  ;; every bigint allocated anywhere in the op is ≤ sumLen + 2 limbs:
  ;; the op's own cross products (≤ sumLen, the add result +1), then
  ;; $rational_new — 2 abs copies, $bigint_gcd (2 abs copies + the
  ;; final shift pair; the binary-gcd loop is in-place and allocates
  ;; NOTHING per iteration — see $bigint_gcd's contract comment), and
  ;; when gcd > 1 two $bigint_div calls (quotient at full dividend
  ;; length, remainder, at most one extra copy each). Counting: 4 (op)
  ;; + 4 (copies) + 2 (shift pair) + 6 (divisions) + canonicals ≈ 17
  ;; objects. Bound: 32 slots of (sumLen + 2) limbs plus 6 rationals —
  ;; ~2× the counted worst case, and O(sumLen) so multi-limb workloads
  ;; remains practical on small heaps; the binary Stein GCD keeps
  ;; this bound linear rather than the quadratic Euclidean bound.
  (func $estimate_rational_add_budget (param $left i32) (param $right i32) (result i32)
    (local $sumLen i32)
    (local.set $sumLen
      (i32.add
        (call $estimate_rational_value_limbs (local.get $left))
        (call $estimate_rational_value_limbs (local.get $right))))
    (i32.add
      (call $sat_budget_mul (i32.const 32)
        (call $estimate_bigint_size (i32.add (local.get $sumLen) (i32.const 2))))
      (i32.mul (i32.const 6) (call $estimate_rational_size)))
  )

  (func $rational_add (param $left i32) (param $right i32) (result i32)
    (local $leftNumerator i32)
    (local $leftDenominator i32)
    (local $rightNumerator i32)
    (local $rightDenominator i32)
    (local $crossLeft i32)
    (local $crossRight i32)
    (local $resultNumerator i32)
    (local $resultDenominator i32)
    (local.set $leftNumerator (call $rational_numerator (local.get $left)))
    (local.set $leftDenominator (call $rational_denominator (local.get $left)))
    (local.set $rightNumerator (call $rational_numerator (local.get $right)))
    (local.set $rightDenominator (call $rational_denominator (local.get $right)))
    (local.set $crossLeft (call $bigint_mul (local.get $leftNumerator) (local.get $rightDenominator)))
    (local.set $crossRight (call $bigint_mul (local.get $rightNumerator) (local.get $leftDenominator)))
    (local.set $resultNumerator (call $bigint_add (local.get $crossLeft) (local.get $crossRight)))
    (local.set $resultDenominator (call $bigint_mul (local.get $leftDenominator) (local.get $rightDenominator)))
    (call $rational_new (local.get $resultNumerator) (local.get $resultDenominator))
  )

  ;; Subtract: (a/b) - (c/d) = (a*d - c*b) / (b*d)
  (func $rational_sub (param $left i32) (param $right i32) (result i32)
    (local $leftNumerator i32)
    (local $leftDenominator i32)
    (local $rightNumerator i32)
    (local $rightDenominator i32)
    (local $crossLeft i32)
    (local $crossRight i32)
    (local $resultNumerator i32)
    (local $resultDenominator i32)
    (local.set $leftNumerator (call $rational_numerator (local.get $left)))
    (local.set $leftDenominator (call $rational_denominator (local.get $left)))
    (local.set $rightNumerator (call $rational_numerator (local.get $right)))
    (local.set $rightDenominator (call $rational_denominator (local.get $right)))
    (local.set $crossLeft (call $bigint_mul (local.get $leftNumerator) (local.get $rightDenominator)))
    (local.set $crossRight (call $bigint_mul (local.get $rightNumerator) (local.get $leftDenominator)))
    (local.set $resultNumerator (call $bigint_sub (local.get $crossLeft) (local.get $crossRight)))
    (local.set $resultDenominator (call $bigint_mul (local.get $leftDenominator) (local.get $rightDenominator)))
    (call $rational_new (local.get $resultNumerator) (local.get $resultDenominator))
  )

  ;; Multiply: (a/b) * (c/d) = (a*c) / (b*d)
  (func $rational_mul (param $left i32) (param $right i32) (result i32)
    (local $resultNumerator i32)
    (local $resultDenominator i32)
    (local.set $resultNumerator (call $bigint_mul
      (call $rational_numerator (local.get $left))
      (call $rational_numerator (local.get $right))))
    (local.set $resultDenominator (call $bigint_mul
      (call $rational_denominator (local.get $left))
      (call $rational_denominator (local.get $right))))
    (call $rational_new (local.get $resultNumerator) (local.get $resultDenominator))
  )

  ;; Divide: (a/b) / (c/d) = (a*d) / (b*c). Returns 0 if right is zero
  ;; (caller must detect this condition and throw RangeError).
  (func $rational_div (param $left i32) (param $right i32) (result i32)
    (local $resultNumerator i32)
    (local $resultDenominator i32)
    (local.set $resultNumerator (call $bigint_mul
      (call $rational_numerator (local.get $left))
      (call $rational_denominator (local.get $right))))
    (local.set $resultDenominator (call $bigint_mul
      (call $rational_denominator (local.get $left))
      (call $rational_numerator (local.get $right))))
    (call $rational_new (local.get $resultNumerator) (local.get $resultDenominator))
  )

  ;; Structural equality between two Rationals (both reduced, denominator > 0).
  ;; Returns 1 for equal, 0 otherwise.
  (func $rational_eq (param $left i32) (param $right i32) (result i32)
    (if (i32.ne
          (call $bigint_compare
            (call $rational_numerator (local.get $left))
            (call $rational_numerator (local.get $right)))
          (i32.const 0))
      (then (return (i32.const 0))))
    (if (i32.ne
          (call $bigint_compare
            (call $rational_denominator (local.get $left))
            (call $rational_denominator (local.get $right)))
          (i32.const 0))
      (then (return (i32.const 0))))
    (i32.const 1)
  )

  ;; Semantic equality spanning Rational and BigInt. Returns 1 if a and b
  ;; represent the same rational number, 0 otherwise.
  ;; Expects left/right already known to be RATIONAL or BIGINT.
  (func $rational_bigint_semantic_eq (param $rational i32) (param $bigint i32) (result i32)
    ;; A Rational equals a BigInt iff the Rational's denominator is 1 and
    ;; its numerator equals the BigInt.
    (local $denominator i32)
    (local.set $denominator (call $rational_denominator (local.get $rational)))
    (if (i32.or
          (i32.ne (call $bigint_length (local.get $denominator)) (i32.const 1))
          (i32.ne (call $bigint_limb (local.get $denominator) (i32.const 0)) (i32.const 1)))
      (then (return (i32.const 0))))
    (i32.eqz (call $bigint_compare
      (call $rational_numerator (local.get $rational))
      (local.get $bigint)))
  )

  ;; Power: rational ** integerExponent. Exponent must be a non-negative
  ;; integer-valued BigInt. Returns 0 on invalid exponent (caller throws).
  (func $rational_pow (param $base i32) (param $exponentBigint i32) (result i32)
    (local $numeratorResult i32)
    (local $denominatorResult i32)
    ;; Negative exponent: flip base to reciprocal, negate exponent magnitude.
    ;; For simplicity in Phase 1a we only support non-negative exponents and
    ;; let the OP dispatch reject negative cases.
    (if (i32.ne (call $bigint_sign (local.get $exponentBigint)) (i32.const 0))
      (then (return (i32.const 0))))
    (local.set $numeratorResult (call $bigint_pow
      (call $rational_numerator (local.get $base))
      (local.get $exponentBigint)))
    (local.set $denominatorResult (call $bigint_pow
      (call $rational_denominator (local.get $base))
      (local.get $exponentBigint)))
    (call $rational_new (local.get $numeratorResult) (local.get $denominatorResult))
  )

  ;; Push a Rational value to the pending stack, choosing the inline
  ;; representation when the value is an integer whose numerator fits in
  ;; signed i64. Otherwise pushes the heap form. This is the default:
  ;; every rational arithmetic result flows through here and benefits from
  ;; the small-integer fast path without changing callsites.
  (func $push_rational (param $header i32)
    (if (call $rational_denominator_is_one (local.get $header))
      (then
        (if (call $bigint_to_i64_fits (call $rational_numerator (local.get $header)))
          (then
            (call $push_rational_inline (global.get $bigint_to_i64_value))
            (return)))))
    (call $pending_push (global.get $TYPE_RATIONAL) (i32.const 0) (local.get $header) (i32.const 0))
  )

  ;; Explicit heap-only push (for callsites that must preserve heap form,
  ;; e.g. when a value will be mutated). Currently unused but kept for
  ;; clarity and potential future need.
  (func $push_rational_heap (param $header i32)
    (call $pending_push (global.get $TYPE_RATIONAL) (i32.const 0) (local.get $header) (i32.const 0))
  )

  ;; ==========================================================================
  ;; Inline small-Rational fast path — Phase 1c.
  ;;
  ;; An inline small-Rational is a TYPE_RATIONAL value slot with
  ;; FLAG_RATIONAL_INLINE set in the flags field. The [data_lo:4][data_hi:4]
  ;; payload carries a signed i64 numerator; the denominator is implicitly 1.
  ;; No heap object exists for an inline value — it is pure-stack.
  ;;
  ;; Overflow handling: arithmetic on two inline inputs is performed as
  ;; i64 operations with overflow detection. If overflow would occur, the
  ;; caller promotes both inputs to heap Rationals and falls back to the
  ;; existing $rational_* helpers.
  ;; ==========================================================================

  ;; Check whether a TYPE_RATIONAL value at the given slot pointer is inline.
  (func $rational_is_inline (param $value_pointer i32) (result i32)
    (i32.and
      (call $value_flags (local.get $value_pointer))
      (global.get $FLAG_RATIONAL_INLINE))
  )

  ;; Read the inline i64 numerator from a Rational value slot. Caller must
  ;; have verified the slot is inline.
  (func $rational_read_inline (param $value_pointer i32) (result i64)
    (i64.or
      (i64.extend_i32_u (call $value_data_lo (local.get $value_pointer)))
      (i64.shl
        (i64.extend_i32_u (call $value_data_hi (local.get $value_pointer)))
        (i64.const 32)))
  )

  ;; Push an inline small-Rational (numerator in i64, denominator implicit 1).
  (func $push_rational_inline (param $numerator i64)
    (call $pending_push
      (global.get $TYPE_RATIONAL)
      (global.get $FLAG_RATIONAL_INLINE)
      (i32.wrap_i64 (local.get $numerator))
      (i32.wrap_i64 (i64.shr_u (local.get $numerator) (i64.const 32))))
  )

  ;; Allocate a BigInt heap object holding the given signed i64 value.
  ;; Used to materialize an inline numerator when we need to fall back to
  ;; heap-path arithmetic.
  (func $bigint_from_i64 (param $value i64) (result i32)
    (local $sign i32)
    (local $magnitude i64)
    (local $lowLimb i32)
    (local $highLimb i32)
    (local $header i32)

    (if (i64.eqz (local.get $value))
      (then (return (call $bigint_zero))))

    (if (i64.lt_s (local.get $value) (i64.const 0))
      (then
        (local.set $sign (i32.const 1))
        (local.set $magnitude (i64.sub (i64.const 0) (local.get $value))))
      (else
        (local.set $sign (i32.const 0))
        (local.set $magnitude (local.get $value))))

    (local.set $lowLimb (i32.wrap_i64 (local.get $magnitude)))
    (local.set $highLimb (i32.wrap_i64 (i64.shr_u (local.get $magnitude) (i64.const 32))))

    (if (i32.eqz (local.get $highLimb))
      (then
        ;; Single-limb BigInt
        (local.set $header (call $bigint_alloc (local.get $sign) (i32.const 1)))
        (call $bigint_set_limb (local.get $header) (i32.const 0) (local.get $lowLimb))
        (return (local.get $header))))

    ;; Two-limb BigInt
    (local.set $header (call $bigint_alloc (local.get $sign) (i32.const 2)))
    (call $bigint_set_limb (local.get $header) (i32.const 0) (local.get $lowLimb))
    (call $bigint_set_limb (local.get $header) (i32.const 1) (local.get $highLimb))
    (local.get $header)
  )

  ;; Build a fresh heap BigInt from the i64 element at $byte_address
  ;; (absolute), interpreting the bits as signed for BigInt64Array and
  ;; unsigned for BigUint64Array. Shared by GET_INDEX, the typed-array
  ;; iterator's .next(), and OBJ_MERGE_SPREAD. $bigint_alloc allocates
  ;; blindly — callers pre-check $estimate_bigint_size(2).
  (func $bigint_from_typed_i64 (param $array_type i32) (param $byte_address i32) (result i32)
    (local $value i64)
    (local $header i32)

    (local.set $value (i64.load (local.get $byte_address)))

    (if (i32.and
          (i32.eq (local.get $array_type) (global.get $TYPE_BIGINT64ARRAY))
          (i64.lt_s (local.get $value) (i64.const 0)))
      (then
        ;; Negative: negate to get magnitude, set sign=1
        (local.set $value (i64.sub (i64.const 0) (local.get $value)))
        (local.set $header (call $bigint_alloc (i32.const 1) (i32.const 2)))
        (call $bigint_set_limb (local.get $header) (i32.const 0)
          (i32.wrap_i64 (local.get $value)))
        (call $bigint_set_limb (local.get $header) (i32.const 1)
          (i32.wrap_i64 (i64.shr_u (local.get $value) (i64.const 32))))
      )
      (else
        (if (i64.eqz (local.get $value))
          (then
            (local.set $header (call $bigint_alloc (i32.const 0) (i32.const 0)))
          )
          (else
            (local.set $header (call $bigint_alloc (i32.const 0) (i32.const 2)))
            (call $bigint_set_limb (local.get $header) (i32.const 0)
              (i32.wrap_i64 (local.get $value)))
            (call $bigint_set_limb (local.get $header) (i32.const 1)
              (i32.wrap_i64 (i64.shr_u (local.get $value) (i64.const 32))))
          )
        )
      )
    )
    (call $bigint_normalize (local.get $header))
    (local.get $header)
  )

  ;; Inverse of $bigint_from_typed_i64: the i64 bit pattern a BigInt heap
  ;; value stores into a BigInt64Array/BigUint64Array element. Low 64 bits
  ;; of the magnitude, negated for a negative sign on the signed array
  ;; type (matches the long-standing SET_INDEX convention; a negative
  ;; BigInt stored into BigUint64Array keeps its raw magnitude rather
  ;; than the spec's mod-2^64 wrap). Shared by SET_INDEX, the
  ;; constructors' seeding loops, and TypedArray.from/of.
  (func $bigint_to_typed_i64 (param $array_type i32) (param $header i32) (result i64)
    (local $value i64)
    (local.set $value (i64.const 0))
    (if (i32.ge_u (call $bigint_length (local.get $header)) (i32.const 1))
      (then
        (local.set $value (i64.extend_i32_u
          (call $bigint_limb (local.get $header) (i32.const 0))))))
    (if (i32.ge_u (call $bigint_length (local.get $header)) (i32.const 2))
      (then
        (local.set $value (i64.or
          (local.get $value)
          (i64.shl
            (i64.extend_i32_u (call $bigint_limb (local.get $header) (i32.const 1)))
            (i64.const 32))))))
    (if (i32.and
          (i32.eq (local.get $array_type) (global.get $TYPE_BIGINT64ARRAY))
          (i32.ne (call $bigint_sign (local.get $header)) (i32.const 0)))
      (then (local.set $value (i64.sub (i64.const 0) (local.get $value)))))
    (local.get $value)
  )

  ;; Materialize a Rational value slot into a heap Rational header pointer.
  ;; If the value is already heap, just reads data_lo. If inline, allocates
  ;; a fresh heap Rational with numerator = inline i64, denominator = 1.
  (func $rational_materialize (param $value_pointer i32) (result i32)
    (local $numeratorBigInt i32)
    (if (call $rational_is_inline (local.get $value_pointer))
      (then
        (local.set $numeratorBigInt
          (call $bigint_from_i64 (call $rational_read_inline (local.get $value_pointer))))
        (return (call $rational_allocate (local.get $numeratorBigInt) (call $bigint_one)))))
    (call $value_data_lo (local.get $value_pointer))
  )

  ;; Try to convert a heap BigInt header to a signed i64, returning whether
  ;; it fits. Output in a pair of globals (we use $inline_convert_result
  ;; for the value and return 1 if fit, 0 otherwise).
  (func $bigint_to_i64_fits (param $header i32) (result i32)
    (local $length i32)
    (local $sign i32)
    (local $low i32)
    (local $high i32)
    (local $value i64)

    (local.set $length (call $bigint_length (local.get $header)))
    (local.set $sign (call $bigint_sign (local.get $header)))

    (if (i32.eqz (local.get $length))
      (then
        (global.set $bigint_to_i64_value (i64.const 0))
        (return (i32.const 1))))

    (if (i32.gt_u (local.get $length) (i32.const 2))
      (then (return (i32.const 0))))

    (local.set $low (call $bigint_limb (local.get $header) (i32.const 0)))
    (if (i32.eq (local.get $length) (i32.const 1))
      (then (local.set $high (i32.const 0)))
      (else (local.set $high (call $bigint_limb (local.get $header) (i32.const 1)))))

    (local.set $value
      (i64.or
        (i64.extend_i32_u (local.get $low))
        (i64.shl (i64.extend_i32_u (local.get $high)) (i64.const 32))))

    ;; Check magnitude fits in signed i64. For positive values, top bit must
    ;; be clear (magnitude ≤ 2^63 - 1). For negative values, the magnitude
    ;; may be up to 2^63 (which negates to i64.MIN).
    (if (i32.eqz (local.get $sign))
      (then
        (if (i64.lt_s (local.get $value) (i64.const 0))
          (then (return (i32.const 0))))
        (global.set $bigint_to_i64_value (local.get $value))
        (return (i32.const 1))))

    ;; Negative: magnitude <= 2^63. If magnitude == 2^63 exactly, result is i64.MIN.
    (if (i64.gt_u (local.get $value)
          (i64.const 0x8000000000000000))
      (then (return (i32.const 0))))
    (global.set $bigint_to_i64_value (i64.sub (i64.const 0) (local.get $value)))
    (i32.const 1)
  )

  ;; Detect i64 signed add overflow. Returns 1 if a + b overflowed, 0 if not.
  ;; Overflow pattern: both operands same sign, result has opposite sign.
  (func $i64_add_overflowed (param $a i64) (param $b i64) (param $result i64) (result i32)
    ;; Both positive (>= 0) and result negative → overflow
    (if (i32.and
          (i32.and
            (i64.ge_s (local.get $a) (i64.const 0))
            (i64.ge_s (local.get $b) (i64.const 0)))
          (i64.lt_s (local.get $result) (i64.const 0)))
      (then (return (i32.const 1))))
    ;; Both negative and result non-negative → overflow
    (if (i32.and
          (i32.and
            (i64.lt_s (local.get $a) (i64.const 0))
            (i64.lt_s (local.get $b) (i64.const 0)))
          (i64.ge_s (local.get $result) (i64.const 0)))
      (then (return (i32.const 1))))
    (i32.const 0)
  )

  ;; Detect i64 signed sub overflow: a - b = result.
  ;; Overflow if a and b have different signs and result has different sign from a.
  (func $i64_sub_overflowed (param $a i64) (param $b i64) (param $result i64) (result i32)
    ;; a >= 0, b < 0, result < 0 → overflow
    (if (i32.and
          (i32.and
            (i64.ge_s (local.get $a) (i64.const 0))
            (i64.lt_s (local.get $b) (i64.const 0)))
          (i64.lt_s (local.get $result) (i64.const 0)))
      (then (return (i32.const 1))))
    ;; a < 0, b >= 0, result >= 0 → overflow
    (if (i32.and
          (i32.and
            (i64.lt_s (local.get $a) (i64.const 0))
            (i64.ge_s (local.get $b) (i64.const 0)))
          (i64.ge_s (local.get $result) (i64.const 0)))
      (then (return (i32.const 1))))
    (i32.const 0)
  )

  ;; Detect i64 signed mul overflow. Conservative check: if |a| * |b| has
  ;; any bit above i63, overflow. We use a simple approach: check whether
  ;; both magnitudes fit in 31 bits, in which case the i64 product is safe.
  ;; Otherwise, report overflow (even if the full math would have fit).
  ;; This is a lower bound — it never reports false negatives.
  (func $i64_mul_safe (param $a i64) (param $b i64) (result i32)
    (local $absA i64)
    (local $absB i64)
    (local.set $absA (select
      (i64.sub (i64.const 0) (local.get $a))
      (local.get $a)
      (i64.lt_s (local.get $a) (i64.const 0))))
    (local.set $absB (select
      (i64.sub (i64.const 0) (local.get $b))
      (local.get $b)
      (i64.lt_s (local.get $b) (i64.const 0))))
    (i32.and
      (i64.lt_u (local.get $absA) (i64.const 0x80000000))
      (i64.lt_u (local.get $absB) (i64.const 0x80000000)))
  )

  ;; Check whether a heap Rational's denominator is exactly 1.
  (func $rational_denominator_is_one (param $header i32) (result i32)
    (local $denominator i32)
    (local.set $denominator (call $rational_denominator (local.get $header)))
    (i32.and
      (i32.eq (call $bigint_length (local.get $denominator)) (i32.const 1))
      (i32.eq (call $bigint_limb (local.get $denominator) (i32.const 0)) (i32.const 1)))
  )

  ;; ==========================================================================
  ;; Coercion helpers: convert a value slot of any numeric type to f64.
  ;;
  ;; These exist so legacy TYPE_FLOAT-only dispatch sites can be rewritten to
  ;; accept any numeric type (Float, Rational, BigInt) with minimal change.
  ;; The Rational case loses exactness — that's the contagion rule at the
  ;; External/legacy boundary. Callsites that need exactness should dispatch on
  ;; TYPE_RATIONAL explicitly instead.
  ;; ==========================================================================

  ;; Convert a heap BigInt to f64. Walks limbs, highest-first, accumulating
  ;; as f64. Precision loss past 2**53 is acceptable (matches JS Number(bigint)).
  (func $bigint_to_f64 (param $header i32) (result f64)
    (local $length i32)
    (local $i i32)
    (local $result f64)
    (local $limb i32)
    (local.set $length (call $bigint_length (local.get $header)))
    (if (i32.eqz (local.get $length))
      (then (return (f64.const 0))))
    (local.set $result (f64.const 0))
    (local.set $i (local.get $length))
    (block $done
      (loop $iter
        (br_if $done (i32.eqz (local.get $i)))
        (local.set $i (i32.sub (local.get $i) (i32.const 1)))
        (local.set $limb (call $bigint_limb (local.get $header) (local.get $i)))
        (local.set $result
          (f64.add
            (f64.mul (local.get $result) (f64.const 4294967296))
            (f64.convert_i32_u (local.get $limb))))
        (br $iter)
      )
    )
    (if (call $bigint_sign (local.get $header))
      (then (local.set $result (f64.neg (local.get $result)))))
    (local.get $result)
  )

  ;; Compare two Rational value slots, returning -1 / 0 / 1.
  ;; Fast path for both-inline: compare i64 numerators.
  ;; General path: cross-multiply numerators by denominators.
  (func $rational_compare (param $leftPointer i32) (param $rightPointer i32) (result i32)
    (local $leftHeader i32)
    (local $rightHeader i32)
    (local $leftInline i32)
    (local $rightInline i32)
    (local $leftN i64)
    (local $rightN i64)
    (local $crossLeft i32)
    (local $crossRight i32)
    (local.set $leftInline (call $rational_is_inline (local.get $leftPointer)))
    (local.set $rightInline (call $rational_is_inline (local.get $rightPointer)))
    ;; Both inline: i64 compare.
    (if (i32.and (local.get $leftInline) (local.get $rightInline))
      (then
        (local.set $leftN (call $rational_read_inline (local.get $leftPointer)))
        (local.set $rightN (call $rational_read_inline (local.get $rightPointer)))
        (if (i64.lt_s (local.get $leftN) (local.get $rightN))
          (then (return (i32.const -1))))
        (if (i64.gt_s (local.get $leftN) (local.get $rightN))
          (then (return (i32.const 1))))
        (return (i32.const 0))))
    ;; Materialize either side that's inline to heap, then cross-multiply.
    (local.set $leftHeader (call $rational_materialize (local.get $leftPointer)))
    (local.set $rightHeader (call $rational_materialize (local.get $rightPointer)))
    ;; crossLeft = leftNumerator * rightDenominator
    (local.set $crossLeft
      (call $bigint_mul
        (call $rational_numerator (local.get $leftHeader))
        (call $rational_denominator (local.get $rightHeader))))
    (local.set $crossRight
      (call $bigint_mul
        (call $rational_numerator (local.get $rightHeader))
        (call $rational_denominator (local.get $leftHeader))))
    (call $bigint_compare (local.get $crossLeft) (local.get $crossRight))
  )

  ;; ==========================================================================
  ;; Allocation-free exact-numeric comparison.
  ;;
  ;; The Expression sort and collection comparators fire O(n²) times per
  ;; canonicalization and run inside status-threaded walks; the heap-path
  ;; $rational_compare above allocates cross products per call, which is
  ;; un-guardable at that granularity. This family compares exact numerics
  ;; using the heap-TAIL free span (bytes past STATE_HEAP_POINTER — never
  ;; committed, invisible to GC) as staging, so a compare allocates
  ;; nothing and leaves no garbage.
  ;;
  ;; Pressure contract: a compare whose staging would not fit the free
  ;; span signals memory pressure (via $check_concat_scratch_overflow)
  ;; and returns 0 as a dummy; the expression walks poll
  ;; $memory_pressure_signaled after each compare-heavy phase and abort,
  ;; so the dummy never becomes observable output.
  ;; ==========================================================================

  ;; Stage a pseudo BigInt header for a signed i64 in tail scratch at
  ;; $dest (24 bytes: two dummy header words + [sign][length][limb0]
  ;; [limb1], matching real BigInt field offsets so the read accessors
  ;; work on it). Returns $dest.
  (func $stage_pseudo_bigint_i64 (param $value i64) (param $dest i32) (result i32)
    (local $sign i32)
    (local $magnitude i64)
    (local $length i32)
    (if (i64.lt_s (local.get $value) (i64.const 0))
      (then
        (local.set $sign (i32.const 1))
        (local.set $magnitude (i64.sub (i64.const 0) (local.get $value))))
      (else (local.set $magnitude (local.get $value))))
    (local.set $length (i32.const 0))
    (if (i64.ne (local.get $magnitude) (i64.const 0))
      (then (local.set $length (i32.const 1))))
    (if (i64.ne (i64.shr_u (local.get $magnitude) (i64.const 32)) (i64.const 0))
      (then (local.set $length (i32.const 2))))
    (i32.store (call $abs (i32.add (local.get $dest) (global.get $GC_HEADER_SIZE)))
      (local.get $sign))
    (i32.store (call $abs (i32.add (local.get $dest) (i32.const 12)))
      (local.get $length))
    (i32.store (call $abs (i32.add (local.get $dest) (i32.const 16)))
      (i32.wrap_i64 (local.get $magnitude)))
    (i32.store (call $abs (i32.add (local.get $dest) (i32.const 20)))
      (i32.wrap_i64 (i64.shr_u (local.get $magnitude) (i64.const 32))))
    (local.get $dest)
  )

  ;; Schoolbook-multiply two BigInt magnitudes into a raw limb buffer at
  ;; $dest (segment-relative tail scratch; no header, just limbs).
  ;; Returns the written limb count (la + lb; leading zeros are the
  ;; comparator's problem). Zero-length operand → 0.
  (func $bigint_mul_magnitude_into (param $a i32) (param $b i32) (param $dest i32) (result i32)
    (local $la i32)
    (local $lb i32)
    (local $total i32)
    (local $i i32)
    (local $j i32)
    (local $k i32)
    (local $carry i64)
    (local $product i64)
    (local $cell i32)
    (local.set $la (call $bigint_length (local.get $a)))
    (local.set $lb (call $bigint_length (local.get $b)))
    (if (i32.or (i32.eqz (local.get $la)) (i32.eqz (local.get $lb)))
      (then (return (i32.const 0))))
    (local.set $total (i32.add (local.get $la) (local.get $lb)))
    (local.set $i (i32.const 0))
    (block $init_done
      (loop $init
        (br_if $init_done (i32.ge_u (local.get $i) (local.get $total)))
        (i32.store
          (call $abs (i32.add (local.get $dest) (i32.mul (local.get $i) (i32.const 4))))
          (i32.const 0))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $init)
      )
    )
    (local.set $i (i32.const 0))
    (block $outer_done
      (loop $outer
        (br_if $outer_done (i32.ge_u (local.get $i) (local.get $la)))
        (local.set $carry (i64.const 0))
        (local.set $j (i32.const 0))
        (block $inner_done
          (loop $inner
            (br_if $inner_done (i32.ge_u (local.get $j) (local.get $lb)))
            (local.set $k (i32.add (local.get $i) (local.get $j)))
            (local.set $cell
              (call $abs (i32.add (local.get $dest) (i32.mul (local.get $k) (i32.const 4)))))
            (local.set $product (i64.add
              (i64.add
                (i64.mul
                  (i64.extend_i32_u (call $bigint_limb (local.get $a) (local.get $i)))
                  (i64.extend_i32_u (call $bigint_limb (local.get $b) (local.get $j))))
                (i64.extend_i32_u (i32.load (local.get $cell))))
              (local.get $carry)))
            (i32.store (local.get $cell) (i32.wrap_i64 (local.get $product)))
            (local.set $carry (i64.shr_u (local.get $product) (i64.const 32)))
            (local.set $j (i32.add (local.get $j) (i32.const 1)))
            (br $inner)
          )
        )
        (if (i64.ne (local.get $carry) (i64.const 0))
          (then
            (i32.store
              (call $abs (i32.add (local.get $dest)
                (i32.mul (i32.add (local.get $i) (local.get $lb)) (i32.const 4))))
              (i32.wrap_i64 (local.get $carry)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $outer)
      )
    )
    (local.get $total)
  )

  ;; Magnitude-compare two raw limb runs (little-endian limbs at
  ;; segment-relative addresses), trimming leading zeros. -1/0/1.
  (func $limb_run_compare (param $a i32) (param $la i32) (param $b i32) (param $lb i32) (result i32)
    (local $wa i32)
    (local $wb i32)
    (block $trim_a_done
      (loop $trim_a
        (br_if $trim_a_done (i32.eqz (local.get $la)))
        (br_if $trim_a_done (i32.ne
          (i32.load (call $abs (i32.add (local.get $a)
            (i32.mul (i32.sub (local.get $la) (i32.const 1)) (i32.const 4)))))
          (i32.const 0)))
        (local.set $la (i32.sub (local.get $la) (i32.const 1)))
        (br $trim_a)
      )
    )
    (block $trim_b_done
      (loop $trim_b
        (br_if $trim_b_done (i32.eqz (local.get $lb)))
        (br_if $trim_b_done (i32.ne
          (i32.load (call $abs (i32.add (local.get $b)
            (i32.mul (i32.sub (local.get $lb) (i32.const 1)) (i32.const 4)))))
          (i32.const 0)))
        (local.set $lb (i32.sub (local.get $lb) (i32.const 1)))
        (br $trim_b)
      )
    )
    (if (i32.ne (local.get $la) (local.get $lb))
      (then (return (select (i32.const 1) (i32.const -1)
        (i32.gt_u (local.get $la) (local.get $lb))))))
    (block $scan_done
      (loop $scan
        (br_if $scan_done (i32.eqz (local.get $la)))
        (local.set $la (i32.sub (local.get $la) (i32.const 1)))
        (local.set $wa (i32.load (call $abs (i32.add (local.get $a)
          (i32.mul (local.get $la) (i32.const 4))))))
        (local.set $wb (i32.load (call $abs (i32.add (local.get $b)
          (i32.mul (local.get $la) (i32.const 4))))))
        (if (i32.ne (local.get $wa) (local.get $wb))
          (then (return (select (i32.const 1) (i32.const -1)
            (i32.gt_u (local.get $wa) (local.get $wb))))))
        (br $scan)
      )
    )
    (i32.const 0)
  )

  ;; Effective sign class of a BigInt header: -1 negative, 0 zero, 1 positive.
  (func $bigint_sign_class (param $header i32) (result i32)
    (if (i32.eqz (call $bigint_length (local.get $header)))
      (then (return (i32.const 0))))
    (if (call $bigint_sign (local.get $header))
      (then (return (i32.const -1))))
    (i32.const 1)
  )

  ;; Is this BigInt exactly the positive scalar 1?
  (func $bigint_is_one (param $header i32) (result i32)
    (i32.and
      (i32.eqz (call $bigint_sign (local.get $header)))
      (i32.and
        (i32.eq (call $bigint_length (local.get $header)) (i32.const 1))
        (i32.eq (call $bigint_limb (local.get $header) (i32.const 0)) (i32.const 1))))
  )

  ;; Compare aNum/aDen against bNum/bDen (all BigInt headers, real or
  ;; pseudo; denominators > 0) without allocating. Cross-product
  ;; magnitudes are staged at $scratch (segment-relative tail scratch;
  ;; caller passes a cursor past any staging of its own). Sets the
  ;; pressure flag and returns 0 if staging would overflow the span.
  (func $fraction_cross_compare
    (param $a_num i32) (param $a_den i32)
    (param $b_num i32) (param $b_den i32)
    (param $scratch i32)
    (result i32)
    (local $class_a i32)
    (local $class_b i32)
    (local $left_ptr i32)
    (local $left_len i32)
    (local $right_ptr i32)
    (local $right_len i32)
    (local $result i32)
    (local $need i32)

    (local.set $class_a (call $bigint_sign_class (local.get $a_num)))
    (local.set $class_b (call $bigint_sign_class (local.get $b_num)))
    (if (i32.ne (local.get $class_a) (local.get $class_b))
      (then (return (select (i32.const -1) (i32.const 1)
        (i32.lt_s (local.get $class_a) (local.get $class_b))))))
    (if (i32.eqz (local.get $class_a))
      (then (return (i32.const 0))))

    ;; Same non-zero sign: compare |aNum|·bDen vs |bNum|·aDen. A
    ;; denominator of 1 skips its product and reads the numerator's
    ;; limbs in place. The overflow check covers the distance from the
    ;; heap pointer to the end of both staged products.
    (local.set $need (i32.add
      (i32.sub (local.get $scratch) (call $read_state (global.get $STATE_HEAP_POINTER)))
      (i32.mul (i32.const 4)
        (i32.add
          (i32.add
            (call $bigint_length (local.get $a_num))
            (call $bigint_length (local.get $b_den)))
          (i32.add
            (call $bigint_length (local.get $b_num))
            (call $bigint_length (local.get $a_den)))))))
    (if (call $check_concat_scratch_overflow (local.get $need))
      (then (return (i32.const 0))))

    (if (call $bigint_is_one (local.get $b_den))
      (then
        (local.set $left_ptr (i32.add (local.get $a_num) (i32.const 16)))
        (local.set $left_len (call $bigint_length (local.get $a_num))))
      (else
        (local.set $left_len (call $bigint_mul_magnitude_into
          (local.get $a_num) (local.get $b_den) (local.get $scratch)))
        (local.set $left_ptr (local.get $scratch))
        (local.set $scratch (i32.add (local.get $scratch)
          (i32.mul (local.get $left_len) (i32.const 4))))))
    (if (call $bigint_is_one (local.get $a_den))
      (then
        (local.set $right_ptr (i32.add (local.get $b_num) (i32.const 16)))
        (local.set $right_len (call $bigint_length (local.get $b_num))))
      (else
        (local.set $right_len (call $bigint_mul_magnitude_into
          (local.get $b_num) (local.get $a_den) (local.get $scratch)))
        (local.set $right_ptr (local.get $scratch))))
    (local.set $result (call $limb_run_compare
      (local.get $left_ptr) (local.get $left_len)
      (local.get $right_ptr) (local.get $right_len)))
    (if (i32.eq (local.get $class_a) (i32.const -1))
      (then (return (i32.sub (i32.const 0) (local.get $result)))))
    (local.get $result)
  )

  ;; Decode a RATIONAL or BIGINT value slot into (numerator, denominator)
  ;; BigInt headers without allocating, staging pseudo headers for
  ;; inline values at $stage (48 bytes of tail scratch). Out-params in
  ;; $fraction_decode_num / $fraction_decode_den.
  (func $decode_exact_slot_fraction (param $slot i32) (param $stage i32)
    (local $header i32)
    (if (i32.eq (call $value_type (local.get $slot)) (global.get $TYPE_BIGINT))
      (then
        (global.set $fraction_decode_num (call $value_data_lo (local.get $slot)))
        (global.set $fraction_decode_den (call $stage_pseudo_bigint_i64
          (i64.const 1) (i32.add (local.get $stage) (i32.const 24))))
        (return)))
    (if (call $rational_is_inline (local.get $slot))
      (then
        (global.set $fraction_decode_num (call $stage_pseudo_bigint_i64
          (call $rational_read_inline (local.get $slot)) (local.get $stage)))
        (global.set $fraction_decode_den (call $stage_pseudo_bigint_i64
          (i64.const 1) (i32.add (local.get $stage) (i32.const 24))))
        (return)))
    (local.set $header (call $value_data_lo (local.get $slot)))
    (global.set $fraction_decode_num (call $rational_numerator (local.get $header)))
    (global.set $fraction_decode_den (call $rational_denominator (local.get $header)))
  )

  ;; Compare two exact numeric value slots (RATIONAL / BIGINT in any
  ;; mix) without allocating. Pressure contract as above.
  (func $exact_numeric_slots_compare (param $a_slot i32) (param $b_slot i32) (result i32)
    (local $heap_pointer i32)
    (local $a_num i32)
    (local $a_den i32)
    (if (call $check_concat_scratch_overflow (i32.const 96))
      (then (return (i32.const 0))))
    (local.set $heap_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))
    (call $decode_exact_slot_fraction (local.get $a_slot) (local.get $heap_pointer))
    (local.set $a_num (global.get $fraction_decode_num))
    (local.set $a_den (global.get $fraction_decode_den))
    (call $decode_exact_slot_fraction (local.get $b_slot)
      (i32.add (local.get $heap_pointer) (i32.const 48)))
    (call $fraction_cross_compare
      (local.get $a_num) (local.get $a_den)
      (global.get $fraction_decode_num) (global.get $fraction_decode_den)
      (i32.add (local.get $heap_pointer) (i32.const 96)))
  )

  ;; Compare a RATIONAL / BIGINT value slot against a Rational HEADER
  ;; (a Complex real or imaginary part) without allocating.
  (func $exact_slot_vs_rational_header_compare
    (param $slot i32) (param $rational_header i32) (result i32)
    (local $heap_pointer i32)
    (if (call $check_concat_scratch_overflow (i32.const 48))
      (then (return (i32.const 0))))
    (local.set $heap_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))
    (call $decode_exact_slot_fraction (local.get $slot) (local.get $heap_pointer))
    (call $fraction_cross_compare
      (global.get $fraction_decode_num) (global.get $fraction_decode_den)
      (call $rational_numerator (local.get $rational_header))
      (call $rational_denominator (local.get $rational_header))
      (i32.add (local.get $heap_pointer) (i32.const 48)))
  )

  ;; Compare two Rational HEADERS without allocating.
  (func $rational_header_pair_compare (param $a i32) (param $b i32) (result i32)
    (call $fraction_cross_compare
      (call $rational_numerator (local.get $a))
      (call $rational_denominator (local.get $a))
      (call $rational_numerator (local.get $b))
      (call $rational_denominator (local.get $b))
      (call $read_state (global.get $STATE_HEAP_POINTER)))
  )

  ;; Convert a Rational value slot to f64 (numerator/denominator).
  (func $rational_to_f64 (param $value_pointer i32) (result f64)
    (local $header i32)
    (local $numerator f64)
    (local $denominator f64)
    (if (call $rational_is_inline (local.get $value_pointer))
      (then
        (return (f64.convert_i64_s (call $rational_read_inline (local.get $value_pointer))))))
    (local.set $header (call $value_data_lo (local.get $value_pointer)))
    (local.set $numerator (call $bigint_to_f64 (call $rational_numerator (local.get $header))))
    (local.set $denominator (call $bigint_to_f64 (call $rational_denominator (local.get $header))))
    (f64.div (local.get $numerator) (local.get $denominator))
  )

  ;; Return 1 if the value slot holds a numeric-like type (Float, Rational,
  ;; or BigInt). Does NOT count Boolean, String, etc.
  (func $value_is_numeric (param $value_pointer i32) (result i32)
    (local $type i32)
    (local.set $type (call $value_type (local.get $value_pointer)))
    (i32.or
      (i32.eq (local.get $type) (global.get $TYPE_FLOAT))
      (i32.or
        (i32.eq (local.get $type) (global.get $TYPE_RATIONAL))
        (i32.eq (local.get $type) (global.get $TYPE_BIGINT))))
  )

  ;; Read any numeric value slot as f64. Caller must have verified
  ;; $value_is_numeric. Rationals and BigInts may lose precision past 2**53.
  (func $value_to_f64 (param $value_pointer i32) (result f64)
    (local $type i32)
    (local.set $type (call $value_type (local.get $value_pointer)))
    (if (i32.eq (local.get $type) (global.get $TYPE_FLOAT))
      (then (return (call $read_f64 (local.get $value_pointer)))))
    (if (i32.eq (local.get $type) (global.get $TYPE_RATIONAL))
      (then (return (call $rational_to_f64 (local.get $value_pointer)))))
    (if (i32.eq (local.get $type) (global.get $TYPE_BIGINT))
      (then (return (call $bigint_to_f64 (call $value_data_lo (local.get $value_pointer))))))
    (f64.const 0)
  )

  ;; ECMA ToInt32: NaN / ±Infinity → 0, truncate toward zero, reduce
  ;; modulo 2^32 into the signed i32 range. Bitwise and shift operands
  ;; must come through here — a raw i32.trunc_f64_s traps the whole
  ;; module on any non-finite or out-of-i32-range input, which sandboxed
  ;; code can produce with as little as `1e10 | 0`.
  ;;
  ;; The modular reduction (x - trunc(x / 2^32) * 2^32) is exact in f64:
  ;; dividing and multiplying by a power of two only shifts the exponent,
  ;; trunc is exact, and the final subtraction of two values within 2^32
  ;; of each other is exact whenever the true result is representable
  ;; (for |x| ≥ 2^85 the value is itself a multiple of 2^32, so the
  ;; residue is exactly 0).
  (func $f64_to_int32 (param $x f64) (result i32)
    (local $r f64)
    ;; NaN → 0 (NaN is the only value that != itself).
    (if (f64.ne (local.get $x) (local.get $x))
      (then (return (i32.const 0))))
    ;; ±Infinity → 0.
    (if (f64.eq (f64.abs (local.get $x)) (f64.const inf))
      (then (return (i32.const 0))))
    (local.set $r (f64.trunc (local.get $x)))
    ;; r mod 2^32, into [0, 2^32).
    (local.set $r (f64.sub (local.get $r)
      (f64.mul
        (f64.trunc (f64.div (local.get $r) (f64.const 4294967296)))
        (f64.const 4294967296))))
    (if (f64.lt (local.get $r) (f64.const 0))
      (then (local.set $r (f64.add (local.get $r) (f64.const 4294967296)))))
    ;; Wrap into signed range [-2^31, 2^31).
    (if (f64.ge (local.get $r) (f64.const 2147483648))
      (then (local.set $r (f64.sub (local.get $r) (f64.const 4294967296)))))
    (i32.trunc_f64_s (local.get $r))
  )

  ;; Element-index conversion for GET_INDEX / SET_INDEX paths: the
  ;; exact i32 when x is integral and in [0, 2^31), else -1. Every
  ;; consumer bounds-checks with an unsigned (or explicit negative)
  ;; compare, so -1 routes to the existing out-of-bounds behavior —
  ;; undefined on reads, ignore/throw on writes. This is JS-correct
  ;; for arr[NaN] and arr[0.5] (no such property → undefined) where
  ;; the previous raw trunc either trapped (NaN, 1e10) or silently
  ;; read element 0 (0.5).
  (func $f64_index_or_negative (param $x f64) (result i32)
    (if (f64.ne (f64.trunc (local.get $x)) (local.get $x))
      (then (return (i32.const -1))))
    (if (f64.lt (local.get $x) (f64.const 0))
      (then (return (i32.const -1))))
    (if (f64.ge (local.get $x) (f64.const 2147483648))
      (then (return (i32.const -1))))
    (i32.trunc_f64_s (local.get $x))
  )

  (func $coerce_to_number_at (param $pointer i32)
    (local $type i32)
    (local $string_id i32)
    (local $len i32)
    (local $parsed f64)
    (local $bits i64)
    (local.set $type (call $value_type (local.get $pointer)))
    (if (call $value_is_numeric (local.get $pointer))
      (then (return)))
    (if (i32.eq (local.get $type) (global.get $TYPE_COMPLEX))
      (then (return)))
    ;; Symbol, Expression, and Matrix refuse numeric coercion (JS spec
    ;; for Symbol; Ring 2/4 math-domain rule for Expression and Matrix).
    ;; Leave them untouched — the op site's non-numeric fallthrough
    ;; raises the TypeError. NaN-ifying them here would make `sym * 2`
    ;; silently produce NaN where `-sym` and `+sym` throw.
    (if (i32.eq (local.get $type) (global.get $TYPE_SYMBOL))
      (then (return)))
    (if (i32.eq (local.get $type) (global.get $TYPE_EXPRESSION))
      (then (return)))
    (if (i32.eq (local.get $type) (global.get $TYPE_MATRIX))
      (then (return)))
    (if (i32.eq (local.get $type) (global.get $TYPE_THEOREM))
      (then (return)))
    ;; AlgebraicNumber passes through unconverted: the arithmetic
    ;; opcodes dispatch it exactly (Ring 6b), and every implicit
    ;; float path (Math.*, f64 fallbacks) keeps refusing —
    ;; approximation is only ever the explicit toApproximation exit.
    (if (i32.eq (local.get $type) (global.get $TYPE_ALGEBRAIC))
      (then (return)))
    (if (i32.eq (local.get $type) (global.get $TYPE_COMPLEX_ALGEBRAIC))
      (then (return)))
    (if (i32.eq (local.get $type) (global.get $TYPE_BOOLEAN))
      (then
        (if (call $value_data_lo (local.get $pointer))
          (then
            (local.set $bits (i64.reinterpret_f64 (f64.const 1)))
            (call $write_value (local.get $pointer)
              (global.get $TYPE_FLOAT) (i32.const 0)
              (i32.wrap_i64 (local.get $bits))
              (i32.wrap_i64 (i64.shr_u (local.get $bits) (i64.const 32)))))
          (else
            (call $write_value (local.get $pointer)
              (global.get $TYPE_FLOAT) (i32.const 0)
              (i32.const 0) (i32.const 0))))
        (return)))
    (if (i32.eq (local.get $type) (global.get $TYPE_NULL))
      (then
        (call $write_value (local.get $pointer)
          (global.get $TYPE_FLOAT) (i32.const 0)
          (i32.const 0) (i32.const 0))
        (return)))
    (if (i32.eq (local.get $type) (global.get $TYPE_UNDEFINED))
      (then
        (call $write_value (local.get $pointer)
          (global.get $TYPE_FLOAT) (i32.const 0)
          (i32.const 0) (i32.const 0x7FF80000))
        (return)))
    (if (i32.eq (local.get $type) (global.get $TYPE_STRING))
      (then
        (local.set $string_id (call $value_data_lo (local.get $pointer)))
        (local.set $len (i32.load (call $string_id_to_abs (local.get $string_id))))
        (if (i32.eqz (local.get $len))
          (then
            (call $write_value (local.get $pointer)
              (global.get $TYPE_FLOAT) (i32.const 0)
              (i32.const 0) (i32.const 0))
            (return)))
        (local.set $parsed (call $parse_float (local.get $string_id)))
        (local.set $bits (i64.reinterpret_f64 (local.get $parsed)))
        (call $write_value (local.get $pointer)
          (global.get $TYPE_FLOAT) (i32.const 0)
          (i32.wrap_i64 (local.get $bits))
          (i32.wrap_i64 (i64.shr_u (local.get $bits) (i64.const 32))))
        (return)))
    (call $write_value (local.get $pointer)
      (global.get $TYPE_FLOAT) (i32.const 0)
      (i32.const 0) (i32.const 0x7FF80000))
  )

  ;; ==========================================================================
  ;; same_value_zero(a, b) -> i32  (slice 5)
  ;;
  ;; The Map/Set key-equality predicate. Returns 1 if a and b are
  ;; SameValueZero-equal, else 0. SameValueZero is === except:
  ;;   - NaN === NaN is true
  ;;   - +0 === -0 is true
  ;; Numeric values across different sandscript numeric type tags
  ;; (FLOAT, RATIONAL inline / heap, BIGINT) are compared via their
  ;; f64 projection. This means RATIONAL 42 and FLOAT 42.0 compare
  ;; SameValueZero — matching JS Number-semantics for Map keys.
  ;; (For non-numeric primitives and objects, the type tags must match
  ;; and data_lo / data_hi must be bitwise-equal.)
  ;; ==========================================================================
  (func $same_value_zero
    (param $a_pointer i32) (param $b_pointer i32)
    (result i32)
    (local $a_type i32)
    (local $b_type i32)
    (local $a_f64 f64)
    (local $b_f64 f64)
    (local $a_is_num i32)
    (local $b_is_num i32)
    (local $a_is_nan i32)
    (local $b_is_nan i32)

    (local.set $a_type (call $value_type (local.get $a_pointer)))
    (local.set $b_type (call $value_type (local.get $b_pointer)))
    (local.set $a_is_num (call $value_is_numeric (local.get $a_pointer)))
    (local.set $b_is_num (call $value_is_numeric (local.get $b_pointer)))

    ;; Mixed numeric / non-numeric: not equal.
    (if (i32.ne (local.get $a_is_num) (local.get $b_is_num))
      (then (return (i32.const 0)))
    )

    (if (i32.eq (local.get $a_is_num) (i32.const 1))
      (then
        ;; Both numeric. Compare via f64 projection. f64.eq returns
        ;; false for NaN==NaN, so we add an explicit NaN check first
        ;; (true iff both are NaN). f64.eq treats +0 and -0 as equal.
        (local.set $a_f64 (call $value_to_f64 (local.get $a_pointer)))
        (local.set $b_f64 (call $value_to_f64 (local.get $b_pointer)))
        (local.set $a_is_nan (f64.ne (local.get $a_f64) (local.get $a_f64)))
        (local.set $b_is_nan (f64.ne (local.get $b_f64) (local.get $b_f64)))
        (if (i32.and (local.get $a_is_nan) (local.get $b_is_nan))
          (then (return (i32.const 1)))
        )
        (return (f64.eq (local.get $a_f64) (local.get $b_f64)))
      )
    )

    ;; Non-numeric. Type tags must match and 12 bytes of payload
    ;; (flags + data_lo + data_hi) must be bitwise-equal. Strings
    ;; compare by their interned-id stored in data_lo, which is the
    ;; right answer for SameValueZero on strings (interning is by
    ;; content).
    (if (i32.ne (local.get $a_type) (local.get $b_type))
      (then (return (i32.const 0)))
    )
    ;; data_lo
    (if (i32.ne
          (i32.load (call $abs (i32.add (local.get $a_pointer) (i32.const 8))))
          (i32.load (call $abs (i32.add (local.get $b_pointer) (i32.const 8)))))
      (then (return (i32.const 0)))
    )
    ;; data_hi
    (if (i32.ne
          (i32.load (call $abs (i32.add (local.get $a_pointer) (i32.const 12))))
          (i32.load (call $abs (i32.add (local.get $b_pointer) (i32.const 12)))))
      (then (return (i32.const 0)))
    )
    (i32.const 1)
  )

  ;; estimate_collection_size(slot_stride, capacity) → bytes
  ;; Worst-case heap consumption of $allocate_collection:
  ;;   32 (header, 16-aligned) + entries_aligned
  ;; where entries_raw = GC_HEADER_SIZE (8) + capacity * slot_stride,
  ;; entries_aligned = (entries_raw + 15) & ~15.
  ;; slot_stride is 36 for Map, 20 for Set.
  (func $estimate_collection_size (param $slot_stride i32) (param $capacity i32) (result i32)
    (i32.add
      (i32.const 32)
      (i32.and
        (i32.add
          (i32.add
            (global.get $GC_HEADER_SIZE)
            (i32.mul (local.get $capacity) (local.get $slot_stride)))
          (i32.const 15))
        (i32.const -16)))
  )

  ;; ==========================================================================
  ;; allocate_collection (slice 5)
  ;;
  ;; Allocates a Map or Set: header (28 bytes — 8 GC + 20 data, padded
  ;; to 32 for 16-byte alignment with downstream heap allocators) plus
  ;; an entries block (GC + capacity * slot_stride, also 16-aligned).
  ;; The data's sym_entries slot (header +24) carries own symbol-keyed
  ;; properties, same block format as objects.
  ;; The header's entriesHeader field points at the entries block's
  ;; header pointer (consistent with object / array conventions).
  ;;
  ;; Returns the header pointer of the collection.
  ;; ==========================================================================
  (func $allocate_collection
    (param $obj_type i32)         ;; OBJ_MAP or OBJ_SET
    (param $entries_obj_type i32) ;; OBJ_MAP_ENTRIES or OBJ_SET_ENTRIES
    (param $slot_stride i32)      ;; 36 for Map, 20 for Set
    (param $capacity i32)         ;; initial slot capacity
    (result i32)
    (local $heap_pointer i32)
    (local $header_pointer i32)
    (local $header_size_aligned i32)
    (local $entries_pointer i32)
    (local $entries_size_raw i32)
    (local $entries_size_aligned i32)

    (local.set $heap_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))

    ;; Header: 8 GC + 16 data = 24 bytes raw, align to 32.
    (local.set $header_pointer (local.get $heap_pointer))
    (local.set $header_size_aligned (i32.const 32))
    (i32.store (call $abs (local.get $header_pointer))
      (i32.or (local.get $header_size_aligned)
              (i32.shl (local.get $obj_type) (i32.const 24))))
    (i32.store (call $abs (i32.add (local.get $header_pointer) (i32.const 4))) (i32.const 0))
    ;; size = 0, slotCount = 0, capacity = $capacity, sym_entries = 0
    (i32.store (call $abs (i32.add (local.get $header_pointer) (i32.const 8))) (i32.const 0))   ;; size
    (i32.store (call $abs (i32.add (local.get $header_pointer) (i32.const 12))) (i32.const 0))  ;; slotCount
    (i32.store (call $abs (i32.add (local.get $header_pointer) (i32.const 16))) (local.get $capacity))  ;; capacity
    ;; entriesHeader filled in below.
    (i32.store (call $abs (i32.add (local.get $header_pointer) (i32.const 24))) (i32.const 0))  ;; sym_entries

    (local.set $heap_pointer (i32.add (local.get $heap_pointer) (local.get $header_size_aligned)))

    ;; Entries block: GC + capacity * stride, padded to 16-byte alignment.
    (local.set $entries_pointer (local.get $heap_pointer))
    (local.set $entries_size_raw
      (i32.add (global.get $GC_HEADER_SIZE)
               (i32.mul (local.get $capacity) (local.get $slot_stride))))
    (local.set $entries_size_aligned
      (i32.and (i32.add (local.get $entries_size_raw) (i32.const 15)) (i32.const -16)))
    (i32.store (call $abs (local.get $entries_pointer))
      (i32.or (local.get $entries_size_aligned)
              (i32.shl (local.get $entries_obj_type) (i32.const 24))))
    (i32.store (call $abs (i32.add (local.get $entries_pointer) (i32.const 4))) (i32.const 0))

    ;; Wire entries pointer into the header.
    (i32.store (call $abs (i32.add (local.get $header_pointer) (i32.const 20)))
      (local.get $entries_pointer))

    (local.set $heap_pointer (i32.add (local.get $heap_pointer) (local.get $entries_size_aligned)))
    (call $write_state (global.get $STATE_HEAP_POINTER) (local.get $heap_pointer))

    (local.get $header_pointer)
  )

  ;; ==========================================================================
  ;; map_grow / set_grow
  ;;
  ;; Reallocate the entries block at double capacity and copy live (non-
  ;; tombstoned) slots. Tombstones are dropped during the copy, which
  ;; resets slotCount to size. Updates the header's capacity, slotCount,
  ;; and entriesHeader fields.
  ;; ==========================================================================
  ;; estimate_collection_grow_size(slot_stride, current_capacity) → bytes
  ;; Worst-case heap consumption of $map_grow_entries: allocates a new
  ;; entries block at max(current_capacity * 2, 4) slots, sized
  ;; GC_HEADER_SIZE (8) + new_cap * slot_stride, 16-aligned.
  ;; slot_stride is 36 for Map, 20 for Set.
  (func $estimate_collection_grow_size (param $slot_stride i32) (param $current_capacity i32) (result i32)
    (local $new_cap i32)
    (local.set $new_cap (i32.mul (local.get $current_capacity) (i32.const 2)))
    (if (i32.lt_u (local.get $new_cap) (i32.const 4))
      (then (local.set $new_cap (i32.const 4))))
    (i32.and
      (i32.add
        (i32.add
          (global.get $GC_HEADER_SIZE)
          (i32.mul (local.get $new_cap) (local.get $slot_stride)))
        (i32.const 15))
      (i32.const -16))
  )

  ;; estimate_collection_build_size(slot_stride, max_size) → bytes
  ;; Worst-case heap consumption for building a collection that grows
  ;; from initial capacity 4 to hold up to `max_size` entries via
  ;; doubling: the header (32 bytes) plus the *sum* of every entries
  ;; block ever allocated. Each $set_grow / $map_grow orphans the prior
  ;; entries block on the heap (gc reclaims it later) and allocates a
  ;; new doubled block, so heap_pointer advances by the running total.
  ;; The geometric sum 4 + 8 + 16 + … + 2*new_cap (for the final
  ;; doubling) is < 4 * new_cap; we use 4 * round_up_pow2(max(max_size, 4))
  ;; for the upper bound and multiply by slot_stride for the byte cost.
  ;; slot_stride is 36 for Map, 20 for Set.
  (func $estimate_collection_build_size (param $slot_stride i32) (param $max_size i32) (result i32)
    (local $target i32)
    (local $cap i32)
    ;; target = max(max_size, 4)
    (local.set $target (local.get $max_size))
    (if (i32.lt_u (local.get $target) (i32.const 4))
      (then (local.set $target (i32.const 4))))
    ;; Round target up to next power of two so the doubling sequence
    ;; lands at or above it. Start cap=4 (matches $allocate_collection
    ;; initial capacity); double until cap >= target.
    (local.set $cap (i32.const 4))
    (block $done
      (loop $grow
        (br_if $done (i32.ge_u (local.get $cap) (local.get $target)))
        (local.set $cap (i32.mul (local.get $cap) (i32.const 2)))
        (br $grow)))
    ;; Header 32 + sum of entries blocks. Sum of geometric 4+8+…+2*cap
    ;; is < 4*cap; use 4*cap for the upper bound, times slot_stride.
    ;; Each entries block also pays GC_HEADER_SIZE; the doubling chain
    ;; has at most log2(cap)+1 blocks — bounded by 30. Add 30*16 (=480)
    ;; for those headers + alignment slack.
    (i32.add
      (i32.const 32)
      (i32.add
        (i32.const 480)
        (i32.mul (i32.mul (local.get $cap) (i32.const 4)) (local.get $slot_stride))))
  )

  (func $map_grow_entries (param $header_pointer i32) (param $slot_stride i32) (param $entries_obj_type i32)
    (local $heap_pointer i32)
    (local $old_entries i32)
    (local $new_entries i32)
    (local $old_capacity i32)
    (local $old_slot_count i32)
    (local $new_capacity i32)
    (local $new_size_raw i32)
    (local $new_size_aligned i32)
    (local $i i32)
    (local $write_index i32)
    (local $src i32)
    (local $dst i32)
    (local $j i32)

    (local.set $old_capacity
      (i32.load (call $abs (i32.add (local.get $header_pointer) (i32.const 16)))))
    (local.set $old_slot_count
      (i32.load (call $abs (i32.add (local.get $header_pointer) (i32.const 12)))))
    (local.set $old_entries
      (i32.load (call $abs (i32.add (local.get $header_pointer) (i32.const 20)))))

    (local.set $new_capacity (i32.mul (local.get $old_capacity) (i32.const 2)))
    (if (i32.lt_u (local.get $new_capacity) (i32.const 4))
      (then (local.set $new_capacity (i32.const 4)))
    )

    (local.set $heap_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))
    (local.set $new_entries (local.get $heap_pointer))
    (local.set $new_size_raw
      (i32.add (global.get $GC_HEADER_SIZE)
               (i32.mul (local.get $new_capacity) (local.get $slot_stride))))
    (local.set $new_size_aligned
      (i32.and (i32.add (local.get $new_size_raw) (i32.const 15)) (i32.const -16)))
    (i32.store (call $abs (local.get $new_entries))
      (i32.or (local.get $new_size_aligned)
              (i32.shl (local.get $entries_obj_type) (i32.const 24))))
    (i32.store (call $abs (i32.add (local.get $new_entries) (i32.const 4))) (i32.const 0))
    (call $write_state (global.get $STATE_HEAP_POINTER)
      (i32.add (local.get $new_entries) (local.get $new_size_aligned)))

    ;; Copy live (non-tombstoned) slots from old_entries to new_entries.
    (local.set $write_index (i32.const 0))
    (local.set $i (i32.const 0))
    (block $copy_done
      (loop $copy_loop
        (br_if $copy_done (i32.ge_u (local.get $i) (local.get $old_slot_count)))
        (local.set $src
          (i32.add
            (i32.add (local.get $old_entries) (global.get $GC_HEADER_SIZE))
            (i32.mul (local.get $i) (local.get $slot_stride))))
        ;; Tombstone flag is at offset 0 of the slot.
        (if (i32.eqz (i32.load (call $abs (local.get $src))))
          (then
            (local.set $dst
              (i32.add
                (i32.add (local.get $new_entries) (global.get $GC_HEADER_SIZE))
                (i32.mul (local.get $write_index) (local.get $slot_stride))))
            ;; Byte-copy slot_stride bytes from src to dst.
            (local.set $j (i32.const 0))
            (block $byte_copy_done
              (loop $byte_copy_loop
                (br_if $byte_copy_done (i32.ge_u (local.get $j) (local.get $slot_stride)))
                (i32.store
                  (call $abs (i32.add (local.get $dst) (local.get $j)))
                  (i32.load (call $abs (i32.add (local.get $src) (local.get $j)))))
                (local.set $j (i32.add (local.get $j) (i32.const 4)))
                (br $byte_copy_loop)
              )
            )
            (local.set $write_index (i32.add (local.get $write_index) (i32.const 1)))
          )
        )
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $copy_loop)
      )
    )

    ;; Update header.
    (i32.store (call $abs (i32.add (local.get $header_pointer) (i32.const 12)))
      (local.get $write_index))  ;; slotCount = live count after compaction
    (i32.store (call $abs (i32.add (local.get $header_pointer) (i32.const 16)))
      (local.get $new_capacity))
    (i32.store (call $abs (i32.add (local.get $header_pointer) (i32.const 20)))
      (local.get $new_entries))
  )

  ;; ==========================================================================
  ;; map_find_slot(header_pointer, key_pointer) -> slot_index | -1
  ;;
  ;; Linear scan over live slots in a Map's entries block. Returns the
  ;; slot index (0..slotCount-1) of the entry whose key SameValueZero-
  ;; equals key_pointer's value, or -1 if no live match. Tombstoned
  ;; slots are skipped.
  ;; ==========================================================================
  (func $map_find_slot (param $header_pointer i32) (param $key_pointer i32) (result i32)
    (local $entries_pointer i32)
    (local $slot_count i32)
    (local $i i32)
    (local $slot_pointer i32)
    (local $key_slot_pointer i32)

    (local.set $entries_pointer
      (i32.load (call $abs (i32.add (local.get $header_pointer) (i32.const 20)))))
    (local.set $slot_count
      (i32.load (call $abs (i32.add (local.get $header_pointer) (i32.const 12)))))

    (local.set $i (i32.const 0))
    (block $not_found
      (loop $scan
        (br_if $not_found (i32.ge_u (local.get $i) (local.get $slot_count)))
        (local.set $slot_pointer
          (i32.add
            (i32.add (local.get $entries_pointer) (global.get $GC_HEADER_SIZE))
            (i32.mul (local.get $i) (global.get $MAP_SLOT_STRIDE))))
        ;; Skip tombstones.
        (if (i32.eqz (i32.load (call $abs (local.get $slot_pointer))))
          (then
            (local.set $key_slot_pointer
              (i32.add (local.get $slot_pointer) (global.get $MAP_SLOT_KEY_OFFSET)))
            (if (call $same_value_zero (local.get $key_slot_pointer) (local.get $key_pointer))
              (then (return (local.get $i)))
            )
          )
        )
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $scan)
      )
    )
    (i32.const -1)
  )

  ;; ==========================================================================
  ;; map_lookup_and_push(header_pointer, key_pointer, want_boolean)
  ;;
  ;; want_boolean=0: push the value (or undefined if not found).
  ;; want_boolean=1: push true/false (Map.has).
  ;; ==========================================================================
  (func $map_lookup_and_push
    (param $header_pointer i32) (param $key_pointer i32) (param $want_boolean i32)
    (local $slot_index i32)
    (local $entries_pointer i32)
    (local $value_slot_pointer i32)

    (local.set $slot_index (call $map_find_slot (local.get $header_pointer) (local.get $key_pointer)))

    (if (i32.eq (local.get $want_boolean) (i32.const 1))
      (then
        (call $pending_push
          (global.get $TYPE_BOOLEAN) (i32.const 0)
          (i32.ne (local.get $slot_index) (i32.const -1))
          (i32.const 0))
        (return)
      )
    )

    ;; want_boolean = 0: push value.
    (if (i32.eq (local.get $slot_index) (i32.const -1))
      (then
        (call $pending_push
          (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))
        (return)
      )
    )

    (local.set $entries_pointer
      (i32.load (call $abs (i32.add (local.get $header_pointer) (i32.const 20)))))
    (local.set $value_slot_pointer
      (i32.add
        (i32.add
          (i32.add (local.get $entries_pointer) (global.get $GC_HEADER_SIZE))
          (i32.mul (local.get $slot_index) (global.get $MAP_SLOT_STRIDE)))
        (global.get $MAP_SLOT_VALUE_OFFSET)))
    (call $pending_push
      (i32.load (call $abs (local.get $value_slot_pointer)))
      (i32.load (call $abs (i32.add (local.get $value_slot_pointer) (i32.const 4))))
      (i32.load (call $abs (i32.add (local.get $value_slot_pointer) (i32.const 8))))
      (i32.load (call $abs (i32.add (local.get $value_slot_pointer) (i32.const 12)))))
  )

  ;; ==========================================================================
  ;; map_set(header_pointer, key_pointer, value_pointer)
  ;;
  ;; If key already present (SameValueZero), update its value in place.
  ;; Otherwise append a new slot, growing the entries block if needed.
  ;; ==========================================================================
  (func $map_set
    (param $header_pointer i32) (param $key_pointer i32) (param $value_pointer i32)
    (local $slot_index i32)
    (local $entries_pointer i32)
    (local $slot_count i32)
    (local $capacity i32)
    (local $size i32)
    (local $slot_pointer i32)
    (local $value_slot_pointer i32)
    (local $key_slot_pointer i32)

    (local.set $slot_index (call $map_find_slot (local.get $header_pointer) (local.get $key_pointer)))
    (local.set $entries_pointer
      (i32.load (call $abs (i32.add (local.get $header_pointer) (i32.const 20)))))

    (if (i32.ne (local.get $slot_index) (i32.const -1))
      (then
        ;; Update existing slot's value.
        (local.set $value_slot_pointer
          (i32.add
            (i32.add
              (i32.add (local.get $entries_pointer) (global.get $GC_HEADER_SIZE))
              (i32.mul (local.get $slot_index) (global.get $MAP_SLOT_STRIDE)))
            (global.get $MAP_SLOT_VALUE_OFFSET)))
        (i32.store (call $abs (local.get $value_slot_pointer))
          (i32.load (call $abs (local.get $value_pointer))))
        (i32.store (call $abs (i32.add (local.get $value_slot_pointer) (i32.const 4)))
          (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 4)))))
        (i32.store (call $abs (i32.add (local.get $value_slot_pointer) (i32.const 8)))
          (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 8)))))
        (i32.store (call $abs (i32.add (local.get $value_slot_pointer) (i32.const 12)))
          (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 12)))))
        (return)
      )
    )

    ;; New key. Grow if slotCount == capacity.
    (local.set $slot_count
      (i32.load (call $abs (i32.add (local.get $header_pointer) (i32.const 12)))))
    (local.set $capacity
      (i32.load (call $abs (i32.add (local.get $header_pointer) (i32.const 16)))))
    (if (i32.ge_u (local.get $slot_count) (local.get $capacity))
      (then
        (call $map_grow_entries (local.get $header_pointer)
          (global.get $MAP_SLOT_STRIDE) (global.get $OBJ_MAP_ENTRIES))
        ;; Re-read entries / slot_count after grow.
        (local.set $entries_pointer
          (i32.load (call $abs (i32.add (local.get $header_pointer) (i32.const 20)))))
        (local.set $slot_count
          (i32.load (call $abs (i32.add (local.get $header_pointer) (i32.const 12)))))
      )
    )

    ;; Append new slot.
    (local.set $slot_pointer
      (i32.add
        (i32.add (local.get $entries_pointer) (global.get $GC_HEADER_SIZE))
        (i32.mul (local.get $slot_count) (global.get $MAP_SLOT_STRIDE))))
    ;; tombstone = 0 (live)
    (i32.store (call $abs (local.get $slot_pointer)) (i32.const 0))
    ;; key
    (local.set $key_slot_pointer
      (i32.add (local.get $slot_pointer) (global.get $MAP_SLOT_KEY_OFFSET)))
    (i32.store (call $abs (local.get $key_slot_pointer))
      (i32.load (call $abs (local.get $key_pointer))))
    (i32.store (call $abs (i32.add (local.get $key_slot_pointer) (i32.const 4)))
      (i32.load (call $abs (i32.add (local.get $key_pointer) (i32.const 4)))))
    (i32.store (call $abs (i32.add (local.get $key_slot_pointer) (i32.const 8)))
      (i32.load (call $abs (i32.add (local.get $key_pointer) (i32.const 8)))))
    (i32.store (call $abs (i32.add (local.get $key_slot_pointer) (i32.const 12)))
      (i32.load (call $abs (i32.add (local.get $key_pointer) (i32.const 12)))))
    ;; value
    (local.set $value_slot_pointer
      (i32.add (local.get $slot_pointer) (global.get $MAP_SLOT_VALUE_OFFSET)))
    (i32.store (call $abs (local.get $value_slot_pointer))
      (i32.load (call $abs (local.get $value_pointer))))
    (i32.store (call $abs (i32.add (local.get $value_slot_pointer) (i32.const 4)))
      (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 4)))))
    (i32.store (call $abs (i32.add (local.get $value_slot_pointer) (i32.const 8)))
      (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 8)))))
    (i32.store (call $abs (i32.add (local.get $value_slot_pointer) (i32.const 12)))
      (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 12)))))
    ;; Bump slotCount and size.
    (i32.store (call $abs (i32.add (local.get $header_pointer) (i32.const 12)))
      (i32.add (local.get $slot_count) (i32.const 1)))
    (local.set $size
      (i32.load (call $abs (i32.add (local.get $header_pointer) (i32.const 8)))))
    (i32.store (call $abs (i32.add (local.get $header_pointer) (i32.const 8)))
      (i32.add (local.get $size) (i32.const 1)))
  )

  ;; ==========================================================================
  ;; map_delete(header_pointer, key_pointer) -> 1 if deleted, 0 if not present
  ;; Tombstones the slot in place; size is decremented but slotCount stays.
  ;; ==========================================================================
  (func $map_delete (param $header_pointer i32) (param $key_pointer i32) (result i32)
    (local $slot_index i32)
    (local $entries_pointer i32)
    (local $slot_pointer i32)
    (local $size i32)

    (local.set $slot_index (call $map_find_slot (local.get $header_pointer) (local.get $key_pointer)))
    (if (i32.eq (local.get $slot_index) (i32.const -1))
      (then (return (i32.const 0)))
    )

    (local.set $entries_pointer
      (i32.load (call $abs (i32.add (local.get $header_pointer) (i32.const 20)))))
    (local.set $slot_pointer
      (i32.add
        (i32.add (local.get $entries_pointer) (global.get $GC_HEADER_SIZE))
        (i32.mul (local.get $slot_index) (global.get $MAP_SLOT_STRIDE))))
    ;; Set tombstone.
    (i32.store (call $abs (local.get $slot_pointer)) (i32.const 1))
    ;; Decrement size.
    (local.set $size
      (i32.load (call $abs (i32.add (local.get $header_pointer) (i32.const 8)))))
    (i32.store (call $abs (i32.add (local.get $header_pointer) (i32.const 8)))
      (i32.sub (local.get $size) (i32.const 1)))
    (i32.const 1)
  )

  ;; ==========================================================================
  ;; Set helpers — same shape as Map but with single-value slots.
  ;; ==========================================================================
  (func $set_find_slot (param $header_pointer i32) (param $value_pointer i32) (result i32)
    (local $entries_pointer i32)
    (local $slot_count i32)
    (local $i i32)
    (local $slot_pointer i32)
    (local $value_slot_pointer i32)

    (local.set $entries_pointer
      (i32.load (call $abs (i32.add (local.get $header_pointer) (i32.const 20)))))
    (local.set $slot_count
      (i32.load (call $abs (i32.add (local.get $header_pointer) (i32.const 12)))))

    (local.set $i (i32.const 0))
    (block $not_found
      (loop $scan
        (br_if $not_found (i32.ge_u (local.get $i) (local.get $slot_count)))
        (local.set $slot_pointer
          (i32.add
            (i32.add (local.get $entries_pointer) (global.get $GC_HEADER_SIZE))
            (i32.mul (local.get $i) (global.get $SET_SLOT_STRIDE))))
        (if (i32.eqz (i32.load (call $abs (local.get $slot_pointer))))
          (then
            (local.set $value_slot_pointer
              (i32.add (local.get $slot_pointer) (global.get $SET_SLOT_VALUE_OFFSET)))
            (if (call $same_value_zero (local.get $value_slot_pointer) (local.get $value_pointer))
              (then (return (local.get $i)))
            )
          )
        )
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $scan)
      )
    )
    (i32.const -1)
  )

  (func $set_lookup_and_push
    (param $header_pointer i32) (param $value_pointer i32) (param $want_boolean i32)
    (call $pending_push
      (global.get $TYPE_BOOLEAN) (i32.const 0)
      (i32.ne (call $set_find_slot (local.get $header_pointer) (local.get $value_pointer))
              (i32.const -1))
      (i32.const 0))
  )

  (func $set_add (param $header_pointer i32) (param $value_pointer i32)
    (local $slot_index i32)
    (local $entries_pointer i32)
    (local $slot_count i32)
    (local $capacity i32)
    (local $size i32)
    (local $slot_pointer i32)
    (local $value_slot_pointer i32)

    (local.set $slot_index (call $set_find_slot (local.get $header_pointer) (local.get $value_pointer)))
    ;; Already present? Return without modification.
    (if (i32.ne (local.get $slot_index) (i32.const -1))
      (then (return))
    )

    (local.set $entries_pointer
      (i32.load (call $abs (i32.add (local.get $header_pointer) (i32.const 20)))))
    (local.set $slot_count
      (i32.load (call $abs (i32.add (local.get $header_pointer) (i32.const 12)))))
    (local.set $capacity
      (i32.load (call $abs (i32.add (local.get $header_pointer) (i32.const 16)))))
    (if (i32.ge_u (local.get $slot_count) (local.get $capacity))
      (then
        (call $map_grow_entries (local.get $header_pointer)
          (global.get $SET_SLOT_STRIDE) (global.get $OBJ_SET_ENTRIES))
        (local.set $entries_pointer
          (i32.load (call $abs (i32.add (local.get $header_pointer) (i32.const 20)))))
        (local.set $slot_count
          (i32.load (call $abs (i32.add (local.get $header_pointer) (i32.const 12)))))
      )
    )

    (local.set $slot_pointer
      (i32.add
        (i32.add (local.get $entries_pointer) (global.get $GC_HEADER_SIZE))
        (i32.mul (local.get $slot_count) (global.get $SET_SLOT_STRIDE))))
    (i32.store (call $abs (local.get $slot_pointer)) (i32.const 0))  ;; tombstone=0
    (local.set $value_slot_pointer
      (i32.add (local.get $slot_pointer) (global.get $SET_SLOT_VALUE_OFFSET)))
    (i32.store (call $abs (local.get $value_slot_pointer))
      (i32.load (call $abs (local.get $value_pointer))))
    (i32.store (call $abs (i32.add (local.get $value_slot_pointer) (i32.const 4)))
      (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 4)))))
    (i32.store (call $abs (i32.add (local.get $value_slot_pointer) (i32.const 8)))
      (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 8)))))
    (i32.store (call $abs (i32.add (local.get $value_slot_pointer) (i32.const 12)))
      (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 12)))))
    (i32.store (call $abs (i32.add (local.get $header_pointer) (i32.const 12)))
      (i32.add (local.get $slot_count) (i32.const 1)))
    (local.set $size
      (i32.load (call $abs (i32.add (local.get $header_pointer) (i32.const 8)))))
    (i32.store (call $abs (i32.add (local.get $header_pointer) (i32.const 8)))
      (i32.add (local.get $size) (i32.const 1)))
  )

  ;; ==========================================================================
  ;; object_set_sym_entry(obj, sym_ptr, type, flags, data_lo, data_hi)
  ;;
  ;; Set a symbol-keyed property on an object. Lazily allocates the
  ;; sym-entries block on first call. Mirrors the JS-side
  ;; objectSetSymbolKey helper used during slice-1 bootstrap.
  ;;
  ;; This is intentionally a small append-style writer with no
  ;; capacity-grow path — callers (only the iterator factory today)
  ;; allocate a fresh empty object and never write more than one
  ;; symbol-keyed property on it, so the initial capacity of 4 is
  ;; always enough.
  ;; ==========================================================================
  ;; estimate_object_sym_entries_size() → bytes
  ;; Worst-case heap consumption of the lazy-allocation branch of
  ;; $object_set_sym_entry: 96 bytes (GC 8 + count 4 + capacity 4 +
  ;; 4 entries * 20 bytes). Fixed-size; capacity 4 is the only
  ;; allocation point (no grow path).
  (func $estimate_object_sym_entries_size (result i32)
    (i32.const 96)
  )

  (func $object_set_sym_entry
    (param $obj i32) (param $sym_ptr i32)
    (param $val_type i32) (param $val_flags i32)
    (param $val_lo i32) (param $val_hi i32)
    (local $entries_pointer i32)
    (local $heap_pointer i32)
    (local $sym_count i32)
    (local $entry_pointer i32)

    (local.set $entries_pointer
      (i32.load (call $abs (i32.add (local.get $obj) (global.get $OBJECT_SYM_ENTRIES_OFFSET)))))
    ;; Lazy-allocate the block on first call.
    (if (i32.eqz (local.get $entries_pointer))
      (then
        (local.set $heap_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))
        (local.set $entries_pointer (local.get $heap_pointer))
        ;; size = GC(8) + count(4) + capacity(4) + 4 * 20 = 96
        (i32.store (call $abs (local.get $entries_pointer))
          (i32.or (i32.const 96) (i32.shl (global.get $OBJ_OBJECT_DATA) (i32.const 24))))
        (i32.store (call $abs (i32.add (local.get $entries_pointer) (i32.const 4))) (i32.const 0))
        (i32.store (call $abs (i32.add (local.get $entries_pointer) (i32.const 8))) (i32.const 0))   ;; count
        (i32.store (call $abs (i32.add (local.get $entries_pointer) (i32.const 12))) (i32.const 4))  ;; cap
        (call $write_state (global.get $STATE_HEAP_POINTER)
          (i32.add (local.get $entries_pointer) (i32.const 96)))
        (i32.store (call $abs (i32.add (local.get $obj) (global.get $OBJECT_SYM_ENTRIES_OFFSET)))
          (local.get $entries_pointer))
      )
    )

    (local.set $sym_count
      (i32.load (call $abs (i32.add (local.get $entries_pointer) (i32.const 8)))))
    (local.set $entry_pointer
      (i32.add
        (i32.add (local.get $entries_pointer) (i32.const 16))  ;; entries start
        (i32.mul (local.get $sym_count) (global.get $ENTRY_SIZE))))
    (i32.store (call $abs (local.get $entry_pointer)) (local.get $sym_ptr))
    (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 4))) (local.get $val_type))
    (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 8))) (local.get $val_flags))
    (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 12))) (local.get $val_lo))
    (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 16))) (local.get $val_hi))
    (i32.store (call $abs (i32.add (local.get $entries_pointer) (i32.const 8)))
      (i32.add (local.get $sym_count) (i32.const 1)))
  )

  ;; ==========================================================================
  ;; sym_slot_addr(type, container) → address of sym-entries pointer slot
  ;;
  ;; Maps a receiver to the segment-relative address of its sym-entries
  ;; pointer slot, or 0 for receivers with no own symbol storage (strings,
  ;; plain primitives). `container` is the value's data_lo: header pointer
  ;; for Object/Function/Array/Map/Set, descriptor data pointer for typed
  ;; arrays.
  ;; ==========================================================================
  (func $sym_slot_addr (param $type i32) (param $container i32) (result i32)
    (if (i32.or
          (i32.eq (local.get $type) (global.get $TYPE_OBJECT))
          (i32.eq (local.get $type) (global.get $TYPE_FUNCTION)))
      (then (return (i32.add (local.get $container) (global.get $OBJECT_SYM_ENTRIES_OFFSET))))
    )
    (if (i32.eq (local.get $type) (global.get $TYPE_ARRAY))
      (then (return (i32.add (local.get $container) (global.get $ARRAY_SYM_ENTRIES_OFFSET))))
    )
    (if (i32.or
          (i32.eq (local.get $type) (global.get $TYPE_MAP))
          (i32.eq (local.get $type) (global.get $TYPE_SET)))
      (then (return (i32.add (local.get $container)
        (i32.add (global.get $GC_HEADER_SIZE) (global.get $MAP_SYM_ENTRIES_OFFSET)))))
    )
    (if (call $is_typed_array (local.get $type))
      (then (return (i32.add (local.get $container) (global.get $TYPED_ARRAY_SYM_ENTRIES_OFFSET))))
    )
    (i32.const 0)
  )

  ;; ==========================================================================
  ;; sym_block_find(entries_pointer, sym_ptr) → entry_pointer | 0
  ;;
  ;; Linear-search a sym-entries block ([GC:8][count:4][capacity:4]
  ;; [entries: count × ENTRY_SIZE]) for a symbol key (pointer equality).
  ;; Accepts 0 for a missing block.
  ;; ==========================================================================
  (func $sym_block_find (param $entries_pointer i32) (param $sym_ptr i32) (result i32)
    (local $count i32)
    (local $i i32)
    (local $entry_pointer i32)
    (if (i32.eqz (local.get $entries_pointer))
      (then (return (i32.const 0)))
    )
    (local.set $count (i32.load (call $abs (i32.add (local.get $entries_pointer) (i32.const 8)))))
    (local.set $i (i32.const 0))
    (block $scan_done
      (loop $scan
        (br_if $scan_done (i32.ge_u (local.get $i) (local.get $count)))
        (local.set $entry_pointer (i32.add
          (i32.add (local.get $entries_pointer) (i32.const 16))
          (i32.mul (local.get $i) (global.get $ENTRY_SIZE))))
        (if (i32.eq (i32.load (call $abs (local.get $entry_pointer))) (local.get $sym_ptr))
          (then (return (local.get $entry_pointer)))
        )
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $scan)
      )
    )
    (i32.const 0)
  )

  ;; ==========================================================================
  ;; string_key_is_hidden(key_offset) → 1 when the interned string starts
  ;; with '@'. The '@' namespace is unreachable from source (the lexer
  ;; cannot produce '@' in an identifier) and carries interpreter- and
  ;; parser-synthesized names: @param_N, iterator internals (@kind, @index),
  ;; and class-compilation bindings incl. #private member storage
  ;; for #private member storage. Hidden keys are non-enumerable: Object.keys/
  ;; values/entries/assign, object spread, and JSON.stringify skip them.
  ;; ==========================================================================
  (func $string_key_is_hidden (param $key_offset i32) (result i32)
    (if (i32.eqz (local.get $key_offset)) (then (return (i32.const 0))))
    (if (i32.eqz (i32.load (call $string_id_to_abs (local.get $key_offset))))
      (then (return (i32.const 0))))
    (i32.eq
      (i32.load8_u (i32.add (call $string_id_to_abs (local.get $key_offset)) (i32.const 4)))
      (i32.const 0x40))
  )

  ;; ==========================================================================
  ;; object_find_string_entry(object_pointer, key_offset) → entry_pointer | 0
  ;;
  ;; Find a string-keyed property entry on a TYPE_OBJECT / TYPE_FUNCTION
  ;; header, walking the prototype chain. Returns the ENTRY pointer
  ;; ([key:4][type:4][flags:4][lo:4][hi:4]) so the caller can read the
  ;; value in place, or 0 when not found. Used by the constructor-seeding
  ;; re-entry machinery to resolve `next` / `done` / `value`.
  ;; ==========================================================================
  (func $object_find_string_entry (param $object_pointer i32) (param $key_offset i32) (result i32)
    (local $current i32)
    (local $depth i32)
    (local $count i32)
    (local $entries_pointer i32)
    (local $i i32)
    (local $entry_pointer i32)
    (local.set $current (local.get $object_pointer))
    (block $find_done
      (loop $find_walk
        (br_if $find_done (i32.eqz (local.get $current)))
        (br_if $find_done (i32.ge_u (local.get $depth) (global.get $MAX_PROTO_DEPTH)))
        (local.set $count (i32.load (call $abs (i32.add (local.get $current) (i32.const 12)))))
        (local.set $entries_pointer (i32.load (call $abs (i32.add (local.get $current) (i32.const 24)))))
        (local.set $i (i32.const 0))
        (block $find_next_proto
          (loop $find_scan
            (br_if $find_next_proto (i32.ge_u (local.get $i) (local.get $count)))
            (local.set $entry_pointer (i32.add
              (i32.add (local.get $entries_pointer) (global.get $GC_HEADER_SIZE))
              (i32.mul (local.get $i) (global.get $ENTRY_SIZE))))
            (if (i32.eq (i32.load (call $abs (local.get $entry_pointer))) (local.get $key_offset))
              (then (return (local.get $entry_pointer))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $find_scan)
          )
        )
        (local.set $current (i32.load (call $abs (i32.add (local.get $current) (i32.const 8)))))
        (local.set $depth (i32.add (local.get $depth) (i32.const 1)))
        (br $find_walk)
      )
    )
    (i32.const 0)
  )

  ;; ==========================================================================
  ;; object_find_symbol_entry(object_pointer, sym_ptr) → entry_pointer | 0
  ;;
  ;; Symbol-keyed twin of $object_find_string_entry: walk the prototype
  ;; chain checking each level's sym-entries block. TYPE_OBJECT /
  ;; TYPE_FUNCTION receivers only. Used to resolve Symbol.iterator on a
  ;; general iterable.
  ;; ==========================================================================
  (func $object_find_symbol_entry (param $object_pointer i32) (param $sym_ptr i32) (result i32)
    (local $current i32)
    (local $depth i32)
    (local $entry_pointer i32)
    (local.set $current (local.get $object_pointer))
    (block $sym_find_done
      (loop $sym_find_walk
        (br_if $sym_find_done (i32.eqz (local.get $current)))
        (br_if $sym_find_done (i32.ge_u (local.get $depth) (global.get $MAX_PROTO_DEPTH)))
        (local.set $entry_pointer (call $sym_block_find
          (i32.load (call $abs (i32.add (local.get $current) (global.get $OBJECT_SYM_ENTRIES_OFFSET))))
          (local.get $sym_ptr)))
        (if (i32.ne (local.get $entry_pointer) (i32.const 0))
          (then (return (local.get $entry_pointer))))
        (local.set $current (i32.load (call $abs (i32.add (local.get $current) (i32.const 8)))))
        (local.set $depth (i32.add (local.get $depth) (i32.const 1)))
        (br $sym_find_walk)
      )
    )
    (i32.const 0)
  )

  ;; ==========================================================================
  ;; setop_has_continue(frame_pointer, verdict) → next pc | -1 | -2
  ;;
  ;; Continuation step for the HAS_DRIVEN set-theoretic methods over a
  ;; Set-like argument (intersection / difference / isSubsetOf /
  ;; isDisjointFrom): other.has(element) just returned; $verdict is its
  ;; truthiness. Applies the verdict, then advances to the receiver's next
  ;; live slot and stages the next has() call (argument pushed, fresh
  ;; scope, `this` = the Set-like), or completes (frame popped, result
  ;; pushed at the frame's pending base).
  ;;
  ;; Operation state: word 0 = continuation kind, word 1 = state array
  ;; [other, accumulator], word 2 = receiver Set. CONTINUATION_PHASE is the
  ;; current receiver-table slot; CONTINUATION_CALLBACK is the has() closure.
  ;;
  ;; Returns the pc to continue at, or -1 (error set — the caller runs the
  ;; throw dance), or -2 (heap pressure with NOTHING mutated — the caller
  ;; re-pushes the popped verdict value and yields parked on the RETURN
  ;; instruction, so the retry re-enters this step idempotently).
  ;; ==========================================================================
  (func $setop_has_continue (param $frame_pointer i32) (param $verdict i32) (result i32)
    (local $method_id i32)
    (local $state_handle i32)
    (local $state_data i32)
    (local $accumulator_slot i32)
    (local $receiver i32)
    (local $slot_index i32)
    (local $slot_count i32)
    (local $entries_pointer i32)
    (local $slot_pointer i32)
    (local $closure_pointer i32)
    (local $new_scope i32)
    (local $return_pc i32)
    (local $predicate_result i32)
    (local $wants_add i32)

    (local.set $state_handle
      (i32.load (i32.add
        (local.get $frame_pointer)
        (global.get $FRAME_CONTINUATION_STATE_HANDLE))))
    (local.set $method_id
      (call $native_continuation_state_get
        (local.get $state_handle) (i32.const 0)))
    (local.set $state_data (i32.load (call $abs (i32.add
      (call $native_continuation_state_get
        (local.get $state_handle) (i32.const 1))
      (i32.const 16)))))
    ;; state elements: [0] = other (value), [1] = accumulator (value)
    (local.set $accumulator_slot (i32.add
      (i32.add (local.get $state_data) (global.get $GC_HEADER_SIZE))
      (global.get $VALUE_SIZE)))
    (local.set $receiver
      (call $native_continuation_state_get
        (local.get $state_handle) (i32.const 2)))
    (local.set $slot_index (i32.load (i32.add (local.get $frame_pointer) (global.get $FRAME_CONTINUATION_PHASE))))
    ;; Re-read the receiver's table fresh: the has() callback may have
    ;; mutated (and grown/relocated) it.
    (local.set $entries_pointer (i32.load (call $abs (i32.add (local.get $receiver) (i32.const 20)))))
    (local.set $slot_pointer (i32.add
      (i32.add (local.get $entries_pointer) (global.get $GC_HEADER_SIZE))
      (i32.mul (local.get $slot_index) (global.get $SET_SLOT_STRIDE))))

    ;; Apply the verdict for the CURRENT slot. -1 = keep iterating.
    (local.set $predicate_result (i32.const -1))
    (local.set $wants_add (i32.const 0))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_SET_INTERSECTION))
      (then (local.set $wants_add (local.get $verdict))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_SET_DIFFERENCE))
      (then (local.set $wants_add (i32.eqz (local.get $verdict)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_SET_IS_SUBSET_OF))
      (then
        (if (i32.eqz (local.get $verdict))
          (then (local.set $predicate_result (i32.const 0))))))   ;; early false
    (if (i32.eq (local.get $method_id) (global.get $METHOD_SET_IS_DISJOINT_FROM))
      (then
        (if (local.get $verdict)
          (then (local.set $predicate_result (i32.const 0))))))   ;; early false

    (if (local.get $wants_add)
      (then
        ;; Grow budget BEFORE mutating so a pressure retry is clean.
        (if (call $check_heap_overflow (call $estimate_collection_grow_size
              (global.get $SET_SLOT_STRIDE)
              (i32.load (call $abs (i32.add
                (i32.load (call $abs (i32.add (local.get $accumulator_slot) (i32.const 8))))
                (i32.const 16))))))
          (then (return (i32.const -2))))
        ;; First slot word: 0 = live, nonzero = tombstone. Value at
        ;; slot + SET_SLOT_VALUE_OFFSET.
        (if (i32.eqz (i32.load (call $abs (local.get $slot_pointer))))
          (then (call $set_add
            (i32.load (call $abs (i32.add (local.get $accumulator_slot) (i32.const 8))))
            (i32.add (local.get $slot_pointer) (global.get $SET_SLOT_VALUE_OFFSET)))))
      )
    )

    ;; Advance to the next live slot (unless an early verdict completed).
    (if (i32.eq (local.get $predicate_result) (i32.const -1))
      (then
        (local.set $slot_count (i32.load (call $abs (i32.add (local.get $receiver) (i32.const 12)))))
        (local.set $slot_index (i32.add (local.get $slot_index) (i32.const 1)))
        (block $setop_has_scan_done
          (loop $setop_has_scan
            (br_if $setop_has_scan_done (i32.ge_u (local.get $slot_index) (local.get $slot_count)))
            (local.set $slot_pointer (i32.add
              (i32.add (local.get $entries_pointer) (global.get $GC_HEADER_SIZE))
              (i32.mul (local.get $slot_index) (global.get $SET_SLOT_STRIDE))))
            ;; 0 = live slot (nonzero = tombstone)
            (br_if $setop_has_scan_done
              (i32.eqz (i32.load (call $abs (local.get $slot_pointer)))))
            (local.set $slot_index (i32.add (local.get $slot_index) (i32.const 1)))
            (br $setop_has_scan)
          )
        )
        (if (i32.lt_u (local.get $slot_index) (local.get $slot_count))
          (then
            ;; Stage the next other.has(element) call.
            (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_CONTINUATION_PHASE)) (local.get $slot_index))
            (local.set $closure_pointer (i32.load (i32.add (local.get $frame_pointer) (global.get $FRAME_CONTINUATION_CALLBACK))))
            (call $write_ctx (global.get $CTX_PENDING_POINTER)
              (call $load_frame_pending_base (local.get $frame_pointer)))
            (call $pending_push
              (i32.load (call $abs (i32.add (local.get $slot_pointer) (global.get $SET_SLOT_VALUE_OFFSET))))
              (i32.load (call $abs (i32.add (i32.add (local.get $slot_pointer) (global.get $SET_SLOT_VALUE_OFFSET)) (i32.const 4))))
              (i32.load (call $abs (i32.add (i32.add (local.get $slot_pointer) (global.get $SET_SLOT_VALUE_OFFSET)) (i32.const 8))))
              (i32.load (call $abs (i32.add (i32.add (local.get $slot_pointer) (global.get $SET_SLOT_VALUE_OFFSET)) (i32.const 12)))))
            (local.set $new_scope (call $scope_create
              (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 40))))))
            (global.set $current_scope (local.get $new_scope))
            (if (i32.eqz (i32.and
                  (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 44))))
                  (global.get $CLOSURE_FLAG_ARROW)))
              (then
                (call $scope_define (local.get $new_scope)
                  (call $read_builtin (i32.const 0x18))   ;; BUILTIN_NAME.THIS
                  (i32.load (call $abs (i32.add (local.get $state_data) (global.get $GC_HEADER_SIZE))))
                  (i32.const 0)
                  (i32.load (call $abs (i32.add
                    (i32.add (local.get $state_data) (global.get $GC_HEADER_SIZE))
                    (i32.const 8))))
                  (i32.const 0))
                (call $scope_define_new_target (local.get $new_scope)
                  (global.get $TYPE_UNDEFINED) (i32.const 0))))
            (return (i32.load (call $abs (i32.add (local.get $closure_pointer) (global.get $FUNCTION_CLOSURE_OFFSET)))))
          )
        )
        ;; Exhausted every element: the predicates held throughout.
        (local.set $predicate_result (i32.const 1))
      )
    )

    ;; Completion: pop the frame, land the result at the pending base.
    (local.set $return_pc (i32.load (i32.add (local.get $frame_pointer) (global.get $FRAME_INSTRUCTION_INDEX))))
    (call $write_ctx (global.get $CTX_CALL_STACK_POINTER)
      (i32.sub (call $read_ctx (global.get $CTX_CALL_STACK_POINTER)) (global.get $FRAME_SIZE)))
    (call $write_ctx (global.get $CTX_PENDING_POINTER)
      (call $load_frame_pending_base (local.get $frame_pointer)))
    (global.set $current_scope (i32.load (i32.add (local.get $frame_pointer) (global.get $FRAME_SCOPE_POINTER))))
    (if (i32.or
          (i32.eq (local.get $method_id) (global.get $METHOD_SET_INTERSECTION))
          (i32.eq (local.get $method_id) (global.get $METHOD_SET_DIFFERENCE)))
      (then
        (call $pending_push
          (i32.load (call $abs (local.get $accumulator_slot)))
          (i32.load (call $abs (i32.add (local.get $accumulator_slot) (i32.const 4))))
          (i32.load (call $abs (i32.add (local.get $accumulator_slot) (i32.const 8))))
          (i32.load (call $abs (i32.add (local.get $accumulator_slot) (i32.const 12))))))
      (else
        (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (local.get $predicate_result) (i32.const 0))))
    (local.get $return_pc)
  )

  ;; ==========================================================================
  ;; setop_keys_continue(frame_pointer, result_type, result_lo) → pc | -1 | -2
  ;;
  ;; Continuation step for the KEYS_DRIVEN set-theoretic methods over a
  ;; Set-like argument (union / symmetricDifference / isSupersetOf).
  ;; Phase 0: other.keys() just returned — store the iterator (state[2]) and
  ;; resolve its next method. Phase 1: next()
  ;; returned a step object — apply the element to the accumulator (or
  ;; test it for isSupersetOf), then re-invoke next() until done.
  ;;
  ;; Operation state: word 0 = continuation kind, word 1 = state array
  ;; [other, accumulator, iterator], word 2 = receiver Set.
  ;; CONTINUATION_CALLBACK is the keys()/next() closure. Return codes are as
  ;; in $setop_has_continue.
  ;; ==========================================================================
  (func $setop_keys_continue (param $frame_pointer i32) (param $result_type i32) (param $result_lo i32) (result i32)
    (local $state_handle i32)
    (local $method_id i32)
    (local $phase i32)
    (local $state_data i32)
    (local $accumulator_slot i32)
    (local $iterator_slot i32)
    (local $entry_pointer i32)
    (local $closure_pointer i32)
    (local $new_scope i32)
    (local $receiver i32)
    (local $value_slot i32)
    (local $return_pc i32)
    (local $accumulator_header i32)

    (local.set $state_handle
      (i32.load (i32.add
        (local.get $frame_pointer)
        (global.get $FRAME_CONTINUATION_STATE_HANDLE))))
    (local.set $method_id
      (call $native_continuation_state_get
        (local.get $state_handle) (i32.const 0)))
    (local.set $phase (i32.load (i32.add (local.get $frame_pointer) (global.get $FRAME_CONTINUATION_PHASE))))
    (local.set $state_data (i32.load (call $abs (i32.add
      (call $native_continuation_state_get
        (local.get $state_handle) (i32.const 1))
      (i32.const 16)))))
    (local.set $accumulator_slot (i32.add
      (i32.add (local.get $state_data) (global.get $GC_HEADER_SIZE))
      (global.get $VALUE_SIZE)))
    (local.set $iterator_slot (i32.add (local.get $accumulator_slot) (global.get $VALUE_SIZE)))
    (local.set $receiver
      (call $native_continuation_state_get
        (local.get $state_handle) (i32.const 2)))

    ;; Both phases require an object result (iterator / IteratorResult).
    (if (i32.ne (local.get $result_type) (global.get $TYPE_OBJECT))
      (then
        (call $set_error (global.get $ERR_TYPE_ERROR) (i32.const 0))
        (return (i32.const -1))))

    (if (i32.eqz (local.get $phase))
      (then
        ;; Phase 0 → store the iterator, resolve next.
        (i32.store (call $abs (local.get $iterator_slot)) (global.get $TYPE_OBJECT))
        (i32.store (call $abs (i32.add (local.get $iterator_slot) (i32.const 4))) (i32.const 0))
        (i32.store (call $abs (i32.add (local.get $iterator_slot) (i32.const 8))) (local.get $result_lo))
        (i32.store (call $abs (i32.add (local.get $iterator_slot) (i32.const 12))) (i32.const 0))
        (local.set $entry_pointer (call $object_find_string_entry
          (local.get $result_lo) (call $read_builtin (global.get $BUILTIN_ITER_NEXT_KEY))))
        (if (i32.eqz (call $entry_value_is_function (local.get $entry_pointer)))
          (then
            (call $set_error (global.get $ERR_TYPE_ERROR) (i32.const 0))
            (return (i32.const -1))))
        (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_CONTINUATION_CALLBACK))
          (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 12)))))
        (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_CONTINUATION_PHASE)) (i32.const 1))
      )
      (else
        ;; Phase 1 → step object. done?
        (local.set $entry_pointer (call $object_find_string_entry
          (local.get $result_lo) (call $read_builtin (global.get $BUILTIN_ITER_DONE_KEY))))
        (if (call $entry_value_is_truthy (local.get $entry_pointer))
          (then
            ;; Done → accumulator (union/symmetricDifference) or true
            ;; (isSupersetOf survived every element).
            (local.set $return_pc (i32.load (i32.add (local.get $frame_pointer) (global.get $FRAME_INSTRUCTION_INDEX))))
            (call $write_ctx (global.get $CTX_CALL_STACK_POINTER)
              (i32.sub (call $read_ctx (global.get $CTX_CALL_STACK_POINTER)) (global.get $FRAME_SIZE)))
            (call $write_ctx (global.get $CTX_PENDING_POINTER)
              (call $load_frame_pending_base (local.get $frame_pointer)))
            (global.set $current_scope (i32.load (i32.add (local.get $frame_pointer) (global.get $FRAME_SCOPE_POINTER))))
            (if (i32.eq (local.get $method_id) (global.get $METHOD_SET_IS_SUPERSET_OF))
              (then
                (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (i32.const 1) (i32.const 0)))
              (else
                (call $pending_push
                  (i32.load (call $abs (local.get $accumulator_slot)))
                  (i32.load (call $abs (i32.add (local.get $accumulator_slot) (i32.const 4))))
                  (i32.load (call $abs (i32.add (local.get $accumulator_slot) (i32.const 8))))
                  (i32.load (call $abs (i32.add (local.get $accumulator_slot) (i32.const 12)))))))
            (return (local.get $return_pc))
          )
        )
        ;; step.value (absent → an undefined slot staged on the pending
        ;; stack; it is truncated again before the next() call below)
        (local.set $entry_pointer (call $object_find_string_entry
          (local.get $result_lo) (call $read_builtin (global.get $BUILTIN_ITER_VALUE_KEY))))
        (if (i32.ne (local.get $entry_pointer) (i32.const 0))
          (then (local.set $value_slot (i32.add (local.get $entry_pointer) (i32.const 4))))
          (else
            (call $pending_push (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))
            (local.set $value_slot (i32.sub (call $read_ctx (global.get $CTX_PENDING_POINTER)) (global.get $VALUE_SIZE)))))
        (local.set $accumulator_header
          (i32.load (call $abs (i32.add (local.get $accumulator_slot) (i32.const 8)))))
        (if (i32.eq (local.get $method_id) (global.get $METHOD_SET_UNION))
          (then
            (if (call $check_heap_overflow (call $estimate_collection_grow_size
                  (global.get $SET_SLOT_STRIDE)
                  (i32.load (call $abs (i32.add (local.get $accumulator_header) (i32.const 16))))))
              (then (return (i32.const -2))))
            (call $set_add (local.get $accumulator_header) (local.get $value_slot))
          )
        )
        (if (i32.eq (local.get $method_id) (global.get $METHOD_SET_SYMMETRIC_DIFFERENCE))
          (then
            ;; Toggle. Grow budget checked BEFORE the delete attempt so a
            ;; pressure retry can't double-toggle.
            (if (call $check_heap_overflow (call $estimate_collection_grow_size
                  (global.get $SET_SLOT_STRIDE)
                  (i32.load (call $abs (i32.add (local.get $accumulator_header) (i32.const 16))))))
              (then (return (i32.const -2))))
            (if (i32.eqz (call $set_delete (local.get $accumulator_header) (local.get $value_slot)))
              (then (call $set_add (local.get $accumulator_header) (local.get $value_slot))))
          )
        )
        (if (i32.eq (local.get $method_id) (global.get $METHOD_SET_IS_SUPERSET_OF))
          (then
            (if (i32.eq (call $set_find_slot (local.get $receiver) (local.get $value_slot)) (i32.const -1))
              (then
                ;; Missing element → false, complete now.
                (local.set $return_pc (i32.load (i32.add (local.get $frame_pointer) (global.get $FRAME_INSTRUCTION_INDEX))))
                (call $write_ctx (global.get $CTX_CALL_STACK_POINTER)
                  (i32.sub (call $read_ctx (global.get $CTX_CALL_STACK_POINTER)) (global.get $FRAME_SIZE)))
                (call $write_ctx (global.get $CTX_PENDING_POINTER)
                  (call $load_frame_pending_base (local.get $frame_pointer)))
                (global.set $current_scope (i32.load (i32.add (local.get $frame_pointer) (global.get $FRAME_SCOPE_POINTER))))
                (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (i32.const 0) (i32.const 0))
                (return (local.get $return_pc))
              )
            )
          )
        )
      )
    )

    ;; Invoke iterator.next() with `this` = the iterator (state[2]).
    (local.set $closure_pointer (i32.load (i32.add (local.get $frame_pointer) (global.get $FRAME_CONTINUATION_CALLBACK))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER)
      (call $load_frame_pending_base (local.get $frame_pointer)))
    (local.set $new_scope (call $scope_create
      (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 40))))))
    (global.set $current_scope (local.get $new_scope))
    (if (i32.eqz (i32.and
          (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 44))))
          (global.get $CLOSURE_FLAG_ARROW)))
      (then
        (call $scope_define (local.get $new_scope)
          (call $read_builtin (i32.const 0x18))   ;; BUILTIN_NAME.THIS
          (i32.load (call $abs (local.get $iterator_slot)))
          (i32.const 0)
          (i32.load (call $abs (i32.add (local.get $iterator_slot) (i32.const 8))))
          (i32.const 0))
        (call $scope_define_new_target (local.get $new_scope)
          (global.get $TYPE_UNDEFINED) (i32.const 0))))
    (i32.load (call $abs (i32.add (local.get $closure_pointer) (global.get $FUNCTION_CLOSURE_OFFSET))))
  )

  ;; ==========================================================================
  ;; Guarded entry-value predicates. WAT's i32.and does NOT short-circuit,
  ;; so `(i32.and (ne entry 0) (load entry+4 ...))` evaluates the load even
  ;; for a missing entry — reading garbage at low addresses (and, through
  ;; a garbage pointer chain, potentially out of bounds). Every "does this
  ;; found-entry hold X" check goes through these instead.
  ;; ==========================================================================
  (func $entry_value_is_function (param $entry_pointer i32) (result i32)
    (if (i32.eqz (local.get $entry_pointer))
      (then (return (i32.const 0))))
    (i32.eq
      (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 4))))
      (global.get $TYPE_FUNCTION)))

  ;; A sym/string entry holding a generator object's self-returning
  ;; Symbol.iterator (BOUND_METHOD → GENERATOR_SELF). The seed drivers
  ;; recognize these and drive the native next() via the sentinel-park
  ;; protocol.
  (func $entry_value_is_accessor (param $entry_pointer i32) (result i32)
    (if (i32.eqz (local.get $entry_pointer))
      (then (return (i32.const 0))))
    (i32.eq
      (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 4))))
      (global.get $TYPE_ACCESSOR)))

  (func $entry_value_is_generator_iterator (param $entry_pointer i32) (result i32)
    (if (i32.eqz (local.get $entry_pointer))
      (then (return (i32.const 0))))
    (i32.and
      (i32.eq
        (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 4))))
        (global.get $TYPE_BOUND_METHOD))
      (i32.eq
        (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 16))))
        (global.get $METHOD_GENERATOR_SELF))))

  (func $entry_value_is_truthy (param $entry_pointer i32) (result i32)
    (if (i32.eqz (local.get $entry_pointer))
      (then (return (i32.const 0))))
    (call $is_truthy_inline
      (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 4))))
      (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 8))))
      (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 12))))
      (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 16))))))

  ;; A value slot holding a TYPE_OBJECT whose object carries at least one
  ;; accessor entry (guarded: non-objects never dereference data_lo).
  (func $value_is_accessor_bearing_object (param $value_pointer i32) (result i32)
    (if (i32.ne (call $value_type (local.get $value_pointer)) (global.get $TYPE_OBJECT))
      (then (return (i32.const 0))))
    (call $object_has_accessor_entry (call $value_data_lo (local.get $value_pointer))))

  ;; ==========================================================================
  ;; object_has_accessor_entry(object_pointer) → 0 | 1
  ;;
  ;; Scan an object's OWN entries for a TYPE_ACCESSOR value. Used by the
  ;; operations that need data-only objects (spread, Object.values/
  ;; entries/assign, JSON.stringify) to decide whether to run the
  ;; accessor resolver first.
  ;; ==========================================================================
  (func $object_has_accessor_entry (param $object_pointer i32) (result i32)
    (local $count i32)
    (local $i i32)
    (local $entries_pointer i32)
    (local.set $count (i32.load (call $abs (i32.add (local.get $object_pointer) (i32.const 12)))))
    (local.set $entries_pointer (i32.load (call $abs (i32.add (local.get $object_pointer) (i32.const 24)))))
    (block $has_acc_done
      (loop $has_acc_scan
        (br_if $has_acc_done (i32.ge_u (local.get $i) (local.get $count)))
        (if (i32.eq
              (i32.load (call $abs (i32.add
                (i32.add
                  (i32.add (local.get $entries_pointer) (global.get $GC_HEADER_SIZE))
                  (i32.mul (local.get $i) (global.get $ENTRY_SIZE)))
                (i32.const 4))))
              (global.get $TYPE_ACCESSOR))
          (then (return (i32.const 1))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $has_acc_scan)
      )
    )
    (i32.const 0)
  )

  ;; ==========================================================================
  ;; accessor_resolve_step(frame_pointer) → next pc
  ;;
  ;; Walk the source object's entries from ITER_INDEX, copying data
  ;; properties (and undefined for setter-only accessors) into the copy
  ;; object, until a getter-backed accessor needs invoking — then stage
  ;; the getter call (fresh scope, `this` = the source) and return its
  ;; start pc — or until exhausted — then pop the frame, write the
  ;; finished copy directly into the pending-stack slot the frame's
  ;; ITER_LENGTH offset names (base − offset), restore the pending
  ;; pointer to the base, and return the frame's saved pc so the caller
  ;; re-executes the ORIGINAL instruction against the resolved copy.
  ;;
  ;; Frame slot roles: ITER_INDEX = entry index; ITER_LENGTH = byte
  ;; offset from the pending base DOWN to the operand slot to replace;
  ;; ITER_RECEIVER = the source object; ITER_RESULT = the copy;
  ;; ITER_CALLBACK = the getter being invoked. The source's count and
  ;; entries pointer are re-read every step (getters may mutate it).
  ;; ==========================================================================
  (func $accessor_resolve_step (param $frame_pointer i32) (result i32)
    (local $source i32)
    (local $copy i32)
    (local $index i32)
    (local $state_handle i32)
    (local $count i32)
    (local $entries_pointer i32)
    (local $entry_pointer i32)
    (local $entry_type i32)
    (local $closure_pointer i32)
    (local $new_scope i32)
    (local $slot_seg i32)
    (local $return_pc i32)

    (local.set $state_handle
      (i32.load (i32.add
        (local.get $frame_pointer)
        (global.get $FRAME_CONTINUATION_STATE_HANDLE))))
    (local.set $source
      (call $native_continuation_state_get
        (local.get $state_handle) (i32.const 2)))
    (local.set $copy
      (call $native_continuation_state_get
        (local.get $state_handle) (i32.const 1)))
    (local.set $index (i32.load (i32.add (local.get $frame_pointer) (global.get $FRAME_CONTINUATION_PHASE))))

    (block $resolve_walk_done
      (loop $resolve_walk
        ;; Live source count, capped at the copy's capacity (= the count
        ;; at begin) so properties a getter ADDS mid-resolve are not
        ;; visited and the pre-sized copy can never grow (which keeps
        ;; the per-entry writes pressure-free).
        (local.set $count (i32.load (call $abs (i32.add (local.get $source) (i32.const 12)))))
        (if (i32.gt_u (local.get $count)
              (i32.load (call $abs (i32.add (local.get $copy) (i32.const 16)))))
          (then (local.set $count
            (i32.load (call $abs (i32.add (local.get $copy) (i32.const 16)))))))
        (br_if $resolve_walk_done (i32.ge_u (local.get $index) (local.get $count)))
        (local.set $entries_pointer (i32.load (call $abs (i32.add (local.get $source) (i32.const 24)))))
        (local.set $entry_pointer (i32.add
          (i32.add (local.get $entries_pointer) (global.get $GC_HEADER_SIZE))
          (i32.mul (local.get $index) (global.get $ENTRY_SIZE))))
        (local.set $entry_type (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 4)))))
        (if (i32.ne (local.get $entry_type) (global.get $TYPE_ACCESSOR))
          (then
            ;; Plain data property: copy verbatim. The copy is pre-sized
            ;; to the begin-time count (see loop header) — grow
            ;; unreachable, status droppable.
            (drop (call $object_set_property (local.get $copy)
              (i32.load (call $abs (local.get $entry_pointer)))
              (local.get $entry_type)
              (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 8))))
              (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 12))))
              (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 16))))))
          )
          (else
            (local.set $closure_pointer
              (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 12)))))
            (if (i32.eqz (local.get $closure_pointer))
              (then
                ;; Setter-only accessor: reads give undefined. Pre-sized
                ;; copy — status droppable.
                (drop (call $object_set_property (local.get $copy)
                  (i32.load (call $abs (local.get $entry_pointer)))
                  (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0)))
              )
              (else
                ;; Getter: stage the call. The result lands in the copy via
                ;; the RETURN continuation; ITER_INDEX still names this entry.
                (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_CONTINUATION_PHASE)) (local.get $index))
                (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_CONTINUATION_CALLBACK)) (local.get $closure_pointer))
                (call $write_ctx (global.get $CTX_PENDING_POINTER)
                  (call $load_frame_pending_base (local.get $frame_pointer)))
                (local.set $new_scope (call $scope_create
                  (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 40))))))
                (global.set $current_scope (local.get $new_scope))
                (if (i32.eqz (i32.and
                      (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 44))))
                      (global.get $CLOSURE_FLAG_ARROW)))
                  (then
                    (call $scope_define (local.get $new_scope)
                      (call $read_builtin (i32.const 0x18))   ;; BUILTIN_NAME.THIS
                      (global.get $TYPE_OBJECT) (i32.const 0)
                      (local.get $source) (i32.const 0))
                    (call $scope_define_new_target (local.get $new_scope)
                      (global.get $TYPE_UNDEFINED) (i32.const 0))))
                (return (i32.load (call $abs (i32.add (local.get $closure_pointer) (global.get $FUNCTION_CLOSURE_OFFSET)))))
              )
            )
          )
        )
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $resolve_walk)
      )
    )

    ;; Exhausted: pop the frame, write the copy into the operand slot,
    ;; restore the pending pointer, and re-run the blocked instruction.
    (local.set $return_pc (i32.load (i32.add (local.get $frame_pointer) (global.get $FRAME_INSTRUCTION_INDEX))))
    (call $write_ctx (global.get $CTX_CALL_STACK_POINTER)
      (i32.sub (call $read_ctx (global.get $CTX_CALL_STACK_POINTER)) (global.get $FRAME_SIZE)))
    (global.set $current_scope (i32.load (i32.add (local.get $frame_pointer) (global.get $FRAME_SCOPE_POINTER))))
    (local.set $slot_seg (i32.sub
      (call $load_frame_pending_base (local.get $frame_pointer))
      (call $native_continuation_state_get
        (local.get $state_handle) (i32.const 0))))
    (i32.store (call $abs (local.get $slot_seg)) (global.get $TYPE_OBJECT))
    (i32.store (call $abs (i32.add (local.get $slot_seg) (i32.const 4))) (i32.const 0))
    (i32.store (call $abs (i32.add (local.get $slot_seg) (i32.const 8))) (local.get $copy))
    (i32.store (call $abs (i32.add (local.get $slot_seg) (i32.const 12))) (i32.const 0))
    (call $write_ctx (global.get $CTX_PENDING_POINTER)
      (call $load_frame_pending_base (local.get $frame_pointer)))
    (local.get $return_pc)
  )

  ;; ==========================================================================
  ;; accessor_resolve_begin(source_pointer, slot_offset, pc) → next pc | -2
  ;;
  ;; Start resolving an accessor-bearing object: pre-check and allocate
  ;; the data-only copy (sized to the source's entry count, so the copy
  ;; never grows and the per-entry writes are pressure-free), push the
  ;; ACCESSOR_RESOLVE continuation frame anchored at the CURRENT pending
  ;; pointer, and take the first step. $slot_offset is the byte distance
  ;; from the pending pointer down to the operand slot the resolved copy
  ;; replaces; $pc is the CURRENT instruction, re-executed on completion.
  ;; Returns -2 on heap pressure with nothing mutated (caller parks the
  ;; pc and yields; the retry re-runs the original instruction).
  ;; ==========================================================================
  (func $accessor_resolve_begin (param $source_pointer i32) (param $slot_offset i32) (param $pc i32) (result i32)
    (local $count i32)
    (local $copy i32)
    (local $stack_pointer i32)
    (local $frame_pointer i32)
    (local $state_handle i32)
    (local $sym_entries i32)
    (local $sym_count i32)
    (local $sym_index i32)
    (local $sym_entry_pointer i32)
    (local.set $count (i32.load (call $abs (i32.add (local.get $source_pointer) (i32.const 12)))))
    (if (call $check_heap_overflow (call $estimate_object_size (local.get $count)))
      (then (return (i32.const -2))))
    (local.set $copy (call $allocate_object (local.get $count)))

    ;; Carry the source's own symbol-keyed properties onto the copy —
    ;; the copy substitutes for the source in the re-run instruction
    ;; (spread / Object.assign), whose sym_entries walk must still see
    ;; them. Plain data copy ($sym_block_set — symbol-keyed accessors
    ;; are not authorable). On a refused allocation return -2: the
    ;; frame is not yet pushed, nothing observable mutated (the copy
    ;; is orphaned for gc), and the caller yields-and-retries.
    (local.set $sym_entries
      (i32.load (call $abs (i32.add (local.get $source_pointer) (global.get $OBJECT_SYM_ENTRIES_OFFSET)))))
    (if (i32.ne (local.get $sym_entries) (i32.const 0))
      (then
        (local.set $sym_count (i32.load (call $abs (i32.add (local.get $sym_entries) (i32.const 8)))))
        (local.set $sym_index (i32.const 0))
        (block $sym_copy_done
          (loop $sym_copy_loop
            (br_if $sym_copy_done (i32.ge_u (local.get $sym_index) (local.get $sym_count)))
            (local.set $sym_entry_pointer (i32.add
              (i32.add (local.get $sym_entries) (i32.const 16))
              (i32.mul (local.get $sym_index) (global.get $ENTRY_SIZE))))
            (if (call $sym_block_set
                  (i32.add (local.get $copy) (global.get $OBJECT_SYM_ENTRIES_OFFSET))
                  (i32.load (call $abs (local.get $sym_entry_pointer)))
                  (i32.load (call $abs (i32.add (local.get $sym_entry_pointer) (i32.const 4))))
                  (i32.load (call $abs (i32.add (local.get $sym_entry_pointer) (i32.const 8))))
                  (i32.load (call $abs (i32.add (local.get $sym_entry_pointer) (i32.const 12))))
                  (i32.load (call $abs (i32.add (local.get $sym_entry_pointer) (i32.const 16)))))
              (then (return (i32.const -2))))
            (local.set $sym_index (i32.add (local.get $sym_index) (i32.const 1)))
            (br $sym_copy_loop)
          )
        )
      )
    )

    (if (call $check_heap_overflow
          (global.get $NATIVE_CONTINUATION_STATE_SIZE))
      (then (return (i32.const -2))))
    (local.set $state_handle
      (call $allocate_native_continuation_state
        (i32.const 6) (i32.const 0)
        (local.get $slot_offset) (local.get $copy)
        (local.get $source_pointer) (global.get $TYPE_OBJECT) (i32.const 0)))

    (local.set $stack_pointer (call $read_ctx (global.get $CTX_CALL_STACK_POINTER)))
    (local.set $frame_pointer (call $abs (local.get $stack_pointer)))
    (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_INSTRUCTION_INDEX)) (local.get $pc))
    (call $publish_native_continuation_frame
      (local.get $frame_pointer) (local.get $stack_pointer)
      (call $read_ctx (global.get $CTX_PENDING_POINTER))
      (i32.const 1) (i32.const 0) (i32.const 0)
      (local.get $state_handle) (i32.const 0)
      (global.get $CONTINUATION_KIND_ACCESSOR_RESOLVE)
      (i32.const 0) (i32.const 0)
      (i32.const 0) (i32.const 0))
    (call $accessor_resolve_step (local.get $frame_pointer))
  )

  ;; ==========================================================================
  ;; accessor_resolve_continue(frame_pointer, type, flags, lo, hi) → next pc
  ;;
  ;; A getter just returned: write its value into the copy under the
  ;; current entry's key, advance, and take the next step.
  ;; ==========================================================================
  (func $accessor_resolve_continue
    (param $frame_pointer i32)
    (param $result_type i32) (param $result_flags i32)
    (param $result_lo i32) (param $result_hi i32)
    (result i32)
    (local $source i32)
    (local $state_handle i32)
    (local $index i32)
    (local $entry_pointer i32)
    (local.set $state_handle
      (i32.load (i32.add
        (local.get $frame_pointer)
        (global.get $FRAME_CONTINUATION_STATE_HANDLE))))
    (local.set $source
      (call $native_continuation_state_get
        (local.get $state_handle) (i32.const 2)))
    (local.set $index
      (i32.load (i32.add
        (local.get $frame_pointer)
        (global.get $FRAME_CONTINUATION_PHASE))))
    ;; Guard against the getter shrinking the source under us.
    (if (i32.lt_u (local.get $index)
          (i32.load (call $abs (i32.add (local.get $source) (i32.const 12)))))
      (then
        (local.set $entry_pointer (i32.add
          (i32.add
            (i32.load (call $abs (i32.add (local.get $source) (i32.const 24))))
            (global.get $GC_HEADER_SIZE))
          (i32.mul (local.get $index) (global.get $ENTRY_SIZE))))
        ;; Pre-sized copy (capacity = begin-time count) — status droppable.
        (drop (call $object_set_property
          (call $native_continuation_state_get
            (local.get $state_handle) (i32.const 1))
          (i32.load (call $abs (local.get $entry_pointer)))
          (local.get $result_type) (local.get $result_flags)
          (local.get $result_lo) (local.get $result_hi)))
      )
    )
    (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_CONTINUATION_PHASE))
      (i32.add (local.get $index) (i32.const 1)))
    (call $accessor_resolve_step (local.get $frame_pointer))
  )

  ;; ==========================================================================
  ;; array_from_source_is_native(type) → i32
  ;;
  ;; True for the Array.from source types that convert to an array with a
  ;; single synchronous walk: Set, Map, and every typed-array type.
  ;; ==========================================================================
  (func $array_from_source_is_native (param $source_type i32) (result i32)
    (if (i32.eq (local.get $source_type) (global.get $TYPE_SET)) (then (return (i32.const 1))))
    (if (i32.eq (local.get $source_type) (global.get $TYPE_MAP)) (then (return (i32.const 1))))
    (if (i32.eq (local.get $source_type) (global.get $TYPE_UINT8ARRAY)) (then (return (i32.const 1))))
    ;; INT8ARRAY (0x14) .. FLOAT64ARRAY (0x1B) are contiguous tags.
    (if (i32.and
          (i32.ge_u (local.get $source_type) (global.get $TYPE_INT8ARRAY))
          (i32.le_u (local.get $source_type) (global.get $TYPE_FLOAT64ARRAY)))
      (then (return (i32.const 1))))
    (if (i32.eq (local.get $source_type) (global.get $TYPE_BIGINT64ARRAY)) (then (return (i32.const 1))))
    (if (i32.eq (local.get $source_type) (global.get $TYPE_BIGUINT64ARRAY)) (then (return (i32.const 1))))
    (i32.const 0)
  )

  ;; ==========================================================================
  ;; array_from_native(source_type, source_lo) → array header pointer | -1
  ;;
  ;; Synchronously convert a Set / Map / typed-array Array.from source into
  ;; a fresh array. The whole budget is pre-checked up front; -1 means heap
  ;; pressure with nothing allocated (the caller yields and retries the
  ;; original instruction). Set yields its live values in slot order; Map
  ;; yields [key, value] pair arrays; typed arrays yield floats (matching
  ;; the typed-array iterator), with BigInt64/BigUint64 elements allocated
  ;; as fresh BigInts.
  ;; ==========================================================================
  (func $array_from_native (param $source_type i32) (param $source_lo i32) (result i32)
    (local $count i32)
    (local $budget i32)
    (local $new_arr i32)
    (local $new_data i32)
    (local $dest i32)
    (local $slot_index i32)
    (local $slot_count i32)
    (local $entries_pointer i32)
    (local $slot_pointer i32)
    (local $write_index i32)
    (local $pair i32)
    (local $pair_data i32)
    (local $bytes_per_element i32)
    (local $byte_pointer i32)
    (local $f64_result f64)
    (local $element_i64 i64)
    (local $is_bigint_source i32)

    (if (i32.or
          (i32.eq (local.get $source_type) (global.get $TYPE_SET))
          (i32.eq (local.get $source_type) (global.get $TYPE_MAP)))
      (then
        ;; Collection header: [GC:8][size:4][slotCount:4][capacity:4][entries:4]
        (local.set $count (i32.load (call $abs (i32.add (local.get $source_lo) (i32.const 8)))))
        (local.set $budget (call $estimate_array_size (local.get $count)))
        (if (i32.eq (local.get $source_type) (global.get $TYPE_MAP))
          (then
            (local.set $budget (i32.add (local.get $budget)
              (i32.mul (local.get $count) (call $estimate_array_size (i32.const 2)))))))
        (if (call $check_heap_overflow (local.get $budget))
          (then (return (i32.const -1))))
        (local.set $new_arr (call $allocate_array (local.get $count)))
        (local.set $new_data (i32.load (call $abs (i32.add (local.get $new_arr) (i32.const 16)))))
        (local.set $entries_pointer (i32.load (call $abs (i32.add (local.get $source_lo) (i32.const 20)))))
        (local.set $slot_count (i32.load (call $abs (i32.add (local.get $source_lo) (i32.const 12)))))
        (local.set $slot_index (i32.const 0))
        (local.set $write_index (i32.const 0))
        (block $collection_walk_done
          (loop $collection_walk
            (br_if $collection_walk_done (i32.ge_u (local.get $slot_index) (local.get $slot_count)))
            (local.set $slot_pointer (i32.add
              (i32.add (local.get $entries_pointer) (global.get $GC_HEADER_SIZE))
              (i32.mul (local.get $slot_index)
                (if (result i32) (i32.eq (local.get $source_type) (global.get $TYPE_MAP))
                  (then (global.get $MAP_SLOT_STRIDE))
                  (else (global.get $SET_SLOT_STRIDE))))))
            ;; First slot word: 0 = live, nonzero = tombstone.
            (if (i32.eqz (i32.load (call $abs (local.get $slot_pointer))))
              (then
                (local.set $dest (i32.add
                  (i32.add (local.get $new_data) (global.get $GC_HEADER_SIZE))
                  (i32.mul (local.get $write_index) (global.get $VALUE_SIZE))))
                (if (i32.eq (local.get $source_type) (global.get $TYPE_SET))
                  (then
                    ;; Copy the value quad at slot + SET_SLOT_VALUE_OFFSET.
                    (i64.store (call $abs (local.get $dest))
                      (i64.load (call $abs (i32.add (local.get $slot_pointer) (global.get $SET_SLOT_VALUE_OFFSET)))))
                    (i64.store (call $abs (i32.add (local.get $dest) (i32.const 8)))
                      (i64.load (call $abs (i32.add
                        (i32.add (local.get $slot_pointer) (global.get $SET_SLOT_VALUE_OFFSET))
                        (i32.const 8)))))
                  )
                  (else
                    ;; Map: build the [key, value] pair array.
                    (local.set $pair (call $allocate_array (i32.const 2)))
                    (local.set $pair_data (i32.load (call $abs (i32.add (local.get $pair) (i32.const 16)))))
                    (i64.store (call $abs (i32.add (local.get $pair_data) (global.get $GC_HEADER_SIZE)))
                      (i64.load (call $abs (i32.add (local.get $slot_pointer) (global.get $MAP_SLOT_KEY_OFFSET)))))
                    (i64.store (call $abs (i32.add
                        (i32.add (local.get $pair_data) (global.get $GC_HEADER_SIZE)) (i32.const 8)))
                      (i64.load (call $abs (i32.add
                        (i32.add (local.get $slot_pointer) (global.get $MAP_SLOT_KEY_OFFSET)) (i32.const 8)))))
                    (i64.store (call $abs (i32.add
                        (i32.add (local.get $pair_data) (global.get $GC_HEADER_SIZE)) (global.get $VALUE_SIZE)))
                      (i64.load (call $abs (i32.add (local.get $slot_pointer) (global.get $MAP_SLOT_VALUE_OFFSET)))))
                    (i64.store (call $abs (i32.add
                        (i32.add
                          (i32.add (local.get $pair_data) (global.get $GC_HEADER_SIZE))
                          (global.get $VALUE_SIZE))
                        (i32.const 8)))
                      (i64.load (call $abs (i32.add
                        (i32.add (local.get $slot_pointer) (global.get $MAP_SLOT_VALUE_OFFSET)) (i32.const 8)))))
                    (i32.store (call $abs (local.get $dest)) (global.get $TYPE_ARRAY))
                    (i32.store (call $abs (i32.add (local.get $dest) (i32.const 4))) (i32.const 0))
                    (i32.store (call $abs (i32.add (local.get $dest) (i32.const 8))) (local.get $pair))
                    (i32.store (call $abs (i32.add (local.get $dest) (i32.const 12))) (i32.const 0))
                  )
                )
                (local.set $write_index (i32.add (local.get $write_index) (i32.const 1)))
              )
            )
            (local.set $slot_index (i32.add (local.get $slot_index) (i32.const 1)))
            (br $collection_walk)
          )
        )
        ;; Live count is the header's size; keep length honest anyway.
        (i32.store (call $abs (i32.add (local.get $new_arr) (i32.const 8))) (local.get $write_index))
        (return (local.get $new_arr))
      )
    )

    ;; Typed arrays. Descriptor: [buffer_ptr:4][byte_offset:4][length:4][sym_entries:4];
    ;; data starts at buffer_ptr + 4 + byte_offset.
    (local.set $count (i32.load (call $abs (i32.add (local.get $source_lo) (i32.const 8)))))
    (local.set $is_bigint_source (i32.or
      (i32.eq (local.get $source_type) (global.get $TYPE_BIGINT64ARRAY))
      (i32.eq (local.get $source_type) (global.get $TYPE_BIGUINT64ARRAY))))
    (local.set $budget (call $estimate_array_size (local.get $count)))
    (if (local.get $is_bigint_source)
      (then
        (local.set $budget (i32.add (local.get $budget)
          (i32.mul (local.get $count) (call $estimate_bigint_size (i32.const 2)))))))
    (if (call $check_heap_overflow (local.get $budget))
      (then (return (i32.const -1))))
    (local.set $new_arr (call $allocate_array (local.get $count)))
    (local.set $new_data (i32.load (call $abs (i32.add (local.get $new_arr) (i32.const 16)))))
    (local.set $bytes_per_element (call $get_bytes_per_element (local.get $source_type)))
    (local.set $slot_index (i32.const 0))
    (block $typed_walk_done
      (loop $typed_walk
        (br_if $typed_walk_done (i32.ge_u (local.get $slot_index) (local.get $count)))
        (local.set $byte_pointer (call $abs (i32.add
          (i32.add
            (i32.add (i32.load (call $abs (local.get $source_lo))) (i32.const 4))
            (i32.load (call $abs (i32.add (local.get $source_lo) (i32.const 4)))))
          (i32.mul (local.get $slot_index) (local.get $bytes_per_element)))))
        (local.set $dest (i32.add
          (i32.add (local.get $new_data) (global.get $GC_HEADER_SIZE))
          (i32.mul (local.get $slot_index) (global.get $VALUE_SIZE))))
        (if (local.get $is_bigint_source)
          (then
            (i32.store (call $abs (local.get $dest)) (global.get $TYPE_BIGINT))
            (i32.store (call $abs (i32.add (local.get $dest) (i32.const 4))) (i32.const 0))
            (i32.store (call $abs (i32.add (local.get $dest) (i32.const 8)))
              (call $bigint_from_typed_i64 (local.get $source_type) (local.get $byte_pointer)))
            (i32.store (call $abs (i32.add (local.get $dest) (i32.const 12))) (i32.const 0))
          )
          (else
            (local.set $f64_result (call $read_typed_element (local.get $source_type) (local.get $byte_pointer)))
            (local.set $element_i64 (i64.reinterpret_f64 (local.get $f64_result)))
            (i32.store (call $abs (local.get $dest)) (global.get $TYPE_FLOAT))
            (i32.store (call $abs (i32.add (local.get $dest) (i32.const 4))) (i32.const 0))
            (i32.store (call $abs (i32.add (local.get $dest) (i32.const 8)))
              (i32.wrap_i64 (local.get $element_i64)))
            (i32.store (call $abs (i32.add (local.get $dest) (i32.const 12)))
              (i32.wrap_i64 (i64.shr_u (local.get $element_i64) (i64.const 32))))
          )
        )
        (local.set $slot_index (i32.add (local.get $slot_index) (i32.const 1)))
        (br $typed_walk)
      )
    )
    (local.get $new_arr)
  )

  ;; ==========================================================================
  ;; array_from_array_like(source_lo) → array header pointer | -1
  ;;
  ;; Array-LIKE Array.from source: an object with no callable
  ;; Symbol.iterator. Reads `length` (ToLength semantics: absent,
  ;; non-numeric, NaN, or negative → 0; fractions truncate), then copies
  ;; the index properties "0".."len-1" (own or prototype; missing indexes
  ;; become undefined). The caller guarantees the source is data-only
  ;; (accessor-bearing sources resolve through ACCESSOR_RESOLVE first).
  ;; -1 = pressure (heap budget refused, or the per-index key interning
  ;; signaled) with only unreachable garbage allocated — the caller
  ;; parks and the retry reconverts from scratch.
  ;; ==========================================================================
  (func $array_from_array_like (param $source_lo i32) (result i32)
    (local $entry_pointer i32)
    (local $length_f64 f64)
    (local $count i32)
    (local $new_arr i32)
    (local $new_data i32)
    (local $index i32)
    (local $key_id i32)
    (local $dest i32)
    (local.set $count (i32.const 0))
    (local.set $entry_pointer (call $object_find_string_entry
      (local.get $source_lo) (call $read_builtin (global.get $BUILTIN_LENGTH))))
    (if (i32.ne (local.get $entry_pointer) (i32.const 0))
      (then
        (if (call $value_is_numeric (i32.add (local.get $entry_pointer) (i32.const 4)))
          (then
            (local.set $length_f64 (call $value_to_f64 (i32.add (local.get $entry_pointer) (i32.const 4))))
            ;; NaN and negatives fail the > 0 comparison → count stays 0.
            (if (f64.gt (local.get $length_f64) (f64.const 0))
              (then
                (if (f64.ge (local.get $length_f64) (f64.const 2147483647))
                  (then (local.set $count (i32.const 2147483647)))
                  (else (local.set $count (i32.trunc_f64_s (local.get $length_f64)))))))))))
    (if (call $check_heap_overflow (call $estimate_array_size (local.get $count)))
      (then (return (i32.const -1))))
    (local.set $new_arr (call $allocate_array (local.get $count)))
    (local.set $new_data (i32.load (call $abs (i32.add (local.get $new_arr) (i32.const 16)))))
    (local.set $index (i32.const 0))
    (block $array_like_done
      (loop $array_like_walk
        (br_if $array_like_done (i32.ge_u (local.get $index) (local.get $count)))
        (local.set $key_id (call $f64_to_string (f64.convert_i32_u (local.get $index))))
        (if (global.get $memory_pressure_signaled)
          (then (return (i32.const -1))))
        (local.set $entry_pointer (call $object_find_string_entry
          (local.get $source_lo) (local.get $key_id)))
        (local.set $dest (i32.add
          (i32.add (local.get $new_data) (global.get $GC_HEADER_SIZE))
          (i32.mul (local.get $index) (global.get $VALUE_SIZE))))
        (if (i32.ne (local.get $entry_pointer) (i32.const 0))
          (then
            (i64.store (call $abs (local.get $dest))
              (i64.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 4)))))
            (i64.store (call $abs (i32.add (local.get $dest) (i32.const 8)))
              (i64.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 12))))))
          (else
            (call $jt_write_quad (local.get $dest)
              (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $array_like_walk)
      )
    )
    (local.get $new_arr)
  )

  ;; ==========================================================================
  ;; array_from_seed_begin(source_pointer, closure_pointer, slot_offset, pc)
  ;;   → next pc | -2
  ;;
  ;; Start draining a user iterable for Array.from: allocate the (empty)
  ;; accumulator array, push an ARRAY_FROM_SEED continuation frame anchored
  ;; at the CURRENT pending pointer, and stage the source[Symbol.iterator]()
  ;; factory call. $slot_offset is the byte distance from the pending
  ;; pointer down to the source operand slot; on completion the drained
  ;; array is written there and the CURRENT instruction ($pc) re-runs —
  ;; the Array-source paths (clone, mapFn rewrite) then apply. Returns -2
  ;; on heap pressure with nothing mutated.
  ;; ==========================================================================
  (func $array_from_seed_begin
    (param $source_pointer i32) (param $closure_pointer i32)
    (param $slot_offset i32) (param $pc i32) (result i32)
    (local $accumulator i32)
    (local $stack_pointer i32)
    (local $frame_pointer i32)
    (local $new_scope i32)
    (if (call $check_heap_overflow (call $estimate_array_size (i32.const 0)))
      (then (return (i32.const -2))))
    (local.set $accumulator (call $allocate_array (i32.const 0)))
    (local.set $stack_pointer (call $read_ctx (global.get $CTX_CALL_STACK_POINTER)))
    (local.set $frame_pointer (call $abs (local.get $stack_pointer)))
    (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_INSTRUCTION_INDEX)) (local.get $pc))
    (call $publish_native_continuation_frame
      (local.get $frame_pointer) (local.get $stack_pointer)
      (call $read_ctx (global.get $CTX_PENDING_POINTER))
      (i32.const 1) (i32.const 0) (i32.const 0)
      (local.get $slot_offset) (i32.const 0)
      (global.get $CONTINUATION_KIND_ARRAY_FROM_SEED)
      (local.get $accumulator) (local.get $closure_pointer)
      (global.get $TYPE_ARRAY) (i32.const 0))
    ;; Stage the factory call with `this` = the source iterable.
    (local.set $new_scope (call $scope_create
      (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 40))))))
    (global.set $current_scope (local.get $new_scope))
    (if (i32.eqz (i32.and
          (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 44))))
          (global.get $CLOSURE_FLAG_ARROW)))
      (then
        (call $scope_define (local.get $new_scope)
          (call $read_builtin (i32.const 0x18))   ;; BUILTIN_NAME.THIS
          (global.get $TYPE_OBJECT) (i32.const 0)
          (local.get $source_pointer) (i32.const 0))
        (call $scope_define_new_target (local.get $new_scope)
          (global.get $TYPE_UNDEFINED) (i32.const 0))))
    (i32.load (call $abs (i32.add (local.get $closure_pointer) (global.get $FUNCTION_CLOSURE_OFFSET))))
  )

  ;; Generator variant of $array_from_seed_begin: the generator is its
  ;; own iterator, so the frame starts in phase 1 with the native drive
  ;; marker (ITER_CALLBACK = 0), and the first next() parks at the
  ;; sentinel RETURN (request written, EXIT_GENERATOR_NEXT set).
  ;; Returns -2 on heap pressure (nothing mutated), -6 when parked.
  (func $array_from_seed_begin_generator
    (param $source_pointer i32) (param $slot_offset i32) (param $pc i32) (result i32)
    (local $accumulator i32)
    (local $stack_pointer i32)
    (local $frame_pointer i32)
    (if (call $check_heap_overflow (call $estimate_array_size (i32.const 0)))
      (then (return (i32.const -2))))
    (local.set $accumulator (call $allocate_array (i32.const 0)))
    (local.set $stack_pointer (call $read_ctx (global.get $CTX_CALL_STACK_POINTER)))
    (local.set $frame_pointer (call $abs (local.get $stack_pointer)))
    (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_INSTRUCTION_INDEX)) (local.get $pc))
    (call $publish_native_continuation_frame
      (local.get $frame_pointer) (local.get $stack_pointer)
      (call $read_ctx (global.get $CTX_PENDING_POINTER))
      (i32.const 1) (i32.const 0) (i32.const 1)
      (local.get $slot_offset) (local.get $source_pointer)
      (global.get $CONTINUATION_KIND_ARRAY_FROM_SEED)
      (local.get $accumulator) (i32.const 0)
      (global.get $TYPE_ARRAY) (i32.const 0))
    ;; First next(): request + park at the sentinel RETURN.
    (i32.store (call $abs (global.get $external_request_base)) (local.get $source_pointer))
    (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 4))) (i32.const 0))
    (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 8)))
      (global.get $TYPE_UNDEFINED))
    (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 12))) (i32.const 0))
    (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 16))) (i32.const 0))
    (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 20))) (i32.const 0))
    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX)
      (i32.sub
        (call $read_instr_count (call $read_state (global.get $STATE_CODE_BLOCK)))
        (i32.const 1)))
    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_GENERATOR_NEXT))
    (i32.const -6)
  )

  ;; ==========================================================================
  ;; array_from_intercept(value_pointer, argc, method_id, pc) → result code
  ;;
  ;; Shared source normalization for the CALL / CALL_METHOD dispatch
  ;; paths, used by Array.from AND Object.fromEntries (whose iterable
  ;; sources become arrays the same way — a Map converts to [key, value]
  ;; pairs, which is exactly the entries shape). The array-like and
  ;; accessor-resolve fallbacks apply to Array.from only (fromEntries
  ;; requires a real iterable). $value_pointer is the callee
  ;; (bound-method) slot; the source argument sits one VALUE_SIZE above
  ;; it in both layouts.
  ;;   >= 0 : a user-iterable drain was staged; continue at this pc.
  ;;   -2   : heap pressure, nothing mutated — park the pc and yield.
  ;;   -3   : proceed to normal dispatch (the source slot may now hold a
  ;;          natively converted array).
  ;;   -4   : TypeError thrown, no handler — exit.
  ;;   -5   : TypeError thrown into a handler — re-read the context pc.
  ;; ==========================================================================
  (func $array_from_intercept
    (param $value_pointer i32) (param $argc i32) (param $method_id i32) (param $pc i32)
    (result i32)
    (local $slot i32)
    (local $source_type i32)
    (local $source_lo i32)
    (local $entry_pointer i32)
    (local $converted i32)
    (if (i32.eqz (local.get $argc)) (then (return (i32.const -3))))
    (local.set $slot (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE)))
    (local.set $source_type (call $value_type (local.get $slot)))
    (local.set $source_lo (call $value_data_lo (local.get $slot)))
    ;; Array.from(null) / Array.from(undefined) → TypeError, per spec.
    (if (i32.or
          (i32.eq (local.get $source_type) (global.get $TYPE_NULL))
          (i32.eq (local.get $source_type) (global.get $TYPE_UNDEFINED)))
      (then
        (if (call $throw_type_error_with_type (global.get $BUILTIN_MSG_NOT_ITERABLE) (local.get $source_type))
          (then (return (i32.const -4)))
          (else (return (i32.const -5))))))
    (if (call $array_from_source_is_native (local.get $source_type))
      (then
        (local.set $converted (call $array_from_native (local.get $source_type) (local.get $source_lo)))
        (if (i32.eq (local.get $converted) (i32.const -1))
          (then (return (i32.const -2))))
        (i32.store (call $abs (local.get $slot)) (global.get $TYPE_ARRAY))
        (i32.store (call $abs (i32.add (local.get $slot) (i32.const 4))) (i32.const 0))
        (i32.store (call $abs (i32.add (local.get $slot) (i32.const 8))) (local.get $converted))
        (i32.store (call $abs (i32.add (local.get $slot) (i32.const 12))) (i32.const 0))
        (return (i32.const -3))))
    ;; User iterable: object with a callable Symbol.iterator (own or
    ;; prototype) drains through the seed driver. Objects WITHOUT the
    ;; symbol take the spec's array-like path: read length, copy index
    ;; properties. Accessor-bearing array-likes resolve to a data-only
    ;; copy first (ACCESSOR_RESOLVE re-runs this call), so the native
    ;; walk never meets a TYPE_ACCESSOR entry.
    (if (i32.eq (local.get $source_type) (global.get $TYPE_OBJECT))
      (then
        (local.set $entry_pointer (call $object_find_symbol_entry
          (local.get $source_lo)
          (call $read_state (global.get $STATE_WELL_KNOWN_ITERATOR_SYMBOL))))
        (if (call $entry_value_is_function (local.get $entry_pointer))
          (then
            (return (call $array_from_seed_begin
              (local.get $source_lo)
              (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 12))))
              (i32.sub (call $read_ctx (global.get $CTX_PENDING_POINTER)) (local.get $slot))
              (local.get $pc)))))
        ;; Generator sources: the generator IS its own iterator — seed in
        ;; phase 1 with the native drive and park for the first next()
        ;; (returns -6: exit condition prepared).
        (if (call $entry_value_is_generator_iterator (local.get $entry_pointer))
          (then
            (return (call $array_from_seed_begin_generator
              (local.get $source_lo)
              (i32.sub (call $read_ctx (global.get $CTX_PENDING_POINTER)) (local.get $slot))
              (local.get $pc)))))
        ;; Array-like / accessor-resolve fallbacks: Array.from only.
        ;; fromEntries with an iterator-less object falls through to its
        ;; dispatch TypeError.
        (if (i32.ne (local.get $method_id) (global.get $METHOD_ARRAY_FROM))
          (then (return (i32.const -3))))
        (if (call $value_is_accessor_bearing_object (local.get $slot))
          (then
            (return (call $accessor_resolve_begin
              (local.get $source_lo)
              (i32.sub (call $read_ctx (global.get $CTX_PENDING_POINTER)) (local.get $slot))
              (local.get $pc)))))
        (local.set $converted (call $array_from_array_like (local.get $source_lo)))
        (if (i32.eq (local.get $converted) (i32.const -1))
          (then (return (i32.const -2))))
        (i32.store (call $abs (local.get $slot)) (global.get $TYPE_ARRAY))
        (i32.store (call $abs (i32.add (local.get $slot) (i32.const 4))) (i32.const 0))
        (i32.store (call $abs (i32.add (local.get $slot) (i32.const 8))) (local.get $converted))
        (i32.store (call $abs (i32.add (local.get $slot) (i32.const 12))) (i32.const 0))
        (return (i32.const -3))))
    (i32.const -3)
  )

  ;; ==========================================================================
  ;; JSON_TRANSFORM driver — JSON.stringify with getter-backed properties
  ;; and/or a function replacer.
  ;;
  ;; Builds a JSON-shaped deep copy of the value with an explicit DFS,
  ;; staging getter and replacer calls in spec order (Get, then replacer,
  ;; per own property). Completion writes the copy into the value operand
  ;; slot (and neutralizes the replacer argument slot) and re-runs the
  ;; call instruction — the native serializer then handles pure data.
  ;;
  ;; All driver state lives in a heap "state array" (an ordinary array of
  ;; value quads, rooted via FRAME_CONTINUATION_STATE_1/RECEIVER):
  ;;   [0] substate INTEGER: 0 walking, 1 awaiting getter,
  ;;       2 awaiting replacer, 3 awaiting root replacer
  ;;   [1] replacer closure (TYPE_FUNCTION) or TYPE_UNDEFINED
  ;;   [2] transformed-root holder (VALUE)
  ;;   [3] root-resolved INTEGER (0/1)
  ;;   [4..] DFS frames, 4 quads each:
  ;;       +0 container copy (OBJECT/ARRAY value)
  ;;       +1 source container (OBJECT/ARRAY value)
  ;;       +2 next source entry index (INTEGER)
  ;;       +3 pending key (STRING key for objects / INTEGER index for
  ;;          arrays) — names the entry a staged call or a child copy
  ;;          belongs to
  ;;
  ;; Because every position lives in the heap, pressure retries are
  ;; resume-exact: -2 is returned only BEFORE the mutations of the entry
  ;; being processed, and a retry re-enters via the RETURN continuation
  ;; with substate telling it whether the popped value is still expected
  ;; (substate 0 = mid-walk resume: ignore the value, just step).
  ;; ==========================================================================

  ;; Segment pointer to state-array quad $index (re-derive after any push —
  ;; growth relocates the data block).
  (func $jt_quad (param $state i32) (param $index i32) (result i32)
    (i32.add
      (i32.add
        (i32.load (call $abs (i32.add (local.get $state) (i32.const 16))))
        (global.get $GC_HEADER_SIZE))
      (i32.mul (local.get $index) (global.get $VALUE_SIZE)))
  )

  (func $jt_write_quad (param $dest i32) (param $t i32) (param $f i32) (param $lo i32) (param $hi i32)
    (i32.store (call $abs (local.get $dest)) (local.get $t))
    (i32.store (call $abs (i32.add (local.get $dest) (i32.const 4))) (local.get $f))
    (i32.store (call $abs (i32.add (local.get $dest) (i32.const 8))) (local.get $lo))
    (i32.store (call $abs (i32.add (local.get $dest) (i32.const 12))) (local.get $hi))
  )

  ;; Classify a produced value (raw entry value, getter return, or replacer
  ;; return) into the current target: write scalars, omit
  ;; undefined/function (null inside arrays), or allocate a child copy and
  ;; push a DFS frame for objects/arrays. Target = the top frame's copy at
  ;; its pending key, or the root holder when no frames are live.
  ;; Returns 0 ok, -1 error set (circular structure), -2 pressure with
  ;; nothing mutated.
  (func $json_transform_classify
    (param $state i32)
    (param $vt i32) (param $vf i32) (param $vlo i32) (param $vhi i32)
    (result i32)
    (local $len i32)
    (local $depth i32)
    (local $top i32)
    (local $count i32)
    (local $budget i32)
    (local $copy i32)
    (local $copy_type i32)
    (local $k i32)
    (local $probe i32)
    (local $data i32)
    (local $dest i32)
    (local.set $len (i32.load (call $abs (i32.add (local.get $state) (i32.const 8)))))
    (local.set $depth (i32.shr_u (i32.sub (local.get $len) (i32.const 4)) (i32.const 2)))

    ;; undefined / function values: omitted from objects and the root,
    ;; null inside arrays.
    (if (i32.or
          (i32.or
            (i32.eq (local.get $vt) (global.get $TYPE_FUNCTION))
            (i32.eq (local.get $vt) (global.get $TYPE_BOUND_METHOD)))
          (i32.eq (local.get $vt) (global.get $TYPE_UNDEFINED)))
      (then
        (if (i32.eqz (local.get $depth))
          (then
            (call $jt_write_quad (call $jt_quad (local.get $state) (i32.const 2))
              (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))
            (i32.store (call $abs (i32.add (call $jt_quad (local.get $state) (i32.const 3)) (i32.const 8)))
              (i32.const 1))
            (return (i32.const 0))))
        (local.set $top (call $jt_quad (local.get $state)
          (i32.add (i32.const 4) (i32.mul (i32.sub (local.get $depth) (i32.const 1)) (i32.const 4)))))
        (if (i32.eq (i32.load (call $abs (local.get $top))) (global.get $TYPE_ARRAY))
          (then
            (local.set $data (i32.load (call $abs (i32.add
              (i32.load (call $abs (i32.add (local.get $top) (i32.const 8))))
              (i32.const 16)))))
            (call $jt_write_quad
              (i32.add
                (i32.add (local.get $data) (global.get $GC_HEADER_SIZE))
                (i32.mul
                  (i32.load (call $abs (i32.add (local.get $top) (i32.const 56))))
                  (global.get $VALUE_SIZE)))
              (global.get $TYPE_NULL) (i32.const 0) (i32.const 0) (i32.const 0))))
        (return (i32.const 0))
      )
    )

    (if (i32.or
          (i32.eq (local.get $vt) (global.get $TYPE_OBJECT))
          (i32.eq (local.get $vt) (global.get $TYPE_ARRAY)))
      (then
        ;; Circular check: the DFS frame stack IS the current path.
        (local.set $k (i32.const 0))
        (block $jt_cycle_done
          (loop $jt_cycle_scan
            (br_if $jt_cycle_done (i32.ge_u (local.get $k) (local.get $depth)))
            (local.set $probe (call $jt_quad (local.get $state)
              (i32.add (i32.const 5) (i32.mul (local.get $k) (i32.const 4)))))
            (if (i32.and
                  (i32.eq (i32.load (call $abs (local.get $probe))) (local.get $vt))
                  (i32.eq (i32.load (call $abs (i32.add (local.get $probe) (i32.const 8)))) (local.get $vlo)))
              (then
                (call $set_error (global.get $ERR_JSON_STRINGIFY) (i32.const 0))
                (return (i32.const -1))))
            (local.set $k (i32.add (local.get $k) (i32.const 1)))
            (br $jt_cycle_scan)
          )
        )
        ;; Budget: the child copy plus state-array growth if at capacity.
        (if (i32.eq (local.get $vt) (global.get $TYPE_OBJECT))
          (then
            (local.set $count (i32.load (call $abs (i32.add (local.get $vlo) (i32.const 12)))))
            (local.set $budget (call $estimate_object_size (local.get $count))))
          (else
            (local.set $count (i32.load (call $abs (i32.add (local.get $vlo) (i32.const 8)))))
            (local.set $budget (call $estimate_array_size (local.get $count)))))
        (if (i32.gt_u
              (i32.add (local.get $len) (i32.const 4))
              (i32.load (call $abs (i32.add (local.get $state) (i32.const 12)))))
          (then
            (local.set $budget (i32.add (local.get $budget)
              (call $estimate_array_grow_size
                (i32.load (call $abs (i32.add (local.get $state) (i32.const 12)))))))))
        (if (call $check_heap_overflow (local.get $budget))
          (then (return (i32.const -2))))
        (if (i32.eq (local.get $vt) (global.get $TYPE_OBJECT))
          (then
            (local.set $copy (call $allocate_object (local.get $count)))
            (local.set $copy_type (global.get $TYPE_OBJECT)))
          (else
            (local.set $copy (call $allocate_array (local.get $count)))
            (local.set $copy_type (global.get $TYPE_ARRAY))))
        ;; Grow statuses droppable: the budget pre-check above covered
        ;; state-array growth (estimate_array_grow_size in $budget).
        (drop (call $array_push_value (local.get $state)
          (local.get $copy_type) (i32.const 0) (local.get $copy) (i32.const 0)))
        (drop (call $array_push_value (local.get $state)
          (local.get $vt) (local.get $vf) (local.get $vlo) (local.get $vhi)))
        (drop (call $array_push_value (local.get $state)
          (global.get $TYPE_INTEGER) (i32.const 0) (i32.const 0) (i32.const 0)))
        (drop (call $array_push_value (local.get $state)
          (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0)))
        (return (i32.const 0))
      )
    )

    ;; Scalar: write into the target.
    (if (i32.eqz (local.get $depth))
      (then
        (call $jt_write_quad (call $jt_quad (local.get $state) (i32.const 2))
          (local.get $vt) (local.get $vf) (local.get $vlo) (local.get $vhi))
        (i32.store (call $abs (i32.add (call $jt_quad (local.get $state) (i32.const 3)) (i32.const 8)))
          (i32.const 1))
        (return (i32.const 0))))
    (local.set $top (call $jt_quad (local.get $state)
      (i32.add (i32.const 4) (i32.mul (i32.sub (local.get $depth) (i32.const 1)) (i32.const 4)))))
    (if (i32.eq (i32.load (call $abs (local.get $top))) (global.get $TYPE_OBJECT))
      (then
        ;; Transform copies are allocated at the source's count
        ;; (allocate_object(count) in classify) — grow unreachable,
        ;; status droppable.
        (drop (call $object_set_property
          (i32.load (call $abs (i32.add (local.get $top) (i32.const 8))))
          (i32.load (call $abs (i32.add (local.get $top) (i32.const 56))))
          (local.get $vt) (local.get $vf) (local.get $vlo) (local.get $vhi))))
      (else
        (local.set $data (i32.load (call $abs (i32.add
          (i32.load (call $abs (i32.add (local.get $top) (i32.const 8))))
          (i32.const 16)))))
        (call $jt_write_quad
          (i32.add
            (i32.add (local.get $data) (global.get $GC_HEADER_SIZE))
            (i32.mul
              (i32.load (call $abs (i32.add (local.get $top) (i32.const 56))))
              (global.get $VALUE_SIZE)))
          (local.get $vt) (local.get $vf) (local.get $vlo) (local.get $vhi))))
    (i32.const 0)
  )

  ;; Stage a getter or replacer call: record the callback, set the
  ;; substate, reset the pending stack to the frame base, push up to two
  ;; arguments (limited by the callee's declared parameter count, padding
  ;; extra declared parameters with undefined), create the call scope, and
  ;; bind `this` for non-arrow callees. Returns the callee's start pc.
  (func $json_transform_stage
    (param $frame i32) (param $state i32) (param $closure i32)
    (param $this_type i32) (param $this_lo i32)
    (param $arg_count i32)
    (param $a1t i32) (param $a1f i32) (param $a1lo i32) (param $a1hi i32)
    (param $a2t i32) (param $a2f i32) (param $a2lo i32) (param $a2hi i32)
    (param $substate i32)
    (result i32)
    (local $params i32)
    (local $k i32)
    (local $new_scope i32)
    (i32.store (i32.add (local.get $frame) (global.get $FRAME_CONTINUATION_CALLBACK)) (local.get $closure))
    (i32.store (call $abs (i32.add (call $jt_quad (local.get $state) (i32.const 0)) (i32.const 8)))
      (local.get $substate))
    (call $write_ctx (global.get $CTX_PENDING_POINTER)
      (call $load_frame_pending_base (local.get $frame)))
    (local.set $params (call $callback_staged_argc (local.get $closure) (local.get $arg_count)))
    ;; We push exactly $params values (padding extra declared parameters
    ;; with undefined), so RECONCILE_PARAMS must see that count — it reads
    ;; FRAME.ARGC from this (top) frame.
    (i32.store (i32.add (local.get $frame) (global.get $FRAME_ARGC)) (local.get $params))
    (local.set $k (i32.const 1))
    (block $jt_stage_args_done
      (loop $jt_stage_args
        (br_if $jt_stage_args_done (i32.gt_u (local.get $k) (local.get $params)))
        (if (i32.and (i32.eq (local.get $k) (i32.const 1)) (i32.ge_u (local.get $arg_count) (i32.const 1)))
          (then (call $pending_push (local.get $a1t) (local.get $a1f) (local.get $a1lo) (local.get $a1hi)))
          (else
            (if (i32.and (i32.eq (local.get $k) (i32.const 2)) (i32.ge_u (local.get $arg_count) (i32.const 2)))
              (then (call $pending_push (local.get $a2t) (local.get $a2f) (local.get $a2lo) (local.get $a2hi)))
              (else (call $pending_push (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))))))
        (local.set $k (i32.add (local.get $k) (i32.const 1)))
        (br $jt_stage_args)
      )
    )
    (local.set $new_scope (call $scope_create
      (i32.load (call $abs (i32.add (local.get $closure) (i32.const 40))))))
    (global.set $current_scope (local.get $new_scope))
    (if (i32.eqz (i32.and
          (i32.load (call $abs (i32.add (local.get $closure) (i32.const 44))))
          (global.get $CLOSURE_FLAG_ARROW)))
      (then
        (call $scope_define (local.get $new_scope)
          (call $read_builtin (i32.const 0x18))   ;; BUILTIN_NAME.THIS
          (local.get $this_type) (i32.const 0)
          (local.get $this_lo) (i32.const 0))
        (call $scope_define_new_target (local.get $new_scope)
          (global.get $TYPE_UNDEFINED) (i32.const 0))))
    (i32.load (call $abs (i32.add (local.get $closure) (global.get $FUNCTION_CLOSURE_OFFSET))))
  )

  ;; The native DFS loop: walks source entries, writing/descending until a
  ;; getter or replacer call must be staged (returns its pc) or the walk
  ;; finishes (pops the ITERATING frame, writes the transformed root into
  ;; the operand slot, neutralizes the replacer argument, and returns the
  ;; blocked instruction's pc for the re-run). $frame is the ABS frame
  ;; pointer. Returns -1 with an error set, or -2 on pressure with the
  ;; heap state untouched for the entry being processed.
  (func $json_transform_step (param $frame i32) (result i32)
    (local $state_handle i32)
    (local $state i32)
    (local $len i32)
    (local $depth i32)
    (local $top i32)
    (local $source_type i32)
    (local $source_lo i32)
    (local $count i32)
    (local $i i32)
    (local $entry i32)
    (local $key_offset i32)
    (local $val_type i32)
    (local $getter i32)
    (local $elem i32)
    (local $data i32)
    (local $r i32)
    (local $parent i32)
    (local $replacer i32)
    (local $key_id i32)
    (local $return_pc i32)
    (local $slot_seg i32)
    (local.set $state_handle
      (i32.load (i32.add
        (local.get $frame)
        (global.get $FRAME_CONTINUATION_STATE_HANDLE))))
    (local.set $state
      (call $native_continuation_state_get
        (local.get $state_handle) (i32.const 1)))
    (block $jt_complete
      (loop $jt_walk
        (local.set $len (i32.load (call $abs (i32.add (local.get $state) (i32.const 8)))))
        (local.set $depth (i32.shr_u (i32.sub (local.get $len) (i32.const 4)) (i32.const 2)))
        (br_if $jt_complete (i32.eqz (local.get $depth)))
        (local.set $top (call $jt_quad (local.get $state)
          (i32.add (i32.const 4) (i32.mul (i32.sub (local.get $depth) (i32.const 1)) (i32.const 4)))))
        (local.set $source_type (i32.load (call $abs (i32.add (local.get $top) (i32.const 16)))))
        (local.set $source_lo (i32.load (call $abs (i32.add (local.get $top) (i32.const 24)))))
        (if (i32.eq (local.get $source_type) (global.get $TYPE_OBJECT))
          (then (local.set $count (i32.load (call $abs (i32.add (local.get $source_lo) (i32.const 12))))))
          (else (local.set $count (i32.load (call $abs (i32.add (local.get $source_lo) (i32.const 8)))))))
        (local.set $i (i32.load (call $abs (i32.add (local.get $top) (i32.const 40)))))

        ;; Exhausted: pop the frame and attach the finished copy.
        (if (i32.ge_u (local.get $i) (local.get $count))
          (then
            (i32.store (call $abs (i32.add (local.get $state) (i32.const 8)))
              (i32.sub (local.get $len) (i32.const 4)))
            (if (i32.eq (local.get $depth) (i32.const 1))
              (then
                (call $jt_write_quad (call $jt_quad (local.get $state) (i32.const 2))
                  (i32.load (call $abs (local.get $top)))
                  (i32.load (call $abs (i32.add (local.get $top) (i32.const 4))))
                  (i32.load (call $abs (i32.add (local.get $top) (i32.const 8))))
                  (i32.load (call $abs (i32.add (local.get $top) (i32.const 12)))))
                (i32.store (call $abs (i32.add (call $jt_quad (local.get $state) (i32.const 3)) (i32.const 8)))
                  (i32.const 1)))
              (else
                (local.set $parent (call $jt_quad (local.get $state)
                  (i32.add (i32.const 4) (i32.mul (i32.sub (local.get $depth) (i32.const 2)) (i32.const 4)))))
                (if (i32.eq (i32.load (call $abs (local.get $parent))) (global.get $TYPE_OBJECT))
                  (then
                    ;; Pre-sized transform copy — status droppable.
                    (drop (call $object_set_property
                      (i32.load (call $abs (i32.add (local.get $parent) (i32.const 8))))
                      (i32.load (call $abs (i32.add (local.get $parent) (i32.const 56))))
                      (i32.load (call $abs (local.get $top)))
                      (i32.load (call $abs (i32.add (local.get $top) (i32.const 4))))
                      (i32.load (call $abs (i32.add (local.get $top) (i32.const 8))))
                      (i32.load (call $abs (i32.add (local.get $top) (i32.const 12)))))))
                  (else
                    (local.set $data (i32.load (call $abs (i32.add
                      (i32.load (call $abs (i32.add (local.get $parent) (i32.const 8))))
                      (i32.const 16)))))
                    (call $jt_write_quad
                      (i32.add
                        (i32.add (local.get $data) (global.get $GC_HEADER_SIZE))
                        (i32.mul
                          (i32.load (call $abs (i32.add (local.get $parent) (i32.const 56))))
                          (global.get $VALUE_SIZE)))
                      (i32.load (call $abs (local.get $top)))
                      (i32.load (call $abs (i32.add (local.get $top) (i32.const 4))))
                      (i32.load (call $abs (i32.add (local.get $top) (i32.const 8))))
                      (i32.load (call $abs (i32.add (local.get $top) (i32.const 12)))))))))
            (br $jt_walk)
          )
        )

        (local.set $replacer (i32.eq
          (i32.load (call $abs (call $jt_quad (local.get $state) (i32.const 1))))
          (global.get $TYPE_FUNCTION)))

        (if (i32.eq (local.get $source_type) (global.get $TYPE_OBJECT))
          (then
            (local.set $entry (i32.add
              (i32.add
                (i32.load (call $abs (i32.add (local.get $source_lo) (i32.const 24))))
                (global.get $GC_HEADER_SIZE))
              (i32.mul (local.get $i) (global.get $ENTRY_SIZE))))
            (local.set $key_offset (i32.load (call $abs (local.get $entry))))
            (local.set $val_type (i32.load (call $abs (i32.add (local.get $entry) (i32.const 4)))))

            (if (i32.eq (local.get $val_type) (global.get $TYPE_ACCESSOR))
              (then
                (local.set $getter (i32.load (call $abs (i32.add (local.get $entry) (i32.const 12)))))
                (i32.store (call $abs (i32.add (local.get $top) (i32.const 40)))
                  (i32.add (local.get $i) (i32.const 1)))
                (call $jt_write_quad (i32.add (local.get $top) (i32.const 48))
                  (global.get $TYPE_STRING) (i32.const 0) (local.get $key_offset) (i32.const 0))
                (if (i32.eqz (local.get $getter))
                  (then
                    ;; Setter-only: the read gives undefined. With a
                    ;; replacer it must still be reported; without one
                    ;; it's simply omitted.
                    (if (local.get $replacer)
                      (then
                        (return (call $json_transform_stage
                          (local.get $frame) (local.get $state)
                          (i32.load (call $abs (i32.add (call $jt_quad (local.get $state) (i32.const 1)) (i32.const 8))))
                          (global.get $TYPE_OBJECT) (local.get $source_lo)
                          (i32.const 2)
                          (global.get $TYPE_STRING) (i32.const 0) (local.get $key_offset) (i32.const 0)
                          (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0)
                          (i32.const 2)))))
                    (br $jt_walk)))
                (return (call $json_transform_stage
                  (local.get $frame) (local.get $state) (local.get $getter)
                  (global.get $TYPE_OBJECT) (local.get $source_lo)
                  (i32.const 0)
                  (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)
                  (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)
                  (i32.const 1)))
              )
            )
            (if (local.get $replacer)
              (then
                (i32.store (call $abs (i32.add (local.get $top) (i32.const 40)))
                  (i32.add (local.get $i) (i32.const 1)))
                (call $jt_write_quad (i32.add (local.get $top) (i32.const 48))
                  (global.get $TYPE_STRING) (i32.const 0) (local.get $key_offset) (i32.const 0))
                (return (call $json_transform_stage
                  (local.get $frame) (local.get $state)
                  (i32.load (call $abs (i32.add (call $jt_quad (local.get $state) (i32.const 1)) (i32.const 8))))
                  (global.get $TYPE_OBJECT) (local.get $source_lo)
                  (i32.const 2)
                  (global.get $TYPE_STRING) (i32.const 0) (local.get $key_offset) (i32.const 0)
                  (i32.load (call $abs (i32.add (local.get $entry) (i32.const 4))))
                  (i32.load (call $abs (i32.add (local.get $entry) (i32.const 8))))
                  (i32.load (call $abs (i32.add (local.get $entry) (i32.const 12))))
                  (i32.load (call $abs (i32.add (local.get $entry) (i32.const 16))))
                  (i32.const 2)))
              )
            )
            ;; Plain data property, no replacer: skip
            ;; function/undefined-valued properties (matching the native
            ;; serializer), classify everything else.
            (if (i32.or
                  (i32.or
                    (i32.eq (local.get $val_type) (global.get $TYPE_FUNCTION))
                    (i32.eq (local.get $val_type) (global.get $TYPE_BOUND_METHOD)))
                  (i32.eq (local.get $val_type) (global.get $TYPE_UNDEFINED)))
              (then
                (i32.store (call $abs (i32.add (local.get $top) (i32.const 40)))
                  (i32.add (local.get $i) (i32.const 1)))
                (br $jt_walk)))
            (call $jt_write_quad (i32.add (local.get $top) (i32.const 48))
              (global.get $TYPE_STRING) (i32.const 0) (local.get $key_offset) (i32.const 0))
            (local.set $r (call $json_transform_classify (local.get $state)
              (i32.load (call $abs (i32.add (local.get $entry) (i32.const 4))))
              (i32.load (call $abs (i32.add (local.get $entry) (i32.const 8))))
              (i32.load (call $abs (i32.add (local.get $entry) (i32.const 12))))
              (i32.load (call $abs (i32.add (local.get $entry) (i32.const 16))))))
            (if (i32.ne (local.get $r) (i32.const 0))
              (then (return (local.get $r))))
            ;; classify may have grown the state array — re-derive.
            (local.set $top (call $jt_quad (local.get $state)
              (i32.add (i32.const 4) (i32.mul (i32.sub (local.get $depth) (i32.const 1)) (i32.const 4)))))
            (i32.store (call $abs (i32.add (local.get $top) (i32.const 40)))
              (i32.add (local.get $i) (i32.const 1)))
            (br $jt_walk)
          )
          (else
            ;; ARRAY source.
            (local.set $elem (i32.add
              (i32.add
                (i32.load (call $abs (i32.add (local.get $source_lo) (i32.const 16))))
                (global.get $GC_HEADER_SIZE))
              (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
            (if (local.get $replacer)
              (then
                ;; Spec passes the element index as a STRING key.
                (local.set $key_id (call $f64_to_string (f64.convert_i32_u (local.get $i))))
                (if (global.get $memory_pressure_signaled)
                  (then (return (i32.const -2))))
                (i32.store (call $abs (i32.add (local.get $top) (i32.const 40)))
                  (i32.add (local.get $i) (i32.const 1)))
                (call $jt_write_quad (i32.add (local.get $top) (i32.const 48))
                  (global.get $TYPE_INTEGER) (i32.const 0) (local.get $i) (i32.const 0))
                (return (call $json_transform_stage
                  (local.get $frame) (local.get $state)
                  (i32.load (call $abs (i32.add (call $jt_quad (local.get $state) (i32.const 1)) (i32.const 8))))
                  (global.get $TYPE_ARRAY) (local.get $source_lo)
                  (i32.const 2)
                  (global.get $TYPE_STRING) (i32.const 0) (local.get $key_id) (i32.const 0)
                  (i32.load (call $abs (local.get $elem)))
                  (i32.load (call $abs (i32.add (local.get $elem) (i32.const 4))))
                  (i32.load (call $abs (i32.add (local.get $elem) (i32.const 8))))
                  (i32.load (call $abs (i32.add (local.get $elem) (i32.const 12))))
                  (i32.const 2)))
              )
            )
            (call $jt_write_quad (i32.add (local.get $top) (i32.const 48))
              (global.get $TYPE_INTEGER) (i32.const 0) (local.get $i) (i32.const 0))
            (local.set $r (call $json_transform_classify (local.get $state)
              (i32.load (call $abs (local.get $elem)))
              (i32.load (call $abs (i32.add (local.get $elem) (i32.const 4))))
              (i32.load (call $abs (i32.add (local.get $elem) (i32.const 8))))
              (i32.load (call $abs (i32.add (local.get $elem) (i32.const 12))))))
            (if (i32.ne (local.get $r) (i32.const 0))
              (then (return (local.get $r))))
            (local.set $top (call $jt_quad (local.get $state)
              (i32.add (i32.const 4) (i32.mul (i32.sub (local.get $depth) (i32.const 1)) (i32.const 4)))))
            (i32.store (call $abs (i32.add (local.get $top) (i32.const 40)))
              (i32.add (local.get $i) (i32.const 1)))
            (br $jt_walk)
          )
        )
      )
    )
    ;; Complete: write the transformed root into the operand slot,
    ;; neutralize the replacer argument, pop the ITERATING frame, and
    ;; re-run the blocked instruction.
    (if (i32.eqz (i32.load (call $abs (i32.add (call $jt_quad (local.get $state) (i32.const 3)) (i32.const 8)))))
      (then
        (call $set_error (global.get $ERR_TYPE_ERROR) (i32.const 0))
        (return (i32.const -1))))
    (local.set $return_pc (i32.load (i32.add (local.get $frame) (global.get $FRAME_INSTRUCTION_INDEX))))
    (call $write_ctx (global.get $CTX_CALL_STACK_POINTER)
      (i32.sub (call $read_ctx (global.get $CTX_CALL_STACK_POINTER)) (global.get $FRAME_SIZE)))
    (global.set $current_scope (i32.load (i32.add (local.get $frame) (global.get $FRAME_SCOPE_POINTER))))
    (local.set $slot_seg (i32.sub
      (call $load_frame_pending_base (local.get $frame))
      (call $native_continuation_state_get
        (local.get $state_handle) (i32.const 0))))
    (local.set $top (call $jt_quad (local.get $state) (i32.const 2)))
    (call $jt_write_quad (local.get $slot_seg)
      (i32.load (call $abs (local.get $top)))
      (i32.load (call $abs (i32.add (local.get $top) (i32.const 4))))
      (i32.load (call $abs (i32.add (local.get $top) (i32.const 8))))
      (i32.load (call $abs (i32.add (local.get $top) (i32.const 12)))))
    (if (i32.eq
          (i32.load (call $abs (call $jt_quad (local.get $state) (i32.const 1))))
          (global.get $TYPE_FUNCTION))
      (then
        (call $jt_write_quad (i32.add (local.get $slot_seg) (global.get $VALUE_SIZE))
          (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER)
      (call $load_frame_pending_base (local.get $frame)))
    (local.get $return_pc)
  )

  ;; A staged getter/replacer call returned $result. Consume it per the
  ;; substate, then resume the walk. Substate 0 means the value was
  ;; already consumed before a mid-walk pressure yield — ignore it and
  ;; just step. Returns pc | -1 (error set) | -2 (pressure; the caller
  ;; re-pushes the result and parks on the RETURN so the retry re-enters
  ;; here with the substate unchanged).
  (func $json_transform_continue
    (param $frame i32)
    (param $rt i32) (param $rf i32) (param $rlo i32) (param $rhi i32)
    (result i32)
    (local $state_handle i32)
    (local $state i32)
    (local $substate i32)
    (local $top i32)
    (local $depth i32)
    (local $r i32)
    (local.set $state_handle
      (i32.load (i32.add
        (local.get $frame)
        (global.get $FRAME_CONTINUATION_STATE_HANDLE))))
    (local.set $state
      (call $native_continuation_state_get
        (local.get $state_handle) (i32.const 1)))
    (local.set $substate (i32.load (call $abs
      (i32.add (call $jt_quad (local.get $state) (i32.const 0)) (i32.const 8)))))
    (if (i32.eqz (local.get $substate))
      (then (return (call $json_transform_step (local.get $frame)))))
    ;; Getter returned with a replacer configured: chain replacer(key, raw)
    ;; before classifying.
    (if (i32.and
          (i32.eq (local.get $substate) (i32.const 1))
          (i32.eq
            (i32.load (call $abs (call $jt_quad (local.get $state) (i32.const 1))))
            (global.get $TYPE_FUNCTION)))
      (then
        (local.set $depth (i32.shr_u
          (i32.sub (i32.load (call $abs (i32.add (local.get $state) (i32.const 8)))) (i32.const 4))
          (i32.const 2)))
        (local.set $top (call $jt_quad (local.get $state)
          (i32.add (i32.const 4) (i32.mul (i32.sub (local.get $depth) (i32.const 1)) (i32.const 4)))))
        (return (call $json_transform_stage
          (local.get $frame) (local.get $state)
          (i32.load (call $abs (i32.add (call $jt_quad (local.get $state) (i32.const 1)) (i32.const 8))))
          (i32.load (call $abs (i32.add (local.get $top) (i32.const 16))))
          (i32.load (call $abs (i32.add (local.get $top) (i32.const 24))))
          (i32.const 2)
          (i32.load (call $abs (i32.add (local.get $top) (i32.const 48))))
          (i32.load (call $abs (i32.add (local.get $top) (i32.const 52))))
          (i32.load (call $abs (i32.add (local.get $top) (i32.const 56))))
          (i32.load (call $abs (i32.add (local.get $top) (i32.const 60))))
          (local.get $rt) (local.get $rf) (local.get $rlo) (local.get $rhi)
          (i32.const 2)))
      )
    )
    (local.set $r (call $json_transform_classify (local.get $state)
      (local.get $rt) (local.get $rf) (local.get $rlo) (local.get $rhi)))
    (if (i32.ne (local.get $r) (i32.const 0))
      (then (return (local.get $r))))
    (i32.store (call $abs (i32.add (call $jt_quad (local.get $state) (i32.const 0)) (i32.const 8)))
      (i32.const 0))
    (call $json_transform_step (local.get $frame))
  )

  ;; ==========================================================================
  ;; json_transform_begin(arg_slot, replacer_closure, slot_offset, pc)
  ;;   → next pc | -2
  ;;
  ;; Start the transform: allocate the state array, push the ITERATING
  ;; frame, then either stage the root replacer call (spec: replacer is
  ;; first invoked as replacer.call({"": value}, "", value)) or classify
  ;; the root and walk to the first getter. $arg_slot is the SEGMENT
  ;; pointer to the stringify value operand; $slot_offset the byte
  ;; distance from the pending pointer down to it; $pc the CURRENT
  ;; instruction (re-run on completion). On -2 everything allocated is
  ;; unreachable garbage and the ITERATING frame has been unwound — the
  ;; caller parks the pc and the retry re-begins from scratch (no user
  ;; code has run).
  ;; ==========================================================================
  (func $json_transform_begin
    (param $arg_slot i32) (param $replacer i32) (param $slot_offset i32) (param $pc i32)
    (result i32)
    (local $state i32)
    (local $stack_pointer i32)
    (local $frame_pointer i32)
    (local $wrapper i32)
    (local $empty_id i32)
    (local $budget i32)
    (local $dest i32)
    (local $r i32)
    (local.set $budget (call $estimate_array_size (i32.const 4)))
    (if (local.get $replacer)
      (then (local.set $budget (i32.add (local.get $budget) (call $estimate_object_size (i32.const 1))))))
    (if (call $check_heap_overflow (local.get $budget))
      (then (return (i32.const -2))))
    (local.set $state (call $allocate_array (i32.const 4)))
    (call $jt_write_quad (call $jt_quad (local.get $state) (i32.const 0))
      (global.get $TYPE_INTEGER) (i32.const 0)
      (if (result i32) (local.get $replacer) (then (i32.const 3)) (else (i32.const 0)))
      (i32.const 0))
    (if (local.get $replacer)
      (then
        (call $jt_write_quad (call $jt_quad (local.get $state) (i32.const 1))
          (global.get $TYPE_FUNCTION) (i32.const 0) (local.get $replacer) (i32.const 0)))
      (else
        (call $jt_write_quad (call $jt_quad (local.get $state) (i32.const 1))
          (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))))
    (call $jt_write_quad (call $jt_quad (local.get $state) (i32.const 2))
      (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))
    (call $jt_write_quad (call $jt_quad (local.get $state) (i32.const 3))
      (global.get $TYPE_INTEGER) (i32.const 0) (i32.const 0) (i32.const 0))
    ;; Push the ITERATING frame.
    (local.set $stack_pointer (call $read_ctx (global.get $CTX_CALL_STACK_POINTER)))
    (local.set $frame_pointer (call $abs (local.get $stack_pointer)))
    (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_INSTRUCTION_INDEX)) (local.get $pc))
    (call $publish_native_continuation_frame
      (local.get $frame_pointer) (local.get $stack_pointer)
      (call $read_ctx (global.get $CTX_PENDING_POINTER))
      (i32.const 1) (i32.const 0) (i32.const 0)
      (local.get $slot_offset) (local.get $state)
      (global.get $CONTINUATION_KIND_JSON_TRANSFORM)
      (local.get $state) (local.get $replacer)
      (global.get $TYPE_OBJECT) (i32.const 0))
    (if (local.get $replacer)
      (then
        ;; Root call: replacer.call({"": value}, "", value).
        (local.set $empty_id (call $intern_string (call $scratch_ptr (i32.const 0) (i32.const 1)) (i32.const 0)))
        (if (global.get $memory_pressure_signaled)
          (then
            (call $write_ctx (global.get $CTX_CALL_STACK_POINTER) (local.get $stack_pointer))
            (return (i32.const -2))))
        (local.set $wrapper (call $allocate_object (i32.const 1)))
        ;; Fresh capacity-1 wrapper, one write — status droppable.
        (drop (call $object_set_property (local.get $wrapper) (local.get $empty_id)
          (i32.load (call $abs (local.get $arg_slot)))
          (i32.load (call $abs (i32.add (local.get $arg_slot) (i32.const 4))))
          (i32.load (call $abs (i32.add (local.get $arg_slot) (i32.const 8))))
          (i32.load (call $abs (i32.add (local.get $arg_slot) (i32.const 12))))))
        (return (call $json_transform_stage
          (local.get $frame_pointer) (local.get $state) (local.get $replacer)
          (global.get $TYPE_OBJECT) (local.get $wrapper)
          (i32.const 2)
          (global.get $TYPE_STRING) (i32.const 0) (local.get $empty_id) (i32.const 0)
          (i32.load (call $abs (local.get $arg_slot)))
          (i32.load (call $abs (i32.add (local.get $arg_slot) (i32.const 4))))
          (i32.load (call $abs (i32.add (local.get $arg_slot) (i32.const 8))))
          (i32.load (call $abs (i32.add (local.get $arg_slot) (i32.const 12))))
          (i32.const 3)))
      )
    )
    ;; No replacer (accessor-triggered): classify the root and walk to the
    ;; first getter. On pressure/error nothing user-visible has run —
    ;; unwind the frame and let the caller park/throw.
    (local.set $r (call $json_transform_classify (local.get $state)
      (i32.load (call $abs (local.get $arg_slot)))
      (i32.load (call $abs (i32.add (local.get $arg_slot) (i32.const 4))))
      (i32.load (call $abs (i32.add (local.get $arg_slot) (i32.const 8))))
      (i32.load (call $abs (i32.add (local.get $arg_slot) (i32.const 12))))))
    (if (i32.lt_s (local.get $r) (i32.const 0))
      (then
        (call $write_ctx (global.get $CTX_CALL_STACK_POINTER) (local.get $stack_pointer))
        (return (local.get $r))))
    (local.set $r (call $json_transform_step (local.get $frame_pointer)))
    (if (i32.lt_s (local.get $r) (i32.const 0))
      (then
        ;; The step may have already popped the frame on completion; only
        ;; unwind when it is still ours (negative return = frame intact).
        (call $write_ctx (global.get $CTX_CALL_STACK_POINTER) (local.get $stack_pointer))))
    (local.get $r)
  )

  ;; ==========================================================================
  ;; ASSIGN_SETTERS driver — Object.assign onto an accessor-bearing target.
  ;;
  ;; By the time this runs, every accessor-bearing SOURCE has been resolved
  ;; to a data-only copy (the ACCESSOR_RESOLVE re-run loop). The driver
  ;; walks each source's entries left to right, mirroring SET_PROP's
  ;; semantics per key: a colliding own accessor on the target stages its
  ;; SETTER with `this` = target (getter-only collisions are silently
  ;; ignored, matching non-strict `o.x = v`); everything else writes
  ;; natively (in-place overwrite, or growth-pre-checked append).
  ;; Completion pushes the target as the call's result at the result slot
  ;; and continues AFTER the call — no re-run (setters must fire exactly
  ;; once).
  ;;
  ;; State array quads (rooted via FRAME_CONTINUATION_STATE_1):
  ;;   [0] scratch substate (written by the shared staging helper; unused)
  ;;   [1] current source argument index k (1 = first source)
  ;;   [2] current entry index i within source k
  ;;   [3] argc
  ;;   [4] byte offset from the frame pending base down to the arg1 slot
  ;; Operation-state word 0 holds the offset to the RESULT slot (they differ:
  ;; CALL_METHOD results land at the receiver slot, two below arg1).
  ;; ==========================================================================
  (func $assign_setters_step (param $frame i32) (result i32)
    (local $state_handle i32)
    (local $state i32)
    (local $target i32)
    (local $k i32)
    (local $i i32)
    (local $argc i32)
    (local $base i32)
    (local $source_seg i32)
    (local $source_lo i32)
    (local $count i32)
    (local $entry i32)
    (local $key_offset i32)
    (local $val_type i32)
    (local $setter i32)
    (local $target_count i32)
    (local $target_entries i32)
    (local $target_entry i32)
    (local $j i32)
    (local $found i32)
    (local $slot_seg i32)
    (local $return_pc i32)
    (local.set $state_handle
      (i32.load (i32.add
        (local.get $frame)
        (global.get $FRAME_CONTINUATION_STATE_HANDLE))))
    (local.set $state
      (call $native_continuation_state_get
        (local.get $state_handle) (i32.const 1)))
    (local.set $target
      (call $native_continuation_state_get
        (local.get $state_handle) (i32.const 2)))
    (local.set $base (call $load_frame_pending_base (local.get $frame)))
    (local.set $k (i32.load (call $abs (i32.add (call $jt_quad (local.get $state) (i32.const 1)) (i32.const 8)))))
    (local.set $i (i32.load (call $abs (i32.add (call $jt_quad (local.get $state) (i32.const 2)) (i32.const 8)))))
    (local.set $argc (i32.load (call $abs (i32.add (call $jt_quad (local.get $state) (i32.const 3)) (i32.const 8)))))
    (block $assign_complete
      (loop $assign_walk
        (br_if $assign_complete (i32.ge_u (local.get $k) (local.get $argc)))
        ;; arg1 (the target) sits at base − state[4]; source k lives k
        ;; slots above it (k = 1 → arg2, the first source).
        (local.set $source_seg (i32.add
          (i32.sub (local.get $base)
            (i32.load (call $abs (i32.add (call $jt_quad (local.get $state) (i32.const 4)) (i32.const 8)))))
          (i32.mul (local.get $k) (global.get $VALUE_SIZE))))
        ;; Non-object sources contribute nothing (matches the native path).
        (if (i32.ne (i32.load (call $abs (local.get $source_seg))) (global.get $TYPE_OBJECT))
          (then
            (local.set $k (i32.add (local.get $k) (i32.const 1)))
            (local.set $i (i32.const 0))
            (i32.store (call $abs (i32.add (call $jt_quad (local.get $state) (i32.const 1)) (i32.const 8))) (local.get $k))
            (i32.store (call $abs (i32.add (call $jt_quad (local.get $state) (i32.const 2)) (i32.const 8))) (i32.const 0))
            (br $assign_walk)))
        (local.set $source_lo (i32.load (call $abs (i32.add (local.get $source_seg) (i32.const 8)))))
        (local.set $count (i32.load (call $abs (i32.add (local.get $source_lo) (i32.const 12)))))
        (if (i32.ge_u (local.get $i) (local.get $count))
          (then
            (local.set $k (i32.add (local.get $k) (i32.const 1)))
            (local.set $i (i32.const 0))
            (i32.store (call $abs (i32.add (call $jt_quad (local.get $state) (i32.const 1)) (i32.const 8))) (local.get $k))
            (i32.store (call $abs (i32.add (call $jt_quad (local.get $state) (i32.const 2)) (i32.const 8))) (i32.const 0))
            (br $assign_walk)))
        (local.set $entry (i32.add
          (i32.add
            (i32.load (call $abs (i32.add (local.get $source_lo) (i32.const 24))))
            (global.get $GC_HEADER_SIZE))
          (i32.mul (local.get $i) (global.get $ENTRY_SIZE))))
        (local.set $key_offset (i32.load (call $abs (local.get $entry))))
        (local.set $val_type (i32.load (call $abs (i32.add (local.get $entry) (i32.const 4)))))
        ;; Sources are data-only by construction (resolved upstream); an
        ;; accessor here means that invariant broke — stay loud (-1: the
        ;; caller runs the throw dance via $throw_from_set_error).
        (if (i32.eq (local.get $val_type) (global.get $TYPE_ACCESSOR))
          (then
            (call $set_error (global.get $ERR_TYPE_ERROR) (i32.const 0))
            (return (i32.const -1))))
        ;; Own-entry search on the target (SET_PROP semantics — prototype
        ;; entries are not consulted).
        (local.set $target_count (i32.load (call $abs (i32.add (local.get $target) (i32.const 12)))))
        (local.set $target_entries (i32.load (call $abs (i32.add (local.get $target) (i32.const 24)))))
        (local.set $j (i32.const 0))
        (local.set $found (i32.const 0))
        (block $assign_target_found
          (loop $assign_target_scan
            (br_if $assign_target_found (i32.ge_u (local.get $j) (local.get $target_count)))
            (local.set $target_entry (i32.add
              (i32.add (local.get $target_entries) (global.get $GC_HEADER_SIZE))
              (i32.mul (local.get $j) (global.get $ENTRY_SIZE))))
            (if (i32.eq (i32.load (call $abs (local.get $target_entry))) (local.get $key_offset))
              (then
                (local.set $found (i32.const 1))
                (br $assign_target_found)))
            (local.set $j (i32.add (local.get $j) (i32.const 1)))
            (br $assign_target_scan)
          )
        )
        (if (local.get $found)
          (then
            (if (i32.eq
                  (i32.load (call $abs (i32.add (local.get $target_entry) (i32.const 4))))
                  (global.get $TYPE_ACCESSOR))
              (then
                (local.set $setter (i32.load (call $abs (i32.add (local.get $target_entry) (i32.const 16)))))
                ;; Advance past this entry BEFORE staging so the setter's
                ;; return resumes at the next one.
                (local.set $i (i32.add (local.get $i) (i32.const 1)))
                (i32.store (call $abs (i32.add (call $jt_quad (local.get $state) (i32.const 2)) (i32.const 8))) (local.get $i))
                (if (i32.eqz (local.get $setter))
                  (then (br $assign_walk)))   ;; getter-only: silent, like o.x = v
                (return (call $json_transform_stage
                  (local.get $frame) (local.get $state) (local.get $setter)
                  (global.get $TYPE_OBJECT) (local.get $target)
                  (i32.const 1)
                  (i32.load (call $abs (i32.add (local.get $entry) (i32.const 4))))
                  (i32.load (call $abs (i32.add (local.get $entry) (i32.const 8))))
                  (i32.load (call $abs (i32.add (local.get $entry) (i32.const 12))))
                  (i32.load (call $abs (i32.add (local.get $entry) (i32.const 16))))
                  (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)
                  (i32.const 0)))
              )
              (else
                ;; Plain data collision: overwrite in place (no growth).
                (i32.store (call $abs (i32.add (local.get $target_entry) (i32.const 4)))
                  (i32.load (call $abs (i32.add (local.get $entry) (i32.const 4)))))
                (i32.store (call $abs (i32.add (local.get $target_entry) (i32.const 8)))
                  (i32.load (call $abs (i32.add (local.get $entry) (i32.const 8)))))
                (i32.store (call $abs (i32.add (local.get $target_entry) (i32.const 12)))
                  (i32.load (call $abs (i32.add (local.get $entry) (i32.const 12)))))
                (i32.store (call $abs (i32.add (local.get $target_entry) (i32.const 16)))
                  (i32.load (call $abs (i32.add (local.get $entry) (i32.const 16)))))
              )
            )
          )
          (else
            ;; New key: growth-pre-checked append.
            (if (i32.ge_u (local.get $target_count)
                  (i32.load (call $abs (i32.add (local.get $target) (i32.const 16)))))
              (then
                (if (call $check_heap_overflow (call $estimate_object_grow_size
                      (i32.load (call $abs (i32.add (local.get $target) (i32.const 16))))))
                  (then (return (i32.const -2))))))
            ;; Grow pre-budgeted just above — status droppable.
            (drop (call $object_set_property (local.get $target) (local.get $key_offset)
              (i32.load (call $abs (i32.add (local.get $entry) (i32.const 4))))
              (i32.load (call $abs (i32.add (local.get $entry) (i32.const 8))))
              (i32.load (call $abs (i32.add (local.get $entry) (i32.const 12))))
              (i32.load (call $abs (i32.add (local.get $entry) (i32.const 16))))))
          )
        )
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (i32.store (call $abs (i32.add (call $jt_quad (local.get $state) (i32.const 2)) (i32.const 8))) (local.get $i))
        (br $assign_walk)
      )
    )
    ;; Complete: pop the frame, land the target at the result slot,
    ;; continue after the call.
    (local.set $return_pc (i32.load (i32.add (local.get $frame) (global.get $FRAME_INSTRUCTION_INDEX))))
    (call $write_ctx (global.get $CTX_CALL_STACK_POINTER)
      (i32.sub (call $read_ctx (global.get $CTX_CALL_STACK_POINTER)) (global.get $FRAME_SIZE)))
    (global.set $current_scope (i32.load (i32.add (local.get $frame) (global.get $FRAME_SCOPE_POINTER))))
    (local.set $slot_seg (i32.sub (local.get $base)
      (call $native_continuation_state_get
        (local.get $state_handle) (i32.const 0))))
    (call $jt_write_quad (local.get $slot_seg)
      (global.get $TYPE_OBJECT) (i32.const 0) (local.get $target) (i32.const 0))
    (call $write_ctx (global.get $CTX_PENDING_POINTER)
      (i32.add (local.get $slot_seg) (global.get $VALUE_SIZE)))
    (local.get $return_pc)
  )

  ;; ==========================================================================
  ;; assign_setters_begin(target, result_slot_offset, arg1_slot_offset,
  ;;                      argc, pc) → next pc | -2
  ;;
  ;; $pc is the CURRENT call instruction; the frame parks pc+1 so
  ;; completion continues AFTER the call. On -2 nothing user-visible has
  ;; run and the frame is unwound — the caller parks the pc and the retry
  ;; re-begins.
  ;; ==========================================================================
  (func $assign_setters_begin
    (param $target i32) (param $result_slot_offset i32)
    (param $arg1_slot_offset i32) (param $argc i32) (param $pc i32)
    (result i32)
    (local $state i32)
    (local $stack_pointer i32)
    (local $frame_pointer i32)
    (local $r i32)
    (if (call $check_heap_overflow (call $estimate_array_size (i32.const 5)))
      (then (return (i32.const -2))))
    (local.set $state (call $allocate_array (i32.const 5)))
    (call $jt_write_quad (call $jt_quad (local.get $state) (i32.const 0))
      (global.get $TYPE_INTEGER) (i32.const 0) (i32.const 0) (i32.const 0))
    (call $jt_write_quad (call $jt_quad (local.get $state) (i32.const 1))
      (global.get $TYPE_INTEGER) (i32.const 0) (i32.const 1) (i32.const 0))
    (call $jt_write_quad (call $jt_quad (local.get $state) (i32.const 2))
      (global.get $TYPE_INTEGER) (i32.const 0) (i32.const 0) (i32.const 0))
    (call $jt_write_quad (call $jt_quad (local.get $state) (i32.const 3))
      (global.get $TYPE_INTEGER) (i32.const 0) (local.get $argc) (i32.const 0))
    (call $jt_write_quad (call $jt_quad (local.get $state) (i32.const 4))
      (global.get $TYPE_INTEGER) (i32.const 0) (local.get $arg1_slot_offset) (i32.const 0))
    (local.set $stack_pointer (call $read_ctx (global.get $CTX_CALL_STACK_POINTER)))
    (local.set $frame_pointer (call $abs (local.get $stack_pointer)))
    (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_INSTRUCTION_INDEX))
      (i32.add (local.get $pc) (i32.const 1)))
    (call $publish_native_continuation_frame
      (local.get $frame_pointer) (local.get $stack_pointer)
      (call $read_ctx (global.get $CTX_PENDING_POINTER))
      (i32.const 1) (i32.const 0) (i32.const 0)
      (local.get $result_slot_offset) (local.get $state)
      (global.get $CONTINUATION_KIND_ASSIGN_SETTERS)
      (local.get $target) (i32.const 0)
      (global.get $TYPE_OBJECT) (i32.const 0))
    (local.set $r (call $assign_setters_step (local.get $frame_pointer)))
    (if (i32.lt_s (local.get $r) (i32.const 0))
      (then
        (call $write_ctx (global.get $CTX_CALL_STACK_POINTER) (local.get $stack_pointer))))
    (local.get $r)
  )

  ;; ==========================================================================
  ;; JSON_INTERNALIZE driver — JSON.parse with a function reviver.
  ;;
  ;; Runs AFTER the native parse (pure data: no accessors, no cycles) and
  ;; walks the result bottom-up per InternalizeJSONProperty: children are
  ;; internalized before their holder's entry is offered to the reviver,
  ;; reviver(key, value) is staged with `this` = the holder, an undefined
  ;; return deletes the entry (objects) or writes undefined (arrays — the
  ;; nearest expressible shape of the spec's hole), and the final call is
  ;; reviver.call({"": root}, "", root). Completion lands the revived
  ;; result at the call's result slot and continues AFTER the call — a
  ;; re-run would re-parse (and the reviver must fire exactly once).
  ;;
  ;; State array (5 header quads + 4 per DFS frame), rooted via
  ;; FRAME_CONTINUATION_STATE_1 like JSON_TRANSFORM:
  ;;   [0] substate INTEGER: 0 walking, 1 awaiting entry reviver,
  ;;       3 awaiting root reviver
  ;;   [1] reviver closure (TYPE_FUNCTION)
  ;;   [2] result holder (VALUE): the parsed root before the root call,
  ;;       the root reviver's return after it
  ;;   [3] root-resolved INTEGER (0/1)
  ;;   [4] root wrapper object ({"": root} — `this` for the root call)
  ;;   [5..] DFS frames, 4 quads each:
  ;;       +0 container being internalized in place (OBJECT/ARRAY value)
  ;;       +1 awaited entry key (STRING id for objects, INTEGER index
  ;;          for arrays) — the entry whose reviver call or child walk
  ;;          is outstanding
  ;;       +2 next entry index (INTEGER)
  ;;       +3 reserved (UNDEFINED)
  ;;
  ;; Pressure discipline mirrors JSON_TRANSFORM: -2 is returned only
  ;; BEFORE the mutations of the entry being processed, so a retry
  ;; re-enters via the RETURN continuation (substate unchanged) or
  ;; re-steps (substate 0) resume-exact.
  ;; ==========================================================================
  (func $json_internalize_step (param $frame i32) (result i32)
    (local $state_handle i32)
    (local $state i32)
    (local $len i32)
    (local $depth i32)
    (local $top i32)
    (local $container_type i32)
    (local $container_lo i32)
    (local $count i32)
    (local $i i32)
    (local $entry i32)
    (local $key_id i32)
    (local $val_type i32)
    (local $elem i32)
    (local $parent i32)
    (local $return_pc i32)
    (local $slot_seg i32)
    (local $empty_id i32)
    (local.set $state_handle
      (i32.load (i32.add
        (local.get $frame)
        (global.get $FRAME_CONTINUATION_STATE_HANDLE))))
    (local.set $state
      (call $native_continuation_state_get
        (local.get $state_handle) (i32.const 1)))
    (block $ji_complete
      (loop $ji_walk
        (local.set $len (i32.load (call $abs (i32.add (local.get $state) (i32.const 8)))))
        (local.set $depth (i32.div_u (i32.sub (local.get $len) (i32.const 5)) (i32.const 4)))
        (if (i32.eqz (local.get $depth))
          (then
            (br_if $ji_complete
              (i32.load (call $abs (i32.add (call $jt_quad (local.get $state) (i32.const 3)) (i32.const 8)))))
            ;; Root call: reviver.call({"": root}, "", root).
            (local.set $empty_id (call $intern_string (call $scratch_ptr (i32.const 0) (i32.const 1)) (i32.const 0)))
            (if (global.get $memory_pressure_signaled)
              (then (return (i32.const -2))))
            (local.set $top (call $jt_quad (local.get $state) (i32.const 2)))
            (return (call $json_transform_stage
              (local.get $frame) (local.get $state)
              (i32.load (call $abs (i32.add (call $jt_quad (local.get $state) (i32.const 1)) (i32.const 8))))
              (global.get $TYPE_OBJECT)
              (i32.load (call $abs (i32.add (call $jt_quad (local.get $state) (i32.const 4)) (i32.const 8))))
              (i32.const 2)
              (global.get $TYPE_STRING) (i32.const 0) (local.get $empty_id) (i32.const 0)
              (i32.load (call $abs (local.get $top)))
              (i32.load (call $abs (i32.add (local.get $top) (i32.const 4))))
              (i32.load (call $abs (i32.add (local.get $top) (i32.const 8))))
              (i32.load (call $abs (i32.add (local.get $top) (i32.const 12))))
              (i32.const 3)))
          )
        )
        (local.set $top (call $jt_quad (local.get $state)
          (i32.add (i32.const 5) (i32.mul (i32.sub (local.get $depth) (i32.const 1)) (i32.const 4)))))
        (local.set $container_type (i32.load (call $abs (local.get $top))))
        (local.set $container_lo (i32.load (call $abs (i32.add (local.get $top) (i32.const 8)))))
        (if (i32.eq (local.get $container_type) (global.get $TYPE_OBJECT))
          (then (local.set $count (i32.load (call $abs (i32.add (local.get $container_lo) (i32.const 12))))))
          (else (local.set $count (i32.load (call $abs (i32.add (local.get $container_lo) (i32.const 8)))))))
        (local.set $i (i32.load (call $abs (i32.add
          (call $jt_quad (local.get $state)
            (i32.add (i32.const 7) (i32.mul (i32.sub (local.get $depth) (i32.const 1)) (i32.const 4))))
          (i32.const 8)))))

        ;; Exhausted: this container's children are internalized. Pop its
        ;; frame and offer the container itself to the reviver — in its
        ;; parent for depth >= 2, as the root call otherwise (next loop
        ;; iteration's depth-0 branch).
        (if (i32.ge_u (local.get $i) (local.get $count))
          (then
            (if (i32.ge_u (local.get $depth) (i32.const 2))
              (then
                (local.set $parent (call $jt_quad (local.get $state)
                  (i32.add (i32.const 5) (i32.mul (i32.sub (local.get $depth) (i32.const 2)) (i32.const 4)))))
                ;; a1 = the awaited key as a STRING (arrays intern the
                ;; index BEFORE the pop mutation — pressure stays exact).
                (if (i32.eq (i32.load (call $abs (local.get $parent))) (global.get $TYPE_ARRAY))
                  (then
                    (local.set $key_id (call $f64_to_string (f64.convert_i32_u
                      (i32.load (call $abs (i32.add
                        (i32.add (local.get $parent) (global.get $VALUE_SIZE))
                        (i32.const 8)))))))
                    (if (global.get $memory_pressure_signaled)
                      (then (return (i32.const -2)))))
                  (else
                    (local.set $key_id (i32.load (call $abs (i32.add
                      (i32.add (local.get $parent) (global.get $VALUE_SIZE))
                      (i32.const 8)))))))
                (i32.store (call $abs (i32.add (local.get $state) (i32.const 8)))
                  (i32.sub (local.get $len) (i32.const 4)))
                (return (call $json_transform_stage
                  (local.get $frame) (local.get $state)
                  (i32.load (call $abs (i32.add (call $jt_quad (local.get $state) (i32.const 1)) (i32.const 8))))
                  (i32.load (call $abs (local.get $parent)))
                  (i32.load (call $abs (i32.add (local.get $parent) (i32.const 8))))
                  (i32.const 2)
                  (global.get $TYPE_STRING) (i32.const 0) (local.get $key_id) (i32.const 0)
                  (local.get $container_type) (i32.const 0) (local.get $container_lo) (i32.const 0)
                  (i32.const 1)))
              )
              (else
                ;; Root container done — pop; the loop re-enters at depth 0.
                (i32.store (call $abs (i32.add (local.get $state) (i32.const 8)))
                  (i32.sub (local.get $len) (i32.const 4)))
                (br $ji_walk)
              )
            )
          )
        )

        ;; Entry i: read (key, value).
        (if (i32.eq (local.get $container_type) (global.get $TYPE_OBJECT))
          (then
            (local.set $entry (i32.add
              (i32.add
                (i32.load (call $abs (i32.add (local.get $container_lo) (i32.const 24))))
                (global.get $GC_HEADER_SIZE))
              (i32.mul (local.get $i) (global.get $ENTRY_SIZE))))
            (local.set $key_id (i32.load (call $abs (local.get $entry))))
            (local.set $val_type (i32.load (call $abs (i32.add (local.get $entry) (i32.const 4)))))
            (local.set $elem (i32.add (local.get $entry) (i32.const 4)))
          )
          (else
            (local.set $elem (i32.add
              (i32.add
                (i32.load (call $abs (i32.add (local.get $container_lo) (i32.const 16))))
                (global.get $GC_HEADER_SIZE))
              (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
            (local.set $val_type (i32.load (call $abs (local.get $elem))))
            (local.set $key_id (local.get $i))
          )
        )

        (if (i32.or
              (i32.eq (local.get $val_type) (global.get $TYPE_OBJECT))
              (i32.eq (local.get $val_type) (global.get $TYPE_ARRAY)))
          (then
            ;; Descend first (bottom-up). Pre-check state growth BEFORE
            ;; any mutation, then record the awaited entry and push.
            (if (i32.gt_u
                  (i32.add (local.get $len) (i32.const 4))
                  (i32.load (call $abs (i32.add (local.get $state) (i32.const 12)))))
              (then
                (if (call $check_heap_overflow
                      (call $estimate_array_grow_size
                        (i32.load (call $abs (i32.add (local.get $state) (i32.const 12))))))
                  (then (return (i32.const -2))))))
            (call $jt_write_quad
              (i32.add (local.get $top) (global.get $VALUE_SIZE))
              (if (result i32) (i32.eq (local.get $container_type) (global.get $TYPE_OBJECT))
                (then (global.get $TYPE_STRING)) (else (global.get $TYPE_INTEGER)))
              (i32.const 0) (local.get $key_id) (i32.const 0))
            (i32.store (call $abs (i32.add
              (call $jt_quad (local.get $state)
                (i32.add (i32.const 7) (i32.mul (i32.sub (local.get $depth) (i32.const 1)) (i32.const 4))))
              (i32.const 8)))
              (i32.add (local.get $i) (i32.const 1)))
            ;; Growth pre-checked above — push statuses droppable.
            (drop (call $array_push_value (local.get $state)
              (local.get $val_type) (i32.const 0)
              (i32.load (call $abs (i32.add (local.get $elem) (i32.const 8)))) (i32.const 0)))
            (drop (call $array_push_value (local.get $state)
              (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0)))
            (drop (call $array_push_value (local.get $state)
              (global.get $TYPE_INTEGER) (i32.const 0) (i32.const 0) (i32.const 0)))
            (drop (call $array_push_value (local.get $state)
              (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0)))
            (br $ji_walk)
          )
        )

        ;; Scalar entry: stage reviver(key, value) with `this` = holder.
        ;; Array indexes intern their string BEFORE the advance mutation.
        (if (i32.eq (local.get $container_type) (global.get $TYPE_ARRAY))
          (then
            (local.set $key_id (call $f64_to_string (f64.convert_i32_u (local.get $i))))
            (if (global.get $memory_pressure_signaled)
              (then (return (i32.const -2))))))
        (call $jt_write_quad
          (i32.add (local.get $top) (global.get $VALUE_SIZE))
          (if (result i32) (i32.eq (local.get $container_type) (global.get $TYPE_OBJECT))
            (then (global.get $TYPE_STRING)) (else (global.get $TYPE_INTEGER)))
          (i32.const 0)
          (if (result i32) (i32.eq (local.get $container_type) (global.get $TYPE_OBJECT))
            (then (local.get $key_id)) (else (local.get $i)))
          (i32.const 0))
        (i32.store (call $abs (i32.add
          (call $jt_quad (local.get $state)
            (i32.add (i32.const 7) (i32.mul (i32.sub (local.get $depth) (i32.const 1)) (i32.const 4))))
          (i32.const 8)))
          (i32.add (local.get $i) (i32.const 1)))
        (return (call $json_transform_stage
          (local.get $frame) (local.get $state)
          (i32.load (call $abs (i32.add (call $jt_quad (local.get $state) (i32.const 1)) (i32.const 8))))
          (local.get $container_type) (local.get $container_lo)
          (i32.const 2)
          (global.get $TYPE_STRING) (i32.const 0) (local.get $key_id) (i32.const 0)
          (i32.load (call $abs (local.get $elem)))
          (i32.load (call $abs (i32.add (local.get $elem) (i32.const 4))))
          (i32.load (call $abs (i32.add (local.get $elem) (i32.const 8))))
          (i32.load (call $abs (i32.add (local.get $elem) (i32.const 12))))
          (i32.const 1)))
      )
    )
    ;; Complete: pop the frame, land the revived root at the result slot,
    ;; continue after the call (assign_setters completion idiom).
    (local.set $return_pc (i32.load (i32.add (local.get $frame) (global.get $FRAME_INSTRUCTION_INDEX))))
    (call $write_ctx (global.get $CTX_CALL_STACK_POINTER)
      (i32.sub (call $read_ctx (global.get $CTX_CALL_STACK_POINTER)) (global.get $FRAME_SIZE)))
    (global.set $current_scope (i32.load (i32.add (local.get $frame) (global.get $FRAME_SCOPE_POINTER))))
    (local.set $slot_seg (i32.sub
      (call $load_frame_pending_base (local.get $frame))
      (call $native_continuation_state_get
        (local.get $state_handle) (i32.const 0))))
    (local.set $top (call $jt_quad (local.get $state) (i32.const 2)))
    (call $jt_write_quad (local.get $slot_seg)
      (i32.load (call $abs (local.get $top)))
      (i32.load (call $abs (i32.add (local.get $top) (i32.const 4))))
      (i32.load (call $abs (i32.add (local.get $top) (i32.const 8))))
      (i32.load (call $abs (i32.add (local.get $top) (i32.const 12)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER)
      (i32.add (local.get $slot_seg) (global.get $VALUE_SIZE)))
    (local.get $return_pc)
  )

  ;; A staged reviver call returned $r*. Apply it per the substate, then
  ;; resume the walk. Substate 0 = mid-walk pressure resume (the value was
  ;; already applied): just step. Returns pc | -1 (error set) | -2
  ;; (pressure; the caller re-pushes the result and parks on the RETURN so
  ;; the retry re-enters here with the substate unchanged).
  (func $json_internalize_continue
    (param $frame i32)
    (param $rt i32) (param $rf i32) (param $rlo i32) (param $rhi i32)
    (result i32)
    (local $state_handle i32)
    (local $state i32)
    (local $substate i32)
    (local $len i32)
    (local $depth i32)
    (local $top i32)
    (local $key_quad i32)
    (local $container_type i32)
    (local $container_lo i32)
    (local $idx i32)
    (local $arr_len i32)
    (local.set $state_handle
      (i32.load (i32.add
        (local.get $frame)
        (global.get $FRAME_CONTINUATION_STATE_HANDLE))))
    (local.set $state
      (call $native_continuation_state_get
        (local.get $state_handle) (i32.const 1)))
    (local.set $substate (i32.load (call $abs
      (i32.add (call $jt_quad (local.get $state) (i32.const 0)) (i32.const 8)))))
    (if (i32.eqz (local.get $substate))
      (then (return (call $json_internalize_step (local.get $frame)))))
    (if (i32.eq (local.get $substate) (i32.const 3))
      (then
        ;; Root reviver returned: it IS the final result.
        (call $jt_write_quad (call $jt_quad (local.get $state) (i32.const 2))
          (local.get $rt) (local.get $rf) (local.get $rlo) (local.get $rhi))
        (i32.store (call $abs (i32.add (call $jt_quad (local.get $state) (i32.const 3)) (i32.const 8)))
          (i32.const 1))
        (i32.store (call $abs (i32.add (call $jt_quad (local.get $state) (i32.const 0)) (i32.const 8)))
          (i32.const 0))
        (return (call $json_internalize_step (local.get $frame)))))
    ;; Substate 1: apply to the awaited entry of the top frame's holder.
    (local.set $len (i32.load (call $abs (i32.add (local.get $state) (i32.const 8)))))
    (local.set $depth (i32.div_u (i32.sub (local.get $len) (i32.const 5)) (i32.const 4)))
    (local.set $top (call $jt_quad (local.get $state)
      (i32.add (i32.const 5) (i32.mul (i32.sub (local.get $depth) (i32.const 1)) (i32.const 4)))))
    (local.set $key_quad (i32.add (local.get $top) (global.get $VALUE_SIZE)))
    (local.set $container_type (i32.load (call $abs (local.get $top))))
    (local.set $container_lo (i32.load (call $abs (i32.add (local.get $top) (i32.const 8)))))
    (if (i32.eq (local.get $container_type) (global.get $TYPE_OBJECT))
      (then
        (if (i32.eq (local.get $rt) (global.get $TYPE_UNDEFINED))
          (then
            ;; Compacting delete — no allocation, pressure-free.
            (drop (call $object_delete_own_property (local.get $container_lo)
              (i32.load (call $abs (i32.add (local.get $key_quad) (i32.const 8)))))))
          (else
            ;; Overwrite of a live key never grows; a reviver that deleted
            ;; its own key via `this` makes this an append — pre-check so
            ;; -2 stays exact.
            (if (call $check_heap_overflow (call $estimate_object_size (i32.const 1)))
              (then (return (i32.const -2))))
            (drop (call $object_set_property (local.get $container_lo)
              (i32.load (call $abs (i32.add (local.get $key_quad) (i32.const 8))))
              (local.get $rt) (local.get $rf) (local.get $rlo) (local.get $rhi))))))
      (else
        ;; Array entry: write in place (undefined stands in for the
        ;; spec's hole). A reviver shrinking the array via `this` can
        ;; strand the index — guard against out-of-bounds.
        (local.set $idx (i32.load (call $abs (i32.add (local.get $key_quad) (i32.const 8)))))
        (local.set $arr_len (i32.load (call $abs (i32.add (local.get $container_lo) (i32.const 8)))))
        (if (i32.lt_u (local.get $idx) (local.get $arr_len))
          (then
            (call $jt_write_quad
              (i32.add
                (i32.add
                  (i32.load (call $abs (i32.add (local.get $container_lo) (i32.const 16))))
                  (global.get $GC_HEADER_SIZE))
                (i32.mul (local.get $idx) (global.get $VALUE_SIZE)))
              (local.get $rt) (local.get $rf) (local.get $rlo) (local.get $rhi))))))
    (i32.store (call $abs (i32.add (call $jt_quad (local.get $state) (i32.const 0)) (i32.const 8)))
      (i32.const 0))
    (call $json_internalize_step (local.get $frame))
  )

  ;; ==========================================================================
  ;; json_internalize_begin(target_slot, reviver, pc) → next pc | -2
  ;;
  ;; The freshly parsed root sits on top of the pending stack (pushed by
  ;; $json_parse); begin consumes it. $target_slot is the SEGMENT pointer
  ;; of the call's result slot (the callable for OP_CALL, the receiver for
  ;; OP_CALL_METHOD); the frame parks pc+1 so completion continues AFTER
  ;; the call. On -2 the pending stack is already popped and the frame
  ;; unwound — the retry re-runs the CALL, which re-parses (no user code
  ;; has run).
  ;; ==========================================================================
  (func $json_internalize_begin
    (param $target_slot i32) (param $reviver i32) (param $pc i32)
    (result i32)
    (local $state i32)
    (local $stack_pointer i32)
    (local $frame_pointer i32)
    (local $wrapper i32)
    (local $empty_id i32)
    (local $root_seg i32)
    (local $root_type i32)
    (local $r i32)
    ;; Pop the parsed root (pointer only — the bytes at root_seg stay
    ;; readable until the next push).
    (local.set $root_seg (i32.sub (call $read_ctx (global.get $CTX_PENDING_POINTER)) (global.get $VALUE_SIZE)))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $root_seg))
    (if (call $check_heap_overflow
          (i32.add
            (i32.add
              (call $estimate_array_size (i32.const 5))
              (call $estimate_array_grow_size (i32.const 5)))
            (call $estimate_object_size (i32.const 1))))
      (then (return (i32.const -2))))
    (local.set $empty_id (call $intern_string (call $scratch_ptr (i32.const 0) (i32.const 1)) (i32.const 0)))
    (if (global.get $memory_pressure_signaled)
      (then (return (i32.const -2))))
    (local.set $state (call $allocate_array (i32.const 5)))
    (call $jt_write_quad (call $jt_quad (local.get $state) (i32.const 0))
      (global.get $TYPE_INTEGER) (i32.const 0) (i32.const 0) (i32.const 0))
    (call $jt_write_quad (call $jt_quad (local.get $state) (i32.const 1))
      (global.get $TYPE_FUNCTION) (i32.const 0) (local.get $reviver) (i32.const 0))
    (call $jt_write_quad (call $jt_quad (local.get $state) (i32.const 2))
      (i32.load (call $abs (local.get $root_seg)))
      (i32.load (call $abs (i32.add (local.get $root_seg) (i32.const 4))))
      (i32.load (call $abs (i32.add (local.get $root_seg) (i32.const 8))))
      (i32.load (call $abs (i32.add (local.get $root_seg) (i32.const 12)))))
    (call $jt_write_quad (call $jt_quad (local.get $state) (i32.const 3))
      (global.get $TYPE_INTEGER) (i32.const 0) (i32.const 0) (i32.const 0))
    (local.set $wrapper (call $allocate_object (i32.const 1)))
    ;; Fresh capacity-1 wrapper, one write — status droppable.
    (drop (call $object_set_property (local.get $wrapper) (local.get $empty_id)
      (i32.load (call $abs (local.get $root_seg)))
      (i32.load (call $abs (i32.add (local.get $root_seg) (i32.const 4))))
      (i32.load (call $abs (i32.add (local.get $root_seg) (i32.const 8))))
      (i32.load (call $abs (i32.add (local.get $root_seg) (i32.const 12))))))
    (call $jt_write_quad (call $jt_quad (local.get $state) (i32.const 4))
      (global.get $TYPE_OBJECT) (i32.const 0) (local.get $wrapper) (i32.const 0))
    ;; Publish the ITERATING frame parked at pc+1.
    (local.set $stack_pointer (call $read_ctx (global.get $CTX_CALL_STACK_POINTER)))
    (local.set $frame_pointer (call $abs (local.get $stack_pointer)))
    (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_INSTRUCTION_INDEX))
      (i32.add (local.get $pc) (i32.const 1)))
    (call $publish_native_continuation_frame
      (local.get $frame_pointer) (local.get $stack_pointer)
      (call $read_ctx (global.get $CTX_PENDING_POINTER))
      (i32.const 1) (i32.const 0) (i32.const 0)
      (i32.sub (call $read_ctx (global.get $CTX_PENDING_POINTER)) (local.get $target_slot))
      (local.get $state)
      (global.get $CONTINUATION_KIND_JSON_INTERNALIZE)
      (local.get $state) (local.get $reviver)
      (global.get $TYPE_OBJECT) (i32.const 0))
    ;; A container root walks its children first; the growth was budgeted.
    (local.set $root_type (i32.load (call $abs (local.get $root_seg))))
    (if (i32.or
          (i32.eq (local.get $root_type) (global.get $TYPE_OBJECT))
          (i32.eq (local.get $root_type) (global.get $TYPE_ARRAY)))
      (then
        (drop (call $array_push_value (local.get $state)
          (local.get $root_type) (i32.const 0)
          (i32.load (call $abs (i32.add (local.get $root_seg) (i32.const 8)))) (i32.const 0)))
        (drop (call $array_push_value (local.get $state)
          (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0)))
        (drop (call $array_push_value (local.get $state)
          (global.get $TYPE_INTEGER) (i32.const 0) (i32.const 0) (i32.const 0)))
        (drop (call $array_push_value (local.get $state)
          (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0)))))
    (local.set $r (call $json_internalize_step (local.get $frame_pointer)))
    (if (i32.lt_s (local.get $r) (i32.const 0))
      (then
        (call $write_ctx (global.get $CTX_CALL_STACK_POINTER) (local.get $stack_pointer))))
    (local.get $r)
  )

  ;; ==========================================================================
  ;; sym_block_set(slot_addr, sym_ptr, type, flags, lo, hi) → pressure flag
  ;;
  ;; Full symbol-keyed property write against the sym-entries pointer slot
  ;; at $slot_addr: update an existing entry in place, lazy-allocate the
  ;; initial block (capacity 4) on first write, or grow the block by
  ;; doubling when full. Allocations are guarded by $check_heap_overflow;
  ;; on overflow nothing is written and the function returns 1 so the
  ;; caller can yield EXIT_MEMORY_PRESSURE and retry cleanly.
  ;; ==========================================================================
  (func $sym_block_set
    (param $slot_addr i32) (param $sym_ptr i32)
    (param $val_type i32) (param $val_flags i32)
    (param $val_lo i32) (param $val_hi i32)
    (result i32)
    (local $entries_pointer i32)
    (local $entry_pointer i32)
    (local $count i32)
    (local $capacity i32)
    (local $new_cap i32)
    (local $new_entries i32)
    (local $new_size i32)
    (local $heap_pointer i32)
    (local $i i32)
    (local $src i32)
    (local $dst i32)

    (local.set $entries_pointer (i32.load (call $abs (local.get $slot_addr))))

    ;; Existing key → update in place (no allocation).
    (local.set $entry_pointer (call $sym_block_find (local.get $entries_pointer) (local.get $sym_ptr)))
    (if (i32.ne (local.get $entry_pointer) (i32.const 0))
      (then
        (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 4))) (local.get $val_type))
        (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 8))) (local.get $val_flags))
        (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 12))) (local.get $val_lo))
        (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 16))) (local.get $val_hi))
        (return (i32.const 0))
      )
    )

    ;; Lazy-allocate the initial block (capacity 4) on first symbol write.
    (if (i32.eqz (local.get $entries_pointer))
      (then
        (if (call $check_heap_overflow (call $estimate_object_sym_entries_size))
          (then (return (i32.const 1)))
        )
        (local.set $heap_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))
        (local.set $entries_pointer (local.get $heap_pointer))
        ;; size = GC(8) + count(4) + capacity(4) + 4 * 20 = 96
        (i32.store (call $abs (local.get $entries_pointer))
          (i32.or (i32.const 96) (i32.shl (global.get $OBJ_OBJECT_DATA) (i32.const 24))))
        (i32.store (call $abs (i32.add (local.get $entries_pointer) (i32.const 4))) (i32.const 0))
        (i32.store (call $abs (i32.add (local.get $entries_pointer) (i32.const 8))) (i32.const 0))   ;; count
        (i32.store (call $abs (i32.add (local.get $entries_pointer) (i32.const 12))) (i32.const 4))  ;; capacity
        (call $write_state (global.get $STATE_HEAP_POINTER)
          (i32.add (local.get $entries_pointer) (i32.const 96)))
        (i32.store (call $abs (local.get $slot_addr)) (local.get $entries_pointer))
      )
    )

    (local.set $count (i32.load (call $abs (i32.add (local.get $entries_pointer) (i32.const 8)))))
    (local.set $capacity (i32.load (call $abs (i32.add (local.get $entries_pointer) (i32.const 12)))))

    ;; Grow at capacity: double, copy, install.
    (if (i32.ge_u (local.get $count) (local.get $capacity))
      (then
        (local.set $new_cap (i32.mul (local.get $capacity) (i32.const 2)))
        (if (i32.lt_u (local.get $new_cap) (i32.const 4))
          (then (local.set $new_cap (i32.const 4)))
        )
        ;; block size = GC(8) + count(4) + capacity(4) + new_cap * 20
        (local.set $new_size (i32.add (i32.const 16)
          (i32.mul (local.get $new_cap) (global.get $ENTRY_SIZE))))
        (if (call $check_heap_overflow (local.get $new_size))
          (then (return (i32.const 1)))
        )
        (local.set $heap_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))
        (local.set $new_entries (local.get $heap_pointer))
        (i32.store (call $abs (local.get $new_entries))
          (i32.or (local.get $new_size) (i32.shl (global.get $OBJ_OBJECT_DATA) (i32.const 24))))
        (i32.store (call $abs (i32.add (local.get $new_entries) (i32.const 4))) (i32.const 0))
        (i32.store (call $abs (i32.add (local.get $new_entries) (i32.const 8))) (local.get $count))
        (i32.store (call $abs (i32.add (local.get $new_entries) (i32.const 12))) (local.get $new_cap))
        (call $write_state (global.get $STATE_HEAP_POINTER)
          (i32.add (local.get $new_entries) (local.get $new_size)))

        ;; Copy existing entries (entries start at block + 16).
        (local.set $i (i32.const 0))
        (block $copy_done
          (loop $copy
            (br_if $copy_done (i32.ge_u (local.get $i) (local.get $count)))
            (local.set $src (i32.add
              (i32.add (local.get $entries_pointer) (i32.const 16))
              (i32.mul (local.get $i) (global.get $ENTRY_SIZE))))
            (local.set $dst (i32.add
              (i32.add (local.get $new_entries) (i32.const 16))
              (i32.mul (local.get $i) (global.get $ENTRY_SIZE))))
            (memory.copy (call $abs (local.get $dst)) (call $abs (local.get $src)) (global.get $ENTRY_SIZE))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $copy)
          )
        )

        (i32.store (call $abs (local.get $slot_addr)) (local.get $new_entries))
        (local.set $entries_pointer (local.get $new_entries))
      )
    )

    ;; Append at $count.
    (local.set $entry_pointer (i32.add
      (i32.add (local.get $entries_pointer) (i32.const 16))
      (i32.mul (local.get $count) (global.get $ENTRY_SIZE))))
    (i32.store (call $abs (local.get $entry_pointer)) (local.get $sym_ptr))
    (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 4))) (local.get $val_type))
    (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 8))) (local.get $val_flags))
    (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 12))) (local.get $val_lo))
    (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 16))) (local.get $val_hi))
    (i32.store (call $abs (i32.add (local.get $entries_pointer) (i32.const 8)))
      (i32.add (local.get $count) (i32.const 1)))
    (i32.const 0)
  )

  ;; ==========================================================================
  ;; build_collection_iterator(coll_type, header_pointer, factory_method_id, next_method_id)
  ;;
  ;; Allocates a 4-slot iterator object that closes over:
  ;;   @coll  = the source Map/Set value
  ;;   @index = next slot to inspect (counts slotCount, skips tombstones)
  ;;   @kind  = iterator kind:
  ;;            Map:  0 = keys, 1 = values, 2 = entries ([k, v] pair)
  ;;            Set:  1 = values (same as keys), 2 = entries ([v, v] pair)
  ;;   next   = bound method dispatching to next_method_id with the
  ;;            iterator object as receiver
  ;; Then pushes the iterator object as the call's return value.
  ;; ==========================================================================
  (func $build_collection_iterator
    (param $coll_type i32) (param $header_pointer i32)
    (param $factory_method_id i32) (param $next_method_id i32)
    (local $iter_pointer i32)
    (local $kind i32)

    ;; Pre-check total heap budget: one object (cap 4, no grow because
    ;; we write exactly 4 string-keyed slots) + the lazy sym-entries
    ;; block for Symbol.iterator. On overflow, signal pressure and
    ;; return without touching the heap; the opcode handler checks the
    ;; flag and yields EXIT_MEMORY_PRESSURE.
    (if (call $check_heap_overflow
          (i32.add
            (call $estimate_object_size (i32.const 4))
            (call $estimate_object_sym_entries_size)))
      (then (return)))

    ;; Derive @kind from the factory method id. Map: keys=0, values=1,
    ;; entries=2. Set: values=1 (same key for keys/values), entries=2.
    (if (i32.eq (local.get $factory_method_id) (global.get $METHOD_MAP_KEYS))
      (then (local.set $kind (i32.const 0)))
      (else
        (if (i32.or
              (i32.eq (local.get $factory_method_id) (global.get $METHOD_MAP_VALUES))
              (i32.eq (local.get $factory_method_id) (global.get $METHOD_SET_VALUES)))
          (then (local.set $kind (i32.const 1)))
          (else
            ;; ENTRIES_M for Map or Set
            (local.set $kind (i32.const 2))
          )
        )
      )
    )

    ;; Fresh capacity-4 object, exactly 4 writes (pre-checked above) —
    ;; grow unreachable, statuses droppable.
    (local.set $iter_pointer (call $allocate_object (i32.const 4)))
    ;; Slot 0: @coll
    (drop (call $object_set_property
      (local.get $iter_pointer)
      (call $read_builtin (global.get $BUILTIN_ITER_HIDDEN_COLL))
      (local.get $coll_type) (i32.const 0)
      (local.get $header_pointer) (i32.const 0)))
    ;; Slot 1: @index = 0 (inline-rational integer)
    (drop (call $object_set_property
      (local.get $iter_pointer)
      (call $read_builtin (global.get $BUILTIN_ITER_HIDDEN_INDEX))
      (global.get $TYPE_RATIONAL)
      (global.get $FLAG_RATIONAL_INLINE)
      (i32.const 0) (i32.const 0)))
    ;; Slot 2: @kind
    (drop (call $object_set_property
      (local.get $iter_pointer)
      (call $read_builtin (global.get $BUILTIN_ITER_HIDDEN_KIND))
      (global.get $TYPE_RATIONAL)
      (global.get $FLAG_RATIONAL_INLINE)
      (local.get $kind) (i32.const 0)))
    ;; Slot 3: next = BOUND_METHOD(this iter, next_method_id)
    (drop (call $object_set_property
      (local.get $iter_pointer)
      (call $read_builtin (global.get $BUILTIN_ITER_NEXT_KEY))
      (global.get $TYPE_BOUND_METHOD)
      (global.get $TYPE_OBJECT)
      (local.get $iter_pointer)
      (local.get $next_method_id)))

    ;; Symbol.iterator on the iterator itself returns `this` so the
    ;; iterator is iterable (matches JS — `for (x of arr.keys())` works
    ;; because arr.keys() is a self-iterable iterator).
    (call $object_set_sym_entry
      (local.get $iter_pointer)
      (call $read_state (global.get $STATE_WELL_KNOWN_ITERATOR_SYMBOL))
      (global.get $TYPE_BOUND_METHOD)
      (global.get $TYPE_OBJECT)
      (local.get $iter_pointer)
      (global.get $METHOD_ITERATOR_RETURN_SELF))

    (call $pending_push
      (global.get $TYPE_OBJECT) (i32.const 0)
      (local.get $iter_pointer) (i32.const 0))
  )

  ;; ==========================================================================
  ;; push_map_set_foreach_args(method_id, entries_pointer, slot_index,
  ;;                           receiver_pointer, param_count)
  ;;
  ;; Pushes callback arguments for one Map/Set forEach step, in LET_VAR
  ;; declaration order (value, key, collection), honoring param_count so
  ;; callbacks that declare fewer parameters don't get extra pending-stack
  ;; entries (see callback_staged_argc). For Map: key is the entry's own
  ;; key. For Set: per spec, key === value (Set has no separate keys).
  ;; ==========================================================================
  (func $push_map_set_foreach_args
    (param $method_id i32) (param $entries_pointer i32) (param $slot_index i32)
    (param $receiver_pointer i32) (param $param_count i32)
    (local $slot_pointer i32)
    (local $key_slot_pointer i32)
    (local $value_slot_pointer i32)

    (if (i32.eq (local.get $method_id) (global.get $METHOD_MAP_FOREACH))
      (then
        (local.set $slot_pointer
          (i32.add
            (i32.add (local.get $entries_pointer) (global.get $GC_HEADER_SIZE))
            (i32.mul (local.get $slot_index) (global.get $MAP_SLOT_STRIDE))))
        (local.set $key_slot_pointer
          (i32.add (local.get $slot_pointer) (global.get $MAP_SLOT_KEY_OFFSET)))
        (local.set $value_slot_pointer
          (i32.add (local.get $slot_pointer) (global.get $MAP_SLOT_VALUE_OFFSET)))

        ;; value (param 1)
        (if (i32.ge_u (local.get $param_count) (i32.const 1))
          (then
            (call $pending_push
              (i32.load (call $abs (local.get $value_slot_pointer)))
              (i32.load (call $abs (i32.add (local.get $value_slot_pointer) (i32.const 4))))
              (i32.load (call $abs (i32.add (local.get $value_slot_pointer) (i32.const 8))))
              (i32.load (call $abs (i32.add (local.get $value_slot_pointer) (i32.const 12)))))
          )
        )
        ;; key (param 2)
        (if (i32.ge_u (local.get $param_count) (i32.const 2))
          (then
            (call $pending_push
              (i32.load (call $abs (local.get $key_slot_pointer)))
              (i32.load (call $abs (i32.add (local.get $key_slot_pointer) (i32.const 4))))
              (i32.load (call $abs (i32.add (local.get $key_slot_pointer) (i32.const 8))))
              (i32.load (call $abs (i32.add (local.get $key_slot_pointer) (i32.const 12)))))
          )
        )
        ;; map (param 3)
        (if (i32.ge_u (local.get $param_count) (i32.const 3))
          (then
            (call $pending_push
              (global.get $TYPE_MAP) (i32.const 0) (local.get $receiver_pointer) (i32.const 0))
          )
        )
      )
      (else
        (local.set $slot_pointer
          (i32.add
            (i32.add (local.get $entries_pointer) (global.get $GC_HEADER_SIZE))
            (i32.mul (local.get $slot_index) (global.get $SET_SLOT_STRIDE))))
        (local.set $value_slot_pointer
          (i32.add (local.get $slot_pointer) (global.get $SET_SLOT_VALUE_OFFSET)))

        ;; value (param 1)
        (if (i32.ge_u (local.get $param_count) (i32.const 1))
          (then
            (call $pending_push
              (i32.load (call $abs (local.get $value_slot_pointer)))
              (i32.load (call $abs (i32.add (local.get $value_slot_pointer) (i32.const 4))))
              (i32.load (call $abs (i32.add (local.get $value_slot_pointer) (i32.const 8))))
              (i32.load (call $abs (i32.add (local.get $value_slot_pointer) (i32.const 12)))))
          )
        )
        ;; key === value for Set (param 2)
        (if (i32.ge_u (local.get $param_count) (i32.const 2))
          (then
            (call $pending_push
              (i32.load (call $abs (local.get $value_slot_pointer)))
              (i32.load (call $abs (i32.add (local.get $value_slot_pointer) (i32.const 4))))
              (i32.load (call $abs (i32.add (local.get $value_slot_pointer) (i32.const 8))))
              (i32.load (call $abs (i32.add (local.get $value_slot_pointer) (i32.const 12)))))
          )
        )
        ;; set (param 3)
        (if (i32.ge_u (local.get $param_count) (i32.const 3))
          (then
            (call $pending_push
              (global.get $TYPE_SET) (i32.const 0) (local.get $receiver_pointer) (i32.const 0))
          )
        )
      )
    )
  )

  ;; ==========================================================================
  ;; map_iterator_next(iter_pointer)
  ;;
  ;; Reads @coll / @index / @kind from the iterator object, advances
  ;; @index past tombstones until a live slot or end. On live slot:
  ;; pushes a fresh { value, done: false } result where `value` is the
  ;; key, the value, or a [k, v] array depending on @kind.
  ;; On end: pushes { value: undefined, done: true }.
  ;; ==========================================================================
  (func $map_iterator_next (param $iter_pointer i32)
    (local $iter_entries i32)
    (local $coll_pointer i32)
    (local $index i32)
    (local $kind i32)
    (local $coll_entries i32)
    (local $slot_count i32)
    (local $slot_pointer i32)
    (local $key_slot_pointer i32)
    (local $value_slot_pointer i32)
    (local $result_pointer i32)
    (local $pair_pointer i32)
    (local $pair_data_pointer i32)
    (local $elem_pointer i32)

    ;; Pre-check worst-case heap budget: result object (cap 2) plus,
    ;; on the entries branch, a pair array (cap 2). Always reserve both
    ;; even on key/value branches — the over-reservation costs a few
    ;; false-positive pressure signals near the boundary; GC + retry
    ;; succeeds trivially in that case.
    (if (call $check_heap_overflow
          (i32.add
            (call $estimate_object_size (i32.const 2))
            (call $estimate_array_size (i32.const 2))))
      (then (return)))

    ;; Read iterator's entries block (object header +24 = entries header).
    (local.set $iter_entries
      (i32.load (call $abs (i32.add (local.get $iter_pointer) (i32.const 24)))))
    ;; Slot 0 (@coll): data_lo at +20 within first entry.
    (local.set $coll_pointer
      (i32.load (call $abs (i32.add (local.get $iter_entries) (i32.const 20)))))
    ;; Slot 1 (@index): data_lo at +40 (= entry 1 base + 12).
    (local.set $index
      (i32.load (call $abs (i32.add (local.get $iter_entries) (i32.const 40)))))
    ;; Slot 2 (@kind): data_lo at +60 (entry 2 base + 12).
    (local.set $kind
      (i32.load (call $abs (i32.add (local.get $iter_entries) (i32.const 60)))))

    (local.set $coll_entries
      (i32.load (call $abs (i32.add (local.get $coll_pointer) (i32.const 20)))))
    (local.set $slot_count
      (i32.load (call $abs (i32.add (local.get $coll_pointer) (i32.const 12)))))

    ;; Advance past tombstones.
    (block $found_live
      (loop $scan
        (if (i32.ge_u (local.get $index) (local.get $slot_count))
          (then
            ;; End of iteration.
            (local.set $result_pointer (call $allocate_object (i32.const 2)))
            (drop (call $object_set_property
              (local.get $result_pointer)
              (call $read_builtin (global.get $BUILTIN_ITER_VALUE_KEY))
              (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0)))
            (drop (call $object_set_property
              (local.get $result_pointer)
              (call $read_builtin (global.get $BUILTIN_ITER_DONE_KEY))
              (global.get $TYPE_BOOLEAN) (i32.const 0) (i32.const 1) (i32.const 0)))
            (call $pending_push
              (global.get $TYPE_OBJECT) (i32.const 0)
              (local.get $result_pointer) (i32.const 0))
            (return)
          )
        )
        (local.set $slot_pointer
          (i32.add
            (i32.add (local.get $coll_entries) (global.get $GC_HEADER_SIZE))
            (i32.mul (local.get $index) (global.get $MAP_SLOT_STRIDE))))
        (if (i32.eqz (i32.load (call $abs (local.get $slot_pointer))))
          (then (br $found_live))
        )
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $scan)
      )
    )

    ;; Live slot at $index. Compute key and value slot pointers.
    (local.set $key_slot_pointer
      (i32.add (local.get $slot_pointer) (global.get $MAP_SLOT_KEY_OFFSET)))
    (local.set $value_slot_pointer
      (i32.add (local.get $slot_pointer) (global.get $MAP_SLOT_VALUE_OFFSET)))

    ;; Build the result object: { value: <key|value|pair>, done: false }
    (local.set $result_pointer (call $allocate_object (i32.const 2)))

    (if (i32.eq (local.get $kind) (i32.const 0))
      (then
        ;; keys → value is the key
        (drop (call $object_set_property
          (local.get $result_pointer)
          (call $read_builtin (global.get $BUILTIN_ITER_VALUE_KEY))
          (i32.load (call $abs (local.get $key_slot_pointer)))
          (i32.load (call $abs (i32.add (local.get $key_slot_pointer) (i32.const 4))))
          (i32.load (call $abs (i32.add (local.get $key_slot_pointer) (i32.const 8))))
          (i32.load (call $abs (i32.add (local.get $key_slot_pointer) (i32.const 12))))))
      )
      (else
        (if (i32.eq (local.get $kind) (i32.const 1))
          (then
            ;; values → value is the value
            (drop (call $object_set_property
              (local.get $result_pointer)
              (call $read_builtin (global.get $BUILTIN_ITER_VALUE_KEY))
              (i32.load (call $abs (local.get $value_slot_pointer)))
              (i32.load (call $abs (i32.add (local.get $value_slot_pointer) (i32.const 4))))
              (i32.load (call $abs (i32.add (local.get $value_slot_pointer) (i32.const 8))))
              (i32.load (call $abs (i32.add (local.get $value_slot_pointer) (i32.const 12))))))
          )
          (else
            ;; entries → value is [k, v] (a fresh array)
            (local.set $pair_pointer (call $allocate_array (i32.const 2)))
            (local.set $pair_data_pointer
              (i32.load (call $abs (i32.add (local.get $pair_pointer) (i32.const 16)))))
            ;; [0] = key
            (local.set $elem_pointer
              (i32.add (local.get $pair_data_pointer) (global.get $GC_HEADER_SIZE)))
            (call $write_value (local.get $elem_pointer)
              (i32.load (call $abs (local.get $key_slot_pointer)))
              (i32.load (call $abs (i32.add (local.get $key_slot_pointer) (i32.const 4))))
              (i32.load (call $abs (i32.add (local.get $key_slot_pointer) (i32.const 8))))
              (i32.load (call $abs (i32.add (local.get $key_slot_pointer) (i32.const 12)))))
            ;; [1] = value
            (local.set $elem_pointer
              (i32.add (local.get $elem_pointer) (global.get $VALUE_SIZE)))
            (call $write_value (local.get $elem_pointer)
              (i32.load (call $abs (local.get $value_slot_pointer)))
              (i32.load (call $abs (i32.add (local.get $value_slot_pointer) (i32.const 4))))
              (i32.load (call $abs (i32.add (local.get $value_slot_pointer) (i32.const 8))))
              (i32.load (call $abs (i32.add (local.get $value_slot_pointer) (i32.const 12)))))
            ;; Set array length = 2.
            (i32.store (call $abs (i32.add (local.get $pair_pointer) (i32.const 8))) (i32.const 2))
            (drop (call $object_set_property
              (local.get $result_pointer)
              (call $read_builtin (global.get $BUILTIN_ITER_VALUE_KEY))
              (global.get $TYPE_ARRAY) (i32.const 0)
              (local.get $pair_pointer) (i32.const 0)))
          )
        )
      )
    )

    (drop (call $object_set_property
      (local.get $result_pointer)
      (call $read_builtin (global.get $BUILTIN_ITER_DONE_KEY))
      (global.get $TYPE_BOOLEAN) (i32.const 0) (i32.const 0) (i32.const 0)))

    ;; Advance @index in the iterator object.
    (i32.store (call $abs (i32.add (local.get $iter_entries) (i32.const 40)))
      (i32.add (local.get $index) (i32.const 1)))

    (call $pending_push
      (global.get $TYPE_OBJECT) (i32.const 0)
      (local.get $result_pointer) (i32.const 0))
  )

  ;; ==========================================================================
  ;; set_iterator_next(iter_pointer) — same shape as map_iterator_next but
  ;; reads from a Set's entries block (20-byte slots). For @kind=1 yields
  ;; the value; for @kind=2 yields a [value, value] pair (spec quirk).
  ;; ==========================================================================
  (func $set_iterator_next (param $iter_pointer i32)
    (local $iter_entries i32)
    (local $coll_pointer i32)
    (local $index i32)
    (local $kind i32)
    (local $coll_entries i32)
    (local $slot_count i32)
    (local $slot_pointer i32)
    (local $value_slot_pointer i32)
    (local $result_pointer i32)
    (local $pair_pointer i32)
    (local $pair_data_pointer i32)
    (local $elem_pointer i32)

    ;; Pre-check worst-case: result object (cap 2) plus, on @kind=entries,
    ;; a pair array (cap 2). Reserve both unconditionally.
    (if (call $check_heap_overflow
          (i32.add
            (call $estimate_object_size (i32.const 2))
            (call $estimate_array_size (i32.const 2))))
      (then (return)))

    (local.set $iter_entries
      (i32.load (call $abs (i32.add (local.get $iter_pointer) (i32.const 24)))))
    (local.set $coll_pointer
      (i32.load (call $abs (i32.add (local.get $iter_entries) (i32.const 20)))))
    (local.set $index
      (i32.load (call $abs (i32.add (local.get $iter_entries) (i32.const 40)))))
    (local.set $kind
      (i32.load (call $abs (i32.add (local.get $iter_entries) (i32.const 60)))))

    (local.set $coll_entries
      (i32.load (call $abs (i32.add (local.get $coll_pointer) (i32.const 20)))))
    (local.set $slot_count
      (i32.load (call $abs (i32.add (local.get $coll_pointer) (i32.const 12)))))

    (block $found_live
      (loop $scan
        (if (i32.ge_u (local.get $index) (local.get $slot_count))
          (then
            (local.set $result_pointer (call $allocate_object (i32.const 2)))
            (drop (call $object_set_property
              (local.get $result_pointer)
              (call $read_builtin (global.get $BUILTIN_ITER_VALUE_KEY))
              (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0)))
            (drop (call $object_set_property
              (local.get $result_pointer)
              (call $read_builtin (global.get $BUILTIN_ITER_DONE_KEY))
              (global.get $TYPE_BOOLEAN) (i32.const 0) (i32.const 1) (i32.const 0)))
            (call $pending_push
              (global.get $TYPE_OBJECT) (i32.const 0)
              (local.get $result_pointer) (i32.const 0))
            (return)
          )
        )
        (local.set $slot_pointer
          (i32.add
            (i32.add (local.get $coll_entries) (global.get $GC_HEADER_SIZE))
            (i32.mul (local.get $index) (global.get $SET_SLOT_STRIDE))))
        (if (i32.eqz (i32.load (call $abs (local.get $slot_pointer))))
          (then (br $found_live))
        )
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $scan)
      )
    )

    (local.set $value_slot_pointer
      (i32.add (local.get $slot_pointer) (global.get $SET_SLOT_VALUE_OFFSET)))

    (local.set $result_pointer (call $allocate_object (i32.const 2)))

    (if (i32.eq (local.get $kind) (i32.const 2))
      (then
        ;; entries → [value, value]
        (local.set $pair_pointer (call $allocate_array (i32.const 2)))
        (local.set $pair_data_pointer
          (i32.load (call $abs (i32.add (local.get $pair_pointer) (i32.const 16)))))
        (local.set $elem_pointer
          (i32.add (local.get $pair_data_pointer) (global.get $GC_HEADER_SIZE)))
        (call $write_value (local.get $elem_pointer)
          (i32.load (call $abs (local.get $value_slot_pointer)))
          (i32.load (call $abs (i32.add (local.get $value_slot_pointer) (i32.const 4))))
          (i32.load (call $abs (i32.add (local.get $value_slot_pointer) (i32.const 8))))
          (i32.load (call $abs (i32.add (local.get $value_slot_pointer) (i32.const 12)))))
        (local.set $elem_pointer
          (i32.add (local.get $elem_pointer) (global.get $VALUE_SIZE)))
        (call $write_value (local.get $elem_pointer)
          (i32.load (call $abs (local.get $value_slot_pointer)))
          (i32.load (call $abs (i32.add (local.get $value_slot_pointer) (i32.const 4))))
          (i32.load (call $abs (i32.add (local.get $value_slot_pointer) (i32.const 8))))
          (i32.load (call $abs (i32.add (local.get $value_slot_pointer) (i32.const 12)))))
        (i32.store (call $abs (i32.add (local.get $pair_pointer) (i32.const 8))) (i32.const 2))
        (drop (call $object_set_property
          (local.get $result_pointer)
          (call $read_builtin (global.get $BUILTIN_ITER_VALUE_KEY))
          (global.get $TYPE_ARRAY) (i32.const 0)
          (local.get $pair_pointer) (i32.const 0)))
      )
      (else
        ;; keys / values → just the value
        (drop (call $object_set_property
          (local.get $result_pointer)
          (call $read_builtin (global.get $BUILTIN_ITER_VALUE_KEY))
          (i32.load (call $abs (local.get $value_slot_pointer)))
          (i32.load (call $abs (i32.add (local.get $value_slot_pointer) (i32.const 4))))
          (i32.load (call $abs (i32.add (local.get $value_slot_pointer) (i32.const 8))))
          (i32.load (call $abs (i32.add (local.get $value_slot_pointer) (i32.const 12))))))
      )
    )

    (drop (call $object_set_property
      (local.get $result_pointer)
      (call $read_builtin (global.get $BUILTIN_ITER_DONE_KEY))
      (global.get $TYPE_BOOLEAN) (i32.const 0) (i32.const 0) (i32.const 0)))

    (i32.store (call $abs (i32.add (local.get $iter_entries) (i32.const 40)))
      (i32.add (local.get $index) (i32.const 1)))

    (call $pending_push
      (global.get $TYPE_OBJECT) (i32.const 0)
      (local.get $result_pointer) (i32.const 0))
  )

  ;; ==========================================================================
  ;; set_iterate_into_result(src_header, result_header, other_header_or_zero, mode)
  ;;
  ;; Walks src's entries block; for each live slot:
  ;;   mode=0 (union):        add to result.
  ;;   mode=1 (intersection): add to result iff other.has(v).
  ;;   mode=2 (difference):   add to result iff !other.has(v).
  ;;
  ;; other_header_or_zero is the second Set's header pointer, or 0 if
  ;; the mode doesn't need it (mode 0).
  ;; ==========================================================================
  (func $set_iterate_into_result
    (param $src_header i32) (param $result_header i32)
    (param $other_header i32) (param $mode i32)
    (local $entries_pointer i32)
    (local $slot_count i32)
    (local $i i32)
    (local $slot_pointer i32)
    (local $value_slot_pointer i32)
    (local $other_has i32)

    (local.set $entries_pointer
      (i32.load (call $abs (i32.add (local.get $src_header) (i32.const 20)))))
    (local.set $slot_count
      (i32.load (call $abs (i32.add (local.get $src_header) (i32.const 12)))))

    (local.set $i (i32.const 0))
    (block $done
      (loop $scan
        (br_if $done (i32.ge_u (local.get $i) (local.get $slot_count)))
        (local.set $slot_pointer
          (i32.add
            (i32.add (local.get $entries_pointer) (global.get $GC_HEADER_SIZE))
            (i32.mul (local.get $i) (global.get $SET_SLOT_STRIDE))))
        (if (i32.eqz (i32.load (call $abs (local.get $slot_pointer))))
          (then
            (local.set $value_slot_pointer
              (i32.add (local.get $slot_pointer) (global.get $SET_SLOT_VALUE_OFFSET)))
            (if (i32.eq (local.get $mode) (i32.const 0))
              (then
                ;; union: unconditional add.
                (call $set_add (local.get $result_header) (local.get $value_slot_pointer))
              )
              (else
                (local.set $other_has
                  (i32.ne
                    (call $set_find_slot (local.get $other_header) (local.get $value_slot_pointer))
                    (i32.const -1)))
                (if (i32.eq (local.get $mode) (i32.const 1))
                  (then
                    ;; intersection: add iff other has.
                    (if (local.get $other_has)
                      (then (call $set_add (local.get $result_header) (local.get $value_slot_pointer)))
                    )
                  )
                  (else
                    ;; difference: add iff other doesn't have.
                    (if (i32.eqz (local.get $other_has))
                      (then (call $set_add (local.get $result_header) (local.get $value_slot_pointer)))
                    )
                  )
                )
              )
            )
          )
        )
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $scan)
      )
    )
  )

  ;; ==========================================================================
  ;; set_all_satisfy(src_header, other_header, mode) -> i32 (boolean)
  ;;
  ;; mode=0 (isSubsetOf):     every v in src is in other.
  ;; mode=1 (isDisjointFrom): no v in src is in other.
  ;; ==========================================================================
  (func $set_all_satisfy
    (param $src_header i32) (param $other_header i32) (param $mode i32)
    (result i32)
    (local $entries_pointer i32)
    (local $slot_count i32)
    (local $i i32)
    (local $slot_pointer i32)
    (local $value_slot_pointer i32)
    (local $other_has i32)

    (local.set $entries_pointer
      (i32.load (call $abs (i32.add (local.get $src_header) (i32.const 20)))))
    (local.set $slot_count
      (i32.load (call $abs (i32.add (local.get $src_header) (i32.const 12)))))

    (local.set $i (i32.const 0))
    (block $done
      (loop $scan
        (br_if $done (i32.ge_u (local.get $i) (local.get $slot_count)))
        (local.set $slot_pointer
          (i32.add
            (i32.add (local.get $entries_pointer) (global.get $GC_HEADER_SIZE))
            (i32.mul (local.get $i) (global.get $SET_SLOT_STRIDE))))
        (if (i32.eqz (i32.load (call $abs (local.get $slot_pointer))))
          (then
            (local.set $value_slot_pointer
              (i32.add (local.get $slot_pointer) (global.get $SET_SLOT_VALUE_OFFSET)))
            (local.set $other_has
              (i32.ne
                (call $set_find_slot (local.get $other_header) (local.get $value_slot_pointer))
                (i32.const -1)))
            (if (i32.eq (local.get $mode) (i32.const 0))
              (then
                ;; isSubsetOf: a missing v fails.
                (if (i32.eqz (local.get $other_has)) (then (return (i32.const 0))))
              )
              (else
                ;; isDisjointFrom: a present v fails.
                (if (local.get $other_has) (then (return (i32.const 0))))
              )
            )
          )
        )
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $scan)
      )
    )
    (i32.const 1)
  )

  (func $set_delete (param $header_pointer i32) (param $value_pointer i32) (result i32)
    (local $slot_index i32)
    (local $entries_pointer i32)
    (local $slot_pointer i32)
    (local $size i32)

    (local.set $slot_index (call $set_find_slot (local.get $header_pointer) (local.get $value_pointer)))
    (if (i32.eq (local.get $slot_index) (i32.const -1))
      (then (return (i32.const 0)))
    )
    (local.set $entries_pointer
      (i32.load (call $abs (i32.add (local.get $header_pointer) (i32.const 20)))))
    (local.set $slot_pointer
      (i32.add
        (i32.add (local.get $entries_pointer) (global.get $GC_HEADER_SIZE))
        (i32.mul (local.get $slot_index) (global.get $SET_SLOT_STRIDE))))
    (i32.store (call $abs (local.get $slot_pointer)) (i32.const 1))  ;; tombstone
    (local.set $size
      (i32.load (call $abs (i32.add (local.get $header_pointer) (i32.const 8)))))
    (i32.store (call $abs (i32.add (local.get $header_pointer) (i32.const 8)))
      (i32.sub (local.get $size) (i32.const 1)))
    (i32.const 1)
  )

  ;; ==========================================================================
  ;; End of Rational helpers.
  ;; ==========================================================================

  ;; ==========================================================================
  ;; Complex arithmetic — Phase 1b of the exact-numbers extension.
  ;; Layout: [GC header: 8][realPointer: 4][imaginaryPointer: 4]
  ;; Both pointers point at Rational heap objects. No collapse: a Complex
  ;; with zero imaginary part is a first-class value, distinct from any
  ;; Rational. Arithmetic is closed on Complex (Complex × Complex → Complex).
  ;; ==========================================================================

  ;; Read the realPointer field of a Complex heap object.
  (func $complex_real (param $header i32) (result i32)
    (i32.load (call $abs (i32.add (local.get $header) (global.get $GC_HEADER_SIZE))))
  )

  ;; Read the imaginaryPointer field of a Complex heap object.
  (func $complex_imaginary (param $header i32) (result i32)
    (i32.load (call $abs (i32.add
      (i32.add (local.get $header) (global.get $GC_HEADER_SIZE))
      (i32.const 4))))
  )

  ;; estimate_complex_size() → bytes
  ;; Worst-case heap consumption of $complex_allocate: 16 bytes
  ;; (GC header 8 + realPointer 4 + imaginaryPointer 4, already 16-aligned).
  ;; NOTE: this is just the Complex wrapper; the real/imaginary Rationals
  ;; (and their numerator/denominator BigInts) are counted separately.
  (func $estimate_complex_size (result i32)
    (i32.const 16)
  )

  ;; Allocate a Complex heap object with the given real/imaginary Rational
  ;; pointers. Caller is responsible for passing normalized Rationals (the
  ;; Rational constructors handle normalization).
  (func $complex_allocate (param $realPointer i32) (param $imaginaryPointer i32) (result i32)
    (local $heap_pointer i32)
    (local $header i32)
    (local $total_size i32)
    (local $aligned i32)

    (local.set $heap_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))
    (local.set $header (local.get $heap_pointer))
    ;; Size: 8 GC header + 8 payload = 16 bytes
    (local.set $total_size (i32.const 16))
    (local.set $aligned (i32.and
      (i32.add (local.get $total_size) (i32.const 15))
      (i32.const -16)))

    ;; GC header
    (i32.store (call $abs (local.get $header))
      (i32.or (local.get $aligned) (i32.shl (global.get $OBJ_COMPLEX) (i32.const 24))))
    (i32.store (call $abs (i32.add (local.get $header) (i32.const 4))) (i32.const 0))

    ;; Write real and imaginary pointers
    (i32.store (call $abs (i32.add (local.get $header) (global.get $GC_HEADER_SIZE)))
      (local.get $realPointer))
    (i32.store (call $abs (i32.add
      (i32.add (local.get $header) (global.get $GC_HEADER_SIZE))
      (i32.const 4)))
      (local.get $imaginaryPointer))

    (call $write_state (global.get $STATE_HEAP_POINTER)
      (i32.add (local.get $header) (local.get $aligned)))

    (local.get $header)
  )

  ;; Construct a Complex from two Rational pointers. Alias for
  ;; $complex_allocate; kept separate for readability at call sites.
  (func $complex_new (param $realPointer i32) (param $imaginaryPointer i32) (result i32)
    (call $complex_allocate (local.get $realPointer) (local.get $imaginaryPointer))
  )

  ;; Promote a Rational to Complex (imaginary = 0/1).
  (func $complex_from_rational (param $rationalHeader i32) (result i32)
    (call $complex_allocate
      (local.get $rationalHeader)
      (call $rational_allocate (call $bigint_zero) (call $bigint_one))))

  ;; Add: (a + bi) + (c + di) = (a+c) + (b+d)i
  (func $complex_add (param $left i32) (param $right i32) (result i32)
    (call $complex_allocate
      (call $rational_add
        (call $complex_real (local.get $left))
        (call $complex_real (local.get $right)))
      (call $rational_add
        (call $complex_imaginary (local.get $left))
        (call $complex_imaginary (local.get $right))))
  )

  ;; Subtract: (a + bi) - (c + di) = (a-c) + (b-d)i
  (func $complex_sub (param $left i32) (param $right i32) (result i32)
    (call $complex_allocate
      (call $rational_sub
        (call $complex_real (local.get $left))
        (call $complex_real (local.get $right)))
      (call $rational_sub
        (call $complex_imaginary (local.get $left))
        (call $complex_imaginary (local.get $right))))
  )

  ;; Multiply: (a + bi)(c + di) = (ac - bd) + (ad + bc)i
  (func $complex_mul (param $left i32) (param $right i32) (result i32)
    (local $leftReal i32)
    (local $leftImaginary i32)
    (local $rightReal i32)
    (local $rightImaginary i32)
    (local.set $leftReal (call $complex_real (local.get $left)))
    (local.set $leftImaginary (call $complex_imaginary (local.get $left)))
    (local.set $rightReal (call $complex_real (local.get $right)))
    (local.set $rightImaginary (call $complex_imaginary (local.get $right)))
    (call $complex_allocate
      ;; real part: ac - bd
      (call $rational_sub
        (call $rational_mul (local.get $leftReal) (local.get $rightReal))
        (call $rational_mul (local.get $leftImaginary) (local.get $rightImaginary)))
      ;; imaginary part: ad + bc
      (call $rational_add
        (call $rational_mul (local.get $leftReal) (local.get $rightImaginary))
        (call $rational_mul (local.get $leftImaginary) (local.get $rightReal))))
  )

  ;; Divide: (a + bi) / (c + di). Multiply numerator and denominator by
  ;; conjugate (c - di):
  ;;   result = ((a + bi)(c - di)) / (c² + d²)
  ;;          = ((ac + bd) + (bc - ad)i) / (c² + d²)
  ;; Caller must ensure the right operand is non-zero (real² + imaginary² > 0).
  (func $complex_div (param $left i32) (param $right i32) (result i32)
    (local $leftReal i32)
    (local $leftImaginary i32)
    (local $rightReal i32)
    (local $rightImaginary i32)
    (local $denominator i32)
    (local.set $leftReal (call $complex_real (local.get $left)))
    (local.set $leftImaginary (call $complex_imaginary (local.get $left)))
    (local.set $rightReal (call $complex_real (local.get $right)))
    (local.set $rightImaginary (call $complex_imaginary (local.get $right)))
    ;; denominator = c² + d²
    (local.set $denominator
      (call $rational_add
        (call $rational_mul (local.get $rightReal) (local.get $rightReal))
        (call $rational_mul (local.get $rightImaginary) (local.get $rightImaginary))))
    (call $complex_allocate
      ;; real: (ac + bd) / denominator
      (call $rational_div
        (call $rational_add
          (call $rational_mul (local.get $leftReal) (local.get $rightReal))
          (call $rational_mul (local.get $leftImaginary) (local.get $rightImaginary)))
        (local.get $denominator))
      ;; imaginary: (bc - ad) / denominator
      (call $rational_div
        (call $rational_sub
          (call $rational_mul (local.get $leftImaginary) (local.get $rightReal))
          (call $rational_mul (local.get $leftReal) (local.get $rightImaginary)))
        (local.get $denominator)))
  )

  ;; Negate: -(a + bi) = -a + (-b)i
  (func $complex_negate (param $z i32) (result i32)
    (call $complex_allocate
      (call $rational_negate (call $complex_real (local.get $z)))
      (call $rational_negate (call $complex_imaginary (local.get $z))))
  )

  ;; Structural equality: real parts equal AND imaginary parts equal.
  (func $complex_eq (param $left i32) (param $right i32) (result i32)
    (if (i32.eqz (call $rational_eq
          (call $complex_real (local.get $left))
          (call $complex_real (local.get $right))))
      (then (return (i32.const 0))))
    (call $rational_eq
      (call $complex_imaginary (local.get $left))
      (call $complex_imaginary (local.get $right)))
  )

  ;; Test if a Complex is the zero value (both components are zero).
  ;; Used for division-by-zero checks.
  (func $complex_is_zero (param $z i32) (result i32)
    (local $real i32)
    (local $imaginary i32)
    (local.set $real (call $complex_real (local.get $z)))
    (local.set $imaginary (call $complex_imaginary (local.get $z)))
    ;; Zero if numerator of real AND numerator of imaginary are both zero.
    (i32.and
      (i32.eqz (call $bigint_length (call $rational_numerator (local.get $real))))
      (i32.eqz (call $bigint_length (call $rational_numerator (local.get $imaginary)))))
  )

  ;; Test if a Complex has a zero imaginary part (real-valued Complex).
  (func $complex_is_real (param $z i32) (result i32)
    (i32.eqz (call $bigint_length (call $rational_numerator (call $complex_imaginary (local.get $z)))))
  )

  ;; Complex ** BigInt (non-negative integer exponent) via repeated squaring.
  ;; Returns 0 on negative exponent (caller throws).
  (func $complex_pow (param $base i32) (param $exponentBigint i32) (result i32)
    (local $result i32)
    (local $currentBase i32)
    (local $exp_len i32)
    (local $i i32)
    (local $limb i32)
    (local $bit i32)
    (local $one i32)
    (local $zero i32)

    (if (i32.ne (call $bigint_sign (local.get $exponentBigint)) (i32.const 0))
      (then (return (i32.const 0))))

    (local.set $exp_len (call $bigint_length (local.get $exponentBigint)))

    ;; exp == 0 → Complex(1, 0)
    (local.set $one (call $rational_allocate (call $bigint_one) (call $bigint_one)))
    (local.set $zero (call $rational_allocate (call $bigint_zero) (call $bigint_one)))
    (if (i32.eqz (local.get $exp_len))
      (then (return (call $complex_allocate (local.get $one) (local.get $zero)))))

    ;; result = 1 + 0i, currentBase = base
    (local.set $result (call $complex_allocate (local.get $one) (local.get $zero)))
    (local.set $currentBase (local.get $base))

    ;; Find total significant bits of exponent
    (local.set $limb (call $bigint_limb (local.get $exponentBigint)
      (i32.sub (local.get $exp_len) (i32.const 1))))
    (local.set $bit (i32.const 0))
    (block $count_done
      (loop $count_bits
        (br_if $count_done (i32.eqz (local.get $limb)))
        (local.set $limb (i32.shr_u (local.get $limb) (i32.const 1)))
        (local.set $bit (i32.add (local.get $bit) (i32.const 1)))
        (br $count_bits)
      )
    )
    (local.set $bit (i32.add
      (i32.mul (i32.sub (local.get $exp_len) (i32.const 1)) (i32.const 32))
      (local.get $bit)))

    ;; For each bit of exponent (low to high)
    (local.set $i (i32.const 0))
    (block $exp_done
      (loop $exp_loop
        (br_if $exp_done (i32.ge_u (local.get $i) (local.get $bit)))
        (local.set $limb (call $bigint_limb (local.get $exponentBigint)
          (i32.div_u (local.get $i) (i32.const 32))))
        (if (i32.ne
              (i32.and
                (i32.shr_u (local.get $limb) (i32.rem_u (local.get $i) (i32.const 32)))
                (i32.const 1))
              (i32.const 0))
          (then
            (local.set $result (call $complex_mul (local.get $result) (local.get $currentBase)))
          )
        )
        (local.set $currentBase (call $complex_mul (local.get $currentBase) (local.get $currentBase)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $exp_loop)
      )
    )

    (local.get $result)
  )

  ;; Push a Complex value to the pending stack.
  (func $push_complex (param $header i32)
    (call $pending_push (global.get $TYPE_COMPLEX) (i32.const 0) (local.get $header) (i32.const 0))
  )

  ;; ==========================================================================
  ;; End of Complex helpers.
  ;; ==========================================================================

  ;; ==========================================================================
  ;; Symbol helpers — Ring 2 (2a.2)
  ;; ==========================================================================

  ;; estimate_symbol_size() → bytes
  ;; Worst-case heap consumption of $symbol_allocate: 16 bytes
  ;; (GC header 8 + descriptionStringOffset 4 + reserved 4).
  (func $estimate_symbol_size (result i32)
    (i32.const 16)
  )

  ;; Allocate a fresh Symbol heap object with the given description string
  ;; offset (0 for an undescribed symbol). Returns the header pointer.
  ;; Layout: [gc_header: 8][descriptionStringOffset: 4][reserved: 4] = 16 bytes.
  (func $symbol_allocate (param $description_string_offset i32) (result i32)
    (local $heap_pointer i32)
    (local $header i32)
    (local $total_size i32)
    (local $aligned i32)

    (local.set $heap_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))
    (local.set $header (local.get $heap_pointer))
    (local.set $total_size (i32.const 16))
    (local.set $aligned (i32.and
      (i32.add (local.get $total_size) (i32.const 15))
      (i32.const -16)))

    ;; GC header: low 24 bits = aligned size, upper byte = OBJ_SYMBOL
    (i32.store (call $abs (local.get $header))
      (i32.or (local.get $aligned) (i32.shl (global.get $OBJ_SYMBOL) (i32.const 24))))
    (i32.store (call $abs (i32.add (local.get $header) (i32.const 4))) (i32.const 0))

    ;; descriptionStringOffset (0 means undescribed)
    (i32.store (call $abs (i32.add (local.get $header) (global.get $GC_HEADER_SIZE)))
      (local.get $description_string_offset))
    ;; reserved (zero in 2a)
    (i32.store (call $abs (i32.add
      (i32.add (local.get $header) (global.get $GC_HEADER_SIZE))
      (i32.const 4)))
      (i32.const 0))

    (call $write_state (global.get $STATE_HEAP_POINTER)
      (i32.add (local.get $header) (local.get $aligned)))

    (local.get $header)
  )

  ;; Read a Symbol's description string offset.
  (func $symbol_description (param $header i32) (result i32)
    (i32.load (call $abs (i32.add (local.get $header) (global.get $GC_HEADER_SIZE))))
  )

  ;; Push a Symbol value onto the pending stack.
  (func $push_symbol (param $header i32)
    (call $pending_push (global.get $TYPE_SYMBOL) (i32.const 0) (local.get $header) (i32.const 0))
  )

  ;; ==========================================================================
  ;; Expression helpers — Ring 2 (2b.2 allocator + 2b.3 construction)
  ;; ==========================================================================

  ;; estimate_expression_size() → bytes
  ;; Worst-case heap consumption of $expression_allocate: 16 bytes
  ;; (GC header 8 + headPointer 4 + argumentArrayPointer 4).
  ;; NOTE: the argument array (Expression's args) is allocated separately
  ;; via $allocate_array (or $expression_alloc_args1/args2) — count those
  ;; with $estimate_array_size.
  (func $estimate_expression_size (result i32)
    (i32.const 16)
  )

  ;; ==========================================================================
  ;; expression_walk_guard(carve_bytes) → i32
  ;;
  ;; Per-node admission check for the Expression tree walks (simplify /
  ;; substitute / canonicalize / desugar). The walks run arbitrarily many
  ;; carves inside ONE instruction, so the dispatcher's per-instruction
  ;; heap-slack safepoint cannot bound them; instead every walk step
  ;; re-asserts the same scaled slack floor (min(HEAP_SLACK_HEADROOM,
  ;; heap_span/16)) on top of its own parametrized carve total, and
  ;; aborts the whole walk on failure — status 1 threads up to the
  ;; method wrapper, which returns with the pressure flag set so the
  ;; dispatcher restores the pending stack and yields
  ;; EXIT_MEMORY_PRESSURE for a gc-and-retry. The floor absorbs the
  ;; small fixed carves between guard points (expression nodes, rational
  ;; wrappers, fold outputs of small coefficients); anything
  ;; size-parametrized — args arrays, scratch blobs, folds of large
  ;; coefficients — must be included in $carve_bytes by the caller.
  ;; Guards expression-operation allocation against the same heap/code
  ;; collision boundary as other instruction-local carves.
  ;; ==========================================================================
  (func $expression_walk_guard (param $carve_bytes i32) (result i32)
    (local $floor i32)
    (local.set $floor
      (i32.shr_u
        (i32.sub
          (call $read_state (global.get $STATE_HEAP_END))
          (call $read_state (global.get $STATE_HEAP_START)))
        (i32.const 4)))
    (if (i32.gt_u (local.get $floor) (global.get $HEAP_SLACK_HEADROOM))
      (then (local.set $floor (global.get $HEAP_SLACK_HEADROOM))))
    (call $check_heap_overflow (i32.add (local.get $carve_bytes) (local.get $floor)))
  )

  ;; Carve an inert working buffer INTO the committed heap (advances
  ;; STATE_HEAP_POINTER) with a real OBJ_SCRATCH header, so the
  ;; collectors' linear header walks parse over it; unmarked, it is
  ;; reclaimed as garbage at the next collection. Caller must have
  ;; guarded the carve (expression_walk_guard). Returns the payload
  ;; pointer (header + GC_HEADER_SIZE).
  (func $carve_scratch_blob (param $payload_bytes i32) (result i32)
    (local $header i32)
    (local $aligned i32)
    (local.set $header (call $read_state (global.get $STATE_HEAP_POINTER)))
    (local.set $aligned (i32.and
      (i32.add
        (i32.add (global.get $GC_HEADER_SIZE) (local.get $payload_bytes))
        (i32.const 15))
      (i32.const -16)))
    (i32.store (call $abs (local.get $header))
      (i32.or (local.get $aligned) (i32.shl (global.get $OBJ_SCRATCH) (i32.const 24))))
    (i32.store (call $abs (i32.add (local.get $header) (i32.const 4))) (i32.const 0))
    (call $write_state (global.get $STATE_HEAP_POINTER)
      (i32.add (local.get $header) (local.get $aligned)))
    (i32.add (local.get $header) (global.get $GC_HEADER_SIZE))
  )

  ;; Allocate an Expression heap object. Layout:
  ;;   [gc_header: 8][headPointer: 4][argumentArrayPointer: 4] = 16 bytes.
  (func $expression_allocate (param $head_pointer i32) (param $args_pointer i32) (result i32)
    (local $heap_pointer i32)
    (local $header i32)
    (local $total_size i32)
    (local $aligned i32)

    (local.set $heap_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))
    (local.set $header (local.get $heap_pointer))
    (local.set $total_size (i32.const 16))
    (local.set $aligned (i32.and
      (i32.add (local.get $total_size) (i32.const 15))
      (i32.const -16)))

    (i32.store (call $abs (local.get $header))
      (i32.or (local.get $aligned) (i32.shl (global.get $OBJ_EXPRESSION) (i32.const 24))))
    (i32.store (call $abs (i32.add (local.get $header) (i32.const 4))) (i32.const 0))

    ;; headPointer, argumentArrayPointer
    (i32.store (call $abs (i32.add (local.get $header) (global.get $GC_HEADER_SIZE)))
      (local.get $head_pointer))
    (i32.store (call $abs (i32.add
      (i32.add (local.get $header) (global.get $GC_HEADER_SIZE))
      (i32.const 4)))
      (local.get $args_pointer))

    (call $write_state (global.get $STATE_HEAP_POINTER)
      (i32.add (local.get $header) (local.get $aligned)))

    (local.get $header)
  )

  ;; Read an Expression's head pointer.
  (func $expression_head (param $header i32) (result i32)
    (i32.load (call $abs (i32.add (local.get $header) (global.get $GC_HEADER_SIZE))))
  )

  ;; Read an Expression's argument array pointer.
  (func $expression_args (param $header i32) (result i32)
    (i32.load (call $abs (i32.add
      (i32.add (local.get $header) (global.get $GC_HEADER_SIZE))
      (i32.const 4))))
  )

  ;; Push an Expression value onto the pending stack.
  (func $push_expression (param $header i32)
    (call $pending_push (global.get $TYPE_EXPRESSION) (i32.const 0) (local.get $header) (i32.const 0))
  )

  ;; Returns 1 iff the given value type is allowed as an Expression argument.
  ;; Ring 2 strict universe: Symbol, Rational, Complex, BigInt, Expression —
  ;; widened by Ring 4 with Matrix (a Matrix is a legal Expression subterm;
  ;; the polynomial machinery treats it as an honorary atom).
  ;; Everything else (Float, String, Boolean, Array, Object, Function, null,
  ;; undefined, …) is rejected at construction time.
  (func $expression_arg_type_ok (param $type i32) (result i32)
    (i32.or
      (i32.or
        (i32.or
          (i32.eq (local.get $type) (global.get $TYPE_SYMBOL))
          (i32.eq (local.get $type) (global.get $TYPE_RATIONAL)))
        ;; Ring 6c universe widening: AlgebraicNumber joins the term
        ;; universe (an opaque exact-numeric atom to the walkers —
        ;; simplify never folds it; that is Ring 7a's contract change).
        (i32.eq (local.get $type) (global.get $TYPE_ALGEBRAIC)))
      (i32.or
        (i32.or
          (i32.eq (local.get $type) (global.get $TYPE_COMPLEX))
          (i32.eq (local.get $type) (global.get $TYPE_BIGINT)))
        (i32.or
          (i32.eq (local.get $type) (global.get $TYPE_EXPRESSION))
          (i32.or
            (i32.eq (local.get $type) (global.get $TYPE_MATRIX))
            (i32.eq (local.get $type) (global.get $TYPE_COMPLEX_ALGEBRAIC))))))
  )

  ;; Validate every element of an Array against the allowed-argument rule.
  ;; Returns 1 iff all elements pass; 0 otherwise.
  (func $expression_validate_args_array (param $array_pointer i32) (result i32)
    (local $length i32)
    (local $data_pointer i32)
    (local $element_pointer i32)
    (local $i i32)
    (local $element_type i32)

    (local.set $length (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 8)))))
    (local.set $data_pointer (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 16)))))
    (if (i32.eqz (local.get $length))
      (then (return (i32.const 1))))

    (local.set $i (i32.const 0))
    (block $done
      (loop $scan
        (br_if $done (i32.ge_u (local.get $i) (local.get $length)))
        (local.set $element_pointer (i32.add
          (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
          (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
        (local.set $element_type (i32.load (call $abs (local.get $element_pointer))))
        (if (i32.eqz (call $expression_arg_type_ok (local.get $element_type)))
          (then (return (i32.const 0))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $scan)
      )
    )
    (i32.const 1)
  )

  ;; Freeze an Array's flags field in place by OR-ing in ARRAY_FLAG_FROZEN.
  (func $expression_freeze_args_array (param $array_pointer i32)
    (i32.store
      (call $abs (i32.add (local.get $array_pointer) (global.get $ARRAY_FLAGS_OFFSET)))
      (i32.or
        (i32.load (call $abs (i32.add (local.get $array_pointer) (global.get $ARRAY_FLAGS_OFFSET))))
        (global.get $ARRAY_FLAG_FROZEN)))
  )

  ;; Build an Expression from an already-validated head (Symbol pointer) and
  ;; args (Array pointer). Freezes the args array so downstream callers can
  ;; hand out args() results without defensive copying. This is the hot path
  ;; for every construction builtin.
  (func $expression_build (param $head_pointer i32) (param $args_array_pointer i32) (result i32)
    (call $expression_freeze_args_array (local.get $args_array_pointer))
    (call $expression_allocate (local.get $head_pointer) (local.get $args_array_pointer))
  )

  ;; Allocate a freshly-filled args Array with two elements copied from
  ;; value slots at the given pointers. Used by the two-argument sugar
  ;; constructors (add, subtract, multiply, divide, power).
  (func $expression_alloc_args2 (param $left_pointer i32) (param $right_pointer i32) (result i32)
    (local $heap_pointer i32)
    (local $array_pointer i32)
    (local $data_pointer i32)
    (local $data_size i32)
    (local $dest i32)

    (local.set $heap_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))
    (local.set $array_pointer (local.get $heap_pointer))

    ;; Data block: GC:8 + 2 * VALUE_SIZE
    (local.set $data_size (i32.add (global.get $GC_HEADER_SIZE)
      (i32.mul (i32.const 2) (global.get $VALUE_SIZE))))
    (local.set $data_pointer (call $write_array_header
      (local.get $array_pointer) (i32.const 2) (i32.const 2) (local.get $data_size)))

    ;; Copy left into slot 0 (16 bytes)
    (local.set $dest (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE)))
    (memory.copy
      (call $abs (local.get $dest))
      (call $abs (local.get $left_pointer))
      (global.get $VALUE_SIZE))
    ;; Copy right into slot 1
    (memory.copy
      (call $abs (i32.add (local.get $dest) (global.get $VALUE_SIZE)))
      (call $abs (local.get $right_pointer))
      (global.get $VALUE_SIZE))

    (call $write_state (global.get $STATE_HEAP_POINTER)
      (i32.add (local.get $data_pointer) (local.get $data_size)))

    (local.get $array_pointer)
  )

  ;; Allocate a one-element args array (for Negate).
  (func $expression_alloc_args1 (param $operand_pointer i32) (result i32)
    (local $heap_pointer i32)
    (local $array_pointer i32)
    (local $data_pointer i32)
    (local $data_size i32)
    (local $dest i32)

    (local.set $heap_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))
    (local.set $array_pointer (local.get $heap_pointer))

    (local.set $data_size (i32.add (global.get $GC_HEADER_SIZE) (global.get $VALUE_SIZE)))
    (local.set $data_pointer (call $write_array_header
      (local.get $array_pointer) (i32.const 1) (i32.const 1) (local.get $data_size)))

    (local.set $dest (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE)))
    (memory.copy
      (call $abs (local.get $dest))
      (call $abs (local.get $operand_pointer))
      (global.get $VALUE_SIZE))

    (call $write_state (global.get $STATE_HEAP_POINTER)
      (i32.add (local.get $data_pointer) (local.get $data_size)))

    (local.get $array_pointer)
  )

  ;; ==========================================================================
  ;; Matrix heap type + construction + inspection — Ring 4 (4a)
  ;;
  ;; Layout: [gc_header:8][rowCount:4][columnCount:4][entriesArrayPointer:4]
  ;; [reserved:4] = 24 bytes, aligned to 32. entriesArrayPointer is a frozen
  ;; row-major Array of length rowCount × columnCount (HEADER pointer) —
  ;; the same storage pattern as Expression's argument array, so both
  ;; collectors handle Matrix as one new case with a single pointer.
  ;; ==========================================================================

  ;; Allocate a Matrix heap object. Caller has budgeted.
  (func $matrix_allocate
    (param $rows i32) (param $columns i32) (param $entries_pointer i32)
    (result i32)
    (local $header i32)
    (local.set $header (call $read_state (global.get $STATE_HEAP_POINTER)))
    (i32.store (call $abs (local.get $header))
      (i32.or (i32.const 32) (i32.shl (global.get $OBJ_MATRIX) (i32.const 24))))
    (i32.store (call $abs (i32.add (local.get $header) (i32.const 4))) (i32.const 0))
    (i32.store (call $abs (i32.add (local.get $header) (global.get $GC_HEADER_SIZE)))
      (local.get $rows))
    (i32.store (call $abs (i32.add (local.get $header) (i32.const 12)))
      (local.get $columns))
    (i32.store (call $abs (i32.add (local.get $header) (i32.const 16)))
      (local.get $entries_pointer))
    (i32.store (call $abs (i32.add (local.get $header) (i32.const 20)))
      (i32.const 0))
    (call $write_state (global.get $STATE_HEAP_POINTER)
      (i32.add (local.get $header) (i32.const 32)))
    (local.get $header)
  )

  (func $matrix_rows_of (param $header i32) (result i32)
    (i32.load (call $abs (i32.add (local.get $header) (global.get $GC_HEADER_SIZE))))
  )

  (func $matrix_columns_of (param $header i32) (result i32)
    (i32.load (call $abs (i32.add (local.get $header) (i32.const 12))))
  )

  (func $matrix_entries_of (param $header i32) (result i32)
    (i32.load (call $abs (i32.add (local.get $header) (i32.const 16))))
  )

  (func $push_matrix (param $header i32)
    (call $pending_push (global.get $TYPE_MATRIX) (i32.const 0) (local.get $header) (i32.const 0))
  )

  ;; Matrix entry universe: the Expression argument universe plus Matrix
  ;; itself (nested matrices are legal opaque entries — block matrices).
  (func $matrix_entry_type_ok (param $type i32) (result i32)
    (i32.or
      (call $expression_arg_type_ok (local.get $type))
      (i32.eq (local.get $type) (global.get $TYPE_MATRIX)))
  )

  ;; Structural equality: shape match, then per-entry
  ;; $expression_values_equal (Ring 1 semantic equality on numeric
  ;; leaves, pointer equality on Symbols, recursion on Expressions and
  ;; nested Matrices). Allocation-free; numeric-leaf compares may signal
  ;; pressure — callers check $memory_pressure_signaled.
  (func $matrix_structural_equal (param $a_header i32) (param $b_header i32) (result i32)
    (local $count i32)
    (local $a_data i32)
    (local $b_data i32)
    (local $i i32)
    (if (i32.ne
          (call $matrix_rows_of (local.get $a_header))
          (call $matrix_rows_of (local.get $b_header)))
      (then (return (i32.const 0))))
    (if (i32.ne
          (call $matrix_columns_of (local.get $a_header))
          (call $matrix_columns_of (local.get $b_header)))
      (then (return (i32.const 0))))
    (local.set $count (i32.mul
      (call $matrix_rows_of (local.get $a_header))
      (call $matrix_columns_of (local.get $a_header))))
    (if (i32.eqz (local.get $count))
      (then (return (i32.const 1))))
    (local.set $a_data (i32.load (call $abs (i32.add
      (call $matrix_entries_of (local.get $a_header)) (i32.const 16)))))
    (local.set $b_data (i32.load (call $abs (i32.add
      (call $matrix_entries_of (local.get $b_header)) (i32.const 16)))))
    (local.set $i (i32.const 0))
    (block $done
      (loop $compare
        (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
        (if (i32.eqz (call $expression_values_equal
              (i32.add
                (i32.add (local.get $a_data) (global.get $GC_HEADER_SIZE))
                (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
              (i32.add
                (i32.add (local.get $b_data) (global.get $GC_HEADER_SIZE))
                (i32.mul (local.get $i) (global.get $VALUE_SIZE)))))
          (then (return (i32.const 0))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $compare)))
    (i32.const 1)
  )

  ;; Read a dimension/index argument: the exact i32 when the slot is a
  ;; numeric non-negative integer in [0, 2^31), else -1.
  (func $matrix_dimension_arg (param $slot i32) (result i32)
    (if (i32.eqz (call $value_is_numeric (local.get $slot)))
      (then (return (i32.const -1))))
    (call $f64_index_or_negative (call $value_to_f64 (local.get $slot)))
  )

  ;; Fill $count entry slots with inline Rational 0.
  (func $matrix_fill_zero (param $entries_data i32) (param $count i32)
    (local $i i32)
    (local $slot i32)
    (local.set $i (i32.const 0))
    (block $done
      (loop $fill
        (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
        (local.set $slot (call $abs (i32.add
          (i32.add (local.get $entries_data) (global.get $GC_HEADER_SIZE))
          (i32.mul (local.get $i) (global.get $VALUE_SIZE)))))
        (i32.store (local.get $slot) (global.get $TYPE_RATIONAL))
        (i32.store (i32.add (local.get $slot) (i32.const 4)) (global.get $FLAG_RATIONAL_INLINE))
        (i32.store (i32.add (local.get $slot) (i32.const 8)) (i32.const 0))
        (i32.store (i32.add (local.get $slot) (i32.const 12)) (i32.const 0))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $fill)))
  )

  ;; Shared tail for every constructor: budget for the entries array plus
  ;; the matrix object (64 covers the 32-byte matrix plus header slop),
  ;; allocate the entries array. Returns the array pointer, or 0 on
  ;; pressure refusal (flag already set; caller returns 0 to yield).
  ;; The entry slots are UNINITIALIZED — every caller fills all $count
  ;; slots before the next allocation point.
  (func $matrix_budget_and_alloc_entries (param $count i32) (result i32)
    (if (call $check_heap_overflow (i32.add (i32.const 64)
          (call $estimate_array_size (local.get $count))))
      (then (return (i32.const 0))))
    (call $allocate_array (local.get $count))
  )

  ;; make(rowsArray) — general-purpose constructor from an Array of row
  ;; Arrays. Validates shape (rectangular) and the entry universe, then
  ;; copies row slots into a fresh frozen row-major entries array.
  (func $matrix_make
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $arg1_type i32)
    (local $arg1_lo i32)
    (local $rows i32)
    (local $columns i32)
    (local $outer_data i32)
    (local $row_slot i32)
    (local $row_pointer i32)
    (local $row_data i32)
    (local $row_length i32)
    (local $r i32)
    (local $c i32)
    (local $count i32)
    (local $entries_pointer i32)
    (local $entries_data i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $arg1_type (call $value_type (local.get $argument1_pointer)))
        (local.set $arg1_lo (call $value_data_lo (local.get $argument1_pointer)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (i32.ne (local.get $arg1_type) (global.get $TYPE_ARRAY))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_MATRIX_ROWS_NOT_ARRAY))))))
    (local.set $rows (i32.load (call $abs (i32.add (local.get $arg1_lo) (i32.const 8)))))
    (local.set $outer_data (i32.load (call $abs (i32.add (local.get $arg1_lo) (i32.const 16)))))
    (local.set $columns (i32.const 0))
    ;; Validation walk: every row an Array, uniform length, entries in
    ;; the allowed universe. Read-only — no allocation until budgeted.
    (local.set $r (i32.const 0))
    (block $rows_done
      (loop $rows_scan
        (br_if $rows_done (i32.ge_u (local.get $r) (local.get $rows)))
        (local.set $row_slot (i32.add
          (i32.add (local.get $outer_data) (global.get $GC_HEADER_SIZE))
          (i32.mul (local.get $r) (global.get $VALUE_SIZE))))
        (if (i32.ne (call $value_type (local.get $row_slot)) (global.get $TYPE_ARRAY))
          (then (return (i32.add (i32.const 1)
            (call $throw_type_error_with_message (global.get $BUILTIN_MSG_MATRIX_ROWS_NOT_ARRAY))))))
        (local.set $row_pointer (call $value_data_lo (local.get $row_slot)))
        (local.set $row_length (i32.load (call $abs (i32.add (local.get $row_pointer) (i32.const 8)))))
        (if (i32.eqz (local.get $r))
          (then (local.set $columns (local.get $row_length)))
          (else
            (if (i32.ne (local.get $row_length) (local.get $columns))
              (then (return (i32.add (i32.const 1)
                (call $throw_type_error_with_message (global.get $BUILTIN_MSG_MATRIX_RAGGED))))))))
        (local.set $row_data (i32.load (call $abs (i32.add (local.get $row_pointer) (i32.const 16)))))
        (local.set $c (i32.const 0))
        (block $row_done
          (loop $row_scan
            (br_if $row_done (i32.ge_u (local.get $c) (local.get $columns)))
            (if (i32.eqz (call $matrix_entry_type_ok (call $value_type (i32.add
                  (i32.add (local.get $row_data) (global.get $GC_HEADER_SIZE))
                  (i32.mul (local.get $c) (global.get $VALUE_SIZE))))))
              (then (return (i32.add (i32.const 1)
                (call $throw_type_error_with_message (global.get $BUILTIN_MSG_MATRIX_ENTRY_TYPE))))))
            (local.set $c (i32.add (local.get $c) (i32.const 1)))
            (br $row_scan)))
        (local.set $r (i32.add (local.get $r) (i32.const 1)))
        (br $rows_scan)))
    (local.set $count (i32.mul (local.get $rows) (local.get $columns)))
    (local.set $entries_pointer (call $matrix_budget_and_alloc_entries (local.get $count)))
    (if (i32.eqz (local.get $entries_pointer))
      (then (return (i32.const 0))))
    (local.set $entries_data (i32.load (call $abs (i32.add (local.get $entries_pointer) (i32.const 16)))))
    ;; Copy row by row: 16-byte value slots, shared substructure.
    (local.set $r (i32.const 0))
    (block $copy_done
      (loop $copy_rows
        (br_if $copy_done (i32.ge_u (local.get $r) (local.get $rows)))
        (local.set $row_slot (i32.add
          (i32.add (local.get $outer_data) (global.get $GC_HEADER_SIZE))
          (i32.mul (local.get $r) (global.get $VALUE_SIZE))))
        (local.set $row_pointer (call $value_data_lo (local.get $row_slot)))
        (local.set $row_data (i32.load (call $abs (i32.add (local.get $row_pointer) (i32.const 16)))))
        (memory.copy
          (call $abs (i32.add
            (i32.add (local.get $entries_data) (global.get $GC_HEADER_SIZE))
            (i32.mul (i32.mul (local.get $r) (local.get $columns)) (global.get $VALUE_SIZE))))
          (call $abs (i32.add (local.get $row_data) (global.get $GC_HEADER_SIZE)))
          (i32.mul (local.get $columns) (global.get $VALUE_SIZE)))
        (local.set $r (i32.add (local.get $r) (i32.const 1)))
        (br $copy_rows)))
    (call $expression_freeze_args_array (local.get $entries_pointer))
    (call $push_matrix (call $matrix_allocate
      (local.get $rows) (local.get $columns) (local.get $entries_pointer)))
    (i32.const 0)
  )

  ;; fromColumns(columnsArray) — transposed make: the outer Array holds
  ;; column Arrays. Entry (r, c) comes from columnsArray[c][r].
  (func $matrix_from_columns
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $arg1_type i32)
    (local $arg1_lo i32)
    (local $rows i32)
    (local $columns i32)
    (local $outer_data i32)
    (local $column_slot i32)
    (local $column_pointer i32)
    (local $column_data i32)
    (local $column_length i32)
    (local $r i32)
    (local $c i32)
    (local $count i32)
    (local $entries_pointer i32)
    (local $entries_data i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $arg1_type (call $value_type (local.get $argument1_pointer)))
        (local.set $arg1_lo (call $value_data_lo (local.get $argument1_pointer)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (i32.ne (local.get $arg1_type) (global.get $TYPE_ARRAY))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_MATRIX_ROWS_NOT_ARRAY))))))
    (local.set $columns (i32.load (call $abs (i32.add (local.get $arg1_lo) (i32.const 8)))))
    (local.set $outer_data (i32.load (call $abs (i32.add (local.get $arg1_lo) (i32.const 16)))))
    (local.set $rows (i32.const 0))
    (local.set $c (i32.const 0))
    (block $columns_done
      (loop $columns_scan
        (br_if $columns_done (i32.ge_u (local.get $c) (local.get $columns)))
        (local.set $column_slot (i32.add
          (i32.add (local.get $outer_data) (global.get $GC_HEADER_SIZE))
          (i32.mul (local.get $c) (global.get $VALUE_SIZE))))
        (if (i32.ne (call $value_type (local.get $column_slot)) (global.get $TYPE_ARRAY))
          (then (return (i32.add (i32.const 1)
            (call $throw_type_error_with_message (global.get $BUILTIN_MSG_MATRIX_ROWS_NOT_ARRAY))))))
        (local.set $column_pointer (call $value_data_lo (local.get $column_slot)))
        (local.set $column_length (i32.load (call $abs (i32.add (local.get $column_pointer) (i32.const 8)))))
        (if (i32.eqz (local.get $c))
          (then (local.set $rows (local.get $column_length)))
          (else
            (if (i32.ne (local.get $column_length) (local.get $rows))
              (then (return (i32.add (i32.const 1)
                (call $throw_type_error_with_message (global.get $BUILTIN_MSG_MATRIX_RAGGED))))))))
        (local.set $column_data (i32.load (call $abs (i32.add (local.get $column_pointer) (i32.const 16)))))
        (local.set $r (i32.const 0))
        (block $column_done
          (loop $column_scan
            (br_if $column_done (i32.ge_u (local.get $r) (local.get $rows)))
            (if (i32.eqz (call $matrix_entry_type_ok (call $value_type (i32.add
                  (i32.add (local.get $column_data) (global.get $GC_HEADER_SIZE))
                  (i32.mul (local.get $r) (global.get $VALUE_SIZE))))))
              (then (return (i32.add (i32.const 1)
                (call $throw_type_error_with_message (global.get $BUILTIN_MSG_MATRIX_ENTRY_TYPE))))))
            (local.set $r (i32.add (local.get $r) (i32.const 1)))
            (br $column_scan)))
        (local.set $c (i32.add (local.get $c) (i32.const 1)))
        (br $columns_scan)))
    (local.set $count (i32.mul (local.get $rows) (local.get $columns)))
    (local.set $entries_pointer (call $matrix_budget_and_alloc_entries (local.get $count)))
    (if (i32.eqz (local.get $entries_pointer))
      (then (return (i32.const 0))))
    (local.set $entries_data (i32.load (call $abs (i32.add (local.get $entries_pointer) (i32.const 16)))))
    ;; Transposed copy: per-slot (no contiguous source run).
    (local.set $c (i32.const 0))
    (block $copy_done
      (loop $copy_columns
        (br_if $copy_done (i32.ge_u (local.get $c) (local.get $columns)))
        (local.set $column_slot (i32.add
          (i32.add (local.get $outer_data) (global.get $GC_HEADER_SIZE))
          (i32.mul (local.get $c) (global.get $VALUE_SIZE))))
        (local.set $column_pointer (call $value_data_lo (local.get $column_slot)))
        (local.set $column_data (i32.load (call $abs (i32.add (local.get $column_pointer) (i32.const 16)))))
        (local.set $r (i32.const 0))
        (block $col_copy_done
          (loop $copy_column
            (br_if $col_copy_done (i32.ge_u (local.get $r) (local.get $rows)))
            (memory.copy
              (call $abs (i32.add
                (i32.add (local.get $entries_data) (global.get $GC_HEADER_SIZE))
                (i32.mul
                  (i32.add (i32.mul (local.get $r) (local.get $columns)) (local.get $c))
                  (global.get $VALUE_SIZE))))
              (call $abs (i32.add
                (i32.add (local.get $column_data) (global.get $GC_HEADER_SIZE))
                (i32.mul (local.get $r) (global.get $VALUE_SIZE))))
              (global.get $VALUE_SIZE))
            (local.set $r (i32.add (local.get $r) (i32.const 1)))
            (br $copy_column)))
        (local.set $c (i32.add (local.get $c) (i32.const 1)))
        (br $copy_columns)))
    (call $expression_freeze_args_array (local.get $entries_pointer))
    (call $push_matrix (call $matrix_allocate
      (local.get $rows) (local.get $columns) (local.get $entries_pointer)))
    (i32.const 0)
  )

  ;; zero(rows, columns) — all entries inline Rational 0.
  (func $matrix_zero
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $argument2_pointer i32)
    (local $rows i32)
    (local $columns i32)
    (local $count i32)
    (local $entries_pointer i32)
    (local.set $rows (i32.const -1))
    (local.set $columns (i32.const -1))
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $rows (call $matrix_dimension_arg (local.get $argument1_pointer)))))
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then
        (local.set $argument2_pointer (i32.add (local.get $argument1_pointer) (global.get $VALUE_SIZE)))
        (local.set $columns (call $matrix_dimension_arg (local.get $argument2_pointer)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (i32.or
          (i32.lt_s (local.get $rows) (i32.const 0))
          (i32.lt_s (local.get $columns) (i32.const 0)))
      (then (return (i32.add (i32.const 1)
        (call $throw_range_error_with_message (global.get $BUILTIN_MSG_MATRIX_DIMENSION))))))
    ;; Product cap: keeps count × VALUE_SIZE inside i32 byte math. Any
    ;; count this large is far past what the heap can hold anyway.
    (if (i64.gt_u
          (i64.mul (i64.extend_i32_u (local.get $rows)) (i64.extend_i32_u (local.get $columns)))
          (i64.const 0xFFFFFF))
      (then (return (i32.add (i32.const 1)
        (call $throw_range_error_with_message (global.get $BUILTIN_MSG_MATRIX_DIMENSION))))))
    (local.set $count (i32.mul (local.get $rows) (local.get $columns)))
    (local.set $entries_pointer (call $matrix_budget_and_alloc_entries (local.get $count)))
    (if (i32.eqz (local.get $entries_pointer))
      (then (return (i32.const 0))))
    (call $matrix_fill_zero
      (i32.load (call $abs (i32.add (local.get $entries_pointer) (i32.const 16))))
      (local.get $count))
    (call $expression_freeze_args_array (local.get $entries_pointer))
    (call $push_matrix (call $matrix_allocate
      (local.get $rows) (local.get $columns) (local.get $entries_pointer)))
    (i32.const 0)
  )

  ;; identity(n) — n × n with inline Rational 1 on the diagonal.
  (func $matrix_identity
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $n i32)
    (local $count i32)
    (local $entries_pointer i32)
    (local $entries_data i32)
    (local $i i32)
    (local $slot i32)
    (local.set $n (i32.const -1))
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $n (call $matrix_dimension_arg (local.get $argument1_pointer)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (i32.lt_s (local.get $n) (i32.const 0))
      (then (return (i32.add (i32.const 1)
        (call $throw_range_error_with_message (global.get $BUILTIN_MSG_MATRIX_DIMENSION))))))
    (if (i64.gt_u
          (i64.mul (i64.extend_i32_u (local.get $n)) (i64.extend_i32_u (local.get $n)))
          (i64.const 0xFFFFFF))
      (then (return (i32.add (i32.const 1)
        (call $throw_range_error_with_message (global.get $BUILTIN_MSG_MATRIX_DIMENSION))))))
    (local.set $count (i32.mul (local.get $n) (local.get $n)))
    (local.set $entries_pointer (call $matrix_budget_and_alloc_entries (local.get $count)))
    (if (i32.eqz (local.get $entries_pointer))
      (then (return (i32.const 0))))
    (local.set $entries_data (i32.load (call $abs (i32.add (local.get $entries_pointer) (i32.const 16)))))
    (call $matrix_fill_zero (local.get $entries_data) (local.get $count))
    ;; Diagonal: flat index i * (n + 1); write inline Rational 1.
    (local.set $i (i32.const 0))
    (block $done
      (loop $diagonal
        (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
        (local.set $slot (call $abs (i32.add
          (i32.add (local.get $entries_data) (global.get $GC_HEADER_SIZE))
          (i32.mul
            (i32.mul (local.get $i) (i32.add (local.get $n) (i32.const 1)))
            (global.get $VALUE_SIZE)))))
        (i32.store (i32.add (local.get $slot) (i32.const 8)) (i32.const 1))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $diagonal)))
    (call $expression_freeze_args_array (local.get $entries_pointer))
    (call $push_matrix (call $matrix_allocate
      (local.get $n) (local.get $n) (local.get $entries_pointer)))
    (i32.const 0)
  )

  ;; diagonal(valuesArray) — square matrix with valuesArray on the
  ;; diagonal, inline Rational 0 elsewhere.
  (func $matrix_diagonal
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $arg1_type i32)
    (local $arg1_lo i32)
    (local $n i32)
    (local $values_data i32)
    (local $count i32)
    (local $entries_pointer i32)
    (local $entries_data i32)
    (local $i i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $arg1_type (call $value_type (local.get $argument1_pointer)))
        (local.set $arg1_lo (call $value_data_lo (local.get $argument1_pointer)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (i32.ne (local.get $arg1_type) (global.get $TYPE_ARRAY))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_MATRIX_ROWS_NOT_ARRAY))))))
    (local.set $n (i32.load (call $abs (i32.add (local.get $arg1_lo) (i32.const 8)))))
    (local.set $values_data (i32.load (call $abs (i32.add (local.get $arg1_lo) (i32.const 16)))))
    (local.set $i (i32.const 0))
    (block $validate_done
      (loop $validate
        (br_if $validate_done (i32.ge_u (local.get $i) (local.get $n)))
        (if (i32.eqz (call $matrix_entry_type_ok (call $value_type (i32.add
              (i32.add (local.get $values_data) (global.get $GC_HEADER_SIZE))
              (i32.mul (local.get $i) (global.get $VALUE_SIZE))))))
          (then (return (i32.add (i32.const 1)
            (call $throw_type_error_with_message (global.get $BUILTIN_MSG_MATRIX_ENTRY_TYPE))))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $validate)))
    (if (i64.gt_u
          (i64.mul (i64.extend_i32_u (local.get $n)) (i64.extend_i32_u (local.get $n)))
          (i64.const 0xFFFFFF))
      (then (return (i32.add (i32.const 1)
        (call $throw_range_error_with_message (global.get $BUILTIN_MSG_MATRIX_DIMENSION))))))
    (local.set $count (i32.mul (local.get $n) (local.get $n)))
    (local.set $entries_pointer (call $matrix_budget_and_alloc_entries (local.get $count)))
    (if (i32.eqz (local.get $entries_pointer))
      (then (return (i32.const 0))))
    (local.set $entries_data (i32.load (call $abs (i32.add (local.get $entries_pointer) (i32.const 16)))))
    (call $matrix_fill_zero (local.get $entries_data) (local.get $count))
    (local.set $i (i32.const 0))
    (block $done
      (loop $diagonal
        (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
        (memory.copy
          (call $abs (i32.add
            (i32.add (local.get $entries_data) (global.get $GC_HEADER_SIZE))
            (i32.mul
              (i32.mul (local.get $i) (i32.add (local.get $n) (i32.const 1)))
              (global.get $VALUE_SIZE))))
          (call $abs (i32.add
            (i32.add (local.get $values_data) (global.get $GC_HEADER_SIZE))
            (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
          (global.get $VALUE_SIZE))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $diagonal)))
    (call $expression_freeze_args_array (local.get $entries_pointer))
    (call $push_matrix (call $matrix_allocate
      (local.get $n) (local.get $n) (local.get $entries_pointer)))
    (i32.const 0)
  )

  ;; rows(M) / columns(M) — one shared shape-reader, branching on
  ;; method_id (the ids are adjacent but the pair is small enough that
  ;; an explicit branch reads clearer than arithmetic).
  (func $matrix_rows_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
