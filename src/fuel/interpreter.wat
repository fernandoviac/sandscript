            (if (i32.or
                  (i32.and
                    (i32.eq (local.get $type1) (global.get $TYPE_RATIONAL))
                    (i32.eq (local.get $type2) (global.get $TYPE_FLOAT)))
                  (i32.and
                    (i32.eq (local.get $type1) (global.get $TYPE_FLOAT))
                    (i32.eq (local.get $type2) (global.get $TYPE_RATIONAL))))
              (then
                (call $push_f64
                  (f64.mul
                    (call $value_to_f64 (local.get $value_pointer))
                    (call $value_to_f64 (local.get $value_pointer2))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_FLOAT))
                  (i32.eq (local.get $type2) (global.get $TYPE_FLOAT)))
              (then
                (call $push_f64
                  (f64.mul
                    (call $read_f64 (local.get $value_pointer))
                    (call $read_f64 (local.get $value_pointer2))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )
            (if (call $raise_error (global.get $ERR_INVALID_OPERAND) (i32.const 0))
              (then (br $exit)))
            (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
            (br $loop)
          )
        )

        (if (i32.eq (local.get $opcode) (global.get $OP_DIV))
          (then
            ;; Peek operands first so we can pre-check heap pressure.
            (local.set $value_pointer2
              (i32.sub
                (call $read_ctx (global.get $CTX_PENDING_POINTER))
                (global.get $VALUE_SIZE)))
            (local.set $value_pointer
              (i32.sub
                (call $read_ctx (global.get $CTX_PENDING_POINTER))
                (i32.mul (global.get $VALUE_SIZE) (i32.const 2))))
            (call $coerce_to_number_at (local.get $value_pointer))
            (call $coerce_to_number_at (local.get $value_pointer2))
            (local.set $type1 (call $value_type (local.get $value_pointer)))
            (local.set $type2 (call $value_type (local.get $value_pointer2)))

            ;; Symbol / Expression refuse numeric coercion — same
            ;; messaged TypeError as OP_SUB (see comment there).
            (if (i32.or
                  (i32.or
                    (i32.eq (local.get $type1) (global.get $TYPE_SYMBOL))
                    (i32.eq (local.get $type1) (global.get $TYPE_EXPRESSION)))
                  (i32.or
                    (i32.eq (local.get $type2) (global.get $TYPE_SYMBOL))
                    (i32.eq (local.get $type2) (global.get $TYPE_EXPRESSION))))
              (then
                (drop (call $pending_pop))
                (drop (call $pending_pop))
                (if (call $throw_type_error_with_type
                      (global.get $BUILTIN_MSG_CANNOT_CONVERT_TO_NUMBER)
                      (select (local.get $type1) (local.get $type2)
                        (i32.or
                          (i32.eq (local.get $type1) (global.get $TYPE_SYMBOL))
                          (i32.eq (local.get $type1) (global.get $TYPE_EXPRESSION)))))
                  (then (br $exit))
                  (else
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)))))

            (if (call $complex_algebraic_pair_dispatchable
                  (local.get $type1) (local.get $type2))
              (then
                (local.set $result_i32 (call $complex_algebraic_operator_arith
                  (i32.const 3) (local.get $value_pointer) (local.get $value_pointer2)))
                (if (i32.eq (local.get $result_i32) (i32.const 1))
                  (then
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)))
                (if (i32.eq (local.get $result_i32) (i32.const 3))
                  (then (br $exit)))
                (if (i32.eq (local.get $result_i32) (i32.const 2))
                  (then
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)))
            ;; AlgebraicNumber arithmetic (Ring 6b) — see OP_ADD.
            (if (call $algebraic_pair_dispatchable (local.get $type1) (local.get $type2))
              (then
                (local.set $result_i32 (call $algebraic_operator_arith
                  (i32.const 3) (local.get $value_pointer) (local.get $value_pointer2)))
                (if (i32.eq (local.get $result_i32) (i32.const 1))
                  (then
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)))
                (if (i32.eq (local.get $result_i32) (i32.const 3))
                  (then (br $exit)))
                (if (i32.eq (local.get $result_i32) (i32.const 2))
                  (then
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)))

            ;; Pre-check by type. bigint_div allocates quotient+remainder
            ;; (each up to la limbs); rational_div is 2 bigint_mul + 1
            ;; rational. Use the rational_add budget for rational and
            ;; bigint_mul budget for bigint (covers quotient+remainder).
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_BIGINT))
                  (i32.eq (local.get $type2) (global.get $TYPE_BIGINT)))
              (then
                (if (call $check_heap_overflow
                      (call $estimate_bigint_mul_budget
                        (local.get $value_pointer) (local.get $value_pointer2)))
                  (then
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)))))
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_RATIONAL))
                  (i32.eq (local.get $type2) (global.get $TYPE_RATIONAL)))
              (then
                (if (call $check_heap_overflow
                      (call $estimate_rational_add_budget
                        (local.get $value_pointer) (local.get $value_pointer2)))
                  (then
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)))))
            ;; Cross-type combos.
            (if (i32.or
                  (i32.or
                    (i32.and
                      (i32.eq (local.get $type1) (global.get $TYPE_RATIONAL))
                      (i32.eq (local.get $type2) (global.get $TYPE_BIGINT)))
                    (i32.and
                      (i32.eq (local.get $type1) (global.get $TYPE_BIGINT))
                      (i32.eq (local.get $type2) (global.get $TYPE_RATIONAL))))
                  (i32.or
                    (i32.eq (local.get $type1) (global.get $TYPE_COMPLEX))
                    (i32.eq (local.get $type2) (global.get $TYPE_COMPLEX))))
              (then
                (if (call $check_heap_overflow
                      (call $estimate_cross_type_arith_budget
                        (local.get $value_pointer) (local.get $value_pointer2)))
                  (then
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)))))

            (local.set $value_pointer2 (call $pending_pop))
            (local.set $value_pointer (call $pending_pop))

            ;; BigInt / BigInt
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_BIGINT))
                  (i32.eq (local.get $type2) (global.get $TYPE_BIGINT)))
              (then
                ;; Division by zero → RangeError
                (if (i32.eqz (call $bigint_length
                  (call $value_data_lo (local.get $value_pointer2))))
                  (then
                    (if (call $raise_error (global.get $ERR_RANGE_ERROR) (i32.const 0))
                      (then (br $exit)))
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)
                  )
                )
                (call $push_bigint
                  (call $bigint_div
                    (call $value_data_lo (local.get $value_pointer))
                    (call $value_data_lo (local.get $value_pointer2))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Complex / Complex
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_COMPLEX))
                  (i32.eq (local.get $type2) (global.get $TYPE_COMPLEX)))
              (then
                (if (call $complex_is_zero (call $value_data_lo (local.get $value_pointer2)))
                  (then
                    (if (call $raise_error (global.get $ERR_RANGE_ERROR) (i32.const 0))
                      (then (br $exit)))
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)
                  )
                )
                (call $push_complex
                  (call $complex_div
                    (call $value_data_lo (local.get $value_pointer))
                    (call $value_data_lo (local.get $value_pointer2))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Complex / Rational
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_COMPLEX))
                  (i32.eq (local.get $type2) (global.get $TYPE_RATIONAL)))
              (then
                (if (call $rational_is_inline (local.get $value_pointer2))
                  (then
                    (if (i64.eqz (call $rational_read_inline (local.get $value_pointer2)))
                      (then
                        (if (call $raise_error (global.get $ERR_RANGE_ERROR) (i32.const 0))
                          (then (br $exit)))
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop))))
                  (else
                    (if (i32.eqz (call $bigint_length
                          (call $rational_numerator
                            (call $value_data_lo (local.get $value_pointer2)))))
                      (then
                        (if (call $raise_error (global.get $ERR_RANGE_ERROR) (i32.const 0))
                          (then (br $exit)))
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop)))))
                (call $push_complex
                  (call $complex_div
                    (call $value_data_lo (local.get $value_pointer))
                    (call $complex_from_rational
                      (call $rational_materialize (local.get $value_pointer2)))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Rational / Complex
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_RATIONAL))
                  (i32.eq (local.get $type2) (global.get $TYPE_COMPLEX)))
              (then
                (if (call $complex_is_zero (call $value_data_lo (local.get $value_pointer2)))
                  (then
                    (if (call $raise_error (global.get $ERR_RANGE_ERROR) (i32.const 0))
                      (then (br $exit)))
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)
                  )
                )
                (call $push_complex
                  (call $complex_div
                    (call $complex_from_rational
                      (call $rational_materialize (local.get $value_pointer)))
                    (call $value_data_lo (local.get $value_pointer2))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Complex / BigInt
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_COMPLEX))
                  (i32.eq (local.get $type2) (global.get $TYPE_BIGINT)))
              (then
                (if (i32.eqz (call $bigint_length (call $value_data_lo (local.get $value_pointer2))))
                  (then
                    (if (call $raise_error (global.get $ERR_RANGE_ERROR) (i32.const 0))
                      (then (br $exit)))
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)
                  )
                )
                (call $push_complex
                  (call $complex_div
                    (call $value_data_lo (local.get $value_pointer))
                    (call $complex_from_rational
                      (call $rational_from_bigint
                        (call $value_data_lo (local.get $value_pointer2))))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; BigInt / Complex
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_BIGINT))
                  (i32.eq (local.get $type2) (global.get $TYPE_COMPLEX)))
              (then
                (if (call $complex_is_zero (call $value_data_lo (local.get $value_pointer2)))
                  (then
                    (if (call $raise_error (global.get $ERR_RANGE_ERROR) (i32.const 0))
                      (then (br $exit)))
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)
                  )
                )
                (call $push_complex
                  (call $complex_div
                    (call $complex_from_rational
                      (call $rational_from_bigint
                        (call $value_data_lo (local.get $value_pointer))))
                    (call $value_data_lo (local.get $value_pointer2))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Complex / Float mix → TypeError
            (if (i32.or
                  (i32.and
                    (i32.eq (local.get $type1) (global.get $TYPE_COMPLEX))
                    (i32.eq (local.get $type2) (global.get $TYPE_FLOAT)))
                  (i32.and
                    (i32.eq (local.get $type1) (global.get $TYPE_FLOAT))
                    (i32.eq (local.get $type2) (global.get $TYPE_COMPLEX))))
              (then
                (if (call $throw_type_error_with_type (global.get $BUILTIN_MSG_MIXED_BIGINT) (local.get $type1))
                  (then (br $exit))
                  (else
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)
                  )
                )
              )
            )

            ;; Rational / Rational
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_RATIONAL))
                  (i32.eq (local.get $type2) (global.get $TYPE_RATIONAL)))
              (then
                ;; Division by zero: coerce to f64 to match JS semantics
                ;; (1/0 = Infinity, 0/0 = NaN). The inline check covers
                ;; the common case of integer literals.
                (if (call $rational_is_inline (local.get $value_pointer2))
                  (then
                    (if (i64.eqz (call $rational_read_inline (local.get $value_pointer2)))
                      (then
                        (call $push_f64
                          (f64.div
                            (call $value_to_f64 (local.get $value_pointer))
                            (f64.const 0)))
                        (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                        (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                        (br $loop))))
                  (else
                    (if (i32.eqz (call $bigint_length
                          (call $rational_numerator
                            (call $value_data_lo (local.get $value_pointer2)))))
                      (then
                        (call $push_f64
                          (f64.div
                            (call $value_to_f64 (local.get $value_pointer))
                            (f64.const 0)))
                        (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                        (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                        (br $loop)))))
                (call $push_rational
                  (call $rational_div
                    (call $rational_materialize (local.get $value_pointer))
                    (call $rational_materialize (local.get $value_pointer2))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Rational / BigInt
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_RATIONAL))
                  (i32.eq (local.get $type2) (global.get $TYPE_BIGINT)))
              (then
                (if (i32.eqz (call $bigint_length
                      (call $value_data_lo (local.get $value_pointer2))))
                  (then
                    (if (call $raise_error (global.get $ERR_RANGE_ERROR) (i32.const 0))
                      (then (br $exit)))
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)
                  )
                )
                (call $push_rational
                  (call $rational_div
                    (call $rational_materialize (local.get $value_pointer))
                    (call $rational_from_bigint
                      (call $value_data_lo (local.get $value_pointer2)))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; BigInt / Rational
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_BIGINT))
                  (i32.eq (local.get $type2) (global.get $TYPE_RATIONAL)))
              (then
                (if (call $rational_is_inline (local.get $value_pointer2))
                  (then
                    (if (i64.eqz (call $rational_read_inline (local.get $value_pointer2)))
                      (then
                        (if (call $raise_error (global.get $ERR_RANGE_ERROR) (i32.const 0))
                          (then (br $exit)))
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop))))
                  (else
                    (if (i32.eqz (call $bigint_length
                          (call $rational_numerator
                            (call $value_data_lo (local.get $value_pointer2)))))
                      (then
                        (if (call $raise_error (global.get $ERR_RANGE_ERROR) (i32.const 0))
                          (then (br $exit)))
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop)))))
                (call $push_rational
                  (call $rational_div
                    (call $rational_from_bigint
                      (call $value_data_lo (local.get $value_pointer)))
                    (call $rational_materialize (local.get $value_pointer2))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Rational / Float — contagion rule: approximate Rational as f64, divide as Float.
            (if (i32.or
                  (i32.and
                    (i32.eq (local.get $type1) (global.get $TYPE_RATIONAL))
                    (i32.eq (local.get $type2) (global.get $TYPE_FLOAT)))
                  (i32.and
                    (i32.eq (local.get $type1) (global.get $TYPE_FLOAT))
                    (i32.eq (local.get $type2) (global.get $TYPE_RATIONAL))))
              (then
                (call $push_f64
                  (f64.div
                    (call $value_to_f64 (local.get $value_pointer))
                    (call $value_to_f64 (local.get $value_pointer2))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_FLOAT))
                  (i32.eq (local.get $type2) (global.get $TYPE_FLOAT)))
              (then
                (call $push_f64
                  (f64.div
                    (call $read_f64 (local.get $value_pointer))
                    (call $read_f64 (local.get $value_pointer2))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )
            (if (call $raise_error (global.get $ERR_INVALID_OPERAND) (i32.const 0))
              (then (br $exit)))
            (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
            (br $loop)
          )
        )

        (if (i32.eq (local.get $opcode) (global.get $OP_MOD))
          (then
            ;; Peek operands first for pre-check.
            (local.set $value_pointer2
              (i32.sub
                (call $read_ctx (global.get $CTX_PENDING_POINTER))
                (global.get $VALUE_SIZE)))
            (local.set $value_pointer
              (i32.sub
                (call $read_ctx (global.get $CTX_PENDING_POINTER))
                (i32.mul (global.get $VALUE_SIZE) (i32.const 2))))
            (call $coerce_to_number_at (local.get $value_pointer))
            (call $coerce_to_number_at (local.get $value_pointer2))
            (local.set $type1 (call $value_type (local.get $value_pointer)))
            (local.set $type2 (call $value_type (local.get $value_pointer2)))

            ;; Symbol / Expression refuse numeric coercion — same
            ;; messaged TypeError as OP_SUB (see comment there).
            (if (i32.or
                  (i32.or
                    (i32.eq (local.get $type1) (global.get $TYPE_SYMBOL))
                    (i32.eq (local.get $type1) (global.get $TYPE_EXPRESSION)))
                  (i32.or
                    (i32.eq (local.get $type2) (global.get $TYPE_SYMBOL))
                    (i32.eq (local.get $type2) (global.get $TYPE_EXPRESSION))))
              (then
                (drop (call $pending_pop))
                (drop (call $pending_pop))
                (if (call $throw_type_error_with_type
                      (global.get $BUILTIN_MSG_CANNOT_CONVERT_TO_NUMBER)
                      (select (local.get $type1) (local.get $type2)
                        (i32.or
                          (i32.eq (local.get $type1) (global.get $TYPE_SYMBOL))
                          (i32.eq (local.get $type1) (global.get $TYPE_EXPRESSION)))))
                  (then (br $exit))
                  (else
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)))))

            ;; Pre-check: bigint mod uses bigint_div (quotient + remainder).
            ;; Rational mod is rarely used but follows rational_add budget.
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_BIGINT))
                  (i32.eq (local.get $type2) (global.get $TYPE_BIGINT)))
              (then
                (if (call $check_heap_overflow
                      (call $estimate_bigint_mul_budget
                        (local.get $value_pointer) (local.get $value_pointer2)))
                  (then
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)))))
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_RATIONAL))
                  (i32.eq (local.get $type2) (global.get $TYPE_RATIONAL)))
              (then
                (if (call $check_heap_overflow
                      (call $estimate_rational_add_budget
                        (local.get $value_pointer) (local.get $value_pointer2)))
                  (then
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)))))
            ;; Cross-type combos.
            (if (i32.or
                  (i32.or
                    (i32.and
                      (i32.eq (local.get $type1) (global.get $TYPE_RATIONAL))
                      (i32.eq (local.get $type2) (global.get $TYPE_BIGINT)))
                    (i32.and
                      (i32.eq (local.get $type1) (global.get $TYPE_BIGINT))
                      (i32.eq (local.get $type2) (global.get $TYPE_RATIONAL))))
                  (i32.or
                    (i32.eq (local.get $type1) (global.get $TYPE_COMPLEX))
                    (i32.eq (local.get $type2) (global.get $TYPE_COMPLEX))))
              (then
                (if (call $check_heap_overflow
                      (call $estimate_cross_type_arith_budget
                        (local.get $value_pointer) (local.get $value_pointer2)))
                  (then
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)))))

            (local.set $value_pointer2 (call $pending_pop))
            (local.set $value_pointer (call $pending_pop))

            ;; BigInt % BigInt
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_BIGINT))
                  (i32.eq (local.get $type2) (global.get $TYPE_BIGINT)))
              (then
                ;; Division by zero → RangeError
                (if (i32.eqz (call $bigint_length
                  (call $value_data_lo (local.get $value_pointer2))))
                  (then
                    (if (call $raise_error (global.get $ERR_RANGE_ERROR) (i32.const 0))
                      (then (br $exit)))
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)
                  )
                )
                ;; Do division (quotient discarded), remainder in scratch
                (drop (call $bigint_div
                  (call $value_data_lo (local.get $value_pointer))
                  (call $value_data_lo (local.get $value_pointer2))))
                (call $push_bigint (call $bigint_last_remainder))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_FLOAT))
                  (i32.eq (local.get $type2) (global.get $TYPE_FLOAT)))
              (then
                ;; a % b = a - trunc(a/b) * b
                (call $push_f64
                  (f64.sub
                    (call $read_f64 (local.get $value_pointer))
                    (f64.mul
                      (f64.trunc
                        (f64.div
                          (call $read_f64 (local.get $value_pointer))
                          (call $read_f64 (local.get $value_pointer2))))
                      (call $read_f64 (local.get $value_pointer2)))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Rational % Rational — when both are inline integer Rationals,
            ;; use i64 modulo directly (no heap allocation). This keeps
            ;; `x % 2 === 0` working in filter-style callbacks where x is an
            ;; integer literal (Rational).
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_RATIONAL))
                  (i32.eq (local.get $type2) (global.get $TYPE_RATIONAL)))
              (then
                (if (i32.and
                      (call $rational_is_inline (local.get $value_pointer))
                      (call $rational_is_inline (local.get $value_pointer2)))
                  (then
                    (local.set $result_i64 (call $rational_read_inline (local.get $value_pointer2)))
                    (if (i64.eqz (local.get $result_i64))
                      (then
                        (if (call $raise_error (global.get $ERR_RANGE_ERROR) (i32.const 0))
                          (then (br $exit)))
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop)
                      )
                    )
                    (call $push_rational_inline
                      (i64.rem_s
                        (call $rational_read_inline (local.get $value_pointer))
                        (local.get $result_i64)))
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )
                ;; Heap path for integer-valued (both denominators = 1)
                (local.set $heap_pointer (call $rational_materialize (local.get $value_pointer)))
                (local.set $element_pointer (call $rational_materialize (local.get $value_pointer2)))
                (if (i32.and
                      (call $rational_denominator_is_one (local.get $heap_pointer))
                      (call $rational_denominator_is_one (local.get $element_pointer)))
                  (then
                    ;; Divisor numerator must be non-zero
                    (if (i32.eqz (call $bigint_length
                          (call $rational_numerator (local.get $element_pointer))))
                      (then
                        (if (call $raise_error (global.get $ERR_RANGE_ERROR) (i32.const 0))
                          (then (br $exit)))
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop)
                      )
                    )
                    ;; Compute a % b via bigint_div (remainder left in scratch).
                    (drop (call $bigint_div
                      (call $rational_numerator (local.get $heap_pointer))
                      (call $rational_numerator (local.get $element_pointer))))
                    (call $push_rational
                      (call $rational_from_bigint (call $bigint_last_remainder)))
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )
                ;; Otherwise fall through to f64 path below.
              )
            )

            ;; Rational/numeric % — coerce to f64 (exact non-integer rational mod is a Phase 2 concern).
            ;; Result is an inline small-Rational if it fits i64; otherwise a Float.
            (if (i32.and
                  (call $value_is_numeric (local.get $value_pointer))
                  (call $value_is_numeric (local.get $value_pointer2)))
              (then
                (call $push_f64
                  (f64.sub
                    (call $value_to_f64 (local.get $value_pointer))
                    (f64.mul
                      (f64.trunc
                        (f64.div
                          (call $value_to_f64 (local.get $value_pointer))
                          (call $value_to_f64 (local.get $value_pointer2))))
                      (call $value_to_f64 (local.get $value_pointer2)))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )
            (if (call $raise_error (global.get $ERR_INVALID_OPERAND) (i32.const 0))
              (then (br $exit)))
            (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
            (br $loop)
          )
        )

        (if (i32.eq (local.get $opcode) (global.get $OP_NEG))
          (then
            ;; Peek operand first for pre-check.
            (local.set $value_pointer
              (i32.sub
                (call $read_ctx (global.get $CTX_PENDING_POINTER))
                (global.get $VALUE_SIZE)))
            ;; JS-spec ToNumber: -"5" → -5, -true → -1, -null → -0,
            ;; -undefined → NaN. Numerics pass through untouched (exact
            ;; negation below); Symbol / Expression stay unconverted and
            ;; reach the TypeError at the bottom.
            (call $coerce_to_number_at (local.get $value_pointer))
            (local.set $type1 (call $value_type (local.get $value_pointer)))

            ;; AlgebraicNumber negation (Ring 6b): in-place slot
            ;; rewrite via p(−x); pressure yields before anything is
            ;; consumed. Renormalisation cannot fire (degree is
            ;; preserved), so the slot stays TYPE_ALGEBRAIC.
            (if (i32.eq (local.get $type1) (global.get $TYPE_ALGEBRAIC))
              (then
                (if (call $algebraic_operator_negate (local.get $value_pointer))
                  (then
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)))

            ;; ComplexAlgebraicNumber negation keeps the operand slot live
            ;; until the exact component rewrite succeeds.
            (if (i32.eq (local.get $type1) (global.get $TYPE_COMPLEX_ALGEBRAIC))
              (then
                (local.set $result_i32
                  (call $complex_algebraic_operator_negate (local.get $value_pointer)))
                (if (i32.eq (local.get $result_i32) (i32.const 1))
                  (then
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)))
                (if (i32.eq (local.get $result_i32) (i32.const 3))
                  (then (br $exit)))
                (if (i32.eq (local.get $result_i32) (i32.const 2))
                  (then
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)))

            ;; Pre-check by type. BigInt: $bigint_add_magnitude allocs
            ;; one bigint. Rational: $rational_materialize + $rational_negate
            ;; alloc ~4 bigints + ~3 rationals. Complex: 2 × rational_negate
            ;; (one per component) + complex wrapper.
            (if (i32.eq (local.get $type1) (global.get $TYPE_BIGINT))
              (then
                (if (call $check_heap_overflow
                      (call $estimate_bigint_neg_budget (local.get $value_pointer)))
                  (then
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)))))
            (if (i32.eq (local.get $type1) (global.get $TYPE_RATIONAL))
              (then
                (if (call $check_heap_overflow
                      (call $estimate_rational_neg_budget (local.get $value_pointer)))
                  (then
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)))))
            (if (i32.eq (local.get $type1) (global.get $TYPE_COMPLEX))
              (then
                (if (call $check_heap_overflow
                      (call $estimate_complex_neg_budget (local.get $value_pointer)))
                  (then
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)))))

            (local.set $value_pointer (call $pending_pop))

            ;; BigInt negation
            (if (i32.eq (local.get $type1) (global.get $TYPE_BIGINT))
              (then
                (local.set $receiver_pointer (call $value_data_lo (local.get $value_pointer)))
                ;; If zero, return zero (no sign flip)
                (if (i32.eqz (call $bigint_length (local.get $receiver_pointer)))
                  (then
                    (call $push_bigint (local.get $receiver_pointer))
                  )
                  (else
                    ;; Copy and flip sign
                    (local.set $heap_pointer (call $bigint_add_magnitude
                      (local.get $receiver_pointer)
                      (call $bigint_alloc (i32.const 0) (i32.const 0))))
                    (i32.store (call $abs (i32.add (local.get $heap_pointer) (global.get $GC_HEADER_SIZE)))
                      (i32.xor (call $bigint_sign (local.get $receiver_pointer)) (i32.const 1)))
                    (call $push_bigint (local.get $heap_pointer))
                  )
                )
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Rational negation
            (if (i32.eq (local.get $type1) (global.get $TYPE_RATIONAL))
              (then
                ;; Inline fast path: negate i64 directly, except for i64.MIN.
                (if (call $rational_is_inline (local.get $value_pointer))
                  (then
                    (local.set $result_i64 (call $rational_read_inline (local.get $value_pointer)))
                    (if (i64.ne (local.get $result_i64)
                          (i64.const 0x8000000000000000))
                      (then
                        (call $push_rational_inline (i64.sub (i64.const 0) (local.get $result_i64)))
                        (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                        (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                        (br $loop)))))
                (call $push_rational
                  (call $rational_negate
                    (call $rational_materialize (local.get $value_pointer))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Complex negation
            (if (i32.eq (local.get $type1) (global.get $TYPE_COMPLEX))
              (then
                (call $push_complex
                  (call $complex_negate
                    (call $value_data_lo (local.get $value_pointer))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            (if (i32.eq (local.get $type1) (global.get $TYPE_FLOAT))
              (then
                (call $push_f64
                  (f64.neg (call $read_f64 (local.get $value_pointer))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )
            ;; Ring 2: Symbol and Expression refuse numeric coercion.
            ;; -sym throws per JS spec; -expression throws by the same rule
            ;; (math-domain object, no implicit numeric projection — user
            ;; calls Exact.Expression.negate(...) to build the Negate tree).
            (if (i32.or
                  (i32.eq (local.get $type1) (global.get $TYPE_SYMBOL))
                  (i32.eq (local.get $type1) (global.get $TYPE_EXPRESSION)))
              (then
                (if (call $throw_type_error_with_type
                      (global.get $BUILTIN_MSG_CANNOT_CONVERT_TO_NUMBER)
                      (local.get $type1))
                  (then (br $exit))
                  (else
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)
                  )
                )
              )
            )
            (if (call $raise_error (global.get $ERR_INVALID_OPERAND) (i32.const 0))
              (then (br $exit)))
            (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
            (br $loop)
          )
        )

        ;; Unary plus: JS-spec ToNumber. Numeric values pass through
        ;; unchanged (preserving type — +Rational stays Rational, same as
        ;; Number(Rational)); Symbol throws TypeError; everything else goes
        ;; through the same conversion rules as METHOD.TO_NUMBER.
        (if (i32.eq (local.get $opcode) (global.get $OP_UPLUS))
          (then
            (local.set $value_pointer (call $pending_pop))
            (local.set $type1 (call $value_type (local.get $value_pointer)))

            ;; Numeric → identity (preserve exact type).
            (if (call $value_is_numeric (local.get $value_pointer))
              (then
                (call $pending_push
                  (local.get $type1)
                  (call $value_flags (local.get $value_pointer))
                  (call $value_data_lo (local.get $value_pointer))
                  (call $value_data_hi (local.get $value_pointer)))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )
            ;; Symbol / Expression → TypeError (JS spec for Symbol; Ring 2
            ;; math-domain rule for Expression).
            (if (i32.or
                  (i32.eq (local.get $type1) (global.get $TYPE_SYMBOL))
                  (i32.eq (local.get $type1) (global.get $TYPE_EXPRESSION)))
              (then
                (if (call $throw_type_error_with_type
                      (global.get $BUILTIN_MSG_CANNOT_CONVERT_TO_NUMBER)
                      (local.get $type1))
                  (then (br $exit))
                  (else
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)
                  )
                )
              )
            )
            ;; undefined → NaN.
            (if (i32.eq (local.get $type1) (global.get $TYPE_UNDEFINED))
              (then
                (call $pending_push (global.get $TYPE_FLOAT) (i32.const 0)
                  (i32.const 0) (i32.const 0x7FF80000))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )
            ;; null → 0.
            (if (i32.eq (local.get $type1) (global.get $TYPE_NULL))
              (then
                (call $push_f64 (f64.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )
            ;; boolean → 0/1.
            (if (i32.eq (local.get $type1) (global.get $TYPE_BOOLEAN))
              (then
                (if (call $value_data_lo (local.get $value_pointer))
                  (then (call $push_f64 (f64.const 1)))
                  (else (call $push_f64 (f64.const 0))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )
            (if (i32.eq (local.get $type1) (global.get $TYPE_STRING))
              (then
                (if (i32.eqz (i32.load (call $string_id_to_abs (call $value_data_lo (local.get $value_pointer)))))
                  (then (call $push_f64 (f64.const 0)))
                  (else (call $push_f64 (call $parse_float (call $value_data_lo (local.get $value_pointer))))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )
            ;; Objects / Arrays / everything else → NaN (matches JS after
            ;; ToPrimitive hint='number' falls through to default toString).
            (call $pending_push (global.get $TYPE_FLOAT) (i32.const 0)
              (i32.const 0) (i32.const 0x7FF80000))
            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        (if (i32.eq (local.get $opcode) (global.get $OP_POW))
          (then
            ;; Peek operands first for pre-check.
            (local.set $value_pointer2
              (i32.sub
                (call $read_ctx (global.get $CTX_PENDING_POINTER))
                (global.get $VALUE_SIZE)))
            (local.set $value_pointer
              (i32.sub
                (call $read_ctx (global.get $CTX_PENDING_POINTER))
                (i32.mul (global.get $VALUE_SIZE) (i32.const 2))))
            (call $coerce_to_number_at (local.get $value_pointer))
            (call $coerce_to_number_at (local.get $value_pointer2))
            (local.set $type1 (call $value_type (local.get $value_pointer)))
            (local.set $type2 (call $value_type (local.get $value_pointer2)))

            ;; Symbol / Expression refuse numeric coercion — same
            ;; messaged TypeError as OP_SUB (see comment there).
            (if (i32.or
                  (i32.or
                    (i32.eq (local.get $type1) (global.get $TYPE_SYMBOL))
                    (i32.eq (local.get $type1) (global.get $TYPE_EXPRESSION)))
                  (i32.or
                    (i32.eq (local.get $type2) (global.get $TYPE_SYMBOL))
                    (i32.eq (local.get $type2) (global.get $TYPE_EXPRESSION))))
              (then
                (drop (call $pending_pop))
                (drop (call $pending_pop))
                (if (call $throw_type_error_with_type
                      (global.get $BUILTIN_MSG_CANNOT_CONVERT_TO_NUMBER)
                      (select (local.get $type1) (local.get $type2)
                        (i32.or
                          (i32.eq (local.get $type1) (global.get $TYPE_SYMBOL))
                          (i32.eq (local.get $type1) (global.get $TYPE_EXPRESSION)))))
                  (then (br $exit))
                  (else
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)))))

            ;; Pre-check: POW-specific budget. $bigint_pow / $rational_pow /
            ;; $complex_pow run their whole square-and-multiply inside
            ;; THIS instruction with no interior bounds checks, so the
            ;; budget must cover the full chain of intermediates — a
            ;; mul-shaped bound (one squaring step) let large exponents
            ;; carve straight through the code block
            ;; unless the whole-operation budget is checked first.
            ;; bounds by the RESULT size, dispatching on both operand
            ;; types, and saturates for absurd exponents so the check
            ;; refuses cleanly.
            (if (i32.or
                  (i32.or
                    (i32.eq (local.get $type1) (global.get $TYPE_BIGINT))
                    (i32.eq (local.get $type1) (global.get $TYPE_RATIONAL)))
                  (i32.or
                    (i32.eq (local.get $type1) (global.get $TYPE_COMPLEX))
                    (i32.or
                      (i32.eq (local.get $type2) (global.get $TYPE_BIGINT))
                      (i32.or
                        (i32.eq (local.get $type2) (global.get $TYPE_RATIONAL))
                        (i32.eq (local.get $type2) (global.get $TYPE_COMPLEX))))))
              (then
                (if (call $check_heap_overflow
                      (call $estimate_pow_budget
                        (local.get $value_pointer) (local.get $value_pointer2)))
                  (then
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)))))

            (local.set $value_pointer2 (call $pending_pop))
            (local.set $value_pointer (call $pending_pop))

            ;; BigInt ** BigInt
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_BIGINT))
                  (i32.eq (local.get $type2) (global.get $TYPE_BIGINT)))
              (then
                ;; Negative exponent → RangeError
                (if (i32.ne (call $bigint_sign
                  (call $value_data_lo (local.get $value_pointer2))) (i32.const 0))
                  (then
                    (if (call $raise_error (global.get $ERR_RANGE_ERROR) (i32.const 0))
                      (then (br $exit)))
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)
                  )
                )
                (call $push_bigint
                  (call $bigint_pow
                    (call $value_data_lo (local.get $value_pointer))
                    (call $value_data_lo (local.get $value_pointer2))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Rational ** BigInt (non-negative integer exponent)
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_RATIONAL))
                  (i32.eq (local.get $type2) (global.get $TYPE_BIGINT)))
              (then
                (if (i32.ne (call $bigint_sign
                  (call $value_data_lo (local.get $value_pointer2))) (i32.const 0))
                  (then
                    (if (call $raise_error (global.get $ERR_RANGE_ERROR) (i32.const 0))
                      (then (br $exit)))
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)
                  )
                )
                (call $push_rational
                  (call $rational_pow
                    (call $rational_materialize (local.get $value_pointer))
                    (call $value_data_lo (local.get $value_pointer2))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Rational ** Rational — only valid when exponent is a non-negative integer
            ;; (denominator == 1, numerator >= 0). Materialize exponent numerator as a
            ;; BigInt, then dispatch through rational_pow.
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_RATIONAL))
                  (i32.eq (local.get $type2) (global.get $TYPE_RATIONAL)))
              (then
                (local.set $heap_pointer (call $rational_materialize (local.get $value_pointer2)))
                (if (i32.eqz (call $rational_denominator_is_one (local.get $heap_pointer)))
                  (then
                    (if (call $raise_error (global.get $ERR_RANGE_ERROR) (i32.const 0))
                      (then (br $exit)))
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)
                  )
                )
                ;; exponent BigInt (numerator of the denom-1 Rational)
                (local.set $element_pointer (call $rational_numerator (local.get $heap_pointer)))
                (if (i32.ne (call $bigint_sign (local.get $element_pointer)) (i32.const 0))
                  (then
                    (if (call $raise_error (global.get $ERR_RANGE_ERROR) (i32.const 0))
                      (then (br $exit)))
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)
                  )
                )
                (call $push_rational
                  (call $rational_pow
                    (call $rational_materialize (local.get $value_pointer))
                    (local.get $element_pointer)))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Complex ** BigInt (non-negative integer exponent)
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_COMPLEX))
                  (i32.eq (local.get $type2) (global.get $TYPE_BIGINT)))
              (then
                (if (i32.ne (call $bigint_sign
                  (call $value_data_lo (local.get $value_pointer2))) (i32.const 0))
                  (then
                    (if (call $raise_error (global.get $ERR_RANGE_ERROR) (i32.const 0))
                      (then (br $exit)))
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)
                  )
                )
                (call $push_complex
                  (call $complex_pow
                    (call $value_data_lo (local.get $value_pointer))
                    (call $value_data_lo (local.get $value_pointer2))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_FLOAT))
                  (i32.eq (local.get $type2) (global.get $TYPE_FLOAT)))
              (then
                (call $push_f64
                  (call $pow
                    (call $read_f64 (local.get $value_pointer))
                    (call $read_f64 (local.get $value_pointer2))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Rational/Float mix → f64 pow
            (if (i32.or
                  (i32.and
                    (i32.eq (local.get $type1) (global.get $TYPE_RATIONAL))
                    (i32.eq (local.get $type2) (global.get $TYPE_FLOAT)))
                  (i32.and
                    (i32.eq (local.get $type1) (global.get $TYPE_FLOAT))
                    (i32.eq (local.get $type2) (global.get $TYPE_RATIONAL))))
              (then
                (call $push_f64
                  (call $pow
                    (call $value_to_f64 (local.get $value_pointer))
                    (call $value_to_f64 (local.get $value_pointer2))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; BigInt/Float mix → f64 pow
            (if (i32.or
                  (i32.and
                    (i32.eq (local.get $type1) (global.get $TYPE_BIGINT))
                    (i32.eq (local.get $type2) (global.get $TYPE_FLOAT)))
                  (i32.and
                    (i32.eq (local.get $type1) (global.get $TYPE_FLOAT))
                    (i32.eq (local.get $type2) (global.get $TYPE_BIGINT))))
              (then
                (call $push_f64
                  (call $pow
                    (call $value_to_f64 (local.get $value_pointer))
                    (call $value_to_f64 (local.get $value_pointer2))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            (if (call $raise_error (global.get $ERR_INVALID_OPERAND) (i32.const 0))
              (then (br $exit)))
            (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
            (br $loop)
          )
        )

        ;; =====================================================================
        ;; BITWISE OPERATORS
        ;; =====================================================================

        ;; BAND: bitwise AND
        (if (i32.eq (local.get $opcode) (global.get $OP_BAND))
          (then
            ;; Peek operands first for pre-check.
            (local.set $value_pointer2
              (i32.sub
                (call $read_ctx (global.get $CTX_PENDING_POINTER))
                (global.get $VALUE_SIZE)))
            (local.set $value_pointer
              (i32.sub
                (call $read_ctx (global.get $CTX_PENDING_POINTER))
                (i32.mul (global.get $VALUE_SIZE) (i32.const 2))))
            (call $coerce_to_number_at (local.get $value_pointer))
            (call $coerce_to_number_at (local.get $value_pointer2))
            (local.set $type1 (call $value_type (local.get $value_pointer)))
            (local.set $type2 (call $value_type (local.get $value_pointer2)))

            ;; After ToNumber coercion only Float / Rational / BigInt /
            ;; Complex / Symbol / Expression remain. None of the last
            ;; three has an integer projection for bitwise/shift ops —
            ;; throw rather than letting value_to_f64 silently read 0.
            (if (i32.or
                  (i32.eqz (call $value_is_numeric (local.get $value_pointer)))
                  (i32.eqz (call $value_is_numeric (local.get $value_pointer2))))
              (then
                (drop (call $pending_pop))
                (drop (call $pending_pop))
                (if (call $throw_type_error_with_type
                      (global.get $BUILTIN_MSG_CANNOT_CONVERT_TO_NUMBER)
                      (select (local.get $type2) (local.get $type1)
                        (call $value_is_numeric (local.get $value_pointer))))
                  (then (br $exit))
                  (else
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)))))

            ;; BigInt: $bigint_bitwise_op allocates one bigint of max(la,lb) limbs.
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_BIGINT))
                  (i32.eq (local.get $type2) (global.get $TYPE_BIGINT)))
              (then
                (if (call $check_heap_overflow
                      (call $estimate_bigint_add_budget
                        (local.get $value_pointer) (local.get $value_pointer2)))
                  (then
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)))))

            (local.set $value_pointer2 (call $pending_pop))
            (local.set $value_pointer (call $pending_pop))

            ;; BigInt & BigInt — limb-by-limb AND (positive only for now)
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_BIGINT))
                  (i32.eq (local.get $type2) (global.get $TYPE_BIGINT)))
              (then
                (call $push_bigint
                  (call $bigint_bitwise_op
                    (call $value_data_lo (local.get $value_pointer))
                    (call $value_data_lo (local.get $value_pointer2))
                    (i32.const 0)))  ;; 0 = AND
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            (call $push_f64 (f64.convert_i32_s
              (i32.and
                (call $f64_to_int32 (call $value_to_f64 (local.get $value_pointer)))
                (call $f64_to_int32 (call $value_to_f64 (local.get $value_pointer2))))))
            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; BOR: bitwise OR
        (if (i32.eq (local.get $opcode) (global.get $OP_BOR))
          (then
            ;; Peek operands first for pre-check.
            (local.set $value_pointer2
              (i32.sub
                (call $read_ctx (global.get $CTX_PENDING_POINTER))
                (global.get $VALUE_SIZE)))
            (local.set $value_pointer
              (i32.sub
                (call $read_ctx (global.get $CTX_PENDING_POINTER))
                (i32.mul (global.get $VALUE_SIZE) (i32.const 2))))
            (call $coerce_to_number_at (local.get $value_pointer))
            (call $coerce_to_number_at (local.get $value_pointer2))
            (local.set $type1 (call $value_type (local.get $value_pointer)))
            (local.set $type2 (call $value_type (local.get $value_pointer2)))

            ;; Non-numeric after coercion (Complex / Symbol / Expression)
            ;; refuses integer projection — see OP_BAND comment.
            (if (i32.or
                  (i32.eqz (call $value_is_numeric (local.get $value_pointer)))
                  (i32.eqz (call $value_is_numeric (local.get $value_pointer2))))
              (then
                (drop (call $pending_pop))
                (drop (call $pending_pop))
                (if (call $throw_type_error_with_type
                      (global.get $BUILTIN_MSG_CANNOT_CONVERT_TO_NUMBER)
                      (select (local.get $type2) (local.get $type1)
                        (call $value_is_numeric (local.get $value_pointer))))
                  (then (br $exit))
                  (else
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)))))

            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_BIGINT))
                  (i32.eq (local.get $type2) (global.get $TYPE_BIGINT)))
              (then
                (if (call $check_heap_overflow
                      (call $estimate_bigint_add_budget
                        (local.get $value_pointer) (local.get $value_pointer2)))
                  (then
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)))))

            (local.set $value_pointer2 (call $pending_pop))
            (local.set $value_pointer (call $pending_pop))

            ;; BigInt | BigInt
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_BIGINT))
                  (i32.eq (local.get $type2) (global.get $TYPE_BIGINT)))
              (then
                (call $push_bigint
                  (call $bigint_bitwise_op
                    (call $value_data_lo (local.get $value_pointer))
                    (call $value_data_lo (local.get $value_pointer2))
                    (i32.const 1)))  ;; 1 = OR
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            (call $push_f64 (f64.convert_i32_s
              (i32.or
                (call $f64_to_int32 (call $value_to_f64 (local.get $value_pointer)))
                (call $f64_to_int32 (call $value_to_f64 (local.get $value_pointer2))))))
            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; BXOR: bitwise XOR
        (if (i32.eq (local.get $opcode) (global.get $OP_BXOR))
          (then
            ;; Peek operands first for pre-check.
            (local.set $value_pointer2
              (i32.sub
                (call $read_ctx (global.get $CTX_PENDING_POINTER))
                (global.get $VALUE_SIZE)))
            (local.set $value_pointer
              (i32.sub
                (call $read_ctx (global.get $CTX_PENDING_POINTER))
                (i32.mul (global.get $VALUE_SIZE) (i32.const 2))))
            (call $coerce_to_number_at (local.get $value_pointer))
            (call $coerce_to_number_at (local.get $value_pointer2))
            (local.set $type1 (call $value_type (local.get $value_pointer)))
            (local.set $type2 (call $value_type (local.get $value_pointer2)))

            ;; Non-numeric after coercion (Complex / Symbol / Expression)
            ;; refuses integer projection — see OP_BAND comment.
            (if (i32.or
                  (i32.eqz (call $value_is_numeric (local.get $value_pointer)))
                  (i32.eqz (call $value_is_numeric (local.get $value_pointer2))))
              (then
                (drop (call $pending_pop))
                (drop (call $pending_pop))
                (if (call $throw_type_error_with_type
                      (global.get $BUILTIN_MSG_CANNOT_CONVERT_TO_NUMBER)
                      (select (local.get $type2) (local.get $type1)
                        (call $value_is_numeric (local.get $value_pointer))))
                  (then (br $exit))
                  (else
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)))))

            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_BIGINT))
                  (i32.eq (local.get $type2) (global.get $TYPE_BIGINT)))
              (then
                (if (call $check_heap_overflow
                      (call $estimate_bigint_add_budget
                        (local.get $value_pointer) (local.get $value_pointer2)))
                  (then
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)))))

            (local.set $value_pointer2 (call $pending_pop))
            (local.set $value_pointer (call $pending_pop))

            ;; BigInt ^ BigInt
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_BIGINT))
                  (i32.eq (local.get $type2) (global.get $TYPE_BIGINT)))
              (then
                (call $push_bigint
                  (call $bigint_bitwise_op
                    (call $value_data_lo (local.get $value_pointer))
                    (call $value_data_lo (local.get $value_pointer2))
                    (i32.const 2)))  ;; 2 = XOR
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            (call $push_f64 (f64.convert_i32_s
              (i32.xor
                (call $f64_to_int32 (call $value_to_f64 (local.get $value_pointer)))
                (call $f64_to_int32 (call $value_to_f64 (local.get $value_pointer2))))))
            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; BNOT: bitwise NOT (unary)
        ;; For BigInt: ~x = -(x + 1n)
        (if (i32.eq (local.get $opcode) (global.get $OP_BNOT))
          (then
            ;; Peek operand first for pre-check.
            (local.set $value_pointer
              (i32.sub
                (call $read_ctx (global.get $CTX_PENDING_POINTER))
                (global.get $VALUE_SIZE)))
            (call $coerce_to_number_at (local.get $value_pointer))
            (local.set $type1 (call $value_type (local.get $value_pointer)))

            ;; Non-numeric after coercion (Complex / Symbol / Expression)
            ;; refuses integer projection — see OP_BAND comment.
            (if (i32.eqz (call $value_is_numeric (local.get $value_pointer)))
              (then
                (drop (call $pending_pop))
                (if (call $throw_type_error_with_type
                      (global.get $BUILTIN_MSG_CANNOT_CONVERT_TO_NUMBER)
                      (local.get $type1))
                  (then (br $exit))
                  (else
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)))))

            ;; Pre-check: $bigint_alloc(1) + $bigint_add (max+1 limbs).
            ;; Use neg budget (single bigint of N+1 limbs).
            (if (i32.eq (local.get $type1) (global.get $TYPE_BIGINT))
              (then
                (if (call $check_heap_overflow
                      (call $estimate_bigint_neg_budget (local.get $value_pointer)))
                  (then
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)))))

            (local.set $value_pointer (call $pending_pop))

            (if (i32.eq (local.get $type1) (global.get $TYPE_BIGINT))
              (then
                ;; ~x = -(x + 1n)
                ;; Create 1n
                (local.set $heap_pointer (call $bigint_alloc (i32.const 0) (i32.const 1)))
                (call $bigint_set_limb (local.get $heap_pointer) (i32.const 0) (i32.const 1))
                ;; x + 1n
                (local.set $heap_pointer (call $bigint_add
                  (call $value_data_lo (local.get $value_pointer))
                  (local.get $heap_pointer)))
                ;; negate: flip sign
                (if (i32.ne (call $bigint_length (local.get $heap_pointer)) (i32.const 0))
                  (then
                    (i32.store (call $abs (i32.add (local.get $heap_pointer) (global.get $GC_HEADER_SIZE)))
                      (i32.xor (call $bigint_sign (local.get $heap_pointer)) (i32.const 1)))
                  )
                )
                (call $push_bigint (local.get $heap_pointer))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            (call $push_f64 (f64.convert_i32_s
              (i32.xor
                (call $f64_to_int32 (call $value_to_f64 (local.get $value_pointer)))
                (i32.const -1))))
            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; SHL: left shift
        (if (i32.eq (local.get $opcode) (global.get $OP_SHL))
          (then
            ;; Peek operands first for pre-check.
            (local.set $value_pointer2
              (i32.sub
                (call $read_ctx (global.get $CTX_PENDING_POINTER))
                (global.get $VALUE_SIZE)))
            (local.set $value_pointer
              (i32.sub
                (call $read_ctx (global.get $CTX_PENDING_POINTER))
                (i32.mul (global.get $VALUE_SIZE) (i32.const 2))))
            (call $coerce_to_number_at (local.get $value_pointer))
            (call $coerce_to_number_at (local.get $value_pointer2))
            (local.set $type1 (call $value_type (local.get $value_pointer)))
            (local.set $type2 (call $value_type (local.get $value_pointer2)))

            ;; Non-numeric after coercion (Complex / Symbol / Expression)
            ;; refuses integer projection — see OP_BAND comment.
            (if (i32.or
                  (i32.eqz (call $value_is_numeric (local.get $value_pointer)))
                  (i32.eqz (call $value_is_numeric (local.get $value_pointer2))))
              (then
                (drop (call $pending_pop))
                (drop (call $pending_pop))
                (if (call $throw_type_error_with_type
                      (global.get $BUILTIN_MSG_CANNOT_CONVERT_TO_NUMBER)
                      (select (local.get $type2) (local.get $type1)
                        (call $value_is_numeric (local.get $value_pointer))))
                  (then (br $exit))
                  (else
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)))))

            ;; Pre-check: $bigint_shift_left allocates old_len + amount/32
            ;; limbs — sized by the shift amount's VALUE. The old
            ;; mul-shaped bound counted the amount's LIMBS (1 for any
            ;; amount < 2^32), so a 100-million-bit shift carved ~12MB
            ;; against a ~64-byte budget
            ;; unless the shift uses a result-size budget.
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_BIGINT))
                  (i32.eq (local.get $type2) (global.get $TYPE_BIGINT)))
              (then
                (if (call $check_heap_overflow
                      (call $estimate_bigint_shift_budget
                        (local.get $value_pointer) (local.get $value_pointer2)))
                  (then
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)))))

            (local.set $value_pointer2 (call $pending_pop))  ;; shift amount
            (local.set $value_pointer (call $pending_pop))   ;; value

            ;; BigInt << BigInt
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_BIGINT))
                  (i32.eq (local.get $type2) (global.get $TYPE_BIGINT)))
              (then
                (call $push_bigint
                  (call $bigint_shift_left
                    (call $value_data_lo (local.get $value_pointer))
                    (call $value_data_lo (local.get $value_pointer2))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            (call $push_f64 (f64.convert_i32_s
              (i32.shl
                (call $f64_to_int32 (call $value_to_f64 (local.get $value_pointer)))
                (i32.and
                  (call $f64_to_int32 (call $value_to_f64 (local.get $value_pointer2)))
                  (i32.const 31)))))
            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; SHR: signed right shift
        (if (i32.eq (local.get $opcode) (global.get $OP_SHR))
          (then
            ;; Peek operands first for pre-check.
            (local.set $value_pointer2
              (i32.sub
                (call $read_ctx (global.get $CTX_PENDING_POINTER))
                (global.get $VALUE_SIZE)))
            (local.set $value_pointer
              (i32.sub
                (call $read_ctx (global.get $CTX_PENDING_POINTER))
                (i32.mul (global.get $VALUE_SIZE) (i32.const 2))))
            (call $coerce_to_number_at (local.get $value_pointer))
            (call $coerce_to_number_at (local.get $value_pointer2))
            (local.set $type1 (call $value_type (local.get $value_pointer)))
            (local.set $type2 (call $value_type (local.get $value_pointer2)))

            ;; Non-numeric after coercion (Complex / Symbol / Expression)
            ;; refuses integer projection — see OP_BAND comment.
            (if (i32.or
                  (i32.eqz (call $value_is_numeric (local.get $value_pointer)))
                  (i32.eqz (call $value_is_numeric (local.get $value_pointer2))))
              (then
                (drop (call $pending_pop))
                (drop (call $pending_pop))
                (if (call $throw_type_error_with_type
                      (global.get $BUILTIN_MSG_CANNOT_CONVERT_TO_NUMBER)
                      (select (local.get $type2) (local.get $type1)
                        (call $value_is_numeric (local.get $value_pointer))))
                  (then (br $exit))
                  (else
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)))))

            ;; Pre-check: $bigint_shift_right allocates one bigint <= la limbs.
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_BIGINT))
                  (i32.eq (local.get $type2) (global.get $TYPE_BIGINT)))
              (then
                (if (call $check_heap_overflow
                      (call $estimate_bigint_add_budget
                        (local.get $value_pointer) (local.get $value_pointer2)))
                  (then
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)))))

            (local.set $value_pointer2 (call $pending_pop))  ;; shift amount
            (local.set $value_pointer (call $pending_pop))   ;; value

            ;; BigInt >> BigInt
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_BIGINT))
                  (i32.eq (local.get $type2) (global.get $TYPE_BIGINT)))
              (then
                (call $push_bigint
                  (call $bigint_shift_right
                    (call $value_data_lo (local.get $value_pointer))
                    (call $value_data_lo (local.get $value_pointer2))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            (call $push_f64 (f64.convert_i32_s
              (i32.shr_s
                (call $f64_to_int32 (call $value_to_f64 (local.get $value_pointer)))
                (i32.and
                  (call $f64_to_int32 (call $value_to_f64 (local.get $value_pointer2)))
                  (i32.const 31)))))
            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; USHR: unsigned right shift (result is always positive)
        (if (i32.eq (local.get $opcode) (global.get $OP_USHR))
          (then
            (local.set $value_pointer2
              (i32.sub
                (call $read_ctx (global.get $CTX_PENDING_POINTER))
                (global.get $VALUE_SIZE)))
            (local.set $value_pointer
              (i32.sub
                (call $read_ctx (global.get $CTX_PENDING_POINTER))
                (i32.mul (global.get $VALUE_SIZE) (i32.const 2))))
            (call $coerce_to_number_at (local.get $value_pointer))
            (call $coerce_to_number_at (local.get $value_pointer2))
            (local.set $type1 (call $value_type (local.get $value_pointer)))
            (local.set $type2 (call $value_type (local.get $value_pointer2)))

            ;; Non-numeric after coercion (Complex / Symbol / Expression)
            ;; refuses integer projection — see OP_BAND comment.
            (if (i32.or
                  (i32.eqz (call $value_is_numeric (local.get $value_pointer)))
                  (i32.eqz (call $value_is_numeric (local.get $value_pointer2))))
              (then
                (drop (call $pending_pop))
                (drop (call $pending_pop))
                (if (call $throw_type_error_with_type
                      (global.get $BUILTIN_MSG_CANNOT_CONVERT_TO_NUMBER)
                      (select (local.get $type2) (local.get $type1)
                        (call $value_is_numeric (local.get $value_pointer))))
                  (then (br $exit))
                  (else
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)))))

            (local.set $value_pointer2 (call $pending_pop))  ;; shift amount
            (local.set $value_pointer (call $pending_pop))   ;; value
            (call $push_f64 (f64.convert_i32_u
              (i32.shr_u
                (call $f64_to_int32 (call $value_to_f64 (local.get $value_pointer)))
                (i32.and
                  (call $f64_to_int32 (call $value_to_f64 (local.get $value_pointer2)))
                  (i32.const 31)))))
            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; =====================================================================
        ;; COMPARISON
        ;; =====================================================================
        (if (i32.eq (local.get $opcode) (global.get $OP_EQ))
          (then
            (local.set $value_pointer2 (call $pending_pop))
            (local.set $value_pointer (call $pending_pop))
            (local.set $type1 (call $value_type (local.get $value_pointer)))
            (local.set $type2 (call $value_type (local.get $value_pointer2)))

            ;; Exact complex-algebraic equality across the complete exact
            ;; real/complex tower.
            (if (call $complex_algebraic_pair_dispatchable
                  (local.get $type1) (local.get $type2))
              (then
                (local.set $result_i32 (call $complex_algebraic_equals_slots
                  (local.get $value_pointer) (local.get $value_pointer2)))
                (if (i32.eq (local.get $result_i32) (i32.const -2))
                  (then
                    (call $write_ctx (global.get $CTX_PENDING_POINTER)
                      (i32.add (local.get $value_pointer)
                        (i32.mul (global.get $VALUE_SIZE) (i32.const 2))))
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)))
                (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0)
                  (local.get $result_i32) (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)))

            ;; AlgebraicNumber equality (Ring 6d): Algebraic joins the
            ;; "number" surface — value equality against Algebraic and
            ;; Rational operands (BigInt mixes stay false per the JS
            ;; 3n === 3 rule; Float mixes stay false at the
            ;; approximation boundary). Pressure restores the popped
            ;; operands and yields.
            (if (i32.or
                  (i32.and
                    (i32.eq (local.get $type1) (global.get $TYPE_ALGEBRAIC))
                    (i32.or
                      (i32.eq (local.get $type2) (global.get $TYPE_ALGEBRAIC))
                      (i32.eq (local.get $type2) (global.get $TYPE_RATIONAL))))
                  (i32.and
                    (i32.eq (local.get $type2) (global.get $TYPE_ALGEBRAIC))
                    (i32.eq (local.get $type1) (global.get $TYPE_RATIONAL))))
              (then
                (local.set $result_i32 (call $algebraic_operator_compare
                  (local.get $value_pointer) (local.get $value_pointer2)))
                (if (i32.eq (local.get $result_i32) (i32.const -2))
                  (then
                    (call $write_ctx (global.get $CTX_PENDING_POINTER)
                      (i32.add (local.get $value_pointer)
                        (i32.mul (global.get $VALUE_SIZE) (i32.const 2))))
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)))
                (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0)
                  (i32.eq (local.get $result_i32) (i32.const 0))
                  (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)))

            ;; Cross-type numeric === : Rational and Float share the JS
            ;; "number" surface but use different heap representations.
