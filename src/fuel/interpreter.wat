  (func (export "test_modpoly_shift_of")
    (param $p_gamma_old i32) (param $gamma_new_apoly i32) (param $s i32) (param $p_gamma_new i32) (result i32)
    (call $algebraic_modpoly_shift_of (local.get $p_gamma_old) (local.get $gamma_new_apoly) (local.get $s) (local.get $p_gamma_new)))
  ;; Full pipeline: registry (raw headers) -> primitive element gamma +
  ;; reps. $registry is a pre-populated array of $registry_count
  ;; AlgebraicNumber headers (caller builds it directly, e.g. via
  ;; scopeLookup on real sandscript-minted values -- no need to run it
  ;; through test_collect_registry's own expression-tree scan for this
  ;; through the expression-tree scan). $reps_out must have capacity
  ;; $registry_count apoly-pointer slots. Returns gamma's header
  ;; directly (0 on pressure; -2 on shift-search limit exceeded --
  ;; distinct sentinels since a real header is never 0 or negative).
  (func (export "test_build_primitive_element")
    (param $registry i32) (param $registry_count i32) (param $reps_out i32) (result i32)
    (local $gamma_out i32)
    (local $status i32)
    (local.set $gamma_out (call $carve_scratch_blob (i32.const 4)))
    (local.set $status (call $algebraic_build_primitive_element
      (local.get $registry) (local.get $registry_count) (local.get $gamma_out) (local.get $reps_out)))
    (if (i32.eq (local.get $status) (i32.const 2)) (then (return (i32.const -2))))
    (if (local.get $status) (then (return (i32.const 0))))
    (i32.load (call $abs (local.get $gamma_out))))
  (func (export "test_build_primitive_element_step")
    (param $gamma_old_header i32) (param $alpha_header i32) (param $s i32)
    (param $reps_out i32) (param $rep_count i32) (result i32)
    (local $gamma_out i32)
    (local $status i32)
    (local.set $gamma_out (call $carve_scratch_blob (i32.const 4)))
    (local.set $status (call $algebraic_build_primitive_element_step
      (local.get $gamma_old_header) (local.get $alpha_header) (local.get $s)
      (local.get $reps_out) (local.get $rep_count) (local.get $gamma_out)))
    (if (local.get $status) (then (return (i32.const 0))))
    (i32.load (call $abs (local.get $gamma_out))))
  (func (export "test_modpoly_shift_of_debug")
    (param $p_gamma_old i32) (param $s i32) (param $p_gamma_new_bigint i32) (result i32)
    (local $p_gamma_new_apoly i32)
    (local $gamma_new_apoly_unit i32)
    (local.set $p_gamma_new_apoly (call $algebraic_apoly_from_bigint_poly (local.get $p_gamma_new_bigint)))
    (if (i32.eqz (local.get $p_gamma_new_apoly)) (then (return (i32.const 0))))
    (local.set $gamma_new_apoly_unit (call $algebraic_apoly_zero_poly (i32.const 1)))
    (if (i32.eqz (local.get $gamma_new_apoly_unit)) (then (return (i32.const 0))))
    (call $algebraic_poly_set_coefficient (local.get $gamma_new_apoly_unit) (i32.const 1)
      (call $rational_new (call $bigint_one) (call $bigint_one)))
    (call $algebraic_modpoly_shift_of (local.get $p_gamma_old) (local.get $gamma_new_apoly_unit) (local.get $s) (local.get $p_gamma_new_apoly)))
  ;; Full pipeline through elimination: canonicalize -> degree ->
  ;; extract-coefficients -> registry -> build_g -> eliminate. Returns
  ;; the FINAL level-1 norm's pointer directly (not wrapped in the
  ;; test_collect_registry-style negative-status encoding, since a
  ;; genuine result is a heap pointer that could collide with small
  ;; negative sentinels) — instead writes a status code via
  ;; $status_out (0 ok / nonzero = the failure code from whichever
  ;; stage failed, offset by stage: canonical/degree/extract failures
  ;; are 100+status, registry collection is 200+status, build_g is
  ;; 300+status, elimination is 400+status).
  (func (export "test_full_norm")
    (param $poly_slot i32) (param $v_slot i32) (param $status_out i32) (result i32)
    (local $stage i32)
    (local $stage2 i32)
    (local $stage_slots i32)
    (local $residual i32)
    (local $degree64 i64)
    (local $degree i32)
    (local $list i32)
    (local $status i32)
    (local $registry i32)
    (local $max_exponents i32)
    (local $count_scratch i32)
    (local $registry_count i32)
    (local $g_out i32)
    (local $norm_out i32)
    (i32.store (call $abs (local.get $status_out)) (i32.const 0))
    (local.set $stage (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (local.set $residual (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (if (call $expression_simplify_into (local.get $poly_slot) (local.get $stage))
      (then (i32.store (call $abs (local.get $status_out)) (i32.const 101)) (return (i32.const 0))))
    (drop (call $poly_measure_factors (local.get $stage)))
    (local.set $stage_slots (global.get $term_factors_count))
    (local.set $stage2 (call $carve_scratch_blob (i32.mul (local.get $stage_slots) (i32.const 16))))
    (local.set $degree64 (call $poly_degree_in
      (local.get $stage) (local.get $v_slot) (local.get $stage2)
      (local.get $stage_slots) (local.get $residual)))
    (if (i64.lt_s (local.get $degree64) (i64.const 0))
      (then (i32.store (call $abs (local.get $status_out)) (i32.const 102)) (return (i32.const 0))))
    (local.set $degree (i32.wrap_i64 (local.get $degree64)))
    (local.set $list (call $carve_scratch_blob
      (i32.mul (i32.add (local.get $degree) (i32.const 1)) (global.get $VALUE_SIZE))))
    (local.set $status (call $poly_extract_coefficients
      (local.get $stage) (local.get $v_slot) (local.get $degree)
      (local.get $list) (local.get $stage2) (local.get $stage_slots)
      (local.get $residual)))
    (if (local.get $status)
      (then (i32.store (call $abs (local.get $status_out)) (i32.add (i32.const 103) (local.get $status))) (return (i32.const 0))))
    (local.set $registry (call $carve_scratch_blob (i32.mul (global.get $ALGEBRAIC_MAX_VARIABLES) (i32.const 4))))
    (local.set $max_exponents (call $carve_scratch_blob (i32.mul (global.get $ALGEBRAIC_MAX_VARIABLES) (i32.const 4))))
    (local.set $count_scratch (call $carve_scratch_blob (i32.const 4)))
    (local.set $status (call $algebraic_collect_variable_registry
      (local.get $list) (local.get $degree) (local.get $registry)
      (local.get $max_exponents) (local.get $count_scratch)))
    (if (local.get $status)
      (then (i32.store (call $abs (local.get $status_out)) (i32.add (i32.const 200) (local.get $status))) (return (i32.const 0))))
    (local.set $registry_count (i32.load (call $abs (local.get $count_scratch))))
    (local.set $g_out (call $carve_scratch_blob (i32.mul (i32.add (local.get $degree) (i32.const 1)) (i32.const 4))))
    (local.set $status (call $algebraic_build_g
      (local.get $list) (local.get $degree)
      (local.get $registry) (local.get $registry_count) (local.get $max_exponents)
      (local.get $g_out)))
    (if (local.get $status)
      (then (i32.store (call $abs (local.get $status_out)) (i32.add (i32.const 300) (local.get $status))) (return (i32.const 0))))
    (local.set $norm_out (call $carve_scratch_blob (i32.const 4)))
    (local.set $status (call $algebraic_eliminate_multivariate
      (local.get $g_out) (local.get $degree) (local.get $registry) (local.get $registry_count)
      (local.get $norm_out)))
    (if (local.get $status)
      (then (i32.store (call $abs (local.get $status_out)) (i32.add (i32.const 400) (local.get $status))) (return (i32.const 0))))
    (i32.load (call $abs (local.get $norm_out))))
  ;; =====================================================================

  ;; Res_y(A, B) of two ypolys, as an xpoly — determinant of the
  ;; Sylvester matrix over ℤ[x] by fraction-free Bareiss elimination
  ;; with row pivoting. Chosen over the subresultant-PRS bookkeeping
  ;; for its unconditional textbook correctness; same fraction-free
  ;; anti-blowup family, and the degrees this ring composes (conic /
  ;; cubic geometry) keep the matrices small. 0 on pressure.
  (func $algebraic_ypoly_resultant (param $a_ypoly i32) (param $b_ypoly i32) (result i32)
    (local $degree_a i32)
    (local $degree_b i32)
    (local $dimension i32)
    (local $matrix i32)
    (local $zero_poly i32)
    (local $row i32)
    (local $column i32)
    (local $k i32)
    (local $i i32)
    (local $j i32)
    (local $pivot i32)
    (local $swap_row i32)
    (local $swap_entry i32)
    (local $sign i32)
    (local $previous i32)
    (local $term1 i32)
    (local $term2 i32)
    (local $entry i32)
    (call $algebraic_ypoly_trim (local.get $a_ypoly))
    (call $algebraic_ypoly_trim (local.get $b_ypoly))
    (local.set $degree_a (call $algebraic_poly_degree (local.get $a_ypoly)))
    (local.set $degree_b (call $algebraic_poly_degree (local.get $b_ypoly)))
    (if (i32.or
          (i32.lt_s (local.get $degree_a) (i32.const 0))
          (i32.lt_s (local.get $degree_b) (i32.const 0)))
      (then (return (call $algebraic_poly_carve (i32.const -1)))))
    ;; Degenerate y-degrees: Res(constant-in-y, B) = A0^deg(B).
    (if (i32.eqz (local.get $degree_a))
      (then (return (call $algebraic_poly_pow_small
        (call $algebraic_poly_coefficient (local.get $a_ypoly) (i32.const 0))
        (local.get $degree_b)))))
    (if (i32.eqz (local.get $degree_b))
      (then (return (call $algebraic_poly_pow_small
        (call $algebraic_poly_coefficient (local.get $b_ypoly) (i32.const 0))
        (local.get $degree_a)))))
    (local.set $dimension (i32.add (local.get $degree_a) (local.get $degree_b)))
    (if (call $expression_walk_guard (i32.add
          (i32.mul (i32.mul (local.get $dimension) (local.get $dimension)) (i32.const 4))
          (i32.const 64)))
      (then (return (i32.const 0))))
    (local.set $matrix (call $carve_scratch_blob
      (i32.mul (i32.mul (local.get $dimension) (local.get $dimension)) (i32.const 4))))
    (local.set $zero_poly (call $algebraic_poly_carve (i32.const -1)))
    (if (i32.eqz (local.get $zero_poly)) (then (return (i32.const 0))))
    ;; Fill with the shared zero polynomial, then lay the Sylvester rows:
    ;; rows 0..degree_b−1 carry A's coefficients (highest first), rows
    ;; degree_b..dimension−1 carry B's.
    (local.set $i (i32.const 0))
    (block $blank_done
      (loop $blank
        (br_if $blank_done (i32.ge_s (local.get $i)
          (i32.mul (local.get $dimension) (local.get $dimension))))
        (i32.store (call $abs (i32.add (local.get $matrix) (i32.mul (local.get $i) (i32.const 4))))
          (local.get $zero_poly))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $blank)))
    (local.set $row (i32.const 0))
    (block $arows_done
      (loop $arows
        (br_if $arows_done (i32.ge_s (local.get $row) (local.get $degree_b)))
        (local.set $k (i32.const 0))
        (block $acols_done
          (loop $acols
            (br_if $acols_done (i32.gt_s (local.get $k) (local.get $degree_a)))
            (i32.store (call $abs (i32.add (local.get $matrix)
              (i32.mul (i32.add (i32.mul (local.get $row) (local.get $dimension))
                (i32.add (local.get $row) (local.get $k))) (i32.const 4))))
              (call $algebraic_poly_coefficient (local.get $a_ypoly)
                (i32.sub (local.get $degree_a) (local.get $k))))
            (local.set $k (i32.add (local.get $k) (i32.const 1)))
            (br $acols)))
        (local.set $row (i32.add (local.get $row) (i32.const 1)))
        (br $arows)))
    (local.set $row (i32.const 0))
    (block $brows_done
      (loop $brows
        (br_if $brows_done (i32.ge_s (local.get $row) (local.get $degree_a)))
        (local.set $k (i32.const 0))
        (block $bcols_done
          (loop $bcols
            (br_if $bcols_done (i32.gt_s (local.get $k) (local.get $degree_b)))
            (i32.store (call $abs (i32.add (local.get $matrix)
              (i32.mul (i32.add
                (i32.mul (i32.add (local.get $row) (local.get $degree_b)) (local.get $dimension))
                (i32.add (local.get $row) (local.get $k))) (i32.const 4))))
              (call $algebraic_poly_coefficient (local.get $b_ypoly)
                (i32.sub (local.get $degree_b) (local.get $k))))
            (local.set $k (i32.add (local.get $k) (i32.const 1)))
            (br $bcols)))
        (local.set $row (i32.add (local.get $row) (i32.const 1)))
        (br $brows)))
    ;; Bareiss elimination.
    (local.set $previous (i32.const 0))
    (local.set $k (i32.const 0))
    (block $eliminate_done
      (loop $eliminate
        (br_if $eliminate_done (i32.ge_s (local.get $k)
          (i32.sub (local.get $dimension) (i32.const 1))))
        (local.set $pivot (i32.load (call $abs (i32.add (local.get $matrix)
          (i32.mul (i32.add (i32.mul (local.get $k) (local.get $dimension)) (local.get $k))
            (i32.const 4))))))
        (if (i32.lt_s (call $algebraic_poly_degree (local.get $pivot)) (i32.const 0))
          (then
            ;; Zero pivot: swap in a lower row with a nonzero entry in
            ;; this column. No such row would mean the resultant is
            ;; identically zero — impossible for the compositions this
            ;; engine is given (their leading coefficients are nonzero
            ;; by construction), so guard it as corruption.
            (local.set $swap_row (i32.add (local.get $k) (i32.const 1)))
            (block $found
              (loop $scan
                (if (i32.ge_s (local.get $swap_row) (local.get $dimension))
                  (then (unreachable)))
                (br_if $found (i32.ge_s
                  (call $algebraic_poly_degree
                    (i32.load (call $abs (i32.add (local.get $matrix)
                      (i32.mul (i32.add (i32.mul (local.get $swap_row) (local.get $dimension))
                        (local.get $k)) (i32.const 4))))))
                  (i32.const 0)))
                (local.set $swap_row (i32.add (local.get $swap_row) (i32.const 1)))
                (br $scan)))
            (local.set $j (i32.const 0))
            (block $swap_done
              (loop $swap
                (br_if $swap_done (i32.ge_s (local.get $j) (local.get $dimension)))
                (local.set $swap_entry (i32.load (call $abs (i32.add (local.get $matrix)
                  (i32.mul (i32.add (i32.mul (local.get $k) (local.get $dimension)) (local.get $j))
                    (i32.const 4))))))
                (i32.store (call $abs (i32.add (local.get $matrix)
                  (i32.mul (i32.add (i32.mul (local.get $k) (local.get $dimension)) (local.get $j))
                    (i32.const 4))))
                  (i32.load (call $abs (i32.add (local.get $matrix)
                    (i32.mul (i32.add (i32.mul (local.get $swap_row) (local.get $dimension))
                      (local.get $j)) (i32.const 4))))))
                (i32.store (call $abs (i32.add (local.get $matrix)
                  (i32.mul (i32.add (i32.mul (local.get $swap_row) (local.get $dimension))
                    (local.get $j)) (i32.const 4))))
                  (local.get $swap_entry))
                (local.set $j (i32.add (local.get $j) (i32.const 1)))
                (br $swap)))
            (local.set $sign (i32.xor (local.get $sign) (i32.const 1)))
            (local.set $pivot (i32.load (call $abs (i32.add (local.get $matrix)
              (i32.mul (i32.add (i32.mul (local.get $k) (local.get $dimension)) (local.get $k))
                (i32.const 4))))))))
        (local.set $i (i32.add (local.get $k) (i32.const 1)))
        (block $irows_done
          (loop $irows
            (br_if $irows_done (i32.ge_s (local.get $i) (local.get $dimension)))
            (local.set $j (i32.add (local.get $k) (i32.const 1)))
            (block $jcols_done
              (loop $jcols
                (br_if $jcols_done (i32.ge_s (local.get $j) (local.get $dimension)))
                (local.set $term1 (call $algebraic_poly_mul (local.get $pivot)
                  (i32.load (call $abs (i32.add (local.get $matrix)
                    (i32.mul (i32.add (i32.mul (local.get $i) (local.get $dimension)) (local.get $j))
                      (i32.const 4)))))))
                (if (i32.eqz (local.get $term1)) (then (return (i32.const 0))))
                (local.set $term2 (call $algebraic_poly_mul
                  (i32.load (call $abs (i32.add (local.get $matrix)
                    (i32.mul (i32.add (i32.mul (local.get $i) (local.get $dimension)) (local.get $k))
                      (i32.const 4)))))
                  (i32.load (call $abs (i32.add (local.get $matrix)
                    (i32.mul (i32.add (i32.mul (local.get $k) (local.get $dimension)) (local.get $j))
                      (i32.const 4)))))))
                (if (i32.eqz (local.get $term2)) (then (return (i32.const 0))))
                (local.set $entry (call $algebraic_poly_sub_poly (local.get $term1) (local.get $term2)))
                (if (i32.eqz (local.get $entry)) (then (return (i32.const 0))))
                (if (i32.and
                      (i32.ne (local.get $previous) (i32.const 0))
                      (i32.ge_s (call $algebraic_poly_degree (local.get $entry)) (i32.const 0)))
                  (then
                    (local.set $entry (call $algebraic_poly_exact_divide
                      (local.get $entry) (local.get $previous)))
                    (if (i32.eqz (local.get $entry)) (then (return (i32.const 0))))
                    (call $algebraic_poly_trim (local.get $entry))))
                (i32.store (call $abs (i32.add (local.get $matrix)
                  (i32.mul (i32.add (i32.mul (local.get $i) (local.get $dimension)) (local.get $j))
                    (i32.const 4))))
                  (local.get $entry))
                (local.set $j (i32.add (local.get $j) (i32.const 1)))
                (br $jcols)))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $irows)))
        (local.set $previous (local.get $pivot))
        (local.set $k (i32.add (local.get $k) (i32.const 1)))
        (br $eliminate)))
    (local.set $entry (i32.load (call $abs (i32.add (local.get $matrix)
      (i32.mul (i32.sub (i32.mul (local.get $dimension) (local.get $dimension)) (i32.const 1))
        (i32.const 4))))))
    (if (local.get $sign)
      (then
        (if (call $expression_walk_guard (i32.const 32))
          (then (return (i32.const 0))))
        (local.set $entry (call $algebraic_poly_scale_down
          (local.get $entry) (call $bigint_one) (i32.const 1)))))
    (local.get $entry)
  )

  ;; Primitive + positive-leading + squarefree normalisation of a
  ;; composition result. Degree ≤ 0 passes through. 0 on pressure.
  (func $algebraic_poly_normalize_squarefree (param $poly i32) (result i32)
    (local $content i32)
    (local $result i32)
    (call $algebraic_poly_trim (local.get $poly))
    (if (i32.le_s (call $algebraic_poly_degree (local.get $poly)) (i32.const 0))
      (then (return (local.get $poly))))
    (local.set $content (call $algebraic_poly_content (local.get $poly)))
    (if (i32.eqz (local.get $content)) (then (return (i32.const 0))))
    (local.set $result (call $algebraic_poly_scale_down
      (local.get $poly) (local.get $content)
      (i32.ne
        (call $bigint_sign (call $algebraic_poly_coefficient
          (local.get $poly) (call $algebraic_poly_degree (local.get $poly))))
        (i32.const 0))))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (local.set $result (call $algebraic_poly_squarefree_part (local.get $result)))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (call $algebraic_poly_trim (local.get $result))
    (local.get $result)
  )

  ;; ----- committed-value bridges --------------------------------------------

  ;; Read a stored coefficients Array (frozen, BigInt slots ascending
  ;; by power) into a scratch polynomial sharing the BigInt headers.
  ;; 0 on pressure.
  (func $algebraic_poly_from_array (param $coefficients_array i32) (result i32)
    (local $length i32)
    (local $data i32)
    (local $poly i32)
    (local $i i32)
    (local.set $length (i32.load (call $abs (i32.add (local.get $coefficients_array) (i32.const 8)))))
    (local.set $data (i32.add
      (i32.load (call $abs (i32.add (local.get $coefficients_array) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (local.set $poly (call $algebraic_poly_carve (i32.sub (local.get $length) (i32.const 1))))
    (if (i32.eqz (local.get $poly)) (then (return (i32.const 0))))
    (local.set $i (i32.const 0))
    (block $done
      (loop $read
        (br_if $done (i32.ge_s (local.get $i) (local.get $length)))
        (call $algebraic_poly_set_coefficient (local.get $poly) (local.get $i)
          (call $value_data_lo (i32.add (local.get $data)
            (i32.mul (local.get $i) (global.get $VALUE_SIZE)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $read)))
    (local.get $poly)
  )

  ;; (a + b) / 2 over rational HEADERS, normalised. 0 on pressure.
  (func $algebraic_rational_midpoint (param $a i32) (param $b i32) (result i32)
    (local $sum i32)
    (if (call $expression_walk_guard (i32.mul (i32.const 6)
          (call $estimate_bigint_size (i32.add
            (i32.add
              (call $bigint_length (call $rational_numerator (local.get $a)))
              (call $bigint_length (call $rational_denominator (local.get $a))))
            (i32.add
              (i32.add
                (call $bigint_length (call $rational_numerator (local.get $b)))
                (call $bigint_length (call $rational_denominator (local.get $b))))
              (i32.const 4))))))
      (then (return (i32.const 0))))
    (local.set $sum (call $rational_add (local.get $a) (local.get $b)))
    (call $rational_new
      (call $rational_numerator (local.get $sum))
      (call $bigint_mul
        (call $rational_denominator (local.get $sum))
        (call $bigint_from_i64 (i64.const 2))))
  )

  ;; One bisection step on a stored interval, in place. Retry-safe: the
  ;; interval invariant (exactly one root, nonzero endpoints) holds
  ;; after every step. Returns 0 ok / 1 pressure.
  (func $algebraic_refine_step (param $header i32) (result i32)
    (local $interval_data i32)
    (local $low_slot i32)
    (local $high_slot i32)
    (local $low i32)
    (local $high i32)
    (local $poly i32)
    (local $mid i32)
    (local $mid_sign i32)
    (local $low_sign i32)
    (local $narrowed i32)
    (if (i32.eqz (i32.load (call $abs
          (i32.add (local.get $header) (global.get $GC_HEADER_SIZE)))))
      (then
        (if (call $algebraic_materialize_standalone_cache (local.get $header))
          (then (return (i32.const 1))))))
    (local.set $interval_data (i32.add
      (i32.load (call $abs (i32.add
        (call $algebraic_interval_of (local.get $header)) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (local.set $low_slot (local.get $interval_data))
    (local.set $high_slot (i32.add (local.get $interval_data) (global.get $VALUE_SIZE)))
    (if (call $expression_walk_guard (i32.const 256))
      (then (return (i32.const 1))))
    (local.set $low (call $rational_materialize (local.get $low_slot)))
    (local.set $high (call $rational_materialize (local.get $high_slot)))
    (local.set $poly (call $algebraic_poly_from_array
      (call $algebraic_coefficients_of (local.get $header))))
    (if (i32.eqz (local.get $poly)) (then (return (i32.const 1))))
    (local.set $mid (call $algebraic_rational_midpoint (local.get $low) (local.get $high)))
    (if (i32.eqz (local.get $mid)) (then (return (i32.const 1))))
    (local.set $mid_sign (call $algebraic_sign_at (local.get $poly)
      (call $rational_numerator (local.get $mid))
      (call $rational_denominator (local.get $mid))))
    (if (i32.eq (local.get $mid_sign) (i32.const 2)) (then (return (i32.const 1))))
    (if (i32.eqz (local.get $mid_sign))
      (then
        ;; The interval's root IS mid — a rational value. Reachable
        ;; whenever the represented value is a rational unhit by
        ;; isolation (refining x²−1's (0, 4) interval bisects onto 1):
        ;; narrow to the middle half-band around mid, which still
        ;; contains the root and halves the width. The new endpoints
        ;; differ from mid, and mid is the only root inside, so they
        ;; evaluate nonzero.
        (local.set $narrowed (call $algebraic_rational_midpoint (local.get $low) (local.get $mid)))
        (if (i32.eqz (local.get $narrowed)) (then (return (i32.const 1))))
        (call $write_value (local.get $low_slot)
          (global.get $TYPE_RATIONAL) (i32.const 0) (local.get $narrowed) (i32.const 0))
        (local.set $narrowed (call $algebraic_rational_midpoint (local.get $mid) (local.get $high)))
        (if (i32.eqz (local.get $narrowed)) (then (return (i32.const 1))))
        (call $write_value (local.get $high_slot)
          (global.get $TYPE_RATIONAL) (i32.const 0) (local.get $narrowed) (i32.const 0))
        (return (i32.const 0))))
    (local.set $low_sign (call $algebraic_sign_at (local.get $poly)
      (call $rational_numerator (local.get $low))
      (call $rational_denominator (local.get $low))))
    (if (i32.eq (local.get $low_sign) (i32.const 2)) (then (return (i32.const 1))))
    (if (i32.eq (local.get $mid_sign) (local.get $low_sign))
      (then
        ;; No crossing in (low, mid): the root is right of mid.
        (call $write_value (local.get $low_slot)
          (global.get $TYPE_RATIONAL) (i32.const 0) (local.get $mid) (i32.const 0)))
      (else
        (call $write_value (local.get $high_slot)
          (global.get $TYPE_RATIONAL) (i32.const 0) (local.get $mid) (i32.const 0))))
    (i32.const 0)
  )

  ;; Compare an AlgebraicNumber against a rational. Materialize the standalone
  ;; polynomial cache at this explicit comparison boundary: interval refinement
  ;; alone cannot recognize a field coordinate that equals the rational at the
  ;; selected real embedding when the retained compositum modulus is reducible.
  ;; Returns −1/0/1, or −2 on pressure.
  (func $algebraic_compare_with_rational (param $header i32) (param $rational i32) (result i32)
    (local $interval_data i32) (local $low i32) (local $high i32)
    (local $poly i32) (local $sign_at_rational i32) (local $sign_at_low i32)
    (local $status i32)
    (if (i32.eqz (i32.load (call $abs
          (i32.add (local.get $header) (global.get $GC_HEADER_SIZE)))))
      (then
        (local.set $status (call $algebraic_materialize_standalone_cache
          (local.get $header)))
        (if (local.get $status) (then (return (i32.const -2))))))
    (local.set $interval_data (i32.add
      (i32.load (call $abs (i32.add
        (call $algebraic_interval_of (local.get $header)) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (if (call $expression_walk_guard (i32.const 256))
      (then (return (i32.const -2))))
    (local.set $low (call $rational_materialize (local.get $interval_data)))
    (local.set $high (call $rational_materialize
      (i32.add (local.get $interval_data) (global.get $VALUE_SIZE))))
    (if (i32.le_s (call $rational_header_pair_compare (local.get $rational) (local.get $low))
          (i32.const 0))
      (then (return (i32.const 1))))
    (if (i32.ge_s (call $rational_header_pair_compare (local.get $rational) (local.get $high))
          (i32.const 0))
      (then (return (i32.const -1))))
    (local.set $poly (call $algebraic_poly_from_array
      (call $algebraic_coefficients_of (local.get $header))))
    (if (i32.eqz (local.get $poly)) (then (return (i32.const -2))))
    (local.set $sign_at_rational (call $algebraic_sign_at (local.get $poly)
      (call $rational_numerator (local.get $rational))
      (call $rational_denominator (local.get $rational))))
    (if (i32.eq (local.get $sign_at_rational) (i32.const 2)) (then (return (i32.const -2))))
    (if (i32.eqz (local.get $sign_at_rational)) (then (return (i32.const 0))))
    (local.set $sign_at_low (call $algebraic_sign_at (local.get $poly)
      (call $rational_numerator (local.get $low))
      (call $rational_denominator (local.get $low))))
    (if (i32.eq (local.get $sign_at_low) (i32.const 2)) (then (return (i32.const -2))))
    (if (i32.eq (local.get $sign_at_rational) (local.get $sign_at_low))
      (then (return (i32.const 1))))
    (i32.const -1)
  )

  ;; Compare two AlgebraicNumbers: equality is decided once via
  ;; gcd(defining polynomials) having a root in the interval overlap
  ;; (Sturm count); inequality refines both intervals until they are
  ;; disjoint. Returns −1/0/1, or −2 on pressure.
  (func $algebraic_compare_algebraic (param $a i32) (param $b i32) (result i32)
    (local $a_data i32)
    (local $b_data i32)
    (local $a_low i32)
    (local $a_high i32)
    (local $b_low i32)
    (local $b_high i32)
    (local $poly_a i32)
    (local $poly_b i32)
    (local $gcd i32)
    (local $chain i32)
    (local $overlap_low i32)
    (local $overlap_high i32)
    (local $variations_low i32)
    (local $variations_high i32)
    (local $checked_equality i32)
    (if (i32.eqz (i32.load (call $abs
          (i32.add (local.get $a) (global.get $GC_HEADER_SIZE)))))
      (then
        (if (call $algebraic_materialize_standalone_cache (local.get $a))
          (then (return (i32.const -2))))))
    (if (i32.eqz (i32.load (call $abs
          (i32.add (local.get $b) (global.get $GC_HEADER_SIZE)))))
      (then
        (if (call $algebraic_materialize_standalone_cache (local.get $b))
          (then (return (i32.const -2))))))
    (if (i32.eq (local.get $a) (local.get $b)) (then (return (i32.const 0))))
    (block $decided
      (loop $narrow
        (local.set $a_data (i32.add
          (i32.load (call $abs (i32.add
            (call $algebraic_interval_of (local.get $a)) (i32.const 16))))
          (global.get $GC_HEADER_SIZE)))
        (local.set $b_data (i32.add
          (i32.load (call $abs (i32.add
            (call $algebraic_interval_of (local.get $b)) (i32.const 16))))
          (global.get $GC_HEADER_SIZE)))
        (if (call $expression_walk_guard (i32.const 512))
          (then (return (i32.const -2))))
        (local.set $a_low (call $rational_materialize (local.get $a_data)))
        (local.set $a_high (call $rational_materialize
          (i32.add (local.get $a_data) (global.get $VALUE_SIZE))))
        (local.set $b_low (call $rational_materialize (local.get $b_data)))
        (local.set $b_high (call $rational_materialize
          (i32.add (local.get $b_data) (global.get $VALUE_SIZE))))
        (if (i32.le_s (call $rational_header_pair_compare (local.get $a_high) (local.get $b_low))
              (i32.const 0))
          (then (return (i32.const -1))))
        (if (i32.le_s (call $rational_header_pair_compare (local.get $b_high) (local.get $a_low))
              (i32.const 0))
          (then (return (i32.const 1))))
        (if (i32.eqz (local.get $checked_equality))
          (then
            (local.set $checked_equality (i32.const 1))
            (local.set $poly_a (call $algebraic_poly_from_array
              (call $algebraic_coefficients_of (local.get $a))))
            (if (i32.eqz (local.get $poly_a)) (then (return (i32.const -2))))
            (local.set $poly_b (call $algebraic_poly_from_array
              (call $algebraic_coefficients_of (local.get $b))))
            (if (i32.eqz (local.get $poly_b)) (then (return (i32.const -2))))
            (local.set $gcd (call $algebraic_poly_gcd (local.get $poly_a) (local.get $poly_b)))
            (if (i32.eqz (local.get $gcd)) (then (return (i32.const -2))))
            (if (i32.ge_s (call $algebraic_poly_degree (local.get $gcd)) (i32.const 1))
              (then
                ;; A gcd root inside the overlap is a common root of
                ;; both defining polynomials lying inside both
                ;; intervals — it must be both values at once.
                (local.set $overlap_low (local.get $a_low))
                (if (i32.gt_s (call $rational_header_pair_compare
                      (local.get $b_low) (local.get $overlap_low)) (i32.const 0))
                  (then (local.set $overlap_low (local.get $b_low))))
                (local.set $overlap_high (local.get $a_high))
                (if (i32.lt_s (call $rational_header_pair_compare
                      (local.get $b_high) (local.get $overlap_high)) (i32.const 0))
                  (then (local.set $overlap_high (local.get $b_high))))
                (local.set $chain (call $algebraic_sturm_build (local.get $gcd)))
                (if (i32.eqz (local.get $chain)) (then (return (i32.const -2))))
                (local.set $variations_low (call $algebraic_variations_at (local.get $chain)
                  (call $rational_numerator (local.get $overlap_low))
                  (call $rational_denominator (local.get $overlap_low))))
                (if (i32.lt_s (local.get $variations_low) (i32.const 0))
                  (then (return (i32.const -2))))
                (local.set $variations_high (call $algebraic_variations_at (local.get $chain)
                  (call $rational_numerator (local.get $overlap_high))
                  (call $rational_denominator (local.get $overlap_high))))
                (if (i32.lt_s (local.get $variations_high) (i32.const 0))
                  (then (return (i32.const -2))))
                (if (i32.ge_s
                      (i32.sub (local.get $variations_low) (local.get $variations_high))
                      (i32.const 1))
                  (then (return (i32.const 0))))))))
        (if (call $algebraic_refine_step (local.get $a))
          (then (return (i32.const -2))))
        (if (call $algebraic_refine_step (local.get $b))
          (then (return (i32.const -2))))
        (br $narrow)))
    (i32.const 0)
  )

  ;; ----- 6b: value-level field arithmetic -----------------------------------

  ;; Guard one heap-path rational operation on two HEADERS (the same
  ;; O(sumLen) accounting as $estimate_rational_add_budget — binary
  ;; gcd, constant object count). 1 on pressure.
  (func $algebraic_rational_guard (param $a i32) (param $b i32) (result i32)
    (local $la i32)
    (local $lb i32)
    (local $len i32)
    (local.set $la (call $bigint_length (call $rational_numerator (local.get $a))))
    (local.set $len (call $bigint_length (call $rational_denominator (local.get $a))))
    (if (i32.gt_u (local.get $len) (local.get $la)) (then (local.set $la (local.get $len))))
    (local.set $lb (call $bigint_length (call $rational_numerator (local.get $b))))
    (local.set $len (call $bigint_length (call $rational_denominator (local.get $b))))
    (if (i32.gt_u (local.get $len) (local.get $lb)) (then (local.set $lb (local.get $len))))
    (call $expression_walk_guard (call $sat_budget_mul (i32.const 32)
      (call $estimate_bigint_size (i32.add
        (i32.add (local.get $la) (local.get $lb)) (i32.const 2)))))
  )

  ;; numerator/2^exponent as a normalised Rational header. 0 on pressure.
  (func $algebraic_dyadic_to_rational (param $numerator i32) (param $exponent i32) (result i32)
    (local $denominator i32)
    (local.set $denominator (call $algebraic_dyadic_denominator (local.get $exponent)))
    (if (i32.eqz (local.get $denominator)) (then (return (i32.const 0))))
    (if (call $expression_walk_guard (call $sat_budget_mul (i32.const 32)
          (call $estimate_bigint_size (i32.add
            (i32.add
              (call $bigint_length (local.get $numerator))
              (call $bigint_length (local.get $denominator)))
            (i32.const 2)))))
      (then (return (i32.const 0))))
    (call $rational_new (local.get $numerator) (local.get $denominator))
  )

  ;; Rational header for an isolation entry's bound: which 0 = low,
  ;; 1 = high (points return the point for both). 0 on pressure.
  (func $algebraic_entry_bound_rational (param $entry i32) (param $which i32) (result i32)
    (if (i32.and
          (local.get $which)
          (i32.eq (i32.load (call $abs (local.get $entry))) (i32.const 1)))
      (then (return (call $algebraic_dyadic_to_rational
        (i32.load (call $abs (i32.add (local.get $entry) (i32.const 12))))
        (i32.load (call $abs (i32.add (local.get $entry) (i32.const 16))))))))
    (call $algebraic_dyadic_to_rational
      (i32.load (call $abs (i32.add (local.get $entry) (i32.const 4))))
      (i32.load (call $abs (i32.add (local.get $entry) (i32.const 8)))))
  )

  ;; Compare numerator/2^exponent with a Rational header without committing
  ;; any heap objects. The power-of-two denominator and cross-products live
  ;; only in the uncommitted heap-tail scratch span. −1/0/1; on pressure the
  ;; memory-pressure flag is set and the returned value is a dummy zero.
  (func $algebraic_dyadic_rational_compare
    (param $numerator i32) (param $exponent i32) (param $rational i32)
    (result i32)
    (local $scratch i32)
    (local $denominator_bytes i32)
    (local.set $scratch (call $read_state (global.get $STATE_HEAP_POINTER)))
    (local.set $denominator_bytes
      (call $algebraic_stage_dyadic_denominator
        (local.get $exponent) (local.get $scratch)))
    (if (i32.eqz (local.get $denominator_bytes)) (then (return (i32.const 0))))
    (call $fraction_cross_compare
      (local.get $numerator) (local.get $scratch)
      (call $rational_numerator (local.get $rational))
      (call $rational_denominator (local.get $rational))
      (i32.add (local.get $scratch) (local.get $denominator_bytes)))
  )


  ;; Non-strict overlap of an isolation entry with the closed rational
  ;; interval [s_lo, s_hi]. 1 overlap / 0 disjoint / −1 pressure.
  (func $algebraic_entry_overlap (param $entry i32) (param $s_lo i32) (param $s_hi i32) (result i32)
    (local $kind i32)
    (local $low_comparison i32)
    (local $high_comparison i32)
    (local.set $kind (i32.load (call $abs (local.get $entry))))
    (local.set $low_comparison (call $algebraic_dyadic_rational_compare
      (i32.load (call $abs (i32.add (local.get $entry) (i32.const 4))))
      (i32.load (call $abs (i32.add (local.get $entry) (i32.const 8))))
      (local.get $s_hi)))
    (if (global.get $memory_pressure_signaled) (then (return (i32.const -1))))
    (if (i32.gt_s (local.get $low_comparison) (i32.const 0))
      (then (return (i32.const 0))))
    (if (i32.eq (local.get $kind) (i32.const 1))
      (then
        (local.set $high_comparison (call $algebraic_dyadic_rational_compare
          (i32.load (call $abs (i32.add (local.get $entry) (i32.const 12))))
          (i32.load (call $abs (i32.add (local.get $entry) (i32.const 16))))
          (local.get $s_lo))))
      (else
        (local.set $high_comparison (call $algebraic_dyadic_rational_compare
          (i32.load (call $abs (i32.add (local.get $entry) (i32.const 4))))
          (i32.load (call $abs (i32.add (local.get $entry) (i32.const 8))))
          (local.get $s_lo)))))
    (if (global.get $memory_pressure_signaled) (then (return (i32.const -1))))
    (i32.ge_s (local.get $high_comparison) (i32.const 0))
  )

  ;; One dyadic bisection step on an interval entry (points are left
  ;; alone). A zero midpoint sign converts the entry to an exact
  ;; point. 0 ok / 1 pressure.
  (func $algebraic_entry_bisect (param $poly i32) (param $entry i32) (result i32)
    (local $low_numerator i32)
    (local $low_exponent i32)
    (local $high_numerator i32)
    (local $high_exponent i32)
    (local $lift i32)
    (local $low_lifted i32)
    (local $high_lifted i32)
    (local $mid_numerator i32)
    (local $mid_exponent i32)
    (local $mid_sign i32)
    (local $low_sign i32)
    (if (i32.eqz (i32.load (call $abs (local.get $entry))))
      (then (return (i32.const 0))))
    (local.set $low_numerator (i32.load (call $abs (i32.add (local.get $entry) (i32.const 4)))))
    (local.set $low_exponent (i32.load (call $abs (i32.add (local.get $entry) (i32.const 8)))))
    (local.set $high_numerator (i32.load (call $abs (i32.add (local.get $entry) (i32.const 12)))))
    (local.set $high_exponent (i32.load (call $abs (i32.add (local.get $entry) (i32.const 16)))))
    (local.set $lift (local.get $low_exponent))
    (if (i32.gt_s (local.get $high_exponent) (local.get $lift))
      (then (local.set $lift (local.get $high_exponent))))
    (if (call $expression_walk_guard (i32.mul (i32.const 3)
          (call $estimate_bigint_size (i32.add
            (i32.add
              (call $bigint_length (local.get $low_numerator))
              (call $bigint_length (local.get $high_numerator)))
            (i32.add (i32.shr_u (local.get $lift) (i32.const 5)) (i32.const 4))))))
      (then (return (i32.const 1))))
    (local.set $low_lifted (call $bigint_shift_left_bits (local.get $low_numerator)
      (i32.sub (local.get $lift) (local.get $low_exponent))))
    (local.set $high_lifted (call $bigint_shift_left_bits (local.get $high_numerator)
      (i32.sub (local.get $lift) (local.get $high_exponent))))
    (local.set $mid_numerator (call $bigint_add (local.get $low_lifted) (local.get $high_lifted)))
    (local.set $mid_exponent (i32.add (local.get $lift) (i32.const 1)))
    (local.set $mid_sign (call $algebraic_sign_at_dyadic
      (local.get $poly) (local.get $mid_numerator) (local.get $mid_exponent)))
    (if (i32.eq (local.get $mid_sign) (i32.const 2)) (then (return (i32.const 1))))
    (if (i32.eqz (local.get $mid_sign))
      (then
        (i32.store (call $abs (local.get $entry)) (i32.const 0))
        (i32.store (call $abs (i32.add (local.get $entry) (i32.const 4))) (local.get $mid_numerator))
        (i32.store (call $abs (i32.add (local.get $entry) (i32.const 8))) (local.get $mid_exponent))
        (return (i32.const 0))))
    (local.set $low_sign (call $algebraic_sign_at_dyadic
      (local.get $poly) (local.get $low_numerator) (local.get $low_exponent)))
    (if (i32.eq (local.get $low_sign) (i32.const 2)) (then (return (i32.const 1))))
    (if (i32.eq (local.get $mid_sign) (local.get $low_sign))
      (then
        (i32.store (call $abs (i32.add (local.get $entry) (i32.const 4))) (local.get $mid_numerator))
        (i32.store (call $abs (i32.add (local.get $entry) (i32.const 8))) (local.get $mid_exponent)))
      (else
        (i32.store (call $abs (i32.add (local.get $entry) (i32.const 12))) (local.get $mid_numerator))
        (i32.store (call $abs (i32.add (local.get $entry) (i32.const 16))) (local.get $mid_exponent))))
    (i32.const 0)
  )

  ;; Commit a scratch polynomial + rational interval as an
  ;; AlgebraicNumber value in $out_slot — with the renormalisation
  ;; rule: degree 1 lands as the Rational −c0/c1. 0 ok / 1 pressure.
  (func $algebraic_mint_poly_interval
    (param $poly i32) (param $low_header i32) (param $high_header i32)
    (param $known_irreducible i32) (param $out_slot i32)
    (result i32)
    (local $degree i32)
    (local $coefficients_array i32)
    (local $coefficients_data i32)
    (local $interval_array i32)
    (local $interval_data i32)
    (local $i i32)
    (local $factors_out i32)
    (local $factor_count i32)
    (local $candidate_factor i32)
    (local $minimal_factor i32)
    (local $sign_low i32)
    (local $sign_high i32)
    ;; Every persistent field generator needs an irreducible modulus.
    ;; Constructors such as rational-turn trigonometry can hand this mint
    ;; path a squarefree but reducible polynomial, bypassing compose_binary's
    ;; later factor selection. Factor here at the representation boundary and
    ;; retain the unique factor whose root lies in the supplied interval.
    (if (i32.eqz (local.get $known_irreducible))
      (then
    (local.set $factors_out (call $carve_scratch_blob (i32.mul (i32.const 16) (i32.const 4))))
    (local.set $factor_count (call $algebraic_zz_zassenhaus
      (local.get $poly) (local.get $factors_out) (i32.const 16)))
    (if (i32.eq (local.get $factor_count) (i32.const -1))
      (then (return (i32.const 1))))
    ;; A bounded factorization refusal keeps the old standalone
    ;; representation valid, but such a value cannot safely act as a shared
    ;; field generator; current production constructors are required to
    ;; factor successfully and tests pin that invariant.
    (if (i32.or
          (i32.eq (local.get $factor_count) (i32.const -2))
          (i32.eq (local.get $factor_count) (i32.const -3)))
      (then (local.set $factor_count (i32.const 1))))
    (if (i32.gt_s (local.get $factor_count) (i32.const 1))
      (then
        (local.set $minimal_factor (i32.const 0))
        (local.set $i (i32.const 0))
        (block $factor_done
          (loop $factor_loop
            (br_if $factor_done (i32.ge_s (local.get $i) (local.get $factor_count)))
            (local.set $candidate_factor (i32.load (call $abs
              (i32.add (local.get $factors_out) (i32.mul (local.get $i) (i32.const 4))))))
            (local.set $sign_low (call $algebraic_sign_at
              (local.get $candidate_factor)
              (call $rational_numerator (local.get $low_header))
              (call $rational_denominator (local.get $low_header))))
            (if (i32.eq (local.get $sign_low) (i32.const 2))
              (then (return (i32.const 1))))
            (local.set $sign_high (call $algebraic_sign_at
              (local.get $candidate_factor)
              (call $rational_numerator (local.get $high_header))
              (call $rational_denominator (local.get $high_header))))
            (if (i32.eq (local.get $sign_high) (i32.const 2))
              (then (return (i32.const 1))))
            (if (i32.or
                  (i32.ne (local.get $sign_low) (local.get $sign_high))
                  (i32.eqz (local.get $sign_low)))
              (then
                (local.set $minimal_factor (local.get $candidate_factor))
                (br $factor_done)))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $factor_loop)))
        (if (i32.eqz (local.get $minimal_factor)) (then (unreachable)))
        (local.set $poly (local.get $minimal_factor))))
      ))
    (local.set $degree (call $algebraic_poly_degree (local.get $poly)))
    (if (i32.le_s (local.get $degree) (i32.const 0)) (then (unreachable)))
    (if (i32.eq (local.get $degree) (i32.const 1))
      (then
        (if (call $expression_walk_guard (i32.mul (i32.const 3)
              (call $estimate_bigint_size (i32.add
                (i32.add
                  (call $bigint_length (call $algebraic_poly_coefficient (local.get $poly) (i32.const 0)))
                  (call $bigint_length (call $algebraic_poly_coefficient (local.get $poly) (i32.const 1))))
                (i32.const 2)))))
          (then (return (i32.const 1))))
        (call $write_value (local.get $out_slot)
          (global.get $TYPE_RATIONAL) (i32.const 0)
          (call $rational_new
            (call $algebraic_bigint_negate
              (call $algebraic_poly_coefficient (local.get $poly) (i32.const 0)))
            (call $algebraic_poly_coefficient (local.get $poly) (i32.const 1)))
          (i32.const 0))
        (return (i32.const 0))))
    (if (call $expression_walk_guard (i32.add
          (i32.add
            (call $estimate_array_size (i32.add (local.get $degree) (i32.const 1)))
            (call $estimate_array_size (i32.const 2)))
          (i32.const 72)))
      (then (return (i32.const 1))))
    (local.set $coefficients_array (call $allocate_array (i32.add (local.get $degree) (i32.const 1))))
    (local.set $coefficients_data (i32.add
      (i32.load (call $abs (i32.add (local.get $coefficients_array) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (local.set $i (i32.const 0))
    (block $store_done
      (loop $store
        (br_if $store_done (i32.gt_s (local.get $i) (local.get $degree)))
        (call $write_value
          (i32.add (local.get $coefficients_data) (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
          (global.get $TYPE_BIGINT) (i32.const 0)
          (call $algebraic_poly_coefficient (local.get $poly) (local.get $i))
          (i32.const 0))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $store)))
    (call $expression_freeze_args_array (local.get $coefficients_array))
    (local.set $interval_array (call $allocate_array (i32.const 2)))
    (local.set $interval_data (i32.add
      (i32.load (call $abs (i32.add (local.get $interval_array) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (call $write_value (local.get $interval_data)
      (global.get $TYPE_RATIONAL) (i32.const 0) (local.get $low_header) (i32.const 0))
    (call $write_value (i32.add (local.get $interval_data) (global.get $VALUE_SIZE))
      (global.get $TYPE_RATIONAL) (i32.const 0) (local.get $high_header) (i32.const 0))
    (call $expression_freeze_args_array (local.get $interval_array))
    (call $write_value (local.get $out_slot)
      (global.get $TYPE_ALGEBRAIC) (i32.const 0)
      (call $algebraic_allocate (local.get $coefficients_array) (local.get $interval_array))
      (i32.const 0))
    (i32.const 0)
  )

  ;; Commit an isolation entry as a value: exact points (and degree-1
  ;; polynomials) as Rationals, intervals as AlgebraicNumbers.
  ;; 0 ok / 1 pressure.
  (func $algebraic_mint_entry
    (param $poly i32) (param $entry i32) (param $known_irreducible i32) (param $out_slot i32)
    (result i32)
    (local $rational i32)
    (local $high_rational i32)
    (if (i32.eqz (i32.load (call $abs (local.get $entry))))
      (then
        (local.set $rational (call $algebraic_dyadic_to_rational
          (i32.load (call $abs (i32.add (local.get $entry) (i32.const 4))))
          (i32.load (call $abs (i32.add (local.get $entry) (i32.const 8))))))
        (if (i32.eqz (local.get $rational)) (then (return (i32.const 1))))
        (call $write_value (local.get $out_slot)
          (global.get $TYPE_RATIONAL) (i32.const 0) (local.get $rational) (i32.const 0))
        (return (i32.const 0))))
    (local.set $rational (call $algebraic_entry_bound_rational (local.get $entry) (i32.const 0)))
    (if (i32.eqz (local.get $rational)) (then (return (i32.const 1))))
    (local.set $high_rational (call $algebraic_entry_bound_rational (local.get $entry) (i32.const 1)))
    (if (i32.eqz (local.get $high_rational)) (then (return (i32.const 1))))
    (call $algebraic_mint_poly_interval (local.get $poly)
      (local.get $rational)
      (local.get $high_rational)
      (local.get $known_irreducible)
      (local.get $out_slot))
  )

  ;; a + u/v: p(x − u/v) cleared to ℤ via the fraction-free Horner
  ;; acc ← acc·(v·x − u) + c_i·v^(m−i); the shifted interval needs no
  ;; root selection (the transform is a bijection). 0 ok / 1 pressure.
  (func $algebraic_value_add_rational
    (param $header i32) (param $r_header i32) (param $out_slot i32)
    (result i32)
    (local $poly i32)
    (local $degree i32)
    (local $u i32)
    (local $v i32)
    (local $linear i32)
    (local $accumulator i32)
    (local $v_power i32)
    (local $i i32)
    (local $coefficient i32)
    (local $term i32)
    (local $content i32)
    (local $interval_data i32)
    (local $low i32)
    (local $high i32)
    (local $coordinates i32)
    (local $rational_coordinates i32)
    (local $shifted_coordinates i32)
    (local $status i32)
    (if (i32.eqz (i32.load (call $abs
          (i32.add (local.get $header) (global.get $GC_HEADER_SIZE)))))
      (then
        (if (call $algebraic_materialize_standalone_cache (local.get $header))
          (then (return (i32.const 1))))))
    (local.set $poly (call $algebraic_poly_from_array
      (call $algebraic_coefficients_of (local.get $header))))
    (if (i32.eqz (local.get $poly)) (then (return (i32.const 1))))
    (local.set $degree (call $algebraic_poly_degree (local.get $poly)))
    (local.set $u (call $rational_numerator (local.get $r_header)))
    (local.set $v (call $rational_denominator (local.get $r_header)))
    (if (call $expression_walk_guard (i32.add (i32.const 64)
          (call $estimate_bigint_size (i32.add (call $bigint_length (local.get $u)) (i32.const 1)))))
      (then (return (i32.const 1))))
    (local.set $linear (call $algebraic_poly_carve (i32.const 1)))
    (if (i32.eqz (local.get $linear)) (then (return (i32.const 1))))
    (call $algebraic_poly_set_coefficient (local.get $linear) (i32.const 0)
      (call $algebraic_bigint_negate (local.get $u)))
    (call $algebraic_poly_set_coefficient (local.get $linear) (i32.const 1) (local.get $v))
    (local.set $accumulator (call $algebraic_poly_carve (i32.const 0)))
    (if (i32.eqz (local.get $accumulator)) (then (return (i32.const 1))))
    (call $algebraic_poly_set_coefficient (local.get $accumulator) (i32.const 0)
      (call $algebraic_poly_coefficient (local.get $poly) (local.get $degree)))
    (local.set $v_power (call $bigint_one))
    (local.set $i (i32.sub (local.get $degree) (i32.const 1)))
    (block $horner_done
      (loop $horner
        (br_if $horner_done (i32.lt_s (local.get $i) (i32.const 0)))
        (local.set $accumulator (call $algebraic_poly_mul (local.get $accumulator) (local.get $linear)))
        (if (i32.eqz (local.get $accumulator)) (then (return (i32.const 1))))
        (local.set $coefficient (call $algebraic_poly_coefficient (local.get $poly) (local.get $i)))
        (if (call $expression_walk_guard (i32.add (i32.const 32)
              (i32.mul (i32.const 3)
                (call $estimate_bigint_size (i32.add
                  (i32.add
                    (call $bigint_length (local.get $v_power))
                    (call $bigint_length (local.get $v)))
                  (i32.add (call $bigint_length (local.get $coefficient)) (i32.const 4)))))))
          (then (return (i32.const 1))))
        (local.set $v_power (call $bigint_mul (local.get $v_power) (local.get $v)))
        (local.set $term (call $algebraic_poly_carve (i32.const 0)))
        (if (i32.eqz (local.get $term)) (then (return (i32.const 1))))
        (call $algebraic_poly_set_coefficient (local.get $term) (i32.const 0)
          (call $bigint_mul (local.get $coefficient) (local.get $v_power)))
        (local.set $accumulator (call $algebraic_poly_add_poly
          (local.get $accumulator) (local.get $term)))
        (if (i32.eqz (local.get $accumulator)) (then (return (i32.const 1))))
        (local.set $i (i32.sub (local.get $i) (i32.const 1)))
        (br $horner)))
    ;; Content strip (leading c_m·v^m is already positive).
    (local.set $content (call $algebraic_poly_content (local.get $accumulator)))
    (if (i32.eqz (local.get $content)) (then (return (i32.const 1))))
    (local.set $accumulator (call $algebraic_poly_scale_down
      (local.get $accumulator) (local.get $content) (i32.const 0)))
    (if (i32.eqz (local.get $accumulator)) (then (return (i32.const 1))))
    (local.set $interval_data (i32.add
      (i32.load (call $abs (i32.add
        (call $algebraic_interval_of (local.get $header)) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (if (call $expression_walk_guard (i32.const 256))
      (then (return (i32.const 1))))
    (local.set $low (call $rational_materialize (local.get $interval_data)))
    (local.set $high (call $rational_materialize
      (i32.add (local.get $interval_data) (global.get $VALUE_SIZE))))
    (if (call $algebraic_rational_guard (local.get $low) (local.get $r_header))
      (then (return (i32.const 1))))
    (local.set $low (call $rational_add (local.get $low) (local.get $r_header)))
    (if (call $algebraic_rational_guard (local.get $high) (local.get $r_header))
      (then (return (i32.const 1))))
    (local.set $high (call $rational_add (local.get $high) (local.get $r_header)))
    (local.set $coordinates (call $algebraic_field_coordinates_apoly (local.get $header)))
    (if (i32.eqz (local.get $coordinates)) (then (return (i32.const 1))))
    (local.set $rational_coordinates (call $algebraic_apoly_from_rational (local.get $r_header)))
    (if (i32.eqz (local.get $rational_coordinates)) (then (return (i32.const 1))))
    (local.set $shifted_coordinates
      (call $algebraic_apoly_add (local.get $coordinates) (local.get $rational_coordinates)))
    (if (i32.eqz (local.get $shifted_coordinates)) (then (return (i32.const 1))))
    (local.set $status (call $algebraic_mint_poly_interval
      (local.get $accumulator) (local.get $low) (local.get $high)
      (i32.const 1) (local.get $out_slot)))
    (if (local.get $status) (then (return (local.get $status))))
    (call $algebraic_attach_field_coordinates
      (local.get $out_slot)
      (call $algebraic_field_generator_of (local.get $header))
      (local.get $shifted_coordinates))
  )

  ;; a · u/v (u ≠ 0): coefficient-wise q_i = c_i·v^i·u^(m−i), interval
  ;; scaled (swapped when negative). 0 ok / 1 pressure.
  (func $algebraic_value_scale_rational
    (param $header i32) (param $r_header i32) (param $out_slot i32)
    (result i32)
    (local $poly i32)
    (local $degree i32)
    (local $u i32)
    (local $v i32)
    (local $powers i32)
    (local $v_power i32)
    (local $u_power i32)
    (local $result i32)
    (local $i i32)
    (local $coefficient i32)
    (local $content i32)
    (local $interval_data i32)
    (local $low i32)
    (local $high i32)
    (local $swap i32)
    (local $coordinates i32)
    (local $rational_coordinates i32)
    (local $scaled_coordinates i32)
    (local $status i32)
    (if (i32.eqz (i32.load (call $abs
          (i32.add (local.get $header) (global.get $GC_HEADER_SIZE)))))
      (then
        (if (call $algebraic_materialize_standalone_cache (local.get $header))
          (then (return (i32.const 1))))))
    (local.set $poly (call $algebraic_poly_from_array
      (call $algebraic_coefficients_of (local.get $header))))
    (if (i32.eqz (local.get $poly)) (then (return (i32.const 1))))
    (local.set $degree (call $algebraic_poly_degree (local.get $poly)))
    (local.set $u (call $rational_numerator (local.get $r_header)))
    (local.set $v (call $rational_denominator (local.get $r_header)))
    (if (call $expression_walk_guard (i32.add
          (i32.mul (i32.add (local.get $degree) (i32.const 2)) (i32.const 4)) (i32.const 64)))
      (then (return (i32.const 1))))
    (local.set $powers (call $carve_scratch_blob
      (i32.mul (i32.add (local.get $degree) (i32.const 1)) (i32.const 4))))
    (local.set $v_power (call $bigint_one))
    (local.set $i (i32.const 0))
    (block $vpowers_done
      (loop $vpowers
        (br_if $vpowers_done (i32.gt_s (local.get $i) (local.get $degree)))
        (i32.store (call $abs (i32.add (local.get $powers) (i32.mul (local.get $i) (i32.const 4))))
          (local.get $v_power))
        (if (i32.lt_s (local.get $i) (local.get $degree))
          (then
            (if (call $expression_walk_guard (i32.mul (i32.const 2)
                  (call $estimate_bigint_size (i32.add
                    (i32.add
                      (call $bigint_length (local.get $v_power))
                      (call $bigint_length (local.get $v)))
                    (i32.const 2)))))
              (then (return (i32.const 1))))
            (local.set $v_power (call $bigint_mul (local.get $v_power) (local.get $v)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $vpowers)))
    (local.set $result (call $algebraic_poly_carve (local.get $degree)))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 1))))
    (local.set $u_power (call $bigint_one))
    (local.set $i (local.get $degree))
    (block $scale_done
      (loop $scale
        (br_if $scale_done (i32.lt_s (local.get $i) (i32.const 0)))
        (local.set $coefficient (call $algebraic_poly_coefficient (local.get $poly) (local.get $i)))
        (local.set $v_power (i32.load (call $abs (i32.add (local.get $powers)
          (i32.mul (local.get $i) (i32.const 4))))))
        (if (call $expression_walk_guard (i32.mul (i32.const 3)
              (call $estimate_bigint_size (i32.add
                (i32.add
                  (call $bigint_length (local.get $coefficient))
                  (call $bigint_length (local.get $v_power)))
                (i32.add (call $bigint_length (local.get $u_power)) (i32.const 4))))))
          (then (return (i32.const 1))))
        (call $algebraic_poly_set_coefficient (local.get $result) (local.get $i)
          (call $bigint_mul
            (call $bigint_mul (local.get $coefficient) (local.get $v_power))
            (local.get $u_power)))
        (if (i32.gt_s (local.get $i) (i32.const 0))
          (then
            (if (call $expression_walk_guard (i32.mul (i32.const 2)
                  (call $estimate_bigint_size (i32.add
                    (i32.add
                      (call $bigint_length (local.get $u_power))
                      (call $bigint_length (local.get $u)))
                    (i32.const 2)))))
              (then (return (i32.const 1))))
            (local.set $u_power (call $bigint_mul (local.get $u_power) (local.get $u)))))
        (local.set $i (i32.sub (local.get $i) (i32.const 1)))
        (br $scale)))
    (local.set $content (call $algebraic_poly_content (local.get $result)))
    (if (i32.eqz (local.get $content)) (then (return (i32.const 1))))
    (local.set $result (call $algebraic_poly_scale_down
      (local.get $result) (local.get $content) (i32.const 0)))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 1))))
    (local.set $interval_data (i32.add
      (i32.load (call $abs (i32.add
        (call $algebraic_interval_of (local.get $header)) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (if (call $expression_walk_guard (i32.const 256))
      (then (return (i32.const 1))))
    (local.set $low (call $rational_materialize (local.get $interval_data)))
    (local.set $high (call $rational_materialize
      (i32.add (local.get $interval_data) (global.get $VALUE_SIZE))))
    (if (call $algebraic_rational_guard (local.get $low) (local.get $r_header))
      (then (return (i32.const 1))))
    (local.set $low (call $rational_mul (local.get $low) (local.get $r_header)))
    (if (call $algebraic_rational_guard (local.get $high) (local.get $r_header))
      (then (return (i32.const 1))))
    (local.set $high (call $rational_mul (local.get $high) (local.get $r_header)))
    (if (call $bigint_sign (local.get $u))
      (then
        (local.set $swap (local.get $low))
        (local.set $low (local.get $high))
        (local.set $high (local.get $swap))))
    (local.set $coordinates (call $algebraic_field_coordinates_apoly (local.get $header)))
    (if (i32.eqz (local.get $coordinates)) (then (return (i32.const 1))))
    (local.set $rational_coordinates (call $algebraic_apoly_from_rational (local.get $r_header)))
    (if (i32.eqz (local.get $rational_coordinates)) (then (return (i32.const 1))))
    (local.set $scaled_coordinates
      (call $algebraic_apoly_mul (local.get $coordinates) (local.get $rational_coordinates)))
    (if (i32.eqz (local.get $scaled_coordinates)) (then (return (i32.const 1))))
    (local.set $status (call $algebraic_mint_poly_interval
      (local.get $result) (local.get $low) (local.get $high)
      (i32.const 1) (local.get $out_slot)))
    (if (local.get $status) (then (return (local.get $status))))
    (call $algebraic_attach_field_coordinates
      (local.get $out_slot)
      (call $algebraic_field_generator_of (local.get $header))
      (local.get $scaled_coordinates))
  )

  ;; Is the represented value exactly zero? (Constant coefficient zero
  ;; AND the interval spans zero.) 0 no / 1 yes / 2 pressure.
  (func $algebraic_value_is_zero (param $header i32) (result i32)
    (local $coefficients_data i32)
    (local $interval_data i32)
    (local $low i32)
    (local $high i32)
    (local $zero i32)
    (local $coordinates i32)
    (if (call $algebraic_field_coordinates_of (local.get $header))
      (then
        (local.set $coordinates (call $algebraic_field_coordinates_apoly (local.get $header)))
        (if (i32.eqz (local.get $coordinates)) (then (return (i32.const 2))))
        (if (i32.lt_s (call $algebraic_poly_degree (local.get $coordinates)) (i32.const 0))
          (then (return (i32.const 1))))
        (if (i32.eqz (call $algebraic_poly_degree (local.get $coordinates)))
          (then (return (i32.eqz (call $bigint_length
            (call $rational_numerator
              (call $algebraic_poly_coefficient (local.get $coordinates) (i32.const 0))))))))
        (return (i32.const 0))))
    (local.set $coefficients_data (i32.add
      (i32.load (call $abs (i32.add
        (call $algebraic_coefficients_of (local.get $header)) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (if (i32.ne (call $bigint_length (call $value_data_lo (local.get $coefficients_data)))
          (i32.const 0))
      (then (return (i32.const 0))))
    (if (call $expression_walk_guard (i32.const 320))
      (then (return (i32.const 2))))
    (local.set $interval_data (i32.add
      (i32.load (call $abs (i32.add
        (call $algebraic_interval_of (local.get $header)) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (local.set $low (call $rational_materialize (local.get $interval_data)))
    (local.set $high (call $rational_materialize
      (i32.add (local.get $interval_data) (global.get $VALUE_SIZE))))
    (local.set $zero (call $rational_new (call $bigint_zero) (call $bigint_one)))
    (i32.and
      (i32.lt_s (call $rational_header_pair_compare (local.get $low) (local.get $zero)) (i32.const 0))
      (i32.gt_s (call $rational_header_pair_compare (local.get $high) (local.get $zero)) (i32.const 0)))
  )

  ;; 1/a (caller guarantees a ≠ 0): coefficient reversal, after
  ;; refining the interval away from zero. 0 ok / 1 pressure.
  (func $algebraic_value_inverse (param $header i32) (param $out_slot i32) (result i32)
    (local $interval_data i32)
    (local $low i32)
    (local $high i32)
    (local $zero i32)
    (local $poly i32)
    (local $degree i32)
    (local $reversed i32)
    (local $content i32)
    (local $j i32)
    (local $coordinates i32)
    (local $generator i32)
    (local $modulus_bigint i32)
    (local $modulus i32)
    (local $inverse_out i32)
    (local $unused_out i32)
    (local $gcd i32)
    (local $inverse_coordinates i32)
    (local $status i32)
    (if (i32.eqz (i32.load (call $abs
          (i32.add (local.get $header) (global.get $GC_HEADER_SIZE)))))
      (then
        (if (call $algebraic_materialize_standalone_cache (local.get $header))
          (then (return (i32.const 1))))))
    (block $separated
      (loop $exclude_zero
        (local.set $interval_data (i32.add
          (i32.load (call $abs (i32.add
            (call $algebraic_interval_of (local.get $header)) (i32.const 16))))
          (global.get $GC_HEADER_SIZE)))
        (if (call $expression_walk_guard (i32.const 320))
          (then (return (i32.const 1))))
        (local.set $low (call $rational_materialize (local.get $interval_data)))
        (local.set $high (call $rational_materialize
          (i32.add (local.get $interval_data) (global.get $VALUE_SIZE))))
        (local.set $zero (call $rational_new (call $bigint_zero) (call $bigint_one)))
        (br_if $separated (i32.eqz (i32.and
          (i32.le_s (call $rational_header_pair_compare (local.get $low) (local.get $zero)) (i32.const 0))
          (i32.ge_s (call $rational_header_pair_compare (local.get $high) (local.get $zero)) (i32.const 0)))))
        (if (call $algebraic_refine_step (local.get $header))
          (then (return (i32.const 1))))
        (br $exclude_zero)))
    (local.set $poly (call $algebraic_poly_from_array
      (call $algebraic_coefficients_of (local.get $header))))
    (if (i32.eqz (local.get $poly)) (then (return (i32.const 1))))
    (local.set $degree (call $algebraic_poly_degree (local.get $poly)))
    (local.set $reversed (call $algebraic_poly_carve (local.get $degree)))
    (if (i32.eqz (local.get $reversed)) (then (return (i32.const 1))))
    (local.set $j (i32.const 0))
    (block $reverse_done
      (loop $reverse
        (br_if $reverse_done (i32.gt_s (local.get $j) (local.get $degree)))
        (call $algebraic_poly_set_coefficient (local.get $reversed) (local.get $j)
          (call $algebraic_poly_coefficient (local.get $poly)
            (i32.sub (local.get $degree) (local.get $j))))
        (local.set $j (i32.add (local.get $j) (i32.const 1)))
        (br $reverse)))
    (call $algebraic_poly_trim (local.get $reversed))
    (if (i32.le_s (call $algebraic_poly_degree (local.get $reversed)) (i32.const 0))
      (then (unreachable)))
    (local.set $content (call $algebraic_poly_content (local.get $reversed)))
    (if (i32.eqz (local.get $content)) (then (return (i32.const 1))))
    (local.set $reversed (call $algebraic_poly_scale_down
      (local.get $reversed) (local.get $content)
      (i32.ne
        (call $bigint_sign (call $algebraic_poly_coefficient
          (local.get $reversed) (call $algebraic_poly_degree (local.get $reversed))))
        (i32.const 0))))
    (if (i32.eqz (local.get $reversed)) (then (return (i32.const 1))))
    ;; New interval (1/high, 1/low) — endpoints are nonzero and share
    ;; the root's sign, so plain numerator/denominator swaps.
    (if (call $algebraic_rational_guard (local.get $low) (local.get $high))
      (then (return (i32.const 1))))
    (local.set $coordinates (call $algebraic_field_coordinates_apoly (local.get $header)))
    (if (i32.eqz (local.get $coordinates)) (then (return (i32.const 1))))
    (local.set $generator (call $algebraic_field_generator_of (local.get $header)))
    (local.set $modulus_bigint (call $algebraic_poly_from_array
      (call $algebraic_coefficients_of (local.get $generator))))
    (if (i32.eqz (local.get $modulus_bigint)) (then (return (i32.const 1))))
    (local.set $modulus (call $algebraic_apoly_from_bigint_poly (local.get $modulus_bigint)))
    (if (i32.eqz (local.get $modulus)) (then (return (i32.const 1))))
    (local.set $inverse_out (call $carve_scratch_blob (i32.const 4)))
    (local.set $unused_out (call $carve_scratch_blob (i32.const 4)))
    (local.set $gcd (call $algebraic_apoly_extended_gcd
      (local.get $coordinates) (local.get $modulus)
      (local.get $inverse_out) (local.get $unused_out)))
    (if (i32.eqz (local.get $gcd)) (then (return (i32.const 1))))
    (if (i32.ne (call $algebraic_poly_degree (local.get $gcd)) (i32.const 0))
      (then (unreachable)))
    (local.set $inverse_coordinates
      (i32.load (call $abs (local.get $inverse_out))))
    (local.set $inverse_coordinates
      (call $algebraic_apoly_mod (local.get $inverse_coordinates) (local.get $modulus)))
    (if (i32.eqz (local.get $inverse_coordinates)) (then (return (i32.const 1))))
    (local.set $status (call $algebraic_mint_poly_interval
      (local.get $reversed)
      (call $rational_new
        (call $rational_denominator (local.get $high))
        (call $rational_numerator (local.get $high)))
      (call $rational_new
        (call $rational_denominator (local.get $low))
        (call $rational_numerator (local.get $low)))
      (i32.const 1)
      (local.get $out_slot)))
    (if (local.get $status) (then (return (local.get $status))))
    (call $algebraic_attach_field_coordinates
      (local.get $out_slot) (local.get $generator) (local.get $inverse_coordinates))
  )

  ;; a ⊕ b for two AlgebraicNumbers via resultant composition:
  ;; kind 0 = sum  — Res_y(p(y), q(x − y))
  ;; kind 1 = product — Res_y(p(y), y^n·q(x/y))
  ;; then squarefree normalisation, isolation, and root selection by
  ;; refining both operands until exactly one candidate overlaps the
  ;; interval arithmetic bound. 0 ok / 1 pressure.
  (func $algebraic_compose_binary
    (param $a_header i32) (param $b_header i32) (param $kind i32) (param $out_slot i32)
    (result i32)
    (local $pa i32)
    (local $pb i32)
    (local $m i32)
    (local $n i32)
    (local $a_ypoly i32)
    (local $b_ypoly i32)
    (local $xk i32)
    (local $i i32)
    (local $k i32)
    (local $binomial i32)
    (local $coefficient i32)
    (local $term i32)
    (local $resultant i32)
    (local $selected i32)
    (local $output i32)
    (local $count i32)
    (local $a_data i32)
    (local $b_data i32)
    (local $a_low i32)
    (local $a_high i32)
    (local $b_low i32)
    (local $b_high i32)
    (local $s_lo i32)
    (local $s_hi i32)
    (local $candidate i32)
    (local $matches i32)
    (local $chosen i32)
    (local $overlap i32)
    (local $zero_poly i32)
    (local $zero_bigint i32)
    (local $product i32)
    (local $select_round i32)
    (local $refine_budget i32)
    (local $refine_i i32)
    (local $factors_out i32)
    (local $factor_count i32)
    (local $chosen_low i32)
    (local $chosen_high i32)
    (local $minimal_factor i32)
    (local $candidate_factor i32)
    (local $sign_low i32)
    (local $sign_high i32)
    (local.set $pa (call $algebraic_poly_from_array
      (call $algebraic_coefficients_of (local.get $a_header))))
    (if (i32.eqz (local.get $pa)) (then (return (i32.const 1))))
    (local.set $pb (call $algebraic_poly_from_array
      (call $algebraic_coefficients_of (local.get $b_header))))
    (if (i32.eqz (local.get $pb)) (then (return (i32.const 1))))
    (local.set $m (call $algebraic_poly_degree (local.get $pa)))
    (local.set $n (call $algebraic_poly_degree (local.get $pb)))
    ;; A: p lifted to ℤ[x][y] with constant coefficients.
    (local.set $a_ypoly (call $algebraic_poly_carve (local.get $m)))
    (if (i32.eqz (local.get $a_ypoly)) (then (return (i32.const 1))))
    (local.set $zero_poly (call $algebraic_poly_carve (i32.const -1)))
    (if (i32.eqz (local.get $zero_poly)) (then (return (i32.const 1))))
    (local.set $i (i32.const 0))
    (block $lift_done
      (loop $lift
        (br_if $lift_done (i32.gt_s (local.get $i) (local.get $m)))
        (local.set $coefficient (call $algebraic_poly_coefficient (local.get $pa) (local.get $i)))
        (if (i32.eqz (call $bigint_length (local.get $coefficient)))
          (then (call $algebraic_poly_set_coefficient
            (local.get $a_ypoly) (local.get $i) (local.get $zero_poly)))
          (else
            (local.set $xk (call $algebraic_poly_carve (i32.const 0)))
            (if (i32.eqz (local.get $xk)) (then (return (i32.const 1))))
            (call $algebraic_poly_set_coefficient (local.get $xk) (i32.const 0) (local.get $coefficient))
            (call $algebraic_poly_set_coefficient (local.get $a_ypoly) (local.get $i) (local.get $xk))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $lift)))
    (local.set $b_ypoly (call $algebraic_poly_carve (local.get $n)))
    (if (i32.eqz (local.get $b_ypoly)) (then (return (i32.const 1))))
    (if (i32.eqz (local.get $kind))
      (then
        ;; Sum: q(x − y); coefficient of y^k is
        ;; Σ_i q_{k+i}·C(k+i, k)·(−1)^k·x^i.
        (local.set $k (i32.const 0))
        (block $shift_done
          (loop $shift
            (br_if $shift_done (i32.gt_s (local.get $k) (local.get $n)))
            (local.set $xk (call $algebraic_poly_carve (i32.sub (local.get $n) (local.get $k))))
            (if (i32.eqz (local.get $xk)) (then (return (i32.const 1))))
            (if (call $expression_walk_guard (i32.const 32))
              (then (return (i32.const 1))))
            (local.set $binomial (call $bigint_one))
            (local.set $i (i32.const 0))
            (block $row_done
              (loop $row
                (br_if $row_done (i32.gt_s (local.get $i) (i32.sub (local.get $n) (local.get $k))))
                (if (i32.gt_s (local.get $i) (i32.const 0))
                  (then
                    (if (call $expression_walk_guard (i32.mul (i32.const 4)
                          (call $estimate_bigint_size (i32.add
                            (call $bigint_length (local.get $binomial)) (i32.const 3)))))
                      (then (return (i32.const 1))))
                    (local.set $binomial (call $bigint_div
                      (call $bigint_mul (local.get $binomial)
                        (call $bigint_from_i64 (i64.extend_i32_s
                          (i32.add (local.get $k) (local.get $i)))))
                      (call $bigint_from_i64 (i64.extend_i32_s (local.get $i)))))))
                (local.set $coefficient (call $algebraic_poly_coefficient
                  (local.get $pb) (i32.add (local.get $k) (local.get $i))))
                (if (call $expression_walk_guard (i32.mul (i32.const 3)
                      (call $estimate_bigint_size (i32.add
                        (i32.add
                          (call $bigint_length (local.get $coefficient))
                          (call $bigint_length (local.get $binomial)))
                        (i32.const 3)))))
                  (then (return (i32.const 1))))
                (local.set $term (call $bigint_mul (local.get $coefficient) (local.get $binomial)))
                (if (i32.and (local.get $k) (i32.const 1))
                  (then (local.set $term (call $algebraic_bigint_negate (local.get $term)))))
                (call $algebraic_poly_set_coefficient (local.get $xk) (local.get $i) (local.get $term))
                (local.set $i (i32.add (local.get $i) (i32.const 1)))
                (br $row)))
            (call $algebraic_poly_trim (local.get $xk))
            (call $algebraic_poly_set_coefficient (local.get $b_ypoly) (local.get $k) (local.get $xk))
            (local.set $k (i32.add (local.get $k) (i32.const 1)))
            (br $shift)))
        ;; Target bound is recomputed inside the selection loop.
        )
      (else
        ;; Product: y^n·q(x/y); coefficient of y^(n−j) is q_j·x^j.
        (if (call $expression_walk_guard (i32.const 32))
          (then (return (i32.const 1))))
        (local.set $zero_bigint (call $bigint_zero))
        (local.set $k (i32.const 0))
        (block $mono_done
          (loop $mono
            (br_if $mono_done (i32.gt_s (local.get $k) (local.get $n)))
            (local.set $coefficient (call $algebraic_poly_coefficient (local.get $pb) (local.get $k)))
            (if (i32.eqz (call $bigint_length (local.get $coefficient)))
              (then (call $algebraic_poly_set_coefficient (local.get $b_ypoly)
                (i32.sub (local.get $n) (local.get $k)) (local.get $zero_poly)))
              (else
                (local.set $xk (call $algebraic_poly_carve (local.get $k)))
                (if (i32.eqz (local.get $xk)) (then (return (i32.const 1))))
                (local.set $i (i32.const 0))
                (block $mfill_done
                  (loop $mfill
                    (br_if $mfill_done (i32.ge_s (local.get $i) (local.get $k)))
                    (call $algebraic_poly_set_coefficient (local.get $xk) (local.get $i)
                      (local.get $zero_bigint))
                    (local.set $i (i32.add (local.get $i) (i32.const 1)))
                    (br $mfill)))
                (call $algebraic_poly_set_coefficient (local.get $xk) (local.get $k)
                  (local.get $coefficient))
                (call $algebraic_poly_set_coefficient (local.get $b_ypoly)
                  (i32.sub (local.get $n) (local.get $k)) (local.get $xk))))
            (local.set $k (i32.add (local.get $k) (i32.const 1)))
            (br $mono)))))
    (local.set $resultant (call $algebraic_ypoly_resultant
      (local.get $a_ypoly) (local.get $b_ypoly)))
    (if (i32.eqz (local.get $resultant)) (then (return (i32.const 1))))
    (call $algebraic_poly_trim (local.get $resultant))
    (if (i32.lt_s (call $algebraic_poly_degree (local.get $resultant)) (i32.const 1))
      (then (unreachable)))
    (local.set $resultant (call $algebraic_poly_normalize_squarefree (local.get $resultant)))
    (if (i32.eqz (local.get $resultant)) (then (return (i32.const 1))))
    (if (call $expression_walk_guard (i32.add
          (i32.mul (call $algebraic_poly_degree (local.get $resultant)) (i32.const 20))
          (i32.const 32)))
      (then (return (i32.const 1))))
    (local.set $output (call $carve_scratch_blob
      (i32.mul (call $algebraic_poly_degree (local.get $resultant)) (i32.const 20))))
    (if (call $algebraic_isolate (local.get $resultant) (local.get $output))
      (then (return (i32.const 1))))
    (local.set $count (global.get $algebraic_isolate_count))
    ;; Root selection: refine the two operand intervals until exactly one
    ;; fixed candidate interval overlaps their arithmetic result bound.
    ;; Isolation already produced pairwise-disjoint intervals whose
    ;; endpoints are not roots. The exact result therefore lies in the
    ;; interior of one candidate interval, and the nested operand bounds
    ;; eventually separate it from every other candidate without refining
    ;; the candidates themselves. Keeping candidates fixed is essential:
    ;; they are scratch state discarded on pressure, while operand
    ;; refinements persist and make each retry advance.
    ;; $refine_budget doubles every round (1, 2, 4, 8, ...). Thirty rounds
    ;; exceed the separation bounds expected here; failure to converge
    ;; beyond that limit is a structural error, not numeric closeness.
    (local.set $select_round (i32.const 0))
    (local.set $refine_budget (i32.const 1))
    (block $selected_done
      (loop $select
        (local.set $a_data (i32.add
          (i32.load (call $abs (i32.add
            (call $algebraic_interval_of (local.get $a_header)) (i32.const 16))))
          (global.get $GC_HEADER_SIZE)))
        (local.set $b_data (i32.add
          (i32.load (call $abs (i32.add
            (call $algebraic_interval_of (local.get $b_header)) (i32.const 16))))
          (global.get $GC_HEADER_SIZE)))
        (if (call $expression_walk_guard (i32.const 512))
          (then (return (i32.const 1))))
        (local.set $a_low (call $rational_materialize (local.get $a_data)))
        (local.set $a_high (call $rational_materialize
          (i32.add (local.get $a_data) (global.get $VALUE_SIZE))))
        (local.set $b_low (call $rational_materialize (local.get $b_data)))
        (local.set $b_high (call $rational_materialize
          (i32.add (local.get $b_data) (global.get $VALUE_SIZE))))
        (if (i32.eqz (local.get $kind))
          (then
            (if (call $algebraic_rational_guard (local.get $a_low) (local.get $b_low))
              (then (return (i32.const 1))))
            (local.set $s_lo (call $rational_add (local.get $a_low) (local.get $b_low)))
            (if (call $algebraic_rational_guard (local.get $a_high) (local.get $b_high))
              (then (return (i32.const 1))))
            (local.set $s_hi (call $rational_add (local.get $a_high) (local.get $b_high))))
          (else
            ;; Product bound: min/max over the four endpoint products.
            (if (call $algebraic_rational_guard (local.get $a_low) (local.get $b_low))
              (then (return (i32.const 1))))
            (local.set $s_lo (call $rational_mul (local.get $a_low) (local.get $b_low)))
            (local.set $s_hi (local.get $s_lo))
            (if (call $algebraic_rational_guard (local.get $a_low) (local.get $b_high))
              (then (return (i32.const 1))))
            (local.set $product (call $rational_mul (local.get $a_low) (local.get $b_high)))
            (if (i32.lt_s (call $rational_header_pair_compare (local.get $product) (local.get $s_lo)) (i32.const 0))
              (then (local.set $s_lo (local.get $product))))
            (if (i32.gt_s (call $rational_header_pair_compare (local.get $product) (local.get $s_hi)) (i32.const 0))
              (then (local.set $s_hi (local.get $product))))
            (if (call $algebraic_rational_guard (local.get $a_high) (local.get $b_low))
              (then (return (i32.const 1))))
            (local.set $product (call $rational_mul (local.get $a_high) (local.get $b_low)))
            (if (i32.lt_s (call $rational_header_pair_compare (local.get $product) (local.get $s_lo)) (i32.const 0))
              (then (local.set $s_lo (local.get $product))))
            (if (i32.gt_s (call $rational_header_pair_compare (local.get $product) (local.get $s_hi)) (i32.const 0))
              (then (local.set $s_hi (local.get $product))))
            (if (call $algebraic_rational_guard (local.get $a_high) (local.get $b_high))
              (then (return (i32.const 1))))
            (local.set $product (call $rational_mul (local.get $a_high) (local.get $b_high)))
            (if (i32.lt_s (call $rational_header_pair_compare (local.get $product) (local.get $s_lo)) (i32.const 0))
              (then (local.set $s_lo (local.get $product))))
            (if (i32.gt_s (call $rational_header_pair_compare (local.get $product) (local.get $s_hi)) (i32.const 0))
              (then (local.set $s_hi (local.get $product))))))
        (local.set $matches (i32.const 0))
        (local.set $i (i32.const 0))
        (block $count_done
          (loop $count_loop
            (br_if $count_done (i32.ge_s (local.get $i) (local.get $count)))
            (local.set $candidate (i32.add (local.get $output)
              (i32.mul (local.get $i) (i32.const 20))))
            (local.set $overlap (call $algebraic_entry_overlap
              (local.get $candidate) (local.get $s_lo) (local.get $s_hi)))
            (if (i32.lt_s (local.get $overlap) (i32.const 0))
              (then (return (i32.const 1))))
            (if (local.get $overlap)
              (then
                (local.set $matches (i32.add (local.get $matches) (i32.const 1)))
                (local.set $chosen (local.get $candidate))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $count_loop)))
        (if (i32.eqz (local.get $matches)) (then (unreachable)))
        (br_if $selected_done (i32.eq (local.get $matches) (i32.const 1)))
        (if (i32.ge_s (local.get $select_round) (i32.const 30))
          (then (return (i32.add (i32.const 2)
            (call $throw_range_error_with_message
              (global.get $BUILTIN_MSG_ALGEBRAIC_DISAMBIGUATION_LIMIT))))))
        (local.set $refine_i (i32.const 0))
        (block $refine_budget_done
          (loop $refine_budget_loop
            (br_if $refine_budget_done (i32.ge_s (local.get $refine_i) (local.get $refine_budget)))
            (if (call $algebraic_refine_step (local.get $a_header))
              (then (return (i32.const 1))))
            (if (call $algebraic_refine_step (local.get $b_header))
              (then (return (i32.const 1))))
            (local.set $refine_i (i32.add (local.get $refine_i) (i32.const 1)))
            (br $refine_budget_loop)))
        (local.set $select_round (i32.add (local.get $select_round) (i32.const 1)))
        (if (i32.lt_s (local.get $refine_budget) (i32.const 0x40000000))
          (then (local.set $refine_budget (i32.mul (local.get $refine_budget) (i32.const 2)))))
        (br $select)))
    ;; A squarefree resultant is not necessarily irreducible:
    ;; $resultant (squarefree, but not necessarily IRREDUCIBLE -- e.g.
    ;; two conjugate roots of the same non-cyclic-Galois-group
    ;; polynomial give a genuinely reducible squarefree resultant)
    ;; must not be minted as-is; it can be a nontrivial multiple of
    ;; the true minimal polynomial, which is both wasteful (every
    ;; later operation pays for the inflated degree) and has been
    ;; confirmed to cause real hangs in ordinary arithmetic (feeding a
    ;; non-minimal value back into this same function). Factor it and
    ;; pick the irreducible factor that actually has $chosen's root --
    ;; identified by a genuine sign change across $chosen's own
    ;; isolating interval (same bracketing test $algebraic_isolate
    ;; itself uses), not by re-disambiguating numerically (that's
    ;; already done; $chosen is already correct, only the STORED
    ;; polynomial needs to shrink to match).
    (local.set $factors_out (call $carve_scratch_blob (i32.mul (i32.const 16) (i32.const 4))))
    (local.set $factor_count (call $algebraic_zz_zassenhaus
      (local.get $resultant) (local.get $factors_out) (i32.const 16)))
    ;; -3 (no usable prime found within the search bound) and -2 (more
    ;; than 16 irreducible factors, an exceedingly generous bound for
    ;; this project's actual resultants) are not hard failures here --
    ;; fall back to treating $resultant as irreducible (its prior,
    ;; pre-this-fix behavior) rather than refusing composition
    ;; outright; this can only make the result NON-minimal in a
    ;; vanishingly rare case, never wrong. -1 (genuine pressure) still
    ;; propagates as a real failure.
    (if (i32.or (i32.eq (local.get $factor_count) (i32.const -3)) (i32.eq (local.get $factor_count) (i32.const -2)))
      (then (local.set $factor_count (i32.const 1))))
    (if (i32.lt_s (local.get $factor_count) (i32.const 0))
      (then (return (i32.const 1))))
    (if (i32.le_s (local.get $factor_count) (i32.const 1))
      (then (return (call $algebraic_mint_entry
        (local.get $resultant) (local.get $chosen) (i32.const 1) (local.get $out_slot)))))
    (local.set $chosen_low (call $algebraic_entry_bound_rational (local.get $chosen) (i32.const 0)))
    (if (i32.eqz (local.get $chosen_low)) (then (return (i32.const 1))))
    (local.set $chosen_high (call $algebraic_entry_bound_rational (local.get $chosen) (i32.const 1)))
    (if (i32.eqz (local.get $chosen_high)) (then (return (i32.const 1))))
    (local.set $minimal_factor (i32.const 0))
    (local.set $i (i32.const 0))
    (block $factor_search_done
      (loop $factor_search
        (br_if $factor_search_done (i32.ge_s (local.get $i) (local.get $factor_count)))
        (local.set $candidate_factor (i32.load (call $abs (i32.add (local.get $factors_out) (i32.mul (local.get $i) (i32.const 4))))))
        (local.set $sign_low (call $algebraic_sign_at (local.get $candidate_factor)
          (call $rational_numerator (local.get $chosen_low)) (call $rational_denominator (local.get $chosen_low))))
        (if (i32.eq (local.get $sign_low) (i32.const 2)) (then (return (i32.const 1))))
        (local.set $sign_high (call $algebraic_sign_at (local.get $candidate_factor)
          (call $rational_numerator (local.get $chosen_high)) (call $rational_denominator (local.get $chosen_high))))
        (if (i32.eq (local.get $sign_high) (i32.const 2)) (then (return (i32.const 1))))
        (if (i32.or (i32.ne (local.get $sign_low) (local.get $sign_high))
              (i32.eqz (local.get $sign_low)))
          (then (local.set $minimal_factor (local.get $candidate_factor)) (br $factor_search_done)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $factor_search)))
    ;; Every factor found should genuinely bracket $chosen's root (it
    ;; IS a root of $resultant, hence of exactly one of its
    ;; irreducible factors) -- failure to find one means something
    ;; upstream is inconsistent, not a recoverable numeric situation.
    (if (i32.eqz (local.get $minimal_factor)) (then (unreachable)))
    (call $algebraic_mint_entry
      (local.get $minimal_factor) (local.get $chosen) (i32.const 1) (local.get $out_slot))
  )

  ;; Mixed exact arithmetic on two value SLOTS (AlgebraicNumber /
  ;; Rational / BigInt), result written to $out_slot. kind 0 add,
  ;; 1 subtract, 2 multiply, 3 divide.
  ;; 0 ok / 1 pressure / 2 caught throw / 3 uncaught throw.
  (func $algebraic_slot_arith
    (param $kind i32) (param $left_slot i32) (param $right_slot i32) (param $out_slot i32)
    (result i32)
    (local $left_type i32)
    (local $right_type i32)
    (local $left_algebraic i32)
    (local $right_algebraic i32)
    (local $left_rational i32)
    (local $right_rational i32)
    (local $result i32)
    (local $status i32)
    (local $temporary_slot i32)
    (local $zero_status i32)
    (local.set $left_type (call $value_type (local.get $left_slot)))
    (local.set $right_type (call $value_type (local.get $right_slot)))
    (if (i32.eq (local.get $left_type) (global.get $TYPE_ALGEBRAIC))
      (then (local.set $left_algebraic (call $value_data_lo (local.get $left_slot))))
      (else
        (if (call $expression_walk_guard (i32.const 128))
          (then (return (i32.const 1))))
        (if (i32.eq (local.get $left_type) (global.get $TYPE_BIGINT))
          (then (local.set $left_rational (call $rational_from_bigint
            (call $value_data_lo (local.get $left_slot)))))
          (else (local.set $left_rational (call $rational_materialize (local.get $left_slot)))))))
    (if (i32.eq (local.get $right_type) (global.get $TYPE_ALGEBRAIC))
      (then (local.set $right_algebraic (call $value_data_lo (local.get $right_slot))))
      (else
        (if (call $expression_walk_guard (i32.const 128))
          (then (return (i32.const 1))))
        (if (i32.eq (local.get $right_type) (global.get $TYPE_BIGINT))
          (then (local.set $right_rational (call $rational_from_bigint
            (call $value_data_lo (local.get $right_slot)))))
          (else (local.set $right_rational (call $rational_materialize (local.get $right_slot)))))))
    ;; Both rational: plain Ring 1 arithmetic on headers.
    (if (i32.and (i32.eqz (local.get $left_algebraic)) (i32.eqz (local.get $right_algebraic)))
      (then
        (if (call $algebraic_rational_guard (local.get $left_rational) (local.get $right_rational))
          (then (return (i32.const 1))))
        (if (i32.eq (local.get $kind) (i32.const 0))
          (then (local.set $result (call $rational_add (local.get $left_rational) (local.get $right_rational)))))
        (if (i32.eq (local.get $kind) (i32.const 1))
          (then (local.set $result (call $rational_sub (local.get $left_rational) (local.get $right_rational)))))
        (if (i32.eq (local.get $kind) (i32.const 2))
          (then (local.set $result (call $rational_mul (local.get $left_rational) (local.get $right_rational)))))
        (if (i32.eq (local.get $kind) (i32.const 3))
          (then
            (if (i32.eqz (call $bigint_length (call $rational_numerator (local.get $right_rational))))
              (then
                (if (call $raise_error (global.get $ERR_RANGE_ERROR) (i32.const 0))
                  (then (return (i32.const 3))))
                (return (i32.const 2))))
            (local.set $result (call $rational_div (local.get $left_rational) (local.get $right_rational)))))
        (call $write_value (local.get $out_slot)
          (global.get $TYPE_RATIONAL) (i32.const 0) (local.get $result) (i32.const 0))
        (return (i32.const 0))))
    (if (call $expression_walk_guard (i32.add (global.get $VALUE_SIZE) (i32.const 96)))
      (then (return (i32.const 1))))
    (local.set $temporary_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    ;; Algebraic ⊕ rational.
    (if (i32.and (i32.ne (local.get $left_algebraic) (i32.const 0))
          (i32.eqz (local.get $right_algebraic)))
      (then
        (if (i32.eq (local.get $kind) (i32.const 0))
          (then
            (if (i32.eqz (call $bigint_length (call $rational_numerator (local.get $right_rational))))
              (then
                (call $write_value (local.get $out_slot)
                  (local.get $left_type) (call $value_flags (local.get $left_slot))
                  (call $value_data_lo (local.get $left_slot))
                  (call $value_data_hi (local.get $left_slot)))
                (return (i32.const 0))))
            (return (call $algebraic_value_add_rational
              (local.get $left_algebraic) (local.get $right_rational) (local.get $out_slot)))))
        (if (i32.eq (local.get $kind) (i32.const 1))
          (then
            (if (i32.eqz (call $bigint_length (call $rational_numerator (local.get $right_rational))))
              (then
                (call $write_value (local.get $out_slot)
                  (local.get $left_type) (call $value_flags (local.get $left_slot))
                  (call $value_data_lo (local.get $left_slot))
                  (call $value_data_hi (local.get $left_slot)))
                (return (i32.const 0))))
            (if (call $expression_walk_guard (i32.const 96))
              (then (return (i32.const 1))))
            (return (call $algebraic_value_add_rational
              (local.get $left_algebraic)
              (call $rational_negate (local.get $right_rational))
              (local.get $out_slot)))))
        (if (i32.eq (local.get $kind) (i32.const 2))
          (then
            (if (i32.eqz (call $bigint_length (call $rational_numerator (local.get $right_rational))))
              (then
                (call $write_inline_rational (local.get $out_slot) (i64.const 0))
                (return (i32.const 0))))
            (return (call $algebraic_value_scale_rational
              (local.get $left_algebraic) (local.get $right_rational) (local.get $out_slot)))))
        ;; kind 3: a / r = a · (v/u).
        (if (i32.eqz (call $bigint_length (call $rational_numerator (local.get $right_rational))))
          (then
            (if (call $raise_error (global.get $ERR_RANGE_ERROR) (i32.const 0))
              (then (return (i32.const 3))))
            (return (i32.const 2))))
        (if (call $algebraic_rational_guard (local.get $right_rational) (local.get $right_rational))
          (then (return (i32.const 1))))
        (return (call $algebraic_value_scale_rational
          (local.get $left_algebraic)
          (call $rational_new
            (call $rational_denominator (local.get $right_rational))
            (call $rational_numerator (local.get $right_rational)))
          (local.get $out_slot)))))
    ;; Rational ⊕ algebraic.
    (if (i32.and (i32.eqz (local.get $left_algebraic))
          (i32.ne (local.get $right_algebraic) (i32.const 0)))
      (then
        (if (i32.eq (local.get $kind) (i32.const 0))
          (then
            (if (i32.eqz (call $bigint_length (call $rational_numerator (local.get $left_rational))))
              (then
                (call $write_value (local.get $out_slot)
                  (local.get $right_type) (call $value_flags (local.get $right_slot))
                  (call $value_data_lo (local.get $right_slot))
                  (call $value_data_hi (local.get $right_slot)))
                (return (i32.const 0))))
            (return (call $algebraic_value_add_rational
              (local.get $right_algebraic) (local.get $left_rational) (local.get $out_slot)))))
        (if (i32.eq (local.get $kind) (i32.const 1))
          (then
            ;; r − a = (−a) + r.
            (if (call $expression_walk_guard (i32.const 96))
              (then (return (i32.const 1))))
            (local.set $status (call $algebraic_value_scale_rational
              (local.get $right_algebraic)
              (call $rational_new
                (call $algebraic_bigint_negate (call $bigint_one)) (call $bigint_one))
              (local.get $temporary_slot)))
            (if (local.get $status) (then (return (local.get $status))))
            (return (call $algebraic_slot_arith (i32.const 0)
              (local.get $temporary_slot) (local.get $left_slot) (local.get $out_slot)))))
        (if (i32.eq (local.get $kind) (i32.const 2))
          (then
            (if (i32.eqz (call $bigint_length (call $rational_numerator (local.get $left_rational))))
              (then
                (call $write_inline_rational (local.get $out_slot) (i64.const 0))
                (return (i32.const 0))))
            (return (call $algebraic_value_scale_rational
              (local.get $right_algebraic) (local.get $left_rational) (local.get $out_slot)))))
        ;; kind 3: r / a = (1/a) · r.
        (local.set $zero_status (call $algebraic_value_is_zero (local.get $right_algebraic)))
        (if (i32.eq (local.get $zero_status) (i32.const 2)) (then (return (i32.const 1))))
        (if (local.get $zero_status)
          (then
            (if (call $raise_error (global.get $ERR_RANGE_ERROR) (i32.const 0))
              (then (return (i32.const 3))))
            (return (i32.const 2))))
        (local.set $status (call $algebraic_value_inverse
          (local.get $right_algebraic) (local.get $temporary_slot)))
        (if (local.get $status) (then (return (local.get $status))))
        (return (call $algebraic_slot_arith (i32.const 2)
          (local.get $temporary_slot) (local.get $left_slot) (local.get $out_slot)))))
    ;; Both algebraic.
    (if (i32.eq (local.get $kind) (i32.const 0))
      (then
        (if (i32.eq
              (call $algebraic_field_generator_of (local.get $left_algebraic))
              (call $algebraic_field_generator_of (local.get $right_algebraic)))
          (then (return (call $algebraic_compose_same_field
            (local.get $left_algebraic) (local.get $right_algebraic)
            (i32.const 0) (local.get $out_slot)))))
        (return (call $algebraic_compose_different_fields
          (local.get $left_algebraic) (local.get $right_algebraic)
          (i32.const 0) (local.get $out_slot)))))
    (if (i32.eq (local.get $kind) (i32.const 1))
      (then
        (if (call $expression_walk_guard (i32.const 96))
          (then (return (i32.const 1))))
        (local.set $status (call $algebraic_value_scale_rational
          (local.get $right_algebraic)
          (call $rational_new
            (call $algebraic_bigint_negate (call $bigint_one)) (call $bigint_one))
          (local.get $temporary_slot)))
        (if (local.get $status) (then (return (local.get $status))))
        (return (call $algebraic_slot_arith (i32.const 0)
          (local.get $left_slot) (local.get $temporary_slot) (local.get $out_slot)))))
    (if (i32.eq (local.get $kind) (i32.const 2))
      (then
        (local.set $zero_status (call $algebraic_value_is_zero (local.get $left_algebraic)))
        (if (i32.eq (local.get $zero_status) (i32.const 2)) (then (return (i32.const 1))))
        (if (i32.eqz (local.get $zero_status))
          (then
            (local.set $zero_status (call $algebraic_value_is_zero (local.get $right_algebraic)))
            (if (i32.eq (local.get $zero_status) (i32.const 2)) (then (return (i32.const 1))))))
        (if (local.get $zero_status)
          (then
            (call $write_inline_rational (local.get $out_slot) (i64.const 0))
            (return (i32.const 0))))
        (if (i32.eq
              (call $algebraic_field_generator_of (local.get $left_algebraic))
              (call $algebraic_field_generator_of (local.get $right_algebraic)))
          (then (return (call $algebraic_compose_same_field
            (local.get $left_algebraic) (local.get $right_algebraic)
            (i32.const 1) (local.get $out_slot)))))
        (return (call $algebraic_compose_different_fields
          (local.get $left_algebraic) (local.get $right_algebraic)
          (i32.const 1) (local.get $out_slot)))))
    ;; kind 3: a / b = a · (1/b).
    (local.set $zero_status (call $algebraic_value_is_zero (local.get $right_algebraic)))
    (if (i32.eq (local.get $zero_status) (i32.const 2)) (then (return (i32.const 1))))
    (if (local.get $zero_status)
      (then
        (if (call $raise_error (global.get $ERR_RANGE_ERROR) (i32.const 0))
          (then (return (i32.const 3))))
        (return (i32.const 2))))
    (local.set $status (call $algebraic_value_inverse
      (local.get $right_algebraic) (local.get $temporary_slot)))
    (if (local.get $status) (then (return (local.get $status))))
    (call $algebraic_slot_arith (i32.const 2)
      (local.get $left_slot) (local.get $temporary_slot) (local.get $out_slot))
  )

  ;; Operator-dispatch wrapper: peeked operand slots in, result written
  ;; over the LEFT operand slot and the stack popped by one on success.
  ;; Same status codes as $algebraic_slot_arith.
  (func $algebraic_operator_arith
    (param $kind i32) (param $left_slot i32) (param $right_slot i32)
    (result i32)
    (local $out_slot i32)
    (local $status i32)
    (local $header i32)
    (if (call $expression_walk_guard (i32.add (global.get $VALUE_SIZE) (i32.const 32)))
      (then (return (i32.const 1))))
    (local.set $out_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (local.set $status (call $algebraic_slot_arith
      (local.get $kind) (local.get $left_slot) (local.get $right_slot) (local.get $out_slot)))
    (if (local.get $status) (then (return (local.get $status))))
    ;; Rational results take the inline fast form when they fit.
    (if (i32.and
          (i32.eq (call $value_type (local.get $out_slot)) (global.get $TYPE_RATIONAL))
          (i32.eqz (call $rational_is_inline (local.get $out_slot))))
      (then
        (local.set $header (call $value_data_lo (local.get $out_slot)))
        (if (call $rational_denominator_is_one (local.get $header))
          (then
            (if (call $bigint_to_i64_fits (call $rational_numerator (local.get $header)))
              (then
                (call $write_inline_rational (local.get $out_slot)
                  (global.get $bigint_to_i64_value))))))))
    (call $write_value (local.get $left_slot)
      (call $value_type (local.get $out_slot))
      (call $value_flags (local.get $out_slot))
      (call $value_data_lo (local.get $out_slot))
      (call $value_data_hi (local.get $out_slot)))
    (call $write_ctx (global.get $CTX_PENDING_POINTER)
      (i32.add (local.get $left_slot) (global.get $VALUE_SIZE)))
    (i32.const 0)
  )

  ;; Exact three-way comparison for relational/equality opcodes over
  ;; an algebraic-involved pair (caller checked
  ;; $algebraic_pair_dispatchable). −1/0/1, or −2 on pressure.
  (func $algebraic_operator_compare (param $left_slot i32) (param $right_slot i32) (result i32)
    (local $left_type i32)
    (local $right_type i32)
    (local $left_rational i32)
    (local $right_rational i32)
    (local $comparison i32)
    (local.set $left_type (call $value_type (local.get $left_slot)))
    (local.set $right_type (call $value_type (local.get $right_slot)))
    (if (i32.and
          (i32.eq (local.get $left_type) (global.get $TYPE_ALGEBRAIC))
          (i32.eq (local.get $right_type) (global.get $TYPE_ALGEBRAIC)))
      (then (return (call $algebraic_compare_algebraic
        (call $value_data_lo (local.get $left_slot))
        (call $value_data_lo (local.get $right_slot))))))
    (if (call $expression_walk_guard (i32.const 128))
      (then (return (i32.const -2))))
    (if (i32.eq (local.get $left_type) (global.get $TYPE_ALGEBRAIC))
      (then
        (if (i32.eq (local.get $right_type) (global.get $TYPE_BIGINT))
          (then (local.set $right_rational (call $rational_from_bigint
            (call $value_data_lo (local.get $right_slot)))))
          (else (local.set $right_rational (call $rational_materialize (local.get $right_slot)))))
        (return (call $algebraic_compare_with_rational
          (call $value_data_lo (local.get $left_slot)) (local.get $right_rational)))))
    (if (i32.eq (local.get $left_type) (global.get $TYPE_BIGINT))
      (then (local.set $left_rational (call $rational_from_bigint
        (call $value_data_lo (local.get $left_slot)))))
      (else (local.set $left_rational (call $rational_materialize (local.get $left_slot)))))
    (local.set $comparison (call $algebraic_compare_with_rational
      (call $value_data_lo (local.get $right_slot)) (local.get $left_rational)))
    (if (i32.eq (local.get $comparison) (i32.const -2))
      (then (return (i32.const -2))))
    (i32.sub (i32.const 0) (local.get $comparison))
  )

  ;; Does an operand pair dispatch to exact algebraic arithmetic?
  ;; At least one AlgebraicNumber, both in {AlgebraicNumber, Rational,
  ;; BigInt}. Float and Complex mixes deliberately fall through to the
  ;; coercion-refuse TypeError — approximation stays an explicit exit.
  (func $algebraic_pair_dispatchable (param $type1 i32) (param $type2 i32) (result i32)
    (if (i32.eqz (i32.or
          (i32.eq (local.get $type1) (global.get $TYPE_ALGEBRAIC))
          (i32.eq (local.get $type2) (global.get $TYPE_ALGEBRAIC))))
      (then (return (i32.const 0))))
    (i32.and
      (i32.or
        (i32.eq (local.get $type1) (global.get $TYPE_ALGEBRAIC))
        (i32.or
          (i32.eq (local.get $type1) (global.get $TYPE_RATIONAL))
          (i32.eq (local.get $type1) (global.get $TYPE_BIGINT))))
      (i32.or
        (i32.eq (local.get $type2) (global.get $TYPE_ALGEBRAIC))
        (i32.or
          (i32.eq (local.get $type2) (global.get $TYPE_RATIONAL))
          (i32.eq (local.get $type2) (global.get $TYPE_BIGINT)))))
  )

  ;; ----- exact complex-algebraic value core ---------------------------------

  (func $exact_real_tower_type (param $type i32) (result i32)
    (i32.or
      (i32.eq (local.get $type) (global.get $TYPE_BIGINT))
      (i32.or
        (i32.eq (local.get $type) (global.get $TYPE_RATIONAL))
        (i32.eq (local.get $type) (global.get $TYPE_ALGEBRAIC)))))

  ;; The legacy Complex type remains the rational-complex fast path. This
  ;; broader dispatch is needed when a ComplexAlgebraicNumber is present, or
  ;; when a real AlgebraicNumber first meets a legacy Complex.
  (func $complex_algebraic_pair_dispatchable
    (param $left_type i32) (param $right_type i32) (result i32)
    (local $left_complex i32)
    (local $right_complex i32)
    (local.set $left_complex (i32.or
      (i32.eq (local.get $left_type) (global.get $TYPE_COMPLEX))
      (i32.eq (local.get $left_type) (global.get $TYPE_COMPLEX_ALGEBRAIC))))
    (local.set $right_complex (i32.or
      (i32.eq (local.get $right_type) (global.get $TYPE_COMPLEX))
      (i32.eq (local.get $right_type) (global.get $TYPE_COMPLEX_ALGEBRAIC))))
    (if (i32.eqz (i32.or
          (i32.eq (local.get $left_type) (global.get $TYPE_COMPLEX_ALGEBRAIC))
          (i32.or
            (i32.eq (local.get $right_type) (global.get $TYPE_COMPLEX_ALGEBRAIC))
            (i32.or
              (i32.and (local.get $left_complex)
                (i32.eq (local.get $right_type) (global.get $TYPE_ALGEBRAIC)))
              (i32.and (local.get $right_complex)
                (i32.eq (local.get $left_type) (global.get $TYPE_ALGEBRAIC)))))))
      (then (return (i32.const 0))))
    (i32.and
      (i32.or (local.get $left_complex)
        (call $exact_real_tower_type (local.get $left_type)))
      (i32.or (local.get $right_complex)
        (call $exact_real_tower_type (local.get $right_type))))
  )

  (func $complex_algebraic_real_pointer (param $header i32) (result i32)
    (i32.load (call $abs
      (i32.add (local.get $header) (global.get $GC_HEADER_SIZE)))))

  (func $complex_algebraic_imaginary_pointer (param $header i32) (result i32)
    (i32.load (call $abs
      (i32.add (i32.add (local.get $header) (global.get $GC_HEADER_SIZE))
        (i32.const 4)))))

  ;; Reconstitute an exact-real value slot from a component HEADER pointer.
  (func $complex_algebraic_component_to_slot
    (param $header i32) (param $out_slot i32)
    (local $object_type i32)
    (local.set $object_type
      (i32.and
        (i32.shr_u (i32.load (call $abs (local.get $header))) (i32.const 24))
        (i32.const 0x7f)))
    (if (i32.eq (local.get $object_type) (global.get $OBJ_BIGINT))
      (then
        (call $write_value (local.get $out_slot)
          (global.get $TYPE_BIGINT) (i32.const 0) (local.get $header) (i32.const 0))
        (return)))
    (if (i32.eq (local.get $object_type) (global.get $OBJ_RATIONAL))
      (then
        (call $write_value (local.get $out_slot)
          (global.get $TYPE_RATIONAL) (i32.const 0) (local.get $header) (i32.const 0))
        (return)))
    (if (i32.eq (local.get $object_type) (global.get $OBJ_ALGEBRAIC))
      (then
        (call $write_value (local.get $out_slot)
          (global.get $TYPE_ALGEBRAIC) (i32.const 0) (local.get $header) (i32.const 0))
        (return)))
    unreachable
  )

  ;; Dense polynomials whose coefficients are exact-real VALUE slots.
  ;; The generic nested-polynomial substrate bottoms out at BigInt; complex
  ;; root projection instead needs one polynomial level over the complete
  ;; exact real tower. Polynomial entries therefore point at immutable
  ;; scratch VALUE slots, and every arithmetic result receives a fresh slot.
  (func $exact_value_poly_carve (param $degree i32) (result i32)
    (local $poly i32)
    (local $zero_slot i32)
    (local $i i32)
    (if (call $expression_walk_guard (i32.add (i32.const 32)
          (i32.mul (i32.add (local.get $degree) (i32.const 1)) (i32.const 4))))
      (then (return (i32.const 0))))
    (local.set $poly (call $algebraic_poly_carve (local.get $degree)))
    (if (i32.eqz (local.get $poly)) (then (return (i32.const 0))))
    (if (i32.lt_s (local.get $degree) (i32.const 0))
      (then (return (local.get $poly))))
    (local.set $zero_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (call $write_inline_rational (local.get $zero_slot) (i64.const 0))
    (local.set $i (i32.const 0))
    (block $done
      (loop $fill
        (br_if $done (i32.gt_s (local.get $i) (local.get $degree)))
        (call $algebraic_poly_set_coefficient
          (local.get $poly) (local.get $i) (local.get $zero_slot))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $fill)))
    (local.get $poly)
  )

  ;; Returns 0 ok / 1 pressure.
  (func $exact_value_poly_trim (param $poly i32) (result i32)
    (local $degree i32)
    (local $zero_status i32)
    (local.set $degree (call $algebraic_poly_degree (local.get $poly)))
    (block $done
      (loop $trim
        (br_if $done (i32.lt_s (local.get $degree) (i32.const 0)))
        (local.set $zero_status (call $algebraic_slot_is_exact_zero
          (call $algebraic_poly_coefficient (local.get $poly) (local.get $degree))))
        (if (i32.eq (local.get $zero_status) (i32.const 2))
          (then (return (i32.const 1))))
        (br_if $done (i32.eqz (local.get $zero_status)))
        (local.set $degree (i32.sub (local.get $degree) (i32.const 1)))
        (br $trim)))
    (call $algebraic_poly_set_degree (local.get $poly) (local.get $degree))
    (i32.const 0)
  )

  ;; kind 0 add / 1 subtract. Returns a fresh polynomial, or 0 on pressure.
  (func $exact_value_poly_add_sub
    (param $kind i32) (param $left i32) (param $right i32) (result i32)
    (local $left_degree i32)
    (local $right_degree i32)
    (local $degree i32)
    (local $result i32)
    (local $zero_slot i32)
    (local $left_slot i32)
    (local $right_slot i32)
    (local $out_slot i32)
    (local $status i32)
    (local $i i32)
    (local.set $left_degree (call $algebraic_poly_degree (local.get $left)))
    (local.set $right_degree (call $algebraic_poly_degree (local.get $right)))
    (local.set $degree (select (local.get $left_degree) (local.get $right_degree)
      (i32.gt_s (local.get $left_degree) (local.get $right_degree))))
    (local.set $result (call $exact_value_poly_carve (local.get $degree)))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (if (i32.lt_s (local.get $degree) (i32.const 0))
      (then (return (local.get $result))))
    (local.set $zero_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (call $write_inline_rational (local.get $zero_slot) (i64.const 0))
    (local.set $i (i32.const 0))
    (block $done
      (loop $combine
        (br_if $done (i32.gt_s (local.get $i) (local.get $degree)))
        (local.set $left_slot (select
          (call $algebraic_poly_coefficient (local.get $left) (local.get $i))
          (local.get $zero_slot) (i32.le_s (local.get $i) (local.get $left_degree))))
        (local.set $right_slot (select
          (call $algebraic_poly_coefficient (local.get $right) (local.get $i))
          (local.get $zero_slot) (i32.le_s (local.get $i) (local.get $right_degree))))
        (local.set $out_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
        (local.set $status (call $complex_algebraic_slot_arith
          (local.get $kind) (local.get $left_slot) (local.get $right_slot)
          (local.get $out_slot)))
        (if (local.get $status) (then (return (i32.const 0))))
        (call $algebraic_poly_set_coefficient
          (local.get $result) (local.get $i) (local.get $out_slot))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $combine)))
    (if (call $exact_value_poly_trim (local.get $result))
      (then (return (i32.const 0))))
    (local.get $result)
  )

  (func $exact_value_poly_multiply (param $left i32) (param $right i32) (result i32)
    (local $left_degree i32)
    (local $right_degree i32)
    (local $result i32)
    (local $i i32)
    (local $j i32)
    (local $product_slot i32)
    (local $sum_slot i32)
    (local $status i32)
    (local $index i32)
    (local.set $left_degree (call $algebraic_poly_degree (local.get $left)))
    (local.set $right_degree (call $algebraic_poly_degree (local.get $right)))
    (if (i32.or (i32.lt_s (local.get $left_degree) (i32.const 0))
          (i32.lt_s (local.get $right_degree) (i32.const 0)))
      (then (return (call $exact_value_poly_carve (i32.const -1)))))
    (local.set $result (call $exact_value_poly_carve
      (i32.add (local.get $left_degree) (local.get $right_degree))))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (local.set $i (i32.const 0))
    (block $rows_done
      (loop $rows
        (br_if $rows_done (i32.gt_s (local.get $i) (local.get $left_degree)))
        (local.set $j (i32.const 0))
        (block $columns_done
          (loop $columns
            (br_if $columns_done (i32.gt_s (local.get $j) (local.get $right_degree)))
            (local.set $index (i32.add (local.get $i) (local.get $j)))
            (local.set $product_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
            (local.set $sum_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
            (local.set $status (call $complex_algebraic_slot_arith
              (i32.const 2)
              (call $algebraic_poly_coefficient (local.get $left) (local.get $i))
              (call $algebraic_poly_coefficient (local.get $right) (local.get $j))
              (local.get $product_slot)))
            (if (local.get $status) (then (return (i32.const 0))))
            (local.set $status (call $complex_algebraic_slot_arith
              (i32.const 0)
              (call $algebraic_poly_coefficient (local.get $result) (local.get $index))
              (local.get $product_slot) (local.get $sum_slot)))
            (if (local.get $status) (then (return (i32.const 0))))
            (call $algebraic_poly_set_coefficient
              (local.get $result) (local.get $index) (local.get $sum_slot))
            (local.set $j (i32.add (local.get $j) (i32.const 1)))
            (br $columns)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $rows)))
    (if (call $exact_value_poly_trim (local.get $result))
      (then (return (i32.const 0))))
    (local.get $result)
  )

  (func $exact_value_poly_power_small
    (param $base i32) (param $exponent i32) (result i32)
    (local $result i32)
    (local $one_slot i32)
    (local $i i32)
    (local.set $result (call $exact_value_poly_carve (i32.const 0)))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (local.set $one_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (call $write_inline_rational (local.get $one_slot) (i64.const 1))
    (call $algebraic_poly_set_coefficient
      (local.get $result) (i32.const 0) (local.get $one_slot))
    (local.set $i (i32.const 0))
    (block $done
      (loop $power
        (br_if $done (i32.ge_s (local.get $i) (local.get $exponent)))
        (local.set $result
          (call $exact_value_poly_multiply (local.get $result) (local.get $base)))
        (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $power)))
    (local.get $result)
  )

  (func $exact_value_poly_negate (param $poly i32) (result i32)
    (local $zero i32)
    (local.set $zero (call $exact_value_poly_carve (i32.const -1)))

    (if (i32.eqz (local.get $zero)) (then (return (i32.const 0))))
    (call $exact_value_poly_add_sub (i32.const 1) (local.get $zero) (local.get $poly))
  )

  ;; Exact polynomial long division over the real algebraic field.
  (func $exact_value_poly_exact_divide
    (param $dividend i32) (param $divisor i32) (result i32)
    (local $dividend_degree i32)
    (local $divisor_degree i32)
    (local $remainder i32)
    (local $quotient i32)
    (local $remainder_degree i32)
    (local $offset i32)
    (local $i i32)
    (local $quotient_slot i32)
    (local $product_slot i32)
    (local $difference_slot i32)
    (local $status i32)
    (local.set $dividend_degree (call $algebraic_poly_degree (local.get $dividend)))
    (local.set $divisor_degree (call $algebraic_poly_degree (local.get $divisor)))
    (if (i32.lt_s (local.get $divisor_degree) (i32.const 0)) (then (unreachable)))
    (if (i32.lt_s (local.get $dividend_degree) (local.get $divisor_degree))
      (then (return (call $exact_value_poly_carve (i32.const -1)))))
    (local.set $remainder (call $exact_value_poly_carve (local.get $dividend_degree)))
    (local.set $quotient (call $exact_value_poly_carve
      (i32.sub (local.get $dividend_degree) (local.get $divisor_degree))))
    (if (i32.or (i32.eqz (local.get $remainder)) (i32.eqz (local.get $quotient)))
      (then (return (i32.const 0))))
    (local.set $i (i32.const 0))
    (block $copy_done
      (loop $copy
        (br_if $copy_done (i32.gt_s (local.get $i) (local.get $dividend_degree)))
        (call $algebraic_poly_set_coefficient (local.get $remainder) (local.get $i)
          (call $algebraic_poly_coefficient (local.get $dividend) (local.get $i)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $copy)))
    (local.set $remainder_degree (local.get $dividend_degree))
    (block $division_done
      (loop $division
        (br_if $division_done
          (i32.lt_s (local.get $remainder_degree) (local.get $divisor_degree)))
        (local.set $offset
          (i32.sub (local.get $remainder_degree) (local.get $divisor_degree)))
        (local.set $quotient_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
        (local.set $status (call $complex_algebraic_slot_arith
          (i32.const 3)
          (call $algebraic_poly_coefficient
            (local.get $remainder) (local.get $remainder_degree))
          (call $algebraic_poly_coefficient
            (local.get $divisor) (local.get $divisor_degree))
          (local.get $quotient_slot)))
        (if (local.get $status) (then (return (i32.const 0))))
        (call $algebraic_poly_set_coefficient
          (local.get $quotient) (local.get $offset) (local.get $quotient_slot))
        (local.set $i (i32.const 0))
        (block $subtract_done
          (loop $subtract
            (br_if $subtract_done (i32.gt_s (local.get $i) (local.get $divisor_degree)))
            (local.set $product_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
            (local.set $difference_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
            (local.set $status (call $complex_algebraic_slot_arith
              (i32.const 2) (local.get $quotient_slot)
              (call $algebraic_poly_coefficient (local.get $divisor) (local.get $i))
              (local.get $product_slot)))
            (if (local.get $status) (then (return (i32.const 0))))
            (local.set $status (call $complex_algebraic_slot_arith
              (i32.const 1)
              (call $algebraic_poly_coefficient (local.get $remainder)
                (i32.add (local.get $offset) (local.get $i)))
              (local.get $product_slot) (local.get $difference_slot)))
            (if (local.get $status) (then (return (i32.const 0))))
            (call $algebraic_poly_set_coefficient (local.get $remainder)
              (i32.add (local.get $offset) (local.get $i))
              (local.get $difference_slot))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $subtract)))
        (if (call $exact_value_poly_trim (local.get $remainder))
          (then (return (i32.const 0))))
        (local.set $remainder_degree
          (call $algebraic_poly_degree (local.get $remainder)))
        (br $division)))
    (if (i32.ge_s (local.get $remainder_degree) (i32.const 0)) (then (unreachable)))
    (if (call $exact_value_poly_trim (local.get $quotient))
      (then (return (i32.const 0))))
    (local.get $quotient)
  )

  ;; Resultant of two outer-variable polynomials whose coefficients are
  ;; exact-value polynomials in the retained variable. Returns that retained
  ;; polynomial, or 0 on pressure.
  (func $exact_value_ypoly_resultant (param $left i32) (param $right i32) (result i32)
    (local $left_degree i32)
    (local $right_degree i32)
    (local $dimension i32)
    (local $matrix i32)
    (local $zero_poly i32)
    (local $row i32)
    (local $column i32)
    (local $coefficient_index i32)
    (local $i i32)
    (local $j i32)
    (local $pivot i32)
    (local $swap_row i32)
    (local $swap_entry i32)
    (local $sign i32)
    (local $previous i32)
    (local $term1 i32)
    (local $term2 i32)
    (local $entry i32)
    (local.set $left_degree (call $algebraic_poly_degree (local.get $left)))
    (local.set $right_degree (call $algebraic_poly_degree (local.get $right)))
    (if (i32.or (i32.lt_s (local.get $left_degree) (i32.const 0))
          (i32.lt_s (local.get $right_degree) (i32.const 0)))
      (then (return (call $exact_value_poly_carve (i32.const -1)))))
    (if (i32.eqz (local.get $left_degree))
      (then (return (call $exact_value_poly_power_small
        (call $algebraic_poly_coefficient (local.get $left) (i32.const 0))
        (local.get $right_degree)))))
    (if (i32.eqz (local.get $right_degree))
      (then (return (call $exact_value_poly_power_small
        (call $algebraic_poly_coefficient (local.get $right) (i32.const 0))
        (local.get $left_degree)))))
    (local.set $dimension (i32.add (local.get $left_degree) (local.get $right_degree)))
    (if (call $expression_walk_guard (i32.add (i32.const 64)
          (i32.mul (i32.mul (local.get $dimension) (local.get $dimension))
            (i32.const 4))))
      (then (return (i32.const 0))))
    (local.set $matrix (call $carve_scratch_blob
      (i32.mul (i32.mul (local.get $dimension) (local.get $dimension))
        (i32.const 4))))
    (local.set $zero_poly (call $exact_value_poly_carve (i32.const -1)))
    (if (i32.eqz (local.get $zero_poly)) (then (return (i32.const 0))))
    (local.set $i (i32.const 0))
    (block $blank_done
      (loop $blank
        (br_if $blank_done (i32.ge_s (local.get $i)
          (i32.mul (local.get $dimension) (local.get $dimension))))
        (i32.store (call $abs (i32.add (local.get $matrix)
          (i32.mul (local.get $i) (i32.const 4)))) (local.get $zero_poly))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $blank)))
    (local.set $row (i32.const 0))
    (block $left_rows_done
      (loop $left_rows
        (br_if $left_rows_done (i32.ge_s (local.get $row) (local.get $right_degree)))
        (local.set $coefficient_index (i32.const 0))
        (block $left_columns_done
          (loop $left_columns
            (br_if $left_columns_done
              (i32.gt_s (local.get $coefficient_index) (local.get $left_degree)))
            (i32.store (call $abs (i32.add (local.get $matrix)
              (i32.mul (i32.add (i32.mul (local.get $row) (local.get $dimension))
                (i32.add (local.get $row) (local.get $coefficient_index)))
                (i32.const 4))))
              (call $algebraic_poly_coefficient (local.get $left)
                (i32.sub (local.get $left_degree) (local.get $coefficient_index))))
            (local.set $coefficient_index
              (i32.add (local.get $coefficient_index) (i32.const 1)))
            (br $left_columns)))
        (local.set $row (i32.add (local.get $row) (i32.const 1)))
        (br $left_rows)))
    (local.set $row (i32.const 0))
    (block $right_rows_done
      (loop $right_rows
        (br_if $right_rows_done (i32.ge_s (local.get $row) (local.get $left_degree)))
        (local.set $coefficient_index (i32.const 0))
        (block $right_columns_done
          (loop $right_columns
            (br_if $right_columns_done
              (i32.gt_s (local.get $coefficient_index) (local.get $right_degree)))
            (i32.store (call $abs (i32.add (local.get $matrix)
              (i32.mul (i32.add
                (i32.mul (i32.add (local.get $row) (local.get $right_degree))
                  (local.get $dimension))
                (i32.add (local.get $row) (local.get $coefficient_index)))
                (i32.const 4))))
              (call $algebraic_poly_coefficient (local.get $right)
                (i32.sub (local.get $right_degree) (local.get $coefficient_index))))
            (local.set $coefficient_index
              (i32.add (local.get $coefficient_index) (i32.const 1)))
            (br $right_columns)))
        (local.set $row (i32.add (local.get $row) (i32.const 1)))
        (br $right_rows)))
    (local.set $previous (i32.const 0))
    (local.set $coefficient_index (i32.const 0))
    (block $elimination_done
      (loop $elimination
        (br_if $elimination_done (i32.ge_s (local.get $coefficient_index)
          (i32.sub (local.get $dimension) (i32.const 1))))
        (local.set $pivot (i32.load (call $abs (i32.add (local.get $matrix)
          (i32.mul (i32.add
            (i32.mul (local.get $coefficient_index) (local.get $dimension))
            (local.get $coefficient_index)) (i32.const 4))))))
        (if (i32.lt_s (call $algebraic_poly_degree (local.get $pivot)) (i32.const 0))
          (then
            (local.set $swap_row
              (i32.add (local.get $coefficient_index) (i32.const 1)))
            (block $pivot_found
              (loop $pivot_scan
                (if (i32.ge_s (local.get $swap_row) (local.get $dimension))
                  (then (unreachable)))
                (br_if $pivot_found (i32.ge_s
                  (call $algebraic_poly_degree
                    (i32.load (call $abs (i32.add (local.get $matrix)
                      (i32.mul (i32.add
                        (i32.mul (local.get $swap_row) (local.get $dimension))
                        (local.get $coefficient_index)) (i32.const 4))))))
                  (i32.const 0)))
                (local.set $swap_row
                  (i32.add (local.get $swap_row) (i32.const 1)))
                (br $pivot_scan)))
            (local.set $column (i32.const 0))
            (block $swap_done
              (loop $swap
                (br_if $swap_done
                  (i32.ge_s (local.get $column) (local.get $dimension)))
                (local.set $swap_entry (i32.load (call $abs (i32.add
                  (local.get $matrix) (i32.mul (i32.add
                    (i32.mul (local.get $coefficient_index) (local.get $dimension))
                    (local.get $column)) (i32.const 4))))))
                (i32.store (call $abs (i32.add (local.get $matrix)
                  (i32.mul (i32.add
                    (i32.mul (local.get $coefficient_index) (local.get $dimension))
                    (local.get $column)) (i32.const 4))))
                  (i32.load (call $abs (i32.add (local.get $matrix)
                    (i32.mul (i32.add
                      (i32.mul (local.get $swap_row) (local.get $dimension))
                      (local.get $column)) (i32.const 4))))))
                (i32.store (call $abs (i32.add (local.get $matrix)
                  (i32.mul (i32.add
                    (i32.mul (local.get $swap_row) (local.get $dimension))
                    (local.get $column)) (i32.const 4)))) (local.get $swap_entry))
                (local.set $column (i32.add (local.get $column) (i32.const 1)))
                (br $swap)))
            (local.set $sign (i32.xor (local.get $sign) (i32.const 1)))
            (local.set $pivot (i32.load (call $abs (i32.add (local.get $matrix)
              (i32.mul (i32.add
                (i32.mul (local.get $coefficient_index) (local.get $dimension))
                (local.get $coefficient_index)) (i32.const 4))))))))
        (local.set $i (i32.add (local.get $coefficient_index) (i32.const 1)))
        (block $rows_done
          (loop $rows
            (br_if $rows_done (i32.ge_s (local.get $i) (local.get $dimension)))
            (local.set $j (i32.add (local.get $coefficient_index) (i32.const 1)))
            (block $columns_done
              (loop $columns
                (br_if $columns_done (i32.ge_s (local.get $j) (local.get $dimension)))
                (local.set $term1 (call $exact_value_poly_multiply
                  (local.get $pivot)
                  (i32.load (call $abs (i32.add (local.get $matrix)
                    (i32.mul (i32.add (i32.mul (local.get $i) (local.get $dimension))
                      (local.get $j)) (i32.const 4)))))))
                (if (i32.eqz (local.get $term1)) (then (return (i32.const 0))))
                (local.set $term2 (call $exact_value_poly_multiply
                  (i32.load (call $abs (i32.add (local.get $matrix)
                    (i32.mul (i32.add (i32.mul (local.get $i) (local.get $dimension))
                      (local.get $coefficient_index)) (i32.const 4)))))
                  (i32.load (call $abs (i32.add (local.get $matrix)
                    (i32.mul (i32.add
                      (i32.mul (local.get $coefficient_index) (local.get $dimension))
                      (local.get $j)) (i32.const 4)))))))
                (if (i32.eqz (local.get $term2)) (then (return (i32.const 0))))
                (local.set $entry (call $exact_value_poly_add_sub
                  (i32.const 1) (local.get $term1) (local.get $term2)))
                (if (i32.eqz (local.get $entry)) (then (return (i32.const 0))))
                (if (i32.and (i32.ne (local.get $previous) (i32.const 0))
                      (i32.ge_s (call $algebraic_poly_degree (local.get $entry))
                        (i32.const 0)))
                  (then

                    (local.set $entry (call $exact_value_poly_exact_divide
                      (local.get $entry) (local.get $previous)))
                    (if (i32.eqz (local.get $entry)) (then (return (i32.const 0))))))
                (i32.store (call $abs (i32.add (local.get $matrix)
                  (i32.mul (i32.add (i32.mul (local.get $i) (local.get $dimension))
                    (local.get $j)) (i32.const 4)))) (local.get $entry))
                (local.set $j (i32.add (local.get $j) (i32.const 1)))
                (br $columns)))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $rows)))
        (local.set $previous (local.get $pivot))
        (local.set $coefficient_index
          (i32.add (local.get $coefficient_index) (i32.const 1)))
        (br $elimination)))
    (local.set $entry (i32.load (call $abs (i32.add (local.get $matrix)
      (i32.mul (i32.sub (i32.mul (local.get $dimension) (local.get $dimension))
        (i32.const 1)) (i32.const 4))))))
    (if (local.get $sign)
      (then
        (local.set $entry (call $exact_value_poly_negate (local.get $entry)))
        (if (i32.eqz (local.get $entry)) (then (return (i32.const 0))))))
    (local.get $entry)
  )

  ;; Isolate the real roots of an exact-value polynomial by routing it
  ;; through Ring 6's public root engine. Returns 0 ok / 1 pressure /
  ;; 2 caught throw / 3 uncaught throw and copies the result array slot out.
  (func $complex_algebraic_real_roots_for_exact_poly
    (param $poly i32) (param $out_slot i32) (result i32)
    (local $degree i32)
    (local $list i32)
    (local $variable_slot i32)
    (local $expression_slot i32)
    (local $call_base i32)
    (local $status i32)
    (local $i i32)
    (local.set $degree (call $algebraic_poly_degree (local.get $poly)))
    (if (call $expression_walk_guard (i32.add (i32.const 64)
          (i32.mul (i32.add (local.get $degree) (i32.const 3))
            (global.get $VALUE_SIZE))))
      (then (return (i32.const 1))))
    (local.set $list (call $carve_scratch_blob
      (i32.mul (i32.add (local.get $degree) (i32.const 1))
        (global.get $VALUE_SIZE))))
    (local.set $variable_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (local.set $expression_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (local.set $i (i32.const 0))
    (block $copy_done
      (loop $copy
        (br_if $copy_done (i32.gt_s (local.get $i) (local.get $degree)))
        (memory.copy
          (call $abs (i32.add (local.get $list)
            (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
          (call $abs (call $algebraic_poly_coefficient
            (local.get $poly) (local.get $i)))
          (global.get $VALUE_SIZE))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $copy)))
    (call $write_value (local.get $variable_slot)
      (global.get $TYPE_SYMBOL) (i32.const 0)
      (call $symbol_allocate
        (call $read_builtin (global.get $BUILTIN_EXACT_VARIABLE_X)))
      (i32.const 0))
    (local.set $status (call $poly_from_coefficient_list
      (local.get $list) (local.get $degree) (local.get $variable_slot)
      (local.get $expression_slot) (i32.const 1)))
    (if (local.get $status) (then (return (i32.const 1))))
    (local.set $call_base (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (call $pending_push
      (call $value_type (local.get $expression_slot))
      (call $value_flags (local.get $expression_slot))
      (call $value_data_lo (local.get $expression_slot))
      (call $value_data_hi (local.get $expression_slot)))
    (call $pending_push
      (call $value_type (local.get $variable_slot))
      (call $value_flags (local.get $variable_slot))
      (call $value_data_lo (local.get $variable_slot))
      (call $value_data_hi (local.get $variable_slot)))
    (local.set $status (call $algebraic_roots_of_polynomial
      (global.get $TYPE_OBJECT) (i32.const 0)
      (global.get $METHOD_EXACT_ALGEBRAIC_ROOTS_OF_POLYNOMIAL)
      (i32.const 2) (local.get $call_base)))
    (if (global.get $memory_pressure_signaled)
      (then (return (i32.const 1))))
    (if (i32.eq (local.get $status) (i32.const 1))
      (then (return (i32.const 2))))
    (if (i32.eq (local.get $status) (i32.const 2))
      (then (return (i32.const 3))))
    (memory.copy (call $abs (local.get $out_slot))
      (call $abs (local.get $call_base)) (global.get $VALUE_SIZE))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $call_base))
    (i32.const 0)
  )

  ;; Split any exact real/complex tower value into exact-real component slots.
  (func $complex_algebraic_split
    (param $value_slot i32) (param $real_slot i32) (param $imaginary_slot i32)
    (local $type i32)
    (local $header i32)
    (local.set $type (call $value_type (local.get $value_slot)))
    (local.set $header (call $value_data_lo (local.get $value_slot)))
    (if (i32.eq (local.get $type) (global.get $TYPE_COMPLEX_ALGEBRAIC))
      (then
        (call $complex_algebraic_component_to_slot
          (call $complex_algebraic_real_pointer (local.get $header))
          (local.get $real_slot))
        (call $complex_algebraic_component_to_slot
          (call $complex_algebraic_imaginary_pointer (local.get $header))
          (local.get $imaginary_slot))
        (return)))
    (if (i32.eq (local.get $type) (global.get $TYPE_COMPLEX))
      (then
        (call $write_value (local.get $real_slot)
          (global.get $TYPE_RATIONAL) (i32.const 0)
          (call $complex_real (local.get $header)) (i32.const 0))
        (call $write_value (local.get $imaginary_slot)
          (global.get $TYPE_RATIONAL) (i32.const 0)
          (call $complex_imaginary (local.get $header)) (i32.const 0))
        (return)))
    (memory.copy
      (call $abs (local.get $real_slot))
      (call $abs (local.get $value_slot))
      (global.get $VALUE_SIZE))
    (call $write_inline_rational (local.get $imaginary_slot) (i64.const 0))
  )

  (func $complex_algebraic_component_header
    (param $value_slot i32) (result i32)
    (local $type i32)
    (local.set $type (call $value_type (local.get $value_slot)))
    (if (i32.eq (local.get $type) (global.get $TYPE_RATIONAL))
      (then (return (call $rational_materialize (local.get $value_slot)))))
    (call $value_data_lo (local.get $value_slot))
  )

  (func $complex_algebraic_allocate
    (param $real_pointer i32) (param $imaginary_pointer i32) (result i32)
    (local $header i32)
    (local.set $header (call $read_state (global.get $STATE_HEAP_POINTER)))
    (i32.store (call $abs (local.get $header))
      (i32.or (i32.const 16)
        (i32.shl (global.get $OBJ_COMPLEX_ALGEBRAIC) (i32.const 24))))
    (i32.store (call $abs (i32.add (local.get $header) (i32.const 4))) (i32.const 0))
    (i32.store (call $abs
      (i32.add (local.get $header) (global.get $GC_HEADER_SIZE)))
      (local.get $real_pointer))
    (i32.store (call $abs
      (i32.add (i32.add (local.get $header) (global.get $GC_HEADER_SIZE))
        (i32.const 4)))
      (local.get $imaginary_pointer))
    (call $write_state (global.get $STATE_HEAP_POINTER)
      (i32.add (local.get $header) (i32.const 16)))
    (local.get $header)
  )

  ;; Canonical result construction. Zero imaginary collapses to the real
  ;; tower; rational-only non-real values reuse the legacy Complex type.
  ;; Returns 0 on success or 1 on pressure.
  (func $complex_algebraic_write_result
    (param $real_slot i32) (param $imaginary_slot i32) (param $out_slot i32)
    (result i32)
    (local $zero_status i32)
    (local $real_type i32)
    (local $imaginary_type i32)
    (local $real_pointer i32)
    (local $imaginary_pointer i32)
    (local $component_header i32)
    (local.set $zero_status
      (call $algebraic_slot_is_exact_zero (local.get $imaginary_slot)))
    (if (i32.eq (local.get $zero_status) (i32.const 2))
      (then (return (i32.const 1))))
    (if (local.get $zero_status)
      (then
        (memory.copy
          (call $abs (local.get $out_slot))
          (call $abs (local.get $real_slot))
          (global.get $VALUE_SIZE))
        (return (i32.const 0))))
    (local.set $real_type (call $value_type (local.get $real_slot)))
    (local.set $imaginary_type (call $value_type (local.get $imaginary_slot)))
    ;; Complex values do not yet carry one shared field for both components.
    ;; Materialize each field-backed component at this boundary and detach its
    ;; real-field provenance; later complex arithmetic then composes the
    ;; standalone minimal polynomials instead of treating two independent
    ;; component fields as one reusable complex field.
    (if (i32.eq (local.get $real_type) (global.get $TYPE_ALGEBRAIC))
      (then
        (local.set $component_header (call $value_data_lo (local.get $real_slot)))
        (if (call $algebraic_field_coordinates_of (local.get $component_header))
          (then
            (if (call $algebraic_materialize_standalone_cache (local.get $component_header))
              (then (return (i32.const 1))))
            (i32.store (call $abs (i32.add (local.get $component_header) (i32.const 16)))
              (i32.const 0))
            (i32.store (call $abs (i32.add (local.get $component_header) (i32.const 20)))
              (i32.const 0))))))
    (if (i32.eq (local.get $imaginary_type) (global.get $TYPE_ALGEBRAIC))
      (then
        (local.set $component_header (call $value_data_lo (local.get $imaginary_slot)))
        (if (call $algebraic_field_coordinates_of (local.get $component_header))
          (then
            (if (call $algebraic_materialize_standalone_cache (local.get $component_header))
              (then (return (i32.const 1))))
            (i32.store (call $abs (i32.add (local.get $component_header) (i32.const 16)))
              (i32.const 0))
            (i32.store (call $abs (i32.add (local.get $component_header) (i32.const 20)))
              (i32.const 0))))))
    (if (i32.and
          (i32.ne (local.get $real_type) (global.get $TYPE_ALGEBRAIC))
          (i32.ne (local.get $imaginary_type) (global.get $TYPE_ALGEBRAIC)))
      (then
        (local.set $real_pointer
          (if (result i32)
            (i32.eq (local.get $real_type) (global.get $TYPE_BIGINT))
            (then (call $rational_from_bigint
              (call $value_data_lo (local.get $real_slot))))
            (else (call $rational_materialize (local.get $real_slot)))))
        (local.set $imaginary_pointer
          (if (result i32)
            (i32.eq (local.get $imaginary_type) (global.get $TYPE_BIGINT))
            (then (call $rational_from_bigint
              (call $value_data_lo (local.get $imaginary_slot))))
            (else (call $rational_materialize (local.get $imaginary_slot)))))
        (call $write_value (local.get $out_slot)
          (global.get $TYPE_COMPLEX) (i32.const 0)
          (call $complex_allocate
            (local.get $real_pointer) (local.get $imaginary_pointer))
          (i32.const 0))
        (return (i32.const 0))))
    (local.set $real_pointer
      (call $complex_algebraic_component_header (local.get $real_slot)))
    (local.set $imaginary_pointer
      (call $complex_algebraic_component_header (local.get $imaginary_slot)))
    (call $write_value (local.get $out_slot)
      (global.get $TYPE_COMPLEX_ALGEBRAIC) (i32.const 0)
      (call $complex_algebraic_allocate
        (local.get $real_pointer) (local.get $imaginary_pointer))
      (i32.const 0))
    (i32.const 0)
  )

  ;; ComplexAlgebraicNumber currently stores its real and imaginary parts as
  ;; independent exact-real values, not as coordinates in one shared complex
  ;; field. Keep cross-component arithmetic on the standalone minimal-
  ;; polynomial path; using two unrelated retained real fields here creates
  ;; their compositum independently for each component and multiplies degrees
  ;; again when the complex result is used.
  (func $complex_algebraic_real_slot_arith
    (param $kind i32) (param $left_slot i32) (param $right_slot i32)
    (param $out_slot i32) (result i32)
    (local $left_header i32) (local $right_header i32)
    (local $temporary_slot i32) (local $status i32) (local $zero_status i32)
    (if (i32.or
          (i32.ne (call $value_type (local.get $left_slot)) (global.get $TYPE_ALGEBRAIC))
          (i32.ne (call $value_type (local.get $right_slot)) (global.get $TYPE_ALGEBRAIC)))
      (then (return (call $algebraic_slot_arith
        (local.get $kind) (local.get $left_slot) (local.get $right_slot)
        (local.get $out_slot)))))
    (local.set $left_header (call $value_data_lo (local.get $left_slot)))
    (local.set $right_header (call $value_data_lo (local.get $right_slot)))
    (if (i32.eq (local.get $kind) (i32.const 0))
      (then (return (call $algebraic_compose_binary
        (local.get $left_header) (local.get $right_header)
        (i32.const 0) (local.get $out_slot)))))
    (if (i32.eq (local.get $kind) (i32.const 1))
      (then
        (if (call $expression_walk_guard (i32.const 96))
          (then (return (i32.const 1))))
        (local.set $temporary_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
        (local.set $status (call $algebraic_value_scale_rational
          (local.get $right_header)
          (call $rational_new
            (call $algebraic_bigint_negate (call $bigint_one)) (call $bigint_one))
          (local.get $temporary_slot)))
        (if (local.get $status) (then (return (local.get $status))))
        (return (call $algebraic_compose_binary
          (local.get $left_header) (call $value_data_lo (local.get $temporary_slot))
          (i32.const 0) (local.get $out_slot)))))
    (if (i32.eq (local.get $kind) (i32.const 2))
      (then
        (local.set $zero_status (call $algebraic_value_is_zero (local.get $left_header)))
        (if (i32.eq (local.get $zero_status) (i32.const 2)) (then (return (i32.const 1))))
        (if (i32.eqz (local.get $zero_status))
          (then
            (local.set $zero_status (call $algebraic_value_is_zero (local.get $right_header)))
            (if (i32.eq (local.get $zero_status) (i32.const 2))
              (then (return (i32.const 1))))))
        (if (local.get $zero_status)
          (then
            (call $write_inline_rational (local.get $out_slot) (i64.const 0))
            (return (i32.const 0))))
        (return (call $algebraic_compose_binary
          (local.get $left_header) (local.get $right_header)
          (i32.const 1) (local.get $out_slot)))))
    (local.set $zero_status (call $algebraic_value_is_zero (local.get $right_header)))
    (if (i32.eq (local.get $zero_status) (i32.const 2)) (then (return (i32.const 1))))
    (if (local.get $zero_status)
      (then
        (if (call $raise_error (global.get $ERR_RANGE_ERROR) (i32.const 0))
          (then (return (i32.const 3))))
        (return (i32.const 2))))
    (if (call $expression_walk_guard (i32.const 96))
      (then (return (i32.const 1))))
    (local.set $temporary_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (local.set $status (call $algebraic_value_inverse
      (local.get $right_header) (local.get $temporary_slot)))
    (if (local.get $status) (then (return (local.get $status))))
    (call $algebraic_compose_binary
      (local.get $left_header) (call $value_data_lo (local.get $temporary_slot))
      (i32.const 1) (local.get $out_slot))
  )
  ;; Arithmetic over exact complex components. Kinds mirror
  ;; $algebraic_slot_arith: 0 add, 1 subtract, 2 multiply, 3 divide.
  (func $complex_algebraic_slot_arith
    (param $kind i32) (param $left_slot i32) (param $right_slot i32)
    (param $out_slot i32) (result i32)
    (local $work i32)
    (local $status i32)
    (local $zero_status i32)
    (local $left_real i32)
    (local $left_imaginary i32)
    (local $right_real i32)
    (local $right_imaginary i32)
    (local $temporary0 i32)
    (local $temporary1 i32)
    (local $temporary2 i32)
    (local $temporary3 i32)
    (local $temporary4 i32)
    (local $temporary5 i32)
    (local $result_real i32)
    (local $result_imaginary i32)
    (if (call $expression_walk_guard (i32.const 288))
      (then (return (i32.const 1))))
    (local.set $work (call $carve_scratch_blob (i32.const 256)))
    (local.set $left_real (local.get $work))
    (local.set $left_imaginary (i32.add (local.get $work) (i32.const 16)))
    (local.set $right_real (i32.add (local.get $work) (i32.const 32)))
    (local.set $right_imaginary (i32.add (local.get $work) (i32.const 48)))
    (local.set $temporary0 (i32.add (local.get $work) (i32.const 64)))
    (local.set $temporary1 (i32.add (local.get $work) (i32.const 80)))
    (local.set $temporary2 (i32.add (local.get $work) (i32.const 96)))
    (local.set $temporary3 (i32.add (local.get $work) (i32.const 112)))
    (local.set $temporary4 (i32.add (local.get $work) (i32.const 128)))
    (local.set $temporary5 (i32.add (local.get $work) (i32.const 144)))
    (local.set $result_real (i32.add (local.get $work) (i32.const 160)))
    (local.set $result_imaginary (i32.add (local.get $work) (i32.const 176)))
    (call $complex_algebraic_split
      (local.get $left_slot) (local.get $left_real) (local.get $left_imaginary))
    (call $complex_algebraic_split
      (local.get $right_slot) (local.get $right_real) (local.get $right_imaginary))
    (if (i32.le_u (local.get $kind) (i32.const 1))
      (then
        (local.set $status (call $complex_algebraic_real_slot_arith
          (local.get $kind) (local.get $left_real) (local.get $right_real)
          (local.get $result_real)))
        (if (local.get $status) (then (return (local.get $status))))
        (local.set $status (call $complex_algebraic_real_slot_arith
          (local.get $kind) (local.get $left_imaginary) (local.get $right_imaginary)
          (local.get $result_imaginary)))
        (if (local.get $status) (then (return (local.get $status))))
        (return (call $complex_algebraic_write_result
          (local.get $result_real) (local.get $result_imaginary)
          (local.get $out_slot)))))
    (if (i32.eq (local.get $kind) (i32.const 2))
      (then
        ;; real = ac - bd
        (local.set $status (call $complex_algebraic_real_slot_arith (i32.const 2)
          (local.get $left_real) (local.get $right_real) (local.get $temporary0)))
        (if (local.get $status) (then (return (local.get $status))))
        (local.set $status (call $complex_algebraic_real_slot_arith (i32.const 2)
          (local.get $left_imaginary) (local.get $right_imaginary) (local.get $temporary1)))
        (if (local.get $status) (then (return (local.get $status))))
        (local.set $status (call $complex_algebraic_real_slot_arith (i32.const 1)
          (local.get $temporary0) (local.get $temporary1) (local.get $result_real)))
        (if (local.get $status) (then (return (local.get $status))))
        ;; imaginary = ad + bc
        (local.set $status (call $complex_algebraic_real_slot_arith (i32.const 2)
          (local.get $left_real) (local.get $right_imaginary) (local.get $temporary2)))
        (if (local.get $status) (then (return (local.get $status))))
        (local.set $status (call $complex_algebraic_real_slot_arith (i32.const 2)
          (local.get $left_imaginary) (local.get $right_real) (local.get $temporary3)))
        (if (local.get $status) (then (return (local.get $status))))
        (local.set $status (call $complex_algebraic_real_slot_arith (i32.const 0)
          (local.get $temporary2) (local.get $temporary3)
          (local.get $result_imaginary)))
        (if (local.get $status) (then (return (local.get $status))))
        (return (call $complex_algebraic_write_result
          (local.get $result_real) (local.get $result_imaginary)
          (local.get $out_slot)))))
    ;; denominator = c² + d²
    (local.set $status (call $complex_algebraic_real_slot_arith (i32.const 2)
      (local.get $right_real) (local.get $right_real) (local.get $temporary0)))
    (if (local.get $status) (then (return (local.get $status))))
    (local.set $status (call $complex_algebraic_real_slot_arith (i32.const 2)
      (local.get $right_imaginary) (local.get $right_imaginary) (local.get $temporary1)))
    (if (local.get $status) (then (return (local.get $status))))
    (local.set $status (call $complex_algebraic_real_slot_arith (i32.const 0)
      (local.get $temporary0) (local.get $temporary1) (local.get $temporary2)))
    (if (local.get $status) (then (return (local.get $status))))
    (local.set $zero_status
      (call $algebraic_slot_is_exact_zero (local.get $temporary2)))
    (if (i32.eq (local.get $zero_status) (i32.const 2))
      (then (return (i32.const 1))))
    (if (local.get $zero_status)
      (then
        (if (call $raise_error (global.get $ERR_RANGE_ERROR) (i32.const 0))
          (then (return (i32.const 3))))
        (return (i32.const 2))))
    ;; real numerator = ac + bd
    (local.set $status (call $complex_algebraic_real_slot_arith (i32.const 2)
      (local.get $left_real) (local.get $right_real) (local.get $temporary3)))
    (if (local.get $status) (then (return (local.get $status))))
    (local.set $status (call $complex_algebraic_real_slot_arith (i32.const 2)
      (local.get $left_imaginary) (local.get $right_imaginary) (local.get $temporary4)))
    (if (local.get $status) (then (return (local.get $status))))
    (local.set $status (call $complex_algebraic_real_slot_arith (i32.const 0)
      (local.get $temporary3) (local.get $temporary4) (local.get $temporary5)))
    (if (local.get $status) (then (return (local.get $status))))
    (local.set $status (call $complex_algebraic_real_slot_arith (i32.const 3)
      (local.get $temporary5) (local.get $temporary2) (local.get $result_real)))
    (if (local.get $status) (then (return (local.get $status))))
    ;; imaginary numerator = bc - ad
    (local.set $status (call $complex_algebraic_real_slot_arith (i32.const 2)
      (local.get $left_imaginary) (local.get $right_real) (local.get $temporary3)))
    (if (local.get $status) (then (return (local.get $status))))
    (local.set $status (call $complex_algebraic_real_slot_arith (i32.const 2)
      (local.get $left_real) (local.get $right_imaginary) (local.get $temporary4)))
    (if (local.get $status) (then (return (local.get $status))))
    (local.set $status (call $complex_algebraic_real_slot_arith (i32.const 1)
      (local.get $temporary3) (local.get $temporary4) (local.get $temporary5)))
    (if (local.get $status) (then (return (local.get $status))))
    (local.set $status (call $complex_algebraic_real_slot_arith (i32.const 3)
      (local.get $temporary5) (local.get $temporary2)
      (local.get $result_imaginary)))
    (if (local.get $status) (then (return (local.get $status))))
    (call $complex_algebraic_write_result
      (local.get $result_real) (local.get $result_imaginary)
      (local.get $out_slot))
  )

  (func $complex_algebraic_operator_arith
    (param $kind i32) (param $left_slot i32) (param $right_slot i32)
    (result i32)
    (local $out_slot i32)
    (local $status i32)
    (if (call $expression_walk_guard (i32.const 48))
      (then (return (i32.const 1))))
    (local.set $out_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (local.set $status (call $complex_algebraic_slot_arith
      (local.get $kind) (local.get $left_slot) (local.get $right_slot)
      (local.get $out_slot)))
    (if (local.get $status) (then (return (local.get $status))))
    (memory.copy
      (call $abs (local.get $left_slot))
      (call $abs (local.get $out_slot))
      (global.get $VALUE_SIZE))
    (call $write_ctx (global.get $CTX_PENDING_POINTER)
      (i32.add (local.get $left_slot) (global.get $VALUE_SIZE)))
    (i32.const 0)
  )

  ;; Evaluate a closed coefficient expression over the complete exact
  ;; real/complex tower. Returns 0 ok / 1 pressure / 2 unsupported shape /
  ;; 3 caught throw / 4 uncaught throw.
  (func $complex_algebraic_evaluate_expression
    (param $slot i32) (param $out_slot i32) (result i32)
    (local $type i32)
    (local $header i32)
    (local $head i32)
    (local $arguments i32)
    (local $arguments_data i32)
    (local $argument_count i32)
    (local $left_slot i32)
    (local $right_slot i32)
    (local $temporary_slot i32)
    (local $power_base_slot i32)
    (local $power_result_slot i32)
    (local $power_exponent i64)
    (local $negative_exponent i32)
    (local $kind i32)
    (local $status i32)
    (local.set $type (call $value_type (local.get $slot)))
    (if (i32.or
          (call $exact_real_tower_type (local.get $type))
          (i32.or
            (i32.eq (local.get $type) (global.get $TYPE_COMPLEX))
            (i32.eq (local.get $type) (global.get $TYPE_COMPLEX_ALGEBRAIC))))
      (then
        (memory.copy (call $abs (local.get $out_slot))
          (call $abs (local.get $slot)) (global.get $VALUE_SIZE))
        (return (i32.const 0))))
    (if (i32.ne (local.get $type) (global.get $TYPE_EXPRESSION))
      (then (return (i32.const 2))))
    (local.set $header (call $value_data_lo (local.get $slot)))
    (local.set $head (call $expression_head (local.get $header)))
    (local.set $arguments (call $expression_args (local.get $header)))
    (local.set $argument_count
      (i32.load (call $abs (i32.add (local.get $arguments) (i32.const 8)))))
    (if (i32.ne (local.get $argument_count) (i32.const 2))
      (then (return (i32.const 2))))
    (local.set $arguments_data (i32.add
      (i32.load (call $abs (i32.add (local.get $arguments) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (if (i32.eq (local.get $head) (call $symbol_registry_lookup
          (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_POWER))))
      (then
        (if (i32.eqz (call $exponent_slot_to_i64
              (i32.add (local.get $arguments_data) (global.get $VALUE_SIZE))))
          (then (return (i32.const 2))))
        (local.set $power_exponent (global.get $bigint_to_i64_value))
        (local.set $negative_exponent
          (i64.lt_s (local.get $power_exponent) (i64.const 0)))
        (if (local.get $negative_exponent)
          (then
            (local.set $power_exponent
              (i64.sub (i64.const 0) (local.get $power_exponent)))))
        (if (call $expression_walk_guard (i32.const 128))
          (then (return (i32.const 1))))
        (local.set $power_base_slot
          (call $carve_scratch_blob (global.get $VALUE_SIZE)))
        (local.set $power_result_slot
          (call $carve_scratch_blob (global.get $VALUE_SIZE)))
        (local.set $temporary_slot
          (call $carve_scratch_blob (global.get $VALUE_SIZE)))
        (local.set $status (call $complex_algebraic_evaluate_expression
          (local.get $arguments_data) (local.get $power_base_slot)))
        (if (local.get $status) (then (return (local.get $status))))
        (call $write_inline_rational (local.get $power_result_slot) (i64.const 1))
        (block $power_done
          (loop $power
            (br_if $power_done
              (i64.eqz (local.get $power_exponent)))
            (if (i64.ne
                  (i64.and (local.get $power_exponent) (i64.const 1))
                  (i64.const 0))
              (then
                (local.set $status (call $complex_algebraic_slot_arith
                  (i32.const 2) (local.get $power_result_slot)
                  (local.get $power_base_slot) (local.get $temporary_slot)))
                (if (local.get $status)
                  (then (return (select (i32.const 1)
                    (i32.add (local.get $status) (i32.const 1))
                    (i32.eq (local.get $status) (i32.const 1))))))
                (memory.copy (call $abs (local.get $power_result_slot))
                  (call $abs (local.get $temporary_slot)) (global.get $VALUE_SIZE))))
            (local.set $power_exponent
              (i64.shr_u (local.get $power_exponent) (i64.const 1)))
            (if (i64.ne (local.get $power_exponent) (i64.const 0))
              (then
                (local.set $status (call $complex_algebraic_slot_arith
                  (i32.const 2) (local.get $power_base_slot)
                  (local.get $power_base_slot) (local.get $temporary_slot)))
                (if (local.get $status)
                  (then (return (select (i32.const 1)
                    (i32.add (local.get $status) (i32.const 1))
                    (i32.eq (local.get $status) (i32.const 1))))))
                (memory.copy (call $abs (local.get $power_base_slot))
                  (call $abs (local.get $temporary_slot)) (global.get $VALUE_SIZE))))
            (br $power)))
        (if (local.get $negative_exponent)
          (then
            (call $write_inline_rational (local.get $power_base_slot) (i64.const 1))
            (local.set $status (call $complex_algebraic_slot_arith
              (i32.const 3) (local.get $power_base_slot)
              (local.get $power_result_slot) (local.get $out_slot)))
            (if (local.get $status)
              (then (return (select (i32.const 1)
                (i32.add (local.get $status) (i32.const 1))
                (i32.eq (local.get $status) (i32.const 1))))))
          )
          (else
            (memory.copy (call $abs (local.get $out_slot))
              (call $abs (local.get $power_result_slot))
              (global.get $VALUE_SIZE))))
        (return (i32.const 0))))
    (if (i32.eq (local.get $head) (call $symbol_registry_lookup
          (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_ADD))))
      (then (local.set $kind (i32.const 0)))
      (else
        (if (i32.eq (local.get $head) (call $symbol_registry_lookup
              (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_SUBTRACT))))
          (then (local.set $kind (i32.const 1)))
          (else
            (if (i32.eq (local.get $head) (call $symbol_registry_lookup
                  (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY))))
              (then (local.set $kind (i32.const 2)))
              (else
                (if (i32.eq (local.get $head) (call $symbol_registry_lookup
                      (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_DIVIDE))))
                  (then (local.set $kind (i32.const 3)))
                  (else (return (i32.const 2)))))))))
    )
    (if (call $expression_walk_guard (i32.const 96))
      (then (return (i32.const 1))))
    (local.set $left_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (local.set $right_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (local.set $status (call $complex_algebraic_evaluate_expression
      (local.get $arguments_data) (local.get $left_slot)))
    (if (local.get $status) (then (return (local.get $status))))
    (local.set $status (call $complex_algebraic_evaluate_expression
      (i32.add (local.get $arguments_data) (global.get $VALUE_SIZE))
      (local.get $right_slot)))
    (if (local.get $status) (then (return (local.get $status))))
    (local.set $status (call $complex_algebraic_slot_arith
      (local.get $kind) (local.get $left_slot) (local.get $right_slot)
      (local.get $out_slot)))
    (if (local.get $status)
      (then (return (select (i32.const 1)
        (i32.add (local.get $status) (i32.const 1))
        (i32.eq (local.get $status) (i32.const 1))))))
    (i32.const 0)
  )

  ;; Principal exact square root. The universal
  ;; sqrt((|z|+a)/2) + sign(b)i sqrt((|z|-a)/2) formula also covers
  ;; both real-axis branches; zero imaginary parts choose +i.
  ;; Returns 0 ok / 1 pressure / 2 caught throw / 3 uncaught throw.
  (func $complex_algebraic_principal_square_root
    (param $value_slot i32) (param $out_slot i32) (result i32)
    (local $work i32)
    (local $real i32)
    (local $imaginary i32)
    (local $real_squared i32)
    (local $imaginary_squared i32)
    (local $magnitude_squared i32)
    (local $magnitude i32)
    (local $two i32)
    (local $real_radicand i32)
    (local $imaginary_radicand i32)
    (local $root_real i32)
    (local $root_imaginary i32)
    (local $zero i32)
    (local $status i32)
    (local $comparison i32)
    (if (call $expression_walk_guard (i32.const 256))
      (then (return (i32.const 1))))
    (local.set $work (call $carve_scratch_blob (i32.const 192)))
    (local.set $real (local.get $work))
    (local.set $imaginary (i32.add (local.get $work) (i32.const 16)))
    (local.set $real_squared (i32.add (local.get $work) (i32.const 32)))
    (local.set $imaginary_squared (i32.add (local.get $work) (i32.const 48)))
    (local.set $magnitude_squared (i32.add (local.get $work) (i32.const 64)))
    (local.set $magnitude (i32.add (local.get $work) (i32.const 80)))
    (local.set $two (i32.add (local.get $work) (i32.const 96)))
    (local.set $real_radicand (i32.add (local.get $work) (i32.const 112)))
    (local.set $imaginary_radicand (i32.add (local.get $work) (i32.const 128)))
    (local.set $root_real (i32.add (local.get $work) (i32.const 144)))
    (local.set $root_imaginary (i32.add (local.get $work) (i32.const 160)))
    (local.set $zero (i32.add (local.get $work) (i32.const 176)))
    (call $complex_algebraic_split
      (local.get $value_slot) (local.get $real) (local.get $imaginary))
    (call $write_inline_rational (local.get $two) (i64.const 2))
    (call $write_inline_rational (local.get $zero) (i64.const 0))
    (local.set $status (call $complex_algebraic_slot_arith
      (i32.const 2) (local.get $real) (local.get $real) (local.get $real_squared)))
    (if (local.get $status) (then (return (local.get $status))))
    (local.set $status (call $complex_algebraic_slot_arith
      (i32.const 2) (local.get $imaginary) (local.get $imaginary)
      (local.get $imaginary_squared)))
    (if (local.get $status) (then (return (local.get $status))))
    (local.set $status (call $complex_algebraic_slot_arith
      (i32.const 0) (local.get $real_squared) (local.get $imaginary_squared)
      (local.get $magnitude_squared)))
    (if (local.get $status) (then (return (local.get $status))))
    (local.set $status (call $algebraic_nth_root_core
      (local.get $magnitude_squared) (i32.const 2) (local.get $magnitude) (i32.const 0)))
    (if (local.get $status) (then (return (local.get $status))))
    (local.set $status (call $complex_algebraic_slot_arith
      (i32.const 0) (local.get $magnitude) (local.get $real)
      (local.get $real_radicand)))
    (if (local.get $status) (then (return (local.get $status))))
    (local.set $status (call $complex_algebraic_slot_arith
      (i32.const 3) (local.get $real_radicand) (local.get $two)
      (local.get $real_radicand)))
    (if (local.get $status) (then (return (local.get $status))))
    (local.set $status (call $algebraic_nth_root_core
      (local.get $real_radicand) (i32.const 2) (local.get $root_real) (i32.const 0)))
    (if (local.get $status) (then (return (local.get $status))))
    (local.set $status (call $complex_algebraic_slot_arith
      (i32.const 1) (local.get $magnitude) (local.get $real)
      (local.get $imaginary_radicand)))
    (if (local.get $status) (then (return (local.get $status))))
    (local.set $status (call $complex_algebraic_slot_arith
      (i32.const 3) (local.get $imaginary_radicand) (local.get $two)
      (local.get $imaginary_radicand)))
    (if (local.get $status) (then (return (local.get $status))))
    (local.set $status (call $algebraic_nth_root_core
      (local.get $imaginary_radicand) (i32.const 2)
      (local.get $root_imaginary) (i32.const 0)))
    (if (local.get $status) (then (return (local.get $status))))
    (local.set $comparison (call $exact_real_compare_slots
      (local.get $imaginary) (local.get $zero)))
    (if (i32.eq (local.get $comparison) (i32.const -2))
      (then (return (i32.const 1))))
    (if (i32.lt_s (local.get $comparison) (i32.const 0))
      (then
        (local.set $status (call $complex_algebraic_slot_arith
          (i32.const 1) (local.get $zero) (local.get $root_imaginary)
          (local.get $root_imaginary)))
        (if (local.get $status) (then (return (local.get $status))))))
    (call $complex_algebraic_write_result
      (local.get $root_real) (local.get $root_imaginary) (local.get $out_slot))
  )

  (func $complex_algebraic_operator_negate (param $slot i32) (result i32)
    (local $work i32)
    (local $status i32)
    (if (call $expression_walk_guard (i32.const 64))
      (then (return (i32.const 1))))
    (local.set $work (call $carve_scratch_blob (i32.const 32)))
    (call $write_inline_rational (local.get $work) (i64.const 0))
    (local.set $status (call $complex_algebraic_slot_arith
      (i32.const 1) (local.get $work) (local.get $slot)
      (i32.add (local.get $work) (i32.const 16))))
    (if (local.get $status) (then (return (local.get $status))))
    (memory.copy
      (call $abs (local.get $slot))
      (call $abs (i32.add (local.get $work) (i32.const 16)))
      (global.get $VALUE_SIZE))
    (i32.const 0)
  )
  ;; Exact three-way comparison for any two real-tower value slots.
  ;; Returns -1/0/1, or -2 on pressure.
  (func $exact_real_compare_slots
    (param $left_slot i32) (param $right_slot i32) (result i32)
    (local $left_type i32)
    (local $right_type i32)
    (local $left_rational i32)
    (local $right_rational i32)
    (local.set $left_type (call $value_type (local.get $left_slot)))
    (local.set $right_type (call $value_type (local.get $right_slot)))
    (if (i32.or
          (i32.eq (local.get $left_type) (global.get $TYPE_ALGEBRAIC))
          (i32.eq (local.get $right_type) (global.get $TYPE_ALGEBRAIC)))
      (then (return (call $algebraic_operator_compare
        (local.get $left_slot) (local.get $right_slot)))))
    (if (i32.and
          (i32.eq (local.get $left_type) (global.get $TYPE_BIGINT))
          (i32.eq (local.get $right_type) (global.get $TYPE_BIGINT)))
      (then (return (call $bigint_compare
        (call $value_data_lo (local.get $left_slot))
        (call $value_data_lo (local.get $right_slot))))))
    (if (call $expression_walk_guard (i32.const 128))
      (then (return (i32.const -2))))
    (local.set $left_rational
      (if (result i32)
        (i32.eq (local.get $left_type) (global.get $TYPE_BIGINT))
        (then (call $rational_from_bigint
          (call $value_data_lo (local.get $left_slot))))
        (else (call $rational_materialize (local.get $left_slot)))))
    (local.set $right_rational
      (if (result i32)
        (i32.eq (local.get $right_type) (global.get $TYPE_BIGINT))
        (then (call $rational_from_bigint
          (call $value_data_lo (local.get $right_slot))))
        (else (call $rational_materialize (local.get $right_slot)))))
    (call $rational_header_pair_compare
      (local.get $left_rational) (local.get $right_rational))
  )


  ;; Principal n-th root of an exact complex value. For n > 2, derive the
  ;; principal cosine as the greatest real root of
  ;; T_n(c) - real(z)/|z|, then reconstruct the signed sine exactly.
  ;; Chebyshev fast doubling keeps the source expression logarithmic in n.
  ;; Returns 0 ok / 1 pressure / 2 caught throw / 3 uncaught throw.
  (func $complex_algebraic_principal_nth_root
    (param $value_slot i32) (param $n i32) (param $out_slot i32) (result i32)
    (local $work i32)
    (local $real i32)
    (local $imaginary i32)
    (local $real_squared i32)
    (local $imaginary_squared i32)
    (local $magnitude_squared i32)
    (local $magnitude i32)
    (local $radial_root i32)
    (local $ratio i32)
    (local $variable i32)
    (local $one i32)
    (local $two i32)
    (local $chebyshev i32)
    (local $next_chebyshev i32)
    (local $temporary i32)
    (local $temporary2 i32)
    (local $even_chebyshev i32)
    (local $odd_chebyshev i32)
    (local $candidate i32)
    (local $sine_squared i32)
    (local $sine i32)
    (local $root_real i32)
    (local $root_imaginary i32)
    (local $zero i32)
    (local $status i32)
    (local $highest_bit i32)
    (local $bit i32)
    (local $call_base i32)
    (local $roots_array i32)
    (local $roots_data i32)
    (local $root_count i32)
    (local $comparison i32)
    (if (i32.eq (local.get $n) (i32.const 2))
      (then (return (call $complex_algebraic_principal_square_root
        (local.get $value_slot) (local.get $out_slot)))))
    (if (call $expression_walk_guard (i32.const 480))
      (then (return (i32.const 1))))
    (local.set $work (call $carve_scratch_blob (i32.const 368)))
    (local.set $real (local.get $work))
    (local.set $imaginary (i32.add (local.get $work) (i32.const 16)))
    (local.set $real_squared (i32.add (local.get $work) (i32.const 32)))
    (local.set $imaginary_squared (i32.add (local.get $work) (i32.const 48)))
    (local.set $magnitude_squared (i32.add (local.get $work) (i32.const 64)))
    (local.set $magnitude (i32.add (local.get $work) (i32.const 80)))
    (local.set $radial_root (i32.add (local.get $work) (i32.const 96)))
    (local.set $ratio (i32.add (local.get $work) (i32.const 112)))
    (local.set $variable (i32.add (local.get $work) (i32.const 128)))
    (local.set $one (i32.add (local.get $work) (i32.const 144)))
    (local.set $two (i32.add (local.get $work) (i32.const 160)))
    (local.set $chebyshev (i32.add (local.get $work) (i32.const 176)))
    (local.set $next_chebyshev (i32.add (local.get $work) (i32.const 192)))
    (local.set $temporary (i32.add (local.get $work) (i32.const 208)))
    (local.set $temporary2 (i32.add (local.get $work) (i32.const 224)))
    (local.set $even_chebyshev (i32.add (local.get $work) (i32.const 240)))
    (local.set $odd_chebyshev (i32.add (local.get $work) (i32.const 256)))
    (local.set $candidate (i32.add (local.get $work) (i32.const 272)))
    (local.set $sine_squared (i32.add (local.get $work) (i32.const 288)))
    (local.set $sine (i32.add (local.get $work) (i32.const 304)))
    (local.set $root_real (i32.add (local.get $work) (i32.const 320)))
    (local.set $root_imaginary (i32.add (local.get $work) (i32.const 336)))
    (local.set $zero (i32.add (local.get $work) (i32.const 352)))
    (call $complex_algebraic_split
      (local.get $value_slot) (local.get $real) (local.get $imaginary))
    (call $write_inline_rational (local.get $one) (i64.const 1))
    (call $write_inline_rational (local.get $two) (i64.const 2))
    (call $write_inline_rational (local.get $zero) (i64.const 0))
    (local.set $status (call $complex_algebraic_slot_arith
      (i32.const 2) (local.get $real) (local.get $real) (local.get $real_squared)))
    (if (local.get $status) (then (return (local.get $status))))
    (local.set $status (call $complex_algebraic_slot_arith
      (i32.const 2) (local.get $imaginary) (local.get $imaginary)
      (local.get $imaginary_squared)))
    (if (local.get $status) (then (return (local.get $status))))
    (local.set $status (call $complex_algebraic_slot_arith
      (i32.const 0) (local.get $real_squared) (local.get $imaginary_squared)
      (local.get $magnitude_squared)))
    (if (local.get $status) (then (return (local.get $status))))
    (local.set $status (call $algebraic_nth_root_core
      (local.get $magnitude_squared) (i32.const 2)
      (local.get $magnitude) (i32.const 0)))
    (if (local.get $status) (then (return (local.get $status))))
    (if (i32.eq (call $algebraic_slot_is_exact_zero (local.get $magnitude))
          (i32.const 1))
      (then
        (call $write_inline_rational (local.get $out_slot) (i64.const 0))
        (return (i32.const 0))))
    (local.set $status (call $algebraic_nth_root_core
      (local.get $magnitude) (local.get $n)
      (local.get $radial_root) (i32.const 0)))
    (if (local.get $status) (then (return (local.get $status))))
    (local.set $comparison (call $exact_real_compare_slots
      (local.get $real) (local.get $zero)))
    (if (i32.eq (local.get $comparison) (i32.const -2))
      (then (return (i32.const 1))))
    (if (i32.eqz (local.get $comparison))
      (then
        (memory.copy (call $abs (local.get $ratio))
          (call $abs (local.get $zero)) (global.get $VALUE_SIZE)))
      (else
        (local.set $comparison (call $exact_real_compare_slots
          (local.get $real) (local.get $magnitude)))
        (if (i32.eq (local.get $comparison) (i32.const -2))
          (then (return (i32.const 1))))
        (if (i32.eqz (local.get $comparison))
          (then
            (memory.copy (call $abs (local.get $ratio))
              (call $abs (local.get $one)) (global.get $VALUE_SIZE)))
          (else
            (local.set $status (call $complex_algebraic_slot_arith
              (i32.const 1) (local.get $zero) (local.get $magnitude)
              (local.get $temporary)))
            (if (local.get $status) (then (return (local.get $status))))
            (local.set $comparison (call $exact_real_compare_slots
              (local.get $real) (local.get $temporary)))
            (if (i32.eq (local.get $comparison) (i32.const -2))
              (then (return (i32.const 1))))
            (if (i32.eqz (local.get $comparison))
              (then
                (local.set $status (call $complex_algebraic_slot_arith
                  (i32.const 1) (local.get $zero) (local.get $one)
                  (local.get $ratio)))
                (if (local.get $status) (then (return (local.get $status)))))
              (else
                (local.set $status (call $complex_algebraic_slot_arith
                  (i32.const 3) (local.get $real) (local.get $magnitude)
                  (local.get $ratio)))
                (if (local.get $status) (then (return (local.get $status))))))))))
    (call $write_value (local.get $variable)
      (global.get $TYPE_SYMBOL) (i32.const 0)
      (call $symbol_allocate
        (call $read_builtin (global.get $BUILTIN_EXACT_VARIABLE_X)))
      (i32.const 0))
    ;; (T_0, T_1) = (1, x), advanced by the bits of n.
    (memory.copy (call $abs (local.get $chebyshev))
      (call $abs (local.get $one)) (global.get $VALUE_SIZE))
    (memory.copy (call $abs (local.get $next_chebyshev))
      (call $abs (local.get $variable)) (global.get $VALUE_SIZE))
    (local.set $highest_bit (i32.const 31))
    (block $highest_found
      (loop $highest_scan
        (br_if $highest_found
          (i32.and (local.get $n)
            (i32.shl (i32.const 1) (local.get $highest_bit))))
        (local.set $highest_bit
          (i32.sub (local.get $highest_bit) (i32.const 1)))
        (br $highest_scan)))
    (local.set $bit (local.get $highest_bit))
    (block $bits_done
      (loop $bits
        (br_if $bits_done (i32.lt_s (local.get $bit) (i32.const 0)))
        (if (call $expression_walk_guard (i32.const 1024))
          (then (return (i32.const 1))))
        ;; T_2m = 2*T_m*T_m - 1.
        (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
          (local.get $chebyshev) (local.get $chebyshev) (local.get $temporary))
        (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
          (local.get $two) (local.get $temporary) (local.get $temporary2))
        (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_SUBTRACT)
          (local.get $temporary2) (local.get $one) (local.get $even_chebyshev))
        ;; T_2m+1 = 2*T_m*T_m+1 - x.
        (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
          (local.get $chebyshev) (local.get $next_chebyshev) (local.get $temporary))
        (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
          (local.get $two) (local.get $temporary) (local.get $temporary2))
        (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_SUBTRACT)
          (local.get $temporary2) (local.get $variable) (local.get $odd_chebyshev))
        (if (i32.and (local.get $n)
              (i32.shl (i32.const 1) (local.get $bit)))
          (then
            ;; T_2m+2 = 2*T_m+1*T_m+1 - 1.
            (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
              (local.get $next_chebyshev) (local.get $next_chebyshev)
              (local.get $temporary))
            (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
              (local.get $two) (local.get $temporary) (local.get $temporary2))
            (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_SUBTRACT)
              (local.get $temporary2) (local.get $one) (local.get $next_chebyshev))
            (memory.copy (call $abs (local.get $chebyshev))
              (call $abs (local.get $odd_chebyshev)) (global.get $VALUE_SIZE)))
          (else
            (memory.copy (call $abs (local.get $chebyshev))
              (call $abs (local.get $even_chebyshev)) (global.get $VALUE_SIZE))
            (memory.copy (call $abs (local.get $next_chebyshev))
              (call $abs (local.get $odd_chebyshev)) (global.get $VALUE_SIZE))))
        (local.set $bit (i32.sub (local.get $bit) (i32.const 1)))
        (br $bits)))
    (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_SUBTRACT)
      (local.get $chebyshev) (local.get $ratio) (local.get $temporary))
    (local.set $call_base (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (call $pending_push
      (call $value_type (local.get $temporary))
      (call $value_flags (local.get $temporary))
      (call $value_data_lo (local.get $temporary))
      (call $value_data_hi (local.get $temporary)))
    (call $pending_push
      (call $value_type (local.get $variable))
      (call $value_flags (local.get $variable))
      (call $value_data_lo (local.get $variable))
      (call $value_data_hi (local.get $variable)))
    (local.set $status (call $algebraic_roots_of_polynomial
      (global.get $TYPE_OBJECT) (i32.const 0)
      (global.get $METHOD_EXACT_ALGEBRAIC_ROOTS_OF_POLYNOMIAL)
      (i32.const 2) (local.get $call_base)))
    (if (global.get $memory_pressure_signaled)
      (then
        (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $call_base))
        (return (i32.const 1))))
    (if (i32.eq (local.get $status) (i32.const 1))
      (then
        (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $call_base))
        (return (i32.const 2))))
    (if (i32.eq (local.get $status) (i32.const 2))
      (then
        (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $call_base))
        (return (i32.const 3))))
    (local.set $roots_array (call $value_data_lo (local.get $call_base)))
    (local.set $root_count
      (i32.load (call $abs (i32.add (local.get $roots_array) (i32.const 8)))))
    (local.set $roots_data (i32.add
      (i32.load (call $abs (i32.add (local.get $roots_array) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (memory.copy (call $abs (local.get $candidate))
      (call $abs (i32.add (local.get $roots_data)
        (i32.mul (i32.sub (local.get $root_count) (i32.const 1))
          (global.get $VALUE_SIZE))))
      (global.get $VALUE_SIZE))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $call_base))
    (local.set $status (call $complex_algebraic_slot_arith
      (i32.const 2) (local.get $candidate) (local.get $candidate)
      (local.get $sine_squared)))
    (if (local.get $status) (then (return (local.get $status))))
    (local.set $status (call $complex_algebraic_slot_arith
      (i32.const 1) (local.get $one) (local.get $sine_squared)
      (local.get $sine_squared)))
    (if (local.get $status) (then (return (local.get $status))))
    (local.set $status (call $algebraic_nth_root_core
      (local.get $sine_squared) (i32.const 2) (local.get $sine) (i32.const 0)))
    (if (local.get $status) (then (return (local.get $status))))
    (local.set $status (call $complex_algebraic_slot_arith
      (i32.const 2) (local.get $radial_root) (local.get $candidate)
      (local.get $root_real)))
    (if (local.get $status) (then (return (local.get $status))))
    (local.set $status (call $complex_algebraic_slot_arith
      (i32.const 2) (local.get $radial_root) (local.get $sine)
      (local.get $root_imaginary)))
    (if (local.get $status) (then (return (local.get $status))))
    (local.set $comparison (call $exact_real_compare_slots
      (local.get $imaginary) (local.get $zero)))
    (if (i32.eq (local.get $comparison) (i32.const -2))
      (then (return (i32.const 1))))
    (if (i32.lt_s (local.get $comparison) (i32.const 0))
      (then
        (local.set $status (call $complex_algebraic_slot_arith
          (i32.const 1) (local.get $zero) (local.get $root_imaginary)
          (local.get $root_imaginary)))
        (if (local.get $status) (then (return (local.get $status))))))
    (call $complex_algebraic_write_result
      (local.get $root_real) (local.get $root_imaginary) (local.get $out_slot))
  )

  ;; Exact equality over all real/complex tower combinations.
  ;; Returns 0/1, or -2 on pressure.
  (func $complex_algebraic_equals_slots
    (param $left_slot i32) (param $right_slot i32) (result i32)
    (local $work i32)
    (local $comparison i32)
    (if (call $expression_walk_guard (i32.const 160))
      (then (return (i32.const -2))))
    (local.set $work (call $carve_scratch_blob (i32.const 128)))
    (call $complex_algebraic_split
      (local.get $left_slot) (local.get $work)
      (i32.add (local.get $work) (i32.const 16)))
    (call $complex_algebraic_split
      (local.get $right_slot) (i32.add (local.get $work) (i32.const 32))
      (i32.add (local.get $work) (i32.const 48)))
    (local.set $comparison (call $exact_real_compare_slots
      (local.get $work) (i32.add (local.get $work) (i32.const 32))))
    (if (i32.eq (local.get $comparison) (i32.const -2))
      (then (return (i32.const -2))))
