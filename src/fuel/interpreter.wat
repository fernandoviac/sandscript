  ;; BigInt.asIntN / BigInt.asUintN. Arguments stay on the pending stack
  ;; until every pressure-prone conversion and allocation has succeeded.
  (func $bigint_fixed_width_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $bits_pointer i32)
    (local $value_pointer i32)
    (local $bits_type i32)
    (local $value_type i32)
    (local $bits_f64 f64)
    (local $bits i32)
    (local $source i32)
    (local $source_length i32)
    (local $source_bit_length i32)
    (local $top_limb i32)
    (local $output_length i32)
    (local $output i32)
    (local $index i32)
    (local $limb i32)
    (local $carry i32)
    (local $high_mask i32)
    (local $high_bits i32)
    (local $negative_output i32)
    (local $parsed i32)

    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $bits_pointer
          (i32.sub (local.get $pending_pointer)
            (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (if (i32.eq
              (call $value_type (local.get $bits_pointer))
              (global.get $TYPE_OBJECT))
          (then
            (return
              (call $stage_bigint_to_primitive
                (local.get $bits_pointer)
                (call $value_data_lo (local.get $bits_pointer))
                (local.get $pending_pointer)
                (i32.const 0)))))
        (call $coerce_to_number_at (local.get $bits_pointer))
        (local.set $bits_type (call $value_type (local.get $bits_pointer)))))
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then
        (local.set $value_pointer
          (i32.add (local.get $bits_pointer) (global.get $VALUE_SIZE)))
        (local.set $value_type (call $value_type (local.get $value_pointer)))))
    (if (i32.eq (local.get $value_type) (global.get $TYPE_OBJECT))
      (then
        (if (i32.and
              (i32.eq
                (i32.and
                  (i32.load
                    (call $abs
                      (call $value_data_lo (local.get $value_pointer))))
                  (i32.const 0x00FFFFFF))
                (i32.const 48))
              (i32.ne
                (i32.load
                  (call $abs
                    (i32.add
                      (call $value_data_lo (local.get $value_pointer))
                      (i32.const 32))))
                (i32.const 0)))
          (then
            (call $write_value
              (local.get $value_pointer)
              (global.get $TYPE_BIGINT) (i32.const 0)
              (i32.load
                (call $abs
                  (i32.add
                    (call $value_data_lo (local.get $value_pointer))
                    (i32.const 32))))
              (i32.const 0))
            (local.set $value_type (global.get $TYPE_BIGINT)))
          (else
            (return
              (call $stage_bigint_to_primitive
                (local.get $value_pointer)
                (call $value_data_lo (local.get $value_pointer))
                (local.get $pending_pointer)
                (i32.const 0)))))))

    ;; ToIndex(bits).
    (if (i32.eqz (local.get $argc))
      (then (local.set $bits_f64 (f64.const 0)))
      (else
        (if (i32.or
              (i32.eq (local.get $bits_type) (global.get $TYPE_BIGINT))
              (i32.eqz (call $value_is_numeric (local.get $bits_pointer))))
          (then
            (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
            (if (call $throw_type_error)
              (then (return (i32.const 2)))
              (else (return (i32.const 1))))))
        (local.set $bits_f64 (call $value_to_f64 (local.get $bits_pointer)))
        (if (f64.ne (local.get $bits_f64) (local.get $bits_f64))
          (then (local.set $bits_f64 (f64.const 0))))
        (local.set $bits_f64 (f64.trunc (local.get $bits_f64)))
        (if (i32.or
              (f64.lt (local.get $bits_f64) (f64.const 0))
              (f64.gt (local.get $bits_f64) (f64.const 9007199254740991)))
          (then
            (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
            (if (call $throw_range_error)
              (then (return (i32.const 2)))
              (else (return (i32.const 1))))))))

    ;; ToBigInt(value). Missing value is undefined and therefore a TypeError.
    (if (i32.lt_u (local.get $argc) (i32.const 2))
      (then
        (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
        (if (call $throw_type_error)
          (then (return (i32.const 2)))
          (else (return (i32.const 1))))))
    (if (i32.eq (local.get $value_type) (global.get $TYPE_BIGINT))
      (then (local.set $source (call $value_data_lo (local.get $value_pointer))))
      (else
        (if (i32.eq (local.get $value_type) (global.get $TYPE_BOOLEAN))
          (then
            (if (call $check_heap_overflow
                  (call $estimate_bigint_size
                    (select (i32.const 1) (i32.const 0)
                      (call $value_data_lo (local.get $value_pointer)))))
              (then (return (i32.const 0))))
            (local.set $source
              (call $bigint_alloc (i32.const 0)
                (select (i32.const 1) (i32.const 0)
                  (call $value_data_lo (local.get $value_pointer)))))
            (if (call $value_data_lo (local.get $value_pointer))
              (then
                (call $bigint_set_limb
                  (local.get $source) (i32.const 0) (i32.const 1)))))
          (else
            (if (i32.eq (local.get $value_type) (global.get $TYPE_STRING))
              (then
                (local.set $parsed
                  (call $string_to_bigint
                    (call $value_data_lo (local.get $value_pointer))))
                (if (global.get $memory_pressure_signaled)
                  (then (return (i32.const 0))))
                (if (i32.eq (local.get $parsed) (i32.const -1))
                  (then
                    (call $write_ctx
                      (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
                    (if (call $throw_syntax_error)
                      (then (return (i32.const 2)))
                      (else (return (i32.const 1))))))
                (local.set $source (local.get $parsed)))
              (else
                (call $write_ctx
                  (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
                (if (call $throw_type_error)
                  (then (return (i32.const 2)))
                  (else (return (i32.const 1))))))))))

    (local.set $source_length (call $bigint_length (local.get $source)))
    (if (local.get $source_length)
      (then
        (local.set $top_limb
          (call $bigint_limb
            (local.get $source)
            (i32.sub (local.get $source_length) (i32.const 1))))
        (local.set $source_bit_length
          (i32.add
            (i32.mul
              (i32.sub (local.get $source_length) (i32.const 1))
              (i32.const 32))
            (i32.sub (i32.const 32) (i32.clz (local.get $top_limb)))))))

    ;; Width zero always produces canonical zero.
    (if (f64.eq (local.get $bits_f64) (f64.const 0))
      (then
        (if (call $check_heap_overflow (call $estimate_bigint_size (i32.const 0)))
          (then (return (i32.const 0))))
        (local.set $output (call $bigint_alloc (i32.const 0) (i32.const 0)))
        (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
        (call $push_bigint (local.get $output))
        (return (i32.const 0))))

    ;; Widths beyond the addressable limb range can only complete without
    ;; allocation when the mathematical result is the input itself.
    (if (f64.gt (local.get $bits_f64) (f64.const 4294967295))
      (then
        (if (i32.or
              (i32.eq (local.get $method_id) (global.get $METHOD_BIGINT_AS_INT_N))
              (i32.eqz (call $bigint_sign (local.get $source))))
          (then
            (call $write_ctx
              (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
            (call $pending_push
              (global.get $TYPE_BIGINT) (i32.const 0)
              (local.get $source) (i32.const 0))
            (return (i32.const 0))))))

    (if (f64.gt (local.get $bits_f64) (f64.const 4294967295))
      (then
        (call $signal_memory_pressure)
        (return (i32.const 0))))
    (local.set $bits (i32.trunc_f64_u (local.get $bits_f64)))
    (local.set $output_length
      (i32.shr_u (i32.add (local.get $bits) (i32.const 31)) (i32.const 5)))
    (if (call $check_heap_overflow
          (call $estimate_bigint_size (local.get $output_length)))
      (then (return (i32.const 0))))
    (local.set $output
      (call $bigint_alloc (i32.const 0) (local.get $output_length)))

    ;; Copy the low limbs. A negative source is converted to its width-limited
    ;; two's-complement residue in place.
    (local.set $carry (call $bigint_sign (local.get $source)))
    (local.set $index (i32.const 0))
    (block $copy_done
      (loop $copy_loop
        (br_if $copy_done (i32.ge_u (local.get $index) (local.get $output_length)))
        (local.set $limb
          (select
            (call $bigint_limb (local.get $source) (local.get $index))
            (i32.const 0)
            (i32.lt_u (local.get $index) (local.get $source_length))))
        (if (call $bigint_sign (local.get $source))
          (then
            (local.set $limb (i32.xor (local.get $limb) (i32.const -1)))
            (if (local.get $carry)
              (then
                (local.set $carry (i32.eq (local.get $limb) (i32.const -1)))
                (local.set $limb (i32.add (local.get $limb) (i32.const 1)))))))
        (call $bigint_set_limb
          (local.get $output) (local.get $index) (local.get $limb))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $copy_loop)))

    (local.set $high_bits (i32.and (local.get $bits) (i32.const 31)))
    (if (local.get $high_bits)
      (then
        (local.set $high_mask
          (i32.sub (i32.shl (i32.const 1) (local.get $high_bits)) (i32.const 1)))
        (call $bigint_set_limb
          (local.get $output)
          (i32.sub (local.get $output_length) (i32.const 1))
          (i32.and
            (call $bigint_limb
              (local.get $output)
              (i32.sub (local.get $output_length) (i32.const 1)))
            (local.get $high_mask)))))

    (if (i32.eq (local.get $method_id) (global.get $METHOD_BIGINT_AS_INT_N))
      (then
        (local.set $negative_output
          (i32.and
            (i32.shr_u
              (call $bigint_limb
                (local.get $output)
                (i32.shr_u (i32.sub (local.get $bits) (i32.const 1)) (i32.const 5)))
              (i32.and (i32.sub (local.get $bits) (i32.const 1)) (i32.const 31)))
            (i32.const 1)))
        (if (local.get $negative_output)
          (then
            (local.set $carry (i32.const 1))
            (local.set $index (i32.const 0))
            (block $signed_done
              (loop $signed_loop
                (br_if $signed_done
                  (i32.ge_u (local.get $index) (local.get $output_length)))
                (local.set $limb
                  (i32.xor
                    (call $bigint_limb (local.get $output) (local.get $index))
                    (i32.const -1)))
                (if (local.get $carry)
                  (then
                    (local.set $carry (i32.eq (local.get $limb) (i32.const -1)))
                    (local.set $limb (i32.add (local.get $limb) (i32.const 1)))))
                (call $bigint_set_limb
                  (local.get $output) (local.get $index) (local.get $limb))
                (local.set $index (i32.add (local.get $index) (i32.const 1)))
                (br $signed_loop)))
            (if (local.get $high_bits)
              (then
                (call $bigint_set_limb
                  (local.get $output)
                  (i32.sub (local.get $output_length) (i32.const 1))
                  (i32.and
                    (call $bigint_limb
                      (local.get $output)
                      (i32.sub (local.get $output_length) (i32.const 1)))
                    (local.get $high_mask)))))
            (i32.store
              (call $abs
                (i32.add (local.get $output) (global.get $GC_HEADER_SIZE)))
              (i32.const 1))))))

    (call $bigint_normalize (local.get $output))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (call $push_bigint (local.get $output))
    (return (i32.const 0))
  )

  ;; BigInt.prototype primitive methods.
  (func $bigint_prototype_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument_pointer i32)
    (local $argument_type i32)
    (local $radix_f64 f64)
    (local $radix i32)
    (local $string_offset i32)

    (if (i32.and
          (i32.eq (local.get $receiver_type) (global.get $TYPE_OBJECT))
          (i32.eq
            (i32.and
              (i32.load (call $abs (local.get $receiver_pointer)))
              (i32.const 0x00FFFFFF))
            (i32.const 48)))
      (then
        (local.set $receiver_type (global.get $TYPE_BIGINT))
        (local.set $receiver_pointer
          (i32.load
            (call $abs
              (i32.add (local.get $receiver_pointer) (i32.const 32)))))))

    (if (i32.ne (local.get $receiver_type) (global.get $TYPE_BIGINT))
      (then
        (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
        (if (call $throw_type_error)
          (then (return (i32.const 2)))
          (else (return (i32.const 1))))))

    (if (i32.eq (local.get $method_id) (global.get $METHOD_BIGINT_VALUE_OF))
      (then
        (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
        (call $push_bigint (local.get $receiver_pointer))
        (return (i32.const 0))))

    (local.set $radix (i32.const 10))
    (if (i32.and
          (i32.eq (local.get $method_id) (global.get $METHOD_BIGINT_TO_STRING))
          (i32.ge_u (local.get $argc) (i32.const 1)))
      (then
        (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
        (local.set $argument_pointer
          (i32.sub (local.get $pending_pointer)
            (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $argument_type (call $value_type (local.get $argument_pointer)))
        (if (i32.ne (local.get $argument_type) (global.get $TYPE_UNDEFINED))
          (then
            (if (i32.eq
                  (local.get $argument_type)
                  (global.get $TYPE_OBJECT))
              (then
                (return
                  (call $stage_bigint_to_primitive
                    (local.get $argument_pointer)
                    (call $value_data_lo (local.get $argument_pointer))
                    (local.get $pending_pointer)
                    (i32.const 0)))))
            (call $coerce_to_number_at (local.get $argument_pointer))
            (if (i32.eqz (call $value_is_numeric (local.get $argument_pointer)))
              (then
                (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
                (if (call $throw_type_error)
                  (then (return (i32.const 2)))
                  (else (return (i32.const 1))))))
            (local.set $radix_f64 (call $value_to_f64 (local.get $argument_pointer)))
            (if (i32.or
                  (f64.ne (local.get $radix_f64) (local.get $radix_f64))
                  (i32.or
                    (f64.lt (f64.trunc (local.get $radix_f64)) (f64.const 2))
                    (f64.gt (f64.trunc (local.get $radix_f64)) (f64.const 36))))
              (then
                (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
                (if (call $throw_range_error)
                  (then (return (i32.const 2)))
                  (else (return (i32.const 1))))))
            (local.set $radix (i32.trunc_f64_u (f64.trunc (local.get $radix_f64))))))))

    (local.set $string_offset
      (call $bigint_to_radix (local.get $receiver_pointer) (local.get $radix)))
    (if (global.get $memory_pressure_signaled)
      (then (return (i32.const 0))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (call $pending_push
      (global.get $TYPE_STRING) (i32.const 0) (local.get $string_offset) (i32.const 0))
    (i32.const 0)
  )

  ;; Object(value) conversion. BigInt primitives receive a wrapper carrying
  ;; an internal [[BigIntData]] pointer; existing objects are returned as-is.
  (func $object_conversion_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $argument_pointer i32)
    (local $argument_type i32)
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument_pointer
          (i32.add (local.get $stack_base) (global.get $VALUE_SIZE)))
        (local.set $argument_type
          (call $value_type (local.get $argument_pointer)))
        (if (i32.eq (local.get $argument_type) (global.get $TYPE_BIGINT))
          (then
            (if (call $check_heap_overflow (i32.const 64))
              (then (return (i32.const 0))))
            (local.set $receiver_pointer
              (call $allocate_bigint_wrapper
                (call $value_data_lo (local.get $argument_pointer))))
            (call $write_ctx
              (global.get $CTX_PENDING_POINTER)
              (local.get $stack_base))
            (call $pending_push
              (global.get $TYPE_OBJECT)
              (i32.const 0)
              (local.get $receiver_pointer)
              (i32.const 0))
            (return (i32.const 0))))
        (if (i32.or
              (i32.eq (local.get $argument_type) (global.get $TYPE_OBJECT))
              (i32.or
                (i32.eq (local.get $argument_type) (global.get $TYPE_ARRAY))
                (i32.eq (local.get $argument_type) (global.get $TYPE_FUNCTION))))
          (then
            (call $write_ctx
              (global.get $CTX_PENDING_POINTER)
              (local.get $stack_base))
            (call $pending_push
              (local.get $argument_type)
              (call $value_flags (local.get $argument_pointer))
              (call $value_data_lo (local.get $argument_pointer))
              (call $value_data_hi (local.get $argument_pointer)))
            (return (i32.const 0))))))
    (if (call $check_heap_overflow (i32.const 48))
      (then (return (i32.const 0))))
    (local.set $receiver_pointer (call $allocate_object (i32.const 0)))
    (i32.store
      (call $abs (i32.add (local.get $receiver_pointer) (i32.const 8)))
      (call $read_state (global.get $STATE_OBJECT_PROTOTYPE)))
    (call $write_ctx
      (global.get $CTX_PENDING_POINTER)
      (local.get $stack_base))
    (call $pending_push
      (global.get $TYPE_OBJECT)
      (i32.const 0)
      (local.get $receiver_pointer)
      (i32.const 0))
    (i32.const 0)
  )

  ;; ==========================================================================
  ;; Symbol methods (dispatch-table migration, batch 9): Symbol(),
  ;; Symbol.for, Symbol.keyFor,
  ;; sym.toString(). Symbol() reaches here via the TYPE_CONSTRUCTOR
  ;; receiver path (called without `new`); `new Symbol()` goes through
  ;; $run's separate constructor-invocation ladder but dispatches the
  ;; same method id — both paths are legitimate, not a duplicate.
  ;; ==========================================================================

  (func $symbol_constructor_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $arg1_type i32)
    (local $arg1_lo i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $arg1_type (call $value_type (local.get $argument1_pointer)))
        (local.set $arg1_lo (call $value_data_lo (local.get $argument1_pointer)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (call $check_heap_overflow (call $estimate_symbol_size))
      (then (return (i32.const 0))))
    (if (i32.eqz (local.get $argc))
      (then
        (call $push_symbol (call $symbol_allocate (i32.const 0)))
        (return (i32.const 0))))
    (if (i32.eq (local.get $arg1_type) (global.get $TYPE_UNDEFINED))
      (then
        (call $push_symbol (call $symbol_allocate (i32.const 0)))
        (return (i32.const 0))))
    (if (i32.eq (local.get $arg1_type) (global.get $TYPE_STRING))
      (then
        (call $push_symbol (call $symbol_allocate (local.get $arg1_lo)))
        (return (i32.const 0))))
    (if (result i32) (call $throw_type_error)
      (then (return (i32.const 2)))
      (else (return (i32.const 1))))
  )

  (func $symbol_for
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $arg1_type i32)
    (local $arg1_lo i32)
    (local $i32_result i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $arg1_type (call $value_type (local.get $argument1_pointer)))
        (local.set $arg1_lo (call $value_data_lo (local.get $argument1_pointer)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (i32.ne (local.get $arg1_type) (global.get $TYPE_STRING))
      (then
        (if (call $throw_type_error)
          (then (return (i32.const 2)))
          (else (return (i32.const 1))))))
    (local.set $i32_result
      (call $symbol_registry_get_or_create (local.get $arg1_lo)))
    (if (i32.eqz (local.get $i32_result))
      (then (return (i32.const 0))))
    (call $push_symbol (local.get $i32_result))
    (i32.const 0)
  )

  (func $symbol_key_for
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $arg1_type i32)
    (local $arg1_lo i32)
    (local $i32_result i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $arg1_type (call $value_type (local.get $argument1_pointer)))
        (local.set $arg1_lo (call $value_data_lo (local.get $argument1_pointer)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (i32.ne (local.get $arg1_type) (global.get $TYPE_SYMBOL))
      (then
        (if (call $throw_type_error)
          (then (return (i32.const 2)))
          (else (return (i32.const 1))))))
    (local.set $i32_result (call $symbol_registry_key_for (local.get $arg1_lo)))
    (if (local.get $i32_result)
      (then
        (call $pending_push (global.get $TYPE_STRING) (i32.const 0)
          (local.get $i32_result) (i32.const 0))
        (return (i32.const 0))))
    (call $pending_push (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))
    (i32.const 0)
  )

  (func $symbol_to_string_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $i32_result i32)
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (local.set $i32_result (call $symbol_description (local.get $receiver_pointer)))
    (if (i32.eqz (local.get $i32_result))
      (then
        (call $pending_push (global.get $TYPE_STRING) (i32.const 0)
          (call $read_builtin (global.get $BUILTIN_SYMBOL_LIT_EMPTY))
          (i32.const 0))
        (return (i32.const 0))))
    (call $pending_push (global.get $TYPE_STRING) (i32.const 0)
      (call $string_concat
        (call $string_concat
          (call $read_builtin (global.get $BUILTIN_SYMBOL_LIT_PREFIX))
          (local.get $i32_result))
        (call $read_builtin (global.get $BUILTIN_SYMBOL_LIT_SUFFIX)))
      (i32.const 0))
    (i32.const 0)
  )

  ;; ==========================================================================
  ;; Expression construction + inspection. Each function
  ;; re-derives whichever arg1/arg2/arg3 fields it uses.

  ;; ==========================================================================

  (func $expression_make
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $arg1_type i32)
    (local $arg1_lo i32)
    (local $argument2_pointer i32)
    (local $arg2_type i32)
    (local $arg2_lo i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $arg1_type (call $value_type (local.get $argument1_pointer)))
        (local.set $arg1_lo (call $value_data_lo (local.get $argument1_pointer)))))
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then
        (local.set $argument2_pointer (i32.add (local.get $argument1_pointer) (global.get $VALUE_SIZE)))
        (local.set $arg2_type (call $value_type (local.get $argument2_pointer)))
        (local.set $arg2_lo (call $value_data_lo (local.get $argument2_pointer)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (i32.ne (local.get $arg1_type) (global.get $TYPE_SYMBOL))
      (then
        (if (call $throw_type_error)
          (then (return (i32.const 2)))
          (else (return (i32.const 1))))))
    (if (i32.ne (local.get $arg2_type) (global.get $TYPE_ARRAY))
      (then
        (if (call $throw_type_error)
          (then (return (i32.const 2)))
          (else (return (i32.const 1))))))
    (if (i32.eqz (call $expression_validate_args_array (local.get $arg2_lo)))
      (then
        (if (call $throw_type_error)
          (then (return (i32.const 2)))
          (else (return (i32.const 1))))))
    (call $push_expression
      (call $expression_build (local.get $arg1_lo) (local.get $arg2_lo)))
    (i32.const 0)
  )

  ;; add/subtract/multiply/divide/power: identical binary-op shape,
  ;; differing only in the BUILTIN_EXPRESSION_HEAD_* constant. One
  ;; shared function, branching on method_id internally (matches
  ;; set_theoretic_ops' pattern for the same reason: the ids aren't a
  ;; contiguous range, so no arithmetic shortcut like the typed-array
  ;; from()/of() range checks applies here).
  (func $expression_binary_op
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $arg1_type i32)
    (local $argument2_pointer i32)
    (local $arg2_type i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $arg1_type (call $value_type (local.get $argument1_pointer)))))
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then
        (local.set $argument2_pointer (i32.add (local.get $argument1_pointer) (global.get $VALUE_SIZE)))
        (local.set $arg2_type (call $value_type (local.get $argument2_pointer)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    ;; Exactly 2 arguments are required: argc > 2 must not silently read
    ;; only the first two and discard the rest.

    (if (i32.ne (local.get $argc) (i32.const 2))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_EXPRESSION_BINARY_ARITY))))))
    (if (call $check_heap_overflow (call $estimate_expression_op_budget))
      (then (return (i32.const 0))))
    (if (i32.eqz (call $expression_arg_type_ok (local.get $arg1_type)))
      (then
        (if (call $throw_type_error)
          (then (return (i32.const 2)))
          (else (return (i32.const 1))))))
    (if (i32.eqz (call $expression_arg_type_ok (local.get $arg2_type)))
      (then
        (if (call $throw_type_error)
          (then (return (i32.const 2)))
          (else (return (i32.const 1))))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_EXACT_EXPRESSION_ADD))
      (then
        (call $push_expression
          (call $expression_build
            (call $symbol_registry_lookup (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_ADD)))
            (call $expression_alloc_args2 (local.get $argument1_pointer) (local.get $argument2_pointer))))
        (return (i32.const 0))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_EXACT_EXPRESSION_SUBTRACT))
      (then
        (call $push_expression
          (call $expression_build
            (call $symbol_registry_lookup (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_SUBTRACT)))
            (call $expression_alloc_args2 (local.get $argument1_pointer) (local.get $argument2_pointer))))
        (return (i32.const 0))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_EXACT_EXPRESSION_MULTIPLY))
      (then
        (call $push_expression
          (call $expression_build
            (call $symbol_registry_lookup (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)))
            (call $expression_alloc_args2 (local.get $argument1_pointer) (local.get $argument2_pointer))))
        (return (i32.const 0))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_EXACT_EXPRESSION_DIVIDE))
      (then
        (call $push_expression
          (call $expression_build
            (call $symbol_registry_lookup (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_DIVIDE)))
            (call $expression_alloc_args2 (local.get $argument1_pointer) (local.get $argument2_pointer))))
        (return (i32.const 0))))
    (call $push_expression
      (call $expression_build
        (call $symbol_registry_lookup (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_POWER)))
        (call $expression_alloc_args2 (local.get $argument1_pointer) (local.get $argument2_pointer))))
    (i32.const 0)
  )

  (func $expression_negate
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $arg1_type i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))

      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $arg1_type (call $value_type (local.get $argument1_pointer)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (call $check_heap_overflow (call $estimate_expression_op_budget))
      (then (return (i32.const 0))))
    (if (i32.eqz (call $expression_arg_type_ok (local.get $arg1_type)))
      (then
        (if (call $throw_type_error)
          (then (return (i32.const 2)))
          (else (return (i32.const 1))))))
    (call $push_expression
      (call $expression_build
        (call $symbol_registry_lookup (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_NEGATE)))
        (call $expression_alloc_args1 (local.get $argument1_pointer))))
    (i32.const 0)
  )
  ;; Build Sin(z) or Cos(z) from the one primitive transcendental head:
  ;; Sin(z) = (Exp(i z) - Exp(-i z)) / 2i
  ;; Cos(z) = (Exp(i z) + Exp(-i z)) / 2.
  (func $expression_build_derived_trigonometric
    (param $argument_slot i32) (param $cosine i32) (param $destination_slot i32)
    (result i32)
    (local $work i32)
    (local $imaginary_unit_slot i32)
    (local $imaginary_argument_slot i32)
    (local $negative_imaginary_argument_slot i32)
    (local $positive_exponential_slot i32)
    (local $negative_exponential_slot i32)
    (local $numerator_slot i32)
    (local $denominator_slot i32)
    (local $zero i32)
    (local $one i32)
    (local $two i32)
    (if (call $expression_walk_guard (i32.const 1024))
      (then (return (i32.const 1))))
    (local.set $work (call $carve_scratch_blob (i32.const 112)))
    (local.set $imaginary_unit_slot (local.get $work))
    (local.set $imaginary_argument_slot (i32.add (local.get $work) (i32.const 16)))
    (local.set $negative_imaginary_argument_slot (i32.add (local.get $work) (i32.const 32)))
    (local.set $positive_exponential_slot (i32.add (local.get $work) (i32.const 48)))
    (local.set $negative_exponential_slot (i32.add (local.get $work) (i32.const 64)))
    (local.set $numerator_slot (i32.add (local.get $work) (i32.const 80)))
    (local.set $denominator_slot (i32.add (local.get $work) (i32.const 96)))
    (local.set $zero (call $rational_new (call $bigint_zero) (call $bigint_one)))
    (local.set $one (call $rational_new (call $bigint_one) (call $bigint_one)))
    (local.set $two (call $rational_new
      (call $bigint_from_i64 (i64.const 2)) (call $bigint_one)))
    (call $write_value (local.get $imaginary_unit_slot)
      (global.get $TYPE_COMPLEX) (i32.const 0)
      (call $complex_allocate (local.get $zero) (local.get $one)) (i32.const 0))
    (call $write_value (local.get $imaginary_argument_slot)
      (global.get $TYPE_EXPRESSION) (i32.const 0)
      (call $expression_build
        (call $symbol_registry_lookup
          (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)))
        (call $expression_alloc_args2
          (local.get $imaginary_unit_slot) (local.get $argument_slot)))
      (i32.const 0))
    (call $write_value (local.get $negative_imaginary_argument_slot)
      (global.get $TYPE_EXPRESSION) (i32.const 0)
      (call $expression_build
        (call $symbol_registry_lookup
          (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_NEGATE)))
        (call $expression_alloc_args1 (local.get $imaginary_argument_slot)))
      (i32.const 0))
    (call $write_value (local.get $positive_exponential_slot)
      (global.get $TYPE_EXPRESSION) (i32.const 0)
      (call $expression_build
        (call $symbol_registry_lookup
          (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_EXP)))
        (call $expression_alloc_args1 (local.get $imaginary_argument_slot)))
      (i32.const 0))
    (call $write_value (local.get $negative_exponential_slot)
      (global.get $TYPE_EXPRESSION) (i32.const 0)
      (call $expression_build
        (call $symbol_registry_lookup
          (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_EXP)))
        (call $expression_alloc_args1
          (local.get $negative_imaginary_argument_slot)))
      (i32.const 0))
    (call $write_value (local.get $numerator_slot)
      (global.get $TYPE_EXPRESSION) (i32.const 0)
      (call $expression_build
        (call $symbol_registry_lookup (call $read_builtin
          (if (result i32) (local.get $cosine)
            (then (global.get $BUILTIN_EXPRESSION_HEAD_ADD))
            (else (global.get $BUILTIN_EXPRESSION_HEAD_SUBTRACT)))))
        (call $expression_alloc_args2
          (local.get $positive_exponential_slot)
          (local.get $negative_exponential_slot)))
      (i32.const 0))
    (if (local.get $cosine)
      (then
        (call $write_value (local.get $denominator_slot)
          (global.get $TYPE_RATIONAL) (i32.const 0) (local.get $two) (i32.const 0)))
      (else
        (call $write_value (local.get $denominator_slot)
          (global.get $TYPE_COMPLEX) (i32.const 0)
          (call $complex_allocate (local.get $zero) (local.get $two)) (i32.const 0))))
    (call $write_value (local.get $destination_slot)
      (global.get $TYPE_EXPRESSION) (i32.const 0)
      (call $expression_build
        (call $symbol_registry_lookup
          (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_DIVIDE)))
        (call $expression_alloc_args2
          (local.get $numerator_slot) (local.get $denominator_slot)))
      (i32.const 0))
    (i32.const 0)
  )

  (func $expression_transcendental_constructor
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument_pointer i32)
    (local $argument_type i32)
    (local $work i32)
    (local $sine_slot i32)
    (local $cosine_slot i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ne (local.get $argc) (i32.const 1))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message
          (global.get $BUILTIN_MSG_EXPRESSION_UNARY_ARITY))))))
    (local.set $argument_pointer
      (i32.sub (local.get $pending_pointer) (global.get $VALUE_SIZE)))
    (local.set $argument_type (call $value_type (local.get $argument_pointer)))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (i32.eqz (call $expression_arg_type_ok (local.get $argument_type)))
      (then (return (i32.add (i32.const 1) (call $throw_type_error)))))
    (if (call $check_heap_overflow (call $estimate_expression_op_budget))
      (then (return (i32.const 0))))
    (if (i32.or
          (i32.eq (local.get $method_id) (global.get $METHOD_EXACT_EXPRESSION_EXP))
          (i32.eq (local.get $method_id) (global.get $METHOD_EXACT_EXPRESSION_LOG)))
      (then
        (call $write_value (local.get $stack_base)
          (global.get $TYPE_EXPRESSION) (i32.const 0)
          (call $expression_build
            (call $symbol_registry_lookup (call $read_builtin
              (if (result i32)
                (i32.eq (local.get $method_id) (global.get $METHOD_EXACT_EXPRESSION_EXP))
                (then (global.get $BUILTIN_EXPRESSION_HEAD_EXP))
                (else (global.get $BUILTIN_EXPRESSION_HEAD_LOG)))))
            (call $expression_alloc_args1 (local.get $argument_pointer)))
          (i32.const 0))
        (call $write_ctx (global.get $CTX_PENDING_POINTER)
          (i32.add (local.get $stack_base) (global.get $VALUE_SIZE)))
        (return (i32.const 0))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_EXACT_EXPRESSION_SIN))
      (then
        (if (call $expression_build_derived_trigonometric
              (local.get $argument_pointer) (i32.const 0) (local.get $stack_base))
          (then (return (i32.const 0))))
        (call $write_ctx (global.get $CTX_PENDING_POINTER)
          (i32.add (local.get $stack_base) (global.get $VALUE_SIZE)))
        (return (i32.const 0))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_EXACT_EXPRESSION_COS))
      (then
        (if (call $expression_build_derived_trigonometric
              (local.get $argument_pointer) (i32.const 1) (local.get $stack_base))
          (then (return (i32.const 0))))
        (call $write_ctx (global.get $CTX_PENDING_POINTER)
          (i32.add (local.get $stack_base) (global.get $VALUE_SIZE)))
        (return (i32.const 0))))
    ;; Tan(z) is the quotient of the two complete derived trees.
    (if (call $expression_walk_guard (i32.const 2048))
      (then (return (i32.const 0))))
    (local.set $work (call $carve_scratch_blob (i32.const 32)))
    (local.set $sine_slot (local.get $work))
    (local.set $cosine_slot (i32.add (local.get $work) (i32.const 16)))
    (if (call $expression_build_derived_trigonometric
          (local.get $argument_pointer) (i32.const 0) (local.get $sine_slot))
      (then (return (i32.const 0))))
    (if (call $expression_build_derived_trigonometric
          (local.get $argument_pointer) (i32.const 1) (local.get $cosine_slot))
      (then (return (i32.const 0))))
    (call $write_value (local.get $stack_base)
      (global.get $TYPE_EXPRESSION) (i32.const 0)
      (call $expression_build
        (call $symbol_registry_lookup
          (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_DIVIDE)))
        (call $expression_alloc_args2
          (local.get $sine_slot) (local.get $cosine_slot)))
      (i32.const 0))
    (call $write_ctx (global.get $CTX_PENDING_POINTER)
      (i32.add (local.get $stack_base) (global.get $VALUE_SIZE)))
    (i32.const 0)
  )

  ;; Return a frozen rational enclosure for a closed expression. Exact
  ;; simplification runs first; a Rational, BigInt, or AlgebraicNumber
  ;; result short-circuits into a direct (possibly refined) enclosure.
  ;; Every other supported shape goes through the certified interval
  ;; evaluator over the ORIGINAL expression at increasing internal
  ;; precision until the enclosure meets the requested width. Degenerate
  ;; rational intervals have width zero.
  (func $expression_to_approximation
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $expression_pointer i32)
    (local $width_pointer i32)
    (local $width_exponent i64)
    (local $width_valid i32)
    (local $stage i32)
    (local $stage_type i32)
    (local $header i32)
    (local $target i32)
    (local $low i32)
    (local $high i32)
    (local $result_array i32)
    (local $result_data i32)
    (local $interval_blob i32)
    (local $precision i32)
    (local $status i32)
    (local $stage_resolved i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ne (local.get $argc) (i32.const 2))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message
          (global.get $BUILTIN_MSG_EXPRESSION_APPROXIMATION))))))
    (local.set $expression_pointer
      (i32.sub (local.get $pending_pointer) (i32.const 32)))
    (local.set $width_pointer
      (i32.add (local.get $expression_pointer) (global.get $VALUE_SIZE)))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (i32.eq (call $value_type (local.get $width_pointer)) (global.get $TYPE_BIGINT))
      (then
        (local.set $width_valid
          (call $bigint_to_i64_fits (call $value_data_lo (local.get $width_pointer))))
        (local.set $width_exponent (global.get $bigint_to_i64_value))))
    (if (i32.eqz (local.get $width_valid))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_ALGEBRAIC_WIDTH))))))
    (if (i32.or
          (i64.gt_s (local.get $width_exponent) (i64.const 1048576))
          (i64.lt_s (local.get $width_exponent) (i64.const -1048576)))
      (then (return (i32.add (i32.const 1)
        (call $throw_range_error_with_message (global.get $BUILTIN_MSG_ALGEBRAIC_WIDTH))))))
    (if (call $expression_walk_guard (i32.const 1024))
      (then (return (i32.const 0))))
    ;; The requested width 2^widthExponent as an exact rational target.
    (if (i64.ge_s (local.get $width_exponent) (i64.const 0))
      (then (local.set $target (call $rational_new
        (call $bigint_shift_left_bits (call $bigint_one)
          (i32.wrap_i64 (local.get $width_exponent)))
        (call $bigint_one))))
      (else (local.set $target (call $rational_new
        (call $bigint_one)
        (call $bigint_shift_left_bits (call $bigint_one)
          (i32.wrap_i64 (i64.sub
            (i64.const 0) (local.get $width_exponent))))))))
    (local.set $stage (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (if (call $expression_simplify_into
          (local.get $expression_pointer) (local.get $stage))
      (then (return (i32.const 0))))
    (local.set $stage_type (call $value_type (local.get $stage)))
    (if (i32.eq (local.get $stage_type) (global.get $TYPE_BIGINT))
      (then
        (local.set $low (call $rational_from_bigint
          (call $value_data_lo (local.get $stage))))
        (local.set $high (local.get $low))))
    (if (i32.eq (local.get $stage_type) (global.get $TYPE_RATIONAL))
      (then
        (local.set $low (call $rational_materialize (local.get $stage)))
        (local.set $high (local.get $low))))
    (if (i32.eq (local.get $stage_type) (global.get $TYPE_ALGEBRAIC))
      (then
        (local.set $header (call $value_data_lo (local.get $stage)))
        (local.set $precision (i32.const 0))
        (if (i64.lt_s (local.get $width_exponent) (i64.const 0))
          (then (local.set $precision
            (i32.wrap_i64 (i64.sub (i64.const 0) (local.get $width_exponent))))))
        (local.set $interval_blob (call $carve_scratch_blob (i32.const 8)))
        (if (call $approximation_algebraic_interval
              (local.get $header) (local.get $precision) (local.get $interval_blob))
          (then (return (i32.const 0))))
        (local.set $low (call $approximation_interval_low (local.get $interval_blob)))
        (local.set $high (call $approximation_interval_high (local.get $interval_blob)))))
    ;; A simplified Complex whose imaginary part is the exact Rational zero
    ;; is an exact real special point: degenerate enclosure of the real part.
    (local.set $stage_resolved (i32.or
      (i32.eq (local.get $stage_type) (global.get $TYPE_BIGINT))
      (i32.or
        (i32.eq (local.get $stage_type) (global.get $TYPE_RATIONAL))
        (i32.eq (local.get $stage_type) (global.get $TYPE_ALGEBRAIC)))))
    (if (i32.eq (local.get $stage_type) (global.get $TYPE_COMPLEX))
      (then
        (if (i32.eqz (call $bigint_length (call $rational_numerator
              (call $complex_imaginary (call $value_data_lo (local.get $stage))))))
          (then
            (local.set $low (call $complex_real (call $value_data_lo (local.get $stage))))
            (local.set $high (local.get $low))
            (local.set $stage_resolved (i32.const 1))))))
    ;; --- General certified interval evaluation over the original tree. ---
    (if (i32.eqz (local.get $stage_resolved))
      (then
        (local.set $precision (i32.const 32))
        (if (i64.lt_s (local.get $width_exponent) (i64.const 0))
          (then
            (local.set $precision (i32.add
              (i32.wrap_i64 (i64.sub (i64.const 0) (local.get $width_exponent)))
              (i32.const 8)))
            (if (i32.lt_s (local.get $precision) (i32.const 32))
              (then (local.set $precision (i32.const 32))))))
        (local.set $interval_blob (call $carve_scratch_blob (i32.const 8)))
        (block $evaluated
          (loop $evaluate
            (if (call $expression_walk_guard (i32.const 8192))
              (then (return (i32.const 0))))
            (local.set $status (call $approximation_evaluate
              (local.get $expression_pointer) (local.get $precision)
              (local.get $interval_blob)))
            (if (i32.eq (local.get $status) (i32.const 1))
              (then (return (i32.const 0))))
            (if (i32.eq (local.get $status) (i32.const 2))
              (then (return (i32.add (i32.const 1)
                (call $throw_type_error_with_message
                  (global.get $BUILTIN_MSG_EXPRESSION_APPROXIMATION))))))
            (if (i32.eqz (local.get $status))
              (then
                (local.set $low (call $approximation_interval_low
                  (local.get $interval_blob)))
                (local.set $high (call $approximation_interval_high
                  (local.get $interval_blob)))
                (br_if $evaluated (i32.le_s
                  (call $rational_header_pair_compare
                    (call $rational_sub (local.get $high) (local.get $low))
                    (local.get $target))
                  (i32.const 0)))))
            ;; Raise the internal precision and re-evaluate.
            (local.set $precision (i32.shl (local.get $precision) (i32.const 1)))
            (if (i32.gt_s (local.get $precision) (i32.const 4194304))
              (then (return (i32.add (i32.const 1)
                (call $throw_type_error_with_message
                  (global.get $BUILTIN_MSG_EXPRESSION_APPROXIMATION))))))
            (br $evaluate)))))
    (local.set $result_array (call $allocate_array (i32.const 2)))
    (local.set $result_data (i32.add
      (i32.load (call $abs
        (i32.add (local.get $result_array) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (call $write_value (local.get $result_data)
      (global.get $TYPE_RATIONAL) (i32.const 0) (local.get $low) (i32.const 0))
    (call $write_value
      (i32.add (local.get $result_data) (global.get $VALUE_SIZE))
      (global.get $TYPE_RATIONAL) (i32.const 0) (local.get $high) (i32.const 0))
    (call $expression_freeze_args_array (local.get $result_array))
    (call $pending_push
      (global.get $TYPE_ARRAY) (i32.const 0) (local.get $result_array) (i32.const 0))
    (i32.const 0)
  )

  ;; ==========================================================================
  ;; Certified expression approximation — the general interval evaluator.
  ;;
  ;; Every intermediate value is an
  ;; exact rational interval, every transcendental algorithm carries a proved
  ;; remainder bound, and no host float ever chooses an endpoint. The
  ;; evaluator proves realness structurally: it accepts real leaves, the
  ;; constant Pi, the arithmetic heads, Exp, principal Log, and the canonical
  ;; trigonometric trees the public constructors produce. Everything else is
  ;; a rejection.
  ;;
  ;; An interval lives in an 8-byte scratch blob: [low header, high header],
  ;; both exact Rational heap headers with low <= high.
  ;;
  ;; Status codes shared by the evaluator family:
  ;;   0 = interval written into the destination blob
  ;;   1 = pressure / walk-guard abort (dispatcher yields and retries)
  ;;   2 = rejection (the caller throws the approximation TypeError)
  ;;   3 = insufficient precision (the outer loop doubles and retries)
  ;; ==========================================================================

  ;; Matched trigonometric argument slot (out-param of
  ;; $approximation_match_trigonometric).
  (global $approximation_trig_argument_slot (mut i32) (i32.const 0))

  ;; floor(a / b) for BigInts with b > 0. $bigint_div truncates toward zero;
  ;; a negative dividend with a nonzero remainder floors one lower.
  (func $approximation_bigint_floor_quotient (param $a i32) (param $b i32) (result i32)
    (local $quotient i32)
    (local $remainder i32)
    (local.set $quotient (call $bigint_div (local.get $a) (local.get $b)))
    (local.set $remainder (call $bigint_last_remainder))
    (if (i32.and
          (i32.ne (call $bigint_sign (local.get $a)) (i32.const 0))
          (i32.ne (call $bigint_length (local.get $remainder)) (i32.const 0)))
      (then (local.set $quotient
        (call $bigint_sub (local.get $quotient) (call $bigint_one)))))
    (local.get $quotient)
  )

  ;; Build the Rational n / d from two small integers.
  (func $approximation_rational_small (param $numerator i64) (param $denominator i64) (result i32)
    (call $rational_new
      (call $bigint_from_i64 (local.get $numerator))
      (call $bigint_from_i64 (local.get $denominator)))
  )

  ;; The Rational 1 / 2^precision_bits (precision_bits >= 0).
  (func $approximation_power_of_two_target (param $precision_bits i32) (result i32)
    (call $rational_new
      (call $bigint_one)
      (call $bigint_shift_left_bits (call $bigint_one) (local.get $precision_bits)))
  )

  ;; Round a Rational header onto the 2^-precision grid. round_up 0 rounds
  ;; toward negative infinity, 1 toward positive infinity — always outward
  ;; for the endpoint each direction serves, so enclosures stay certified.
  (func $approximation_rational_dyadic
    (param $value i32) (param $precision_bits i32) (param $round_up i32) (result i32)
    (local $scaled i32)
    (local $quotient i32)
    (local.set $scaled (call $bigint_shift_left_bits
      (call $rational_numerator (local.get $value)) (local.get $precision_bits)))
    (if (local.get $round_up)
      (then (local.set $quotient (call $bigint_sub (call $bigint_zero)
        (call $approximation_bigint_floor_quotient
          (call $bigint_sub (call $bigint_zero) (local.get $scaled))
          (call $rational_denominator (local.get $value))))))
      (else (local.set $quotient (call $approximation_bigint_floor_quotient
        (local.get $scaled)
        (call $rational_denominator (local.get $value))))))
    (call $rational_new (local.get $quotient)
      (call $bigint_shift_left_bits (call $bigint_one) (local.get $precision_bits)))
  )

  (func $approximation_interval_low (param $blob i32) (result i32)
    (i32.load (call $abs (local.get $blob)))
  )

  (func $approximation_interval_high (param $blob i32) (result i32)
    (i32.load (call $abs (i32.add (local.get $blob) (i32.const 4))))
  )

  (func $approximation_interval_write (param $blob i32) (param $low i32) (param $high i32)
    (i32.store (call $abs (local.get $blob)) (local.get $low))
    (i32.store (call $abs (i32.add (local.get $blob) (i32.const 4))) (local.get $high))
  )

  ;; Outward-round both endpoints onto the 2^-precision grid.
  (func $approximation_interval_round (param $blob i32) (param $precision_bits i32)
    (call $approximation_interval_write (local.get $blob)
      (call $approximation_rational_dyadic
        (call $approximation_interval_low (local.get $blob))
        (local.get $precision_bits) (i32.const 0))
      (call $approximation_rational_dyadic
        (call $approximation_interval_high (local.get $blob))
        (local.get $precision_bits) (i32.const 1)))
  )

  (func $approximation_rational_minimum (param $a i32) (param $b i32) (result i32)
    (if (result i32)
        (i32.le_s (call $rational_header_pair_compare (local.get $a) (local.get $b))
          (i32.const 0))
      (then (local.get $a))
      (else (local.get $b)))
  )

  (func $approximation_rational_maximum (param $a i32) (param $b i32) (result i32)
    (if (result i32)
        (i32.ge_s (call $rational_header_pair_compare (local.get $a) (local.get $b))
          (i32.const 0))
      (then (local.get $a))
      (else (local.get $b)))
  )

  (func $approximation_rational_absolute (param $value i32) (result i32)
    (if (result i32)
        (i32.ne (call $bigint_sign (call $rational_numerator (local.get $value)))
          (i32.const 0))
      (then (call $rational_negate (local.get $value)))
      (else (local.get $value)))
  )

  ;; max(|low|, |high|) of an interval.
  (func $approximation_interval_magnitude (param $blob i32) (result i32)
    (call $approximation_rational_maximum
      (call $approximation_rational_absolute
        (call $approximation_interval_low (local.get $blob)))
      (call $approximation_rational_absolute
        (call $approximation_interval_high (local.get $blob))))
  )

  ;; -1 entirely negative, 1 entirely positive, 0 contains or touches zero.
  (func $approximation_interval_sign (param $blob i32) (result i32)
    (local $low_numerator i32)
    (local $high_numerator i32)
    (local.set $low_numerator
      (call $rational_numerator (call $approximation_interval_low (local.get $blob))))
    (local.set $high_numerator
      (call $rational_numerator (call $approximation_interval_high (local.get $blob))))
    ;; low > 0 -> entirely positive.
    (if (i32.and
          (i32.eqz (call $bigint_sign (local.get $low_numerator)))
          (i32.ne (call $bigint_length (local.get $low_numerator)) (i32.const 0)))
      (then (return (i32.const 1))))
    ;; high < 0 -> entirely negative.
    (if (i32.ne (call $bigint_sign (local.get $high_numerator)) (i32.const 0))
      (then (return (i32.const -1))))
    (i32.const 0)
  )

  ;; destination = a + b (aliasing-safe: reads complete before writes).
  (func $approximation_interval_add (param $destination i32) (param $a i32) (param $b i32)
    (local $low i32)
    (local $high i32)
    (local.set $low (call $rational_add
      (call $approximation_interval_low (local.get $a))
      (call $approximation_interval_low (local.get $b))))
    (local.set $high (call $rational_add
      (call $approximation_interval_high (local.get $a))
      (call $approximation_interval_high (local.get $b))))
    (call $approximation_interval_write (local.get $destination)
      (local.get $low) (local.get $high))
  )

  ;; destination = a - b.
  (func $approximation_interval_subtract (param $destination i32) (param $a i32) (param $b i32)
    (local $low i32)
    (local $high i32)
    (local.set $low (call $rational_sub
      (call $approximation_interval_low (local.get $a))
      (call $approximation_interval_high (local.get $b))))
    (local.set $high (call $rational_sub
      (call $approximation_interval_high (local.get $a))
      (call $approximation_interval_low (local.get $b))))
    (call $approximation_interval_write (local.get $destination)
      (local.get $low) (local.get $high))
  )

  ;; destination = -a.
  (func $approximation_interval_negate (param $destination i32) (param $a i32)
    (local $low i32)
    (local $high i32)
    (local.set $low (call $rational_negate
      (call $approximation_interval_high (local.get $a))))
    (local.set $high (call $rational_negate
      (call $approximation_interval_low (local.get $a))))
    (call $approximation_interval_write (local.get $destination)
      (local.get $low) (local.get $high))
  )

  ;; destination = a * b (four endpoint products, min and max).
  (func $approximation_interval_multiply (param $destination i32) (param $a i32) (param $b i32)
    (local $product1 i32)
    (local $product2 i32)
    (local $product3 i32)
    (local $product4 i32)
    (local.set $product1 (call $rational_mul
      (call $approximation_interval_low (local.get $a))
      (call $approximation_interval_low (local.get $b))))
    (local.set $product2 (call $rational_mul
      (call $approximation_interval_low (local.get $a))
      (call $approximation_interval_high (local.get $b))))
    (local.set $product3 (call $rational_mul
      (call $approximation_interval_high (local.get $a))
      (call $approximation_interval_low (local.get $b))))
    (local.set $product4 (call $rational_mul
      (call $approximation_interval_high (local.get $a))
      (call $approximation_interval_high (local.get $b))))
    (call $approximation_interval_write (local.get $destination)
      (call $approximation_rational_minimum
        (call $approximation_rational_minimum (local.get $product1) (local.get $product2))
        (call $approximation_rational_minimum (local.get $product3) (local.get $product4)))
      (call $approximation_rational_maximum
        (call $approximation_rational_maximum (local.get $product1) (local.get $product2))
        (call $approximation_rational_maximum (local.get $product3) (local.get $product4))))
  )

  ;; destination = a scaled by an exact rational scalar (sign-aware).
  (func $approximation_interval_scale (param $destination i32) (param $a i32) (param $scalar i32)
    (local $low_product i32)
    (local $high_product i32)
    (local.set $low_product (call $rational_mul
      (call $approximation_interval_low (local.get $a)) (local.get $scalar)))
    (local.set $high_product (call $rational_mul
      (call $approximation_interval_high (local.get $a)) (local.get $scalar)))
    (if (i32.ne (call $bigint_sign (call $rational_numerator (local.get $scalar)))
          (i32.const 0))
      (then (call $approximation_interval_write (local.get $destination)
        (local.get $high_product) (local.get $low_product)))
      (else (call $approximation_interval_write (local.get $destination)
        (local.get $low_product) (local.get $high_product))))
  )

  ;; destination = 1 / a. Status 3 when a contains zero.
  (func $approximation_interval_reciprocal (param $destination i32) (param $a i32) (result i32)
    (local $low i32)
    (local $high i32)
    (if (i32.eqz (call $approximation_interval_sign (local.get $a)))
      (then (return (i32.const 3))))
    (local.set $low (call $rational_new
      (call $rational_denominator (call $approximation_interval_high (local.get $a)))
      (call $rational_numerator (call $approximation_interval_high (local.get $a)))))
    (local.set $high (call $rational_new
      (call $rational_denominator (call $approximation_interval_low (local.get $a)))
      (call $rational_numerator (call $approximation_interval_low (local.get $a)))))
    (call $approximation_interval_write (local.get $destination)
      (local.get $low) (local.get $high))
    (i32.const 0)
  )

  ;; destination = base ** exponent for an exact integer exponent.
  ;; Status 3 when a negative exponent meets a zero-containing base.
  (func $approximation_interval_power_integer
    (param $destination i32) (param $base i32) (param $exponent i64)
    (param $precision_bits i32) (result i32)
    (local $magnitude i64)
    (local $accumulator i32)
    (local $square i32)
    (local $one i32)
    (local $status i32)
    (local.set $one (call $approximation_rational_small (i64.const 1) (i64.const 1)))
    (if (i64.eqz (local.get $exponent))
      (then
        (call $approximation_interval_write (local.get $destination)
          (local.get $one) (local.get $one))
        (return (i32.const 0))))
    (local.set $magnitude (local.get $exponent))
    (if (i64.lt_s (local.get $magnitude) (i64.const 0))
      (then (local.set $magnitude (i64.sub (i64.const 0) (local.get $magnitude)))))
    (local.set $accumulator (call $carve_scratch_blob (i32.const 16)))
    (local.set $square (i32.add (local.get $accumulator) (i32.const 8)))
    (call $approximation_interval_write (local.get $accumulator)
      (local.get $one) (local.get $one))
    (call $approximation_interval_write (local.get $square)
      (call $approximation_interval_low (local.get $base))
      (call $approximation_interval_high (local.get $base)))
    (block $powered
      (loop $power
        (if (i32.wrap_i64 (i64.and (local.get $magnitude) (i64.const 1)))
          (then
            (call $approximation_interval_multiply
              (local.get $accumulator) (local.get $accumulator) (local.get $square))
            (call $approximation_interval_round
              (local.get $accumulator) (local.get $precision_bits))))
        (local.set $magnitude (i64.shr_u (local.get $magnitude) (i64.const 1)))
        (br_if $powered (i64.eqz (local.get $magnitude)))
        (call $approximation_interval_multiply
          (local.get $square) (local.get $square) (local.get $square))
        (call $approximation_interval_round
          (local.get $square) (local.get $precision_bits))
        (br $power)))
    (if (i64.lt_s (local.get $exponent) (i64.const 0))
      (then
        (local.set $status (call $approximation_interval_reciprocal
          (local.get $accumulator) (local.get $accumulator)))
        (if (local.get $status) (then (return (local.get $status))))))
    (call $approximation_interval_write (local.get $destination)
      (call $approximation_interval_low (local.get $accumulator))
      (call $approximation_interval_high (local.get $accumulator)))
    (i32.const 0)
  )

  ;; Enclosure of arctangent(1 / m) for a small positive integer m >= 2.
  ;; Alternating series sum_i (-1)^i / ((2i+1) m^(2i+1)); the truncation
  ;; error after the last added term is bounded by the first omitted term.
  (func $approximation_arctangent_reciprocal
    (param $m i64) (param $precision_bits i32) (param $destination i32) (result i32)
    (local $m_squared i32)
    (local $power i32)
    (local $odd i64)
    (local $negative i32)
    (local $sum i32)
    (local $term i32)
    (local $next_magnitude i32)
    (local $target i32)
    (local.set $m_squared (call $bigint_mul
      (call $bigint_from_i64 (local.get $m)) (call $bigint_from_i64 (local.get $m))))
    (local.set $power (call $bigint_from_i64 (local.get $m)))
    (local.set $odd (i64.const 1))
    (local.set $negative (i32.const 0))
    (local.set $sum (call $approximation_rational_small (i64.const 0) (i64.const 1)))
    (local.set $target (call $approximation_power_of_two_target
      (i32.add (local.get $precision_bits) (i32.const 4))))
    (block $summed
      (loop $sum_terms
        (if (call $expression_walk_guard (i32.const 8192))
          (then (return (i32.const 1))))
        (local.set $term (call $rational_new
          (call $bigint_from_i64
            (select (i64.const -1) (i64.const 1)
              (local.get $negative)))
          (call $bigint_mul (call $bigint_from_i64 (local.get $odd)) (local.get $power))))
        (local.set $sum (call $rational_add (local.get $sum) (local.get $term)))
        (local.set $negative (i32.eqz (local.get $negative)))
        (local.set $odd (i64.add (local.get $odd) (i64.const 2)))
        (local.set $power (call $bigint_mul (local.get $power) (local.get $m_squared)))
        (local.set $next_magnitude (call $rational_new
          (call $bigint_one)
          (call $bigint_mul (call $bigint_from_i64 (local.get $odd)) (local.get $power))))
        (br_if $summed (i32.le_s
          (call $rational_header_pair_compare (local.get $next_magnitude) (local.get $target))
          (i32.const 0)))
        (br $sum_terms)))
    (call $approximation_interval_write (local.get $destination)
      (call $rational_sub (local.get $sum) (local.get $next_magnitude))
      (call $rational_add (local.get $sum) (local.get $next_magnitude)))
    (call $approximation_interval_round (local.get $destination)
      (i32.add (local.get $precision_bits) (i32.const 2)))
    (i32.const 0)
  )

  ;; Certified enclosure of Pi via Machin's formula:
  ;;   pi = 16 arctangent(1/5) - 4 arctangent(1/239).
  (func $approximation_pi_interval (param $precision_bits i32) (param $destination i32) (result i32)
    (local $work i32)
    (local $first i32)
    (local $second i32)
    (local $status i32)
    (local.set $work (call $carve_scratch_blob (i32.const 16)))
    (local.set $first (local.get $work))
    (local.set $second (i32.add (local.get $work) (i32.const 8)))
    (local.set $status (call $approximation_arctangent_reciprocal (i64.const 5)
      (i32.add (local.get $precision_bits) (i32.const 8)) (local.get $first)))
    (if (local.get $status) (then (return (local.get $status))))
    (local.set $status (call $approximation_arctangent_reciprocal (i64.const 239)
      (i32.add (local.get $precision_bits) (i32.const 8)) (local.get $second)))
    (if (local.get $status) (then (return (local.get $status))))
    (call $approximation_interval_scale (local.get $first) (local.get $first)
      (call $approximation_rational_small (i64.const 16) (i64.const 1)))
    (call $approximation_interval_scale (local.get $second) (local.get $second)
      (call $approximation_rational_small (i64.const 4) (i64.const 1)))
    (call $approximation_interval_subtract (local.get $destination)
      (local.get $first) (local.get $second))
    (call $approximation_interval_round (local.get $destination)
      (i32.add (local.get $precision_bits) (i32.const 2)))
    (i32.const 0)
  )

  ;; Enclosure of atanh(t) for an exact rational |t| <= 1/2:
  ;;   sum_i t^(2i+1) / (2i+1), tail after the last added term bounded by
  ;;   |t|^(2N+3)/(2N+3) * 1/(1 - t^2) <= 4/3 * |next term|.
  (func $approximation_atanh
    (param $t i32) (param $precision_bits i32) (param $destination i32) (result i32)
    (local $t_squared i32)
    (local $power i32)
    (local $odd i64)
    (local $sum i32)
    (local $term i32)
    (local $next_magnitude i32)
    (local $tail i32)
    (local $target i32)
    (local.set $t_squared (call $rational_mul (local.get $t) (local.get $t)))
    (local.set $power (local.get $t))
    (local.set $odd (i64.const 1))
    (local.set $sum (call $approximation_rational_small (i64.const 0) (i64.const 1)))
    (local.set $target (call $approximation_power_of_two_target
      (i32.add (local.get $precision_bits) (i32.const 4))))
    (block $summed
      (loop $sum_terms
        (if (call $expression_walk_guard (i32.const 8192))
          (then (return (i32.const 1))))
        (local.set $term (call $rational_div (local.get $power)
          (call $approximation_rational_small (local.get $odd) (i64.const 1))))
        (local.set $sum (call $rational_add (local.get $sum) (local.get $term)))
        (local.set $odd (i64.add (local.get $odd) (i64.const 2)))
        (local.set $power (call $rational_mul (local.get $power) (local.get $t_squared)))
        (local.set $next_magnitude (call $approximation_rational_absolute
          (call $rational_div (local.get $power)
            (call $approximation_rational_small (local.get $odd) (i64.const 1)))))
        (br_if $summed (i32.le_s
          (call $rational_header_pair_compare (local.get $next_magnitude) (local.get $target))
          (i32.const 0)))
        (br $sum_terms)))
    (local.set $tail (call $rational_mul (local.get $next_magnitude)
      (call $approximation_rational_small (i64.const 4) (i64.const 3))))
    (call $approximation_interval_write (local.get $destination)
      (call $rational_sub (local.get $sum) (local.get $tail))
      (call $rational_add (local.get $sum) (local.get $tail)))
    (call $approximation_interval_round (local.get $destination)
      (i32.add (local.get $precision_bits) (i32.const 2)))
    (i32.const 0)
  )

  ;; Certified enclosure of the natural logarithm of 2: 2 atanh(1/3).
  (func $approximation_ln2_interval (param $precision_bits i32) (param $destination i32) (result i32)
    (local $status i32)
    (local.set $status (call $approximation_atanh
      (call $approximation_rational_small (i64.const 1) (i64.const 3))
      (i32.add (local.get $precision_bits) (i32.const 4))
      (local.get $destination)))
    (if (local.get $status) (then (return (local.get $status))))
    (call $approximation_interval_scale (local.get $destination) (local.get $destination)
      (call $approximation_rational_small (i64.const 2) (i64.const 1)))
    (i32.const 0)
  )

  ;; Certified enclosure of exp(q) for an exact rational q.
  ;; Range reduction: r = q / 2^k with |r| < 1/4, Taylor series with the
  ;; geometric tail bound |last term| (ratio <= 1/3 for |r| <= 1/4), then k
  ;; interval squarings. Status 2 when the required internal precision
  ;; exceeds the hard cap.
  (func $approximation_exponential_point
    (param $q i32) (param $precision_bits i32) (param $destination i32) (result i32)
    (local $numerator i32)
    (local $denominator i32)
    (local $floor_magnitude i32)
    (local $halvings i32)
    (local $inner i32)
    (local $reduced i32)
    (local $term i32)
    (local $index i64)
    (local $tail i32)
    (local $target i32)
    (local $count i32)
    (local.set $numerator (call $rational_numerator (local.get $q)))
    (local.set $denominator (call $rational_denominator (local.get $q)))
    (local.set $floor_magnitude (call $approximation_bigint_floor_quotient
      (call $bigint_abs_copy (local.get $numerator)) (local.get $denominator)))
    (local.set $halvings (i32.add
      (call $bigint_bit_length (local.get $floor_magnitude)) (i32.const 2)))
    (local.set $inner (i32.add (local.get $precision_bits)
      (i32.add (i32.mul (local.get $halvings) (i32.const 2)) (i32.const 8))))
    (if (i32.gt_s (local.get $inner) (i32.const 4194304))
      (then (return (i32.const 2))))
    (local.set $reduced (call $rational_new
      (local.get $numerator)
      (call $bigint_shift_left_bits (local.get $denominator) (local.get $halvings))))
    ;; Taylor: term_0 = 1, term_i = term_(i-1) * r / i.
    (local.set $term (call $approximation_rational_small (i64.const 1) (i64.const 1)))
    (call $approximation_interval_write (local.get $destination)
      (local.get $term) (local.get $term))
    (local.set $index (i64.const 1))
    (local.set $target (call $approximation_power_of_two_target
      (i32.add (local.get $inner) (i32.const 2))))
    (block $summed
      (loop $sum_terms
        (if (call $expression_walk_guard (i32.const 8192))
          (then (return (i32.const 1))))
        (local.set $term (call $rational_div
          (call $rational_mul (local.get $term) (local.get $reduced))
          (call $approximation_rational_small (local.get $index) (i64.const 1))))
        (call $approximation_interval_write (local.get $destination)
          (call $rational_add
            (call $approximation_interval_low (local.get $destination)) (local.get $term))
          (call $rational_add
            (call $approximation_interval_high (local.get $destination)) (local.get $term)))
        (local.set $index (i64.add (local.get $index) (i64.const 1)))
        (br_if $summed (i32.le_s
          (call $rational_header_pair_compare
            (call $approximation_rational_absolute (local.get $term))
            (local.get $target))
          (i32.const 0)))
        (br $sum_terms)))
    ;; Tail after the last added term: |term| * (|r|/(i+1)) / (1 - |r|)
    ;; <= |term| for |r| <= 1/4.
    (local.set $tail (call $approximation_rational_absolute (local.get $term)))
    (call $approximation_interval_write (local.get $destination)
      (call $rational_sub
        (call $approximation_interval_low (local.get $destination)) (local.get $tail))
      (call $rational_add
        (call $approximation_interval_high (local.get $destination)) (local.get $tail)))
    (call $approximation_interval_round (local.get $destination) (local.get $inner))
    ;; Undo the range reduction: square the enclosure k times.
    (local.set $count (i32.const 0))
    (block $squared
      (loop $square
        (br_if $squared (i32.ge_s (local.get $count) (local.get $halvings)))
        (if (call $expression_walk_guard (i32.const 8192))
          (then (return (i32.const 1))))
        (call $approximation_interval_multiply
          (local.get $destination) (local.get $destination) (local.get $destination))
        (call $approximation_interval_round (local.get $destination) (local.get $inner))
        (local.set $count (i32.add (local.get $count) (i32.const 1)))
        (br $square)))
    (i32.const 0)
  )

  ;; Certified enclosure of the principal natural logarithm of an exact
  ;; rational q > 0 (caller enforces positivity):
  ;;   q = m * 2^e with m in (2/3, 4/3], ln q = e ln2 + 2 atanh((m-1)/(m+1)).
  (func $approximation_logarithm_point
    (param $q i32) (param $precision_bits i32) (param $destination i32) (result i32)
    (local $exponent i32)
    (local $mantissa i32)
    (local $t i32)
    (local $status i32)
    (local $ln2 i32)
    (local $exponent_bits i32)
    (local.set $exponent (i32.sub
      (call $bigint_bit_length (call $rational_numerator (local.get $q)))
      (call $bigint_bit_length (call $rational_denominator (local.get $q)))))
    (if (i32.ge_s (local.get $exponent) (i32.const 0))
      (then (local.set $mantissa (call $rational_new
        (call $rational_numerator (local.get $q))
        (call $bigint_shift_left_bits
          (call $rational_denominator (local.get $q)) (local.get $exponent)))))
      (else (local.set $mantissa (call $rational_new
        (call $bigint_shift_left_bits
          (call $rational_numerator (local.get $q))
          (i32.sub (i32.const 0) (local.get $exponent)))
        (call $rational_denominator (local.get $q))))))
    ;; m in [1/2, 2); fold m > 4/3 down so t stays within [-1/5, 1/7].
    (if (i32.gt_s
          (call $rational_header_pair_compare (local.get $mantissa)
            (call $approximation_rational_small (i64.const 4) (i64.const 3)))
          (i32.const 0))
      (then
        (local.set $mantissa (call $rational_mul (local.get $mantissa)
          (call $approximation_rational_small (i64.const 1) (i64.const 2))))
        (local.set $exponent (i32.add (local.get $exponent) (i32.const 1)))))
    (local.set $t (call $rational_div
      (call $rational_sub (local.get $mantissa)
        (call $approximation_rational_small (i64.const 1) (i64.const 1)))
      (call $rational_add (local.get $mantissa)
        (call $approximation_rational_small (i64.const 1) (i64.const 1)))))
    (local.set $status (call $approximation_atanh (local.get $t)
      (i32.add (local.get $precision_bits) (i32.const 6)) (local.get $destination)))
    (if (local.get $status) (then (return (local.get $status))))
    (call $approximation_interval_scale (local.get $destination) (local.get $destination)
      (call $approximation_rational_small (i64.const 2) (i64.const 1)))
    (if (i32.ne (local.get $exponent) (i32.const 0))
      (then
        (local.set $ln2 (call $carve_scratch_blob (i32.const 8)))
        (local.set $exponent_bits (call $bigint_bit_length
          (call $bigint_from_i64 (i64.extend_i32_s
            (select
              (i32.sub (i32.const 0) (local.get $exponent))
              (local.get $exponent)
              (i32.lt_s (local.get $exponent) (i32.const 0)))))))
        (local.set $status (call $approximation_ln2_interval
          (i32.add (i32.add (local.get $precision_bits) (local.get $exponent_bits))
            (i32.const 6))
          (local.get $ln2)))
        (if (local.get $status) (then (return (local.get $status))))
        (call $approximation_interval_scale (local.get $ln2) (local.get $ln2)
          (call $approximation_rational_small
            (i64.extend_i32_s (local.get $exponent)) (i64.const 1)))
        (call $approximation_interval_add (local.get $destination)
          (local.get $destination) (local.get $ln2))))
    (call $approximation_interval_round (local.get $destination)
      (i32.add (local.get $precision_bits) (i32.const 2)))
    (i32.const 0)
  )

  ;; Monotone interval exponential: [exp(low) enclosure low, exp(high)
  ;; enclosure high].
  (func $approximation_exponential_interval
    (param $argument i32) (param $precision_bits i32) (param $destination i32) (result i32)
    (local $work i32)
    (local $status i32)
    (local $low i32)
    (local.set $work (call $carve_scratch_blob (i32.const 8)))
    (local.set $status (call $approximation_exponential_point
      (call $approximation_interval_low (local.get $argument))
      (local.get $precision_bits) (local.get $work)))
    (if (local.get $status) (then (return (local.get $status))))
    (local.set $low (call $approximation_interval_low (local.get $work)))
    (local.set $status (call $approximation_exponential_point
      (call $approximation_interval_high (local.get $argument))
      (local.get $precision_bits) (local.get $work)))
    (if (local.get $status) (then (return (local.get $status))))
    (call $approximation_interval_write (local.get $destination)
      (local.get $low)
      (call $approximation_interval_high (local.get $work)))
    (i32.const 0)
  )

  ;; Monotone interval logarithm; caller has proved the argument interval
  ;; is entirely positive.
  (func $approximation_logarithm_interval
    (param $argument i32) (param $precision_bits i32) (param $destination i32) (result i32)
    (local $work i32)
    (local $status i32)
    (local $low i32)
    (local.set $work (call $carve_scratch_blob (i32.const 8)))
    (local.set $status (call $approximation_logarithm_point
      (call $approximation_interval_low (local.get $argument))
      (local.get $precision_bits) (local.get $work)))
    (if (local.get $status) (then (return (local.get $status))))
    (local.set $low (call $approximation_interval_low (local.get $work)))
    (local.set $status (call $approximation_logarithm_point
      (call $approximation_interval_high (local.get $argument))
      (local.get $precision_bits) (local.get $work)))
    (if (local.get $status) (then (return (local.get $status))))
    (call $approximation_interval_write (local.get $destination)
      (local.get $low)
      (call $approximation_interval_high (local.get $work)))
    (i32.const 0)
  )

  ;; Certified sine (cosine_flag 0) or cosine (cosine_flag 1) of a real
  ;; interval. Quadrant reduction subtracts the nearest multiple of 2 pi
  ;; using the certified Pi enclosure, then a bounded alternating Taylor
  ;; series runs in interval arithmetic. When the argument is too wide the
  ;; universal enclosure [-1, 1] is returned; the outer precision loop
  ;; shrinks the argument and retries.
  (func $approximation_sine_cosine_interval
    (param $argument i32) (param $cosine_flag i32) (param $precision_bits i32)
    (param $destination i32) (result i32)
    (local $work i32)
    (local $pi i32)
    (local $reduced i32)
    (local $term i32)
    (local $r_squared i32)
    (local $sum i32)
    (local $one i32)
    (local $inner i32)
    (local $status i32)
    (local $turns i32)
    (local $index i64)
    (local $first_factor i64)
    (local $second_factor i64)
    (local $tail i32)
    (local $target i32)
    (local $low i32)
    (local $high i32)
    (local.set $one (call $approximation_rational_small (i64.const 1) (i64.const 1)))
    ;; A wide argument gets the universal enclosure.
    (if (i32.gt_s
          (call $rational_header_pair_compare
            (call $rational_sub
              (call $approximation_interval_high (local.get $argument))
              (call $approximation_interval_low (local.get $argument)))
            (call $approximation_rational_small (i64.const 1) (i64.const 4)))
          (i32.const 0))
      (then
        (call $approximation_interval_write (local.get $destination)
          (call $rational_negate (local.get $one)) (local.get $one))
        (return (i32.const 0))))
    ;; Reduction precision covers the multiplier magnitude.
    (local.set $inner (i32.add (i32.add (local.get $precision_bits)
      (call $bigint_bit_length (call $approximation_bigint_floor_quotient
        (call $bigint_abs_copy (call $rational_numerator
          (call $approximation_interval_low (local.get $argument))))
        (call $rational_denominator
          (call $approximation_interval_low (local.get $argument))))))
      (i32.const 8)))
    (if (i32.gt_s (local.get $inner) (i32.const 4194304))
      (then (return (i32.const 2))))
    (local.set $work (call $carve_scratch_blob (i32.const 40)))
    (local.set $pi (local.get $work))
    (local.set $reduced (i32.add (local.get $work) (i32.const 8)))
    (local.set $term (i32.add (local.get $work) (i32.const 16)))
    (local.set $r_squared (i32.add (local.get $work) (i32.const 24)))
    (local.set $sum (i32.add (local.get $work) (i32.const 32)))
    (local.set $status (call $approximation_pi_interval (local.get $inner) (local.get $pi)))
    (if (local.get $status) (then (return (local.get $status))))
    ;; two_pi enclosure in place.
    (call $approximation_interval_scale (local.get $pi) (local.get $pi)
      (call $approximation_rational_small (i64.const 2) (i64.const 1)))
    ;; Nearest multiple of two pi (an approximate pick is sound: only the
    ;; residual magnitude check below matters for the series bound).
    (local.set $turns (call $rational_nearest_bigint
      (call $rational_div
        (call $approximation_interval_low (local.get $argument))
        (call $approximation_interval_low (local.get $pi)))))
    (call $approximation_interval_scale (local.get $reduced) (local.get $pi)
      (call $rational_from_bigint (local.get $turns)))
    (call $approximation_interval_subtract (local.get $reduced)
      (local.get $argument) (local.get $reduced))
    (call $approximation_interval_round (local.get $reduced) (local.get $inner))
    ;; The reduced magnitude must stay within the series bound.
    (if (i32.gt_s
          (call $rational_header_pair_compare
            (call $approximation_interval_magnitude (local.get $reduced))
            (call $approximation_rational_small (i64.const 4) (i64.const 1)))
          (i32.const 0))
      (then
        (call $approximation_interval_write (local.get $destination)
          (call $rational_negate (local.get $one)) (local.get $one))
        (return (i32.const 0))))
    (call $approximation_interval_multiply
      (local.get $r_squared) (local.get $reduced) (local.get $reduced))
    (call $approximation_interval_round (local.get $r_squared) (local.get $inner))
    ;; term_0: sine -> r, cosine -> [1, 1].
    (if (local.get $cosine_flag)
      (then (call $approximation_interval_write (local.get $term)
        (local.get $one) (local.get $one)))
      (else (call $approximation_interval_write (local.get $term)
        (call $approximation_interval_low (local.get $reduced))
        (call $approximation_interval_high (local.get $reduced)))))
    (call $approximation_interval_write (local.get $sum)
      (call $approximation_interval_low (local.get $term))
      (call $approximation_interval_high (local.get $term)))
    (local.set $index (i64.const 1))
    (local.set $target (call $approximation_power_of_two_target
      (i32.add (local.get $precision_bits) (i32.const 6))))
    (block $summed
      (loop $sum_terms
        (if (call $expression_walk_guard (i32.const 8192))
          (then (return (i32.const 1))))
        (if (local.get $cosine_flag)
          (then
            (local.set $first_factor (i64.sub
              (i64.mul (local.get $index) (i64.const 2)) (i64.const 1)))
            (local.set $second_factor (i64.mul (local.get $index) (i64.const 2))))
          (else
            (local.set $first_factor (i64.mul (local.get $index) (i64.const 2)))
            (local.set $second_factor (i64.add
              (i64.mul (local.get $index) (i64.const 2)) (i64.const 1)))))
        (call $approximation_interval_multiply
          (local.get $term) (local.get $term) (local.get $r_squared))
        (call $approximation_interval_scale (local.get $term) (local.get $term)
          (call $rational_new
            (call $bigint_from_i64 (i64.const -1))
            (call $bigint_from_i64
              (i64.mul (local.get $first_factor) (local.get $second_factor)))))
        (call $approximation_interval_round (local.get $term) (local.get $inner))
        (call $approximation_interval_add
          (local.get $sum) (local.get $sum) (local.get $term))
        (call $approximation_interval_round (local.get $sum) (local.get $inner))
        (local.set $index (i64.add (local.get $index) (i64.const 1)))
        ;; Stop once terms provably decay: from index >= 4 onward the term
        ;; ratio is at most 16/72, so the tail is below the last term.
        (br_if $summed (i32.and
          (i64.ge_s (local.get $index) (i64.const 4))
          (i32.le_s
            (call $rational_header_pair_compare
              (call $approximation_interval_magnitude (local.get $term))
              (local.get $target))
            (i32.const 0))))
        (br $sum_terms)))
    (local.set $tail (call $approximation_interval_magnitude (local.get $term)))
    (local.set $low (call $rational_sub
      (call $approximation_interval_low (local.get $sum)) (local.get $tail)))
    (local.set $high (call $rational_add
      (call $approximation_interval_high (local.get $sum)) (local.get $tail)))
    ;; Intersect with the universal range [-1, 1].
    (local.set $low (call $approximation_rational_maximum (local.get $low)
      (call $rational_negate (local.get $one))))
    (local.set $high (call $approximation_rational_minimum (local.get $high)
      (local.get $one)))
    (call $approximation_interval_write (local.get $destination)
      (local.get $low) (local.get $high))
    (call $approximation_interval_round (local.get $destination)
      (i32.add (local.get $precision_bits) (i32.const 2)))
    (i32.const 0)
  )

  ;; --- Structural recognition of the canonical trigonometric trees. ---

  (func $approximation_expression_argument_count (param $expression_header i32) (result i32)
    (i32.load (call $abs (i32.add
      (call $expression_args (local.get $expression_header)) (i32.const 8))))
  )

  (func $approximation_expression_argument_data (param $expression_header i32) (result i32)
    (i32.add
      (i32.load (call $abs (i32.add
        (call $expression_args (local.get $expression_header)) (i32.const 16))))
      (global.get $GC_HEADER_SIZE))
  )

  (func $approximation_head_is (param $expression_header i32) (param $head_builtin i32) (result i32)
    (i32.eq
      (call $symbol_description (call $expression_head (local.get $expression_header)))
      (call $read_builtin (local.get $head_builtin)))
  )

  ;; Is the slot the exact Complex 0 + imaginary_value i?
  (func $approximation_complex_is
    (param $slot i32) (param $imaginary_value i64) (result i32)
    (local $header i32)
    (if (i32.ne (call $value_type (local.get $slot)) (global.get $TYPE_COMPLEX))
      (then (return (i32.const 0))))
    (local.set $header (call $value_data_lo (local.get $slot)))
    (if (i32.ne (call $bigint_length
          (call $rational_numerator (call $complex_real (local.get $header))))
          (i32.const 0))
      (then (return (i32.const 0))))
    (i32.eqz (call $rational_header_pair_compare
      (call $complex_imaginary (local.get $header))
      (call $approximation_rational_small (local.get $imaginary_value) (i64.const 1))))
  )

  ;; Match Exp(Multiply(Complex(0,1), z)) and return the Multiply slot, or 0.
  (func $approximation_match_exponential_of_imaginary (param $slot i32) (result i32)
    (local $header i32)
    (local $inner_slot i32)
    (local $inner_header i32)
    (local $data i32)
    (if (i32.ne (call $value_type (local.get $slot)) (global.get $TYPE_EXPRESSION))
      (then (return (i32.const 0))))
    (local.set $header (call $value_data_lo (local.get $slot)))
    (if (i32.eqz (call $approximation_head_is (local.get $header)
          (global.get $BUILTIN_EXPRESSION_HEAD_EXP)))
      (then (return (i32.const 0))))
    (if (i32.ne (call $approximation_expression_argument_count (local.get $header))
          (i32.const 1))
      (then (return (i32.const 0))))
    (local.set $inner_slot (call $approximation_expression_argument_data (local.get $header)))
    (if (i32.ne (call $value_type (local.get $inner_slot)) (global.get $TYPE_EXPRESSION))
      (then (return (i32.const 0))))
    (local.set $inner_header (call $value_data_lo (local.get $inner_slot)))
    (if (i32.eqz (call $approximation_head_is (local.get $inner_header)
          (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)))
      (then (return (i32.const 0))))
    (if (i32.ne (call $approximation_expression_argument_count (local.get $inner_header))
          (i32.const 2))
      (then (return (i32.const 0))))
    (local.set $data (call $approximation_expression_argument_data (local.get $inner_header)))
    (if (i32.eqz (call $approximation_complex_is (local.get $data) (i64.const 1)))
      (then (return (i32.const 0))))
    (local.get $inner_slot)
  )

  ;; Match Exp(Negate(Multiply(Complex(0,1), z))) and return the
  ;; Multiply(...) slot inside the Negate, or 0.
  (func $approximation_match_negated_exponential (param $slot i32) (result i32)
    (local $header i32)
    (local $inner_slot i32)
    (local $inner_header i32)
    (if (i32.ne (call $value_type (local.get $slot)) (global.get $TYPE_EXPRESSION))
      (then (return (i32.const 0))))
    (local.set $header (call $value_data_lo (local.get $slot)))
    (if (i32.eqz (call $approximation_head_is (local.get $header)
          (global.get $BUILTIN_EXPRESSION_HEAD_EXP)))
      (then (return (i32.const 0))))
    (if (i32.ne (call $approximation_expression_argument_count (local.get $header))
          (i32.const 1))
      (then (return (i32.const 0))))
    (local.set $inner_slot (call $approximation_expression_argument_data (local.get $header)))
    (if (i32.ne (call $value_type (local.get $inner_slot)) (global.get $TYPE_EXPRESSION))
      (then (return (i32.const 0))))
    (local.set $inner_header (call $value_data_lo (local.get $inner_slot)))
    (if (i32.eqz (call $approximation_head_is (local.get $inner_header)
          (global.get $BUILTIN_EXPRESSION_HEAD_NEGATE)))
      (then (return (i32.const 0))))
    (if (i32.ne (call $approximation_expression_argument_count (local.get $inner_header))
          (i32.const 1))
      (then (return (i32.const 0))))
    (call $approximation_expression_argument_data (local.get $inner_header))
  )

  ;; Match the canonical constructor tree for sine (returns 1) or cosine
  ;; (returns 2), storing the argument slot in
  ;; $approximation_trig_argument_slot. 0 = no match. The recognition is
  ;; strict: a hand-built near-match that deviates from the constructor
  ;; shape does not match.
  (func $approximation_match_trigonometric (param $slot i32) (result i32)
    (local $header i32)
    (local $data i32)
    (local $numerator_slot i32)
    (local $denominator_slot i32)
    (local $kind i32)
    (local $numerator_header i32)
    (local $pair_data i32)
    (local $argument_slot i32)
    (local $multiply_slot i32)
    (local $two_slot i32)
    (if (i32.ne (call $value_type (local.get $slot)) (global.get $TYPE_EXPRESSION))
      (then (return (i32.const 0))))
    (local.set $header (call $value_data_lo (local.get $slot)))
    (if (i32.eqz (call $approximation_head_is (local.get $header)
          (global.get $BUILTIN_EXPRESSION_HEAD_DIVIDE)))
      (then (return (i32.const 0))))
    (if (i32.ne (call $approximation_expression_argument_count (local.get $header))
          (i32.const 2))
      (then (return (i32.const 0))))
    (local.set $data (call $approximation_expression_argument_data (local.get $header)))
    (local.set $numerator_slot (local.get $data))
    (local.set $denominator_slot (i32.add (local.get $data) (global.get $VALUE_SIZE)))
    ;; Denominator selects the flavor: Complex(0, 2) -> sine, Rational 2 -> cosine.
    (local.set $kind (i32.const 0))
    (if (call $approximation_complex_is (local.get $denominator_slot) (i64.const 2))
      (then (local.set $kind (i32.const 1))))
    (if (i32.eqz (local.get $kind))
      (then
        (if (i32.eq (call $value_type (local.get $denominator_slot))
              (global.get $TYPE_RATIONAL))
          (then
            (if (i32.eqz (call $rational_header_pair_compare
                  (call $rational_materialize (local.get $denominator_slot))
                  (call $approximation_rational_small (i64.const 2) (i64.const 1))))
              (then (local.set $kind (i32.const 2))))))))
    (if (i32.eqz (local.get $kind)) (then (return (i32.const 0))))
    (if (i32.ne (call $value_type (local.get $numerator_slot)) (global.get $TYPE_EXPRESSION))
      (then (return (i32.const 0))))
    (local.set $numerator_header (call $value_data_lo (local.get $numerator_slot)))
    (if (i32.eqz (call $approximation_head_is (local.get $numerator_header)
          (if (result i32) (i32.eq (local.get $kind) (i32.const 1))
            (then (global.get $BUILTIN_EXPRESSION_HEAD_SUBTRACT))
            (else (global.get $BUILTIN_EXPRESSION_HEAD_ADD)))))
      (then (return (i32.const 0))))
    (if (i32.ne (call $approximation_expression_argument_count (local.get $numerator_header))
          (i32.const 2))
      (then (return (i32.const 0))))
    (local.set $pair_data
      (call $approximation_expression_argument_data (local.get $numerator_header)))
    (local.set $multiply_slot
      (call $approximation_match_exponential_of_imaginary (local.get $pair_data)))
    (if (i32.eqz (local.get $multiply_slot)) (then (return (i32.const 0))))
    (local.set $two_slot (call $approximation_match_negated_exponential
      (i32.add (local.get $pair_data) (global.get $VALUE_SIZE))))
    (if (i32.eqz (local.get $two_slot)) (then (return (i32.const 0))))
    ;; The negated exponent must be the SAME Multiply(i, z) tree.
    (if (i32.eqz (call $expression_values_equal
          (local.get $multiply_slot) (local.get $two_slot)))
      (then (return (i32.const 0))))
    (if (global.get $memory_pressure_signaled)
      (then (return (i32.const 0))))
    ;; z is the second argument of the matched Multiply.
    (local.set $argument_slot (i32.add
      (call $approximation_expression_argument_data
        (call $value_data_lo (local.get $multiply_slot)))
      (global.get $VALUE_SIZE)))
    (global.set $approximation_trig_argument_slot (local.get $argument_slot))
    (local.get $kind)
  )

  ;; Is a simplified numeric slot exactly zero? 0 no / 1 yes / 2 pressure.
  (func $approximation_slot_is_exact_zero (param $slot i32) (result i32)
    (local $type i32)
    (local.set $type (call $value_type (local.get $slot)))
    (if (i32.eq (local.get $type) (global.get $TYPE_BIGINT))
      (then (return (i32.eqz (call $bigint_length
        (call $value_data_lo (local.get $slot)))))))
    (if (i32.eq (local.get $type) (global.get $TYPE_RATIONAL))
      (then (return (call $rational_is_zero (local.get $slot)))))
    (if (i32.eq (local.get $type) (global.get $TYPE_ALGEBRAIC))
      (then (return (call $algebraic_value_is_zero
        (call $value_data_lo (local.get $slot))))))
    (i32.const 0)
  )

  ;; Is a simplified numeric slot provably <= 0? Used for the principal-log
  ;; branch rejection. 0 unknown-or-positive / 1 yes / 2 pressure.
  (func $approximation_slot_is_exact_nonpositive (param $slot i32) (result i32)
    (local $type i32)
    (local $zero_status i32)
    (local.set $type (call $value_type (local.get $slot)))
    (if (i32.eq (local.get $type) (global.get $TYPE_BIGINT))
      (then (return (i32.or
        (i32.eqz (call $bigint_length (call $value_data_lo (local.get $slot))))
        (i32.ne (call $bigint_sign (call $value_data_lo (local.get $slot)))
          (i32.const 0))))))
    (if (i32.eq (local.get $type) (global.get $TYPE_RATIONAL))
      (then (return (i32.or
        (call $rational_is_zero (local.get $slot))
        (call $rational_is_negative (local.get $slot))))))
    (if (i32.eq (local.get $type) (global.get $TYPE_ALGEBRAIC))
      (then
        (local.set $zero_status (call $algebraic_value_is_zero
          (call $value_data_lo (local.get $slot))))
        (return (local.get $zero_status))))
    (i32.const 0)
  )

  ;; Refine a real algebraic leaf to a rational interval of width at most
  ;; 2^-precision_bits. Status 0 / 1.
  (func $approximation_algebraic_interval
    (param $header i32) (param $precision_bits i32) (param $destination i32) (result i32)
    (local $target i32)
    (local $interval_data i32)
    (local $low i32)
    (local $high i32)
    (local.set $target (call $approximation_power_of_two_target (local.get $precision_bits)))
    (block $narrowed
      (loop $narrow
        (local.set $interval_data (i32.add
          (i32.load (call $abs (i32.add
            (call $algebraic_interval_of (local.get $header)) (i32.const 16))))
          (global.get $GC_HEADER_SIZE)))
        (local.set $low (call $rational_materialize (local.get $interval_data)))
        (local.set $high (call $rational_materialize
          (i32.add (local.get $interval_data) (global.get $VALUE_SIZE))))
        (br_if $narrowed (i32.le_s
          (call $rational_header_pair_compare
            (call $rational_sub (local.get $high) (local.get $low))
            (local.get $target))
          (i32.const 0)))
        (if (call $algebraic_refine_step (local.get $header))
          (then (return (i32.const 1))))
        (br $narrow)))
    (call $approximation_interval_write (local.get $destination)
      (local.get $low) (local.get $high))
    (i32.const 0)
  )

  ;; The recursive certified interval evaluator over value slots.
  ;; Status: 0 ok / 1 pressure / 2 reject / 3 raise precision.
  (func $approximation_evaluate
    (param $slot i32) (param $precision_bits i32) (param $destination i32) (result i32)
    (local $type i32)
    (local $header i32)
    (local $count i32)
    (local $data i32)
    (local $work i32)
    (local $left i32)
    (local $right i32)
    (local $status i32)
    (local $kind i32)
    (local $argument_slot i32)
    (local $second_kind i32)
    (local $second_argument_slot i32)
    (local $exponent_slot i32)
    (local $exponent_valid i32)
    (local $exponent_value i64)
    (local $exponent_header i32)
    (local $temporary_slot i32)
    (local $zero_status i32)
    (if (call $expression_walk_guard (i32.const 8192))
      (then (return (i32.const 1))))
    (local.set $type (call $value_type (local.get $slot)))
    ;; --- Exact real leaves. ---
    (if (i32.eq (local.get $type) (global.get $TYPE_BIGINT))
      (then
        (local.set $left (call $rational_from_bigint (call $value_data_lo (local.get $slot))))
        (call $approximation_interval_write (local.get $destination)
          (local.get $left) (local.get $left))
        (return (i32.const 0))))
    (if (i32.eq (local.get $type) (global.get $TYPE_RATIONAL))
      (then
        (local.set $left (call $rational_materialize (local.get $slot)))
        (call $approximation_interval_write (local.get $destination)
          (local.get $left) (local.get $left))
        (return (i32.const 0))))
    (if (i32.eq (local.get $type) (global.get $TYPE_ALGEBRAIC))
      (then (return (call $approximation_algebraic_interval
        (call $value_data_lo (local.get $slot))
        (local.get $precision_bits) (local.get $destination)))))
    (if (i32.eq (local.get $type) (global.get $TYPE_COMPLEX))
      (then
        (local.set $header (call $value_data_lo (local.get $slot)))
        ;; Real only when exact endpoint arithmetic makes the imaginary
        ;; part the exact Rational zero.
        (if (i32.ne (call $bigint_length
              (call $rational_numerator (call $complex_imaginary (local.get $header))))
              (i32.const 0))
          (then (return (i32.const 2))))
        (local.set $left (call $complex_real (local.get $header)))
        (call $approximation_interval_write (local.get $destination)
          (local.get $left) (local.get $left))
        (return (i32.const 0))))
    ;; ComplexAlgebraicNumber values are non-real by invariant.
    (if (i32.eq (local.get $type) (global.get $TYPE_COMPLEX_ALGEBRAIC))
      (then (return (i32.const 2))))
    (if (i32.eq (local.get $type) (global.get $TYPE_SYMBOL))
      (then
        ;; The constant Pi gets its own certified enclosure; a free symbol
        ;; is a rejection.
        (if (i32.eq
              (call $symbol_description (call $value_data_lo (local.get $slot)))
              (call $read_builtin (global.get $BUILTIN_EXACT_CONSTANT_PI)))
          (then (return (call $approximation_pi_interval
            (i32.add (local.get $precision_bits) (i32.const 2))
            (local.get $destination)))))
        (return (i32.const 2))))
    (if (i32.ne (local.get $type) (global.get $TYPE_EXPRESSION))
      (then (return (i32.const 2))))
    (local.set $header (call $value_data_lo (local.get $slot)))
    (local.set $count (call $approximation_expression_argument_count (local.get $header)))
    (local.set $data (call $approximation_expression_argument_data (local.get $header)))
    ;; --- Canonical trigonometric trees (before the generic Divide). ---
    (local.set $kind (call $approximation_match_trigonometric (local.get $slot)))
    (if (global.get $memory_pressure_signaled) (then (return (i32.const 1))))
    (if (local.get $kind)
      (then
        (local.set $argument_slot (global.get $approximation_trig_argument_slot))
        (local.set $work (call $carve_scratch_blob (i32.const 8)))
        (local.set $status (call $approximation_evaluate (local.get $argument_slot)
          (i32.add (local.get $precision_bits) (i32.const 4)) (local.get $work)))
        (if (local.get $status) (then (return (local.get $status))))
        (return (call $approximation_sine_cosine_interval (local.get $work)
          (i32.sub (local.get $kind) (i32.const 1))
          (local.get $precision_bits) (local.get $destination)))))
    ;; Tangent: Divide(sine tree of z, cosine tree of the same z).
    (if (i32.and
          (call $approximation_head_is (local.get $header)
            (global.get $BUILTIN_EXPRESSION_HEAD_DIVIDE))
          (i32.eq (local.get $count) (i32.const 2)))
      (then
        (local.set $kind (call $approximation_match_trigonometric (local.get $data)))
        (if (global.get $memory_pressure_signaled) (then (return (i32.const 1))))
        (local.set $argument_slot (global.get $approximation_trig_argument_slot))
        (if (i32.eq (local.get $kind) (i32.const 1))
          (then
            (local.set $second_kind (call $approximation_match_trigonometric
              (i32.add (local.get $data) (global.get $VALUE_SIZE))))
            (if (global.get $memory_pressure_signaled) (then (return (i32.const 1))))
            (local.set $second_argument_slot
              (global.get $approximation_trig_argument_slot))
            (if (i32.eq (local.get $second_kind) (i32.const 2))
              (then
                (if (call $expression_values_equal
                      (local.get $argument_slot) (local.get $second_argument_slot))
                  (then
                    (if (global.get $memory_pressure_signaled)
                      (then (return (i32.const 1))))
                    ;; work: argument, sine, cosine intervals.
                    (local.set $work (call $carve_scratch_blob (i32.const 24)))
                    (local.set $left (i32.add (local.get $work) (i32.const 8)))
                    (local.set $right (i32.add (local.get $work) (i32.const 16)))
                    (local.set $status (call $approximation_evaluate
                      (local.get $argument_slot)
                      (i32.add (local.get $precision_bits) (i32.const 8))
                      (local.get $work)))
                    (if (local.get $status) (then (return (local.get $status))))
                    (local.set $status (call $approximation_sine_cosine_interval
                      (local.get $work) (i32.const 0)
                      (i32.add (local.get $precision_bits) (i32.const 4))
                      (local.get $left)))
                    (if (local.get $status) (then (return (local.get $status))))
                    (local.set $status (call $approximation_sine_cosine_interval
                      (local.get $work) (i32.const 1)
                      (i32.add (local.get $precision_bits) (i32.const 4))
                      (local.get $right)))
                    (if (local.get $status) (then (return (local.get $status))))
                    (if (i32.eqz (call $approximation_interval_sign (local.get $right)))
                      (then
                        ;; The cosine enclosure straddles zero: reject only
                        ;; when the exact cosine value IS zero (a pole).
                        (local.set $temporary_slot
                          (call $carve_scratch_blob (global.get $VALUE_SIZE)))
                        (if (call $expression_simplify_into
                              (i32.add (local.get $data) (global.get $VALUE_SIZE))
                              (local.get $temporary_slot))
                          (then (return (i32.const 1))))
                        (local.set $zero_status (call $approximation_slot_is_exact_zero
                          (local.get $temporary_slot)))
                        (if (i32.eq (local.get $zero_status) (i32.const 2))
                          (then (return (i32.const 1))))
                        (if (local.get $zero_status)
                          (then (return (i32.const 2))))
                        (return (i32.const 3))))
                    (local.set $status (call $approximation_interval_reciprocal
                      (local.get $right) (local.get $right)))
                    (if (local.get $status) (then (return (local.get $status))))
                    (call $approximation_interval_multiply (local.get $destination)
                      (local.get $left) (local.get $right))
                    (call $approximation_interval_round (local.get $destination)
                      (i32.add (local.get $precision_bits) (i32.const 2)))
                    (return (i32.const 0)))))))
          (else
            ;; Consume the failed-match pressure caveat conservatively.
            (if (global.get $memory_pressure_signaled)
              (then (return (i32.const 1))))))))
    ;; --- Exp and principal Log. ---
    (if (i32.and
          (call $approximation_head_is (local.get $header)
            (global.get $BUILTIN_EXPRESSION_HEAD_EXP))
          (i32.eq (local.get $count) (i32.const 1)))
      (then
        (local.set $work (call $carve_scratch_blob (i32.const 8)))
        (local.set $status (call $approximation_evaluate (local.get $data)
          (i32.add (local.get $precision_bits) (i32.const 4)) (local.get $work)))
        (if (local.get $status) (then (return (local.get $status))))
        (local.set $status (call $approximation_exponential_interval (local.get $work)
          (i32.add (local.get $precision_bits) (i32.const 2)) (local.get $destination)))
        (if (local.get $status) (then (return (local.get $status))))
        (call $approximation_interval_round (local.get $destination)
          (i32.add (local.get $precision_bits) (i32.const 2)))
        (return (i32.const 0))))
    (if (i32.and
          (call $approximation_head_is (local.get $header)
            (global.get $BUILTIN_EXPRESSION_HEAD_LOG))
          (i32.eq (local.get $count) (i32.const 1)))
      (then
        (local.set $work (call $carve_scratch_blob (i32.const 8)))
        (local.set $status (call $approximation_evaluate (local.get $data)
          (i32.add (local.get $precision_bits) (i32.const 4)) (local.get $work)))
        (if (local.get $status) (then (return (local.get $status))))
        (local.set $kind (call $approximation_interval_sign (local.get $work)))
        (if (i32.eq (local.get $kind) (i32.const -1))
          (then (return (i32.const 2))))
        (if (i32.eqz (local.get $kind))
          (then
            ;; Zero-straddling argument: reject only when the exact value
            ;; is provably nonpositive; otherwise raise precision.
            (local.set $temporary_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
            (if (call $expression_simplify_into (local.get $data) (local.get $temporary_slot))
              (then (return (i32.const 1))))
            (local.set $zero_status (call $approximation_slot_is_exact_nonpositive
              (local.get $temporary_slot)))
            (if (i32.eq (local.get $zero_status) (i32.const 2))
              (then (return (i32.const 1))))
            (if (local.get $zero_status) (then (return (i32.const 2))))
            (return (i32.const 3))))
        (return (call $approximation_logarithm_interval (local.get $work)
          (i32.add (local.get $precision_bits) (i32.const 2)) (local.get $destination)))))
    ;; --- Negate. ---
    (if (i32.and
          (call $approximation_head_is (local.get $header)
            (global.get $BUILTIN_EXPRESSION_HEAD_NEGATE))
          (i32.eq (local.get $count) (i32.const 1)))
      (then
        (local.set $work (call $carve_scratch_blob (i32.const 8)))
        (local.set $status (call $approximation_evaluate (local.get $data)
          (local.get $precision_bits) (local.get $work)))
        (if (local.get $status) (then (return (local.get $status))))
        (call $approximation_interval_negate (local.get $destination) (local.get $work))
        (return (i32.const 0))))
    ;; --- Power. ---
    (if (i32.and
          (call $approximation_head_is (local.get $header)
            (global.get $BUILTIN_EXPRESSION_HEAD_POWER))
          (i32.eq (local.get $count) (i32.const 2)))
      (then
        (local.set $exponent_slot (i32.add (local.get $data) (global.get $VALUE_SIZE)))
        (local.set $exponent_valid (i32.const 0))
        (if (i32.eq (call $value_type (local.get $exponent_slot)) (global.get $TYPE_BIGINT))
          (then
            (local.set $exponent_valid (call $bigint_to_i64_fits
              (call $value_data_lo (local.get $exponent_slot))))
            (local.set $exponent_value (global.get $bigint_to_i64_value))))
        (if (i32.eq (call $value_type (local.get $exponent_slot)) (global.get $TYPE_RATIONAL))
          (then
            (local.set $exponent_header (call $rational_materialize (local.get $exponent_slot)))
            (if (call $rational_denominator_is_one (local.get $exponent_header))
              (then
                (local.set $exponent_valid (call $bigint_to_i64_fits
                  (call $rational_numerator (local.get $exponent_header))))
                (local.set $exponent_value (global.get $bigint_to_i64_value))))))
        (if (local.get $exponent_valid)
          (then
            ;; Exact integer exponent: repeated interval multiplication.
            (local.set $work (call $carve_scratch_blob (i32.const 8)))
            (local.set $status (call $approximation_evaluate (local.get $data)
              (i32.add (local.get $precision_bits) (i32.const 8)) (local.get $work)))
            (if (local.get $status) (then (return (local.get $status))))
            (return (call $approximation_interval_power_integer
              (local.get $destination) (local.get $work) (local.get $exponent_value)
              (i32.add (local.get $precision_bits) (i32.const 8))))))
        ;; General power: base ** y = exp(y * log(base)) on a provably
        ;; positive base.
        (local.set $work (call $carve_scratch_blob (i32.const 16)))
        (local.set $left (local.get $work))
        (local.set $right (i32.add (local.get $work) (i32.const 8)))
        (local.set $status (call $approximation_evaluate (local.get $data)
          (i32.add (local.get $precision_bits) (i32.const 8)) (local.get $left)))
        (if (local.get $status) (then (return (local.get $status))))
        (local.set $status (call $approximation_evaluate (local.get $exponent_slot)
          (i32.add (local.get $precision_bits) (i32.const 8)) (local.get $right)))
        (if (local.get $status) (then (return (local.get $status))))
        (local.set $kind (call $approximation_interval_sign (local.get $left)))
        (if (i32.eq (local.get $kind) (i32.const -1))
          (then (return (i32.const 2))))
        (if (i32.eqz (local.get $kind))
          (then
            (local.set $temporary_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
            (if (call $expression_simplify_into (local.get $data) (local.get $temporary_slot))
              (then (return (i32.const 1))))
            (local.set $zero_status (call $approximation_slot_is_exact_nonpositive
              (local.get $temporary_slot)))
            (if (i32.eq (local.get $zero_status) (i32.const 2))
              (then (return (i32.const 1))))
            (if (local.get $zero_status) (then (return (i32.const 2))))
            (return (i32.const 3))))
        (local.set $status (call $approximation_logarithm_interval (local.get $left)
          (i32.add (local.get $precision_bits) (i32.const 8)) (local.get $left)))
        (if (local.get $status) (then (return (local.get $status))))
        (call $approximation_interval_multiply
          (local.get $left) (local.get $left) (local.get $right))
        (call $approximation_interval_round (local.get $left)
          (i32.add (local.get $precision_bits) (i32.const 8)))
        (local.set $status (call $approximation_exponential_interval (local.get $left)
          (i32.add (local.get $precision_bits) (i32.const 2)) (local.get $destination)))
        (if (local.get $status) (then (return (local.get $status))))
        (call $approximation_interval_round (local.get $destination)
          (i32.add (local.get $precision_bits) (i32.const 2)))
        (return (i32.const 0))))
    ;; --- Binary arithmetic heads. ---
    (if (i32.ne (local.get $count) (i32.const 2))
      (then (return (i32.const 2))))
    (local.set $kind (i32.const 0))
    (if (call $approximation_head_is (local.get $header)
          (global.get $BUILTIN_EXPRESSION_HEAD_ADD))
      (then (local.set $kind (i32.const 1))))
    (if (call $approximation_head_is (local.get $header)
          (global.get $BUILTIN_EXPRESSION_HEAD_SUBTRACT))
      (then (local.set $kind (i32.const 2))))
    (if (call $approximation_head_is (local.get $header)
          (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY))
      (then (local.set $kind (i32.const 3))))
    (if (call $approximation_head_is (local.get $header)
          (global.get $BUILTIN_EXPRESSION_HEAD_DIVIDE))
      (then (local.set $kind (i32.const 4))))
    (if (i32.eqz (local.get $kind))
      (then (return (i32.const 2))))
    (local.set $work (call $carve_scratch_blob (i32.const 16)))
    (local.set $left (local.get $work))
    (local.set $right (i32.add (local.get $work) (i32.const 8)))
    (local.set $status (call $approximation_evaluate (local.get $data)
      (i32.add (local.get $precision_bits) (i32.const 4)) (local.get $left)))
    (if (local.get $status) (then (return (local.get $status))))
    (local.set $status (call $approximation_evaluate
      (i32.add (local.get $data) (global.get $VALUE_SIZE))
      (i32.add (local.get $precision_bits) (i32.const 4)) (local.get $right)))
    (if (local.get $status) (then (return (local.get $status))))
    (if (i32.eq (local.get $kind) (i32.const 1))
      (then
        (call $approximation_interval_add
          (local.get $destination) (local.get $left) (local.get $right))
        (call $approximation_interval_round (local.get $destination)
          (i32.add (local.get $precision_bits) (i32.const 2)))
        (return (i32.const 0))))
    (if (i32.eq (local.get $kind) (i32.const 2))
      (then
        (call $approximation_interval_subtract
          (local.get $destination) (local.get $left) (local.get $right))
        (call $approximation_interval_round (local.get $destination)
          (i32.add (local.get $precision_bits) (i32.const 2)))
        (return (i32.const 0))))
    (if (i32.eq (local.get $kind) (i32.const 3))
      (then
        (call $approximation_interval_multiply
          (local.get $destination) (local.get $left) (local.get $right))
        (call $approximation_interval_round (local.get $destination)
          (i32.add (local.get $precision_bits) (i32.const 2)))
        (return (i32.const 0))))
    ;; Divide.
    (if (i32.eqz (call $approximation_interval_sign (local.get $right)))
      (then
        ;; The divisor enclosure straddles zero: an exactly-zero divisor is
        ;; a rejection; otherwise the outer loop raises precision.
        (local.set $temporary_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
        (if (call $expression_simplify_into
              (i32.add (local.get $data) (global.get $VALUE_SIZE))
              (local.get $temporary_slot))
          (then (return (i32.const 1))))
        (local.set $zero_status (call $approximation_slot_is_exact_zero
          (local.get $temporary_slot)))
        (if (i32.eq (local.get $zero_status) (i32.const 2))
          (then (return (i32.const 1))))
        (if (local.get $zero_status) (then (return (i32.const 2))))
        (return (i32.const 3))))
    (local.set $status (call $approximation_interval_reciprocal
      (local.get $right) (local.get $right)))
    (if (local.get $status) (then (return (local.get $status))))
    (call $approximation_interval_multiply
      (local.get $destination) (local.get $left) (local.get $right))
    (call $approximation_interval_round (local.get $destination)
      (i32.add (local.get $precision_bits) (i32.const 2)))
    (i32.const 0)
  )
  ;; ==========================================================================
  ;; Symbolic calculus — derived elementary-function constructors, the
  ;; ordering relation heads, and exact structural differentiation.
  ;;
  ;; Exp and principal Log stay the only primitive
  ;; transcendental heads. Every derived function constructor builds one
  ;; canonical expression tree over the existing heads. Differentiation is
  ;; an exact structural operation: no floating-point arithmetic anywhere.
  ;; Each derivative-family method returns one frozen record carrying its
  ;; result and its deduplicated domain conditions.
  ;; ==========================================================================

  (global $METHOD_EXACT_EXPRESSION_SINH i32 (i32.const 0x294))
  (global $METHOD_EXACT_EXPRESSION_COSH i32 (i32.const 0x295))
  (global $METHOD_EXACT_EXPRESSION_TANH i32 (i32.const 0x296))
  (global $METHOD_EXACT_EXPRESSION_SQRT i32 (i32.const 0x297))
  (global $METHOD_EXACT_EXPRESSION_ASIN i32 (i32.const 0x298))
  (global $METHOD_EXACT_EXPRESSION_ACOS i32 (i32.const 0x299))
  (global $METHOD_EXACT_EXPRESSION_ATAN i32 (i32.const 0x29A))
  (global $METHOD_EXACT_EXPRESSION_ASINH i32 (i32.const 0x29B))
  (global $METHOD_EXACT_EXPRESSION_ACOSH i32 (i32.const 0x29C))
  (global $METHOD_EXACT_EXPRESSION_ATANH i32 (i32.const 0x29D))
  (global $METHOD_EXACT_EXPRESSION_DERIVATIVE i32 (i32.const 0x29E))
  (global $METHOD_EXACT_EXPRESSION_GRADIENT i32 (i32.const 0x29F))
  (global $METHOD_EXACT_EXPRESSION_JACOBIAN i32 (i32.const 0x2A0))
  (global $METHOD_EXACT_EXPRESSION_HESSIAN i32 (i32.const 0x2A1))
  (global $METHOD_EXACT_EXPRESSION_TAYLOR i32 (i32.const 0x2A2))

  (global $BUILTIN_EXPRESSION_HEAD_LESS i32 (i32.const 0x60C))
  (global $BUILTIN_EXPRESSION_HEAD_LESS_EQUAL i32 (i32.const 0x610))
  (global $BUILTIN_EXPRESSION_HEAD_GREATER i32 (i32.const 0x614))
  (global $BUILTIN_EXPRESSION_HEAD_GREATER_EQUAL i32 (i32.const 0x618))
  (global $BUILTIN_MSG_DERIVATIVE_UNSUPPORTED_HEAD i32 (i32.const 0x61C))
  (global $BUILTIN_MSG_DERIVATIVE_ARGUMENTS i32 (i32.const 0x620))
  (global $BUILTIN_MSG_TAYLOR_ORDER i32 (i32.const 0x624))
  (global $BUILTIN_KEY_EXPRESSION i32 (i32.const 0x628))
  (global $BUILTIN_KEY_CONDITIONS i32 (i32.const 0x62C))
  (global $BUILTIN_KEY_EXPRESSIONS i32 (i32.const 0x630))
  (global $BUILTIN_KEY_MATRIX i32 (i32.const 0x634))
  (global $BUILTIN_KEY_POLYNOMIAL i32 (i32.const 0x638))
  (global $BUILTIN_KEY_VARIABLE i32 (i32.const 0x63C))
  (global $BUILTIN_KEY_POINT i32 (i32.const 0x640))
  (global $BUILTIN_KEY_ORDER i32 (i32.const 0x644))

  ;; Out-params of the hyperbolic matcher and the derivative engine.
  (global $calculus_argument_slot (mut i32) (i32.const 0))
  (global $calculus_failed_head (mut i32) (i32.const 0))
  ;; Head of the linked condition list collected during one derivative
  ;; run. Node layout: [value slot: 16][next: 4][duplicate: 4][pad: 8].
  (global $calculus_conditions_list (mut i32) (i32.const 0))

  ;; Build head(a) RAW into dest (caller guards).
  (func $build_raw_expr1
    (param $head_builtin i32) (param $a_slot i32) (param $dest_slot i32)
    (local $new_expression i32)
    (local.set $new_expression (call $expression_build
      (call $symbol_registry_lookup (call $read_builtin (local.get $head_builtin)))
      (call $expression_alloc_args1 (local.get $a_slot))))
    (i32.store (call $abs (local.get $dest_slot)) (global.get $TYPE_EXPRESSION))
    (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 4))) (i32.const 0))
    (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 8)))
      (local.get $new_expression))
    (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 12))) (i32.const 0))
  )

  ;; Write the heap Rational one-half into a value slot.
  (func $calculus_write_one_half (param $dest_slot i32)
    (call $write_value (local.get $dest_slot)
      (global.get $TYPE_RATIONAL) (i32.const 0)
      (call $rational_new
        (call $bigint_one)
        (call $bigint_from_i64 (i64.const 2)))
      (i32.const 0))
  )

  ;; Write the Complex 0 + imaginary i into a value slot (imaginary is a
  ;; small exact numerator over the given denominator).
  (func $calculus_write_imaginary
    (param $dest_slot i32) (param $numerator i64) (param $denominator i64)
    (call $write_value (local.get $dest_slot)
      (global.get $TYPE_COMPLEX) (i32.const 0)
      (call $complex_allocate
        (call $rational_new (call $bigint_zero) (call $bigint_one))
        (call $rational_new
          (call $bigint_from_i64 (local.get $numerator))
          (call $bigint_from_i64 (local.get $denominator))))
      (i32.const 0))
  )

  ;; Build sinh(z) (cosh_flag 0) or cosh(z) (cosh_flag 1):
  ;;   sinh(z) = (Exp(z) - Exp(-z)) / 2, cosh(z) = (Exp(z) + Exp(-z)) / 2.
  ;; Returns walk status.
  (func $calculus_build_hyperbolic
    (param $argument_slot i32) (param $cosh_flag i32) (param $destination_slot i32)
    (result i32)
    (local $work i32)
    (local $plus_slot i32)
    (local $minus_slot i32)
    (local $numerator_slot i32)
    (local $two_slot i32)
    (if (call $expression_walk_guard (i32.const 1024))
      (then (return (i32.const 1))))
    (local.set $work (call $carve_scratch_blob (i32.const 64)))
    (local.set $plus_slot (local.get $work))
    (local.set $minus_slot (i32.add (local.get $work) (i32.const 16)))
    (local.set $numerator_slot (i32.add (local.get $work) (i32.const 32)))
    (local.set $two_slot (i32.add (local.get $work) (i32.const 48)))
    (call $build_raw_expr1 (global.get $BUILTIN_EXPRESSION_HEAD_EXP)
      (local.get $argument_slot) (local.get $plus_slot))
    (call $build_raw_expr1 (global.get $BUILTIN_EXPRESSION_HEAD_NEGATE)
      (local.get $argument_slot) (local.get $minus_slot))
    (call $build_raw_expr1 (global.get $BUILTIN_EXPRESSION_HEAD_EXP)
      (local.get $minus_slot) (local.get $minus_slot))
    (call $build_raw_expr2
      (if (result i32) (local.get $cosh_flag)
        (then (global.get $BUILTIN_EXPRESSION_HEAD_ADD))
        (else (global.get $BUILTIN_EXPRESSION_HEAD_SUBTRACT)))
      (local.get $plus_slot) (local.get $minus_slot) (local.get $numerator_slot))
    (call $write_inline_rational (local.get $two_slot) (i64.const 2))
    (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_DIVIDE)
      (local.get $numerator_slot) (local.get $two_slot) (local.get $destination_slot))
    (i32.const 0)
  )

  ;; Build principal sqrt(z) = Power(z, 1/2). Returns walk status.
  (func $calculus_build_square_root
    (param $argument_slot i32) (param $destination_slot i32) (result i32)
    (local $half_slot i32)
    (if (call $expression_walk_guard (i32.const 256))
      (then (return (i32.const 1))))
    (local.set $half_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (call $calculus_write_one_half (local.get $half_slot))
    (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_POWER)
      (local.get $argument_slot) (local.get $half_slot) (local.get $destination_slot))
    (i32.const 0)
  )

  ;; The canonical derived elementary-function constructors. All of them
  ;; use the principal branches of Log and Power(., 1/2):
  ;;   asin(z)  = -i Log(i z + sqrt(1 - z^2))
  ;;   acos(z)  = -i Log(z + i sqrt(1 - z^2))
  ;;   atan(z)  = -(i/2) Log((1 + i z) / (1 - i z))
  ;;   asinh(z) = Log(z + sqrt(z^2 + 1))
  ;;   acosh(z) = Log(z + sqrt(z - 1) sqrt(z + 1))
  ;;   atanh(z) = (1/2) Log((1 + z) / (1 - z))
  (func $expression_derived_function_constructor
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument_pointer i32)
    (local $argument_type i32)
    (local $work i32)
    (local $slot1 i32)
    (local $slot2 i32)
    (local $slot3 i32)
    (local $slot4 i32)
    (local $status i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ne (local.get $argc) (i32.const 1))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message
          (global.get $BUILTIN_MSG_EXPRESSION_UNARY_ARITY))))))
    (local.set $argument_pointer
      (i32.sub (local.get $pending_pointer) (global.get $VALUE_SIZE)))
    (local.set $argument_type (call $value_type (local.get $argument_pointer)))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (i32.eqz (call $expression_arg_type_ok (local.get $argument_type)))
      (then (return (i32.add (i32.const 1) (call $throw_type_error)))))
    (if (call $expression_walk_guard (i32.const 4096))
      (then (return (i32.const 0))))
    (local.set $work (call $carve_scratch_blob (i32.const 64)))
    (local.set $slot1 (local.get $work))
    (local.set $slot2 (i32.add (local.get $work) (i32.const 16)))
    (local.set $slot3 (i32.add (local.get $work) (i32.const 32)))
    (local.set $slot4 (i32.add (local.get $work) (i32.const 48)))
    (block $built
      (if (i32.eq (local.get $method_id) (global.get $METHOD_EXACT_EXPRESSION_SINH))
        (then
          (if (call $calculus_build_hyperbolic (local.get $argument_pointer)
                (i32.const 0) (local.get $stack_base))
            (then (return (i32.const 0))))
          (br $built)))
      (if (i32.eq (local.get $method_id) (global.get $METHOD_EXACT_EXPRESSION_COSH))
        (then
          (if (call $calculus_build_hyperbolic (local.get $argument_pointer)
                (i32.const 1) (local.get $stack_base))
            (then (return (i32.const 0))))
          (br $built)))
      (if (i32.eq (local.get $method_id) (global.get $METHOD_EXACT_EXPRESSION_TANH))
        (then
          (if (call $calculus_build_hyperbolic (local.get $argument_pointer)
                (i32.const 0) (local.get $slot1))
            (then (return (i32.const 0))))
          (if (call $calculus_build_hyperbolic (local.get $argument_pointer)
                (i32.const 1) (local.get $slot2))
            (then (return (i32.const 0))))
          (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_DIVIDE)
            (local.get $slot1) (local.get $slot2) (local.get $stack_base))
          (br $built)))
      (if (i32.eq (local.get $method_id) (global.get $METHOD_EXACT_EXPRESSION_SQRT))
        (then
          (if (call $calculus_build_square_root (local.get $argument_pointer)
                (local.get $stack_base))
            (then (return (i32.const 0))))
          (br $built)))
      (if (i32.eq (local.get $method_id) (global.get $METHOD_EXACT_EXPRESSION_ASIN))
        (then
          ;; slot1 = 1 - z^2 -> sqrt; slot2 = i z; slot3 = i.
          (call $write_inline_rational (local.get $slot1) (i64.const 2))
          (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_POWER)
            (local.get $argument_pointer) (local.get $slot1) (local.get $slot1))
          (call $write_inline_rational (local.get $slot2) (i64.const 1))
          (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_SUBTRACT)
            (local.get $slot2) (local.get $slot1) (local.get $slot1))
          (if (call $calculus_build_square_root (local.get $slot1) (local.get $slot1))
            (then (return (i32.const 0))))
          (call $calculus_write_imaginary (local.get $slot3) (i64.const 1) (i64.const 1))
          (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
            (local.get $slot3) (local.get $argument_pointer) (local.get $slot2))
          (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_ADD)
            (local.get $slot2) (local.get $slot1) (local.get $slot1))
          (call $build_raw_expr1 (global.get $BUILTIN_EXPRESSION_HEAD_LOG)
            (local.get $slot1) (local.get $slot1))
          (call $calculus_write_imaginary (local.get $slot3) (i64.const -1) (i64.const 1))
          (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
            (local.get $slot3) (local.get $slot1) (local.get $stack_base))
          (br $built)))
      (if (i32.eq (local.get $method_id) (global.get $METHOD_EXACT_EXPRESSION_ACOS))
        (then
          ;; slot1 = sqrt(1 - z^2); slot2 = i slot1; sum = z + slot2.
          (call $write_inline_rational (local.get $slot1) (i64.const 2))
          (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_POWER)
            (local.get $argument_pointer) (local.get $slot1) (local.get $slot1))
          (call $write_inline_rational (local.get $slot2) (i64.const 1))
          (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_SUBTRACT)
            (local.get $slot2) (local.get $slot1) (local.get $slot1))
          (if (call $calculus_build_square_root (local.get $slot1) (local.get $slot1))
            (then (return (i32.const 0))))
          (call $calculus_write_imaginary (local.get $slot3) (i64.const 1) (i64.const 1))
          (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
            (local.get $slot3) (local.get $slot1) (local.get $slot1))
          (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_ADD)
            (local.get $argument_pointer) (local.get $slot1) (local.get $slot1))
          (call $build_raw_expr1 (global.get $BUILTIN_EXPRESSION_HEAD_LOG)
            (local.get $slot1) (local.get $slot1))
          (call $calculus_write_imaginary (local.get $slot3) (i64.const -1) (i64.const 1))
          (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
            (local.get $slot3) (local.get $slot1) (local.get $stack_base))
          (br $built)))
      (if (i32.eq (local.get $method_id) (global.get $METHOD_EXACT_EXPRESSION_ATAN))
        (then
          ;; slot1 = i z; slot2 = 1 + i z; slot3 = 1 - i z.
          (call $calculus_write_imaginary (local.get $slot4) (i64.const 1) (i64.const 1))
          (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
            (local.get $slot4) (local.get $argument_pointer) (local.get $slot1))
          (call $write_inline_rational (local.get $slot2) (i64.const 1))
          (call $write_inline_rational (local.get $slot3) (i64.const 1))
          (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_ADD)
            (local.get $slot2) (local.get $slot1) (local.get $slot2))
          (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_SUBTRACT)
            (local.get $slot3) (local.get $slot1) (local.get $slot3))
          (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_DIVIDE)
            (local.get $slot2) (local.get $slot3) (local.get $slot1))
          (call $build_raw_expr1 (global.get $BUILTIN_EXPRESSION_HEAD_LOG)
            (local.get $slot1) (local.get $slot1))
          (call $calculus_write_imaginary (local.get $slot4) (i64.const -1) (i64.const 2))
          (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
            (local.get $slot4) (local.get $slot1) (local.get $stack_base))
          (br $built)))
      (if (i32.eq (local.get $method_id) (global.get $METHOD_EXACT_EXPRESSION_ASINH))
        (then
          ;; Log(z + sqrt(z^2 + 1)).
          (call $write_inline_rational (local.get $slot1) (i64.const 2))
          (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_POWER)
            (local.get $argument_pointer) (local.get $slot1) (local.get $slot1))
          (call $write_inline_rational (local.get $slot2) (i64.const 1))
          (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_ADD)
            (local.get $slot1) (local.get $slot2) (local.get $slot1))
          (if (call $calculus_build_square_root (local.get $slot1) (local.get $slot1))
            (then (return (i32.const 0))))
          (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_ADD)
            (local.get $argument_pointer) (local.get $slot1) (local.get $slot1))
          (call $build_raw_expr1 (global.get $BUILTIN_EXPRESSION_HEAD_LOG)
            (local.get $slot1) (local.get $stack_base))
          (br $built)))
      (if (i32.eq (local.get $method_id) (global.get $METHOD_EXACT_EXPRESSION_ACOSH))
        (then
          ;; Log(z + sqrt(z - 1) sqrt(z + 1)).
          (call $write_inline_rational (local.get $slot1) (i64.const 1))
          (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_SUBTRACT)
            (local.get $argument_pointer) (local.get $slot1) (local.get $slot2))
          (if (call $calculus_build_square_root (local.get $slot2) (local.get $slot2))
            (then (return (i32.const 0))))
          (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_ADD)
            (local.get $argument_pointer) (local.get $slot1) (local.get $slot3))
          (if (call $calculus_build_square_root (local.get $slot3) (local.get $slot3))
            (then (return (i32.const 0))))
          (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
            (local.get $slot2) (local.get $slot3) (local.get $slot2))
          (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_ADD)
            (local.get $argument_pointer) (local.get $slot2) (local.get $slot2))
          (call $build_raw_expr1 (global.get $BUILTIN_EXPRESSION_HEAD_LOG)
            (local.get $slot2) (local.get $stack_base))
          (br $built)))
      ;; atanh(z) = (1/2) Log((1 + z) / (1 - z)).
      (call $write_inline_rational (local.get $slot1) (i64.const 1))
      (call $write_inline_rational (local.get $slot2) (i64.const 1))
      (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_ADD)
        (local.get $slot1) (local.get $argument_pointer) (local.get $slot1))
      (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_SUBTRACT)
        (local.get $slot2) (local.get $argument_pointer) (local.get $slot2))
      (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_DIVIDE)
        (local.get $slot1) (local.get $slot2) (local.get $slot1))
      (call $build_raw_expr1 (global.get $BUILTIN_EXPRESSION_HEAD_LOG)
        (local.get $slot1) (local.get $slot1))
      (call $calculus_write_one_half (local.get $slot2))
      (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
        (local.get $slot2) (local.get $slot1) (local.get $stack_base))
    )
    (call $write_ctx (global.get $CTX_PENDING_POINTER)
      (i32.add (local.get $stack_base) (global.get $VALUE_SIZE)))
    (i32.const 0)
  )

  ;; Match the canonical hyperbolic trees: Divide(Subtract|Add(Exp(z),
  ;; Exp(Negate(z))), 2). Returns 0 no match / 1 sinh / 2 cosh, storing the
  ;; argument slot in $calculus_argument_slot.
  (func $calculus_match_hyperbolic (param $slot i32) (result i32)
    (local $header i32)
    (local $data i32)
    (local $kind i32)
    (local $numerator_header i32)
    (local $pair_data i32)
    (local $first_header i32)
    (local $second_header i32)
    (local $inner_slot i32)
    (local $inner_header i32)
    (local $two_slot i32)
    (if (i32.ne (call $value_type (local.get $slot)) (global.get $TYPE_EXPRESSION))
      (then (return (i32.const 0))))
    (local.set $header (call $value_data_lo (local.get $slot)))
    (if (i32.eqz (call $approximation_head_is (local.get $header)
          (global.get $BUILTIN_EXPRESSION_HEAD_DIVIDE)))
      (then (return (i32.const 0))))
    (if (i32.ne (call $approximation_expression_argument_count (local.get $header))
          (i32.const 2))
      (then (return (i32.const 0))))
    (local.set $data (call $approximation_expression_argument_data (local.get $header)))
    ;; Denominator must be the exact Rational 2.
    (if (i32.ne (call $value_type (i32.add (local.get $data) (global.get $VALUE_SIZE)))
          (global.get $TYPE_RATIONAL))
      (then (return (i32.const 0))))
    (local.set $two_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (call $write_inline_rational (local.get $two_slot) (i64.const 2))
    (if (i32.ne (call $exact_numeric_slots_compare
          (i32.add (local.get $data) (global.get $VALUE_SIZE)) (local.get $two_slot))
          (i32.const 0))
      (then (return (i32.const 0))))
    (if (global.get $memory_pressure_signaled)
      (then (return (i32.const 0))))
    (if (i32.ne (call $value_type (local.get $data)) (global.get $TYPE_EXPRESSION))
      (then (return (i32.const 0))))
    (local.set $numerator_header (call $value_data_lo (local.get $data)))
    (local.set $kind (i32.const 0))
    (if (call $approximation_head_is (local.get $numerator_header)
          (global.get $BUILTIN_EXPRESSION_HEAD_SUBTRACT))
      (then (local.set $kind (i32.const 1))))
    (if (call $approximation_head_is (local.get $numerator_header)
          (global.get $BUILTIN_EXPRESSION_HEAD_ADD))
      (then (local.set $kind (i32.const 2))))
    (if (i32.eqz (local.get $kind)) (then (return (i32.const 0))))
    (if (i32.ne (call $approximation_expression_argument_count (local.get $numerator_header))
          (i32.const 2))
      (then (return (i32.const 0))))
    (local.set $pair_data
      (call $approximation_expression_argument_data (local.get $numerator_header)))
    ;; First argument: Exp(z).
    (if (i32.ne (call $value_type (local.get $pair_data)) (global.get $TYPE_EXPRESSION))
      (then (return (i32.const 0))))
    (local.set $first_header (call $value_data_lo (local.get $pair_data)))
    (if (i32.eqz (call $approximation_head_is (local.get $first_header)
          (global.get $BUILTIN_EXPRESSION_HEAD_EXP)))
      (then (return (i32.const 0))))
    (if (i32.ne (call $approximation_expression_argument_count (local.get $first_header))
          (i32.const 1))
      (then (return (i32.const 0))))
    ;; Second argument: Exp(Negate(z)).
    (if (i32.ne (call $value_type (i32.add (local.get $pair_data) (global.get $VALUE_SIZE)))
          (global.get $TYPE_EXPRESSION))
      (then (return (i32.const 0))))
    (local.set $second_header (call $value_data_lo
      (i32.add (local.get $pair_data) (global.get $VALUE_SIZE))))
    (if (i32.eqz (call $approximation_head_is (local.get $second_header)
          (global.get $BUILTIN_EXPRESSION_HEAD_EXP)))
      (then (return (i32.const 0))))
    (if (i32.ne (call $approximation_expression_argument_count (local.get $second_header))
          (i32.const 1))
      (then (return (i32.const 0))))
    (local.set $inner_slot (call $approximation_expression_argument_data
      (local.get $second_header)))
    (if (i32.ne (call $value_type (local.get $inner_slot)) (global.get $TYPE_EXPRESSION))
      (then (return (i32.const 0))))
    (local.set $inner_header (call $value_data_lo (local.get $inner_slot)))
    (if (i32.eqz (call $approximation_head_is (local.get $inner_header)
          (global.get $BUILTIN_EXPRESSION_HEAD_NEGATE)))
      (then (return (i32.const 0))))
    (if (i32.ne (call $approximation_expression_argument_count (local.get $inner_header))
          (i32.const 1))
      (then (return (i32.const 0))))
    ;; The negated argument must be the SAME z tree.
    (if (i32.eqz (call $expression_values_equal
          (call $approximation_expression_argument_data (local.get $first_header))
          (call $approximation_expression_argument_data (local.get $inner_header))))
      (then (return (i32.const 0))))
    (if (global.get $memory_pressure_signaled)
      (then (return (i32.const 0))))
    (global.set $calculus_argument_slot
      (call $approximation_expression_argument_data (local.get $first_header)))
    (local.get $kind)
  )

  ;; Push one Greater(subject, 0) condition onto the collected list.
  ;; Returns walk status.
  (func $calculus_push_condition_positive (param $subject_slot i32) (result i32)
    (local $node i32)
    (local $zero_slot i32)
    (if (call $expression_walk_guard (i32.const 512))
      (then (return (i32.const 1))))
    (local.set $node (call $carve_scratch_blob (i32.const 32)))
    (local.set $zero_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (call $write_inline_rational (local.get $zero_slot) (i64.const 0))
    (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_GREATER)
      (local.get $subject_slot) (local.get $zero_slot) (local.get $node))
    (i32.store (call $abs (i32.add (local.get $node) (i32.const 16)))
      (global.get $calculus_conditions_list))
    (i32.store (call $abs (i32.add (local.get $node) (i32.const 20))) (i32.const 0))
    (global.set $calculus_conditions_list (local.get $node))
    (i32.const 0)
  )

  ;; Build the frozen, deduplicated conditions Array from the collected
  ;; list. Returns the Array pointer, or -1 on pressure.
  (func $calculus_conditions_array (result i32)
    (local $node i32)
    (local $other i32)
    (local $count i32)
    (local $array_pointer i32)
    (local $data i32)
    ;; Mark duplicates (structural equality against later nodes; the later
    ;; node survives, matching first-introduction order after reversal).
    (local.set $node (global.get $calculus_conditions_list))
    (block $marked
      (loop $mark
        (br_if $marked (i32.eqz (local.get $node)))
        (local.set $other (i32.load (call $abs (i32.add (local.get $node) (i32.const 16)))))
        (block $done_one
          (loop $scan
            (br_if $done_one (i32.eqz (local.get $other)))
            (if (call $expression_values_equal (local.get $node) (local.get $other))
              (then
                (i32.store (call $abs (i32.add (local.get $node) (i32.const 20)))
                  (i32.const 1))
                (br $done_one)))
            (if (global.get $memory_pressure_signaled)
              (then (return (i32.const -1))))
            (local.set $other (i32.load (call $abs
              (i32.add (local.get $other) (i32.const 16)))))
            (br $scan)))
        (local.set $node (i32.load (call $abs (i32.add (local.get $node) (i32.const 16)))))
        (br $mark)))
    (local.set $count (i32.const 0))
    (local.set $node (global.get $calculus_conditions_list))
    (block $counted
      (loop $count_nodes
        (br_if $counted (i32.eqz (local.get $node)))
        (if (i32.eqz (i32.load (call $abs (i32.add (local.get $node) (i32.const 20)))))
          (then (local.set $count (i32.add (local.get $count) (i32.const 1)))))
        (local.set $node (i32.load (call $abs (i32.add (local.get $node) (i32.const 16)))))
        (br $count_nodes)))
    (if (call $expression_walk_guard (i32.add (i32.const 256)
          (i32.mul (local.get $count) (global.get $VALUE_SIZE))))
      (then (return (i32.const -1))))
    (local.set $array_pointer (call $allocate_array (local.get $count)))
    (local.set $data (i32.add
      (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    ;; The list is last-pushed-first; fill from the back so the array keeps
    ;; first-introduction order.
    (local.set $node (global.get $calculus_conditions_list))
    (block $filled
      (loop $fill
        (br_if $filled (i32.eqz (local.get $node)))
        (if (i32.eqz (i32.load (call $abs (i32.add (local.get $node) (i32.const 20)))))
          (then
            (local.set $count (i32.sub (local.get $count) (i32.const 1)))
            (memory.copy
              (call $abs (i32.add (local.get $data)
                (i32.mul (local.get $count) (global.get $VALUE_SIZE))))
              (call $abs (local.get $node))
              (global.get $VALUE_SIZE))))
        (local.set $node (i32.load (call $abs (i32.add (local.get $node) (i32.const 16)))))
        (br $fill)))
    (call $expression_freeze_args_array (local.get $array_pointer))
    (local.get $array_pointer)
  )

  ;; Allocate a frozen record object and set one property per key/slot
  ;; pair. slots holds `count` consecutive (key_builtin i32, value_slot i32)
  ;; pairs in scratch. Returns the object pointer, or 0 on pressure.
  (func $calculus_record (param $pairs i32) (param $count i32) (result i32)
    (local $object_pointer i32)
    (local $i i32)
    (local $key_builtin i32)
    (local $value_slot i32)
    (if (call $expression_walk_guard (i32.const 512))
      (then (return (i32.const 0))))
    (local.set $object_pointer (call $allocate_object (i32.const 6)))
    (local.set $i (i32.const 0))
    (block $set_all
      (loop $set
        (br_if $set_all (i32.ge_u (local.get $i) (local.get $count)))
        (local.set $key_builtin (i32.load (call $abs
          (i32.add (local.get $pairs) (i32.mul (local.get $i) (i32.const 8))))))
        (local.set $value_slot (i32.load (call $abs
          (i32.add (i32.add (local.get $pairs) (i32.mul (local.get $i) (i32.const 8)))
            (i32.const 4)))))
        (drop (call $object_set_property
          (local.get $object_pointer)
          (call $read_builtin (local.get $key_builtin))
          (call $value_type (local.get $value_slot))
          (call $value_flags (local.get $value_slot))
          (call $value_data_lo (local.get $value_slot))
          (i32.load (call $abs (i32.add (local.get $value_slot) (i32.const 12))))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $set)))
    ;; Freeze.
    (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 20)))
      (i32.or
        (i32.load (call $abs (i32.add (local.get $object_pointer) (i32.const 20))))
        (global.get $OBJECT_FLAG_FROZEN)))
    (local.get $object_pointer)
  )

  ;; The exact structural derivative engine.
  ;; Status: 0 ok / 1 pressure / 2 unsupported head (in
  ;; $calculus_failed_head). The raw result lands in destination_slot; the
  ;; public methods pass it through the existing simplifier.
  (func $calculus_derivative_into
    (param $source_slot i32) (param $variable_pointer i32) (param $destination_slot i32)
    (result i32)
    (local $type i32)
    (local $header i32)
    (local $count i32)
    (local $data i32)
    (local $work i32)
    (local $left i32)
    (local $right i32)
    (local $extra i32)
    (local $status i32)
    (local $kind i32)
    (local $argument_slot i32)
    (local $second_kind i32)
    (local $index i32)
    (local $inner i32)
    (local $derivatives i32)
    (local $exponent_slot i32)
    (local $exponent_header i32)
    (local $rows i32)
    (local $columns i32)
    (local $entries_data i32)
    (local $new_entries i32)
    (local $new_data i32)
    (if (call $expression_walk_guard (i32.const 4096))
      (then (return (i32.const 1))))
    (local.set $type (call $value_type (local.get $source_slot)))
    ;; Exact numeric atoms differentiate to zero.
    (if (i32.or
          (i32.or
            (i32.eq (local.get $type) (global.get $TYPE_BIGINT))
            (i32.eq (local.get $type) (global.get $TYPE_RATIONAL)))
          (i32.or
            (i32.eq (local.get $type) (global.get $TYPE_COMPLEX))
            (i32.or
              (i32.eq (local.get $type) (global.get $TYPE_ALGEBRAIC))
              (i32.eq (local.get $type) (global.get $TYPE_COMPLEX_ALGEBRAIC)))))
      (then
        (call $write_inline_rational (local.get $destination_slot) (i64.const 0))
        (return (i32.const 0))))
    ;; A Symbol is the variable (1) or a constant (0).
    (if (i32.eq (local.get $type) (global.get $TYPE_SYMBOL))
      (then
        (call $write_inline_rational (local.get $destination_slot)
          (i64.extend_i32_u (i32.eq
            (call $value_data_lo (local.get $source_slot))
            (local.get $variable_pointer))))
        (return (i32.const 0))))
    ;; Matrix values differentiate element by element.
    (if (i32.eq (local.get $type) (global.get $TYPE_MATRIX))
      (then
        (local.set $header (call $value_data_lo (local.get $source_slot)))
        (local.set $rows (call $matrix_rows_of (local.get $header)))
        (local.set $columns (call $matrix_columns_of (local.get $header)))
        (local.set $count (i32.mul (local.get $rows) (local.get $columns)))
        (local.set $entries_data (i32.add
          (i32.load (call $abs (i32.add
            (call $matrix_entries_of (local.get $header)) (i32.const 16))))
          (global.get $GC_HEADER_SIZE)))
        (local.set $new_entries (call $matrix_budget_and_alloc_entries (local.get $count)))
        (if (i32.eqz (local.get $new_entries)) (then (return (i32.const 1))))
        (local.set $new_data (i32.add
          (i32.load (call $abs (i32.add (local.get $new_entries) (i32.const 16))))
          (global.get $GC_HEADER_SIZE)))
        (local.set $index (i32.const 0))
        (block $entries_done
          (loop $entries
            (br_if $entries_done (i32.ge_u (local.get $index) (local.get $count)))
            (local.set $status (call $calculus_derivative_into
              (i32.add (local.get $entries_data)
                (i32.mul (local.get $index) (global.get $VALUE_SIZE)))
              (local.get $variable_pointer)
              (i32.add (local.get $new_data)
                (i32.mul (local.get $index) (global.get $VALUE_SIZE)))))
            (if (local.get $status) (then (return (local.get $status))))
            (if (call $expression_simplify_into
                  (i32.add (local.get $new_data)
                    (i32.mul (local.get $index) (global.get $VALUE_SIZE)))
                  (i32.add (local.get $new_data)
                    (i32.mul (local.get $index) (global.get $VALUE_SIZE))))
              (then (return (i32.const 1))))
            (local.set $index (i32.add (local.get $index) (i32.const 1)))
            (br $entries)))
        (call $expression_freeze_args_array (local.get $new_entries))
        (if (call $expression_walk_guard (i32.const 64))
          (then (return (i32.const 1))))
        (call $write_value (local.get $destination_slot)
          (global.get $TYPE_MATRIX) (i32.const 0)
          (call $matrix_allocate (local.get $rows) (local.get $columns)
            (local.get $new_entries))
          (i32.const 0))
        (return (i32.const 0))))
    (if (i32.ne (local.get $type) (global.get $TYPE_EXPRESSION))
      (then
        (global.set $calculus_failed_head (i32.const 0))
        (return (i32.const 2))))
    (local.set $header (call $value_data_lo (local.get $source_slot)))
    (local.set $count (call $approximation_expression_argument_count (local.get $header)))
    (local.set $data (call $approximation_expression_argument_data (local.get $header)))
    (local.set $work (call $carve_scratch_blob (i32.const 96)))
    (local.set $left (local.get $work))
    (local.set $right (i32.add (local.get $work) (i32.const 16)))
    (local.set $extra (i32.add (local.get $work) (i32.const 32)))
    ;; --- Recognized canonical trigonometric trees (one closed-form unit). ---
    (local.set $kind (call $approximation_match_trigonometric (local.get $source_slot)))
    (if (global.get $memory_pressure_signaled) (then (return (i32.const 1))))
    (if (local.get $kind)
      (then
        (local.set $argument_slot (global.get $approximation_trig_argument_slot))
        (local.set $status (call $calculus_derivative_into (local.get $argument_slot)
          (local.get $variable_pointer) (local.get $left)))
        (if (local.get $status) (then (return (local.get $status))))
        (if (i32.eq (local.get $kind) (i32.const 1))
          (then
            ;; d sin(u) = cos(u) u'.
            (if (call $expression_build_derived_trigonometric
                  (local.get $argument_slot) (i32.const 1) (local.get $right))
              (then (return (i32.const 1))))
            (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
              (local.get $right) (local.get $left) (local.get $destination_slot))
            (return (i32.const 0))))
        ;; d cos(u) = Negate(sin(u) u').
        (if (call $expression_build_derived_trigonometric
              (local.get $argument_slot) (i32.const 0) (local.get $right))
          (then (return (i32.const 1))))
        (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
          (local.get $right) (local.get $left) (local.get $extra))
        (call $build_raw_expr1 (global.get $BUILTIN_EXPRESSION_HEAD_NEGATE)
          (local.get $extra) (local.get $destination_slot))
        (return (i32.const 0))))
    ;; --- Recognized canonical hyperbolic trees. ---
    (local.set $kind (call $calculus_match_hyperbolic (local.get $source_slot)))
    (if (global.get $memory_pressure_signaled) (then (return (i32.const 1))))
    (if (local.get $kind)
      (then
        (local.set $argument_slot (global.get $calculus_argument_slot))
        (local.set $status (call $calculus_derivative_into (local.get $argument_slot)
          (local.get $variable_pointer) (local.get $left)))
        (if (local.get $status) (then (return (local.get $status))))
        ;; d sinh(u) = cosh(u) u'; d cosh(u) = sinh(u) u'.
        (if (call $calculus_build_hyperbolic (local.get $argument_slot)
              (i32.eq (local.get $kind) (i32.const 1)) (local.get $right))
          (then (return (i32.const 1))))
        (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
          (local.get $right) (local.get $left) (local.get $destination_slot))
        (return (i32.const 0))))
    ;; --- Tangent-shaped quotients: sin(u)/cos(u) and sinh(u)/cosh(u). ---
    (if (i32.and
          (call $approximation_head_is (local.get $header)
            (global.get $BUILTIN_EXPRESSION_HEAD_DIVIDE))
          (i32.eq (local.get $count) (i32.const 2)))
      (then
        ;; tan: d = u' / cos(u)^2.
        (local.set $kind (call $approximation_match_trigonometric (local.get $data)))
        (if (global.get $memory_pressure_signaled) (then (return (i32.const 1))))
        (local.set $argument_slot (global.get $approximation_trig_argument_slot))
        (if (i32.eq (local.get $kind) (i32.const 1))
          (then
            (local.set $second_kind (call $approximation_match_trigonometric
              (i32.add (local.get $data) (global.get $VALUE_SIZE))))
            (if (global.get $memory_pressure_signaled) (then (return (i32.const 1))))
            (if (i32.and
                  (i32.eq (local.get $second_kind) (i32.const 2))
                  (call $expression_values_equal (local.get $argument_slot)
                    (global.get $approximation_trig_argument_slot)))
              (then
                (if (global.get $memory_pressure_signaled) (then (return (i32.const 1))))
                (local.set $status (call $calculus_derivative_into
                  (local.get $argument_slot) (local.get $variable_pointer)
                  (local.get $left)))
                (if (local.get $status) (then (return (local.get $status))))
                (if (call $expression_build_derived_trigonometric
                      (local.get $argument_slot) (i32.const 1) (local.get $right))
                  (then (return (i32.const 1))))
                (call $write_inline_rational (local.get $extra) (i64.const 2))
                (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_POWER)
                  (local.get $right) (local.get $extra) (local.get $right))
                (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_DIVIDE)
                  (local.get $left) (local.get $right) (local.get $destination_slot))
                (return (i32.const 0))))))
        ;; tanh: d = u' / cosh(u)^2.
        (local.set $kind (call $calculus_match_hyperbolic (local.get $data)))
        (if (global.get $memory_pressure_signaled) (then (return (i32.const 1))))
        (local.set $argument_slot (global.get $calculus_argument_slot))
        (if (i32.eq (local.get $kind) (i32.const 1))
          (then
            (local.set $second_kind (call $calculus_match_hyperbolic
              (i32.add (local.get $data) (global.get $VALUE_SIZE))))
            (if (global.get $memory_pressure_signaled) (then (return (i32.const 1))))
            (if (i32.and
                  (i32.eq (local.get $second_kind) (i32.const 2))
                  (call $expression_values_equal (local.get $argument_slot)
                    (global.get $calculus_argument_slot)))
              (then
                (if (global.get $memory_pressure_signaled) (then (return (i32.const 1))))
                (local.set $status (call $calculus_derivative_into
                  (local.get $argument_slot) (local.get $variable_pointer)
                  (local.get $left)))
                (if (local.get $status) (then (return (local.get $status))))
                (if (call $calculus_build_hyperbolic (local.get $argument_slot)
                      (i32.const 1) (local.get $right))
                  (then (return (i32.const 1))))
                (call $write_inline_rational (local.get $extra) (i64.const 2))
                (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_POWER)
                  (local.get $right) (local.get $extra) (local.get $right))
                (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_DIVIDE)
                  (local.get $left) (local.get $right) (local.get $destination_slot))
                (return (i32.const 0))))))))
    ;; --- Exp and principal Log. ---
    (if (i32.and
          (call $approximation_head_is (local.get $header)
            (global.get $BUILTIN_EXPRESSION_HEAD_EXP))
          (i32.eq (local.get $count) (i32.const 1)))
      (then
        (local.set $status (call $calculus_derivative_into (local.get $data)
          (local.get $variable_pointer) (local.get $left)))
        (if (local.get $status) (then (return (local.get $status))))
        (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
          (local.get $source_slot) (local.get $left) (local.get $destination_slot))
        (return (i32.const 0))))
    (if (i32.and
          (call $approximation_head_is (local.get $header)
            (global.get $BUILTIN_EXPRESSION_HEAD_LOG))
          (i32.eq (local.get $count) (i32.const 1)))
      (then
        (local.set $status (call $calculus_derivative_into (local.get $data)
          (local.get $variable_pointer) (local.get $left)))
        (if (local.get $status) (then (return (local.get $status))))
        (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_DIVIDE)
          (local.get $left) (local.get $data) (local.get $destination_slot))
        (return (i32.const 0))))
    ;; --- Negate. ---
    (if (i32.and
          (call $approximation_head_is (local.get $header)
            (global.get $BUILTIN_EXPRESSION_HEAD_NEGATE))
          (i32.eq (local.get $count) (i32.const 1)))
      (then
        (local.set $status (call $calculus_derivative_into (local.get $data)
          (local.get $variable_pointer) (local.get $left)))
        (if (local.get $status) (then (return (local.get $status))))
        (call $build_raw_expr1 (global.get $BUILTIN_EXPRESSION_HEAD_NEGATE)
          (local.get $left) (local.get $destination_slot))
        (return (i32.const 0))))
    ;; --- Add (n-ary) and Subtract (binary). ---
    (if (call $approximation_head_is (local.get $header)
          (global.get $BUILTIN_EXPRESSION_HEAD_ADD))
      (then
        (if (i32.eqz (local.get $count))
          (then
            (call $write_inline_rational (local.get $destination_slot) (i64.const 0))
            (return (i32.const 0))))
        (local.set $status (call $calculus_derivative_into (local.get $data)
          (local.get $variable_pointer) (local.get $left)))
        (if (local.get $status) (then (return (local.get $status))))
        (local.set $index (i32.const 1))
        (block $sum_done
          (loop $sum
            (br_if $sum_done (i32.ge_u (local.get $index) (local.get $count)))
            (local.set $status (call $calculus_derivative_into
              (i32.add (local.get $data)
                (i32.mul (local.get $index) (global.get $VALUE_SIZE)))
              (local.get $variable_pointer) (local.get $right)))
            (if (local.get $status) (then (return (local.get $status))))
            (if (call $expression_walk_guard (i32.const 512))
              (then (return (i32.const 1))))
            (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_ADD)
              (local.get $left) (local.get $right) (local.get $left))
            (local.set $index (i32.add (local.get $index) (i32.const 1)))
            (br $sum)))
        (memory.copy (call $abs (local.get $destination_slot))
          (call $abs (local.get $left)) (global.get $VALUE_SIZE))
        (return (i32.const 0))))
    (if (i32.and
          (call $approximation_head_is (local.get $header)
            (global.get $BUILTIN_EXPRESSION_HEAD_SUBTRACT))
          (i32.eq (local.get $count) (i32.const 2)))
      (then
        (local.set $status (call $calculus_derivative_into (local.get $data)
          (local.get $variable_pointer) (local.get $left)))
        (if (local.get $status) (then (return (local.get $status))))
        (local.set $status (call $calculus_derivative_into
          (i32.add (local.get $data) (global.get $VALUE_SIZE))
          (local.get $variable_pointer) (local.get $right)))
        (if (local.get $status) (then (return (local.get $status))))
        (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_SUBTRACT)
          (local.get $left) (local.get $right) (local.get $destination_slot))
        (return (i32.const 0))))
    ;; --- Multiply: the product rule over all factors in one pass. ---
    (if (call $approximation_head_is (local.get $header)
          (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY))
      (then
        (if (i32.eqz (local.get $count))
          (then
            (call $write_inline_rational (local.get $destination_slot) (i64.const 0))
            (return (i32.const 0))))
        ;; Differentiate every factor first.
        (if (call $expression_walk_guard (i32.add (i32.const 512)
              (i32.mul (local.get $count) (global.get $VALUE_SIZE))))
          (then (return (i32.const 1))))
        (local.set $derivatives (call $carve_scratch_blob
          (i32.mul (local.get $count) (global.get $VALUE_SIZE))))
        (local.set $index (i32.const 0))
        (block $factors_done
          (loop $factors
            (br_if $factors_done (i32.ge_u (local.get $index) (local.get $count)))
            (local.set $status (call $calculus_derivative_into
              (i32.add (local.get $data)
                (i32.mul (local.get $index) (global.get $VALUE_SIZE)))
              (local.get $variable_pointer)
              (i32.add (local.get $derivatives)
                (i32.mul (local.get $index) (global.get $VALUE_SIZE)))))
            (if (local.get $status) (then (return (local.get $status))))
            (local.set $index (i32.add (local.get $index) (i32.const 1)))
            (br $factors)))
        ;; Sum over i of (d_i * product of the other factors).
        (local.set $index (i32.const 0))
        (block $terms_done
          (loop $terms
            (br_if $terms_done (i32.ge_u (local.get $index) (local.get $count)))
            (if (call $expression_walk_guard (i32.const 1024))
              (then (return (i32.const 1))))
            (memory.copy (call $abs (local.get $right))
              (call $abs (i32.add (local.get $derivatives)
                (i32.mul (local.get $index) (global.get $VALUE_SIZE))))
              (global.get $VALUE_SIZE))
            (local.set $inner (i32.const 0))
            (block $product_done
              (loop $product
                (br_if $product_done (i32.ge_u (local.get $inner) (local.get $count)))
                (if (i32.ne (local.get $inner) (local.get $index))
                  (then
                    (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
                      (local.get $right)
                      (i32.add (local.get $data)
                        (i32.mul (local.get $inner) (global.get $VALUE_SIZE)))
                      (local.get $right))))
                (local.set $inner (i32.add (local.get $inner) (i32.const 1)))
                (br $product)))
            (if (local.get $index)
              (then (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_ADD)
                (local.get $left) (local.get $right) (local.get $left)))
              (else (memory.copy (call $abs (local.get $left))
                (call $abs (local.get $right)) (global.get $VALUE_SIZE))))
            (local.set $index (i32.add (local.get $index) (i32.const 1)))
            (br $terms)))
        (memory.copy (call $abs (local.get $destination_slot))
          (call $abs (local.get $left)) (global.get $VALUE_SIZE))
        (return (i32.const 0))))
    ;; --- Divide: the quotient rule. ---
    (if (i32.and
          (call $approximation_head_is (local.get $header)
            (global.get $BUILTIN_EXPRESSION_HEAD_DIVIDE))
          (i32.eq (local.get $count) (i32.const 2)))
      (then
        (local.set $status (call $calculus_derivative_into (local.get $data)
          (local.get $variable_pointer) (local.get $left)))
        (if (local.get $status) (then (return (local.get $status))))
        (local.set $status (call $calculus_derivative_into
          (i32.add (local.get $data) (global.get $VALUE_SIZE))
          (local.get $variable_pointer) (local.get $right)))
        (if (local.get $status) (then (return (local.get $status))))
        ;; (u' v - u v') / v^2.
        (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
          (local.get $left) (i32.add (local.get $data) (global.get $VALUE_SIZE))
          (local.get $left))
        (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
          (local.get $data) (local.get $right) (local.get $right))
        (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_SUBTRACT)
          (local.get $left) (local.get $right) (local.get $left))
        (call $write_inline_rational (local.get $extra) (i64.const 2))
        (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_POWER)
          (i32.add (local.get $data) (global.get $VALUE_SIZE)) (local.get $extra)
          (local.get $right))
        (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_DIVIDE)
          (local.get $left) (local.get $right) (local.get $destination_slot))
        (return (i32.const 0))))
    ;; --- Power. ---
    (if (i32.and
          (call $approximation_head_is (local.get $header)
            (global.get $BUILTIN_EXPRESSION_HEAD_POWER))
          (i32.eq (local.get $count) (i32.const 2)))
      (then
        (local.set $exponent_slot (i32.add (local.get $data) (global.get $VALUE_SIZE)))
        ;; Constant BigInt or Rational exponent: c u^(c-1) u'; a
        ;; non-integer exponent uses the principal branch and adds the
        ;; condition Greater(u, 0).
        (local.set $kind (i32.const 0))
        (if (i32.eq (call $value_type (local.get $exponent_slot)) (global.get $TYPE_BIGINT))
          (then
            (local.set $exponent_header (call $rational_from_bigint
              (call $value_data_lo (local.get $exponent_slot))))
            (local.set $kind (i32.const 1))))
        (if (i32.eq (call $value_type (local.get $exponent_slot)) (global.get $TYPE_RATIONAL))
          (then
            (local.set $exponent_header (call $rational_materialize
              (local.get $exponent_slot)))
            (local.set $kind (i32.const 1))))
        (if (local.get $kind)
          (then
            (local.set $status (call $calculus_derivative_into (local.get $data)
              (local.get $variable_pointer) (local.get $left)))
            (if (local.get $status) (then (return (local.get $status))))
            (if (i32.eqz (call $rational_denominator_is_one (local.get $exponent_header)))
              (then
                (local.set $status (call $calculus_push_condition_positive
                  (local.get $data)))
                (if (local.get $status) (then (return (local.get $status))))))
            ;; extra = c - 1 (exact rational), right = u^(c-1).
            (call $write_value (local.get $extra)
              (global.get $TYPE_RATIONAL) (i32.const 0)
              (call $rational_sub (local.get $exponent_header)
                (call $rational_new (call $bigint_one) (call $bigint_one)))
              (i32.const 0))
            (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_POWER)
              (local.get $data) (local.get $extra) (local.get $right))
            (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
              (local.get $exponent_slot) (local.get $right) (local.get $right))
            (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
              (local.get $right) (local.get $left) (local.get $destination_slot))
            (return (i32.const 0))))
        ;; General power through the principal Log:
        ;;   d(u^v) = u^v (v' Log(u) + v u' / u), condition Greater(u, 0).
        (local.set $status (call $calculus_derivative_into (local.get $data)
          (local.get $variable_pointer) (local.get $left)))
        (if (local.get $status) (then (return (local.get $status))))
        (local.set $status (call $calculus_derivative_into (local.get $exponent_slot)
          (local.get $variable_pointer) (local.get $right)))
        (if (local.get $status) (then (return (local.get $status))))
        (local.set $status (call $calculus_push_condition_positive (local.get $data)))
        (if (local.get $status) (then (return (local.get $status))))
        ;; extra = v' Log(u).
        (call $build_raw_expr1 (global.get $BUILTIN_EXPRESSION_HEAD_LOG)
          (local.get $data) (local.get $extra))
        (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
          (local.get $right) (local.get $extra) (local.get $extra))
        ;; left = v u' / u.
        (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
          (local.get $exponent_slot) (local.get $left) (local.get $left))
        (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_DIVIDE)
          (local.get $left) (local.get $data) (local.get $left))
        (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_ADD)
          (local.get $extra) (local.get $left) (local.get $left))
        (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
          (local.get $source_slot) (local.get $left) (local.get $destination_slot))
        (return (i32.const 0))))
    ;; An unknown head is not differentiable.
    (global.set $calculus_failed_head (call $expression_head (local.get $header)))
    (i32.const 2)
  )

  ;; Throw the derivative TypeError that names the unsupported head.
  (func $calculus_throw_unsupported_head (result i32)
    (local $error i32)
    (local.set $error (call $allocate_error_object
      (call $read_state (global.get $STATE_TYPE_ERROR_PROTOTYPE))
      (global.get $BUILTIN_MSG_DERIVATIVE_UNSUPPORTED_HEAD)))
    (if (global.get $calculus_failed_head)
      (then
        (drop (call $object_set_property (local.get $error)
          (call $read_builtin (global.get $BUILTIN_MESSAGE))
          (global.get $TYPE_STRING) (i32.const 0)
          (call $string_concat
            (call $read_builtin (global.get $BUILTIN_MSG_DERIVATIVE_UNSUPPORTED_HEAD))
            (call $symbol_description (global.get $calculus_failed_head)))
          (i32.const 0)))))
    (call $throw_allocated_error (local.get $error))
  )

  ;; Simplify-and-record tail shared by derivative and gradient-family
  ;; methods: builds the conditions array and the frozen record, then
  ;; pushes it. pairs/count as for $calculus_record, with the conditions
  ;; slot LAST (its value slot is filled here). Returns dispatch status.
  (func $calculus_finish_record (param $pairs i32) (param $count i32) (result i32)
    (local $conditions_array i32)
    (local $conditions_slot i32)
    (local $record i32)
    (local.set $conditions_array (call $calculus_conditions_array))
    (if (i32.eq (local.get $conditions_array) (i32.const -1))
      (then (return (i32.const 0))))
    (local.set $conditions_slot (i32.load (call $abs (i32.add
      (i32.add (local.get $pairs)
        (i32.mul (i32.sub (local.get $count) (i32.const 1)) (i32.const 8)))
      (i32.const 4)))))
    (call $write_value (local.get $conditions_slot)
      (global.get $TYPE_ARRAY) (i32.const 0) (local.get $conditions_array) (i32.const 0))
    (local.set $record (call $calculus_record (local.get $pairs) (local.get $count)))
    (if (i32.eqz (local.get $record)) (then (return (i32.const 0))))
    (call $pending_push (global.get $TYPE_OBJECT) (i32.const 0)
      (local.get $record) (i32.const 0))
    (i32.const 0)
  )

  ;; derivative(expression, variable) -> { expression, conditions }.
  (func $expression_derivative_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $expression_slot i32)
    (local $variable_slot i32)
    (local $result_slot i32)
    (local $pairs i32)
    (local $status i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then (local.set $expression_slot (i32.sub (local.get $pending_pointer)
        (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))))
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then (local.set $variable_slot
        (i32.add (local.get $expression_slot) (global.get $VALUE_SIZE)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (i32.or
          (i32.ne (local.get $argc) (i32.const 2))
          (i32.ne (call $value_type (local.get $variable_slot)) (global.get $TYPE_SYMBOL)))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message
          (global.get $BUILTIN_MSG_DERIVATIVE_ARGUMENTS))))))
    (if (call $expression_walk_guard (i32.const 4096))
      (then (return (i32.const 0))))
    (global.set $calculus_conditions_list (i32.const 0))
    (local.set $result_slot (call $carve_scratch_blob (i32.const 32)))
    (local.set $pairs (call $carve_scratch_blob (i32.const 16)))
    (local.set $status (call $calculus_derivative_into (local.get $expression_slot)
      (call $value_data_lo (local.get $variable_slot)) (local.get $result_slot)))
    (if (i32.eq (local.get $status) (i32.const 1)) (then (return (i32.const 0))))
    (if (i32.eq (local.get $status) (i32.const 2))
      (then (return (i32.add (i32.const 1) (call $calculus_throw_unsupported_head)))))
    (if (i32.ne (call $value_type (local.get $result_slot)) (global.get $TYPE_MATRIX))
      (then
        (if (call $expression_simplify_into (local.get $result_slot) (local.get $result_slot))
          (then (return (i32.const 0))))))
    (i32.store (call $abs (local.get $pairs)) (global.get $BUILTIN_KEY_EXPRESSION))
    (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 4)))
      (local.get $result_slot))
    (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 8)))
      (global.get $BUILTIN_KEY_CONDITIONS))
    (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 12)))
      (i32.add (local.get $result_slot) (i32.const 16)))
    (call $calculus_finish_record (local.get $pairs) (i32.const 2))
  )

  ;; Validate a variables argument: an Array of distinct Symbols.
  ;; Returns 1 valid / 0 invalid.
  (func $calculus_variables_ok (param $variables_slot i32) (result i32)
    (local $array_pointer i32)
    (local $length i32)
    (local $data i32)
    (local $i i32)
    (local $j i32)
    (if (i32.ne (call $value_type (local.get $variables_slot)) (global.get $TYPE_ARRAY))
      (then (return (i32.const 0))))
    (local.set $array_pointer (call $value_data_lo (local.get $variables_slot)))
    (local.set $length (i32.load (call $abs
      (i32.add (local.get $array_pointer) (i32.const 8)))))
    (local.set $data (i32.add
      (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (local.set $i (i32.const 0))
    (block $checked
      (loop $check
        (br_if $checked (i32.ge_u (local.get $i) (local.get $length)))
        (if (i32.ne (call $value_type (i32.add (local.get $data)
              (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
              (global.get $TYPE_SYMBOL))
          (then (return (i32.const 0))))
        (local.set $j (i32.const 0))
        (block $distinct
          (loop $pair
            (br_if $distinct (i32.ge_u (local.get $j) (local.get $i)))
            (if (i32.eq
                  (call $value_data_lo (i32.add (local.get $data)
                    (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
                  (call $value_data_lo (i32.add (local.get $data)
                    (i32.mul (local.get $j) (global.get $VALUE_SIZE)))))
              (then (return (i32.const 0))))
            (local.set $j (i32.add (local.get $j) (i32.const 1)))
            (br $pair)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $check)))
    (i32.const 1)
  )

  ;; gradient(expression, variables) -> { expressions, conditions }.
  (func $expression_gradient_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $expression_slot i32)
    (local $variables_slot i32)
    (local $variables_data i32)
    (local $length i32)
    (local $i i32)
    (local $status i32)
    (local $result_array i32)
    (local $result_data i32)
    (local $pairs i32)
    (local $slots i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then (local.set $expression_slot (i32.sub (local.get $pending_pointer)
        (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))))
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then (local.set $variables_slot
        (i32.add (local.get $expression_slot) (global.get $VALUE_SIZE)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (i32.or
          (i32.ne (local.get $argc) (i32.const 2))
          (i32.eqz (call $calculus_variables_ok (local.get $variables_slot))))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message
          (global.get $BUILTIN_MSG_DERIVATIVE_ARGUMENTS))))))
    (local.set $length (i32.load (call $abs (i32.add
      (call $value_data_lo (local.get $variables_slot)) (i32.const 8)))))
    (if (call $expression_walk_guard (i32.add (i32.const 4096)
          (i32.mul (local.get $length) (i32.const 64))))
      (then (return (i32.const 0))))
    (global.set $calculus_conditions_list (i32.const 0))
    (local.set $result_array (call $allocate_array (local.get $length)))
    (local.set $result_data (i32.add
      (i32.load (call $abs (i32.add (local.get $result_array) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (local.set $variables_data (i32.add
      (i32.load (call $abs (i32.add
        (call $value_data_lo (local.get $variables_slot)) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (local.set $i (i32.const 0))
    (block $derived
      (loop $derive
        (br_if $derived (i32.ge_u (local.get $i) (local.get $length)))
        (local.set $status (call $calculus_derivative_into (local.get $expression_slot)
          (call $value_data_lo (i32.add (local.get $variables_data)
            (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
          (i32.add (local.get $result_data)
            (i32.mul (local.get $i) (global.get $VALUE_SIZE)))))
        (if (i32.eq (local.get $status) (i32.const 1)) (then (return (i32.const 0))))
        (if (i32.eq (local.get $status) (i32.const 2))
          (then (return (i32.add (i32.const 1)
            (call $calculus_throw_unsupported_head)))))
        (if (call $expression_simplify_into
              (i32.add (local.get $result_data)
                (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
              (i32.add (local.get $result_data)
                (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
          (then (return (i32.const 0))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $derive)))
    (call $expression_freeze_args_array (local.get $result_array))
    (local.set $slots (call $carve_scratch_blob (i32.const 32)))
    (local.set $pairs (call $carve_scratch_blob (i32.const 16)))
    (call $write_value (local.get $slots)
      (global.get $TYPE_ARRAY) (i32.const 0) (local.get $result_array) (i32.const 0))
    (i32.store (call $abs (local.get $pairs)) (global.get $BUILTIN_KEY_EXPRESSIONS))
    (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 4))) (local.get $slots))
    (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 8)))
      (global.get $BUILTIN_KEY_CONDITIONS))
    (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 12)))
      (i32.add (local.get $slots) (i32.const 16)))
    (call $calculus_finish_record (local.get $pairs) (i32.const 2))
  )

  ;; Differentiate matrix_source[row] expressions by variables into a
  ;; row-major entries array. Shared by jacobian (rows = expressions) and
  ;; hessian (rows = first derivatives). Returns the entries array
  ;; pointer, -1 pressure, -2 unsupported head.
  (func $calculus_matrix_entries
    (param $sources_data i32) (param $rows i32)
    (param $variables_data i32) (param $columns i32)
    (result i32)
    (local $entries i32)
    (local $entries_data i32)
    (local $r i32)
    (local $c i32)
    (local $slot i32)
    (local $status i32)
    (local.set $entries (call $matrix_budget_and_alloc_entries
      (i32.mul (local.get $rows) (local.get $columns))))
    (if (i32.eqz (local.get $entries)) (then (return (i32.const -1))))
    (local.set $entries_data (i32.add
      (i32.load (call $abs (i32.add (local.get $entries) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (local.set $r (i32.const 0))
    (block $rows_done
      (loop $row_loop
        (br_if $rows_done (i32.ge_u (local.get $r) (local.get $rows)))
        (local.set $c (i32.const 0))
        (block $columns_done
          (loop $column_loop
            (br_if $columns_done (i32.ge_u (local.get $c) (local.get $columns)))
            (local.set $slot (i32.add (local.get $entries_data)
              (i32.mul (i32.add (i32.mul (local.get $r) (local.get $columns))
                (local.get $c)) (global.get $VALUE_SIZE))))
            (local.set $status (call $calculus_derivative_into
              (i32.add (local.get $sources_data)
                (i32.mul (local.get $r) (global.get $VALUE_SIZE)))
              (call $value_data_lo (i32.add (local.get $variables_data)
                (i32.mul (local.get $c) (global.get $VALUE_SIZE))))
              (local.get $slot)))
            (if (i32.eq (local.get $status) (i32.const 1))
              (then (return (i32.const -1))))
            (if (i32.eq (local.get $status) (i32.const 2))
              (then (return (i32.const -2))))
            (if (call $expression_simplify_into (local.get $slot) (local.get $slot))
              (then (return (i32.const -1))))
            (local.set $c (i32.add (local.get $c) (i32.const 1)))
            (br $column_loop)))
        (local.set $r (i32.add (local.get $r) (i32.const 1)))
        (br $row_loop)))
    (call $expression_freeze_args_array (local.get $entries))
    (local.get $entries)
  )

  ;; jacobian(expressions, variables) -> { matrix, conditions }.
  (func $expression_jacobian_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $expressions_slot i32)
    (local $variables_slot i32)
    (local $rows i32)
    (local $columns i32)
    (local $sources_data i32)
    (local $variables_data i32)
    (local $entries i32)
    (local $slots i32)
    (local $pairs i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then (local.set $expressions_slot (i32.sub (local.get $pending_pointer)
        (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))))
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then (local.set $variables_slot
        (i32.add (local.get $expressions_slot) (global.get $VALUE_SIZE)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (i32.or
          (i32.or
            (i32.ne (local.get $argc) (i32.const 2))
            (i32.ne (call $value_type (local.get $expressions_slot))
              (global.get $TYPE_ARRAY)))
          (i32.eqz (call $calculus_variables_ok (local.get $variables_slot))))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message
          (global.get $BUILTIN_MSG_DERIVATIVE_ARGUMENTS))))))
    (local.set $rows (i32.load (call $abs (i32.add
      (call $value_data_lo (local.get $expressions_slot)) (i32.const 8)))))
    (local.set $columns (i32.load (call $abs (i32.add
      (call $value_data_lo (local.get $variables_slot)) (i32.const 8)))))
    (if (call $expression_walk_guard (i32.add (i32.const 4096)
          (i32.mul (i32.mul (local.get $rows) (local.get $columns)) (i32.const 32))))
      (then (return (i32.const 0))))
    (global.set $calculus_conditions_list (i32.const 0))
    (local.set $sources_data (i32.add
      (i32.load (call $abs (i32.add
        (call $value_data_lo (local.get $expressions_slot)) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (local.set $variables_data (i32.add
      (i32.load (call $abs (i32.add
        (call $value_data_lo (local.get $variables_slot)) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (local.set $entries (call $calculus_matrix_entries
      (local.get $sources_data) (local.get $rows)
      (local.get $variables_data) (local.get $columns)))
    (if (i32.eq (local.get $entries) (i32.const -1)) (then (return (i32.const 0))))
    (if (i32.eq (local.get $entries) (i32.const -2))
      (then (return (i32.add (i32.const 1) (call $calculus_throw_unsupported_head)))))
    (local.set $slots (call $carve_scratch_blob (i32.const 32)))
    (local.set $pairs (call $carve_scratch_blob (i32.const 16)))
    (call $write_value (local.get $slots)
      (global.get $TYPE_MATRIX) (i32.const 0)
      (call $matrix_allocate (local.get $rows) (local.get $columns) (local.get $entries))
      (i32.const 0))
    (i32.store (call $abs (local.get $pairs)) (global.get $BUILTIN_KEY_MATRIX))
    (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 4))) (local.get $slots))
    (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 8)))
      (global.get $BUILTIN_KEY_CONDITIONS))
    (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 12)))
      (i32.add (local.get $slots) (i32.const 16)))
    (call $calculus_finish_record (local.get $pairs) (i32.const 2))
  )

  ;; hessian(expression, variables) -> { matrix, conditions }. Row i is
  ;; the derivative with respect to variables[i], differentiated again by
  ;; each variables[j] in the caller's order.
  (func $expression_hessian_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $expression_slot i32)
    (local $variables_slot i32)
    (local $length i32)
    (local $variables_data i32)
    (local $first_data i32)
    (local $i i32)
    (local $status i32)
    (local $entries i32)
    (local $slots i32)
    (local $pairs i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then (local.set $expression_slot (i32.sub (local.get $pending_pointer)
        (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))))
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then (local.set $variables_slot
        (i32.add (local.get $expression_slot) (global.get $VALUE_SIZE)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (i32.or
          (i32.ne (local.get $argc) (i32.const 2))
          (i32.eqz (call $calculus_variables_ok (local.get $variables_slot))))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message
          (global.get $BUILTIN_MSG_DERIVATIVE_ARGUMENTS))))))
    (local.set $length (i32.load (call $abs (i32.add
      (call $value_data_lo (local.get $variables_slot)) (i32.const 8)))))
    (if (call $expression_walk_guard (i32.add (i32.const 4096)
          (i32.mul (i32.mul (local.get $length) (local.get $length)) (i32.const 32))))
      (then (return (i32.const 0))))
    (global.set $calculus_conditions_list (i32.const 0))
    (local.set $variables_data (i32.add
      (i32.load (call $abs (i32.add
        (call $value_data_lo (local.get $variables_slot)) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    ;; First derivatives, simplified, in caller order.
    (local.set $first_data (call $carve_scratch_blob
      (i32.mul (local.get $length) (global.get $VALUE_SIZE))))
    (local.set $i (i32.const 0))
    (block $first_done
      (loop $first_loop
        (br_if $first_done (i32.ge_u (local.get $i) (local.get $length)))
        (local.set $status (call $calculus_derivative_into (local.get $expression_slot)
          (call $value_data_lo (i32.add (local.get $variables_data)
            (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
          (i32.add (local.get $first_data)
            (i32.mul (local.get $i) (global.get $VALUE_SIZE)))))
        (if (i32.eq (local.get $status) (i32.const 1)) (then (return (i32.const 0))))
        (if (i32.eq (local.get $status) (i32.const 2))
          (then (return (i32.add (i32.const 1)
            (call $calculus_throw_unsupported_head)))))
        (if (call $expression_simplify_into
              (i32.add (local.get $first_data)
                (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
              (i32.add (local.get $first_data)
                (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
          (then (return (i32.const 0))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $first_loop)))
    (local.set $entries (call $calculus_matrix_entries
      (local.get $first_data) (local.get $length)
      (local.get $variables_data) (local.get $length)))
    (if (i32.eq (local.get $entries) (i32.const -1)) (then (return (i32.const 0))))
    (if (i32.eq (local.get $entries) (i32.const -2))
      (then (return (i32.add (i32.const 1) (call $calculus_throw_unsupported_head)))))
    (local.set $slots (call $carve_scratch_blob (i32.const 32)))
    (local.set $pairs (call $carve_scratch_blob (i32.const 16)))
    (call $write_value (local.get $slots)
      (global.get $TYPE_MATRIX) (i32.const 0)
      (call $matrix_allocate (local.get $length) (local.get $length) (local.get $entries))
      (i32.const 0))
    (i32.store (call $abs (local.get $pairs)) (global.get $BUILTIN_KEY_MATRIX))
    (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 4))) (local.get $slots))
    (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 8)))
      (global.get $BUILTIN_KEY_CONDITIONS))
    (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 12)))
      (i32.add (local.get $slots) (i32.const 16)))
    (call $calculus_finish_record (local.get $pairs) (i32.const 2))
  )

  ;; taylor(expression, variable, point, order) ->
  ;;   { polynomial, variable, point, order, conditions }.
  ;; The finite Taylor polynomial only; no remainder value is fabricated.
  (func $expression_taylor_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $expression_slot i32)
    (local $variable_slot i32)
    (local $point_slot i32)
    (local $order_slot i32)
    (local $order i64)
    (local $order_valid i32)
    (local $work i32)
    (local $polynomial i32)
    (local $current i32)
    (local $term i32)
    (local $delta i32)
    (local $scratch i32)
    (local $factorial i32)
    (local $k i64)
    (local $status i32)
    (local $pairs i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then (local.set $expression_slot (i32.sub (local.get $pending_pointer)
        (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))))
    (if (i32.ge_u (local.get $argc) (i32.const 4))
      (then
        (local.set $variable_slot
          (i32.add (local.get $expression_slot) (global.get $VALUE_SIZE)))
        (local.set $point_slot
          (i32.add (local.get $variable_slot) (global.get $VALUE_SIZE)))
        (local.set $order_slot
          (i32.add (local.get $point_slot) (global.get $VALUE_SIZE)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (i32.or
          (i32.ne (local.get $argc) (i32.const 4))
          (i32.ne (call $value_type (local.get $variable_slot)) (global.get $TYPE_SYMBOL)))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message
          (global.get $BUILTIN_MSG_DERIVATIVE_ARGUMENTS))))))
    (if (i32.eq (call $value_type (local.get $order_slot)) (global.get $TYPE_BIGINT))
      (then
        (local.set $order_valid (call $bigint_to_i64_fits
          (call $value_data_lo (local.get $order_slot))))
        (local.set $order (global.get $bigint_to_i64_value))))
    (if (i32.or
          (i32.eqz (local.get $order_valid))
          (i32.or
            (i64.lt_s (local.get $order) (i64.const 0))
            (i64.gt_s (local.get $order) (i64.const 256))))
      (then (return (i32.add (i32.const 1)
        (call $throw_range_error_with_message (global.get $BUILTIN_MSG_TAYLOR_ORDER))))))
    (if (call $expression_walk_guard (i32.const 8192))
      (then (return (i32.const 0))))
    (global.set $calculus_conditions_list (i32.const 0))
    (local.set $work (call $carve_scratch_blob (i32.const 96)))
    (local.set $polynomial (local.get $work))
    (local.set $current (i32.add (local.get $work) (i32.const 16)))
    (local.set $term (i32.add (local.get $work) (i32.const 32)))
    (local.set $delta (i32.add (local.get $work) (i32.const 48)))
    (local.set $scratch (i32.add (local.get $work) (i32.const 64)))
    ;; Order-zero term: f evaluated at the point.
    (if (call $expression_substitute_into (local.get $expression_slot)
          (call $value_data_lo (local.get $variable_slot))
          (local.get $point_slot) (local.get $polynomial))
      (then (return (i32.const 0))))
    (if (call $expression_simplify_into (local.get $polynomial) (local.get $polynomial))
      (then (return (i32.const 0))))
    ;; delta = variable - point (raw canonical difference).
    (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_SUBTRACT)
      (local.get $variable_slot) (local.get $point_slot) (local.get $delta))
    (memory.copy (call $abs (local.get $current))
      (call $abs (local.get $expression_slot)) (global.get $VALUE_SIZE))
    (local.set $factorial (call $bigint_one))
    (local.set $k (i64.const 1))
    (block $expanded
      (loop $expand
        (br_if $expanded (i64.gt_s (local.get $k) (local.get $order)))
        (if (call $expression_walk_guard (i32.const 8192))
          (then (return (i32.const 0))))
        ;; current = simplify(d current / d variable).
        (local.set $status (call $calculus_derivative_into (local.get $current)
          (call $value_data_lo (local.get $variable_slot)) (local.get $scratch)))
        (if (i32.eq (local.get $status) (i32.const 1)) (then (return (i32.const 0))))
        (if (i32.eq (local.get $status) (i32.const 2))
          (then (return (i32.add (i32.const 1)
            (call $calculus_throw_unsupported_head)))))
        (if (call $expression_simplify_into (local.get $scratch) (local.get $current))
          (then (return (i32.const 0))))
        (local.set $factorial (call $bigint_mul (local.get $factorial)
          (call $bigint_from_i64 (local.get $k))))
        ;; term = (current at point / k!) * delta^k.
        (if (call $expression_substitute_into (local.get $current)
              (call $value_data_lo (local.get $variable_slot))
              (local.get $point_slot) (local.get $term))
          (then (return (i32.const 0))))
        (call $write_value (local.get $scratch)
          (global.get $TYPE_RATIONAL) (i32.const 0)
          (call $rational_from_bigint (local.get $factorial)) (i32.const 0))
        (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_DIVIDE)
          (local.get $term) (local.get $scratch) (local.get $term))
        (call $write_inline_rational (local.get $scratch) (local.get $k))
        (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_POWER)
          (local.get $delta) (local.get $scratch) (local.get $scratch))
        (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
          (local.get $term) (local.get $scratch) (local.get $term))
        (if (call $build_simplified2 (global.get $BUILTIN_EXPRESSION_HEAD_ADD)
              (local.get $polynomial) (local.get $term) (local.get $polynomial))
          (then (return (i32.const 0))))
        (local.set $k (i64.add (local.get $k) (i64.const 1)))
        (br $expand)))
    (local.set $pairs (call $carve_scratch_blob (i32.const 48)))
    (local.set $scratch (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (i32.store (call $abs (local.get $pairs)) (global.get $BUILTIN_KEY_POLYNOMIAL))
    (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 4)))
      (local.get $polynomial))
    (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 8)))
      (global.get $BUILTIN_KEY_VARIABLE))
    (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 12)))
      (local.get $variable_slot))
    (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 16)))
      (global.get $BUILTIN_KEY_POINT))
    (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 20)))
      (local.get $point_slot))
    (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 24)))
      (global.get $BUILTIN_KEY_ORDER))
    (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 28)))
      (local.get $order_slot))
    (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 32)))
      (global.get $BUILTIN_KEY_CONDITIONS))
    (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 36)))
      (local.get $scratch))
    (call $calculus_finish_record (local.get $pairs) (i32.const 5))
  )

  ;; ==========================================================================
  ;; Exact solving and factorization — the univariate rational polynomial
  ;; surface over the existing Zassenhaus/Hensel engine, exact polynomial
  ;; root solving with multiplicity, and the tagged linear-solve results.
  ;;
  ;; The solving and factorization surface is univariate: the
  ;; named variable is the only free symbol, and every other free symbol or
  ;; non-rational coefficient is a loud rejection. Algebraic coefficients
  ;; stay rejected in `factor` until the shared-field representation
  ;; defines a complete factor contract; `solvePolynomial` routes them
  ;; through the existing complex-roots engine.
  ;; ==========================================================================

  (global $METHOD_EXACT_EXPRESSION_FACTOR i32 (i32.const 0x2A3))
  (global $METHOD_EXACT_EXPRESSION_EXPAND_FACTORIZATION i32 (i32.const 0x2A4))
  (global $METHOD_EXACT_EXPRESSION_DEGREE i32 (i32.const 0x2A5))
  (global $METHOD_EXACT_EXPRESSION_COEFFICIENTS i32 (i32.const 0x2A6))
  (global $METHOD_EXACT_EXPRESSION_CONTENT i32 (i32.const 0x2A7))
  (global $METHOD_EXACT_EXPRESSION_PRIMITIVE_PART i32 (i32.const 0x2A8))
  (global $METHOD_EXACT_EXPRESSION_SOLVE_POLYNOMIAL i32 (i32.const 0x2A9))
  (global $METHOD_EXACT_EXPRESSION_SOLVE_SYSTEM i32 (i32.const 0x2AA))
  (global $METHOD_EXACT_EXPRESSION_SOLVE_INEQUALITY i32 (i32.const 0x2AB))
  (global $METHOD_EXACT_EXPRESSION_SIGN_CHART i32 (i32.const 0x2AC))
  (global $METHOD_EXACT_EXPRESSION_SATISFIES i32 (i32.const 0x2AD))

  (global $BUILTIN_KEY_UNIT i32 (i32.const 0x648))
  (global $BUILTIN_KEY_FACTORS i32 (i32.const 0x64C))
  (global $BUILTIN_KEY_KIND i32 (i32.const 0x650))
  (global $BUILTIN_KEY_SOLUTION i32 (i32.const 0x654))
  (global $BUILTIN_KEY_PARTICULAR i32 (i32.const 0x658))
  (global $BUILTIN_KEY_BASIS i32 (i32.const 0x65C))
  (global $BUILTIN_KEY_LOWER i32 (i32.const 0x660))
  (global $BUILTIN_KEY_LOWER_CLOSED i32 (i32.const 0x664))
  (global $BUILTIN_KEY_UPPER i32 (i32.const 0x668))
  (global $BUILTIN_KEY_UPPER_CLOSED i32 (i32.const 0x66C))
  (global $BUILTIN_KEY_SIGN i32 (i32.const 0x670))
  (global $BUILTIN_KEY_INTERVAL i32 (i32.const 0x674))
  (global $BUILTIN_KEY_ROOT i32 (i32.const 0x678))
  (global $BUILTIN_KEY_MULTIPLICITY i32 (i32.const 0x67C))
  (global $BUILTIN_LIT_SOLVE_UNIQUE i32 (i32.const 0x680))
  (global $BUILTIN_LIT_SOLVE_NONE i32 (i32.const 0x684))
  (global $BUILTIN_LIT_SOLVE_FAMILY i32 (i32.const 0x688))
  (global $BUILTIN_MSG_SOLVING_ARGUMENTS i32 (i32.const 0x68C))
  (global $BUILTIN_MSG_SOLVING_UNSUPPORTED i32 (i32.const 0x690))
  (global $BUILTIN_MSG_SOLVING_POSITIVE_DIMENSIONAL i32 (i32.const 0x694))

  ;; Parser outputs.
  (global $solving_parsed_degree (mut i32) (i32.const 0))
  (global $solving_parsed_coefficients (mut i32) (i32.const 0))
  ;; 1 when any parsed coefficient slot is an Expression (may contain
  ;; free symbols); such polynomials are not usable as closed univariate
  ;; equations.
  (global $solving_parsed_symbolic (mut i32) (i32.const 0))
  ;; Integer-normalization outputs.
  (global $solving_primitive_polynomial (mut i32) (i32.const 0))
  (global $solving_unit_numerator (mut i32) (i32.const 0))
  (global $solving_denominator (mut i32) (i32.const 0))

  ;; Parse a univariate polynomial in `variable`. Writes the simplified
  ;; coefficient value slots (ascending power) and the degree into the
  ;; parser globals. Status: 0 ok / 1 pressure / 2 bad arguments /
  ;; 3 not a polynomial or unsupported free symbols / 4 exact zero /
  ;; 5 polynomial with non-rational exact coefficients.
  (func $solving_parse_polynomial
    (param $expression_slot i32) (param $variable_slot i32) (result i32)
    (local $stage i32)
    (local $residual i32)
    (local $stage2 i32)
    (local $stage_slots i32)
    (local $degree64 i64)
    (local $degree i32)
    (local $list i32)
    (local $status i32)
    (local $i i32)
    (local $slot_type i32)
    (local $non_rational i32)
    (if (i32.ne (call $value_type (local.get $variable_slot)) (global.get $TYPE_SYMBOL))
      (then (return (i32.const 2))))
    (if (call $expression_walk_guard (i32.add
          (i32.mul (i32.const 2) (global.get $VALUE_SIZE)) (i32.const 32)))
      (then (return (i32.const 1))))
    (local.set $stage (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (local.set $residual (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (if (call $expression_simplify_into (local.get $expression_slot) (local.get $stage))
      (then (return (i32.const 1))))
    (if (call $expression_value_is_zero_wide (local.get $stage))
      (then
        (if (global.get $memory_pressure_signaled) (then (return (i32.const 1))))
        (return (i32.const 4))))
    (if (global.get $memory_pressure_signaled) (then (return (i32.const 1))))
    (drop (call $poly_measure_factors (local.get $stage)))
    (local.set $stage_slots (global.get $term_factors_count))
    (if (call $expression_walk_guard
          (i32.add (i32.mul (local.get $stage_slots) (i32.const 16)) (i32.const 16)))
      (then (return (i32.const 1))))
    (local.set $stage2 (call $carve_scratch_blob
      (i32.mul (local.get $stage_slots) (i32.const 16))))
    (local.set $degree64 (call $poly_degree_in
      (local.get $stage) (local.get $variable_slot)
      (local.get $stage2) (local.get $stage_slots) (local.get $residual)))
    (if (i64.eq (local.get $degree64) (i64.const -1))
      (then (return (i32.const 1))))
    (if (i64.lt_s (local.get $degree64) (i64.const 0))
      (then (return (i32.const 3))))
    (if (i64.gt_s (local.get $degree64) (i64.const 100000))
      (then (return (i32.const 3))))
    (local.set $degree (i32.wrap_i64 (local.get $degree64)))
    (if (call $expression_walk_guard
          (i32.mul (i32.add (local.get $degree) (i32.const 1)) (global.get $VALUE_SIZE)))
      (then (return (i32.const 1))))
    (local.set $list (call $carve_scratch_blob
      (i32.mul (i32.add (local.get $degree) (i32.const 1)) (global.get $VALUE_SIZE))))
    (local.set $status (call $poly_extract_coefficients
      (local.get $stage) (local.get $variable_slot) (local.get $degree)
      (local.get $list) (local.get $stage2) (local.get $stage_slots)
      (local.get $residual)))
    (if (i32.eq (local.get $status) (i32.const 1)) (then (return (i32.const 1))))
    (if (local.get $status) (then (return (i32.const 3))))
    ;; Coefficient universe check.
    (global.set $solving_parsed_symbolic (i32.const 0))
    (local.set $non_rational (i32.const 0))
    (local.set $i (i32.const 0))
    (block $checked
      (loop $check
        (br_if $checked (i32.gt_s (local.get $i) (local.get $degree)))
        (local.set $slot_type (call $value_type (i32.add (local.get $list)
          (i32.mul (local.get $i) (global.get $VALUE_SIZE)))))
        (if (i32.eqz (i32.or
              (i32.eq (local.get $slot_type) (global.get $TYPE_BIGINT))
              (i32.eq (local.get $slot_type) (global.get $TYPE_RATIONAL))))
          (then
            ;; An exact numeric non-rational coefficient is status 5; any
            ;; symbol-bearing coefficient is an unsupported free symbol.
            (if (i32.or
                  (i32.or
                    (i32.eq (local.get $slot_type) (global.get $TYPE_ALGEBRAIC))
                    (i32.eq (local.get $slot_type) (global.get $TYPE_COMPLEX)))
                  (i32.or
                    (i32.eq (local.get $slot_type) (global.get $TYPE_COMPLEX_ALGEBRAIC))
                    (i32.eq (local.get $slot_type) (global.get $TYPE_EXPRESSION))))
              (then
                (if (i32.eq (local.get $slot_type) (global.get $TYPE_EXPRESSION))
                  (then (global.set $solving_parsed_symbolic (i32.const 1))))
                (local.set $non_rational (i32.const 1)))
              (else (return (i32.const 3))))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $check)))
    (global.set $solving_parsed_degree (local.get $degree))
    (global.set $solving_parsed_coefficients (local.get $list))
    (if (local.get $non_rational) (then (return (i32.const 5))))
    (i32.const 0)
  )

  ;; Read the numerator/denominator bigint headers of a BIGINT or RATIONAL
  ;; coefficient slot (denominator 1 for BigInt). Numerator out in scratch
  ;; word 0, denominator in word 1.
  (func $solving_slot_fraction (param $slot i32) (param $out i32)
    (local $header i32)
    (if (i32.eq (call $value_type (local.get $slot)) (global.get $TYPE_BIGINT))
      (then
        (i32.store (call $abs (local.get $out)) (call $value_data_lo (local.get $slot)))
        (i32.store (call $abs (i32.add (local.get $out) (i32.const 4)))
          (call $bigint_one)))
      (else
        (local.set $header (call $rational_materialize (local.get $slot)))
        (i32.store (call $abs (local.get $out)) (call $rational_numerator (local.get $header)))
        (i32.store (call $abs (i32.add (local.get $out) (i32.const 4)))
          (call $rational_denominator (local.get $header)))))
  )

  ;; Clear denominators and strip content from the parsed coefficients:
  ;; f = (unit_numerator / denominator) * primitive, with primitive an
  ;; integer polynomial with coprime coefficients and a positive leading
  ;; coefficient; unit_numerator carries the sign. Status 0 / 1 pressure.
  (func $solving_normalize_integer (result i32)
    (local $degree i32)
    (local $list i32)
    (local $lcm i32)
    (local $fraction i32)
    (local $i i32)
    (local $numerator i32)
    (local $denominator i32)
    (local $gcd i32)
    (local $poly i32)
    (local $content i32)
    (local $leading i32)
    (local $negate i32)
    (local.set $degree (global.get $solving_parsed_degree))
    (local.set $list (global.get $solving_parsed_coefficients))
    (if (call $expression_walk_guard (i32.add (i32.const 256)
          (i32.mul (local.get $degree) (i32.const 16))))
      (then (return (i32.const 1))))
    (local.set $fraction (call $carve_scratch_blob (i32.const 8)))
    (local.set $lcm (call $bigint_one))
    (local.set $i (i32.const 0))
    (block $lcm_done
      (loop $lcm_fold
        (br_if $lcm_done (i32.gt_s (local.get $i) (local.get $degree)))
        (call $solving_slot_fraction
          (i32.add (local.get $list) (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
          (local.get $fraction))
        (local.set $denominator (i32.load (call $abs
          (i32.add (local.get $fraction) (i32.const 4)))))
        (local.set $gcd (call $algebraic_bigint_gcd_guarded
          (local.get $lcm) (local.get $denominator)))
        (if (i32.eqz (local.get $gcd)) (then (return (i32.const 1))))
        (local.set $lcm (call $bigint_mul (local.get $lcm)
          (call $bigint_div (local.get $denominator) (local.get $gcd))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $lcm_fold)))
    (local.set $poly (call $algebraic_poly_carve (local.get $degree)))
    (if (i32.eqz (local.get $poly)) (then (return (i32.const 1))))
    (local.set $i (i32.const 0))
    (block $fill_done
      (loop $fill
        (br_if $fill_done (i32.gt_s (local.get $i) (local.get $degree)))
        (call $solving_slot_fraction
          (i32.add (local.get $list) (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
          (local.get $fraction))
        (local.set $numerator (i32.load (call $abs (local.get $fraction))))
        (local.set $denominator (i32.load (call $abs
          (i32.add (local.get $fraction) (i32.const 4)))))
        (call $algebraic_poly_set_coefficient (local.get $poly) (local.get $i)
          (call $bigint_mul (local.get $numerator)
            (call $bigint_div (local.get $lcm) (local.get $denominator))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $fill)))
    (local.set $content (call $algebraic_poly_content (local.get $poly)))
    (if (i32.eqz (local.get $content)) (then (return (i32.const 1))))
    (local.set $leading (call $algebraic_poly_coefficient
      (local.get $poly) (local.get $degree)))
    (local.set $negate (i32.ne (call $bigint_sign (local.get $leading)) (i32.const 0)))
    (local.set $poly (call $algebraic_poly_scale_down
      (local.get $poly) (local.get $content) (local.get $negate)))
    (if (i32.eqz (local.get $poly)) (then (return (i32.const 1))))
    (if (local.get $negate)
      (then (local.set $content (call $bigint_sub (call $bigint_zero) (local.get $content)))))
    (global.set $solving_primitive_polynomial (local.get $poly))
    (global.set $solving_unit_numerator (local.get $content))
    (global.set $solving_denominator (local.get $lcm))
    (i32.const 0)
  )

  ;; Yun's squarefree decomposition of a primitive positive-leading
  ;; integer polynomial. Writes up to `max` (polynomial pointer,
  ;; multiplicity) pairs into the two parallel 4-byte-entry buffers.
  ;; Returns the count, or -1 on pressure.
  (func $solving_squarefree_decomposition
    (param $polynomial i32) (param $polynomials_out i32) (param $multiplicities_out i32)
    (param $max i32) (result i32)
    (local $count i32)
    (local $derivative i32)
    (local $gcd i32)
    (local $w i32)
    (local $y i32)
    (local $z i32)
    (local $step i32)
    (local $k i32)
    (if (i32.le_s (call $algebraic_poly_degree (local.get $polynomial)) (i32.const 0))
      (then (return (i32.const 0))))
    (local.set $derivative (call $algebraic_poly_derivative (local.get $polynomial)))
    (if (i32.eqz (local.get $derivative)) (then (return (i32.const -1))))
    (local.set $gcd (call $algebraic_poly_gcd (local.get $polynomial) (local.get $derivative)))
    (if (i32.eqz (local.get $gcd)) (then (return (i32.const -1))))
    (if (i32.eqz (call $algebraic_poly_degree (local.get $gcd)))
      (then
        (i32.store (call $abs (local.get $polynomials_out)) (local.get $polynomial))
        (i32.store (call $abs (local.get $multiplicities_out)) (i32.const 1))
        (return (i32.const 1))))
    (local.set $w (call $algebraic_poly_exact_divide (local.get $polynomial) (local.get $gcd)))
    (if (i32.eqz (local.get $w)) (then (return (i32.const -1))))
    (local.set $y (call $algebraic_poly_exact_divide (local.get $derivative) (local.get $gcd)))
    (if (i32.eqz (local.get $y)) (then (return (i32.const -1))))
    (local.set $count (i32.const 0))
    (local.set $k (i32.const 1))
    (block $decomposed
      (loop $yun
        (if (call $expression_walk_guard (i32.const 4096))
          (then (return (i32.const -1))))
        (local.set $derivative (call $algebraic_poly_derivative (local.get $w)))
        (if (i32.eqz (local.get $derivative)) (then (return (i32.const -1))))
        (local.set $z (call $algebraic_poly_sub_poly (local.get $y) (local.get $derivative)))
        (if (i32.eqz (local.get $z)) (then (return (i32.const -1))))
        (call $algebraic_poly_trim (local.get $z))
        (if (i32.lt_s (call $algebraic_poly_degree (local.get $z)) (i32.const 0))
          (then
            ;; z == 0: w is the final factor with multiplicity k.
            (if (i32.gt_s (call $algebraic_poly_degree (local.get $w)) (i32.const 0))
              (then
                (if (i32.ge_s (local.get $count) (local.get $max))
                  (then (return (i32.const -1))))
                (i32.store (call $abs (i32.add (local.get $polynomials_out)
                  (i32.mul (local.get $count) (i32.const 4)))) (local.get $w))
                (i32.store (call $abs (i32.add (local.get $multiplicities_out)
                  (i32.mul (local.get $count) (i32.const 4)))) (local.get $k))
                (local.set $count (i32.add (local.get $count) (i32.const 1)))))
            (br $decomposed)))
        (local.set $step (call $algebraic_poly_gcd (local.get $w) (local.get $z)))
        (if (i32.eqz (local.get $step)) (then (return (i32.const -1))))
        (if (i32.gt_s (call $algebraic_poly_degree (local.get $step)) (i32.const 0))
          (then
            (if (i32.ge_s (local.get $count) (local.get $max))
              (then (return (i32.const -1))))
            (i32.store (call $abs (i32.add (local.get $polynomials_out)
              (i32.mul (local.get $count) (i32.const 4)))) (local.get $step))
            (i32.store (call $abs (i32.add (local.get $multiplicities_out)
              (i32.mul (local.get $count) (i32.const 4)))) (local.get $k))
            (local.set $count (i32.add (local.get $count) (i32.const 1)))))
        (local.set $w (call $algebraic_poly_exact_divide (local.get $w) (local.get $step)))
        (if (i32.eqz (local.get $w)) (then (return (i32.const -1))))
        (local.set $y (call $algebraic_poly_exact_divide (local.get $z) (local.get $step)))
        (if (i32.eqz (local.get $y)) (then (return (i32.const -1))))
        (local.set $k (i32.add (local.get $k) (i32.const 1)))
        (br $yun)))
    (local.get $count)
  )

  ;; Factor one primitive squarefree integer polynomial into irreducible
  ;; primitive positive-leading factors. Returns the count, -1 on
  ;; pressure, -2 on a loud engine failure.
  (func $solving_factor_squarefree
    (param $polynomial i32) (param $factors_out i32) (param $max i32) (result i32)
    (local $degree i32)
    (local $count i32)
    (local $i i32)
    (local $factor i32)
    (local.set $degree (call $algebraic_poly_degree (local.get $polynomial)))
    (if (i32.le_s (local.get $degree) (i32.const 0)) (then (return (i32.const 0))))
    (if (i32.eq (local.get $degree) (i32.const 1))
      (then
        (i32.store (call $abs (local.get $factors_out)) (local.get $polynomial))
        (return (i32.const 1))))
    (local.set $count (call $algebraic_zz_zassenhaus
      (local.get $polynomial) (local.get $factors_out) (local.get $max)))
    (if (i32.eq (local.get $count) (i32.const -1)) (then (return (i32.const -1))))
    (if (i32.lt_s (local.get $count) (i32.const 0)) (then (return (i32.const -2))))
    ;; Normalize every factor to a positive leading coefficient.
    (local.set $i (i32.const 0))
    (block $normalized
      (loop $normalize
        (br_if $normalized (i32.ge_s (local.get $i) (local.get $count)))
        (local.set $factor (i32.load (call $abs (i32.add (local.get $factors_out)
          (i32.mul (local.get $i) (i32.const 4))))))
        (if (i32.ne (call $bigint_sign (call $algebraic_poly_coefficient
              (local.get $factor)
              (call $algebraic_poly_degree (local.get $factor))))
              (i32.const 0))
          (then
            (local.set $factor (call $algebraic_poly_scale_down
              (local.get $factor) (call $bigint_one) (i32.const 1)))
            (if (i32.eqz (local.get $factor)) (then (return (i32.const -1))))
            (i32.store (call $abs (i32.add (local.get $factors_out)
              (i32.mul (local.get $i) (i32.const 4)))) (local.get $factor))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $normalize)))
    (local.get $count)
  )

  ;; Canonical order: ascending degree, then descending-index coefficient
  ;; comparison. Returns -1/0/1.
  (func $solving_polynomial_order (param $a i32) (param $b i32) (result i32)
    (local $degree_a i32)
    (local $degree_b i32)
    (local $i i32)
    (local $comparison i32)
    (local.set $degree_a (call $algebraic_poly_degree (local.get $a)))
    (local.set $degree_b (call $algebraic_poly_degree (local.get $b)))
    (if (i32.lt_s (local.get $degree_a) (local.get $degree_b))
      (then (return (i32.const -1))))
    (if (i32.gt_s (local.get $degree_a) (local.get $degree_b))
      (then (return (i32.const 1))))
    (local.set $i (local.get $degree_a))
    (block $compared
      (loop $compare
        (br_if $compared (i32.lt_s (local.get $i) (i32.const 0)))
        (local.set $comparison (call $bigint_compare
          (call $algebraic_poly_coefficient (local.get $a) (local.get $i))
          (call $algebraic_poly_coefficient (local.get $b) (local.get $i))))
        (if (local.get $comparison) (then (return (local.get $comparison))))
        (local.set $i (i32.sub (local.get $i) (i32.const 1)))
        (br $compare)))
    (i32.const 0)
  )

  ;; Convert a bigint-coefficient polynomial into a canonical simplified
  ;; expression in `variable`. Status 0 / 1 pressure.
  (func $solving_polynomial_to_expression
    (param $polynomial i32) (param $variable_slot i32) (param $destination_slot i32)
    (result i32)
    (local $degree i32)
    (local $i i32)
    (local $coefficient i32)
    (local $work i32)
    (local $term_slot i32)
    (local $scratch_slot i32)
    (local $have_accumulator i32)
    (if (call $expression_walk_guard (i32.const 2048))
      (then (return (i32.const 1))))
    (local.set $degree (call $algebraic_poly_degree (local.get $polynomial)))
    (local.set $work (call $carve_scratch_blob (i32.const 48)))
    (local.set $term_slot (i32.add (local.get $work) (i32.const 16)))
    (local.set $scratch_slot (i32.add (local.get $work) (i32.const 32)))
    (local.set $have_accumulator (i32.const 0))
    (local.set $i (local.get $degree))
    (block $built
      (loop $build
        (br_if $built (i32.lt_s (local.get $i) (i32.const 0)))
        (local.set $coefficient (call $algebraic_poly_coefficient
          (local.get $polynomial) (local.get $i)))
        (if (i32.ne (call $bigint_length (local.get $coefficient)) (i32.const 0))
          (then
            (if (call $expression_walk_guard (i32.const 1024))
              (then (return (i32.const 1))))
            (call $write_value (local.get $term_slot)
              (global.get $TYPE_BIGINT) (i32.const 0)
              (local.get $coefficient) (i32.const 0))
            (if (local.get $i)
              (then
                (call $write_inline_rational (local.get $scratch_slot)
                  (i64.extend_i32_s (local.get $i)))
                (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_POWER)
                  (local.get $variable_slot) (local.get $scratch_slot)
                  (local.get $scratch_slot))
                (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
                  (local.get $term_slot) (local.get $scratch_slot) (local.get $term_slot))))
            (if (local.get $have_accumulator)
              (then (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_ADD)
                (local.get $work) (local.get $term_slot) (local.get $work)))
              (else
                (memory.copy (call $abs (local.get $work))
                  (call $abs (local.get $term_slot)) (global.get $VALUE_SIZE))
                (local.set $have_accumulator (i32.const 1))))))
        (local.set $i (i32.sub (local.get $i) (i32.const 1)))
        (br $build)))
    (if (i32.eqz (local.get $have_accumulator))
      (then (call $write_inline_rational (local.get $work) (i64.const 0))))
    (call $expression_simplify_into (local.get $work) (local.get $destination_slot))
  )

  ;; The leading coefficient of the parsed polynomial as a Rational header.
  (func $solving_leading_rational (result i32)
    (local $slot i32)
    (local.set $slot (i32.add (global.get $solving_parsed_coefficients)
      (i32.mul (global.get $solving_parsed_degree) (global.get $VALUE_SIZE))))
    (if (i32.eq (call $value_type (local.get $slot)) (global.get $TYPE_BIGINT))
      (then (return (call $rational_from_bigint (call $value_data_lo (local.get $slot))))))
    (call $rational_materialize (local.get $slot))
  )

  ;; Run the full rational factorization: parse output must already be in
  ;; the parser globals. Writes sorted (polynomial, multiplicity) pairs and
  ;; the exact rational unit header. Returns the factor count, -1 pressure,
  ;; -2 loud engine failure.
  (func $solving_factorization
    (param $polynomials_out i32) (param $multiplicities_out i32) (param $max i32)
    (param $unit_out i32)
    (result i32)
    (local $squarefree_polynomials i32)
    (local $squarefree_multiplicities i32)
    (local $squarefree_count i32)
    (local $factor_buffer i32)
    (local $count i32)
    (local $i i32)
    (local $j i32)
    (local $piece_count i32)
    (local $multiplicity i32)
    (local $swap_polynomial i32)
    (local $swap_multiplicity i32)
    (local $product i32)
    (local $factor i32)
    (local $status i32)
    (if (call $expression_walk_guard (i32.const 4096))
      (then (return (i32.const -1))))
    (local.set $status (call $solving_normalize_integer))
    (if (local.get $status) (then (return (i32.const -1))))
    (local.set $squarefree_polynomials (call $carve_scratch_blob (i32.const 256)))
    (local.set $squarefree_multiplicities (call $carve_scratch_blob (i32.const 256)))
    (local.set $factor_buffer (call $carve_scratch_blob (i32.const 256)))
    (local.set $squarefree_count (call $solving_squarefree_decomposition
      (global.get $solving_primitive_polynomial)
      (local.get $squarefree_polynomials) (local.get $squarefree_multiplicities)
      (i32.const 64)))
    (if (i32.lt_s (local.get $squarefree_count) (i32.const 0))
      (then (return (i32.const -1))))
    (local.set $count (i32.const 0))
    (local.set $i (i32.const 0))
    (block $factored
      (loop $factor_pieces
        (br_if $factored (i32.ge_s (local.get $i) (local.get $squarefree_count)))
        (local.set $multiplicity (i32.load (call $abs
          (i32.add (local.get $squarefree_multiplicities)
            (i32.mul (local.get $i) (i32.const 4))))))
        (local.set $piece_count (call $solving_factor_squarefree
          (i32.load (call $abs (i32.add (local.get $squarefree_polynomials)
            (i32.mul (local.get $i) (i32.const 4)))))
          (local.get $factor_buffer) (i32.const 64)))
        (if (i32.lt_s (local.get $piece_count) (i32.const 0))
          (then (return (local.get $piece_count))))
        (local.set $j (i32.const 0))
        (block $collected
          (loop $collect
            (br_if $collected (i32.ge_s (local.get $j) (local.get $piece_count)))
            (if (i32.ge_s (local.get $count) (local.get $max))
              (then (return (i32.const -2))))
            (i32.store (call $abs (i32.add (local.get $polynomials_out)
              (i32.mul (local.get $count) (i32.const 4))))
              (i32.load (call $abs (i32.add (local.get $factor_buffer)
                (i32.mul (local.get $j) (i32.const 4))))))
            (i32.store (call $abs (i32.add (local.get $multiplicities_out)
              (i32.mul (local.get $count) (i32.const 4))))
              (local.get $multiplicity))
            (local.set $count (i32.add (local.get $count) (i32.const 1)))
            (local.set $j (i32.add (local.get $j) (i32.const 1)))
            (br $collect)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $factor_pieces)))
    ;; Canonical order (insertion sort; the counts are small).
    (local.set $i (i32.const 1))
    (block $sorted
      (loop $sort
        (br_if $sorted (i32.ge_s (local.get $i) (local.get $count)))
        (local.set $j (local.get $i))
        (block $inserted
          (loop $insert
            (br_if $inserted (i32.le_s (local.get $j) (i32.const 0)))
            (if (i32.le_s (call $solving_polynomial_order
                  (i32.load (call $abs (i32.add (local.get $polynomials_out)
                    (i32.mul (i32.sub (local.get $j) (i32.const 1)) (i32.const 4)))))
                  (i32.load (call $abs (i32.add (local.get $polynomials_out)
                    (i32.mul (local.get $j) (i32.const 4))))))
                  (i32.const 0))
              (then (br $inserted)))
            (local.set $swap_polynomial (i32.load (call $abs
              (i32.add (local.get $polynomials_out) (i32.mul (local.get $j) (i32.const 4))))))
            (local.set $swap_multiplicity (i32.load (call $abs
              (i32.add (local.get $multiplicities_out) (i32.mul (local.get $j) (i32.const 4))))))
            (i32.store (call $abs (i32.add (local.get $polynomials_out)
              (i32.mul (local.get $j) (i32.const 4))))
              (i32.load (call $abs (i32.add (local.get $polynomials_out)
                (i32.mul (i32.sub (local.get $j) (i32.const 1)) (i32.const 4))))))
            (i32.store (call $abs (i32.add (local.get $multiplicities_out)
              (i32.mul (local.get $j) (i32.const 4))))
              (i32.load (call $abs (i32.add (local.get $multiplicities_out)
                (i32.mul (i32.sub (local.get $j) (i32.const 1)) (i32.const 4))))))
            (i32.store (call $abs (i32.add (local.get $polynomials_out)
              (i32.mul (i32.sub (local.get $j) (i32.const 1)) (i32.const 4))))
              (local.get $swap_polynomial))
            (i32.store (call $abs (i32.add (local.get $multiplicities_out)
              (i32.mul (i32.sub (local.get $j) (i32.const 1)) (i32.const 4))))
              (local.get $swap_multiplicity))
            (local.set $j (i32.sub (local.get $j) (i32.const 1)))
            (br $insert)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $sort)))
    ;; unit = leading(f) / product of factor leading coefficients^multiplicity.
    (local.set $product (call $bigint_one))
    (local.set $i (i32.const 0))
    (block $unit_done
      (loop $unit_fold
        (br_if $unit_done (i32.ge_s (local.get $i) (local.get $count)))
        (local.set $factor (i32.load (call $abs (i32.add (local.get $polynomials_out)
          (i32.mul (local.get $i) (i32.const 4))))))
        (local.set $product (call $bigint_mul (local.get $product)
          (call $bigint_pow
            (call $algebraic_poly_coefficient (local.get $factor)
              (call $algebraic_poly_degree (local.get $factor)))
            (call $bigint_from_i64 (i64.extend_i32_s (i32.load (call $abs
              (i32.add (local.get $multiplicities_out)
                (i32.mul (local.get $i) (i32.const 4))))))))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $unit_fold)))
    (i32.store (call $abs (local.get $unit_out))
      (call $rational_div (call $solving_leading_rational)
        (call $rational_from_bigint (local.get $product))))
    (local.get $count)
  )

  ;; Shared prologue for the two-argument (expression, variable) solving
  ;; methods: reads the argument slots and validates the count. Returns 1
  ;; when validation passed, 0 after arranging the throw.
  ;; (Argument slots via globals.)
  (global $solving_argument1 (mut i32) (i32.const 0))
  (global $solving_argument2 (mut i32) (i32.const 0))
  (func $solving_two_arguments
    (param $argc i32) (param $stack_base i32) (result i32)
    (local $pending_pointer i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (global.set $solving_argument1 (i32.sub (local.get $pending_pointer)
      (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
    (global.set $solving_argument2
      (i32.add (global.get $solving_argument1) (global.get $VALUE_SIZE)))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (i32.eq (local.get $argc) (i32.const 2))
  )

  ;; Map a parse status onto the dispatch result (throwing). Only call for
  ;; nonzero statuses.
  (func $solving_parse_reject (param $status i32) (result i32)
    (if (i32.eq (local.get $status) (i32.const 1)) (then (return (i32.const 0))))
    (if (i32.eq (local.get $status) (i32.const 2))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_SOLVING_ARGUMENTS))))))
    (return (i32.add (i32.const 1)
      (call $throw_type_error_with_message (global.get $BUILTIN_MSG_SOLVING_UNSUPPORTED))))
  )

  ;; factor(expression, variable) -> { unit, factors }.
  (func $expression_factor_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $status i32)
    (local $polynomials i32)
    (local $multiplicities i32)
    (local $unit_out i32)
    (local $count i32)
    (local $i i32)
    (local $work i32)
    (local $factors_array i32)
    (local $factors_data i32)
    (local $pair_array i32)
    (local $pair_data i32)
    (local $pairs i32)
    (local $record i32)
    (if (i32.eqz (call $solving_two_arguments (local.get $argc) (local.get $stack_base)))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_SOLVING_ARGUMENTS))))))
    (local.set $status (call $solving_parse_polynomial
      (global.get $solving_argument1) (global.get $solving_argument2)))
    (if (local.get $status)
      (then (return (call $solving_parse_reject (local.get $status)))))
    (if (call $expression_walk_guard (i32.const 8192))
      (then (return (i32.const 0))))
    (local.set $polynomials (call $carve_scratch_blob (i32.const 512)))
    (local.set $multiplicities (call $carve_scratch_blob (i32.const 512)))
    (local.set $unit_out (call $carve_scratch_blob (i32.const 4)))
    (local.set $work (call $carve_scratch_blob (i32.const 48)))
    (if (global.get $solving_parsed_degree)
      (then
        (local.set $count (call $solving_factorization
          (local.get $polynomials) (local.get $multiplicities) (i32.const 128)
          (local.get $unit_out)))
        (if (i32.eq (local.get $count) (i32.const -1)) (then (return (i32.const 0))))
        (if (i32.lt_s (local.get $count) (i32.const 0))
          (then (return (i32.add (i32.const 1)
            (call $throw_range_error_with_message
              (global.get $BUILTIN_MSG_SOLVING_UNSUPPORTED)))))))
      (else
        ;; Constant polynomial: the unit is the value itself.
        (local.set $count (i32.const 0))
        (i32.store (call $abs (local.get $unit_out)) (call $solving_leading_rational))))
    ;; factors: frozen Array of frozen [expression, multiplicity] pairs.
    (local.set $factors_array (call $allocate_array (local.get $count)))
    (local.set $factors_data (i32.add
      (i32.load (call $abs (i32.add (local.get $factors_array) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (local.set $i (i32.const 0))
    (block $emitted
      (loop $emit
        (br_if $emitted (i32.ge_s (local.get $i) (local.get $count)))
        (if (call $expression_walk_guard (i32.const 2048))
          (then (return (i32.const 0))))
        (local.set $pair_array (call $allocate_array (i32.const 2)))
        (local.set $pair_data (i32.add
          (i32.load (call $abs (i32.add (local.get $pair_array) (i32.const 16))))
          (global.get $GC_HEADER_SIZE)))
        (if (call $solving_polynomial_to_expression
              (i32.load (call $abs (i32.add (local.get $polynomials)
                (i32.mul (local.get $i) (i32.const 4)))))
              (global.get $solving_argument2)
              (local.get $pair_data))
          (then (return (i32.const 0))))
        (call $write_value (i32.add (local.get $pair_data) (global.get $VALUE_SIZE))
          (global.get $TYPE_BIGINT) (i32.const 0)
          (call $bigint_from_i64 (i64.extend_i32_s (i32.load (call $abs
            (i32.add (local.get $multiplicities) (i32.mul (local.get $i) (i32.const 4)))))))
          (i32.const 0))
        (call $expression_freeze_args_array (local.get $pair_array))
        (call $write_value (i32.add (local.get $factors_data)
          (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
          (global.get $TYPE_ARRAY) (i32.const 0) (local.get $pair_array) (i32.const 0))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $emit)))
    (call $expression_freeze_args_array (local.get $factors_array))
    (call $write_value (local.get $work)
      (global.get $TYPE_RATIONAL) (i32.const 0)
      (i32.load (call $abs (local.get $unit_out))) (i32.const 0))
    (call $write_value (i32.add (local.get $work) (i32.const 16))
      (global.get $TYPE_ARRAY) (i32.const 0) (local.get $factors_array) (i32.const 0))
    (local.set $pairs (call $carve_scratch_blob (i32.const 16)))
    (i32.store (call $abs (local.get $pairs)) (global.get $BUILTIN_KEY_UNIT))
    (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 4))) (local.get $work))
    (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 8)))
      (global.get $BUILTIN_KEY_FACTORS))
    (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 12)))
      (i32.add (local.get $work) (i32.const 16)))
    (local.set $record (call $calculus_record (local.get $pairs) (i32.const 2)))
    (if (i32.eqz (local.get $record)) (then (return (i32.const 0))))
    (call $pending_push (global.get $TYPE_OBJECT) (i32.const 0)
      (local.get $record) (i32.const 0))
    (i32.const 0)
  )

  ;; expandFactorization(record) -> the canonical expanded polynomial.
  (func $expression_expand_factorization_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument_slot i32)
    (local $object_pointer i32)
    (local $unit_entry i32)
    (local $factors_entry i32)
    (local $factors_array i32)
    (local $factors_data i32)
    (local $length i32)
    (local $i i32)
    (local $work i32)
    (local $pair_slot i32)
    (local $pair_array i32)
    (local $pair_data i32)
    (local $walk_status i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then (local.set $argument_slot (i32.sub (local.get $pending_pointer)
        (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (i32.or
          (i32.ne (local.get $argc) (i32.const 1))
          (i32.ne (call $value_type (local.get $argument_slot)) (global.get $TYPE_OBJECT)))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_SOLVING_ARGUMENTS))))))
    (local.set $object_pointer (call $value_data_lo (local.get $argument_slot)))
    (local.set $unit_entry (call $object_find_string_entry
      (local.get $object_pointer) (call $read_builtin (global.get $BUILTIN_KEY_UNIT))))
    (local.set $factors_entry (call $object_find_string_entry
      (local.get $object_pointer) (call $read_builtin (global.get $BUILTIN_KEY_FACTORS))))
    (if (i32.or
          (i32.eqz (local.get $unit_entry))
          (i32.or
            (i32.eqz (local.get $factors_entry))
            (i32.ne (call $value_type (i32.add (local.get $factors_entry) (i32.const 4)))
              (global.get $TYPE_ARRAY))))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_SOLVING_ARGUMENTS))))))
    (if (call $expression_walk_guard (i32.const 4096))
      (then (return (i32.const 0))))
    (local.set $work (call $carve_scratch_blob (i32.const 32)))
    (memory.copy (call $abs (local.get $work))
      (call $abs (i32.add (local.get $unit_entry) (i32.const 4)))
      (global.get $VALUE_SIZE))
    (local.set $factors_array (call $value_data_lo
      (i32.add (local.get $factors_entry) (i32.const 4))))
    (local.set $length (i32.load (call $abs
      (i32.add (local.get $factors_array) (i32.const 8)))))
    (local.set $factors_data (i32.add
      (i32.load (call $abs (i32.add (local.get $factors_array) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (local.set $i (i32.const 0))
    (block $product_done
      (loop $product
        (br_if $product_done (i32.ge_u (local.get $i) (local.get $length)))
        (local.set $pair_slot (i32.add (local.get $factors_data)
          (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
        (if (i32.ne (call $value_type (local.get $pair_slot)) (global.get $TYPE_ARRAY))
          (then (return (i32.add (i32.const 1)
            (call $throw_type_error_with_message
              (global.get $BUILTIN_MSG_SOLVING_ARGUMENTS))))))
        (local.set $pair_array (call $value_data_lo (local.get $pair_slot)))
        (if (i32.ne (i32.load (call $abs (i32.add (local.get $pair_array) (i32.const 8))))
              (i32.const 2))
          (then (return (i32.add (i32.const 1)
            (call $throw_type_error_with_message
              (global.get $BUILTIN_MSG_SOLVING_ARGUMENTS))))))
        (local.set $pair_data (i32.add
          (i32.load (call $abs (i32.add (local.get $pair_array) (i32.const 16))))
          (global.get $GC_HEADER_SIZE)))
        (if (call $expression_walk_guard (i32.const 1024))
          (then (return (i32.const 0))))
        (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_POWER)
          (local.get $pair_data)
          (i32.add (local.get $pair_data) (global.get $VALUE_SIZE))
          (i32.add (local.get $work) (i32.const 16)))
        (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
          (local.get $work) (i32.add (local.get $work) (i32.const 16)) (local.get $work))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $product)))
    ;; Full expansion back to the canonical polynomial.
    (global.set $expansion_cap_disabled (i32.const 1))
    (local.set $walk_status (call $expression_simplify_into
      (local.get $work)
      (call $read_ctx (global.get $CTX_PENDING_POINTER))))
    (global.set $expansion_cap_disabled (i32.const 0))
    (if (local.get $walk_status) (then (return (i32.const 0))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER)
      (i32.add (call $read_ctx (global.get $CTX_PENDING_POINTER)) (global.get $VALUE_SIZE)))
    (i32.const 0)
  )

  ;; degree(expression, variable) -> BigInt.
  (func $expression_degree_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $status i32)
    (if (i32.eqz (call $solving_two_arguments (local.get $argc) (local.get $stack_base)))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_SOLVING_ARGUMENTS))))))
    (local.set $status (call $solving_parse_polynomial
      (global.get $solving_argument1) (global.get $solving_argument2)))
    (if (local.get $status)
      (then (return (call $solving_parse_reject (local.get $status)))))
    (call $pending_push (global.get $TYPE_BIGINT) (i32.const 0)
      (call $bigint_from_i64 (i64.extend_i32_s (global.get $solving_parsed_degree)))
      (i32.const 0))
    (i32.const 0)
  )

  ;; coefficients(expression, variable) -> frozen Array, ascending power.
  (func $expression_coefficients_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $status i32)
    (local $result_array i32)
    (local $result_data i32)
    (local $count i32)
    (if (i32.eqz (call $solving_two_arguments (local.get $argc) (local.get $stack_base)))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_SOLVING_ARGUMENTS))))))
    (local.set $status (call $solving_parse_polynomial
      (global.get $solving_argument1) (global.get $solving_argument2)))
    (if (local.get $status)
      (then (return (call $solving_parse_reject (local.get $status)))))
    (local.set $count (i32.add (global.get $solving_parsed_degree) (i32.const 1)))
    (if (call $expression_walk_guard (call $estimate_array_size (local.get $count)))
      (then (return (i32.const 0))))
    (local.set $result_array (call $allocate_array (local.get $count)))
    (local.set $result_data (i32.add
      (i32.load (call $abs (i32.add (local.get $result_array) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (memory.copy (call $abs (local.get $result_data))
      (call $abs (global.get $solving_parsed_coefficients))
      (i32.mul (local.get $count) (global.get $VALUE_SIZE)))
    (call $expression_freeze_args_array (local.get $result_array))
    (call $pending_push (global.get $TYPE_ARRAY) (i32.const 0)
      (local.get $result_array) (i32.const 0))
    (i32.const 0)
  )

  ;; content(expression, variable) -> exact Rational; content * primitivePart
  ;; reconstructs the input.
  (func $expression_content_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $status i32)
    (if (i32.eqz (call $solving_two_arguments (local.get $argc) (local.get $stack_base)))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_SOLVING_ARGUMENTS))))))
    (local.set $status (call $solving_parse_polynomial
      (global.get $solving_argument1) (global.get $solving_argument2)))
    (if (local.get $status)
      (then (return (call $solving_parse_reject (local.get $status)))))
    (local.set $status (call $solving_normalize_integer))
    (if (local.get $status) (then (return (i32.const 0))))
    (call $pending_push (global.get $TYPE_RATIONAL) (i32.const 0)
      (call $rational_new (global.get $solving_unit_numerator)
        (global.get $solving_denominator))
      (i32.const 0))
    (i32.const 0)
  )

  ;; primitivePart(expression, variable) -> canonical expression with
  ;; coprime integer coefficients and a positive leading coefficient.
  (func $expression_primitive_part_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $status i32)
    (local $destination i32)
    (if (i32.eqz (call $solving_two_arguments (local.get $argc) (local.get $stack_base)))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_SOLVING_ARGUMENTS))))))
    (local.set $status (call $solving_parse_polynomial
      (global.get $solving_argument1) (global.get $solving_argument2)))
    (if (local.get $status)
      (then (return (call $solving_parse_reject (local.get $status)))))
    (local.set $status (call $solving_normalize_integer))
    (if (local.get $status) (then (return (i32.const 0))))
    (local.set $destination (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (call $solving_polynomial_to_expression
          (global.get $solving_primitive_polynomial)
          (global.get $solving_argument2)
          (local.get $destination))
      (then (return (i32.const 0))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER)
      (i32.add (local.get $destination) (global.get $VALUE_SIZE)))
    (i32.const 0)
  )

  ;; Staged internal call to the complex-roots engine:
  ;; rootsOfPolynomial(expression, variable) -> Array of exact roots at
  ;; `result_slot`. Status 0 ok / 1 pressure-or-thrown (dispatch result is
  ;; stored in $solving_staged_dispatch for thrown propagation).
  (global $solving_staged_dispatch (mut i32) (i32.const 0))
  (func $solving_complex_roots
    (param $expression_slot i32) (param $variable_slot i32) (param $result_slot i32)
    (result i32)
    (local $saved_pending i32)
    (local $status i32)
    (if (call $expression_walk_guard (i32.const 64))
      (then (return (i32.const 1))))
    (local.set $saved_pending (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (memory.copy (call $abs (local.get $result_slot))
      (call $abs (local.get $expression_slot)) (global.get $VALUE_SIZE))
    (memory.copy (call $abs (i32.add (local.get $result_slot) (global.get $VALUE_SIZE)))
      (call $abs (local.get $variable_slot)) (global.get $VALUE_SIZE))
    (call $write_ctx (global.get $CTX_PENDING_POINTER)
      (i32.add (local.get $result_slot) (i32.mul (i32.const 2) (global.get $VALUE_SIZE))))
    (local.set $status (call $complex_algebraic_method
      (global.get $TYPE_OBJECT) (i32.const 0)
      (global.get $METHOD_EXACT_COMPLEX_ALGEBRAIC_ROOTS_OF_POLYNOMIAL)
      (i32.const 2) (local.get $result_slot)))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $saved_pending))
    (global.set $solving_staged_dispatch (local.get $status))
    (if (local.get $status) (then (return (i32.const 1))))
    (if (global.get $memory_pressure_signaled) (then (return (i32.const 1))))
    (i32.const 0)
  )

  ;; Is a simplified exact value exactly zero (real or complex)?
  ;; 0 no / 1 yes / 2 pressure / 3 undecidable.
  (func $solving_value_is_zero (param $slot i32) (result i32)
    (local $type i32)
    (local $header i32)
    (local.set $type (call $value_type (local.get $slot)))
    (if (i32.or
          (i32.or
            (i32.eq (local.get $type) (global.get $TYPE_BIGINT))
            (i32.eq (local.get $type) (global.get $TYPE_RATIONAL)))
          (i32.eq (local.get $type) (global.get $TYPE_ALGEBRAIC)))
      (then (return (call $approximation_slot_is_exact_zero (local.get $slot)))))
    (if (i32.eq (local.get $type) (global.get $TYPE_COMPLEX))
      (then
        (local.set $header (call $value_data_lo (local.get $slot)))
        (return (i32.and
          (i32.eqz (call $bigint_length
            (call $rational_numerator (call $complex_real (local.get $header)))))
          (i32.eqz (call $bigint_length
            (call $rational_numerator (call $complex_imaginary (local.get $header)))))))))
    ;; A ComplexAlgebraicNumber is non-real by invariant, so never zero.
    (if (i32.eq (local.get $type) (global.get $TYPE_COMPLEX_ALGEBRAIC))
      (then (return (i32.const 0))))
    (i32.const 3)
  )

  ;; solvePolynomial(expression, variable) -> frozen Array of frozen
  ;; { root, multiplicity } records.
  (func $expression_solve_polynomial_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $status i32)
    (local $rational_coefficients i32)
    (local $polynomials i32)
    (local $multiplicities i32)
    (local $unit_out i32)
    (local $factor_count i32)
    (local $work i32)
    (local $factor_slot i32)
    (local $roots_slot i32)
    (local $record_pairs i32)
    (local $result_records i32)
    (local $result_count i32)
    (local $i i32)
    (local $j i32)
    (local $roots_array i32)
    (local $roots_length i32)
    (local $roots_data i32)
    (local $multiplicity i32)
    (local $record i32)
    (local $result_array i32)
    (local $result_data i32)
    (local $current_slot i32)
    (local $derivative_slot i32)
    (local $value_slot i32)
    (local $zero_status i32)
    (local $degree i32)
    (if (i32.eqz (call $solving_two_arguments (local.get $argc) (local.get $stack_base)))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_SOLVING_ARGUMENTS))))))
    (local.set $status (call $solving_parse_polynomial
      (global.get $solving_argument1) (global.get $solving_argument2)))
    (local.set $rational_coefficients (i32.eqz (local.get $status)))
    (if (i32.and (i32.ne (local.get $status) (i32.const 0))
          (i32.ne (local.get $status) (i32.const 5)))
      (then (return (call $solving_parse_reject (local.get $status)))))
    (local.set $degree (global.get $solving_parsed_degree))
    (if (call $expression_walk_guard (i32.const 8192))
      (then (return (i32.const 0))))
    ;; Result staging: up to 256 (root slot, multiplicity) entries.
    (local.set $result_records (call $carve_scratch_blob (i32.mul (i32.const 256) (i32.const 20))))
    (local.set $result_count (i32.const 0))
    (local.set $work (call $carve_scratch_blob (i32.const 96)))
    (local.set $factor_slot (local.get $work))
    (local.set $roots_slot (i32.add (local.get $work) (i32.const 16)))
    (local.set $current_slot (i32.add (local.get $work) (i32.const 48)))
    (local.set $derivative_slot (i32.add (local.get $work) (i32.const 64)))
    (local.set $value_slot (i32.add (local.get $work) (i32.const 80)))
    (if (local.get $rational_coefficients)
      (then
        ;; Multiplicities from the repeated-factor decomposition.
        (if (i32.eqz (local.get $degree))
          (then
            (local.set $factor_count (i32.const 0)))
          (else
            (local.set $polynomials (call $carve_scratch_blob (i32.const 512)))
            (local.set $multiplicities (call $carve_scratch_blob (i32.const 512)))
            (local.set $unit_out (call $carve_scratch_blob (i32.const 4)))
            (local.set $factor_count (call $solving_factorization
              (local.get $polynomials) (local.get $multiplicities) (i32.const 128)
              (local.get $unit_out)))
            (if (i32.eq (local.get $factor_count) (i32.const -1))
              (then (return (i32.const 0))))
            (if (i32.lt_s (local.get $factor_count) (i32.const 0))
              (then (return (i32.add (i32.const 1)
                (call $throw_range_error_with_message
                  (global.get $BUILTIN_MSG_SOLVING_UNSUPPORTED))))))))
        (local.set $i (i32.const 0))
        (block $factors_done
          (loop $factor_roots
            (br_if $factors_done (i32.ge_s (local.get $i) (local.get $factor_count)))
            (if (call $solving_polynomial_to_expression
                  (i32.load (call $abs (i32.add (local.get $polynomials)
                    (i32.mul (local.get $i) (i32.const 4)))))
                  (global.get $solving_argument2)
                  (local.get $factor_slot))
              (then (return (i32.const 0))))
            (if (call $solving_complex_roots (local.get $factor_slot)
                  (global.get $solving_argument2) (local.get $roots_slot))
              (then (return (global.get $solving_staged_dispatch))))
            (local.set $roots_array (call $value_data_lo (local.get $roots_slot)))
            (local.set $roots_length (i32.load (call $abs
              (i32.add (local.get $roots_array) (i32.const 8)))))
            (local.set $roots_data (i32.add
              (i32.load (call $abs (i32.add (local.get $roots_array) (i32.const 16))))
              (global.get $GC_HEADER_SIZE)))
            (local.set $multiplicity (i32.load (call $abs
              (i32.add (local.get $multiplicities) (i32.mul (local.get $i) (i32.const 4))))))
            (local.set $j (i32.const 0))
            (block $roots_done
              (loop $collect_roots
                (br_if $roots_done (i32.ge_u (local.get $j) (local.get $roots_length)))
                (if (i32.ge_s (local.get $result_count) (i32.const 256))
                  (then (return (i32.add (i32.const 1)
                    (call $throw_range_error_with_message
                      (global.get $BUILTIN_MSG_SOLVING_UNSUPPORTED))))))
                (memory.copy
                  (call $abs (i32.add (local.get $result_records)
                    (i32.mul (local.get $result_count) (i32.const 20))))
                  (call $abs (i32.add (local.get $roots_data)
                    (i32.mul (local.get $j) (global.get $VALUE_SIZE))))
                  (global.get $VALUE_SIZE))
                (i32.store (call $abs (i32.add
                  (i32.add (local.get $result_records)
                    (i32.mul (local.get $result_count) (i32.const 20)))
                  (i32.const 16)))
                  (local.get $multiplicity))
                (local.set $result_count (i32.add (local.get $result_count) (i32.const 1)))
                (local.set $j (i32.add (local.get $j) (i32.const 1)))
                (br $collect_roots)))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $factor_roots))))
      (else
        ;; Algebraic coefficients: the existing complex-roots engine gives
        ;; the distinct roots; the multiplicity of each root is the number
        ;; of successive derivatives that vanish exactly at it.
        (if (call $solving_complex_roots (global.get $solving_argument1)
              (global.get $solving_argument2) (local.get $roots_slot))
          (then (return (global.get $solving_staged_dispatch))))
        (local.set $roots_array (call $value_data_lo (local.get $roots_slot)))
        (local.set $roots_length (i32.load (call $abs
          (i32.add (local.get $roots_array) (i32.const 8)))))
        (local.set $roots_data (i32.add
          (i32.load (call $abs (i32.add (local.get $roots_array) (i32.const 16))))
          (global.get $GC_HEADER_SIZE)))
        (local.set $j (i32.const 0))
        (block $algebraic_roots_done
          (loop $algebraic_roots
            (br_if $algebraic_roots_done (i32.ge_u (local.get $j) (local.get $roots_length)))
            (if (i32.ge_s (local.get $result_count) (i32.const 256))
              (then (return (i32.add (i32.const 1)
                (call $throw_range_error_with_message
                  (global.get $BUILTIN_MSG_SOLVING_UNSUPPORTED))))))
            ;; Count vanishing derivatives at this root.
            (memory.copy (call $abs (local.get $current_slot))
              (call $abs (global.get $solving_argument1)) (global.get $VALUE_SIZE))
            (local.set $multiplicity (i32.const 0))
            (block $multiplicity_done
              (loop $multiplicity_scan
                (if (i32.gt_s (local.get $multiplicity) (local.get $degree))
                  (then (br $multiplicity_done)))
                (if (call $expression_substitute_into (local.get $current_slot)
                      (call $value_data_lo (global.get $solving_argument2))
                      (i32.add (local.get $roots_data)
                        (i32.mul (local.get $j) (global.get $VALUE_SIZE)))
                      (local.get $value_slot))
                  (then (return (i32.const 0))))
                (if (call $expression_simplify_into
                      (local.get $value_slot) (local.get $value_slot))
                  (then (return (i32.const 0))))
                (local.set $zero_status (call $solving_value_is_zero
                  (local.get $value_slot)))
                (if (i32.eq (local.get $zero_status) (i32.const 2))
                  (then (return (i32.const 0))))
                (if (i32.eq (local.get $zero_status) (i32.const 3))
                  (then (return (i32.add (i32.const 1)
                    (call $throw_type_error_with_message
                      (global.get $BUILTIN_MSG_SOLVING_UNSUPPORTED))))))
                (br_if $multiplicity_done (i32.eqz (local.get $zero_status)))
                (local.set $multiplicity (i32.add (local.get $multiplicity) (i32.const 1)))
                (local.set $status (call $calculus_derivative_into
                  (local.get $current_slot)
                  (call $value_data_lo (global.get $solving_argument2))
                  (local.get $derivative_slot)))
                (if (i32.eq (local.get $status) (i32.const 1))
                  (then (return (i32.const 0))))
                (if (i32.eq (local.get $status) (i32.const 2))
                  (then (return (i32.add (i32.const 1)
                    (call $calculus_throw_unsupported_head)))))
                (if (call $expression_simplify_into
                      (local.get $derivative_slot) (local.get $current_slot))
                  (then (return (i32.const 0))))
                (br $multiplicity_scan)))
            (memory.copy
              (call $abs (i32.add (local.get $result_records)
                (i32.mul (local.get $result_count) (i32.const 20))))
              (call $abs (i32.add (local.get $roots_data)
                (i32.mul (local.get $j) (global.get $VALUE_SIZE))))
              (global.get $VALUE_SIZE))
            (i32.store (call $abs (i32.add
              (i32.add (local.get $result_records)
                (i32.mul (local.get $result_count) (i32.const 20)))
              (i32.const 16)))
              (local.get $multiplicity))
            (local.set $result_count (i32.add (local.get $result_count) (i32.const 1)))
            (local.set $j (i32.add (local.get $j) (i32.const 1)))
            (br $algebraic_roots)))))
    ;; Emit the frozen records array.
    (if (call $expression_walk_guard (i32.add (i32.const 1024)
          (i32.mul (local.get $result_count) (i32.const 64))))
      (then (return (i32.const 0))))
    (local.set $result_array (call $allocate_array (local.get $result_count)))
    (local.set $result_data (i32.add
      (i32.load (call $abs (i32.add (local.get $result_array) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (local.set $record_pairs (call $carve_scratch_blob (i32.const 32)))
    (local.set $i (i32.const 0))
    (block $records_done
      (loop $records
        (br_if $records_done (i32.ge_s (local.get $i) (local.get $result_count)))
        (call $write_value (i32.add (local.get $record_pairs) (i32.const 16))
          (global.get $TYPE_BIGINT) (i32.const 0)
          (call $bigint_from_i64 (i64.extend_i32_s (i32.load (call $abs (i32.add
            (i32.add (local.get $result_records) (i32.mul (local.get $i) (i32.const 20)))
            (i32.const 16))))))
          (i32.const 0))
        (i32.store (call $abs (local.get $record_pairs)) (global.get $BUILTIN_KEY_ROOT))
        (i32.store (call $abs (i32.add (local.get $record_pairs) (i32.const 4)))
          (i32.add (local.get $result_records) (i32.mul (local.get $i) (i32.const 20))))
        (i32.store (call $abs (i32.add (local.get $record_pairs) (i32.const 8)))
          (global.get $BUILTIN_KEY_MULTIPLICITY))
        (i32.store (call $abs (i32.add (local.get $record_pairs) (i32.const 12)))
          (i32.add (local.get $record_pairs) (i32.const 16)))
        (local.set $record (call $calculus_record (local.get $record_pairs) (i32.const 2)))
        (if (i32.eqz (local.get $record)) (then (return (i32.const 0))))
        (call $write_value (i32.add (local.get $result_data)
          (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
          (global.get $TYPE_OBJECT) (i32.const 0) (local.get $record) (i32.const 0))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $records)))
    (call $expression_freeze_args_array (local.get $result_array))
    (call $pending_push (global.get $TYPE_ARRAY) (i32.const 0)
      (local.get $result_array) (i32.const 0))
    (i32.const 0)
  )

  ;; ==========================================================================
  ;; Inequality and condition surface + zero-dimensional system solving.
  ;;
  ;; Sign analysis is exact: real algebraic roots partition the line, every
  ;; interior witness is an exact Rational, and every sign is an exact sign
  ;; test. No float is ever sampled.
  ;; ==========================================================================

  ;; Staged internal call to the real-roots engine. Same contract as
  ;; $solving_complex_roots.
  (func $solving_real_roots
    (param $expression_slot i32) (param $variable_slot i32) (param $result_slot i32)
    (result i32)
    (local $saved_pending i32)
    (local $status i32)
    (if (call $expression_walk_guard (i32.const 64))
      (then (return (i32.const 1))))
    (local.set $saved_pending (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (memory.copy (call $abs (local.get $result_slot))
      (call $abs (local.get $expression_slot)) (global.get $VALUE_SIZE))
    (memory.copy (call $abs (i32.add (local.get $result_slot) (global.get $VALUE_SIZE)))
      (call $abs (local.get $variable_slot)) (global.get $VALUE_SIZE))
    (call $write_ctx (global.get $CTX_PENDING_POINTER)
      (i32.add (local.get $result_slot) (i32.mul (i32.const 2) (global.get $VALUE_SIZE))))
    (local.set $status (call $algebraic_roots_of_polynomial
      (global.get $TYPE_OBJECT) (i32.const 0)
      (global.get $METHOD_EXACT_ALGEBRAIC_ROOTS_OF_POLYNOMIAL)
      (i32.const 2) (local.get $result_slot)))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $saved_pending))
    (global.set $solving_staged_dispatch (local.get $status))
    (if (local.get $status) (then (return (i32.const 1))))
    (if (global.get $memory_pressure_signaled) (then (return (i32.const 1))))
    (i32.const 0)
  )

  ;; Rational lower/upper bound headers for an exact real slot.
  (func $solving_rational_bound (param $slot i32) (param $upper i32) (result i32)
    (local $interval_data i32)
    (if (i32.eq (call $value_type (local.get $slot)) (global.get $TYPE_ALGEBRAIC))
      (then
        (local.set $interval_data (i32.add
          (i32.load (call $abs (i32.add
            (call $algebraic_interval_of (call $value_data_lo (local.get $slot)))
            (i32.const 16))))
          (global.get $GC_HEADER_SIZE)))
        (return (call $rational_materialize
          (if (result i32) (local.get $upper)
            (then (i32.add (local.get $interval_data) (global.get $VALUE_SIZE)))
            (else (local.get $interval_data)))))))
    (if (i32.eq (call $value_type (local.get $slot)) (global.get $TYPE_BIGINT))
      (then (return (call $rational_from_bigint (call $value_data_lo (local.get $slot))))))
    (call $rational_materialize (local.get $slot))
  )

  ;; An exact Rational strictly between two exact real slots (either side
  ;; may be 0 for an unbounded side). Writes a RATIONAL value slot.
  ;; Status 0 / 1 pressure.
  (func $solving_witness_between
    (param $left_slot i32) (param $right_slot i32) (param $destination_slot i32)
    (result i32)
    (local $upper i32)
    (local $lower i32)
    (local $one i32)
    (local.set $one (call $approximation_rational_small (i64.const 1) (i64.const 1)))
    (if (i32.and (i32.eqz (local.get $left_slot)) (i32.eqz (local.get $right_slot)))
      (then
        (call $write_inline_rational (local.get $destination_slot) (i64.const 0))
        (return (i32.const 0))))
    (if (i32.eqz (local.get $left_slot))
      (then
        (call $write_value (local.get $destination_slot)
          (global.get $TYPE_RATIONAL) (i32.const 0)
          (call $rational_sub
            (call $solving_rational_bound (local.get $right_slot) (i32.const 0))
            (local.get $one))
          (i32.const 0))
        (return (i32.const 0))))
    (if (i32.eqz (local.get $right_slot))
      (then
        (call $write_value (local.get $destination_slot)
          (global.get $TYPE_RATIONAL) (i32.const 0)
          (call $rational_add
            (call $solving_rational_bound (local.get $left_slot) (i32.const 1))
            (local.get $one))
          (i32.const 0))
        (return (i32.const 0))))
    (block $separated
      (loop $separate
        (if (call $expression_walk_guard (i32.const 4096))
          (then (return (i32.const 1))))
        (local.set $upper (call $solving_rational_bound (local.get $left_slot) (i32.const 1)))
        (local.set $lower (call $solving_rational_bound (local.get $right_slot) (i32.const 0)))
        (br_if $separated (i32.lt_s
          (call $rational_header_pair_compare (local.get $upper) (local.get $lower))
          (i32.const 0)))
        ;; Refine whichever side is refinable.
        (if (i32.eq (call $value_type (local.get $left_slot)) (global.get $TYPE_ALGEBRAIC))
          (then (if (call $algebraic_refine_step (call $value_data_lo (local.get $left_slot)))
            (then (return (i32.const 1))))))
        (if (i32.eq (call $value_type (local.get $right_slot)) (global.get $TYPE_ALGEBRAIC))
          (then (if (call $algebraic_refine_step (call $value_data_lo (local.get $right_slot)))
            (then (return (i32.const 1))))))
        (br $separate)))
    (call $write_value (local.get $destination_slot)
      (global.get $TYPE_RATIONAL) (i32.const 0)
      (call $rational_mul
        (call $rational_add (local.get $upper) (local.get $lower))
        (call $rational_new (call $bigint_one) (call $bigint_from_i64 (i64.const 2))))
      (i32.const 0))
    (i32.const 0)
  )

  ;; Exact sign of a rational-coefficient polynomial expression at an
  ;; exact rational witness slot. Returns -1/0/1, or 2 on pressure.
  (func $solving_sign_at_witness
    (param $expression_slot i32) (param $variable_slot i32) (param $witness_slot i32)
    (result i32)
    (local $value_slot i32)
    (local $header i32)
    (if (call $expression_walk_guard (i32.const 2048))
      (then (return (i32.const 2))))
    (local.set $value_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (if (call $expression_substitute_into (local.get $expression_slot)
          (call $value_data_lo (local.get $variable_slot))
          (local.get $witness_slot) (local.get $value_slot))
      (then (return (i32.const 2))))
    (if (call $expression_simplify_into (local.get $value_slot) (local.get $value_slot))
      (then (return (i32.const 2))))
    (if (i32.eq (call $value_type (local.get $value_slot)) (global.get $TYPE_BIGINT))
      (then
        (local.set $header (call $value_data_lo (local.get $value_slot)))
        (if (i32.eqz (call $bigint_length (local.get $header)))
          (then (return (i32.const 0))))
        (if (call $bigint_sign (local.get $header))
          (then (return (i32.const -1))))
        (return (i32.const 1))))
    (if (i32.ne (call $value_type (local.get $value_slot)) (global.get $TYPE_RATIONAL))
      (then (return (i32.const 2))))
    (if (call $rational_is_zero (local.get $value_slot)) (then (return (i32.const 0))))
    (if (call $rational_is_negative (local.get $value_slot)) (then (return (i32.const -1))))
    (i32.const 1)
  )

  ;; Boundary/sign analysis outputs. Boundary records are 24 bytes:
  ;; [value slot: 16][flags: 4 (bit0 numerator root, bit1 denominator
  ;; root)][pad: 4]. Region signs are (count + 1) i32 entries.
  (global $solving_boundary_records (mut i32) (i32.const 0))
  (global $solving_boundary_count (mut i32) (i32.const 0))
  (global $solving_region_signs (mut i32) (i32.const 0))

  ;; Collect the sorted distinct boundaries and per-region exact signs for
  ;; n / d over the reals. `denominator_slot` may be 0 for a polynomial.
  ;; Status 0 / 1 pressure-or-thrown ($solving_staged_dispatch).
  (func $solving_sign_analysis
    (param $numerator_slot i32) (param $denominator_slot i32) (param $variable_slot i32)
    (result i32)
    (local $numerator_roots_slot i32)
    (local $denominator_roots_slot i32)
    (local $n_array i32)
    (local $n_length i32)
    (local $n_data i32)
    (local $d_array i32)
    (local $d_length i32)
    (local $d_data i32)
    (local $records i32)
    (local $count i32)
    (local $i i32)
    (local $j i32)
    (local $comparison i32)
    (local $record i32)
    (local $signs i32)
    (local $witness_slot i32)
    (local $left_slot i32)
    (local $right_slot i32)
    (local $sign i32)
    (local $denominator_sign i32)
    (local $work i32)
    (if (call $expression_walk_guard (i32.const 8192))
      (then (return (i32.const 1))))
    (local.set $work (call $carve_scratch_blob (i32.const 96)))
    (local.set $numerator_roots_slot (local.get $work))
    (local.set $denominator_roots_slot (i32.add (local.get $work) (i32.const 48)))
    (if (call $solving_real_roots (local.get $numerator_slot)
          (local.get $variable_slot) (local.get $numerator_roots_slot))
      (then (return (i32.const 1))))
    (local.set $n_array (call $value_data_lo (local.get $numerator_roots_slot)))
    (local.set $n_length (i32.load (call $abs (i32.add (local.get $n_array) (i32.const 8)))))
    (local.set $n_data (i32.add
      (i32.load (call $abs (i32.add (local.get $n_array) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (local.set $d_length (i32.const 0))
    (if (local.get $denominator_slot)
      (then
        (if (call $solving_real_roots (local.get $denominator_slot)
              (local.get $variable_slot) (local.get $denominator_roots_slot))
          (then (return (i32.const 1))))
        (local.set $d_array (call $value_data_lo (local.get $denominator_roots_slot)))
        (local.set $d_length (i32.load (call $abs
          (i32.add (local.get $d_array) (i32.const 8)))))
        (local.set $d_data (i32.add
          (i32.load (call $abs (i32.add (local.get $d_array) (i32.const 16))))
          (global.get $GC_HEADER_SIZE)))))
    (if (i32.gt_s (i32.add (local.get $n_length) (local.get $d_length)) (i32.const 120))
      (then (return (i32.const 1))))
    (if (call $expression_walk_guard (i32.const 8192))
      (then (return (i32.const 1))))
    (local.set $records (call $carve_scratch_blob (i32.const 3072)))
    (local.set $signs (call $carve_scratch_blob (i32.const 512)))
    (local.set $witness_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    ;; Sorted merge of the two ascending root lists.
    (local.set $count (i32.const 0))
    (local.set $i (i32.const 0))
    (local.set $j (i32.const 0))
    (block $merged
      (loop $merge
        (br_if $merged (i32.and
          (i32.ge_u (local.get $i) (local.get $n_length))
          (i32.ge_u (local.get $j) (local.get $d_length))))
        (local.set $record (i32.add (local.get $records)
          (i32.mul (local.get $count) (i32.const 24))))
        (if (i32.ge_u (local.get $i) (local.get $n_length))
          (then (local.set $comparison (i32.const 1)))
          (else (if (i32.ge_u (local.get $j) (local.get $d_length))
            (then (local.set $comparison (i32.const -1)))
            (else
              (local.set $comparison (call $exact_real_compare_slots
                (i32.add (local.get $n_data) (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
                (i32.add (local.get $d_data) (i32.mul (local.get $j) (global.get $VALUE_SIZE)))))
              (if (global.get $memory_pressure_signaled)
                (then (return (i32.const 1))))))))
        (if (i32.lt_s (local.get $comparison) (i32.const 0))
          (then
            (memory.copy (call $abs (local.get $record))
              (call $abs (i32.add (local.get $n_data)
                (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
              (global.get $VALUE_SIZE))
            (i32.store (call $abs (i32.add (local.get $record) (i32.const 16))) (i32.const 1))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))))
        (if (i32.gt_s (local.get $comparison) (i32.const 0))
          (then
            (memory.copy (call $abs (local.get $record))
              (call $abs (i32.add (local.get $d_data)
                (i32.mul (local.get $j) (global.get $VALUE_SIZE))))
              (global.get $VALUE_SIZE))
            (i32.store (call $abs (i32.add (local.get $record) (i32.const 16))) (i32.const 2))
            (local.set $j (i32.add (local.get $j) (i32.const 1)))))
        (if (i32.eqz (local.get $comparison))
          (then
            (memory.copy (call $abs (local.get $record))
              (call $abs (i32.add (local.get $n_data)
                (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
              (global.get $VALUE_SIZE))
            (i32.store (call $abs (i32.add (local.get $record) (i32.const 16))) (i32.const 3))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (local.set $j (i32.add (local.get $j) (i32.const 1)))))
        (local.set $count (i32.add (local.get $count) (i32.const 1)))
        (br $merge)))
    ;; Region signs at exact rational witnesses.
    (local.set $i (i32.const 0))
    (block $signed
      (loop $sign_regions
        (br_if $signed (i32.gt_s (local.get $i) (local.get $count)))
        (local.set $left_slot (if (result i32) (local.get $i)
          (then (i32.add (local.get $records)
            (i32.mul (i32.sub (local.get $i) (i32.const 1)) (i32.const 24))))
          (else (i32.const 0))))
        (local.set $right_slot (if (result i32) (i32.lt_s (local.get $i) (local.get $count))
          (then (i32.add (local.get $records) (i32.mul (local.get $i) (i32.const 24))))
          (else (i32.const 0))))
        (if (call $solving_witness_between
              (local.get $left_slot) (local.get $right_slot) (local.get $witness_slot))
          (then (return (i32.const 1))))
        (local.set $sign (call $solving_sign_at_witness
          (local.get $numerator_slot) (local.get $variable_slot) (local.get $witness_slot)))
        (if (i32.eq (local.get $sign) (i32.const 2)) (then (return (i32.const 1))))
        (if (local.get $denominator_slot)
          (then
            (local.set $denominator_sign (call $solving_sign_at_witness
              (local.get $denominator_slot) (local.get $variable_slot)
              (local.get $witness_slot)))
            (if (i32.eq (local.get $denominator_sign) (i32.const 2))
              (then (return (i32.const 1))))
            (local.set $sign (i32.mul (local.get $sign) (local.get $denominator_sign)))))
        (i32.store (call $abs (i32.add (local.get $signs)
          (i32.mul (local.get $i) (i32.const 4)))) (local.get $sign))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $sign_regions)))
    (global.set $solving_boundary_records (local.get $records))
    (global.set $solving_boundary_count (local.get $count))
    (global.set $solving_region_signs (local.get $signs))
    (i32.const 0)
  )

  ;; Build one frozen canonical interval record. Unbounded sides pass 0
  ;; and store `undefined` with a false closed flag. Returns the object
  ;; pointer or 0 on pressure.
  (func $solving_interval_record
    (param $lower_slot i32) (param $lower_closed i32)
    (param $upper_slot i32) (param $upper_closed i32)
    (result i32)
    (local $slots i32)
    (local $pairs i32)
    (if (call $expression_walk_guard (i32.const 1024))
      (then (return (i32.const 0))))
    (local.set $slots (call $carve_scratch_blob (i32.const 64)))
    (local.set $pairs (call $carve_scratch_blob (i32.const 32)))
    (if (local.get $lower_slot)
      (then (memory.copy (call $abs (local.get $slots))
        (call $abs (local.get $lower_slot)) (global.get $VALUE_SIZE)))
      (else (call $write_value (local.get $slots)
        (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))))
    (call $write_value (i32.add (local.get $slots) (i32.const 16))
      (global.get $TYPE_BOOLEAN) (i32.const 0) (local.get $lower_closed) (i32.const 0))
    (if (local.get $upper_slot)
      (then (memory.copy (call $abs (i32.add (local.get $slots) (i32.const 32)))
        (call $abs (local.get $upper_slot)) (global.get $VALUE_SIZE)))
      (else (call $write_value (i32.add (local.get $slots) (i32.const 32))
        (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))))
    (call $write_value (i32.add (local.get $slots) (i32.const 48))
      (global.get $TYPE_BOOLEAN) (i32.const 0) (local.get $upper_closed) (i32.const 0))
    (i32.store (call $abs (local.get $pairs)) (global.get $BUILTIN_KEY_LOWER))
    (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 4))) (local.get $slots))
    (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 8)))
      (global.get $BUILTIN_KEY_LOWER_CLOSED))
    (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 12)))
      (i32.add (local.get $slots) (i32.const 16)))
    (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 16)))
      (global.get $BUILTIN_KEY_UPPER))
    (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 20)))
      (i32.add (local.get $slots) (i32.const 32)))
    (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 24)))
      (global.get $BUILTIN_KEY_UPPER_CLOSED))
    (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 28)))
      (i32.add (local.get $slots) (i32.const 48)))
    (call $calculus_record (local.get $pairs) (i32.const 4))
  )

  ;; Split a simplified difference into numerator/denominator polynomial
  ;; expressions in `variable`. The supported classes are polynomials and
  ;; top-level quotients of polynomials. Writes the numerator into
  ;; numerator_slot and the denominator (or nothing) into denominator_slot,
  ;; returning: 0 polynomial (no denominator) / 1 quotient / 2 pressure /
  ;; 3 unsupported.
  (func $solving_split_rational_function
    (param $difference_slot i32) (param $variable_slot i32)
    (param $numerator_slot i32) (param $denominator_slot i32)
    (result i32)
    (local $status i32)
    (local $header i32)
    (local $data i32)
    (local $count i32)
    (local $i i32)
    (local $factor_slot i32)
    (local $factor_header i32)
    (local $factor_data i32)
    (local $exponent_valid i32)
    (local $exponent_value i64)
    (local $exponent_header i32)
    (local $work i32)
    (local $have_numerator i32)
    (local $have_denominator i32)
    (local $piece_slot i32)
    (local.set $status (call $solving_parse_polynomial
      (local.get $difference_slot) (local.get $variable_slot)))
    (if (i32.eq (local.get $status) (i32.const 1)) (then (return (i32.const 2))))
    (if (i32.or (i32.eqz (local.get $status)) (i32.eq (local.get $status) (i32.const 4)))
      (then
        (memory.copy (call $abs (local.get $numerator_slot))
          (call $abs (local.get $difference_slot)) (global.get $VALUE_SIZE))
        (return (i32.const 0))))
    ;; Not a polynomial: decompose a rational-function shape. The
    ;; simplifier canonicalizes quotients into Multiply factors with
    ;; negative-integer Power exponents, so both the raw Divide form and
    ;; the canonical form are recognized.
    (if (i32.ne (call $value_type (local.get $difference_slot)) (global.get $TYPE_EXPRESSION))
      (then (return (i32.const 3))))
    (local.set $header (call $value_data_lo (local.get $difference_slot)))
    (if (call $expression_walk_guard (i32.const 4096))
      (then (return (i32.const 2))))
    (local.set $work (call $carve_scratch_blob (i32.const 32)))
    (local.set $piece_slot (i32.add (local.get $work) (i32.const 16)))
    (if (i32.and
          (call $approximation_head_is (local.get $header)
            (global.get $BUILTIN_EXPRESSION_HEAD_DIVIDE))
          (i32.eq (call $approximation_expression_argument_count (local.get $header))
            (i32.const 2)))
      (then
        (local.set $data (call $approximation_expression_argument_data (local.get $header)))
        (memory.copy (call $abs (local.get $numerator_slot))
          (call $abs (local.get $data)) (global.get $VALUE_SIZE))
        (memory.copy (call $abs (local.get $denominator_slot))
          (call $abs (i32.add (local.get $data) (global.get $VALUE_SIZE)))
          (global.get $VALUE_SIZE))
        (local.set $have_numerator (i32.const 1))
        (local.set $have_denominator (i32.const 1)))
      (else
        ;; Treat the node as a product; a bare Power(q, -k) is a
        ;; one-factor product.
        (if (call $approximation_head_is (local.get $header)
              (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY))
          (then
            (local.set $count (call $approximation_expression_argument_count
              (local.get $header)))
            (local.set $data (call $approximation_expression_argument_data
              (local.get $header))))
          (else
            (local.set $count (i32.const 1))
            (local.set $data (local.get $difference_slot))))
        (local.set $have_numerator (i32.const 0))
        (local.set $have_denominator (i32.const 0))
        (local.set $i (i32.const 0))
        (block $partitioned
          (loop $partition
            (br_if $partitioned (i32.ge_s (local.get $i) (local.get $count)))
            (local.set $factor_slot (i32.add (local.get $data)
              (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
            ;; A Power factor with a negative exact integer exponent joins
            ;; the denominator as base^|exponent|.
            (local.set $exponent_valid (i32.const 0))
            (if (i32.eq (call $value_type (local.get $factor_slot))
                  (global.get $TYPE_EXPRESSION))
              (then
                (local.set $factor_header (call $value_data_lo (local.get $factor_slot)))
                (if (i32.and
                      (call $approximation_head_is (local.get $factor_header)
                        (global.get $BUILTIN_EXPRESSION_HEAD_POWER))
                      (i32.eq (call $approximation_expression_argument_count
                        (local.get $factor_header)) (i32.const 2)))
                  (then
                    (local.set $factor_data (call $approximation_expression_argument_data
                      (local.get $factor_header)))
                    (if (i32.eq (call $value_type (i32.add (local.get $factor_data)
                          (global.get $VALUE_SIZE))) (global.get $TYPE_BIGINT))
                      (then
                        (local.set $exponent_valid (call $bigint_to_i64_fits
                          (call $value_data_lo (i32.add (local.get $factor_data)
                            (global.get $VALUE_SIZE)))))
                        (local.set $exponent_value (global.get $bigint_to_i64_value))))
                    (if (i32.eq (call $value_type (i32.add (local.get $factor_data)
                          (global.get $VALUE_SIZE))) (global.get $TYPE_RATIONAL))
                      (then
                        (local.set $exponent_header (call $rational_materialize
                          (i32.add (local.get $factor_data) (global.get $VALUE_SIZE))))
                        (if (call $rational_denominator_is_one (local.get $exponent_header))
                          (then
                            (local.set $exponent_valid (call $bigint_to_i64_fits
                              (call $rational_numerator (local.get $exponent_header))))
                            (local.set $exponent_value
                              (global.get $bigint_to_i64_value))))))
                    (if (i32.ge_s (i32.wrap_i64 (local.get $exponent_value)) (i32.const 0))
                      (then (local.set $exponent_valid (i32.const 0))))))))
            (if (local.get $exponent_valid)
              (then
                ;; Denominator piece: base ** |exponent|.
                (call $write_inline_rational (local.get $piece_slot)
                  (i64.sub (i64.const 0) (local.get $exponent_value)))
                (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_POWER)
                  (local.get $factor_data) (local.get $piece_slot) (local.get $piece_slot))
                (if (local.get $have_denominator)
                  (then (call $build_raw_expr2
                    (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
                    (local.get $denominator_slot) (local.get $piece_slot)
                    (local.get $denominator_slot)))
                  (else
                    (memory.copy (call $abs (local.get $denominator_slot))
                      (call $abs (local.get $piece_slot)) (global.get $VALUE_SIZE))
                    (local.set $have_denominator (i32.const 1)))))
              (else
                (if (local.get $have_numerator)
                  (then (call $build_raw_expr2
                    (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
                    (local.get $numerator_slot) (local.get $factor_slot)
                    (local.get $numerator_slot)))
                  (else
                    (memory.copy (call $abs (local.get $numerator_slot))
                      (call $abs (local.get $factor_slot)) (global.get $VALUE_SIZE))
                    (local.set $have_numerator (i32.const 1))))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $partition)))
        (if (i32.eqz (local.get $have_denominator)) (then (return (i32.const 3))))
        (if (i32.eqz (local.get $have_numerator))
          (then (call $write_inline_rational (local.get $numerator_slot) (i64.const 1))))))
    ;; Both pieces must simplify into supported polynomials.
    (if (call $expression_simplify_into (local.get $numerator_slot) (local.get $numerator_slot))
      (then (return (i32.const 2))))
    (if (call $expression_simplify_into
          (local.get $denominator_slot) (local.get $denominator_slot))
      (then (return (i32.const 2))))
    (local.set $status (call $solving_parse_polynomial
      (local.get $numerator_slot) (local.get $variable_slot)))
    (if (i32.eq (local.get $status) (i32.const 1)) (then (return (i32.const 2))))
    (if (i32.and (i32.ne (local.get $status) (i32.const 0))
          (i32.ne (local.get $status) (i32.const 4)))
      (then (return (i32.const 3))))
    (local.set $status (call $solving_parse_polynomial
      (local.get $denominator_slot) (local.get $variable_slot)))
    (if (i32.eq (local.get $status) (i32.const 1)) (then (return (i32.const 2))))
    (if (local.get $status) (then (return (i32.const 3))))
    (i32.const 1)
  )

  ;; Relation-head opcode: 0 none / 1 Equal / 2 NotEqual / 3 Less /
  ;; 4 LessEqual / 5 Greater / 6 GreaterEqual.
  (func $solving_relation_opcode (param $header i32) (result i32)
    (if (call $approximation_head_is (local.get $header)
          (global.get $BUILTIN_EXPRESSION_HEAD_EQUAL))
      (then (return (i32.const 1))))
    (if (call $approximation_head_is (local.get $header)
          (global.get $BUILTIN_EXPRESSION_HEAD_NOT_EQUAL))
      (then (return (i32.const 2))))
    (if (call $approximation_head_is (local.get $header)
          (global.get $BUILTIN_EXPRESSION_HEAD_LESS))
      (then (return (i32.const 3))))
    (if (call $approximation_head_is (local.get $header)
          (global.get $BUILTIN_EXPRESSION_HEAD_LESS_EQUAL))
      (then (return (i32.const 4))))
    (if (call $approximation_head_is (local.get $header)
          (global.get $BUILTIN_EXPRESSION_HEAD_GREATER))
      (then (return (i32.const 5))))
    (if (call $approximation_head_is (local.get $header)
          (global.get $BUILTIN_EXPRESSION_HEAD_GREATER_EQUAL))
      (then (return (i32.const 6))))
    (i32.const 0)
  )

  ;; Does the relation opcode accept this exact sign (-1/0/1)?
  (func $solving_relation_accepts (param $opcode i32) (param $sign i32) (result i32)
    (if (i32.eq (local.get $opcode) (i32.const 1))
      (then (return (i32.eqz (local.get $sign)))))
    (if (i32.eq (local.get $opcode) (i32.const 2))
      (then (return (i32.ne (local.get $sign) (i32.const 0)))))
    (if (i32.eq (local.get $opcode) (i32.const 3))
      (then (return (i32.lt_s (local.get $sign) (i32.const 0)))))
    (if (i32.eq (local.get $opcode) (i32.const 4))
      (then (return (i32.le_s (local.get $sign) (i32.const 0)))))
    (if (i32.eq (local.get $opcode) (i32.const 5))
      (then (return (i32.gt_s (local.get $sign) (i32.const 0)))))
    (i32.ge_s (local.get $sign) (i32.const 0))
  )

  ;; solveInequality(relation, variable) -> frozen Array of canonical
  ;; interval records (sorted, merged; points are degenerate closed
  ;; intervals).
  (func $expression_solve_inequality_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $header i32)
    (local $data i32)
    (local $opcode i32)
    (local $work i32)
    (local $difference_slot i32)
    (local $numerator_slot i32)
    (local $denominator_slot i32)
    (local $split i32)
    (local $count i32)
    (local $signs i32)
    (local $records i32)
    (local $result_intervals i32)
    (local $result_count i32)
    (local $i i32)
    (local $in_run i32)
    (local $run_lower_slot i32)
    (local $run_lower_closed i32)
    (local $flags i32)
    (local $region_included i32)
    (local $boundary_included i32)
    (local $boundary_slot i32)
    (local $record i32)
    (local $result_array i32)
    (local $result_data i32)
    (if (i32.eqz (call $solving_two_arguments (local.get $argc) (local.get $stack_base)))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_SOLVING_ARGUMENTS))))))
    (if (i32.or
          (i32.ne (call $value_type (global.get $solving_argument1))
            (global.get $TYPE_EXPRESSION))
          (i32.ne (call $value_type (global.get $solving_argument2))
            (global.get $TYPE_SYMBOL)))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_SOLVING_ARGUMENTS))))))
    (local.set $header (call $value_data_lo (global.get $solving_argument1)))
    (local.set $opcode (call $solving_relation_opcode (local.get $header)))
    (if (i32.or
          (i32.eqz (local.get $opcode))
          (i32.ne (call $approximation_expression_argument_count (local.get $header))
            (i32.const 2)))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_SOLVING_ARGUMENTS))))))
    (if (call $expression_walk_guard (i32.const 8192))
      (then (return (i32.const 0))))
    (local.set $work (call $carve_scratch_blob (i32.const 64)))
    (local.set $difference_slot (local.get $work))
    (local.set $numerator_slot (i32.add (local.get $work) (i32.const 16)))
    (local.set $denominator_slot (i32.add (local.get $work) (i32.const 32)))
    (local.set $data (call $approximation_expression_argument_data (local.get $header)))
    (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_SUBTRACT)
      (local.get $data) (i32.add (local.get $data) (global.get $VALUE_SIZE))
      (local.get $difference_slot))
    (if (call $expression_simplify_into
          (local.get $difference_slot) (local.get $difference_slot))
      (then (return (i32.const 0))))
    (local.set $split (call $solving_split_rational_function
      (local.get $difference_slot) (global.get $solving_argument2)
      (local.get $numerator_slot) (local.get $denominator_slot)))
    (if (i32.eq (local.get $split) (i32.const 2)) (then (return (i32.const 0))))
    (if (i32.eq (local.get $split) (i32.const 3))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message
          (global.get $BUILTIN_MSG_SOLVING_UNSUPPORTED))))))
    ;; An exactly-zero difference holds everywhere (or nowhere): one
    ;; unbounded interval when the relation accepts sign zero, else empty.
    (if (call $expression_value_is_zero_wide (local.get $numerator_slot))
      (then
        (if (global.get $memory_pressure_signaled) (then (return (i32.const 0))))
        (local.set $result_array (call $allocate_array
          (call $solving_relation_accepts (local.get $opcode) (i32.const 0))))
        (if (call $solving_relation_accepts (local.get $opcode) (i32.const 0))
          (then
            (local.set $record (call $solving_interval_record
              (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)))
            (if (i32.eqz (local.get $record)) (then (return (i32.const 0))))
            (call $write_value (i32.add
              (i32.load (call $abs (i32.add (local.get $result_array) (i32.const 16))))
              (global.get $GC_HEADER_SIZE))
              (global.get $TYPE_OBJECT) (i32.const 0) (local.get $record) (i32.const 0))))
        (call $expression_freeze_args_array (local.get $result_array))
        (call $pending_push (global.get $TYPE_ARRAY) (i32.const 0)
          (local.get $result_array) (i32.const 0))
        (return (i32.const 0))))
    (if (call $solving_sign_analysis (local.get $numerator_slot)
          (if (result i32) (i32.eq (local.get $split) (i32.const 1))
            (then (local.get $denominator_slot)) (else (i32.const 0)))
          (global.get $solving_argument2))
      (then
        (if (global.get $solving_staged_dispatch)
          (then (return (global.get $solving_staged_dispatch))))
        (return (i32.const 0))))
    (local.set $count (global.get $solving_boundary_count))
    (local.set $signs (global.get $solving_region_signs))
    (local.set $records (global.get $solving_boundary_records))
    ;; Sweep: alternating regions and boundaries, merging adjacent
    ;; compatible pieces. Result staging: (lower_slot, lower_closed,
    ;; upper_slot, upper_closed) i32 quads.
    (local.set $result_intervals (call $carve_scratch_blob (i32.const 2048)))
    (local.set $result_count (i32.const 0))
    (local.set $in_run (i32.const 0))
    (local.set $i (i32.const 0))
    (block $swept
      (loop $sweep
        ;; Region i.
        (local.set $region_included (call $solving_relation_accepts
          (local.get $opcode)
          (i32.load (call $abs (i32.add (local.get $signs)
            (i32.mul (local.get $i) (i32.const 4)))))))
        (if (i32.and (local.get $region_included) (i32.eqz (local.get $in_run)))
          (then
            (local.set $in_run (i32.const 1))
            (if (local.get $i)
              (then
                (local.set $run_lower_slot (i32.add (local.get $records)
                  (i32.mul (i32.sub (local.get $i) (i32.const 1)) (i32.const 24))))
                (local.set $run_lower_closed (i32.const 0)))
              (else
                (local.set $run_lower_slot (i32.const 0))
                (local.set $run_lower_closed (i32.const 0))))))
        (if (i32.and (i32.eqz (local.get $region_included)) (local.get $in_run))
          (then
            ;; The run ended at boundary i-1 (which was included).
            (local.set $in_run (i32.const 0))
            (i32.store (call $abs (i32.add (local.get $result_intervals)
              (i32.mul (local.get $result_count) (i32.const 16))))
              (local.get $run_lower_slot))
            (i32.store (call $abs (i32.add (i32.add (local.get $result_intervals)
              (i32.mul (local.get $result_count) (i32.const 16))) (i32.const 4)))
              (local.get $run_lower_closed))
            (i32.store (call $abs (i32.add (i32.add (local.get $result_intervals)
              (i32.mul (local.get $result_count) (i32.const 16))) (i32.const 8)))
              (i32.add (local.get $records)
                (i32.mul (i32.sub (local.get $i) (i32.const 1)) (i32.const 24))))
            (i32.store (call $abs (i32.add (i32.add (local.get $result_intervals)
              (i32.mul (local.get $result_count) (i32.const 16))) (i32.const 12)))
              (i32.const 1))
            (local.set $result_count (i32.add (local.get $result_count) (i32.const 1)))))
        (br_if $swept (i32.ge_s (local.get $i) (local.get $count)))
        ;; Boundary i.
        (local.set $boundary_slot (i32.add (local.get $records)
          (i32.mul (local.get $i) (i32.const 24))))
        (local.set $flags (i32.load (call $abs
          (i32.add (local.get $boundary_slot) (i32.const 16)))))
        ;; A denominator root is outside the domain; otherwise the exact
        ;; value there is zero (a numerator root).
        (local.set $boundary_included (i32.and
          (i32.eqz (i32.and (local.get $flags) (i32.const 2)))
          (call $solving_relation_accepts (local.get $opcode) (i32.const 0))))
        (if (i32.and (local.get $in_run) (i32.eqz (local.get $boundary_included)))
          (then
            ;; Close the run with an open endpoint at this boundary.
            (local.set $in_run (i32.const 0))
            (i32.store (call $abs (i32.add (local.get $result_intervals)
              (i32.mul (local.get $result_count) (i32.const 16))))
              (local.get $run_lower_slot))
            (i32.store (call $abs (i32.add (i32.add (local.get $result_intervals)
              (i32.mul (local.get $result_count) (i32.const 16))) (i32.const 4)))
              (local.get $run_lower_closed))
            (i32.store (call $abs (i32.add (i32.add (local.get $result_intervals)
              (i32.mul (local.get $result_count) (i32.const 16))) (i32.const 8)))
              (local.get $boundary_slot))
            (i32.store (call $abs (i32.add (i32.add (local.get $result_intervals)
              (i32.mul (local.get $result_count) (i32.const 16))) (i32.const 12)))
              (i32.const 0))
            (local.set $result_count (i32.add (local.get $result_count) (i32.const 1)))))
        (if (i32.and (local.get $boundary_included) (i32.eqz (local.get $in_run)))
          (then
            ;; A run (possibly a single point) starts closed here.
            (local.set $in_run (i32.const 1))
            (local.set $run_lower_slot (local.get $boundary_slot))
            (local.set $run_lower_closed (i32.const 1))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $sweep)))
    (if (local.get $in_run)
      (then
        (i32.store (call $abs (i32.add (local.get $result_intervals)
          (i32.mul (local.get $result_count) (i32.const 16))))
          (local.get $run_lower_slot))
        (i32.store (call $abs (i32.add (i32.add (local.get $result_intervals)
          (i32.mul (local.get $result_count) (i32.const 16))) (i32.const 4)))
          (local.get $run_lower_closed))
        (i32.store (call $abs (i32.add (i32.add (local.get $result_intervals)
          (i32.mul (local.get $result_count) (i32.const 16))) (i32.const 8)))
          (i32.const 0))
        (i32.store (call $abs (i32.add (i32.add (local.get $result_intervals)
          (i32.mul (local.get $result_count) (i32.const 16))) (i32.const 12)))
          (i32.const 0))
        (local.set $result_count (i32.add (local.get $result_count) (i32.const 1)))))
    ;; Emit.
    (if (call $expression_walk_guard (i32.add (i32.const 1024)
          (i32.mul (local.get $result_count) (i32.const 64))))
      (then (return (i32.const 0))))
    (local.set $result_array (call $allocate_array (local.get $result_count)))
    (local.set $result_data (i32.add
      (i32.load (call $abs (i32.add (local.get $result_array) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (local.set $i (i32.const 0))
    (block $emitted
      (loop $emit
        (br_if $emitted (i32.ge_s (local.get $i) (local.get $result_count)))
        (local.set $record (call $solving_interval_record
          (i32.load (call $abs (i32.add (local.get $result_intervals)
            (i32.mul (local.get $i) (i32.const 16)))))
          (i32.load (call $abs (i32.add (i32.add (local.get $result_intervals)
            (i32.mul (local.get $i) (i32.const 16))) (i32.const 4))))
          (i32.load (call $abs (i32.add (i32.add (local.get $result_intervals)
            (i32.mul (local.get $i) (i32.const 16))) (i32.const 8))))
          (i32.load (call $abs (i32.add (i32.add (local.get $result_intervals)
            (i32.mul (local.get $i) (i32.const 16))) (i32.const 12))))))
        (if (i32.eqz (local.get $record)) (then (return (i32.const 0))))
        (call $write_value (i32.add (local.get $result_data)
          (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
          (global.get $TYPE_OBJECT) (i32.const 0) (local.get $record) (i32.const 0))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $emit)))
    (call $expression_freeze_args_array (local.get $result_array))
    (call $pending_push (global.get $TYPE_ARRAY) (i32.const 0)
      (local.get $result_array) (i32.const 0))
    (i32.const 0)
  )

  ;; signChart(expression, variable) -> frozen Array of { interval, sign }
  ;; entries: open regions with their exact sign and numerator-root points
  ;; with sign zero. Denominator roots are outside the domain and omitted.
  (func $expression_sign_chart_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $work i32)
    (local $difference_slot i32)
    (local $numerator_slot i32)
    (local $denominator_slot i32)
    (local $split i32)
    (local $count i32)
    (local $signs i32)
    (local $records i32)
    (local $entries i32)
    (local $entry_count i32)
    (local $i i32)
    (local $flags i32)
    (local $interval_record i32)
    (local $pairs i32)
    (local $slots i32)
    (local $record i32)
    (local $result_array i32)
    (local $result_data i32)
    (if (i32.eqz (call $solving_two_arguments (local.get $argc) (local.get $stack_base)))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_SOLVING_ARGUMENTS))))))
    (if (i32.ne (call $value_type (global.get $solving_argument2)) (global.get $TYPE_SYMBOL))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_SOLVING_ARGUMENTS))))))
    (if (call $expression_walk_guard (i32.const 8192))
      (then (return (i32.const 0))))
    (local.set $work (call $carve_scratch_blob (i32.const 64)))
    (local.set $difference_slot (local.get $work))
    (local.set $numerator_slot (i32.add (local.get $work) (i32.const 16)))
    (local.set $denominator_slot (i32.add (local.get $work) (i32.const 32)))
    (if (call $expression_simplify_into
          (global.get $solving_argument1) (local.get $difference_slot))
      (then (return (i32.const 0))))
    (local.set $split (call $solving_split_rational_function
      (local.get $difference_slot) (global.get $solving_argument2)
      (local.get $numerator_slot) (local.get $denominator_slot)))
    (if (i32.eq (local.get $split) (i32.const 2)) (then (return (i32.const 0))))
    (if (i32.eq (local.get $split) (i32.const 3))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message
          (global.get $BUILTIN_MSG_SOLVING_UNSUPPORTED))))))
    (if (call $expression_value_is_zero_wide (local.get $numerator_slot))
      (then
        (if (global.get $memory_pressure_signaled) (then (return (i32.const 0))))
        (local.set $interval_record (call $solving_interval_record
          (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)))
        (if (i32.eqz (local.get $interval_record)) (then (return (i32.const 0))))
        (local.set $result_array (call $allocate_array (i32.const 1)))
        (local.set $slots (call $carve_scratch_blob (i32.const 32)))
        (local.set $pairs (call $carve_scratch_blob (i32.const 16)))
        (call $write_value (local.get $slots)
          (global.get $TYPE_OBJECT) (i32.const 0)
          (local.get $interval_record) (i32.const 0))
        (call $write_value (i32.add (local.get $slots) (i32.const 16))
          (global.get $TYPE_BIGINT) (i32.const 0)
          (call $bigint_zero) (i32.const 0))
        (i32.store (call $abs (local.get $pairs)) (global.get $BUILTIN_KEY_INTERVAL))
        (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 4))) (local.get $slots))
        (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 8)))
          (global.get $BUILTIN_KEY_SIGN))
        (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 12)))
          (i32.add (local.get $slots) (i32.const 16)))
        (local.set $record (call $calculus_record (local.get $pairs) (i32.const 2)))
        (if (i32.eqz (local.get $record)) (then (return (i32.const 0))))
        (call $write_value (i32.add
          (i32.load (call $abs (i32.add (local.get $result_array) (i32.const 16))))
          (global.get $GC_HEADER_SIZE))
          (global.get $TYPE_OBJECT) (i32.const 0) (local.get $record) (i32.const 0))
        (call $expression_freeze_args_array (local.get $result_array))
        (call $pending_push (global.get $TYPE_ARRAY) (i32.const 0)
          (local.get $result_array) (i32.const 0))
        (return (i32.const 0))))
    (if (call $solving_sign_analysis (local.get $numerator_slot)
          (if (result i32) (i32.eq (local.get $split) (i32.const 1))
            (then (local.get $denominator_slot)) (else (i32.const 0)))
          (global.get $solving_argument2))
      (then
        (if (global.get $solving_staged_dispatch)
          (then (return (global.get $solving_staged_dispatch))))
        (return (i32.const 0))))
    (local.set $count (global.get $solving_boundary_count))
    (local.set $signs (global.get $solving_region_signs))
    (local.set $records (global.get $solving_boundary_records))
    ;; Entries staging: (interval_lower, lower_closed, interval_upper,
    ;; upper_closed, sign) i32 quints.
    (local.set $entries (call $carve_scratch_blob (i32.const 8192)))
    (local.set $entry_count (i32.const 0))
    (local.set $i (i32.const 0))
    (block $charted
      (loop $chart
        ;; Region i.
        (i32.store (call $abs (i32.add (local.get $entries)
          (i32.mul (local.get $entry_count) (i32.const 20))))
          (if (result i32) (local.get $i)
            (then (i32.add (local.get $records)
              (i32.mul (i32.sub (local.get $i) (i32.const 1)) (i32.const 24))))
            (else (i32.const 0))))
        (i32.store (call $abs (i32.add (i32.add (local.get $entries)
          (i32.mul (local.get $entry_count) (i32.const 20))) (i32.const 4)))
          (i32.const 0))
        (i32.store (call $abs (i32.add (i32.add (local.get $entries)
          (i32.mul (local.get $entry_count) (i32.const 20))) (i32.const 8)))
          (if (result i32) (i32.lt_s (local.get $i) (local.get $count))
            (then (i32.add (local.get $records) (i32.mul (local.get $i) (i32.const 24))))
            (else (i32.const 0))))
        (i32.store (call $abs (i32.add (i32.add (local.get $entries)
          (i32.mul (local.get $entry_count) (i32.const 20))) (i32.const 12)))
          (i32.const 0))
        (i32.store (call $abs (i32.add (i32.add (local.get $entries)
          (i32.mul (local.get $entry_count) (i32.const 20))) (i32.const 16)))
          (i32.load (call $abs (i32.add (local.get $signs)
            (i32.mul (local.get $i) (i32.const 4))))))
        (local.set $entry_count (i32.add (local.get $entry_count) (i32.const 1)))
        (br_if $charted (i32.ge_s (local.get $i) (local.get $count)))
        ;; Boundary i: a numerator root gets a zero-sign point entry.
        (local.set $flags (i32.load (call $abs (i32.add
          (i32.add (local.get $records) (i32.mul (local.get $i) (i32.const 24)))
          (i32.const 16)))))
        (if (i32.eqz (i32.and (local.get $flags) (i32.const 2)))
          (then
            (i32.store (call $abs (i32.add (local.get $entries)
              (i32.mul (local.get $entry_count) (i32.const 20))))
              (i32.add (local.get $records) (i32.mul (local.get $i) (i32.const 24))))
            (i32.store (call $abs (i32.add (i32.add (local.get $entries)
              (i32.mul (local.get $entry_count) (i32.const 20))) (i32.const 4)))
              (i32.const 1))
            (i32.store (call $abs (i32.add (i32.add (local.get $entries)
              (i32.mul (local.get $entry_count) (i32.const 20))) (i32.const 8)))
              (i32.add (local.get $records) (i32.mul (local.get $i) (i32.const 24))))
            (i32.store (call $abs (i32.add (i32.add (local.get $entries)
              (i32.mul (local.get $entry_count) (i32.const 20))) (i32.const 12)))
              (i32.const 1))
            (i32.store (call $abs (i32.add (i32.add (local.get $entries)
              (i32.mul (local.get $entry_count) (i32.const 20))) (i32.const 16)))
              (i32.const 0))
            (local.set $entry_count (i32.add (local.get $entry_count) (i32.const 1)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $chart)))
    ;; Emit { interval, sign } records.
    (if (call $expression_walk_guard (i32.add (i32.const 1024)
          (i32.mul (local.get $entry_count) (i32.const 96))))
      (then (return (i32.const 0))))
    (local.set $result_array (call $allocate_array (local.get $entry_count)))
    (local.set $result_data (i32.add
      (i32.load (call $abs (i32.add (local.get $result_array) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (local.set $slots (call $carve_scratch_blob (i32.const 32)))
    (local.set $pairs (call $carve_scratch_blob (i32.const 16)))
    (local.set $i (i32.const 0))
    (block $emitted
      (loop $emit
        (br_if $emitted (i32.ge_s (local.get $i) (local.get $entry_count)))
        (local.set $interval_record (call $solving_interval_record
          (i32.load (call $abs (i32.add (local.get $entries)
            (i32.mul (local.get $i) (i32.const 20)))))
          (i32.load (call $abs (i32.add (i32.add (local.get $entries)
            (i32.mul (local.get $i) (i32.const 20))) (i32.const 4))))
          (i32.load (call $abs (i32.add (i32.add (local.get $entries)
            (i32.mul (local.get $i) (i32.const 20))) (i32.const 8))))
          (i32.load (call $abs (i32.add (i32.add (local.get $entries)
            (i32.mul (local.get $i) (i32.const 20))) (i32.const 12))))))
        (if (i32.eqz (local.get $interval_record)) (then (return (i32.const 0))))
        (call $write_value (local.get $slots)
          (global.get $TYPE_OBJECT) (i32.const 0)
          (local.get $interval_record) (i32.const 0))
        (call $write_value (i32.add (local.get $slots) (i32.const 16))
          (global.get $TYPE_BIGINT) (i32.const 0)
          (call $bigint_from_i64 (i64.extend_i32_s
            (i32.load (call $abs (i32.add (i32.add (local.get $entries)
              (i32.mul (local.get $i) (i32.const 20))) (i32.const 16))))))
          (i32.const 0))
        (i32.store (call $abs (local.get $pairs)) (global.get $BUILTIN_KEY_INTERVAL))
        (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 4))) (local.get $slots))
        (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 8)))
          (global.get $BUILTIN_KEY_SIGN))
        (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 12)))
          (i32.add (local.get $slots) (i32.const 16)))
        (local.set $record (call $calculus_record (local.get $pairs) (i32.const 2)))
        (if (i32.eqz (local.get $record)) (then (return (i32.const 0))))
        (call $write_value (i32.add (local.get $result_data)
          (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
          (global.get $TYPE_OBJECT) (i32.const 0) (local.get $record) (i32.const 0))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $emit)))
    (call $expression_freeze_args_array (local.get $result_array))
    (call $pending_push (global.get $TYPE_ARRAY) (i32.const 0)
      (local.get $result_array) (i32.const 0))
    (i32.const 0)
  )

  ;; Decide the exact sign of a closed exact value slot.
  ;; Returns -1/0/1, 2 pressure, or 3 undecidable.
  (func $solving_exact_sign (param $slot i32) (result i32)
    (local $type i32)
    (local $header i32)
    (local $blob i32)
    (local $precision i32)
    (local $status i32)
    (local $interval_sign i32)
    (local $zero_status i32)
    (local.set $type (call $value_type (local.get $slot)))
    (if (i32.eq (local.get $type) (global.get $TYPE_BIGINT))
      (then
        (local.set $header (call $value_data_lo (local.get $slot)))
        (if (i32.eqz (call $bigint_length (local.get $header)))
          (then (return (i32.const 0))))
        (if (call $bigint_sign (local.get $header)) (then (return (i32.const -1))))
        (return (i32.const 1))))
    (if (i32.eq (local.get $type) (global.get $TYPE_RATIONAL))
      (then
        (if (call $rational_is_zero (local.get $slot)) (then (return (i32.const 0))))
        (if (call $rational_is_negative (local.get $slot)) (then (return (i32.const -1))))
        (return (i32.const 1))))
    (if (i32.eq (local.get $type) (global.get $TYPE_ALGEBRAIC))
      (then
        (local.set $zero_status (call $algebraic_value_is_zero
          (call $value_data_lo (local.get $slot))))
        (if (i32.eq (local.get $zero_status) (i32.const 2)) (then (return (i32.const 2))))
        (if (local.get $zero_status) (then (return (i32.const 0))))
        ;; Refine the isolating interval until the sign is decided.
        (local.set $blob (call $carve_scratch_blob (i32.const 8)))
        (local.set $precision (i32.const 8))
        (block $decided
          (loop $decide
            (if (call $expression_walk_guard (i32.const 4096))
              (then (return (i32.const 2))))
            (local.set $status (call $approximation_algebraic_interval
              (call $value_data_lo (local.get $slot)) (local.get $precision)
              (local.get $blob)))
            (if (local.get $status) (then (return (i32.const 2))))
            (local.set $interval_sign (call $approximation_interval_sign (local.get $blob)))
            (br_if $decided (i32.ne (local.get $interval_sign) (i32.const 0)))
            (local.set $precision (i32.shl (local.get $precision) (i32.const 1)))
            (if (i32.gt_s (local.get $precision) (i32.const 65536))
              (then (return (i32.const 3))))
            (br $decide)))
        (return (local.get $interval_sign))))
    ;; Transcendental values: the certified interval evaluator at
    ;; increasing precision. A zero value cannot be proved this way, so an
    ;; interval that keeps straddling zero is undecidable.
    (if (i32.or
          (i32.eq (local.get $type) (global.get $TYPE_EXPRESSION))
          (i32.eq (local.get $type) (global.get $TYPE_SYMBOL)))
      (then
        (local.set $blob (call $carve_scratch_blob (i32.const 8)))
        (local.set $precision (i32.const 64))
        (block $evaluated
          (loop $evaluate
            (if (call $expression_walk_guard (i32.const 8192))
              (then (return (i32.const 2))))
            (local.set $status (call $approximation_evaluate
              (local.get $slot) (local.get $precision) (local.get $blob)))
            (if (i32.eq (local.get $status) (i32.const 1)) (then (return (i32.const 2))))
            (if (i32.eq (local.get $status) (i32.const 2)) (then (return (i32.const 3))))
            (if (i32.eqz (local.get $status))
              (then
                (local.set $interval_sign (call $approximation_interval_sign
                  (local.get $blob)))
                (br_if $evaluated (i32.ne (local.get $interval_sign) (i32.const 0)))))
            (local.set $precision (i32.shl (local.get $precision) (i32.const 1)))
            ;; The exact series cost grows superlinearly with precision;
            ;; a relation an enclosure of width 2^-256 cannot decide is
            ;; reported as unknown, never guessed.
            (if (i32.gt_s (local.get $precision) (i32.const 256))
              (then (return (i32.const 3))))
            (br $evaluate)))
        (return (local.get $interval_sign))))
    (i32.const 3)
  )

  ;; satisfies(conditions, variables, values) -> true / false / undefined.
  (func $expression_satisfies_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $conditions_slot i32)
    (local $variables_slot i32)
    (local $values_slot i32)
    (local $conditions_data i32)
    (local $conditions_length i32)
    (local $variables_data i32)
    (local $values_data i32)
    (local $binding_count i32)
    (local $i i32)
    (local $j i32)
    (local $header i32)
    (local $opcode i32)
    (local $data i32)
    (local $work i32)
    (local $value_slot i32)
    (local $sign i32)
    (local $zero_status i32)
    (local $truth i32)
    (local $any_unknown i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then (local.set $conditions_slot (i32.sub (local.get $pending_pointer)
        (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))))
    (if (i32.ge_u (local.get $argc) (i32.const 3))
      (then
        (local.set $variables_slot
          (i32.add (local.get $conditions_slot) (global.get $VALUE_SIZE)))
        (local.set $values_slot
          (i32.add (local.get $variables_slot) (global.get $VALUE_SIZE)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (i32.or
          (i32.or
            (i32.ne (local.get $argc) (i32.const 3))
            (i32.ne (call $value_type (local.get $conditions_slot)) (global.get $TYPE_ARRAY)))
          (i32.or
            (i32.eqz (call $calculus_variables_ok (local.get $variables_slot)))
            (i32.ne (call $value_type (local.get $values_slot)) (global.get $TYPE_ARRAY))))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_SOLVING_ARGUMENTS))))))
    (local.set $binding_count (i32.load (call $abs (i32.add
      (call $value_data_lo (local.get $variables_slot)) (i32.const 8)))))
    (if (i32.ne (local.get $binding_count)
          (i32.load (call $abs (i32.add
            (call $value_data_lo (local.get $values_slot)) (i32.const 8)))))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_SOLVING_ARGUMENTS))))))
    (local.set $conditions_length (i32.load (call $abs (i32.add
      (call $value_data_lo (local.get $conditions_slot)) (i32.const 8)))))
    (local.set $conditions_data (i32.add
      (i32.load (call $abs (i32.add
        (call $value_data_lo (local.get $conditions_slot)) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (local.set $variables_data (i32.add
      (i32.load (call $abs (i32.add
        (call $value_data_lo (local.get $variables_slot)) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (local.set $values_data (i32.add
      (i32.load (call $abs (i32.add
        (call $value_data_lo (local.get $values_slot)) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (if (call $expression_walk_guard (i32.const 4096))
      (then (return (i32.const 0))))
    (local.set $work (call $carve_scratch_blob (i32.const 32)))
    (local.set $value_slot (i32.add (local.get $work) (i32.const 16)))
    (local.set $any_unknown (i32.const 0))
    (local.set $i (i32.const 0))
    (block $conditions_done
      (loop $conditions
        (br_if $conditions_done (i32.ge_u (local.get $i) (local.get $conditions_length)))
        (if (i32.ne (call $value_type (i32.add (local.get $conditions_data)
              (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
              (global.get $TYPE_EXPRESSION))
          (then (return (i32.add (i32.const 1)
            (call $throw_type_error_with_message
              (global.get $BUILTIN_MSG_SOLVING_ARGUMENTS))))))
        (local.set $header (call $value_data_lo (i32.add (local.get $conditions_data)
          (i32.mul (local.get $i) (global.get $VALUE_SIZE)))))
        (local.set $opcode (call $solving_relation_opcode (local.get $header)))
        (if (i32.or
              (i32.eqz (local.get $opcode))
              (i32.ne (call $approximation_expression_argument_count (local.get $header))
                (i32.const 2)))
          (then (return (i32.add (i32.const 1)
            (call $throw_type_error_with_message
              (global.get $BUILTIN_MSG_SOLVING_ARGUMENTS))))))
        (local.set $data (call $approximation_expression_argument_data (local.get $header)))
        ;; difference = lhs - rhs, then bind every variable.
        (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_SUBTRACT)
          (local.get $data) (i32.add (local.get $data) (global.get $VALUE_SIZE))
          (local.get $work))
        (local.set $j (i32.const 0))
        (block $bound
          (loop $bind
            (br_if $bound (i32.ge_u (local.get $j) (local.get $binding_count)))
            (if (call $expression_substitute_into (local.get $work)
                  (call $value_data_lo (i32.add (local.get $variables_data)
                    (i32.mul (local.get $j) (global.get $VALUE_SIZE))))
                  (i32.add (local.get $values_data)
                    (i32.mul (local.get $j) (global.get $VALUE_SIZE)))
                  (local.get $work))
              (then (return (i32.const 0))))
            (local.set $j (i32.add (local.get $j) (i32.const 1)))
            (br $bind)))
        (if (call $expression_simplify_into (local.get $work) (local.get $value_slot))
          (then (return (i32.const 0))))
        ;; Complex values: only equality relations decide.
        (if (i32.or
              (i32.eq (call $value_type (local.get $value_slot)) (global.get $TYPE_COMPLEX))
              (i32.eq (call $value_type (local.get $value_slot))
                (global.get $TYPE_COMPLEX_ALGEBRAIC)))
          (then
            (if (i32.gt_s (local.get $opcode) (i32.const 2))
              (then
                (local.set $any_unknown (i32.const 1))
                (local.set $i (i32.add (local.get $i) (i32.const 1)))
                (br $conditions)))
            (local.set $zero_status (call $solving_value_is_zero (local.get $value_slot)))
            (if (i32.eq (local.get $zero_status) (i32.const 2))
              (then (return (i32.const 0))))
            (if (i32.eq (local.get $zero_status) (i32.const 3))
              (then
                (local.set $any_unknown (i32.const 1))
                (local.set $i (i32.add (local.get $i) (i32.const 1)))
                (br $conditions)))
            (local.set $truth (if (result i32)
                (i32.eq (local.get $opcode) (i32.const 1))
              (then (local.get $zero_status))
              (else (i32.eqz (local.get $zero_status)))))
            (if (i32.eqz (local.get $truth))
              (then
                (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0)
                  (i32.const 0) (i32.const 0))
                (return (i32.const 0))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $conditions)))
        (local.set $sign (call $solving_exact_sign (local.get $value_slot)))
        (if (i32.eq (local.get $sign) (i32.const 2)) (then (return (i32.const 0))))
        (if (i32.eq (local.get $sign) (i32.const 3))
          (then
            (local.set $any_unknown (i32.const 1))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $conditions)))
        (if (i32.eqz (call $solving_relation_accepts
              (local.get $opcode) (local.get $sign)))
          (then
            (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0)
              (i32.const 0) (i32.const 0))
            (return (i32.const 0))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $conditions)))
    (if (local.get $any_unknown)
      (then (call $pending_push (global.get $TYPE_UNDEFINED) (i32.const 0)
        (i32.const 0) (i32.const 0)))
      (else (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0)
        (i32.const 1) (i32.const 0))))
    (i32.const 0)
  )

  ;; Staged internal call to the lexicographic Groebner-basis surface.
  (func $solving_groebner_basis
    (param $expressions_slot i32) (param $variables_slot i32) (param $result_slot i32)
    (result i32)
    (local $saved_pending i32)
    (local $status i32)
    (if (call $expression_walk_guard (i32.const 64))
      (then (return (i32.const 1))))
    (local.set $saved_pending (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (memory.copy (call $abs (local.get $result_slot))
      (call $abs (local.get $expressions_slot)) (global.get $VALUE_SIZE))
    (memory.copy (call $abs (i32.add (local.get $result_slot) (global.get $VALUE_SIZE)))
      (call $abs (local.get $variables_slot)) (global.get $VALUE_SIZE))
    (call $write_ctx (global.get $CTX_PENDING_POINTER)
      (i32.add (local.get $result_slot) (i32.mul (i32.const 2) (global.get $VALUE_SIZE))))
    (local.set $status (call $expression_groebner_method
      (global.get $TYPE_OBJECT) (i32.const 0)
      (global.get $METHOD_EXACT_EXPRESSION_GROEBNER_BASIS)
      (i32.const 2) (local.get $result_slot)))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $saved_pending))
    (global.set $solving_staged_dispatch (local.get $status))
    (if (local.get $status) (then (return (i32.const 1))))
    (if (global.get $memory_pressure_signaled) (then (return (i32.const 1))))
    (i32.const 0)
  )

  ;; Tuple accumulation for solveSystem.
  (global $solving_tuples (mut i32) (i32.const 0))
  (global $solving_tuple_count (mut i32) (i32.const 0))
  (global $solving_variable_count (mut i32) (i32.const 0))

  ;; Recursive back-substitution over the lexicographic basis. `index`
  ;; walks the caller's variables from last to first; `assignments` holds
  ;; value slots for the variables after `index`; `substituted_basis` holds
  ;; the basis with those assignments applied. Status: 0 ok / 1 pressure
  ;; or thrown / 2 positive-dimensional / 3 unsupported.
  (func $solving_system_enumerate
    (param $basis_data i32) (param $basis_count i32)
    (param $variables_data i32) (param $index i32)
    (param $assignments i32)
    (result i32)
    (local $i i32)
    (local $work i32)
    (local $substituted i32)
    (local $slot i32)
    (local $j i32)
    (local $status i32)
    (local $univariate_slot i32)
    (local $zero_status i32)
    (local $roots_slot i32)
    (local $roots_array i32)
    (local $roots_length i32)
    (local $roots_data i32)
    (local $r i32)
    (local $accepted i32)
    (local $check_slot i32)
    (local $tuple_array i32)
    (local $tuple_data i32)
    (if (call $expression_walk_guard (i32.add (i32.const 8192)
          (i32.mul (local.get $basis_count) (i32.const 32))))
      (then (return (i32.const 1))))
    ;; Substitute the assignments made so far into every basis element.
    (local.set $substituted (call $carve_scratch_blob
      (i32.mul (local.get $basis_count) (global.get $VALUE_SIZE))))
    (local.set $i (i32.const 0))
    (block $substituted_done
      (loop $substitute
        (br_if $substituted_done (i32.ge_s (local.get $i) (local.get $basis_count)))
        (local.set $slot (i32.add (local.get $substituted)
          (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
        (memory.copy (call $abs (local.get $slot))
          (call $abs (i32.add (local.get $basis_data)
            (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
          (global.get $VALUE_SIZE))
        (local.set $j (i32.add (local.get $index) (i32.const 1)))
        (block $applied
          (loop $apply
            (br_if $applied (i32.ge_s (local.get $j) (global.get $solving_variable_count)))
            (if (call $expression_substitute_into (local.get $slot)
                  (call $value_data_lo (i32.add (local.get $variables_data)
                    (i32.mul (local.get $j) (global.get $VALUE_SIZE))))
                  (i32.add (local.get $assignments)
                    (i32.mul (local.get $j) (global.get $VALUE_SIZE)))
                  (local.get $slot))
              (then (return (i32.const 1))))
            (local.set $j (i32.add (local.get $j) (i32.const 1)))
            (br $apply)))
        (if (call $expression_simplify_into (local.get $slot) (local.get $slot))
          (then (return (i32.const 1))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $substitute)))
    ;; Fully-assigned tuple: every element must have vanished.
    (if (i32.lt_s (local.get $index) (i32.const 0))
      (then
        (local.set $i (i32.const 0))
        (block $checked
          (loop $check
            (br_if $checked (i32.ge_s (local.get $i) (local.get $basis_count)))
            (local.set $zero_status (call $solving_value_is_zero
              (i32.add (local.get $substituted)
                (i32.mul (local.get $i) (global.get $VALUE_SIZE)))))
            (if (i32.eq (local.get $zero_status) (i32.const 2))
              (then (return (i32.const 1))))
            (if (i32.eq (local.get $zero_status) (i32.const 3))
              (then (return (i32.const 3))))
            (if (i32.eqz (local.get $zero_status)) (then (return (i32.const 0))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $check)))
        ;; Emit the tuple in the caller's variable order.
        (if (i32.ge_s (global.get $solving_tuple_count) (i32.const 128))
          (then (return (i32.const 3))))
        (local.set $tuple_array (call $allocate_array
          (global.get $solving_variable_count)))
        (local.set $tuple_data (i32.add
          (i32.load (call $abs (i32.add (local.get $tuple_array) (i32.const 16))))
          (global.get $GC_HEADER_SIZE)))
        (memory.copy (call $abs (local.get $tuple_data))
          (call $abs (local.get $assignments))
          (i32.mul (global.get $solving_variable_count) (global.get $VALUE_SIZE)))
        (call $expression_freeze_args_array (local.get $tuple_array))
        (i32.store (call $abs (i32.add (global.get $solving_tuples)
          (i32.mul (global.get $solving_tuple_count) (i32.const 4))))
          (local.get $tuple_array))
        (global.set $solving_tuple_count
          (i32.add (global.get $solving_tuple_count) (i32.const 1)))
        (return (i32.const 0))))
    ;; Check every already-numeric element; find a univariate element in
    ;; the current variable.
    (local.set $univariate_slot (i32.const 0))
    (local.set $i (i32.const 0))
    (block $scanned
      (loop $scan
        (br_if $scanned (i32.ge_s (local.get $i) (local.get $basis_count)))
        (local.set $slot (i32.add (local.get $substituted)
          (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
        (local.set $zero_status (call $solving_value_is_zero (local.get $slot)))
        (if (i32.eq (local.get $zero_status) (i32.const 2))
          (then (return (i32.const 1))))
        (if (i32.eq (local.get $zero_status) (i32.const 1))
          (then
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $scan)))
        (if (i32.eqz (local.get $zero_status))
          (then
            ;; A nonzero numeric constant kills this branch.
            (if (i32.ne (call $value_type (local.get $slot)) (global.get $TYPE_EXPRESSION))
              (then (return (i32.const 0))))))
        (if (i32.eqz (local.get $univariate_slot))
          (then
            ;; Univariate in the current variable? The parse succeeds with
            ;; any exact numeric coefficients (status 0 or 5).
            (local.set $status (call $solving_parse_polynomial (local.get $slot)
              (i32.add (local.get $variables_data)
                (i32.mul (local.get $index) (global.get $VALUE_SIZE)))))
            (if (i32.eq (local.get $status) (i32.const 1))
              (then (return (i32.const 1))))
            (if (i32.and
                  (i32.or (i32.eqz (local.get $status))
                    (i32.eq (local.get $status) (i32.const 5)))
                  (i32.and
                    (i32.ge_s (global.get $solving_parsed_degree) (i32.const 1))
                    (i32.eqz (global.get $solving_parsed_symbolic))))
              (then (local.set $univariate_slot (local.get $slot))))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $scan)))
    (if (i32.eqz (local.get $univariate_slot))
      (then (return (i32.const 2))))
    ;; Candidate values for the current variable. A linear equation is
    ;; solved directly by exact closed-field division (the roots engine is
    ;; not consulted); higher degrees go through the complex-roots engine.
    (local.set $roots_slot (call $carve_scratch_blob (i32.const 48)))
    (local.set $status (call $solving_parse_polynomial (local.get $univariate_slot)
      (i32.add (local.get $variables_data)
        (i32.mul (local.get $index) (global.get $VALUE_SIZE)))))
    (if (i32.eq (local.get $status) (i32.const 1)) (then (return (i32.const 1))))
    (if (i32.eq (global.get $solving_parsed_degree) (i32.const 1))
      (then
        ;; root = -(c0 / c1).
        (local.set $roots_data (call $carve_scratch_blob (i32.const 32)))
        (local.set $status (call $algebraic_slot_arith (i32.const 3)
          (global.get $solving_parsed_coefficients)
          (i32.add (global.get $solving_parsed_coefficients) (global.get $VALUE_SIZE))
          (local.get $roots_data)))
        (if (local.get $status) (then (return (i32.const 1))))
        (call $write_inline_rational
          (i32.add (local.get $roots_data) (global.get $VALUE_SIZE)) (i64.const -1))
        (local.set $status (call $algebraic_slot_arith (i32.const 2)
          (local.get $roots_data)
          (i32.add (local.get $roots_data) (global.get $VALUE_SIZE))
          (local.get $roots_data)))
        (if (local.get $status) (then (return (i32.const 1))))
        (local.set $roots_length (i32.const 1)))
      (else
        (if (call $solving_complex_roots (local.get $univariate_slot)
              (i32.add (local.get $variables_data)
                (i32.mul (local.get $index) (global.get $VALUE_SIZE)))
              (local.get $roots_slot))
          (then (return (i32.const 1))))
        (local.set $roots_array (call $value_data_lo (local.get $roots_slot)))
        (local.set $roots_length (i32.load (call $abs
          (i32.add (local.get $roots_array) (i32.const 8)))))
        (local.set $roots_data (i32.add
          (i32.load (call $abs (i32.add (local.get $roots_array) (i32.const 16))))
          (global.get $GC_HEADER_SIZE)))
        ;; A univariate polynomial of positive degree always has complex
        ;; roots; an empty result is an engine limitation — fail loudly.
        (if (i32.eqz (local.get $roots_length))
          (then (return (i32.const 3))))))
    (local.set $check_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (local.set $r (i32.const 0))
    (block $roots_done
      (loop $roots
        (br_if $roots_done (i32.ge_u (local.get $r) (local.get $roots_length)))
        ;; Filter: the candidate must vanish in every other element that is
        ;; univariate in this variable.
        (local.set $accepted (i32.const 1))
        (local.set $i (i32.const 0))
        (block $filtered
          (loop $filter
            (br_if $filtered (i32.ge_s (local.get $i) (local.get $basis_count)))
            (local.set $slot (i32.add (local.get $substituted)
              (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
            (if (i32.and
                  (i32.eq (call $value_type (local.get $slot)) (global.get $TYPE_EXPRESSION))
                  (i32.ne (local.get $slot) (local.get $univariate_slot)))
              (then
                (local.set $status (call $solving_parse_polynomial (local.get $slot)
                  (i32.add (local.get $variables_data)
                    (i32.mul (local.get $index) (global.get $VALUE_SIZE)))))
                (if (i32.eq (local.get $status) (i32.const 1))
                  (then (return (i32.const 1))))
                (if (i32.and
                      (i32.or (i32.eqz (local.get $status))
                        (i32.eq (local.get $status) (i32.const 5)))
                      (i32.and
                        (i32.ge_s (global.get $solving_parsed_degree) (i32.const 1))
                        (i32.eqz (global.get $solving_parsed_symbolic))))
                  (then
                    (if (call $expression_substitute_into (local.get $slot)
                          (call $value_data_lo (i32.add (local.get $variables_data)
                            (i32.mul (local.get $index) (global.get $VALUE_SIZE))))
                          (i32.add (local.get $roots_data)
                            (i32.mul (local.get $r) (global.get $VALUE_SIZE)))
                          (local.get $check_slot))
                      (then (return (i32.const 1))))
                    (if (call $expression_simplify_into
                          (local.get $check_slot) (local.get $check_slot))
                      (then (return (i32.const 1))))
                    (local.set $zero_status (call $solving_value_is_zero
                      (local.get $check_slot)))
                    (if (i32.eq (local.get $zero_status) (i32.const 2))
                      (then (return (i32.const 1))))
                    (if (i32.eq (local.get $zero_status) (i32.const 3))
                      (then (return (i32.const 3))))
                    (if (i32.eqz (local.get $zero_status))
                      (then
                        (local.set $accepted (i32.const 0))
                        (br $filtered)))))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $filter)))
        (if (local.get $accepted)
          (then
            (memory.copy (call $abs (i32.add (local.get $assignments)
              (i32.mul (local.get $index) (global.get $VALUE_SIZE))))
              (call $abs (i32.add (local.get $roots_data)
                (i32.mul (local.get $r) (global.get $VALUE_SIZE))))
              (global.get $VALUE_SIZE))
            (local.set $status (call $solving_system_enumerate
              (local.get $basis_data) (local.get $basis_count)
              (local.get $variables_data)
              (i32.sub (local.get $index) (i32.const 1))
              (local.get $assignments)))
            (if (local.get $status) (then (return (local.get $status))))))
        (local.set $r (i32.add (local.get $r) (i32.const 1)))
        (br $roots)))
    (i32.const 0)
  )

  ;; solveSystem(expressions, variables) -> frozen Array of frozen exact
  ;; solution tuples in the caller's variable order. Rejects systems that
  ;; are not zero-dimensional.
  (func $expression_solve_system_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $variable_count i32)
    (local $basis_slot i32)
    (local $basis_array i32)
    (local $basis_count i32)
    (local $basis_data i32)
    (local $assignments i32)
    (local $status i32)
    (local $result_array i32)
    (local $result_data i32)
    (local $i i32)
    (if (i32.eqz (call $solving_two_arguments (local.get $argc) (local.get $stack_base)))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_SOLVING_ARGUMENTS))))))
    (if (i32.or
          (i32.ne (call $value_type (global.get $solving_argument1)) (global.get $TYPE_ARRAY))
          (i32.eqz (call $calculus_variables_ok (global.get $solving_argument2))))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_SOLVING_ARGUMENTS))))))
    (local.set $variable_count (i32.load (call $abs (i32.add
      (call $value_data_lo (global.get $solving_argument2)) (i32.const 8)))))
    (if (i32.eqz (local.get $variable_count))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_SOLVING_ARGUMENTS))))))
    (if (call $expression_walk_guard (i32.add (i32.const 8192)
          (i32.mul (local.get $variable_count) (i32.const 32))))
      (then (return (i32.const 0))))
    (local.set $basis_slot (call $carve_scratch_blob (i32.const 48)))
    (if (call $solving_groebner_basis (global.get $solving_argument1)
          (global.get $solving_argument2) (local.get $basis_slot))
      (then
        (if (global.get $solving_staged_dispatch)
          (then (return (global.get $solving_staged_dispatch))))
        (return (i32.const 0))))
    (local.set $basis_array (call $value_data_lo (local.get $basis_slot)))
    (local.set $basis_count (i32.load (call $abs
      (i32.add (local.get $basis_array) (i32.const 8)))))
    (local.set $basis_data (i32.add
      (i32.load (call $abs (i32.add (local.get $basis_array) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (global.set $solving_variable_count (local.get $variable_count))
    (global.set $solving_tuples (call $carve_scratch_blob (i32.const 512)))
    (global.set $solving_tuple_count (i32.const 0))
    (local.set $assignments (call $carve_scratch_blob
      (i32.mul (local.get $variable_count) (global.get $VALUE_SIZE))))
    (local.set $status (call $solving_system_enumerate
      (local.get $basis_data) (local.get $basis_count)
      (i32.add
        (i32.load (call $abs (i32.add
          (call $value_data_lo (global.get $solving_argument2)) (i32.const 16))))
        (global.get $GC_HEADER_SIZE))
      (i32.sub (local.get $variable_count) (i32.const 1))
      (local.get $assignments)))
    (if (i32.eq (local.get $status) (i32.const 1))
      (then
        (if (global.get $solving_staged_dispatch)
          (then (return (global.get $solving_staged_dispatch))))
        (return (i32.const 0))))
    (if (i32.eq (local.get $status) (i32.const 2))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message
          (global.get $BUILTIN_MSG_SOLVING_POSITIVE_DIMENSIONAL))))))
    (if (i32.eq (local.get $status) (i32.const 3))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message
          (global.get $BUILTIN_MSG_SOLVING_UNSUPPORTED))))))
    (if (call $expression_walk_guard (i32.add (i32.const 1024)
          (i32.mul (global.get $solving_tuple_count) (i32.const 32))))
      (then (return (i32.const 0))))
    (local.set $result_array (call $allocate_array (global.get $solving_tuple_count)))
    (local.set $result_data (i32.add
      (i32.load (call $abs (i32.add (local.get $result_array) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (local.set $i (i32.const 0))
    (block $emitted
      (loop $emit
        (br_if $emitted (i32.ge_s (local.get $i) (global.get $solving_tuple_count)))
        (call $write_value (i32.add (local.get $result_data)
          (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
          (global.get $TYPE_ARRAY) (i32.const 0)
          (i32.load (call $abs (i32.add (global.get $solving_tuples)
            (i32.mul (local.get $i) (i32.const 4)))))
          (i32.const 0))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $emit)))
    (call $expression_freeze_args_array (local.get $result_array))
    (call $pending_push (global.get $TYPE_ARRAY) (i32.const 0)
      (local.get $result_array) (i32.const 0))
    (i32.const 0)
  )

  ;; Rebuild Power(base, exponent) as a symbolic node (fold refusal path).
  ;; Returns walk status.
  (func $expression_write_power_symbolic
    (param $base_slot i32) (param $exponent_slot i32) (param $dest_slot i32)
    (result i32)
    (if (call $expression_walk_guard (i32.const 128))
      (then (return (i32.const 1))))
    (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_POWER)
      (local.get $base_slot) (local.get $exponent_slot) (local.get $dest_slot))
    (i32.const 0)
  )

  ;; Exact integer power of an algebraic-valued slot by repeated
  ;; closed-field multiplication; reciprocal for negative exponents.
  ;; Returns walk status (nonzero aborts the fold for a retry).
  (func $expression_fold_algebraic_power
    (param $base_slot i32) (param $magnitude i32) (param $negative i32)
    (param $dest_slot i32)
    (result i32)
    (local $accumulator i32)
    (local $one_slot i32)
    (local $i i32)
    (local $status i32)
    (if (call $expression_walk_guard (i32.const 1024))
      (then (return (i32.const 1))))
    (local.set $accumulator (call $carve_scratch_blob (i32.const 32)))
    (local.set $one_slot (i32.add (local.get $accumulator) (i32.const 16)))
    (call $write_inline_rational (local.get $accumulator) (i64.const 1))
    (local.set $i (i32.const 0))
    (block $powered
      (loop $power
        (br_if $powered (i32.ge_u (local.get $i) (local.get $magnitude)))
        (if (i32.eq (call $value_type (local.get $base_slot))
              (global.get $TYPE_COMPLEX_ALGEBRAIC))
          (then (local.set $status (call $complex_algebraic_slot_arith (i32.const 2)
            (local.get $accumulator) (local.get $base_slot) (local.get $accumulator))))
          (else (local.set $status (call $algebraic_slot_arith (i32.const 2)
            (local.get $accumulator) (local.get $base_slot) (local.get $accumulator)))))
        (if (local.get $status) (then (return (i32.const 1))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $power)))
    (if (local.get $negative)
      (then
        (call $write_inline_rational (local.get $one_slot) (i64.const 1))
        (if (i32.eq (call $value_type (local.get $accumulator))
              (global.get $TYPE_COMPLEX_ALGEBRAIC))
          (then (local.set $status (call $complex_algebraic_slot_arith (i32.const 3)
            (local.get $one_slot) (local.get $accumulator) (local.get $accumulator))))
          (else (local.set $status (call $algebraic_slot_arith (i32.const 3)
            (local.get $one_slot) (local.get $accumulator) (local.get $accumulator)))))
        (if (local.get $status) (then (return (i32.const 1))))))
    (memory.copy (call $abs (local.get $dest_slot))
      (call $abs (local.get $accumulator)) (global.get $VALUE_SIZE))
    (i32.const 0)
  )

  ;; ==========================================================================
  ;; Verified symbolic integration.
  ;;
  ;; A bounded search over the supported integrand classes; every candidate
  ;; is verified by exact symbolic differentiation before it is returned.
  ;; Unsupported forms return an explicit unevaluated Integral expression.
  ;; No float and no quadrature anywhere.
  ;; ==========================================================================

  (global $METHOD_EXACT_EXPRESSION_INTEGRAL i32 (i32.const 0x2AE))
  (global $METHOD_EXACT_EXPRESSION_DEFINITE_INTEGRAL i32 (i32.const 0x2AF))
  (global $METHOD_EXACT_EXPRESSION_ANTIDERIVATIVE i32 (i32.const 0x2B0))
  (global $BUILTIN_EXPRESSION_HEAD_INTEGRAL i32 (i32.const 0x698))
  (global $BUILTIN_LIT_INTEGRAL_VERIFIED i32 (i32.const 0x69C))
  (global $BUILTIN_LIT_INTEGRAL_UNEVALUATED i32 (i32.const 0x6A0))
  (global $BUILTIN_MSG_INTEGRAL_ARGUMENTS i32 (i32.const 0x6A4))

  ;; Build an unevaluated Integral node (2 or 4 args) into dest.
  (func $integration_build_node
    (param $integrand_slot i32) (param $variable_slot i32)
    (param $lower_slot i32) (param $upper_slot i32)
    (param $dest_slot i32)
    (result i32)
    (local $args i32)
    (local $data i32)
    (local $count i32)
    (local.set $count (if (result i32) (local.get $lower_slot)
      (then (i32.const 4)) (else (i32.const 2))))
    (if (call $expression_walk_guard (i32.add (i32.const 128)
          (i32.mul (local.get $count) (global.get $VALUE_SIZE))))
      (then (return (i32.const 1))))
    (local.set $args (call $allocate_array (local.get $count)))
    (local.set $data (i32.add
      (i32.load (call $abs (i32.add (local.get $args) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (memory.copy (call $abs (local.get $data))
      (call $abs (local.get $integrand_slot)) (global.get $VALUE_SIZE))
    (memory.copy (call $abs (i32.add (local.get $data) (global.get $VALUE_SIZE)))
      (call $abs (local.get $variable_slot)) (global.get $VALUE_SIZE))
    (if (local.get $lower_slot)
      (then
        (memory.copy (call $abs (i32.add (local.get $data) (i32.const 32)))
          (call $abs (local.get $lower_slot)) (global.get $VALUE_SIZE))
        (memory.copy (call $abs (i32.add (local.get $data) (i32.const 48)))
          (call $abs (local.get $upper_slot)) (global.get $VALUE_SIZE))))
    (call $expression_freeze_args_array (local.get $args))
    (call $write_value (local.get $dest_slot)
      (global.get $TYPE_EXPRESSION) (i32.const 0)
      (call $expression_build
        (call $symbol_registry_lookup
          (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_INTEGRAL)))
        (local.get $args))
      (i32.const 0))
    (i32.const 0)
  )

  ;; Safe structural simplification for an Integral node whose arguments
  ;; are already simplified (new_data points at the fresh args data,
  ;; GC-header offset NOT yet applied). Returns 1 when it wrote dest, 0 to
  ;; fall through to the generic rebuild, 2 on pressure.
  (func $integration_simplify_integral
    (param $new_data i32) (param $length i32) (param $dest_slot i32)
    (result i32)
    (local $data i32)
    (local $integrand_slot i32)
    (local $variable_slot i32)
    (local $header i32)
    (local $inner_count i32)
    (local $inner_data i32)
    (local $i i32)
    (local $work i32)
    (local $free_slot i32)
    (local $dependent_slot i32)
    (local $have_free i32)
    (local $have_dependent i32)
    (local $contains i32)
    (local $status i32)
    (if (i32.and (i32.ne (local.get $length) (i32.const 2))
          (i32.ne (local.get $length) (i32.const 4)))
      (then (return (i32.const 0))))
    (local.set $data (i32.add (local.get $new_data) (global.get $GC_HEADER_SIZE)))
    (local.set $integrand_slot (local.get $data))
    (local.set $variable_slot (i32.add (local.get $data) (global.get $VALUE_SIZE)))
    (if (i32.ne (call $value_type (local.get $variable_slot)) (global.get $TYPE_SYMBOL))
      (then (return (i32.const 0))))
    ;; An integral of exact zero is zero.
    (if (call $expression_value_is_zero_wide (local.get $integrand_slot))
      (then
        (if (global.get $memory_pressure_signaled) (then (return (i32.const 2))))
        (call $write_inline_rational (local.get $dest_slot) (i64.const 0))
        (return (i32.const 1))))
    (if (global.get $memory_pressure_signaled) (then (return (i32.const 2))))
    ;; A definite integral with equal bounds is zero.
    (if (i32.eq (local.get $length) (i32.const 4))
      (then
        (if (call $expression_values_equal
              (i32.add (local.get $data) (i32.const 32))
              (i32.add (local.get $data) (i32.const 48)))
          (then
            (if (global.get $memory_pressure_signaled) (then (return (i32.const 2))))
            (call $write_inline_rational (local.get $dest_slot) (i64.const 0))
            (return (i32.const 1))))
        (if (global.get $memory_pressure_signaled) (then (return (i32.const 2))))))
    (if (i32.ne (call $value_type (local.get $integrand_slot)) (global.get $TYPE_EXPRESSION))
      (then (return (i32.const 0))))
    (local.set $header (call $value_data_lo (local.get $integrand_slot)))
    ;; Linearity: Integral(Add(...), v, ...) -> Add of Integrals.
    (if (call $approximation_head_is (local.get $header)
          (global.get $BUILTIN_EXPRESSION_HEAD_ADD))
      (then
        (local.set $inner_count (call $approximation_expression_argument_count
          (local.get $header)))
        (local.set $inner_data (call $approximation_expression_argument_data
          (local.get $header)))
        (if (i32.eqz (local.get $inner_count)) (then (return (i32.const 0))))
        (if (call $expression_walk_guard (i32.add (i32.const 512)
              (i32.mul (local.get $inner_count) (i32.const 96))))
          (then (return (i32.const 2))))
        (local.set $work (call $carve_scratch_blob (i32.const 32)))
        (local.set $i (i32.const 0))
        (block $distributed
          (loop $distribute
            (br_if $distributed (i32.ge_s (local.get $i) (local.get $inner_count)))
            (if (call $integration_build_node
                  (i32.add (local.get $inner_data)
                    (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
                  (local.get $variable_slot)
                  (if (result i32) (i32.eq (local.get $length) (i32.const 4))
                    (then (i32.add (local.get $data) (i32.const 32))) (else (i32.const 0)))
                  (i32.add (local.get $data) (i32.const 48))
                  (i32.add (local.get $work) (i32.const 16)))
              (then (return (i32.const 2))))
            (if (local.get $i)
              (then (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_ADD)
                (local.get $work) (i32.add (local.get $work) (i32.const 16))
                (local.get $work)))
              (else (memory.copy (call $abs (local.get $work))
                (call $abs (i32.add (local.get $work) (i32.const 16)))
                (global.get $VALUE_SIZE))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $distribute)))
        (if (call $expression_simplify_into (local.get $work) (local.get $dest_slot))
          (then (return (i32.const 2))))
        (return (i32.const 1))))
    ;; A factor independent of the bound variable moves outside.
    (if (call $approximation_head_is (local.get $header)
          (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY))
      (then
        (local.set $inner_count (call $approximation_expression_argument_count
          (local.get $header)))
        (local.set $inner_data (call $approximation_expression_argument_data
          (local.get $header)))
        (if (call $expression_walk_guard (i32.const 1024))
          (then (return (i32.const 2))))
        (local.set $work (call $carve_scratch_blob (i32.const 64)))
        (local.set $free_slot (local.get $work))
        (local.set $dependent_slot (i32.add (local.get $work) (i32.const 16)))
        (local.set $have_free (i32.const 0))
        (local.set $have_dependent (i32.const 0))
        (local.set $i (i32.const 0))
        (block $partitioned
          (loop $partition
            (br_if $partitioned (i32.ge_s (local.get $i) (local.get $inner_count)))
            (local.set $contains (call $expression_contains_value
              (i32.add (local.get $inner_data)
                (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
              (local.get $variable_slot)))
            (if (global.get $memory_pressure_signaled) (then (return (i32.const 2))))
            (if (local.get $contains)
              (then
                (if (local.get $have_dependent)
                  (then (call $build_raw_expr2
                    (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
                    (local.get $dependent_slot)
                    (i32.add (local.get $inner_data)
                      (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
                    (local.get $dependent_slot)))
                  (else
                    (memory.copy (call $abs (local.get $dependent_slot))
                      (call $abs (i32.add (local.get $inner_data)
                        (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
                      (global.get $VALUE_SIZE))
                    (local.set $have_dependent (i32.const 1)))))
              (else
                (if (local.get $have_free)
                  (then (call $build_raw_expr2
                    (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
                    (local.get $free_slot)
                    (i32.add (local.get $inner_data)
                      (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
                    (local.get $free_slot)))
                  (else
                    (memory.copy (call $abs (local.get $free_slot))
                      (call $abs (i32.add (local.get $inner_data)
                        (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
                      (global.get $VALUE_SIZE))
                    (local.set $have_free (i32.const 1))))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $partition)))
        (if (i32.eqz (local.get $have_free)) (then (return (i32.const 0))))
        (if (i32.eqz (local.get $have_dependent))
          (then (call $write_inline_rational (local.get $dependent_slot) (i64.const 1))))
        (if (call $integration_build_node
              (local.get $dependent_slot) (local.get $variable_slot)
              (if (result i32) (i32.eq (local.get $length) (i32.const 4))
                (then (i32.add (local.get $data) (i32.const 32))) (else (i32.const 0)))
              (i32.add (local.get $data) (i32.const 48))
              (local.get $dependent_slot))
          (then (return (i32.const 2))))
        (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
          (local.get $free_slot) (local.get $dependent_slot) (local.get $free_slot))
        (if (call $expression_simplify_into (local.get $free_slot) (local.get $dest_slot))
          (then (return (i32.const 2))))
        (return (i32.const 1))))
    (i32.const 0)
  )

  ;; Parse `candidate` as a linear polynomial a*variable + b with closed
  ;; rational coefficients. Writes the exact Rational headers of a and b to
  ;; the out words. Returns 1 on match, 0 otherwise, 2 on pressure.
  (func $integration_linear_argument
    (param $candidate_slot i32) (param $variable_slot i32)
    (param $a_out i32) (param $b_out i32)
    (result i32)
    (local $status i32)
    (local $slot i32)
    (local.set $status (call $solving_parse_polynomial
      (local.get $candidate_slot) (local.get $variable_slot)))
    (if (i32.eq (local.get $status) (i32.const 1)) (then (return (i32.const 2))))
    (if (local.get $status) (then (return (i32.const 0))))
    (if (i32.ne (global.get $solving_parsed_degree) (i32.const 1))
      (then (return (i32.const 0))))
    (local.set $slot (global.get $solving_parsed_coefficients))
    (i32.store (call $abs (local.get $b_out))
      (call $solving_rational_bound (local.get $slot) (i32.const 0)))
    (i32.store (call $abs (local.get $a_out))
      (call $solving_rational_bound
        (i32.add (local.get $slot) (global.get $VALUE_SIZE)) (i32.const 0)))
    (i32.const 1)
  )

  ;; The bounded antiderivative search. Writes an UNVERIFIED candidate into
  ;; dest. Log rules push their positivity conditions onto the calculus
  ;; condition list. Status: 0 candidate / 4 unsupported / 1 pressure.
  (func $integration_antiderivative
    (param $integrand_slot i32) (param $variable_slot i32) (param $dest_slot i32)
    (param $depth i32)
    (result i32)
    (local $type i32)
    (local $header i32)
    (local $count i32)
    (local $data i32)
    (local $work i32)
    (local $left i32)
    (local $right i32)
    (local $extra i32)
    (local $status i32)
    (local $i i32)
    (local $contains i32)
    (local $have_free i32)
    (local $have_dependent i32)
    (local $kind i32)
    (local $a_out i32)
    (local $b_out i32)
    (local $exponent_header i32)
    (local $one_header i32)
    (local $next_header i32)
    (if (i32.gt_s (local.get $depth) (i32.const 16))
      (then (return (i32.const 4))))
    (if (call $expression_walk_guard (i32.const 8192))
      (then (return (i32.const 1))))
    (local.set $work (call $carve_scratch_blob (i32.const 96)))
    (local.set $left (local.get $work))
    (local.set $right (i32.add (local.get $work) (i32.const 16)))
    (local.set $extra (i32.add (local.get $work) (i32.const 32)))
    (local.set $a_out (i32.add (local.get $work) (i32.const 48)))
    (local.set $b_out (i32.add (local.get $work) (i32.const 52)))
    ;; A value with no occurrence of the variable integrates to c*x.
    (local.set $contains (call $expression_contains_value
      (local.get $integrand_slot) (local.get $variable_slot)))
    (if (global.get $memory_pressure_signaled) (then (return (i32.const 1))))
    (if (i32.eqz (local.get $contains))
      (then
        (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
          (local.get $integrand_slot) (local.get $variable_slot) (local.get $dest_slot))
        (return (i32.const 0))))
    (local.set $type (call $value_type (local.get $integrand_slot)))
    ;; The bare variable.
    (if (i32.eq (local.get $type) (global.get $TYPE_SYMBOL))
      (then
        (call $write_inline_rational (local.get $extra) (i64.const 2))
        (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_POWER)
          (local.get $variable_slot) (local.get $extra) (local.get $left))
        (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_DIVIDE)
          (local.get $left) (local.get $extra) (local.get $dest_slot))
        (return (i32.const 0))))
    (if (i32.ne (local.get $type) (global.get $TYPE_EXPRESSION))
      (then (return (i32.const 4))))
    (local.set $header (call $value_data_lo (local.get $integrand_slot)))
    (local.set $count (call $approximation_expression_argument_count (local.get $header)))
    (local.set $data (call $approximation_expression_argument_data (local.get $header)))
    ;; Linearity over a finite sum.
    (if (call $approximation_head_is (local.get $header)
          (global.get $BUILTIN_EXPRESSION_HEAD_ADD))
      (then
        (if (i32.eqz (local.get $count)) (then (return (i32.const 4))))
        (local.set $i (i32.const 0))
        (block $summed
          (loop $sum
            (br_if $summed (i32.ge_s (local.get $i) (local.get $count)))
            (local.set $status (call $integration_antiderivative
              (i32.add (local.get $data) (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
              (local.get $variable_slot) (local.get $right)
              (i32.add (local.get $depth) (i32.const 1))))
            (if (local.get $status) (then (return (local.get $status))))
            (if (local.get $i)
              (then (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_ADD)
                (local.get $left) (local.get $right) (local.get $left)))
              (else (memory.copy (call $abs (local.get $left))
                (call $abs (local.get $right)) (global.get $VALUE_SIZE))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $sum)))
        (memory.copy (call $abs (local.get $dest_slot))
          (call $abs (local.get $left)) (global.get $VALUE_SIZE))
        (return (i32.const 0))))
    ;; Subtract and Negate reduce to linearity.
    (if (i32.and
          (call $approximation_head_is (local.get $header)
            (global.get $BUILTIN_EXPRESSION_HEAD_SUBTRACT))
          (i32.eq (local.get $count) (i32.const 2)))
      (then
        (local.set $status (call $integration_antiderivative (local.get $data)
          (local.get $variable_slot) (local.get $left)
          (i32.add (local.get $depth) (i32.const 1))))
        (if (local.get $status) (then (return (local.get $status))))
        (local.set $status (call $integration_antiderivative
          (i32.add (local.get $data) (global.get $VALUE_SIZE))
          (local.get $variable_slot) (local.get $right)
          (i32.add (local.get $depth) (i32.const 1))))
        (if (local.get $status) (then (return (local.get $status))))
        (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_SUBTRACT)
          (local.get $left) (local.get $right) (local.get $dest_slot))
        (return (i32.const 0))))
    (if (i32.and
          (call $approximation_head_is (local.get $header)
            (global.get $BUILTIN_EXPRESSION_HEAD_NEGATE))
          (i32.eq (local.get $count) (i32.const 1)))
      (then
        (local.set $status (call $integration_antiderivative (local.get $data)
          (local.get $variable_slot) (local.get $left)
          (i32.add (local.get $depth) (i32.const 1))))
        (if (local.get $status) (then (return (local.get $status))))
        (call $build_raw_expr1 (global.get $BUILTIN_EXPRESSION_HEAD_NEGATE)
          (local.get $left) (local.get $dest_slot))
        (return (i32.const 0))))
    ;; Multiply: pull constant factors out; then a recognized product may
    ;; use bounded integration by parts.
    (if (call $approximation_head_is (local.get $header)
          (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY))
      (then
        ;; Flatten nested Multiply factors one level so integration by
        ;; parts sees a flat factor list (a raw u' like Multiply(2, x)
        ;; must contribute its constant to the free part).
        (local.set $kind (i32.const 0))
        (local.set $i (i32.const 0))
        (block $flat_scan_done
          (loop $flat_scan
            (br_if $flat_scan_done (i32.ge_s (local.get $i) (local.get $count)))
            (local.set $extra (i32.add (local.get $data)
              (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
            (if (i32.eq (call $value_type (local.get $extra)) (global.get $TYPE_EXPRESSION))
              (then
                (if (call $approximation_head_is (call $value_data_lo (local.get $extra))
                      (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY))
                  (then (local.set $kind (i32.const 1))))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $flat_scan)))
        (if (local.get $kind)
          (then
            (local.set $status (call $integration_flatten_product
              (local.get $data) (local.get $count)))
            (if (i32.eqz (local.get $status)) (then (return (i32.const 1))))
            (local.set $data (local.get $status))
            (local.set $count (global.get $integration_flat_count))))
        (local.set $extra (i32.add (local.get $work) (i32.const 32)))
        (local.set $have_free (i32.const 0))
        (local.set $have_dependent (i32.const 0))
        (local.set $i (i32.const 0))
        (block $partitioned
          (loop $partition
            (br_if $partitioned (i32.ge_s (local.get $i) (local.get $count)))
            (local.set $contains (call $expression_contains_value
              (i32.add (local.get $data) (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
              (local.get $variable_slot)))
            (if (global.get $memory_pressure_signaled) (then (return (i32.const 1))))
            (if (local.get $contains)
              (then
                (if (local.get $have_dependent)
                  (then (call $build_raw_expr2
                    (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
                    (local.get $right)
                    (i32.add (local.get $data)
                      (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
                    (local.get $right)))
                  (else
                    (memory.copy (call $abs (local.get $right))
                      (call $abs (i32.add (local.get $data)
                        (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
                      (global.get $VALUE_SIZE))
                    (local.set $have_dependent (i32.const 1)))))
              (else
                (if (local.get $have_free)
                  (then (call $build_raw_expr2
                    (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
                    (local.get $left)
                    (i32.add (local.get $data)
                      (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
                    (local.get $left)))
                  (else
                    (memory.copy (call $abs (local.get $left))
                      (call $abs (i32.add (local.get $data)
                        (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
                      (global.get $VALUE_SIZE))
                    (local.set $have_free (i32.const 1))))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $partition)))
        (if (local.get $have_free)
          (then
            (if (i32.eqz (local.get $have_dependent))
              (then (call $write_inline_rational (local.get $right) (i64.const 1))))
            (local.set $status (call $integration_antiderivative (local.get $right)
              (local.get $variable_slot) (local.get $extra)
              (i32.add (local.get $depth) (i32.const 1))))
            (if (local.get $status) (then (return (local.get $status))))
            (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
              (local.get $left) (local.get $extra) (local.get $dest_slot))
            (return (i32.const 0))))
        ;; All factors depend on the variable: try the rational-function
        ;; route, then bounded integration by parts.
        (local.set $status (call $integration_rational_function
          (local.get $integrand_slot) (local.get $variable_slot) (local.get $dest_slot)))
        (if (i32.ne (local.get $status) (i32.const 4))
          (then (return (local.get $status))))
        (return (call $integration_by_parts
          (local.get $integrand_slot) (local.get $variable_slot) (local.get $dest_slot)
          (local.get $depth)))))
    ;; Exp of a linear argument: Exp(a x + b) / a.
    (if (i32.and
          (call $approximation_head_is (local.get $header)
            (global.get $BUILTIN_EXPRESSION_HEAD_EXP))
          (i32.eq (local.get $count) (i32.const 1)))
      (then
        (local.set $status (call $integration_linear_argument (local.get $data)
          (local.get $variable_slot) (local.get $a_out) (local.get $b_out)))
        (if (i32.eq (local.get $status) (i32.const 2)) (then (return (i32.const 1))))
        (if (i32.eqz (local.get $status)) (then (return (i32.const 4))))
        (call $write_value (local.get $extra)
          (global.get $TYPE_RATIONAL) (i32.const 0)
          (i32.load (call $abs (local.get $a_out))) (i32.const 0))
        (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_DIVIDE)
          (local.get $integrand_slot) (local.get $extra) (local.get $dest_slot))
        (return (i32.const 0))))
    ;; Sine / cosine trees with a linear argument.
    (local.set $kind (call $approximation_match_trigonometric (local.get $integrand_slot)))
    (if (global.get $memory_pressure_signaled) (then (return (i32.const 1))))
    (if (local.get $kind)
      (then
        (local.set $status (call $integration_linear_argument
          (global.get $approximation_trig_argument_slot)
          (local.get $variable_slot) (local.get $a_out) (local.get $b_out)))
        (if (i32.eq (local.get $status) (i32.const 2)) (then (return (i32.const 1))))
        (if (i32.eqz (local.get $status)) (then (return (i32.const 4))))
        (if (call $expression_build_derived_trigonometric
              (global.get $approximation_trig_argument_slot)
              (i32.eq (local.get $kind) (i32.const 1))
              (local.get $left))
          (then (return (i32.const 1))))
        ;; sin(u) -> -cos(u)/a; cos(u) -> sin(u)/a.
        (if (i32.eq (local.get $kind) (i32.const 1))
          (then (call $build_raw_expr1 (global.get $BUILTIN_EXPRESSION_HEAD_NEGATE)
            (local.get $left) (local.get $left))))
        (call $write_value (local.get $extra)
          (global.get $TYPE_RATIONAL) (i32.const 0)
          (i32.load (call $abs (local.get $a_out))) (i32.const 0))
        (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_DIVIDE)
          (local.get $left) (local.get $extra) (local.get $dest_slot))
        (return (i32.const 0))))
    ;; Hyperbolic trees with a linear argument.
    (local.set $kind (call $calculus_match_hyperbolic (local.get $integrand_slot)))
    (if (global.get $memory_pressure_signaled) (then (return (i32.const 1))))
    (if (local.get $kind)
      (then
        (local.set $status (call $integration_linear_argument
          (global.get $calculus_argument_slot)
          (local.get $variable_slot) (local.get $a_out) (local.get $b_out)))
        (if (i32.eq (local.get $status) (i32.const 2)) (then (return (i32.const 1))))
        (if (i32.eqz (local.get $status)) (then (return (i32.const 4))))
        ;; sinh(u) -> cosh(u)/a; cosh(u) -> sinh(u)/a.
        (if (call $calculus_build_hyperbolic
              (global.get $calculus_argument_slot)
              (i32.eq (local.get $kind) (i32.const 1))
              (local.get $left))
          (then (return (i32.const 1))))
        (call $write_value (local.get $extra)
          (global.get $TYPE_RATIONAL) (i32.const 0)
          (i32.load (call $abs (local.get $a_out))) (i32.const 0))
        (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_DIVIDE)
          (local.get $left) (local.get $extra) (local.get $dest_slot))
        (return (i32.const 0))))
    ;; Power forms.
    (if (i32.and
          (call $approximation_head_is (local.get $header)
            (global.get $BUILTIN_EXPRESSION_HEAD_POWER))
          (i32.eq (local.get $count) (i32.const 2)))
      (then
        ;; Exponent: an exact rational constant.
        (local.set $kind (i32.const 0))
        (if (i32.eq (call $value_type (i32.add (local.get $data) (global.get $VALUE_SIZE)))
              (global.get $TYPE_BIGINT))
          (then
            (local.set $exponent_header (call $rational_from_bigint
              (call $value_data_lo (i32.add (local.get $data) (global.get $VALUE_SIZE)))))
            (local.set $kind (i32.const 1))))
        (if (i32.eq (call $value_type (i32.add (local.get $data) (global.get $VALUE_SIZE)))
              (global.get $TYPE_RATIONAL))
          (then
            (local.set $exponent_header (call $rational_materialize
              (i32.add (local.get $data) (global.get $VALUE_SIZE))))
            (local.set $kind (i32.const 1))))
        (if (i32.eqz (local.get $kind)) (then (return (i32.const 4))))
        ;; Base: the variable itself or a linear polynomial.
        (local.set $status (call $integration_linear_argument (local.get $data)
          (local.get $variable_slot) (local.get $a_out) (local.get $b_out)))
        (if (i32.eq (local.get $status) (i32.const 2)) (then (return (i32.const 1))))
        (if (i32.eqz (local.get $status))
          (then (return (call $integration_rational_function
            (local.get $integrand_slot) (local.get $variable_slot)
            (local.get $dest_slot)))))
        (local.set $one_header (call $rational_new (call $bigint_one) (call $bigint_one)))
        (call $write_value (local.get $extra)
          (global.get $TYPE_RATIONAL) (i32.const 0)
          (call $rational_add (local.get $exponent_header) (local.get $one_header))
          (i32.const 0))
        (if (call $rational_is_zero (local.get $extra))
          (then
            ;; Integral of u^-1: Log(u) / a, condition Greater(u, 0).
            (local.set $status (call $calculus_push_condition_positive
              (local.get $data)))
            (if (local.get $status) (then (return (i32.const 1))))
            (call $build_raw_expr1 (global.get $BUILTIN_EXPRESSION_HEAD_LOG)
              (local.get $data) (local.get $left))
            (call $write_value (local.get $right)
              (global.get $TYPE_RATIONAL) (i32.const 0)
              (i32.load (call $abs (local.get $a_out))) (i32.const 0))
            (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_DIVIDE)
              (local.get $left) (local.get $right) (local.get $dest_slot))
            (return (i32.const 0))))
        ;; u^c -> u^(c+1) / (a (c+1)).
        (local.set $next_header (call $rational_mul
          (i32.load (call $abs (local.get $a_out)))
          (call $rational_add (local.get $exponent_header) (local.get $one_header))))
        (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_POWER)
          (local.get $data) (local.get $extra) (local.get $left))
        (call $write_value (local.get $right)
          (global.get $TYPE_RATIONAL) (i32.const 0)
          (local.get $next_header) (i32.const 0))
        (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_DIVIDE)
          (local.get $left) (local.get $right) (local.get $dest_slot))
        (return (i32.const 0))))
    ;; Divide: a variable-free denominator is a constant factor; otherwise
    ;; the rational-function route.
    (if (i32.and
          (call $approximation_head_is (local.get $header)
            (global.get $BUILTIN_EXPRESSION_HEAD_DIVIDE))
          (i32.eq (local.get $count) (i32.const 2)))
      (then
        (local.set $contains (call $expression_contains_value
          (i32.add (local.get $data) (global.get $VALUE_SIZE))
          (local.get $variable_slot)))
        (if (global.get $memory_pressure_signaled) (then (return (i32.const 1))))
        (if (i32.eqz (local.get $contains))
          (then
            (local.set $status (call $integration_antiderivative (local.get $data)
              (local.get $variable_slot) (local.get $extra)
              (i32.add (local.get $depth) (i32.const 1))))
            (if (local.get $status) (then (return (local.get $status))))
            (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_DIVIDE)
              (local.get $extra) (i32.add (local.get $data) (global.get $VALUE_SIZE))
              (local.get $dest_slot))
            (return (i32.const 0))))
        (return (call $integration_rational_function
          (local.get $integrand_slot) (local.get $variable_slot) (local.get $dest_slot)))))
    ;; A bare polynomial expression (e.g. Power(x, 3) is handled above;
    ;; anything that parses as a polynomial integrates term by term through
    ;; the rational-function route).
    (call $integration_rational_function
      (local.get $integrand_slot) (local.get $variable_slot) (local.get $dest_slot))
  )

  ;; Integrate a rational function (or plain polynomial) exactly through
  ;; factorization and partial fractions over linear factors.
  ;; Status: 0 candidate / 4 unsupported / 1 pressure.
  (func $integration_rational_function
    (param $integrand_slot i32) (param $variable_slot i32) (param $dest_slot i32)
    (result i32)
    (local $work i32)
    (local $numerator_slot i32)
    (local $denominator_slot i32)
    (local $split i32)
    (local $status i32)
    (local $n_degree i32)
    (local $n_coefficients i32)
    (local $d_degree i32)
    (local $d_coefficients i32)
    (local $i i32)
    (local $k i32)
    (local $accumulator_slot i32)
    (local $term_slot i32)
    (local $scratch_slot i32)
    (local $have_accumulator i32)
    (local $polynomials i32)
    (local $multiplicities i32)
    (local $unit_out i32)
    (local $factor_count i32)
    (local $factor i32)
    (local $multiplicity i32)
    (local $root_header i32)
    (local $remainder_coefficients i32)
    (local $remainder_degree i32)
    (local $shifted i32)
    (local $value_header i32)
    (local $coefficient_header i32)
    (local $linear_slot i32)
    (local $exponent_slot i32)
    (if (call $expression_walk_guard (i32.const 8192))
      (then (return (i32.const 1))))
    (local.set $work (call $carve_scratch_blob (i32.const 144)))
    (local.set $numerator_slot (local.get $work))
    (local.set $denominator_slot (i32.add (local.get $work) (i32.const 16)))
    (local.set $accumulator_slot (i32.add (local.get $work) (i32.const 32)))
    (local.set $term_slot (i32.add (local.get $work) (i32.const 48)))
    (local.set $scratch_slot (i32.add (local.get $work) (i32.const 64)))
    (local.set $linear_slot (i32.add (local.get $work) (i32.const 80)))
    (local.set $exponent_slot (i32.add (local.get $work) (i32.const 96)))
    (local.set $split (call $solving_split_rational_function
      (local.get $integrand_slot) (local.get $variable_slot)
      (local.get $numerator_slot) (local.get $denominator_slot)))
    (if (i32.eq (local.get $split) (i32.const 2)) (then (return (i32.const 1))))
    (if (i32.eq (local.get $split) (i32.const 3)) (then (return (i32.const 4))))
    (local.set $have_accumulator (i32.const 0))
    ;; Numerator coefficients as Rational headers.
    (local.set $status (call $solving_parse_polynomial
      (local.get $numerator_slot) (local.get $variable_slot)))
    (if (i32.eq (local.get $status) (i32.const 1)) (then (return (i32.const 1))))
    (if (i32.and (i32.ne (local.get $status) (i32.const 0))
          (i32.ne (local.get $status) (i32.const 4)))
      (then (return (i32.const 4))))
    (if (i32.eq (local.get $status) (i32.const 4))
      (then
        (call $write_inline_rational (local.get $dest_slot) (i64.const 0))
        (return (i32.const 0))))
    (local.set $n_degree (global.get $solving_parsed_degree))
    (local.set $n_coefficients (call $integration_rational_headers
      (global.get $solving_parsed_coefficients) (local.get $n_degree)))
    (if (i32.eqz (local.get $n_coefficients)) (then (return (i32.const 1))))
    (if (i32.eqz (local.get $split))
      (then
        ;; A plain polynomial: sum c_i x^(i+1) / (i+1).
        (local.set $i (i32.const 0))
        (block $emitted
          (loop $emit
            (br_if $emitted (i32.gt_s (local.get $i) (local.get $n_degree)))
            (local.set $coefficient_header (i32.load (call $abs
              (i32.add (local.get $n_coefficients) (i32.mul (local.get $i) (i32.const 4))))))
            (if (i32.eqz (call $rational_is_zero_header (local.get $coefficient_header)))
              (then
                (if (call $expression_walk_guard (i32.const 1024))
                  (then (return (i32.const 1))))
                (call $write_value (local.get $scratch_slot)
                  (global.get $TYPE_RATIONAL) (i32.const 0)
                  (call $rational_div (local.get $coefficient_header)
                    (call $rational_new
                      (call $bigint_from_i64 (i64.extend_i32_s
                        (i32.add (local.get $i) (i32.const 1))))
                      (call $bigint_one)))
                  (i32.const 0))
                (call $write_inline_rational (local.get $exponent_slot)
                  (i64.extend_i32_s (i32.add (local.get $i) (i32.const 1))))
                (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_POWER)
                  (local.get $variable_slot) (local.get $exponent_slot) (local.get $term_slot))
                (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
                  (local.get $scratch_slot) (local.get $term_slot) (local.get $term_slot))
                (if (local.get $have_accumulator)
                  (then (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_ADD)
                    (local.get $accumulator_slot) (local.get $term_slot)
                    (local.get $accumulator_slot)))
                  (else
                    (memory.copy (call $abs (local.get $accumulator_slot))
                      (call $abs (local.get $term_slot)) (global.get $VALUE_SIZE))
                    (local.set $have_accumulator (i32.const 1))))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $emit)))
        (if (i32.eqz (local.get $have_accumulator))
          (then (call $write_inline_rational (local.get $accumulator_slot) (i64.const 0))))
        (memory.copy (call $abs (local.get $dest_slot))
          (call $abs (local.get $accumulator_slot)) (global.get $VALUE_SIZE))
        (return (i32.const 0))))
    ;; Rational function: parse the denominator, factor it, and require
    ;; linear irreducible factors.
    (local.set $status (call $solving_parse_polynomial
      (local.get $denominator_slot) (local.get $variable_slot)))
    (if (i32.eq (local.get $status) (i32.const 1)) (then (return (i32.const 1))))
    (if (local.get $status) (then (return (i32.const 4))))
    (local.set $d_degree (global.get $solving_parsed_degree))
    (if (i32.eqz (local.get $d_degree)) (then (return (i32.const 4))))
    (local.set $d_coefficients (call $integration_rational_headers
      (global.get $solving_parsed_coefficients) (local.get $d_degree)))
    (if (i32.eqz (local.get $d_coefficients)) (then (return (i32.const 1))))
    (local.set $polynomials (call $carve_scratch_blob (i32.const 256)))
    (local.set $multiplicities (call $carve_scratch_blob (i32.const 256)))
    (local.set $unit_out (call $carve_scratch_blob (i32.const 4)))
    (local.set $factor_count (call $solving_factorization
      (local.get $polynomials) (local.get $multiplicities) (i32.const 64)
      (local.get $unit_out)))
    (if (i32.eq (local.get $factor_count) (i32.const -1)) (then (return (i32.const 1))))
    (if (i32.lt_s (local.get $factor_count) (i32.const 0)) (then (return (i32.const 4))))
    (local.set $i (i32.const 0))
    (block $linear_checked
      (loop $linear_check
        (br_if $linear_checked (i32.ge_s (local.get $i) (local.get $factor_count)))
        (if (i32.gt_s (call $algebraic_poly_degree
              (i32.load (call $abs (i32.add (local.get $polynomials)
                (i32.mul (local.get $i) (i32.const 4))))))
              (i32.const 1))
          (then (return (i32.const 4))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $linear_check)))
    ;; Long division: numerator = quotient * denominator + remainder.
    (local.set $remainder_coefficients (call $carve_scratch_blob
      (i32.mul (i32.add (local.get $n_degree) (i32.const 1)) (i32.const 4))))
    (memory.copy (call $abs (local.get $remainder_coefficients))
      (call $abs (local.get $n_coefficients))
      (i32.mul (i32.add (local.get $n_degree) (i32.const 1)) (i32.const 4)))
    (local.set $remainder_degree (local.get $n_degree))
    (block $divided
      (loop $divide
        (br_if $divided (i32.lt_s (local.get $remainder_degree) (local.get $d_degree)))
        (if (call $expression_walk_guard (i32.const 4096))
          (then (return (i32.const 1))))
        ;; q-term = lead(r)/lead(d) * x^(rd - dd); integrate it directly
        ;; (the antiderivative of the quotient term), then subtract
        ;; q-term * d from the remainder.
        (local.set $coefficient_header (call $rational_div
          (i32.load (call $abs (i32.add (local.get $remainder_coefficients)
            (i32.mul (local.get $remainder_degree) (i32.const 4)))))
          (i32.load (call $abs (i32.add (local.get $d_coefficients)
            (i32.mul (local.get $d_degree) (i32.const 4)))))))
        (local.set $k (i32.sub (local.get $remainder_degree) (local.get $d_degree)))
        ;; Antiderivative of c x^k: c x^(k+1)/(k+1).
        (call $write_value (local.get $scratch_slot)
          (global.get $TYPE_RATIONAL) (i32.const 0)
          (call $rational_div (local.get $coefficient_header)
            (call $rational_new
              (call $bigint_from_i64 (i64.extend_i32_s (i32.add (local.get $k) (i32.const 1))))
              (call $bigint_one)))
          (i32.const 0))
        (call $write_inline_rational (local.get $exponent_slot)
          (i64.extend_i32_s (i32.add (local.get $k) (i32.const 1))))
        (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_POWER)
          (local.get $variable_slot) (local.get $exponent_slot) (local.get $term_slot))
        (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
          (local.get $scratch_slot) (local.get $term_slot) (local.get $term_slot))
        (if (local.get $have_accumulator)
          (then (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_ADD)
            (local.get $accumulator_slot) (local.get $term_slot)
            (local.get $accumulator_slot)))
          (else
            (memory.copy (call $abs (local.get $accumulator_slot))
              (call $abs (local.get $term_slot)) (global.get $VALUE_SIZE))
            (local.set $have_accumulator (i32.const 1))))
        ;; remainder -= c x^k * denominator.
        (local.set $i (i32.const 0))
        (block $reduced
          (loop $reduce
            (br_if $reduced (i32.gt_s (local.get $i) (local.get $d_degree)))
            (local.set $shifted (i32.add (local.get $i) (local.get $k)))
            (i32.store (call $abs (i32.add (local.get $remainder_coefficients)
              (i32.mul (local.get $shifted) (i32.const 4))))
              (call $rational_sub
                (i32.load (call $abs (i32.add (local.get $remainder_coefficients)
                  (i32.mul (local.get $shifted) (i32.const 4)))))
                (call $rational_mul (local.get $coefficient_header)
                  (i32.load (call $abs (i32.add (local.get $d_coefficients)
                    (i32.mul (local.get $i) (i32.const 4))))))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $reduce)))
        ;; Trim.
        (block $trimmed
          (loop $trim
            (br_if $trimmed (i32.lt_s (local.get $remainder_degree) (i32.const 0)))
            (br_if $trimmed (i32.eqz (call $rational_is_zero_header
              (i32.load (call $abs (i32.add (local.get $remainder_coefficients)
                (i32.mul (local.get $remainder_degree) (i32.const 4))))))))
            (local.set $remainder_degree
              (i32.sub (local.get $remainder_degree) (i32.const 1)))
            (br $trim)))
        (br $divide)))
    ;; Partial fractions over the linear factors by exact deflation.
    (if (i32.ge_s (local.get $remainder_degree) (i32.const 0))
      (then
        (if (i32.eqz (local.get $have_accumulator))
          (then
            (call $write_inline_rational (local.get $accumulator_slot) (i64.const 0))
            (local.set $have_accumulator (i32.const 1))))
        (local.set $i (i32.const 0))
        (block $factors_done
          (loop $factors
            (br_if $factors_done (i32.ge_s (local.get $i) (local.get $factor_count)))
            (local.set $factor (i32.load (call $abs (i32.add (local.get $polynomials)
              (i32.mul (local.get $i) (i32.const 4))))))
            (local.set $multiplicity (i32.load (call $abs
              (i32.add (local.get $multiplicities) (i32.mul (local.get $i) (i32.const 4))))))
            ;; root = -b/a of the primitive linear factor a x + b.
            (local.set $root_header (call $rational_negate (call $rational_new
              (call $algebraic_poly_coefficient (local.get $factor) (i32.const 0))
              (call $algebraic_poly_coefficient (local.get $factor) (i32.const 1)))))
            (local.set $status (call $integration_emit_pole_terms
              (local.get $remainder_coefficients) (local.get $remainder_degree)
              (local.get $d_coefficients) (local.get $d_degree)
              (local.get $root_header) (local.get $multiplicity)
              (local.get $variable_slot)
              (local.get $accumulator_slot) (local.get $have_accumulator)))
            (if (i32.eq (local.get $status) (i32.const 1)) (then (return (i32.const 1))))
            (local.set $have_accumulator (i32.const 1))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $factors)))))
    (if (i32.eqz (local.get $have_accumulator))
      (then (call $write_inline_rational (local.get $accumulator_slot) (i64.const 0))))
    (memory.copy (call $abs (local.get $dest_slot))
      (call $abs (local.get $accumulator_slot)) (global.get $VALUE_SIZE))
    (i32.const 0)
  )

  ;; Convert (degree + 1) BIGINT/RATIONAL value slots into Rational
  ;; headers (4-byte entries). Returns the buffer or 0 on pressure.
  (func $integration_rational_headers
    (param $coefficients i32) (param $degree i32) (result i32)
    (local $buffer i32)
    (local $i i32)
    (local $slot i32)
    (if (call $expression_walk_guard (i32.add (i32.const 256)
          (i32.mul (local.get $degree) (i32.const 8))))
      (then (return (i32.const 0))))
    (local.set $buffer (call $carve_scratch_blob
      (i32.mul (i32.add (local.get $degree) (i32.const 1)) (i32.const 4))))
    (local.set $i (i32.const 0))
    (block $converted
      (loop $convert
        (br_if $converted (i32.gt_s (local.get $i) (local.get $degree)))
        (local.set $slot (i32.add (local.get $coefficients)
          (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
        (i32.store (call $abs (i32.add (local.get $buffer)
          (i32.mul (local.get $i) (i32.const 4))))
          (if (result i32)
              (i32.eq (call $value_type (local.get $slot)) (global.get $TYPE_BIGINT))
            (then (call $rational_from_bigint (call $value_data_lo (local.get $slot))))
            (else (call $rational_materialize (local.get $slot)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $convert)))
    (local.get $buffer)
  )

  ;; Is a Rational HEADER exactly zero?
  (func $rational_is_zero_header (param $header i32) (result i32)
    (i32.eqz (call $bigint_length (call $rational_numerator (local.get $header))))
  )

  ;; Horner evaluation of a Rational-header coefficient buffer at an exact
  ;; rational point.
  (func $integration_poly_evaluate
    (param $coefficients i32) (param $degree i32) (param $point i32) (result i32)
    (local $result i32)
    (local $i i32)
    (local.set $result (i32.load (call $abs (i32.add (local.get $coefficients)
      (i32.mul (local.get $degree) (i32.const 4))))))
    (local.set $i (i32.sub (local.get $degree) (i32.const 1)))
    (block $evaluated
      (loop $evaluate
        (br_if $evaluated (i32.lt_s (local.get $i) (i32.const 0)))
        (local.set $result (call $rational_add
          (call $rational_mul (local.get $result) (local.get $point))
          (i32.load (call $abs (i32.add (local.get $coefficients)
            (i32.mul (local.get $i) (i32.const 4)))))))
        (local.set $i (i32.sub (local.get $i) (i32.const 1)))
        (br $evaluate)))
    (local.get $result)
  )

  ;; Synthetic division of a Rational-header buffer by (x - root), writing
  ;; the quotient into `quotient` ((degree) entries). Returns the exact
  ;; remainder header.
  (func $integration_poly_deflate
    (param $coefficients i32) (param $degree i32) (param $root i32)
    (param $quotient i32) (result i32)
    (local $carry i32)
    (local $i i32)
    (local.set $carry (i32.load (call $abs (i32.add (local.get $coefficients)
      (i32.mul (local.get $degree) (i32.const 4))))))
    (local.set $i (i32.sub (local.get $degree) (i32.const 1)))
    (block $deflated
      (loop $deflate
        (br_if $deflated (i32.lt_s (local.get $i) (i32.const 0)))
        (i32.store (call $abs (i32.add (local.get $quotient)
          (i32.mul (local.get $i) (i32.const 4)))) (local.get $carry))
        (local.set $carry (call $rational_add
          (call $rational_mul (local.get $carry) (local.get $root))
          (i32.load (call $abs (i32.add (local.get $coefficients)
            (i32.mul (local.get $i) (i32.const 4)))))))
        (local.set $i (i32.sub (local.get $i) (i32.const 1)))
        (br $deflate)))
    (local.get $carry)
  )

  ;; Emit the partial-fraction antiderivative terms for one linear pole
  ;; (root, multiplicity): A_k/(x-r)^k integrates to A_1 Log(x - r) (with
  ;; the positivity condition) plus A_k (x-r)^(1-k)/(1-k) for k >= 2.
  ;; Coefficients come from exact deflation of the remainder against the
  ;; full denominator. Returns 0 ok / 1 pressure. Appends onto the
  ;; accumulator slot (raw Adds).
  (func $integration_emit_pole_terms
    (param $numerator_coefficients i32) (param $numerator_degree i32)
    (param $denominator_coefficients i32) (param $denominator_degree i32)
    (param $root i32) (param $multiplicity i32)
    (param $variable_slot i32)
    (param $accumulator_slot i32) (param $have_accumulator i32)
    (result i32)
    (local $reduced i32)
    (local $reduced_degree i32)
    (local $residual i32)
    (local $residual_degree i32)
    (local $quotient i32)
    (local $k i32)
    (local $i i32)
    (local $a_header i32)
    (local $work i32)
    (local $term_slot i32)
    (local $scratch_slot i32)
    (local $linear_slot i32)
    (local $value_header i32)
    (if (call $expression_walk_guard (i32.add (i32.const 4096)
          (i32.mul (local.get $denominator_degree) (i32.const 16))))
      (then (return (i32.const 1))))
    (local.set $work (call $carve_scratch_blob (i32.const 64)))
    (local.set $term_slot (local.get $work))
    (local.set $scratch_slot (i32.add (local.get $work) (i32.const 16)))
    (local.set $linear_slot (i32.add (local.get $work) (i32.const 32)))
    ;; reduced = denominator deflated by (x - root)^multiplicity.
    (local.set $reduced (call $carve_scratch_blob
      (i32.mul (i32.add (local.get $denominator_degree) (i32.const 1)) (i32.const 4))))
    (memory.copy (call $abs (local.get $reduced))
      (call $abs (local.get $denominator_coefficients))
      (i32.mul (i32.add (local.get $denominator_degree) (i32.const 1)) (i32.const 4)))
    (local.set $reduced_degree (local.get $denominator_degree))
    (local.set $quotient (call $carve_scratch_blob
      (i32.mul (i32.add (local.get $denominator_degree) (i32.const 1)) (i32.const 4))))
    (local.set $k (i32.const 0))
    (block $stripped
      (loop $strip
        (br_if $stripped (i32.ge_s (local.get $k) (local.get $multiplicity)))
        (drop (call $integration_poly_deflate (local.get $reduced)
          (local.get $reduced_degree) (local.get $root) (local.get $quotient)))
        (memory.copy (call $abs (local.get $reduced)) (call $abs (local.get $quotient))
          (i32.mul (local.get $reduced_degree) (i32.const 4)))
        (local.set $reduced_degree (i32.sub (local.get $reduced_degree) (i32.const 1)))
        (local.set $k (i32.add (local.get $k) (i32.const 1)))
        (br $strip)))
    ;; residual carries the numerator, deflated once per emitted A_k.
    (local.set $residual (call $carve_scratch_blob
      (i32.mul (i32.add (local.get $numerator_degree) (i32.const 2)) (i32.const 4))))
    (memory.copy (call $abs (local.get $residual))
      (call $abs (local.get $numerator_coefficients))
      (i32.mul (i32.add (local.get $numerator_degree) (i32.const 1)) (i32.const 4)))
    (local.set $residual_degree (local.get $numerator_degree))
    ;; The linear expression (x - root).
    (call $write_value (local.get $scratch_slot)
      (global.get $TYPE_RATIONAL) (i32.const 0) (local.get $root) (i32.const 0))
    (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_SUBTRACT)
      (local.get $variable_slot) (local.get $scratch_slot) (local.get $linear_slot))
    (local.set $k (local.get $multiplicity))
    (block $emitted
      (loop $emit
        (br_if $emitted (i32.lt_s (local.get $k) (i32.const 1)))
        (if (call $expression_walk_guard (i32.const 4096))
          (then (return (i32.const 1))))
        ;; A_k = residual(root) / reduced(root); note residual may have
        ;; degenerated to the zero polynomial.
        (if (i32.lt_s (local.get $residual_degree) (i32.const 0))
          (then (local.set $a_header (call $rational_new
            (call $bigint_zero) (call $bigint_one))))
          (else (local.set $a_header (call $rational_div
            (call $integration_poly_evaluate (local.get $residual)
              (local.get $residual_degree) (local.get $root))
            (call $integration_poly_evaluate (local.get $reduced)
              (local.get $reduced_degree) (local.get $root))))))
        (if (i32.eqz (call $rational_is_zero_header (local.get $a_header)))
          (then
            (if (i32.eq (local.get $k) (i32.const 1))
              (then
                ;; A Log(x - root), condition Greater(x - root, 0).
                (if (call $calculus_push_condition_positive (local.get $linear_slot))
                  (then (return (i32.const 1))))
                (call $build_raw_expr1 (global.get $BUILTIN_EXPRESSION_HEAD_LOG)
                  (local.get $linear_slot) (local.get $term_slot)))
              (else
                ;; A (x-root)^(1-k) / (1-k).
                (call $write_inline_rational (local.get $scratch_slot)
                  (i64.extend_i32_s (i32.sub (i32.const 1) (local.get $k))))
                (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_POWER)
                  (local.get $linear_slot) (local.get $scratch_slot) (local.get $term_slot))
                (call $write_inline_rational (local.get $scratch_slot)
                  (i64.extend_i32_s (i32.sub (i32.const 1) (local.get $k))))
                (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_DIVIDE)
                  (local.get $term_slot) (local.get $scratch_slot) (local.get $term_slot))))
            ;; term *= A_k.
            (call $write_value (local.get $scratch_slot)
              (global.get $TYPE_RATIONAL) (i32.const 0)
              (local.get $a_header) (i32.const 0))
            (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
              (local.get $scratch_slot) (local.get $term_slot) (local.get $term_slot))
            (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_ADD)
              (local.get $accumulator_slot) (local.get $term_slot)
              (local.get $accumulator_slot))))
        ;; residual = (residual - A_k * reduced) / (x - root): subtract,
        ;; then deflate exactly (the remainder is zero by construction).
        (if (i32.ge_s (local.get $k) (i32.const 2))
          (then
            (if (i32.lt_s (local.get $residual_degree) (local.get $reduced_degree))
              (then (local.set $residual_degree (local.get $reduced_degree))))
            (local.set $i (i32.const 0))
            (block $subtracted
              (loop $subtract
                (br_if $subtracted (i32.gt_s (local.get $i) (local.get $residual_degree)))
                (local.set $value_header
                  (if (result i32) (i32.le_s (local.get $i) (local.get $reduced_degree))
                    (then (call $rational_mul (local.get $a_header)
                      (i32.load (call $abs (i32.add (local.get $reduced)
                        (i32.mul (local.get $i) (i32.const 4)))))))
                    (else (call $rational_new (call $bigint_zero) (call $bigint_one)))))
                (i32.store (call $abs (i32.add (local.get $residual)
                  (i32.mul (local.get $i) (i32.const 4))))
                  (call $rational_sub
                    (i32.load (call $abs (i32.add (local.get $residual)
                      (i32.mul (local.get $i) (i32.const 4)))))
                    (local.get $value_header)))
                (local.set $i (i32.add (local.get $i) (i32.const 1)))
                (br $subtract)))
            (drop (call $integration_poly_deflate (local.get $residual)
              (local.get $residual_degree) (local.get $root) (local.get $quotient)))
            (memory.copy (call $abs (local.get $residual)) (call $abs (local.get $quotient))
              (i32.mul (local.get $residual_degree) (i32.const 4)))
            (local.set $residual_degree (i32.sub (local.get $residual_degree) (i32.const 1)))
            ;; reduced gains back one (x - root): multiply reduced by the
            ;; linear factor so A_(k-1) = residual(root)/reduced(root)
            ;; stays the standard formula.
            (local.set $i (local.get $reduced_degree))
            (i32.store (call $abs (i32.add (local.get $quotient)
              (i32.mul (i32.add (local.get $i) (i32.const 1)) (i32.const 4))))
              (i32.load (call $abs (i32.add (local.get $reduced)
                (i32.mul (local.get $i) (i32.const 4))))))
            (block $lifted
              (loop $lift
                (br_if $lifted (i32.lt_s (local.get $i) (i32.const 1)))
                (i32.store (call $abs (i32.add (local.get $quotient)
                  (i32.mul (local.get $i) (i32.const 4))))
                  (call $rational_sub
                    (i32.load (call $abs (i32.add (local.get $reduced)
                      (i32.mul (i32.sub (local.get $i) (i32.const 1)) (i32.const 4)))))
                    (call $rational_mul (local.get $root)
                      (i32.load (call $abs (i32.add (local.get $reduced)
                        (i32.mul (local.get $i) (i32.const 4))))))))
                (local.set $i (i32.sub (local.get $i) (i32.const 1)))
                (br $lift)))
            (i32.store (call $abs (local.get $quotient))
              (call $rational_negate (call $rational_mul (local.get $root)
                (i32.load (call $abs (local.get $reduced))))))
            (local.set $reduced_degree (i32.add (local.get $reduced_degree) (i32.const 1)))
            (memory.copy (call $abs (local.get $reduced)) (call $abs (local.get $quotient))
              (i32.mul (i32.add (local.get $reduced_degree) (i32.const 1)) (i32.const 4)))))
        (local.set $k (i32.sub (local.get $k) (i32.const 1)))
        (br $emit)))
    (i32.const 0)
  )

  ;; One-level flattening of a product's argument slots: nested Multiply
  ;; factors contribute their own arguments. Returns the flat slot buffer
  ;; (count in $integration_flat_count), or 0 on pressure.
  (global $integration_flat_count (mut i32) (i32.const 0))
  (func $integration_flatten_product
    (param $data i32) (param $count i32) (result i32)
    (local $buffer i32)
    (local $i i32)
    (local $j i32)
    (local $out i32)
    (local $slot i32)
    (local $inner_header i32)
    (local $inner_count i32)
    (local $inner_data i32)
    (if (call $expression_walk_guard (i32.const 2048))
      (then (return (i32.const 0))))
    (local.set $buffer (call $carve_scratch_blob
      (i32.mul (i32.const 32) (global.get $VALUE_SIZE))))
    (local.set $out (i32.const 0))
    (local.set $i (i32.const 0))
    (block $flattened
      (loop $flatten
        (br_if $flattened (i32.ge_s (local.get $i) (local.get $count)))
        (local.set $slot (i32.add (local.get $data)
          (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
        (local.set $inner_count (i32.const 0))
        (if (i32.eq (call $value_type (local.get $slot)) (global.get $TYPE_EXPRESSION))
          (then
            (local.set $inner_header (call $value_data_lo (local.get $slot)))
            (if (call $approximation_head_is (local.get $inner_header)
                  (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY))
              (then
                (local.set $inner_count (call $approximation_expression_argument_count
                  (local.get $inner_header)))
                (local.set $inner_data (call $approximation_expression_argument_data
                  (local.get $inner_header)))))))
        (if (local.get $inner_count)
          (then
            (local.set $j (i32.const 0))
            (block $copied
              (loop $copy
                (br_if $copied (i32.ge_s (local.get $j) (local.get $inner_count)))
                (if (i32.ge_s (local.get $out) (i32.const 32))
                  (then (return (i32.const 0))))
                (memory.copy (call $abs (i32.add (local.get $buffer)
                  (i32.mul (local.get $out) (global.get $VALUE_SIZE))))
                  (call $abs (i32.add (local.get $inner_data)
                    (i32.mul (local.get $j) (global.get $VALUE_SIZE))))
                  (global.get $VALUE_SIZE))
                (local.set $out (i32.add (local.get $out) (i32.const 1)))
                (local.set $j (i32.add (local.get $j) (i32.const 1)))
                (br $copy))))
          (else
            (if (i32.ge_s (local.get $out) (i32.const 32))
              (then (return (i32.const 0))))
            (memory.copy (call $abs (i32.add (local.get $buffer)
              (i32.mul (local.get $out) (global.get $VALUE_SIZE))))
              (call $abs (local.get $slot))
              (global.get $VALUE_SIZE))
            (local.set $out (i32.add (local.get $out) (i32.const 1)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $flatten)))
    (global.set $integration_flat_count (local.get $out))
    (local.get $buffer)
  )

  ;; Bounded integration by parts for recognized products
  ;; x^n * elementary(linear). Status 0 / 4 / 1.
  (func $integration_by_parts
    (param $integrand_slot i32) (param $variable_slot i32) (param $dest_slot i32)
    (param $depth i32)
    (result i32)
    (local $header i32)
    (local $count i32)
    (local $data i32)
    (local $power_slot i32)
    (local $elementary_slot i32)
    (local $i i32)
    (local $work i32)
    (local $antiderivative_slot i32)
    (local $derivative_slot i32)
    (local $term_slot i32)
    (local $status i32)
    (local $slot i32)
    (local $slot_kind i32)
    (local.set $header (call $value_data_lo (local.get $integrand_slot)))
    (local.set $count (call $approximation_expression_argument_count (local.get $header)))
    (local.set $data (call $approximation_expression_argument_data (local.get $header)))
    (if (i32.ne (local.get $count) (i32.const 2)) (then (return (i32.const 4))))
    ;; Classify the two factors: one power of the variable, one elementary
    ;; form (Exp / sine / cosine / sinh / cosh tree).
    (local.set $power_slot (i32.const 0))
    (local.set $elementary_slot (i32.const 0))
    (local.set $i (i32.const 0))
    (block $classified
      (loop $classify
        (br_if $classified (i32.ge_s (local.get $i) (i32.const 2)))
        (local.set $slot (i32.add (local.get $data)
          (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
        (local.set $slot_kind (i32.const 0))
        (if (i32.eq (call $value_type (local.get $slot)) (global.get $TYPE_SYMBOL))
          (then (local.set $slot_kind (i32.const 1))))
        (if (i32.eq (call $value_type (local.get $slot)) (global.get $TYPE_EXPRESSION))
          (then
            (if (i32.and
                  (call $approximation_head_is (call $value_data_lo (local.get $slot))
                    (global.get $BUILTIN_EXPRESSION_HEAD_POWER))
                  (i32.eq (call $value_type (i32.add
                    (call $approximation_expression_argument_data
                      (call $value_data_lo (local.get $slot)))
                    (global.get $VALUE_SIZE)))
                    (global.get $TYPE_BIGINT)))
              (then
                (if (i32.eq (call $value_type
                      (call $approximation_expression_argument_data
                        (call $value_data_lo (local.get $slot))))
                      (global.get $TYPE_SYMBOL))
                  (then (local.set $slot_kind (i32.const 1))))))
            (if (i32.eqz (local.get $slot_kind))
              (then (local.set $slot_kind (i32.const 2))))))
        (if (i32.eq (local.get $slot_kind) (i32.const 1))
          (then (local.set $power_slot (local.get $slot))))
        (if (i32.eq (local.get $slot_kind) (i32.const 2))
          (then (local.set $elementary_slot (local.get $slot))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $classify)))
    (if (i32.or (i32.eqz (local.get $power_slot)) (i32.eqz (local.get $elementary_slot)))
      (then (return (i32.const 4))))
    (if (call $expression_walk_guard (i32.const 4096))
      (then (return (i32.const 1))))
    (local.set $work (call $carve_scratch_blob (i32.const 64)))
    (local.set $antiderivative_slot (local.get $work))
    (local.set $derivative_slot (i32.add (local.get $work) (i32.const 16)))
    (local.set $term_slot (i32.add (local.get $work) (i32.const 32)))
    ;; F = antiderivative of the elementary factor.
    (local.set $status (call $integration_antiderivative (local.get $elementary_slot)
      (local.get $variable_slot) (local.get $antiderivative_slot)
      (i32.add (local.get $depth) (i32.const 1))))
    (if (local.get $status) (then (return (local.get $status))))
    ;; u' = derivative of the power factor.
    (local.set $status (call $calculus_derivative_into (local.get $power_slot)
      (call $value_data_lo (local.get $variable_slot)) (local.get $derivative_slot)))
    (if (i32.eq (local.get $status) (i32.const 1)) (then (return (i32.const 1))))
    (if (i32.eq (local.get $status) (i32.const 2)) (then (return (i32.const 4))))
    (if (call $expression_simplify_into
          (local.get $derivative_slot) (local.get $derivative_slot))
      (then (return (i32.const 1))))
    ;; result = u F - integral(u' F).
    (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
      (local.get $derivative_slot) (local.get $antiderivative_slot) (local.get $term_slot))
    (local.set $status (call $integration_antiderivative (local.get $term_slot)
      (local.get $variable_slot) (local.get $term_slot)
      (i32.add (local.get $depth) (i32.const 1))))
    (if (local.get $status) (then (return (local.get $status))))
    (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
      (local.get $power_slot) (local.get $antiderivative_slot) (local.get $derivative_slot))
    (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_SUBTRACT)
      (local.get $derivative_slot) (local.get $term_slot) (local.get $dest_slot))
    (i32.const 0)
  )

  ;; Run the bounded search plus the exact derivative verification gate.
  ;; Status: 0 verified (candidate simplified into dest), 4 not verified,
  ;; 1 pressure, 2 thrown.
  (func $integration_verified_antiderivative
    (param $integrand_slot i32) (param $variable_slot i32) (param $dest_slot i32)
    (result i32)
    (local $work i32)
    (local $simplified_slot i32)
    (local $derivative_slot i32)
    (local $difference_slot i32)
    (local $status i32)
    (if (call $expression_walk_guard (i32.const 8192))
      (then (return (i32.const 1))))
    (local.set $work (call $carve_scratch_blob (i32.const 48)))
    (local.set $simplified_slot (local.get $work))
    (local.set $derivative_slot (i32.add (local.get $work) (i32.const 16)))
    (local.set $difference_slot (i32.add (local.get $work) (i32.const 32)))
    (if (call $expression_simplify_into (local.get $integrand_slot)
          (local.get $simplified_slot))
      (then (return (i32.const 1))))
    ;; Search the ORIGINAL tree: the canonical trigonometric and
    ;; hyperbolic constructor shapes do not survive simplification. The
    ;; verification gate compares against the simplified integrand.
    (local.set $status (call $integration_antiderivative (local.get $integrand_slot)
      (local.get $variable_slot) (local.get $dest_slot) (i32.const 0)))
    (if (local.get $status) (then (return (local.get $status))))
    (if (call $expression_simplify_into (local.get $dest_slot) (local.get $dest_slot))
      (then (return (i32.const 1))))
    ;; The gate: d(candidate)/dx - integrand must simplify to exact zero.
    (local.set $status (call $calculus_derivative_into (local.get $dest_slot)
      (call $value_data_lo (local.get $variable_slot)) (local.get $derivative_slot)))
    (if (i32.eq (local.get $status) (i32.const 1)) (then (return (i32.const 1))))
    (if (i32.eq (local.get $status) (i32.const 2)) (then (return (i32.const 4))))
    (if (call $build_simplified2 (global.get $BUILTIN_EXPRESSION_HEAD_SUBTRACT)
          (local.get $derivative_slot) (local.get $simplified_slot)
          (local.get $difference_slot))
      (then (return (i32.const 1))))
    (if (i32.eqz (call $expression_value_is_zero_wide (local.get $difference_slot)))
      (then
        (if (global.get $memory_pressure_signaled) (then (return (i32.const 1))))
        ;; Structural cancellation missed: decide the residual exactly as a
        ;; rational function over one common denominator. Still purely
        ;; symbolic; never a sampled test.
        (local.set $status (call $integration_rational_residual_is_zero
          (local.get $difference_slot) (local.get $variable_slot)))
        (if (i32.eq (local.get $status) (i32.const 2)) (then (return (i32.const 1))))
        (if (i32.eqz (local.get $status)) (then (return (i32.const 4))))))
    (if (global.get $memory_pressure_signaled) (then (return (i32.const 1))))
    (i32.const 0)
  )

  ;; Is a simplified difference exactly the zero rational function? Splits
  ;; the canonical sum into rational-function terms, combines them over the
  ;; product denominator with exact rational polynomial arithmetic, and
  ;; tests the combined numerator for the zero polynomial.
  ;; Returns 1 zero / 0 not-provably-zero / 2 pressure.
  (func $integration_rational_residual_is_zero
    (param $difference_slot i32) (param $variable_slot i32)
    (result i32)
    (local $terms_data i32)
    (local $terms_count i32)
    (local $i i32)
    (local $work i32)
    (local $numerator_slot i32)
    (local $denominator_slot i32)
    (local $split i32)
    (local $status i32)
    (local $term_numerators i32)
    (local $term_numerator_degrees i32)
    (local $term_denominators i32)
    (local $term_denominator_degrees i32)
    (local $headers i32)
    (local $sum_coefficients i32)
    (local $sum_degree i32)
    (local $product i32)
    (local $product_degree i32)
    (local $j i32)
    (local $k i32)
    (local $entry i32)
    (if (call $expression_walk_guard (i32.const 8192))
      (then (return (i32.const 2))))
    (call $sum_term_list (local.get $difference_slot))
    (local.set $terms_data (global.get $sum_terms_data))
    (local.set $terms_count (global.get $sum_terms_count))
    (if (i32.or (i32.eqz (local.get $terms_count))
          (i32.gt_s (local.get $terms_count) (i32.const 32)))
      (then (return (i32.const 0))))
    (local.set $work (call $carve_scratch_blob (i32.const 32)))
    (local.set $numerator_slot (local.get $work))
    (local.set $denominator_slot (i32.add (local.get $work) (i32.const 16)))
    (local.set $term_numerators (call $carve_scratch_blob (i32.const 128)))
    (local.set $term_numerator_degrees (call $carve_scratch_blob (i32.const 128)))
    (local.set $term_denominators (call $carve_scratch_blob (i32.const 128)))
    (local.set $term_denominator_degrees (call $carve_scratch_blob (i32.const 128)))
    ;; Parse every term as numerator/denominator Rational-header buffers.
    (local.set $i (i32.const 0))
    (block $parsed
      (loop $parse
        (br_if $parsed (i32.ge_s (local.get $i) (local.get $terms_count)))
        (local.set $split (call $solving_split_rational_function
          (i32.add (local.get $terms_data) (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
          (local.get $variable_slot)
          (local.get $numerator_slot) (local.get $denominator_slot)))
        (if (i32.eq (local.get $split) (i32.const 2)) (then (return (i32.const 2))))
        (if (i32.eq (local.get $split) (i32.const 3)) (then (return (i32.const 0))))
        (local.set $status (call $solving_parse_polynomial
          (local.get $numerator_slot) (local.get $variable_slot)))
        (if (i32.eq (local.get $status) (i32.const 1)) (then (return (i32.const 2))))
        (if (i32.and (i32.ne (local.get $status) (i32.const 0))
              (i32.ne (local.get $status) (i32.const 4)))
          (then (return (i32.const 0))))
        (if (i32.eq (local.get $status) (i32.const 4))
          (then
            ;; A zero term contributes nothing: encode as 0 / 1.
            (i32.store (call $abs (i32.add (local.get $term_numerator_degrees)
              (i32.mul (local.get $i) (i32.const 4)))) (i32.const 0))
            (local.set $headers (call $carve_scratch_blob (i32.const 4)))
            (i32.store (call $abs (local.get $headers))
              (call $rational_new (call $bigint_zero) (call $bigint_one)))
            (i32.store (call $abs (i32.add (local.get $term_numerators)
              (i32.mul (local.get $i) (i32.const 4)))) (local.get $headers)))
          (else
            (i32.store (call $abs (i32.add (local.get $term_numerator_degrees)
              (i32.mul (local.get $i) (i32.const 4))))
              (global.get $solving_parsed_degree))
            (local.set $headers (call $integration_rational_headers
              (global.get $solving_parsed_coefficients)
              (global.get $solving_parsed_degree)))
            (if (i32.eqz (local.get $headers)) (then (return (i32.const 2))))
            (i32.store (call $abs (i32.add (local.get $term_numerators)
              (i32.mul (local.get $i) (i32.const 4)))) (local.get $headers))))
        (if (i32.eq (local.get $split) (i32.const 1))
          (then
            (local.set $status (call $solving_parse_polynomial
              (local.get $denominator_slot) (local.get $variable_slot)))
            (if (i32.eq (local.get $status) (i32.const 1)) (then (return (i32.const 2))))
            (if (local.get $status) (then (return (i32.const 0))))
            (i32.store (call $abs (i32.add (local.get $term_denominator_degrees)
              (i32.mul (local.get $i) (i32.const 4))))
              (global.get $solving_parsed_degree))
            (local.set $headers (call $integration_rational_headers
              (global.get $solving_parsed_coefficients)
              (global.get $solving_parsed_degree)))
            (if (i32.eqz (local.get $headers)) (then (return (i32.const 2))))
            (i32.store (call $abs (i32.add (local.get $term_denominators)
              (i32.mul (local.get $i) (i32.const 4)))) (local.get $headers)))
          (else
            (i32.store (call $abs (i32.add (local.get $term_denominator_degrees)
              (i32.mul (local.get $i) (i32.const 4)))) (i32.const 0))
            (local.set $headers (call $carve_scratch_blob (i32.const 4)))
            (i32.store (call $abs (local.get $headers))
              (call $rational_new (call $bigint_one) (call $bigint_one)))
            (i32.store (call $abs (i32.add (local.get $term_denominators)
              (i32.mul (local.get $i) (i32.const 4)))) (local.get $headers))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $parse)))
    ;; Combined numerator = sum over i of n_i * product of d_j (j != i).
    (local.set $sum_coefficients (i32.const 0))
    (local.set $sum_degree (i32.const -1))
    (local.set $i (i32.const 0))
    (block $combined
      (loop $combine
        (br_if $combined (i32.ge_s (local.get $i) (local.get $terms_count)))
        (if (call $expression_walk_guard (i32.const 8192))
          (then (return (i32.const 2))))
        (local.set $product (i32.load (call $abs (i32.add (local.get $term_numerators)
          (i32.mul (local.get $i) (i32.const 4))))))
        (local.set $product_degree (i32.load (call $abs
          (i32.add (local.get $term_numerator_degrees)
            (i32.mul (local.get $i) (i32.const 4))))))
        (local.set $j (i32.const 0))
        (block $multiplied
          (loop $multiply
            (br_if $multiplied (i32.ge_s (local.get $j) (local.get $terms_count)))
            (if (i32.ne (local.get $j) (local.get $i))
              (then
                (local.set $product (call $integration_poly_multiply
                  (local.get $product) (local.get $product_degree)
                  (i32.load (call $abs (i32.add (local.get $term_denominators)
                    (i32.mul (local.get $j) (i32.const 4)))))
                  (i32.load (call $abs (i32.add (local.get $term_denominator_degrees)
                    (i32.mul (local.get $j) (i32.const 4)))))))
                (if (i32.eqz (local.get $product)) (then (return (i32.const 2))))
                (local.set $product_degree (i32.add (local.get $product_degree)
                  (i32.load (call $abs (i32.add (local.get $term_denominator_degrees)
                    (i32.mul (local.get $j) (i32.const 4)))))))))
            (local.set $j (i32.add (local.get $j) (i32.const 1)))
            (br $multiply)))
        ;; sum += product.
        (if (i32.eqz (local.get $sum_coefficients))
          (then
            (local.set $sum_coefficients (local.get $product))
            (local.set $sum_degree (local.get $product_degree)))
          (else
            (if (i32.lt_s (local.get $sum_degree) (local.get $product_degree))
              (then
                (local.set $headers (call $carve_scratch_blob
                  (i32.mul (i32.add (local.get $product_degree) (i32.const 1))
                    (i32.const 4))))
                (local.set $k (i32.const 0))
                (block $padded
                  (loop $pad
                    (br_if $padded (i32.gt_s (local.get $k) (local.get $product_degree)))
                    (i32.store (call $abs (i32.add (local.get $headers)
                      (i32.mul (local.get $k) (i32.const 4))))
                      (if (result i32) (i32.le_s (local.get $k) (local.get $sum_degree))
                        (then (i32.load (call $abs (i32.add (local.get $sum_coefficients)
                          (i32.mul (local.get $k) (i32.const 4))))))
                        (else (call $rational_new (call $bigint_zero) (call $bigint_one)))))
                    (local.set $k (i32.add (local.get $k) (i32.const 1)))
                    (br $pad)))
                (local.set $sum_coefficients (local.get $headers))
                (local.set $sum_degree (local.get $product_degree))))
            (local.set $k (i32.const 0))
            (block $added
              (loop $add
                (br_if $added (i32.gt_s (local.get $k) (local.get $product_degree)))
                (i32.store (call $abs (i32.add (local.get $sum_coefficients)
                  (i32.mul (local.get $k) (i32.const 4))))
                  (call $rational_add
                    (i32.load (call $abs (i32.add (local.get $sum_coefficients)
                      (i32.mul (local.get $k) (i32.const 4)))))
                    (i32.load (call $abs (i32.add (local.get $product)
                      (i32.mul (local.get $k) (i32.const 4)))))))
                (local.set $k (i32.add (local.get $k) (i32.const 1)))
                (br $add)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $combine)))
    ;; Zero iff every combined coefficient is exactly zero.
    (local.set $k (i32.const 0))
    (block $checked
      (loop $check
        (br_if $checked (i32.gt_s (local.get $k) (local.get $sum_degree)))
        (if (i32.eqz (call $rational_is_zero_header
              (i32.load (call $abs (i32.add (local.get $sum_coefficients)
                (i32.mul (local.get $k) (i32.const 4)))))))
          (then (return (i32.const 0))))
        (local.set $k (i32.add (local.get $k) (i32.const 1)))
        (br $check)))
    (i32.const 1)
  )

  ;; Exact product of two Rational-header coefficient buffers. Returns the
  ;; product buffer or 0 on pressure.
  (func $integration_poly_multiply
    (param $a i32) (param $a_degree i32) (param $b i32) (param $b_degree i32)
    (result i32)
    (local $result i32)
    (local $degree i32)
    (local $i i32)
    (local $j i32)
    (local $zero i32)
    (local.set $degree (i32.add (local.get $a_degree) (local.get $b_degree)))
    (if (call $expression_walk_guard (i32.add (i32.const 512)
          (i32.mul (local.get $degree) (i32.const 8))))
      (then (return (i32.const 0))))
    (local.set $result (call $carve_scratch_blob
      (i32.mul (i32.add (local.get $degree) (i32.const 1)) (i32.const 4))))
    (local.set $zero (call $rational_new (call $bigint_zero) (call $bigint_one)))
    (local.set $i (i32.const 0))
    (block $zeroed
      (loop $fill
        (br_if $zeroed (i32.gt_s (local.get $i) (local.get $degree)))
        (i32.store (call $abs (i32.add (local.get $result)
          (i32.mul (local.get $i) (i32.const 4)))) (local.get $zero))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $fill)))
    (local.set $i (i32.const 0))
    (block $outer_done
      (loop $outer
        (br_if $outer_done (i32.gt_s (local.get $i) (local.get $a_degree)))
        (local.set $j (i32.const 0))
        (block $inner_done
          (loop $inner
            (br_if $inner_done (i32.gt_s (local.get $j) (local.get $b_degree)))
            (i32.store (call $abs (i32.add (local.get $result)
              (i32.mul (i32.add (local.get $i) (local.get $j)) (i32.const 4))))
              (call $rational_add
                (i32.load (call $abs (i32.add (local.get $result)
                  (i32.mul (i32.add (local.get $i) (local.get $j)) (i32.const 4)))))
                (call $rational_mul
                  (i32.load (call $abs (i32.add (local.get $a)
                    (i32.mul (local.get $i) (i32.const 4)))))
                  (i32.load (call $abs (i32.add (local.get $b)
                    (i32.mul (local.get $j) (i32.const 4))))))))
            (local.set $j (i32.add (local.get $j) (i32.const 1)))
            (br $inner)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $outer)))
    (local.get $result)
  )

  ;; integral(expression, variable) -> unevaluated Integral node.
  (func $expression_integral_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $destination i32)
    (if (i32.eqz (call $solving_two_arguments (local.get $argc) (local.get $stack_base)))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_INTEGRAL_ARGUMENTS))))))
    (if (i32.or
          (i32.eqz (call $expression_arg_type_ok
            (call $value_type (global.get $solving_argument1))))
          (i32.ne (call $value_type (global.get $solving_argument2))
            (global.get $TYPE_SYMBOL)))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_INTEGRAL_ARGUMENTS))))))
    (local.set $destination (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (call $integration_build_node
          (global.get $solving_argument1) (global.get $solving_argument2)
          (i32.const 0) (i32.const 0) (local.get $destination))
      (then (return (i32.const 0))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER)
      (i32.add (local.get $destination) (global.get $VALUE_SIZE)))
    (i32.const 0)
  )

  ;; antiderivative(expression, variable) -> tagged record.
  (func $expression_antiderivative_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $work i32)
    (local $kind_slot i32)
    (local $expression_slot i32)
    (local $pairs i32)
    (local $status i32)
    (if (i32.eqz (call $solving_two_arguments (local.get $argc) (local.get $stack_base)))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_INTEGRAL_ARGUMENTS))))))
    (if (i32.or
          (i32.eqz (call $expression_arg_type_ok
            (call $value_type (global.get $solving_argument1))))
          (i32.ne (call $value_type (global.get $solving_argument2))
            (global.get $TYPE_SYMBOL)))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_INTEGRAL_ARGUMENTS))))))
    (if (call $expression_walk_guard (i32.const 4096))
      (then (return (i32.const 0))))
    (global.set $calculus_conditions_list (i32.const 0))
    (local.set $work (call $carve_scratch_blob (i32.const 32)))
    (local.set $kind_slot (local.get $work))
    (local.set $expression_slot (i32.add (local.get $work) (i32.const 16)))
    (local.set $pairs (call $carve_scratch_blob (i32.const 48)))
    (local.set $status (call $integration_verified_antiderivative
      (global.get $solving_argument1) (global.get $solving_argument2)
      (local.get $expression_slot)))
    (if (i32.eq (local.get $status) (i32.const 1)) (then (return (i32.const 0))))
    (if (i32.eq (local.get $status) (i32.const 2))
      (then (return (i32.add (i32.const 1) (call $calculus_throw_unsupported_head)))))
    (if (i32.eq (local.get $status) (i32.const 4))
      (then
        ;; { kind: "unevaluated", expression: Integral node }.
        (if (call $integration_build_node
              (global.get $solving_argument1) (global.get $solving_argument2)
              (i32.const 0) (i32.const 0) (local.get $expression_slot))
          (then (return (i32.const 0))))
        (call $write_value (local.get $kind_slot)
          (global.get $TYPE_STRING) (i32.const 0)
          (call $read_builtin (global.get $BUILTIN_LIT_INTEGRAL_UNEVALUATED)) (i32.const 0))
        (i32.store (call $abs (local.get $pairs)) (global.get $BUILTIN_KEY_KIND))
        (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 4)))
          (local.get $kind_slot))
        (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 8)))
          (global.get $BUILTIN_KEY_EXPRESSION))
        (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 12)))
          (local.get $expression_slot))
        (local.set $status (call $calculus_record (local.get $pairs) (i32.const 2)))
        (if (i32.eqz (local.get $status)) (then (return (i32.const 0))))
        (call $pending_push (global.get $TYPE_OBJECT) (i32.const 0)
          (local.get $status) (i32.const 0))
        (return (i32.const 0))))
    ;; { kind: "verified", expression, conditions }.
    (call $write_value (local.get $kind_slot)
      (global.get $TYPE_STRING) (i32.const 0)
      (call $read_builtin (global.get $BUILTIN_LIT_INTEGRAL_VERIFIED)) (i32.const 0))
    (i32.store (call $abs (local.get $pairs)) (global.get $BUILTIN_KEY_KIND))
    (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 4))) (local.get $kind_slot))
    (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 8)))
      (global.get $BUILTIN_KEY_EXPRESSION))
    (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 12)))
      (local.get $expression_slot))
    (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 16)))
      (global.get $BUILTIN_KEY_CONDITIONS))
    (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 20)))
      (i32.add (local.get $work) (i32.const 16)))
    ;; The conditions slot must be its own storage: reuse pairs tail.
    (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 20)))
      (i32.add (local.get $pairs) (i32.const 24)))
    (call $calculus_finish_record (local.get $pairs) (i32.const 3))
  )

  ;; definiteIntegral(expression, variable, lower, upper) -> an exact value
  ;; when the verified antiderivative's conditions hold over the closed
  ;; interval between the bounds; otherwise an unevaluated definite
  ;; Integral node.
  (func $expression_definite_integral_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $expression_slot i32)
    (local $variable_slot i32)
    (local $lower_slot i32)
    (local $upper_slot i32)
    (local $work i32)
    (local $antiderivative_slot i32)
    (local $upper_value_slot i32)
    (local $lower_value_slot i32)
    (local $status i32)
    (local $node i32)
    (local $conditions_ok i32)
    (local $destination i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then (local.set $expression_slot (i32.sub (local.get $pending_pointer)
        (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))))
    (if (i32.ge_u (local.get $argc) (i32.const 4))
      (then
        (local.set $variable_slot
          (i32.add (local.get $expression_slot) (global.get $VALUE_SIZE)))
        (local.set $lower_slot (i32.add (local.get $variable_slot) (global.get $VALUE_SIZE)))
        (local.set $upper_slot (i32.add (local.get $lower_slot) (global.get $VALUE_SIZE)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (i32.or
          (i32.ne (local.get $argc) (i32.const 4))
          (i32.or
            (i32.eqz (call $expression_arg_type_ok
              (call $value_type (local.get $expression_slot))))
            (i32.ne (call $value_type (local.get $variable_slot))
              (global.get $TYPE_SYMBOL))))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_INTEGRAL_ARGUMENTS))))))
    (if (call $expression_walk_guard (i32.const 8192))
      (then (return (i32.const 0))))
    (local.set $work (call $carve_scratch_blob (i32.const 64)))
    (local.set $antiderivative_slot (local.get $work))
    (local.set $upper_value_slot (i32.add (local.get $work) (i32.const 16)))
    (local.set $lower_value_slot (i32.add (local.get $work) (i32.const 32)))
    (local.set $destination (i32.add (local.get $work) (i32.const 48)))
    ;; Equal bounds are exactly zero.
    (if (call $expression_values_equal (local.get $lower_slot) (local.get $upper_slot))
      (then
        (if (global.get $memory_pressure_signaled) (then (return (i32.const 0))))
        (call $write_inline_rational (local.get $destination) (i64.const 0))
        (call $pending_push (global.get $TYPE_RATIONAL)
          (global.get $FLAG_RATIONAL_INLINE) (i32.const 0) (i32.const 0))
        (return (i32.const 0))))
    (if (global.get $memory_pressure_signaled) (then (return (i32.const 0))))
    ;; Exact real bounds are required for endpoint substitution.
    (local.set $conditions_ok (i32.and
      (call $integration_bound_supported (local.get $lower_slot))
      (call $integration_bound_supported (local.get $upper_slot))))
    (global.set $calculus_conditions_list (i32.const 0))
    (local.set $status (i32.const 4))
    (if (local.get $conditions_ok)
      (then
        (local.set $status (call $integration_verified_antiderivative
          (local.get $expression_slot) (local.get $variable_slot)
          (local.get $antiderivative_slot)))
        (if (i32.eq (local.get $status) (i32.const 1)) (then (return (i32.const 0))))
        (if (i32.eq (local.get $status) (i32.const 2))
          (then (return (i32.add (i32.const 1)
            (call $calculus_throw_unsupported_head)))))))
    (if (i32.eqz (local.get $status))
      (then
        ;; Every condition must hold over the closed interval between the
        ;; bounds.
        (local.set $conditions_ok (call $integration_conditions_hold
          (local.get $variable_slot) (local.get $lower_slot) (local.get $upper_slot)))
        (if (i32.eq (local.get $conditions_ok) (i32.const 2))
          (then (return (i32.const 0))))
        (if (i32.eq (local.get $conditions_ok) (i32.const 3))
          (then (return (global.get $solving_staged_dispatch))))
        (if (local.get $conditions_ok)
          (then
            (if (call $expression_substitute_into (local.get $antiderivative_slot)
                  (call $value_data_lo (local.get $variable_slot))
                  (local.get $upper_slot) (local.get $upper_value_slot))
              (then (return (i32.const 0))))
            (if (call $expression_substitute_into (local.get $antiderivative_slot)
                  (call $value_data_lo (local.get $variable_slot))
                  (local.get $lower_slot) (local.get $lower_value_slot))
              (then (return (i32.const 0))))
            (if (call $build_simplified2 (global.get $BUILTIN_EXPRESSION_HEAD_SUBTRACT)
                  (local.get $upper_value_slot) (local.get $lower_value_slot)
                  (local.get $destination))
              (then (return (i32.const 0))))
            (call $pending_push
              (call $value_type (local.get $destination))
              (call $value_flags (local.get $destination))
              (call $value_data_lo (local.get $destination))
              (i32.load (call $abs (i32.add (local.get $destination) (i32.const 12)))))
            (return (i32.const 0))))))
    ;; Unevaluated definite Integral node.
    (if (call $integration_build_node
          (local.get $expression_slot) (local.get $variable_slot)
          (local.get $lower_slot) (local.get $upper_slot) (local.get $destination))
      (then (return (i32.const 0))))
    (call $pending_push
      (call $value_type (local.get $destination))
      (call $value_flags (local.get $destination))
      (call $value_data_lo (local.get $destination))
      (i32.const 0))
    (i32.const 0)
  )

  ;; Exact real bound values supported for endpoint substitution.
  (func $integration_bound_supported (param $slot i32) (result i32)
    (local $type i32)
    (local.set $type (call $value_type (local.get $slot)))
    (i32.or
      (i32.or
        (i32.eq (local.get $type) (global.get $TYPE_BIGINT))
        (i32.eq (local.get $type) (global.get $TYPE_RATIONAL)))
      (i32.eq (local.get $type) (global.get $TYPE_ALGEBRAIC)))
  )

  ;; Do all collected conditions hold over the closed interval between the
  ;; bounds? Uses the exact inequality machinery: each condition's solution
  ;; set must contain [min(bounds), max(bounds)] inside one canonical
  ;; interval. Returns 1 yes / 0 no / 2 pressure / 3 thrown (dispatch in
  ;; $solving_staged_dispatch).
  (func $integration_conditions_hold
    (param $variable_slot i32) (param $lower_slot i32) (param $upper_slot i32)
    (result i32)
    (local $node i32)
    (local $low_slot i32)
    (local $high_slot i32)
    (local $saved_pending i32)
    (local $result_slot i32)
    (local $status i32)
    (local $intervals_array i32)
    (local $length i32)
    (local $data i32)
    (local $i i32)
    (local $record i32)
    (local $entry i32)
    (local $contained i32)
    (local $comparison i32)
    (local $swap i32)
    (local.set $low_slot (local.get $lower_slot))
    (local.set $high_slot (local.get $upper_slot))
    (local.set $comparison (call $exact_real_compare_slots
      (local.get $low_slot) (local.get $high_slot)))
    (if (global.get $memory_pressure_signaled) (then (return (i32.const 2))))
    (if (i32.gt_s (local.get $comparison) (i32.const 0))
      (then
        (local.set $swap (local.get $low_slot))
        (local.set $low_slot (local.get $high_slot))
        (local.set $high_slot (local.get $swap))))
    (local.set $node (global.get $calculus_conditions_list))
    (block $checked
      (loop $check
        (br_if $checked (i32.eqz (local.get $node)))
        ;; Skip deduplication flags; every node is a relation expression
        ;; over the bound variable.
        (if (call $expression_walk_guard (i32.const 4096))
          (then (return (i32.const 2))))
        (local.set $result_slot (call $carve_scratch_blob (i32.const 48)))
        (local.set $saved_pending (call $read_ctx (global.get $CTX_PENDING_POINTER)))
        (memory.copy (call $abs (local.get $result_slot))
          (call $abs (local.get $node)) (global.get $VALUE_SIZE))
        (memory.copy (call $abs (i32.add (local.get $result_slot) (global.get $VALUE_SIZE)))
          (call $abs (local.get $variable_slot)) (global.get $VALUE_SIZE))
        (call $write_ctx (global.get $CTX_PENDING_POINTER)
          (i32.add (local.get $result_slot) (i32.mul (i32.const 2) (global.get $VALUE_SIZE))))
        (local.set $status (call $expression_solve_inequality_method
          (global.get $TYPE_OBJECT) (i32.const 0)
          (global.get $METHOD_EXACT_EXPRESSION_SOLVE_INEQUALITY)
          (i32.const 2) (local.get $result_slot)))
        (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $saved_pending))
        (global.set $solving_staged_dispatch (local.get $status))
        (if (local.get $status) (then (return (i32.const 3))))
        (if (global.get $memory_pressure_signaled) (then (return (i32.const 2))))
        (local.set $intervals_array (call $value_data_lo (local.get $result_slot)))
        (local.set $length (i32.load (call $abs
          (i32.add (local.get $intervals_array) (i32.const 8)))))
        (local.set $data (i32.add
          (i32.load (call $abs (i32.add (local.get $intervals_array) (i32.const 16))))
          (global.get $GC_HEADER_SIZE)))
        ;; [low, high] must sit inside one canonical interval.
        (local.set $contained (i32.const 0))
        (local.set $i (i32.const 0))
        (block $scanned
          (loop $scan
            (br_if $scanned (i32.ge_u (local.get $i) (local.get $length)))
            (local.set $record (call $value_data_lo (i32.add (local.get $data)
              (i32.mul (local.get $i) (global.get $VALUE_SIZE)))))
            (if (call $integration_interval_contains
                  (local.get $record) (local.get $low_slot) (local.get $high_slot))
              (then
                (local.set $contained (i32.const 1))
                (br $scanned)))
            (if (global.get $memory_pressure_signaled) (then (return (i32.const 2))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $scan)))
        (if (i32.eqz (local.get $contained)) (then (return (i32.const 0))))
        (local.set $node (i32.load (call $abs (i32.add (local.get $node) (i32.const 16)))))
        (br $check)))
    (i32.const 1)
  )

  ;; Does one canonical interval record contain the closed [low, high]?
  (func $integration_interval_contains
    (param $record i32) (param $low_slot i32) (param $high_slot i32)
    (result i32)
    (local $entry i32)
    (local $bound_slot i32)
    (local $closed i32)
    (local $comparison i32)
    ;; Lower side.
    (local.set $entry (call $object_find_string_entry (local.get $record)
      (call $read_builtin (global.get $BUILTIN_KEY_LOWER))))
    (if (i32.eqz (local.get $entry)) (then (return (i32.const 0))))
    (local.set $bound_slot (i32.add (local.get $entry) (i32.const 4)))
    (if (i32.ne (call $value_type (local.get $bound_slot)) (global.get $TYPE_UNDEFINED))
      (then
        (local.set $entry (call $object_find_string_entry (local.get $record)
          (call $read_builtin (global.get $BUILTIN_KEY_LOWER_CLOSED))))
        (local.set $closed (call $value_data_lo
          (i32.add (local.get $entry) (i32.const 4))))
        (local.set $comparison (call $exact_real_compare_slots
          (local.get $bound_slot) (local.get $low_slot)))
        (if (i32.gt_s (local.get $comparison) (i32.const 0))
          (then (return (i32.const 0))))
        (if (i32.and (i32.eqz (local.get $comparison)) (i32.eqz (local.get $closed)))
          (then (return (i32.const 0))))))
    ;; Upper side.
    (local.set $entry (call $object_find_string_entry (local.get $record)
      (call $read_builtin (global.get $BUILTIN_KEY_UPPER))))
    (if (i32.eqz (local.get $entry)) (then (return (i32.const 0))))
    (local.set $bound_slot (i32.add (local.get $entry) (i32.const 4)))
    (if (i32.ne (call $value_type (local.get $bound_slot)) (global.get $TYPE_UNDEFINED))
      (then
        (local.set $entry (call $object_find_string_entry (local.get $record)
          (call $read_builtin (global.get $BUILTIN_KEY_UPPER_CLOSED))))
        (local.set $closed (call $value_data_lo
          (i32.add (local.get $entry) (i32.const 4))))
        (local.set $comparison (call $exact_real_compare_slots
          (local.get $high_slot) (local.get $bound_slot)))
        (if (i32.gt_s (local.get $comparison) (i32.const 0))
          (then (return (i32.const 0))))
        (if (i32.and (i32.eqz (local.get $comparison)) (i32.eqz (local.get $closed)))
          (then (return (i32.const 0))))))
    (i32.const 1)
  )

  (func $expression_kind
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $arg1_type i32)
    (local $arg1_lo i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $arg1_type (call $value_type (local.get $argument1_pointer)))
        (local.set $arg1_lo (call $value_data_lo (local.get $argument1_pointer)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (i32.ne (local.get $arg1_type) (global.get $TYPE_EXPRESSION))
      (then
        (if (call $throw_type_error)
          (then (return (i32.const 2)))
          (else (return (i32.const 1))))))
    (call $push_symbol (call $expression_head (local.get $arg1_lo)))
    (i32.const 0)
  )

  (func $expression_args_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $arg1_type i32)
    (local $arg1_lo i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $arg1_type (call $value_type (local.get $argument1_pointer)))
        (local.set $arg1_lo (call $value_data_lo (local.get $argument1_pointer)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (i32.ne (local.get $arg1_type) (global.get $TYPE_EXPRESSION))
      (then
        (if (call $throw_type_error)
          (then (return (i32.const 2)))
          (else (return (i32.const 1))))))
    (call $pending_push (global.get $TYPE_ARRAY) (i32.const 0)
      (call $expression_args (local.get $arg1_lo))
      (i32.const 0))
    (i32.const 0)
  )

  (func $expression_argument_count
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $arg1_type i32)
    (local $arg1_lo i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $arg1_type (call $value_type (local.get $argument1_pointer)))
        (local.set $arg1_lo (call $value_data_lo (local.get $argument1_pointer)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (i32.ne (local.get $arg1_type) (global.get $TYPE_EXPRESSION))
      (then
        (if (call $throw_type_error)
          (then (return (i32.const 2)))
          (else (return (i32.const 1))))))
    (call $push_rational_inline (i64.extend_i32_u
      (i32.load (call $abs (i32.add
        (call $expression_args (local.get $arg1_lo))
        (i32.const 8))))))
    (i32.const 0)
  )

  (func $expression_is_expression
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $arg1_type i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $arg1_type (call $value_type (local.get $argument1_pointer)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0)
      (i32.eq (local.get $arg1_type) (global.get $TYPE_EXPRESSION))
      (i32.const 0))
    (i32.const 0)
  )

  (func $expression_is_atom
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $arg1_type i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $arg1_type (call $value_type (local.get $argument1_pointer)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0)
      (i32.or
        (i32.or
          (i32.eq (local.get $arg1_type) (global.get $TYPE_SYMBOL))
          (i32.eq (local.get $arg1_type) (global.get $TYPE_RATIONAL)))
        (i32.or
          (i32.eq (local.get $arg1_type) (global.get $TYPE_COMPLEX))
          (i32.eq (local.get $arg1_type) (global.get $TYPE_BIGINT))))
      (i32.const 0))
    (i32.const 0)
  )

  ;; Ring 3 (3a): Exact.Expression.isPolynomial(value) — the widened
  ;; polynomial-shape predicate as a public boolean. Pure query: no
  ;; allocation, no simplification, never throws.
  (func $expression_is_polynomial
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $answer i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer)
          (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $answer (i32.ne
          (call $expression_polynomial_kind (local.get $argument1_pointer))
          (global.get $POLY_KIND_NOT_POLYNOMIAL)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0)
      (local.get $answer)
      (i32.const 0))
    (i32.const 0)
  )

  (func $expression_equal
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $argument2_pointer i32)
    (local $equal_result i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))))
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then (local.set $argument2_pointer (i32.add (local.get $argument1_pointer) (global.get $VALUE_SIZE)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (local.set $equal_result
      (call $expression_values_equal (local.get $argument1_pointer) (local.get $argument2_pointer)))
    ;; The equality walk is allocation-free but its numeric-leaf compares
    ;; may signal pressure on oversized tail-scratch staging; the result
    ;; is then a dummy — yield for a gc-and-retry instead of pushing it.
    (if (global.get $memory_pressure_signaled)
      (then (return (i32.const 0))))
    (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0)
      (local.get $equal_result)
      (i32.const 0))
    (i32.const 0)
  )

  (func $expression_simplify
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    ;; Status 1 = pressure-abort: the pressure flag is already set, the
    ;; dispatcher restores the pending stack and yields for a retry.
    (if (call $expression_simplify_into
          (local.get $argument1_pointer)
          (call $read_ctx (global.get $CTX_PENDING_POINTER)))
      (then (return (i32.const 0))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER)
      (i32.add
        (call $read_ctx (global.get $CTX_PENDING_POINTER))
        (global.get $VALUE_SIZE)))
    (i32.const 0)
  )

  ;; Ring 3 (3c): final normalization for polynomialGcd's result —
  ;; strip the numeric content and fix the sign so the leading
  ;; coefficient (under canonical lex order: the FIRST term) is
  ;; positive for real-leading results; Complex-leading results keep
  ;; their units (Q6, no rotation). Numeric results pass through
  ;; unchanged (they ARE the content). Returns walk status.
  (func $polynomial_gcd_normalize (param $slot i32) (result i32)
    (local $terms_data i32)
    (local $terms_count i32)
    (local $i i32)
    (local $content i32)
    (local $operand i32)
    (local $coeff_slot i32)
    (local $status i32)
    (local $lead_negative i32)
    (if (call $expression_slot_is_numeric (local.get $slot))
      (then (return (i32.const 0))))
    (if (call $expression_walk_guard (i32.const 48))
      (then (return (i32.const 1))))
    (local.set $content (call $carve_scratch_blob
      (i32.mul (i32.const 2) (global.get $VALUE_SIZE))))
    (local.set $operand (i32.add (local.get $content) (global.get $VALUE_SIZE)))
    (call $sum_term_list (local.get $slot))
    (local.set $terms_data (global.get $sum_terms_data))
    (local.set $terms_count (global.get $sum_terms_count))
    ;; Numeric content = gcd of the terms' numeric coefficients.
    (call $write_inline_rational (local.get $content) (i64.const 0))
    (local.set $i (i32.const 0))
    (block $fold_done
      (loop $fold
        (br_if $fold_done (i32.ge_u (local.get $i) (local.get $terms_count)))
        (local.set $coeff_slot (call $term_split
          (i32.add (local.get $terms_data) (i32.mul (local.get $i) (global.get $VALUE_SIZE)))))
        (if (local.get $coeff_slot)
          (then (memory.copy (call $abs (local.get $operand))
            (call $abs (local.get $coeff_slot)) (global.get $VALUE_SIZE)))
          (else (call $write_inline_rational (local.get $operand) (i64.const 1))))
        (local.set $status (call $exact_numeric_gcd
          (local.get $content) (local.get $operand) (local.get $content)))
        (if (local.get $status) (then (return (local.get $status))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $fold)
      )
    )
    ;; Sign from the leading (first) term's coefficient: real-negative
    ;; flips the whole polynomial; Complex leading is left alone.
    (local.set $coeff_slot (call $term_split (local.get $terms_data)))
    (local.set $lead_negative (i32.const 0))
    (if (local.get $coeff_slot)
      (then
        (if (i32.ne (call $value_type (local.get $coeff_slot)) (global.get $TYPE_COMPLEX))
          (then
            (call $write_inline_rational (local.get $operand) (i64.const 0))
            (if (i32.lt_s (call $exact_numeric_slots_compare
                  (local.get $coeff_slot) (local.get $operand)) (i32.const 0))
              (then (local.set $lead_negative (i32.const 1))))))))
    (if (local.get $lead_negative)
      (then
        (call $write_inline_rational (local.get $operand) (i64.const -1))
        (local.set $status (call $build_simplified2
          (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
          (local.get $content) (local.get $operand) (local.get $content)))
        (if (local.get $status) (then (return (local.get $status))))))
    (if (call $expression_value_is_one_wide (local.get $content))
      (then (return (i32.const 0))))
    ;; Divide through — cap disabled so the per-term rescale always
    ;; distributes back to canonical form regardless of term count.
    (global.set $expansion_cap_disabled (i32.const 1))
    (local.set $status (call $build_simplified2
      (global.get $BUILTIN_EXPRESSION_HEAD_DIVIDE)
      (local.get $slot) (local.get $content) (local.get $slot)))
    (global.set $expansion_cap_disabled (i32.const 0))
    (local.get $status)
  )

  ;; Ring 3 (3b): Exact.Expression.expand(e) — simplify with the
  ;; MAX_EXPANSION_TERMS cap disabled: every Multiply-over-Add
  ;; distribution and Power(sum, n) expansion fires regardless of
  ;; predicted size. The user opted into the blow-up.
  (func $expression_expand
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $walk_status i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (global.set $expansion_cap_disabled (i32.const 1))
    (local.set $walk_status (call $expression_simplify_into
      (local.get $argument1_pointer)
      (call $read_ctx (global.get $CTX_PENDING_POINTER))))
    (global.set $expansion_cap_disabled (i32.const 0))
    (if (local.get $walk_status)
      (then (return (i32.const 0))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER)
      (i32.add
        (call $read_ctx (global.get $CTX_PENDING_POINTER))
        (global.get $VALUE_SIZE)))
    (i32.const 0)
  )

  ;; Ring 3 (3c): Exact.Expression.polynomialGcd(a, b). Validates the
  ;; polynomial-shape predicate on both inputs (TypeError otherwise),
  ;; simplifies them, runs the semantic GCD, and normalizes to
  ;; primitive form with a positive real leading coefficient.
  (func $expression_polynomial_gcd
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $argument2_pointer i32)
    (local $scratch i32)
    (local $dest i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))))
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then (local.set $argument2_pointer (i32.add (local.get $argument1_pointer) (global.get $VALUE_SIZE)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (i32.or
          (i32.lt_u (local.get $argc) (i32.const 2))
          (i32.or
            (i32.eq (call $expression_polynomial_kind (local.get $argument1_pointer))
                    (global.get $POLY_KIND_NOT_POLYNOMIAL))
            (i32.eq (call $expression_polynomial_kind (local.get $argument2_pointer))
                    (global.get $POLY_KIND_NOT_POLYNOMIAL))))
      (then
        (if (call $throw_type_error)
          (then (return (i32.const 2)))
          (else (return (i32.const 1))))))
    (if (call $expression_walk_guard (i32.const 48))
      (then (return (i32.const 0))))
    (local.set $scratch (call $carve_scratch_blob
      (i32.mul (i32.const 2) (global.get $VALUE_SIZE))))
    (if (call $expression_simplify_into (local.get $argument1_pointer) (local.get $scratch))
      (then (return (i32.const 0))))
    (if (call $expression_simplify_into (local.get $argument2_pointer)
          (i32.add (local.get $scratch) (global.get $VALUE_SIZE)))
      (then (return (i32.const 0))))
    (local.set $dest (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (call $poly_gcd_semantic
          (local.get $scratch)
          (i32.add (local.get $scratch) (global.get $VALUE_SIZE))
          (local.get $dest))
      (then (return (i32.const 0))))
    (if (call $polynomial_gcd_normalize (local.get $dest))
      (then (return (i32.const 0))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER)
      (i32.add (local.get $dest) (global.get $VALUE_SIZE)))
    (i32.const 0)
  )

  ;; Ring 3 (3c): Exact.Expression.polynomialDivide(a, b) → [quotient,
  ;; remainder]. TypeError on non-polynomial shapes (including
  ;; unsupported exponents in the chosen main variable), RangeError on
  ;; a zero divisor. Field semantics in the main variable of b (highest
  ;; degree, ties by canonical order).
  (func $expression_polynomial_divide
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $argument2_pointer i32)
    (local $scratch i32)
    (local $b_slot i32)
    (local $v_slot i32)
    (local $q_slot i32)
    (local $r_slot i32)
    (local $status i32)
    (local $array_pointer i32)
    (local $array_data i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))))
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then (local.set $argument2_pointer (i32.add (local.get $argument1_pointer) (global.get $VALUE_SIZE)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (i32.or
          (i32.lt_u (local.get $argc) (i32.const 2))
          (i32.or
            (i32.eq (call $expression_polynomial_kind (local.get $argument1_pointer))
                    (global.get $POLY_KIND_NOT_POLYNOMIAL))
            (i32.eq (call $expression_polynomial_kind (local.get $argument2_pointer))
                    (global.get $POLY_KIND_NOT_POLYNOMIAL))))
      (then
        (if (call $throw_type_error)
          (then (return (i32.const 2)))
          (else (return (i32.const 1))))))
    (if (call $expression_walk_guard (i32.const 96))
      (then (return (i32.const 0))))
    (local.set $scratch (call $carve_scratch_blob
      (i32.mul (i32.const 5) (global.get $VALUE_SIZE))))
    (local.set $b_slot (i32.add (local.get $scratch) (global.get $VALUE_SIZE)))
    (local.set $v_slot (i32.add (local.get $b_slot) (global.get $VALUE_SIZE)))
    (local.set $q_slot (i32.add (local.get $v_slot) (global.get $VALUE_SIZE)))
    (local.set $r_slot (i32.add (local.get $q_slot) (global.get $VALUE_SIZE)))
    (if (call $expression_simplify_into (local.get $argument1_pointer) (local.get $scratch))
      (then (return (i32.const 0))))
    (if (call $expression_simplify_into (local.get $argument2_pointer) (local.get $b_slot))
      (then (return (i32.const 0))))
    (if (call $expression_value_is_zero_wide (local.get $b_slot))
      (then
        (if (call $throw_range_error)
          (then (return (i32.const 2)))
          (else (return (i32.const 1))))))
    (local.set $status (call $choose_main_atom
      (local.get $b_slot) (i32.const 0) (local.get $v_slot)))
    (if (i32.eq (local.get $status) (i32.const 1))
      (then (return (i32.const 0))))
    (if (i32.eq (local.get $status) (i32.const 2))
      (then
        ;; Atom-free divisor: q = a / b, r = 0.
        (if (call $build_simplified2 (global.get $BUILTIN_EXPRESSION_HEAD_DIVIDE)
              (local.get $scratch) (local.get $b_slot) (local.get $q_slot))
          (then (return (i32.const 0))))
        (call $expression_write_zero (local.get $r_slot)))
      (else
        (local.set $status (call $poly_field_divide
          (local.get $scratch) (local.get $b_slot) (local.get $v_slot)
          (local.get $q_slot) (local.get $r_slot) (i32.const 0)))
        (if (i32.eq (local.get $status) (i32.const 1))
          (then (return (i32.const 0))))
        (if (local.get $status)
          (then
            (if (call $throw_type_error)
              (then (return (i32.const 2)))
              (else (return (i32.const 1))))))))
    ;; Build the [quotient, remainder] result array.
    (if (call $expression_walk_guard (i32.const 96))
      (then (return (i32.const 0))))
    (local.set $array_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))
    (local.set $array_data (call $write_array_header
      (local.get $array_pointer) (i32.const 2) (i32.const 2) (i32.const 48)))
    (call $write_state (global.get $STATE_HEAP_POINTER)
      (i32.add (local.get $array_data) (i32.const 48)))
    (memory.copy
      (call $abs (i32.add (local.get $array_data) (global.get $GC_HEADER_SIZE)))
      (call $abs (local.get $q_slot)) (global.get $VALUE_SIZE))
    (memory.copy
      (call $abs (i32.add
        (i32.add (local.get $array_data) (global.get $GC_HEADER_SIZE))
        (global.get $VALUE_SIZE)))
      (call $abs (local.get $r_slot)) (global.get $VALUE_SIZE))
    (call $pending_push (global.get $TYPE_ARRAY) (i32.const 0)
      (local.get $array_pointer) (i32.const 0))
    (i32.const 0)
  )

  ;; Ring 3 (3c): Exact.Expression.collect(e, v) — regroup e as a
  ;; polynomial in v: Add(c_n·v^n, …, c_1·v, c_0) with each c_i fully
  ;; simplified in the other atoms, and the grouped shape left RAW
  ;; (simplify would redistribute it). TypeError when e is not
  ;; polynomial in v — negative/non-integer exponents on v, or v
  ;; occurring inside an opaque head or coefficient.
  (func $expression_collect
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $argument2_pointer i32)
    (local $scratch i32)
    (local $v_slot i32)
    (local $residual_tmp i32)
    (local $stage_slots i32)
    (local $stage i32)
    (local $degree i64)
    (local $degree32 i32)
    (local $list i32)
    (local $status i32)
    (local $i i32)
    (local $v_type i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))))
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then (local.set $argument2_pointer (i32.add (local.get $argument1_pointer) (global.get $VALUE_SIZE)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (local.set $v_type (i32.const -1))
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then (local.set $v_type (call $value_type (local.get $argument2_pointer)))))
    (if (i32.or
          (i32.eqz (i32.or
            (i32.eq (local.get $v_type) (global.get $TYPE_SYMBOL))
            (i32.eq (local.get $v_type) (global.get $TYPE_EXPRESSION))))
          (i32.eq (call $expression_polynomial_kind (local.get $argument1_pointer))
                  (global.get $POLY_KIND_NOT_POLYNOMIAL)))
      (then
        (if (call $throw_type_error)
          (then (return (i32.const 2)))
          (else (return (i32.const 1))))))
    (if (call $expression_walk_guard (i32.const 48))
      (then (return (i32.const 0))))
    (local.set $scratch (call $carve_scratch_blob
      (i32.mul (i32.const 2) (global.get $VALUE_SIZE))))
    (local.set $residual_tmp (i32.add (local.get $scratch) (global.get $VALUE_SIZE)))
    (if (call $expression_simplify_into (local.get $argument1_pointer) (local.get $scratch))
      (then (return (i32.const 0))))
    (local.set $v_slot (local.get $argument2_pointer))
    ;; Staging + degree.
    (drop (call $poly_measure_factors (local.get $scratch)))
    (local.set $stage_slots (global.get $term_factors_count))
    (if (call $expression_walk_guard
          (i32.add (i32.mul (local.get $stage_slots) (i32.const 16)) (i32.const 16)))
      (then (return (i32.const 0))))
    (local.set $stage (call $carve_scratch_blob
      (i32.mul (local.get $stage_slots) (i32.const 16))))
    (local.set $degree (call $poly_degree_in
      (local.get $scratch) (local.get $v_slot) (local.get $stage)
      (local.get $stage_slots) (local.get $residual_tmp)))
    (if (i64.eq (local.get $degree) (i64.const -1))
      (then (return (i32.const 0))))
    (if (i32.or
          (i64.lt_s (local.get $degree) (i64.const 0))
          (i64.gt_s (local.get $degree) (i64.const 1048576)))
      (then
        (if (call $throw_type_error)
          (then (return (i32.const 2)))
          (else (return (i32.const 1))))))
    (local.set $degree32 (i32.wrap_i64 (local.get $degree)))
    (if (call $expression_walk_guard
          (i32.mul (i32.add (local.get $degree32) (i32.const 1)) (global.get $VALUE_SIZE)))
      (then (return (i32.const 0))))
    (local.set $list (call $carve_scratch_blob
      (i32.mul (i32.add (local.get $degree32) (i32.const 1)) (global.get $VALUE_SIZE))))
    (local.set $status (call $poly_extract_coefficients
      (local.get $scratch) (local.get $v_slot) (local.get $degree32)
      (local.get $list) (local.get $stage) (local.get $stage_slots)
      (local.get $residual_tmp)))
    (if (i32.eq (local.get $status) (i32.const 1))
      (then (return (i32.const 0))))
    (if (local.get $status)
      (then
        (if (call $throw_type_error)
          (then (return (i32.const 2)))
          (else (return (i32.const 1))))))
    ;; No v inside any coefficient (e.g. Sin(v), or v under an opaque
    ;; head): that is "not polynomial in v".
    (local.set $i (i32.const 0))
    (block $contain_done
      (loop $contain
        (br_if $contain_done (i32.gt_s (local.get $i) (local.get $degree32)))
        (if (call $expression_contains_value
              (i32.add (local.get $list) (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
              (local.get $v_slot))
          (then
            (if (call $throw_type_error)
              (then (return (i32.const 2)))
              (else (return (i32.const 1))))))
        (if (global.get $memory_pressure_signaled)
          (then (return (i32.const 0))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $contain)
      )
    )
    (if (call $poly_from_coefficient_list
          (local.get $list) (local.get $degree32) (local.get $v_slot)
          (call $read_ctx (global.get $CTX_PENDING_POINTER)) (i32.const 0))
      (then (return (i32.const 0))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER)
      (i32.add
        (call $read_ctx (global.get $CTX_PENDING_POINTER))
        (global.get $VALUE_SIZE)))
    (i32.const 0)
  )

  (func $expression_substitute
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $argument2_pointer i32)
    (local $arg2_type i32)
    (local $arg2_lo i32)
    (local $argument3_pointer i32)
    (local $arg3_type i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))))
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then
        (local.set $argument2_pointer (i32.add (local.get $argument1_pointer) (global.get $VALUE_SIZE)))
        (local.set $arg2_type (call $value_type (local.get $argument2_pointer)))
        (local.set $arg2_lo (call $value_data_lo (local.get $argument2_pointer)))))
    (if (i32.ge_u (local.get $argc) (i32.const 3))
      (then
        (local.set $argument3_pointer (i32.add (local.get $argument2_pointer) (global.get $VALUE_SIZE)))
        (local.set $arg3_type (call $value_type (local.get $argument3_pointer)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (i32.ne (local.get $arg2_type) (global.get $TYPE_SYMBOL))
      (then
        (if (call $throw_type_error)
          (then (return (i32.const 2)))
          (else (return (i32.const 1))))))
    ;; The replacement must stay inside the term universe (the same
    ;; set `make` enforces, plus Matrix): a foreign value spliced into
    ;; a tree would reach walkers that trust type-specific fields.
    (if (i32.eqz (call $matrix_entry_type_ok (local.get $arg3_type)))
      (then
        (if (call $throw_type_error)
          (then (return (i32.const 2)))
          (else (return (i32.const 1))))))
    ;; Status 1 = pressure-abort: the pressure flag is already set, the
    ;; dispatcher restores the pending stack and yields for a retry.
    (if (call $expression_substitute_into
          (local.get $argument1_pointer)
          (local.get $arg2_lo)
          (local.get $argument3_pointer)
          (call $read_ctx (global.get $CTX_PENDING_POINTER)))
      (then (return (i32.const 0))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER)
      (i32.add
        (call $read_ctx (global.get $CTX_PENDING_POINTER))
        (global.get $VALUE_SIZE)))
    (i32.const 0)
  )

  ;; Ring 5 (5a): Exact.Expression.match(pattern, subject, variables).
  ;; Returns a frozen Array of bound values aligned with `variables`,
  ;; or null when the pattern does not match. Validation throws:
  ;; variables must be an Array of distinct Symbols, and every listed
  ;; variable must occur in the pattern (an absent variable could
  ;; never bind — silence would hand back undefined bindings).
  (func $expression_match
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $argument2_pointer i32)
    (local $argument3_pointer i32)
    (local $variables_array i32)
    (local $variable_count i32)
    (local $variables_data i32)
    (local $i i32)
    (local $j i32)
    (local $variable_slot i32)
    (local $bindings_data i32)
    (local $result_array i32)
    (local $result_data i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))))
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then (local.set $argument2_pointer (i32.add (local.get $argument1_pointer) (global.get $VALUE_SIZE)))))
    (if (i32.ge_u (local.get $argc) (i32.const 3))
      (then (local.set $argument3_pointer (i32.add (local.get $argument2_pointer) (global.get $VALUE_SIZE)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (i32.or
          (i32.lt_u (local.get $argc) (i32.const 3))
          (i32.ne (call $value_type (local.get $argument3_pointer)) (global.get $TYPE_ARRAY)))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_MATCH_VARIABLES))))))
    (local.set $variables_array (call $value_data_lo (local.get $argument3_pointer)))
    (local.set $variable_count (i32.load (call $abs
      (i32.add (local.get $variables_array) (i32.const 8)))))
    (local.set $variables_data (i32.add
      (i32.load (call $abs (i32.add (local.get $variables_array) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    ;; Validate: every entry a Symbol, no duplicates, each occurring
    ;; in the pattern.
    (local.set $i (i32.const 0))
    (block $validate_done
      (loop $validate
        (br_if $validate_done (i32.ge_u (local.get $i) (local.get $variable_count)))
        (local.set $variable_slot (i32.add (local.get $variables_data)
          (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
        (if (i32.ne (call $value_type (local.get $variable_slot)) (global.get $TYPE_SYMBOL))
          (then (return (i32.add (i32.const 1)
            (call $throw_type_error_with_message (global.get $BUILTIN_MSG_MATCH_VARIABLES))))))
        (local.set $j (i32.const 0))
        (block $dup_done
          (loop $dup
            (br_if $dup_done (i32.ge_u (local.get $j) (local.get $i)))
            (if (i32.eq
                  (call $value_data_lo (local.get $variable_slot))
                  (call $value_data_lo (i32.add (local.get $variables_data)
                    (i32.mul (local.get $j) (global.get $VALUE_SIZE)))))
              (then (return (i32.add (i32.const 1)
                (call $throw_type_error_with_message (global.get $BUILTIN_MSG_MATCH_VARIABLES))))))
            (local.set $j (i32.add (local.get $j) (i32.const 1)))
            (br $dup)))
        (if (i32.eqz (call $expression_contains_value
              (local.get $argument1_pointer) (local.get $variable_slot)))
          (then
            (if (global.get $memory_pressure_signaled) (then (return (i32.const 0))))
            (return (i32.add (i32.const 1)
              (call $throw_type_error_with_message
                (global.get $BUILTIN_MSG_MATCH_VARIABLE_ABSENT))))))
        (if (global.get $memory_pressure_signaled) (then (return (i32.const 0))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $validate)))
    ;; Bindings scratch: variable_count zeroed slots (type 0 = unbound).
    (if (i32.gt_u (local.get $variable_count) (i32.const 0))
      (then
        (if (call $expression_walk_guard
              (i32.add (i32.mul (local.get $variable_count) (global.get $VALUE_SIZE))
                (i32.const 64)))
          (then (return (i32.const 0))))
        (local.set $bindings_data (call $carve_scratch_blob
          (i32.mul (local.get $variable_count) (global.get $VALUE_SIZE))))
        (memory.fill
          (call $abs (local.get $bindings_data))
          (i32.const 0)
          (i32.mul (local.get $variable_count) (global.get $VALUE_SIZE)))))
    (if (i32.eqz (call $expression_match_value
          (local.get $argument1_pointer) (local.get $argument2_pointer)
          (local.get $variables_data) (local.get $variable_count)
          (local.get $bindings_data)))
      (then
        (if (global.get $memory_pressure_signaled) (then (return (i32.const 0))))
        (call $pending_push (global.get $TYPE_NULL) (i32.const 0) (i32.const 0) (i32.const 0))
        (return (i32.const 0))))
    (if (global.get $memory_pressure_signaled) (then (return (i32.const 0))))
    ;; Result: a frozen Array of the bound values.
    (if (call $check_heap_overflow (i32.add (i32.const 64)
          (call $estimate_array_size (local.get $variable_count))))
      (then (return (i32.const 0))))
    (local.set $result_array (call $allocate_array (local.get $variable_count)))
    (local.set $result_data (i32.load (call $abs
      (i32.add (local.get $result_array) (i32.const 16)))))
    (if (i32.gt_u (local.get $variable_count) (i32.const 0))
      (then
        (memory.copy
          (call $abs (i32.add (local.get $result_data) (global.get $GC_HEADER_SIZE)))
          (call $abs (local.get $bindings_data))
          (i32.mul (local.get $variable_count) (global.get $VALUE_SIZE)))))
    (call $expression_freeze_args_array (local.get $result_array))
    (call $pending_push (global.get $TYPE_ARRAY) (i32.const 0) (local.get $result_array) (i32.const 0))
    (i32.const 0)
  )

  ;; ==========================================================================
  ;; Ring 6 (6a): Exact.AlgebraicNumber — real algebraic numbers.
  ;;
  ;; An AlgebraicNumber heap object is [gc:8][coefficientsArrayPointer:4]
  ;; [intervalArrayPointer:4][fieldGeneratorPointer:4]
  ;; [coordinatesArrayPointer:4], aligned to 24. coefficients is a frozen
  ;; Array of BigInt values (index = degree; primitive, positive leading
  ;; coefficient, squarefree, degree ≥ 2); interval is a frozen Array
  ;; [low, high] of Rational values — an OPEN interval with
  ;; p(low) ≠ 0 ≠ p(high) containing exactly one real root of the
  ;; defining polynomial. Refinement narrows the stored interval IN
  ;; PLACE (observational purity: the value never changes, only how
  ;; precisely it is known).
  ;;
  ;; The optional field pair retains algebraic dependence: a nonzero
  ;; fieldGeneratorPointer names gamma and coordinates stores the reduced
  ;; rational polynomial A such that this value is A(gamma). Both pointers
  ;; zero encode the common standalone case where this value is its own
  ;; generator and A(x)=x. Degree-0/1 results renormalise to Rational at
  ;; mint and dyadic bisection midpoints that evaluate to exactly zero are
  ;; extracted as Rational roots during isolation — but a rational value
  ;; CAN still be represented, as the unhit root of a degree ≥ 2
  ;; squarefree polynomial (x²−1's roots ±1 isolate as intervals).
  ;; All 6a intervals are dyadic (endpoints n / 2^k) and stay dyadic under
  ;; refinement.
  ;;
  ;; The dense engine works on transient scratch polynomials: carved
  ;; OBJ_SCRATCH blobs [degree:i32][coefficient BigInt HEADER pointers:
  ;; degree+1, ascending by power]; degree −1 encodes the zero
  ;; polynomial. Blob pointers never survive a gc — every allocation
  ;; site is guard-checked ($expression_walk_guard with the step's
  ;; parametrized bigint sizes; the guard's slack floor absorbs the
  ;; small fixed carves), a pressure signal aborts the whole operation
  ;; (status-threaded), the dispatcher yields for a gc-and-retry, and
  ;; the aborted attempt's blobs are reclaimed as garbage. Only the
  ;; final committed objects (arrays, the AlgebraicNumber itself)
  ;; outlive the attempt. Refinement's in-place interval narrowing is
  ;; retry-safe: every step preserves the full interval invariant.
  ;; ==========================================================================

  ;; Allocate a standalone-generator AlgebraicNumber. Caller has budgeted
  ;; 24 bytes. Zero field metadata is the identity representation A(x)=x.
  (func $algebraic_allocate
    (param $coefficients_array i32) (param $interval_array i32)
    (result i32)
    (local $header i32)
    (local.set $header (call $read_state (global.get $STATE_HEAP_POINTER)))
    (i32.store (call $abs (local.get $header))
      (i32.or (i32.const 24) (i32.shl (global.get $OBJ_ALGEBRAIC) (i32.const 24))))
    (i32.store (call $abs (i32.add (local.get $header) (i32.const 4))) (i32.const 0))
    (i32.store (call $abs (i32.add (local.get $header) (global.get $GC_HEADER_SIZE)))
      (local.get $coefficients_array))
    (i32.store (call $abs (i32.add (local.get $header) (i32.const 12)))
      (local.get $interval_array))
    (i32.store (call $abs (i32.add (local.get $header) (i32.const 16))) (i32.const 0))
    (i32.store (call $abs (i32.add (local.get $header) (i32.const 20))) (i32.const 0))
    (call $write_state (global.get $STATE_HEAP_POINTER)
      (i32.add (local.get $header) (i32.const 24)))
    (local.get $header)
  )

  (func $algebraic_coefficients_of (param $header i32) (result i32)
    (local $coefficients i32)
    (local.set $coefficients
      (i32.load (call $abs (i32.add (local.get $header) (global.get $GC_HEADER_SIZE)))))
    (if (i32.eqz (local.get $coefficients))
      (then
        (if (call $algebraic_materialize_standalone_cache (local.get $header))
          (then (return (i32.const 0))))
        (local.set $coefficients
          (i32.load (call $abs
            (i32.add (local.get $header) (global.get $GC_HEADER_SIZE)))))))
    (local.get $coefficients)
  )
  (func $algebraic_interval_of (param $header i32) (result i32)
    (local $interval i32)
    (local.set $interval
      (i32.load (call $abs (i32.add (local.get $header) (i32.const 12)))))
    (if (i32.eqz (local.get $interval))
      (then
        (if (call $algebraic_materialize_standalone_cache (local.get $header))
          (then (return (i32.const 0))))
        (local.set $interval
          (i32.load (call $abs (i32.add (local.get $header) (i32.const 12))))))
      )
    (local.get $interval)
  )
  (func $algebraic_field_generator_of (param $header i32) (result i32)
    (local $generator i32)
    (local.set $generator (i32.load (call $abs (i32.add (local.get $header) (i32.const 16)))))
    (if (result i32) (local.get $generator)
      (then (local.get $generator))
      (else (local.get $header)))
  )
  (func $algebraic_field_coordinates_of (param $header i32) (result i32)
    (i32.load (call $abs (i32.add (local.get $header) (i32.const 20))))
  )

  (func $algebraic_push (param $header i32)
    (call $pending_push (global.get $TYPE_ALGEBRAIC) (i32.const 0) (local.get $header) (i32.const 0))
  )

  ;; ----- scratch polynomials ------------------------------------------------

  ;; Carve a scratch polynomial for $degree (payload 4 + (degree+1)*4
  ;; bytes; degree −1 carves just the degree word). Returns the payload
  ;; pointer, or 0 on pressure.
  (func $algebraic_poly_carve (param $degree i32) (result i32)
    (local $payload i32)
    (if (call $expression_walk_guard
          (i32.mul (i32.add (local.get $degree) (i32.const 2)) (i32.const 4)))
      (then (return (i32.const 0))))
    (local.set $payload (call $carve_scratch_blob
      (i32.mul (i32.add (local.get $degree) (i32.const 2)) (i32.const 4))))
    (i32.store (call $abs (local.get $payload)) (local.get $degree))
    (local.get $payload)
  )

  (func $algebraic_poly_degree (param $poly i32) (result i32)
    (i32.load (call $abs (local.get $poly)))
  )
  (func $algebraic_poly_set_degree (param $poly i32) (param $degree i32)
    (i32.store (call $abs (local.get $poly)) (local.get $degree))
  )
  (func $algebraic_poly_coefficient (param $poly i32) (param $index i32) (result i32)
    (i32.load (call $abs (i32.add (local.get $poly)
      (i32.add (i32.const 4) (i32.mul (local.get $index) (i32.const 4))))))
  )
  (func $algebraic_poly_set_coefficient (param $poly i32) (param $index i32) (param $coefficient i32)
    (i32.store (call $abs (i32.add (local.get $poly)
      (i32.add (i32.const 4) (i32.mul (local.get $index) (i32.const 4)))))
      (local.get $coefficient))
  )

  ;; Drop leading zero coefficients from the stored degree.
  (func $algebraic_poly_trim (param $poly i32)
    (local $degree i32)
    (local.set $degree (call $algebraic_poly_degree (local.get $poly)))
    (block $done
      (loop $trim
        (br_if $done (i32.lt_s (local.get $degree) (i32.const 0)))
        (br_if $done (i32.ne
          (call $bigint_length (call $algebraic_poly_coefficient
            (local.get $poly) (local.get $degree)))
          (i32.const 0)))
        (local.set $degree (i32.sub (local.get $degree) (i32.const 1)))
        (br $trim)))
    (call $algebraic_poly_set_degree (local.get $poly) (local.get $degree))
  )

  ;; Negated copy of a BigInt (zero returns the input unchanged).
  (func $algebraic_bigint_negate (param $a i32) (result i32)
    (local $length i32)
    (local $result i32)
    (local $i i32)
    (local.set $length (call $bigint_length (local.get $a)))
    (if (i32.eqz (local.get $length)) (then (return (local.get $a))))
    (local.set $result (call $bigint_alloc
      (i32.eqz (call $bigint_sign (local.get $a))) (local.get $length)))
    (local.set $i (i32.const 0))
    (block $done
      (loop $copy
        (br_if $done (i32.ge_u (local.get $i) (local.get $length)))
        (call $bigint_set_limb (local.get $result) (local.get $i)
          (call $bigint_limb (local.get $a) (local.get $i)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $copy)))
    (local.get $result)
  )

  ;; Sign of a BigInt as -1 / 0 / 1.
  (func $algebraic_bigint_sign_value (param $a i32) (result i32)
    (if (i32.eqz (call $bigint_length (local.get $a)))
      (then (return (i32.const 0))))
    (if (call $bigint_sign (local.get $a))
      (then (return (i32.const -1))))
    (i32.const 1)
  )

  ;; Guarded gcd of two BigInt magnitudes: the shared $bigint_gcd
  ;; pre-budgets nothing (its Ring 1 callers do), so the engine
  ;; pre-guards its whole allocation — two abs copies plus the final
  ;; shift pair, doubled for margin (the binary-gcd loop itself never
  ;; allocates) — then delegates. Non-negative result. Returns 0 on
  ;; pressure (a BigInt header is never 0).
  (func $algebraic_bigint_gcd_guarded (param $a i32) (param $b i32) (result i32)
    (if (call $expression_walk_guard (i32.mul (i32.const 2) (i32.add
          (call $estimate_bigint_size
            (i32.add (call $bigint_length (local.get $a)) (i32.const 2)))
          (call $estimate_bigint_size
            (i32.add (call $bigint_length (local.get $b)) (i32.const 2))))))
      (then (return (i32.const 0))))
    (call $bigint_gcd (local.get $a) (local.get $b))
  )

  ;; Content of a scratch polynomial: gcd of |coefficients|, positive.
  ;; Zero polynomial → the zero BigInt. Returns 0 on pressure.
  (func $algebraic_poly_content (param $poly i32) (result i32)
    (local $degree i32)
    (local $i i32)
    (local $content i32)
    (local $coefficient i32)
    (local.set $degree (call $algebraic_poly_degree (local.get $poly)))
    (if (call $expression_walk_guard (i32.const 32))
      (then (return (i32.const 0))))
    (local.set $content (call $bigint_zero))
    (local.set $i (i32.const 0))
    (block $done
      (loop $fold
        (br_if $done (i32.gt_s (local.get $i) (local.get $degree)))
        (local.set $coefficient (call $algebraic_poly_coefficient
          (local.get $poly) (local.get $i)))
        (if (i32.ne (call $bigint_length (local.get $coefficient)) (i32.const 0))
          (then
            (local.set $content (call $algebraic_bigint_gcd_guarded
              (local.get $content) (local.get $coefficient)))
            (if (i32.eqz (local.get $content))
              (then (return (i32.const 0))))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $fold)))
    (local.get $content)
  )

  ;; Divide every coefficient exactly by $divisor (positive), optionally
  ;; negating, into a fresh scratch polynomial. Returns the new
  ;; polynomial or 0 on pressure.
  (func $algebraic_poly_scale_down
    (param $poly i32) (param $divisor i32) (param $negate i32)
    (result i32)
    (local $degree i32)
    (local $result i32)
    (local $i i32)
    (local $coefficient i32)
    (local $scaled i32)
    (local.set $degree (call $algebraic_poly_degree (local.get $poly)))
    (local.set $result (call $algebraic_poly_carve (local.get $degree)))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (local.set $i (i32.const 0))
    (block $done
      (loop $scale
        (br_if $done (i32.gt_s (local.get $i) (local.get $degree)))
        (local.set $coefficient (call $algebraic_poly_coefficient
          (local.get $poly) (local.get $i)))
        (if (call $expression_walk_guard (i32.mul (i32.const 4)
              (call $estimate_bigint_size (i32.add
                (call $bigint_length (local.get $coefficient)) (i32.const 2)))))
          (then (return (i32.const 0))))
        (local.set $scaled (call $bigint_div (local.get $coefficient) (local.get $divisor)))
        (if (local.get $negate)
          (then (local.set $scaled (call $algebraic_bigint_negate (local.get $scaled)))))
        (call $algebraic_poly_set_coefficient
          (local.get $result) (local.get $i) (local.get $scaled))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $scale)))
    (local.get $result)
  )

  ;; Primitive part with the sign PRESERVED (positive content divisor);
  ;; optionally negates (for Sturm's −remainder step). Zero polynomial
  ;; passes through. Returns 0 on pressure.
  (func $algebraic_poly_primitive (param $poly i32) (param $negate i32) (result i32)
    (local $content i32)
    (if (i32.lt_s (call $algebraic_poly_degree (local.get $poly)) (i32.const 0))
      (then (return (local.get $poly))))
    (local.set $content (call $algebraic_poly_content (local.get $poly)))
    (if (i32.eqz (local.get $content)) (then (return (i32.const 0))))
    (call $algebraic_poly_scale_down
      (local.get $poly) (local.get $content) (local.get $negate))
  )

  ;; Derivative into a fresh scratch polynomial. Degree-0 input yields
  ;; the zero polynomial. Returns 0 on pressure.
  (func $algebraic_poly_derivative (param $poly i32) (result i32)
    (local $degree i32)
    (local $result i32)
    (local $i i32)
    (local $coefficient i32)
    (local $factor i32)
    (local.set $degree (call $algebraic_poly_degree (local.get $poly)))
    (if (i32.le_s (local.get $degree) (i32.const 0))
      (then (return (call $algebraic_poly_carve (i32.const -1)))))
    (local.set $result (call $algebraic_poly_carve (i32.sub (local.get $degree) (i32.const 1))))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (local.set $i (i32.const 1))
    (block $done
      (loop $derive
        (br_if $done (i32.gt_s (local.get $i) (local.get $degree)))
        (local.set $coefficient (call $algebraic_poly_coefficient
          (local.get $poly) (local.get $i)))
        (if (call $expression_walk_guard (i32.mul (i32.const 3)
              (call $estimate_bigint_size (i32.add
                (call $bigint_length (local.get $coefficient)) (i32.const 2)))))
          (then (return (i32.const 0))))
        (local.set $factor (call $bigint_from_i64 (i64.extend_i32_s (local.get $i))))
        (call $algebraic_poly_set_coefficient
          (local.get $result) (i32.sub (local.get $i) (i32.const 1))
          (call $bigint_mul (local.get $coefficient) (local.get $factor)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $derive)))
    (local.get $result)
  )

  ;; Pseudo-remainder of $a by $b (deg a ≥ deg b ≥ 0), scaled to a
  ;; POSITIVE multiple of the true remainder: each reduction step
  ;; scales the running remainder by lc(b), and the accumulated sign
  ;; (sign(lc(b))^steps) is corrected at the end — Sturm's sign
  ;; relations survive positive scaling only. Fresh scratch
  ;; polynomial; degree −1 encodes a zero remainder. 0 on pressure.
  (func $algebraic_pseudo_remainder (param $a i32) (param $b i32) (result i32)
    (local $degree_b i32)
    (local $leading_b i32)
    (local $remainder i32)
    (local $degree_r i32)
    (local $leading_r i32)
    (local $next i32)
    (local $shift i32)
    (local $j i32)
    (local $term1 i32)
    (local $term2 i32)
    (local $coefficient_r i32)
    (local $coefficient_b i32)
    (local $negative_steps i32)
    (local $i i32)
    (local.set $degree_b (call $algebraic_poly_degree (local.get $b)))
    (local.set $leading_b (call $algebraic_poly_coefficient (local.get $b) (local.get $degree_b)))
    ;; Working copy of a — coefficient headers are shared (BigInts are
    ;; immutable; every reduction writes fresh ones).
    (local.set $remainder (call $algebraic_poly_carve (call $algebraic_poly_degree (local.get $a))))
    (if (i32.eqz (local.get $remainder)) (then (return (i32.const 0))))
    (local.set $i (i32.const 0))
    (block $copy_done
      (loop $copy
        (br_if $copy_done (i32.gt_s (local.get $i) (call $algebraic_poly_degree (local.get $a))))
        (call $algebraic_poly_set_coefficient (local.get $remainder) (local.get $i)
          (call $algebraic_poly_coefficient (local.get $a) (local.get $i)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $copy)))
    (block $reduce_done
      (loop $reduce
        (call $algebraic_poly_trim (local.get $remainder))
        (local.set $degree_r (call $algebraic_poly_degree (local.get $remainder)))
        (br_if $reduce_done (i32.lt_s (local.get $degree_r) (local.get $degree_b)))
        (local.set $leading_r (call $algebraic_poly_coefficient (local.get $remainder) (local.get $degree_r)))
        (local.set $shift (i32.sub (local.get $degree_r) (local.get $degree_b)))
        (local.set $next (call $algebraic_poly_carve (i32.sub (local.get $degree_r) (i32.const 1))))
        (if (i32.eqz (local.get $next)) (then (return (i32.const 0))))
        (local.set $j (i32.const 0))
        (block $row_done
          (loop $row
            (br_if $row_done (i32.gt_s (local.get $j) (i32.sub (local.get $degree_r) (i32.const 1))))
            (local.set $coefficient_r (call $algebraic_poly_coefficient (local.get $remainder) (local.get $j)))
            (if (call $expression_walk_guard (i32.mul (i32.const 4)
                  (call $estimate_bigint_size (i32.add
                    (i32.add
                      (call $bigint_length (local.get $leading_b))
                      (call $bigint_length (local.get $coefficient_r)))
                    (i32.add
                      (call $bigint_length (local.get $leading_r))
                      (i32.const 4))))))
              (then (return (i32.const 0))))
            (local.set $term1 (call $bigint_mul (local.get $leading_b) (local.get $coefficient_r)))
            (if (i32.ge_s (local.get $j) (local.get $shift))
              (then
                (local.set $coefficient_b (call $algebraic_poly_coefficient
                  (local.get $b) (i32.sub (local.get $j) (local.get $shift))))
                (if (call $expression_walk_guard (i32.mul (i32.const 3)
                      (call $estimate_bigint_size (i32.add
                        (i32.add
                          (call $bigint_length (local.get $leading_r))
                          (call $bigint_length (local.get $coefficient_b)))
                        (i32.add (call $bigint_length (local.get $term1)) (i32.const 4))))))
                  (then (return (i32.const 0))))
                (local.set $term2 (call $bigint_mul (local.get $leading_r) (local.get $coefficient_b)))
                (local.set $term1 (call $bigint_sub (local.get $term1) (local.get $term2)))))
            (call $algebraic_poly_set_coefficient (local.get $next) (local.get $j) (local.get $term1))
            (local.set $j (i32.add (local.get $j) (i32.const 1)))
            (br $row)))
        (if (call $bigint_sign (local.get $leading_b))
          (then (local.set $negative_steps (i32.xor (local.get $negative_steps) (i32.const 1)))))
        (local.set $remainder (local.get $next))
        (br $reduce)))
    ;; Correct the accumulated multiplier sign to positive.
    (if (local.get $negative_steps)
      (then
        (local.set $i (i32.const 0))
        (block $negate_done
          (loop $negate
            (br_if $negate_done (i32.gt_s (local.get $i)
              (call $algebraic_poly_degree (local.get $remainder))))
            (if (call $expression_walk_guard
                  (call $estimate_bigint_size (i32.add
                    (call $bigint_length (call $algebraic_poly_coefficient
                      (local.get $remainder) (local.get $i)))
                    (i32.const 1))))
              (then (return (i32.const 0))))
            (call $algebraic_poly_set_coefficient (local.get $remainder) (local.get $i)
              (call $algebraic_bigint_negate
                (call $algebraic_poly_coefficient (local.get $remainder) (local.get $i))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $negate)))))
    (local.get $remainder)
  )

  ;; Primitive-PRS gcd over ℤ: result primitive with positive leading
  ;; coefficient. Inputs need not be primitive. 0 on pressure.
  (func $algebraic_poly_gcd (param $a i32) (param $b i32) (result i32)
    (local $x i32)
    (local $y i32)
    (local $remainder i32)
    (local $swap i32)
    (local.set $x (call $algebraic_poly_primitive (local.get $a) (i32.const 0)))
    (if (i32.eqz (local.get $x)) (then (return (i32.const 0))))
    (local.set $y (call $algebraic_poly_primitive (local.get $b) (i32.const 0)))
    (if (i32.eqz (local.get $y)) (then (return (i32.const 0))))
    (if (i32.lt_s
          (call $algebraic_poly_degree (local.get $x))
          (call $algebraic_poly_degree (local.get $y)))
      (then
        (local.set $swap (local.get $x))
        (local.set $x (local.get $y))
        (local.set $y (local.get $swap))))
    (block $done
      (loop $euclid
        (br_if $done (i32.lt_s (call $algebraic_poly_degree (local.get $y)) (i32.const 0)))
        (local.set $remainder (call $algebraic_pseudo_remainder (local.get $x) (local.get $y)))
        (if (i32.eqz (local.get $remainder)) (then (return (i32.const 0))))
        (call $algebraic_poly_trim (local.get $remainder))
        (if (i32.ge_s (call $algebraic_poly_degree (local.get $remainder)) (i32.const 0))
          (then
            (local.set $remainder (call $algebraic_poly_primitive (local.get $remainder) (i32.const 0)))
            (if (i32.eqz (local.get $remainder)) (then (return (i32.const 0))))))
        (local.set $x (local.get $y))
        (local.set $y (local.get $remainder))
        (br $euclid)))
    ;; Force a positive leading coefficient (divide by one, negated).
    (if (call $bigint_sign (call $algebraic_poly_coefficient
          (local.get $x) (call $algebraic_poly_degree (local.get $x))))
      (then
        (if (call $expression_walk_guard (i32.const 32))
          (then (return (i32.const 0))))
        (local.set $x (call $algebraic_poly_scale_down
          (local.get $x) (call $bigint_one) (i32.const 1)))))
    (local.get $x)
  )

  ;; Exact division over ℤ — caller guarantees $b divides $a (Gauss:
  ;; a primitive divisor of a primitive polynomial has an integral
  ;; quotient, and every leading-coefficient division along the way is
  ;; exact). 0 on pressure.
  (func $algebraic_poly_exact_divide (param $a i32) (param $b i32) (result i32)
    (local $degree_a i32)
    (local $degree_b i32)
    (local $leading_b i32)
    (local $quotient i32)
    (local $work i32)
    (local $k i32)
    (local $j i32)
    (local $i i32)
    (local $quotient_coefficient i32)
    (local $index i32)
    (local $coefficient_b i32)
    (local.set $degree_a (call $algebraic_poly_degree (local.get $a)))
    (local.set $degree_b (call $algebraic_poly_degree (local.get $b)))
    (local.set $leading_b (call $algebraic_poly_coefficient (local.get $b) (local.get $degree_b)))
    (local.set $quotient (call $algebraic_poly_carve (i32.sub (local.get $degree_a) (local.get $degree_b))))
    (if (i32.eqz (local.get $quotient)) (then (return (i32.const 0))))
    (local.set $work (call $algebraic_poly_carve (local.get $degree_a)))
    (if (i32.eqz (local.get $work)) (then (return (i32.const 0))))
    (local.set $i (i32.const 0))
    (block $copy_done
      (loop $copy
        (br_if $copy_done (i32.gt_s (local.get $i) (local.get $degree_a)))
        (call $algebraic_poly_set_coefficient (local.get $work) (local.get $i)
          (call $algebraic_poly_coefficient (local.get $a) (local.get $i)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $copy)))
    (local.set $k (i32.sub (local.get $degree_a) (local.get $degree_b)))
    (block $divide_done
      (loop $divide
        (br_if $divide_done (i32.lt_s (local.get $k) (i32.const 0)))
        (local.set $index (i32.add (local.get $k) (local.get $degree_b)))
        (if (call $expression_walk_guard (i32.mul (i32.const 3)
              (call $estimate_bigint_size (i32.add
                (call $bigint_length (call $algebraic_poly_coefficient
                  (local.get $work) (local.get $index)))
                (i32.const 2)))))
          (then (return (i32.const 0))))
        (local.set $quotient_coefficient (call $bigint_div
          (call $algebraic_poly_coefficient (local.get $work) (local.get $index))
          (local.get $leading_b)))
        (call $algebraic_poly_set_coefficient
          (local.get $quotient) (local.get $k) (local.get $quotient_coefficient))
        (if (i32.ne (call $bigint_length (local.get $quotient_coefficient)) (i32.const 0))
          (then
            (local.set $j (i32.const 0))
            (block $update_done
              (loop $update
                (br_if $update_done (i32.ge_s (local.get $j) (local.get $degree_b)))
                (local.set $coefficient_b (call $algebraic_poly_coefficient (local.get $b) (local.get $j)))
                (if (call $expression_walk_guard (i32.mul (i32.const 3)
                      (call $estimate_bigint_size (i32.add
                        (i32.add
                          (call $bigint_length (local.get $quotient_coefficient))
                          (call $bigint_length (local.get $coefficient_b)))
                        (i32.add
                          (call $bigint_length (call $algebraic_poly_coefficient
                            (local.get $work) (i32.add (local.get $k) (local.get $j))))
                          (i32.const 4))))))
                  (then (return (i32.const 0))))
                (call $algebraic_poly_set_coefficient (local.get $work)
                  (i32.add (local.get $k) (local.get $j))
                  (call $bigint_sub
                    (call $algebraic_poly_coefficient (local.get $work)
                      (i32.add (local.get $k) (local.get $j)))
                    (call $bigint_mul (local.get $quotient_coefficient) (local.get $coefficient_b))))
                (local.set $j (i32.add (local.get $j) (i32.const 1)))
                (br $update)))))
        (local.set $k (i32.sub (local.get $k) (i32.const 1)))
        (br $divide)))
    (local.get $quotient)
  )

  ;; Squarefree part p / gcd(p, p′) of a primitive positive-leading
  ;; polynomial with degree ≥ 1. The quotient of primitives is
  ;; primitive (Gauss) and its leading coefficient lc(p)/lc(gcd) stays
  ;; positive, so no re-normalisation is needed. 0 on pressure.
  (func $algebraic_poly_squarefree_part (param $poly i32) (result i32)
    (local $derivative i32)
    (local $gcd i32)
    (local.set $derivative (call $algebraic_poly_derivative (local.get $poly)))
    (if (i32.eqz (local.get $derivative)) (then (return (i32.const 0))))
    (local.set $gcd (call $algebraic_poly_gcd (local.get $poly) (local.get $derivative)))
    (if (i32.eqz (local.get $gcd)) (then (return (i32.const 0))))
    (if (i32.eqz (call $algebraic_poly_degree (local.get $gcd)))
      (then (return (local.get $poly))))
    (call $algebraic_poly_exact_divide (local.get $poly) (local.get $gcd))
  )

  ;; Sign of poly at $numerator/$denominator (denominator > 0):
  ;; homogenized Horner over BigInts — acc·num + coeff(i)·den^(d−i),
  ;; no rational reduction anywhere. Returns −1/0/1, or 2 on pressure.
  (func $algebraic_sign_at
    (param $poly i32) (param $numerator i32) (param $denominator i32)
    (result i32)
    (local $degree i32)
    (local $accumulator i32)
    (local $denominator_power i32)
    (local $i i32)
    (local $coefficient i32)
    (local $heap_checkpoint i32)
    (local $result i32)
    (local.set $heap_checkpoint (call $read_state (global.get $STATE_HEAP_POINTER)))
    (local.set $degree (call $algebraic_poly_degree (local.get $poly)))
    (if (i32.lt_s (local.get $degree) (i32.const 0))
      (then (return (i32.const 0))))
    (local.set $accumulator (call $algebraic_poly_coefficient (local.get $poly) (local.get $degree)))
    (if (call $expression_walk_guard (i32.const 32))
      (then
        (call $write_state (global.get $STATE_HEAP_POINTER) (local.get $heap_checkpoint))
        (return (i32.const 2))))
    (local.set $denominator_power (call $bigint_one))
    (local.set $i (i32.sub (local.get $degree) (i32.const 1)))
    (block $done
      (loop $horner
        (br_if $done (i32.lt_s (local.get $i) (i32.const 0)))
        (local.set $coefficient (call $algebraic_poly_coefficient (local.get $poly) (local.get $i)))
        (if (call $expression_walk_guard (i32.mul (i32.const 4)
              (call $estimate_bigint_size (i32.add
                (i32.add
                  (call $bigint_length (local.get $accumulator))
                  (call $bigint_length (local.get $numerator)))
                (i32.add
                  (i32.add
                    (call $bigint_length (local.get $denominator_power))
                    (call $bigint_length (local.get $denominator)))
                  (i32.add (call $bigint_length (local.get $coefficient)) (i32.const 4)))))))
          (then
            (call $write_state (global.get $STATE_HEAP_POINTER) (local.get $heap_checkpoint))
            (return (i32.const 2))))
        (local.set $denominator_power (call $bigint_mul
          (local.get $denominator_power) (local.get $denominator)))
        (local.set $accumulator (call $bigint_add
          (call $bigint_mul (local.get $accumulator) (local.get $numerator))
          (call $bigint_mul (local.get $coefficient) (local.get $denominator_power))))
        (local.set $i (i32.sub (local.get $i) (i32.const 1)))
        (br $horner)))
    (local.set $result (call $algebraic_bigint_sign_value (local.get $accumulator)))
    (call $write_state (global.get $STATE_HEAP_POINTER) (local.get $heap_checkpoint))
    (local.get $result)
  )

  ;; Sturm chain of a squarefree primitive polynomial (degree ≥ 1):
  ;; scratch blob [count:i32][polynomial pointers…], s0 = p,
  ;; s1 = primitive(p′), s_{i+1} = primitive(−prem(s_{i−1}, s_i)).
  ;; 0 on pressure.
  (func $algebraic_sturm_build (param $poly i32) (result i32)
    (local $chain i32)
    (local $count i32)
    (local $previous i32)
    (local $current i32)
    (local $remainder i32)
    (local $capacity i32)
    (local.set $capacity (i32.add (call $algebraic_poly_degree (local.get $poly)) (i32.const 2)))
    (if (call $expression_walk_guard
          (i32.add (i32.mul (local.get $capacity) (i32.const 4)) (i32.const 32)))
      (then (return (i32.const 0))))
    (local.set $chain (call $carve_scratch_blob
      (i32.add (i32.mul (local.get $capacity) (i32.const 4)) (i32.const 4))))
    (i32.store (call $abs (i32.add (local.get $chain) (i32.const 4))) (local.get $poly))
    (local.set $count (i32.const 1))
    (local.set $current (call $algebraic_poly_derivative (local.get $poly)))
    (if (i32.eqz (local.get $current)) (then (return (i32.const 0))))
    (local.set $current (call $algebraic_poly_primitive (local.get $current) (i32.const 0)))
    (if (i32.eqz (local.get $current)) (then (return (i32.const 0))))
    (i32.store (call $abs (i32.add (local.get $chain) (i32.const 8))) (local.get $current))
    (local.set $count (i32.const 2))
    (local.set $previous (local.get $poly))
    (block $done
      (loop $extend
        (br_if $done (i32.le_s (call $algebraic_poly_degree (local.get $current)) (i32.const 0)))
        (local.set $remainder (call $algebraic_pseudo_remainder
          (local.get $previous) (local.get $current)))
        (if (i32.eqz (local.get $remainder)) (then (return (i32.const 0))))
        (call $algebraic_poly_trim (local.get $remainder))
        (br_if $done (i32.lt_s (call $algebraic_poly_degree (local.get $remainder)) (i32.const 0)))
        (local.set $remainder (call $algebraic_poly_primitive (local.get $remainder) (i32.const 1)))
        (if (i32.eqz (local.get $remainder)) (then (return (i32.const 0))))
        (i32.store (call $abs (i32.add (local.get $chain)
          (i32.add (i32.const 4) (i32.mul (local.get $count) (i32.const 4)))))
          (local.get $remainder))
        (local.set $count (i32.add (local.get $count) (i32.const 1)))
        (local.set $previous (local.get $current))
        (local.set $current (local.get $remainder))
        (br $extend)))
    (i32.store (call $abs (local.get $chain)) (local.get $count))
    (local.get $chain)
  )

  ;; Sign variations of the chain at $numerator/$denominator
  ;; (denominator > 0), zeros skipped. −1 on pressure.
  (func $algebraic_variations_at
    (param $chain i32) (param $numerator i32) (param $denominator i32)
    (result i32)
    (local $count i32)
    (local $k i32)
    (local $sign i32)
    (local $previous_sign i32)
    (local $variations i32)
    (local.set $count (i32.load (call $abs (local.get $chain))))
    (local.set $k (i32.const 0))
    (block $done
      (loop $walk
        (br_if $done (i32.ge_u (local.get $k) (local.get $count)))
        (local.set $sign (call $algebraic_sign_at
          (i32.load (call $abs (i32.add (local.get $chain)
            (i32.add (i32.const 4) (i32.mul (local.get $k) (i32.const 4))))))
          (local.get $numerator) (local.get $denominator)))
        (if (i32.eq (local.get $sign) (i32.const 2))
          (then (return (i32.const -1))))
        (if (i32.ne (local.get $sign) (i32.const 0))
          (then
            (if (i32.and
                  (i32.ne (local.get $previous_sign) (i32.const 0))
                  (i32.ne (local.get $sign) (local.get $previous_sign)))
              (then (local.set $variations (i32.add (local.get $variations) (i32.const 1)))))
            (local.set $previous_sign (local.get $sign))))
        (local.set $k (i32.add (local.get $k) (i32.const 1)))
        (br $walk)))
    (local.get $variations)
  )

  ;; Power-of-two Cauchy root bound: every real root of the polynomial
  ;; lies strictly inside ±2^result.
  (func $algebraic_root_bound_exponent (param $poly i32) (result i32)
    (local $degree i32)
    (local $leading_bits i32)
    (local $maximum_delta i32)
    (local $delta i32)
    (local $i i32)
    (local $coefficient i32)
    (local.set $degree (call $algebraic_poly_degree (local.get $poly)))
    (local.set $leading_bits (call $bigint_bit_length
      (call $algebraic_poly_coefficient (local.get $poly) (local.get $degree))))
    (local.set $i (i32.const 0))
    (block $done
      (loop $scan
        (br_if $done (i32.ge_s (local.get $i) (local.get $degree)))
        (local.set $coefficient (call $algebraic_poly_coefficient (local.get $poly) (local.get $i)))
        (if (i32.ne (call $bigint_length (local.get $coefficient)) (i32.const 0))
          (then
            (local.set $delta (i32.sub
              (call $bigint_bit_length (local.get $coefficient))
              (local.get $leading_bits)))
            (if (i32.gt_s (local.get $delta) (local.get $maximum_delta))
              (then (local.set $maximum_delta (local.get $delta))))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $scan)))
    (i32.add (local.get $maximum_delta) (i32.const 2))
  )

  ;; Left-shift a BigInt by a raw i32 bit count (the shared
  ;; $bigint_shift_left takes its count as a BigInt header).
  (func $bigint_shift_left_bits (param $value i32) (param $bits i32) (result i32)
    (if (i32.eqz (local.get $bits)) (then (return (local.get $value))))
    (call $bigint_shift_left (local.get $value)
      (call $bigint_from_i64 (i64.extend_i32_s (local.get $bits))))
  )

  ;; 2^$exponent as a BigInt. 0 on pressure.
  (func $algebraic_dyadic_denominator (param $exponent i32) (result i32)
    (local $result i32)
    (if (call $expression_walk_guard (call $estimate_bigint_size
          (i32.add (i32.shr_u (local.get $exponent) (i32.const 5)) (i32.const 3))))
      (then (return (i32.const 0))))
    (local.set $result (call $bigint_shift_left_bits (call $bigint_one) (local.get $exponent)))
    (local.get $result)
  )

  ;; Sign of poly at the dyadic point $numerator/2^$exponent.
  ;; −1/0/1, or 2 on pressure.
  (func $algebraic_sign_at_dyadic
    (param $poly i32) (param $numerator i32) (param $exponent i32)
    (result i32)
    (local $denominator i32)
    (local $heap_checkpoint i32)
    (local $result i32)
    (local.set $heap_checkpoint (call $read_state (global.get $STATE_HEAP_POINTER)))
    (local.set $denominator (call $algebraic_dyadic_denominator (local.get $exponent)))
    (if (i32.eqz (local.get $denominator))
      (then
        (call $write_state (global.get $STATE_HEAP_POINTER) (local.get $heap_checkpoint))
        (return (i32.const 2))))
    (local.set $result
      (call $algebraic_sign_at (local.get $poly) (local.get $numerator) (local.get $denominator)))
    (call $write_state (global.get $STATE_HEAP_POINTER) (local.get $heap_checkpoint))
    (local.get $result)
  )

  ;; Chain variations at the dyadic point. −1 on pressure.
  (func $algebraic_variations_at_dyadic
    (param $chain i32) (param $numerator i32) (param $exponent i32)
    (result i32)
    (local $denominator i32)
    (local $heap_checkpoint i32)
    (local $result i32)
    (local.set $heap_checkpoint (call $read_state (global.get $STATE_HEAP_POINTER)))
    (local.set $denominator (call $algebraic_dyadic_denominator (local.get $exponent)))
    (if (i32.eqz (local.get $denominator))
      (then
        (call $write_state (global.get $STATE_HEAP_POINTER) (local.get $heap_checkpoint))
        (return (i32.const -1))))
    (local.set $result
      (call $algebraic_variations_at
        (local.get $chain) (local.get $numerator) (local.get $denominator)))
    (call $write_state (global.get $STATE_HEAP_POINTER) (local.get $heap_checkpoint))
    (local.get $result)
  )

  ;; Stage a positive power-of-two pseudo BigInt in uncommitted heap-tail
  ;; scratch. Returns its byte span, or 0 after signaling pressure.
  (func $algebraic_stage_dyadic_denominator
    (param $exponent i32) (param $destination i32) (result i32)
    (local $length i32)
    (local $bytes i32)
    (local $needed i32)
    (local $limb_index i32)
    (local.set $length
      (i32.add (i32.shr_u (local.get $exponent) (i32.const 5)) (i32.const 1)))
    (local.set $bytes
      (i32.add (i32.const 16) (i32.mul (local.get $length) (i32.const 4))))
    (local.set $needed
      (i32.add
        (i32.sub (local.get $destination)
          (call $read_state (global.get $STATE_HEAP_POINTER)))
        (local.get $bytes)))
    (if (call $check_concat_scratch_overflow (local.get $needed))
      (then (return (i32.const 0))))
    (i32.store (call $abs (i32.add (local.get $destination) (i32.const 8))) (i32.const 0))
    (i32.store (call $abs (i32.add (local.get $destination) (i32.const 12)))
      (local.get $length))
    (local.set $limb_index (i32.const 0))
    (block $zero_done
      (loop $zero
        (br_if $zero_done (i32.ge_u (local.get $limb_index) (local.get $length)))
        (i32.store
          (call $abs (i32.add
            (i32.add (local.get $destination) (i32.const 16))
            (i32.mul (local.get $limb_index) (i32.const 4))))
          (i32.const 0))
        (local.set $limb_index (i32.add (local.get $limb_index) (i32.const 1)))
        (br $zero)))
    (i32.store
      (call $abs (i32.add
        (i32.add (local.get $destination) (i32.const 16))
        (i32.mul (i32.shr_u (local.get $exponent) (i32.const 5)) (i32.const 4))))
      (i32.shl (i32.const 1) (i32.and (local.get $exponent) (i32.const 31))))
    (local.get $bytes)
  )

  ;; Compare two dyadic values through temporary power-of-two denominators
  ;; and allocation-free cross-products in heap-tail scratch. −1/0/1, or
  ;; 2 on pressure.
  (func $algebraic_dyadic_compare
    (param $a_numerator i32) (param $a_exponent i32)
    (param $b_numerator i32) (param $b_exponent i32)
    (result i32)
    (local $scratch i32)
    (local $a_denominator i32)
    (local $b_denominator i32)
    (local $a_denominator_bytes i32)
    (local $b_denominator_bytes i32)
    (local $result i32)
    (local.set $scratch (call $read_state (global.get $STATE_HEAP_POINTER)))
    (local.set $a_denominator (local.get $scratch))
    (local.set $a_denominator_bytes
      (call $algebraic_stage_dyadic_denominator
        (local.get $a_exponent) (local.get $a_denominator)))
    (if (i32.eqz (local.get $a_denominator_bytes)) (then (return (i32.const 2))))
    (local.set $b_denominator
      (i32.add (local.get $a_denominator) (local.get $a_denominator_bytes)))
    (local.set $b_denominator_bytes
      (call $algebraic_stage_dyadic_denominator
        (local.get $b_exponent) (local.get $b_denominator)))
    (if (i32.eqz (local.get $b_denominator_bytes)) (then (return (i32.const 2))))
    (local.set $result (call $fraction_cross_compare
      (local.get $a_numerator) (local.get $a_denominator)
      (local.get $b_numerator) (local.get $b_denominator)
      (i32.add (local.get $b_denominator) (local.get $b_denominator_bytes))))
    (if (global.get $memory_pressure_signaled) (then (return (i32.const 2))))
    (local.get $result)
  )

  ;; ----- real-root isolation ------------------------------------------------
  ;;
  ;; Output entries (20 bytes): [kind:4][numerator:4][exponent:4]
  ;; [high_numerator:4][high_exponent:4]. kind 0 = exact rational root
  ;; at the dyadic numerator/2^exponent (a bisection midpoint that
  ;; evaluated to zero); kind 1 = open dyadic interval
  ;; (numerator/2^exponent, high_numerator/2^high_exponent) holding
  ;; exactly one root. Entries are kept sorted ascending by their
  ;; leading dyadic key (the root itself, or the interval's low
  ;; endpoint — pairwise disjointness makes that a total order).

  (global $algebraic_isolate_count (mut i32) (i32.const 0))

  ;; Insert an entry into the sorted output list. Returns 1 on
  ;; pressure, else 0.
  (func $algebraic_isolate_emit
    (param $output i32)
    (param $kind i32) (param $numerator i32) (param $exponent i32)
    (param $high_numerator i32) (param $high_exponent i32)
    (result i32)
    (local $count i32)
    (local $position i32)
    (local $comparison i32)
    (local $entry i32)
    (local.set $count (global.get $algebraic_isolate_count))
    (local.set $position (i32.const 0))
    (block $found
      (loop $scan
        (br_if $found (i32.ge_s (local.get $position) (local.get $count)))
        (local.set $entry (i32.add (local.get $output)
          (i32.mul (local.get $position) (i32.const 20))))
        (local.set $comparison (call $algebraic_dyadic_compare
          (i32.load (call $abs (i32.add (local.get $entry) (i32.const 4))))
          (i32.load (call $abs (i32.add (local.get $entry) (i32.const 8))))
          (local.get $numerator) (local.get $exponent)))
        (if (i32.eq (local.get $comparison) (i32.const 2))
          (then (return (i32.const 1))))
        (br_if $found (i32.eq (local.get $comparison) (i32.const 1)))
        (local.set $position (i32.add (local.get $position) (i32.const 1)))
        (br $scan)))
    ;; Shift the tail up one entry (memory.copy handles overlap).
    (if (i32.gt_s (local.get $count) (local.get $position))
      (then
        (memory.copy
          (call $abs (i32.add (local.get $output)
            (i32.mul (i32.add (local.get $position) (i32.const 1)) (i32.const 20))))
          (call $abs (i32.add (local.get $output)
            (i32.mul (local.get $position) (i32.const 20))))
          (i32.mul (i32.sub (local.get $count) (local.get $position)) (i32.const 20)))))
    (local.set $entry (i32.add (local.get $output)
      (i32.mul (local.get $position) (i32.const 20))))
    (i32.store (call $abs (local.get $entry)) (local.get $kind))
    (i32.store (call $abs (i32.add (local.get $entry) (i32.const 4))) (local.get $numerator))
    (i32.store (call $abs (i32.add (local.get $entry) (i32.const 8))) (local.get $exponent))
    (i32.store (call $abs (i32.add (local.get $entry) (i32.const 12))) (local.get $high_numerator))
    (i32.store (call $abs (i32.add (local.get $entry) (i32.const 16))) (local.get $high_exponent))
    (global.set $algebraic_isolate_count (i32.add (local.get $count) (i32.const 1)))
    (i32.const 0)
  )

  ;; Push a worklist interval; grows the list by doubling when full.
  ;; Updates the (mut) worklist globals. Returns 1 on pressure, else 0.
  (global $algebraic_worklist (mut i32) (i32.const 0))
  (global $algebraic_worklist_count (mut i32) (i32.const 0))
  (global $algebraic_worklist_capacity (mut i32) (i32.const 0))
  (func $algebraic_worklist_push
    (param $low_numerator i32) (param $low_exponent i32)
    (param $high_numerator i32) (param $high_exponent i32)
    (param $variations_low i32) (param $variations_high i32)
    (result i32)
    (local $grown i32)
    (local $entry i32)
    (if (i32.ge_s (global.get $algebraic_worklist_count)
          (global.get $algebraic_worklist_capacity))
      (then
        (if (call $expression_walk_guard (i32.add
              (i32.mul (global.get $algebraic_worklist_capacity) (i32.const 48))
              (i32.const 32)))
          (then (return (i32.const 1))))
        (local.set $grown (call $carve_scratch_blob
          (i32.mul (global.get $algebraic_worklist_capacity) (i32.const 48))))
        (memory.copy (call $abs (local.get $grown))
          (call $abs (global.get $algebraic_worklist))
          (i32.mul (global.get $algebraic_worklist_count) (i32.const 24)))
        (global.set $algebraic_worklist (local.get $grown))
        (global.set $algebraic_worklist_capacity
          (i32.mul (global.get $algebraic_worklist_capacity) (i32.const 2)))))
    (local.set $entry (i32.add (global.get $algebraic_worklist)
      (i32.mul (global.get $algebraic_worklist_count) (i32.const 24))))
    (i32.store (call $abs (local.get $entry)) (local.get $low_numerator))
    (i32.store (call $abs (i32.add (local.get $entry) (i32.const 4))) (local.get $low_exponent))
    (i32.store (call $abs (i32.add (local.get $entry) (i32.const 8))) (local.get $high_numerator))
    (i32.store (call $abs (i32.add (local.get $entry) (i32.const 12))) (local.get $high_exponent))
    (i32.store (call $abs (i32.add (local.get $entry) (i32.const 16))) (local.get $variations_low))
    (i32.store (call $abs (i32.add (local.get $entry) (i32.const 20))) (local.get $variations_high))
    (global.set $algebraic_worklist_count
      (i32.add (global.get $algebraic_worklist_count) (i32.const 1)))
    (i32.const 0)
  )

  ;; Isolate every real root of a squarefree primitive positive-leading
  ;; polynomial (degree ≥ 1). $output was carved by the caller with
  ;; capacity degree × 20 bytes; results land there sorted ascending,
  ;; count in $algebraic_isolate_count. Returns 0 ok / 1 pressure.
  (func $algebraic_isolate (param $poly i32) (param $output i32) (result i32)
    (local $chain i32)
    (local $bound_exponent i32)
    (local $bound_numerator i32)
    (local $entry i32)
    (local $low_numerator i32)
    (local $low_exponent i32)
    (local $high_numerator i32)
    (local $high_exponent i32)
    (local $variations_low i32)
    (local $variations_high i32)
    (local $root_count i32)
    (local $lift i32)
    (local $low_lifted i32)
    (local $high_lifted i32)
    (local $mid_numerator i32)
    (local $mid_exponent i32)
    (local $mid_sign i32)
    (local $variations_mid i32)
    (local $band_shift i32)
    (local $width_numerator i32)
    (local $band_low i32)
    (local $band_high i32)
    (local $band_exponent i32)
    (local $band_scaled_mid i32)
    (local $sign_left i32)
    (local $sign_right i32)
    (local $variations_band_low i32)
    (local $variations_band_high i32)
    (local $band_heap_checkpoint i32)
    (global.set $algebraic_isolate_count (i32.const 0))
    (local.set $chain (call $algebraic_sturm_build (local.get $poly)))
    (if (i32.eqz (local.get $chain)) (then (return (i32.const 1))))
    (local.set $bound_exponent (call $algebraic_root_bound_exponent (local.get $poly)))
    (local.set $bound_numerator (call $algebraic_dyadic_denominator (local.get $bound_exponent)))
    (if (i32.eqz (local.get $bound_numerator)) (then (return (i32.const 1))))
    ;; Worklist entries (24 bytes): [low_num][low_exp][high_num]
    ;; [high_exp][variations_low][variations_high].
    (global.set $algebraic_worklist_capacity (i32.const 64))
    (global.set $algebraic_worklist_count (i32.const 0))
    (if (call $expression_walk_guard (i32.add
          (i32.mul (global.get $algebraic_worklist_capacity) (i32.const 24)) (i32.const 64)))
      (then (return (i32.const 1))))
    (global.set $algebraic_worklist (call $carve_scratch_blob
      (i32.mul (global.get $algebraic_worklist_capacity) (i32.const 24))))
    (local.set $variations_low (call $algebraic_variations_at_dyadic (local.get $chain)
      (call $algebraic_bigint_negate (local.get $bound_numerator)) (i32.const 0)))
    (if (i32.lt_s (local.get $variations_low) (i32.const 0)) (then (return (i32.const 1))))
    (local.set $variations_high (call $algebraic_variations_at_dyadic (local.get $chain)
      (local.get $bound_numerator) (i32.const 0)))
    (if (i32.lt_s (local.get $variations_high) (i32.const 0)) (then (return (i32.const 1))))
    (if (call $algebraic_worklist_push
          (call $algebraic_bigint_negate (local.get $bound_numerator)) (i32.const 0)
          (local.get $bound_numerator) (i32.const 0)
          (local.get $variations_low) (local.get $variations_high))
      (then (return (i32.const 1))))
    (block $work_done
      (loop $work
        (br_if $work_done (i32.eqz (global.get $algebraic_worklist_count)))
        (global.set $algebraic_worklist_count
          (i32.sub (global.get $algebraic_worklist_count) (i32.const 1)))
        (local.set $entry (i32.add (global.get $algebraic_worklist)
          (i32.mul (global.get $algebraic_worklist_count) (i32.const 24))))
        (local.set $low_numerator (i32.load (call $abs (local.get $entry))))
        (local.set $low_exponent (i32.load (call $abs (i32.add (local.get $entry) (i32.const 4)))))
        (local.set $high_numerator (i32.load (call $abs (i32.add (local.get $entry) (i32.const 8)))))
        (local.set $high_exponent (i32.load (call $abs (i32.add (local.get $entry) (i32.const 12)))))
        (local.set $variations_low (i32.load (call $abs (i32.add (local.get $entry) (i32.const 16)))))
        (local.set $variations_high (i32.load (call $abs (i32.add (local.get $entry) (i32.const 20)))))
        (local.set $root_count (i32.sub (local.get $variations_low) (local.get $variations_high)))
        (br_if $work (i32.le_s (local.get $root_count) (i32.const 0)))
        (if (i32.eq (local.get $root_count) (i32.const 1))
          (then
            (if (call $algebraic_isolate_emit (local.get $output) (i32.const 1)
                  (local.get $low_numerator) (local.get $low_exponent)
                  (local.get $high_numerator) (local.get $high_exponent))
              (then (return (i32.const 1))))
            (br $work)))
        ;; Split: lift both endpoints to the shared exponent, midpoint
        ;; one level deeper.
        (local.set $lift (local.get $low_exponent))
        (if (i32.gt_s (local.get $high_exponent) (local.get $lift))
          (then (local.set $lift (local.get $high_exponent))))
        (if (call $expression_walk_guard (i32.mul (i32.const 3)
              (call $estimate_bigint_size (i32.add
                (i32.add
                  (call $bigint_length (local.get $low_numerator))
                  (call $bigint_length (local.get $high_numerator)))
                (i32.add (i32.shr_u (local.get $lift) (i32.const 5)) (i32.const 4))))))
          (then (return (i32.const 1))))
        (local.set $low_lifted (call $bigint_shift_left_bits (local.get $low_numerator)
          (i32.sub (local.get $lift) (local.get $low_exponent))))
        (local.set $high_lifted (call $bigint_shift_left_bits (local.get $high_numerator)
          (i32.sub (local.get $lift) (local.get $high_exponent))))
        (local.set $mid_numerator (call $bigint_add (local.get $low_lifted) (local.get $high_lifted)))
        (local.set $mid_exponent (i32.add (local.get $lift) (i32.const 1)))
        (local.set $mid_sign (call $algebraic_sign_at_dyadic
          (local.get $poly) (local.get $mid_numerator) (local.get $mid_exponent)))
        (if (i32.eq (local.get $mid_sign) (i32.const 2)) (then (return (i32.const 1))))
        (if (i32.ne (local.get $mid_sign) (i32.const 0))
          (then
            ;; Clean split: both halves keep nonzero endpoints.
            (local.set $variations_mid (call $algebraic_variations_at_dyadic
              (local.get $chain) (local.get $mid_numerator) (local.get $mid_exponent)))
            (if (i32.lt_s (local.get $variations_mid) (i32.const 0))
              (then (return (i32.const 1))))
            (if (call $algebraic_worklist_push
                  (local.get $low_numerator) (local.get $low_exponent)
                  (local.get $mid_numerator) (local.get $mid_exponent)
                  (local.get $variations_low) (local.get $variations_mid))
              (then (return (i32.const 1))))
            (if (call $algebraic_worklist_push
                  (local.get $mid_numerator) (local.get $mid_exponent)
                  (local.get $high_numerator) (local.get $high_exponent)
                  (local.get $variations_mid) (local.get $variations_high))
              (then (return (i32.const 1))))
            (br $work)))
        ;; The midpoint IS a root — a dyadic rational root. Record it,
        ;; then carve an exclusion band (mid − ε, mid + ε) holding only
        ;; this root, and continue on the outer pieces.
        (if (call $algebraic_isolate_emit (local.get $output) (i32.const 0)
              (local.get $mid_numerator) (local.get $mid_exponent)
              (i32.const 0) (i32.const 0))
          (then (return (i32.const 1))))
        (if (call $expression_walk_guard (i32.mul (i32.const 2)
              (call $estimate_bigint_size (i32.add
                (i32.add
                  (call $bigint_length (local.get $low_lifted))
                  (call $bigint_length (local.get $high_lifted)))
                (i32.const 4)))))
          (then (return (i32.const 1))))
        (local.set $width_numerator (call $bigint_sub
          (local.get $high_lifted) (local.get $low_lifted)))
        (local.set $band_shift (i32.const 2))
        (local.set $band_heap_checkpoint
          (call $read_state (global.get $STATE_HEAP_POINTER)))
        (block $band_done
          (loop $band
            ;; ε = width/2^band_shift; candidates mid ± ε live at
            ;; exponent lift + band_shift.
            (local.set $band_exponent (i32.add (local.get $lift) (local.get $band_shift)))
            (if (call $expression_walk_guard (i32.mul (i32.const 3)
                  (call $estimate_bigint_size (i32.add
                    (i32.add
                      (call $bigint_length (local.get $mid_numerator))
                      (call $bigint_length (local.get $width_numerator)))
                    (i32.add (i32.shr_u (local.get $band_exponent) (i32.const 5)) (i32.const 4))))))
              (then (return (i32.const 1))))
            (local.set $band_scaled_mid (call $bigint_shift_left_bits (local.get $mid_numerator)
              (i32.sub (local.get $band_shift) (i32.const 1))))
            (local.set $band_low (call $bigint_sub (local.get $band_scaled_mid) (local.get $width_numerator)))
            (local.set $band_high (call $bigint_add (local.get $band_scaled_mid) (local.get $width_numerator)))
            (local.set $sign_left (call $algebraic_sign_at_dyadic
              (local.get $poly) (local.get $band_low) (local.get $band_exponent)))
            (if (i32.eq (local.get $sign_left) (i32.const 2)) (then (return (i32.const 1))))
            (local.set $sign_right (call $algebraic_sign_at_dyadic
              (local.get $poly) (local.get $band_high) (local.get $band_exponent)))
            (if (i32.eq (local.get $sign_right) (i32.const 2)) (then (return (i32.const 1))))
            (if (i32.and
                  (i32.ne (local.get $sign_left) (i32.const 0))
                  (i32.ne (local.get $sign_right) (i32.const 0)))
              (then
                (local.set $variations_band_low (call $algebraic_variations_at_dyadic
                  (local.get $chain) (local.get $band_low) (local.get $band_exponent)))
                (if (i32.lt_s (local.get $variations_band_low) (i32.const 0))
                  (then (return (i32.const 1))))
                (local.set $variations_band_high (call $algebraic_variations_at_dyadic
                  (local.get $chain) (local.get $band_high) (local.get $band_exponent)))
                (if (i32.lt_s (local.get $variations_band_high) (i32.const 0))
                  (then (return (i32.const 1))))
                (if (i32.eq
                      (i32.sub (local.get $variations_band_low) (local.get $variations_band_high))
                      (i32.const 1))
                  (then
                    ;; The band holds only the recorded root; continue
                    ;; on the outer pieces.
                    (if (call $algebraic_worklist_push
                          (local.get $low_numerator) (local.get $low_exponent)
                          (local.get $band_low) (local.get $band_exponent)
                          (local.get $variations_low) (local.get $variations_band_low))
                      (then (return (i32.const 1))))
                    (if (call $algebraic_worklist_push
                          (local.get $band_high) (local.get $band_exponent)
                          (local.get $high_numerator) (local.get $high_exponent)
                          (local.get $variations_band_high) (local.get $variations_high))
                      (then (return (i32.const 1))))
                    (br $band_done)))))
            ;; A rejected exclusion band contributes no live state. Reclaim
            ;; its exact-arithmetic temporaries before trying the narrower
            ;; band; otherwise a rational root can consume the whole heap
            ;; inside this one non-resumable opcode.
            (call $write_state
              (global.get $STATE_HEAP_POINTER) (local.get $band_heap_checkpoint))
            (local.set $band_shift (i32.add (local.get $band_shift) (i32.const 1)))
            (br $band)))
        (br $work)))
    (i32.const 0)
  )

  ;; ----- 6b: scratch-polynomial ring arithmetic -----------------------------
  ;;
  ;; The composition engine (field arithmetic via resultants) works on
  ;; the same scratch polynomials as isolation, plus a second layer:
  ;; a "ypoly" is a scratch blob with the SAME [degree:i32][entry:4]…
  ;; layout whose entries are xpoly POINTERS instead of BigInt headers
  ;; — a polynomial in y with ℤ[x] coefficients. $algebraic_poly_carve
  ;; / _degree / _coefficient / _set_coefficient are reused verbatim
  ;; for both layers; only trim differs (zero test is xpoly degree).

  ;; a + b into a fresh scratch polynomial. 0 on pressure.
  (func $algebraic_poly_add_poly (param $a i32) (param $b i32) (result i32)
    (local $degree_a i32)
    (local $degree_b i32)
    (local $degree i32)
    (local $result i32)
    (local $i i32)
    (local $ca i32)
    (local $cb i32)
    (local $sum i32)
    (local.set $degree_a (call $algebraic_poly_degree (local.get $a)))
    (local.set $degree_b (call $algebraic_poly_degree (local.get $b)))
    (local.set $degree (select (local.get $degree_a) (local.get $degree_b)
      (i32.gt_s (local.get $degree_a) (local.get $degree_b))))
    (if (i32.lt_s (local.get $degree) (i32.const 0))
      (then (return (call $algebraic_poly_carve (i32.const -1)))))
    (local.set $result (call $algebraic_poly_carve (local.get $degree)))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (local.set $i (i32.const 0))
    (block $done
      (loop $add
        (br_if $done (i32.gt_s (local.get $i) (local.get $degree)))
        (if (i32.gt_s (local.get $i) (local.get $degree_a))
          (then (local.set $sum (call $algebraic_poly_coefficient (local.get $b) (local.get $i))))
          (else
            (if (i32.gt_s (local.get $i) (local.get $degree_b))
              (then (local.set $sum (call $algebraic_poly_coefficient (local.get $a) (local.get $i))))
              (else
                (local.set $ca (call $algebraic_poly_coefficient (local.get $a) (local.get $i)))
                (local.set $cb (call $algebraic_poly_coefficient (local.get $b) (local.get $i)))
                (if (call $expression_walk_guard (i32.mul (i32.const 2)
                      (call $estimate_bigint_size (i32.add
                        (i32.add
                          (call $bigint_length (local.get $ca))
                          (call $bigint_length (local.get $cb)))
                        (i32.const 2)))))
                  (then (return (i32.const 0))))
                (local.set $sum (call $bigint_add (local.get $ca) (local.get $cb)))))))
        (call $algebraic_poly_set_coefficient (local.get $result) (local.get $i) (local.get $sum))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $add)))
    (call $algebraic_poly_trim (local.get $result))
    (local.get $result)
  )

  ;; a − b into a fresh scratch polynomial. 0 on pressure.
  (func $algebraic_poly_sub_poly (param $a i32) (param $b i32) (result i32)
    (local $degree_a i32)
    (local $degree_b i32)
    (local $degree i32)
    (local $result i32)
    (local $i i32)
    (local $ca i32)
    (local $cb i32)
    (local $entry i32)
    (local.set $degree_a (call $algebraic_poly_degree (local.get $a)))
    (local.set $degree_b (call $algebraic_poly_degree (local.get $b)))
    (local.set $degree (select (local.get $degree_a) (local.get $degree_b)
      (i32.gt_s (local.get $degree_a) (local.get $degree_b))))
    (if (i32.lt_s (local.get $degree) (i32.const 0))
      (then (return (call $algebraic_poly_carve (i32.const -1)))))
    (local.set $result (call $algebraic_poly_carve (local.get $degree)))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (local.set $i (i32.const 0))
    (block $done
      (loop $subtract
        (br_if $done (i32.gt_s (local.get $i) (local.get $degree)))
        (if (i32.gt_s (local.get $i) (local.get $degree_a))
          (then
            (local.set $cb (call $algebraic_poly_coefficient (local.get $b) (local.get $i)))
            (if (call $expression_walk_guard
                  (call $estimate_bigint_size (i32.add
                    (call $bigint_length (local.get $cb)) (i32.const 1))))
              (then (return (i32.const 0))))
            (local.set $entry (call $algebraic_bigint_negate (local.get $cb))))
          (else
            (if (i32.gt_s (local.get $i) (local.get $degree_b))
              (then (local.set $entry (call $algebraic_poly_coefficient (local.get $a) (local.get $i))))
              (else
                (local.set $ca (call $algebraic_poly_coefficient (local.get $a) (local.get $i)))
                (local.set $cb (call $algebraic_poly_coefficient (local.get $b) (local.get $i)))
                (if (call $expression_walk_guard (i32.mul (i32.const 2)
                      (call $estimate_bigint_size (i32.add
                        (i32.add
                          (call $bigint_length (local.get $ca))
                          (call $bigint_length (local.get $cb)))
                        (i32.const 2)))))
                  (then (return (i32.const 0))))
                (local.set $entry (call $bigint_sub (local.get $ca) (local.get $cb)))))))
        (call $algebraic_poly_set_coefficient (local.get $result) (local.get $i) (local.get $entry))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $subtract)))
    (call $algebraic_poly_trim (local.get $result))
    (local.get $result)
  )

  ;; a · b (schoolbook) into a fresh scratch polynomial. 0 on pressure.
  (func $algebraic_poly_mul (param $a i32) (param $b i32) (result i32)
    (local $degree_a i32)
    (local $degree_b i32)
    (local $result i32)
    (local $i i32)
    (local $j i32)
    (local $ca i32)
    (local $cb i32)
    (local $accumulator i32)
    (local $zero i32)
    (local.set $degree_a (call $algebraic_poly_degree (local.get $a)))
    (local.set $degree_b (call $algebraic_poly_degree (local.get $b)))
    (if (i32.or
          (i32.lt_s (local.get $degree_a) (i32.const 0))
          (i32.lt_s (local.get $degree_b) (i32.const 0)))
      (then (return (call $algebraic_poly_carve (i32.const -1)))))
    (local.set $result (call $algebraic_poly_carve
      (i32.add (local.get $degree_a) (local.get $degree_b))))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (if (call $expression_walk_guard (i32.const 32))
      (then (return (i32.const 0))))
    (local.set $zero (call $bigint_zero))
    (local.set $i (i32.const 0))
    (block $fill_done
      (loop $fill
        (br_if $fill_done (i32.gt_s (local.get $i)
          (i32.add (local.get $degree_a) (local.get $degree_b))))
        (call $algebraic_poly_set_coefficient (local.get $result) (local.get $i) (local.get $zero))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $fill)))
    (local.set $i (i32.const 0))
    (block $rows_done
      (loop $rows
        (br_if $rows_done (i32.gt_s (local.get $i) (local.get $degree_a)))
        (local.set $ca (call $algebraic_poly_coefficient (local.get $a) (local.get $i)))
        (if (i32.ne (call $bigint_length (local.get $ca)) (i32.const 0))
          (then
            (local.set $j (i32.const 0))
            (block $cols_done
              (loop $cols
                (br_if $cols_done (i32.gt_s (local.get $j) (local.get $degree_b)))
                (local.set $cb (call $algebraic_poly_coefficient (local.get $b) (local.get $j)))
                (if (i32.ne (call $bigint_length (local.get $cb)) (i32.const 0))
                  (then
                    (local.set $accumulator (call $algebraic_poly_coefficient
                      (local.get $result) (i32.add (local.get $i) (local.get $j))))
                    (if (call $expression_walk_guard (i32.mul (i32.const 3)
                          (call $estimate_bigint_size (i32.add
                            (i32.add
                              (call $bigint_length (local.get $ca))
                              (call $bigint_length (local.get $cb)))
                            (i32.add (call $bigint_length (local.get $accumulator)) (i32.const 4))))))
                      (then (return (i32.const 0))))
                    (call $algebraic_poly_set_coefficient (local.get $result)
                      (i32.add (local.get $i) (local.get $j))
                      (call $bigint_add (local.get $accumulator)
                        (call $bigint_mul (local.get $ca) (local.get $cb))))))
                (local.set $j (i32.add (local.get $j) (i32.const 1)))
                (br $cols)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $rows)))
    (call $algebraic_poly_trim (local.get $result))
    (local.get $result)
  )

  ;; Drop leading zero-POLYNOMIAL entries from a ypoly's stored degree.
  (func $algebraic_ypoly_trim (param $ypoly i32)
    (local $degree i32)
    (local.set $degree (call $algebraic_poly_degree (local.get $ypoly)))
    (block $done
      (loop $trim
        (br_if $done (i32.lt_s (local.get $degree) (i32.const 0)))
        (br_if $done (i32.ge_s
          (call $algebraic_poly_degree (call $algebraic_poly_coefficient
            (local.get $ypoly) (local.get $degree)))
          (i32.const 0)))
        (local.set $degree (i32.sub (local.get $degree) (i32.const 1)))
        (br $trim)))
    (call $algebraic_poly_set_degree (local.get $ypoly) (local.get $degree))
  )

  ;; base^k over ℤ[x] by repeated multiplication (k small — Sylvester
  ;; degenerate cases only). 0 on pressure.
  (func $algebraic_poly_pow_small (param $base i32) (param $k i32) (result i32)
    (local $result i32)
    (local $i i32)
    (if (call $expression_walk_guard (i32.const 32))
      (then (return (i32.const 0))))
    (local.set $result (call $algebraic_poly_carve (i32.const 0)))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (call $algebraic_poly_set_coefficient (local.get $result) (i32.const 0) (call $bigint_one))
    (local.set $i (i32.const 0))
    (block $done
      (loop $power
        (br_if $done (i32.ge_s (local.get $i) (local.get $k)))
        (local.set $result (call $algebraic_poly_mul (local.get $result) (local.get $base)))
        (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $power)))
    (local.get $result)
  )

  ;; =====================================================================
  ;; Depth-generic multivariate polynomial substrate
  ;; uses one recursive blob shape at every coefficient depth.
  ;;
  ;; A level-k polynomial is the SAME `[degree][entry…]` blob the
  ;; level-1 (xpoly, coefficients are bigints) and level-2 (ypoly,
  ;; coefficients are xpolys) primitives already use — $algebraic_
  ;; poly_carve/_degree/_set_degree/_coefficient/_set_coefficient are
  ;; genuinely opaque-slot operations and are reused UNCHANGED at every
  ;; level. What differs by level is only how a "coefficient" (an
  ;; opaque i32 entry) is interpreted: depth 0 = the entry itself is a
  ;; bigint header; depth d>0 = the entry is a level-d polynomial
  ;; pointer, itself built from the SAME blob format one level down.
  ;;
  ;; $algebraic_poly_mul/_add_poly/_sub_poly/_exact_divide are NOT
  ;; depth-generic — they call bigint_add/_sub/_mul/_div/_length
  ;; DIRECTLY on whatever $algebraic_poly_coefficient returns. This is
  ;; correct today only because they are exclusively used at depth 0
  ;; (raw xpoly arithmetic) or, via $algebraic_ypoly_resultant's own
  ;; calls, at what is ACCIDENTALLY depth 1 (an xpoly IS a bigint's
  ;; container's contents when read through poly_coefficient on a
  ;; ypoly) — reusing them naively at depth ≥ 2 would read a
  ;; sub-polynomial pointer and call bigint_length/bigint_mul on it as
  ;; if it were a bigint header: silent heap corruption, not a crash.
  ;; The functions below are a SEPARATE, explicitly depth-parameterized
  ;; family; the existing zero-argument functions above are untouched
  ;; and remain the depth-0/accidentally-depth-1 primitives every
  ;; existing 6a–6d call site already relies on.
  ;;
  ;; Depth-0 zero/one, depth-generic (used by npoly_pow_small's base
  ;; case and by npoly_carve's zero-fill).
  (func $algebraic_npoly_zero (param $depth i32) (result i32)
    (if (i32.eqz (local.get $depth)) (then (return (call $bigint_zero))))
    (call $algebraic_poly_carve (i32.const -1))
  )
  (func $algebraic_npoly_one (param $depth i32) (result i32)
    (local $result i32)
    (if (i32.eqz (local.get $depth)) (then (return (call $bigint_one))))
    (local.set $result (call $algebraic_poly_carve (i32.const 0)))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (call $algebraic_poly_set_coefficient (local.get $result) (i32.const 0)
      (call $algebraic_npoly_one (i32.sub (local.get $depth) (i32.const 1))))
    (local.get $result)
  )

  ;; Depth-generic "is this entry the zero value at this depth" —
  ;; generalizes $algebraic_poly_trim's leaf check (bigint_length == 0)
  ;; and $algebraic_ypoly_trim's one-level check
  ;; ($algebraic_poly_degree < 0) to any depth.
  (func $algebraic_npoly_entry_is_zero (param $entry i32) (param $depth i32) (result i32)
    (if (i32.eqz (local.get $depth))
      (then (return (i32.eqz (call $bigint_length (local.get $entry))))))
    (i32.lt_s (call $algebraic_poly_degree (local.get $entry)) (i32.const 0))
  )

  ;; Depth-generic trim — generalizes $algebraic_poly_trim/
  ;; $algebraic_ypoly_trim to any depth via $algebraic_npoly_entry_is_zero.
  ;; $poly is level-$depth (matching every OTHER $algebraic_npoly_*
  ;; function's convention, e.g. $algebraic_npoly_resultant's own
  ;; $a_poly/$b_poly), so its COEFFICIENTS -- what $algebraic_poly_degree
  ;; drops when it finds one zero -- are level-($depth-1): entry_is_zero
  ;; must be checked at $depth-1, not $depth, or a level>=1 coefficient
  ;; pointer gets misread as a level-0 bigint (or vice versa) wherever a
  ;; leading coefficient is genuinely zero.
  (func $algebraic_npoly_trim (param $poly i32) (param $depth i32)
    (local $degree i32)
    (local.set $degree (call $algebraic_poly_degree (local.get $poly)))
    (block $done
      (loop $trim
        (br_if $done (i32.lt_s (local.get $degree) (i32.const 0)))
        (br_if $done (i32.eqz (call $algebraic_npoly_entry_is_zero
          (call $algebraic_poly_coefficient (local.get $poly) (local.get $degree))
          (i32.sub (local.get $depth) (i32.const 1)))))
        (local.set $degree (i32.sub (local.get $degree) (i32.const 1)))
        (br $trim)))
    (call $algebraic_poly_set_degree (local.get $poly) (local.get $degree))
  )

  ;; entry_a + entry_b at $depth (an "entry at depth d" is a bigint if
  ;; d=0, a level-d polynomial if d>0). depth 0: bigint_add; depth>0:
  ;; recurse via $algebraic_npoly_add on the level-$depth polynomials
  ;; THEMSELVES (not depth-1 — $a/$b already ARE level-$depth here,
  ;; $algebraic_npoly_add's own $depth param is the level of ITS
  ;; arguments, matching every other npoly_* poly-level function).
  (func $algebraic_npoly_entry_add (param $a i32) (param $b i32) (param $depth i32) (result i32)
    (if (i32.eqz (local.get $depth))
      (then
        (if (call $expression_walk_guard (i32.mul (i32.const 2)
              (call $estimate_bigint_size (i32.add
                (i32.add (call $bigint_length (local.get $a)) (call $bigint_length (local.get $b)))
                (i32.const 2)))))
          (then (return (i32.const 0))))
        (return (call $bigint_add (local.get $a) (local.get $b)))))
    (call $algebraic_npoly_add (local.get $a) (local.get $b) (local.get $depth))
  )
  (func $algebraic_npoly_entry_sub (param $a i32) (param $b i32) (param $depth i32) (result i32)
    (if (i32.eqz (local.get $depth))
      (then
        (if (call $expression_walk_guard (i32.mul (i32.const 2)
              (call $estimate_bigint_size (i32.add
                (i32.add (call $bigint_length (local.get $a)) (call $bigint_length (local.get $b)))
                (i32.const 2)))))
          (then (return (i32.const 0))))
        (return (call $bigint_sub (local.get $a) (local.get $b)))))
    (call $algebraic_npoly_sub (local.get $a) (local.get $b) (local.get $depth))
  )
  (func $algebraic_npoly_entry_negate (param $a i32) (param $depth i32) (result i32)
    (local $zero i32)
    (if (i32.eqz (local.get $depth))
      (then (return (call $algebraic_bigint_negate (local.get $a)))))
    (local.set $zero (call $algebraic_npoly_zero (local.get $depth)))
    (call $algebraic_npoly_entry_sub (local.get $zero) (local.get $a) (local.get $depth))
  )
  (func $algebraic_npoly_entry_mul (param $a i32) (param $b i32) (param $depth i32) (result i32)
    (if (i32.eqz (local.get $depth))
      (then
        (if (call $expression_walk_guard (i32.mul (i32.const 3)
              (call $estimate_bigint_size (i32.add
                (i32.add (call $bigint_length (local.get $a)) (call $bigint_length (local.get $b)))
                (i32.const 4)))))
          (then (return (i32.const 0))))
        (return (call $bigint_mul (local.get $a) (local.get $b)))))
    (call $algebraic_npoly_mul (local.get $a) (local.get $b) (local.get $depth))
  )
  ;; entry_a / entry_b at $depth — ASSUMES exact division (same
  ;; contract as $bigint_div's use inside $algebraic_poly_exact_divide:
  ;; only called where the caller has already established the
  ;; division is exact via a leading-coefficient-cancellation
  ;; invariant).
  (func $algebraic_npoly_entry_exact_divide (param $a i32) (param $b i32) (param $depth i32) (result i32)
    (if (i32.eqz (local.get $depth))
      (then (return (call $bigint_div (local.get $a) (local.get $b)))))
    (call $algebraic_npoly_exact_divide (local.get $a) (local.get $b) (local.get $depth))
  )

  ;; a + b at $depth into a fresh scratch level-$depth polynomial.
  ;; Direct depth-generic twin of $algebraic_poly_add_poly. 0 on
  ;; pressure.
  (func $algebraic_npoly_add (param $a i32) (param $b i32) (param $depth i32) (result i32)
    (local $degree_a i32)
    (local $degree_b i32)
    (local $degree i32)
    (local $result i32)
    (local $i i32)
    (local $sum i32)
    (local $sub_depth i32)
    (local.set $sub_depth (i32.sub (local.get $depth) (i32.const 1)))
    (local.set $degree_a (call $algebraic_poly_degree (local.get $a)))
    (local.set $degree_b (call $algebraic_poly_degree (local.get $b)))
    (local.set $degree (select (local.get $degree_a) (local.get $degree_b)
      (i32.gt_s (local.get $degree_a) (local.get $degree_b))))
    (if (i32.lt_s (local.get $degree) (i32.const 0))
      (then (return (call $algebraic_poly_carve (i32.const -1)))))
    (local.set $result (call $algebraic_poly_carve (local.get $degree)))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (local.set $i (i32.const 0))
    (block $done
      (loop $add
        (br_if $done (i32.gt_s (local.get $i) (local.get $degree)))
        (if (i32.gt_s (local.get $i) (local.get $degree_a))
          (then (local.set $sum (call $algebraic_poly_coefficient (local.get $b) (local.get $i))))
          (else
            (if (i32.gt_s (local.get $i) (local.get $degree_b))
              (then (local.set $sum (call $algebraic_poly_coefficient (local.get $a) (local.get $i))))
              (else
                (local.set $sum (call $algebraic_npoly_entry_add
                  (call $algebraic_poly_coefficient (local.get $a) (local.get $i))
                  (call $algebraic_poly_coefficient (local.get $b) (local.get $i))
                  (local.get $sub_depth)))
                (if (i32.eqz (local.get $sum)) (then (return (i32.const 0))))))))
        (call $algebraic_poly_set_coefficient (local.get $result) (local.get $i) (local.get $sum))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $add)))
    (call $algebraic_npoly_trim (local.get $result) (local.get $depth))
    (local.get $result)
  )

  ;; a - b at $depth into a fresh scratch level-$depth polynomial.
  ;; Direct depth-generic twin of $algebraic_poly_sub_poly. 0 on
  ;; pressure.
  (func $algebraic_npoly_sub (param $a i32) (param $b i32) (param $depth i32) (result i32)
    (local $degree_a i32)
    (local $degree_b i32)
    (local $degree i32)
    (local $result i32)
    (local $i i32)
    (local $entry i32)
    (local $sub_depth i32)
    (local.set $sub_depth (i32.sub (local.get $depth) (i32.const 1)))
    (local.set $degree_a (call $algebraic_poly_degree (local.get $a)))
    (local.set $degree_b (call $algebraic_poly_degree (local.get $b)))
    (local.set $degree (select (local.get $degree_a) (local.get $degree_b)
      (i32.gt_s (local.get $degree_a) (local.get $degree_b))))
    (local.set $result (call $algebraic_poly_carve (local.get $degree)))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (local.set $i (i32.const 0))
    (block $done
      (loop $subtract
        (br_if $done (i32.gt_s (local.get $i) (local.get $degree)))
        (if (i32.gt_s (local.get $i) (local.get $degree_a))
          (then
            (local.set $entry (call $algebraic_npoly_entry_negate
              (call $algebraic_poly_coefficient (local.get $b) (local.get $i))
              (local.get $sub_depth)))
            (if (i32.eqz (local.get $entry)) (then (return (i32.const 0)))))
          (else
            (if (i32.gt_s (local.get $i) (local.get $degree_b))
              (then (local.set $entry (call $algebraic_poly_coefficient (local.get $a) (local.get $i))))
              (else
                (local.set $entry (call $algebraic_npoly_entry_sub
                  (call $algebraic_poly_coefficient (local.get $a) (local.get $i))
                  (call $algebraic_poly_coefficient (local.get $b) (local.get $i))
                  (local.get $sub_depth)))
                (if (i32.eqz (local.get $entry)) (then (return (i32.const 0))))))))
        (call $algebraic_poly_set_coefficient (local.get $result) (local.get $i) (local.get $entry))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $subtract)))
    (call $algebraic_npoly_trim (local.get $result) (local.get $depth))
    (local.get $result)
  )

  ;; a * b (schoolbook) at $depth into a fresh scratch level-$depth
  ;; polynomial. Direct depth-generic twin of $algebraic_poly_mul. 0
  ;; on pressure.
  (func $algebraic_npoly_mul (param $a i32) (param $b i32) (param $depth i32) (result i32)
    (local $degree_a i32)
    (local $degree_b i32)
    (local $result i32)
    (local $i i32)
    (local $j i32)
    (local $ca i32)
    (local $cb i32)
    (local $accumulator i32)
    (local $product i32)
    (local $sub_depth i32)
    (local.set $sub_depth (i32.sub (local.get $depth) (i32.const 1)))
    (local.set $degree_a (call $algebraic_poly_degree (local.get $a)))
    (local.set $degree_b (call $algebraic_poly_degree (local.get $b)))
    (if (i32.or
          (i32.lt_s (local.get $degree_a) (i32.const 0))
          (i32.lt_s (local.get $degree_b) (i32.const 0)))
      (then (return (call $algebraic_poly_carve (i32.const -1)))))
    (local.set $result (call $algebraic_poly_carve
      (i32.add (local.get $degree_a) (local.get $degree_b))))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (local.set $i (i32.const 0))
    (block $fill_done
      (loop $fill
        (br_if $fill_done (i32.gt_s (local.get $i)
          (i32.add (local.get $degree_a) (local.get $degree_b))))
        (call $algebraic_poly_set_coefficient (local.get $result) (local.get $i)
          (call $algebraic_npoly_zero (local.get $sub_depth)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $fill)))
    (local.set $i (i32.const 0))
    (block $rows_done
      (loop $rows
        (br_if $rows_done (i32.gt_s (local.get $i) (local.get $degree_a)))
        (local.set $ca (call $algebraic_poly_coefficient (local.get $a) (local.get $i)))
        (if (i32.eqz (call $algebraic_npoly_entry_is_zero (local.get $ca) (local.get $sub_depth)))
          (then
            (local.set $j (i32.const 0))
            (block $cols_done
              (loop $cols
                (br_if $cols_done (i32.gt_s (local.get $j) (local.get $degree_b)))
                (local.set $cb (call $algebraic_poly_coefficient (local.get $b) (local.get $j)))
                (if (i32.eqz (call $algebraic_npoly_entry_is_zero (local.get $cb) (local.get $sub_depth)))
                  (then
                    (local.set $accumulator (call $algebraic_poly_coefficient
                      (local.get $result) (i32.add (local.get $i) (local.get $j))))
                    (local.set $product (call $algebraic_npoly_entry_mul
                      (local.get $ca) (local.get $cb) (local.get $sub_depth)))
                    (if (i32.eqz (local.get $product)) (then (return (i32.const 0))))
                    (local.set $accumulator (call $algebraic_npoly_entry_add
                      (local.get $accumulator) (local.get $product) (local.get $sub_depth)))
                    (if (i32.eqz (local.get $accumulator)) (then (return (i32.const 0))))
                    (call $algebraic_poly_set_coefficient (local.get $result)
                      (i32.add (local.get $i) (local.get $j)) (local.get $accumulator))))
                (local.set $j (i32.add (local.get $j) (i32.const 1)))
                (br $cols)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $rows)))
    (call $algebraic_npoly_trim (local.get $result) (local.get $depth))
    (local.get $result)
  )

  ;; Exact polynomial long division at $depth: a / b, remainder
  ;; assumed zero (same contract as $algebraic_poly_exact_divide — the
  ;; caller has already established exactness via Bareiss's leading-
  ;; coefficient-cancellation invariant). Direct depth-generic twin.
  ;; 0 on pressure.
  (func $algebraic_npoly_exact_divide (param $a i32) (param $b i32) (param $depth i32) (result i32)
    (local $degree_a i32)
    (local $degree_b i32)
    (local $leading_b i32)
    (local $quotient i32)
    (local $work i32)
    (local $k i32)
    (local $j i32)
    (local $i i32)
    (local $quotient_coefficient i32)
    (local $index i32)
    (local $coefficient_b i32)
    (local $sub_depth i32)
    (local $term i32)
    (local.set $sub_depth (i32.sub (local.get $depth) (i32.const 1)))
    (local.set $degree_a (call $algebraic_poly_degree (local.get $a)))
    (local.set $degree_b (call $algebraic_poly_degree (local.get $b)))
    (local.set $leading_b (call $algebraic_poly_coefficient (local.get $b) (local.get $degree_b)))
    (local.set $quotient (call $algebraic_poly_carve (i32.sub (local.get $degree_a) (local.get $degree_b))))
    (if (i32.eqz (local.get $quotient)) (then (return (i32.const 0))))
    (local.set $work (call $algebraic_poly_carve (local.get $degree_a)))
    (if (i32.eqz (local.get $work)) (then (return (i32.const 0))))
    (local.set $i (i32.const 0))
    (block $copy_done
      (loop $copy
        (br_if $copy_done (i32.gt_s (local.get $i) (local.get $degree_a)))
        (call $algebraic_poly_set_coefficient (local.get $work) (local.get $i)
          (call $algebraic_poly_coefficient (local.get $a) (local.get $i)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $copy)))
    (local.set $k (i32.sub (local.get $degree_a) (local.get $degree_b)))
    (block $divide_done
      (loop $divide
        (br_if $divide_done (i32.lt_s (local.get $k) (i32.const 0)))
        (local.set $index (i32.add (local.get $k) (local.get $degree_b)))
        (local.set $quotient_coefficient (call $algebraic_npoly_entry_exact_divide
          (call $algebraic_poly_coefficient (local.get $work) (local.get $index))
          (local.get $leading_b) (local.get $sub_depth)))
        (if (i32.eqz (local.get $quotient_coefficient)) (then (return (i32.const 0))))
        (call $algebraic_poly_set_coefficient
          (local.get $quotient) (local.get $k) (local.get $quotient_coefficient))
        (if (i32.eqz (call $algebraic_npoly_entry_is_zero
              (local.get $quotient_coefficient) (local.get $sub_depth)))
          (then
            (local.set $j (i32.const 0))
            (block $update_done
              (loop $update
                (br_if $update_done (i32.ge_s (local.get $j) (local.get $degree_b)))
                (local.set $coefficient_b (call $algebraic_poly_coefficient (local.get $b) (local.get $j)))
                (local.set $term (call $algebraic_npoly_entry_mul
                  (local.get $quotient_coefficient) (local.get $coefficient_b) (local.get $sub_depth)))
                (if (i32.eqz (local.get $term)) (then (return (i32.const 0))))
                (local.set $term (call $algebraic_npoly_entry_sub
                  (call $algebraic_poly_coefficient (local.get $work) (i32.add (local.get $k) (local.get $j)))
                  (local.get $term) (local.get $sub_depth)))
                (if (i32.eqz (local.get $term)) (then (return (i32.const 0))))
                (call $algebraic_poly_set_coefficient (local.get $work)
                  (i32.add (local.get $k) (local.get $j)) (local.get $term))
                (local.set $j (i32.add (local.get $j) (i32.const 1)))
                (br $update)))))
        (local.set $k (i32.sub (local.get $k) (i32.const 1)))
        (br $divide)))
    (local.get $quotient)
  )

  ;; base^k at $depth by repeated multiplication. Direct depth-generic
  ;; twin of $algebraic_poly_pow_small. 0 on pressure.
  (func $algebraic_npoly_pow_small (param $base i32) (param $k i32) (param $depth i32) (result i32)
    (local $result i32)
    (local $i i32)
    (if (call $expression_walk_guard (i32.const 32))
      (then (return (i32.const 0))))
    (local.set $result (call $algebraic_poly_carve (i32.const 0)))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (call $algebraic_poly_set_coefficient (local.get $result) (i32.const 0)
      (call $algebraic_npoly_one (i32.sub (local.get $depth) (i32.const 1))))
    (local.set $i (i32.const 0))
    (block $done
      (loop $power
        (br_if $done (i32.ge_s (local.get $i) (local.get $k)))
        (local.set $result (call $algebraic_npoly_mul (local.get $result) (local.get $base) (local.get $depth)))
        (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $power)))
    (local.get $result)
  )

  ;; Res_y(A, B) of two level-$depth polynomials, as a level-($depth-1)
  ;; polynomial using the same fraction-free Bareiss elimination as
  ;; $algebraic_ypoly_resultant, generalized through the npoly coefficient
  ;; arithmetic family. A separate, literal implementation keeps the
  ;; correctness-critical exact-arithmetic path independently auditable,
  ;; while $algebraic_ypoly_resultant remains the reference implementation.
  ;; Returns 0 on pressure.



  (func $algebraic_npoly_resultant (param $a_poly i32) (param $b_poly i32) (param $depth i32) (result i32)
    (local $degree_a i32)
    (local $degree_b i32)
    (local $dimension i32)
    (local $matrix i32)
    (local $zero_poly i32)
    (local $row i32)
    (local $column i32)
    (local $k i32)
    (local $i i32)
    (local $j i32)
    (local $pivot i32)
    (local $swap_row i32)
    (local $swap_entry i32)
    (local $sign i32)
    (local $previous i32)
    (local $term1 i32)
    (local $term2 i32)
    (local $entry i32)
    (call $algebraic_npoly_trim (local.get $a_poly) (local.get $depth))
    (call $algebraic_npoly_trim (local.get $b_poly) (local.get $depth))
    (local.set $degree_a (call $algebraic_poly_degree (local.get $a_poly)))
    (local.set $degree_b (call $algebraic_poly_degree (local.get $b_poly)))
    (if (i32.or
          (i32.lt_s (local.get $degree_a) (i32.const 0))
          (i32.lt_s (local.get $degree_b) (i32.const 0)))
      (then (return (call $algebraic_poly_carve (i32.const -1)))))
    ;; Degenerate outer-degrees: Res(constant, B) = A0^deg(B).
    (if (i32.eqz (local.get $degree_a))
      (then (return (call $algebraic_npoly_pow_small
        (call $algebraic_poly_coefficient (local.get $a_poly) (i32.const 0))
        (local.get $degree_b) (i32.sub (local.get $depth) (i32.const 1))))))
    (if (i32.eqz (local.get $degree_b))
      (then (return (call $algebraic_npoly_pow_small
        (call $algebraic_poly_coefficient (local.get $b_poly) (i32.const 0))
        (local.get $degree_a) (i32.sub (local.get $depth) (i32.const 1))))))
    (local.set $dimension (i32.add (local.get $degree_a) (local.get $degree_b)))
    (if (call $expression_walk_guard (i32.add
          (i32.mul (i32.mul (local.get $dimension) (local.get $dimension)) (i32.const 4))
          (i32.const 64)))
      (then (return (i32.const 0))))
    (local.set $matrix (call $carve_scratch_blob
      (i32.mul (i32.mul (local.get $dimension) (local.get $dimension)) (i32.const 4))))
    (local.set $zero_poly (call $algebraic_npoly_zero (i32.sub (local.get $depth) (i32.const 1))))
    (if (i32.eqz (local.get $zero_poly)) (then (return (i32.const 0))))
    ;; Fill with the shared zero entry, then lay the Sylvester rows:
    ;; rows 0..degree_b−1 carry A's coefficients (highest first), rows
    ;; degree_b..dimension−1 carry B's.
    (local.set $i (i32.const 0))
    (block $blank_done
      (loop $blank
        (br_if $blank_done (i32.ge_s (local.get $i)
          (i32.mul (local.get $dimension) (local.get $dimension))))
        (i32.store (call $abs (i32.add (local.get $matrix) (i32.mul (local.get $i) (i32.const 4))))
          (local.get $zero_poly))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $blank)))
    (local.set $row (i32.const 0))
    (block $arows_done
      (loop $arows
        (br_if $arows_done (i32.ge_s (local.get $row) (local.get $degree_b)))
        (local.set $k (i32.const 0))
        (block $acols_done
          (loop $acols
            (br_if $acols_done (i32.gt_s (local.get $k) (local.get $degree_a)))
            (i32.store (call $abs (i32.add (local.get $matrix)
              (i32.mul (i32.add (i32.mul (local.get $row) (local.get $dimension))
                (i32.add (local.get $row) (local.get $k))) (i32.const 4))))
              (call $algebraic_poly_coefficient (local.get $a_poly)
                (i32.sub (local.get $degree_a) (local.get $k))))
            (local.set $k (i32.add (local.get $k) (i32.const 1)))
            (br $acols)))
        (local.set $row (i32.add (local.get $row) (i32.const 1)))
        (br $arows)))
    (local.set $row (i32.const 0))
    (block $brows_done
      (loop $brows
        (br_if $brows_done (i32.ge_s (local.get $row) (local.get $degree_a)))
        (local.set $k (i32.const 0))
        (block $bcols_done
          (loop $bcols
            (br_if $bcols_done (i32.gt_s (local.get $k) (local.get $degree_b)))
            (i32.store (call $abs (i32.add (local.get $matrix)
              (i32.mul (i32.add
                (i32.mul (i32.add (local.get $row) (local.get $degree_b)) (local.get $dimension))
                (i32.add (local.get $row) (local.get $k))) (i32.const 4))))
              (call $algebraic_poly_coefficient (local.get $b_poly)
                (i32.sub (local.get $degree_b) (local.get $k))))
            (local.set $k (i32.add (local.get $k) (i32.const 1)))
            (br $bcols)))
        (local.set $row (i32.add (local.get $row) (i32.const 1)))
        (br $brows)))
    ;; Bareiss elimination — coefficient arithmetic at depth-1 (matrix
    ;; entries are level-(depth-1) polynomials).
    (local.set $previous (i32.const 0))
    (local.set $k (i32.const 0))
    (block $eliminate_done
      (loop $eliminate
        (br_if $eliminate_done (i32.ge_s (local.get $k)
          (i32.sub (local.get $dimension) (i32.const 1))))
        (local.set $pivot (i32.load (call $abs (i32.add (local.get $matrix)
          (i32.mul (i32.add (i32.mul (local.get $k) (local.get $dimension)) (local.get $k))
            (i32.const 4))))))
        (if (call $algebraic_npoly_entry_is_zero (local.get $pivot) (i32.sub (local.get $depth) (i32.const 1)))
          (then
            ;; Zero pivot: swap in a lower row with a nonzero entry in
            ;; this column. No such row would mean the resultant is
            ;; identically zero — impossible for the compositions this
            ;; engine is given (their leading coefficients are nonzero
            ;; by construction), so guard it as corruption.
            (local.set $swap_row (i32.add (local.get $k) (i32.const 1)))
            (block $found
              (loop $scan
                (if (i32.ge_s (local.get $swap_row) (local.get $dimension))
                  (then (unreachable)))
                (br_if $found (i32.eqz (call $algebraic_npoly_entry_is_zero
                  (i32.load (call $abs (i32.add (local.get $matrix)
                    (i32.mul (i32.add (i32.mul (local.get $swap_row) (local.get $dimension))
                      (local.get $k)) (i32.const 4)))))
                  (i32.sub (local.get $depth) (i32.const 1)))))
                (local.set $swap_row (i32.add (local.get $swap_row) (i32.const 1)))
                (br $scan)))
            (local.set $j (i32.const 0))
            (block $swap_done
              (loop $swap
                (br_if $swap_done (i32.ge_s (local.get $j) (local.get $dimension)))
                (local.set $swap_entry (i32.load (call $abs (i32.add (local.get $matrix)
                  (i32.mul (i32.add (i32.mul (local.get $k) (local.get $dimension)) (local.get $j))
                    (i32.const 4))))))
                (i32.store (call $abs (i32.add (local.get $matrix)
                  (i32.mul (i32.add (i32.mul (local.get $k) (local.get $dimension)) (local.get $j))
                    (i32.const 4))))
                  (i32.load (call $abs (i32.add (local.get $matrix)
                    (i32.mul (i32.add (i32.mul (local.get $swap_row) (local.get $dimension))
                      (local.get $j)) (i32.const 4))))))
                (i32.store (call $abs (i32.add (local.get $matrix)
                  (i32.mul (i32.add (i32.mul (local.get $swap_row) (local.get $dimension))
                    (local.get $j)) (i32.const 4))))
                  (local.get $swap_entry))
                (local.set $j (i32.add (local.get $j) (i32.const 1)))
                (br $swap)))
            (local.set $sign (i32.xor (local.get $sign) (i32.const 1)))
            (local.set $pivot (i32.load (call $abs (i32.add (local.get $matrix)
              (i32.mul (i32.add (i32.mul (local.get $k) (local.get $dimension)) (local.get $k))
                (i32.const 4))))))))
        (local.set $i (i32.add (local.get $k) (i32.const 1)))
        (block $irows_done
          (loop $irows
            (br_if $irows_done (i32.ge_s (local.get $i) (local.get $dimension)))
            (local.set $j (i32.add (local.get $k) (i32.const 1)))
            (block $jcols_done
              (loop $jcols
                (br_if $jcols_done (i32.ge_s (local.get $j) (local.get $dimension)))
                (local.set $term1 (call $algebraic_npoly_entry_mul (local.get $pivot)
                  (i32.load (call $abs (i32.add (local.get $matrix)
                    (i32.mul (i32.add (i32.mul (local.get $i) (local.get $dimension)) (local.get $j))
                      (i32.const 4)))))
                  (i32.sub (local.get $depth) (i32.const 1))))
                (if (i32.eqz (local.get $term1)) (then (return (i32.const 0))))
                (local.set $term2 (call $algebraic_npoly_entry_mul
                  (i32.load (call $abs (i32.add (local.get $matrix)
                    (i32.mul (i32.add (i32.mul (local.get $i) (local.get $dimension)) (local.get $k))
                      (i32.const 4)))))
                  (i32.load (call $abs (i32.add (local.get $matrix)
                    (i32.mul (i32.add (i32.mul (local.get $k) (local.get $dimension)) (local.get $j))
                      (i32.const 4)))))
                  (i32.sub (local.get $depth) (i32.const 1))))
                (if (i32.eqz (local.get $term2)) (then (return (i32.const 0))))
                (local.set $entry (call $algebraic_npoly_entry_sub (local.get $term1) (local.get $term2)
                  (i32.sub (local.get $depth) (i32.const 1))))
                (if (i32.eqz (local.get $entry)) (then (return (i32.const 0))))
                (if (i32.and
                      (i32.ne (local.get $previous) (i32.const 0))
                      (i32.eqz (call $algebraic_npoly_entry_is_zero (local.get $entry)
                        (i32.sub (local.get $depth) (i32.const 1)))))
                  (then
                    (local.set $entry (call $algebraic_npoly_entry_exact_divide
                      (local.get $entry) (local.get $previous) (i32.sub (local.get $depth) (i32.const 1))))
                    (if (i32.eqz (local.get $entry)) (then (return (i32.const 0))))
                    (if (local.get $depth)
                      (then
                        (if (i32.gt_s (local.get $depth) (i32.const 1))
                          (then (call $algebraic_npoly_trim (local.get $entry) (i32.sub (local.get $depth) (i32.const 1))))
                          (else (call $algebraic_poly_trim (local.get $entry))))))))
                (i32.store (call $abs (i32.add (local.get $matrix)
                  (i32.mul (i32.add (i32.mul (local.get $i) (local.get $dimension)) (local.get $j))
                    (i32.const 4))))
                  (local.get $entry))
                (local.set $j (i32.add (local.get $j) (i32.const 1)))
                (br $jcols)))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $irows)))
        (local.set $previous (local.get $pivot))
        (local.set $k (i32.add (local.get $k) (i32.const 1)))
        (br $eliminate)))
    (local.set $entry (i32.load (call $abs (i32.add (local.get $matrix)
      (i32.mul (i32.sub (i32.mul (local.get $dimension) (local.get $dimension)) (i32.const 1))
        (i32.const 4))))))
    (if (local.get $sign)
      (then
        (if (call $expression_walk_guard (i32.const 32))
          (then (return (i32.const 0))))
        (local.set $entry (call $algebraic_npoly_entry_negate
          (local.get $entry) (i32.sub (local.get $depth) (i32.const 1))))
        (if (i32.eqz (local.get $entry)) (then (return (i32.const 0))))))
    (local.get $entry)
  )

  ;; =====================================================================
  ;; Internal equivalence exports for the npoly substrate:
  ;; depth 0 matches raw bigint operations, while depth 1 matches the
  ;; $algebraic_poly_* and $algebraic_ypoly_resultant operations
  ;; bit-for-bit. They expose the recursive representation directly
  ;; so equivalence can be checked independently of the public surface.





  (func (export "test_npoly_carve") (param $degree i32) (result i32)
    (call $algebraic_poly_carve (local.get $degree)))
  (func (export "test_npoly_degree") (param $poly i32) (result i32)
    (call $algebraic_poly_degree (local.get $poly)))
  (func (export "test_npoly_set_coefficient")
    (param $poly i32) (param $index i32) (param $entry i32)
    (call $algebraic_poly_set_coefficient (local.get $poly) (local.get $index) (local.get $entry)))
  (func (export "test_npoly_coefficient") (param $poly i32) (param $index i32) (result i32)
    (call $algebraic_poly_coefficient (local.get $poly) (local.get $index)))
  ;; Poly-level ops (a/b are level-$depth POLYNOMIAL pointers; $depth
  ;; must be >= 1 — at depth 0 a/b would be raw bigints, which these
  ;; call $algebraic_poly_degree on and misread. Use the _entry_
  ;; variants below for depth-0/leaf-level testing.
  (func (export "test_npoly_add") (param $a i32) (param $b i32) (param $depth i32) (result i32)
    (call $algebraic_npoly_add (local.get $a) (local.get $b) (local.get $depth)))
  (func (export "test_npoly_sub") (param $a i32) (param $b i32) (param $depth i32) (result i32)
    (call $algebraic_npoly_sub (local.get $a) (local.get $b) (local.get $depth)))
  (func (export "test_npoly_mul") (param $a i32) (param $b i32) (param $depth i32) (result i32)
    (call $algebraic_npoly_mul (local.get $a) (local.get $b) (local.get $depth)))
  (func (export "test_npoly_exact_divide") (param $a i32) (param $b i32) (param $depth i32) (result i32)
    (call $algebraic_npoly_exact_divide (local.get $a) (local.get $b) (local.get $depth)))
  ;; Entry-level ops (a/b are level-$depth ENTRIES: bigints at depth 0,
  ;; level-$depth polynomial pointers at depth > 0) — the depth-0-aware
  ;; family every poly-level op's coefficient arithmetic actually
  ;; dispatches through.
  (func (export "test_npoly_entry_add") (param $a i32) (param $b i32) (param $depth i32) (result i32)
    (call $algebraic_npoly_entry_add (local.get $a) (local.get $b) (local.get $depth)))
  (func (export "test_npoly_entry_sub") (param $a i32) (param $b i32) (param $depth i32) (result i32)
    (call $algebraic_npoly_entry_sub (local.get $a) (local.get $b) (local.get $depth)))
  (func (export "test_npoly_entry_mul") (param $a i32) (param $b i32) (param $depth i32) (result i32)
    (call $algebraic_npoly_entry_mul (local.get $a) (local.get $b) (local.get $depth)))
  (func (export "test_npoly_entry_exact_divide") (param $a i32) (param $b i32) (param $depth i32) (result i32)
    (call $algebraic_npoly_entry_exact_divide (local.get $a) (local.get $b) (local.get $depth)))
  (func (export "test_npoly_resultant") (param $a i32) (param $b i32) (param $depth i32) (result i32)
    (call $algebraic_npoly_resultant (local.get $a) (local.get $b) (local.get $depth)))
  (func (export "test_npoly_pow_small") (param $base i32) (param $k i32) (param $depth i32) (result i32)
    (call $algebraic_npoly_pow_small (local.get $base) (local.get $k) (local.get $depth)))
  ;; Depth-0/depth-1 comparison targets — the EXISTING, unmodified
  ;; primitives, exported read-only for the same equivalence tests.
  (func (export "test_poly_mul") (param $a i32) (param $b i32) (result i32)
    (call $algebraic_poly_mul (local.get $a) (local.get $b)))
  (func (export "test_poly_add_poly") (param $a i32) (param $b i32) (result i32)
    (call $algebraic_poly_add_poly (local.get $a) (local.get $b)))
  (func (export "test_poly_sub_poly") (param $a i32) (param $b i32) (result i32)
    (call $algebraic_poly_sub_poly (local.get $a) (local.get $b)))
  (func (export "test_poly_exact_divide") (param $a i32) (param $b i32) (result i32)
    (call $algebraic_poly_exact_divide (local.get $a) (local.get $b)))
  (func (export "test_ypoly_resultant") (param $a i32) (param $b i32) (result i32)
    (call $algebraic_ypoly_resultant (local.get $a) (local.get $b)))
  (func (export "test_bigint_mul") (param $a i32) (param $b i32) (result i32)
    (call $bigint_mul (local.get $a) (local.get $b)))
  (func (export "test_bigint_add") (param $a i32) (param $b i32) (result i32)
    (call $bigint_add (local.get $a) (local.get $b)))
  (func (export "test_bigint_sub") (param $a i32) (param $b i32) (result i32)
    (call $bigint_sub (local.get $a) (local.get $b)))
  (func (export "test_carve_scratch") (param $bytes i32) (result i32)
    (call $carve_scratch_blob (local.get $bytes)))
  ;; Coefficient-classifier test surface (section 1). $term_slot is a
  ;; raw value-slot pointer (e.g. from session.mem.scopeLookup). Caller
  ;; allocates $record via test_npoly_carve-style scratch (use
  ;; test_classify_new_record) and reads it back with the accessors
  ;; below.
  (func (export "test_classify_new_record") (result i32)
    (local $record i32)
    (local.set $record (call $carve_scratch_blob (global.get $ALGEBRAIC_MONOMIAL_RECORD_SIZE)))
    (i32.store (call $abs (local.get $record))
      (call $rational_new (call $bigint_one) (call $bigint_one)))
    (i32.store (call $abs (i32.add (local.get $record) (i32.const 4))) (i32.const 0))
    (local.get $record))
  (func (export "test_classify_term") (param $record i32) (param $term_slot i32) (result i32)
    (call $algebraic_classify_term (local.get $record) (local.get $term_slot)))
  (func (export "test_classify_record_scalar") (param $record i32) (result i32)
    (i32.load (call $abs (local.get $record))))
  (func (export "test_classify_record_factor_count") (param $record i32) (result i32)
    (i32.load (call $abs (i32.add (local.get $record) (i32.const 4)))))
  (func (export "test_classify_record_factor_alpha") (param $record i32) (param $index i32) (result i32)
    (i32.load (call $abs (i32.add (local.get $record)
      (i32.add (i32.const 8) (i32.mul (local.get $index) (i32.const 8)))))))
  (func (export "test_classify_record_factor_exponent") (param $record i32) (param $index i32) (result i32)
    (i32.load (call $abs (i32.add (local.get $record)
      (i32.add (i32.const 12) (i32.mul (local.get $index) (i32.const 8)))))))
  ;; Registry-collection test surface (section 3 groundwork).
  ;; $poly_slot/$v_slot mirror algebraic_roots_of_polynomial's own
  ;; canonicalize -> degree -> extract-coefficients pipeline exactly,
  ;; so tests exercise the registry collector against the REAL
  ;; post-simplify coefficient shapes. Returns the registry entry
  ;; count (or a negative encoding of a failure status: -(status)-100
  ;; to keep it unambiguous from a legitimate 0..16 count) and writes
  ;; up to 16 alpha headers into the caller-provided $registry buffer.
  (func (export "test_collect_registry")
    (param $poly_slot i32) (param $v_slot i32) (param $registry i32) (param $max_exponents i32) (result i32)
    (local $stage i32)
    (local $stage2 i32)
    (local $stage_slots i32)
    (local $residual i32)
    (local $degree64 i64)
    (local $degree i32)
    (local $list i32)
    (local $status i32)
    (local $count_scratch i32)
    (local.set $stage (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (local.set $residual (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (if (call $expression_simplify_into (local.get $poly_slot) (local.get $stage))
      (then (return (i32.const -101))))
    (drop (call $poly_measure_factors (local.get $stage)))
    (local.set $stage_slots (global.get $term_factors_count))
    (local.set $stage2 (call $carve_scratch_blob (i32.mul (local.get $stage_slots) (i32.const 16))))
    (local.set $degree64 (call $poly_degree_in
      (local.get $stage) (local.get $v_slot) (local.get $stage2)
      (local.get $stage_slots) (local.get $residual)))
    (if (i64.lt_s (local.get $degree64) (i64.const 0)) (then (return (i32.const -102))))
    (local.set $degree (i32.wrap_i64 (local.get $degree64)))
    (local.set $list (call $carve_scratch_blob
      (i32.mul (i32.add (local.get $degree) (i32.const 1)) (global.get $VALUE_SIZE))))
    (local.set $status (call $poly_extract_coefficients
      (local.get $stage) (local.get $v_slot) (local.get $degree)
      (local.get $list) (local.get $stage2) (local.get $stage_slots)
      (local.get $residual)))
    (if (local.get $status) (then (return (i32.sub (i32.const -103) (local.get $status)))))
    (local.set $count_scratch (call $carve_scratch_blob (i32.const 4)))
    (local.set $status (call $algebraic_collect_variable_registry
      (local.get $list) (local.get $degree) (local.get $registry)
      (local.get $max_exponents) (local.get $count_scratch)))
    (if (local.get $status) (then (return (i32.sub (i32.const -200) (local.get $status)))))
    (i32.load (call $abs (local.get $count_scratch))))
  ;; White-box G construction over the raw expression shape. The public
  ;; pipeline simplifies exact coefficients first; this export
  ;; retains factor structure to test registry exponents and nested-polynomial
  ;; construction directly. $registry/$max_exponents
  ;; are caller-provided scratch (>=16*4 bytes each, as in
  ;; test_collect_registry); $g_out is caller-provided scratch of
  ;; >=($degree+1)*4 bytes, filled with the level-r polynomial pointer
  ;; for each x-power. Returns the x-degree on success (>= 0), or a
  ;; negative failure encoding (same convention as test_collect_registry,
  ;; with build_g failures at -300-status).
  (func (export "test_build_g")
    (param $poly_slot i32) (param $v_slot i32)
    (param $registry i32) (param $max_exponents i32) (param $g_out i32) (result i32)
    (local $stage i32)
    (local $stage2 i32)
    (local $stage_slots i32)
    (local $residual i32)
    (local $degree64 i64)
    (local $degree i32)
    (local $list i32)
    (local $status i32)
    (local $count_scratch i32)
    (local $registry_count i32)
    (local.set $stage (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (local.set $residual (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (memory.copy (call $abs (local.get $stage))
      (call $abs (local.get $poly_slot)) (global.get $VALUE_SIZE))
    (drop (call $poly_measure_factors (local.get $stage)))
    (local.set $stage_slots (global.get $term_factors_count))
    (local.set $stage2 (call $carve_scratch_blob (i32.mul (local.get $stage_slots) (i32.const 16))))
    (local.set $degree64 (call $poly_degree_in
      (local.get $stage) (local.get $v_slot) (local.get $stage2)
      (local.get $stage_slots) (local.get $residual)))
    (if (i64.lt_s (local.get $degree64) (i64.const 0)) (then (return (i32.const -102))))
    (local.set $degree (i32.wrap_i64 (local.get $degree64)))
    (local.set $list (call $carve_scratch_blob
      (i32.mul (i32.add (local.get $degree) (i32.const 1)) (global.get $VALUE_SIZE))))
    (local.set $status (call $poly_extract_coefficients
      (local.get $stage) (local.get $v_slot) (local.get $degree)
      (local.get $list) (local.get $stage2) (local.get $stage_slots)
      (local.get $residual)))
    (if (local.get $status) (then (return (i32.sub (i32.const -103) (local.get $status)))))
    (local.set $count_scratch (call $carve_scratch_blob (i32.const 4)))
    (local.set $status (call $algebraic_collect_variable_registry
      (local.get $list) (local.get $degree) (local.get $registry)
      (local.get $max_exponents) (local.get $count_scratch)))
    (if (local.get $status) (then (return (i32.sub (i32.const -200) (local.get $status)))))
    (local.set $registry_count (i32.load (call $abs (local.get $count_scratch))))
    (local.set $status (call $algebraic_build_g
      (local.get $list) (local.get $degree)
      (local.get $registry) (local.get $registry_count) (local.get $max_exponents)
      (local.get $g_out)))
    (if (local.get $status) (then (return (i32.sub (i32.const -300) (local.get $status)))))
    (local.get $degree))
  (func (export "test_g_descend_slot") (param $root i32) (param $depth i32) (param $exponents i32) (result i32)
    (call $algebraic_g_descend_slot (local.get $root) (local.get $depth) (local.get $exponents)))
