            (local.set $byte_pointer (i32.add (local.get $byte_pointer) (i32.const 4)))
            (local.set $j (i32.const 0))
            (local.set $char_code (i32.const 0))))
        (br $btoa_encode_loop)))
    (if (i32.eq (local.get $j) (i32.const 1))
      (then
        (local.set $char_code (i32.shl (local.get $char_code) (i32.const 16)))
        (i32.store8 (local.get $byte_pointer)
          (call $base64_char_code (i32.shr_u (local.get $char_code) (i32.const 18))))
        (i32.store8 (i32.add (local.get $byte_pointer) (i32.const 1))
          (call $base64_char_code
            (i32.and (i32.shr_u (local.get $char_code) (i32.const 12)) (i32.const 63))))
        (i32.store8 (i32.add (local.get $byte_pointer) (i32.const 2)) (i32.const 61))
        (i32.store8 (i32.add (local.get $byte_pointer) (i32.const 3)) (i32.const 61))))
    (if (i32.eq (local.get $j) (i32.const 2))
      (then
        (local.set $char_code (i32.shl (local.get $char_code) (i32.const 8)))
        (i32.store8 (local.get $byte_pointer)
          (call $base64_char_code (i32.shr_u (local.get $char_code) (i32.const 18))))
        (i32.store8 (i32.add (local.get $byte_pointer) (i32.const 1))
          (call $base64_char_code
            (i32.and (i32.shr_u (local.get $char_code) (i32.const 12)) (i32.const 63))))
        (i32.store8 (i32.add (local.get $byte_pointer) (i32.const 2))
          (call $base64_char_code
            (i32.and (i32.shr_u (local.get $char_code) (i32.const 6)) (i32.const 63))))
        (i32.store8 (i32.add (local.get $byte_pointer) (i32.const 3)) (i32.const 61))))
    (call $pending_push (global.get $TYPE_STRING) (i32.const 0)
      (call $intern_string (local.get $scratch_pointer) (local.get $slice_len))
      (i32.const 0))
    (i32.const 0)
  )

  (func $global_atob
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $arg1_type i32)
    (local $arg1_lo i32)
    (local $object_pointer i32)
    (local $key_offset i32)
    (local $str_len i32)
    (local $data_pointer i32)
    (local $i i32)
    (local $count i32)
    (local $match_pos i32)
    (local $i32_result i32)
    (local $start_idx i32)
    (local $scratch_pointer i32)
    (local $byte_pointer i32)
    (local $j i32)
    (local $char_code i32)
    (local $char_count i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $arg1_type (call $value_type (local.get $argument1_pointer)))
        (local.set $arg1_lo (call $value_data_lo (local.get $argument1_pointer)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (i32.eqz (local.get $argc))
      (then
        (local.set $object_pointer (call $allocate_error_object
          (call $read_state (global.get $STATE_TYPE_ERROR_PROTOTYPE))
          (global.get $BUILTIN_MSG_MISSING_ARGUMENT)))
        (if (call $throw_allocated_error (local.get $object_pointer))
          (then (return (i32.const 2)))
          (else (return (i32.const 1))))))
    (if (i32.eq (local.get $arg1_type) (global.get $TYPE_STRING))
      (then (local.set $key_offset (local.get $arg1_lo)))
      (else (local.set $key_offset (call $value_to_string (local.get $argument1_pointer)))))
    (local.set $str_len (i32.load (call $string_id_to_abs (local.get $key_offset))))
    (local.set $data_pointer (call $string_id_bytes_seg (local.get $key_offset)))
    (local.set $i (i32.const 0))
    (local.set $count (i32.const 0))
    (local.set $match_pos (i32.const -1))
    (block $atob_scan_done
      (loop $atob_scan_loop
        (br_if $atob_scan_done (i32.ge_u (local.get $i) (local.get $str_len)))
        (local.set $i32_result
          (i32.load8_u (call $abs (i32.add (local.get $data_pointer) (local.get $i)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (if (call $is_base64_whitespace (local.get $i32_result))
          (then (br $atob_scan_loop)))
        (if (i32.eq (local.get $i32_result) (i32.const 61))
          (then
            (if (i32.eq (local.get $match_pos) (i32.const -1))
              (then (local.set $match_pos (local.get $count))))
            (local.set $count (i32.add (local.get $count) (i32.const 1)))
            (br $atob_scan_loop)))
        (if (i32.or
              (i32.ne (local.get $match_pos) (i32.const -1))
              (i32.eq (call $base64_char_value (local.get $i32_result)) (i32.const -1)))
          (then
            (if (call $throw_invalid_character_error
                  (global.get $BUILTIN_MSG_ATOB_INVALID_CHARACTER))
              (then (return (i32.const 2)))
              (else (return (i32.const 1))))))
        (local.set $count (i32.add (local.get $count) (i32.const 1)))
        (br $atob_scan_loop)))
    (local.set $start_idx (local.get $count))
    (if (i32.ne (local.get $match_pos) (i32.const -1))
      (then
        (if (i32.or
              (i32.gt_u (i32.sub (local.get $count) (local.get $match_pos)) (i32.const 2))
              (i32.ne (i32.rem_u (local.get $count) (i32.const 4)) (i32.const 0)))
          (then
            (if (call $throw_invalid_character_error
                  (global.get $BUILTIN_MSG_ATOB_INVALID_CHARACTER))
              (then (return (i32.const 2)))
              (else (return (i32.const 1))))))
        (local.set $start_idx (local.get $match_pos))))
    (if (i32.eq (i32.rem_u (local.get $start_idx) (i32.const 4)) (i32.const 1))
      (then
        (if (call $throw_invalid_character_error
              (global.get $BUILTIN_MSG_ATOB_INVALID_CHARACTER))
          (then (return (i32.const 2)))
          (else (return (i32.const 1))))))
    (local.set $count
      (i32.mul (i32.const 3) (i32.div_u (local.get $start_idx) (i32.const 4))))
    (if (i32.eq (i32.rem_u (local.get $start_idx) (i32.const 4)) (i32.const 2))
      (then (local.set $count (i32.add (local.get $count) (i32.const 1)))))
    (if (i32.eq (i32.rem_u (local.get $start_idx) (i32.const 4)) (i32.const 3))
      (then (local.set $count (i32.add (local.get $count) (i32.const 2)))))
    (if (call $check_concat_scratch_overflow
          (i32.shl (local.get $count) (i32.const 1)))
      (then (return (i32.const 0))))
    (local.set $scratch_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))
    (local.set $byte_pointer (local.get $scratch_pointer))
    (local.set $i (i32.const 0))
    (local.set $j (i32.const 0))
    (local.set $char_code (i32.const 0))
    (local.set $char_count (i32.const 0))
    (block $atob_decode_done
      (loop $atob_decode_loop
        (br_if $atob_decode_done
          (i32.ge_u (local.get $char_count) (local.get $start_idx)))
        (local.set $i32_result
          (i32.load8_u (call $abs (i32.add (local.get $data_pointer) (local.get $i)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (if (call $is_base64_whitespace (local.get $i32_result))
          (then (br $atob_decode_loop)))
        (local.set $char_code
          (i32.or (i32.shl (local.get $char_code) (i32.const 6))
                  (call $base64_char_value (local.get $i32_result))))
        (local.set $j (i32.add (local.get $j) (i32.const 1)))
        (local.set $char_count (i32.add (local.get $char_count) (i32.const 1)))
        (if (i32.eq (local.get $j) (i32.const 4))
          (then
            (local.set $byte_pointer (i32.add (local.get $byte_pointer)
              (call $utf8_encode_at (local.get $byte_pointer)
                (i32.and (i32.shr_u (local.get $char_code) (i32.const 16)) (i32.const 0xFF)))))
            (local.set $byte_pointer (i32.add (local.get $byte_pointer)
              (call $utf8_encode_at (local.get $byte_pointer)
                (i32.and (i32.shr_u (local.get $char_code) (i32.const 8)) (i32.const 0xFF)))))
            (local.set $byte_pointer (i32.add (local.get $byte_pointer)
              (call $utf8_encode_at (local.get $byte_pointer)
                (i32.and (local.get $char_code) (i32.const 0xFF)))))
            (local.set $j (i32.const 0))
            (local.set $char_code (i32.const 0))))
        (br $atob_decode_loop)))
    (if (i32.eq (local.get $j) (i32.const 2))
      (then
        (local.set $byte_pointer (i32.add (local.get $byte_pointer)
          (call $utf8_encode_at (local.get $byte_pointer)
            (i32.and (i32.shr_u (local.get $char_code) (i32.const 4)) (i32.const 0xFF)))))))
    (if (i32.eq (local.get $j) (i32.const 3))
      (then
        (local.set $byte_pointer (i32.add (local.get $byte_pointer)
          (call $utf8_encode_at (local.get $byte_pointer)
            (i32.and (i32.shr_u (local.get $char_code) (i32.const 10)) (i32.const 0xFF)))))
        (local.set $byte_pointer (i32.add (local.get $byte_pointer)
          (call $utf8_encode_at (local.get $byte_pointer)
            (i32.and (i32.shr_u (local.get $char_code) (i32.const 2)) (i32.const 0xFF)))))))
    (call $pending_push (global.get $TYPE_STRING) (i32.const 0)
      (call $intern_string
        (call $abs (local.get $scratch_pointer))
        (i32.sub (local.get $byte_pointer) (local.get $scratch_pointer)))
      (i32.const 0))
    (i32.const 0)
  )

  ;; ==========================================================================
  ;; Type conversion functions (dispatch-table migration, batch 8):
  ;; String(), Number(), Boolean(),
  ;; BigInt(), called without `new` (receiver_type = TYPE_CONSTRUCTOR).
  ;; Each function re-derives arg1 (type/lo) it uses.
  ;; ==========================================================================

  ;; ==========================================================================
  ;; find_own_bound_method(object_pointer, key_offset) → method_id, or -1
  ;; if not found.
  ;;
  ;; Narrow prototype-chain walk for implicit-coercion call sites (e.g.
  ;; "" + err, String(err)) that need to know whether an object overrides
  ;; a well-known method (toString) before falling back to the generic
  ;; "[object <tag>]" formatter. Deliberately NOT a general property
  ;; lookup: unlike OP_GET_PROP's walk, this only recognizes
  ;; TYPE_BOUND_METHOD entries and never invokes an accessor getter — a
  ;; getter mid-coercion could itself throw/suspend, which none of the
  ;; type-conversion call sites are built to handle. Sufficient for
  ;; Error.prototype.toString (a plain bound method), not a substitute
  ;; for OP_GET_PROP's walk.
  ;; ==========================================================================
  (func $find_own_bound_method (param $object_pointer i32) (param $key_offset i32) (result i32)
    (local $current_obj i32)
    (local $proto_depth i32)
    (local $obj_count i32)
    (local $entries_pointer i32)
    (local $i i32)
    (local $entry_pointer i32)
    (local $prop_key i32)

    (local.set $current_obj (local.get $object_pointer))
    (local.set $proto_depth (i32.const 0))

    (block $search_done
      (loop $proto_loop
        (br_if $search_done (i32.eqz (local.get $current_obj)))
        (br_if $search_done (i32.ge_u (local.get $proto_depth) (global.get $MAX_PROTO_DEPTH)))

        (local.set $obj_count (i32.load (call $abs (i32.add (local.get $current_obj) (i32.const 12)))))
        (local.set $entries_pointer (i32.load (call $abs (i32.add (local.get $current_obj) (i32.const 24)))))

        (local.set $i (i32.const 0))
        (block $check_next_proto
          (loop $prop_loop
            (br_if $check_next_proto (i32.ge_u (local.get $i) (local.get $obj_count)))

            (local.set $entry_pointer (i32.add
              (i32.add (local.get $entries_pointer) (global.get $GC_HEADER_SIZE))
              (i32.mul (local.get $i) (global.get $ENTRY_SIZE))))

            (local.set $prop_key (i32.load (call $abs (local.get $entry_pointer))))

            (if (i32.eq (local.get $prop_key) (local.get $key_offset))
              (then
                (if (i32.eq
                      (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 4))))
                      (global.get $TYPE_BOUND_METHOD))
                  (then
                    (return (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 16))))))
                  (else (return (i32.const -1))))
              )
            )

            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $prop_loop)
          )
        )

        (local.set $current_obj (i32.load (call $abs (i32.add (local.get $current_obj) (i32.const 8)))))
        (local.set $proto_depth (i32.add (local.get $proto_depth) (i32.const 1)))
        (br $proto_loop)
      )
    )
    (i32.const -1)
  )

  ;; ==========================================================================
  ;; find_own_string_property(object_pointer, key_offset) → interned string
  ;; id, or -1 if not found / not a string.
  ;;
  ;; Same walk as $find_own_bound_method, for reading a string-valued
  ;; property (own or inherited) — used by $error_to_string to read
  ;; `name` (always inherited from the prototype today; no user Error
  ;; subclassing exists to give an instance its own `name`) and
  ;; `message` (always an own property, set by the constructor).
  ;; ==========================================================================
  (func $find_own_string_property (param $object_pointer i32) (param $key_offset i32) (result i32)
    (local $current_obj i32)
    (local $proto_depth i32)
    (local $obj_count i32)
    (local $entries_pointer i32)
    (local $i i32)
    (local $entry_pointer i32)
    (local $prop_key i32)

    (local.set $current_obj (local.get $object_pointer))
    (local.set $proto_depth (i32.const 0))

    (block $search_done
      (loop $proto_loop
        (br_if $search_done (i32.eqz (local.get $current_obj)))
        (br_if $search_done (i32.ge_u (local.get $proto_depth) (global.get $MAX_PROTO_DEPTH)))

        (local.set $obj_count (i32.load (call $abs (i32.add (local.get $current_obj) (i32.const 12)))))
        (local.set $entries_pointer (i32.load (call $abs (i32.add (local.get $current_obj) (i32.const 24)))))

        (local.set $i (i32.const 0))
        (block $check_next_proto
          (loop $prop_loop
            (br_if $check_next_proto (i32.ge_u (local.get $i) (local.get $obj_count)))

            (local.set $entry_pointer (i32.add
              (i32.add (local.get $entries_pointer) (global.get $GC_HEADER_SIZE))
              (i32.mul (local.get $i) (global.get $ENTRY_SIZE))))

            (local.set $prop_key (i32.load (call $abs (local.get $entry_pointer))))

            (if (i32.eq (local.get $prop_key) (local.get $key_offset))
              (then
                (if (i32.eq
                      (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 4))))
                      (global.get $TYPE_STRING))
                  (then
                    (return (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 12))))))
                  (else (return (i32.const -1))))
              )
            )

            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $prop_loop)
          )
        )

        (local.set $current_obj (i32.load (call $abs (i32.add (local.get $current_obj) (i32.const 8)))))
        (local.set $proto_depth (i32.add (local.get $proto_depth) (i32.const 1)))
        (br $proto_loop)
      )
    )
    (i32.const -1)
  )

  ;; ==========================================================================
  ;; error_to_string_id(object_pointer) → interned string id, formatted as
  ;; `${name}: ${message}`, or just `name` if message is empty (matches
  ;; real JS: an Error with no message string()s to just its name, not
  ;; "Error: "). `name` is read via prototype-chain walk (always
  ;; inherited from the prototype today — no user Error subclassing
  ;; exists to give an instance its own `name`); `message` is always an
  ;; own property, set by the constructor.
  ;;
  ;; Pure — no pending-stack interaction, so both the method-call form
  ;; (e.toString(), via $error_to_string below) and value-level implicit
  ;; coercion (+, String(), via $value_to_string) can call it directly.
  ;; May self-signal memory pressure via $string_concat/$intern_string;
  ;; callers must check $memory_pressure_signaled same as any other
  ;; string-allocating primitive.
  ;;
  ;; METHOD_ERROR_TO_STRING dispatches here so e.toString() and implicit
  ;; coercion use the Error name/message representation rather than the
  ;; generic Object.prototype-style tag or undefined.
  ;;
  ;; ==========================================================================
  (func $error_to_string_id (param $object_pointer i32) (result i32)
    (local $name_id i32)
    (local $message_id i32)

    (local.set $name_id (call $find_own_string_property
      (local.get $object_pointer) (call $read_builtin (global.get $BUILTIN_NAME))))
    (if (i32.eq (local.get $name_id) (i32.const -1))
      (then (local.set $name_id (call $read_builtin (global.get $BUILTIN_LIT_ERROR)))))

    (local.set $message_id (call $find_own_string_property
      (local.get $object_pointer) (call $read_builtin (global.get $BUILTIN_MESSAGE))))
    (if (i32.eq (local.get $message_id) (i32.const -1))
      (then (local.set $message_id (call $read_builtin (global.get $BUILTIN_LIT_EMPTY_STRING)))))

    (if (i32.eqz (i32.load (call $abs (call $string_id_to_seg (local.get $message_id)))))
      (then (return (local.get $name_id))))

    (call $string_concat
      (call $string_concat (local.get $name_id)
        (call $read_builtin (global.get $BUILTIN_LIT_COLON_SPACE)))
      (local.get $message_id))
  )

  ;; Error.prototype.toString() method-call entry — see error_to_string_id.
  (func $error_to_string
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $error_object i32)
    (local $result_id i32)

    ;; The receiver in the method-call form (e.toString()) is the Error
    ;; INSTANCE sitting on the pending stack at stack_base — not
    ;; receiver_pointer, which for a prototype-installed bound method is
    ;; the prototype object itself (same convention $object_to_string_method
    ;; already relies on for Object.prototype.toString.call(x)).
    (local.set $error_object (call $value_data_lo (local.get $stack_base)))

    (local.set $result_id (call $error_to_string_id (local.get $error_object)))
    (if (global.get $memory_pressure_signaled)
      (then (return (i32.const 0))))

    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (call $pending_push (global.get $TYPE_STRING) (i32.const 0) (local.get $result_id) (i32.const 0))
    (i32.const 0)
  )

  (func $to_string_conversion
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $arg1_type i32)
    (local $arg1_lo i32)
    (local $string_pointer i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $arg1_type (call $value_type (local.get $argument1_pointer)))
        (local.set $arg1_lo (call $value_data_lo (local.get $argument1_pointer)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (i32.eq (local.get $arg1_type) (global.get $TYPE_STRING))
      (then
        (call $pending_push (global.get $TYPE_STRING) (i32.const 0) (local.get $arg1_lo) (i32.const 0))
        (return (i32.const 0))))
    (if (i32.eq (local.get $arg1_type) (global.get $TYPE_UNDEFINED))
      (then
        (local.set $string_pointer (call $read_builtin (global.get $BUILTIN_TYPEOF_UNDEFINED)))
        (call $pending_push (global.get $TYPE_STRING) (i32.const 0) (local.get $string_pointer) (i32.const 0))
        (return (i32.const 0))))
    (if (i32.eq (local.get $arg1_type) (global.get $TYPE_NULL))
      (then
        (local.set $string_pointer (call $read_builtin (global.get $BUILTIN_LIT_NULL)))
        (call $pending_push (global.get $TYPE_STRING) (i32.const 0) (local.get $string_pointer) (i32.const 0))
        (return (i32.const 0))))
    (if (i32.eq (local.get $arg1_type) (global.get $TYPE_BOOLEAN))
      (then
        (if (local.get $arg1_lo)
          (then (local.set $string_pointer (call $read_builtin (global.get $BUILTIN_LIT_TRUE))))
          (else (local.set $string_pointer (call $read_builtin (global.get $BUILTIN_LIT_FALSE)))))
        (call $pending_push (global.get $TYPE_STRING) (i32.const 0) (local.get $string_pointer) (i32.const 0))
        (return (i32.const 0))))
    (if (i32.or
          (call $value_is_numeric (local.get $argument1_pointer))
          (i32.eq (local.get $arg1_type) (global.get $TYPE_COMPLEX)))
      (then
        (call $pending_push (global.get $TYPE_STRING) (i32.const 0)
          (call $value_to_string (local.get $argument1_pointer))
          (i32.const 0))
        (return (i32.const 0))))
    (if (i32.eq (local.get $arg1_type) (global.get $TYPE_SYMBOL))
      (then
        (local.set $string_pointer (call $symbol_description (local.get $arg1_lo)))
        (if (i32.eqz (local.get $string_pointer))
          (then
            (call $pending_push (global.get $TYPE_STRING) (i32.const 0)
              (call $read_builtin (global.get $BUILTIN_SYMBOL_LIT_EMPTY))
              (i32.const 0)))
          (else
            (call $pending_push (global.get $TYPE_STRING) (i32.const 0)
              (call $string_concat
                (call $string_concat
