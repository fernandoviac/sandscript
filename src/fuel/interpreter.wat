  (func $string_from_char_code
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $data_pointer i32)
    (local $dest i32)
    (local $i i32)
    (local $argument_pointer i32)
    (local $f64_result f64)
    (local $code_point i32)
    (local $str_len i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))))
    ;; Stage into heap-tail scratch, then call $intern_string, matching
    ;; btoa and the slice/case methods. Direct [len][bytes] writes into
    ;; the string region must not advance STATE_STRING_POINTER from the
    ;; data end: that would roughly double the step, leave an uninitialized
    ;; gap, break GC compaction and string-audit walks, and misalign later
    ;; entries. Advancing from the entry start keeps every intern aligned.
    ;; $intern_string also preserves deduplication and checks capacity.






    ;; Worst case 3 UTF-8 bytes per unit (values are masked to 0xFFFF).
    (if (call $check_concat_scratch_overflow (i32.mul (local.get $argc) (i32.const 3)))
      (then (return (i32.const 0))))
    (local.set $data_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))
    (local.set $dest (local.get $data_pointer))
    (local.set $i (i32.const 0))
    (local.set $argument_pointer (local.get $argument1_pointer))
    (block $args_done
      (loop $args_loop
        (br_if $args_done (i32.ge_u (local.get $i) (local.get $argc)))
        (if (call $value_is_numeric (local.get $argument_pointer))
          (then
            (local.set $f64_result (call $value_to_f64 (local.get $argument_pointer)))
            (local.set $code_point (i32.and (call $f64_to_int32 (local.get $f64_result)) (i32.const 0xFFFF))))
          (else (local.set $code_point (i32.const 0))))
        (local.set $dest (i32.add (local.get $dest)
          (call $utf8_encode_at (local.get $dest) (local.get $code_point))))
        (local.set $argument_pointer (i32.add (local.get $argument_pointer) (global.get $VALUE_SIZE)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $args_loop)))
    (local.set $str_len (i32.sub (local.get $dest) (local.get $data_pointer)))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (call $pending_push (global.get $TYPE_STRING) (i32.const 0)
      (call $intern_string (call $abs (local.get $data_pointer)) (local.get $str_len))
      (i32.const 0))
    (i32.const 0)
  )

  (func $string_from_code_point
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $data_pointer i32)
    (local $dest i32)
    (local $i i32)
    (local $argument_pointer i32)
    (local $f64_result f64)
    (local $code_point i32)
    (local $str_len i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))))
    ;; Stage into heap-tail scratch, then $intern_string — see
    ;; $string_from_char_code's comment; this function had the same
    ;; direct-region write with the same broken bump advance.
    ;; Worst case 4 UTF-8 bytes per code point (up to 0x10FFFF).
    (if (call $check_concat_scratch_overflow (i32.mul (local.get $argc) (i32.const 4)))
      (then (return (i32.const 0))))
    (local.set $data_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))
    (local.set $dest (local.get $data_pointer))
    (local.set $i (i32.const 0))
    (local.set $argument_pointer (local.get $argument1_pointer))
    (block $args_done
      (loop $args_loop
        (br_if $args_done (i32.ge_u (local.get $i) (local.get $argc)))
        (if (call $value_is_numeric (local.get $argument_pointer))
          (then
            (local.set $f64_result (call $value_to_f64 (local.get $argument_pointer)))
            (local.set $code_point (call $f64_to_int32 (local.get $f64_result)))
            (if (f64.ne (local.get $f64_result) (f64.convert_i32_u (local.get $code_point)))
              (then (local.set $code_point (i32.const 0xFFFD))))
            (if (i32.gt_u (local.get $code_point) (i32.const 0x10FFFF))
              (then (local.set $code_point (i32.const 0xFFFD)))))
          (else (local.set $code_point (i32.const 0))))
        (local.set $dest (i32.add (local.get $dest)
          (call $utf8_encode_at (local.get $dest) (local.get $code_point))))
        (local.set $argument_pointer (i32.add (local.get $argument_pointer) (global.get $VALUE_SIZE)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $args_loop)))
    (local.set $str_len (i32.sub (local.get $dest) (local.get $data_pointer)))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (call $pending_push (global.get $TYPE_STRING) (i32.const 0)
      (call $intern_string (call $abs (local.get $data_pointer)) (local.get $str_len))
      (i32.const 0))
    (i32.const 0)
  )

  ;; ==========================================================================
  ;; Typed array static methods (dispatch-table migration, batch 12):
  ;; TypedArray.from/of. Per the 2026-07-08 design decision, these
  ;; stay as range checks — one shared function per range, registered
  ;; at all 11 ids in that
  ;; range — rather than splitting into 11 near-identical functions
  ;; each. The varying part across the 11 typed-array element types is
  ;; a single type-tag parameter ($val_type, recovered via
  ;; $typed_array_static_method_offset_to_type on method_id minus the
  ;; range's lower bound), not genuinely different logic.
  ;; ==========================================================================

  (func $typed_array_from
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $arg1_type i32)
    (local $val_type i32)
    (local $bytes_per_element i32)
    (local $array_pointer i32)
    (local $arr_len i32)
    (local $data_pointer i32)
    (local $heap_pointer i32)
    (local $dest i32)
    (local $i i32)
    (local $entry_pointer i32)
    (local $arg_type i32)
    (local $iter_i64 i64)
    (local $result_f64 f64)
    (local $element_pointer i32)
    (local $val_lo i32)
    (local $val_hi i32)
    (local $src_count i32)
    (local $source_pointer i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $arg1_type (call $value_type (local.get $argument1_pointer)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (local.set $val_type (call $typed_array_static_method_offset_to_type
      (i32.sub (local.get $method_id) (global.get $METHOD_UINT8ARRAY_FROM))))
    (local.set $bytes_per_element (call $get_bytes_per_element (local.get $val_type)))
    (if (i32.eq (local.get $arg1_type) (global.get $TYPE_ARRAY))
      (then
        (local.set $array_pointer (call $value_data_lo (local.get $argument1_pointer)))
        (local.set $arr_len (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 8)))))
        (if (call $check_heap_overflow
              (i32.add
                (call $estimate_arraybuffer_size (i32.mul (local.get $arr_len) (local.get $bytes_per_element)))
                (call $estimate_typed_array_descriptor_size)))
          (then (return (i32.const 0))))
        (local.set $data_pointer (call $allocate_arraybuffer
          (i32.mul (local.get $arr_len) (local.get $bytes_per_element))))
        (local.set $heap_pointer (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 16)))))
        (local.set $dest (call $abs (i32.add (local.get $data_pointer) (i32.const 4))))
        (local.set $i (i32.const 0))
        (block $copy_done
          (loop $copy_loop
            (br_if $copy_done (i32.ge_u (local.get $i) (local.get $arr_len)))
            (local.set $entry_pointer (i32.add
              (i32.add (local.get $heap_pointer) (global.get $GC_HEADER_SIZE))
              (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
            (local.set $arg_type (call $value_type (local.get $entry_pointer)))
            (if (i32.or
                  (i32.eq (local.get $val_type) (global.get $TYPE_BIGINT64ARRAY))
                  (i32.eq (local.get $val_type) (global.get $TYPE_BIGUINT64ARRAY)))
              (then
                (local.set $iter_i64 (i64.const 0))
                (if (i32.eq (local.get $arg_type) (global.get $TYPE_BIGINT))
                  (then
                    (local.set $iter_i64 (call $bigint_to_typed_i64
                      (local.get $val_type)
                      (call $value_data_lo (local.get $entry_pointer))))))
                (i64.store
                  (i32.add (local.get $dest) (i32.mul (local.get $i) (local.get $bytes_per_element)))
                  (local.get $iter_i64)))
              (else
                (local.set $result_f64 (f64.const 0))
                (if (call $value_is_numeric (local.get $entry_pointer))
                  (then (local.set $result_f64 (call $value_to_f64 (local.get $entry_pointer)))))
                (call $write_typed_element
                  (local.get $val_type)
                  (i32.add (local.get $dest) (i32.mul (local.get $i) (local.get $bytes_per_element)))
                  (local.get $result_f64))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $copy_loop)))
        (local.set $element_pointer
          (call $allocate_typed_array_descriptor
            (local.get $data_pointer) (i32.const 0) (local.get $arr_len)))
        (call $pending_push
          (local.get $val_type) (i32.const 0) (local.get $element_pointer) (i32.const 0))
        (return (i32.const 0))))
