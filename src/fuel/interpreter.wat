            (local.set $data1_lo (call $value_data_lo (local.get $value_pointer)))
            (local.set $data2_lo (call $value_data_lo (local.get $value_pointer2)))
            (if (i32.eq (local.get $data1_lo) (local.get $data2_lo))
              (then
