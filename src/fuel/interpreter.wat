                )

                ;; Map.prototype.forEach / Set.prototype.forEach — separate
                ;; from the Array callback methods above since the
                ;; receiver is a hash-slot table (with tombstones), not a
                ;; contiguous index-addressable array. Handled entirely by
                ;; this branch plus its RETURN/RETURN_UNDEFINED continuation;
                ;; never falls through to dispatch_builtin_method.
                (if (i32.or
                      (i32.eq (local.get $method_id) (global.get $METHOD_MAP_FOREACH))
                      (i32.eq (local.get $method_id) (global.get $METHOD_SET_FOREACH)))
                  (then
                    ;; Need at least 1 argument (the callback).
                    (if (i32.lt_u (local.get $operand1) (i32.const 1))
                      (then
                        (if (call $raise_error (global.get $ERR_ARITY) (i32.const 1))
                          (then (br $exit)))
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop)
                      )
                    )

                    (local.set $closure_pointer (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE)))
                    (if (i32.ne (call $value_type (local.get $closure_pointer)) (global.get $TYPE_FUNCTION))
                      (then
                        (if (call $throw_type_error_with_type (global.get $BUILTIN_MSG_NOT_A_FUNCTION) (i32.const 0))
                          (then (br $exit))
                          (else
                            (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                            (br $loop)
                          )
                        )
                      )
                    )
                    (local.set $start_instr (call $value_data_lo (local.get $closure_pointer)))

                    ;; Scan for the first live (non-tombstone) slot.
                    (local.set $arr_len
                      (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 12)))))
                    (local.set $data_pointer
                      (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 20)))))
                    (local.set $index (i32.const 0))
                    (block $ms_foreach_found
                      (loop $ms_foreach_scan
                        (br_if $ms_foreach_found (i32.ge_u (local.get $index) (local.get $arr_len)))
                        (local.set $element_pointer
                          (i32.add
                            (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
                            (i32.mul (local.get $index)
                              (if (result i32) (i32.eq (local.get $method_id) (global.get $METHOD_MAP_FOREACH))
                                (then (global.get $MAP_SLOT_STRIDE))
                                (else (global.get $SET_SLOT_STRIDE))))))
                        (if (i32.eqz (i32.load (call $abs (local.get $element_pointer))))
                          (then (br $ms_foreach_found)))
                        (local.set $index (i32.add (local.get $index) (i32.const 1)))
                        (br $ms_foreach_scan)
                      )
                    )

                    ;; Clean up stack (drop receiver/method/args).
                    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $value_pointer2))

                    (if (i32.ge_u (local.get $index) (local.get $arr_len))
                      (then
                        ;; Empty collection (or all tombstones) - forEach returns undefined.
                        (call $pending_push (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))
                        (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                        (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                        (br $loop)
                      )
                    )

                    ;; Push iteration frame.
                    (local.set $stack_pointer (call $read_ctx (global.get $CTX_CALL_STACK_POINTER)))
                    (local.set $frame_pointer (call $abs (local.get $stack_pointer)))

                    (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_INSTRUCTION_INDEX)) (i32.add (local.get $pc) (i32.const 1)))
                    (call $publish_native_continuation_frame
                      (local.get $frame_pointer) (local.get $stack_pointer)
                      (local.get $value_pointer2)
                      (i32.const 1)
                      (call $callback_staged_argc (local.get $start_instr) (i32.const 3))
                      (local.get $index) (local.get $arr_len) (i32.const 0)
                      (call $continuation_kind_from_callback_method (local.get $method_id))
                      (local.get $receiver_pointer) (local.get $start_instr)
                      (local.get $receiver_type) (i32.const 0))

                    ;; Clean pending stack - we'll push callback args.
                    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $value_pointer2))

                    (local.set $captured_scope (i32.load (call $abs (i32.add (local.get $start_instr) (i32.const 40)))))
                    (local.set $closure_flags (i32.load (call $abs (i32.add (local.get $start_instr) (i32.const 44)))))

                    (call $push_map_set_foreach_args
                      (local.get $method_id) (local.get $data_pointer) (local.get $index)
                      (local.get $receiver_pointer)
                      (call $callback_staged_argc (local.get $start_instr) (i32.const 3)))

                    (local.set $new_scope (call $scope_create (local.get $captured_scope)))
                    (global.set $current_scope (local.get $new_scope))
                    (if (i32.eqz (i32.and (local.get $closure_flags) (global.get $CLOSURE_FLAG_ARROW)))
                      (then
                        (call $scope_define (local.get $new_scope)
                          (call $read_builtin (i32.const 0x18))
                          (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))
                        (call $scope_define_new_target (local.get $new_scope)
                          (global.get $TYPE_UNDEFINED) (i32.const 0))
                      )
                    )
                    (local.set $pc (i32.load (call $abs (i32.add (local.get $start_instr) (global.get $FUNCTION_CLOSURE_OFFSET)))))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )

                ;; Promise methods yield to airlock
                (if (i32.eq (local.get $receiver_type) (global.get $TYPE_PROMISE))
                  (then
                    ;; Write promise method request to external_request_base
                    ;; [promiseHeaderPointer:4][methodId:4][argsPointer:4][argCount:4]
                    (i32.store (call $abs (global.get $external_request_base))
                      (local.get $receiver_pointer))
                    (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 4)))
                      (local.get $method_id))
                    (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 8)))
                      (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE)))
                    (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 12)))
                      (local.get $operand1))

                    ;; Clean up pending stack: remove receiver + bound method + args
                    ;; Restore pending pointer to where the receiver was
                    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $value_pointer2))

                    ;; Save the complete continuation and yield. Another context may run
                    ;; before this slot resumes and replace the instance-global
                    ;; current_scope, so CTX_SCOPE must travel with every yield.
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX)
                      (i32.add (local.get $pc) (i32.const 1)))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_PROMISE_METHOD))
                    (br $exit)
                  )
                )

                ;; Promise static methods (Promise.all, Promise.race) yield to airlock
                (if (i32.and
                      (i32.ge_u (local.get $method_id) (global.get $METHOD_PROMISE_ALL))
                      (i32.le_u (local.get $method_id) (global.get $METHOD_PROMISE_RACE)))
                  (then
                    ;; Write request: [0 (static call)][methodId][argsPointer][argCount]
                    (i32.store (call $abs (global.get $external_request_base))
                      (i32.const 0))
                    (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 4)))
                      (local.get $method_id))
                    (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 8)))
                      (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE)))
                    (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 12)))
                      (local.get $operand1))

                    ;; Clean up pending stack: remove receiver + bound method + args
                    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $value_pointer2))

                    ;; Save the complete continuation and yield. Another context may run
                    ;; before this slot resumes and replace the instance-global
                    ;; current_scope, so CTX_SCOPE must travel with every yield.
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX)
                      (i32.add (local.get $pc) (i32.const 1)))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_PROMISE_METHOD))
                    (br $exit)
                  )
                )

                ;; Sort with comparator — batch 25, same intercept
                ;; shape as the other callback-method entries.
                ;; $sort_method implements only the first comparator
                ;; call; OP_RETURN's existing sort continuation
                ;; (unchanged) drives the rest of the insertion-sort
                ;; walk. Falls through to dispatch_builtin_method (the
                ;; default numeric sort) when there's no comparator.
                (if (i32.and
                      (i32.eq (local.get $method_id) (global.get $METHOD_SORT))
                      (i32.and
                        (i32.ge_u (local.get $operand1) (i32.const 1))
                        (i32.eq (call $value_type (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE)))
                                (global.get $TYPE_FUNCTION))))
                  (then
                    (local.set $result_i32 (call $sort_method
                      (local.get $receiver_type) (local.get $receiver_pointer)
                      (local.get $method_id) (local.get $operand1) (local.get $value_pointer2)))
                    (if (i32.eq (local.get $result_i32) (global.get $STATUS_NATIVE_CONTINUATION_STAGED))
                      (then
                        (local.set $frame_pointer (call $abs
                          (i32.sub (call $read_ctx (global.get $CTX_CALL_STACK_POINTER)) (global.get $FRAME_SIZE))))
                        (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_INSTRUCTION_INDEX))
                          (i32.add (local.get $pc) (i32.const 1)))
                        (local.set $pc
                          (call $enter_staged_native_continuation_callback
                            (local.get $frame_pointer)))
                        (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                        (br $loop)
                      )
                    )
                    (if (global.get $memory_pressure_signaled)
                      (then
                        (call $call_pressure_restore_pending (local.get $opcode)
                          (local.get $pending_pointer) (local.get $value_pointer)
                          (local.get $spread_array_pointer))
                        (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                        (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                        (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                        (br $exit)
                      )
                    )
                    ;; 0: sort returned already (0/1-element array, already sorted).
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )

                ;; Typed-array sort with comparator — same intercept
                ;; shape as the array sort above. Gated on a typed
                ;; receiver (typed method ids are not unique across the
                ;; whole method-id space). Falls through to
                ;; dispatch_builtin_method ($typed_array_sort_method,
                ;; the default numeric sort) when there's no function
                ;; comparator.
                (if (i32.and
                      (i32.and
                        (i32.eq (local.get $method_id) (global.get $METHOD_UINT8ARRAY_SORT))
                        (call $is_typed_array (local.get $receiver_type)))
                      (i32.and
                        (i32.ge_u (local.get $operand1) (i32.const 1))
                        (i32.eq (call $value_type (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE)))
                                (global.get $TYPE_FUNCTION))))
                  (then
                    (local.set $result_i32 (call $typed_array_sort_comparator_method
                      (local.get $receiver_type) (local.get $receiver_pointer)
                      (local.get $method_id) (local.get $operand1) (local.get $value_pointer2)))
                    (if (i32.eq (local.get $result_i32) (global.get $STATUS_NATIVE_CONTINUATION_STAGED))
                      (then
                        (local.set $frame_pointer (call $abs
                          (i32.sub (call $read_ctx (global.get $CTX_CALL_STACK_POINTER)) (global.get $FRAME_SIZE))))
                        (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_INSTRUCTION_INDEX))
                          (i32.add (local.get $pc) (i32.const 1)))
                        (local.set $pc
                          (call $enter_staged_native_continuation_callback
                            (local.get $frame_pointer)))
                        (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                        (br $loop)
                      )
                    )
                    (if (global.get $memory_pressure_signaled)
                      (then
                        (call $call_pressure_restore_pending (local.get $opcode)
                          (local.get $pending_pointer) (local.get $value_pointer)
                          (local.get $spread_array_pointer))
                        (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                        (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                        (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                        (br $exit)
                      )
                    )
                    ;; 0: sort returned already (0/1-element window, already sorted).
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )

                ;; toSorted with comparator — copy-then-sort. The wrapper
                ;; copies the receiver and stages an ARRAY_SORT continuation
                ;; against the copy via $sort_method; completion pushes the copy.
                ;; Falls through to dispatch_builtin_method (copy +
                ;; default numeric sort) when there's no comparator.
                (if (i32.and
                      (i32.eq (local.get $method_id) (global.get $METHOD_ARRAY_TO_SORTED))
                      (i32.and
                        (i32.ge_u (local.get $operand1) (i32.const 1))
                        (i32.eq (call $value_type (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE)))
                                (global.get $TYPE_FUNCTION))))
                  (then
                    (local.set $result_i32 (call $array_to_sorted_comparator_method
                      (local.get $receiver_type) (local.get $receiver_pointer)
                      (local.get $method_id) (local.get $operand1) (local.get $value_pointer2)))
                    (if (i32.eq (local.get $result_i32) (global.get $STATUS_NATIVE_CONTINUATION_STAGED))
                      (then
                        (local.set $frame_pointer (call $abs
                          (i32.sub (call $read_ctx (global.get $CTX_CALL_STACK_POINTER)) (global.get $FRAME_SIZE))))
                        (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_INSTRUCTION_INDEX))
                          (i32.add (local.get $pc) (i32.const 1)))
                        (local.set $pc
                          (call $enter_staged_native_continuation_callback
                            (local.get $frame_pointer)))
                        (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                        (br $loop)
                      )
                    )
                    (if (i32.eq (local.get $result_i32) (i32.const 2))
                      (then
                        (if (global.get $throw_already_searched)
                          (then
                            (global.set $throw_already_searched (i32.const 0))
                            (br $exit)))
                        (if (call $throw_from_set_error) (then (br $exit)))
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop)
                      )
                    )
                    (if (i32.eq (local.get $result_i32) (i32.const 1))
                      (then
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop)
                      )
                    )
                    (if (global.get $memory_pressure_signaled)
                      (then
                        (call $call_pressure_restore_pending (local.get $opcode)
                          (local.get $pending_pointer) (local.get $value_pointer)
                          (local.get $spread_array_pointer))
                        (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                        (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                        (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                        (br $exit)
                      )
                    )
                    ;; 0: toSorted returned already (0/1-element copy).
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )

                ;; Typed toSorted with comparator — same shape, typed copy.
                (if (i32.and
                      (i32.and
                        (i32.eq (local.get $method_id) (global.get $METHOD_TYPED_ARRAY_TO_SORTED))
                        (call $is_typed_array (local.get $receiver_type)))
                      (i32.and
                        (i32.ge_u (local.get $operand1) (i32.const 1))
                        (i32.eq (call $value_type (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE)))
                                (global.get $TYPE_FUNCTION))))
                  (then
                    (local.set $result_i32 (call $typed_array_to_sorted_comparator_method
                      (local.get $receiver_type) (local.get $receiver_pointer)
                      (local.get $method_id) (local.get $operand1) (local.get $value_pointer2)))
                    (if (i32.eq (local.get $result_i32) (global.get $STATUS_NATIVE_CONTINUATION_STAGED))
                      (then
                        (local.set $frame_pointer (call $abs
                          (i32.sub (call $read_ctx (global.get $CTX_CALL_STACK_POINTER)) (global.get $FRAME_SIZE))))
                        (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_INSTRUCTION_INDEX))
                          (i32.add (local.get $pc) (i32.const 1)))
                        (local.set $pc
                          (call $enter_staged_native_continuation_callback
                            (local.get $frame_pointer)))
                        (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                        (br $loop)
                      )
                    )
                    (if (global.get $memory_pressure_signaled)
                      (then
                        (call $call_pressure_restore_pending (local.get $opcode)
                          (local.get $pending_pointer) (local.get $value_pointer)
                          (local.get $spread_array_pointer))
                        (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                        (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                        (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                        (br $exit)
                      )
                    )
                    ;; 0: toSorted returned already (0/1-element copy).
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )

                ;; RegExp exec/test: fuel-resumable inline dispatch — see
                ;; the CALL twin above for the full rationale.
                (if (i32.or
                      (i32.eq (local.get $method_id) (global.get $METHOD_REGEXP_EXEC))
                      (i32.eq (local.get $method_id) (global.get $METHOD_REGEXP_TEST)))
                  (then
                    (if (i32.ne (local.get $receiver_type) (global.get $TYPE_REGEXP))
                      (then
                        (if (call $throw_type_error_with_message
                              (global.get $BUILTIN_MSG_REGEXP_RECEIVER))
                          (then (br $exit))
                          (else
                            (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                            (br $loop)))))
                    (global.set $current_executing_pc (local.get $pc))
                    (call $regexp_match_step
                      (local.get $receiver_pointer)
                      (local.get $method_id)
                      (local.get $value_pointer2)  ;; result over the receiver slot
                      (local.get $operand1)
                      (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE))
                      (local.get $pending_pointer)
                      (local.get $fuel)
                      (i32.const 0))
                    (local.set $fuel)
                    (local.set $result_i32)
                    (if (i32.eqz (local.get $result_i32))
                      (then
                        (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                        (br $loop)))
                    (if (i32.eq (local.get $result_i32) (i32.const 1))
                      (then
                        (call $call_pressure_restore_pending (local.get $opcode)
                          (local.get $pending_pointer) (local.get $value_pointer)
                          (local.get $spread_array_pointer))
                        (local.set $fuel (i32.const 0))
                        (br $loop)))
                    (if (i32.eq (local.get $result_i32) (i32.const 2))
                      (then
                        (call $call_pressure_restore_pending (local.get $opcode)
                          (local.get $pending_pointer) (local.get $value_pointer)
                          (local.get $spread_array_pointer))
                        (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                        (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                        (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                        (br $exit)))
                    (if (i32.eq (local.get $result_i32) (i32.const 4))
                      (then
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop)))
                    (br $exit)))

                ;; Schema — see the CALL twin; result lands over the
                ;; receiver slot.
                (block $proof_native_method_fallback
                (if (call $is_proof_inline_call (local.get $method_id) (local.get $value_pointer2)
                      (local.get $operand1)
                      (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE)))
                  (then
                    (global.set $current_executing_pc (local.get $pc))
                    (call $proof_native_op_step
                      (local.get $method_id)
                      (local.get $value_pointer2)  ;; result over the receiver slot
                      (local.get $operand1)
                      (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE))
                      (local.get $pending_pointer)
                      (local.get $fuel))
                    (local.set $fuel)
                    (local.set $result_i32)
                    (br_if $proof_native_method_fallback (i32.eq (local.get $result_i32) (i32.const 6)))
                    (if (i32.eqz (local.get $result_i32))
                      (then
                        (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                        (br $loop)))
                    (if (i32.eq (local.get $result_i32) (i32.const 1))
                      (then
                        (call $call_pressure_restore_pending (local.get $opcode)
                          (local.get $pending_pointer) (local.get $value_pointer)
                          (local.get $spread_array_pointer))
                        (local.set $fuel (i32.const 0))
                        (br $loop)))
                    (if (i32.eq (local.get $result_i32) (i32.const 2))
                      (then
                        (call $call_pressure_restore_pending (local.get $opcode)
                          (local.get $pending_pointer) (local.get $value_pointer)
                          (local.get $spread_array_pointer))
                        (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                        (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                        (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                        (br $exit)))
                    (if (i32.eq (local.get $result_i32) (i32.const 4))
                      (then
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop)))
                    (br $exit)))
                )

                (if (call $is_schema_inline_method (local.get $method_id))
                  (then
                    (if (i32.and (call $is_schema_instance_method (local.get $method_id))
                                 (i32.ne (local.get $receiver_type) (global.get $TYPE_SCHEMA)))
                      (then
                        (if (call $throw_type_error_with_message
                              (global.get $BUILTIN_MSG_SCHEMA_RECEIVER))
                          (then (br $exit))
                          (else
                            (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                            (br $loop)))))
                    (global.set $current_executing_pc (local.get $pc))
                    (call $schema_op_step
                      (local.get $method_id)
                      (local.get $receiver_pointer)
                      (local.get $value_pointer2)  ;; result over the receiver slot
                      (local.get $operand1)
                      (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE))
                      (local.get $pending_pointer)
                      (local.get $fuel))
                    (local.set $fuel)
                    (local.set $result_i32)
                    (if (i32.eqz (local.get $result_i32))
                      (then
                        (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                        (br $loop)))
                    (if (i32.eq (local.get $result_i32) (i32.const 1))
                      (then
                        (call $call_pressure_restore_pending (local.get $opcode)
                          (local.get $pending_pointer) (local.get $value_pointer)
                          (local.get $spread_array_pointer))
                        (local.set $fuel (i32.const 0))
                        (br $loop)))
                    (if (i32.eq (local.get $result_i32) (i32.const 2))
                      (then
                        (call $call_pressure_restore_pending (local.get $opcode)
                          (local.get $pending_pointer) (local.get $value_pointer)
                          (local.get $spread_array_pointer))
                        (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                        (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                        (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                        (br $exit)))
                    (if (i32.eq (local.get $result_i32) (i32.const 4))
                      (then
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop)))
                    (br $exit)))

                ;; RegExp string methods (step 5) — see the CALL twin for
                ;; the routing rationale. Result lands over the receiver
                ;; slot; disposition 5 = a replace callback frame was
                ;; staged.
                (if (i32.or
                      (i32.or
                        (i32.or
                          (i32.eq (local.get $method_id) (global.get $METHOD_STRING_MATCH))
                          (i32.eq (local.get $method_id) (global.get $METHOD_STRING_MATCH_ALL)))
                        (i32.or
                          (i32.eq (local.get $method_id) (global.get $METHOD_STRING_SEARCH))
                          (i32.eq (local.get $method_id) (global.get $METHOD_REGEXP_STRING_ITERATOR_NEXT))))
                      (i32.and
                        (i32.and
                          (i32.eq (local.get $receiver_type) (global.get $TYPE_STRING))
                          (i32.ge_u (local.get $operand1) (i32.const 1)))
                        (i32.and
                          (i32.or
                            (i32.or
                              (i32.eq (local.get $method_id) (global.get $METHOD_SPLIT))
                              (i32.eq (local.get $method_id) (global.get $METHOD_REPLACE)))
                            (i32.eq (local.get $method_id) (global.get $METHOD_REPLACE_ALL)))
                          (i32.eq
                            (call $value_type (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE)))
                            (global.get $TYPE_REGEXP)))))
                  (then
                    (global.set $current_executing_pc (local.get $pc))
                    (if (i32.eq (local.get $method_id) (global.get $METHOD_STRING_MATCH))
                      (then
                        (call $regexp_string_match_step
                          (local.get $receiver_pointer)
                          (local.get $value_pointer2)
                          (local.get $operand1)
                          (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE))
                          (local.get $pending_pointer)
                          (local.get $fuel))
                        (local.set $fuel)
                        (local.set $result_i32)))
                    (if (i32.eq (local.get $method_id) (global.get $METHOD_STRING_MATCH_ALL))
                      (then
                        (call $regexp_string_match_all_step
                          (local.get $receiver_pointer)
                          (local.get $value_pointer2)
                          (local.get $operand1)
                          (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE))
                          (local.get $pending_pointer)
                          (local.get $fuel))
                        (local.set $fuel)
                        (local.set $result_i32)))
                    (if (i32.eq (local.get $method_id) (global.get $METHOD_STRING_SEARCH))
                      (then
                        (call $regexp_string_search_step
                          (local.get $receiver_pointer)
                          (local.get $value_pointer2)
                          (local.get $operand1)
                          (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE))
                          (local.get $pending_pointer)
                          (local.get $fuel))
                        (local.set $fuel)
                        (local.set $result_i32)))
                    (if (i32.eq (local.get $method_id) (global.get $METHOD_REGEXP_STRING_ITERATOR_NEXT))
                      (then
                        (call $regexp_string_iterator_next_step
                          (local.get $receiver_pointer)
                          (local.get $value_pointer2)
                          (local.get $pending_pointer)
                          (local.get $fuel))
                        (local.set $fuel)
                        (local.set $result_i32)))
                    (if (i32.eq (local.get $method_id) (global.get $METHOD_SPLIT))
                      (then
                        (call $regexp_string_split_step
                          (local.get $receiver_pointer)
                          (local.get $value_pointer2)
                          (local.get $operand1)
                          (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE))
                          (local.get $pending_pointer)
                          (local.get $fuel))
                        (local.set $fuel)
                        (local.set $result_i32)))
                    (if (i32.or
                          (i32.eq (local.get $method_id) (global.get $METHOD_REPLACE))
                          (i32.eq (local.get $method_id) (global.get $METHOD_REPLACE_ALL)))
                      (then
                        (call $regexp_string_replace_step
                          (local.get $receiver_pointer)
                          (local.get $method_id)
                          (local.get $value_pointer2)
                          (local.get $operand1)
                          (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE))
                          (local.get $pending_pointer)
                          (local.get $fuel))
                        (local.set $fuel)
                        (local.set $result_i32)))
                    (if (i32.eqz (local.get $result_i32))
                      (then
                        (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                        (br $loop)))
                    (if (i32.eq (local.get $result_i32) (i32.const 1))
                      (then
                        (call $call_pressure_restore_pending (local.get $opcode)
                          (local.get $pending_pointer) (local.get $value_pointer)
                          (local.get $spread_array_pointer))
                        (local.set $fuel (i32.const 0))
                        (br $loop)))
                    (if (i32.eq (local.get $result_i32) (i32.const 2))
                      (then
                        (call $call_pressure_restore_pending (local.get $opcode)
                          (local.get $pending_pointer) (local.get $value_pointer)
                          (local.get $spread_array_pointer))
                        (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                        (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                        (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                        (br $exit)))
                    (if (i32.eq (local.get $result_i32) (i32.const 4))
                      (then
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop)))
                    (if (i32.eq (local.get $result_i32) (i32.const 5))
                      (then
                        (local.set $frame_pointer
                          (call $abs
                            (i32.sub
                              (call $read_ctx (global.get $CTX_CALL_STACK_POINTER))
                              (global.get $FRAME_SIZE))))
                        (i32.store
                          (i32.add
                            (local.get $frame_pointer)
                            (global.get $FRAME_INSTRUCTION_INDEX))
                          (i32.add (local.get $pc) (i32.const 1)))
                        (local.set $pc
                          (call $enter_staged_native_continuation_callback
                            (local.get $frame_pointer)))
                        (br $loop)))
                    (br $exit)))

                ;; Dispatch to non-callback method implementation
                (local.set $dispatch_result
                  (call $dispatch_builtin_method
                    (local.get $receiver_type)
                    (local.get $receiver_pointer)
                    (local.get $method_id)
                    (local.get $operand1)          ;; argc
                    (local.get $value_pointer2)))         ;; receiver position on stack (for cleanup)

                ;; Memory-pressure rollback (see CALL's TYPE_BOUND_METHOD
                ;; branch for the full explanation). Restoring
                ;; pending_pointer to entry value re-exposes the
                ;; receiver + bound method + args for retry. (Spread form:
                ;; restore rebuilds the packed [receiver, callee, args_array]
                ;; shape instead.)
                (if (global.get $memory_pressure_signaled)
                  (then
                    (call $call_pressure_restore_pending (local.get $opcode)
                      (local.get $pending_pointer) (local.get $value_pointer)
                      (local.get $spread_array_pointer))
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)
                  )
                )

                ;; Proof.universes is dispatched through the generic native
                ;; table, but stages the same continuation result as the
                ;; callback-specific method entries above.
                (if (i32.eq
                      (local.get $dispatch_result)
                      (global.get $STATUS_NATIVE_CONTINUATION_STAGED))
                  (then
                    (local.set $frame_pointer
                      (call $abs
                        (i32.sub
                          (call $read_ctx
                            (global.get $CTX_CALL_STACK_POINTER))
                          (global.get $FRAME_SIZE))))
                    (i32.store
                      (i32.add
                        (local.get $frame_pointer)
                        (global.get $FRAME_INSTRUCTION_INDEX))
                      (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $pc
                      (call $enter_staged_native_continuation_callback
                        (local.get $frame_pointer)))
                    (local.set $fuel
                      (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)))

                ;; Code 3: the stringify walk met a getter-backed property.
                ;; Restore the pending stack (dispatch truncated it) and run
                ;; the JSON_TRANSFORM driver; its completion re-runs this
                ;; CALL_METHOD with the resolved copy substituted. The
                ;; spread form cannot re-run against its unpacked stack —
                ;; it keeps the loud accessor TypeError.
                (if (i32.eq (local.get $dispatch_result) (i32.const 3))
                  (then
                    (if (i32.ne (local.get $opcode) (global.get $OP_CALL_METHOD))
                      (then
                        (if (call $throw_type_error_with_type
                              (global.get $BUILTIN_MSG_ACCESSOR_UNSUPPORTED) (global.get $TYPE_ACCESSOR))
                          (then (br $exit))
                          (else
                            (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                            (br $loop)))))
                    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $pending_pointer))
                    (local.set $value_pointer3 (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE)))
                    (local.set $result_i32 (call $json_transform_begin
                      (local.get $value_pointer3)
                      (i32.const 0)
                      (i32.sub (local.get $pending_pointer) (local.get $value_pointer3))
                      (local.get $pc)))
                    (if (i32.eq (local.get $result_i32) (i32.const -2))
                      (then
                        (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                        (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                        (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                        (br $exit)))
                    (if (i32.eq (local.get $result_i32) (i32.const -1))
                      (then
                        (if (call $throw_from_set_error) (then (br $exit)))
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop)))
                    (local.set $pc (local.get $result_i32))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )

                ;; Code 4 (generators): the native prepared an exit condition
                ;; (EXIT_GENERATOR_NEXT with the request block written and the
                ;; pending stack reset). Save the resume point and exit.
                (if (i32.eq (local.get $dispatch_result) (i32.const 4))
                  (then
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (i32.add (local.get $pc) (i32.const 1)))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $exit)
                  )
                )

                ;; Code 6 (Function.prototype.call/apply): the native rewrote
                ;; the pending stack into plain-argument shape at the receiver
                ;; slot and left [closure][scope][argc] in the request block —
                ;; stage the closure call here.
                (if (i32.eq (local.get $dispatch_result) (i32.const 6))
                  (then
                    (local.set $closure_pointer (i32.load (call $abs (global.get $external_request_base))))
                    (local.set $new_scope (i32.load (call $abs (i32.add (global.get $external_request_base) (i32.const 4)))))
                    (local.set $index (i32.load (call $abs (i32.add (global.get $external_request_base) (i32.const 8)))))

                    (local.set $stack_pointer (call $read_ctx (global.get $CTX_CALL_STACK_POINTER)))
                    (local.set $frame_pointer (call $abs (local.get $stack_pointer)))
                    (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_INSTRUCTION_INDEX)) (i32.add (local.get $pc) (i32.const 1)))
                    (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_SCOPE_POINTER)) (global.get $current_scope))
                    (call $save_frame_pending_base (local.get $frame_pointer)
                      (i32.sub
                        (call $read_ctx (global.get $CTX_PENDING_POINTER))
                        (i32.mul (local.get $index) (global.get $VALUE_SIZE))))
                    (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_PENDING_COUNT)) (i32.const 1))
                    (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_FLAGS)) (i32.const 0))
                    (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_AST_NODE)) (i32.const 0))
                    (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_ASYNC_PROMISE)) (i32.const 0))
                    (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_ARGC)) (local.get $index))
                    (call $write_ctx (global.get $CTX_CALL_STACK_POINTER)
                      (i32.add (local.get $stack_pointer) (global.get $FRAME_SIZE)))

                    (global.set $current_scope (local.get $new_scope))
                    (local.set $pc (i32.load (call $abs (i32.add (local.get $closure_pointer) (global.get $FUNCTION_CLOSURE_OFFSET)))))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )

                ;; Handle dispatch result: 0=ok, 1=caught exception, 2=uncaught error
                (if (i32.eq (local.get $dispatch_result) (i32.const 2))
                  (then
                    (if (global.get $throw_already_searched)
                      (then
                        (global.set $throw_already_searched (i32.const 0))
                        (br $exit)))
                    (if (call $throw_from_set_error)
                      (then (br $exit)))
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)))
                (if (i32.eq (local.get $dispatch_result) (i32.const 1))
                  (then
                    ;; Exception was caught, reload instruction index
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)
                  )
                )

                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Handle TYPE_EXTERNAL_METHOD - yield to orchestrator.
            ;; Stack: [receiver, external_method, arg1, ..., argN]
            ;; Reset slot is the receiver's slot (value_pointer2) so the result
            ;; replaces receiver+method+args in one shot.
            (if (i32.eq (local.get $type1) (global.get $TYPE_EXTERNAL_METHOD))
              (then
                (local.set $fuel (call $yield_external_call
                  (local.get $value_pointer)
                  (local.get $operand1)
                  (call $value_data_hi (local.get $value_pointer))
                  (local.get $value_pointer2)
                  (local.get $pc)
                  (local.get $fuel)))
                (br $exit)
              )
            )

            ;; Handle TYPE_PROMISE_RESOLVE / TYPE_PROMISE_REJECT — a Promise
            ;; executor continuation stored as an object property and called
            ;; in method form (`waiter.resolve(value)`). Same settle protocol
            ;; as OP_CALL's branch; the receiver is ignored (a continuation
            ;; binds no `this`). ONE difference: pending_pointer pre-positions
            ;; at the RECEIVER slot (value_pointer2) so the host's single
            ;; undefined write collapses receiver+continuation+args — the same
            ;; stack invariant as the TYPE_EXTERNAL_METHOD path above.
            (if (i32.or
                  (i32.eq (local.get $type1) (global.get $TYPE_PROMISE_RESOLVE))
                  (i32.eq (local.get $type1) (global.get $TYPE_PROMISE_REJECT)))
              (then
                ;; promisePointer = data_lo
                (i32.store (call $abs (global.get $external_request_base))
                  (call $value_data_lo (local.get $value_pointer)))
                ;; isReject = 1 if TYPE_PROMISE_REJECT, else 0
                (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 4)))
                  (i32.eq (local.get $type1) (global.get $TYPE_PROMISE_REJECT)))
                ;; argsPointer = value_pointer + VALUE_SIZE (first arg right after the continuation)
                (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 8)))
                  (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE)))
                ;; argCount = operand1
                (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 12)))
                  (local.get $operand1))

                ;; Save state for resume.
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX)
                  (i32.add (local.get $pc) (i32.const 1)))
                (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $value_pointer2))

                ;; Set status to PROMISE_SETTLE and exit
                (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_PROMISE_SETTLE))
                (br $exit)
              )
            )

            ;; Check it's a closure (OP_CALL_METHOD)
            (if (i32.ne (local.get $type1) (global.get $TYPE_FUNCTION))
              (then
                (if (call $throw_type_error_with_type (global.get $BUILTIN_MSG_NOT_A_FUNCTION) (local.get $type1))
                  (then (br $exit))
                  (else
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)
                  )
                )
              )
            )

            ;; Get closure data pointer
            (local.set $closure_pointer (call $value_data_lo (local.get $value_pointer)))

            ;; Read closure fields (from header pointer)
            ;; Layout: [GC:8][prototype:4][count:4][capacity:4][flags:4][entries:4][start_instruction:4][end_instruction:4][scope:4][function_flags:4]
            (local.set $start_instr (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 32)))))
            (local.set $captured_scope (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 40)))))
            (local.set $closure_flags (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 44)))))

            ;; Read receiver value (we'll need it to bind `this`)
            (local.set $type2 (call $value_type (local.get $value_pointer2)))
            (local.set $data2_lo (call $value_data_lo (local.get $value_pointer2)))
            (local.set $data2_hi (call $value_data_hi (local.get $value_pointer2)))

            ;; Async method call: yield to airlock. Same shape as OP_CALL's
            ;; async path, plus the receiver fields at offset +12..+27 so
            ;; handleAsyncCall can bind `this` in the spawned context.
            ;; Async GENERATOR methods carry both flags and take the
            ;; generator branch below.
            (if (i32.eq
                  (i32.and (local.get $closure_flags)
                    (i32.or (global.get $CLOSURE_FLAG_ASYNC) (global.get $CLOSURE_FLAG_GENERATOR)))
                  (global.get $CLOSURE_FLAG_ASYNC))
              (then
                ;; Async-call request layout (extended for method form):
                ;;   [closurePointer:4][argsPointer:4][argCount:4]
                ;;   [receiverType:4][receiverFlags:4][receiverLo:4][receiverHi:4]
                (i32.store (call $abs (global.get $external_request_base))
                  (local.get $closure_pointer))
                (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 4)))
                  (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE)))
                (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 8)))
                  (local.get $operand1))
                ;; Receiver fields
                (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 12)))
                  (local.get $type2))
                (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 16)))
                  (i32.const 0))
                (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 20)))
                  (local.get $data2_lo))
                (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 24)))
                  (local.get $data2_hi))

                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX)
                  (i32.add (local.get $pc) (i32.const 1)))
                ;; Save current_scope to CTX_SCOPE — same reason OP_AWAIT
                ;; saves it: SCOPE_PUSH operations between function entry
                ;; and this yield mutate the WAT global $current_scope but
                ;; not CTX_SCOPE. Without this save, the resumed run reads
                ;; a stale CTX_SCOPE and runs the next instruction
                ;; (typically AWAIT then SET_VAR) in the wrong scope chain,
                ;; producing "undeclared variable" errors for for-await's
                ;; internal @step / @iter bindings.
                (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_ASYNC_CALL))
                (br $exit)
              )
            )

            ;; Generator method call: spawn a generator context
            ;; using the async request shape.
            ;; method path, including the receiver fields for `this`.
            (if (i32.and (local.get $closure_flags) (global.get $CLOSURE_FLAG_GENERATOR))
              (then
                (i32.store (call $abs (global.get $external_request_base))
                  (local.get $closure_pointer))
                (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 4)))
                  (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE)))
                (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 8)))
                  (local.get $operand1))
                (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 12)))
                  (local.get $type2))
                (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 16)))
                  (i32.const 0))
                (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 20)))
                  (local.get $data2_lo))
                (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 24)))
                  (local.get $data2_hi))

                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX)
                  (i32.add (local.get $pc) (i32.const 1)))
                (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_GENERATOR_CALL))
                (br $exit)
              )
            )

            ;; Push call frame
            (local.set $stack_pointer (call $read_ctx (global.get $CTX_CALL_STACK_POINTER)))
            (local.set $frame_pointer (call $abs (local.get $stack_pointer)))

            ;; PENDING_BASE = where the receiver was (so on return, receiver + closure slots are reclaimed)
            ;; v6: CODE_BLOCK removed from frame layout
            (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_INSTRUCTION_INDEX)) (i32.add (local.get $pc) (i32.const 1)))
            (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_SCOPE_POINTER)) (global.get $current_scope))
            (call $save_frame_pending_base (local.get $frame_pointer) (local.get $value_pointer2))
            (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_PENDING_COUNT)) (i32.const 1))
            (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_FLAGS)) (i32.const 0))
            (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_AST_NODE)) (i32.const 0))
            (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_ASYNC_PROMISE)) (i32.const 0))
            (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_ARGC)) (local.get $operand1))

            ;; Update stack pointer
            (call $write_ctx (global.get $CTX_CALL_STACK_POINTER)
              (i32.add (local.get $stack_pointer) (global.get $FRAME_SIZE)))

            ;; Create new scope with captured scope as parent
            (local.set $new_scope (call $scope_create (local.get $captured_scope)))
            (global.set $current_scope (local.get $new_scope))

            ;; For non-arrow functions, bind `this` to receiver
            (if (i32.eqz (i32.and (local.get $closure_flags) (global.get $CLOSURE_FLAG_ARROW)))
              (then
                ;; Read the interned "this" string offset from builtins
                (local.set $key_offset (call $read_builtin (i32.const 0x18))) ;; BUILTIN_NAME.THIS

                ;; Define `this` in the new scope
                (call $scope_define
                  (local.get $new_scope)
                  (local.get $key_offset)
                  (local.get $type2)
                  (i32.const 0)  ;; flags
                  (local.get $data2_lo)
                  (local.get $data2_hi))
                (call $scope_define_new_target_for_method (local.get $new_scope)
                  (i32.load (i32.add (local.get $frame_pointer) (global.get $FRAME_SCOPE_POINTER)))
                  (call $read_operand2 (local.get $code_block) (local.get $pc)))
              )
            )

            ;; Remove receiver and closure from pending stack (they're consumed)
            ;; The args need to stay for LET_VAR to pop
            ;; Actually, we set PENDING_BASE to receiver position, so on return
            ;; everything from there will be reclaimed. But we need to move args
            ;; down to fill the gap left by receiver+closure.
            ;;
            ;; Stack currently: [receiver, closure, arg1, arg2, ...]
            ;; We want:         [arg1, arg2, ...]
            ;;
            ;; Move args down by 2 VALUE_SIZEs (32 bytes)
            (if (i32.gt_u (local.get $operand1) (i32.const 0))
              (then
                (local.set $i (i32.const 0))
                (block $move_done
                  (loop $move_loop
                    (br_if $move_done (i32.ge_u (local.get $i) (local.get $operand1)))

                    ;; src = value_pointer + VALUE_SIZE + i * VALUE_SIZE (args start after closure)
                    ;; dst = value_pointer2 + i * VALUE_SIZE (where receiver was)
                    (local.set $dest (i32.add (local.get $value_pointer2)
                      (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
                    (local.set $entry_pointer (i32.add
                      (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE))
                      (i32.mul (local.get $i) (global.get $VALUE_SIZE))))

                    ;; Copy 16 bytes
                    (i32.store (call $abs (local.get $dest))
                      (i32.load (call $abs (local.get $entry_pointer))))
                    (i32.store (call $abs (i32.add (local.get $dest) (i32.const 4)))
                      (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 4)))))
                    (i32.store (call $abs (i32.add (local.get $dest) (i32.const 8)))
                      (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 8)))))
                    (i32.store (call $abs (i32.add (local.get $dest) (i32.const 12)))
                      (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 12)))))

                    (local.set $i (i32.add (local.get $i) (i32.const 1)))
                    (br $move_loop)
                  )
                )
              )
            )

            ;; Update pending pointer to account for removed receiver+closure
            (call $write_ctx (global.get $CTX_PENDING_POINTER)
              (i32.sub (local.get $pending_pointer) (i32.mul (global.get $VALUE_SIZE) (i32.const 2))))

            ;; Jump to function body
            (local.set $pc (local.get $start_instr))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; OP_NEW: new Constructor(args)
        ;; operand1 = argc
        ;; Stack: [constructor, arg1, ..., argN]
        ;; Constructor can be TYPE_CONSTRUCTOR (built-in) or TYPE_FUNCTION (user-defined)
        ;; NEW_SPREAD shares this handler: its prologue pops the parser-
        ;; packed args array and unpacks it in place, after which the
        ;; stack and operand1 match NEW exactly. Pressure retries restore
        ;; the packed shape via $new_pressure_restore_pending.
        (if (i32.or
              (i32.eq (local.get $opcode) (global.get $OP_NEW))
              (i32.eq (local.get $opcode) (global.get $OP_NEW_SPREAD)))
          (then
            (if (i32.eq (local.get $opcode) (global.get $OP_NEW_SPREAD))
              (then
                ;; Peek the args array — validation and the capacity grow
                ;; below run BEFORE the pop so a pressure yield leaves the
                ;; stack untouched for the retry.
                (local.set $value_pointer (call $pending_peek))
                (local.set $type1 (i32.load (call $abs (local.get $value_pointer))))
                (if (i32.ne (local.get $type1) (global.get $TYPE_ARRAY))
                  (then
                    ;; Internal: parser always packs into an array. If we see
                    ;; non-array here, bytecode is corrupted.
                    (if (call $raise_error (global.get $ERR_TYPE_ERROR) (local.get $type1))
                      (then (br $exit)))
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)
                  )
                )
                (local.set $new_spread_array_pointer (call $value_data_lo (local.get $value_pointer)))
                (local.set $new_packed_pending (call $read_ctx (global.get $CTX_PENDING_POINTER)))
                (local.set $operand1
                  (i32.load (call $abs (i32.add (local.get $new_spread_array_pointer) (i32.const 8)))))

                ;; Pre-grow the pending stack for the unpack (see
                ;; CALL_SPREAD's prologue for the rationale).
                (block $new_spread_capacity_ok
                  (loop $new_spread_capacity_loop
                    (br_if $new_spread_capacity_ok
                      (i32.le_u
                        (i32.add
                          (call $read_ctx (global.get $CTX_PENDING_POINTER))
                          (i32.mul (i32.add (local.get $operand1) (i32.const 4)) (global.get $VALUE_SIZE)))
                        (call $read_ctx (global.get $CTX_PENDING_LIMIT))))
                    (if (call $grow_stack
                          (global.get $CTX_PENDING_BASE) (global.get $CTX_PENDING_LIMIT)
                          (global.get $CTX_PENDING_POINTER))
                      (then
                        (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                        (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                        (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                        (br $exit)
                      )
                    )
                    (br $new_spread_capacity_loop)
                  )
                )

                ;; Pop the args array (its header pointer is already saved),
                ;; then unpack its elements over the popped slot and upward.
                (drop (call $pending_pop))
                (local.set $data_pointer
                  (i32.load (call $abs (i32.add (local.get $new_spread_array_pointer) (i32.const 16)))))
                (local.set $i (i32.const 0))
                (block $new_spread_unpack_done
                  (loop $new_spread_unpack_loop
                    (br_if $new_spread_unpack_done (i32.ge_u (local.get $i) (local.get $operand1)))
                    (local.set $element_pointer (i32.add
                      (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
                      (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
                    (call $pending_push
                      (i32.load (call $abs (local.get $element_pointer)))
                      (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 4))))
                      (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 8))))
                      (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 12)))))
                    (local.set $i (i32.add (local.get $i) (i32.const 1)))
                    (br $new_spread_unpack_loop)
                  )
                )
              )
            )

            ;; Corrupt-operand tripwire: the constructor and its argc
            ;; arguments are ON the operand stack, so argc + 1 can never
            ;; exceed its depth. A corrupt argc would read a wild
            ;; address as the constructor.
            (if (i32.ge_u (local.get $operand1)
                  (i32.div_u
                    (i32.sub
                      (call $read_ctx (global.get $CTX_PENDING_POINTER))
                      (call $pending_base_seg))
                    (global.get $VALUE_SIZE)))
              (then
                (call $fault_error (global.get $ERR_CORRUPT_OPERAND) (local.get $operand1) (local.get $pc))
                (br $exit)))

            ;; Calculate constructor position: pending_pointer - (argc + 1) * VALUE_SIZE
            (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
            (local.set $value_pointer
              (i32.sub
                (local.get $pending_pointer)
                (i32.mul
                  (i32.add (local.get $operand1) (i32.const 1))
                  (global.get $VALUE_SIZE))))

            (local.set $type1 (call $value_type (local.get $value_pointer)))

            ;; =========================================================================
            ;; TYPE_FUNCTION: User-defined constructor
            ;; =========================================================================
            (if (i32.eq (local.get $type1) (global.get $TYPE_FUNCTION))
              (then
                ;; Get closure pointer
                (local.set $closure_pointer (call $value_data_lo (local.get $value_pointer)))

                ;; Check for arrow function (cannot be used as constructor)
                ;; function_flags at offset 40 (0x28)
                (local.set $closure_flags (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 44)))))
                (if (i32.and (local.get $closure_flags) (global.get $CLOSURE_FLAG_ARROW))
                  (then
                    (if (call $throw_type_error_with_type (global.get $BUILTIN_MSG_NOT_A_FUNCTION) (i32.const 0))
                      (then (br $exit))
                      (else
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop)
                      )
                    )
                  )
                )

                ;; Look up .prototype property on the function
                ;; Function layout: [GC:8][prototype:4][count:4][capacity:4][flags:4][entries:4]...
                (local.set $obj_count (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 12)))))
                (local.set $entries_pointer (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 24)))))
                (local.set $key_offset (call $read_builtin (global.get $BUILTIN_PROTOTYPE)))
                (local.set $found (i32.const 0))
                (local.set $receiver_pointer (i32.const 0))  ;; Will hold the prototype object

                (block $proto_lookup_done
                  (local.set $i (i32.const 0))
                  (loop $proto_lookup_loop
                    (br_if $proto_lookup_done (i32.ge_u (local.get $i) (local.get $obj_count)))

                    (local.set $entry_pointer (i32.add
                      (i32.add (local.get $entries_pointer) (global.get $GC_HEADER_SIZE))
                      (i32.mul (local.get $i) (global.get $ENTRY_SIZE))))

                    (local.set $prop_key (i32.load (call $abs (local.get $entry_pointer))))

                    (if (i32.eq (local.get $prop_key) (local.get $key_offset))
                      (then
                        ;; Found .prototype - get the value (should be TYPE_OBJECT)
                        (local.set $type2 (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 4)))))
                        (if (i32.eq (local.get $type2) (global.get $TYPE_OBJECT))
                          (then
                            (local.set $receiver_pointer (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 12)))))
                          )
                        )
                        ;; If .prototype is not an object, receiver_pointer stays 0 (will use Object.prototype)
                        (local.set $found (i32.const 1))
                        (br $proto_lookup_done)
                      )
                    )

                    (local.set $i (i32.add (local.get $i) (i32.const 1)))
                    (br $proto_lookup_loop)
                  )
                )

                ;; If .prototype not found or not an object, use Object.prototype
                (if (i32.eqz (local.get $receiver_pointer))
                  (then
                    (local.set $receiver_pointer (call $read_state (global.get $STATE_OBJECT_PROTOTYPE)))
                  )
                )

                ;; Allocate new object with prototype = receiver_pointer
                (local.set $heap_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))
                (local.set $object_pointer (local.get $heap_pointer))

                ;; Object header: 32 bytes [GC:8][prototype:4][count:4][capacity:4][flags:4][entries:4][sym_entries:4]
                (i32.store (call $abs (local.get $object_pointer))
                  (i32.or (global.get $OBJECT_HEADER_SIZE) (i32.shl (global.get $OBJ_OBJECT) (i32.const 24))))
                (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 4))) (i32.const 0))

                ;; Entries block: 8 + 4 * ENTRY_SIZE = 88 bytes (capacity 4)
                (local.set $entries_pointer (i32.add (local.get $object_pointer) (global.get $OBJECT_HEADER_SIZE)))
                (i32.store (call $abs (local.get $entries_pointer))
                  (i32.or (i32.const 88) (i32.shl (global.get $OBJ_OBJECT_DATA) (i32.const 24))))
                (i32.store (call $abs (i32.add (local.get $entries_pointer) (i32.const 4))) (i32.const 0))

                ;; Object fields: prototype, count=0, capacity=4, flags=0, entries_pointer, sym_entries=0
                (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 8))) (local.get $receiver_pointer))
                (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 12))) (i32.const 0))
                (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 16))) (i32.const 4))
                (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 20))) (i32.const 0))
                (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 24))) (local.get $entries_pointer))
                (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 28))) (i32.const 0))

                ;; Update heap pointer
                (call $write_state (global.get $STATE_HEAP_POINTER)
                  (i32.add (local.get $entries_pointer) (i32.const 88)))

                ;; Read closure data for the call
                (local.set $start_instr (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 32)))))
                (local.set $captured_scope (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 40)))))

                ;; Push call frame with CONSTRUCTOR flag
                ;; v6: CODE_BLOCK removed from frame layout
                (local.set $stack_pointer (call $read_ctx (global.get $CTX_CALL_STACK_POINTER)))
                (local.set $frame_pointer (call $abs (local.get $stack_pointer)))

                (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_INSTRUCTION_INDEX)) (i32.add (local.get $pc) (i32.const 1)))
                (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_SCOPE_POINTER)) (global.get $current_scope))
                (call $save_frame_pending_base (local.get $frame_pointer) (local.get $value_pointer))
                (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_PENDING_COUNT)) (i32.const 1))
                (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_FLAGS)) (global.get $FRAME_FLAG_CONSTRUCTOR))
                (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_AST_NODE)) (i32.const 0))
                (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_ASYNC_PROMISE)) (i32.const 0))
                (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_ARGC)) (local.get $operand1))
                ;; Store created object in FRAME_CONTINUATION_STATE_1 slot for RETURN_UNDEFINED to use
                (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_CONTINUATION_STATE_1)) (local.get $object_pointer))

                (call $write_ctx (global.get $CTX_CALL_STACK_POINTER)
                  (i32.add (local.get $stack_pointer) (global.get $FRAME_SIZE)))

                ;; Create new scope with captured scope as parent
                (local.set $new_scope (call $scope_create (local.get $captured_scope)))
                (global.set $current_scope (local.get $new_scope))

                ;; Bind `this` to the new object
                (call $scope_define
                  (local.get $new_scope)
                  (call $read_builtin (i32.const 0x18))  ;; BUILTIN_NAME.THIS
                  (global.get $TYPE_OBJECT)
                  (i32.const 0)
                  (local.get $object_pointer)
                  (i32.const 0))

                ;; new.target inside the constructor body: the callee itself.
                (call $scope_define_new_target (local.get $new_scope)
                  (global.get $TYPE_FUNCTION) (local.get $closure_pointer))

                ;; Jump to function body
                (local.set $pc (local.get $start_instr))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; =========================================================================
            ;; TYPE_EXTERNAL_METHOD: `new obj.method(args)` where obj.method is an
            ;; external method handle. Same yield path as OP_CALL — the host's
            ;; handler doesn't distinguish `new` from a bare call.
            ;; =========================================================================
            (if (i32.eq (local.get $type1) (global.get $TYPE_EXTERNAL_METHOD))
              (then
                (local.set $fuel (call $yield_external_call
                  (local.get $value_pointer)
                  (local.get $operand1)
                  (call $value_data_hi (local.get $value_pointer))
                  (local.get $value_pointer)
                  (local.get $pc)
                  (local.get $fuel)))
                (br $exit)
              )
            )

            ;; =========================================================================
            ;; TYPE_EXTERNAL: `new ExternalCallable(args)` — direct call on a
            ;; callable external. methodOffset = 0 signals direct call.
            ;; =========================================================================
            (if (i32.eq (local.get $type1) (global.get $TYPE_EXTERNAL))
              (then
                (local.set $fuel (call $yield_external_call
                  (local.get $value_pointer)
                  (local.get $operand1)
                  (i32.const 0)
                  (local.get $value_pointer)
                  (local.get $pc)
                  (local.get $fuel)))
                (br $exit)
              )
            )

            ;; Must be TYPE_CONSTRUCTOR for built-in constructors
            (if (i32.ne (local.get $type1) (global.get $TYPE_CONSTRUCTOR))
              (then
                (if (call $throw_type_error_with_type (global.get $BUILTIN_MSG_NOT_A_FUNCTION) (local.get $type1))
                  (then (br $exit))
                  (else
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)
                  )
                )
              )
            )

            ;; TYPE_CONSTRUCTOR layout: [type][padding][object_pointer][method_id]
            ;; data_lo = object_pointer (has static methods)
            ;; data_hi = method_id
            (local.set $receiver_pointer (call $value_data_lo (local.get $value_pointer)))
            (local.set $method_id (call $value_data_hi (local.get $value_pointer)))

            ;; Pop constructor and args, move pending pointer
            (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $value_pointer))


            ;; new RegExp(pattern, flags): a resumable engine compile, not a
            ;; plain allocation. $regexp_construct_step re-roots the
            ;; constructor and args (undoing the pop above) so they survive
            ;; fuel pauses; pause paths re-pack the SPREAD shape so the
            ;; retry's prologue unpacks cleanly.
            (if (i32.eq (local.get $method_id) (global.get $METHOD_REGEXP_CONSTRUCTOR))
              (then
                (global.set $current_executing_pc (local.get $pc))
                (call $regexp_construct_step
                  (local.get $value_pointer) (local.get $operand1)
                  (local.get $pending_pointer) (local.get $fuel))
                (local.set $fuel)
                (local.set $result_i32)
                ;; 0 = done: the result replaced the constructor slot.
                (if (i32.eqz (local.get $result_i32))
                  (then
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (br $loop)))
                ;; 1 = paused on fuel: restore the packed stack shape and
                ;; park at this pc with the engine's remaining (zero) fuel.
                (if (i32.eq (local.get $result_i32) (i32.const 1))
                  (then
                    (call $new_pressure_restore_pending (local.get $opcode) (local.get $pending_pointer) (local.get $new_packed_pending) (local.get $new_spread_array_pointer))
                    (local.set $fuel (i32.const 0))
                    (br $loop)))
                ;; 2 = memory pressure: yield for gc-and-retry of this pc.
                (if (i32.eq (local.get $result_i32) (i32.const 2))
                  (then
                    (call $new_pressure_restore_pending (local.get $opcode) (local.get $pending_pointer) (local.get $new_packed_pending) (local.get $new_spread_array_pointer))
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)))
                ;; 4 = thrown and caught: continue at the handler.
                (if (i32.eq (local.get $result_i32) (i32.const 4))
                  (then
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)))
                ;; 3 = thrown and uncaught (or substrate fault).
                (br $exit)))

            ;; new Schema(schema, options): the constructor form of compile;
            ;; same disposition ladder as RegExp above.
            (if (i32.eq (local.get $method_id) (global.get $METHOD_SCHEMA_CONSTRUCTOR))
              (then
                (global.set $current_executing_pc (local.get $pc))
                (call $schema_construct_step
                  (local.get $value_pointer) (local.get $operand1)
                  (local.get $pending_pointer) (local.get $fuel))
                (local.set $fuel)
                (local.set $result_i32)
                (if (i32.eqz (local.get $result_i32))
                  (then
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (br $loop)))
                (if (i32.eq (local.get $result_i32) (i32.const 1))
                  (then
                    (call $new_pressure_restore_pending (local.get $opcode) (local.get $pending_pointer) (local.get $new_packed_pending) (local.get $new_spread_array_pointer))
                    (local.set $fuel (i32.const 0))
                    (br $loop)))
                (if (i32.eq (local.get $result_i32) (i32.const 2))
                  (then
                    (call $new_pressure_restore_pending (local.get $opcode) (local.get $pending_pointer) (local.get $new_packed_pending) (local.get $new_spread_array_pointer))
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)))
                (if (i32.eq (local.get $result_i32) (i32.const 4))
                  (then
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)))
                (br $exit)))
            ;; Dispatch based on method_id
            (if (i32.eq (local.get $method_id) (global.get $METHOD_ARRAY_CONSTRUCTOR))
              (then
                ;; new Array() or new Array(length)
                (if (i32.eqz (local.get $operand1))
                  (then
                    ;; new Array() - create empty array
                    (if (call $check_heap_overflow (call $estimate_array_size (i32.const 0)))
                      (then
                        (call $new_pressure_restore_pending (local.get $opcode) (local.get $pending_pointer) (local.get $new_packed_pending) (local.get $new_spread_array_pointer))
                        (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                        (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                        (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                        (br $exit)))
                    (local.set $heap_pointer (call $allocate_array (i32.const 0)))
                    (call $pending_push (global.get $TYPE_ARRAY) (i32.const 0) (local.get $heap_pointer) (i32.const 0))
                  )
                  (else
                    ;; new Array(length) — a SINGLE numeric arg is the
                    ;; length. Anything else (2+ args, or one non-numeric
                    ;; arg) builds an array OF the args, per spec:
                    ;; new Array(1, 2, 3) === [1, 2, 3]; new Array("x")
                    ;; === ["x"]. (Multi-arg used to silently take the
                    ;; length-form path; one non-numeric arg used to
                    ;; TypeError.)
                    (local.set $value_pointer2 (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE)))
                    (local.set $type2 (call $value_type (local.get $value_pointer2)))
                    (if (i32.and
                          (i32.eq (local.get $operand1) (i32.const 1))
                          (call $value_is_numeric (local.get $value_pointer2)))
                      (then
                        ;; Get length from numeric (Float/Rational/BigInt)
                        (local.set $result_f64 (call $value_to_f64 (local.get $value_pointer2)))
                        ;; JS-spec invalid-array-length validation: the
                        ;; length must be a non-negative integer below
                        ;; 2^31 (sandscript arrays use i32 lengths).
                        ;; The raw trunc here trapped on NaN, and a
                        ;; negative count flowed straight into the
                        ;; allocator.
                        (if (i32.or
                              (f64.ne (f64.trunc (local.get $result_f64)) (local.get $result_f64))
                              (i32.or
                                (f64.lt (local.get $result_f64) (f64.const 0))
                                (f64.ge (local.get $result_f64) (f64.const 2147483648))))
                          (then
                            (if (call $throw_range_error_with_message
                                  (global.get $BUILTIN_MSG_INVALID_ARRAY_LENGTH))
                              (then (br $exit))
                              (else
                                (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                                (br $loop)))))
                        (local.set $count (i32.trunc_f64_s (local.get $result_f64)))
                        (if (call $check_heap_overflow
                              (call $estimate_array_size (local.get $count)))
                          (then
                            (call $new_pressure_restore_pending (local.get $opcode) (local.get $pending_pointer) (local.get $new_packed_pending) (local.get $new_spread_array_pointer))
                            (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                            (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                            (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                            (br $exit)))
                        (local.set $heap_pointer (call $allocate_array (local.get $count)))

                        ;; Initialize array elements to undefined
                        ;; Array layout: [GC:8][length:4][capacity:4][data_pointer:4]
                        (local.set $data_pointer (i32.load (call $abs (i32.add (local.get $heap_pointer) (i32.const 16)))))
                        (local.set $i (i32.const 0))
                        (block $init_done
                          (loop $init_loop
                            (br_if $init_done (i32.ge_u (local.get $i) (local.get $count)))
                            ;; element_pointer = data_pointer + GC_HEADER + i * VALUE_SIZE
                            (local.set $element_pointer (i32.add
                              (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
                              (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
                            ;; Write undefined: [type=undefined][flags=0][data_lo=0][data_hi=0]
                            (i32.store (call $abs (local.get $element_pointer)) (global.get $TYPE_UNDEFINED))
                            (i32.store (call $abs (i32.add (local.get $element_pointer) (i32.const 4))) (i32.const 0))
                            (i32.store (call $abs (i32.add (local.get $element_pointer) (i32.const 8))) (i32.const 0))
                            (i32.store (call $abs (i32.add (local.get $element_pointer) (i32.const 12))) (i32.const 0))
                            (local.set $i (i32.add (local.get $i) (i32.const 1)))
                            (br $init_loop)
                          )
                        )
                        (call $pending_push (global.get $TYPE_ARRAY) (i32.const 0) (local.get $heap_pointer) (i32.const 0))
                      )
                      (else
                        ;; new Array(elements...): copy the args verbatim.
                        (if (call $check_heap_overflow
                              (call $estimate_array_size (local.get $operand1)))
                          (then
                            (call $new_pressure_restore_pending (local.get $opcode) (local.get $pending_pointer) (local.get $new_packed_pending) (local.get $new_spread_array_pointer))
                            (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                            (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                            (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                            (br $exit)))
                        (local.set $heap_pointer (call $allocate_array (local.get $operand1)))
                        (local.set $data_pointer (i32.load (call $abs (i32.add (local.get $heap_pointer) (i32.const 16)))))
                        (local.set $i (i32.const 0))
                        (block $array_ctor_copy_done
                          (loop $array_ctor_copy_loop
                            (br_if $array_ctor_copy_done (i32.ge_u (local.get $i) (local.get $operand1)))
                            (local.set $element_pointer (i32.add
                              (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
                              (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
                            (i64.store (call $abs (local.get $element_pointer))
                              (i64.load (call $abs (i32.add (local.get $value_pointer2)
                                (i32.mul (local.get $i) (global.get $VALUE_SIZE))))))
                            (i64.store (call $abs (i32.add (local.get $element_pointer) (i32.const 8)))
                              (i64.load (call $abs (i32.add
                                (i32.add (local.get $value_pointer2) (i32.const 8))
                                (i32.mul (local.get $i) (global.get $VALUE_SIZE))))))
                            (local.set $i (i32.add (local.get $i) (i32.const 1)))
                            (br $array_ctor_copy_loop)
                          )
                        )
                        (call $pending_push (global.get $TYPE_ARRAY) (i32.const 0) (local.get $heap_pointer) (i32.const 0))
                      )
                    )
                  )
                )
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            (if (i32.eq (local.get $method_id) (global.get $METHOD_OBJECT_CONSTRUCTOR))
              (then
                ;; new Object() - create empty object
                (local.set $heap_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))
                (local.set $object_pointer (local.get $heap_pointer))

                ;; Object header: 32 bytes [GC:8][prototype:4][count:4][capacity:4][flags:4][entries:4][sym_entries:4]
                (i32.store (call $abs (local.get $object_pointer))
                  (i32.or (global.get $OBJECT_HEADER_SIZE) (i32.shl (global.get $OBJ_OBJECT) (i32.const 24))))
                (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 4))) (i32.const 0))

                ;; Entries block: 8 + 4 * ENTRY_SIZE = 88 bytes
                (local.set $entries_pointer (i32.add (local.get $object_pointer) (global.get $OBJECT_HEADER_SIZE)))
                (i32.store (call $abs (local.get $entries_pointer))
                  (i32.or (i32.const 88) (i32.shl (global.get $OBJ_OBJECT_DATA) (i32.const 24))))
                (i32.store (call $abs (i32.add (local.get $entries_pointer) (i32.const 4))) (i32.const 0))

                ;; Object fields: prototype=0, count=0, capacity=4, flags=0, entries_pointer, sym_entries=0
                (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 8))) (i32.const 0))   ;; prototype
                (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 12))) (i32.const 0))  ;; count
                (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 16))) (i32.const 4))  ;; capacity
                (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 20))) (i32.const 0))  ;; flags
                (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 24))) (local.get $entries_pointer))
                (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 28))) (i32.const 0))  ;; sym_entries

                ;; Update heap pointer
                (call $write_state (global.get $STATE_HEAP_POINTER)
                  (i32.add (local.get $entries_pointer) (i32.const 88)))

                (call $pending_push (global.get $TYPE_OBJECT) (i32.const 0) (local.get $object_pointer) (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; =========================================================================
            ;; TextEncoder / TextDecoder constructors.
            ;;
            ;; Both produce a plain object whose prototype is the corresponding
            ;; codec prototype (which carries .encode / .decode as bound
            ;; methods). State is intentionally empty — both codecs are
            ;; stateless in SS (no streaming, no `fatal`, no custom label).
            ;;
            ;; new TextDecoder("utf-8") and the zero-arg form are accepted;
            ;; any other label is rejected with TypeError to match the
            ;; "subset of JS that doesn't replicate weird corners" policy.
            ;; =========================================================================
            (if (i32.or
                  (i32.eq (local.get $method_id) (global.get $METHOD_TEXT_ENCODER_CONSTRUCTOR))
                  (i32.eq (local.get $method_id) (global.get $METHOD_TEXT_DECODER_CONSTRUCTOR)))
              (then
                ;; Note: label argument to TextDecoder (e.g. "utf-8") is
                ;; accepted but not validated in v1. Strings in SS are stored
                ;; as UTF-8 natively, so a non-UTF-8 label is silently treated
                ;; as UTF-8 rather than rejected. This is a deliberate
                ;; simplification; revisit if real callers hit it.

                ;; Select prototype based on which constructor.
                (if (i32.eq (local.get $method_id) (global.get $METHOD_TEXT_ENCODER_CONSTRUCTOR))
                  (then
                    (local.set $receiver_pointer (call $read_state (global.get $STATE_TEXT_ENCODER_PROTOTYPE)))
                  )
                  (else
                    (local.set $receiver_pointer (call $read_state (global.get $STATE_TEXT_DECODER_PROTOTYPE)))
                  )
                )

                ;; Reset pending to where the constructor was, then push instance.
                (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $value_pointer))

                ;; Pressure pre-check: object header + entries block.
                ;; allocate_object(0) writes 32 bytes for header + 8 byte entries header.
                (if (i32.ge_u (local.get $operand1) (i32.const 1))
                  (then
                    (local.set $value_pointer2
                      (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE)))
                    (if (i32.eq
                          (call $value_type (local.get $value_pointer2))
                          (global.get $TYPE_BIGINT))
                      (then
                        (if (call $check_heap_overflow (i32.const 64))
                          (then
                            (call $new_pressure_restore_pending
                              (local.get $opcode)
                              (local.get $pending_pointer)
                              (local.get $new_packed_pending)
                              (local.get $new_spread_array_pointer))
                            (call $write_ctx
                              (global.get $CTX_INSTRUCTION_INDEX)
                              (local.get $pc))
                            (call $write_ctx
                              (global.get $CTX_SCOPE)
                              (global.get $current_scope))
                            (call $write_ctx
                              (global.get $CTX_EXIT_CONDITION)
                              (global.get $EXIT_MEMORY_PRESSURE))
                            (br $exit)))
                        (call $pending_push
                          (global.get $TYPE_OBJECT)
                          (i32.const 0)
                          (call $allocate_bigint_wrapper
                            (call $value_data_lo (local.get $value_pointer2)))
                          (i32.const 0))
                        (local.set $pc
                          (i32.add (local.get $pc) (i32.const 1)))
                        (local.set $fuel
                          (i32.sub (local.get $fuel) (i32.const 1)))
                        (br $loop)))))

                (if (call $check_heap_overflow (i32.const 48))
                  (then
                    (call $new_pressure_restore_pending (local.get $opcode) (local.get $pending_pointer) (local.get $new_packed_pending) (local.get $new_spread_array_pointer))
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)))

                (local.set $object_pointer (call $allocate_object (i32.const 0)))
                ;; Wire prototype.
                (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 8))) (local.get $receiver_pointer))

                (call $pending_push (global.get $TYPE_OBJECT) (i32.const 0)
                  (local.get $object_pointer) (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; =========================================================================
            ;; Error Constructors: new Error(msg), new TypeError(msg), new ReferenceError(msg), new RangeError(msg)
            ;; =========================================================================
            (if (i32.or
                  (i32.or
                    (i32.eq (local.get $method_id) (global.get $METHOD_ERROR_CONSTRUCTOR))
                    (i32.eq (local.get $method_id) (global.get $METHOD_TYPE_ERROR_CONSTRUCTOR)))
                  (i32.or
                    (i32.eq (local.get $method_id) (global.get $METHOD_REFERENCE_ERROR_CONSTRUCTOR))
                    (i32.or
                      (i32.eq (local.get $method_id) (global.get $METHOD_RANGE_ERROR_CONSTRUCTOR))
                      (i32.eq (local.get $method_id) (global.get $METHOD_SYNTAX_ERROR_CONSTRUCTOR)))))
              (then
                ;; Select the appropriate prototype based on method_id
                (if (i32.eq (local.get $method_id) (global.get $METHOD_ERROR_CONSTRUCTOR))
                  (then
                    (local.set $receiver_pointer (call $read_state (global.get $STATE_ERROR_PROTOTYPE)))
                  )
                  (else (if (i32.eq (local.get $method_id) (global.get $METHOD_TYPE_ERROR_CONSTRUCTOR))
                    (then
                      (local.set $receiver_pointer (call $read_state (global.get $STATE_TYPE_ERROR_PROTOTYPE)))
                    )
                    (else (if (i32.eq (local.get $method_id) (global.get $METHOD_REFERENCE_ERROR_CONSTRUCTOR))
                      (then
                        (local.set $receiver_pointer (call $read_state (global.get $STATE_REFERENCE_ERROR_PROTOTYPE)))
                      )
                      (else
                        (if (i32.eq (local.get $method_id) (global.get $METHOD_RANGE_ERROR_CONSTRUCTOR))
                          (then
                            (local.set $receiver_pointer (call $read_state (global.get $STATE_RANGE_ERROR_PROTOTYPE))))
                          (else
                            (local.set $receiver_pointer (call $read_state (global.get $STATE_SYNTAX_ERROR_PROTOTYPE)))))
                      )
                    ))
                  ))
                )

                ;; Allocate error object: header + entries for 1 property (message)
                (local.set $heap_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))
                (local.set $object_pointer (local.get $heap_pointer))

                ;; Object header: 32 bytes [GC:8][prototype:4][count:4][capacity:4][flags:4][entries:4][sym_entries:4]
                (i32.store (call $abs (local.get $object_pointer))
                  (i32.or (global.get $OBJECT_HEADER_SIZE) (i32.shl (global.get $OBJ_OBJECT) (i32.const 24))))
                (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 4))) (i32.const 0))

                ;; Entries block: 8 + 2 * ENTRY_SIZE = 48 bytes (capacity 2)
                (local.set $entries_pointer (i32.add (local.get $object_pointer) (global.get $OBJECT_HEADER_SIZE)))
                (i32.store (call $abs (local.get $entries_pointer))
                  (i32.or (i32.const 48) (i32.shl (global.get $OBJ_OBJECT_DATA) (i32.const 24))))
                (i32.store (call $abs (i32.add (local.get $entries_pointer) (i32.const 4))) (i32.const 0))

                ;; Object fields: prototype, count=0, capacity=2, flags=0, entries_pointer, sym_entries=0
                (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 8))) (local.get $receiver_pointer))
                (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 12))) (i32.const 0))
                (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 16))) (i32.const 2))
                (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 20))) (i32.const 0))
                (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 24))) (local.get $entries_pointer))
                (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 28))) (i32.const 0))

                ;; Update heap pointer
                (call $write_state (global.get $STATE_HEAP_POINTER)
                  (i32.add (local.get $entries_pointer) (i32.const 48)))

                ;; Set message property
                ;; If argc > 0, use first argument; otherwise use empty string
                (if (i32.gt_u (local.get $operand1) (i32.const 0))
                  (then
                    ;; First arg is at value_pointer + VALUE_SIZE
                    (local.set $value_pointer2 (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE)))
                    (local.set $type2 (call $value_type (local.get $value_pointer2)))

                    ;; Convert to string if needed
                    (if (i32.eq (local.get $type2) (global.get $TYPE_STRING))
                      (then
                        ;; Already a string - set message directly
                        ;; Fresh capacity-2 error object, first property —
                        ;; status droppable.
                        (drop (call $object_set_property
                          (local.get $object_pointer)
                          (call $read_builtin (global.get $BUILTIN_MESSAGE))
                          (global.get $TYPE_STRING)
                          (i32.const 0)
                          (call $value_data_lo (local.get $value_pointer2))
                          (i32.const 0)))
                      )
                      (else
                        ;; Convert to string using value_to_string
                        (local.set $key_offset (call $value_to_string (local.get $value_pointer2)))
                        ;; Fresh capacity-2 error object, first property —
                        ;; status droppable.
                        (drop (call $object_set_property
                          (local.get $object_pointer)
                          (call $read_builtin (global.get $BUILTIN_MESSAGE))
                          (global.get $TYPE_STRING)
                          (i32.const 0)
                          (local.get $key_offset)
                          (i32.const 0)))
                      )
                    )
                  )
                  (else
                    ;; No argument - set message to empty string
                    ;; Fresh capacity-2 error object, first property —
                    ;; status droppable.
                    (drop (call $object_set_property
                      (local.get $object_pointer)
                      (call $read_builtin (global.get $BUILTIN_MESSAGE))
                      (global.get $TYPE_STRING)
                      (i32.const 0)
                      (call $read_builtin (global.get $BUILTIN_LIT_EMPTY_STRING))
                      (i32.const 0)))
                  )
                )

                (call $pending_push (global.get $TYPE_OBJECT) (i32.const 0) (local.get $object_pointer) (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; new Function() - TypeError (sandbox safety, no eval)
            (if (i32.eq (local.get $method_id) (global.get $METHOD_FUNCTION_CONSTRUCTOR))
              (then
                (if (call $throw_type_error_with_type (global.get $BUILTIN_MSG_NOT_A_FUNCTION) (i32.const 0))
                  (then (br $exit))
                  (else
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)
                  )
                )
              )
            )

            ;; new BigInt() - TypeError (BigInt is not a constructor)
            (if (i32.eq (local.get $method_id) (global.get $METHOD_TO_BIGINT))
              (then
                (if (call $throw_type_error_with_type (global.get $BUILTIN_MSG_NOT_A_FUNCTION) (i32.const 0))
                  (then (br $exit))
                  (else
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)
                  )
                )
              )
            )

            ;; new String() or new Number() - NotSupportedError
            (if (i32.or
                  (i32.eq (local.get $method_id) (global.get $METHOD_TO_STRING))
                  (i32.eq (local.get $method_id) (global.get $METHOD_TO_NUMBER)))
              (then
                (if (call $raise_error (global.get $ERR_NOT_SUPPORTED) (local.get $method_id))
                  (then (br $exit)))
                (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                (br $loop)
              )
            )

            ;; =========================================================================
            ;; new ArrayBuffer(length) - allocate byte buffer
            ;; =========================================================================
            (if (i32.eq (local.get $method_id) (global.get $METHOD_ARRAYBUFFER_CONSTRUCTOR))
              (then
                ;; Get length argument (operand1 = argc)
                (if (i32.eqz (local.get $operand1))
                  (then
                    ;; No argument - default to 0
                    (local.set $arr_len (i32.const 0))
                  )
                  (else
                    ;; First arg is at value_pointer + VALUE_SIZE
                    (local.set $value_pointer2 (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE)))
                    (local.set $type2 (call $value_type (local.get $value_pointer2)))

                    ;; Convert numeric length (Float/Rational/BigInt) to integer
                    (if (call $value_is_numeric (local.get $value_pointer2))
                      (then
                        (local.set $arr_len (i32.trunc_sat_f64_s (call $value_to_f64 (local.get $value_pointer2))))
                      )
                      (else
                        ;; Non-number - treat as 0
                        (local.set $arr_len (i32.const 0))
                      )
                    )
                  )
                )

                ;; Validate length (must be non-negative)
                (if (i32.lt_s (local.get $arr_len) (i32.const 0))
                  (then
                    (return (i32.add (i32.const 1) (call $throw_range_error)))
                  )
                )

                ;; Pressure pre-check.
                (if (call $check_heap_overflow
                      (call $estimate_arraybuffer_size (local.get $arr_len)))
                  (then
                    (call $new_pressure_restore_pending (local.get $opcode) (local.get $pending_pointer) (local.get $new_packed_pending) (local.get $new_spread_array_pointer))
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)))

                ;; Allocate ArrayBuffer
                (local.set $data_pointer (call $allocate_arraybuffer (local.get $arr_len)))

                ;; Push ArrayBuffer value: [TYPE_ARRAYBUFFER][0][dataPointer][0]
                (call $pending_push
                  (global.get $TYPE_ARRAYBUFFER)
                  (i32.const 0)
                  (local.get $data_pointer)
                  (i32.const 0))

                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; =========================================================================
            ;; new TypedArray(length) or new TypedArray(buffer, [offset, [length]])
            ;; Handles all typed array constructors: Uint8Array, Int8Array, etc.
            ;; =========================================================================
            (if (call $is_typed_array_constructor (local.get $method_id))
              (then
                ;; Get the result type for this constructor
                (local.set $result_type (call $get_typed_array_type_for_constructor (local.get $method_id)))
                ;; Get BYTES_PER_ELEMENT for this type
                (local.set $result_lo (call $get_bytes_per_element (local.get $result_type)))

                ;; Get first argument (operand1 = argc)
                (if (i32.eqz (local.get $operand1))
                  (then
                    ;; Pressure pre-check: empty arraybuffer + descriptor.
                    (if (call $check_heap_overflow
                          (i32.add
                            (call $estimate_arraybuffer_size (i32.const 0))
                            (call $estimate_typed_array_descriptor_size)))
                      (then
                        (call $new_pressure_restore_pending (local.get $opcode) (local.get $pending_pointer) (local.get $new_packed_pending) (local.get $new_spread_array_pointer))
                        (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                        (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                        (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                        (br $exit)))
                    ;; No argument - create empty typed array
                    (local.set $data_pointer (call $allocate_arraybuffer (i32.const 0)))
                    (local.set $element_pointer
                      (call $allocate_typed_array_descriptor
                        (local.get $data_pointer)
                        (i32.const 0)
                        (i32.const 0)))
                    (call $pending_push
                      (local.get $result_type)
                      (i32.const 0)
                      (local.get $element_pointer)
                      (i32.const 0))
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )

                ;; First arg is at value_pointer + VALUE_SIZE
                (local.set $value_pointer2 (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE)))
                (local.set $type2 (call $value_type (local.get $value_pointer2)))

                ;; Check if first arg is ArrayBuffer
                (if (i32.eq (local.get $type2) (global.get $TYPE_ARRAYBUFFER))
                  (then
                    ;; new TypedArray(buffer, [byteOffset, [length]])
                    ;; Get buffer pointer
                    (local.set $data_pointer (call $value_data_lo (local.get $value_pointer2)))
                    ;; Get buffer's byteLength (stored at first 4 bytes of ArrayBuffer data)
                    (local.set $count (i32.load (call $abs (local.get $data_pointer))))

                    ;; Default byteOffset = 0
                    (local.set $index (i32.const 0))
                    ;; Default length = (buffer.byteLength - byteOffset) / BYTES_PER_ELEMENT
                    (local.set $arr_len (i32.div_u (local.get $count) (local.get $result_lo)))

                    ;; Check for second arg (byteOffset) — accept any numeric
                    (if (i32.ge_u (local.get $operand1) (i32.const 2))
                      (then
                        (local.set $value_pointer3 (i32.add (local.get $value_pointer2) (global.get $VALUE_SIZE)))
                        (local.set $type3 (call $value_type (local.get $value_pointer3)))
                        (if (call $value_is_numeric (local.get $value_pointer3))
                          (then
                            (local.set $index (i32.trunc_sat_f64_s (call $value_to_f64 (local.get $value_pointer3))))
                          )
                        )
                        ;; Validate byteOffset (must be aligned to BYTES_PER_ELEMENT)
                        (if (i32.or
                              (i32.lt_s (local.get $index) (i32.const 0))
                              (i32.or
                                (i32.gt_u (local.get $index) (local.get $count))
                                (i32.ne (i32.rem_u (local.get $index) (local.get $result_lo)) (i32.const 0))))
                          (then
                            (if (call $throw_range_error)
                              (then (br $exit))
                              (else
                                (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                                (br $loop)
                              )
                            )
                          )
                        )
                        ;; Update default length = (buffer.byteLength - byteOffset) / BYTES_PER_ELEMENT
                        (local.set $arr_len (i32.div_u (i32.sub (local.get $count) (local.get $index)) (local.get $result_lo)))
                      )
                    )

                    ;; Check for third arg (length in elements) — accept any numeric
                    (if (i32.ge_u (local.get $operand1) (i32.const 3))
                      (then
                        (local.set $value_pointer4 (i32.add (local.get $value_pointer3) (global.get $VALUE_SIZE)))
                        (local.set $type4 (call $value_type (local.get $value_pointer4)))
                        (if (call $value_is_numeric (local.get $value_pointer4))
                          (then
                            (local.set $arr_len (i32.trunc_sat_f64_s (call $value_to_f64 (local.get $value_pointer4))))
                          )
                        )
                        ;; Validate length
                        (if (i32.lt_s (local.get $arr_len) (i32.const 0))
                          (then
                            (if (call $throw_range_error)
                              (then (br $exit))
                              (else
                                (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                                (br $loop)
                              )
                            )
                          )
                        )
                      )
                    )

                    ;; Validate offset + (length * BYTES_PER_ELEMENT) <= buffer.byteLength
                    (if (i32.gt_u (i32.add (local.get $index) (i32.mul (local.get $arr_len) (local.get $result_lo))) (local.get $count))
                      (then
                        (if (call $throw_range_error)
                          (then (br $exit))
                          (else
                            (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                            (br $loop)
                          )
                        )
                      )
                    )

                    ;; Pressure pre-check: descriptor only (buffer reused).
                    (if (call $check_heap_overflow (call $estimate_typed_array_descriptor_size))
                      (then
                        (call $new_pressure_restore_pending (local.get $opcode) (local.get $pending_pointer) (local.get $new_packed_pending) (local.get $new_spread_array_pointer))
                        (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                        (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                        (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                        (br $exit)))

                    ;; Allocate descriptor pointing to existing buffer
                    ;; Note: descriptor stores element count, not byte length
                    (local.set $element_pointer
                      (call $allocate_typed_array_descriptor
                        (local.get $data_pointer)
                        (local.get $index)
                        (local.get $arr_len)))

                    ;; Push typed array value
                    (call $pending_push
                      (local.get $result_type)
                      (i32.const 0)
                      (local.get $element_pointer)
                      (i32.const 0))

                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )

                ;; First arg is number - create new buffer with that length (in elements)
                (if (call $value_is_numeric (local.get $value_pointer2))
                  (then
                    (local.set $arr_len (i32.trunc_sat_f64_s (call $value_to_f64 (local.get $value_pointer2))))

                    ;; Validate length (must be non-negative)
                    (if (i32.lt_s (local.get $arr_len) (i32.const 0))
                      (then
                        (if (call $throw_range_error)
                          (then (br $exit))
                          (else
                            (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                            (br $loop)
                          )
                        )
                      )
                    )

                    ;; Pressure pre-check: new arraybuffer (arr_len * bpe bytes) + descriptor.
                    (if (call $check_heap_overflow
                          (i32.add
                            (call $estimate_arraybuffer_size
                              (i32.mul (local.get $arr_len) (local.get $result_lo)))
                            (call $estimate_typed_array_descriptor_size)))
                      (then
                        (call $new_pressure_restore_pending (local.get $opcode) (local.get $pending_pointer) (local.get $new_packed_pending) (local.get $new_spread_array_pointer))
                        (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                        (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                        (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                        (br $exit)))

                    ;; Allocate underlying ArrayBuffer with byteLength = length * BYTES_PER_ELEMENT
                    (local.set $data_pointer (call $allocate_arraybuffer
                      (i32.mul (local.get $arr_len) (local.get $result_lo))))

                    ;; Allocate descriptor: [bufferPtr][byteOffset=0][length in elements]
                    (local.set $element_pointer
                      (call $allocate_typed_array_descriptor
                        (local.get $data_pointer)
                        (i32.const 0)
                        (local.get $arr_len)))

                    ;; Push typed array value
                    (call $pending_push
                      (local.get $result_type)
                      (i32.const 0)
                      (local.get $element_pointer)
                      (i32.const 0))

                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )

                ;; First arg is Array - create typed array with copied elements
                (if (i32.eq (local.get $type2) (global.get $TYPE_ARRAY))
                  (then
                    ;; Get array header pointer and length
                    (local.set $array_pointer (call $value_data_lo (local.get $value_pointer2)))
                    (local.set $arr_len (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 8)))))

                    ;; Pressure pre-check: new arraybuffer + descriptor.
                    (if (call $check_heap_overflow
                          (i32.add
                            (call $estimate_arraybuffer_size
                              (i32.mul (local.get $arr_len) (local.get $result_lo)))
                            (call $estimate_typed_array_descriptor_size)))
                      (then
                        (call $new_pressure_restore_pending (local.get $opcode) (local.get $pending_pointer) (local.get $new_packed_pending) (local.get $new_spread_array_pointer))
                        (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                        (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                        (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                        (br $exit)))

                    ;; Allocate underlying ArrayBuffer with byteLength = length * BYTES_PER_ELEMENT
                    (local.set $data_pointer (call $allocate_arraybuffer
                      (i32.mul (local.get $arr_len) (local.get $result_lo))))

                    ;; Get data block pointer from array header - temporarily store in heap_pointer
                    (local.set $heap_pointer (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 16)))))

                    ;; Destination pointer (after ArrayBuffer length prefix)
                    (local.set $dest (call $abs (i32.add (local.get $data_pointer) (i32.const 4))))

                    ;; Copy loop - read from array, write as typed elements
                    (local.set $index (i32.const 0))
                    (block $copy_done
                      (loop $copy_loop
                        (br_if $copy_done (i32.ge_u (local.get $index) (local.get $arr_len)))

                        ;; Get element from source array
                        ;; Element at: data_pointer + GC_HEADER_SIZE + (index * VALUE_SIZE)
                        (local.set $value_pointer3 (i32.add
                          (i32.add (local.get $heap_pointer) (global.get $GC_HEADER_SIZE))
                          (i32.mul (local.get $index) (global.get $VALUE_SIZE))))

                        ;; Get element type
                        (local.set $type3 (call $value_type (local.get $value_pointer3)))

                        (if (i32.or
                              (i32.eq (local.get $result_type) (global.get $TYPE_BIGINT64ARRAY))
                              (i32.eq (local.get $result_type) (global.get $TYPE_BIGUINT64ARRAY)))
                          (then
                            ;; BigInt element path: $write_typed_element's f64
                            ;; payload can't carry a BigInt (this used to
                            ;; silently zero-fill). Non-BigInt elements write 0
                            ;; (spec says TypeError — same deviation SET_INDEX
                            ;; has today).
                            (local.set $result_i64 (i64.const 0))
                            (if (i32.eq (local.get $type3) (global.get $TYPE_BIGINT))
                              (then
                                (local.set $result_i64 (call $bigint_to_typed_i64
                                  (local.get $result_type)
                                  (call $value_data_lo (local.get $value_pointer3))))))
                            (i64.store
                              (i32.add (local.get $dest)
                                (i32.mul (local.get $index) (local.get $result_lo)))
                              (local.get $result_i64))
                          )
                          (else
                            ;; Numeric element path (accept any numeric)
                            (local.set $float_result (f64.const 0))
                            (if (call $value_is_numeric (local.get $value_pointer3))
                              (then
                                (local.set $float_result (call $value_to_f64 (local.get $value_pointer3)))
                              )
                            )
                            (call $write_typed_element
                              (local.get $result_type)
                              (i32.add (local.get $dest)
                                (i32.mul (local.get $index) (local.get $result_lo)))
                              (local.get $float_result))
                          )
                        )

                        (local.set $index (i32.add (local.get $index) (i32.const 1)))
                        (br $copy_loop)
                      )
                    )

                    ;; Allocate descriptor
                    (local.set $element_pointer
                      (call $allocate_typed_array_descriptor
                        (local.get $data_pointer)
                        (i32.const 0)
                        (local.get $arr_len)))

                    ;; Push typed array value
                    (call $pending_push
                      (local.get $result_type)
                      (i32.const 0)
                      (local.get $element_pointer)
                      (i32.const 0))

                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )

                ;; First arg is TypedArray - create typed array with copied elements
                (if (call $is_typed_array (local.get $type2))
                  (then
                    ;; Get source typed array descriptor
                    (local.set $array_pointer (call $value_data_lo (local.get $value_pointer2)))
                    ;; Read source descriptor: [bufferPtr][byteOffset][length]
                    ;; Reuse data1_lo for source buffer, data1_hi for source offset, data2_lo for source bpe
                    (local.set $data1_lo (i32.load (call $abs (local.get $array_pointer))))
                    (local.set $data1_hi (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 4)))))
                    (local.set $arr_len (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 8)))))

                    ;; Get source BYTES_PER_ELEMENT
                    (local.set $data2_lo (call $get_bytes_per_element (local.get $type2)))

                    ;; Pressure pre-check: new arraybuffer + descriptor.
                    (if (call $check_heap_overflow
                          (i32.add
                            (call $estimate_arraybuffer_size
                              (i32.mul (local.get $arr_len) (local.get $result_lo)))
                            (call $estimate_typed_array_descriptor_size)))
                      (then
                        (call $new_pressure_restore_pending (local.get $opcode) (local.get $pending_pointer) (local.get $new_packed_pending) (local.get $new_spread_array_pointer))
                        (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                        (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                        (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                        (br $exit)))

                    ;; Allocate underlying ArrayBuffer with byteLength = length * dest BYTES_PER_ELEMENT
                    (local.set $data_pointer (call $allocate_arraybuffer
                      (i32.mul (local.get $arr_len) (local.get $result_lo))))

                    ;; Source pointer (buffer + 4 + byteOffset) - reuse heap_pointer
                    (local.set $heap_pointer (call $abs (i32.add
                      (i32.add (local.get $data1_lo) (i32.const 4))
                      (local.get $data1_hi))))

                    ;; Destination pointer (after ArrayBuffer length prefix)
                    (local.set $dest (call $abs (i32.add (local.get $data_pointer) (i32.const 4))))

                    ;; Copy loop - read from source typed array, write to dest typed array
                    (local.set $index (i32.const 0))
                    (block $copy_done
                      (loop $copy_loop
                        (br_if $copy_done (i32.ge_u (local.get $index) (local.get $arr_len)))

                        (if (i32.and
                              (i32.or
                                (i32.eq (local.get $result_type) (global.get $TYPE_BIGINT64ARRAY))
                                (i32.eq (local.get $result_type) (global.get $TYPE_BIGUINT64ARRAY)))
                              (i32.or
                                (i32.eq (local.get $type2) (global.get $TYPE_BIGINT64ARRAY))
                                (i32.eq (local.get $type2) (global.get $TYPE_BIGUINT64ARRAY))))
                          (then
                            ;; BigInt→BigInt: raw i64 copy (bit-preserving, per
                            ;; spec's mod-2^64 element conversion). The f64 path
                            ;; below can't carry BigInts and used to zero-fill.
                            (i64.store
                              (i32.add (local.get $dest)
                                (i32.mul (local.get $index) (local.get $result_lo)))
                              (i64.load
                                (i32.add (local.get $heap_pointer)
                                  (i32.mul (local.get $index) (local.get $data2_lo)))))
                          )
                          (else
                            ;; Read from source typed array. Mixed BigInt↔numeric
                            ;; sources still zero-fill through this path (spec
                            ;; says TypeError).
                            (local.set $float_result (call $read_typed_element
                              (local.get $type2)
                              (i32.add (local.get $heap_pointer)
                                (i32.mul (local.get $index) (local.get $data2_lo)))))

                            ;; Write to destination typed array
                            (call $write_typed_element
                              (local.get $result_type)
                              (i32.add (local.get $dest)
                                (i32.mul (local.get $index) (local.get $result_lo)))
                              (local.get $float_result))
                          )
                        )

                        (local.set $index (i32.add (local.get $index) (i32.const 1)))
                        (br $copy_loop)
                      )
                    )

                    ;; Allocate descriptor
                    (local.set $element_pointer
                      (call $allocate_typed_array_descriptor
                        (local.get $data_pointer)
                        (i32.const 0)
                        (local.get $arr_len)))

                    ;; Push typed array value
                    (call $pending_push
                      (local.get $result_type)
                      (i32.const 0)
                      (local.get $element_pointer)
                      (i32.const 0))

                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )

                ;; Invalid first argument type - TypeError
                (if (call $throw_type_error_with_type (global.get $BUILTIN_MSG_NOT_AN_OBJECT) (local.get $type2))
                  (then (br $exit))
                  (else
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)
                  )
                )
              )
            )

            ;; =========================================================================
            ;; new DataView(buffer, [byteOffset, [byteLength]])
            ;; =========================================================================
            (if (i32.eq (local.get $method_id) (global.get $METHOD_DATAVIEW_CONSTRUCTOR))
              (then
                ;; Must have at least 1 arg (ArrayBuffer)
                (if (i32.eqz (local.get $operand1))
                  (then
                    (if (call $throw_type_error_with_type (global.get $BUILTIN_MSG_NOT_AN_OBJECT) (i32.const 0))
                      (then (br $exit))
                      (else
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop)
                      )
                    )
                  )
                )

                ;; First arg must be ArrayBuffer
                (local.set $value_pointer2 (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE)))
                (local.set $type2 (call $value_type (local.get $value_pointer2)))

                (if (i32.ne (local.get $type2) (global.get $TYPE_ARRAYBUFFER))
                  (then
                    (if (call $throw_type_error_with_type (global.get $BUILTIN_MSG_NOT_AN_OBJECT) (local.get $type2))
                      (then (br $exit))
                      (else
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop)
                      )
                    )
                  )
                )

                ;; Get buffer pointer and byteLength
                (local.set $data_pointer (call $value_data_lo (local.get $value_pointer2)))
                (local.set $count (i32.load (call $abs (local.get $data_pointer))))  ;; buffer.byteLength

                ;; Default byteOffset = 0
                (local.set $index (i32.const 0))
                ;; Default byteLength = buffer.byteLength - byteOffset
                (local.set $arr_len (local.get $count))

                ;; Check for second arg (byteOffset) — accept any numeric
                (if (i32.ge_u (local.get $operand1) (i32.const 2))
                  (then
                    (local.set $value_pointer3 (i32.add (local.get $value_pointer2) (global.get $VALUE_SIZE)))
                    (local.set $type3 (call $value_type (local.get $value_pointer3)))
                    (if (call $value_is_numeric (local.get $value_pointer3))
                      (then
                        (local.set $index (i32.trunc_sat_f64_s (call $value_to_f64 (local.get $value_pointer3))))
                      )
                    )
                    ;; Validate byteOffset
                    (if (i32.or
                          (i32.lt_s (local.get $index) (i32.const 0))
                          (i32.gt_u (local.get $index) (local.get $count)))
                      (then
                        (if (call $throw_range_error)
                          (then (br $exit))
                          (else
                            (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                            (br $loop)
                          )
                        )
                      )
                    )
                    ;; Update default length
                    (local.set $arr_len (i32.sub (local.get $count) (local.get $index)))

                    ;; Check for third arg (byteLength) — accept any numeric
                    (if (i32.ge_u (local.get $operand1) (i32.const 3))
                      (then
                        (local.set $value_pointer4 (i32.add (local.get $value_pointer3) (global.get $VALUE_SIZE)))
                        (local.set $type4 (call $value_type (local.get $value_pointer4)))
                        (if (call $value_is_numeric (local.get $value_pointer4))
                          (then
                            (local.set $arr_len (i32.trunc_sat_f64_s (call $value_to_f64 (local.get $value_pointer4))))
                          )
                        )
                        ;; Validate byteLength
                        (if (i32.lt_s (local.get $arr_len) (i32.const 0))
                          (then
                            (if (call $throw_range_error)
                              (then (br $exit))
                              (else
                                (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                                (br $loop)
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )

                ;; Validate byteOffset + byteLength <= buffer.byteLength
                (if (i32.gt_u (i32.add (local.get $index) (local.get $arr_len)) (local.get $count))
                  (then
                    (return (i32.add (i32.const 1) (call $throw_range_error)))
                  )
                )

                ;; Pressure pre-check: just the descriptor (reuses existing buffer).
                (if (call $check_heap_overflow (call $estimate_typed_array_descriptor_size))
                  (then
                    (call $new_pressure_restore_pending (local.get $opcode) (local.get $pending_pointer) (local.get $new_packed_pending) (local.get $new_spread_array_pointer))
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)))

