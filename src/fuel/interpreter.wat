            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_BIGINT))
                  (i32.eq (local.get $type2) (global.get $TYPE_BIGINT)))
              (then
                (call $pending_push
                  (global.get $TYPE_BOOLEAN) (i32.const 0)
                  (i32.le_s (call $bigint_compare
                    (call $value_data_lo (local.get $value_pointer))
                    (call $value_data_lo (local.get $value_pointer2)))
                    (i32.const 0))
                  (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Rational <= Rational
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_RATIONAL))
                  (i32.eq (local.get $type2) (global.get $TYPE_RATIONAL)))
              (then
                (call $pending_push
                  (global.get $TYPE_BOOLEAN) (i32.const 0)
                  (i32.le_s (call $rational_compare (local.get $value_pointer) (local.get $value_pointer2)) (i32.const 0))
                  (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )
            (if (i32.and
                  (call $value_is_numeric (local.get $value_pointer))
                  (call $value_is_numeric (local.get $value_pointer2)))
              (then
                (call $pending_push
                  (global.get $TYPE_BOOLEAN) (i32.const 0)
                  (f64.le
                    (call $value_to_f64 (local.get $value_pointer))
                    (call $value_to_f64 (local.get $value_pointer2)))
                  (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )
            ;; String <= String — lexicographic byte comparison
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_STRING))
                  (i32.eq (local.get $type2) (global.get $TYPE_STRING)))
              (then
                (call $pending_push
                  (global.get $TYPE_BOOLEAN) (i32.const 0)
                  (i32.le_s (call $string_compare (local.get $value_pointer) (local.get $value_pointer2)) (i32.const 0))
                  (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )
            (if (call $raise_error (global.get $ERR_INVALID_OPERAND) (i32.const 0))
              (then (br $exit)))
            (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
            (br $loop)
          )
        )

        (if (i32.eq (local.get $opcode) (global.get $OP_GTE))
          (then
            (local.set $value_pointer2 (call $pending_pop))
            (local.set $value_pointer (call $pending_pop))
            (local.set $type1 (call $value_type (local.get $value_pointer)))
            (local.set $type2 (call $value_type (local.get $value_pointer2)))

            ;; AlgebraicNumber comparison (Ring 6d): exact three-way
            ;; compare; pressure restores the popped operands and
            ;; yields for the gc-retry.
            (if (call $algebraic_pair_dispatchable (local.get $type1) (local.get $type2))
              (then
                (local.set $result_i32 (call $algebraic_operator_compare
                  (local.get $value_pointer) (local.get $value_pointer2)))
                (if (i32.eq (local.get $result_i32) (i32.const -2))
                  (then
                    (call $write_ctx (global.get $CTX_PENDING_POINTER)
                      (i32.add (local.get $value_pointer)
                        (i32.mul (global.get $VALUE_SIZE) (i32.const 2))))
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)))
                (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0)
                  (i32.ge_s (local.get $result_i32) (i32.const 0))
                  (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)))

            ;; BigInt >= BigInt
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_BIGINT))
                  (i32.eq (local.get $type2) (global.get $TYPE_BIGINT)))
              (then
                (call $pending_push
                  (global.get $TYPE_BOOLEAN) (i32.const 0)
                  (i32.ge_s (call $bigint_compare
                    (call $value_data_lo (local.get $value_pointer))
                    (call $value_data_lo (local.get $value_pointer2)))
                    (i32.const 0))
                  (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Rational >= Rational
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_RATIONAL))
                  (i32.eq (local.get $type2) (global.get $TYPE_RATIONAL)))
              (then
                (call $pending_push
                  (global.get $TYPE_BOOLEAN) (i32.const 0)
                  (i32.ge_s (call $rational_compare (local.get $value_pointer) (local.get $value_pointer2)) (i32.const 0))
                  (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )
            (if (i32.and
                  (call $value_is_numeric (local.get $value_pointer))
                  (call $value_is_numeric (local.get $value_pointer2)))
              (then
                (call $pending_push
                  (global.get $TYPE_BOOLEAN) (i32.const 0)
                  (f64.ge
                    (call $value_to_f64 (local.get $value_pointer))
                    (call $value_to_f64 (local.get $value_pointer2)))
                  (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )
            ;; String >= String — lexicographic byte comparison
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_STRING))
                  (i32.eq (local.get $type2) (global.get $TYPE_STRING)))
              (then
                (call $pending_push
                  (global.get $TYPE_BOOLEAN) (i32.const 0)
                  (i32.ge_s (call $string_compare (local.get $value_pointer) (local.get $value_pointer2)) (i32.const 0))
                  (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )
            (if (call $raise_error (global.get $ERR_INVALID_OPERAND) (i32.const 0))
              (then (br $exit)))
            (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
            (br $loop)
          )
        )

        (if (i32.eq (local.get $opcode) (global.get $OP_NEQ))
          (then
            (local.set $value_pointer2 (call $pending_pop))
            (local.set $value_pointer (call $pending_pop))
            (local.set $type1 (call $value_type (local.get $value_pointer)))
            (local.set $type2 (call $value_type (local.get $value_pointer2)))

            ;; Exact complex-algebraic inequality across the complete tower.
            (if (call $complex_algebraic_pair_dispatchable
                  (local.get $type1) (local.get $type2))
              (then
                (local.set $result_i32 (call $complex_algebraic_equals_slots
                  (local.get $value_pointer) (local.get $value_pointer2)))
                (if (i32.eq (local.get $result_i32) (i32.const -2))
                  (then
                    (call $write_ctx (global.get $CTX_PENDING_POINTER)
                      (i32.add (local.get $value_pointer)
                        (i32.mul (global.get $VALUE_SIZE) (i32.const 2))))
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)))
                (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0)
                  (i32.eqz (local.get $result_i32)) (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)))

            ;; AlgebraicNumber equality (Ring 6d): Algebraic joins the
            ;; "number" surface — value equality against Algebraic and
            ;; Rational operands (BigInt mixes stay false per the JS
            ;; 3n === 3 rule; Float mixes stay false at the
            ;; approximation boundary). Pressure restores the popped
            ;; operands and yields.
            (if (i32.or
                  (i32.and
                    (i32.eq (local.get $type1) (global.get $TYPE_ALGEBRAIC))
                    (i32.or
                      (i32.eq (local.get $type2) (global.get $TYPE_ALGEBRAIC))
                      (i32.eq (local.get $type2) (global.get $TYPE_RATIONAL))))
                  (i32.and
                    (i32.eq (local.get $type2) (global.get $TYPE_ALGEBRAIC))
                    (i32.eq (local.get $type1) (global.get $TYPE_RATIONAL))))
              (then
                (local.set $result_i32 (call $algebraic_operator_compare
                  (local.get $value_pointer) (local.get $value_pointer2)))
                (if (i32.eq (local.get $result_i32) (i32.const -2))
                  (then
                    (call $write_ctx (global.get $CTX_PENDING_POINTER)
                      (i32.add (local.get $value_pointer)
                        (i32.mul (global.get $VALUE_SIZE) (i32.const 2))))
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)))
                (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0)
                  (i32.ne (local.get $result_i32) (i32.const 0))
                  (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)))

            ;; Cross-type numeric !== : symmetric to OP_EQ. See OP_EQ
            ;; for rationale.
            (if (i32.and
                  (i32.ne (local.get $type1) (local.get $type2))
                  (i32.and
                    (i32.or
                      (i32.eq (local.get $type1) (global.get $TYPE_FLOAT))
                      (i32.eq (local.get $type1) (global.get $TYPE_RATIONAL)))
                    (i32.or
                      (i32.eq (local.get $type2) (global.get $TYPE_FLOAT))
                      (i32.eq (local.get $type2) (global.get $TYPE_RATIONAL)))))
              (then
                (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0)
                  (f64.ne
                    (call $value_to_f64 (local.get $value_pointer))
                    (call $value_to_f64 (local.get $value_pointer2)))
                  (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Different types are never equal (so NEQ is true)
            (if (i32.ne (local.get $type1) (local.get $type2))
              (then
                (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (i32.const 1) (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Float comparison: use f64.ne
            (if (i32.eq (local.get $type1) (global.get $TYPE_FLOAT))
              (then
                (call $pending_push
                  (global.get $TYPE_BOOLEAN)
                  (i32.const 0)
                  (f64.ne
                    (call $read_f64 (local.get $value_pointer))
                    (call $read_f64 (local.get $value_pointer2)))
                  (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Rational comparison: structural inequality (reduced form).
            (if (i32.eq (local.get $type1) (global.get $TYPE_RATIONAL))
              (then
                (if (i32.and
                      (call $rational_is_inline (local.get $value_pointer))
                      (call $rational_is_inline (local.get $value_pointer2)))
                  (then
                    (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0)
                      (i64.ne
                        (call $rational_read_inline (local.get $value_pointer))
                        (call $rational_read_inline (local.get $value_pointer2)))
                      (i32.const 0))
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)))
                (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0)
                  (i32.eqz (call $rational_eq
                    (call $rational_materialize (local.get $value_pointer))
                    (call $rational_materialize (local.get $value_pointer2))))
                  (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Complex comparison: structural inequality
            (if (i32.eq (local.get $type1) (global.get $TYPE_COMPLEX))
              (then
                (call $pending_push
                  (global.get $TYPE_BOOLEAN)
                  (i32.const 0)
                  (i32.eqz (call $complex_eq
                    (call $value_data_lo (local.get $value_pointer))
                    (call $value_data_lo (local.get $value_pointer2))))
                  (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Other types: compare data_lo
            (local.set $data1_lo (call $value_data_lo (local.get $value_pointer)))
            (local.set $data2_lo (call $value_data_lo (local.get $value_pointer2)))
            (if (i32.ne (local.get $data1_lo) (local.get $data2_lo))
              (then
                (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (i32.const 1) (i32.const 0))
              )
              (else
                (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (i32.const 0) (i32.const 0))
              )
            )
            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; =====================================================================
        ;; LOGIC
        ;; =====================================================================
        (if (i32.eq (local.get $opcode) (global.get $OP_NOT))
          (then
            (local.set $value_pointer (call $pending_pop))
            (if (call $is_truthy (local.get $value_pointer))
              (then
                (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (i32.const 0) (i32.const 0))
              )
              (else
                (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (i32.const 1) (i32.const 0))
              )
            )
            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; TYPEOF: pop value, push type string
        ;; Type mappings (JS semantics):
        ;;   TYPE_NULL (0) -> "object" (JS quirk)
        ;;   TYPE_UNDEFINED (1) -> "undefined"
        ;;   TYPE_BOOLEAN (2) -> "boolean"
        ;;   TYPE_FLOAT (4) -> "number"
        ;;   TYPE_STRING (5) -> "string"
        ;;   TYPE_ARRAY (6) -> "object"
        ;;   TYPE_OBJECT (7) -> "object"
        ;;   TYPE_FUNCTION (8) -> "function"
        (if (i32.eq (local.get $opcode) (global.get $OP_TYPEOF))
          (then
            (local.set $value_pointer (call $pending_pop))
            (local.set $type1 (call $value_type (local.get $value_pointer)))

            ;; Select the appropriate string offset based on type
            ;; Now reads from BUILTINS segment instead of STATE
            (if (i32.eq (local.get $type1) (global.get $TYPE_UNDEFINED))
              (then
                (local.set $key_offset (call $read_builtin (global.get $BUILTIN_TYPEOF_UNDEFINED)))
              )
              (else (if (i32.eq (local.get $type1) (global.get $TYPE_BOOLEAN))
                (then
                  (local.set $key_offset (call $read_builtin (global.get $BUILTIN_TYPEOF_BOOLEAN)))
                )
                (else (if (i32.or
                          (i32.or
                            (i32.or
                              (i32.eq (local.get $type1) (global.get $TYPE_FLOAT))
                              (i32.eq (local.get $type1) (global.get $TYPE_RATIONAL)))
                            (i32.or
                              (i32.eq (local.get $type1) (global.get $TYPE_COMPLEX))
                              (i32.eq (local.get $type1) (global.get $TYPE_COMPLEX_ALGEBRAIC))))
                          (i32.eq (local.get $type1) (global.get $TYPE_ALGEBRAIC)))
                  (then
                    ;; Float, Rational, Complex, and AlgebraicNumber all present as
                    ;; "number" to preserve JS surface — `typeof x === 'number'`
                    ;; works for any numeric value.
                    (local.set $key_offset (call $read_builtin (global.get $BUILTIN_TYPEOF_NUMBER)))
                  )
                  (else (if (i32.eq (local.get $type1) (global.get $TYPE_STRING))
                    (then
                      (local.set $key_offset (call $read_builtin (global.get $BUILTIN_TYPEOF_STRING)))
                    )
                    (else (if (i32.eq (local.get $type1) (global.get $TYPE_BIGINT))
                      (then
                        (local.set $key_offset (call $read_builtin (global.get $BUILTIN_TYPEOF_BIGINT)))
                      )
                      (else (if (i32.eq (local.get $type1) (global.get $TYPE_SYMBOL))
                        (then
                          ;; Ring 2: typeof Symbol → "symbol", matching JS spec.
                          (local.set $key_offset (call $read_builtin (global.get $BUILTIN_TYPEOF_SYMBOL)))
                        )
                        (else (if (i32.or
                                (i32.eq (local.get $type1) (global.get $TYPE_FUNCTION))
                                (i32.eq (local.get $type1) (global.get $TYPE_BOUND_METHOD)))
                          (then
                            (local.set $key_offset (call $read_builtin (global.get $BUILTIN_TYPEOF_FUNCTION)))
                          )
                          (else
                            ;; TYPE_NULL, TYPE_ARRAY, TYPE_OBJECT all return "object"
                            (local.set $key_offset (call $read_builtin (global.get $BUILTIN_TYPEOF_OBJECT)))
                          )
                        ))
                      ))
                    ))
                  ))
                ))
              ))
            )

            ;; Push TYPE_STRING with the string offset
            (call $pending_push
              (global.get $TYPE_STRING)
              (i32.const 0)
              (local.get $key_offset)
              (i32.const 0))

            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; =====================================================================
        ;; OP_INSTANCEOF: Check if value is instance of constructor
        ;; Stack: [left, right] → [boolean]
        ;; =====================================================================
        (if (i32.eq (local.get $opcode) (global.get $OP_INSTANCEOF))
          (then
            ;; Pop right (constructor) and left (value to test)
            (local.set $value_pointer2 (call $pending_pop))  ;; constructor
            (local.set $value_pointer (call $pending_pop))   ;; value

            (local.set $type2 (call $value_type (local.get $value_pointer2)))
            (local.set $type1 (call $value_type (local.get $value_pointer)))

            ;; extends-externals D4: TYPE_EXTERNAL right side. The
            ;; surrogate binding lives in the membrane, which the
            ;; interpreter cannot read, so the first dispatch yields
            ;; EXIT_INSTANCEOF_EXTERNAL with the handle slot; the airlock
            ;; stages the surrogate prototype pointer in the request
            ;; block (+8 marker, +12 pointer) and resumes this same
            ;; instruction. A handle with no surrogate throws host-side
            ;; (the existing not-callable TypeError). No host code runs.
            (if (i32.eq (local.get $type2) (global.get $TYPE_EXTERNAL))
              (then
                (if (i32.and
                      (i32.eq (i32.load (call $abs (i32.add (global.get $external_request_base) (i32.const 8)))) (i32.const 1))
                      (i32.eq (i32.load (call $abs (global.get $external_request_base)))
                        (call $value_data_lo (local.get $value_pointer2))))
                  (then
                    ;; Phase 2: staged surrogate; the ordinary chain walk
                    ;; below runs against it.
                    (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 8))) (i32.const 0))
                  )
                  (else
                    ;; Phase 1: restore both operands and yield at this pc.
                    (call $pending_push (local.get $type1) (call $value_flags (local.get $value_pointer))
                      (call $value_data_lo (local.get $value_pointer)) (call $value_data_hi (local.get $value_pointer)))
                    (call $pending_push (local.get $type2) (call $value_flags (local.get $value_pointer2))
                      (call $value_data_lo (local.get $value_pointer2)) (call $value_data_hi (local.get $value_pointer2)))
                    (i32.store (call $abs (global.get $external_request_base))
                      (call $value_data_lo (local.get $value_pointer2)))
                    (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 4)))
                      (call $value_data_hi (local.get $value_pointer2)))
                    (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 8))) (i32.const 0))
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_INSTANCEOF_EXTERNAL))
                    (br $exit)
                  )
                )
              )
            )

            ;; Right side must be TYPE_FUNCTION, TYPE_CONSTRUCTOR, or a
            ;; TYPE_EXTERNAL whose surrogate was staged above.
            (if (i32.and
                  (i32.and
                    (i32.ne (local.get $type2) (global.get $TYPE_FUNCTION))
                    (i32.ne (local.get $type2) (global.get $TYPE_CONSTRUCTOR)))
                  (i32.ne (local.get $type2) (global.get $TYPE_EXTERNAL)))
              (then
                (if (call $throw_type_error_with_type (global.get $BUILTIN_MSG_NOT_A_FUNCTION) (local.get $type2))
                  (then (br $exit))
                  (else
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)
                  )
                )
              )
            )

            ;; Get target prototype based on right's type. A staged
            ;; TYPE_EXTERNAL reads its surrogate from the request block
            ;; instead of resolving a .prototype property.
            (if (i32.eq (local.get $type2) (global.get $TYPE_EXTERNAL))
              (then
                (local.set $receiver_pointer
                  (i32.load (call $abs (i32.add (global.get $external_request_base) (i32.const 12)))))
              )
              (else
            (local.set $receiver_pointer (i32.const 0))  ;; target prototype

            (if (i32.eq (local.get $type2) (global.get $TYPE_FUNCTION))
              (then
                ;; For TYPE_FUNCTION: check for arrow function, then look up .prototype
                (local.set $closure_pointer (call $value_data_lo (local.get $value_pointer2)))

                ;; Check for arrow function (no .prototype) - throw TypeError
                (local.set $closure_flags (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 44)))))
                (if (i32.and (local.get $closure_flags) (global.get $CLOSURE_FLAG_ARROW))
                  (then
                    (if (call $throw_type_error_with_type (global.get $BUILTIN_MSG_NOT_A_FUNCTION) (i32.const 0))
                      (then (br $exit))
                      (else
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop)
                      )
                    )
                  )
                )

                ;; Look up .prototype property on the function
                (local.set $obj_count (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 12)))))
                (local.set $entries_pointer (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 24)))))
                (local.set $key_offset (call $read_builtin (global.get $BUILTIN_PROTOTYPE)))

                (block $proto_found
                  (local.set $i (i32.const 0))
                  (loop $proto_loop
                    (br_if $proto_found (i32.ge_u (local.get $i) (local.get $obj_count)))

                    (local.set $entry_pointer (i32.add
                      (i32.add (local.get $entries_pointer) (global.get $GC_HEADER_SIZE))
                      (i32.mul (local.get $i) (global.get $ENTRY_SIZE))))

                    (local.set $prop_key (i32.load (call $abs (local.get $entry_pointer))))

                    (if (i32.eq (local.get $prop_key) (local.get $key_offset))
                      (then
                        ;; Found .prototype - check it's an object
                        (local.set $result_type (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 4)))))
                        (if (i32.eq (local.get $result_type) (global.get $TYPE_OBJECT))
                          (then
                            (local.set $receiver_pointer (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 12)))))
                          )
                        )
                        (br $proto_found)
                      )
                    )

                    (local.set $i (i32.add (local.get $i) (i32.const 1)))
                    (br $proto_loop)
                  )
                )

                ;; If .prototype not found or not object, throw TypeError
                (if (i32.eqz (local.get $receiver_pointer))
                  (then
                    (if (call $throw_type_error_with_type (global.get $BUILTIN_MSG_NOT_AN_OBJECT) (i32.const 0))
                      (then (br $exit))
                      (else
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop)
                      )
                    )
                  )
                )
              )
              (else
                ;; TYPE_CONSTRUCTOR: method_id → prototype, via the
                ;; shared lookup table (batch 20). 0 means "unrecognized
                ;; constructor id" — the
                ;; error-throw-and-loop-control stays here since it needs
                ;; $exit/$loop, unreachable from inside a called function.
                (local.set $method_id (call $value_data_hi (local.get $value_pointer2)))
                (local.set $receiver_pointer (call $constructor_method_id_to_prototype (local.get $method_id)))
                ;; Schema keeps its prototype on the constructor object
                (global.set $schema_prototype_pointer (i32.const 0))
                (if (i32.eq (local.get $method_id) (global.get $METHOD_SCHEMA_CONSTRUCTOR))
                  (then
                    (local.set $entry_pointer (call $object_find_string_entry
                      (call $value_data_lo (local.get $value_pointer2))
                      (call $read_builtin (global.get $BUILTIN_PROTOTYPE))))
                    (if (local.get $entry_pointer)
                      (then
                        (local.set $receiver_pointer (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 12)))))
                        (global.set $schema_prototype_pointer (local.get $receiver_pointer))))))
                (if (i32.eqz (local.get $receiver_pointer))
                  (then
                    (if (call $throw_type_error_with_type (global.get $BUILTIN_MSG_NOT_AN_OBJECT) (i32.const 0))
                      (then (br $exit))
                      (else
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop)
                      )
                    )
                  )
                )
              )
            )

            ))

            ;; Now check left value against target prototype (receiver_pointer)
            ;; Handle primitives: return false. Rational, BigInt, and Complex
            ;; count as primitives for instanceof purposes (no wrapper objects).
            (if (i32.or
                  (i32.or
                    (i32.or
                      (i32.eq (local.get $type1) (global.get $TYPE_UNDEFINED))
                      (i32.eq (local.get $type1) (global.get $TYPE_NULL)))
                    (i32.or
                      (i32.or
                        (i32.eq (local.get $type1) (global.get $TYPE_BOOLEAN))
                        (i32.eq (local.get $type1) (global.get $TYPE_FLOAT)))
                      (i32.eq (local.get $type1) (global.get $TYPE_STRING))))
                  (i32.or
                    (i32.or
                      (i32.eq (local.get $type1) (global.get $TYPE_RATIONAL))
                      (i32.eq (local.get $type1) (global.get $TYPE_BIGINT)))
                    (i32.eq (local.get $type1) (global.get $TYPE_COMPLEX))))
              (then
                ;; Primitives: push false
                (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (i32.const 0) (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Handle msgpack refs BEFORE the generic object walk: a
            ;; ref's data_lo is the parent blob's data pointer, NOT an
            ;; object header — the fall-through prototype-chain walk
            ;; dereferenced it as one and read data-dependent garbage
            ;; (in-bounds → a wrong answer; out-of-bounds → a raw WASM
            ;; trap; hit live by iris3's topology observer, 2026-07-11).
            ;; Semantics mirror what the ref decodes as: an array ref
            ;; answers like TYPE_ARRAY, a map ref like a plain object.
            (if (i32.eq (local.get $type1) (global.get $TYPE_MSGPACK_REF))
              (then
                (local.set $mp_type (call $msgpack_peek_type
                  (call $msgpack_ref_absolute
                    (call $value_data_lo (local.get $value_pointer))
                    (call $value_data_hi (local.get $value_pointer)))
                  (call $msgpack_ref_parent_end
                    (call $value_data_lo (local.get $value_pointer)))))
                (if (i32.eq (local.get $mp_type) (global.get $MSGPACK_ERROR))
                  (then
                    (if (call $raise_error (global.get $ERR_MSGPACK_INVALID) (i32.const 30))
                      (then (br $exit)))
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)
                  )
                )
                (local.set $found (i32.const 0))
                (if (i32.eq (local.get $mp_type) (global.get $MSGPACK_ARRAY))
                  (then
                    (if (i32.eq (local.get $receiver_pointer) (call $read_state (global.get $STATE_ARRAY_PROTOTYPE)))
                      (then (local.set $found (i32.const 1))))
                    (if (i32.eq (local.get $receiver_pointer) (call $read_state (global.get $STATE_OBJECT_PROTOTYPE)))
                      (then (local.set $found (i32.const 1))))
                  )
                )
                (if (i32.eq (local.get $mp_type) (global.get $MSGPACK_MAP))
                  (then
                    (if (i32.eq (local.get $receiver_pointer) (call $read_state (global.get $STATE_OBJECT_PROTOTYPE)))
                      (then (local.set $found (i32.const 1))))
                  )
                )
                (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (local.get $found) (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; RegExp primitives: true against RegExp.prototype or
            ;; Object.prototype (mirrors the array arm below).
            (if (i32.eq (local.get $type1) (global.get $TYPE_REGEXP))
              (then
                (local.set $found (i32.const 0))
                (if (i32.eq (local.get $receiver_pointer) (call $read_state (global.get $STATE_REGEXP_PROTOTYPE)))
                  (then (local.set $found (i32.const 1))))
                (if (i32.eq (local.get $receiver_pointer) (call $read_state (global.get $STATE_OBJECT_PROTOTYPE)))
                  (then (local.set $found (i32.const 1))))
                (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (local.get $found) (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)))

            ;; Schema primitives: true against Schema.prototype (found on
            ;; the constructor object — no STATE cell) or Object.prototype.
            (if (i32.eq (local.get $type1) (global.get $TYPE_SCHEMA))
              (then
                (local.set $found (i32.const 0))
                (if (i32.eq (local.get $receiver_pointer) (global.get $schema_prototype_pointer))
                  (then (local.set $found (i32.const 1))))
                (if (i32.eq (local.get $receiver_pointer) (call $read_state (global.get $STATE_OBJECT_PROTOTYPE)))
                  (then (local.set $found (i32.const 1))))
                (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (local.get $found) (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)))

            ;; Handle arrays specially
            (if (i32.eq (local.get $type1) (global.get $TYPE_ARRAY))
              (then
                ;; Arrays: true if target is Array.prototype or Object.prototype
                (local.set $found (i32.const 0))
                (if (i32.eq (local.get $receiver_pointer) (call $read_state (global.get $STATE_ARRAY_PROTOTYPE)))
                  (then (local.set $found (i32.const 1)))
                )
                (if (i32.eq (local.get $receiver_pointer) (call $read_state (global.get $STATE_OBJECT_PROTOTYPE)))
                  (then (local.set $found (i32.const 1)))
                )
                (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (local.get $found) (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Handle ArrayBuffer specially
            (if (i32.eq (local.get $type1) (global.get $TYPE_ARRAYBUFFER))
              (then
                ;; ArrayBuffer: true if target is ArrayBuffer.prototype or Object.prototype
                (local.set $found (i32.const 0))
                (if (i32.eq (local.get $receiver_pointer) (call $read_state (global.get $STATE_ARRAYBUFFER_PROTOTYPE)))
                  (then (local.set $found (i32.const 1)))
                )
                (if (i32.eq (local.get $receiver_pointer) (call $read_state (global.get $STATE_OBJECT_PROTOTYPE)))
                  (then (local.set $found (i32.const 1)))
                )
                (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (local.get $found) (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Handle Uint8Array specially
            (if (i32.eq (local.get $type1) (global.get $TYPE_UINT8ARRAY))
              (then
                ;; Uint8Array: true if target is Uint8Array.prototype or Object.prototype
                (local.set $found (i32.const 0))
                (if (i32.eq (local.get $receiver_pointer) (call $read_state (global.get $STATE_UINT8ARRAY_PROTOTYPE)))
                  (then (local.set $found (i32.const 1)))
                )
                (if (i32.eq (local.get $receiver_pointer) (call $read_state (global.get $STATE_OBJECT_PROTOTYPE)))
                  (then (local.set $found (i32.const 1)))
                )
                (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (local.get $found) (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Handle DataView specially
            (if (i32.eq (local.get $type1) (global.get $TYPE_DATAVIEW))
              (then
                ;; DataView: true if target is DataView.prototype or Object.prototype
                (local.set $found (i32.const 0))
                (if (i32.eq (local.get $receiver_pointer) (call $read_state (global.get $STATE_DATAVIEW_PROTOTYPE)))
                  (then (local.set $found (i32.const 1)))
                )
                (if (i32.eq (local.get $receiver_pointer) (call $read_state (global.get $STATE_OBJECT_PROTOTYPE)))
                  (then (local.set $found (i32.const 1)))
                )
                (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (local.get $found) (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Handle Map specially
            (if (i32.eq (local.get $type1) (global.get $TYPE_MAP))
              (then
                ;; Map: true if target is Map.prototype or Object.prototype.
                ;; A Map value is not a prototype-bearing object (offset 8 of
                ;; its header is `size`, not a [[Prototype]] pointer), so it
                ;; must NOT fall through to the generic chain walk below.
                (local.set $found (i32.const 0))
                (if (i32.eq (local.get $receiver_pointer) (call $read_state (global.get $STATE_MAP_PROTOTYPE)))
                  (then (local.set $found (i32.const 1)))
                )
                (if (i32.eq (local.get $receiver_pointer) (call $read_state (global.get $STATE_OBJECT_PROTOTYPE)))
                  (then (local.set $found (i32.const 1)))
                )
                (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (local.get $found) (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Handle Set specially
            (if (i32.eq (local.get $type1) (global.get $TYPE_SET))
              (then
                ;; Set: true if target is Set.prototype or Object.prototype.
                ;; Same rationale as Map above.
                (local.set $found (i32.const 0))
                (if (i32.eq (local.get $receiver_pointer) (call $read_state (global.get $STATE_SET_PROTOTYPE)))
                  (then (local.set $found (i32.const 1)))
                )
                (if (i32.eq (local.get $receiver_pointer) (call $read_state (global.get $STATE_OBJECT_PROTOTYPE)))
                  (then (local.set $found (i32.const 1)))
                )
                (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (local.get $found) (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; For objects and functions: walk prototype chain
            ;; Get left's [[Prototype]]
            (local.set $object_pointer (call $value_data_lo (local.get $value_pointer)))
            (local.set $heap_pointer (i32.load (call $abs (i32.add (local.get $object_pointer) (i32.const 8)))))  ;; prototype at offset 8

            ;; Walk chain
            (local.set $found (i32.const 0))
            (block $chain_done
              (loop $chain_loop
                ;; If current is 0, we've reached end of chain
                (br_if $chain_done (i32.eqz (local.get $heap_pointer)))

                ;; Check if current matches target
                (if (i32.eq (local.get $heap_pointer) (local.get $receiver_pointer))
                  (then
                    (local.set $found (i32.const 1))
                    (br $chain_done)
                  )
                )

                ;; Move to next prototype
                (local.set $heap_pointer (i32.load (call $abs (i32.add (local.get $heap_pointer) (i32.const 8)))))
                (br $chain_loop)
              )
            )

            ;; Push result
            (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (local.get $found) (i32.const 0))
            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; =====================================================================
        ;; OP_VOID: pop operand (already evaluated for side effects),
        ;; discard it, push undefined.
        ;; Stack: [value] → [undefined]
        ;; =====================================================================
        (if (i32.eq (local.get $opcode) (global.get $OP_VOID))
          (then
            (drop (call $pending_pop))
            (call $pending_push (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))
            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; =====================================================================
        ;; OP_DELETE: `delete <non-reference>` — the parser only reaches
        ;; here when delete's operand did NOT bottom out in a
        ;; MEMBER_ACCESS/INDEX_ACCESS reference (parser.js's unary()
        ;; special-cases those to DELETE_PROP/DELETE_INDEX instead, which
        ;; can actually remove something). This is `delete x`, `delete 5`,
        ;; `delete f()` — matches JS's own "operand is not a reference"
        ;; case, which is a SyntaxError for bare identifiers in strict
        ;; mode; sandscript throws for all such cases rather than
        ;; inventing a "true but did nothing" semantics.
        ;; Stack: [operand] → (throws)
        ;; =====================================================================
        (if (i32.eq (local.get $opcode) (global.get $OP_DELETE))
          (then
            (drop (call $pending_pop))
            (if (call $raise_error (global.get $ERR_NOT_SUPPORTED) (global.get $NOT_SUPPORTED_FEATURE_DELETE))
              (then (br $exit))
              (else
                (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                (br $loop)
              )
            )
          )
        )

        ;; =====================================================================
        ;; OP_DELETE_PROP: `delete obj.prop`. operand1 = compile-time
        ;; string-key offset (same as GET_PROP/SET_PROP). Stack: [obj] →
        ;; [boolean]. Own-property removal only (JS semantics — deleting
        ;; through to a prototype's same-named property is not a thing).
        ;; Non-Object/Function receivers (Array, string, number, etc.):
        ;; JS's delete on a non-configurable-or-absent property still
        ;; returns a boolean without throwing for most cases, but
        ;; sandscript has no per-property configurability model, so this
        ;; simply reports `false` (property was never there to remove) —
        ;; matches deleting a nonexistent key on a real object too.
        ;; =====================================================================
        (if (i32.eq (local.get $opcode) (global.get $OP_DELETE_PROP))
          (then
            (local.set $value_pointer (call $pending_pop))
            (local.set $type1 (call $value_type (local.get $value_pointer)))
            (if (i32.or
                  (i32.eq (local.get $type1) (global.get $TYPE_OBJECT))
                  (i32.eq (local.get $type1) (global.get $TYPE_FUNCTION)))
              (then
                (local.set $object_pointer (call $value_data_lo (local.get $value_pointer)))
                (local.set $found (call $object_delete_own_property
                  (local.get $object_pointer) (local.get $operand1)))
              )
              (else
                (local.set $found (i32.const 0))
              )
            )
            ;; extends-externals D5: no own vat entry on a branded instance —
            ;; route the deletion to the backing value (setDeleteProperty).
            (if (i32.eqz (local.get $found))
              (then
                (if (i32.and
                      (i32.eq (local.get $type1) (global.get $TYPE_OBJECT))
                      (i32.ne
                        (i32.and
                          (i32.load (call $abs (i32.add (local.get $object_pointer) (i32.const 20))))
                          (global.get $OBJECT_FLAG_EXTERNAL_BACKED))
                        (i32.const 0)))
                  (then
                    (local.set $entry_pointer (call $object_find_string_entry
                      (local.get $object_pointer)
                      (call $read_builtin (global.get $BUILTIN_EXTERNAL_BACKING))))
                    (if (i32.ne (local.get $entry_pointer) (i32.const 0))
                      (then
                        (i32.store (call $abs (global.get $external_request_base))
                          (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 12)))))
                        (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 4)))
                          (local.get $operand1))
                        (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 8))) (i32.const 0))
                        (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 12))) (i32.const 0))
                        (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 16)))
                          (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 16)))))
                        (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 20)))
                          (local.get $object_pointer))
                        (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                        (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (i32.add (local.get $pc) (i32.const 1)))
                        (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                        (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_EXTERNAL_DELETE_PROPERTY))
                        (br $exit)
                      )
                    )
                  )
                )
              )
            )
            (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (local.get $found) (i32.const 0))
            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; =====================================================================
        ;; OP_DELETE_INDEX: `delete obj[expr]`. Stack: [obj, key] →
        ;; [boolean] (SET_INDEX's pop order: key on top). ToPropertyKey the
        ;; key to a string for Object/Function receivers, same coercion
        ;; chokepoint as GET_INDEX/SET_INDEX. Arrays: no hole
        ;; representation exists (grep confirms no TYPE_HOLE/sparse-array
        ;; support) — rather than silently splice (wrong: JS's delete
        ;; leaves length unchanged) or silently set-to-undefined
        ;; (indistinguishable from a real assigned undefined, which is
        ;; NOT what `delete` means), this is explicit NOT_SUPPORTED for
        ;; arrays, per the plan's Slice 2 scope boundary.
        ;; =====================================================================
        (if (i32.eq (local.get $opcode) (global.get $OP_DELETE_INDEX))
          (then
            ;; ToPropertyKey on the un-popped key slot (same rationale as
            ;; GET_INDEX/OP_IN: scratch writes must land above the live
            ;; top, and a pressure yield must retry with the stack intact).
            (local.set $value_pointer (call $pending_peek))
            (local.set $value_pointer2 (i32.sub (local.get $value_pointer) (global.get $VALUE_SIZE)))
            (local.set $type1 (call $value_type (local.get $value_pointer2)))
            (local.set $type2 (call $value_type (local.get $value_pointer)))
            (if (i32.and
                  (i32.or
                    (i32.eq (local.get $type1) (global.get $TYPE_OBJECT))
                    (i32.eq (local.get $type1) (global.get $TYPE_FUNCTION)))
                  (i32.and
                    (i32.ne (local.get $type2) (global.get $TYPE_STRING))
                    (i32.ne (local.get $type2) (global.get $TYPE_SYMBOL))))
              (then
                (local.set $key_offset (call $value_to_string (local.get $value_pointer)))
                (if (global.get $memory_pressure_signaled)
                  (then
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)
                  )
                )
                (i32.store (call $abs (local.get $value_pointer)) (global.get $TYPE_STRING))
                (i32.store (call $abs (i32.add (local.get $value_pointer) (i32.const 4))) (i32.const 0))
                (i32.store (call $abs (i32.add (local.get $value_pointer) (i32.const 8))) (local.get $key_offset))
                (i32.store (call $abs (i32.add (local.get $value_pointer) (i32.const 12))) (i32.const 0))
                (local.set $type2 (global.get $TYPE_STRING))
              )
            )

            (local.set $value_pointer (call $pending_pop))   ;; key
            (local.set $value_pointer2 (call $pending_pop))  ;; obj

            (if (i32.eq (local.get $type1) (global.get $TYPE_ARRAY))
              (then
                (if (call $raise_error (global.get $ERR_NOT_SUPPORTED) (global.get $NOT_SUPPORTED_FEATURE_DELETE))
                  (then (br $exit))
                  (else
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)
                  )
                )
              )
            )

            (if (i32.or
                  (i32.eq (local.get $type1) (global.get $TYPE_OBJECT))
                  (i32.eq (local.get $type1) (global.get $TYPE_FUNCTION)))
              (then
                (if (i32.eq (local.get $type2) (global.get $TYPE_SYMBOL))
                  (then
                    (if (call $raise_error (global.get $ERR_NOT_SUPPORTED) (global.get $NOT_SUPPORTED_FEATURE_DELETE))
                      (then (br $exit))
                      (else
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop)
                      )
                    )
                  )
                )
                (local.set $key_offset (call $value_data_lo (local.get $value_pointer)))
                (local.set $object_pointer (call $value_data_lo (local.get $value_pointer2)))
                (local.set $found (call $object_delete_own_property
                  (local.get $object_pointer) (local.get $key_offset)))
                ;; extends-externals D5: forward branded deletions (see
                ;; OP_DELETE_PROP).
                (if (i32.eqz (local.get $found))
                  (then
                    (if (i32.and
                          (i32.eq (local.get $type1) (global.get $TYPE_OBJECT))
                          (i32.ne
                            (i32.and
                              (i32.load (call $abs (i32.add (local.get $object_pointer) (i32.const 20))))
                              (global.get $OBJECT_FLAG_EXTERNAL_BACKED))
                            (i32.const 0)))
                      (then
                        (local.set $entry_pointer (call $object_find_string_entry
                          (local.get $object_pointer)
                          (call $read_builtin (global.get $BUILTIN_EXTERNAL_BACKING))))
                        (if (i32.ne (local.get $entry_pointer) (i32.const 0))
                          (then
                            (i32.store (call $abs (global.get $external_request_base))
                              (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 12)))))
                            (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 4)))
                              (local.get $key_offset))
                            (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 8))) (i32.const 0))
                            (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 12))) (i32.const 0))
                            (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 16)))
                              (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 16)))))
                            (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 20)))
                              (local.get $object_pointer))
                            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                            (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (i32.add (local.get $pc) (i32.const 1)))
                            (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                            (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_EXTERNAL_DELETE_PROPERTY))
                            (br $exit)
                          )
                        )
                      )
                    )
                  )
                )
                (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (local.get $found) (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Any other receiver type (string, number, etc.): nothing to
            ;; delete — push false rather than throw (matches JS: `delete
            ;; "x"[0]` is `false`, not a TypeError).
            (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (i32.const 0) (i32.const 0))
            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; =====================================================================
        ;; OP_IN: `key in obj`. Stack: [key, obj] → [boolean]
        ;; Object/Function: ToPropertyKey(key) to a string (symbol keys are
        ;; NOT_SUPPORTED — no symbol-keyed lookup wired here yet), then walk
        ;; the prototype chain via $object_find_string_entry (own +
        ;; inherited, matching JS's `in` semantics — unlike DELETE, which is
        ;; own-properties-only). Array: numeric index bounds check, no
        ;; prototype walk (arr.length/etc. living on Array.prototype are
        ;; intentionally excluded — same scope boundary as GET_INDEX's
        ;; array branch, which never consults Array.prototype either).
        ;; Anything else: TypeError, matching JS ("Cannot use 'in' operator
        ;; to search for 'x' in 5").
        ;; =====================================================================
        (if (i32.eq (local.get $opcode) (global.get $OP_IN))
          (then
            ;; ToPropertyKey on the un-popped key slot first (same rationale
            ;; as GET_INDEX: $value_to_string's scratch writes must land
            ;; above the live pending-stack top, and a pressure yield must
            ;; retry with the stack untouched).
            (local.set $value_pointer2 (call $pending_peek))                                   ;; obj (right, top)
            (local.set $value_pointer (i32.sub (local.get $value_pointer2) (global.get $VALUE_SIZE)))  ;; key (left)
            (local.set $type1 (call $value_type (local.get $value_pointer2)))
            (local.set $type2 (call $value_type (local.get $value_pointer)))

            (if (i32.and
                  (i32.or
                    (i32.eq (local.get $type1) (global.get $TYPE_OBJECT))
                    (i32.eq (local.get $type1) (global.get $TYPE_FUNCTION)))
                  (i32.and
                    (i32.ne (local.get $type2) (global.get $TYPE_STRING))
                    (i32.ne (local.get $type2) (global.get $TYPE_SYMBOL))))
              (then
                (local.set $key_offset (call $value_to_string (local.get $value_pointer)))
                (if (global.get $memory_pressure_signaled)
                  (then
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)
                  )
                )
                (i32.store (call $abs (local.get $value_pointer)) (global.get $TYPE_STRING))
                (i32.store (call $abs (i32.add (local.get $value_pointer) (i32.const 4))) (i32.const 0))
                (i32.store (call $abs (i32.add (local.get $value_pointer) (i32.const 8))) (local.get $key_offset))
                (i32.store (call $abs (i32.add (local.get $value_pointer) (i32.const 12))) (i32.const 0))
                (local.set $type2 (global.get $TYPE_STRING))
              )
            )

            ;; Pop obj, then key.
            (local.set $value_pointer2 (call $pending_pop))
            (local.set $value_pointer (call $pending_pop))

            (if (i32.eq (local.get $type1) (global.get $TYPE_ARRAY))
              (then
                (local.set $array_pointer (call $value_data_lo (local.get $value_pointer2)))
                (local.set $arr_len (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 8)))))
                (local.set $index (call $f64_index_or_negative (call $value_to_f64 (local.get $value_pointer))))
                (local.set $found (i32.and
                  (i32.ge_s (local.get $index) (i32.const 0))
                  (i32.lt_u (local.get $index) (local.get $arr_len))))
                (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (local.get $found) (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            (if (i32.or
                  (i32.eq (local.get $type1) (global.get $TYPE_OBJECT))
                  (i32.eq (local.get $type1) (global.get $TYPE_FUNCTION)))
              (then
                (if (i32.eq (local.get $type2) (global.get $TYPE_SYMBOL))
                  (then
                    (if (call $raise_error (global.get $ERR_NOT_SUPPORTED) (global.get $NOT_SUPPORTED_FEATURE_IN))
                      (then (br $exit))
                      (else
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop)
                      )
                    )
                  )
                )

                (local.set $key_offset (call $value_data_lo (local.get $value_pointer)))
                (local.set $object_pointer (call $value_data_lo (local.get $value_pointer2)))
                (local.set $found (i32.ne
                  (call $object_find_string_entry (local.get $object_pointer) (local.get $key_offset))
                  (i32.const 0)))
                ;; extends-externals D5: an in-vat miss on a branded instance
                ;; asks the backing value (setHasProperty; deterministic
                ;; presence probe, never a getter).
                (if (i32.eqz (local.get $found))
                  (then
                    (if (i32.and
                          (i32.eq (local.get $type1) (global.get $TYPE_OBJECT))
                          (i32.ne
                            (i32.and
                              (i32.load (call $abs (i32.add (local.get $object_pointer) (i32.const 20))))
                              (global.get $OBJECT_FLAG_EXTERNAL_BACKED))
                            (i32.const 0)))
                      (then
                        (local.set $entry_pointer (call $object_find_string_entry
                          (local.get $object_pointer)
                          (call $read_builtin (global.get $BUILTIN_EXTERNAL_BACKING))))
                        (if (i32.ne (local.get $entry_pointer) (i32.const 0))
                          (then
                            (i32.store (call $abs (global.get $external_request_base))
                              (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 12)))))
                            (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 4)))
                              (local.get $key_offset))
                            (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 8))) (i32.const 0))
                            (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 12))) (i32.const 0))
                            (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 16)))
                              (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 16)))))
                            (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 20)))
                              (local.get $object_pointer))
                            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                            (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (i32.add (local.get $pc) (i32.const 1)))
                            (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                            (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_EXTERNAL_HAS_PROPERTY))
                            (br $exit)
                          )
                        )
                      )
                    )
                  )
                )
                (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (local.get $found) (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            (if (call $throw_type_error_with_type (global.get $BUILTIN_MSG_NOT_AN_OBJECT) (local.get $type1))
              (then (br $exit))
              (else
                (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                (br $loop)
              )
            )
          )
        )

        ;; AND: short-circuit - if left is falsy, keep it and jump; else pop and continue
        (if (i32.eq (local.get $opcode) (global.get $OP_AND))
          (then
            (local.set $value_pointer (call $pending_peek))
            (if (call $is_truthy (local.get $value_pointer))
              (then
                ;; Truthy: pop left (discard), continue to evaluate right
                (drop (call $pending_pop))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
              )
              (else
                ;; Falsy: keep left on stack, jump past right
                (local.set $pc (local.get $operand1))
              )
            )
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; OR: short-circuit - if left is truthy, keep it and jump; else pop and continue
        (if (i32.eq (local.get $opcode) (global.get $OP_OR))
          (then
            (local.set $value_pointer (call $pending_peek))
            (if (call $is_truthy (local.get $value_pointer))
              (then
                ;; Truthy: keep left on stack, jump past right
                (local.set $pc (local.get $operand1))
              )
              (else
                ;; Falsy: pop left (discard), continue to evaluate right
                (drop (call $pending_pop))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
              )
            )
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; NULLISH: short-circuit - if left is nullish, pop and evaluate right; else keep and jump
        (if (i32.eq (local.get $opcode) (global.get $OP_NULLISH))
          (then
            (local.set $value_pointer (call $pending_peek))
            (local.set $type1 (i32.load (local.get $value_pointer)))
            ;; Check if type is NULL (0) or UNDEFINED (1)
            (if (i32.or
                  (i32.eq (local.get $type1) (global.get $TYPE_NULL))
                  (i32.eq (local.get $type1) (global.get $TYPE_UNDEFINED)))
              (then
                ;; Nullish: pop left (discard), continue to evaluate right
                (drop (call $pending_pop))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
              )
              (else
                ;; Not nullish: keep left on stack, jump past right
                (local.set $pc (local.get $operand1))
              )
            )
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; =====================================================================
        ;; CONTROL FLOW
        ;; =====================================================================
        (if (i32.eq (local.get $opcode) (global.get $OP_JUMP))
          (then
            (local.set $pc (local.get $operand1))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        (if (i32.eq (local.get $opcode) (global.get $OP_JUMP_IF_FALSE))
          (then
            (local.set $value_pointer (call $pending_pop))
            (if (call $is_truthy (local.get $value_pointer))
              (then
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
              )
              (else
                (local.set $pc (local.get $operand1))
              )
            )
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        (if (i32.eq (local.get $opcode) (global.get $OP_JUMP_IF_TRUE))
          (then
            (local.set $value_pointer (call $pending_pop))
            (if (call $is_truthy (local.get $value_pointer))
              (then
                (local.set $pc (local.get $operand1))
              )
              (else
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
              )
            )
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; =====================================================================
        ;; OBJECTS/ARRAYS
        ;; =====================================================================

        ;; MAKE_ARRAY: pop N values, create array, push array reference
        ;; operand1 = count
        (if (i32.eq (local.get $opcode) (global.get $OP_MAKE_ARRAY))
          (then
            (local.set $count (local.get $operand1))

            ;; Corrupt-operand tripwire: the literal's elements are ON
            ;; the operand stack, so count can never exceed its depth.
            ;; A corrupt huge count wraps $estimate_array_size's i32
            ;; multiply (defeating the pressure pre-check below) and the
            ;; copy loop then writes across all of linear memory.
            (if (i32.gt_u (local.get $count)
                  (i32.div_u
                    (i32.sub
                      (call $read_ctx (global.get $CTX_PENDING_POINTER))
                      (call $pending_base_seg))
                    (global.get $VALUE_SIZE)))
              (then
                (call $fault_error (global.get $ERR_CORRUPT_OPERAND) (local.get $count) (local.get $pc))
                (br $exit)))

            ;; Pre-check BEFORE the first store: the literal's element
            ;; count sizes this carve, and a large literal can exceed
            ;; the dispatcher's heap-slack headroom in one instruction.
            ;; Nothing has been popped yet, so the pressure retry
            ;; re-enters cleanly after a pressure yield.
            (if (call $check_heap_overflow (call $estimate_array_size (local.get $count)))
              (then
                (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                (br $exit)))

            ;; Header + data block via the array-header chokepoint
            (local.set $heap_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))
            (local.set $array_pointer (local.get $heap_pointer))
            (local.set $data_size (i32.add (global.get $GC_HEADER_SIZE)
                                           (i32.mul (local.get $count) (global.get $VALUE_SIZE))))
            (local.set $data_pointer (call $write_array_header
              (local.get $array_pointer) (local.get $count) (local.get $count) (local.get $data_size)))

            ;; Update heap pointer
            (call $write_state (global.get $STATE_HEAP_POINTER)
              (i32.add (local.get $data_pointer) (local.get $data_size)))

            ;; Pop values in reverse order and copy to data block
            ;; Values are on stack: [first, second, ..., last] with last on top
            ;; We need to pop last first and store at index (count-1)
            (local.set $i (local.get $count))
            (block $pop_done
              (loop $pop_loop
                (br_if $pop_done (i32.eqz (local.get $i)))
                (local.set $i (i32.sub (local.get $i) (i32.const 1)))

                (local.set $value_pointer (call $pending_pop))
                ;; dest = data_pointer + GC_HEADER_SIZE + i * 16
                (local.set $dest (i32.add
                  (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
                  (i32.mul (local.get $i) (global.get $VALUE_SIZE))))

                ;; Copy 16 bytes
                (i32.store (call $abs (local.get $dest))
                  (i32.load (call $abs (local.get $value_pointer))))
                (i32.store (call $abs (i32.add (local.get $dest) (i32.const 4)))
                  (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 4)))))
                (i32.store (call $abs (i32.add (local.get $dest) (i32.const 8)))
                  (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 8)))))
                (i32.store (call $abs (i32.add (local.get $dest) (i32.const 12)))
                  (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 12)))))

                (br $pop_loop)
              )
            )

            ;; Push array reference (type=ARRAY, data_lo=array_pointer)
            (call $pending_push
              (global.get $TYPE_ARRAY)
              (i32.const 0)
              (local.get $array_pointer)
              (i32.const 0))

            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; MAKE_OBJECT: pop N key-value pairs, create object, push object reference
        ;; operand1 = count (number of key-value pairs)
        ;; Stack has: key1, val1, key2, val2, ... with last pair on top
        ;; New layout: Object header (20) + separate entries block
        ;;   Header: [GC:8][count:4][capacity:4][entries_pointer:4]
        ;;   Entries: [GC:8][entries: capacity * 20]
        (if (i32.eq (local.get $opcode) (global.get $OP_MAKE_OBJECT))
          (then
            (local.set $count (local.get $operand1))

            ;; Corrupt-operand tripwire: the literal's key-value pairs
            ;; are ON the operand stack (2 values per pair), so count
            ;; can never exceed half its depth. A corrupt huge count
            ;; wraps $estimate_object_size's i32 multiply (defeating the
            ;; pressure pre-check below) and the entry-write loop then
            ;; writes across all of linear memory.
            (if (i32.gt_u (local.get $count)
                  (i32.div_u
                    (i32.sub
                      (call $read_ctx (global.get $CTX_PENDING_POINTER))
                      (call $pending_base_seg))
                    (i32.mul (global.get $VALUE_SIZE) (i32.const 2))))
              (then
                (call $fault_error (global.get $ERR_CORRUPT_OPERAND) (local.get $count) (local.get $pc))
                (br $exit)))

            ;; Initial capacity: max(count, 4) to allow for growth
            (local.set $arr_cap (local.get $count))
            (if (i32.lt_u (local.get $arr_cap) (i32.const 4))
              (then (local.set $arr_cap (i32.const 4)))
            )

            ;; Pre-check BEFORE the first store — same rationale as
            ;; MAKE_ARRAY above: the pre-check precedes the first store.
            (if (call $check_heap_overflow (call $estimate_object_size (local.get $arr_cap)))
              (then
                (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                (br $exit)))

            (local.set $heap_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))

            ;; Allocate object header: 32 bytes
            (local.set $object_pointer (local.get $heap_pointer))
            (i32.store (call $abs (local.get $object_pointer))
              (i32.or (global.get $OBJECT_HEADER_SIZE) (i32.shl (global.get $OBJ_OBJECT) (i32.const 24))))
            (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 4))) (i32.const 0))

            ;; Allocate entries block: GC header (8) + capacity * ENTRY_SIZE
            (local.set $entries_pointer (i32.add (local.get $object_pointer) (global.get $OBJECT_HEADER_SIZE)))
            (local.set $data_size (i32.add (global.get $GC_HEADER_SIZE)
                                           (i32.mul (local.get $arr_cap) (global.get $ENTRY_SIZE))))
            (i32.store (call $abs (local.get $entries_pointer))
              (i32.or (local.get $data_size) (i32.shl (global.get $OBJ_OBJECT_DATA) (i32.const 24))))
            (i32.store (call $abs (i32.add (local.get $entries_pointer) (i32.const 4))) (i32.const 0))

            ;; Object header: prototype, count, capacity, flags (0), entries_pointer, sym_entries (0)
            (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 8)))
              (call $read_state (global.get $STATE_OBJECT_PROTOTYPE)))
            (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 12))) (local.get $count))
            (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 16))) (local.get $arr_cap))
            (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 20))) (i32.const 0))  ;; flags = 0
            (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 24))) (local.get $entries_pointer))
            (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 28))) (i32.const 0))  ;; sym_entries = 0

            ;; Update heap pointer
            (call $write_state (global.get $STATE_HEAP_POINTER)
              (i32.add (local.get $entries_pointer) (local.get $data_size)))

            ;; Pop key-value pairs in reverse order
            ;; Stack: [key1, val1, key2, val2] with val2 on top
            ;; Entry layout: [key_pointer:4][type:4][flags:4][data_lo:4][data_hi:4]
            (local.set $i (local.get $count))
            (block $obj_pop_done
              (loop $obj_pop_loop
                (br_if $obj_pop_done (i32.eqz (local.get $i)))
                (local.set $i (i32.sub (local.get $i) (i32.const 1)))

                ;; entry_pointer = entries_pointer + 8 (GC header) + i * ENTRY_SIZE
                (local.set $entry_pointer (i32.add
                  (i32.add (local.get $entries_pointer) (global.get $GC_HEADER_SIZE))
                  (i32.mul (local.get $i) (global.get $ENTRY_SIZE))))

                ;; Pop value first (it's on top)
                (local.set $value_pointer (call $pending_pop))

                ;; Pop key (should be a string - get its data_lo which is the string offset)
                (local.set $value_pointer2 (call $pending_pop))
                (local.set $key_offset (call $value_data_lo (local.get $value_pointer2)))

                ;; Write entry: [key][type][flags][data_lo][data_hi]
                (i32.store (call $abs (local.get $entry_pointer)) (local.get $key_offset))
                (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 4)))
                  (call $value_type (local.get $value_pointer)))
                (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 8)))
                  (call $value_flags (local.get $value_pointer)))  ;; preserve value flags (inline rational, etc.)
                (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 12)))
                  (call $value_data_lo (local.get $value_pointer)))
                (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 16)))
                  (call $value_data_hi (local.get $value_pointer)))

                (br $obj_pop_loop)
              )
            )

            ;; Push object reference (type=OBJECT, data_lo=object_pointer)
            (call $pending_push
              (global.get $TYPE_OBJECT)
              (i32.const 0)
              (local.get $object_pointer)
              (i32.const 0))

            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; GET_INDEX: pop index, pop array/object, push element
        (if (i32.eq (local.get $opcode) (global.get $OP_GET_INDEX))
          (then
            ;; ToPropertyKey: a non-string, non-symbol key on an Object/
            ;; Function container coerces to its string form (JS obj[42]
            ;; is obj["42"]; same chokepoint as `"" + key`, so the key
            ;; always matches what String(key) produces). Coerce on the
            ;; un-popped operands so $value_to_string's pending-stack
            ;; scratch writes land above the live slots, and a pressure
            ;; yield retries the whole op without restoring the stack.
            ;; A msgpack MAP ref coerces too — ref[key] is a key lookup,
            ;; same as a real object (array refs keep numeric indexing).
            ;; The peek is inside a REAL branch: WAT i32.and/or evaluate
            ;; both operands, and peeking a non-ref container would
            ;; dereference its data_lo (a float's bit pattern, a string
            ;; id...) as a blob pointer — an out-of-bounds load for
            ;; arbitrary values.
            (local.set $value_pointer (call $pending_peek))
            (local.set $value_pointer2 (i32.sub (local.get $value_pointer) (global.get $VALUE_SIZE)))
            (local.set $type1 (call $value_type (local.get $value_pointer2)))
            (local.set $type2 (call $value_type (local.get $value_pointer)))
            (local.set $coerce_key (i32.const 0))
            (if (i32.or
                  (i32.eq (local.get $type1) (global.get $TYPE_OBJECT))
                  (i32.eq (local.get $type1) (global.get $TYPE_FUNCTION)))
              (then (local.set $coerce_key (i32.const 1))))
            (if (i32.eq (local.get $type1) (global.get $TYPE_MSGPACK_REF))
              (then
                (if (i32.eq
                      (call $msgpack_peek_type
                        (call $msgpack_ref_absolute
                          (call $value_data_lo (local.get $value_pointer2))
                          (call $value_data_hi (local.get $value_pointer2)))
                        (call $msgpack_ref_parent_end
                          (call $value_data_lo (local.get $value_pointer2))))
                      (global.get $MSGPACK_MAP))
                  (then (local.set $coerce_key (i32.const 1))))))
            (if (i32.and
                  (local.get $coerce_key)
                  (i32.and
                    (i32.ne (local.get $type2) (global.get $TYPE_STRING))
                    (i32.ne (local.get $type2) (global.get $TYPE_SYMBOL))))
              (then
                (local.set $key_offset (call $value_to_string (local.get $value_pointer)))
                (if (global.get $memory_pressure_signaled)
                  (then
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)
                  )
                )
                ;; Rewrite the key slot in place as the interned string;
                ;; the string-key branch below dispatches it unchanged.
                (i32.store (call $abs (local.get $value_pointer)) (global.get $TYPE_STRING))
                (i32.store (call $abs (i32.add (local.get $value_pointer) (i32.const 4))) (i32.const 0))
                (i32.store (call $abs (i32.add (local.get $value_pointer) (i32.const 8))) (local.get $key_offset))
                (i32.store (call $abs (i32.add (local.get $value_pointer) (i32.const 12))) (i32.const 0))
              )
            )

            ;; Pop index
            (local.set $value_pointer (call $pending_pop))
            (local.set $type2 (call $value_type (local.get $value_pointer)))

            ;; Pop array/object
            (local.set $value_pointer2 (call $pending_pop))
            (local.set $type1 (call $value_type (local.get $value_pointer2)))
            (local.set $array_pointer (call $value_data_lo (local.get $value_pointer2)))

            ;; Check if array with non-symbol index. Symbol-keyed array access
            ;; (e.g. arr[Symbol.iterator]) is dispatched by the symbol-key
            ;; branch below; falling through here would coerce the symbol to
            ;; NaN, read arr[0], and return a bogus element.
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_ARRAY))
                  (i32.ne (local.get $type2) (global.get $TYPE_SYMBOL)))
              (then
                ;; Array indexing - convert numeric index to i32 (accepts Float/Rational/BigInt)
                (local.set $index (call $f64_index_or_negative (call $value_to_f64 (local.get $value_pointer))))

                ;; Array: get length and bounds check
                (local.set $arr_len (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 8)))))

                (if (i32.ge_u (local.get $index) (local.get $arr_len))
                  (then
                    ;; Out of bounds - push undefined
                    (call $pending_push
                      (global.get $TYPE_UNDEFINED)
                      (i32.const 0)
                      (i32.const 0)
                      (i32.const 0))
                  )
                  (else
                    ;; Get data pointer and element
                    ;; data_pointer points to start of data block (including GC header), add 8 to skip it
                    (local.set $data_pointer (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 16)))))
                    (local.set $element_pointer (i32.add
                      (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
                      (i32.mul (local.get $index) (global.get $VALUE_SIZE))))

                    ;; Push element value
                    (call $pending_push
                      (i32.load (call $abs (local.get $element_pointer)))
                      (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 4))))
                      (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 8))))
                      (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 12)))))
                  )
                )

                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; String indexing with numeric index: str[i] → single-character string
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_STRING))
                  (i32.or
                    (i32.eq (local.get $type2) (global.get $TYPE_FLOAT))
                    (i32.or
                      (i32.eq (local.get $type2) (global.get $TYPE_RATIONAL))
                      (i32.eq (local.get $type2) (global.get $TYPE_BIGINT)))))
              (then
                (local.set $index (call $f64_index_or_negative (call $value_to_f64 (local.get $value_pointer))))

                ;; array_pointer already holds data_lo = string id.
                ;; $index is a code-point index (JS string semantics), not a
                ;; byte index - bounds-check and walk it UTF-8-aware, the
                ;; same way $utf8_char_count/METHOD_CHAR_AT do, instead of
                ;; treating it as a raw byte offset into [length:4][bytes...].
                ;; Bounds check against the code-point count first: unlike
                ;; charAt (which treats index === length as a valid "at end"
                ;; query returning ""), numeric indexing must reject
                ;; index === length as out of bounds, same as array indexing.
                (local.set $arr_len (call $utf8_char_count (local.get $array_pointer)))
                (local.set $obj_size
                  (if (result i32) (i32.ge_u (local.get $index) (local.get $arr_len))
                    (then (i32.const -1))
                    (else (call $utf8_char_to_byte_offset (local.get $array_pointer) (local.get $index)))))

                (if (i32.lt_s (local.get $obj_size) (i32.const 0))
                  (then
                    (call $pending_push
                      (global.get $TYPE_UNDEFINED)
                      (i32.const 0)
                      (i32.const 0)
                      (i32.const 0))
                  )
                  (else
                    ;; Byte width of the code point starting at that offset
                    (local.set $data_pointer (call $string_id_to_seg (local.get $array_pointer)))
                    (local.set $data_size (call $utf8_char_byte_len (local.get $data_pointer) (local.get $obj_size)))

                    ;; Copy the code point's 1-4 UTF-8 bytes into scratch
                    (local.set $element_pointer (call $scratch_ptr (i32.const 0) (i32.const 4)))
                    (local.set $i (i32.const 0))
                    (block $copy_done
                      (loop $copy_loop
                        (br_if $copy_done (i32.ge_u (local.get $i) (local.get $data_size)))
                        (i32.store8
                          (i32.add (local.get $element_pointer) (local.get $i))
                          (i32.load8_u (call $abs (i32.add
                            (i32.add (local.get $data_pointer) (i32.const 4))
                            (i32.add (local.get $obj_size) (local.get $i))))))
                        (local.set $i (i32.add (local.get $i) (i32.const 1)))
                        (br $copy_loop)
                      )
                    )
                    (local.set $element_pointer (call $intern_string (local.get $element_pointer) (local.get $data_size)))

                    ;; Chokepoint: $intern_string self-signals pressure on
                    ;; string-table overflow and returns the sentinel id 0.
                    ;; The operands were already popped at the top of the
                    ;; handler, so restore the pending pointer (the slot
                    ;; contents are untouched by the pops) and yield;
                    ;; retry re-runs this op from a clean stack.
                    (if (global.get $memory_pressure_signaled)
                      (then
                        (call $write_ctx (global.get $CTX_PENDING_POINTER)
                          (i32.add
                            (call $read_ctx (global.get $CTX_PENDING_POINTER))
                            (i32.mul (global.get $VALUE_SIZE) (i32.const 2))))
                        (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                        (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                        (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                        (br $exit)
                      )
                    )

                    (call $pending_push
                      (global.get $TYPE_STRING)
                      (i32.const 0)
                      (local.get $element_pointer)
                      (i32.const 0))
                  )
                )

                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Check if object or function with string key
            (if (i32.and
                  (i32.or
                    (i32.eq (local.get $type1) (global.get $TYPE_OBJECT))
                    (i32.eq (local.get $type1) (global.get $TYPE_FUNCTION)))
                  (i32.eq (local.get $type2) (global.get $TYPE_STRING)))
              (then
                ;; Object/Function property lookup by string key
                (local.set $object_pointer (local.get $array_pointer))
                (local.set $key_offset (call $value_data_lo (local.get $value_pointer)))

                ;; Object/Function layout: [GC:8][prototype:4][count:4][capacity:4][entries_pointer:4]
                ;; Walk prototype chain looking for property
                (local.set $current_obj (local.get $object_pointer))
                (local.set $proto_depth (i32.const 0))
                (local.set $found (i32.const 0))

                (block $idx_prop_search_done
                  (loop $idx_proto_loop
                    ;; Stop if null prototype or depth limit reached
                    (br_if $idx_prop_search_done (i32.eqz (local.get $current_obj)))
                    (br_if $idx_prop_search_done (i32.ge_u (local.get $proto_depth) (global.get $MAX_PROTO_DEPTH)))

                    ;; Get count and entries from current object
                    (local.set $obj_count (i32.load (call $abs (i32.add (local.get $current_obj) (i32.const 12)))))
                    (local.set $entries_pointer (i32.load (call $abs (i32.add (local.get $current_obj) (i32.const 24)))))

                    ;; Linear search for property in current object
                    (local.set $i (i32.const 0))
                    (block $idx_check_next_proto
                      (loop $idx_prop_loop
                        (br_if $idx_check_next_proto (i32.ge_u (local.get $i) (local.get $obj_count)))

                        ;; entry_pointer = entries_pointer + 8 (GC header) + i * ENTRY_SIZE
                        (local.set $entry_pointer (i32.add
                          (i32.add (local.get $entries_pointer) (global.get $GC_HEADER_SIZE))
                          (i32.mul (local.get $i) (global.get $ENTRY_SIZE))))

                        (local.set $prop_key (i32.load (call $abs (local.get $entry_pointer))))

                        (if (i32.eq (local.get $prop_key) (local.get $key_offset))
                          (then
                            ;; Accessor property: invoke the getter (see
                            ;; GET_PROP's twin block for the mechanics; both
                            ;; operands are already popped, so the result
                            ;; lands at the receiver's slot).
                            (if (i32.eq
                                  (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 4))))
                                  (global.get $TYPE_ACCESSOR))
                              (then
                                (local.set $closure_pointer
                                  (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 12)))))
                                (if (i32.eqz (local.get $closure_pointer))
                                  (then
                                    (call $pending_push (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))
                                    (local.set $found (i32.const 1))
                                    (br $idx_prop_search_done)
                                  )
                                )
                                (local.set $stack_pointer (call $read_ctx (global.get $CTX_CALL_STACK_POINTER)))
                                (local.set $frame_pointer (call $abs (local.get $stack_pointer)))
                                (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_INSTRUCTION_INDEX))
                                  (i32.add (local.get $pc) (i32.const 1)))
                                (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_SCOPE_POINTER))
                                  (global.get $current_scope))
                                (call $save_frame_pending_base (local.get $frame_pointer)
                                  (call $read_ctx (global.get $CTX_PENDING_POINTER)))
                                (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_PENDING_COUNT)) (i32.const 1))
                                (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_FLAGS)) (i32.const 0))
                                (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_AST_NODE)) (i32.const 0))
                                (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_ASYNC_PROMISE)) (i32.const 0))
                                (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_ARGC)) (i32.const 0))
                                (call $write_ctx (global.get $CTX_CALL_STACK_POINTER)
                                  (i32.add (local.get $stack_pointer) (global.get $FRAME_SIZE)))
                                (local.set $new_scope (call $scope_create
                                  (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 40))))))
                                (global.set $current_scope (local.get $new_scope))
                                (call $scope_define
                                  (local.get $new_scope)
                                  (call $read_builtin (i32.const 0x18))   ;; BUILTIN_NAME.THIS
                                  (local.get $type1) (i32.const 0)
                                  (local.get $object_pointer) (i32.const 0))
                                (call $scope_define_new_target (local.get $new_scope)
                                  (global.get $TYPE_UNDEFINED) (i32.const 0))
                                (local.set $pc (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 32)))))
                                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                                (br $loop)
                              )
                            )
                            ;; Found! Push the value
                            (call $pending_push
                              (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 4))))   ;; type
                              (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 8))))   ;; flags
                              (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 12))))  ;; data_lo
                              (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 16))))) ;; data_hi
                            (local.set $found (i32.const 1))
                            (br $idx_prop_search_done)
                          )
                        )

                        (local.set $i (i32.add (local.get $i) (i32.const 1)))
                        (br $idx_prop_loop)
                      )
                    )

                    ;; Not found in current object, move to prototype
                    (local.set $current_obj (i32.load (call $abs (i32.add (local.get $current_obj) (i32.const 8)))))
                    (local.set $proto_depth (i32.add (local.get $proto_depth) (i32.const 1)))
                    (br $idx_proto_loop)
                  )
                )

                ;; If not found after walking chain, push undefined
                (if (i32.eqz (local.get $found))
                  (then
                    (call $pending_push
                      (global.get $TYPE_UNDEFINED)
                      (i32.const 0)
                      (i32.const 0)
                      (i32.const 0))
                  )
                )

                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Symbol-keyed lookup. Object/Function walk their own prototype
            ;; chain starting from the receiver itself. Primitive receivers
            ;; (Array, typed arrays, Map, Set) consult their own sym-entries
            ;; slot first, then fall back to their STATE-resident prototype
            ;; object (String has no own slot — prototype only). The
            ;; receiver's identity is preserved so that a found BOUND_METHOD
            ;; can be rebound to the original primitive before being
            ;; returned (so the subsequent CALL_METHOD sees receiver = the
            ;; array/string, not the prototype).
            (if (i32.and
                  (i32.or
                    (i32.or
                      (i32.or
                        (i32.eq (local.get $type1) (global.get $TYPE_OBJECT))
                        (i32.eq (local.get $type1) (global.get $TYPE_FUNCTION)))
                      (i32.or
                        (i32.eq (local.get $type1) (global.get $TYPE_MAP))
                        (i32.eq (local.get $type1) (global.get $TYPE_SET))))
                    (i32.or
                      (i32.or
                        (i32.eq (local.get $type1) (global.get $TYPE_ARRAY))
                        (i32.eq (local.get $type1) (global.get $TYPE_STRING)))
                      (call $is_typed_array (local.get $type1))))
                  (i32.eq (local.get $type2) (global.get $TYPE_SYMBOL)))
              (then
                (local.set $object_pointer (local.get $array_pointer))
                (local.set $key_offset (call $value_data_lo (local.get $value_pointer)))

                ;; Own symbol-keyed properties first for primitive receivers.
                ;; Object/Function own entries are covered by the prototype
                ;; walk below, which starts at the receiver itself.
                (if (i32.and
                      (i32.ne (local.get $type1) (global.get $TYPE_OBJECT))
                      (i32.ne (local.get $type1) (global.get $TYPE_FUNCTION)))
                  (then
                    (local.set $entry_pointer (call $sym_slot_addr (local.get $type1) (local.get $object_pointer)))
                    (if (i32.ne (local.get $entry_pointer) (i32.const 0))
                      (then
                        (local.set $entry_pointer (call $sym_block_find
                          (i32.load (call $abs (local.get $entry_pointer)))
                          (local.get $key_offset)))
                        (if (i32.ne (local.get $entry_pointer) (i32.const 0))
                          (then
                            ;; Found an own entry. Rebind a BOUND_METHOD to
                            ;; the receiver, same rule as the prototype walk
                            ;; below for typed-primitive receivers.
                            (local.set $type3 (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 4)))))
                            (if (i32.eq (local.get $type3) (global.get $TYPE_BOUND_METHOD))
                              (then
                                (call $pending_push
                                  (global.get $TYPE_BOUND_METHOD)
                                  (local.get $type1)
                                  (local.get $object_pointer)
                                  (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 16)))))
                              )
                              (else
                                (call $pending_push
                                  (local.get $type3)
                                  (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 8))))
                                  (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 12))))
                                  (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 16)))))
                              )
                            )
                            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                            (br $loop)
                          )
                        )
                      )
                    )
                  )
                )

                ;; Pick the starting node for the prototype walk.
                (if (i32.or
                      (i32.eq (local.get $type1) (global.get $TYPE_OBJECT))
                      (i32.eq (local.get $type1) (global.get $TYPE_FUNCTION)))
                  (then (local.set $current_obj (local.get $object_pointer)))
                  (else
                    (if (i32.eq (local.get $type1) (global.get $TYPE_ARRAY))
                      (then (local.set $current_obj (call $read_state (global.get $STATE_ARRAY_PROTOTYPE))))
                      (else
                        (if (i32.eq (local.get $type1) (global.get $TYPE_STRING))
                          (then (local.set $current_obj (call $read_state (global.get $STATE_STRING_PROTOTYPE))))
                          (else
                            (if (i32.eq (local.get $type1) (global.get $TYPE_MAP))
                              (then (local.set $current_obj (call $read_state (global.get $STATE_MAP_PROTOTYPE))))
                              (else
                                (if (i32.eq (local.get $type1) (global.get $TYPE_SET))
                                  (then (local.set $current_obj (call $read_state (global.get $STATE_SET_PROTOTYPE))))
                                  (else
                                    ;; Typed array: shared prototype.
                                    (local.set $current_obj (call $read_state (global.get $STATE_UINT8ARRAY_PROTOTYPE)))
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )

                (local.set $proto_depth (i32.const 0))
                (local.set $found (i32.const 0))

                (block $idx_sym_search_done
                  (loop $idx_sym_proto_loop
                    (br_if $idx_sym_search_done (i32.eqz (local.get $current_obj)))
                    (br_if $idx_sym_search_done (i32.ge_u (local.get $proto_depth) (global.get $MAX_PROTO_DEPTH)))

                    ;; Read sym-entries pointer from object header at +28.
                    (local.set $entries_pointer (i32.load (call $abs (i32.add (local.get $current_obj) (global.get $OBJECT_SYM_ENTRIES_OFFSET)))))

                    (if (i32.ne (local.get $entries_pointer) (i32.const 0))
                      (then
                        (local.set $obj_count (i32.load (call $abs (i32.add (local.get $entries_pointer) (global.get $GC_HEADER_SIZE)))))
                        (local.set $i (i32.const 0))
                        (block $idx_sym_check_next_proto
                          (loop $idx_sym_prop_loop
                            (br_if $idx_sym_check_next_proto (i32.ge_u (local.get $i) (local.get $obj_count)))

                            (local.set $entry_pointer (i32.add
                              (i32.add (local.get $entries_pointer) (i32.const 16))
                              (i32.mul (local.get $i) (global.get $ENTRY_SIZE))))

                            (local.set $prop_key (i32.load (call $abs (local.get $entry_pointer))))

                            (if (i32.eq (local.get $prop_key) (local.get $key_offset))
                              (then
                                ;; If the stored value is a BOUND_METHOD, rebind it
                                ;; to the receiver of the lookup so the subsequent
                                ;; CALL_METHOD sees the right `this` — but only for
                                ;; typed-primitive receivers (Map/Set/Array/etc.)
                                ;; where the prototype walk started from a STATE
                                ;; prototype rather than the value itself. When the
                                ;; receiver IS an Object/Function (prototype access
                                ;; like `Map.prototype[Symbol.iterator]`), push the
                                ;; stored entry verbatim so identity matches the
                                ;; string-key GET_PROP path on the same prototype.
                                (local.set $type3 (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 4)))))
                                (if (i32.and
                                      (i32.eq (local.get $type3) (global.get $TYPE_BOUND_METHOD))
                                      (i32.and
                                        (i32.ne (local.get $type1) (global.get $TYPE_OBJECT))
                                        (i32.ne (local.get $type1) (global.get $TYPE_FUNCTION))))
                                  (then
                                    (call $pending_push
                                      (global.get $TYPE_BOUND_METHOD)
                                      (local.get $type1)                  ;; flags = receiver type
                                      (local.get $object_pointer)         ;; data_lo = original receiver
                                      (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 16)))))  ;; method id
                                  )
                                  (else
                                    (call $pending_push
                                      (local.get $type3)
                                      (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 8))))
                                      (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 12))))
                                      (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 16)))))
                                  )
                                )
                                (local.set $found (i32.const 1))
                                (br $idx_sym_search_done)
                              )
                            )

                            (local.set $i (i32.add (local.get $i) (i32.const 1)))
                            (br $idx_sym_prop_loop)
                          )
                        )
                      )
                    )

                    ;; Not found in current object; move to prototype.
                    (local.set $current_obj (i32.load (call $abs (i32.add (local.get $current_obj) (i32.const 8)))))
                    (local.set $proto_depth (i32.add (local.get $proto_depth) (i32.const 1)))
                    (br $idx_sym_proto_loop)
                  )
                )

                (if (i32.eqz (local.get $found))
                  (then
                    (call $pending_push
                      (global.get $TYPE_UNDEFINED)
                      (i32.const 0)
                      (i32.const 0)
                      (i32.const 0))
                  )
                )

                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Check if typed array with non-symbol index. As with TYPE_ARRAY
            ;; above, symbol-keyed access falls through to the symbol-key
            ;; branch (handled there via the shared UINT8ARRAY_PROTOTYPE).
            (if (i32.and
                  (call $is_typed_array (local.get $type1))
                  (i32.ne (local.get $type2) (global.get $TYPE_SYMBOL)))
              (then
                ;; TypedArray value: [TYPE_*ARRAY][0][descriptorPtr][0]
                ;; Descriptor: [bufferPtr:4][byteOffset:4][length:4]
                ;; value_pointer2 = the typed array value
                ;; value_pointer = the index value
                (local.set $element_pointer (call $value_data_lo (local.get $value_pointer2)))  ;; descriptorPtr
                (local.set $data_pointer (i32.load (call $abs (local.get $element_pointer))))   ;; bufferPtr
                (local.set $arr_cap (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 4)))))  ;; byteOffset
                (local.set $arr_len (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 8)))))  ;; length in elements

                ;; Get BYTES_PER_ELEMENT for this type
                (local.set $result_lo (call $get_bytes_per_element (local.get $type1)))

                ;; Convert index to i32
                (local.set $index (call $f64_index_or_negative (call $value_to_f64 (local.get $value_pointer))))

                ;; Bounds check: index must be >= 0 and < length
                (if (i32.or
                      (i32.lt_s (local.get $index) (i32.const 0))
                      (i32.ge_u (local.get $index) (local.get $arr_len)))
                  (then
                    ;; Out of bounds - return undefined
                    (call $pending_push
                      (global.get $TYPE_UNDEFINED)
                      (i32.const 0)
                      (i32.const 0)
                      (i32.const 0))
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )

                ;; Calculate byte address:
                ;; ArrayBuffer layout: [GC:8][byteLength:4][bytes...]
                ;; bufferPtr points after GC header, bytes start at bufferPtr + 4
                ;; Byte address = bufferPtr + 4 + byteOffset + (index * BYTES_PER_ELEMENT)
                (local.set $element_pointer (call $abs (i32.add
                  (i32.add
                    (i32.add (local.get $data_pointer) (i32.const 4))
                    (local.get $arr_cap))
                  (i32.mul (local.get $index) (local.get $result_lo)))))

                ;; BigInt64Array/BigUint64Array: read i64, create BigInt.
                ;; $bigint_alloc allocates blindly — pre-check the worst-case
                ;; 2-limb budget; on refusal restore the two popped operands
                ;; and pressure-yield so the retry re-runs this op.
                (if (i32.or
                      (i32.eq (local.get $type1) (global.get $TYPE_BIGINT64ARRAY))
                      (i32.eq (local.get $type1) (global.get $TYPE_BIGUINT64ARRAY)))
                  (then
                    (if (call $check_heap_overflow (call $estimate_bigint_size (i32.const 2)))
                      (then
                        (call $write_ctx (global.get $CTX_PENDING_POINTER)
                          (i32.add
                            (call $read_ctx (global.get $CTX_PENDING_POINTER))
                            (i32.mul (global.get $VALUE_SIZE) (i32.const 2))))
                        (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                        (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                        (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                        (br $exit)
                      )
                    )
                    (call $push_bigint
                      (call $bigint_from_typed_i64 (local.get $type1) (local.get $element_pointer)))
                  )
                  (else
                    ;; Float32/Float64 typed arrays → Float; integer typed arrays
                    ;; (Int8/Uint8/Uint8Clamped/Int16/Uint16/Int32/Uint32) → inline
                    ;; Rational so values compare exactly against integer literals.
                    (if (i32.or
                          (i32.eq (local.get $type1) (global.get $TYPE_FLOAT32ARRAY))
                          (i32.eq (local.get $type1) (global.get $TYPE_FLOAT64ARRAY)))
                      (then
                        (call $push_f64 (call $read_typed_element (local.get $type1) (local.get $element_pointer)))
                      )
                      (else
                        (call $push_rational_inline
                          (i64.trunc_sat_f64_s
                            (call $read_typed_element (local.get $type1) (local.get $element_pointer))))
                      )
                    )
                  )
                )

                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Check if TYPE_MSGPACK_REF (read-only msgpack container)
            (if (i32.eq (local.get $type1) (global.get $TYPE_MSGPACK_REF))
              (then
                ;; Layout A: array_pointer = parent_data_ptr, data_hi = offset
                (local.set $data1_hi (call $value_data_hi (local.get $value_pointer2)))
                (local.set $mp_addr (call $msgpack_ref_absolute (local.get $array_pointer) (local.get $data1_hi)))
                (local.set $mp_end (call $msgpack_ref_parent_end (local.get $array_pointer)))

                ;; Route by the ref's own container type: a MAP ref
                ;; treats ref[key] as a key lookup (obj[k] == obj.k —
                ;; the key was string-coerced by the ToPropertyKey block
                ;; above; jsonSafe-style walks over Object.keys read
                ;; through exactly this path and used to get undefined
                ;; for every key). An ARRAY ref keeps numeric indexing.
                (if (i32.eq (call $msgpack_peek_type (local.get $mp_addr) (local.get $mp_end))
                            (global.get $MSGPACK_MAP))
                  (then
                    (if (i32.eq (local.get $type2) (global.get $TYPE_STRING))
                      (then
                        (local.set $found (call $msgpack_map_get
                          (local.get $mp_addr) (local.get $mp_end)
                          (call $value_data_lo (local.get $value_pointer))))
                      )
                      (else
                        ;; Symbol key: msgpack maps have no symbol
                        ;; entries — not found.
                        (local.set $found (i32.const -1))
                      )
                    )
                  )
                  (else
                    ;; Convert index to i32
                    (local.set $index (call $f64_index_or_negative (call $value_to_f64 (local.get $value_pointer))))
                    ;; Use msgpack_array_get to find the element
                    (local.set $found (call $msgpack_array_get (local.get $mp_addr) (local.get $mp_end) (local.get $index)))
                  )
                )

                (if (i32.eq (local.get $found) (i32.const -1))
                  (then
                    ;; Not found / out of bounds / not indexable - push undefined
                    (call $pending_push
                      (global.get $TYPE_UNDEFINED)
                      (i32.const 0)
                      (i32.const 0)
                      (i32.const 0))
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )

                ;; found = address of element
                ;; Peek the element type
                (local.set $mp_type (call $msgpack_peek_type (local.get $found) (local.get $mp_end)))
                (if (i32.eq (local.get $mp_type) (global.get $MSGPACK_ERROR))
                  (then
                    (if (call $raise_error (global.get $ERR_MSGPACK_INVALID) (i32.const 20))
                      (then (br $exit)))
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)
                  )
                )

                ;; For direct types (incl. bin → Uint8Array), read directly
                (if (call $msgpack_is_direct_type (local.get $mp_type))
                  (then
                    (if (i32.eq (call $msgpack_read_primitive (local.get $found) (local.get $mp_end))
                                (i32.const -1))
                      (then
                        ;; -1 with the pressure flag = refused allocation:
                        ;; un-consume the two popped operands (their bytes
                        ;; are untouched above the pointer) and yield so
                        ;; the retry re-executes this GET_INDEX. -1 with
                        ;; the flag clear = malformed input.
                        (if (global.get $memory_pressure_signaled)
                          (then
                            (call $write_ctx (global.get $CTX_PENDING_POINTER)
                              (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE)))
                            (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                            (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                            (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                            (br $exit)
                          )
                        )
                        (if (call $raise_error (global.get $ERR_MSGPACK_INVALID) (i32.const 21))
                          (then (br $exit)))
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop)
                      )
                    )
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )

                ;; For containers (array/map), return new TYPE_MSGPACK_REF
                ;; Layout A: data_lo = parent_data_ptr, data_hi = offset of found
                (call $pending_push
                  (global.get $TYPE_MSGPACK_REF)
                  (i32.const 0)
                  (local.get $array_pointer)
                  (call $msgpack_ref_offset_of (local.get $found) (local.get $array_pointer)))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Check for null/undefined - these should throw TypeError
            (if (i32.or
                  (i32.eq (local.get $type1) (global.get $TYPE_NULL))
                  (i32.eq (local.get $type1) (global.get $TYPE_UNDEFINED)))
              (then
                (if (call $throw_type_error_with_type
                  (if (result i32) (i32.eq (local.get $type1) (global.get $TYPE_NULL))
                    (then (global.get $BUILTIN_MSG_PROPERTY_OF_NULL))
                    (else (global.get $BUILTIN_MSG_PROPERTY_OF_UNDEFINED)))
                  (local.get $type1))
                  (then (br $exit))
                  (else
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)
                  )
                )
              )
            )

            ;; Symbol-keyed access on a primitive without a wired prototype
            ;; (e.g. 42[Symbol.iterator]): return undefined, matching JS for
            ;; primitives whose prototype doesn't carry the key. Subsequent
            ;; CALL_METHOD on undefined will produce the proper catchable
            ;; "Not a function" TypeError. Without this branch, the fall-
            ;; through ERR_INVALID_OPERAND below escapes as an uncatchable
            ;; error and surface code like `let [a] = 42` or `for (x of 42)`
            ;; can't be wrapped in try/catch.
            (if (i32.eq (local.get $type2) (global.get $TYPE_SYMBOL))
              (then
                (call $pending_push
                  (global.get $TYPE_UNDEFINED) (i32.const 0)
                  (i32.const 0) (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Not an array or object[string] or msgpack - error
            (if (call $raise_error (global.get $ERR_INVALID_OPERAND) (local.get $type1))
              (then (br $exit)))
            (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
            (br $loop)
          )
        )

        ;; SET_INDEX: pop value, pop index, pop container, set container[index] = value, push value
        ;; Handles both arrays (numeric index) and objects (string index)
        (if (i32.eq (local.get $opcode) (global.get $OP_SET_INDEX))
          (then
            ;; Capture pending_pointer BEFORE the pops so any pressure
            ;; yield in the body can restore the pre-pop stack state for
            ;; a clean retry.
            (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))

            ;; ToPropertyKey: a non-string, non-symbol key on an Object/
            ;; Function container coerces to its string form (JS
            ;; obj[42] = v is obj["42"] = v). Mirrors the GET_INDEX
            ;; coercion above: done on the un-popped operands so a
            ;; pressure yield retries cleanly. Stack pre-pop:
            ;; value (top), index, container.
            (local.set $value_pointer2 (i32.sub (local.get $pending_pointer) (i32.mul (global.get $VALUE_SIZE) (i32.const 2))))
            (local.set $type1 (call $value_type (i32.sub (local.get $pending_pointer) (i32.mul (global.get $VALUE_SIZE) (i32.const 3)))))
            (local.set $type2 (call $value_type (local.get $value_pointer2)))
            (if (i32.and
                  (i32.or
                    (i32.eq (local.get $type1) (global.get $TYPE_OBJECT))
                    (i32.eq (local.get $type1) (global.get $TYPE_FUNCTION)))
                  (i32.and
                    (i32.ne (local.get $type2) (global.get $TYPE_STRING))
                    (i32.ne (local.get $type2) (global.get $TYPE_SYMBOL))))
              (then
                (local.set $key_offset (call $value_to_string (local.get $value_pointer2)))
                (if (global.get $memory_pressure_signaled)
                  (then
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)
                  )
                )
                ;; Rewrite the key slot in place as the interned string;
                ;; the string-key branch below dispatches it unchanged.
                (i32.store (call $abs (local.get $value_pointer2)) (global.get $TYPE_STRING))
                (i32.store (call $abs (i32.add (local.get $value_pointer2) (i32.const 4))) (i32.const 0))
                (i32.store (call $abs (i32.add (local.get $value_pointer2) (i32.const 8))) (local.get $key_offset))
                (i32.store (call $abs (i32.add (local.get $value_pointer2) (i32.const 12))) (i32.const 0))
              )
            )

            ;; Pop value to store
            (local.set $value_pointer (call $pending_pop))
            (local.set $set_val_type (i32.load (call $abs (local.get $value_pointer))))
            (local.set $set_val_flags (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 4)))))
            (local.set $set_val_lo (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 8)))))
            (local.set $set_val_hi (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 12)))))

            ;; Pop index
            (local.set $value_pointer2 (call $pending_pop))
            (local.set $type2 (call $value_type (local.get $value_pointer2)))

            ;; Pop container
            (local.set $value_pointer (call $pending_pop))
            (local.set $type1 (call $value_type (local.get $value_pointer)))

            ;; Check if msgpack ref (read-only, cannot assign)
            (if (i32.eq (local.get $type1) (global.get $TYPE_MSGPACK_REF))
              (then
                (if (call $raise_error (global.get $ERR_MSGPACK_READONLY) (local.get $type1))
                  (then (br $exit)))
                (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                (br $loop)
              )
            )

            ;; Symbol-keyed write on any receiver with own symbol storage
            ;; (Object/Function/Array/typed arrays/Map/Set). Symbols pass
            ;; through ToPropertyKey unchanged and must NEVER reach the
            ;; numeric element paths below — before this branch existed,
            ;; arr[sym] = v coerced the symbol to index 0 and silently
            ;; clobbered arr[0]. Receivers without own storage (strings,
            ;; plain primitives) fall through to the branches below.
            (if (i32.eq (local.get $type2) (global.get $TYPE_SYMBOL))
              (then
                (local.set $key_offset (call $value_data_lo (local.get $value_pointer2)))   ;; symbol header ptr
                (local.set $object_pointer (call $value_data_lo (local.get $value_pointer)))
                (local.set $entry_pointer (call $sym_slot_addr (local.get $type1) (local.get $object_pointer)))
                (if (i32.ne (local.get $entry_pointer) (i32.const 0))
                  (then
                    ;; Frozen check for the freezable receivers. Object,
                    ;; Function and Array all keep their flags word at
                    ;; header +20 with the frozen bit at 0x01.
                    (if (i32.or
                          (i32.or
                            (i32.eq (local.get $type1) (global.get $TYPE_OBJECT))
                            (i32.eq (local.get $type1) (global.get $TYPE_FUNCTION)))
                          (i32.eq (local.get $type1) (global.get $TYPE_ARRAY)))
                      (then
                        (if (i32.and
                              (i32.load (call $abs (i32.add (local.get $object_pointer) (i32.const 0x14))))
                              (global.get $OBJECT_FLAG_FROZEN))
                          (then
                            (if (call $throw_type_error_with_type (global.get $BUILTIN_MSG_FROZEN_OBJECT) (i32.const 0))
                              (then (br $exit))
                              (else
                                (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                                (br $loop)
                              )
                            )
                          )
                        )
                      )
                    )

                    (if (call $sym_block_set
                          (local.get $entry_pointer) (local.get $key_offset)
                          (local.get $set_val_type) (local.get $set_val_flags)
                          (local.get $set_val_lo) (local.get $set_val_hi))
                      (then
                        ;; Heap pressure: restore the three popped operands
                        ;; (pointer-only — the slots are untouched) and
                        ;; yield; retry re-runs this op cleanly.
                        (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $pending_pointer))
                        (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                        (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                        (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                        (br $exit)
                      )
                    )

                    ;; Push value back (assignment is an expression).
                    (call $pending_push
                      (local.get $set_val_type)
                      (local.get $set_val_flags)
                      (local.get $set_val_lo)
                      (local.get $set_val_hi))
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )
              )
            )

            ;; Check if typed array (any typed array indexed assignment)
            (if (call $is_typed_array (local.get $type1))
              (then
                ;; TypedArray value: [TYPE_*ARRAY][0][descriptorPtr][0]
                ;; Descriptor: [bufferPtr:4][byteOffset:4][length:4]
                (local.set $element_pointer (call $value_data_lo (local.get $value_pointer)))  ;; descriptorPtr
                (local.set $data_pointer (i32.load (call $abs (local.get $element_pointer))))   ;; bufferPtr
                (local.set $arr_cap (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 4)))))  ;; byteOffset
                (local.set $arr_len (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 8)))))  ;; length in elements

                ;; Get BYTES_PER_ELEMENT for this type
                (local.set $result_hi (call $get_bytes_per_element (local.get $type1)))

                ;; Convert index to i32
                (local.set $index (call $f64_index_or_negative (call $value_to_f64 (local.get $value_pointer2))))

                ;; Bounds check: index must be >= 0 and < length
                (if (i32.or
                      (i32.lt_s (local.get $index) (i32.const 0))
                      (i32.ge_u (local.get $index) (local.get $arr_len)))
                  (then
                    ;; Out of bounds - silently ignore (JS semantics)
                    ;; Push the value back as the result of assignment
                    (call $pending_push
                      (local.get $set_val_type)
                      (local.get $set_val_flags)
                      (local.get $set_val_lo)
                      (local.get $set_val_hi))
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )

                ;; Convert value to f64 for writing — accept any numeric type.
                ;; Uses set_val_{type,flags,lo,hi} captured at pop time since
                ;; the original value pointer was overwritten by the container pop.
                (if (i32.eq (local.get $set_val_type) (global.get $TYPE_INTEGER))
                  (then
                    (local.set $float_result (f64.convert_i32_s (local.get $set_val_lo)))
                  )
                  (else (if (i32.eq (local.get $set_val_type) (global.get $TYPE_FLOAT))
                    (then
                      (local.set $float_result
                        (f64.reinterpret_i64
                          (i64.or
                            (i64.extend_i32_u (local.get $set_val_lo))
                            (i64.shl (i64.extend_i32_u (local.get $set_val_hi)) (i64.const 32)))))
                    )
                    (else (if (i32.eq (local.get $set_val_type) (global.get $TYPE_RATIONAL))
                      (then
                        (if (i32.and (local.get $set_val_flags) (global.get $FLAG_RATIONAL_INLINE))
                          (then
                            ;; Inline: i64 numerator reconstructed from lo/hi
                            (local.set $float_result
                              (f64.convert_i64_s
                                (i64.or
                                  (i64.extend_i32_u (local.get $set_val_lo))
                                  (i64.shl (i64.extend_i32_u (local.get $set_val_hi)) (i64.const 32)))))
                          )
                          (else
                            ;; Heap Rational: set_val_lo is the header pointer
                            (local.set $float_result
                              (f64.div
                                (call $bigint_to_f64 (call $rational_numerator (local.get $set_val_lo)))
                                (call $bigint_to_f64 (call $rational_denominator (local.get $set_val_lo)))))
                          )
                        )
                      )
                      (else (if (i32.eq (local.get $set_val_type) (global.get $TYPE_BIGINT))
                        (then
                          (local.set $float_result (call $bigint_to_f64 (local.get $set_val_lo)))
                        )
                        (else
                          ;; Non-numeric - use 0
                          (local.set $float_result (f64.const 0))
                        )
                      ))
                    ))
                  ))
                )

                ;; Calculate byte address:
                ;; bufferPtr points after GC header, bytes start at bufferPtr + 4
                ;; Byte address = bufferPtr + 4 + byteOffset + (index * BYTES_PER_ELEMENT)
                (local.set $element_pointer (call $abs (i32.add
                  (i32.add
                    (i32.add (local.get $data_pointer) (i32.const 4))
                    (local.get $arr_cap))
                  (i32.mul (local.get $index) (local.get $result_hi)))))

                ;; BigInt64Array/BigUint64Array: write i64 from BigInt value
                (if (i32.or
                      (i32.eq (local.get $type1) (global.get $TYPE_BIGINT64ARRAY))
                      (i32.eq (local.get $type1) (global.get $TYPE_BIGUINT64ARRAY)))
                  (then
                    ;; Value must be BigInt type
                    (if (i32.eq (local.get $set_val_type) (global.get $TYPE_BIGINT))
                      (then
                        ;; set_val_lo = header pointer
                        (i64.store (local.get $element_pointer)
                          (call $bigint_to_typed_i64 (local.get $type1) (local.get $set_val_lo)))
                      )
                      (else
                        ;; Non-BigInt value → TypeError (should be, but for now write 0)
                        (i64.store (local.get $element_pointer) (i64.const 0))
                      )
                    )
                  )
                  (else
                    ;; Write element using type-specific helper
                    (call $write_typed_element (local.get $type1) (local.get $element_pointer) (local.get $float_result))
                  )
                )

                ;; Push the original value back as result
                (call $pending_push
                  (local.get $set_val_type)
                  (local.get $set_val_flags)
                  (local.get $set_val_lo)
                  (local.get $set_val_hi))

                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Branch based on container type and index type
            (if (i32.and
                  (i32.or
                    (i32.eq (local.get $type1) (global.get $TYPE_OBJECT))
                    (i32.eq (local.get $type1) (global.get $TYPE_FUNCTION)))
                  (i32.eq (local.get $type2) (global.get $TYPE_STRING)))
              (then
                ;; Object/Function with string key - same logic as SET_PROP
                (local.set $object_pointer (call $value_data_lo (local.get $value_pointer)))
                (local.set $key_offset (call $value_data_lo (local.get $value_pointer2)))

                ;; Check if object is frozen (flags at offset 0x14)
                (if (i32.and
                      (i32.load (call $abs (i32.add (local.get $object_pointer) (i32.const 0x14))))
                      (global.get $OBJECT_FLAG_FROZEN))
                  (then
                    (if (call $throw_type_error_with_type (global.get $BUILTIN_MSG_FROZEN_OBJECT) (i32.const 0))
                      (then (br $exit))
                      (else
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop)
                      )
                    )
                  )
                )

                ;; Object/Function layout: [GC:8][prototype:4][count:4][capacity:4][flags:4][entries:4]
                (local.set $obj_count (i32.load (call $abs (i32.add (local.get $object_pointer) (i32.const 12)))))
                (local.set $obj_cap (i32.load (call $abs (i32.add (local.get $object_pointer) (i32.const 16)))))
                (local.set $entries_pointer (i32.load (call $abs (i32.add (local.get $object_pointer) (i32.const 24)))))

                ;; Search for existing property
                (local.set $i (i32.const 0))
                (local.set $found (i32.const 0))
                (block $idx_prop_set_found
                  (loop $idx_prop_set_loop
                    (br_if $idx_prop_set_found (i32.ge_u (local.get $i) (local.get $obj_count)))

                    ;; entry_pointer = entries_pointer + 8 + i * ENTRY_SIZE
                    (local.set $entry_pointer (i32.add
                      (i32.add (local.get $entries_pointer) (global.get $GC_HEADER_SIZE))
                      (i32.mul (local.get $i) (global.get $ENTRY_SIZE))))

                    (local.set $prop_key (i32.load (call $abs (local.get $entry_pointer))))

                    (if (i32.eq (local.get $prop_key) (local.get $key_offset))
                      (then
                        (if (i32.eq
                              (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 4))))
                              (global.get $TYPE_ACCESSOR))
                          (then
                            ;; Accessor definition over an accessor: merge
                            ;; halves. This is also the path object-literal
                            ;; accessors take (builder mode SET_INDEX), so a
                            ;; get/set pair for one key lands as one entry.
                            (if (i32.eq (local.get $set_val_type) (global.get $TYPE_ACCESSOR))
                              (then
                                (if (i32.ne (local.get $set_val_lo) (i32.const 0))
                                  (then (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 12))) (local.get $set_val_lo))))
                                (if (i32.ne (local.get $set_val_hi) (i32.const 0))
                                  (then (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 16))) (local.get $set_val_hi))))
                                (local.set $found (i32.const 1))
                                (br $idx_prop_set_found)
                              )
                            )
                            ;; Plain assignment onto an accessor property:
                            ;; invoke the setter (see SET_PROP's twin block
                            ;; for the full mechanics).
                            (local.set $closure_pointer
                              (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 16)))))
                            (call $pending_push (local.get $set_val_type) (local.get $set_val_flags)
                              (local.get $set_val_lo) (local.get $set_val_hi))
                            (if (i32.eqz (local.get $closure_pointer))
                              (then
                                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                                (br $loop)
                              )
                            )
                            (call $pending_push (local.get $set_val_type) (local.get $set_val_flags)
                              (local.get $set_val_lo) (local.get $set_val_hi))
                            (local.set $stack_pointer (call $read_ctx (global.get $CTX_CALL_STACK_POINTER)))
                            (local.set $frame_pointer (call $abs (local.get $stack_pointer)))
                            (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_INSTRUCTION_INDEX))
                              (i32.add (local.get $pc) (i32.const 1)))
                            (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_SCOPE_POINTER))
                              (global.get $current_scope))
                            (call $save_frame_pending_base (local.get $frame_pointer)
                              (i32.sub (call $read_ctx (global.get $CTX_PENDING_POINTER)) (global.get $VALUE_SIZE)))
                            (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_PENDING_COUNT)) (i32.const 1))
                            (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_FLAGS)) (global.get $FRAME_FLAG_DISCARD_RESULT))
                            (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_AST_NODE)) (i32.const 0))
                            (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_ASYNC_PROMISE)) (i32.const 0))
                            (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_ARGC)) (i32.const 1))
                            (call $write_ctx (global.get $CTX_CALL_STACK_POINTER)
                              (i32.add (local.get $stack_pointer) (global.get $FRAME_SIZE)))
                            (local.set $new_scope (call $scope_create
                              (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 40))))))
                            (global.set $current_scope (local.get $new_scope))
                            (call $scope_define
                              (local.get $new_scope)
                              (call $read_builtin (i32.const 0x18))   ;; BUILTIN_NAME.THIS
                              (local.get $type1) (i32.const 0)
                              (local.get $object_pointer) (i32.const 0))
                            (call $scope_define_new_target (local.get $new_scope)
                              (global.get $TYPE_UNDEFINED) (i32.const 0))
                            (local.set $pc (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 32)))))
                            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                            (br $loop)
                          )
                        )
                        ;; Found! Update the value in place
                        (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 4))) (local.get $set_val_type))
                        (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 8))) (local.get $set_val_flags))
                        (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 12))) (local.get $set_val_lo))
                        (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 16))) (local.get $set_val_hi))
                        (local.set $found (i32.const 1))
                        (br $idx_prop_set_found)
                      )
                    )

                    (local.set $i (i32.add (local.get $i) (i32.const 1)))
                    (br $idx_prop_set_loop)
                  )
                )

                ;; If not found, add new property
                (if (i32.eqz (local.get $found))
                  (then
                    ;; Inherited-accessor walk (class-support slice 1) —
                    ;; twin of SET_PROP's block: an own miss consults the
                    ;; prototype chain; an inherited accessor's setter
                    ;; intercepts the write with `this` = the receiver.
                    ;; TYPE_ACCESSOR values are definitions (object-literal
                    ;; builder mode) and always define own — skip the walk.
                    (if (i32.ne (local.get $set_val_type) (global.get $TYPE_ACCESSOR))
                      (then
                        (local.set $entry_pointer (call $object_find_string_entry
                          (i32.load (call $abs (i32.add (local.get $object_pointer) (i32.const 8))))
                          (local.get $key_offset)))
                        (if (i32.and
                              (i32.ne (local.get $entry_pointer) (i32.const 0))
                              (i32.eq
                                (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 4))))
                                (global.get $TYPE_ACCESSOR)))
                          (then
                            (local.set $closure_pointer
                              (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 16)))))
                            (call $pending_push (local.get $set_val_type) (local.get $set_val_flags)
                              (local.get $set_val_lo) (local.get $set_val_hi))
                            (if (i32.eqz (local.get $closure_pointer))
                              (then
                                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                                (br $loop)
                              )
                            )
                            (call $pending_push (local.get $set_val_type) (local.get $set_val_flags)
                              (local.get $set_val_lo) (local.get $set_val_hi))
                            (local.set $stack_pointer (call $read_ctx (global.get $CTX_CALL_STACK_POINTER)))
                            (local.set $frame_pointer (call $abs (local.get $stack_pointer)))
                            (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_INSTRUCTION_INDEX))
                              (i32.add (local.get $pc) (i32.const 1)))
                            (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_SCOPE_POINTER))
                              (global.get $current_scope))
                            (call $save_frame_pending_base (local.get $frame_pointer)
                              (i32.sub (call $read_ctx (global.get $CTX_PENDING_POINTER)) (global.get $VALUE_SIZE)))
                            (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_PENDING_COUNT)) (i32.const 1))
                            (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_FLAGS)) (global.get $FRAME_FLAG_DISCARD_RESULT))
                            (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_AST_NODE)) (i32.const 0))
                            (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_ASYNC_PROMISE)) (i32.const 0))
                            (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_ARGC)) (i32.const 1))
                            (call $write_ctx (global.get $CTX_CALL_STACK_POINTER)
                              (i32.add (local.get $stack_pointer) (global.get $FRAME_SIZE)))
                            (local.set $new_scope (call $scope_create
                              (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 40))))))
                            (global.set $current_scope (local.get $new_scope))
                            (call $scope_define
                              (local.get $new_scope)
                              (call $read_builtin (i32.const 0x18))   ;; BUILTIN_NAME.THIS
                              (local.get $type1) (i32.const 0)
                              (local.get $object_pointer) (i32.const 0))
                            (call $scope_define_new_target (local.get $new_scope)
                              (global.get $TYPE_UNDEFINED) (i32.const 0))
                            (local.set $pc (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 32)))))
                            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                            (br $loop)
                          )
                        )
                      )
                    )

                    ;; Check if we need to grow entries block
                    (if (i32.ge_u (local.get $obj_count) (local.get $obj_cap))
                      (then
                        ;; Pressure pre-check for the doubling grow — an
                        ;; already-large object's grow can exceed the
                        ;; dispatcher's heap-slack headroom in one
                        ;; instruction. Restore the three popped operands
                        ;; (pointer-only — the slots are untouched) and
                        ;; yield; retry re-runs this op cleanly
                        ;; because the pre-check precedes all mutation.
                        (if (call $check_heap_overflow (call $estimate_object_grow_size (local.get $obj_cap)))
                          (then
                            (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $pending_pointer))
                            (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                            (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                            (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                            (br $exit)))

                        ;; Need to reallocate entries block
                        ;; new_cap = capacity * 2 (or at least 4)
                        (local.set $new_cap (i32.mul (local.get $obj_cap) (i32.const 2)))
                        (if (i32.lt_u (local.get $new_cap) (i32.const 4))
                          (then (local.set $new_cap (i32.const 4)))
                        )

                        ;; Allocate new entries block
                        (local.set $heap_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))
                        (local.set $new_entries_pointer (local.get $heap_pointer))
                        (local.set $new_entries_size (i32.add (global.get $GC_HEADER_SIZE)
                                                             (i32.mul (local.get $new_cap) (global.get $ENTRY_SIZE))))

                        ;; GC header for new entries block
                        (i32.store (call $abs (local.get $new_entries_pointer))
                          (i32.or (local.get $new_entries_size) (i32.shl (global.get $OBJ_OBJECT_DATA) (i32.const 24))))
                        (i32.store (call $abs (i32.add (local.get $new_entries_pointer) (i32.const 4))) (i32.const 0))

                        ;; Update heap pointer
                        (call $write_state (global.get $STATE_HEAP_POINTER)
                          (i32.add (local.get $new_entries_pointer) (local.get $new_entries_size)))

                        ;; Copy existing entries from old block
                        (local.set $i (i32.const 0))
                        (block $idx_copy_entries_done
                          (loop $idx_copy_entries_loop
                            (br_if $idx_copy_entries_done (i32.ge_u (local.get $i) (local.get $obj_count)))
                            ;; src = old_entries_pointer + 8 + i * ENTRY_SIZE
                            (local.set $element_pointer (i32.add
                              (i32.add (local.get $entries_pointer) (global.get $GC_HEADER_SIZE))
                              (i32.mul (local.get $i) (global.get $ENTRY_SIZE))))
                            ;; dest = new_entries_pointer + 8 + i * ENTRY_SIZE
                            (local.set $dest (i32.add
                              (i32.add (local.get $new_entries_pointer) (global.get $GC_HEADER_SIZE))
                              (i32.mul (local.get $i) (global.get $ENTRY_SIZE))))
                            ;; Copy ENTRY_SIZE bytes
                            (i32.store (call $abs (local.get $dest))
                              (i32.load (call $abs (local.get $element_pointer))))
                            (i32.store (call $abs (i32.add (local.get $dest) (i32.const 4)))
                              (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 4)))))
                            (i32.store (call $abs (i32.add (local.get $dest) (i32.const 8)))
                              (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 8)))))
                            (i32.store (call $abs (i32.add (local.get $dest) (i32.const 12)))
                              (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 12)))))
                            (i32.store (call $abs (i32.add (local.get $dest) (i32.const 16)))
                              (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 16)))))
                            (local.set $i (i32.add (local.get $i) (i32.const 1)))
                            (br $idx_copy_entries_loop)
                          )
                        )

                        ;; Update object header with new entries_pointer and capacity
                        (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 16))) (local.get $new_cap))
                        (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 24))) (local.get $new_entries_pointer))
                        (local.set $entries_pointer (local.get $new_entries_pointer))
                      )
                    )

                    ;; Add new entry at count position
                    ;; entry_pointer = entries_pointer + 8 + count * ENTRY_SIZE
                    (local.set $entry_pointer (i32.add
                      (i32.add (local.get $entries_pointer) (global.get $GC_HEADER_SIZE))
                      (i32.mul (local.get $obj_count) (global.get $ENTRY_SIZE))))

                    ;; Write entry: [key][type][flags][data_lo][data_hi]
                    (i32.store (call $abs (local.get $entry_pointer)) (local.get $key_offset))
                    (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 4))) (local.get $set_val_type))
                    (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 8))) (local.get $set_val_flags))
                    (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 12))) (local.get $set_val_lo))
                    (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 16))) (local.get $set_val_hi))

                    ;; Increment count
                    (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 12)))
                      (i32.add (local.get $obj_count) (i32.const 1)))
                  )
                )

                ;; Push value back (assignment is an expression)
                (call $pending_push
                  (local.get $set_val_type)
                  (local.get $set_val_flags)
                  (local.get $set_val_lo)
                  (local.get $set_val_hi))

                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; String assignment is a silent no-op (strings are immutable in JS).
            ;; Push the value back as the expression result.
            (if (i32.eq (local.get $type1) (global.get $TYPE_STRING))
              (then
                (call $pending_push
                  (local.get $set_val_type)
                  (local.get $set_val_flags)
                  (local.get $set_val_lo)
                  (local.get $set_val_hi))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Array with numeric index - original logic
            (local.set $index (call $f64_index_or_negative (call $value_to_f64 (local.get $value_pointer2))))
            (local.set $array_pointer (call $value_data_lo (local.get $value_pointer)))

            ;; Check if array
            (if (i32.ne (local.get $type1) (global.get $TYPE_ARRAY))
              (then
                (if (call $raise_error (global.get $ERR_INVALID_OPERAND) (local.get $type1))
                  (then (br $exit)))
                (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                (br $loop)
              )
            )

            ;; Ring 2: frozen Arrays refuse mutation.
            (if (i32.and
                  (i32.load (call $abs (i32.add (local.get $array_pointer) (global.get $ARRAY_FLAGS_OFFSET))))
                  (global.get $ARRAY_FLAG_FROZEN))
              (then
                (if (call $throw_type_error_with_type (global.get $BUILTIN_MSG_FROZEN_OBJECT) (i32.const 0))
                  (then (br $exit))
                  (else
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)
                  )
                )
              )
            )

            ;; Check for negative index
            (if (i32.lt_s (local.get $index) (i32.const 0))
              (then
                (if (call $raise_error (global.get $ERR_INVALID_OPERAND) (local.get $index))
                  (then (br $exit)))
                (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                (br $loop)
              )
            )

            ;; Get array length, capacity, data_pointer
            (local.set $arr_len (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 8)))))
            (local.set $arr_cap (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 12)))))
            (local.set $data_pointer (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 16)))))

            ;; Check if we need to grow the array
            (if (i32.ge_u (local.get $index) (local.get $arr_cap))
              (then
                ;; Need to reallocate data block
                ;; new_cap = max(index + 1, capacity * 2)
                (local.set $new_cap (i32.add (local.get $index) (i32.const 1)))
                (if (i32.gt_u (i32.mul (local.get $arr_cap) (i32.const 2)) (local.get $new_cap))
                  (then
                    (local.set $new_cap (i32.mul (local.get $arr_cap) (i32.const 2)))
                  )
                )

                ;; Pressure pre-check: GC_HEADER + new_cap * VALUE_SIZE.
                ;; The pop-and-push before this point can be re-derived
                ;; on retry from the same stack state — but we already
                ;; popped operands above. Restore pending_pointer so the
                ;; retry sees container/index/value on top again.
                (if (call $check_heap_overflow
                      (i32.add
                        (global.get $GC_HEADER_SIZE)
                        (i32.mul (local.get $new_cap) (global.get $VALUE_SIZE))))
                  (then
                    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $pending_pointer))
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)))

                ;; Allocate new data block
                (local.set $heap_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))
                (local.set $new_data_pointer (local.get $heap_pointer))
                (local.set $new_data_size (i32.add (global.get $GC_HEADER_SIZE)
                                                   (i32.mul (local.get $new_cap) (global.get $VALUE_SIZE))))

                ;; GC header for new data block
                (i32.store (call $abs (local.get $new_data_pointer))
                  (i32.or (local.get $new_data_size) (i32.shl (global.get $OBJ_ARRAY_DATA) (i32.const 24))))
                (i32.store (call $abs (i32.add (local.get $new_data_pointer) (i32.const 4))) (i32.const 0))

                ;; Update heap pointer
                (call $write_state (global.get $STATE_HEAP_POINTER)
                  (i32.add (local.get $new_data_pointer) (local.get $new_data_size)))

                ;; Copy existing elements from old data block
                (local.set $i (i32.const 0))
                (block $copy_done
                  (loop $copy_loop
                    (br_if $copy_done (i32.ge_u (local.get $i) (local.get $arr_len)))
                    ;; src = old_data_pointer + 8 + i * 16
                    (local.set $element_pointer (i32.add
                      (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
                      (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
                    ;; dest = new_data_pointer + 8 + i * 16
                    (local.set $dest (i32.add
                      (i32.add (local.get $new_data_pointer) (global.get $GC_HEADER_SIZE))
                      (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
                    ;; Copy 16 bytes
                    (i32.store (call $abs (local.get $dest))
                      (i32.load (call $abs (local.get $element_pointer))))
                    (i32.store (call $abs (i32.add (local.get $dest) (i32.const 4)))
                      (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 4)))))
                    (i32.store (call $abs (i32.add (local.get $dest) (i32.const 8)))
                      (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 8)))))
                    (i32.store (call $abs (i32.add (local.get $dest) (i32.const 12)))
                      (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 12)))))
                    (local.set $i (i32.add (local.get $i) (i32.const 1)))
                    (br $copy_loop)
                  )
                )

                ;; Fill gap with undefined if index > arr_len
                (local.set $i (local.get $arr_len))
                (block $fill_done
                  (loop $fill_loop
                    (br_if $fill_done (i32.ge_u (local.get $i) (local.get $index)))
                    ;; dest = new_data_pointer + 8 + i * 16
                    (local.set $dest (i32.add
                      (i32.add (local.get $new_data_pointer) (global.get $GC_HEADER_SIZE))
                      (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
                    ;; Write undefined
                    (i32.store (call $abs (local.get $dest)) (global.get $TYPE_UNDEFINED))
                    (i32.store (call $abs (i32.add (local.get $dest) (i32.const 4))) (i32.const 0))
                    (i32.store (call $abs (i32.add (local.get $dest) (i32.const 8))) (i32.const 0))
                    (i32.store (call $abs (i32.add (local.get $dest) (i32.const 12))) (i32.const 0))
                    (local.set $i (i32.add (local.get $i) (i32.const 1)))
                    (br $fill_loop)
                  )
                )

                ;; Update array header with new data_pointer and capacity
                (i32.store (call $abs (i32.add (local.get $array_pointer) (i32.const 12))) (local.get $new_cap))
                (i32.store (call $abs (i32.add (local.get $array_pointer) (i32.const 16))) (local.get $new_data_pointer))
                (local.set $data_pointer (local.get $new_data_pointer))
              )
              (else
                ;; Within capacity, but may need to fill gap if index > length
                (if (i32.gt_u (local.get $index) (local.get $arr_len))
                  (then
                    (local.set $i (local.get $arr_len))
                    (block $fill_done2
                      (loop $fill_loop2
                        (br_if $fill_done2 (i32.ge_u (local.get $i) (local.get $index)))
                        (local.set $dest (i32.add
                          (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
                          (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
                        (i32.store (call $abs (local.get $dest)) (global.get $TYPE_UNDEFINED))
                        (i32.store (call $abs (i32.add (local.get $dest) (i32.const 4))) (i32.const 0))
                        (i32.store (call $abs (i32.add (local.get $dest) (i32.const 8))) (i32.const 0))
                        (i32.store (call $abs (i32.add (local.get $dest) (i32.const 12))) (i32.const 0))
                        (local.set $i (i32.add (local.get $i) (i32.const 1)))
                        (br $fill_loop2)
                      )
                    )
                  )
                )
              )
            )

            ;; Write value at index
            (local.set $element_pointer (i32.add
              (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
              (i32.mul (local.get $index) (global.get $VALUE_SIZE))))
            (i32.store (call $abs (local.get $element_pointer)) (local.get $set_val_type))
            (i32.store (call $abs (i32.add (local.get $element_pointer) (i32.const 4))) (local.get $set_val_flags))
            (i32.store (call $abs (i32.add (local.get $element_pointer) (i32.const 8))) (local.get $set_val_lo))
            (i32.store (call $abs (i32.add (local.get $element_pointer) (i32.const 12))) (local.get $set_val_hi))

            ;; Update length if index >= arr_len
            (if (i32.ge_u (local.get $index) (local.get $arr_len))
              (then
                (i32.store (call $abs (i32.add (local.get $array_pointer) (i32.const 8)))
                  (i32.add (local.get $index) (i32.const 1)))
              )
            )

            ;; Push value back (assignment is an expression)
            (call $pending_push
              (local.get $set_val_type)
              (local.get $set_val_flags)
              (local.get $set_val_lo)
              (local.get $set_val_hi))

            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; GET_PROP: operand1 = property name (string offset), pop object, push value
        (if (i32.eq (local.get $opcode) (global.get $OP_GET_PROP))
          (then
            (local.set $key_offset (local.get $operand1))

            ;; Pop object
            (local.set $value_pointer (call $pending_pop))
            (local.set $type1 (call $value_type (local.get $value_pointer)))
            (local.set $object_pointer (call $value_data_lo (local.get $value_pointer)))

            ;; Native Proof namespaces resolve their own immutable surface by
            ;; comparing the parser-interned property name inside WAT.
            (if (i32.eq (local.get $type1) (global.get $TYPE_PROOF_NAMESPACE))
              (then
                (call $proof_native_push_namespace_property
                  (local.get $object_pointer)
                  (local.get $key_offset))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)))

            ;; Ring 2: Symbol has two computed properties, .description and
            ;; .toString. Description reads the interned string offset stored
            ;; on the Symbol heap object (or undefined for undescribed).
            ;; toString is a bound method that renders "Symbol(desc)" /
            ;; "Symbol()". Any other property access returns undefined
            ;; (matches JS — Symbols don't expose arbitrary properties).
            (if (i32.eq (local.get $type1) (global.get $TYPE_SYMBOL))
              (then
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_SYMBOL_DESCRIPTION)))
                  (then
                    (local.set $result_i32 (call $symbol_description (local.get $object_pointer)))
                    (if (i32.eqz (local.get $result_i32))
                      (then
                        (call $pending_push (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))
                      )
                      (else
                        (call $pending_push (global.get $TYPE_STRING) (i32.const 0)
                          (local.get $result_i32) (i32.const 0))
                      )
                    )
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_TO_STRING_NAME)))
                  (then
                    (call $pending_push
                      (global.get $TYPE_BOUND_METHOD)
                      (global.get $TYPE_SYMBOL)
                      (local.get $object_pointer)
                      (global.get $METHOD_SYMBOL_TO_STRING))
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )
                ;; Unknown property on a Symbol → undefined.
                (call $pending_push (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Native bound methods expose call / apply / bind (so
            ;; Object.prototype.toString.call(x) works). The pushed value
            ;; carries no receiver — the FUNCTION_* natives read the
            ;; original bound method from the receiver stack slot in the
            ;; method-call form. Other keys read undefined.
            (if (i32.eq (local.get $type1) (global.get $TYPE_BOUND_METHOD))
              (then
                (local.set $method_id
                  (call $value_data_hi (local.get $value_pointer)))
                (if (i32.and
                      (i32.ge_u (local.get $method_id) (global.get $METHOD_BIGINT_AS_INT_N))
                      (i32.le_u (local.get $method_id) (global.get $METHOD_BIGINT_TO_LOCALE_STRING)))
                  (then
                    (if (i32.eq
                          (local.get $key_offset)
                          (call $read_builtin (global.get $BUILTIN_NAME)))
                      (then
                        (local.set $result_i32
                          (call $read_builtin
                            (select
                              (global.get $BUILTIN_BIGINT_AS_INT_N)
                              (select
                                (global.get $BUILTIN_BIGINT_AS_UINT_N)
                                (select
                                  (global.get $BUILTIN_TO_STRING_NAME)
                                  (select
                                    (global.get $BUILTIN_VALUE_OF)
                                    (global.get $BUILTIN_TO_LOCALE_STRING)
                                    (i32.eq
                                      (local.get $method_id)
                                      (global.get $METHOD_BIGINT_VALUE_OF)))
                                  (i32.eq
                                    (local.get $method_id)
                                    (global.get $METHOD_BIGINT_TO_STRING)))
                                (i32.eq
                                  (local.get $method_id)
                                  (global.get $METHOD_BIGINT_AS_UINT_N)))
                              (i32.eq
                                (local.get $method_id)
                                (global.get $METHOD_BIGINT_AS_INT_N)))))
                        (call $pending_push
                          (global.get $TYPE_STRING) (i32.const 0)
                          (local.get $result_i32) (i32.const 0))
                        (local.set $pc
                          (i32.add (local.get $pc) (i32.const 1)))
                        (local.set $fuel
                          (i32.sub (local.get $fuel) (i32.const 1)))
                        (br $loop)))
                    (if (i32.eq
                          (local.get $key_offset)
                          (call $read_builtin (global.get $BUILTIN_LENGTH)))
                      (then
                        (call $push_f64
                          (select
                            (f64.const 2)
                            (select
                              (f64.const 1)
                              (f64.const 0)
                              (i32.eq
                                (local.get $method_id)
                                (global.get $METHOD_BIGINT_TO_STRING)))
                            (i32.or
                              (i32.eq
                                (local.get $method_id)
                                (global.get $METHOD_BIGINT_AS_INT_N))
                              (i32.eq
                                (local.get $method_id)
                                (global.get $METHOD_BIGINT_AS_UINT_N)))))
                        (local.set $pc
                          (i32.add (local.get $pc) (i32.const 1)))
                        (local.set $fuel
                          (i32.sub (local.get $fuel) (i32.const 1)))
                        (br $loop)))))
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_CALL_NAME)))
                  (then
                    (call $pending_push (global.get $TYPE_BOUND_METHOD) (i32.const 0)
                      (i32.const 0) (global.get $METHOD_FUNCTION_CALL))
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_APPLY_NAME)))
                  (then
                    (call $pending_push (global.get $TYPE_BOUND_METHOD) (i32.const 0)
                      (i32.const 0) (global.get $METHOD_FUNCTION_APPLY))
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_BIND_NAME)))
                  (then
                    (call $pending_push (global.get $TYPE_BOUND_METHOD) (i32.const 0)
                      (i32.const 0) (global.get $METHOD_FUNCTION_BIND))
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )
                (call $pending_push (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Primitive BigInts resolve their prototype methods without
            ;; boxing. The heap pointer is retained as the bound receiver.
            (if (i32.eq (local.get $type1) (global.get $TYPE_BIGINT))
              (then
                (local.set $method_id (i32.const 0))
                (if (i32.eq
                      (local.get $key_offset)
                      (call $read_builtin (global.get $BUILTIN_TO_STRING_NAME)))
                  (then (local.set $method_id (global.get $METHOD_BIGINT_TO_STRING))))
                (if (i32.eq
                      (local.get $key_offset)
                      (call $read_builtin (global.get $BUILTIN_TO_LOCALE_STRING)))
                  (then (local.set $method_id (global.get $METHOD_BIGINT_TO_LOCALE_STRING))))
                (if (i32.eq
                      (local.get $key_offset)
                      (call $read_builtin (global.get $BUILTIN_VALUE_OF)))
                  (then (local.set $method_id (global.get $METHOD_BIGINT_VALUE_OF))))
                (if (local.get $method_id)
                  (then
                    (call $pending_push
                      (global.get $TYPE_BOUND_METHOD)
                      (i32.const 0)
                      (i32.const 0)
                      (local.get $method_id)))
                  (else
                    (call $pending_push
                      (global.get $TYPE_UNDEFINED)
                      (i32.const 0) (i32.const 0) (i32.const 0))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)))

            ;; Numbers: toFixed / toString bound methods; any other
            ;; property reads undefined (matches JS — numbers have no own
            ;; properties). The receiver value is NOT embedded in the
            ;; bound method (a float doesn't fit its 32-bit slot);
            ;; dispatch reads it from the receiver stack slot, so these
            ;; methods require the method-call form.
            (if (i32.or
                  (i32.or
                    (i32.eq (local.get $type1) (global.get $TYPE_INTEGER))
                    (i32.eq (local.get $type1) (global.get $TYPE_FLOAT)))
                  (i32.eq (local.get $type1) (global.get $TYPE_RATIONAL)))
              (then
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_TO_FIXED)))
                  (then
                    (call $pending_push
                      (global.get $TYPE_BOUND_METHOD)
                      (local.get $type1)
                      (i32.const 0)
                      (global.get $METHOD_NUMBER_TO_FIXED))
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_TO_STRING_NAME)))
                  (then
                    (call $pending_push
                      (global.get $TYPE_BOUND_METHOD)
                      (local.get $type1)
                      (i32.const 0)
                      (global.get $METHOD_NUMBER_TO_STRING))
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )
                (call $pending_push (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Map: .size is read from the instance header; everything else
            ;; resolves via Map.prototype's string-key entries. BOUND_METHODs
            ;; found there get their receiver rewritten to this map (same
            ;; convention as slice 3's array.iterator path).
            (if (i32.or
                  (i32.eq (local.get $type1) (global.get $TYPE_MAP))
                  (i32.eq (local.get $type1) (global.get $TYPE_SET)))
              (then
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_MAP_SIZE)))
                  (then
                    (local.set $arr_len
                      (i32.load (call $abs (i32.add (local.get $object_pointer) (i32.const 8)))))
                    (call $push_f64 (f64.convert_i32_u (local.get $arr_len)))
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )
                ;; Method lookup via prototype walk.
                (if (i32.eq (local.get $type1) (global.get $TYPE_MAP))
                  (then (local.set $current_obj (call $read_state (global.get $STATE_MAP_PROTOTYPE))))
                  (else (local.set $current_obj (call $read_state (global.get $STATE_SET_PROTOTYPE))))
                )
                (local.set $proto_depth (i32.const 0))
                (local.set $found (i32.const 0))
                (block $coll_prop_done
                  (loop $coll_proto_loop
                    (br_if $coll_prop_done (i32.eqz (local.get $current_obj)))
                    (br_if $coll_prop_done (i32.ge_u (local.get $proto_depth) (global.get $MAX_PROTO_DEPTH)))
                    (local.set $obj_count (i32.load (call $abs (i32.add (local.get $current_obj) (i32.const 12)))))
                    (local.set $entries_pointer (i32.load (call $abs (i32.add (local.get $current_obj) (i32.const 24)))))
                    (local.set $i (i32.const 0))
                    (block $coll_next_proto
                      (loop $coll_prop_loop
                        (br_if $coll_next_proto (i32.ge_u (local.get $i) (local.get $obj_count)))
                        (local.set $entry_pointer (i32.add
                          (i32.add (local.get $entries_pointer) (global.get $GC_HEADER_SIZE))
                          (i32.mul (local.get $i) (global.get $ENTRY_SIZE))))
                        (local.set $prop_key (i32.load (call $abs (local.get $entry_pointer))))
                        (if (i32.eq (local.get $prop_key) (local.get $key_offset))
                          (then
                            ;; Found. If BOUND_METHOD, rebind to the current Map/Set instance.
                            (local.set $type3
                              (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 4)))))
                            (if (i32.eq (local.get $type3) (global.get $TYPE_BOUND_METHOD))
                              (then
                                (call $pending_push
                                  (global.get $TYPE_BOUND_METHOD)
                                  (local.get $type1)         ;; flags = receiver type (TYPE_MAP / TYPE_SET)
                                  (local.get $object_pointer);; data_lo = receiver pointer
                                  (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 16)))))
                              )
                              (else
                                (call $pending_push
                                  (local.get $type3)
                                  (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 8))))
                                  (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 12))))
                                  (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 16)))))
                              )
                            )
                            (local.set $found (i32.const 1))
                            (br $coll_prop_done)
                          )
                        )
                        (local.set $i (i32.add (local.get $i) (i32.const 1)))
                        (br $coll_prop_loop)
                      )
                    )
                    (local.set $current_obj (i32.load (call $abs (i32.add (local.get $current_obj) (i32.const 8)))))
                    (local.set $proto_depth (i32.add (local.get $proto_depth) (i32.const 1)))
                    (br $coll_proto_loop)
                  )
                )
                (if (i32.eqz (local.get $found))
                  (then
                    (call $pending_push (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))
                  )
                )
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Check for .length and methods on arrays
            (if (i32.eq (local.get $type1) (global.get $TYPE_ARRAY))
              (then
                ;; Check if property is "length"
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_LENGTH)))
                  (then
                    ;; Array layout: [GC:8][length:4][capacity:4][data_pointer:4]
                    ;; object_pointer = array_pointer (start of allocation including GC header)
                    ;; Length is at object_pointer + 8 (after 8-byte GC header)
                    (local.set $arr_len (i32.load (call $abs (i32.add (local.get $object_pointer) (i32.const 8)))))

                    ;; Push length as float (JS semantics - all numbers are f64)
                    (call $push_f64 (f64.convert_i32_u (local.get $arr_len)))

                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )

                ;; Check for array methods - return TYPE_BOUND_METHOD
                ;; Format: type=BOUND_METHOD, flags=receiver_type, data_lo=receiver_pointer, data_hi=method_id
                (local.set $method_id (i32.const 0))

                ;; push
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_PUSH)))
                  (then (local.set $method_id (global.get $METHOD_PUSH))))
                ;; pop
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_POP)))
                  (then (local.set $method_id (global.get $METHOD_POP))))
                ;; toString — matches JS Array.prototype.toString, equivalent
                ;; to .join(",").
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_TO_STRING_NAME)))
                  (then (local.set $method_id (global.get $METHOD_ARRAY_TO_STRING))))
                ;; shift
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_SHIFT)))
                  (then (local.set $method_id (global.get $METHOD_SHIFT))))
                ;; unshift
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_UNSHIFT)))
                  (then (local.set $method_id (global.get $METHOD_UNSHIFT))))
                ;; slice
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_SLICE)))
                  (then (local.set $method_id (global.get $METHOD_SLICE))))
                ;; concat
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_CONCAT)))
                  (then (local.set $method_id (global.get $METHOD_CONCAT))))
                ;; join
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_JOIN)))
                  (then (local.set $method_id (global.get $METHOD_JOIN))))
                ;; reverse
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_REVERSE)))
                  (then (local.set $method_id (global.get $METHOD_REVERSE))))
                ;; indexOf
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_INDEX_OF)))
                  (then (local.set $method_id (global.get $METHOD_INDEX_OF))))
                ;; includes
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_INCLUDES)))
                  (then (local.set $method_id (global.get $METHOD_INCLUDES))))
                ;; map (callback method)
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_MAP)))
                  (then (local.set $method_id (global.get $METHOD_MAP))))
                ;; filter (callback method)
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_FILTER)))
                  (then (local.set $method_id (global.get $METHOD_FILTER))))
                ;; reduce (callback method)
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_REDUCE)))
                  (then (local.set $method_id (global.get $METHOD_REDUCE))))
                ;; reduceRight (callback method, descending)
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_REDUCE_RIGHT)))
                  (then (local.set $method_id (global.get $METHOD_ARRAY_REDUCE_RIGHT))))
                ;; forEach (callback method)
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_FOR_EACH)))
                  (then (local.set $method_id (global.get $METHOD_FOR_EACH))))
                ;; find (callback method)
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_FIND)))
                  (then (local.set $method_id (global.get $METHOD_FIND))))
                ;; findIndex (callback method)
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_FIND_INDEX)))
                  (then (local.set $method_id (global.get $METHOD_FIND_INDEX))))
                ;; findLast (callback method, descending)
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_FIND_LAST)))
                  (then (local.set $method_id (global.get $METHOD_FIND_LAST))))
                ;; findLastIndex (callback method, descending)
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_FIND_LAST_INDEX)))
                  (then (local.set $method_id (global.get $METHOD_FIND_LAST_INDEX))))
                ;; some (callback method)
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_SOME)))
                  (then (local.set $method_id (global.get $METHOD_SOME))))
                ;; every (callback method)
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_EVERY)))
                  (then (local.set $method_id (global.get $METHOD_EVERY))))
                ;; splice
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_SPLICE)))
                  (then (local.set $method_id (global.get $METHOD_SPLICE))))
                ;; sort (callback method)
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_SORT)))
                  (then (local.set $method_id (global.get $METHOD_SORT))))
                ;; flat
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_FLAT)))
                  (then (local.set $method_id (global.get $METHOD_FLAT))))
                ;; flatMap (callback method)
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_FLAT_MAP)))
                  (then (local.set $method_id (global.get $METHOD_FLAT_MAP))))
                ;; at
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_AT)))
                  (then (local.set $method_id (global.get $METHOD_ARRAY_AT))))
                ;; fill
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_FILL)))
                  (then (local.set $method_id (global.get $METHOD_ARRAY_FILL))))
                ;; lastIndexOf
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_LAST_INDEX_OF)))
                  (then (local.set $method_id (global.get $METHOD_ARRAY_LAST_INDEX_OF))))
                ;; copyWithin
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_COPY_WITHIN)))
                  (then (local.set $method_id (global.get $METHOD_ARRAY_COPY_WITHIN))))
                ;; keys (iterator factory, kind 0)
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_SETLIKE_KEYS)))
                  (then (local.set $method_id (global.get $METHOD_ARRAY_KEYS))))
                ;; values (=== the Symbol.iterator iterator, kind 1)
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_VALUES)))
                  (then (local.set $method_id (global.get $METHOD_ARRAY_ITERATOR_FACTORY))))
                ;; entries (iterator factory, kind 2 — [index, value] pairs)
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_ENTRIES)))
                  (then (local.set $method_id (global.get $METHOD_ARRAY_ENTRIES))))
                ;; toReversed (copying)
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_TO_REVERSED)))
                  (then (local.set $method_id (global.get $METHOD_ARRAY_TO_REVERSED))))
                ;; toSorted (copying; comparator form intercepted at CALL_METHOD)
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_TO_SORTED)))
                  (then (local.set $method_id (global.get $METHOD_ARRAY_TO_SORTED))))
                ;; with (copying)
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_WITH_NAME)))
                  (then (local.set $method_id (global.get $METHOD_ARRAY_WITH))))
                ;; toSpliced (copying; arrays only per spec)
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_TO_SPLICED)))
                  (then (local.set $method_id (global.get $METHOD_ARRAY_TO_SPLICED))))
                ;; toLocaleString — the sandbox has no locales; JS
                ;; default-locale number output equals toString's, so
                ;; this is a resolution-time alias for the same method.
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_TO_LOCALE_STRING)))
                  (then (local.set $method_id (global.get $METHOD_ARRAY_TO_STRING))))
                ;; If we found a method, push TYPE_BOUND_METHOD
                (if (i32.ne (local.get $method_id) (i32.const 0))
                  (then
                    (call $pending_push
                      (global.get $TYPE_BOUND_METHOD)
                      (global.get $TYPE_ARRAY)           ;; flags = receiver type
                      (local.get $object_pointer)               ;; data_lo = receiver pointer
                      (local.get $method_id))            ;; data_hi = method ID
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )

                ;; Match-result metadata: an exec result array carries a
                ;; hidden meta object in its sym-entries block under the
                ;; bootstrap match-meta symbol; index/input/groups/indices
                ;; resolve through it. Plain arrays (or a meta object
                ;; missing the property, e.g. groups with no named
                ;; captures) fall through to undefined — matching JS.
                (if (i32.or
                      (i32.or
                        (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_MATCH_INDEX)))
                        (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_MATCH_INPUT))))
                      (i32.or
                        (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_MATCH_GROUPS)))
                        (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_MATCH_INDICES)))))
                  (then
                    (local.set $result_i32 (i32.load (call $abs (i32.add
                      (local.get $object_pointer)
                      (global.get $ARRAY_SYM_ENTRIES_OFFSET)))))
                    (if (i32.ne (local.get $result_i32) (i32.const 0))
                      (then
                        (local.set $result_i32 (call $sym_block_find
                          (local.get $result_i32)
                          (call $read_state (global.get $STATE_REGEXP_MATCH_META_SYMBOL))))
                        (if (i32.ne (local.get $result_i32) (i32.const 0))
                          (then
                            ;; Entry value is the meta object; resolve the
                            ;; same key against its own entries.
                            (if (i32.eq
                                  (i32.load (call $abs (i32.add (local.get $result_i32) (i32.const 4))))
                                  (global.get $TYPE_OBJECT))
                              (then
                                (local.set $result_i32 (call $object_find_string_entry
                                  (i32.load (call $abs (i32.add (local.get $result_i32) (i32.const 12))))
                                  (local.get $key_offset)))
                                (if (i32.ne (local.get $result_i32) (i32.const 0))
                                  (then
                                    (call $pending_push
                                      (i32.load (call $abs (i32.add (local.get $result_i32) (i32.const 4))))
                                      (i32.load (call $abs (i32.add (local.get $result_i32) (i32.const 8))))
                                      (i32.load (call $abs (i32.add (local.get $result_i32) (i32.const 12))))
                                      (i32.load (call $abs (i32.add (local.get $result_i32) (i32.const 16)))))
                                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                                    (br $loop)))))))))))

                ;; Not a known property - return undefined
                (call $pending_push
                  (global.get $TYPE_UNDEFINED)
                  (i32.const 0)
                  (i32.const 0)
                  (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; RegExp descriptor properties. Instances are TYPE_REGEXP
            ;; primitives; every property resolves here (no prototype walk).
            ;; object_pointer = descriptor HEADER pointer.
            (if (i32.eq (local.get $type1) (global.get $TYPE_REGEXP))
              (then
                (local.set $data_pointer
                  (i32.add (local.get $object_pointer) (global.get $GC_HEADER_SIZE)))
                ;; .source — script-visible pattern text ("(?:)" when empty,
                ;; unescaped slashes escaped). May intern: pressure retries.
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_SOURCE)))
                  (then
                    (local.set $result_i32
                      (call $regexp_source_string
                        (i32.load (call $abs (i32.add (local.get $data_pointer)
                          (global.get $REGEXP_PATTERN_STRING))))))
                    (if (i32.eqz (local.get $result_i32))
                      (then
                        ;; Refused intern: restore the popped receiver and
                        ;; yield for gc-and-retry of this instruction.
                        (call $write_ctx (global.get $CTX_PENDING_POINTER)
                          (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE)))
                        (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                        (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                        (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                        (br $exit)))
                    (call $pending_push
                      (global.get $TYPE_STRING) (i32.const 0)
                      (local.get $result_i32) (i32.const 0))
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)))
                ;; .flags — canonical letters (d g i m s y). May intern.
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_FLAGS)))
                  (then
                    (local.set $result_i32
                      (call $regexp_flags_string
                        (i32.load (call $abs (i32.add (local.get $data_pointer)
                          (global.get $REGEXP_FLAGS))))))
                    (if (i32.eqz (local.get $result_i32))
                      (then
                        (call $write_ctx (global.get $CTX_PENDING_POINTER)
                          (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE)))
                        (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                        (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                        (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                        (br $exit)))
                    (call $pending_push
                      (global.get $TYPE_STRING) (i32.const 0)
                      (local.get $result_i32) (i32.const 0))
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)))
                ;; .lastIndex — Unicode-scalar index (deliberate divergence
                ;; from JS's UTF-16 units; the epic owns the ruling).
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_LAST_INDEX)))
                  (then
                    (call $push_f64
                      (f64.convert_i32_u
                        (i32.load (call $abs (i32.add (local.get $data_pointer)
                          (global.get $REGEXP_LAST_INDEX))))))
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)))
                ;; Flag booleans.
                (local.set $result_i32 (i32.const -1))
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_GLOBAL)))
                  (then (local.set $result_i32 (global.get $REGEXP_FLAG_GLOBAL))))
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_IGNORE_CASE)))
                  (then (local.set $result_i32 (global.get $REGEXP_FLAG_IGNORE_CASE))))
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_MULTILINE)))
                  (then (local.set $result_i32 (global.get $REGEXP_FLAG_MULTILINE))))
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_DOT_ALL)))
                  (then (local.set $result_i32 (global.get $REGEXP_FLAG_DOT_ALL))))
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_HAS_INDICES)))
                  (then (local.set $result_i32 (global.get $REGEXP_FLAG_HAS_INDICES))))
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_STICKY)))
                  (then (local.set $result_i32 (global.get $REGEXP_FLAG_STICKY))))
                (if (i32.ne (local.get $result_i32) (i32.const -1))
                  (then
                    (call $pending_push
                      (global.get $TYPE_BOOLEAN) (i32.const 0)
                      (i32.ne
                        (i32.and
                          (i32.load (call $abs (i32.add (local.get $data_pointer)
                            (global.get $REGEXP_FLAGS))))
                          (local.get $result_i32))
                        (i32.const 0))
                      (i32.const 0))
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)))
                ;; .exec / .test — bound methods on the descriptor.
                (local.set $method_id (i32.const 0))
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_EXEC)))
                  (then (local.set $method_id (global.get $METHOD_REGEXP_EXEC))))
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_TEST)))
                  (then (local.set $method_id (global.get $METHOD_REGEXP_TEST))))
                (if (i32.ne (local.get $method_id) (i32.const 0))
                  (then
                    (call $pending_push
                      (global.get $TYPE_BOUND_METHOD)
                      (global.get $TYPE_REGEXP)
                      (local.get $object_pointer)
                      (local.get $method_id))
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)))
                ;; Unknown property on a RegExp → undefined.
                (call $pending_push
                  (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)))

            ;; Schema primitives: test/validate/assert/errors bind per
            ;; instance; schema/kind/dialect read the descriptor.
            (if (i32.eq (local.get $type1) (global.get $TYPE_SCHEMA))
              (then
                (local.set $method_id (i32.const 0))
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_TEST)))
                  (then (local.set $method_id (global.get $METHOD_SCHEMA_TEST))))
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_VALIDATE)))
                  (then (local.set $method_id (global.get $METHOD_SCHEMA_VALIDATE))))
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_ASSERT)))
                  (then (local.set $method_id (global.get $METHOD_SCHEMA_ASSERT))))
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_ERRORS)))
                  (then (local.set $method_id (global.get $METHOD_SCHEMA_ERRORS))))
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_MATCH)))
                  (then (local.set $method_id (global.get $METHOD_SCHEMA_MATCH))))
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_MATCH_ALL)))
                  (then (local.set $method_id (global.get $METHOD_SCHEMA_MATCH_ALL))))
                (if (i32.ne (local.get $method_id) (i32.const 0))
                  (then
                    (call $pending_push
                      (global.get $TYPE_BOUND_METHOD)
                      (global.get $TYPE_SCHEMA)
                      (local.get $object_pointer)
                      (local.get $method_id))
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)))
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_KEY_SCHEMA)))
                  (then
                    (local.set $entry_pointer (i32.add (i32.add (local.get $object_pointer) (global.get $GC_HEADER_SIZE)) (global.get $SCHEMA_SOURCE)))
                    (call $pending_push
                      (call $value_type (local.get $entry_pointer))
                      (call $value_flags (local.get $entry_pointer))
                      (call $value_data_lo (local.get $entry_pointer))
                      (call $value_data_hi (local.get $entry_pointer)))
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)))
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_KEY_KIND)))
                  (then
                    (call $pending_push (global.get $TYPE_STRING) (i32.const 0)
                      (select (call $read_builtin (global.get $BUILTIN_LIT_SET)) (call $read_builtin (global.get $BUILTIN_KEY_SCHEMA))
                              (i32.and (call $schema_descriptor_field (local.get $object_pointer) (global.get $SCHEMA_OPTIONS)) (global.get $SCHEMA_OPT_SET)))
                      (i32.const 0))
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)))
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_MAP_SIZE)))
                  (then
                    (call $push_f64 (f64.convert_i32_u (call $schema_program_route_count
                      (i32.add (call $abs (call $schema_descriptor_field (local.get $object_pointer) (global.get $SCHEMA_PROGRAM_BUFFER))) (i32.const 4)))))
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)))
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_KEY_DIALECT)))
                  (then
                    (call $pending_push (global.get $TYPE_STRING) (i32.const 0)
                      (call $schema_dialect_string (local.get $object_pointer)) (i32.const 0))
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)))
                (call $pending_push
                  (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)))

            ;; Check for .length and methods on strings
            (if (i32.eq (local.get $type1) (global.get $TYPE_STRING))
              (then
                ;; Check if property is "length"
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_LENGTH)))
                  (then
                    ;; String table entry: [byte_len:4][bytes:N]
                    ;; object_pointer is the string table offset
                    ;; Count UTF-8 characters (not bytes) to match JS behavior
                    (local.set $arr_len (call $utf8_char_count (local.get $object_pointer)))

                    ;; Push length as float
                    (call $push_f64 (f64.convert_i32_u (local.get $arr_len)))

                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )

                ;; Check for string methods - return TYPE_BOUND_METHOD
                (local.set $method_id (i32.const 0))

                ;; charAt
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_CHAR_AT)))
                  (then (local.set $method_id (global.get $METHOD_CHAR_AT))))
                ;; charCodeAt
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_CHAR_CODE_AT)))
                  (then (local.set $method_id (global.get $METHOD_CHAR_CODE_AT))))
                ;; indexOf (string version)
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_STRING_INDEX_OF)))
                  (then (local.set $method_id (global.get $METHOD_STRING_INDEX_OF))))
                ;; includes (string version)
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_STRING_INCLUDES)))
                  (then (local.set $method_id (global.get $METHOD_STRING_INCLUDES))))
                ;; slice (string version)
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_STRING_SLICE)))
                  (then (local.set $method_id (global.get $METHOD_STRING_SLICE))))
                ;; substring
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_SUBSTRING)))
                  (then (local.set $method_id (global.get $METHOD_SUBSTRING))))
                ;; split
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_SPLIT)))
                  (then (local.set $method_id (global.get $METHOD_SPLIT))))
                ;; trim
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_TRIM)))
                  (then (local.set $method_id (global.get $METHOD_TRIM))))
                ;; toLowerCase
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_TO_LOWER_CASE)))
                  (then (local.set $method_id (global.get $METHOD_TO_LOWER_CASE))))
                ;; toUpperCase
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_TO_UPPER_CASE)))
                  (then (local.set $method_id (global.get $METHOD_TO_UPPER_CASE))))
                ;; startsWith
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_STARTS_WITH)))
                  (then (local.set $method_id (global.get $METHOD_STARTS_WITH))))
                ;; endsWith
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_ENDS_WITH)))
                  (then (local.set $method_id (global.get $METHOD_ENDS_WITH))))
                ;; repeat
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_REPEAT)))
                  (then (local.set $method_id (global.get $METHOD_REPEAT))))
                ;; padStart
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_PAD_START)))
                  (then (local.set $method_id (global.get $METHOD_PAD_START))))
                ;; padEnd
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_PAD_END)))
                  (then (local.set $method_id (global.get $METHOD_PAD_END))))
                ;; replace
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_REPLACE)))
                  (then (local.set $method_id (global.get $METHOD_REPLACE))))
                ;; replaceAll
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_REPLACE_ALL)))
                  (then (local.set $method_id (global.get $METHOD_REPLACE_ALL))))
                ;; trimStart
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_TRIM_START)))
                  (then (local.set $method_id (global.get $METHOD_TRIM_START))))
                ;; trimEnd
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_TRIM_END)))
                  (then (local.set $method_id (global.get $METHOD_TRIM_END))))
                ;; lastIndexOf
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_STRING_LAST_INDEX_OF)))
                  (then (local.set $method_id (global.get $METHOD_STRING_LAST_INDEX_OF))))
                ;; at
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_STRING_AT)))
                  (then (local.set $method_id (global.get $METHOD_STRING_AT))))
                ;; concat
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_STRING_CONCAT)))
                  (then (local.set $method_id (global.get $METHOD_STRING_CONCAT))))
                ;; match / matchAll / search (RegExp string methods —
                ;; fuel-resumable, dispatched inline in CALL/CALL_METHOD)
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_MATCH)))
                  (then (local.set $method_id (global.get $METHOD_STRING_MATCH))))
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_MATCH_ALL)))
                  (then (local.set $method_id (global.get $METHOD_STRING_MATCH_ALL))))
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_SEARCH)))
                  (then (local.set $method_id (global.get $METHOD_STRING_SEARCH))))

                ;; If we found a method, push TYPE_BOUND_METHOD
                (if (i32.ne (local.get $method_id) (i32.const 0))
                  (then
                    (call $pending_push
                      (global.get $TYPE_BOUND_METHOD)
                      (global.get $TYPE_STRING)          ;; flags = receiver type
                      (local.get $object_pointer)               ;; data_lo = receiver pointer (string table offset)
                      (local.get $method_id))            ;; data_hi = method ID
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )

                ;; Not a known property - return undefined
                (call $pending_push
                  (global.get $TYPE_UNDEFINED)
                  (i32.const 0)
                  (i32.const 0)
                  (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Check for methods on Promise objects
            (if (i32.eq (local.get $type1) (global.get $TYPE_PROMISE))
              (then
                ;; Promise methods: then, catch, finally
                ;; object_pointer = header pointer of promise
                (local.set $method_id (i32.const 0))

                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_THEN)))
                  (then (local.set $method_id (global.get $METHOD_THEN))))
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_CATCH)))
                  (then (local.set $method_id (global.get $METHOD_CATCH))))
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_FINALLY)))
                  (then (local.set $method_id (global.get $METHOD_FINALLY))))

                ;; If we found a method, push TYPE_BOUND_METHOD
                (if (i32.ne (local.get $method_id) (i32.const 0))
                  (then
                    (call $pending_push
                      (global.get $TYPE_BOUND_METHOD)
                      (global.get $TYPE_PROMISE)             ;; flags = receiver type
                      (local.get $object_pointer)            ;; data_lo = promise header pointer
                      (local.get $method_id))                ;; data_hi = method ID
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )

                ;; Not a known property - return undefined
                (call $pending_push
                  (global.get $TYPE_UNDEFINED)
                  (i32.const 0)
                  (i32.const 0)
                  (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Check if TYPE_CONSTRUCTOR (Array, Object, String, Number)
            ;; These have an underlying object with static methods
            ;; Layout: [type=CONSTRUCTOR][padding][object_pointer][method_id]
            (if (i32.eq (local.get $type1) (global.get $TYPE_CONSTRUCTOR))
              (then
                ;; object_pointer already has data_lo which is the underlying object pointer
                ;; Do the same object property lookup as TYPE_OBJECT
                ;; Object layout: [GC:8][prototype:4][count:4][capacity:4][entries:4]
                (local.set $obj_count (i32.load (call $abs (i32.add (local.get $object_pointer) (i32.const 12)))))
                (local.set $entries_pointer (i32.load (call $abs (i32.add (local.get $object_pointer) (i32.const 24)))))

                ;; Linear search for property
                (local.set $i (i32.const 0))
                (local.set $found (i32.const 0))
                (block $ctor_prop_found
                  (loop $ctor_prop_loop
                    (br_if $ctor_prop_found (i32.ge_u (local.get $i) (local.get $obj_count)))

                    ;; entry_pointer = entries_pointer + 8 (GC header) + i * ENTRY_SIZE
                    (local.set $entry_pointer (i32.add
                      (i32.add (local.get $entries_pointer) (global.get $GC_HEADER_SIZE))
                      (i32.mul (local.get $i) (global.get $ENTRY_SIZE))))

                    (local.set $prop_key (i32.load (call $abs (local.get $entry_pointer))))

                    (if (i32.eq (local.get $prop_key) (local.get $key_offset))
                      (then
                        ;; Found! Push the value
                        (call $pending_push
                          (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 4))))   ;; type
                          (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 8))))   ;; flags
                          (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 12))))  ;; data_lo
                          (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 16))))) ;; data_hi
                        (local.set $found (i32.const 1))
                        (br $ctor_prop_found)
                      )
                    )

                    (local.set $i (i32.add (local.get $i) (i32.const 1)))
                    (br $ctor_prop_loop)
                  )
                )

                ;; If not found, push undefined
                (if (i32.eqz (local.get $found))
                  (then
                    (call $pending_push
                      (global.get $TYPE_UNDEFINED)
                      (i32.const 0)
                      (i32.const 0)
                      (i32.const 0))
                  )
                )

                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Check if object or function (functions have same layout for properties)
            (if (i32.or
                  (i32.eq (local.get $type1) (global.get $TYPE_OBJECT))
                  (i32.eq (local.get $type1) (global.get $TYPE_FUNCTION)))
              (then
                ;; Object/Function layout: [GC:8][prototype:4][count:4][capacity:4][entries_pointer:4]
                ;; Entry: [key:4][type:4][flags:4][data_lo:4][data_hi:4]
                ;; Walk prototype chain looking for property
                (local.set $current_obj (local.get $object_pointer))
                (local.set $proto_depth (i32.const 0))
                (local.set $found (i32.const 0))

                (block $prop_search_done
                  (loop $proto_loop
                    (br_if $prop_search_done (i32.eqz (local.get $current_obj)))
                    (br_if $prop_search_done (i32.ge_u (local.get $proto_depth) (global.get $MAX_PROTO_DEPTH)))
                    (local.set $obj_count (i32.load (call $abs (i32.add (local.get $current_obj) (i32.const 12)))))
                    (local.set $entries_pointer (i32.load (call $abs (i32.add (local.get $current_obj) (i32.const 24)))))
                    (local.set $i (i32.const 0))
                    (block $check_next_proto
                      (loop $prop_loop
                        (br_if $check_next_proto (i32.ge_u (local.get $i) (local.get $obj_count)))
                        (local.set $entry_pointer (i32.add
                          (i32.add (local.get $entries_pointer) (global.get $GC_HEADER_SIZE))
                          (i32.mul (local.get $i) (global.get $ENTRY_SIZE))))
                        (local.set $prop_key (i32.load (call $abs (local.get $entry_pointer))))
                        (if (i32.eq (local.get $prop_key) (local.get $key_offset))
                          (then
                            (if (i32.eq
                                  (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 4))))
                                  (global.get $TYPE_ACCESSOR))
                              (then
                                (local.set $closure_pointer
                                  (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 12)))))
                                (if (i32.eqz (local.get $closure_pointer))
                                  (then
                                    (call $pending_push (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))
                                    (local.set $found (i32.const 1))
                                    (br $prop_search_done)))
                                (local.set $stack_pointer (call $read_ctx (global.get $CTX_CALL_STACK_POINTER)))
                                (local.set $frame_pointer (call $abs (local.get $stack_pointer)))
                                (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_INSTRUCTION_INDEX))
                                  (i32.add (local.get $pc) (i32.const 1)))
                                (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_SCOPE_POINTER))
                                  (global.get $current_scope))
                                (call $save_frame_pending_base (local.get $frame_pointer)
                                  (call $read_ctx (global.get $CTX_PENDING_POINTER)))
                                (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_PENDING_COUNT)) (i32.const 1))
                                (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_FLAGS)) (i32.const 0))
                                (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_AST_NODE)) (i32.const 0))
                                (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_ASYNC_PROMISE)) (i32.const 0))
                                (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_ARGC)) (i32.const 0))
                                (call $write_ctx (global.get $CTX_CALL_STACK_POINTER)
                                  (i32.add (local.get $stack_pointer) (global.get $FRAME_SIZE)))
                                (local.set $new_scope (call $scope_create
                                  (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 40))))))
                                (global.set $current_scope (local.get $new_scope))
                                (call $scope_define
                                  (local.get $new_scope)
                                  (call $read_builtin (i32.const 0x18))
                                  (local.get $type1) (i32.const 0)
                                  (local.get $object_pointer) (i32.const 0))
                                (call $scope_define_new_target (local.get $new_scope)
                                  (global.get $TYPE_UNDEFINED) (i32.const 0))
                                (local.set $pc (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 32)))))
                                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                                (br $loop)))
                            (call $pending_push
                              (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 4))))
                              (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 8))))
                              (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 12))))
                              (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 16)))))
                            (local.set $found (i32.const 1))
                            (br $prop_search_done)))
                        (local.set $i (i32.add (local.get $i) (i32.const 1)))
                        (br $prop_loop)))
                    (local.set $current_obj (i32.load (call $abs (i32.add (local.get $current_obj) (i32.const 8)))))
                    (local.set $proto_depth (i32.add (local.get $proto_depth) (i32.const 1)))
                    (br $proto_loop)
                  )
                )

                ;; If not found after walking the chain: a private access
                ;; (operand2 bit 0, set only by the parser's #member
                ;; emissions) throws — the receiver's class did not declare
                ;; the name (JS TypeError). A plain access pushes undefined.
                (if (i32.eqz (local.get $found))
                  (then
                    (if (i32.and (local.get $operand2) (i32.const 1))
                      (then
                        (if (call $throw_type_error_with_message (global.get $BUILTIN_MSG_PRIVATE_NOT_DECLARED))
                          (then (br $exit))
                          (else
                            (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                            (br $loop)
                          )
                        )
                      )
                    )
                    ;; extends-externals D5: a string-key miss on a branded
                    ;; instance forwards to the backing external value. The
                    ;; airlock probes presence (setHasProperty), runs a getter
                    ;; or default getter, falls back to the method-binding
                    ;; shape for a present method, or resumes undefined.
                    ;; +20 carries the receiver — the branded marker.
                    (if (i32.and
                          (i32.eq (local.get $type1) (global.get $TYPE_OBJECT))
                          (i32.ne
                            (i32.and
                              (i32.load (call $abs (i32.add (local.get $object_pointer) (i32.const 20))))
                              (global.get $OBJECT_FLAG_EXTERNAL_BACKED))
                            (i32.const 0)))
                      (then
                        (local.set $entry_pointer (call $object_find_string_entry
                          (local.get $object_pointer)
                          (call $read_builtin (global.get $BUILTIN_EXTERNAL_BACKING))))
                        (if (i32.ne (local.get $entry_pointer) (i32.const 0))
                          (then
                            (i32.store (call $abs (global.get $external_request_base))
                              (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 12)))))
                            (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 4)))
                              (local.get $key_offset))
                            (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 8))) (i32.const 0))
                            (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 12))) (i32.const 0))
                            (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 16)))
                              (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 16)))))
                            (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 20)))
                              (local.get $object_pointer))
                            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                            (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX)
                              (i32.add (local.get $pc) (i32.const 1)))
                            (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                            (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_EXTERNAL_PROPERTY))
                            (br $exit)
                          )
                        )
                      )
                    )
                    (call $pending_push
                      (global.get $TYPE_UNDEFINED)
                      (i32.const 0)
                      (i32.const 0)
                      (i32.const 0))
                  )
                )

                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Check if TYPE_ARRAYBUFFER
            ;; ArrayBuffer value: [TYPE_ARRAYBUFFER][0][dataPointer][0]
            ;; Supports: .byteLength
            (if (i32.eq (local.get $type1) (global.get $TYPE_ARRAYBUFFER))
              (then
                ;; object_pointer = dataPointer (points after GC header)
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_BYTE_LENGTH)))
                  (then
                    ;; Read byteLength from ArrayBuffer
                    ;; Layout: [GC:8][byteLength:4][bytes...]
                    ;; dataPointer points after GC header, so byteLength is at dataPointer + 0
                    (local.set $arr_len (i32.load (call $abs (local.get $object_pointer))))
                    (call $push_f64 (f64.convert_i32_u (local.get $arr_len)))
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )

                ;; Unknown property on ArrayBuffer - return undefined
                (call $pending_push
                  (global.get $TYPE_UNDEFINED)
                  (i32.const 0)
                  (i32.const 0)
                  (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Check if typed array (any typed array)
            ;; TypedArray value: [TYPE_*][0][descriptorPtr][0]
            ;; Descriptor: [bufferPtr:4][byteOffset:4][length:4]
            ;; Supports: .length, .byteLength, .byteOffset, .buffer, .BYTES_PER_ELEMENT
            (if (call $is_typed_array (local.get $type1))
              (then
                ;; Read from descriptor
                (local.set $element_pointer (call $value_data_lo (local.get $value_pointer)))  ;; descriptorPtr
                (local.set $data_pointer (i32.load (call $abs (local.get $element_pointer))))   ;; bufferPtr
                (local.set $index (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 4)))))  ;; byteOffset
                (local.set $arr_len (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 8)))))  ;; length in elements
                ;; Get BYTES_PER_ELEMENT for this type
                (local.set $result_lo (call $get_bytes_per_element (local.get $type1)))

                ;; .length - returns length of the typed array view (in elements)
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_LENGTH)))
                  (then
                    (call $push_f64 (f64.convert_i32_u (local.get $arr_len)))
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )

                ;; .byteLength - length * BYTES_PER_ELEMENT
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_BYTE_LENGTH)))
                  (then
                    (call $push_f64 (f64.convert_i32_u (i32.mul (local.get $arr_len) (local.get $result_lo))))
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )

                ;; .byteOffset
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_BYTE_OFFSET)))
                  (then
                    (call $push_f64 (f64.convert_i32_u (local.get $index)))
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )

                ;; .buffer - returns the underlying ArrayBuffer
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_BUFFER)))
                  (then
                    (call $pending_push
                      (global.get $TYPE_ARRAYBUFFER)
                      (i32.const 0)
                      (local.get $data_pointer)
                      (i32.const 0))
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )

                ;; .BYTES_PER_ELEMENT - returns element size for this type
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_BYTES_PER_ELEMENT)))
                  (then
                    (call $push_f64 (f64.convert_i32_u (local.get $result_lo)))
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )

                ;; Check for typed array methods - return TYPE_BOUND_METHOD
                ;; Format: type=BOUND_METHOD, flags=receiver_type, data_lo=descriptorPtr, data_hi=method_id
                ;; All typed arrays share the same method IDs
                (local.set $method_id (i32.const 0))

                ;; subarray
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_SUBARRAY)))
                  (then (local.set $method_id (global.get $METHOD_UINT8ARRAY_SUBARRAY))))
                ;; slice (reuse BUILTIN_SLICE from arrays)
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_SLICE)))
                  (then (local.set $method_id (global.get $METHOD_UINT8ARRAY_SLICE))))
                ;; fill
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_FILL)))
                  (then (local.set $method_id (global.get $METHOD_UINT8ARRAY_FILL))))
                ;; set
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_SET)))
                  (then (local.set $method_id (global.get $METHOD_UINT8ARRAY_SET))))
                ;; copyWithin
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_COPY_WITHIN)))
                  (then (local.set $method_id (global.get $METHOD_UINT8ARRAY_COPY_WITHIN))))
                ;; reverse (reuse BUILTIN_REVERSE from arrays)
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_REVERSE)))
                  (then (local.set $method_id (global.get $METHOD_UINT8ARRAY_REVERSE))))
                ;; indexOf (reuse BUILTIN_INDEX_OF from arrays)
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_INDEX_OF)))
                  (then (local.set $method_id (global.get $METHOD_UINT8ARRAY_INDEX_OF))))
                ;; lastIndexOf
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_LAST_INDEX_OF)))
                  (then (local.set $method_id (global.get $METHOD_UINT8ARRAY_LAST_INDEX_OF))))
                ;; includes (reuse BUILTIN_INCLUDES from arrays)
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_INCLUDES)))
                  (then (local.set $method_id (global.get $METHOD_UINT8ARRAY_INCLUDES))))
                ;; forEach (reuse BUILTIN_FOR_EACH from arrays)
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_FOR_EACH)))
                  (then (local.set $method_id (global.get $METHOD_UINT8ARRAY_FOR_EACH))))
                ;; map (reuse BUILTIN_MAP from arrays)
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_MAP)))
                  (then (local.set $method_id (global.get $METHOD_UINT8ARRAY_MAP))))
                ;; filter (reuse BUILTIN_FILTER from arrays)
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_FILTER)))
                  (then (local.set $method_id (global.get $METHOD_UINT8ARRAY_FILTER))))
                ;; find (reuse BUILTIN_FIND from arrays)
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_FIND)))
                  (then (local.set $method_id (global.get $METHOD_UINT8ARRAY_FIND))))
                ;; findIndex (reuse BUILTIN_FIND_INDEX from arrays)
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_FIND_INDEX)))
                  (then (local.set $method_id (global.get $METHOD_UINT8ARRAY_FIND_INDEX))))
                ;; findLast (reuse BUILTIN_FIND_LAST from arrays)
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_FIND_LAST)))
                  (then (local.set $method_id (global.get $METHOD_UINT8ARRAY_FIND_LAST))))
                ;; findLastIndex (reuse BUILTIN_FIND_LAST_INDEX from arrays)
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_FIND_LAST_INDEX)))
                  (then (local.set $method_id (global.get $METHOD_UINT8ARRAY_FIND_LAST_INDEX))))
                ;; every (reuse BUILTIN_EVERY from arrays)
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_EVERY)))
                  (then (local.set $method_id (global.get $METHOD_UINT8ARRAY_EVERY))))
                ;; some (reuse BUILTIN_SOME from arrays)
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_SOME)))
                  (then (local.set $method_id (global.get $METHOD_UINT8ARRAY_SOME))))
                ;; reduce (reuse BUILTIN_REDUCE from arrays)
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_REDUCE)))
                  (then (local.set $method_id (global.get $METHOD_UINT8ARRAY_REDUCE))))
                ;; reduceRight
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_REDUCE_RIGHT)))
                  (then (local.set $method_id (global.get $METHOD_UINT8ARRAY_REDUCE_RIGHT))))
                ;; at (reuse BUILTIN_AT from arrays; negative wraps)
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_AT)))
                  (then (local.set $method_id (global.get $METHOD_TYPED_ARRAY_AT))))
                ;; join (reuse BUILTIN_JOIN from arrays)
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_JOIN)))
                  (then (local.set $method_id (global.get $METHOD_UINT8ARRAY_JOIN))))
                ;; toString (same conversion as implicit coercion — join(","))
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_TO_STRING_NAME)))
                  (then (local.set $method_id (global.get $METHOD_UINT8ARRAY_TO_STRING))))
                ;; sort (reuse BUILTIN_SORT from arrays; default is NUMERIC ascending)
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_SORT)))
                  (then (local.set $method_id (global.get $METHOD_UINT8ARRAY_SORT))))
                ;; keys (iterator factory, kind 0)
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_SETLIKE_KEYS)))
                  (then (local.set $method_id (global.get $METHOD_TYPED_ARRAY_KEYS))))
                ;; values (=== the Symbol.iterator iterator, kind 1)
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_VALUES)))
                  (then (local.set $method_id (global.get $METHOD_TYPED_ARRAY_ITERATOR_FACTORY))))
                ;; entries (iterator factory, kind 2 — [index, value] pairs)
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_ENTRIES)))
                  (then (local.set $method_id (global.get $METHOD_TYPED_ARRAY_ENTRIES))))
                ;; toReversed (copying; the copy takes the window only)
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_TO_REVERSED)))
                  (then (local.set $method_id (global.get $METHOD_TYPED_ARRAY_TO_REVERSED))))
                ;; toSorted (copying; comparator form intercepted at CALL_METHOD)
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_TO_SORTED)))
                  (then (local.set $method_id (global.get $METHOD_TYPED_ARRAY_TO_SORTED))))
                ;; with (copying); toSpliced deliberately absent — typed
                ;; arrays are fixed-length, the spec has no toSpliced.
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_WITH_NAME)))
                  (then (local.set $method_id (global.get $METHOD_TYPED_ARRAY_WITH))))
                ;; toLocaleString — resolution-time alias for toString
                ;; (no locales in the sandbox).
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_TO_LOCALE_STRING)))
                  (then (local.set $method_id (global.get $METHOD_UINT8ARRAY_TO_STRING))))
                ;; If we found a method, push TYPE_BOUND_METHOD
                ;; Note: flags stores the receiver type so methods know which typed array they're on
                (if (i32.ne (local.get $method_id) (i32.const 0))
                  (then
                    (call $pending_push
                      (global.get $TYPE_BOUND_METHOD)
                      (local.get $type1)                  ;; flags = receiver type (TYPE_INT8ARRAY, etc.)
                      (local.get $element_pointer)        ;; data_lo = descriptor pointer
                      (local.get $method_id))             ;; data_hi = method ID
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )

                ;; Unknown property on typed array - return undefined
                (call $pending_push
                  (global.get $TYPE_UNDEFINED)
                  (i32.const 0)
                  (i32.const 0)
                  (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Check if TYPE_DATAVIEW
            ;; DataView value: [TYPE_DATAVIEW][0][descriptorPtr][0]
            ;; Descriptor: [bufferPtr:4][byteOffset:4][byteLength:4]
            ;; Supports: .buffer, .byteOffset, .byteLength, and all get*/set* methods
            (if (i32.eq (local.get $type1) (global.get $TYPE_DATAVIEW))
              (then
                ;; Read from descriptor
                (local.set $element_pointer (call $value_data_lo (local.get $value_pointer)))  ;; descriptorPtr
                (local.set $data_pointer (i32.load (call $abs (local.get $element_pointer))))   ;; bufferPtr
                (local.set $index (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 4)))))  ;; byteOffset
                (local.set $arr_len (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 8)))))  ;; byteLength

                ;; .byteLength
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_BYTE_LENGTH)))
                  (then
                    (call $push_f64 (f64.convert_i32_u (local.get $arr_len)))
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )

                ;; .byteOffset
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_BYTE_OFFSET)))
                  (then
                    (call $push_f64 (f64.convert_i32_u (local.get $index)))
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )

                ;; .buffer - returns the underlying ArrayBuffer
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_BUFFER)))
                  (then
                    (call $pending_push
                      (global.get $TYPE_ARRAYBUFFER)
                      (i32.const 0)
                      (local.get $data_pointer)
                      (i32.const 0))
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )

                ;; Check for DataView methods - return TYPE_BOUND_METHOD
                ;; Format: type=BOUND_METHOD, flags=TYPE_DATAVIEW, data_lo=descriptorPtr, data_hi=method_id
                (local.set $method_id (i32.const 0))

                ;; Getters
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_GET_INT8)))
                  (then (local.set $method_id (global.get $METHOD_DATAVIEW_GET_INT8))))
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_GET_UINT8)))
                  (then (local.set $method_id (global.get $METHOD_DATAVIEW_GET_UINT8))))
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_GET_INT16)))
                  (then (local.set $method_id (global.get $METHOD_DATAVIEW_GET_INT16))))
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_GET_UINT16)))
                  (then (local.set $method_id (global.get $METHOD_DATAVIEW_GET_UINT16))))
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_GET_INT32)))
                  (then (local.set $method_id (global.get $METHOD_DATAVIEW_GET_INT32))))
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_GET_UINT32)))
                  (then (local.set $method_id (global.get $METHOD_DATAVIEW_GET_UINT32))))
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_GET_FLOAT32)))
                  (then (local.set $method_id (global.get $METHOD_DATAVIEW_GET_FLOAT32))))
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_GET_FLOAT64)))
                  (then (local.set $method_id (global.get $METHOD_DATAVIEW_GET_FLOAT64))))

                ;; Setters
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_SET_INT8)))
                  (then (local.set $method_id (global.get $METHOD_DATAVIEW_SET_INT8))))
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_SET_UINT8)))
                  (then (local.set $method_id (global.get $METHOD_DATAVIEW_SET_UINT8))))
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_SET_INT16)))
                  (then (local.set $method_id (global.get $METHOD_DATAVIEW_SET_INT16))))
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_SET_UINT16)))
                  (then (local.set $method_id (global.get $METHOD_DATAVIEW_SET_UINT16))))
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_SET_INT32)))
                  (then (local.set $method_id (global.get $METHOD_DATAVIEW_SET_INT32))))
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_SET_UINT32)))
                  (then (local.set $method_id (global.get $METHOD_DATAVIEW_SET_UINT32))))
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_SET_FLOAT32)))
                  (then (local.set $method_id (global.get $METHOD_DATAVIEW_SET_FLOAT32))))
                (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_SET_FLOAT64)))
                  (then (local.set $method_id (global.get $METHOD_DATAVIEW_SET_FLOAT64))))

                ;; If we found a method, push TYPE_BOUND_METHOD
                (if (i32.ne (local.get $method_id) (i32.const 0))
                  (then
                    (call $pending_push
                      (global.get $TYPE_BOUND_METHOD)
                      (global.get $TYPE_DATAVIEW)             ;; flags = receiver type
                      (local.get $element_pointer)            ;; data_lo = descriptor pointer
                      (local.get $method_id))                 ;; data_hi = method ID
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )

                ;; Unknown property on DataView - return undefined
                (call $pending_push
                  (global.get $TYPE_UNDEFINED)
                  (i32.const 0)
                  (i32.const 0)
                  (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Check if TYPE_EXTERNAL (opaque external handle)
            ;; Member-access on an external: write a property request and yield
            ;; EXIT_EXTERNAL_PROPERTY. The host (JS airlock) decides what to push:
            ;;   - if a getter is registered, runs it and pushes the value
            ;;   - if not, pushes TYPE_EXTERNAL_METHOD (handleId + propertyOffset)
            ;;     to preserve the existing method-binding behavior
            ;; EXTERNAL_REQUEST layout (reused): [handleId:4][propertyOffset:4][argsPointer:4][argCount:4]
            ;; argsPointer and argCount are zero — property reads carry no args.
            (if (i32.eq (local.get $type1) (global.get $TYPE_EXTERNAL))
              (then
                ;; handleId
                (i32.store (call $abs (global.get $external_request_base))
                  (local.get $object_pointer))
                ;; propertyOffset (method-name slot reused)
                (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 4)))
                  (local.get $key_offset))
                ;; argsPointer = 0
                (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 8)))
                  (i32.const 0))
                ;; argCount = 0
                (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 12)))
                  (i32.const 0))
                ;; External handle VERSION at +16 (data_hi
                ;; of the receiver value). Lets the host reject a stale handle
                ;; value whose slot was reaped. 0 = legacy/unversioned → skipped.
                (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 16)))
                  (call $value_data_hi (local.get $value_pointer)))
                ;; extends-externals D5: +20 nonzero marks a BRANDED-instance
                ;; forward; a plain external read must clear it.
                (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 20)))
                  (i32.const 0))

                ;; Save state for resume (PC after this instruction).
                ;; Saving $current_scope is critical: SCOPE_PUSH mutates only the
                ;; WAT global; CTX_SCOPE is reloaded into the global at every
                ;; entry to wasm.exports.run. Without this write, the scope
                ;; chain rewinds to whatever CTX_SCOPE last held (e.g. the
                ;; pre-grant scope) on resume.
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX)
                  (i32.add (local.get $pc) (i32.const 1)))
                (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))

                ;; Set status to EXTERNAL_PROPERTY and exit
                (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_EXTERNAL_PROPERTY))
                (br $exit)
              )
            )

            ;; Check if TYPE_MSGPACK_REF (read-only msgpack data)
            (if (i32.eq (local.get $type1) (global.get $TYPE_MSGPACK_REF))
              (then
                ;; Layout A: data_lo = parent_data_ptr, data_hi = offset
                ;; object_pointer was set from value_data_lo (== parent_data_ptr)
                (local.set $mp_addr
                  (call $msgpack_ref_absolute (local.get $object_pointer) (call $value_data_hi (local.get $value_pointer))))
                (local.set $mp_end
                  (call $msgpack_ref_parent_end (local.get $object_pointer)))

                ;; Peek the msgpack type
                (local.set $mp_type (call $msgpack_peek_type (local.get $mp_addr) (local.get $mp_end)))
                (if (i32.eq (local.get $mp_type) (global.get $MSGPACK_ERROR))
                  (then
                    (if (call $raise_error (global.get $ERR_MSGPACK_INVALID) (i32.const 10))
                      (then (br $exit)))
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)
                  )
                )

                ;; If it's an array and property is "length", return array length
                (if (i32.eq (local.get $mp_type) (global.get $MSGPACK_ARRAY))
                  (then
                    (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_LENGTH)))
                      (then
                        ;; Count is in scratch from peek_type
                        (local.set $mp_count (call $msgpack_scratch_count))
                        (call $push_f64 (f64.convert_i32_u (local.get $mp_count)))
                        (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                        (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                        (br $loop)
                      )
                    )

                    ;; Check for array methods - return TYPE_BOUND_METHOD
                    (local.set $method_id (i32.const 0))

                    ;; map
                    (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_MAP)))
                      (then (local.set $method_id (global.get $METHOD_MAP))))
                    ;; filter
                    (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_FILTER)))
                      (then (local.set $method_id (global.get $METHOD_FILTER))))
                    ;; forEach
                    (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_FOR_EACH)))
                      (then (local.set $method_id (global.get $METHOD_FOR_EACH))))
                    ;; find
                    (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_FIND)))
                      (then (local.set $method_id (global.get $METHOD_FIND))))
                    ;; findIndex
                    (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_FIND_INDEX)))
                      (then (local.set $method_id (global.get $METHOD_FIND_INDEX))))
                    ;; findLast
                    (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_FIND_LAST)))
                      (then (local.set $method_id (global.get $METHOD_FIND_LAST))))
                    ;; findLastIndex
                    (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_FIND_LAST_INDEX)))
                      (then (local.set $method_id (global.get $METHOD_FIND_LAST_INDEX))))
                    ;; some
                    (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_SOME)))
                      (then (local.set $method_id (global.get $METHOD_SOME))))
                    ;; every
                    (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_EVERY)))
                      (then (local.set $method_id (global.get $METHOD_EVERY))))
                    ;; reduce
                    (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_REDUCE)))
                      (then (local.set $method_id (global.get $METHOD_REDUCE))))
                    ;; indexOf
                    (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_INDEX_OF)))
                      (then (local.set $method_id (global.get $METHOD_INDEX_OF))))
                    ;; includes
                    (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_INCLUDES)))
                      (then (local.set $method_id (global.get $METHOD_INCLUDES))))
                    ;; slice
                    (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_SLICE)))
                      (then (local.set $method_id (global.get $METHOD_SLICE))))
                    ;; keys / values / entries (iterator factories; the
                    ;; factory materializes the msgpack receiver)
                    (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_SETLIKE_KEYS)))
                      (then (local.set $method_id (global.get $METHOD_ARRAY_KEYS))))
                    (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_VALUES)))
                      (then (local.set $method_id (global.get $METHOD_ARRAY_ITERATOR_FACTORY))))
                    (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_ENTRIES)))
                      (then (local.set $method_id (global.get $METHOD_ARRAY_ENTRIES))))
                    ;; toReversed / toSorted / with / toSpliced (copying;
                    ;; each entry function materializes the msgpack
                    ;; receiver itself)
                    (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_TO_REVERSED)))
                      (then (local.set $method_id (global.get $METHOD_ARRAY_TO_REVERSED))))
                    (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_TO_SORTED)))
                      (then (local.set $method_id (global.get $METHOD_ARRAY_TO_SORTED))))
                    (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_WITH_NAME)))
                      (then (local.set $method_id (global.get $METHOD_ARRAY_WITH))))
                    (if (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_TO_SPLICED)))
                      (then (local.set $method_id (global.get $METHOD_ARRAY_TO_SPLICED))))

                    ;; If we found a method, push TYPE_BOUND_METHOD
                    (if (i32.ne (local.get $method_id) (i32.const 0))
                      (then
                        ;; BOUND_METHOD msgpack encoding (Layout A):
                        ;; flags = TYPE_MSGPACK_REF | (offset << 8)
                        ;; data_lo = parent_data_ptr, data_hi = method_id
                        (call $pending_push
                          (global.get $TYPE_BOUND_METHOD)
                          (i32.or
                            (global.get $TYPE_MSGPACK_REF)
                            (i32.shl (call $value_data_hi (local.get $value_pointer)) (i32.const 8)))
                          (local.get $object_pointer)
                          (local.get $method_id))
                        (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                        (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                        (br $loop)
                      )
                    )

                    ;; Array doesn't support other properties - return undefined
                    (call $pending_push
                      (global.get $TYPE_UNDEFINED)
                      (i32.const 0)
                      (i32.const 0)
                      (i32.const 0))
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )

                ;; If it's a map, search for the key
                (if (i32.eq (local.get $mp_type) (global.get $MSGPACK_MAP))
                  (then
                    ;; Call msgpack_map_get to find the key
                    (local.set $found
                      (call $msgpack_map_get
                        (local.get $mp_addr)
                        (local.get $mp_end)
                        (local.get $key_offset)))

                    (if (i32.eq (local.get $found) (i32.const -1))
                      (then
                        ;; Key not found - return undefined
                        (call $pending_push
                          (global.get $TYPE_UNDEFINED)
                          (i32.const 0)
                          (i32.const 0)
                          (i32.const 0))
                        (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                        (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                        (br $loop)
                      )
                    )

                    ;; found = address of value in msgpack
                    ;; Peek the value type
                    (local.set $mp_type (call $msgpack_peek_type (local.get $found) (local.get $mp_end)))
                    (if (i32.eq (local.get $mp_type) (global.get $MSGPACK_ERROR))
                      (then
                        (if (call $raise_error (global.get $ERR_MSGPACK_INVALID) (i32.const 11))
                          (then (br $exit)))
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop)
                      )
                    )

                    ;; For direct types (incl. bin → Uint8Array), read directly
                    (if (call $msgpack_is_direct_type (local.get $mp_type))
                      (then
                        (if (i32.eq (call $msgpack_read_primitive (local.get $found) (local.get $mp_end))
                                    (i32.const -1))
                          (then
                            ;; -1 with the pressure flag = refused
                            ;; allocation: un-consume the popped object
                            ;; operand and yield so the retry re-executes
                            ;; this GET_PROP. -1 with the flag clear =
                            ;; malformed input.
                            (if (global.get $memory_pressure_signaled)
                              (then
                                (call $write_ctx (global.get $CTX_PENDING_POINTER)
                                  (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE)))
                                (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                                (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                                (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                                (br $exit)
                              )
                            )
                            (if (call $raise_error (global.get $ERR_MSGPACK_INVALID) (i32.const 12))
                              (then (br $exit)))
                            (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                            (br $loop)
                          )
                        )
                        (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                        (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                        (br $loop)
                      )
                    )

                    ;; For containers (array/map), return new TYPE_MSGPACK_REF
                    ;; Layout A: data_lo = parent_data_ptr, data_hi = offset of found within parent
                    (call $pending_push
                      (global.get $TYPE_MSGPACK_REF)
                      (i32.const 0)
                      (local.get $object_pointer)
                      (call $msgpack_ref_offset_of (local.get $found) (local.get $object_pointer)))
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )

                ;; Not a map or array - can't access property, return undefined
                (call $pending_push
                  (global.get $TYPE_UNDEFINED)
                  (i32.const 0)
                  (i32.const 0)
                  (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Check for null/undefined - these should throw TypeError
            (if (i32.or
                  (i32.eq (local.get $type1) (global.get $TYPE_NULL))
                  (i32.eq (local.get $type1) (global.get $TYPE_UNDEFINED)))
              (then
                (if (call $throw_type_error_with_type
                  (if (result i32) (i32.eq (local.get $type1) (global.get $TYPE_NULL))
                    (then (global.get $BUILTIN_MSG_PROPERTY_OF_NULL))
                    (else (global.get $BUILTIN_MSG_PROPERTY_OF_UNDEFINED)))
                  (local.get $type1))
                  (then (br $exit))
                  (else
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)
                  )
                )
              )
            )

            ;; For other types (number, boolean), push undefined (match JS behavior)
            (call $pending_push
              (global.get $TYPE_UNDEFINED)
              (i32.const 0)
              (i32.const 0)
              (i32.const 0))
            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; =====================================================================
        ;; OP_CLASS_LINK: wire class inheritance edges (class-support slice 1)
        ;; Stack: [parent_constructor, class_constructor] → [class_constructor]
        ;; Two writes:
        ;;   class.[[proto]]           = parent            (static inheritance)
        ;;   class.prototype.[[proto]] = parent.prototype  (instance inheritance)
        ;; The parent must be a plain (non-arrow, non-async, non-generator)
        ;; SandScript function whose .prototype is an object, an allowlisted
        ;; built-in constructor, or a TYPE_EXTERNAL handle the host
        ;; registered constructible (airlock.setConstructible — the branch
        ;; below yields so the airlock can read the membrane registration
        ;; and intern the surrogate prototype); anything else throws a
        ;; catchable TypeError.
        ;; Both proto slots hold HEADER pointers; the collectors already trace
        ;; and forward the object-header prototype slot for OBJ_OBJECT and
        ;; OBJ_FUNCTION via the shared object-header walkers.
        ;; =====================================================================
        (if (i32.eq (local.get $opcode) (global.get $OP_CLASS_LINK))
          (then
            (local.set $value_pointer2 (call $pending_pop))  ;; class ctor (top)
            (local.set $value_pointer (call $pending_pop))   ;; parent ctor
            (local.set $type2 (call $value_type (local.get $value_pointer2)))
            (local.set $type1 (call $value_type (local.get $value_pointer)))

            ;; extends-externals D2: TYPE_EXTERNAL parent. Constructible
            ;; registration and the surrogate binding live in the
            ;; membrane, which the interpreter cannot read — the first
            ;; dispatch yields EXIT_CLASS_LINK_EXTERNAL with the handle
            ;; slot; the airlock validates the registration (unregistered
            ;; → catchable "This external cannot be extended"), checks the
            ;; context holds the handle's grant, interns ONE surrogate
            ;; prototype per handle, stages its pointer in the request
            ;; block (+8 marker, +12 pointer), and resumes this same pc.
            ;; No host/capability code runs; linking stays synchronous.
            (if (i32.eq (local.get $type1) (global.get $TYPE_EXTERNAL))
              (then
                (if (i32.and
                      (i32.eq (i32.load (call $abs (i32.add (global.get $external_request_base) (i32.const 8)))) (i32.const 1))
                      (i32.eq (i32.load (call $abs (global.get $external_request_base)))
                        (call $value_data_lo (local.get $value_pointer))))
                  (then
                    ;; Phase 2: wire ONLY the instance edge —
                    ;; class.prototype.[[proto]] = surrogate. class.[[proto]]
                    ;; stays unchanged (D2 step 5: no host static
                    ;; inheritance; a static miss resolves through the
                    ;; normal function static chain and never exits the vat).
                    (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 8))) (i32.const 0))
                    (local.set $receiver_pointer
                      (i32.load (call $abs (i32.add (global.get $external_request_base) (i32.const 12)))))
                    (if (i32.ne (local.get $type2) (global.get $TYPE_FUNCTION))
                      (then
                        (if (call $throw_type_error_with_type (global.get $BUILTIN_MSG_NOT_A_FUNCTION) (local.get $type2))
                          (then (br $exit))
                          (else
                            (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                            (br $loop)
                          )
                        )
                      )
                    )
                    (local.set $object_pointer (call $value_data_lo (local.get $value_pointer2)))
                    (local.set $key_offset (call $read_builtin (global.get $BUILTIN_PROTOTYPE)))
                    (local.set $entry_pointer (call $object_find_string_entry
                      (local.get $object_pointer) (local.get $key_offset)))
                    (if (i32.or
                          (i32.eqz (local.get $entry_pointer))
                          (i32.ne
                            (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 4))))
                            (global.get $TYPE_OBJECT)))
                      (then
                        (if (call $throw_type_error_with_type (global.get $BUILTIN_MSG_NOT_AN_OBJECT) (i32.const 0))
                          (then (br $exit))
                          (else
                            (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                            (br $loop)
                          )
                        )
                      )
                    )
                    ;; class.prototype.[[proto]] = surrogate (HEADER ptrs)
                    (i32.store
                      (call $abs (i32.add
                        (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 12))))
                        (i32.const 8)))
                      (local.get $receiver_pointer))
                    ;; Push the class constructor back
                    (call $pending_push
                      (local.get $type2)
                      (call $value_flags (local.get $value_pointer2))
                      (local.get $object_pointer)
                      (call $value_data_hi (local.get $value_pointer2)))
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                  (else
                    ;; Phase 1: restore operands and yield at this pc.
                    (call $pending_push (local.get $type1) (call $value_flags (local.get $value_pointer))
                      (call $value_data_lo (local.get $value_pointer)) (call $value_data_hi (local.get $value_pointer)))
                    (call $pending_push (local.get $type2) (call $value_flags (local.get $value_pointer2))
                      (call $value_data_lo (local.get $value_pointer2)) (call $value_data_hi (local.get $value_pointer2)))
                    (i32.store (call $abs (global.get $external_request_base))
                      (call $value_data_lo (local.get $value_pointer)))
                    (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 4)))
                      (call $value_data_hi (local.get $value_pointer)))
                    (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 8))) (i32.const 0))
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_CLASS_LINK_EXTERNAL))
                    (br $exit)
                  )
                )
              )
            )

            ;; The class (top) must be a SandScript function. The parent is
            ;; an arbitrary heritage expression: a SandScript function, or an
            ;; allowlisted built-in constructor whose instances are plain
            ;; objects, currently the Error family and Object.
            (if (i32.or
                  (i32.and
                    (i32.ne (local.get $type1) (global.get $TYPE_FUNCTION))
                    (i32.ne (local.get $type1) (global.get $TYPE_CONSTRUCTOR)))
                  (i32.ne (local.get $type2) (global.get $TYPE_FUNCTION)))
              (then
                (if (call $throw_type_error_with_type (global.get $BUILTIN_MSG_NOT_A_FUNCTION) (local.get $type1))
                  (then (br $exit))
                  (else
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)
                  )
                )
              )
            )

            ;; Parent header: function closure, or the constructor's statics
            ;; object — both carry ordinary object entries, so the static
            ;; inheritance edge below works for either kind.
            (local.set $closure_pointer (call $value_data_lo (local.get $value_pointer)))
            (local.set $object_pointer (call $value_data_lo (local.get $value_pointer2)))   ;; class header

            (if (i32.eq (local.get $type1) (global.get $TYPE_CONSTRUCTOR))
              (then
                ;; Built-in parent: allowlist by method id. Only built-ins
                ;; whose instances are plain objects qualify; exotic-instance
                ;; built-ins (Map, Set, Array, typed arrays, RegExp, Promise)
                ;; would need chain-driven exotic allocation plus per-instance
                ;; prototype overrides — reject loudly. Do NOT key this on
                ;; $constructor_method_id_to_prototype returning nonzero: the
                ;; conversion functions (String, Number, Boolean) map to
                ;; Object.prototype there and would silently link a wrong chain.
                (local.set $method_id (call $value_data_hi (local.get $value_pointer)))
                (if (i32.eqz (i32.or
                      (i32.or
                        (i32.or
                          (i32.eq (local.get $method_id) (global.get $METHOD_ERROR_CONSTRUCTOR))
                          (i32.eq (local.get $method_id) (global.get $METHOD_TYPE_ERROR_CONSTRUCTOR)))
                        (i32.or
                          (i32.eq (local.get $method_id) (global.get $METHOD_REFERENCE_ERROR_CONSTRUCTOR))
                          (i32.eq (local.get $method_id) (global.get $METHOD_RANGE_ERROR_CONSTRUCTOR))))
                      (i32.or
                        (i32.eq (local.get $method_id) (global.get $METHOD_SYNTAX_ERROR_CONSTRUCTOR))
                        (i32.eq (local.get $method_id) (global.get $METHOD_OBJECT_CONSTRUCTOR)))))
                  (then
                    (if (call $throw_type_error_with_message (global.get $BUILTIN_MSG_NOT_EXTENSIBLE))
                      (then (br $exit))
                      (else
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop)
                      )
                    )
                  )
                )
                ;; parent.prototype via the method-id table (never 0 for the
                ;; allowlisted ids).
                (local.set $receiver_pointer
                  (call $constructor_method_id_to_prototype (local.get $method_id)))
              )
              (else
                ;; SandScript-function parent: must be constructible — reject
                ;; arrow / async / generator.
                (local.set $closure_flags (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 44)))))
                (if (i32.and (local.get $closure_flags)
                      (i32.or (global.get $CLOSURE_FLAG_ARROW)
                        (i32.or (global.get $CLOSURE_FLAG_ASYNC) (global.get $CLOSURE_FLAG_GENERATOR))))
                  (then
                    (if (call $throw_type_error_with_type (global.get $BUILTIN_MSG_NOT_A_FUNCTION) (local.get $type1))
                      (then (br $exit))
                      (else
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop)
                      )
                    )
                  )
                )

                ;; Resolve parent.prototype — must be an object.
                (local.set $key_offset (call $read_builtin (global.get $BUILTIN_PROTOTYPE)))
                (local.set $entry_pointer (call $object_find_string_entry
                  (local.get $closure_pointer) (local.get $key_offset)))
                (if (i32.or
                      (i32.eqz (local.get $entry_pointer))
                      (i32.ne
                        (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 4))))
                        (global.get $TYPE_OBJECT)))
                  (then
                    (if (call $throw_type_error_with_type (global.get $BUILTIN_MSG_NOT_AN_OBJECT) (i32.const 0))
                      (then (br $exit))
                      (else
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop)
                      )
                    )
                  )
                )
                (local.set $receiver_pointer (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 12)))))
              )
            )

            ;; Resolve class.prototype — parser-guaranteed, validated anyway.
            (local.set $key_offset (call $read_builtin (global.get $BUILTIN_PROTOTYPE)))

            (local.set $entry_pointer (call $object_find_string_entry
              (local.get $object_pointer) (local.get $key_offset)))
            (if (i32.or
                  (i32.eqz (local.get $entry_pointer))
                  (i32.ne
                    (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 4))))
                    (global.get $TYPE_OBJECT)))
              (then
                (if (call $throw_type_error_with_type (global.get $BUILTIN_MSG_NOT_AN_OBJECT) (i32.const 0))
                  (then (br $exit))
                  (else
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)
                  )
                )
              )
            )

            ;; class.prototype.[[proto]] = parent.prototype (both HEADER ptrs)
            (i32.store
              (call $abs (i32.add
                (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 12))))
                (i32.const 8)))
              (local.get $receiver_pointer))

            ;; class.[[proto]] = parent (static member inheritance)
            (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 8)))
              (local.get $closure_pointer))

            ;; Push the class constructor back
            (call $pending_push
              (local.get $type2)
              (call $value_flags (local.get $value_pointer2))
              (local.get $object_pointer)
              (call $value_data_hi (local.get $value_pointer2)))

            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; ==================================================================
        ;; GET_SUPER: super property read.
        ;; operand1 = property name (string offset).
        ;; Stack: [receiver, start] -> [receiver, value].
        ;; The lookup walks the prototype chain FROM `start` (the parent
        ;; prototype for instance members, the parent constructor for
        ;; statics), so it skips the receiver's own class level. An
        ;; accessor's getter runs with `this` = receiver — the receiver
        ;; stays on the stack under the result: the parser consumes it
        ;; (CALL_METHOD for `super.m(...)`) or drops it (SWAP + POP for a
        ;; plain read).
        ;; ==================================================================
        (if (i32.eq (local.get $opcode) (global.get $OP_GET_SUPER))
          (then
            (local.set $key_offset (local.get $operand1))
            ;; Pop start; the receiver stays below.
            (local.set $value_pointer (call $pending_pop))
            (local.set $type1 (call $value_type (local.get $value_pointer)))
            ;; TYPE_CONSTRUCTOR: static member of a class extending a
            ;; built-in — data_lo is the constructor's statics object, an
            ;; ordinary object header, so the chain walk below is unchanged.
            (if (i32.eqz (i32.or
                  (i32.eq (local.get $type1) (global.get $TYPE_OBJECT))
                  (i32.or
                    (i32.eq (local.get $type1) (global.get $TYPE_FUNCTION))
                    (i32.eq (local.get $type1) (global.get $TYPE_CONSTRUCTOR)))))
              (then
                (if (call $throw_type_error_with_type (global.get $BUILTIN_MSG_NOT_AN_OBJECT) (local.get $type1))
                  (then (br $exit)))
                (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                (br $loop)))
            (local.set $entry_pointer (call $object_find_string_entry
              (call $value_data_lo (local.get $value_pointer)) (local.get $key_offset)))
            (if (i32.eqz (local.get $entry_pointer))
              (then
                (call $pending_push (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)))
            (if (i32.eq
                  (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 4))))
                  (global.get $TYPE_ACCESSOR))
              (then
                ;; Getter half (data_lo). Missing getter reads as undefined.
                (local.set $closure_pointer
                  (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 12)))))
                (if (i32.eqz (local.get $closure_pointer))
                  (then
                    (call $pending_push (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)))
                ;; Invoke the getter with `this` = the receiver (stack top).
                ;; Pending base = the current pointer, so the return value
                ;; lands directly above the preserved receiver.
                (local.set $value_pointer2 (call $pending_peek))
                (local.set $stack_pointer (call $read_ctx (global.get $CTX_CALL_STACK_POINTER)))
                (local.set $frame_pointer (call $abs (local.get $stack_pointer)))
                (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_INSTRUCTION_INDEX))
                  (i32.add (local.get $pc) (i32.const 1)))
                (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_SCOPE_POINTER))
                  (global.get $current_scope))
                (call $save_frame_pending_base (local.get $frame_pointer)
                  (call $read_ctx (global.get $CTX_PENDING_POINTER)))
                (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_PENDING_COUNT)) (i32.const 1))
                (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_FLAGS)) (i32.const 0))
                (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_AST_NODE)) (i32.const 0))
                (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_ASYNC_PROMISE)) (i32.const 0))
                (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_ARGC)) (i32.const 0))
                (call $write_ctx (global.get $CTX_CALL_STACK_POINTER)
                  (i32.add (local.get $stack_pointer) (global.get $FRAME_SIZE)))
                (local.set $new_scope (call $scope_create
                  (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 40))))))
                (global.set $current_scope (local.get $new_scope))
                (call $scope_define
                  (local.get $new_scope)
                  (call $read_builtin (i32.const 0x18))   ;; BUILTIN_NAME.THIS
                  (call $value_type (local.get $value_pointer2)) (i32.const 0)
                  (call $value_data_lo (local.get $value_pointer2)) (i32.const 0))
                (call $scope_define_new_target (local.get $new_scope)
                  (global.get $TYPE_UNDEFINED) (i32.const 0))
                (local.set $pc (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 32)))))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)))
            ;; Data property on the chain: push its value.
            (call $pending_push
              (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 4))))
              (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 8))))
              (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 12))))
              (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 16)))))
            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; ==================================================================
        ;; SET_SUPER: super property write.
        ;; operand1 = property name (string offset).
        ;; Stack: [receiver, start, value] -> [value].
        ;; An accessor found walking the chain FROM `start` intercepts: its
        ;; setter runs with `this` = receiver (a missing setter half is a
        ;; silent no-op, JS non-strict). Anything else — data property or
        ;; miss — defines/updates an OWN property on the receiver, which is
        ;; JavaScript's `super.x = v` semantics.
        ;; ==================================================================
        (if (i32.eq (local.get $opcode) (global.get $OP_SET_SUPER))
          (then
            (local.set $key_offset (local.get $operand1))
            ;; Pop value.
            (local.set $value_pointer (call $pending_pop))
            (local.set $set_val_type (i32.load (call $abs (local.get $value_pointer))))
            (local.set $set_val_flags (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 4)))))
            (local.set $set_val_lo (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 8)))))
            (local.set $set_val_hi (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 12)))))
            ;; Pop start.
            (local.set $value_pointer2 (call $pending_pop))
            (local.set $type2 (call $value_type (local.get $value_pointer2)))
            ;; TYPE_CONSTRUCTOR accepted for the same reason as GET_SUPER:
            ;; a static member of a class extending a built-in.
            (if (i32.eqz (i32.or
                  (i32.eq (local.get $type2) (global.get $TYPE_OBJECT))
                  (i32.or
                    (i32.eq (local.get $type2) (global.get $TYPE_FUNCTION))
                    (i32.eq (local.get $type2) (global.get $TYPE_CONSTRUCTOR)))))
              (then
                (if (call $throw_type_error_with_type (global.get $BUILTIN_MSG_NOT_AN_OBJECT) (local.get $type2))
                  (then (br $exit)))
                (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                (br $loop)))
            ;; Pop receiver.
            (local.set $value_pointer3 (call $pending_pop))
            (local.set $type1 (call $value_type (local.get $value_pointer3)))
            (local.set $object_pointer (call $value_data_lo (local.get $value_pointer3)))
            ;; The assignment's result value lands at the receiver's slot.
            (call $pending_push (local.get $set_val_type) (local.get $set_val_flags)
              (local.get $set_val_lo) (local.get $set_val_hi))
            (local.set $entry_pointer (call $object_find_string_entry
              (call $value_data_lo (local.get $value_pointer2)) (local.get $key_offset)))
            (if (call $entry_value_is_accessor (local.get $entry_pointer))
              (then
                ;; Setter closure = the accessor entry's data_hi. A missing
                ;; setter half silently ignores the write.
                (local.set $closure_pointer
                  (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 16)))))
                (if (i32.eqz (local.get $closure_pointer))
                  (then
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)))
                ;; Invoke the setter: push the value again as its one
                ;; argument, push a DISCARD_RESULT frame, bind `this` to the
                ;; receiver.
                (call $pending_push (local.get $set_val_type) (local.get $set_val_flags)
                  (local.get $set_val_lo) (local.get $set_val_hi))
                (local.set $stack_pointer (call $read_ctx (global.get $CTX_CALL_STACK_POINTER)))
                (local.set $frame_pointer (call $abs (local.get $stack_pointer)))
                (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_INSTRUCTION_INDEX))
                  (i32.add (local.get $pc) (i32.const 1)))
                (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_SCOPE_POINTER))
                  (global.get $current_scope))
                (call $save_frame_pending_base (local.get $frame_pointer)
                  (i32.sub (call $read_ctx (global.get $CTX_PENDING_POINTER)) (global.get $VALUE_SIZE)))
                (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_PENDING_COUNT)) (i32.const 1))
                (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_FLAGS)) (global.get $FRAME_FLAG_DISCARD_RESULT))
                (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_AST_NODE)) (i32.const 0))
                (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_ASYNC_PROMISE)) (i32.const 0))
                (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_ARGC)) (i32.const 1))
                (call $write_ctx (global.get $CTX_CALL_STACK_POINTER)
                  (i32.add (local.get $stack_pointer) (global.get $FRAME_SIZE)))
                (local.set $new_scope (call $scope_create
                  (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 40))))))
                (global.set $current_scope (local.get $new_scope))
                (call $scope_define
                  (local.get $new_scope)
                  (call $read_builtin (i32.const 0x18))   ;; BUILTIN_NAME.THIS
                  (local.get $type1) (i32.const 0)
                  (local.get $object_pointer) (i32.const 0))
                (call $scope_define_new_target (local.get $new_scope)
                  (global.get $TYPE_UNDEFINED) (i32.const 0))
                (local.set $pc (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 32)))))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)))
            ;; Data property or miss: define/update an OWN property on the
            ;; receiver (status droppable — the write either lands or the
            ;; error state is already set by the helper).
            (drop (call $object_set_property
              (local.get $object_pointer) (local.get $key_offset)
              (local.get $set_val_type) (local.get $set_val_flags)
              (local.get $set_val_lo) (local.get $set_val_hi)))
            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; SET_PROP: operand1 = property name (string offset), pop value, pop object
        ;; Set obj.prop = value, push value back
        (if (i32.eq (local.get $opcode) (global.get $OP_SET_PROP))
          (then
            (local.set $key_offset (local.get $operand1))

            ;; Pop value to store
            (local.set $value_pointer (call $pending_pop))
            (local.set $set_val_type (i32.load (call $abs (local.get $value_pointer))))
            (local.set $set_val_flags (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 4)))))
            (local.set $set_val_lo (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 8)))))
            (local.set $set_val_hi (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 12)))))

            ;; Pop object
            (local.set $value_pointer2 (call $pending_pop))
            (local.set $type1 (call $value_type (local.get $value_pointer2)))
            (local.set $object_pointer (call $value_data_lo (local.get $value_pointer2)))

            ;; Check if TYPE_EXTERNAL (opaque external handle) — the write-side
            ;; twin of the EXIT_EXTERNAL_PROPERTY read path. Member-assignment
            ;; on an external: write a property-set request and yield
            ;; EXIT_EXTERNAL_PROPERTY_SET. The host (JS airlock) runs a
            ;; registered setter (or throws if none); a property write returns
            ;; nothing to the drone, so the host resumes the slot with the
            ;; assigned value (assignment is an expression).
            ;;
            ;; EXTERNAL_REQUEST layout (reused, same as the call/read paths):
            ;;   [handleId:4][propertyOffset:4][argsPointer:4][argCount:4]
            ;; The assigned value carries as a single arg: it still physically
            ;; sits at $value_pointer (pending_pop only moved the pointer, it
            ;; did not clear the slot), so argsPointer = $value_pointer,
            ;; argCount = 1. The host unmarshals it exactly like a method-call
            ;; argument.
            (if (i32.eq (local.get $type1) (global.get $TYPE_EXTERNAL))
              (then
                ;; handleId = the external handle's slot
                (i32.store (call $abs (global.get $external_request_base))
                  (local.get $object_pointer))
                ;; propertyOffset (method-name slot reused) = property name
                (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 4)))
                  (local.get $key_offset))
                ;; argsPointer = the assigned value's slot
                (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 8)))
                  (local.get $value_pointer))
                ;; argCount = 1 (the single assigned value)
                (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 12)))
                  (i32.const 1))
                ;; External handle VERSION at +16 (data_hi
                ;; of the receiver value $value_pointer2). 0 = legacy → skipped.
                (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 16)))
                  (call $value_data_hi (local.get $value_pointer2)))
                ;; extends-externals D5: clear the branded-forward marker.
                (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 20)))
                  (i32.const 0))

                ;; Save state for resume (PC after this instruction). Saving
                ;; $current_scope is critical for the same reason as the read
                ;; path: SCOPE_PUSH mutates only the WAT global, and CTX_SCOPE
                ;; is reloaded at every entry to run.
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX)
                  (i32.add (local.get $pc) (i32.const 1)))
                (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))

                ;; Pre-position the pending pointer to the object's (now-popped)
                ;; slot, where the host's resumeWithValue lands the assigned
                ;; value. An assignment evaluates to the assigned value, so the
                ;; expression leaves exactly one value on the pending stack —
                ;; mirroring the normal SET_PROP "push value back" at the end of
                ;; this handler.
                (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $value_pointer2))

                ;; Set status to EXTERNAL_PROPERTY_SET and exit
                (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_EXTERNAL_PROPERTY_SET))
                (br $exit)
              )
            )

            ;; Check if msgpack ref (read-only, cannot assign)
            (if (i32.eq (local.get $type1) (global.get $TYPE_MSGPACK_REF))
              (then
                (if (call $raise_error (global.get $ERR_MSGPACK_READONLY) (local.get $type1))
                  (then (br $exit)))
                (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                (br $loop)
              )
            )

            ;; RegExp: only .lastIndex is writable, and the dialect requires
            ;; a non-negative integer (JS's silent store-anything is a
            ;; weird-corner we reject loudly). Other keys fall through to
            ;; the not-an-object TypeError below.
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_REGEXP))
                  (i32.eq (local.get $key_offset) (call $read_builtin (global.get $BUILTIN_LAST_INDEX))))
              (then
                ;; Numeric validation mirrors new Array(length): integral,
                ;; in u32 range. Reuses the popped value slot ($value_pointer
                ;; still points at intact bytes).
                (if (i32.eqz (call $value_is_numeric (local.get $value_pointer)))
                  (then
                    (if (call $throw_type_error_with_message
                          (global.get $BUILTIN_MSG_REGEXP_LAST_INDEX))
                      (then (br $exit))
                      (else
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop)))))
                (local.set $result_f64 (call $value_to_f64 (local.get $value_pointer)))
                (if (i32.or
                      (f64.ne (f64.trunc (local.get $result_f64)) (local.get $result_f64))
                      (i32.or
                        (f64.lt (local.get $result_f64) (f64.const 0))
                        (f64.ge (local.get $result_f64) (f64.const 4294967296))))
                  (then
                    (if (call $throw_range_error_with_message
                          (global.get $BUILTIN_MSG_REGEXP_LAST_INDEX))
                      (then (br $exit))
                      (else
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop)))))
                (i32.store
                  (call $abs (i32.add
                    (i32.add (local.get $object_pointer) (global.get $GC_HEADER_SIZE))
                    (global.get $REGEXP_LAST_INDEX)))
                  (i32.trunc_f64_u (local.get $result_f64)))
                ;; Assignment evaluates to the assigned value.
                (call $pending_push
                  (local.get $set_val_type) (local.get $set_val_flags)
                  (local.get $set_val_lo) (local.get $set_val_hi))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)))

            ;; Check if object or function (functions can have properties)
            (if (i32.and
                  (i32.ne (local.get $type1) (global.get $TYPE_OBJECT))
                  (i32.ne (local.get $type1) (global.get $TYPE_FUNCTION)))
              (then
                (if (call $throw_type_error_with_type (global.get $BUILTIN_MSG_NOT_AN_OBJECT) (local.get $type1))
                  (then (br $exit))
                  (else
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)
                  )
                )
              )
            )

            ;; Check if object is frozen (flags at offset 0x14)
            (if (i32.and
                  (i32.load (call $abs (i32.add (local.get $object_pointer) (i32.const 0x14))))
                  (global.get $OBJECT_FLAG_FROZEN))
              (then
                (if (call $throw_type_error_with_type (global.get $BUILTIN_MSG_FROZEN_OBJECT) (i32.const 0))
                  (then (br $exit))
                  (else
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)
                  )
                )
              )
            )

            ;; Object/Function layout: [GC:8][prototype:4][count:4][capacity:4][flags:4][entries:4]
            (local.set $obj_count (i32.load (call $abs (i32.add (local.get $object_pointer) (i32.const 12)))))
            (local.set $obj_cap (i32.load (call $abs (i32.add (local.get $object_pointer) (i32.const 16)))))
            (local.set $entries_pointer (i32.load (call $abs (i32.add (local.get $object_pointer) (i32.const 24)))))

            ;; Search for existing property
            (local.set $i (i32.const 0))
            (local.set $found (i32.const 0))
            (block $prop_set_found
              (loop $prop_set_loop
                (br_if $prop_set_found (i32.ge_u (local.get $i) (local.get $obj_count)))

                ;; entry_pointer = entries_pointer + 8 + i * ENTRY_SIZE
                (local.set $entry_pointer (i32.add
                  (i32.add (local.get $entries_pointer) (global.get $GC_HEADER_SIZE))
                  (i32.mul (local.get $i) (global.get $ENTRY_SIZE))))

                (local.set $prop_key (i32.load (call $abs (local.get $entry_pointer))))

                (if (i32.eq (local.get $prop_key) (local.get $key_offset))
                  (then
                    (if (i32.eq
                          (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 4))))
                          (global.get $TYPE_ACCESSOR))
                      (then
                        ;; Accessor definition over an accessor: merge halves
                        ;; (nonzero incoming halves win) — `{get x(){}}` then
                        ;; a later `set x` keeps both.
                        (if (i32.eq (local.get $set_val_type) (global.get $TYPE_ACCESSOR))
                          (then
                            (if (i32.ne (local.get $set_val_lo) (i32.const 0))
                              (then (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 12))) (local.get $set_val_lo))))
                            (if (i32.ne (local.get $set_val_hi) (i32.const 0))
                              (then (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 16))) (local.get $set_val_hi))))
                            (local.set $found (i32.const 1))
                            (br $prop_set_found)
                          )
                        )
                        ;; Plain assignment onto an accessor property: invoke
                        ;; the setter with `this` = the receiver and the value
                        ;; as its argument. The assignment's result value is
                        ;; pushed first (at the popped receiver's slot); the
                        ;; frame's DISCARD flag drops the setter's return so
                        ;; the stack ends as [value], same as a data write.
                        (local.set $closure_pointer
                          (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 16)))))
                        (call $pending_push (local.get $set_val_type) (local.get $set_val_flags)
                          (local.get $set_val_lo) (local.get $set_val_hi))
                        ;; No setter half: JS non-strict silently ignores the
                        ;; write; the expression still evaluates to the value.
                        (if (i32.eqz (local.get $closure_pointer))
                          (then
                            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                            (br $loop)
                          )
                        )
                        (call $pending_push (local.get $set_val_type) (local.get $set_val_flags)
                          (local.get $set_val_lo) (local.get $set_val_hi))
                        (local.set $stack_pointer (call $read_ctx (global.get $CTX_CALL_STACK_POINTER)))
                        (local.set $frame_pointer (call $abs (local.get $stack_pointer)))
                        (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_INSTRUCTION_INDEX))
                          (i32.add (local.get $pc) (i32.const 1)))
                        (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_SCOPE_POINTER))
                          (global.get $current_scope))
                        (call $save_frame_pending_base (local.get $frame_pointer)
                          (i32.sub (call $read_ctx (global.get $CTX_PENDING_POINTER)) (global.get $VALUE_SIZE)))
                        (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_PENDING_COUNT)) (i32.const 1))
                        (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_FLAGS)) (global.get $FRAME_FLAG_DISCARD_RESULT))
                        (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_AST_NODE)) (i32.const 0))
                        (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_ASYNC_PROMISE)) (i32.const 0))
                        (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_ARGC)) (i32.const 1))
                        (call $write_ctx (global.get $CTX_CALL_STACK_POINTER)
                          (i32.add (local.get $stack_pointer) (global.get $FRAME_SIZE)))
                        (local.set $new_scope (call $scope_create
                          (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 40))))))
                        (global.set $current_scope (local.get $new_scope))
                        (call $scope_define
                          (local.get $new_scope)
                          (call $read_builtin (i32.const 0x18))   ;; BUILTIN_NAME.THIS
                          (local.get $type1) (i32.const 0)
                          (local.get $object_pointer) (i32.const 0))
                        (call $scope_define_new_target (local.get $new_scope)
                          (global.get $TYPE_UNDEFINED) (i32.const 0))
                        (local.set $pc (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 32)))))
                        (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                        (br $loop)
                      )
                    )
                    ;; Found! Update the value in place
                    (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 4))) (local.get $set_val_type))
                    (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 8))) (local.get $set_val_flags))
                    (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 12))) (local.get $set_val_lo))
                    (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 16))) (local.get $set_val_hi))
                    (local.set $found (i32.const 1))
                    (br $prop_set_found)
                  )
                )

                (local.set $i (i32.add (local.get $i) (i32.const 1)))
                (br $prop_set_loop)
              )
            )

            ;; If not found, add new property
            (if (i32.eqz (local.get $found))
              (then
                ;; Inherited-accessor walk (class-support slice 1): an own
                ;; miss must consult the prototype chain before creating an
                ;; own property — an inherited accessor's setter intercepts
                ;; the write with `this` = the receiver. An incoming
                ;; TYPE_ACCESSOR value is a DEFINITION (WRAP_GETTER /
                ;; WRAP_SETTER emission), never a write — it always defines
                ;; an own property, skipping the walk. An inherited DATA
                ;; property keeps the own-create (shadowing) behavior.
                (if (i32.ne (local.get $set_val_type) (global.get $TYPE_ACCESSOR))
                  (then
                    (local.set $entry_pointer (call $object_find_string_entry
                      (i32.load (call $abs (i32.add (local.get $object_pointer) (i32.const 8))))
                      (local.get $key_offset)))
                    (if (i32.and
                          (i32.ne (local.get $entry_pointer) (i32.const 0))
                          (i32.eq
                            (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 4))))
                            (global.get $TYPE_ACCESSOR)))
                      (then
                        ;; Setter closure = the accessor entry's data_hi.
                        (local.set $closure_pointer
                          (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 16)))))
                        ;; Assignment result value first (lands at the popped
                        ;; receiver's slot — same shape as the own-accessor
                        ;; path above).
                        (call $pending_push (local.get $set_val_type) (local.get $set_val_flags)
                          (local.get $set_val_lo) (local.get $set_val_hi))
                        ;; No setter half: JS non-strict silently ignores the
                        ;; write; the expression still evaluates to the value.
                        (if (i32.eqz (local.get $closure_pointer))
                          (then
                            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                            (br $loop)
                          )
                        )
                        ;; Invoke the setter: push the value again as its one
                        ;; argument, push a DISCARD_RESULT frame, bind `this`
                        ;; to the ORIGINAL receiver (not the prototype that
                        ;; owns the accessor).
                        (call $pending_push (local.get $set_val_type) (local.get $set_val_flags)
                          (local.get $set_val_lo) (local.get $set_val_hi))
                        (local.set $stack_pointer (call $read_ctx (global.get $CTX_CALL_STACK_POINTER)))
                        (local.set $frame_pointer (call $abs (local.get $stack_pointer)))
                        (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_INSTRUCTION_INDEX))
                          (i32.add (local.get $pc) (i32.const 1)))
                        (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_SCOPE_POINTER))
                          (global.get $current_scope))
                        (call $save_frame_pending_base (local.get $frame_pointer)
                          (i32.sub (call $read_ctx (global.get $CTX_PENDING_POINTER)) (global.get $VALUE_SIZE)))
                        (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_PENDING_COUNT)) (i32.const 1))
                        (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_FLAGS)) (global.get $FRAME_FLAG_DISCARD_RESULT))
                        (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_AST_NODE)) (i32.const 0))
                        (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_ASYNC_PROMISE)) (i32.const 0))
                        (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_ARGC)) (i32.const 1))
                        (call $write_ctx (global.get $CTX_CALL_STACK_POINTER)
                          (i32.add (local.get $stack_pointer) (global.get $FRAME_SIZE)))
                        (local.set $new_scope (call $scope_create
                          (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 40))))))
                        (global.set $current_scope (local.get $new_scope))
                        (call $scope_define
                          (local.get $new_scope)
                          (call $read_builtin (i32.const 0x18))   ;; BUILTIN_NAME.THIS
                          (local.get $type1) (i32.const 0)
                          (local.get $object_pointer) (i32.const 0))
                        (call $scope_define_new_target (local.get $new_scope)
                          (global.get $TYPE_UNDEFINED) (i32.const 0))
                        (local.set $pc (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 32)))))
                        (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                        (br $loop)
                      )
                    )
                  )
                )

                ;; A private write (operand2 bit 0) never own-creates: the
                ;; field-initializer emissions (flag 0) are the only sites
                ;; that create private storage. Reaching here means the
                ;; receiver's class did not declare the name (wrong-class
                ;; write) or the chain entry is a private method (not
                ;; writable) — JavaScript throws a TypeError for both.
                (if (i32.and (local.get $operand2) (i32.const 1))
                  (then
                    (if (call $throw_type_error_with_message (global.get $BUILTIN_MSG_PRIVATE_NOT_DECLARED))
                      (then (br $exit))
                      (else
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop)
                      )
                    )
                  )
                )

                ;; extends-externals D5: a string-key own-miss (with no vat
                ;; setter in the chain — the inherited-accessor walk above
                ;; already dispatched those) on a branded instance consults
                ;; the backing value. Two-phase: the first dispatch yields
                ;; EXIT_EXTERNAL_PROPERTY_SET with the receiver at +20; the
                ;; airlock probes presence (setHasProperty) and either runs
                ;; the external setter (resuming past this instruction with
                ;; the assigned value) or stages the own-create marker at
                ;; +24 and retries this same pc, where the branch below
                ;; falls through to the ordinary own-create. Hidden '@'
                ;; keys cannot be spelled in source and symbol keys use the
                ;; sym-entries opcodes — both stay in the vat by
                ;; construction.
                (if (i32.and
                      (i32.eq (local.get $type1) (global.get $TYPE_OBJECT))
                      (i32.ne
                        (i32.and
                          (i32.load (call $abs (i32.add (local.get $object_pointer) (i32.const 20))))
                          (global.get $OBJECT_FLAG_EXTERNAL_BACKED))
                        (i32.const 0)))
                  (then
                    (if (i32.and
                          (i32.eq (i32.load (call $abs (i32.add (global.get $external_request_base) (i32.const 24)))) (i32.const 1))
                          (i32.eq (i32.load (call $abs (i32.add (global.get $external_request_base) (i32.const 20)))) (local.get $object_pointer)))
                      (then
                        ;; Phase 2: the host reported the backing property
                        ;; absent — clear the marker and own-create below.
                        (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 24))) (i32.const 0))
                      )
                      (else
                        (local.set $entry_pointer (call $object_find_string_entry
                          (local.get $object_pointer)
                          (call $read_builtin (global.get $BUILTIN_EXTERNAL_BACKING))))
                        (if (i32.ne (local.get $entry_pointer) (i32.const 0))
                          (then
                            (i32.store (call $abs (global.get $external_request_base))
                              (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 12)))))
                            (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 4)))
                              (local.get $key_offset))
                            ;; argsPointer = the assigned value's popped slot.
                            (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 8)))
                              (local.get $value_pointer))
                            (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 12)))
                              (i32.const 1))
                            (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 16)))
                              (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 16)))))
                            (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 20)))
                              (local.get $object_pointer))
                            (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 24))) (i32.const 0))
                            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                            ;; Retry pc: the airlock advances it (and
                            ;; pre-positions pending) itself on the setter
                            ;; path; the own-create path re-dispatches here.
                            (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                            (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                            (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_EXTERNAL_PROPERTY_SET))
                            (br $exit)
                          )
                        )
                      )
                    )
                  )
                )

                ;; Check if we need to grow entries block
                (if (i32.ge_u (local.get $obj_count) (local.get $obj_cap))
                  (then
                    ;; Pressure pre-check for the doubling grow — an
                    ;; already-large object's grow can exceed the
                    ;; dispatcher's heap-slack headroom in one
                    ;; instruction. SET_PROP popped exactly two operands
                    ;; (value, object) and pushed nothing on this path;
                    ;; restore them pointer-only (the slots are
                    ;; untouched) and yield; retry re-runs this op
                    ;; cleanly because the pre-check precedes mutation.
                    (if (call $check_heap_overflow (call $estimate_object_grow_size (local.get $obj_cap)))
                      (then
                        (call $write_ctx (global.get $CTX_PENDING_POINTER)
                          (i32.add
                            (call $read_ctx (global.get $CTX_PENDING_POINTER))
                            (i32.mul (global.get $VALUE_SIZE) (i32.const 2))))
                        (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                        (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                        (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                        (br $exit)))

                    ;; Need to reallocate entries block
                    ;; new_cap = capacity * 2 (or at least 4)
                    (local.set $new_cap (i32.mul (local.get $obj_cap) (i32.const 2)))
                    (if (i32.lt_u (local.get $new_cap) (i32.const 4))
                      (then (local.set $new_cap (i32.const 4)))
                    )

                    ;; Allocate new entries block
                    (local.set $heap_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))
                    (local.set $new_entries_pointer (local.get $heap_pointer))
                    (local.set $new_entries_size (i32.add (global.get $GC_HEADER_SIZE)
                                                         (i32.mul (local.get $new_cap) (global.get $ENTRY_SIZE))))

                    ;; GC header for new entries block
                    (i32.store (call $abs (local.get $new_entries_pointer))
                      (i32.or (local.get $new_entries_size) (i32.shl (global.get $OBJ_OBJECT_DATA) (i32.const 24))))
                    (i32.store (call $abs (i32.add (local.get $new_entries_pointer) (i32.const 4))) (i32.const 0))

                    ;; Update heap pointer
                    (call $write_state (global.get $STATE_HEAP_POINTER)
                      (i32.add (local.get $new_entries_pointer) (local.get $new_entries_size)))

                    ;; Copy existing entries from old block (if any)
                    (if (i32.and
                          (i32.ne (local.get $entries_pointer) (i32.const 0))
                          (i32.gt_u (local.get $obj_count) (i32.const 0)))
                      (then
                        (local.set $i (i32.const 0))
                        (block $copy_entries_done
                          (loop $copy_entries_loop
                            (br_if $copy_entries_done (i32.ge_u (local.get $i) (local.get $obj_count)))
                            ;; src = old_entries_pointer + 8 + i * ENTRY_SIZE
                            (local.set $element_pointer (i32.add
                              (i32.add (local.get $entries_pointer) (global.get $GC_HEADER_SIZE))
                              (i32.mul (local.get $i) (global.get $ENTRY_SIZE))))
                            ;; dest = new_entries_pointer + 8 + i * ENTRY_SIZE
                            (local.set $dest (i32.add
                              (i32.add (local.get $new_entries_pointer) (global.get $GC_HEADER_SIZE))
                              (i32.mul (local.get $i) (global.get $ENTRY_SIZE))))
                            ;; Copy ENTRY_SIZE bytes
                            (i32.store (call $abs (local.get $dest))
                              (i32.load (call $abs (local.get $element_pointer))))
                            (i32.store (call $abs (i32.add (local.get $dest) (i32.const 4)))
                              (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 4)))))
                            (i32.store (call $abs (i32.add (local.get $dest) (i32.const 8)))
                              (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 8)))))
                            (i32.store (call $abs (i32.add (local.get $dest) (i32.const 12)))
                              (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 12)))))
                            (i32.store (call $abs (i32.add (local.get $dest) (i32.const 16)))
                              (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 16)))))
                            (local.set $i (i32.add (local.get $i) (i32.const 1)))
                            (br $copy_entries_loop)
                          )
                        )
                      )
                    )

                    ;; Update object header with new entries_pointer and capacity
                    (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 16))) (local.get $new_cap))
                    (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 24))) (local.get $new_entries_pointer))
                    (local.set $entries_pointer (local.get $new_entries_pointer))
                  )
                )

                ;; Add new entry at count position
                ;; entry_pointer = entries_pointer + 8 + count * ENTRY_SIZE
                (local.set $entry_pointer (i32.add
                  (i32.add (local.get $entries_pointer) (global.get $GC_HEADER_SIZE))
                  (i32.mul (local.get $obj_count) (global.get $ENTRY_SIZE))))

                ;; Write entry: [key][type][flags][data_lo][data_hi]
                (i32.store (call $abs (local.get $entry_pointer)) (local.get $key_offset))
                (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 4))) (local.get $set_val_type))
                (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 8))) (local.get $set_val_flags))
                (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 12))) (local.get $set_val_lo))
                (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 16))) (local.get $set_val_hi))

                ;; Increment count
                (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 12)))
                  (i32.add (local.get $obj_count) (i32.const 1)))
              )
            )

            ;; Push value back (assignment is an expression)
            (call $pending_push
              (local.get $set_val_type)
              (local.get $set_val_flags)
              (local.get $set_val_lo)
              (local.get $set_val_hi))

            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; =====================================================================
        ;; SCOPE
        ;; =====================================================================
        (if (i32.eq (local.get $opcode) (global.get $OP_SCOPE_PUSH))
          (then
            ;; Pressure pre-check: a $scope_create cache miss allocates
            ;; a 200-byte scope (32 header + 168 entries block).
            (if (call $check_heap_overflow (call $estimate_scope_size))
              (then
                (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                (br $exit)))
            (local.set $new_scope (call $scope_create (global.get $current_scope)))
            (global.set $current_scope (local.get $new_scope))
            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        (if (i32.eq (local.get $opcode) (global.get $OP_SCOPE_POP))
          (then
            ;; Restore parent scope
            (local.set $value_pointer (global.get $current_scope))
            (global.set $current_scope
              (i32.load (call $abs (local.get $value_pointer))))
            ;; Recycle: a popped scope is off every chain the instant it
            ;; pops, and this handler cannot park mid-flight. Only
            ;; closure-captured scopes (flags bit 0, data+16) must keep
            ;; their identity; everything else feeds the free list (the
            ;; dead scope's parent field becomes the list link).
            (if (i32.eqz (i32.and
                  (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 16))))
                  (i32.const 1)))
              (then
                (i32.store (call $abs (local.get $value_pointer))
                  (global.get $scope_cache_list))
                (global.set $scope_cache_list (local.get $value_pointer))))
            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; =====================================================================
        ;; TRY/CATCH/FINALLY
        ;; =====================================================================

        ;; TRY_PUSH: operand1 = catch_index (0 if none), operand2 = finally_index (0 if none)
        ;; Push try entry to track exception handlers
        (if (i32.eq (local.get $opcode) (global.get $OP_TRY_PUSH))
          (then
            (call $try_push (local.get $operand1) (local.get $operand2))
            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; TRY_POP: Normal exit from a try block (or, v11, from a catch
        ;; block — the parser emits one after every catch body since
        ;; catch entry keeps the entry armed for its finally).
        ;; With a finally: disarm the entry in place, store a NORMAL
        ;; completion in it, and divert; FINALLY_END pops it.
        ;; Without: pop the entry and fall through.
        (if (i32.eq (local.get $opcode) (global.get $OP_TRY_POP))
          (then
            (local.set $operand2 (call $try_read (i32.const 0) (global.get $TRY_FINALLY_INDEX)))

            (if (i32.ne (local.get $operand2) (i32.const 0))
              (then
                (call $try_write_top (global.get $TRY_CATCH_INDEX) (i32.const 0))
                (call $try_write_top (global.get $TRY_FINALLY_INDEX) (i32.const 0))
                (call $try_write_top (global.get $TRY_COMPLETION_TYPE) (global.get $COMPLETION_NORMAL))
                (local.set $pc (local.get $operand2))
              )
              (else
                (call $try_pop)
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
              )
            )
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; UNWIND_JUMP: break/continue crossing try frames. operand1 =
        ;; target instruction index, operand2 = number of try entries to
        ;; unwind (statically counted by the parser; all belong to the
        ;; current call frame). Diverts through each armed finally with a
        ;; COMPLETION_JUMP; FINALLY_END continues the unwind.
        (if (i32.eq (local.get $opcode) (global.get $OP_UNWIND_JUMP))
          (then
            ;; Corrupt-operand tripwire: the parser statically counts
            ;; the try entries to unwind (all in the current frame), so
            ;; count can never exceed the try stack's depth. A corrupt
            ;; count would walk $unwind_toward's pops below base, where
            ;; garbage finally indexes trigger below-base writes.
            (if (i32.gt_u (local.get $operand2) (call $try_depth))
              (then
                (call $fault_error (global.get $ERR_CORRUPT_OPERAND) (local.get $operand2) (local.get $pc))
                (br $exit)))
            (local.set $index (call $unwind_toward (local.get $operand1) (local.get $operand2)))
            (if (i32.ne (local.get $index) (i32.const 0))
              (then (local.set $pc (local.get $index)))
              (else (local.set $pc (local.get $operand1)))
            )
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; PUSH_COMPLETION_KIND: push the top try entry's completion type
        ;; as an inline integer (0 normal / 1 throw / 2 return / 3 jump).
        ;; Only emitted inside finally blocks, where the top entry is the
        ;; disarmed holder carrying the pending completion.
        (if (i32.eq (local.get $opcode) (global.get $OP_PUSH_COMPLETION_KIND))
          (then
            (call $pending_push
              (global.get $TYPE_RATIONAL)
              (global.get $FLAG_RATIONAL_INLINE)
              (call $try_read (i32.const 0) (global.get $TRY_COMPLETION_TYPE))
              (i32.const 0))
            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; ASSERT_ITER_RESULT: peek the iterator-result on top of pending stack.
        ;; Throw TypeError if not TYPE_OBJECT or TYPE_FUNCTION. The value stays
        ;; on the stack so the for-of desugaring can read .done / .value after.
        (if (i32.eq (local.get $opcode) (global.get $OP_ASSERT_ITER_RESULT))
          (then
            (local.set $value_pointer (call $pending_peek))
            (local.set $type1 (call $value_type (local.get $value_pointer)))
            (if (i32.and
                  (i32.ne (local.get $type1) (global.get $TYPE_OBJECT))
                  (i32.ne (local.get $type1) (global.get $TYPE_FUNCTION)))
              (then
                (if (call $throw_type_error_with_type (global.get $BUILTIN_MSG_NOT_AN_OBJECT) (local.get $type1))
                  (then (br $exit))
                  (else
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)
                  )
                )
              )
            )
            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; ASSERT_ITERABLE: iteration-protocol diagnostics for the for-of /
        ;; array-destructuring / spread lowerings. The peeked value stays on
        ;; the stack in both modes.
        ;; operand1 = 0: peek the SOURCE about to be iterated; throw
        ;;   "Not iterable" for value types that can never carry
        ;;   Symbol.iterator (null/undefined/boolean/number/bigint/rational/
        ;;   complex/symbol) — pre-empting GET_INDEX's generic
        ;;   "Cannot read property" on null/undefined.
        ;; operand1 = 1: peek the iterator FACTORY that source[Symbol.iterator]
        ;;   produced (stack: [receiver, factory]); if the lookup missed
        ;;   (undefined/null), throw "Not iterable" carrying the RECEIVER's
        ;;   type — pre-empting CALL_METHOD's misleading "Not a function".
        (if (i32.eq (local.get $opcode) (global.get $OP_ASSERT_ITERABLE))
          (then
            (local.set $value_pointer (call $pending_peek))
            (local.set $type1 (call $value_type (local.get $value_pointer)))
            (if (i32.eqz (local.get $operand1))
              (then
                ;; Source pre-check. NULL/UNDEFINED/BOOLEAN/INTEGER/FLOAT are
                ;; the contiguous low tags 0x00-0x04.
                (if (i32.or
                      (i32.le_u (local.get $type1) (global.get $TYPE_FLOAT))
                      (i32.or
                        (i32.eq (local.get $type1) (global.get $TYPE_BIGINT))
                        (i32.or
                          (i32.eq (local.get $type1) (global.get $TYPE_RATIONAL))
                          (i32.or
                            (i32.eq (local.get $type1) (global.get $TYPE_COMPLEX))
                            (i32.eq (local.get $type1) (global.get $TYPE_SYMBOL))))))
                  (then
                    (if (call $throw_type_error_with_type (global.get $BUILTIN_MSG_NOT_ITERABLE) (local.get $type1))
                      (then (br $exit))
                      (else
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop)
                      )
                    )
                  )
                )
              )
              (else
                ;; Factory check: the Symbol.iterator lookup missed entirely.
                (if (i32.or
                      (i32.eq (local.get $type1) (global.get $TYPE_UNDEFINED))
                      (i32.eq (local.get $type1) (global.get $TYPE_NULL)))
                  (then
                    (if (call $throw_type_error_with_type
                          (global.get $BUILTIN_MSG_NOT_ITERABLE)
                          (call $value_type (i32.sub (local.get $value_pointer) (global.get $VALUE_SIZE))))
                      (then (br $exit))
                      (else
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop)
                      )
                    )
                  )
                )
              )
            )
            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; THROW: Pop exception value, search for handler
        ;; If handler found: unwind frames, jump to catch/finally
        ;; If not found: set STATUS_ERROR
        (if (i32.eq (local.get $opcode) (global.get $OP_THROW))
          (then
            ;; Pop exception value
            (local.set $value_pointer (call $pending_pop))

            ;; Push it back so save_completion_value can read it
            (call $pending_push
              (call $value_type (local.get $value_pointer))
              (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 4))))
              (call $value_data_lo (local.get $value_pointer))
              (call $value_data_hi (local.get $value_pointer)))

            ;; Save exception to completion value slot
            (call $save_completion_value)

            ;; Pop it again (we saved it)
            (drop (call $pending_pop))

            ;; Set completion type to throw
            (call $write_ctx (global.get $CTX_COMPLETION_TYPE) (global.get $COMPLETION_THROW))

            ;; Unified v11 handler walk (keep+disarm semantics).
            (if (call $throw_dispatch (i32.const 0) (i32.const 0) (i32.const 0))
              (then (br $exit)))
            (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))

            ;; Handler found, continue execution
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; FINALLY_END: end of a finally block. v11: the top try entry is
        ;; this finally's disarmed holder carrying the pending completion.
        ;; Read it, pop the entry, and re-dispatch:
        ;;   NORMAL — continue to the next instruction.
        ;;   THROW  — feed the exception back through $throw_dispatch
        ;;            (finds the next handler, exactly like OP_THROW).
        ;;   RETURN — push the return value and jump to the sentinel
        ;;            RETURN instruction the parser appends at the end of
        ;;            every parse batch. Re-running a REAL return gives
        ;;            the full OP_RETURN semantics — remaining finallys at
        ;;            this depth, iteration continuations, async
        ;;            completion — with zero duplication, and any
        ;;            pressure park inside the continuation resumes at a
        ;;            genuine RETURN instruction.
        ;;   JUMP   — continue unwinding toward the stored break/continue
        ;;            target ($unwind_toward).
        (if (i32.eq (local.get $opcode) (global.get $OP_FINALLY_END))
          (then
            (local.set $type1 (call $try_read (i32.const 0) (global.get $TRY_COMPLETION_TYPE)))

            ;; Normal completion - pop the holder, continue
            (if (i32.eq (local.get $type1) (global.get $COMPLETION_NORMAL))
              (then
                (call $try_pop)
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Throw completion - re-throw through the unified walk
            (if (i32.eq (local.get $type1) (global.get $COMPLETION_THROW))
              (then
                (call $try_copy_completion_value_to_ctx)
                (call $write_ctx (global.get $CTX_COMPLETION_TYPE) (global.get $COMPLETION_THROW))
                (local.set $operand1
                  (call $try_read (i32.const 0) (global.get $TRY_ERROR_CODE)))
                (local.set $operand2
                  (call $try_read (i32.const 0) (global.get $TRY_ERROR_DETAIL)))
                (local.set $index
                  (call $try_read
                    (i32.const 0) (global.get $TRY_ERROR_INSTRUCTION_INDEX)))
                (call $try_pop)
                (if (call $throw_dispatch
                      (local.get $operand1)
                      (local.get $operand2)
                      (local.get $index))
                  (then (br $exit)))
                (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Return completion - re-dispatch through the sentinel RETURN
            (if (i32.eq (local.get $type1) (global.get $COMPLETION_RETURN))
              (then
                (call $try_push_completion_value_to_pending)
                (call $try_pop)
                (local.set $pc (i32.sub (local.get $instr_count) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Jump completion - continue the unwind toward the target
            (if (i32.eq (local.get $type1) (global.get $COMPLETION_JUMP))
              (then
                ;; value lo = target, value hi = remaining entries
                (local.set $operand1 (call $try_read (i32.const 0)
                  (i32.add (global.get $TRY_COMPLETION_VALUE) (i32.const 8))))
                (local.set $operand2 (call $try_read (i32.const 0)
                  (i32.add (global.get $TRY_COMPLETION_VALUE) (i32.const 12))))
                (call $try_pop)
                (local.set $index (call $unwind_toward (local.get $operand1) (local.get $operand2)))
                (if (i32.ne (local.get $index) (i32.const 0))
                  (then (local.set $pc (local.get $index)))
                  (else (local.set $pc (local.get $operand1)))
                )
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Unknown completion type - error
            (if (call $raise_error (global.get $ERR_INVALID_OPERAND) (local.get $type1))
              (then (br $exit)))
            (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
            (br $loop)
          )
        )

        ;; =====================================================================
        ;; GRANTS
        ;; =====================================================================

        ;; GRANT_START: operand1 = denied addr (0 if none), operand2 = grant count
        ;; Pop N identifier values from pending stack, store in scratch, yield STATUS_GRANT_REQUEST
        ;; The host will call back with grant approval/rejection for each identifier
        (if (i32.eq (local.get $opcode) (global.get $OP_GRANT_START))
          (then
            ;; For now, this is a stub that yields STATUS_GRANT_REQUEST
            ;; The actual grant approval logic is handled by Airlock in JS
            ;; Store operand1 (denied addr) and operand2 (count) in scratch for Airlock to read
            (i32.store (call $scratch_ptr (i32.const 0) (i32.const 4))
              (local.get $operand1))
            (i32.store (call $scratch_ptr (i32.const 4) (i32.const 4))
              (local.get $operand2))

            ;; Yield to host for grant processing
            ;; Must save scope to state - SCOPE_PUSH may have changed $current_scope global
            ;; Decrement fuel before yielding - instruction is complete from WASM's perspective
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
            (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_GRANT_REQUEST))
            (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
            (return (local.get $fuel))
          )
        )

        ;; GRANT_END: operand1 = count of entries to pop
        ;; Pop entries from grant stack (JS memory manipulation)
        ;; This doesn't yield - just continues execution
        (if (i32.eq (local.get $opcode) (global.get $OP_GRANT_END))
          (then
            ;; Corrupt-operand tripwire: the parser statically counts
            ;; the grant entries this op closes, so count can never
            ;; exceed the grant stack's depth. A corrupt count would
            ;; send the pointer below base and later grant pushes would
            ;; write wild.
            (if (i32.gt_u (local.get $operand1)
                  (i32.div_u
                    (i32.sub
                      (call $read_ctx (global.get $CTX_GRANT_STACK_POINTER))
                      (call $grant_stack_base_seg))
                    (global.get $GRANT_ENTRY_SIZE)))
              (then
                (call $fault_error (global.get $ERR_CORRUPT_OPERAND) (local.get $operand1) (local.get $pc))
                (br $exit)))

            ;; Pop N entries from grant stack
            ;; Grant stack pointer is decremented by N * GRANT_ENTRY_SIZE
            (local.set $index (call $read_ctx (global.get $CTX_GRANT_STACK_POINTER)))
            (local.set $index
              (i32.sub (local.get $index)
                (i32.mul (local.get $operand1) (global.get $GRANT_ENTRY_SIZE))))
            (call $write_ctx (global.get $CTX_GRANT_STACK_POINTER) (local.get $index))

            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; GRANT_DENIED: operand1 = param name (0 if none)
        ;; Entry point for denied block. Array of revoked identifiers is on pending stack
        ;; (pushed by Airlock before jumping here)
        (if (i32.eq (local.get $opcode) (global.get $OP_GRANT_DENIED))
          (then
            ;; Just continue - the revoked identifiers array is already on pending stack
            ;; The LET_VAR that follows will bind it to the parameter
            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; =====================================================================
        ;; FUNCTIONS
        ;; =====================================================================

        ;; MAKE_CLOSURE: operand1 = start_instr, operand2 = end_instr
        ;; Create function capturing current scope, push to pending
        ;; Function layout (after GC header): [prototype:4][count:4][capacity:4][entries:4][start:4][end:4][scope:4][flags:4]
        ;; flags = 0 for regular function (binds `this`)
        ;; Regular functions get a .prototype property (arrow functions don't)
        (if (i32.eq (local.get $opcode) (global.get $OP_MAKE_CLOSURE))
          (then
            ;; Allocate function: GC header (8) + object header (16) + closure data (16) = 40 bytes
            (local.set $heap_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))

            ;; GC header: [size | (type << 24)]
            (i32.store (call $abs (local.get $heap_pointer))
              (i32.or (global.get $FUNCTION_HEADER_SIZE) (i32.shl (global.get $OBJ_FUNCTION) (i32.const 24))))
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 4))) (i32.const 0))

            ;; Object header (at +8): prototype=Function.prototype, count=0, capacity=0, flags=0, entries=0, sym_entries=0
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 8)))
              (call $read_state (global.get $STATE_FUNCTION_PROTOTYPE)))   ;; prototype = Function.prototype
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 12))) (i32.const 0))  ;; count
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 16))) (i32.const 0))  ;; capacity
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 20))) (i32.const 0))  ;; flags
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 24))) (i32.const 0))  ;; entries_pointer
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 28))) (i32.const 0))  ;; sym_entries_pointer

            ;; Closure data (at +32): start_instruction, end_instruction, scope, function_flags
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 32))) (local.get $operand1))  ;; start_instruction
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 36))) (local.get $operand2))  ;; end_instruction
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 40))) (global.get $current_scope)) ;; scope
            (call $scope_mark_captured_chain (global.get $current_scope))
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 44))) (i32.const 0)) ;; function_flags = 0 (regular)

            ;; Update heap pointer past function
            (call $write_state (global.get $STATE_HEAP_POINTER)
              (i32.add (local.get $heap_pointer) (global.get $FUNCTION_HEADER_SIZE)))

            ;; Save function header ptr for later
            (local.set $start_instr (local.get $heap_pointer))

            ;; Allocate empty prototype object: [GC:8][prototype:4][count:4][capacity:4][flags:4][entries:4][sym_entries:4] = 32 bytes
            ;; The .prototype object inherits from Object.prototype
            (local.set $heap_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))
            (i32.store (call $abs (local.get $heap_pointer))
              (i32.or (global.get $OBJECT_HEADER_SIZE) (i32.shl (global.get $OBJ_OBJECT) (i32.const 24))))
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 4))) (i32.const 0))
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 8)))
              (call $read_state (global.get $STATE_OBJECT_PROTOTYPE)))   ;; prototype = Object.prototype
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 12))) (i32.const 0))  ;; count = 0
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 16))) (i32.const 0))  ;; capacity = 0
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 20))) (i32.const 0))  ;; flags = 0
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 24))) (i32.const 0))  ;; entries_pointer = 0
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 28))) (i32.const 0))  ;; sym_entries_pointer = 0
            (call $write_state (global.get $STATE_HEAP_POINTER)
              (i32.add (local.get $heap_pointer) (global.get $OBJECT_HEADER_SIZE)))

            ;; Set function.prototype = prototype object
            ;; object_set_property(function_pointer, key_offset, type, flags, data_lo, data_hi)
            ;; First property on a capacity-0 function header: a fixed
            ;; 96-byte grow, far below the per-instruction heap-slack
            ;; floor — refusal unreachable, status droppable.
            (drop (call $object_set_property
              (local.get $start_instr)                              ;; function header ptr
              (call $read_builtin (global.get $BUILTIN_PROTOTYPE))  ;; "prototype" string offset
              (global.get $TYPE_OBJECT)                             ;; type = OBJECT
              (i32.const 0)                                         ;; flags = 0
              (local.get $heap_pointer)                                 ;; data_lo = prototype header ptr
              (i32.const 0)))                                       ;; data_hi = 0

            ;; Push function value (type=FUNCTION, data_lo=header ptr like TYPE_OBJECT)
            (call $pending_push
              (global.get $TYPE_FUNCTION)
              (i32.const 0)
              (local.get $start_instr)
              (i32.const 0))

            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; MAKE_ARROW_CLOSURE: operand1 = start_instr, operand2 = end_instr
        ;; Same as MAKE_CLOSURE but sets CLOSURE_FLAG_ARROW (doesn't bind `this`)
        ;; Arrow functions don't get a .prototype property (they're not constructible)
        (if (i32.eq (local.get $opcode) (global.get $OP_MAKE_ARROW_CLOSURE))
          (then
            ;; Allocate function: GC header (8) + object header (20) + closure data (16) = 44 bytes
            (local.set $heap_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))

            ;; GC header: [size | (type << 24)]
            (i32.store (call $abs (local.get $heap_pointer))
              (i32.or (global.get $FUNCTION_HEADER_SIZE) (i32.shl (global.get $OBJ_FUNCTION) (i32.const 24))))
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 4))) (i32.const 0))

            ;; Object header (at +8): prototype=Function.prototype, count=0, capacity=0, flags=0, entries=0, sym_entries=0
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 8)))
              (call $read_state (global.get $STATE_FUNCTION_PROTOTYPE)))   ;; prototype = Function.prototype
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 12))) (i32.const 0))  ;; count
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 16))) (i32.const 0))  ;; capacity
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 20))) (i32.const 0))  ;; flags
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 24))) (i32.const 0))  ;; entries_pointer
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 28))) (i32.const 0))  ;; sym_entries_pointer

            ;; Closure data (at +32): start_instruction, end_instruction, scope, function_flags
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 32))) (local.get $operand1))  ;; start_instruction
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 36))) (local.get $operand2))  ;; end_instruction
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 40))) (global.get $current_scope)) ;; scope
            (call $scope_mark_captured_chain (global.get $current_scope))
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 44))) (global.get $CLOSURE_FLAG_ARROW)) ;; function_flags = ARROW

            ;; Update heap pointer
            (call $write_state (global.get $STATE_HEAP_POINTER)
              (i32.add (local.get $heap_pointer) (global.get $FUNCTION_HEADER_SIZE)))

            ;; Push function value (type=FUNCTION, data_lo=header ptr like TYPE_OBJECT)
            (call $pending_push
              (global.get $TYPE_FUNCTION)
              (i32.const 0)
              (local.get $heap_pointer)
              (i32.const 0))

            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; MAKE_ASYNC_CLOSURE: operand1 = start_instr, operand2 = end_instr
        ;; Same as MAKE_CLOSURE but sets CLOSURE_FLAG_ASYNC
        (if (i32.eq (local.get $opcode) (global.get $OP_MAKE_ASYNC_CLOSURE))
          (then
            ;; Allocate function: GC header (8) + object header (16) + closure data (16) = 40 bytes
            (local.set $heap_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))

            ;; GC header: [size | (type << 24)]
            (i32.store (call $abs (local.get $heap_pointer))
              (i32.or (global.get $FUNCTION_HEADER_SIZE) (i32.shl (global.get $OBJ_FUNCTION) (i32.const 24))))
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 4))) (i32.const 0))

            ;; Object header (at +8): prototype=Function.prototype, count=0, capacity=0, flags=0, entries=0, sym_entries=0
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 8)))
              (call $read_state (global.get $STATE_FUNCTION_PROTOTYPE)))
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 12))) (i32.const 0))
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 16))) (i32.const 0))
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 20))) (i32.const 0))
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 24))) (i32.const 0))
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 28))) (i32.const 0))

            ;; Closure data (at +32): start_instruction, end_instruction, scope, function_flags
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 32))) (local.get $operand1))
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 36))) (local.get $operand2))
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 40))) (global.get $current_scope))
            (call $scope_mark_captured_chain (global.get $current_scope))
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 44))) (global.get $CLOSURE_FLAG_ASYNC))

            ;; Update heap pointer past function
            (call $write_state (global.get $STATE_HEAP_POINTER)
              (i32.add (local.get $heap_pointer) (global.get $FUNCTION_HEADER_SIZE)))

            ;; Save function header ptr for later
            (local.set $start_instr (local.get $heap_pointer))

            ;; Allocate empty prototype object (async functions still have .prototype)
            (local.set $heap_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))
            (i32.store (call $abs (local.get $heap_pointer))
              (i32.or (global.get $OBJECT_HEADER_SIZE) (i32.shl (global.get $OBJ_OBJECT) (i32.const 24))))
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 4))) (i32.const 0))
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 8)))
              (call $read_state (global.get $STATE_OBJECT_PROTOTYPE)))
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 12))) (i32.const 0))
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 16))) (i32.const 0))
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 20))) (i32.const 0))
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 24))) (i32.const 0))
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 28))) (i32.const 0))
            (call $write_state (global.get $STATE_HEAP_POINTER)
              (i32.add (local.get $heap_pointer) (global.get $OBJECT_HEADER_SIZE)))

            ;; Set function.prototype = prototype object
            ;; First property on a capacity-0 function header: a fixed
            ;; 96-byte grow, far below the per-instruction heap-slack
            ;; floor — refusal unreachable, status droppable.
            (drop (call $object_set_property
              (local.get $start_instr)
              (call $read_builtin (global.get $BUILTIN_PROTOTYPE))
              (global.get $TYPE_OBJECT)
              (i32.const 0)
              (local.get $heap_pointer)
              (i32.const 0)))

            ;; Push function value
            (call $pending_push
              (global.get $TYPE_FUNCTION)
              (i32.const 0)
              (local.get $start_instr)
              (i32.const 0))

            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; MAKE_GENERATOR_CLOSURE / MAKE_ASYNC_GENERATOR_CLOSURE:
        ;; operand1 = start_instr, operand2 = end_instr
        ;; Same as MAKE_CLOSURE but sets CLOSURE_FLAG_GENERATOR (the async
        ;; form also sets CLOSURE_FLAG_ASYNC). Calling either spawns a
        ;; generator context (EXIT_GENERATOR_CALL) instead of running the
        ;; body; the airlock reads the flags to pick the sync (parked
        ;; caller) or async (step promise) protocol.
        (if (i32.or
              (i32.eq (local.get $opcode) (global.get $OP_MAKE_GENERATOR_CLOSURE))
              (i32.eq (local.get $opcode) (global.get $OP_MAKE_ASYNC_GENERATOR_CLOSURE)))
          (then
            (local.set $heap_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))

            (i32.store (call $abs (local.get $heap_pointer))
              (i32.or (global.get $FUNCTION_HEADER_SIZE) (i32.shl (global.get $OBJ_FUNCTION) (i32.const 24))))
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 4))) (i32.const 0))

            ;; Object header (at +8): prototype=Function.prototype, count=0, capacity=0, flags=0, entries=0, sym_entries=0
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 8)))
              (call $read_state (global.get $STATE_FUNCTION_PROTOTYPE)))
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 12))) (i32.const 0))
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 16))) (i32.const 0))
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 20))) (i32.const 0))
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 24))) (i32.const 0))
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 28))) (i32.const 0))

            ;; Closure data (at +32): start_instruction, end_instruction, scope, function_flags
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 32))) (local.get $operand1))
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 36))) (local.get $operand2))
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 40))) (global.get $current_scope))
            (call $scope_mark_captured_chain (global.get $current_scope))
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 44)))
              (if (result i32)
                  (i32.eq (local.get $opcode) (global.get $OP_MAKE_ASYNC_GENERATOR_CLOSURE))
                (then (i32.or (global.get $CLOSURE_FLAG_ASYNC) (global.get $CLOSURE_FLAG_GENERATOR)))
                (else (global.get $CLOSURE_FLAG_GENERATOR))))

            (call $write_state (global.get $STATE_HEAP_POINTER)
              (i32.add (local.get $heap_pointer) (global.get $FUNCTION_HEADER_SIZE)))

            (call $pending_push
              (global.get $TYPE_FUNCTION)
              (i32.const 0)
              (local.get $heap_pointer)
              (i32.const 0))

            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; MAKE_ASYNC_ARROW_CLOSURE: operand1 = start_instr, operand2 = end_instr
        ;; Same as MAKE_ARROW_CLOSURE but also sets CLOSURE_FLAG_ASYNC
        (if (i32.eq (local.get $opcode) (global.get $OP_MAKE_ASYNC_ARROW_CLOSURE))
          (then
            ;; Allocate function: GC header (8) + object header (20) + closure data (16) = 44 bytes
            (local.set $heap_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))

            ;; GC header
            (i32.store (call $abs (local.get $heap_pointer))
              (i32.or (global.get $FUNCTION_HEADER_SIZE) (i32.shl (global.get $OBJ_FUNCTION) (i32.const 24))))
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 4))) (i32.const 0))

            ;; Object header
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 8)))
              (call $read_state (global.get $STATE_FUNCTION_PROTOTYPE)))
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 12))) (i32.const 0))
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 16))) (i32.const 0))
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 20))) (i32.const 0))
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 24))) (i32.const 0))
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 28))) (i32.const 0))

            ;; Closure data with ARROW | ASYNC flags
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 32))) (local.get $operand1))
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 36))) (local.get $operand2))
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 40))) (global.get $current_scope))
            (call $scope_mark_captured_chain (global.get $current_scope))
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 44)))
              (i32.or (global.get $CLOSURE_FLAG_ARROW) (global.get $CLOSURE_FLAG_ASYNC)))

            ;; Update heap pointer (no .prototype for arrow functions)
            (call $write_state (global.get $STATE_HEAP_POINTER)
              (i32.add (local.get $heap_pointer) (global.get $FUNCTION_HEADER_SIZE)))

            ;; Push function value
            (call $pending_push
              (global.get $TYPE_FUNCTION)
              (i32.const 0)
              (local.get $heap_pointer)
              (i32.const 0))

            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; AWAIT: pop value, check if promise, yield to airlock
        ;; If not a promise: write value to request, yield STATUS_AWAIT
        ;; If promise resolved: write resolved value to request, yield STATUS_AWAIT
        ;; If promise rejected: write rejection to request (with isRejected=1), yield STATUS_AWAIT
        ;; If promise pending: add context to waiter list, yield STATUS_AWAIT
        ;;
        ;; Request format at external_request_base: [isPending:4][isRejected:4][valuePointer:4]
        ;; YIELD parks this generator context. The
        ;; yielded value stays on the pending stack for the airlock to
        ;; read; the resume convention is AWAIT's — the driver pushes the
        ;; sent value before re-running, and it becomes the yield
        ;; expression's result at pc+1.
        (if (i32.eq (local.get $opcode) (global.get $OP_YIELD))
          (then
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX)
              (i32.add (local.get $pc) (i32.const 1)))
            (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
            (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_GENERATOR_YIELD))
            (br $exit)
          )
        )

        (if (i32.eq (local.get $opcode) (global.get $OP_AWAIT))
          (then
            ;; Preflight the only allocation AWAIT can perform before changing
            ;; the pending stack, context state, or promise head.
            (local.set $value_pointer
              (i32.sub
                (call $read_ctx (global.get $CTX_PENDING_POINTER))
                (global.get $VALUE_SIZE)))
            (local.set $type1
              (i32.load (call $abs (local.get $value_pointer))))
            (if (i32.eq (local.get $type1) (global.get $TYPE_PROMISE))
              (then
                (local.set $promise_ptr
                  (i32.add
                    (i32.load (call $abs
                      (i32.add (local.get $value_pointer) (i32.const 8))))
                    (global.get $GC_HEADER_SIZE)))
                (local.set $promise_status
                  (i32.load (call $abs (local.get $promise_ptr))))
                (if
                  (i32.and
                    (i32.eq
                      (local.get $promise_status)
                      (global.get $PROMISE_STATUS_PENDING))
                    (call $check_heap_overflow
                      (global.get $PROMISE_WAITER_TOTAL_SIZE)))
                  (then
                    (call $write_ctx
                      (global.get $CTX_EXIT_CONDITION)
                      (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)))
              ))
            ;; Pop the value to await
            (local.set $value_pointer (call $pending_pop))
            (local.set $type1 (i32.load (call $abs (local.get $value_pointer))))

            ;; Save state for after await. CTX_SCOPE must be saved because
            ;; SCOPE_PUSH operations between function entry and the AWAIT
            ;; mutate $current_scope (a WAT global) but do not touch
            ;; CTX_SCOPE; without this save, the resumed run reads a stale
            ;; CTX_SCOPE and runs the post-await code in the wrong scope.
            (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX)
              (i32.add (local.get $pc) (i32.const 1)))
            (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))

            ;; The current context's request block (per-context, layout v8)
            (local.set $request_base (global.get $external_request_base))

            ;; Check if it's a Promise
            (if (i32.ne (local.get $type1) (global.get $TYPE_PROMISE))
              (then
                ;; Not a promise - write value to request, yield
                ;; isPending=0, isRejected=0, valuePointer=value_pointer
                (i32.store (call $abs (local.get $request_base)) (i32.const 0))
                (i32.store (call $abs (i32.add (local.get $request_base) (i32.const 4))) (i32.const 0))
                (i32.store (call $abs (i32.add (local.get $request_base) (i32.const 8))) (local.get $value_pointer))
                (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_AWAIT))
                (br $exit)
              )
            )

            ;; It's a Promise - get the data pointer
            ;; payload is at value_pointer+8, it's the header pointer
            ;; data pointer = header pointer + GC_HEADER_SIZE
            (local.set $promise_ptr
              (i32.add
                (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 8))))
                (global.get $GC_HEADER_SIZE)))

            ;; Check promise status
            (local.set $promise_status (i32.load (call $abs (local.get $promise_ptr))))

            (if (i32.eq (local.get $promise_status) (global.get $PROMISE_STATUS_RESOLVED))
              (then
                ;; Resolved - write resolved value pointer to request
                ;; isPending=0, isRejected=0, valuePointer = promise + PROMISE_VALUE
                (i32.store (call $abs (local.get $request_base)) (i32.const 0))
                (i32.store (call $abs (i32.add (local.get $request_base) (i32.const 4))) (i32.const 0))
                (i32.store (call $abs (i32.add (local.get $request_base) (i32.const 8)))
                  (i32.add (local.get $promise_ptr) (global.get $PROMISE_VALUE)))
                (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_AWAIT))
                (br $exit)
              )
            )

            (if (i32.eq (local.get $promise_status) (global.get $PROMISE_STATUS_REJECTED))
              (then
                ;; Rejected - write rejection reason to request with isRejected=1
                ;; isPending=0, isRejected=1, valuePointer = promise + PROMISE_VALUE
                (i32.store (call $abs (local.get $request_base)) (i32.const 0))
                (i32.store (call $abs (i32.add (local.get $request_base) (i32.const 4))) (i32.const 1))
                (i32.store (call $abs (i32.add (local.get $request_base) (i32.const 8)))
                  (i32.add (local.get $promise_ptr) (global.get $PROMISE_VALUE)))
                (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_AWAIT))
                (br $exit)
              )
            )

            ;; Pending - allocate and publish a durable waiter node.
            (local.set $waiter_head
              (i32.load (call $abs
                (i32.add
                  (local.get $promise_ptr)
                  (global.get $PROMISE_WAITERS)))))
            (local.set $waiter_node
              (call $allocate_promise_waiter
                (local.get $context_slot)
                (i32.load (call $abs
                  (i32.add
                    (call $read_state
                      (global.get $STATE_CONTEXT_GENERATION_TABLE_POINTER))
                    (i32.mul
                      (local.get $context_slot)
                      (i32.const 4)))))
                (local.get $waiter_head)))
            (call $write_ctx
              (global.get $CTX_WAITING_ON)
              (local.get $promise_ptr))
            (i32.store
              (call $abs
                (i32.add
                  (local.get $promise_ptr)
                  (global.get $PROMISE_WAITERS)))
              (local.get $waiter_node))

            ;; Write request: isPending=1, isRejected=0, valuePointer=0
            (i32.store (call $abs (local.get $request_base)) (i32.const 1))
            (i32.store (call $abs (i32.add (local.get $request_base) (i32.const 4))) (i32.const 0))
            (i32.store (call $abs (i32.add (local.get $request_base) (i32.const 8))) (i32.const 0))

            (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_AWAIT))
            (br $exit)
          )
        )

        ;; CALL: operand1 = argc
        ;; Stack before: [closure, arg0, arg1, ..., argN-1] with argN-1 on top
        ;; The closure is argc values below the args.
        ;;
        ;; We read the closure from below the args, save frame state,
        ;; then leave args on stack for function body to consume via LET_VAR.
        ;; On RETURN, pending_pointer is restored to where closure was (discarding closure).
        ;;
        ;; Frame layout: [CODE_BLOCK:4][INSTRUCTION_INDEX:4][SCOPE:4][PENDING_BASE:4]
        ;;               [PENDING_COUNT:4][FLAGS:4][SOURCE_START:4][SOURCE_END:4]
        ;; CALL (0x71) and CALL_SPREAD (0x88) share one handler. CALL_SPREAD's
        ;; prologue pops the packed args array (parser-emitted, always an
        ;; Array) and unpacks its elements in place; the stack and operand1
        ;; then match CALL exactly, so every callee kind below — closures,
        ;; bound methods, constructors, async (airlock), externals, promise
        ;; continuations — works with spread. Pressure retries restore the
        ;; packed shape via $call_pressure_restore_pending.
        (if (i32.or
              (i32.eq (local.get $opcode) (global.get $OP_CALL))
              (i32.eq (local.get $opcode) (global.get $OP_CALL_SPREAD)))
          (then
            (if (i32.eq (local.get $opcode) (global.get $OP_CALL_SPREAD))
              (then
                ;; Peek the args array — validation and the capacity grow
                ;; below run BEFORE the pop so a pressure yield leaves the
                ;; stack untouched for the retry.
                (local.set $value_pointer (call $pending_peek))
                (local.set $type1 (i32.load (call $abs (local.get $value_pointer))))
                (if (i32.ne (local.get $type1) (global.get $TYPE_ARRAY))
                  (then
                    ;; Internal: parser always packs into an array. If we see
                    ;; non-array here, bytecode is corrupted.
                    (if (call $raise_error (global.get $ERR_TYPE_ERROR) (local.get $type1))
                      (then (br $exit)))
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)
                  )
                )
                (local.set $spread_array_pointer (call $value_data_lo (local.get $value_pointer)))
                (local.set $operand1
                  (i32.load (call $abs (i32.add (local.get $spread_array_pointer) (i32.const 8)))))   ;; array length

                ;; Pre-grow the pending stack for the unpack: the
                ;; per-instruction safepoint only guarantees slack for a
                ;; small fixed burst, and unpacking pushes operand1 values
                ;; in one instruction — without this, a large spread wrote
                ;; straight past the stack block. $grow_stack doubles, so
                ;; loop until the capacity fits (growth relocates the
                ;; block; every address below is re-derived afterwards).
                (block $call_spread_capacity_ok
                  (loop $call_spread_capacity_loop
                    (br_if $call_spread_capacity_ok
                      (i32.le_u
                        (i32.add
                          (call $read_ctx (global.get $CTX_PENDING_POINTER))
                          (i32.mul (i32.add (local.get $operand1) (i32.const 4)) (global.get $VALUE_SIZE)))
                        (call $read_ctx (global.get $CTX_PENDING_LIMIT))))
                    (if (call $grow_stack
                          (global.get $CTX_PENDING_BASE) (global.get $CTX_PENDING_LIMIT)
                          (global.get $CTX_PENDING_POINTER))
                      (then
                        (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                        (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                        (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                        (br $exit)
                      )
                    )
                    (br $call_spread_capacity_loop)
                  )
                )

                ;; Pop the args array (its header pointer is already saved).
                (drop (call $pending_pop))
                (local.set $data_pointer
                  (i32.load (call $abs (i32.add (local.get $spread_array_pointer) (i32.const 16))))) ;; data block

                ;; Unpack the array onto the pending stack (over the popped
                ;; array's slot and upward).
                (local.set $i (i32.const 0))
                (block $call_spread_unpack_done
                  (loop $call_spread_unpack_loop
                    (br_if $call_spread_unpack_done (i32.ge_u (local.get $i) (local.get $operand1)))
                    (local.set $element_pointer (i32.add
                      (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
                      (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
                    (call $pending_push
                      (i32.load (call $abs (local.get $element_pointer)))
                      (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 4))))
                      (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 8))))
                      (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 12)))))
                    (local.set $i (i32.add (local.get $i) (i32.const 1)))
                    (br $call_spread_unpack_loop)
                  )
                )
              )
            )

            ;; Corrupt-operand tripwire: the closure and its argc
            ;; arguments are ON the operand stack, so argc + 1 can never
            ;; exceed its depth. A corrupt argc would read a wild
            ;; address as the closure (and reach RECONCILE_PARAMS as a
            ;; corrupt frame ARGC).
            (if (i32.ge_u (local.get $operand1)
                  (i32.div_u
                    (i32.sub
                      (call $read_ctx (global.get $CTX_PENDING_POINTER))
                      (call $pending_base_seg))
                    (global.get $VALUE_SIZE)))
              (then
                (call $fault_error (global.get $ERR_CORRUPT_OPERAND) (local.get $operand1) (local.get $pc))
                (br $exit)))

            ;; Calculate where the closure is on the pending stack
            ;; closure_position = pending_pointer - (argc + 1) * VALUE_SIZE
            (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
            (local.set $value_pointer
              (i32.sub
                (local.get $pending_pointer)
                (i32.mul
                  (i32.add (local.get $operand1) (i32.const 1))
                  (global.get $VALUE_SIZE))))

            (local.set $type1 (call $value_type (local.get $value_pointer)))

            ;; Handle TYPE_BOUND_METHOD (global functions like isNaN, isFinite)
            (if (i32.eq (local.get $type1) (global.get $TYPE_BOUND_METHOD))
              (then
                ;; Extract receiver info from bound method
                ;; Format: [type:i32][flags:i32][receiver_pointer:i32][method_id:i32]
                ;; For arrays/strings: flags = receiver_type, receiver_pointer = pointer
                ;; For msgpack: flags = TYPE_MSGPACK_REF | (offset << 8), receiver_pointer = parent_data_ptr
                ;; For globals: flags = 0, receiver_pointer = 0
                (local.set $receiver_type (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 4)))))
                (local.set $receiver_pointer (call $value_data_lo (local.get $value_pointer)))
                (local.set $method_id (call $value_data_hi (local.get $value_pointer)))

                ;; Promise methods yield to airlock (too complex for WASM)
                (if (i32.eq (local.get $receiver_type) (global.get $TYPE_PROMISE))
                  (then
                    ;; Write promise method request to external_request_base
                    ;; [promiseHeaderPointer:4][methodId:4][argsPointer:4][argCount:4]
                    (i32.store (call $abs (global.get $external_request_base))
                      (local.get $receiver_pointer))
                    (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 4)))
                      (local.get $method_id))
                    (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 8)))
                      (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE)))
                    (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 12)))
                      (local.get $operand1))

                    ;; Clean up pending stack: remove bound method + args
                    ;; Restore pending pointer to where the bound method was
                    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $value_pointer))

                    ;; Save the complete continuation and yield. Another context may run
                    ;; before this slot resumes and replace the instance-global
                    ;; current_scope, so CTX_SCOPE must travel with every yield.
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX)
                      (i32.add (local.get $pc) (i32.const 1)))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_PROMISE_METHOD))
                    (br $exit)
                  )
                )

                ;; Promise static methods (Promise.all, Promise.race) yield to airlock
                ;; method_id in [0x35, 0x36] — all Promise static methods that need airlock
                (if (i32.and
                      (i32.ge_u (local.get $method_id) (global.get $METHOD_PROMISE_ALL))
                      (i32.le_u (local.get $method_id) (global.get $METHOD_PROMISE_RACE)))
                  (then
                    ;; Write request: [0 (static call)][methodId][argsPointer][argCount]
                    (i32.store (call $abs (global.get $external_request_base))
                      (i32.const 0))
                    (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 4)))
                      (local.get $method_id))
                    (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 8)))
                      (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE)))
                    (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 12)))
                      (local.get $operand1))

                    ;; Clean up pending stack
                    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $value_pointer))

                    ;; Save the complete continuation and yield. Another context may run
                    ;; before this slot resumes and replace the instance-global
                    ;; current_scope, so CTX_SCOPE must travel with every yield.
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX)
                      (i32.add (local.get $pc) (i32.const 1)))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_PROMISE_METHOD))
                    (br $exit)
                  )
                )

                ;; Array.from with an iterable source (detached-call form,
                ;; e.g. `let f = Array.from; f(set)`): normalize the source
                ;; slot before dispatch — Set/Map/typed sources convert
                ;; natively in place, user iterables drain through an
                ;; ARRAY_FROM_SEED continuation that re-runs this CALL with
                ;; the array substituted, and null/undefined throw
                ;; "Not iterable". Gated to plain CALL: a CALL_SPREAD
                ;; re-run would meet the already-unpacked stack.
                (if (i32.and
                      (i32.eq (local.get $opcode) (global.get $OP_CALL))
                      (i32.or
                        (i32.eq (local.get $method_id) (global.get $METHOD_ARRAY_FROM))
                        (i32.eq (local.get $method_id) (global.get $METHOD_OBJECT_FROM_ENTRIES))))
                  (then
                    (local.set $result_i32 (call $array_from_intercept
                      (local.get $value_pointer) (local.get $operand1) (local.get $method_id) (local.get $pc)))
                    (if (i32.eq (local.get $result_i32) (i32.const -4)) (then (br $exit)))
                    (if (i32.eq (local.get $result_i32) (i32.const -5))
                      (then
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop)))
                    (if (i32.eq (local.get $result_i32) (i32.const -2))
                      (then
                        (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                        (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                        (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                        (br $exit)))
                    ;; -6: generator seed parked (EXIT_GENERATOR_NEXT prepared).
                    (if (i32.eq (local.get $result_i32) (i32.const -6))
                      (then
                        (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                        (br $exit)))
                    (if (i32.ge_s (local.get $result_i32) (i32.const 0))
                      (then
                        (local.set $pc (local.get $result_i32))
                        (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                        (br $loop)))
                    ;; -3: proceed to dispatch — but a callable second
                    ;; argument would be a mapFn, and the map rewrite
                    ;; lives in the method-call path only (OP_CALL has no
                    ;; callback-method staging). Loud beats silently
                    ;; ignoring the mapFn.
                    (if (i32.and
                          (i32.eq (local.get $method_id) (global.get $METHOD_ARRAY_FROM))
                          (i32.ge_u (local.get $operand1) (i32.const 2)))
                      (then
                        (local.set $value_pointer4 (i32.add (local.get $value_pointer) (i32.mul (global.get $VALUE_SIZE) (i32.const 2))))
                        (if (i32.eq (call $value_type (local.get $value_pointer4)) (global.get $TYPE_FUNCTION))
                          (then
                            (if (call $throw_type_error_with_type
                                  (global.get $BUILTIN_MSG_DETACHED_CALLBACK) (global.get $TYPE_FUNCTION))
                              (then (br $exit))
                              (else
                                (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                                (br $loop)))))))
                  )
                )

                ;; JSON.stringify with a FUNCTION replacer (detached-call
                ;; form): drive the transform up front — see the
                ;; CALL_METHOD twin. Gated to plain CALL.
                (if (i32.and
                      (i32.eq (local.get $opcode) (global.get $OP_CALL))
                      (i32.and
                        (i32.eq (local.get $method_id) (global.get $METHOD_JSON_STRINGIFY))
                        (i32.ge_u (local.get $operand1) (i32.const 2))))
                  (then
                    (local.set $value_pointer3 (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE)))
                    (local.set $value_pointer4 (i32.add (local.get $value_pointer3) (global.get $VALUE_SIZE)))
                    (if (i32.eq (call $value_type (local.get $value_pointer4)) (global.get $TYPE_FUNCTION))
                      (then
                        (local.set $result_i32 (call $json_transform_begin
                          (local.get $value_pointer3)
                          (call $value_data_lo (local.get $value_pointer4))
                          (i32.sub (call $read_ctx (global.get $CTX_PENDING_POINTER)) (local.get $value_pointer3))
                          (local.get $pc)))
                        (if (i32.eq (local.get $result_i32) (i32.const -2))
                          (then
                            (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                            (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                            (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                            (br $exit)))
                        (if (i32.eq (local.get $result_i32) (i32.const -1))
                          (then
                            (if (call $throw_from_set_error) (then (br $exit)))
                            (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                            (br $loop)))
                        (local.set $pc (local.get $result_i32))
                        (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                        (br $loop)
                      )
                    )
                  )
                )

                ;; JSON.parse with a FUNCTION reviver (detached-call form):
                ;; parse natively first (pure data, no user code), then
                ;; drive the JSON_INTERNALIZE walk. Its completion pushes
                ;; the revived result directly and continues after the
                ;; call — a re-run would re-parse and re-fire revivers.
                ;; Gated to plain CALL; see the CALL_METHOD twin.
                (if (i32.and
                      (i32.eq (local.get $opcode) (global.get $OP_CALL))
                      (i32.and
                        (i32.eq (local.get $method_id) (global.get $METHOD_JSON_PARSE))
                        (i32.ge_u (local.get $operand1) (i32.const 2))))
                  (then
                    (local.set $value_pointer3 (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE)))
                    (local.set $value_pointer4 (i32.add (local.get $value_pointer3) (global.get $VALUE_SIZE)))
                    (if (i32.and
                          (i32.eq (call $value_type (local.get $value_pointer4)) (global.get $TYPE_FUNCTION))
                          (i32.eq (call $value_type (local.get $value_pointer3)) (global.get $TYPE_STRING)))
                      (then
                        ;; Working-buffer budget mirrors $json_parse_method.
                        (if (call $check_heap_overflow
                              (i32.add
                                (i32.mul (call $estimate_arraybuffer_size (i32.const 4096)) (i32.const 3))
                                (i32.mul (call $estimate_typed_array_descriptor_size) (i32.const 3))))
                          (then
                            (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                            (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                            (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                            (br $exit)))
                        (if (i32.eqz (call $json_parse (call $value_data_lo (local.get $value_pointer3))))
                          (then
                            (if (global.get $memory_pressure_signaled)
                              (then
                                (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                                (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                                (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                                (br $exit)))
                            (if (call $throw_from_set_error) (then (br $exit)))
                            (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                            (br $loop)))
                        (local.set $result_i32 (call $json_internalize_begin
                          (local.get $value_pointer)
                          (call $value_data_lo (local.get $value_pointer4))
                          (local.get $pc)))
                        (if (i32.eq (local.get $result_i32) (i32.const -2))
                          (then
                            (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                            (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                            (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                            (br $exit)))
                        (if (i32.eq (local.get $result_i32) (i32.const -1))
                          (then
                            (if (call $throw_from_set_error) (then (br $exit)))
                            (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                            (br $loop)))
                        (local.set $pc (local.get $result_i32))
                        (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                        (br $loop)
                      )
                    )
                  )
                )

                ;; RegExp exec/test: a fuel-resumable engine match,
                ;; dispatched inline (never via $builtin_table — the
                ;; $builtin_sig shape cannot carry fuel or a pause
                ;; disposition). Mirrors the RegExp-constructor arm's
                ;; disposition handling.
                (if (i32.or
                      (i32.eq (local.get $method_id) (global.get $METHOD_REGEXP_EXEC))
                      (i32.eq (local.get $method_id) (global.get $METHOD_REGEXP_TEST)))
                  (then
                    (if (i32.ne (local.get $receiver_type) (global.get $TYPE_REGEXP))
                      (then
                        (if (call $throw_type_error_with_message
                              (global.get $BUILTIN_MSG_REGEXP_RECEIVER))
                          (then (br $exit))
                          (else
                            (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                            (br $loop)))))
                    (global.set $current_executing_pc (local.get $pc))
                    (call $regexp_match_step
                      (local.get $receiver_pointer)
                      (local.get $method_id)
                      (local.get $value_pointer)   ;; result over the callee slot
                      (local.get $operand1)
                      (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE))
                      (local.get $pending_pointer)
                      (local.get $fuel)
                      (i32.const 0))
                    (local.set $fuel)
                    (local.set $result_i32)
                    (if (i32.eqz (local.get $result_i32))
                      (then
                        (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                        (br $loop)))
                    (if (i32.eq (local.get $result_i32) (i32.const 1))
                      (then
                        (call $call_pressure_restore_pending (local.get $opcode)
                          (local.get $pending_pointer) (local.get $value_pointer)
                          (local.get $spread_array_pointer))
                        (local.set $fuel (i32.const 0))
                        (br $loop)))
                    (if (i32.eq (local.get $result_i32) (i32.const 2))
                      (then
                        (call $call_pressure_restore_pending (local.get $opcode)
                          (local.get $pending_pointer) (local.get $value_pointer)
                          (local.get $spread_array_pointer))
                        (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                        (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                        (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                        (br $exit)))
                    (if (i32.eq (local.get $result_i32) (i32.const 4))
                      (then
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop)))
                    (br $exit)))

                ;; Schema: compile / one-shots / instance methods — the
                ;; same fuel-resumable inline dispatch as RegExp exec/test.
                (block $proof_native_call_fallback
                (if (call $is_proof_inline_call (local.get $method_id) (local.get $value_pointer)
                      (local.get $operand1)
                      (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE)))
                  (then
                    (global.set $current_executing_pc (local.get $pc))
                    (call $proof_native_op_step
                      (local.get $method_id)
                      (local.get $value_pointer)   ;; result over the callee slot
                      (local.get $operand1)
                      (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE))
                      (local.get $pending_pointer)
                      (local.get $fuel))
                    (local.set $fuel)
                    (local.set $result_i32)
                    (br_if $proof_native_call_fallback (i32.eq (local.get $result_i32) (i32.const 6)))
                    (if (i32.eqz (local.get $result_i32))
                      (then
                        (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                        (br $loop)))
                    (if (i32.eq (local.get $result_i32) (i32.const 1))
                      (then
                        (call $call_pressure_restore_pending (local.get $opcode)
                          (local.get $pending_pointer) (local.get $value_pointer)
                          (local.get $spread_array_pointer))
                        (local.set $fuel (i32.const 0))
                        (br $loop)))
                    (if (i32.eq (local.get $result_i32) (i32.const 2))
                      (then
                        (call $call_pressure_restore_pending (local.get $opcode)
                          (local.get $pending_pointer) (local.get $value_pointer)
                          (local.get $spread_array_pointer))
                        (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                        (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                        (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                        (br $exit)))
                    (if (i32.eq (local.get $result_i32) (i32.const 4))
                      (then
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop)))
                    (br $exit)))
                )

                (if (call $is_schema_inline_method (local.get $method_id))
                  (then
                    (if (i32.and (call $is_schema_instance_method (local.get $method_id))
                                 (i32.ne (local.get $receiver_type) (global.get $TYPE_SCHEMA)))
                      (then
                        (if (call $throw_type_error_with_message
                              (global.get $BUILTIN_MSG_SCHEMA_RECEIVER))
                          (then (br $exit))
                          (else
                            (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                            (br $loop)))))
                    (global.set $current_executing_pc (local.get $pc))
                    (call $schema_op_step
                      (local.get $method_id)
                      (local.get $receiver_pointer)
                      (local.get $value_pointer)   ;; result over the callee slot
                      (local.get $operand1)
                      (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE))
                      (local.get $pending_pointer)
                      (local.get $fuel))
                    (local.set $fuel)
                    (local.set $result_i32)
                    (if (i32.eqz (local.get $result_i32))
                      (then
                        (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                        (br $loop)))
                    (if (i32.eq (local.get $result_i32) (i32.const 1))
                      (then
                        (call $call_pressure_restore_pending (local.get $opcode)
                          (local.get $pending_pointer) (local.get $value_pointer)
                          (local.get $spread_array_pointer))
                        (local.set $fuel (i32.const 0))
                        (br $loop)))
                    (if (i32.eq (local.get $result_i32) (i32.const 2))
                      (then
                        (call $call_pressure_restore_pending (local.get $opcode)
                          (local.get $pending_pointer) (local.get $value_pointer)
                          (local.get $spread_array_pointer))
                        (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                        (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                        (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                        (br $exit)))
                    (if (i32.eq (local.get $result_i32) (i32.const 4))
                      (then
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop)))
                    (br $exit)))

                ;; RegExp string methods (step 5): match/matchAll/search
                ;; and the matchAll iterator's next() always route here;
                ;; split/replace/replaceAll only for a string receiver
                ;; with a RegExp first argument (string-argument forms
                ;; stay on the fuelless builtin-table path). All are
                ;; fuel-resumable; disposition 5 = a replace callback
                ;; frame was staged.
                (if (i32.or
                      (i32.or
                        (i32.or
                          (i32.eq (local.get $method_id) (global.get $METHOD_STRING_MATCH))
                          (i32.eq (local.get $method_id) (global.get $METHOD_STRING_MATCH_ALL)))
                        (i32.or
                          (i32.eq (local.get $method_id) (global.get $METHOD_STRING_SEARCH))
                          (i32.eq (local.get $method_id) (global.get $METHOD_REGEXP_STRING_ITERATOR_NEXT))))
                      (i32.and
                        (i32.and
                          (i32.eq (local.get $receiver_type) (global.get $TYPE_STRING))
                          (i32.ge_u (local.get $operand1) (i32.const 1)))
                        (i32.and
                          (i32.or
                            (i32.or
                              (i32.eq (local.get $method_id) (global.get $METHOD_SPLIT))
                              (i32.eq (local.get $method_id) (global.get $METHOD_REPLACE)))
                            (i32.eq (local.get $method_id) (global.get $METHOD_REPLACE_ALL)))
                          (i32.eq
                            (call $value_type (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE)))
                            (global.get $TYPE_REGEXP)))))
                  (then
                    (global.set $current_executing_pc (local.get $pc))
                    (if (i32.eq (local.get $method_id) (global.get $METHOD_STRING_MATCH))
                      (then
                        (call $regexp_string_match_step
                          (local.get $receiver_pointer)
                          (local.get $value_pointer)
                          (local.get $operand1)
                          (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE))
                          (local.get $pending_pointer)
                          (local.get $fuel))
                        (local.set $fuel)
                        (local.set $result_i32)))
                    (if (i32.eq (local.get $method_id) (global.get $METHOD_STRING_MATCH_ALL))
                      (then
                        (call $regexp_string_match_all_step
                          (local.get $receiver_pointer)
                          (local.get $value_pointer)
                          (local.get $operand1)
                          (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE))
                          (local.get $pending_pointer)
                          (local.get $fuel))
                        (local.set $fuel)
                        (local.set $result_i32)))
                    (if (i32.eq (local.get $method_id) (global.get $METHOD_STRING_SEARCH))
                      (then
                        (call $regexp_string_search_step
                          (local.get $receiver_pointer)
                          (local.get $value_pointer)
                          (local.get $operand1)
                          (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE))
                          (local.get $pending_pointer)
                          (local.get $fuel))
                        (local.set $fuel)
                        (local.set $result_i32)))
                    (if (i32.eq (local.get $method_id) (global.get $METHOD_REGEXP_STRING_ITERATOR_NEXT))
                      (then
                        (call $regexp_string_iterator_next_step
                          (local.get $receiver_pointer)
                          (local.get $value_pointer)
                          (local.get $pending_pointer)
                          (local.get $fuel))
                        (local.set $fuel)
                        (local.set $result_i32)))
                    (if (i32.eq (local.get $method_id) (global.get $METHOD_SPLIT))
                      (then
                        (call $regexp_string_split_step
                          (local.get $receiver_pointer)
                          (local.get $value_pointer)
                          (local.get $operand1)
                          (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE))
                          (local.get $pending_pointer)
                          (local.get $fuel))
                        (local.set $fuel)
                        (local.set $result_i32)))
                    (if (i32.or
                          (i32.eq (local.get $method_id) (global.get $METHOD_REPLACE))
                          (i32.eq (local.get $method_id) (global.get $METHOD_REPLACE_ALL)))
                      (then
                        (call $regexp_string_replace_step
                          (local.get $receiver_pointer)
                          (local.get $method_id)
                          (local.get $value_pointer)
                          (local.get $operand1)
                          (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE))
                          (local.get $pending_pointer)
                          (local.get $fuel))
                        (local.set $fuel)
                        (local.set $result_i32)))
                    (if (i32.eqz (local.get $result_i32))
                      (then
                        (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                        (br $loop)))
                    (if (i32.eq (local.get $result_i32) (i32.const 1))
                      (then
                        (call $call_pressure_restore_pending (local.get $opcode)
                          (local.get $pending_pointer) (local.get $value_pointer)
                          (local.get $spread_array_pointer))
                        (local.set $fuel (i32.const 0))
                        (br $loop)))
                    (if (i32.eq (local.get $result_i32) (i32.const 2))
                      (then
                        (call $call_pressure_restore_pending (local.get $opcode)
                          (local.get $pending_pointer) (local.get $value_pointer)
                          (local.get $spread_array_pointer))
                        (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                        (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                        (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                        (br $exit)))
                    (if (i32.eq (local.get $result_i32) (i32.const 4))
                      (then
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop)))
                    (if (i32.eq (local.get $result_i32) (i32.const 5))
                      (then
                        (local.set $frame_pointer
                          (call $abs
                            (i32.sub
                              (call $read_ctx (global.get $CTX_CALL_STACK_POINTER))
                              (global.get $FRAME_SIZE))))
                        (i32.store
                          (i32.add
                            (local.get $frame_pointer)
                            (global.get $FRAME_INSTRUCTION_INDEX))
                          (i32.add (local.get $pc) (i32.const 1)))
                        (local.set $pc
                          (call $enter_staged_native_continuation_callback
                            (local.get $frame_pointer)))
                        (br $loop)))
                    (br $exit)))

                ;; Dispatch to builtin method
                (local.set $dispatch_result
                  (call $dispatch_builtin_method
                    (local.get $receiver_type)
                    (local.get $receiver_pointer)
                    (local.get $method_id)
                    (local.get $operand1)   ;; argc
                    (local.get $value_pointer)))   ;; stack_base (where function was)

                ;; Memory-pressure rollback: if any helper inside the
                ;; method signaled pressure, restore the pending stack
                ;; to its CALL-entry state and yield. The method may
                ;; have done partial work — that work either lives
                ;; beyond pending_pointer (which we restore) and is
                ;; thus invisible, or it allocated in the string table
                ;; (intermediate interns) which gc on resume reclaims
                ;; or dedups. The bound-method value at $value_pointer
                ;; sits BELOW the restored pp, so it persists for the
                ;; retry's re-execution. (Spread form: restore rebuilds
                ;; the packed [callee, args_array] shape instead.)
                (if (global.get $memory_pressure_signaled)
                  (then
                    (call $call_pressure_restore_pending (local.get $opcode)
                      (local.get $pending_pointer) (local.get $value_pointer)
                      (local.get $spread_array_pointer))
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)
                  )
                )

                ;; Code 3: the stringify walk met a getter-backed property.
                ;; Restore the pending stack (dispatch truncated it) and run
                ;; the JSON_TRANSFORM driver; its completion re-runs this
                ;; CALL with the resolved copy substituted. The spread form
                ;; cannot re-run against its unpacked stack — it keeps the
                ;; loud accessor TypeError.
                (if (i32.eq (local.get $dispatch_result) (i32.const 3))
                  (then
                    (if (i32.ne (local.get $opcode) (global.get $OP_CALL))
                      (then
                        (if (call $throw_type_error_with_type
                              (global.get $BUILTIN_MSG_ACCESSOR_UNSUPPORTED) (global.get $TYPE_ACCESSOR))
                          (then (br $exit))
                          (else
                            (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                            (br $loop)))))
                    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $pending_pointer))
                    (local.set $value_pointer3 (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE)))
                    (local.set $result_i32 (call $json_transform_begin
                      (local.get $value_pointer3)
                      (i32.const 0)
                      (i32.sub (local.get $pending_pointer) (local.get $value_pointer3))
                      (local.get $pc)))
                    (if (i32.eq (local.get $result_i32) (i32.const -2))
                      (then
                        (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                        (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                        (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                        (br $exit)))
                    (if (i32.eq (local.get $result_i32) (i32.const -1))
                      (then
                        (if (call $throw_from_set_error) (then (br $exit)))
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop)))
                    (local.set $pc (local.get $result_i32))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )

                (if (i32.eq
                      (local.get $dispatch_result)
                      (global.get $STATUS_NATIVE_CONTINUATION_STAGED))
                  (then
                    (local.set $frame_pointer
                      (call $abs
                        (i32.sub
                          (call $read_ctx (global.get $CTX_CALL_STACK_POINTER))
                          (global.get $FRAME_SIZE))))
                    (i32.store
                      (i32.add
                        (local.get $frame_pointer)
                        (global.get $FRAME_INSTRUCTION_INDEX))
                      (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $pc
                      (call $enter_staged_native_continuation_callback
                        (local.get $frame_pointer)))
                    (br $loop)))

                ;; Code 4 (generators): the native prepared an exit condition
                ;; (EXIT_GENERATOR_NEXT with the request block written and the
                ;; pending stack reset). Save the resume point and exit.
                (if (i32.eq (local.get $dispatch_result) (i32.const 4))
                  (then
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (i32.add (local.get $pc) (i32.const 1)))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $exit)
                  )
                )

                ;; Handle dispatch result: 0=ok, 1=caught exception, 2=uncaught error
                (if (i32.eq (local.get $dispatch_result) (i32.const 2))
                  (then
                    (if (global.get $throw_already_searched)
                      (then
                        (global.set $throw_already_searched (i32.const 0))
                        (br $exit)))
                    (if (call $throw_from_set_error)
                      (then (br $exit)))
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)))
                (if (i32.eq (local.get $dispatch_result) (i32.const 1))
                  (then
                    ;; Exception was caught, reload instruction index
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)
                  )
                )

                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Handle TYPE_CONSTRUCTOR (String(), Number(), etc. called without new)
            ;; These act as conversion functions
            (if (i32.eq (local.get $type1) (global.get $TYPE_CONSTRUCTOR))
              (then
                ;; Extract method_id from constructor
                ;; Format: [type:i32][flags:i32][object_pointer:i32][method_id:i32]
                (local.set $method_id (call $value_data_hi (local.get $value_pointer)))

                ;; RegExp(pattern, flags) without `new` constructs exactly
                ;; like the new-form (JS semantics; the pattern-is-already-
                ;; a-RegExp identity shortcut is deliberately not kept —
                ;; the call form always compiles a fresh descriptor).
                (if (i32.eq (local.get $method_id) (global.get $METHOD_REGEXP_CONSTRUCTOR))
                  (then
                    (global.set $current_executing_pc (local.get $pc))
                    (call $regexp_construct_step
                      (local.get $value_pointer) (local.get $operand1)
                      (local.get $pending_pointer) (local.get $fuel))
                    (local.set $fuel)
                    (local.set $result_i32)
                    (if (i32.eqz (local.get $result_i32))
                      (then
                        (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                        (br $loop)))
                    (if (i32.eq (local.get $result_i32) (i32.const 1))
                      (then
                        (call $call_pressure_restore_pending (local.get $opcode)
                          (local.get $pending_pointer) (local.get $value_pointer)
                          (local.get $spread_array_pointer))
                        (local.set $fuel (i32.const 0))
                        (br $loop)))
                    (if (i32.eq (local.get $result_i32) (i32.const 2))
                      (then
                        (call $call_pressure_restore_pending (local.get $opcode)
                          (local.get $pending_pointer) (local.get $value_pointer)
                          (local.get $spread_array_pointer))
                        (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                        (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                        (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                        (br $exit)))
                    (if (i32.eq (local.get $result_i32) (i32.const 4))
                      (then
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop)))
                    (br $exit)))

                ;; Schema(schema, options) without `new`: compile.
                (if (i32.eq (local.get $method_id) (global.get $METHOD_SCHEMA_CONSTRUCTOR))
                  (then
                    (global.set $current_executing_pc (local.get $pc))
                    (call $schema_construct_step
                      (local.get $value_pointer) (local.get $operand1)
                      (local.get $pending_pointer) (local.get $fuel))
                    (local.set $fuel)
                    (local.set $result_i32)
                    (if (i32.eqz (local.get $result_i32))
                      (then
                        (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                        (br $loop)))
                    (if (i32.eq (local.get $result_i32) (i32.const 1))
                      (then
                        (call $call_pressure_restore_pending (local.get $opcode)
                          (local.get $pending_pointer) (local.get $value_pointer)
                          (local.get $spread_array_pointer))
                        (local.set $fuel (i32.const 0))
                        (br $loop)))
                    (if (i32.eq (local.get $result_i32) (i32.const 2))
                      (then
                        (call $call_pressure_restore_pending (local.get $opcode)
                          (local.get $pending_pointer) (local.get $value_pointer)
                          (local.get $spread_array_pointer))
                        (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                        (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                        (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                        (br $exit)))
                    (if (i32.eq (local.get $result_i32) (i32.const 4))
                      (then
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop)))
                    (br $exit)))

                ;; Dispatch conversion based on method_id
                (local.set $dispatch_result
                  (call $dispatch_builtin_method
                    (global.get $TYPE_CONSTRUCTOR)
                    (i32.const 0)
                    (local.get $method_id)
                    (local.get $operand1)   ;; argc
                    (local.get $value_pointer)))   ;; stack_base

                ;; Memory-pressure rollback (see comment in TYPE_BOUND_METHOD branch above).
                (if (global.get $memory_pressure_signaled)
                  (then
                    (call $call_pressure_restore_pending (local.get $opcode)
                      (local.get $pending_pointer) (local.get $value_pointer)
                      (local.get $spread_array_pointer))
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)
                  )
                )

                (if (i32.eq
                      (local.get $dispatch_result)
                      (global.get $STATUS_NATIVE_CONTINUATION_STAGED))
                  (then
                    (local.set $frame_pointer
                      (call $abs
                        (i32.sub
                          (call $read_ctx (global.get $CTX_CALL_STACK_POINTER))
                          (global.get $FRAME_SIZE))))
                    (i32.store
                      (i32.add
                        (local.get $frame_pointer)
                        (global.get $FRAME_INSTRUCTION_INDEX))
                      (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $pc
                      (call $enter_staged_native_continuation_callback
                        (local.get $frame_pointer)))
                    (br $loop)))

                ;; Code 4 (generators): the native prepared an exit condition
                ;; (EXIT_GENERATOR_NEXT with the request block written and the
                ;; pending stack reset). Save the resume point and exit.
                (if (i32.eq (local.get $dispatch_result) (i32.const 4))
                  (then
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (i32.add (local.get $pc) (i32.const 1)))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $exit)
                  )
                )

                ;; Handle dispatch result: 0=ok, 1=caught exception, 2=uncaught error
                (if (i32.eq (local.get $dispatch_result) (i32.const 2))
                  (then
                    (if (global.get $throw_already_searched)
                      (then
                        (global.set $throw_already_searched (i32.const 0))
                        (br $exit)))
                    (if (call $throw_from_set_error)
                      (then (br $exit)))
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)))
                (if (i32.eq (local.get $dispatch_result) (i32.const 1))
                  (then
                    ;; Exception was caught, reload instruction index
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)
                  )
                )

                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Handle TYPE_EXTERNAL_METHOD - yield to orchestrator.
            ;; methodOffset = data_hi of the callable. Reset slot is the
            ;; callable's own slot (closure_position) so the result lands there.
            (if (i32.eq (local.get $type1) (global.get $TYPE_EXTERNAL_METHOD))
              (then
                (local.set $fuel (call $yield_external_call
                  (local.get $value_pointer)
                  (local.get $operand1)
                  (call $value_data_hi (local.get $value_pointer))
                  (local.get $value_pointer)
                  (local.get $pc)
                  (local.get $fuel)))
                (br $exit)
              )
            )

            ;; Handle TYPE_EXTERNAL - direct call on external (no method name).
            ;; methodOffset = 0 signals direct call.
            (if (i32.eq (local.get $type1) (global.get $TYPE_EXTERNAL))
              (then
                (local.set $fuel (call $yield_external_call
                  (local.get $value_pointer)
                  (local.get $operand1)
                  (i32.const 0)
                  (local.get $value_pointer)
                  (local.get $pc)
                  (local.get $fuel)))
                (br $exit)
              )
            )

            ;; Handle TYPE_PROMISE_RESOLVE / TYPE_PROMISE_REJECT - Promise
            ;; executor's resolve/reject continuation. Not a host capability —
            ;; no membrane, no handler lookup. The host runs the settle
            ;; logic inline via handlePromiseSettle.
            ;;
            ;; Value layout: [type=PROMISE_RESOLVE/REJECT][flags=0][promiseDataPointer][unused]
            ;; EXTERNAL_REQUEST layout (reused): [promisePointer:4][isReject:4][argsPointer:4][argCount:4]
            (if (i32.or
                  (i32.eq (local.get $type1) (global.get $TYPE_PROMISE_RESOLVE))
                  (i32.eq (local.get $type1) (global.get $TYPE_PROMISE_REJECT)))
              (then
                ;; promisePointer = data_lo
                (i32.store (call $abs (global.get $external_request_base))
                  (call $value_data_lo (local.get $value_pointer)))
                ;; isReject = 1 if TYPE_PROMISE_REJECT, else 0
                (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 4)))
                  (i32.eq (local.get $type1) (global.get $TYPE_PROMISE_REJECT)))
                ;; argsPointer = value_pointer + VALUE_SIZE (first arg right after the continuation)
                (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 8)))
                  (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE)))
                ;; argCount = operand1
                (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 12)))
                  (local.get $operand1))

                ;; Save state for resume.
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX)
                  (i32.add (local.get $pc) (i32.const 1)))
                (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                ;; Pre-position pending pointer to the continuation's slot —
                ;; the host writes undefined there (resolve/reject return void)
                ;; and pending_pointer ends up advanced by VALUE_SIZE just like
                ;; the EXTERNAL_CALL paths. Same invariant.
                (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $value_pointer))

                ;; Set status to PROMISE_SETTLE and exit
                (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_PROMISE_SETTLE))
                (br $exit)
              )
            )

            ;; Check it's a closure (OP_CALL)
            (if (i32.ne (local.get $type1) (global.get $TYPE_FUNCTION))
              (then
                (if (call $throw_call_not_function_diagnostic (local.get $value_pointer))
                  (then (br $exit))
                  (else
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)
                  )
                )
              )
            )

            ;; Get closure data pointer
            (local.set $closure_pointer (call $value_data_lo (local.get $value_pointer)))

            ;; Read closure fields (from header pointer)
            ;; Layout: [GC:8][prototype:4][count:4][capacity:4][flags:4][entries:4][sym_entries:4][start_instruction:4][end_instruction:4][scope:4][function_flags:4]
            ;; start_instruction at header + 32
            (local.set $start_instr (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 32)))))
            ;; scope at header + 40
            (local.set $captured_scope (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 40)))))
            ;; function_flags at header + 44
            (local.set $closure_flags (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 44)))))

            ;; Check if async function - yield to airlock for context spawn.
            ;; Async GENERATORS carry both flags and take the generator
            ;; branch below (their spawn is a generator context, not an
            ;; async-function context), so this matches ASYNC-and-only-ASYNC.
            (if (i32.eq
                  (i32.and (local.get $closure_flags)
                    (i32.or (global.get $CLOSURE_FLAG_ASYNC) (global.get $CLOSURE_FLAG_GENERATOR)))
                  (global.get $CLOSURE_FLAG_ASYNC))
              (then
                ;; Write async request to external_request_base.
                ;; Layout: [closurePointer:4][argsPointer:4][argCount:4]
                ;;         [receiverType:4][receiverFlags:4][receiverLo:4][receiverHi:4]
                ;; OP_CALL has no receiver (no `this` binding), so receiver
                ;; fields are TYPE_UNDEFINED — handleAsyncCall skips binding.
                (i32.store (call $abs (global.get $external_request_base))
                  (local.get $closure_pointer))
                (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 4)))
                  (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE)))
                (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 8)))
                  (local.get $operand1))
                (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 12)))
                  (global.get $TYPE_UNDEFINED))
                (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 16)))
                  (i32.const 0))
                (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 20)))
                  (i32.const 0))
                (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 24)))
                  (i32.const 0))

                ;; Save state for resume after async call
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX)
                  (i32.add (local.get $pc) (i32.const 1)))
                ;; Save current_scope (see comment in OP_CALL_METHOD async branch).
                (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))

                ;; Set status to ASYNC_CALL and exit
                (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_ASYNC_CALL))
                (br $exit)
              )
            )

            ;; Generator function: spawn a generator context instead of
            ;; running the body. Same request layout
            ;; as the async spawn; handleGeneratorCall pushes the
            ;; generator object as the call's result.
            (if (i32.and (local.get $closure_flags) (global.get $CLOSURE_FLAG_GENERATOR))
              (then
                (i32.store (call $abs (global.get $external_request_base))
                  (local.get $closure_pointer))
                (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 4)))
                  (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE)))
                (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 8)))
                  (local.get $operand1))
                (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 12)))
                  (global.get $TYPE_UNDEFINED))
                (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 16)))
                  (i32.const 0))
                (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 20)))
                  (i32.const 0))
                (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 24)))
                  (i32.const 0))

                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX)
                  (i32.add (local.get $pc) (i32.const 1)))
                (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_GENERATOR_CALL))
                (br $exit)
              )
            )

            ;; Push call frame
            (local.set $stack_pointer (call $read_ctx (global.get $CTX_CALL_STACK_POINTER)))
            (local.set $frame_pointer (call $abs (local.get $stack_pointer)))

            ;; PENDING_BASE = where the closure was (so on return, closure slot is reclaimed)
            ;; Frame saves the position of the closure, not current pending_pointer
            ;; v6: CODE_BLOCK removed from frame layout
            (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_INSTRUCTION_INDEX)) (i32.add (local.get $pc) (i32.const 1)))
            (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_SCOPE_POINTER)) (global.get $current_scope))
            (call $save_frame_pending_base (local.get $frame_pointer) (local.get $value_pointer))
            (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_PENDING_COUNT)) (i32.const 1))
            (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_FLAGS)) (i32.const 0))
            (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_AST_NODE)) (i32.const 0))
            (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_ASYNC_PROMISE)) (i32.const 0))
            (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_ARGC)) (local.get $operand1))

            ;; Update stack pointer
            (call $write_ctx (global.get $CTX_CALL_STACK_POINTER)
              (i32.add (local.get $stack_pointer) (global.get $FRAME_SIZE)))

            ;; Create new scope with captured scope as parent
            (local.set $new_scope (call $scope_create (local.get $captured_scope)))
            (global.set $current_scope (local.get $new_scope))

            ;; For non-arrow functions, bind `this` to undefined
            ;; (Arrow functions inherit `this` from their lexical scope)
            (if (i32.eqz (i32.and (local.get $closure_flags) (global.get $CLOSURE_FLAG_ARROW)))
              (then
                ;; Read the interned "this" string offset from builtins
                (local.set $key_offset (call $read_builtin (i32.const 0x18))) ;; BUILTIN_NAME.THIS

                ;; Define `this` = undefined in the new scope
                (call $scope_define
                  (local.get $new_scope)
                  (local.get $key_offset)
                  (global.get $TYPE_UNDEFINED)
                  (i32.const 0)  ;; flags
                  (i32.const 0)  ;; data_lo
                  (i32.const 0)) ;; data_hi
                (call $scope_define_new_target (local.get $new_scope)
                  (global.get $TYPE_UNDEFINED) (i32.const 0))
              )
            )

            ;; Jump to function body
            ;; Args are still on pending stack for LET_VAR to pop
            (local.set $pc (local.get $start_instr))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; CALL_METHOD (0x75): operand1 = argc
        ;; Stack: [receiver, closure/bound_method, arg1, arg2, ..., argN]
        ;; For closures: binds `this` to receiver for non-arrow functions
        ;; For bound methods: dispatches to built-in method implementation
        ;;
        ;; CALL_METHOD_SPREAD (0x89) shares this handler: its prologue pops
        ;; the packed args array (parser-emitted, always an Array) and
        ;; unpacks it in place, after which the stack and operand1 match
        ;; CALL_METHOD exactly — bound methods (`arr.push(...vals)`),
        ;; closures, async methods, externals and promise continuations all
        ;; take their regular branch. Pressure retries restore the packed
        ;; shape via $call_pressure_restore_pending.
        (if (i32.or
              (i32.eq (local.get $opcode) (global.get $OP_CALL_METHOD))
              (i32.eq (local.get $opcode) (global.get $OP_CALL_METHOD_SPREAD)))
          (then
            (if (i32.eq (local.get $opcode) (global.get $OP_CALL_METHOD_SPREAD))
              (then
                ;; Peek the args array — validation and the capacity grow
                ;; below run BEFORE the pop so a pressure yield leaves the
                ;; stack untouched for the retry (see CALL_SPREAD above).
                (local.set $value_pointer (call $pending_peek))
                (local.set $type1 (i32.load (call $abs (local.get $value_pointer))))
                (if (i32.ne (local.get $type1) (global.get $TYPE_ARRAY))
                  (then
                    (if (call $raise_error (global.get $ERR_TYPE_ERROR) (local.get $type1))
                      (then (br $exit)))
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)
                  )
                )
                (local.set $spread_array_pointer (call $value_data_lo (local.get $value_pointer)))
                (local.set $operand1
                  (i32.load (call $abs (i32.add (local.get $spread_array_pointer) (i32.const 8)))))

                ;; Pre-grow the pending stack for the unpack (see the
                ;; CALL_SPREAD prologue for the full rationale).
                (block $call_method_spread_capacity_ok
                  (loop $call_method_spread_capacity_loop
                    (br_if $call_method_spread_capacity_ok
                      (i32.le_u
                        (i32.add
                          (call $read_ctx (global.get $CTX_PENDING_POINTER))
                          (i32.mul (i32.add (local.get $operand1) (i32.const 4)) (global.get $VALUE_SIZE)))
                        (call $read_ctx (global.get $CTX_PENDING_LIMIT))))
                    (if (call $grow_stack
                          (global.get $CTX_PENDING_BASE) (global.get $CTX_PENDING_LIMIT)
                          (global.get $CTX_PENDING_POINTER))
                      (then
                        (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                        (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                        (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                        (br $exit)
                      )
                    )
                    (br $call_method_spread_capacity_loop)
                  )
                )

                ;; Pop the args array (its header pointer is already saved).
                (drop (call $pending_pop))
                (local.set $data_pointer
                  (i32.load (call $abs (i32.add (local.get $spread_array_pointer) (i32.const 16)))))

                ;; Unpack the array onto the pending stack.
                (local.set $i (i32.const 0))
                (block $call_method_spread_unpack_done
                  (loop $call_method_spread_unpack_loop
                    (br_if $call_method_spread_unpack_done (i32.ge_u (local.get $i) (local.get $operand1)))
                    (local.set $element_pointer (i32.add
                      (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
                      (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
                    (call $pending_push
                      (i32.load (call $abs (local.get $element_pointer)))
                      (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 4))))
                      (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 8))))
                      (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 12)))))
                    (local.set $i (i32.add (local.get $i) (i32.const 1)))
                    (br $call_method_spread_unpack_loop)
                  )
                )
              )
            )

            ;; Corrupt-operand tripwire: the receiver, the method, and
            ;; its argc arguments are ON the operand stack, so argc + 2
            ;; can never exceed its depth. A corrupt argc would read
            ;; wild addresses as method and receiver. (The two-part
            ;; compare is wrap-proof for any 32-bit argc.)
            (local.set $index
              (i32.div_u
                (i32.sub
                  (call $read_ctx (global.get $CTX_PENDING_POINTER))
                  (call $pending_base_seg))
                (global.get $VALUE_SIZE)))
            (if (i32.or
                  (i32.lt_u (local.get $index) (i32.const 2))
                  (i32.gt_u (local.get $operand1) (i32.sub (local.get $index) (i32.const 2))))
              (then
                (call $fault_error (global.get $ERR_CORRUPT_OPERAND) (local.get $operand1) (local.get $pc))
                (br $exit)))

            ;; Calculate where the closure/method is on the pending stack
            ;; method_position = pending_pointer - (argc + 1) * VALUE_SIZE
            ;; receiver_position = method_position - VALUE_SIZE
            (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
            (local.set $value_pointer
              (i32.sub
                (local.get $pending_pointer)
                (i32.mul
                  (i32.add (local.get $operand1) (i32.const 1))
                  (global.get $VALUE_SIZE))))

            ;; receiver is just before closure/method
            (local.set $value_pointer2
              (i32.sub (local.get $value_pointer) (global.get $VALUE_SIZE)))

            (local.set $type1 (call $value_type (local.get $value_pointer)))

            ;; super() against a registered constructible external parent
            ;; (extends-externals D3, phase 1: beginConstruction). Gated on
            ;; operand2 bit 0 like the built-in branch below. Yields the
            ;; EXISTING external-call exit with the interned method name
            ;; "@beginConstruction" (unspellable in source); the airlock
            ;; validates the registration and grants, resolves new.target
            ;; from the request block, runs the host's beginConstruction,
            ;; brands the receiver with @externalBacking (+ the
            ;; @constructionLink slot) and CONSTRUCTION_PENDING, and
            ;; resumes with undefined as the super() result.
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_EXTERNAL))
                  (i32.and (call $read_operand2 (local.get $code_block) (local.get $pc)) (i32.const 1)))
              (then
                ;; The receiver must be an ordinary object.
                (if (i32.ne (call $value_type (local.get $value_pointer2)) (global.get $TYPE_OBJECT))
                  (then
                    (if (call $throw_type_error_with_type (global.get $BUILTIN_MSG_NOT_AN_OBJECT)
                          (call $value_type (local.get $value_pointer2)))
                      (then (br $exit))
                      (else
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop)
                      )
                    )
                  )
                )
                (local.set $receiver_pointer (call $value_data_lo (local.get $value_pointer2)))
                ;; A second initialization of the same receiver throws.
                (if (i32.and
                      (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 20))))
                      (global.get $OBJECT_FLAG_EXTERNAL_BACKED))
                  (then
                    (if (call $throw_type_error_with_message (global.get $BUILTIN_MSG_RECEIVER_ALREADY_INITIALIZED))
                      (then (br $exit))
                      (else
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop)
                      )
                    )
                  )
                )
                ;; Resolve @newtarget (the parser defines it in every
                ;; non-arrow invocation; super() emission propagates the
                ;; most-derived constructor into it).
                (local.set $entry_pointer (call $scope_lookup (global.get $current_scope)
                  (call $read_builtin (i32.const 0x5C4))))  ;; BUILTIN_NAME.NEW_TARGET
                ;; Stage the begin request through the shared yield path,
                ;; then add the construction extras the airlock reads:
                ;; +20 = new.target closure HEADER pointer (0 = none).
                (local.set $fuel (call $yield_external_call
                  (local.get $value_pointer)
                  (local.get $operand1)
                  (call $read_builtin (global.get $BUILTIN_CONSTRUCT_BEGIN))
                  (local.get $value_pointer2)
                  (local.get $pc)
                  (local.get $fuel)))
                (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 20)))
                  (if (result i32)
                    (i32.and
                      (i32.ne (local.get $entry_pointer) (i32.const 0))
                      (if (result i32) (i32.ne (local.get $entry_pointer) (i32.const 0))
                        (then (i32.eq (i32.load (call $abs (local.get $entry_pointer))) (global.get $TYPE_FUNCTION)))
                        (else (i32.const 0))))
                    (then (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 8)))))
                    (else (i32.const 0))))
                (br $exit)
              )
            )

            ;; super() against an allowlisted built-in parent
            ;; selected by operand2 bit 0. Only
            ;; the super-call emission sets it — so a plain call of a built-in
            ;; constructor value (`obj.m()` where m is Error) keeps its
            ;; current behavior. The parent runs no body and pushes no frame:
            ;; it initializes the receiver (`this`) in place, synchronously.
            ;; Error family: define the own `message` string, mirroring the
            ;; OP_NEW error branch (arg0 through $value_to_string, the empty
            ;; string without an argument). Object: no initialization at all.
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_CONSTRUCTOR))
                  (i32.and (call $read_operand2 (local.get $code_block) (local.get $pc)) (i32.const 1)))
              (then
                (local.set $method_id (call $value_data_hi (local.get $value_pointer)))

                ;; The receiver must be the object under construction.
                (if (i32.ne (call $value_type (local.get $value_pointer2)) (global.get $TYPE_OBJECT))
                  (then
                    (if (call $throw_type_error_with_type (global.get $BUILTIN_MSG_NOT_AN_OBJECT)
                          (call $value_type (local.get $value_pointer2)))
                      (then (br $exit))
                      (else
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop)
                      )
                    )
                  )
                )
                (local.set $receiver_pointer (call $value_data_lo (local.get $value_pointer2)))

                (if (i32.or
                      (i32.or
                        (i32.eq (local.get $method_id) (global.get $METHOD_ERROR_CONSTRUCTOR))
                        (i32.eq (local.get $method_id) (global.get $METHOD_TYPE_ERROR_CONSTRUCTOR)))
                      (i32.or
                        (i32.eq (local.get $method_id) (global.get $METHOD_REFERENCE_ERROR_CONSTRUCTOR))
                        (i32.or
                          (i32.eq (local.get $method_id) (global.get $METHOD_RANGE_ERROR_CONSTRUCTOR))
                          (i32.eq (local.get $method_id) (global.get $METHOD_SYNTAX_ERROR_CONSTRUCTOR)))))
                  (then
                    ;; Message string offset: arg0 (ToString) or "".
                    (if (i32.gt_u (local.get $operand1) (i32.const 0))
                      (then
                        (local.set $element_pointer (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE)))
                        (local.set $key_offset (call $value_to_string (local.get $element_pointer)))
                      )
                      (else
                        (local.set $key_offset (call $read_builtin (global.get $BUILTIN_LIT_EMPTY_STRING)))
                      )
                    )

                    ;; Fields may run before super() (accepted deviation), so
                    ;; the receiver's entries can be at capacity. Pre-budget
                    ;; the grow; on pressure, restore the packed spread shape
                    ;; and yield with the instruction unconsumed.
                    (if (call $check_heap_overflow (call $estimate_object_grow_size
                          (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 16))))))
                      (then
                        (call $call_pressure_restore_pending (local.get $opcode)
                          (local.get $pending_pointer) (local.get $value_pointer)
                          (local.get $spread_array_pointer))
                        (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                        (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                        (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                        (br $exit)
                      )
                    )

                    ;; Grow pre-budgeted just above — status droppable.
                    (drop (call $object_set_property
                      (local.get $receiver_pointer)
                      (call $read_builtin (global.get $BUILTIN_MESSAGE))
                      (global.get $TYPE_STRING)
                      (i32.const 0)
                      (local.get $key_offset)
                      (i32.const 0)))
                  )
                  (else
                    ;; Object: nothing to initialize. Any other method id is
                    ;; unreachable through CLASS_LINK's allowlist — reject a
                    ;; hand-built bytecode sequence loudly.
                    (if (i32.ne (local.get $method_id) (global.get $METHOD_OBJECT_CONSTRUCTOR))
                      (then
                        (if (call $throw_type_error_with_message (global.get $BUILTIN_MSG_NOT_EXTENSIBLE))
                          (then (br $exit))
                          (else
                            (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                            (br $loop)
                          )
                        )
                      )
                    )
                  )
                )

                ;; The call result (undefined, matching a SandScript parent
                ;; constructor's implicit return) lands at the receiver slot.
                (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $value_pointer2))
                (call $pending_push (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Check if it's a TYPE_BOUND_METHOD
            (if (i32.eq (local.get $type1) (global.get $TYPE_BOUND_METHOD))
              (then
                ;; Extract bound method info
                ;; flags = receiver type (TYPE_ARRAY or TYPE_STRING)
                ;; data_lo = receiver pointer
                ;; data_hi = method ID
                (local.set $receiver_type (call $value_flags (local.get $value_pointer)))
                (local.set $receiver_pointer (call $value_data_lo (local.get $value_pointer)))
                ;; Prototype entries stored without a receiver use the explicit
                ;; CALL_METHOD receiver slot. Computed methods that already carry
                ;; receiver metadata must keep it: their adjacent stack slot can
                ;; be undefined after computed-key evaluation.
                (if (i32.eqz
                      (i32.or
                        (local.get $receiver_type)
                        (local.get $receiver_pointer)))
                  (then
                    (local.set $receiver_type (call $value_type (local.get $value_pointer2)))
                    (local.set $receiver_pointer (call $value_data_lo (local.get $value_pointer2)))))
                (local.set $method_id (call $value_data_hi (local.get $value_pointer)))

                ;; Array.from with an iterable source: normalize the source
                ;; slot before anything else — Set/Map/typed sources convert
                ;; natively in place, user iterables drain through an
                ;; ARRAY_FROM_SEED continuation that re-runs this
                ;; CALL_METHOD with the array substituted (so the mapFn
                ;; rewrite below then applies uniformly), and
                ;; null/undefined throw "Not iterable". Gated to plain
                ;; CALL_METHOD: a CALL_METHOD_SPREAD re-run would meet the
                ;; already-unpacked stack.
                (if (i32.and
                      (i32.eq (local.get $opcode) (global.get $OP_CALL_METHOD))
                      (i32.or
                        (i32.eq (local.get $method_id) (global.get $METHOD_ARRAY_FROM))
                        (i32.eq (local.get $method_id) (global.get $METHOD_OBJECT_FROM_ENTRIES))))
                  (then
                    (local.set $result_i32 (call $array_from_intercept
                      (local.get $value_pointer) (local.get $operand1) (local.get $method_id) (local.get $pc)))
                    (if (i32.eq (local.get $result_i32) (i32.const -4)) (then (br $exit)))
                    (if (i32.eq (local.get $result_i32) (i32.const -5))
                      (then
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop)))
                    (if (i32.eq (local.get $result_i32) (i32.const -2))
                      (then
                        (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                        (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                        (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                        (br $exit)))
                    ;; -6: generator seed parked (EXIT_GENERATOR_NEXT prepared).
                    (if (i32.eq (local.get $result_i32) (i32.const -6))
                      (then
                        (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                        (br $exit)))
                    (if (i32.ge_s (local.get $result_i32) (i32.const 0))
                      (then
                        (local.set $pc (local.get $result_i32))
                        (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                        (br $loop)))
                    ;; -3: proceed (source slot may now hold the converted array).
                  )
                )

                ;; JSON.stringify with a FUNCTION replacer: run the
                ;; JSON_TRANSFORM driver up front (the native serializer
                ;; ignores non-function replacers — a function replacer
                ;; used to be silently dropped). The getters-only case is
                ;; handled after dispatch via result code 3. Gated to
                ;; plain CALL_METHOD (a spread re-run would meet the
                ;; unpacked stack).
                (if (i32.and
                      (i32.eq (local.get $opcode) (global.get $OP_CALL_METHOD))
                      (i32.and
                        (i32.eq (local.get $method_id) (global.get $METHOD_JSON_STRINGIFY))
                        (i32.ge_u (local.get $operand1) (i32.const 2))))
                  (then
                    (local.set $value_pointer3 (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE)))
                    (local.set $value_pointer4 (i32.add (local.get $value_pointer3) (global.get $VALUE_SIZE)))
                    (if (i32.eq (call $value_type (local.get $value_pointer4)) (global.get $TYPE_FUNCTION))
                      (then
                        (local.set $result_i32 (call $json_transform_begin
                          (local.get $value_pointer3)
                          (call $value_data_lo (local.get $value_pointer4))
                          (i32.sub (call $read_ctx (global.get $CTX_PENDING_POINTER)) (local.get $value_pointer3))
                          (local.get $pc)))
                        (if (i32.eq (local.get $result_i32) (i32.const -2))
                          (then
                            (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                            (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                            (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                            (br $exit)))
                        (if (i32.eq (local.get $result_i32) (i32.const -1))
                          (then
                            (if (call $throw_from_set_error) (then (br $exit)))
                            (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                            (br $loop)))
                        (local.set $pc (local.get $result_i32))
                        (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                        (br $loop)
                      )
                    )
                  )
                )

                ;; JSON.parse with a FUNCTION reviver: parse natively first
                ;; (pure data, no user code), then drive the
                ;; JSON_INTERNALIZE walk — see the detached-CALL twin.
                ;; Gated to plain CALL_METHOD (a spread re-run would meet
                ;; the unpacked stack).
                (if (i32.and
                      (i32.eq (local.get $opcode) (global.get $OP_CALL_METHOD))
                      (i32.and
                        (i32.eq (local.get $method_id) (global.get $METHOD_JSON_PARSE))
                        (i32.ge_u (local.get $operand1) (i32.const 2))))
                  (then
                    (local.set $value_pointer3 (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE)))
                    (local.set $value_pointer4 (i32.add (local.get $value_pointer3) (global.get $VALUE_SIZE)))
                    (if (i32.and
                          (i32.eq (call $value_type (local.get $value_pointer4)) (global.get $TYPE_FUNCTION))
                          (i32.eq (call $value_type (local.get $value_pointer3)) (global.get $TYPE_STRING)))
                      (then
                        ;; Working-buffer budget mirrors $json_parse_method.
                        (if (call $check_heap_overflow
                              (i32.add
                                (i32.mul (call $estimate_arraybuffer_size (i32.const 4096)) (i32.const 3))
                                (i32.mul (call $estimate_typed_array_descriptor_size) (i32.const 3))))
                          (then
                            (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                            (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                            (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                            (br $exit)))
                        (if (i32.eqz (call $json_parse (call $value_data_lo (local.get $value_pointer3))))
                          (then
                            (if (global.get $memory_pressure_signaled)
                              (then
                                (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                                (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                                (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                                (br $exit)))
                            (if (call $throw_from_set_error) (then (br $exit)))
                            (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                            (br $loop)))
                        (local.set $result_i32 (call $json_internalize_begin
                          (local.get $value_pointer2)
                          (call $value_data_lo (local.get $value_pointer4))
                          (local.get $pc)))
                        (if (i32.eq (local.get $result_i32) (i32.const -2))
                          (then
                            (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                            (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                            (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                            (br $exit)))
                        (if (i32.eq (local.get $result_i32) (i32.const -1))
                          (then
                            (if (call $throw_from_set_error) (then (br $exit)))
                            (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                            (br $loop)))
                        (local.set $pc (local.get $result_i32))
                        (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                        (br $loop)
                      )
                    )
                  )
                )

                ;; Array.from(source, mapFn): with a callable mapFn and an
                ;; Array source this is exactly source.map(mapFn). Rewrite
                ;; IN PLACE into that call — the bound-method slot becomes
                ;; map-bound-to-the-source and the callback moves into the
                ;; first-arg slot — then fall through to the callback
                ;; machinery below. Because the rewritten stack IS a plain
                ;; map call, a memory-pressure retry of this instruction
                ;; re-runs cleanly without re-entering this branch. (The
                ;; mapFn used to be silently ignored.) A mapFn alongside a
                ;; non-Array source throws rather than dropping it; an
                ;; undefined mapFn falls through to the plain form. Spec
                ;; nit: a 3-parameter mapFn also receives the array (map's
                ;; calling convention); spec passes only (element, index).
                (if (i32.and
                      (i32.eq (local.get $method_id) (global.get $METHOD_ARRAY_FROM))
                      (i32.ge_u (local.get $operand1) (i32.const 2)))
                  (then
                    (local.set $value_pointer3 (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE)))
                    (local.set $value_pointer4 (i32.add (local.get $value_pointer3) (global.get $VALUE_SIZE)))
                    (if (i32.ne (call $value_type (local.get $value_pointer4)) (global.get $TYPE_UNDEFINED))
                      (then
                        (if (i32.and
                              (i32.eq (call $value_type (local.get $value_pointer4)) (global.get $TYPE_FUNCTION))
                              (i32.eq (call $value_type (local.get $value_pointer3)) (global.get $TYPE_ARRAY)))
                          (then
                            (local.set $receiver_type (global.get $TYPE_ARRAY))
                            (local.set $receiver_pointer (call $value_data_lo (local.get $value_pointer3)))
                            (local.set $method_id (global.get $METHOD_MAP))
                            ;; Bound-method slot := map bound to the source array
                            ;; (also keeps the source rooted for GC at a
                            ;; pressure yield).
                            (i32.store (call $abs (i32.add (local.get $value_pointer) (i32.const 4)))
                              (global.get $TYPE_ARRAY))
                            (i32.store (call $abs (i32.add (local.get $value_pointer) (i32.const 8)))
                              (local.get $receiver_pointer))
                            (i32.store (call $abs (i32.add (local.get $value_pointer) (i32.const 12)))
                              (global.get $METHOD_MAP))
                            ;; First-arg slot := the callback
                            (i32.store (call $abs (local.get $value_pointer3))
                              (i32.load (call $abs (local.get $value_pointer4))))
                            (i32.store (call $abs (i32.add (local.get $value_pointer3) (i32.const 4)))
                              (i32.load (call $abs (i32.add (local.get $value_pointer4) (i32.const 4)))))
                            (i32.store (call $abs (i32.add (local.get $value_pointer3) (i32.const 8)))
                              (i32.load (call $abs (i32.add (local.get $value_pointer4) (i32.const 8)))))
                            (i32.store (call $abs (i32.add (local.get $value_pointer3) (i32.const 12)))
                              (i32.load (call $abs (i32.add (local.get $value_pointer4) (i32.const 12)))))
                          )
                          (else
                            (if (call $throw_type_error_with_type (global.get $BUILTIN_MSG_NOT_A_FUNCTION)
                                  (call $value_type (local.get $value_pointer4)))
                              (then (br $exit))
                              (else
                                (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                                (br $loop)
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )

                ;; Object.values / Object.entries / Object.assign /
                ;; JSON.stringify with an accessor-bearing object argument:
                ;; resolve it into a data-only copy first (invoking its
                ;; getters through an ACCESSOR_RESOLVE frame whose
                ;; completion re-runs this instruction with the copy
                ;; substituted in the operand slot); the native paths then
                ;; handle pure data. assign scans its sources left to
                ;; right — one resolution per re-run, preserving the
                ;; spec's getter invocation order. Nested accessors under
                ;; JSON.stringify keep the serializer's loud TypeError, as
                ;; does assign onto an accessor-bearing TARGET (its
                ;; setters would need invoking).
                ;; (JSON.stringify left this list 2026-07-05: its accessor
                ;; handling — including nested ones — now runs through the
                ;; JSON_TRANSFORM driver via dispatch code 3.)
                (if (i32.or
                      (i32.or
                        (i32.eq (local.get $method_id) (global.get $METHOD_OBJECT_VALUES))
                        (i32.eq (local.get $method_id) (global.get $METHOD_OBJECT_ENTRIES)))
                      (i32.eq (local.get $method_id) (global.get $METHOD_OBJECT_ASSIGN)))
                  (then
                    ;; Sources start at arg1, or arg2 for assign (arg1 is
                    ;; the target).
                    (local.set $i (i32.const 0))
                    (if (i32.eq (local.get $method_id) (global.get $METHOD_OBJECT_ASSIGN))
                      (then (local.set $i (i32.const 1))))
                    (block $accessor_arg_scan_done
                      (loop $accessor_arg_scan
                        (br_if $accessor_arg_scan_done (i32.ge_u (local.get $i) (local.get $operand1)))
                        (local.set $value_pointer3 (i32.add (local.get $value_pointer)
                          (i32.mul (i32.add (local.get $i) (i32.const 1)) (global.get $VALUE_SIZE))))
                        (if (call $value_is_accessor_bearing_object (local.get $value_pointer3))
                          (then
                            (local.set $result_i32 (call $accessor_resolve_begin
                              (call $value_data_lo (local.get $value_pointer3))
                              (i32.sub (call $read_ctx (global.get $CTX_PENDING_POINTER)) (local.get $value_pointer3))
                              (local.get $pc)))
                            (if (i32.eq (local.get $result_i32) (i32.const -2))
                              (then
                                (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                                (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                                (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                                (br $exit)))
                            (local.set $pc (local.get $result_i32))
                            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                            (br $loop)
                          )
                        )
                        (local.set $i (i32.add (local.get $i) (i32.const 1)))
                        (br $accessor_arg_scan)
                      )
                    )

                    ;; assign onto an accessor-bearing TARGET (every source
                    ;; is data-only once the scan above found nothing to
                    ;; resolve): drive the target's setters through the
                    ;; ASSIGN_SETTERS continuation and complete the call
                    ;; directly — no re-run (setters must fire exactly
                    ;; once). Frozen targets fall through to dispatch (the
                    ;; native frozen TypeError); the spread form falls
                    ;; through too.
                    (if (i32.and
                          (i32.eq (local.get $opcode) (global.get $OP_CALL_METHOD))
                          (i32.and
                            (i32.eq (local.get $method_id) (global.get $METHOD_OBJECT_ASSIGN))
                            (i32.ge_u (local.get $operand1) (i32.const 1))))
                      (then
                        (local.set $value_pointer3 (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE)))
                        (if (i32.and
                              (call $value_is_accessor_bearing_object (local.get $value_pointer3))
                              (i32.eqz (i32.and
                                (i32.load (call $abs (i32.add
                                  (call $value_data_lo (local.get $value_pointer3))
                                  (i32.const 0x14))))
                                (global.get $OBJECT_FLAG_FROZEN))))
                          (then
                            (local.set $result_i32 (call $assign_setters_begin
                              (call $value_data_lo (local.get $value_pointer3))
                              (i32.sub (call $read_ctx (global.get $CTX_PENDING_POINTER)) (local.get $value_pointer2))
                              (i32.sub (call $read_ctx (global.get $CTX_PENDING_POINTER)) (local.get $value_pointer3))
                              (local.get $operand1)
                              (local.get $pc)))
                            (if (i32.eq (local.get $result_i32) (i32.const -2))
                              (then
                                (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                                (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                                (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                                (br $exit)))
                            (if (i32.eq (local.get $result_i32) (i32.const -1))
                              (then
                                (if (call $throw_from_set_error) (then (br $exit)))
                                (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                                (br $loop)))
                            (local.set $pc (local.get $result_i32))
                            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                            (br $loop)
                          )
                        )
                      )
                    )
                  )
                )

                ;; ES2025 set-theoretic methods with a Set-LIKE argument
                ;; (foreign-callable re-entry). Plain Set arguments keep the
                ;; native fast path in dispatch_builtin_method; a Set-like
                ;; (an object exposing callable has()/keys()) is driven by
                ;; a FRAME_FLAG_NATIVE_CONTINUATION continuation:
                ;;   intersection / difference / isSubsetOf / isDisjointFrom
                ;;   probe other.has(v) per element of this (HAS_DRIVEN);
                ;;   union / symmetricDifference / isSupersetOf drain
                ;;   other.keys()'s iterator (KEYS_DRIVEN).
                ;; Spec nit: the Set-like's numeric `size` is not read (it
                ;; only feeds the spec's strategy choices, not results).
                (if (i32.and
                      (i32.and
                        (i32.eq (local.get $receiver_type) (global.get $TYPE_SET))
                        (i32.and
                          (i32.ge_u (local.get $method_id) (global.get $METHOD_SET_UNION))
                          (i32.le_u (local.get $method_id) (global.get $METHOD_SET_IS_DISJOINT_FROM))))
                      (i32.ge_u (local.get $operand1) (i32.const 1)))
                  (then
                    (local.set $value_pointer3 (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE)))
                    (if (i32.ne (call $value_type (local.get $value_pointer3)) (global.get $TYPE_SET))
                      (then
                        (if (i32.ne (call $value_type (local.get $value_pointer3)) (global.get $TYPE_OBJECT))
                          (then
                            (if (call $throw_type_error_with_type (global.get $BUILTIN_MSG_NOT_AN_OBJECT)
                                  (call $value_type (local.get $value_pointer3)))
                              (then (br $exit))
                              (else
                                (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                                (br $loop)
                              )
                            )
                          )
                        )
                        (local.set $object_pointer (call $value_data_lo (local.get $value_pointer3)))
                        (if (i32.or
                              (i32.or
                                (i32.eq (local.get $method_id) (global.get $METHOD_SET_UNION))
                                (i32.eq (local.get $method_id) (global.get $METHOD_SET_SYMMETRIC_DIFFERENCE)))
                              (i32.eq (local.get $method_id) (global.get $METHOD_SET_IS_SUPERSET_OF)))
                          (then
                            ;; ---- KEYS_DRIVEN ----
                            (local.set $entry_pointer (call $object_find_string_entry
                              (local.get $object_pointer) (call $read_builtin (global.get $BUILTIN_SETLIKE_KEYS))))
                            (if (i32.eqz (call $entry_value_is_function (local.get $entry_pointer)))
                              (then
                                (if (call $throw_type_error_with_type (global.get $BUILTIN_MSG_NOT_A_FUNCTION)
                                      (call $value_type (local.get $value_pointer3)))
                                  (then (br $exit))
                                  (else
                                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                                    (br $loop)
                                  )
                                )
                              )
                            )
                            (local.set $closure_pointer
                              (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 12)))))
                            ;; Pre-check: state array (3) + accumulator clone
                            ;; of this (union/symmetricDifference; boolean for
                            ;; isSupersetOf costs nothing).
                            (if (call $check_heap_overflow
                                  (i32.add
                                    (call $estimate_array_size (i32.const 3))
                                    (call $estimate_collection_build_size
                                      (global.get $SET_SLOT_STRIDE)
                                      (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 8)))))))
                              (then
                                (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $pending_pointer))
                                (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                                (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                                (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                                (br $exit)))
                            ;; Accumulator: a clone of this for union /
                            ;; symmetricDifference; TRUE for isSupersetOf.
                            (if (i32.eq (local.get $method_id) (global.get $METHOD_SET_IS_SUPERSET_OF))
                              (then
                                (local.set $set_val_type (global.get $TYPE_BOOLEAN))
                                (local.set $set_val_lo (i32.const 1))
                              )
                              (else
                                (local.set $heap_pointer (call $allocate_collection
                                  (global.get $OBJ_SET) (global.get $OBJ_SET_ENTRIES)
                                  (global.get $SET_SLOT_STRIDE) (i32.const 4)))
                                ;; Copy this's live slots.
                                (local.set $data_pointer
                                  (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 20)))))
                                (local.set $arr_len
                                  (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 12)))))
                                (local.set $i (i32.const 0))
                                (block $setop_clone_done
                                  (loop $setop_clone_loop
                                    (br_if $setop_clone_done (i32.ge_u (local.get $i) (local.get $arr_len)))
                                    (local.set $element_pointer (i32.add
                                      (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
                                      (i32.mul (local.get $i) (global.get $SET_SLOT_STRIDE))))
                                    ;; First slot word: 0 = live, nonzero = tombstone.
                                    (if (i32.eqz (i32.load (call $abs (local.get $element_pointer))))
                                      (then (call $set_add (local.get $heap_pointer)
                                        (i32.add (local.get $element_pointer) (global.get $SET_SLOT_VALUE_OFFSET)))))
                                    (local.set $i (i32.add (local.get $i) (i32.const 1)))
                                    (br $setop_clone_loop)
                                  )
                                )
                                (local.set $set_val_type (global.get $TYPE_SET))
                                (local.set $set_val_lo (local.get $heap_pointer))
                              )
                            )
                            ;; State array [other, accumulator, iterator(undefined)]
                            (local.set $result_i32 (call $allocate_array (i32.const 3)))
                            (i32.store (call $abs (i32.add (local.get $result_i32) (i32.const 8))) (i32.const 3))
                            (local.set $new_data_pointer (i32.load (call $abs (i32.add (local.get $result_i32) (i32.const 16)))))
                            (local.set $element_pointer (i32.add (local.get $new_data_pointer) (global.get $GC_HEADER_SIZE)))
                            (i32.store (call $abs (local.get $element_pointer)) (global.get $TYPE_OBJECT))
                            (i32.store (call $abs (i32.add (local.get $element_pointer) (i32.const 4))) (i32.const 0))
                            (i32.store (call $abs (i32.add (local.get $element_pointer) (i32.const 8))) (local.get $object_pointer))
                            (i32.store (call $abs (i32.add (local.get $element_pointer) (i32.const 12))) (i32.const 0))
                            (local.set $element_pointer (i32.add (local.get $element_pointer) (global.get $VALUE_SIZE)))
                            (i32.store (call $abs (local.get $element_pointer)) (local.get $set_val_type))
                            (i32.store (call $abs (i32.add (local.get $element_pointer) (i32.const 4))) (i32.const 0))
                            (i32.store (call $abs (i32.add (local.get $element_pointer) (i32.const 8))) (local.get $set_val_lo))
                            (i32.store (call $abs (i32.add (local.get $element_pointer) (i32.const 12))) (i32.const 0))
                            (local.set $element_pointer (i32.add (local.get $element_pointer) (global.get $VALUE_SIZE)))
                            (i32.store (call $abs (local.get $element_pointer)) (global.get $TYPE_UNDEFINED))
                            (i32.store (call $abs (i32.add (local.get $element_pointer) (i32.const 4))) (i32.const 0))
                            (i32.store (call $abs (i32.add (local.get $element_pointer) (i32.const 8))) (i32.const 0))
                            (i32.store (call $abs (i32.add (local.get $element_pointer) (i32.const 12))) (i32.const 0))
                            ;; Frame + first call: other.keys(), this = other.
                            (local.set $stack_pointer (call $read_ctx (global.get $CTX_CALL_STACK_POINTER)))
                            (local.set $frame_pointer (call $abs (local.get $stack_pointer)))
                            (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_INSTRUCTION_INDEX))
                              (i32.add (local.get $pc) (i32.const 1)))
                            (call $publish_native_continuation_frame
                              (local.get $frame_pointer) (local.get $stack_pointer)
                              (local.get $value_pointer2)
                              (i32.const 1) (i32.const 0) (i32.const 0)
                              (local.get $method_id) (local.get $result_i32)
                              (global.get $CONTINUATION_KIND_SETOP_KEYS_DRIVEN)
                              (local.get $receiver_pointer) (local.get $closure_pointer)
                              (global.get $TYPE_SET) (i32.const 0))
                            (local.set $new_scope (call $scope_create
                              (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 40))))))
                            (global.set $current_scope (local.get $new_scope))
                            (if (i32.eqz (i32.and
                                  (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 44))))
                                  (global.get $CLOSURE_FLAG_ARROW)))
                              (then
                                (call $scope_define (local.get $new_scope)
                                  (call $read_builtin (i32.const 0x18))
                                  (global.get $TYPE_OBJECT) (i32.const 0)
                                  (local.get $object_pointer) (i32.const 0))
                                (call $scope_define_new_target (local.get $new_scope)
                                  (global.get $TYPE_UNDEFINED) (i32.const 0))))
                            (local.set $pc (i32.load (call $abs (i32.add (local.get $closure_pointer) (global.get $FUNCTION_CLOSURE_OFFSET)))))
                            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                            (br $loop)
                          )
                          (else
                            ;; ---- HAS_DRIVEN ----
                            (local.set $entry_pointer (call $object_find_string_entry
                              (local.get $object_pointer) (call $read_builtin (global.get $BUILTIN_SETLIKE_HAS))))
                            (if (i32.eqz (call $entry_value_is_function (local.get $entry_pointer)))
                              (then
                                (if (call $throw_type_error_with_type (global.get $BUILTIN_MSG_NOT_A_FUNCTION)
                                      (call $value_type (local.get $value_pointer3)))
                                  (then (br $exit))
                                  (else
                                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                                    (br $loop)
                                  )
                                )
                              )
                            )
                            (local.set $closure_pointer
                              (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 12)))))
                            ;; Pre-check: state array (2) + empty accumulator
                            ;; Set (intersection/difference; booleans free).
                            (if (call $check_heap_overflow
                                  (i32.add
                                    (call $estimate_array_size (i32.const 2))
                                    (call $estimate_collection_size (global.get $SET_SLOT_STRIDE) (i32.const 4))))
                              (then
                                (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $pending_pointer))
                                (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                                (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                                (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                                (br $exit)))
                            ;; Find the receiver's first live slot; an empty
                            ;; receiver completes without any foreign call.
                            (local.set $data_pointer
                              (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 20)))))
                            (local.set $arr_len
                              (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 12)))))
                            (local.set $index (i32.const 0))
                            (block $setop_first_done
                              (loop $setop_first_scan
                                (br_if $setop_first_done (i32.ge_u (local.get $index) (local.get $arr_len)))
                                (local.set $element_pointer (i32.add
                                  (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
                                  (i32.mul (local.get $index) (global.get $SET_SLOT_STRIDE))))
                                ;; 0 = live slot (nonzero = tombstone)
                                (br_if $setop_first_done
                                  (i32.eqz (i32.load (call $abs (local.get $element_pointer)))))
                                (local.set $index (i32.add (local.get $index) (i32.const 1)))
                                (br $setop_first_scan)
                              )
                            )
                            (if (i32.ge_u (local.get $index) (local.get $arr_len))
                              (then
                                ;; Empty receiver: intersection/difference →
                                ;; empty Set; isSubsetOf/isDisjointFrom → true.
                                (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $value_pointer2))
                                (if (i32.or
                                      (i32.eq (local.get $method_id) (global.get $METHOD_SET_INTERSECTION))
                                      (i32.eq (local.get $method_id) (global.get $METHOD_SET_DIFFERENCE)))
                                  (then
                                    (call $pending_push (global.get $TYPE_SET) (i32.const 0)
                                      (call $allocate_collection
                                        (global.get $OBJ_SET) (global.get $OBJ_SET_ENTRIES)
                                        (global.get $SET_SLOT_STRIDE) (i32.const 4))
                                      (i32.const 0)))
                                  (else
                                    (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (i32.const 1) (i32.const 0))))
                                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                                (br $loop)
                              )
                            )
                            ;; Accumulator: empty Set (intersection/difference)
                            ;; or TRUE (predicates).
                            (if (i32.or
                                  (i32.eq (local.get $method_id) (global.get $METHOD_SET_INTERSECTION))
                                  (i32.eq (local.get $method_id) (global.get $METHOD_SET_DIFFERENCE)))
                              (then
                                (local.set $set_val_type (global.get $TYPE_SET))
                                (local.set $set_val_lo (call $allocate_collection
                                  (global.get $OBJ_SET) (global.get $OBJ_SET_ENTRIES)
                                  (global.get $SET_SLOT_STRIDE) (i32.const 4)))
                              )
                              (else
                                (local.set $set_val_type (global.get $TYPE_BOOLEAN))
                                (local.set $set_val_lo (i32.const 1))
                              )
                            )
                            ;; State array [other, accumulator]
                            (local.set $result_i32 (call $allocate_array (i32.const 2)))
                            (i32.store (call $abs (i32.add (local.get $result_i32) (i32.const 8))) (i32.const 2))
                            (local.set $new_data_pointer (i32.load (call $abs (i32.add (local.get $result_i32) (i32.const 16)))))
                            (local.set $element_pointer (i32.add (local.get $new_data_pointer) (global.get $GC_HEADER_SIZE)))
                            (i32.store (call $abs (local.get $element_pointer)) (global.get $TYPE_OBJECT))
                            (i32.store (call $abs (i32.add (local.get $element_pointer) (i32.const 4))) (i32.const 0))
                            (i32.store (call $abs (i32.add (local.get $element_pointer) (i32.const 8))) (local.get $object_pointer))
                            (i32.store (call $abs (i32.add (local.get $element_pointer) (i32.const 12))) (i32.const 0))
                            (local.set $element_pointer (i32.add (local.get $element_pointer) (global.get $VALUE_SIZE)))
                            (i32.store (call $abs (local.get $element_pointer)) (local.get $set_val_type))
                            (i32.store (call $abs (i32.add (local.get $element_pointer) (i32.const 4))) (i32.const 0))
                            (i32.store (call $abs (i32.add (local.get $element_pointer) (i32.const 8))) (local.get $set_val_lo))
                            (i32.store (call $abs (i32.add (local.get $element_pointer) (i32.const 12))) (i32.const 0))
                            ;; Frame + first call: other.has(firstElement).
                            (local.set $stack_pointer (call $read_ctx (global.get $CTX_CALL_STACK_POINTER)))
                            (local.set $frame_pointer (call $abs (local.get $stack_pointer)))
                            (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_INSTRUCTION_INDEX))
                              (i32.add (local.get $pc) (i32.const 1)))
                            (call $publish_native_continuation_frame
                              (local.get $frame_pointer) (local.get $stack_pointer)
                              (local.get $value_pointer2)
                              (i32.const 1) (i32.const 1) (local.get $index)
                              (local.get $method_id) (local.get $result_i32)
                              (global.get $CONTINUATION_KIND_SETOP_HAS_DRIVEN)
                              (local.get $receiver_pointer) (local.get $closure_pointer)
                              (global.get $TYPE_SET) (i32.const 0))
                            ;; Re-derive the first live slot's pointer (the
                            ;; state-array writes above reused $element_pointer).
                            (local.set $element_pointer (i32.add
                              (i32.add
                                (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
                                (i32.mul (local.get $index) (global.get $SET_SLOT_STRIDE)))
                              (global.get $SET_SLOT_VALUE_OFFSET)))
                            (call $pending_push
                              (i32.load (call $abs (local.get $element_pointer)))
                              (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 4))))
                              (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 8))))
                              (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 12)))))
                            (local.set $new_scope (call $scope_create
                              (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 40))))))
                            (global.set $current_scope (local.get $new_scope))
                            (if (i32.eqz (i32.and
                                  (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 44))))
                                  (global.get $CLOSURE_FLAG_ARROW)))
                              (then
                                (call $scope_define (local.get $new_scope)
                                  (call $read_builtin (i32.const 0x18))
                                  (global.get $TYPE_OBJECT) (i32.const 0)
                                  (local.get $object_pointer) (i32.const 0))
                                (call $scope_define_new_target (local.get $new_scope)
                                  (global.get $TYPE_UNDEFINED) (i32.const 0))))
                            (local.set $pc (i32.load (call $abs (i32.add (local.get $closure_pointer) (global.get $FUNCTION_CLOSURE_OFFSET)))))
                            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
