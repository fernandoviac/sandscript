            ;; =========================================================================
            ;; new Map() / new Map(iterable)  (slice 5)
            ;; =========================================================================
            ;; Seeding accepts a plain Array (or array-like TYPE_ARRAY) of
            ;; [key, value] pairs — the common case (`new Map([[k,v],...])`)
