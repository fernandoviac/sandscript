                  ;; allocation-saving truncation, which a fixed callee
                  ;; cannot observe (RECONCILE_PARAMS pads the missing
                  ;; tail with undefined either way).
                  (local.set $phase (i32.const 8))
                  (local.set $state0 (i32.or
                    (i32.or (i32.const 8) (local.get $matched))
                    (i32.shl (local.get $method_id) (i32.const 16))))
                  (call $native_continuation_state_set
                    (local.get $state_handle) (i32.const 0) (local.get $state0))
                  (local.set $stack_pointer (call $read_ctx (global.get $CTX_CALL_STACK_POINTER)))
                  (local.set $frame_pointer (call $abs (local.get $stack_pointer)))
                  (call $publish_native_continuation_frame
                    (local.get $frame_pointer) (local.get $stack_pointer)
                    (i32.sub (local.get $args_base) (global.get $VALUE_SIZE))
                    (i32.const 1) (local.get $param_count)
                    (i32.const 0) (local.get $state_handle) (i32.const 0)
                    (global.get $CONTINUATION_KIND_REGEXP_REPLACE)
                    (i32.const 0) (local.get $closure_pointer)
                    (i32.const 0) (i32.const 0))
                  (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
                  ;; Arguments (as many as declared): match, captures...,
                  ;; offset (scalar units), input, groups (named only).
                  (local.set $arg_index (i32.const 0))
                  (block $args_done
                    (loop $push_args
                      (br_if $args_done (i32.ge_u (local.get $arg_index) (local.get $param_count)))
                      (if (i32.eq (local.get $arg_index) (i32.const 0))
                        (then
                          (call $pending_push
                            (global.get $TYPE_STRING) (i32.const 0)
                            (call $intern_string
                              (i32.add (local.get $subject_abs) (local.get $ms))
                              (i32.sub (local.get $me) (local.get $ms)))
                            (i32.const 0)))
                        (else
                          (if (i32.le_u (local.get $arg_index) (local.get $ncaps))
                            (then
                              (local.set $cap_start (i32.load (i32.add
                                (i32.add (local.get $cont_payload) (global.get $REGEX_CONT_HEADER_SIZE))
                                (i32.shl (local.get $arg_index) (i32.const 3)))))
                              (local.set $cap_end (i32.load (i32.add
                                (i32.add
                                  (i32.add (local.get $cont_payload) (global.get $REGEX_CONT_HEADER_SIZE))
                                  (i32.shl (local.get $arg_index) (i32.const 3)))
                                (i32.const 4))))
                              (if (i32.and
                                    (i32.ne (local.get $cap_start) (global.get $REGEX_CONT_NO_POSITION))
                                    (i32.ne (local.get $cap_end) (global.get $REGEX_CONT_NO_POSITION)))
                                (then
                                  (call $pending_push
                                    (global.get $TYPE_STRING) (i32.const 0)
                                    (call $intern_string
                                      (i32.add (local.get $subject_abs) (local.get $cap_start))
                                      (i32.sub (local.get $cap_end) (local.get $cap_start)))
                                    (i32.const 0)))
                                (else
                                  (call $pending_push
                                    (global.get $TYPE_UNDEFINED) (i32.const 0)
                                    (i32.const 0) (i32.const 0)))))
                            (else
                              (if (i32.eq (local.get $arg_index)
                                    (i32.add (local.get $ncaps) (i32.const 1)))
                                (then
                                  (local.set $bits (i64.reinterpret_f64
                                    (f64.convert_i32_u (local.get $offset_scalar))))
                                  (call $pending_push
                                    (global.get $TYPE_FLOAT) (i32.const 0)
                                    (i32.wrap_i64 (local.get $bits))
                                    (i32.wrap_i64 (i64.shr_u (local.get $bits) (i64.const 32)))))
                                (else
                                  (if (i32.eq (local.get $arg_index)
                                        (i32.add (local.get $ncaps) (i32.const 2)))
                                    (then
                                      (call $pending_push
                                        (global.get $TYPE_STRING) (i32.const 0)
                                        (local.get $subject_id) (i32.const 0)))
                                    (else
                                      (if (i32.and
                                            (i32.eq (local.get $arg_index)
                                              (i32.add (local.get $ncaps) (i32.const 3)))
                                            (i32.ne (local.get $groups_object) (i32.const 0)))
                                        (then
                                          (call $pending_push
                                            (global.get $TYPE_OBJECT) (i32.const 0)
                                            (local.get $groups_object) (i32.const 0)))
                                        (else
                                          (call $pending_push
                                            (global.get $TYPE_UNDEFINED) (i32.const 0)
                                            (i32.const 0) (i32.const 0))))))))))))
                      (local.set $arg_index (i32.add (local.get $arg_index) (i32.const 1)))
                      (br $push_args)))
                  (return (i32.const 5) (local.get $fuel)))
                (else
                  ;; String replacement: measure, grow once, write once.
                  (local.set $total (i32.add
                    (i32.sub (local.get $ms) (local.get $p))
                    (call $regexp_expand_replacement
                      (local.get $repl_id) (local.get $subject_id)
                      (local.get $continuation) (local.get $program)
                      (i32.const 0))))
                  (local.set $output (call $regexp_out_ensure
                    (local.get $state_handle) (local.get $output) (local.get $total)))
                  (if (i32.eqz (local.get $output))
                    (then (return (i32.const 2) (local.get $fuel))))
                  (local.set $out_content
                    (i32.add (call $abs (local.get $output)) (i32.const 4)))
                  (memory.copy
                    (i32.add (i32.add (local.get $out_content) (i32.const 12)) (local.get $used))
                    (i32.add (local.get $subject_abs) (local.get $p))
                    (i32.sub (local.get $ms) (local.get $p)))
                  (drop (call $regexp_expand_replacement
                    (local.get $repl_id) (local.get $subject_id)
                    (local.get $continuation) (local.get $program)
                    (i32.add
                      (i32.add (i32.add (local.get $out_content) (i32.const 12)) (local.get $used))
                      (i32.sub (local.get $ms) (local.get $p)))))
                  (i32.store (local.get $out_content)
                    (i32.add (local.get $used) (local.get $total)))
                  (i32.store (i32.add (local.get $out_content) (i32.const 4)) (local.get $me))
                  ;; Advance (shared with phase 8 below via $drive).
                  (if (i32.eqz (local.get $g))
                    (then
                      (local.set $phase (i32.const 9))
                      (local.set $state0 (i32.or
                        (i32.or (i32.const 9) (local.get $matched))
                        (i32.shl (local.get $method_id) (i32.const 16))))
                      (call $native_continuation_state_set
                        (local.get $state_handle) (i32.const 0) (local.get $state0))
                      (br $tail)))
                  (local.set $origin (local.get $me))
                  (local.set $origin_scalar (i32.load (i32.add
                    (local.get $cont_payload) (global.get $REGEX_CONT_MATCH_END_SCALAR))))
                  (if (i32.eq (local.get $me) (local.get $ms))
                    (then
                      (if (i32.ge_u (local.get $me) (local.get $subject_len))
                        (then (local.set $origin (i32.add (local.get $subject_len) (i32.const 1))))
                        (else
                          (local.set $origin (i32.add (local.get $me)
                            (call $regexp_scalar_len_at
                              (local.get $subject_abs) (local.get $me))))
                          (local.set $origin_scalar
                            (i32.add (local.get $origin_scalar) (i32.const 1)))))))
                  (if (i32.gt_u (local.get $origin) (local.get $subject_len))
                    (then
                      (local.set $phase (i32.const 9))
                      (local.set $state0 (i32.or
                        (i32.or (i32.const 9) (local.get $matched))
                        (i32.shl (local.get $method_id) (i32.const 16))))
                      (call $native_continuation_state_set
                        (local.get $state_handle) (i32.const 0) (local.get $state0))
                      (br $tail)))
                  (local.set $status (call $regexp_init_attempt
                    (local.get $program) (local.get $continuation)
                    (local.get $subject_id) (local.get $origin) (local.get $origin_scalar)))
                  (if (i32.ne (local.get $status) (global.get $REGEX_STATUS_OK))
                    (then
                      (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
                      (call $fault_error (global.get $ERR_CORRUPT_OPERAND)
                        (local.get $status) (global.get $current_executing_pc))
                      (return (i32.const 3) (local.get $fuel))))
                  (local.set $phase (i32.const 6))
                  (local.set $state0 (i32.or
                    (i32.or (i32.const 6) (local.get $matched))
                    (i32.shl (local.get $method_id) (i32.const 16))))
                  (call $native_continuation_state_set
                    (local.get $state_handle) (i32.const 0) (local.get $state0))
                  (br $drive)))))

          ;; Phase 8: the callback returned; its result sits in the
          ;; op-root harvest slot (the return handler re-armed this
          ;; CALL). ToString + append, then advance exactly like the
          ;; string path.
          (local.set $root_data (i32.add
            (i32.load (call $abs (i32.add (local.get $op_root) (i32.const 16))))
            (global.get $GC_HEADER_SIZE)))
          (local.set $sid (call $value_to_string (i32.add
            (local.get $root_data) (i32.mul (i32.const 3) (global.get $VALUE_SIZE)))))
          (if (i32.eqz (local.get $sid))
            (then (return (i32.const 2) (local.get $fuel))))
          (local.set $total (i32.add
            (i32.sub (local.get $ms) (local.get $p))
            (i32.load (call $string_id_to_abs (local.get $sid)))))
          (local.set $output (call $regexp_out_ensure
            (local.get $state_handle) (local.get $output) (local.get $total)))
          (if (i32.eqz (local.get $output))
            (then (return (i32.const 2) (local.get $fuel))))
          (local.set $out_content
            (i32.add (call $abs (local.get $output)) (i32.const 4)))
          (memory.copy
            (i32.add (i32.add (local.get $out_content) (i32.const 12)) (local.get $used))
            (i32.add (local.get $subject_abs) (local.get $p))
            (i32.sub (local.get $ms) (local.get $p)))
          (memory.copy
            (i32.add
              (i32.add (i32.add (local.get $out_content) (i32.const 12)) (local.get $used))
              (i32.sub (local.get $ms) (local.get $p)))
            (i32.add (call $string_id_to_abs (local.get $sid)) (i32.const 4))
            (i32.load (call $string_id_to_abs (local.get $sid))))
          (i32.store (local.get $out_content)
            (i32.add (local.get $used) (local.get $total)))
          (i32.store (i32.add (local.get $out_content) (i32.const 4)) (local.get $me))
          (call $write_value
            (i32.add (local.get $root_data) (i32.mul (i32.const 3) (global.get $VALUE_SIZE)))
            (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))
          (if (i32.eqz (local.get $g))
            (then
              (local.set $phase (i32.const 9))
              (local.set $state0 (i32.or
                (i32.or (i32.const 9) (local.get $matched))
                (i32.shl (local.get $method_id) (i32.const 16))))
              (call $native_continuation_state_set
                (local.get $state_handle) (i32.const 0) (local.get $state0))
              (br $tail)))
          (local.set $origin (local.get $me))
          (local.set $origin_scalar (i32.load (i32.add
            (local.get $cont_payload) (global.get $REGEX_CONT_MATCH_END_SCALAR))))
          (if (i32.eq (local.get $me) (local.get $ms))
            (then
              (if (i32.ge_u (local.get $me) (local.get $subject_len))
                (then (local.set $origin (i32.add (local.get $subject_len) (i32.const 1))))
                (else
                  (local.set $origin (i32.add (local.get $me)
                    (call $regexp_scalar_len_at
                      (local.get $subject_abs) (local.get $me))))
                  (local.set $origin_scalar
                    (i32.add (local.get $origin_scalar) (i32.const 1)))))))
          (if (i32.gt_u (local.get $origin) (local.get $subject_len))
            (then
              (local.set $phase (i32.const 9))
              (local.set $state0 (i32.or
                (i32.or (i32.const 9) (local.get $matched))
                (i32.shl (local.get $method_id) (i32.const 16))))
              (call $native_continuation_state_set
                (local.get $state_handle) (i32.const 0) (local.get $state0))
              (br $tail)))
          (local.set $status (call $regexp_init_attempt
            (local.get $program) (local.get $continuation)
            (local.get $subject_id) (local.get $origin) (local.get $origin_scalar)))
          (if (i32.ne (local.get $status) (global.get $REGEX_STATUS_OK))
            (then
              (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
              (call $fault_error (global.get $ERR_CORRUPT_OPERAND)
                (local.get $status) (global.get $current_executing_pc))
              (return (i32.const 3) (local.get $fuel))))
          (local.set $phase (i32.const 6))
          (local.set $state0 (i32.or
            (i32.or (i32.const 6) (local.get $matched))
            (i32.shl (local.get $method_id) (i32.const 16))))
          (call $native_continuation_state_set
            (local.get $state_handle) (i32.const 0) (local.get $state0))
          (br $drive)))

      ;; Phase 9: append the tail once, then move to commit.
      (local.set $out_content (i32.add (call $abs (local.get $output)) (i32.const 4)))
      (local.set $used (i32.load (local.get $out_content)))
      (local.set $p (i32.load (i32.add (local.get $out_content) (i32.const 4))))
      (local.set $output (call $regexp_out_ensure
        (local.get $state_handle) (local.get $output)
        (i32.sub (local.get $subject_len) (local.get $p))))
      (if (i32.eqz (local.get $output))
        (then (return (i32.const 2) (local.get $fuel))))
      (local.set $out_content (i32.add (call $abs (local.get $output)) (i32.const 4)))
      (memory.copy
        (i32.add (i32.add (local.get $out_content) (i32.const 12)) (local.get $used))
        (i32.add (local.get $subject_abs) (local.get $p))
        (i32.sub (local.get $subject_len) (local.get $p)))
      (i32.store (local.get $out_content)
        (i32.add (local.get $used)
          (i32.sub (local.get $subject_len) (local.get $p))))
      (i32.store (i32.add (local.get $out_content) (i32.const 4)) (local.get $subject_len))
      (local.set $state0 (i32.or
        (i32.or (i32.const 10) (local.get $matched))
        (i32.shl (local.get $method_id) (i32.const 16))))
      (call $native_continuation_state_set
        (local.get $state_handle) (i32.const 0) (local.get $state0)))

    ;; Phase 10: intern the output and commit lastIndex per exec rules
    ;; (g: the loop's final failing attempt leaves 0; sticky non-global:
    ;; the single match's end, or 0 on a miss; otherwise untouched).
    (local.set $out_content (i32.add (call $abs (local.get $output)) (i32.const 4)))
    (local.set $sid (call $intern_string
      (i32.add (local.get $out_content) (i32.const 12))
      (i32.load (local.get $out_content))))
    (if (i32.eqz (local.get $sid))
      (then (return (i32.const 2) (local.get $fuel))))
    (if (local.get $g)
      (then
        (i32.store
          (call $abs (i32.add
            (local.get $descriptor_data) (global.get $REGEXP_LAST_INDEX)))
          (i32.const 0)))
      (else
        (if (local.get $y)
          (then
            (i32.store
              (call $abs (i32.add
                (local.get $descriptor_data) (global.get $REGEXP_LAST_INDEX)))
              (select
                (i32.load (i32.add
                  (local.get $cont_payload) (global.get $REGEX_CONT_MATCH_END_SCALAR)))
                (i32.const 0)
                (local.get $matched)))))))
    (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
    (call $write_value (local.get $result_slot)
      (global.get $TYPE_STRING) (i32.const 0) (local.get $sid) (i32.const 0))
    (call $write_ctx (global.get $CTX_PENDING_POINTER)
      (i32.add (local.get $result_slot) (global.get $VALUE_SIZE)))
    (return (i32.const 0) (local.get $fuel))
  )

  ;; ==========================================================================
  ;; is_typed_array
  ;;
  ;; Check if a type tag represents any typed array type.
  ;; Returns 1 if true, 0 if false.
  ;; ==========================================================================
  (func $is_typed_array (param $type i32) (result i32)
    ;; Check UINT8ARRAY (0x11) separately since it's not contiguous with others
    (if (i32.eq (local.get $type) (global.get $TYPE_UINT8ARRAY))
      (then (return (i32.const 1))))
    ;; Check range 0x14 - 0x1F (INT8ARRAY through BIGUINT64ARRAY)
    (i32.and
      (i32.ge_u (local.get $type) (global.get $TYPE_INT8ARRAY))
      (i32.le_u (local.get $type) (global.get $TYPE_BIGUINT64ARRAY)))
  )

  ;; ==========================================================================
  ;; get_bytes_per_element
  ;;
  ;; Get BYTES_PER_ELEMENT for a typed array type.
  ;; Returns 1, 2, 4, or 8 depending on type.
  ;; ==========================================================================
  (func $get_bytes_per_element (param $type i32) (result i32)
    ;; 1-byte types: INT8ARRAY, UINT8ARRAY, UINT8CLAMPEDARRAY
    (if (i32.or
          (i32.eq (local.get $type) (global.get $TYPE_INT8ARRAY))
          (i32.or
            (i32.eq (local.get $type) (global.get $TYPE_UINT8ARRAY))
            (i32.eq (local.get $type) (global.get $TYPE_UINT8CLAMPEDARRAY))))
      (then (return (i32.const 1))))
    ;; 2-byte types: INT16ARRAY, UINT16ARRAY
    (if (i32.or
          (i32.eq (local.get $type) (global.get $TYPE_INT16ARRAY))
          (i32.eq (local.get $type) (global.get $TYPE_UINT16ARRAY)))
      (then (return (i32.const 2))))
    ;; 4-byte types: INT32ARRAY, UINT32ARRAY, FLOAT32ARRAY
    (if (i32.or
          (i32.eq (local.get $type) (global.get $TYPE_INT32ARRAY))
          (i32.or
            (i32.eq (local.get $type) (global.get $TYPE_UINT32ARRAY))
            (i32.eq (local.get $type) (global.get $TYPE_FLOAT32ARRAY))))
      (then (return (i32.const 4))))
    ;; 8-byte types: FLOAT64ARRAY, BIGINT64ARRAY, BIGUINT64ARRAY
    (if (i32.or
          (i32.eq (local.get $type) (global.get $TYPE_FLOAT64ARRAY))
          (i32.or
            (i32.eq (local.get $type) (global.get $TYPE_BIGINT64ARRAY))
            (i32.eq (local.get $type) (global.get $TYPE_BIGUINT64ARRAY))))
      (then (return (i32.const 8))))
    ;; Unknown type
    (i32.const 0)
  )

  ;; ==========================================================================
  ;; typed_array_static_method_offset_to_type
  ;;
  ;; Convert an offset (0-10) from typed array static method IDs to TYPE_*.
  ;; The offsets match the order in METHOD constants:
  ;;   0 = UINT8ARRAY, 1 = INT8ARRAY, 2 = UINT8CLAMPEDARRAY,
  ;;   3 = INT16ARRAY, 4 = UINT16ARRAY, 5 = INT32ARRAY,
  ;;   6 = UINT32ARRAY, 7 = FLOAT32ARRAY, 8 = FLOAT64ARRAY,
  ;;   9 = BIGINT64ARRAY, 10 = BIGUINT64ARRAY
  ;; ==========================================================================
  (func $typed_array_static_method_offset_to_type (param $offset i32) (result i32)
    (if (i32.eq (local.get $offset) (i32.const 0))
      (then (return (global.get $TYPE_UINT8ARRAY))))
    (if (i32.eq (local.get $offset) (i32.const 1))
      (then (return (global.get $TYPE_INT8ARRAY))))
    (if (i32.eq (local.get $offset) (i32.const 2))
      (then (return (global.get $TYPE_UINT8CLAMPEDARRAY))))
    (if (i32.eq (local.get $offset) (i32.const 3))
      (then (return (global.get $TYPE_INT16ARRAY))))
    (if (i32.eq (local.get $offset) (i32.const 4))
      (then (return (global.get $TYPE_UINT16ARRAY))))
    (if (i32.eq (local.get $offset) (i32.const 5))
      (then (return (global.get $TYPE_INT32ARRAY))))
    (if (i32.eq (local.get $offset) (i32.const 6))
      (then (return (global.get $TYPE_UINT32ARRAY))))
    (if (i32.eq (local.get $offset) (i32.const 7))
      (then (return (global.get $TYPE_FLOAT32ARRAY))))
    (if (i32.eq (local.get $offset) (i32.const 8))
      (then (return (global.get $TYPE_FLOAT64ARRAY))))
    (if (i32.eq (local.get $offset) (i32.const 9))
      (then (return (global.get $TYPE_BIGINT64ARRAY))))
    (if (i32.eq (local.get $offset) (i32.const 10))
      (then (return (global.get $TYPE_BIGUINT64ARRAY))))
    ;; Unknown
    (i32.const 0)
  )

  ;; ==========================================================================
  ;; read_typed_element
  ;;
  ;; Read an element from a typed array at the given byte address.
  ;; Returns the value as f64 (JavaScript number representation).
  ;; ==========================================================================
  (func $read_typed_element (param $type i32) (param $byte_addr i32) (result f64)
    ;; Int8Array - sign extended
    (if (i32.eq (local.get $type) (global.get $TYPE_INT8ARRAY))
      (then (return (f64.convert_i32_s (i32.load8_s (local.get $byte_addr))))))
    ;; Uint8Array, Uint8ClampedArray - zero extended
    (if (i32.or
          (i32.eq (local.get $type) (global.get $TYPE_UINT8ARRAY))
          (i32.eq (local.get $type) (global.get $TYPE_UINT8CLAMPEDARRAY)))
      (then (return (f64.convert_i32_u (i32.load8_u (local.get $byte_addr))))))
    ;; Int16Array - sign extended
    (if (i32.eq (local.get $type) (global.get $TYPE_INT16ARRAY))
      (then (return (f64.convert_i32_s (i32.load16_s (local.get $byte_addr))))))
    ;; Uint16Array - zero extended
    (if (i32.eq (local.get $type) (global.get $TYPE_UINT16ARRAY))
      (then (return (f64.convert_i32_u (i32.load16_u (local.get $byte_addr))))))
    ;; Int32Array - sign extended
    (if (i32.eq (local.get $type) (global.get $TYPE_INT32ARRAY))
      (then (return (f64.convert_i32_s (i32.load (local.get $byte_addr))))))
    ;; Uint32Array - zero extended
    (if (i32.eq (local.get $type) (global.get $TYPE_UINT32ARRAY))
      (then (return (f64.convert_i32_u (i32.load (local.get $byte_addr))))))
    ;; Float32Array - widen to f64
    (if (i32.eq (local.get $type) (global.get $TYPE_FLOAT32ARRAY))
      (then (return (f64.promote_f32 (f32.load (local.get $byte_addr))))))
    ;; Float64Array - direct
    (if (i32.eq (local.get $type) (global.get $TYPE_FLOAT64ARRAY))
      (then (return (f64.load (local.get $byte_addr)))))
    ;; Default (shouldn't happen)
    (f64.const 0)
  )

  ;; ==========================================================================
  ;; write_typed_element
  ;;
  ;; Write an f64 value to a typed array at the given byte address.
  ;; Handles type-specific conversions (truncation, clamping, etc.).
  ;; ==========================================================================
  (func $write_typed_element (param $type i32) (param $byte_addr i32) (param $value f64)
    (local $i32_val i32)
    ;; Int8Array - truncate to signed byte
    (if (i32.eq (local.get $type) (global.get $TYPE_INT8ARRAY))
      (then
        (i32.store8 (local.get $byte_addr)
          (i32.and (i32.trunc_sat_f64_s (local.get $value)) (i32.const 0xff)))
        (return)))
    ;; Uint8Array - truncate to unsigned byte
    (if (i32.eq (local.get $type) (global.get $TYPE_UINT8ARRAY))
      (then
        (i32.store8 (local.get $byte_addr)
          (i32.and (i32.trunc_sat_f64_s (local.get $value)) (i32.const 0xff)))
        (return)))
    ;; Uint8ClampedArray - clamp to 0-255
    (if (i32.eq (local.get $type) (global.get $TYPE_UINT8CLAMPEDARRAY))
      (then
        (local.set $i32_val (i32.trunc_sat_f64_s (local.get $value)))
        (if (i32.lt_s (local.get $i32_val) (i32.const 0))
          (then (local.set $i32_val (i32.const 0))))
        (if (i32.gt_s (local.get $i32_val) (i32.const 255))
          (then (local.set $i32_val (i32.const 255))))
        (i32.store8 (local.get $byte_addr) (local.get $i32_val))
        (return)))
    ;; Int16Array - truncate to signed 16-bit
    (if (i32.eq (local.get $type) (global.get $TYPE_INT16ARRAY))
      (then
        (i32.store16 (local.get $byte_addr)
          (i32.and (i32.trunc_sat_f64_s (local.get $value)) (i32.const 0xffff)))
        (return)))
    ;; Uint16Array - truncate to unsigned 16-bit
    (if (i32.eq (local.get $type) (global.get $TYPE_UINT16ARRAY))
      (then
        (i32.store16 (local.get $byte_addr)
          (i32.and (i32.trunc_sat_f64_s (local.get $value)) (i32.const 0xffff)))
        (return)))
    ;; Int32Array - truncate to 32-bit
    (if (i32.eq (local.get $type) (global.get $TYPE_INT32ARRAY))
      (then
        (i32.store (local.get $byte_addr) (i32.trunc_sat_f64_s (local.get $value)))
        (return)))
    ;; Uint32Array - truncate to 32-bit unsigned
    (if (i32.eq (local.get $type) (global.get $TYPE_UINT32ARRAY))
      (then
        (i32.store (local.get $byte_addr) (i32.trunc_sat_f64_u (local.get $value)))
        (return)))
    ;; Float32Array - narrow to f32
    (if (i32.eq (local.get $type) (global.get $TYPE_FLOAT32ARRAY))
      (then
        (f32.store (local.get $byte_addr) (f32.demote_f64 (local.get $value)))
        (return)))
    ;; Float64Array - direct
    (if (i32.eq (local.get $type) (global.get $TYPE_FLOAT64ARRAY))
      (then
        (f64.store (local.get $byte_addr) (local.get $value))
        (return)))
  )

  ;; ==========================================================================
  ;; get_typed_array_type_for_constructor
  ;;
  ;; Map constructor method ID to the corresponding TYPE_* constant.
  ;; ==========================================================================
  (func $get_typed_array_type_for_constructor (param $method_id i32) (result i32)
    (if (i32.eq (local.get $method_id) (global.get $METHOD_UINT8ARRAY_CONSTRUCTOR))
      (then (return (global.get $TYPE_UINT8ARRAY))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_INT8ARRAY_CONSTRUCTOR))
      (then (return (global.get $TYPE_INT8ARRAY))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_UINT8CLAMPEDARRAY_CONSTRUCTOR))
      (then (return (global.get $TYPE_UINT8CLAMPEDARRAY))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_INT16ARRAY_CONSTRUCTOR))
      (then (return (global.get $TYPE_INT16ARRAY))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_UINT16ARRAY_CONSTRUCTOR))
      (then (return (global.get $TYPE_UINT16ARRAY))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_INT32ARRAY_CONSTRUCTOR))
      (then (return (global.get $TYPE_INT32ARRAY))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_UINT32ARRAY_CONSTRUCTOR))
      (then (return (global.get $TYPE_UINT32ARRAY))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_FLOAT32ARRAY_CONSTRUCTOR))
      (then (return (global.get $TYPE_FLOAT32ARRAY))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_FLOAT64ARRAY_CONSTRUCTOR))
      (then (return (global.get $TYPE_FLOAT64ARRAY))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_BIGINT64ARRAY_CONSTRUCTOR))
      (then (return (global.get $TYPE_BIGINT64ARRAY))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_BIGUINT64ARRAY_CONSTRUCTOR))
      (then (return (global.get $TYPE_BIGUINT64ARRAY))))
    ;; Unknown - return 0
    (i32.const 0)
  )

  ;; ==========================================================================
  ;; is_typed_array_constructor
  ;;
  ;; Check if a method ID is a typed array constructor.
  ;; ==========================================================================
  (func $is_typed_array_constructor (param $method_id i32) (result i32)
    (i32.or
      (i32.eq (local.get $method_id) (global.get $METHOD_UINT8ARRAY_CONSTRUCTOR))
      (i32.or
        (i32.and
          (i32.ge_u (local.get $method_id) (global.get $METHOD_INT8ARRAY_CONSTRUCTOR))
          (i32.le_u (local.get $method_id) (global.get $METHOD_BIGUINT64ARRAY_CONSTRUCTOR)))
        (i32.const 0)))
  )

  ;; estimate_typed_array_descriptor_size() → bytes
  ;; Worst-case heap consumption of $allocate_typed_array_descriptor:
  ;;   24 bytes fixed (GC 8 + bufferPtr 4 + byteOffset 4 + length 4 + pad 4).
  (func $estimate_typed_array_descriptor_size (result i32)
    (i32.const 24)
  )

  ;; ==========================================================================
  ;; allocate_typed_array_descriptor
  ;;
  ;; Allocates a TypedArray descriptor on the heap.
  ;; Layout: [GC:8][bufferPtr:4][byteOffset:4][length:4][sym_entries:4] = 24 bytes
  ;; sym_entries (the former pad) carries own symbol-keyed properties,
  ;; same block format as objects.
  ;; Returns data pointer (after GC header).
  ;; ==========================================================================
  (func $allocate_typed_array_descriptor
    (param $buffer_ptr i32) (param $byte_offset i32) (param $length i32)
    (result i32)
    (local $heap_pointer i32)
    (local $header_pointer i32)
    (local $data_pointer i32)

    (local.set $heap_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))
    (local.set $header_pointer (local.get $heap_pointer))
    (local.set $data_pointer (i32.add (local.get $header_pointer) (global.get $GC_HEADER_SIZE)))

    ;; Write GC header: size=24 | (OBJ_TYPED_ARRAY_DESCRIPTOR << 24)
    (i32.store (call $abs (local.get $header_pointer))
      (i32.or (i32.const 24) (i32.shl (global.get $OBJ_TYPED_ARRAY_DESCRIPTOR) (i32.const 24))))
    (i32.store (call $abs (i32.add (local.get $header_pointer) (i32.const 4))) (i32.const 0))

    ;; Write descriptor fields
    (i32.store (call $abs (local.get $data_pointer)) (local.get $buffer_ptr))
    (i32.store (call $abs (i32.add (local.get $data_pointer) (i32.const 4))) (local.get $byte_offset))
    (i32.store (call $abs (i32.add (local.get $data_pointer) (i32.const 8))) (local.get $length))
    (i32.store (call $abs (i32.add (local.get $data_pointer) (global.get $TYPED_ARRAY_SYM_ENTRIES_OFFSET))) (i32.const 0))

    ;; Update heap pointer (24 bytes total, already aligned)
    (call $write_state (global.get $STATE_HEAP_POINTER)
      (i32.add (local.get $heap_pointer) (i32.const 24)))

    ;; Return data pointer
    (local.get $data_pointer)
  )

  ;; ==========================================================================
  ;; to_uint8
  ;;
  ;; Convert a value to uint8 (0-255) for Uint8Array writes.
  ;; ==========================================================================
  (func $to_uint8 (param $value_ptr i32) (result i32)
    (local $type i32)
    (local $num f64)

    (local.set $type (call $value_type (local.get $value_ptr)))

    ;; Integer: direct AND with 0xFF
    (if (i32.eq (local.get $type) (global.get $TYPE_INTEGER))
      (then
        (return (i32.and (call $value_data_lo (local.get $value_ptr)) (i32.const 255)))
      )
    )

    ;; Float / Rational / BigInt: coerce to f64, truncate, AND with 0xFF
    (if (call $value_is_numeric (local.get $value_ptr))
      (then
        (local.set $num (call $value_to_f64 (local.get $value_ptr)))
        ;; ToUint8: modular reduction (handles NaN/±Infinity → 0 and
        ;; out-of-i32-range magnitudes — the raw trunc trapped there).
        (return (i32.and (call $f64_to_int32 (local.get $num)) (i32.const 255)))
      )
    )

    ;; Non-numeric: return 0
    (i32.const 0)
  )

  ;; ==========================================================================
  ;; value_flags - Read flags field from value at pointer
  ;; ==========================================================================
  (func $value_flags (param $pointer i32) (result i32)
    (i32.load (call $abs (i32.add (local.get $pointer) (i32.const 4))))
  )

  ;; ==========================================================================
  ;; object_set_property - Set a property on an object (used by Object.assign)
  ;; Handles both updating existing properties and adding new ones.
  ;;
  ;; Returns 0 on success; 1 when the add-property path needs the
  ;; doubling grow and $check_heap_overflow refuses it — pressure is
  ;; signaled and NOTHING was mutated. The caller must then restore
  ;; whatever operands it consumed and yield EXIT_MEMORY_PRESSURE, or
  ;; propagate the status to a handler. WAT requires every status result
  ;; to be consumed, so each call site either handles it or explicitly
  ;; documents a pre-budgeted carve with (drop). The grow branch can
  ;; double an already-large object; its full instruction-local allocation
  ;; must fit the heap/code free span before any writes.



  ;; ==========================================================================
  ;; estimate_object_grow_size(current_capacity) → bytes
  ;; Worst-case heap consumption of the grow branch of $object_set_property:
  ;; allocates a new entries block at max(current_capacity * 2, 4) entries,
  ;; sized GC_HEADER_SIZE (8) + new_cap * ENTRY_SIZE (20), 16-aligned.
  ;; If the property already exists (in-place update) or capacity is
  ;; sufficient, no allocation happens — opcode handlers should still
  ;; pre-check this as the worst case.
  (func $estimate_object_grow_size (param $current_capacity i32) (result i32)
    (local $new_cap i32)
    (local.set $new_cap (i32.mul (local.get $current_capacity) (i32.const 2)))
    (if (i32.lt_u (local.get $new_cap) (i32.const 4))
      (then (local.set $new_cap (i32.const 4))))
    (i32.and
      (i32.add
        (i32.add
          (global.get $GC_HEADER_SIZE)
          (i32.mul (local.get $new_cap) (global.get $ENTRY_SIZE)))
        (i32.const 15))
      (i32.const -16))
  )

  (func $object_set_property
    (param $object_pointer i32)
    (param $key_offset i32)
    (param $val_type i32)
    (param $val_flags i32)
    (param $val_lo i32)
    (param $val_hi i32)
    (result i32)

    (local $obj_count i32)
    (local $obj_cap i32)
    (local $entries_pointer i32)
    (local $i i32)
    (local $entry_pointer i32)
    (local $prop_key i32)
    (local $found i32)
    (local $heap_pointer i32)
    (local $new_entries_pointer i32)
    (local $new_entries_size i32)
    (local $new_cap i32)
    (local $element_pointer i32)
    (local $dest i32)

    ;; Object layout: [GC:8][prototype:4][count:4][capacity:4][entries_pointer:4]
    (local.set $obj_count (i32.load (call $abs (i32.add (local.get $object_pointer) (i32.const 12)))))
    (local.set $obj_cap (i32.load (call $abs (i32.add (local.get $object_pointer) (i32.const 16)))))
    (local.set $entries_pointer (i32.load (call $abs (i32.add (local.get $object_pointer) (i32.const 24)))))

    ;; Search for existing property
    (local.set $i (i32.const 0))
    (local.set $found (i32.const 0))
    (block $prop_found
      (loop $prop_loop
        (br_if $prop_found (i32.ge_u (local.get $i) (local.get $obj_count)))

        ;; entry_pointer = entries_pointer + 8 + i * ENTRY_SIZE
        (local.set $entry_pointer (i32.add
          (i32.add (local.get $entries_pointer) (global.get $GC_HEADER_SIZE))
          (i32.mul (local.get $i) (global.get $ENTRY_SIZE))))

        (local.set $prop_key (i32.load (call $abs (local.get $entry_pointer))))

        (if (i32.eq (local.get $prop_key) (local.get $key_offset))
          (then
            ;; Accessor-over-accessor: merge halves instead of replacing,
            ;; so `{ get x() {}, set x(v) {} }` keeps both. Nonzero halves
            ;; of the incoming value win; zero halves keep the existing.
            (if (i32.and
                  (i32.eq (local.get $val_type) (global.get $TYPE_ACCESSOR))
                  (i32.eq
                    (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 4))))
                    (global.get $TYPE_ACCESSOR)))
              (then
                (if (i32.ne (local.get $val_lo) (i32.const 0))
                  (then (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 12))) (local.get $val_lo))))
                (if (i32.ne (local.get $val_hi) (i32.const 0))
                  (then (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 16))) (local.get $val_hi))))
                (local.set $found (i32.const 1))
                (br $prop_found)
              )
            )
            ;; Found! Update the value in place
            (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 4))) (local.get $val_type))
            (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 8))) (local.get $val_flags))
            (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 12))) (local.get $val_lo))
            (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 16))) (local.get $val_hi))
            (local.set $found (i32.const 1))
            (br $prop_found)
          )
        )

        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $prop_loop)
      )
    )

    ;; If not found, add new property
    (if (i32.eqz (local.get $found))
      (then
        ;; Check if we need to grow entries block
        (if (i32.ge_u (local.get $obj_count) (local.get $obj_cap))
          (then
            ;; Pressure gate — BEFORE any store. A refused grow leaves
            ;; the object, the heap pointer, and the value untouched.
            (if (call $check_heap_overflow (call $estimate_object_grow_size (local.get $obj_cap)))
              (then (return (i32.const 1))))

            ;; Need to reallocate entries block
            ;; new_cap = capacity * 2 (or at least 4)
            (local.set $new_cap (i32.mul (local.get $obj_cap) (i32.const 2)))
            (if (i32.lt_u (local.get $new_cap) (i32.const 4))
              (then (local.set $new_cap (i32.const 4)))
            )

            ;; Allocate new entries block
            (local.set $heap_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))
            (local.set $new_entries_pointer (local.get $heap_pointer))
            (local.set $new_entries_size (i32.add (global.get $GC_HEADER_SIZE)
                                                   (i32.mul (local.get $new_cap) (global.get $ENTRY_SIZE))))
            ;; 16-align the entries block so downstream heap allocations
            ;; (BigInt / Rational / Complex / Expression) stay on the shared
            ;; grid. See $allocate_object for the full rationale.
            (local.set $new_entries_size (i32.and
              (i32.add (local.get $new_entries_size) (i32.const 15))
              (i32.const -16)))

            ;; GC header for new entries block — stores the aligned size.
            (i32.store (call $abs (local.get $new_entries_pointer))
              (i32.or (local.get $new_entries_size) (i32.shl (global.get $OBJ_OBJECT_DATA) (i32.const 24))))
            (i32.store (call $abs (i32.add (local.get $new_entries_pointer) (i32.const 4))) (i32.const 0))

            ;; Update heap pointer by the aligned size.
            (call $write_state (global.get $STATE_HEAP_POINTER)
              (i32.add (local.get $new_entries_pointer) (local.get $new_entries_size)))

            ;; Copy existing entries from old block
            (local.set $i (i32.const 0))
            (block $copy_done
              (loop $copy_loop
                (br_if $copy_done (i32.ge_u (local.get $i) (local.get $obj_count)))
                ;; src = old_entries_pointer + 8 + i * ENTRY_SIZE
                (local.set $element_pointer (i32.add
                  (i32.add (local.get $entries_pointer) (global.get $GC_HEADER_SIZE))
                  (i32.mul (local.get $i) (global.get $ENTRY_SIZE))))
                ;; dest = new_entries_pointer + 8 + i * ENTRY_SIZE
                (local.set $dest (i32.add
                  (i32.add (local.get $new_entries_pointer) (global.get $GC_HEADER_SIZE))
                  (i32.mul (local.get $i) (global.get $ENTRY_SIZE))))
                ;; Copy 20 bytes (entry size)
                (i32.store (call $abs (local.get $dest))
                  (i32.load (call $abs (local.get $element_pointer))))
                (i32.store (call $abs (i32.add (local.get $dest) (i32.const 4)))
                  (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 4)))))
                (i32.store (call $abs (i32.add (local.get $dest) (i32.const 8)))
                  (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 8)))))
                (i32.store (call $abs (i32.add (local.get $dest) (i32.const 12)))
                  (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 12)))))
                (i32.store (call $abs (i32.add (local.get $dest) (i32.const 16)))
                  (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 16)))))
                (local.set $i (i32.add (local.get $i) (i32.const 1)))
                (br $copy_loop)
              )
            )

            ;; Update object header with new entries_pointer and capacity
            (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 16))) (local.get $new_cap))
            (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 24))) (local.get $new_entries_pointer))
            (local.set $entries_pointer (local.get $new_entries_pointer))
          )
        )

        ;; Add new entry at count position
        ;; entry_pointer = entries_pointer + 8 + count * ENTRY_SIZE
        (local.set $entry_pointer (i32.add
          (i32.add (local.get $entries_pointer) (global.get $GC_HEADER_SIZE))
          (i32.mul (local.get $obj_count) (global.get $ENTRY_SIZE))))

        ;; Write entry: [key][type][flags][data_lo][data_hi]
        (i32.store (call $abs (local.get $entry_pointer)) (local.get $key_offset))
        (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 4))) (local.get $val_type))
        (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 8))) (local.get $val_flags))
        (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 12))) (local.get $val_lo))
        (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 16))) (local.get $val_hi))

        ;; Increment count
        (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 12)))
          (i32.add (local.get $obj_count) (i32.const 1)))
      )
    )
    (i32.const 0)
  )

  ;; object_delete_own_property(object_pointer, key_offset) → boolean (i32)
  ;;
  ;; Own-property removal for plain objects. Unlike
  ;; $object_find_string_entry (used by `in`, which
  ;; walks the prototype chain per JS spec), `delete` only ever removes
  ;; an OWN property — deleting through to a prototype's same-named
  ;; property is not JS semantics, so this never walks $object_pointer's
  ;; prototype link.
  ;;
  ;; Shift-down removal (not swap-with-last): plain objects preserve
  ;; JS's spec'd string-key insertion-order enumeration
  ;; (for...in/Object.keys), so removing an entry must slide every
  ;; later entry down one slot rather than swapping the last entry into
  ;; the hole, which would silently reorder later-inserted keys ahead
  ;; of earlier ones on the next enumeration.
  (func $object_delete_own_property (param $object_pointer i32) (param $key_offset i32) (result i32)
    (local $obj_count i32)
    (local $entries_pointer i32)
    (local $i i32)
    (local $entry_pointer i32)
    (local $found_index i32)
    (local $src i32)
    (local $dest i32)

    (local.set $obj_count (i32.load (call $abs (i32.add (local.get $object_pointer) (i32.const 12)))))
    (local.set $entries_pointer (i32.load (call $abs (i32.add (local.get $object_pointer) (i32.const 24)))))

    ;; Find the own entry (linear scan, no prototype walk).
    (local.set $found_index (i32.const -1))
    (local.set $i (i32.const 0))
    (block $scan_done
      (loop $scan
        (br_if $scan_done (i32.ge_u (local.get $i) (local.get $obj_count)))
        (local.set $entry_pointer (i32.add
          (i32.add (local.get $entries_pointer) (global.get $GC_HEADER_SIZE))
          (i32.mul (local.get $i) (global.get $ENTRY_SIZE))))
        (if (i32.eq (i32.load (call $abs (local.get $entry_pointer))) (local.get $key_offset))
          (then
            (local.set $found_index (local.get $i))
            (br $scan_done)
          )
        )
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $scan)
      )
    )

    (if (i32.lt_s (local.get $found_index) (i32.const 0))
      (then (return (i32.const 0)))  ;; not an own property — nothing to delete
    )

    ;; Shift every entry after found_index down by one slot.
    (local.set $i (local.get $found_index))
    (block $shift_done
      (loop $shift
        (br_if $shift_done (i32.ge_u (i32.add (local.get $i) (i32.const 1)) (local.get $obj_count)))
        (local.set $dest (i32.add
          (i32.add (local.get $entries_pointer) (global.get $GC_HEADER_SIZE))
          (i32.mul (local.get $i) (global.get $ENTRY_SIZE))))
        (local.set $src (i32.add
          (i32.add (local.get $entries_pointer) (global.get $GC_HEADER_SIZE))
          (i32.mul (i32.add (local.get $i) (i32.const 1)) (global.get $ENTRY_SIZE))))
        (i32.store (call $abs (local.get $dest))
          (i32.load (call $abs (local.get $src))))
        (i32.store (call $abs (i32.add (local.get $dest) (i32.const 4)))
          (i32.load (call $abs (i32.add (local.get $src) (i32.const 4)))))
        (i32.store (call $abs (i32.add (local.get $dest) (i32.const 8)))
          (i32.load (call $abs (i32.add (local.get $src) (i32.const 8)))))
        (i32.store (call $abs (i32.add (local.get $dest) (i32.const 12)))
          (i32.load (call $abs (i32.add (local.get $src) (i32.const 12)))))
        (i32.store (call $abs (i32.add (local.get $dest) (i32.const 16)))
          (i32.load (call $abs (i32.add (local.get $src) (i32.const 16)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $shift)
      )
    )

    ;; Decrement count. The now-stale last slot is left with whatever
    ;; bytes it had (harmless: count no longer reaches it, and it gets
    ;; overwritten in place next time $object_set_property appends).
    (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 12)))
      (i32.sub (local.get $obj_count) (i32.const 1)))

    (i32.const 1)
  )

  ;; ==========================================================================
  ;; JSON Support
  ;; ==========================================================================

  ;; Working memory for JSON.stringify and JSON.parse lives on the heap as
  ;; regular Uint8Array objects. Each function allocates a small descriptor
  ;; (4 KB initial capacity by default) and grows it by doubling whenever a
  ;; write would overflow. When the JSON op returns, the descriptors fall out
  ;; of scope and become garbage at the next GC cycle. JSON output is bounded
  ;; by available heap (intermediate work) and by the string table's free
  ;; capacity (the final interned result) — never by a fixed magic constant.
  ;;
  ;; The helpers below are the buffer-management primitives shared by both
  ;; stringify and parse. They use $allocate_arraybuffer +
  ;; $allocate_typed_array_descriptor (the same machinery that backs
  ;; user-facing Uint8Array). The descriptor's `length` field doubles as the
  ;; buffer's byte capacity — Uint8Array length-in-elements equals
  ;; length-in-bytes — so growth bumps that field along with the inner
  ;; buffer_ptr.

  ;; Allocate a fresh JSON working buffer (Uint8Array descriptor + backing
  ;; ArrayBuffer). Returns the descriptor data pointer. Initial bytes are
  ;; zero (matches $allocate_arraybuffer's contract).
  (func $json_alloc_buffer (param $byte_capacity i32) (result i32)
    (local $buffer_ptr i32)
    (local.set $buffer_ptr (call $allocate_arraybuffer (local.get $byte_capacity)))
    (call $allocate_typed_array_descriptor
      (local.get $buffer_ptr)
      (i32.const 0)
      (local.get $byte_capacity)))

  ;; Return the segment-relative offset of the first data byte in a JSON
  ;; buffer (i.e. byte 0 of the user-visible bytes, skipping the 4-byte
  ;; ArrayBuffer length prefix).
  (func $json_buffer_data_ptr (param $descriptor i32) (result i32)
    ;; Descriptor data layout: [buffer_ptr:4][byte_offset:4][length:4]
    ;; ArrayBuffer data layout: [byte_length:4][...bytes...]
    ;; First byte = buffer_ptr + 4 (since byte_offset == 0 by construction)
    (i32.add
      (i32.load (call $abs (local.get $descriptor)))
      (i32.const 4)))

  ;; Return the byte capacity of a JSON buffer.
  (func $json_buffer_capacity (param $descriptor i32) (result i32)
    (i32.load (call $abs (i32.add (local.get $descriptor) (i32.const 8)))))

  ;; Grow a JSON buffer to at least `required_bytes` capacity. If the current
  ;; capacity already suffices, this is a no-op. Otherwise allocates a new
  ;; ArrayBuffer of max(capacity*2, required), memcpy's the existing bytes
  ;; in, and rewrites the descriptor to point at the new backing.
  ;;
  ;; Returns 0 on success. Each growth step is pressure-checked
  ;; ($check_heap_overflow on the new backing's size) — $allocate_arraybuffer
  ;; bumps the heap blindly, and unchecked doublings would write past the
  ;; code pointer once the entry reserve is exceeded. On refusal the
  ;; pressure flag is set, the buffer is untouched, and 1 is returned;
  ;; callers unwind to the method handler, which yields
  ;; EXIT_MEMORY_PRESSURE and retries after GC.
  ;; The budget covers only bytes the writer can consume before yielding.
  ;;
  ;; The descriptor pointer is stable — callers can keep holding it across
  ;; this call. The inner `buffer_ptr` field changes, so callers must
  ;; re-read $json_buffer_data_ptr after this returns if they want absolute
  ;; addresses.
  (func $json_buffer_grow (param $descriptor i32) (param $required_bytes i32) (result i32)
    (local $current_capacity i32)
    (local $new_capacity i32)
    (local $old_buffer_ptr i32)
    (local $new_buffer_ptr i32)
    (local $copy_dest i32)
    (local $copy_src i32)
    (local $i i32)

    (local.set $current_capacity
      (i32.load (call $abs (i32.add (local.get $descriptor) (i32.const 8)))))

    ;; No-op if we already fit.
    (if (i32.ge_u (local.get $current_capacity) (local.get $required_bytes))
      (then (return (i32.const 0))))

    ;; Compute new capacity: max(current * 2, required). The doubling keeps
    ;; total bytes copied across all growths bounded by 2 × final size
    ;; (amortised O(n)). The max with required handles the edge case where
    ;; a single write asks for more than double the current size — rare in
    ;; practice (would need a >capacity-sized single literal) but cheap to
    ;; cover.
    (local.set $new_capacity (i32.shl (local.get $current_capacity) (i32.const 1)))
    (if (i32.lt_u (local.get $new_capacity) (local.get $required_bytes))
      (then (local.set $new_capacity (local.get $required_bytes))))

    ;; Pressure-check this growth step before touching the heap.
    (if (call $check_heap_overflow
          (call $estimate_arraybuffer_size (local.get $new_capacity)))
      (then (return (i32.const 1))))

    ;; Allocate the new backing buffer (zero-initialised by allocate_arraybuffer).
    (local.set $new_buffer_ptr (call $allocate_arraybuffer (local.get $new_capacity)))

    ;; Copy existing bytes from old buffer's data area to new buffer's data
    ;; area. Both areas live at buffer_ptr + 4 (skipping the ArrayBuffer
    ;; length prefix). Copy current_capacity bytes — anything past that in
    ;; the new buffer is already zero from allocate_arraybuffer.
    (local.set $old_buffer_ptr
      (i32.load (call $abs (local.get $descriptor))))
    (local.set $copy_src
      (call $abs (i32.add (local.get $old_buffer_ptr) (i32.const 4))))
    (local.set $copy_dest
      (call $abs (i32.add (local.get $new_buffer_ptr) (i32.const 4))))

    (local.set $i (i32.const 0))
    (block $copy_done
      (loop $copy_loop
        (br_if $copy_done (i32.ge_u (local.get $i) (local.get $current_capacity)))
        (i32.store8
          (i32.add (local.get $copy_dest) (local.get $i))
          (i32.load8_u (i32.add (local.get $copy_src) (local.get $i))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $copy_loop)))

    ;; Rewrite the descriptor in place. byte_offset stays 0.
    (i32.store (call $abs (local.get $descriptor)) (local.get $new_buffer_ptr))
    (i32.store
      (call $abs (i32.add (local.get $descriptor) (i32.const 8)))
      (local.get $new_capacity))
    (i32.const 0))

  ;; Ensure a JSON buffer has room for `extra_bytes` more bytes starting at
  ;; `current_pos` (a byte offset within the buffer). Grows the buffer if
  ;; necessary. Returns the segment-relative offset of the first data byte
  ;; *after* any growth — callers should use this to recompute absolute
  ;; addresses for the writes that follow.
  ;;
  ;; Returns -1 if growth was refused under memory pressure, or if
  ;; current_pos is already the -1 error sentinel (so a failed position
  ;; flows through chained writes without ever being used as an offset).
  ;; Callers MUST check for -1 before writing — writing at data_ptr - 1
  ;; would corrupt the byte before the buffer's data area.
  (func $json_buffer_ensure
    (param $descriptor i32) (param $current_pos i32) (param $extra_bytes i32)
    (result i32)
    (if (i32.eq (local.get $current_pos) (i32.const -1))
      (then (return (i32.const -1))))
    (if (call $json_buffer_grow
          (local.get $descriptor)
          (i32.add (local.get $current_pos) (local.get $extra_bytes)))
      (then (return (i32.const -1))))
    (call $json_buffer_data_ptr (local.get $descriptor)))

  ;; Write a byte to the JSON output buffer.
  ;; descriptor: the buffer's Uint8Array descriptor.
  ;; pos: byte offset within the buffer to write at.
  ;; Returns: new position (pos + 1), or -1 if the buffer could not grow
  ;; (pressure) or pos was already -1 — the sentinel flows through write
  ;; chains and is caught at the recursion/return boundaries.
  ;; Grows the buffer if necessary; the descriptor's inner buffer_ptr may
  ;; change but the descriptor pointer itself is stable.
  (func $json_write_byte (param $descriptor i32) (param $pos i32) (param $byte i32) (result i32)
    (local $data_ptr i32)
    (local.set $data_ptr
      (call $json_buffer_ensure (local.get $descriptor) (local.get $pos) (i32.const 1)))
    (if (i32.eq (local.get $data_ptr) (i32.const -1))
      (then (return (i32.const -1))))
    (i32.store8
      (call $abs (i32.add (local.get $data_ptr) (local.get $pos)))
      (local.get $byte))
    (i32.add (local.get $pos) (i32.const 1))
  )

  ;; Write multiple bytes from a source segment offset into the JSON
  ;; output buffer. src is a segment-relative address; len is the byte
  ;; count. Returns the new position (pos + len), or -1 on pressure
  ;; refusal / already-failed pos (same contract as $json_write_byte).
  (func $json_write_bytes
    (param $descriptor i32) (param $pos i32) (param $src i32) (param $len i32)
    (result i32)
    (local $data_ptr i32)
    (local $i i32)
    (local $abs_dest i32)
    (local $abs_src i32)

    (local.set $data_ptr
      (call $json_buffer_ensure (local.get $descriptor) (local.get $pos) (local.get $len)))
    (if (i32.eq (local.get $data_ptr) (i32.const -1))
      (then (return (i32.const -1))))
    (local.set $abs_dest (call $abs (i32.add (local.get $data_ptr) (local.get $pos))))
    (local.set $abs_src (call $abs (local.get $src)))
    (local.set $i (i32.const 0))

    (block $done
      (loop $copy
        (br_if $done (i32.ge_u (local.get $i) (local.get $len)))
        (i32.store8
          (i32.add (local.get $abs_dest) (local.get $i))
          (i32.load8_u (i32.add (local.get $abs_src) (local.get $i))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $copy)
      )
    )

    (i32.add (local.get $pos) (local.get $len))
  )

  ;; Write an escaped JSON string (without surrounding quotes).
  ;; descriptor: the JSON output buffer's Uint8Array descriptor.
  ;; pos: byte offset within the buffer to start writing at.
  ;; str_offset: segment-relative offset of the source string entry
  ;;   (length prefix followed by UTF-8 bytes).
  ;; Returns: new position, or -1 on error.
  ;;
  ;; The escape expansion is at most 6× the source length (for the
  ;; `\u00XX` form of control characters), so we pre-grow the buffer
  ;; to fit that worst case before entering the loop. The unused tail
  ;; after our actual writes is harmless — pos only advances by what
  ;; we wrote, so the next writer overwrites the unused bytes.
  (func $json_write_escaped_string
    (param $descriptor i32) (param $pos i32) (param $str_offset i32)
    (result i32)
    (local $len i32)
    (local $abs_str i32)
    (local $i i32)
    (local $byte i32)
    (local $abs_pos i32)
    (local $data_ptr i32)

    ;; Get string length and absolute source address.
    (local.set $len (i32.load (call $string_id_to_abs (local.get $str_offset))))
    (local.set $abs_str (i32.add (call $string_id_to_abs (local.get $str_offset)) (i32.const 4)))

    ;; Pre-grow for worst case: 6 bytes per source byte.
    (local.set $data_ptr
      (call $json_buffer_ensure
        (local.get $descriptor)
        (local.get $pos)
        (i32.mul (local.get $len) (i32.const 6))))
    (if (i32.eq (local.get $data_ptr) (i32.const -1))
      (then (return (i32.const -1))))

    (local.set $i (i32.const 0))

    (block $done
      (loop $escape_loop
        (br_if $done (i32.ge_u (local.get $i) (local.get $len)))

        (local.set $byte (i32.load8_u (i32.add (local.get $abs_str) (local.get $i))))
        (local.set $abs_pos (call $abs (i32.add (local.get $data_ptr) (local.get $pos))))

        ;; Check for characters that need escaping
        (if (i32.eq (local.get $byte) (i32.const 34))  ;; "
          (then
            (i32.store8 (local.get $abs_pos) (i32.const 92))  ;; \
            (i32.store8 (i32.add (local.get $abs_pos) (i32.const 1)) (i32.const 34))  ;; "
            (local.set $pos (i32.add (local.get $pos) (i32.const 2)))
          )
          (else
            (if (i32.eq (local.get $byte) (i32.const 92))  ;; \
              (then
                (i32.store8 (local.get $abs_pos) (i32.const 92))  ;; \
                (i32.store8 (i32.add (local.get $abs_pos) (i32.const 1)) (i32.const 92))  ;; \
                (local.set $pos (i32.add (local.get $pos) (i32.const 2)))
              )
              (else
                (if (i32.eq (local.get $byte) (i32.const 10))  ;; newline
                  (then
                    (i32.store8 (local.get $abs_pos) (i32.const 92))  ;; \
                    (i32.store8 (i32.add (local.get $abs_pos) (i32.const 1)) (i32.const 110))  ;; n
                    (local.set $pos (i32.add (local.get $pos) (i32.const 2)))
                  )
                  (else
                    (if (i32.eq (local.get $byte) (i32.const 13))  ;; carriage return
                      (then
                        (i32.store8 (local.get $abs_pos) (i32.const 92))  ;; \
                        (i32.store8 (i32.add (local.get $abs_pos) (i32.const 1)) (i32.const 114))  ;; r
                        (local.set $pos (i32.add (local.get $pos) (i32.const 2)))
                      )
                      (else
                        (if (i32.eq (local.get $byte) (i32.const 9))  ;; tab
                          (then
                            (i32.store8 (local.get $abs_pos) (i32.const 92))  ;; \
                            (i32.store8 (i32.add (local.get $abs_pos) (i32.const 1)) (i32.const 116))  ;; t
                            (local.set $pos (i32.add (local.get $pos) (i32.const 2)))
                          )
                          (else
                            (if (i32.lt_u (local.get $byte) (i32.const 32))  ;; other control chars
                              (then
                                ;; Write \u00XX
                                (i32.store8 (local.get $abs_pos) (i32.const 92))  ;; \
                                (i32.store8 (i32.add (local.get $abs_pos) (i32.const 1)) (i32.const 117))  ;; u
                                (i32.store8 (i32.add (local.get $abs_pos) (i32.const 2)) (i32.const 48))  ;; 0
                                (i32.store8 (i32.add (local.get $abs_pos) (i32.const 3)) (i32.const 48))  ;; 0
                                ;; High nibble
                                (i32.store8 (i32.add (local.get $abs_pos) (i32.const 4))
                                  (call $hex_digit (i32.shr_u (local.get $byte) (i32.const 4))))
                                ;; Low nibble
                                (i32.store8 (i32.add (local.get $abs_pos) (i32.const 5))
                                  (call $hex_digit (i32.and (local.get $byte) (i32.const 15))))
                                (local.set $pos (i32.add (local.get $pos) (i32.const 6)))
                              )
                              (else
                                ;; Regular character - copy as-is
                                (i32.store8 (local.get $abs_pos) (local.get $byte))
                                (local.set $pos (i32.add (local.get $pos) (i32.const 1)))
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )

        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $escape_loop)
      )
    )

    (local.get $pos)
  )

  ;; Convert nibble (0-15) to hex digit ASCII
  (func $hex_digit (param $n i32) (result i32)
    (if (result i32) (i32.lt_u (local.get $n) (i32.const 10))
      (then (i32.add (local.get $n) (i32.const 48)))  ;; '0' + n
      (else (i32.add (local.get $n) (i32.const 87))) ;; 'a' + n - 10
    )
  )

  ;; Visited-set layout (used for cycle detection in $json_stringify_value):
  ;;   buffer bytes 0..4   = count (i32)
  ;;   buffer bytes 4..    = entries (i32 each, one per visited pointer)
  ;;
  ;; The count lives inside the buffer (rather than as a separate cell) so
  ;; buffer growth copies it forward automatically.

  ;; Read the current visited-set count.
  (func $json_visited_count (param $descriptor i32) (result i32)
    (i32.load (call $abs (call $json_buffer_data_ptr (local.get $descriptor)))))

  ;; Write a new visited-set count.
  (func $json_visited_set_count (param $descriptor i32) (param $count i32)
    (i32.store
      (call $abs (call $json_buffer_data_ptr (local.get $descriptor)))
      (local.get $count)))

  ;; Check if a pointer is in the visited set.
  ;; Returns: 1 if found, 0 if not found.
  (func $json_visited_contains (param $descriptor i32) (param $pointer i32) (result i32)
    (local $count i32)
    (local $entries_base_abs i32)
    (local $i i32)

    (local.set $count (call $json_visited_count (local.get $descriptor)))
    ;; entries start at data + 4 (after the count cell).
    (local.set $entries_base_abs
      (call $abs (i32.add (call $json_buffer_data_ptr (local.get $descriptor)) (i32.const 4))))
    (local.set $i (i32.const 0))

    (block $not_found
      (loop $search
        (br_if $not_found (i32.ge_u (local.get $i) (local.get $count)))
        (if (i32.eq
              (i32.load (i32.add (local.get $entries_base_abs) (i32.mul (local.get $i) (i32.const 4))))
              (local.get $pointer))
          (then (return (i32.const 1)))
        )
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $search)
      )
    )

    (i32.const 0)
  )

  ;; Add a pointer to the visited set. Grows the buffer if necessary.
  ;; Increments the count automatically. Re-reads the data pointer after
  ;; the grow so the entry lands at the right address.
  ;;
  ;; Returns 0 on success, 1 if the buffer could not grow under memory
  ;; pressure — the entry is NOT added, and the caller must unwind (a
  ;; skipped visited entry would let a cycle recurse unboundedly inside
  ;; a single instruction, where no fuel check can interrupt it).
  (func $json_visited_add (param $descriptor i32) (param $pointer i32) (result i32)
    (local $count i32)
    (local $required_bytes i32)
    (local $data_ptr i32)

    (local.set $count (call $json_visited_count (local.get $descriptor)))
    ;; Required bytes: count cell (4) + (count + 1) entries × 4 bytes.
    (local.set $required_bytes
      (i32.add (i32.const 4) (i32.mul (i32.add (local.get $count) (i32.const 1)) (i32.const 4))))
    (if (call $json_buffer_grow (local.get $descriptor) (local.get $required_bytes))
      (then (return (i32.const 1))))

    ;; Re-read data pointer after possible grow, then write entry.
    (local.set $data_ptr (call $json_buffer_data_ptr (local.get $descriptor)))
    (i32.store
      (call $abs (i32.add
        (i32.add (local.get $data_ptr) (i32.const 4))
        (i32.mul (local.get $count) (i32.const 4))))
      (local.get $pointer))

    ;; Increment count.
    (i32.store
      (call $abs (local.get $data_ptr))
      (i32.add (local.get $count) (i32.const 1)))
    (i32.const 0)
  )

  ;; JSON stringify a value.
  ;; value_pointer: pointer to 16-byte value slot.
  ;; out_descriptor: the output buffer's Uint8Array descriptor.
  ;; out_pos: current byte offset within the output buffer.
  ;; visited_descriptor: the visited-set buffer's Uint8Array descriptor.
  ;; Returns: new output position, or -1 on error — a circular reference
  ;; (set_error called, pressure flag clear) or a refused buffer growth
  ;; under memory pressure (no error set, pressure flag set). The caller
  ;; distinguishes the two via $memory_pressure_signaled.
  ;; Write '\n' followed by $depth copies of the indent-unit string.
  ;; indent_id 0 = compact mode: writes nothing. Passes -1 through so it
  ;; chains like $json_write_byte.
  (func $json_write_newline_indent
    (param $descriptor i32) (param $pos i32) (param $indent_id i32) (param $depth i32)
    (result i32)
    (local $i i32)
    (if (i32.eqz (local.get $indent_id))
      (then (return (local.get $pos))))
    (if (i32.eq (local.get $pos) (i32.const -1))
      (then (return (i32.const -1))))
    (local.set $pos (call $json_write_byte (local.get $descriptor) (local.get $pos) (i32.const 10)))  ;; \n
    (local.set $i (i32.const 0))
    (block $indent_done
      (loop $indent_loop
        (br_if $indent_done (i32.ge_s (local.get $i) (local.get $depth)))
        (if (i32.eq (local.get $pos) (i32.const -1))
          (then (return (i32.const -1))))
        (local.set $pos (call $json_write_bytes
          (local.get $descriptor) (local.get $pos)
          (call $string_id_bytes_seg (local.get $indent_id))
          (call $read_string_len (local.get $indent_id))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $indent_loop)
      )
    )
    (local.get $pos)
  )

  ;; Own-entry lookup (no prototype walk) — the serializer reads own
  ;; properties only; the array-replacer PropertyList path needs the same
  ;; visibility by key.
  (func $object_find_own_entry (param $object_pointer i32) (param $key_offset i32) (result i32)
    (local $count i32)
    (local $entries i32)
    (local $j i32)
    (local $entry i32)
    (local.set $count (i32.load (call $abs (i32.add (local.get $object_pointer) (i32.const 12)))))
    (local.set $entries (i32.load (call $abs (i32.add (local.get $object_pointer) (i32.const 24)))))
    (local.set $j (i32.const 0))
    (block $own_find_done
      (loop $own_find_scan
        (br_if $own_find_done (i32.ge_u (local.get $j) (local.get $count)))
        (local.set $entry (i32.add
          (i32.add (local.get $entries) (global.get $GC_HEADER_SIZE))
          (i32.mul (local.get $j) (global.get $ENTRY_SIZE))))
        (if (i32.eq (i32.load (call $abs (local.get $entry))) (local.get $key_offset))
          (then (return (local.get $entry))))
        (local.set $j (i32.add (local.get $j) (i32.const 1)))
        (br $own_find_scan)
      )
    )
    (i32.const 0)
  )

  (func $json_stringify_value
    (param $value_pointer i32)
    (param $out_descriptor i32)
    (param $out_pos i32)
    (param $visited_descriptor i32)
    (param $indent_id i32)
    (param $depth i32)
    ;; Array-replacer PropertyList: 0 = none, else an array of
    ;; TYPE_STRING key quads. Applied to OBJECT serialization only
    ;; (spec: arrays are unaffected); threaded through every recursion
    ;; so nested objects filter too.
    (param $property_list i32)
    (result i32)

    (local $type i32)
    (local $data_lo i32)
    (local $data_hi i32)
    (local $str_offset i32)
    (local $str_len i32)
    (local $abs_str i32)
    (local $f64_val f64)
    (local $object_pointer i32)
    (local $obj_count i32)
    (local $entries_pointer i32)
    (local $i i32)
    (local $entry_pointer i32)
    (local $key_offset i32)
    (local $element_pointer i32)
    (local $first i32)
    (local $visited_count i32)
    (local $arr_len i32)
    (local $data_pointer i32)
    (local $elem_type i32)
    (local $abs_pos i32)
    (local $data_ptr i32)
    (local $json_array_pointer i32)
    (local $json_array_length i32)
    (local $json_index i32)
    (local $json_component_slots i32)

    ;; A failed position from an earlier write propagates here through
    ;; the recursion — bail before it can be used as a buffer offset.
    (if (i32.eq (local.get $out_pos) (i32.const -1))
      (then (return (i32.const -1))))

    (local.set $type (i32.load (call $abs (local.get $value_pointer))))
    (local.set $data_lo (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 8)))))
    (local.set $data_hi (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 12)))))

    ;; null
    (if (i32.eq (local.get $type) (global.get $TYPE_NULL))
      (then
        (local.set $data_ptr
          (call $json_buffer_ensure (local.get $out_descriptor) (local.get $out_pos) (i32.const 4)))
        (if (i32.eq (local.get $data_ptr) (i32.const -1))
          (then (return (i32.const -1))))
        (local.set $abs_pos (call $abs (i32.add (local.get $data_ptr) (local.get $out_pos))))
        (i32.store8 (local.get $abs_pos) (i32.const 110))  ;; n
        (i32.store8 (i32.add (local.get $abs_pos) (i32.const 1)) (i32.const 117))  ;; u
        (i32.store8 (i32.add (local.get $abs_pos) (i32.const 2)) (i32.const 108))  ;; l
        (i32.store8 (i32.add (local.get $abs_pos) (i32.const 3)) (i32.const 108))  ;; l
        (return (i32.add (local.get $out_pos) (i32.const 4)))
      )
    )

    ;; undefined - converted to null in JSON
    (if (i32.eq (local.get $type) (global.get $TYPE_UNDEFINED))
      (then
        (local.set $data_ptr
          (call $json_buffer_ensure (local.get $out_descriptor) (local.get $out_pos) (i32.const 4)))
        (if (i32.eq (local.get $data_ptr) (i32.const -1))
          (then (return (i32.const -1))))
        (local.set $abs_pos (call $abs (i32.add (local.get $data_ptr) (local.get $out_pos))))
        (i32.store8 (local.get $abs_pos) (i32.const 110))  ;; n
        (i32.store8 (i32.add (local.get $abs_pos) (i32.const 1)) (i32.const 117))  ;; u
        (i32.store8 (i32.add (local.get $abs_pos) (i32.const 2)) (i32.const 108))  ;; l
        (i32.store8 (i32.add (local.get $abs_pos) (i32.const 3)) (i32.const 108))  ;; l
        (return (i32.add (local.get $out_pos) (i32.const 4)))
      )
    )

    ;; boolean
    (if (i32.eq (local.get $type) (global.get $TYPE_BOOLEAN))
      (then
        (if (local.get $data_lo)
          (then
            ;; true
            (local.set $data_ptr
              (call $json_buffer_ensure (local.get $out_descriptor) (local.get $out_pos) (i32.const 4)))
            (if (i32.eq (local.get $data_ptr) (i32.const -1))
              (then (return (i32.const -1))))
            (local.set $abs_pos (call $abs (i32.add (local.get $data_ptr) (local.get $out_pos))))
            (i32.store8 (local.get $abs_pos) (i32.const 116))  ;; t
            (i32.store8 (i32.add (local.get $abs_pos) (i32.const 1)) (i32.const 114))  ;; r
            (i32.store8 (i32.add (local.get $abs_pos) (i32.const 2)) (i32.const 117))  ;; u
            (i32.store8 (i32.add (local.get $abs_pos) (i32.const 3)) (i32.const 101))  ;; e
            (return (i32.add (local.get $out_pos) (i32.const 4)))
          )
          (else
            ;; false
            (local.set $data_ptr
              (call $json_buffer_ensure (local.get $out_descriptor) (local.get $out_pos) (i32.const 5)))
            (if (i32.eq (local.get $data_ptr) (i32.const -1))
              (then (return (i32.const -1))))
            (local.set $abs_pos (call $abs (i32.add (local.get $data_ptr) (local.get $out_pos))))
            (i32.store8 (local.get $abs_pos) (i32.const 102))  ;; f
            (i32.store8 (i32.add (local.get $abs_pos) (i32.const 1)) (i32.const 97))  ;; a
            (i32.store8 (i32.add (local.get $abs_pos) (i32.const 2)) (i32.const 108))  ;; l
            (i32.store8 (i32.add (local.get $abs_pos) (i32.const 3)) (i32.const 115))  ;; s
            (i32.store8 (i32.add (local.get $abs_pos) (i32.const 4)) (i32.const 101))  ;; e
            (return (i32.add (local.get $out_pos) (i32.const 5)))
          )
        )
      )
    )

    ;; Float — JSON number (approximate side; NaN/Infinity become null).
    (if (i32.eq (local.get $type) (global.get $TYPE_FLOAT))
      (then
        (local.set $f64_val (f64.load (call $abs (i32.add (local.get $value_pointer) (i32.const 8)))))

        (if (i32.or
              (f64.ne (local.get $f64_val) (local.get $f64_val))
              (i32.or
                (f64.eq (local.get $f64_val) (f64.const inf))
                (f64.eq (local.get $f64_val) (f64.const -inf))))
          (then
            (local.set $data_ptr
              (call $json_buffer_ensure (local.get $out_descriptor) (local.get $out_pos) (i32.const 4)))
            (if (i32.eq (local.get $data_ptr) (i32.const -1))
              (then (return (i32.const -1))))
            (local.set $abs_pos (call $abs (i32.add (local.get $data_ptr) (local.get $out_pos))))
            (i32.store8 (local.get $abs_pos) (i32.const 110))  ;; n
            (i32.store8 (i32.add (local.get $abs_pos) (i32.const 1)) (i32.const 117))  ;; u
            (i32.store8 (i32.add (local.get $abs_pos) (i32.const 2)) (i32.const 108))  ;; l
            (i32.store8 (i32.add (local.get $abs_pos) (i32.const 3)) (i32.const 108))  ;; l
            (return (i32.add (local.get $out_pos) (i32.const 4)))
          )
        )

        (local.set $str_offset (call $f64_to_string (local.get $f64_val)))
        ;; A refused conversion (pressure) returns 0 with the flag set —
        ;; bail with the walker's failure sentinel instead of writing
        ;; string id 0's bytes and carrying on
        ;; would otherwise convert pressure into a valid empty string.
        (if (global.get $memory_pressure_signaled)
          (then (return (i32.const -1))))
        (local.set $str_len (i32.load (call $string_id_to_abs (local.get $str_offset))))
        (return (call $json_write_bytes
          (local.get $out_descriptor)
          (local.get $out_pos)
          (call $string_id_bytes_seg (local.get $str_offset))
          (local.get $str_len)))
      )
    )

    ;; Rational — integer-valued Rationals emit as plain JSON numbers to
    ;; preserve legacy consumer compat (matches the session.get unwrap rule
    ;; from 1d). Non-integer Rationals emit tagged form
    ;; {"$rational":"numerator/denominator"} so precision survives the
    ;; round-trip; f64 JSON numbers can't represent 1/3 losslessly.
    (if (i32.eq (local.get $type) (global.get $TYPE_RATIONAL))
      (then
        ;; Integer check: inline Rationals are always integer; heap
        ;; Rationals are integer iff denominator == 1.
        (if (call $rational_is_inline (local.get $value_pointer))
          (then
            ;; Use rational_to_decimal (which handles sign) for the plain
            ;; number emission. No NaN/Infinity case — inline Rationals are
            ;; finite by construction.
            (local.set $str_offset (call $rational_to_decimal (local.get $value_pointer)))
            (if (global.get $memory_pressure_signaled)
              (then (return (i32.const -1))))
            (local.set $str_len (i32.load (call $string_id_to_abs (local.get $str_offset))))
            (return (call $json_write_bytes
              (local.get $out_descriptor)
              (local.get $out_pos)
              (call $string_id_bytes_seg (local.get $str_offset))
              (local.get $str_len)))
          )
        )
        (if (i32.and
              (i32.eq (call $bigint_length
                (call $rational_denominator (local.get $data_lo))) (i32.const 1))
              (i32.eq (call $bigint_limb
                (call $rational_denominator (local.get $data_lo)) (i32.const 0)) (i32.const 1)))
          (then
            ;; Integer heap Rational → plain number.
            (local.set $str_offset (call $rational_to_decimal (local.get $value_pointer)))
            (if (global.get $memory_pressure_signaled)
              (then (return (i32.const -1))))
            (local.set $str_len (i32.load (call $string_id_to_abs (local.get $str_offset))))
            (return (call $json_write_bytes
              (local.get $out_descriptor)
              (local.get $out_pos)
              (call $string_id_bytes_seg (local.get $str_offset))
              (local.get $str_len)))
          )
        )

        ;; Non-integer Rational → tagged form.
        (local.set $str_offset (call $read_builtin (global.get $BUILTIN_JSON_RATIONAL_PREFIX)))
        (local.set $str_len (i32.load (call $string_id_to_abs (local.get $str_offset))))
        (local.set $out_pos (call $json_write_bytes
          (local.get $out_descriptor)
          (local.get $out_pos)
          (call $string_id_bytes_seg (local.get $str_offset))
          (local.get $str_len)))
        ;; Convert to a local FIRST so a pressure refusal (0 + flag) can
        ;; bail before the write consumes it.
        (local.set $str_offset (call $rational_to_decimal (local.get $value_pointer)))
        (if (global.get $memory_pressure_signaled)
          (then (return (i32.const -1))))
        (local.set $out_pos (call $json_write_escaped_string
          (local.get $out_descriptor)
          (local.get $out_pos)
          (local.get $str_offset)))
        (local.set $str_offset (call $read_builtin (global.get $BUILTIN_JSON_TAGGED_SUFFIX)))
        (local.set $str_len (i32.load (call $string_id_to_abs (local.get $str_offset))))
        (return (call $json_write_bytes
          (local.get $out_descriptor)
          (local.get $out_pos)
          (call $string_id_bytes_seg (local.get $str_offset))
          (local.get $str_len)))
      )
    )

    ;; Complex — tagged-object form: {"$complex":"<exact>"}.
    (if (i32.eq (local.get $type) (global.get $TYPE_COMPLEX))
      (then
        (local.set $str_offset (call $read_builtin (global.get $BUILTIN_JSON_COMPLEX_PREFIX)))
        (local.set $str_len (i32.load (call $string_id_to_abs (local.get $str_offset))))
        (local.set $out_pos (call $json_write_bytes
          (local.get $out_descriptor)
          (local.get $out_pos)
          (call $string_id_bytes_seg (local.get $str_offset))
          (local.get $str_len)))
        ;; Convert to a local FIRST so a pressure refusal (0 + flag) can
        ;; bail before the write consumes it.
        (local.set $str_offset (call $complex_to_decimal (local.get $data_lo)))
        (if (global.get $memory_pressure_signaled)
          (then (return (i32.const -1))))
        (local.set $out_pos (call $json_write_escaped_string
          (local.get $out_descriptor)
          (local.get $out_pos)
          (local.get $str_offset)))
        (local.set $str_offset (call $read_builtin (global.get $BUILTIN_JSON_TAGGED_SUFFIX)))
        (local.set $str_len (i32.load (call $string_id_to_abs (local.get $str_offset))))
        (return (call $json_write_bytes
          (local.get $out_descriptor)
          (local.get $out_pos)
          (call $string_id_bytes_seg (local.get $str_offset))
          (local.get $str_len)))
      )
    )

    ;; BigInt — tagged-object form: {"$bigint":"<exact>"}. JSON numbers
    ;; cannot represent integers past 2^53 exactly, so a dedicated tag
    ;; ComplexAlgebraicNumber — tagged component payloads:
    ;; {"$complexAlgebraic":{"realPart":...,"imaginaryPart":...}}
    (if (i32.eq (local.get $type) (global.get $TYPE_COMPLEX_ALGEBRAIC))
      (then
        (if (call $check_heap_overflow (i32.const 128))
          (then (return (i32.const -1))))
        (local.set $json_component_slots (call $carve_scratch_blob (i32.const 32)))
        (call $complex_algebraic_component_to_slot
          (call $complex_algebraic_real_pointer (local.get $data_lo))
          (local.get $json_component_slots))
        (call $complex_algebraic_component_to_slot
          (call $complex_algebraic_imaginary_pointer (local.get $data_lo))
          (i32.add (local.get $json_component_slots) (global.get $VALUE_SIZE)))
        (local.set $str_offset
          (call $read_builtin (global.get $BUILTIN_JSON_COMPLEX_ALGEBRAIC_PREFIX)))
        (local.set $str_len
          (i32.load (call $string_id_to_abs (local.get $str_offset))))
        (local.set $out_pos (call $json_write_bytes
          (local.get $out_descriptor) (local.get $out_pos)
          (call $string_id_bytes_seg (local.get $str_offset))
          (local.get $str_len)))
        (local.set $out_pos (call $json_stringify_value
          (local.get $json_component_slots)
          (local.get $out_descriptor) (local.get $out_pos)
          (local.get $visited_descriptor) (local.get $indent_id)
          (local.get $depth) (local.get $property_list)))
        (if (i32.lt_s (local.get $out_pos) (i32.const 0))
          (then (return (local.get $out_pos))))
        (local.set $str_offset
          (call $read_builtin (global.get $BUILTIN_JSON_COMPLEX_ALGEBRAIC_MIDDLE)))
        (local.set $str_len
          (i32.load (call $string_id_to_abs (local.get $str_offset))))
        (local.set $out_pos (call $json_write_bytes
          (local.get $out_descriptor) (local.get $out_pos)
          (call $string_id_bytes_seg (local.get $str_offset))
          (local.get $str_len)))
        (local.set $out_pos (call $json_stringify_value
          (i32.add (local.get $json_component_slots) (global.get $VALUE_SIZE))
          (local.get $out_descriptor) (local.get $out_pos)
          (local.get $visited_descriptor) (local.get $indent_id)
          (local.get $depth) (local.get $property_list)))
        (if (i32.lt_s (local.get $out_pos) (i32.const 0))
          (then (return (local.get $out_pos))))
        (local.set $str_offset
          (call $read_builtin (global.get $BUILTIN_JSON_COMPLEX_ALGEBRAIC_SUFFIX)))
        (local.set $str_len
          (i32.load (call $string_id_to_abs (local.get $str_offset))))
        (return (call $json_write_bytes
          (local.get $out_descriptor) (local.get $out_pos)
          (call $string_id_bytes_seg (local.get $str_offset))
          (local.get $str_len)))))

    ;; guarantees round-trip through Exact.fromJSON.
    (if (i32.eq (local.get $type) (global.get $TYPE_BIGINT))
      (then
        (local.set $str_offset (call $read_builtin (global.get $BUILTIN_JSON_BIGINT_PREFIX)))
        (local.set $str_len (i32.load (call $string_id_to_abs (local.get $str_offset))))
        (local.set $out_pos (call $json_write_bytes
          (local.get $out_descriptor)
          (local.get $out_pos)
          (call $string_id_bytes_seg (local.get $str_offset))
          (local.get $str_len)))
        ;; Convert to a local FIRST so a pressure refusal (0 + flag) can
        ;; bail before the write consumes it.
        (local.set $str_offset (call $bigint_to_decimal (local.get $data_lo)))
        (if (global.get $memory_pressure_signaled)
          (then (return (i32.const -1))))
        (local.set $out_pos (call $json_write_escaped_string
          (local.get $out_descriptor)
          (local.get $out_pos)
          (local.get $str_offset)))
        (local.set $str_offset (call $read_builtin (global.get $BUILTIN_JSON_TAGGED_SUFFIX)))
        (local.set $str_len (i32.load (call $string_id_to_abs (local.get $str_offset))))
        (return (call $json_write_bytes
          (local.get $out_descriptor)
          (local.get $out_pos)
          (call $string_id_bytes_seg (local.get $str_offset))
          (local.get $str_len)))
      )
    )

    ;; AlgebraicNumber — tagged structured form:
    ;; {"$algebraic":{"definingPolynomial":["-2","0","0","1"],
    ;; "isolatingInterval":["5/4","3/2"]}} — coefficients as decimal
    ;; strings ascending by degree, endpoints as exact rationals.
    (if (i32.eq (local.get $type) (global.get $TYPE_ALGEBRAIC))
      (then
        (local.set $str_offset (call $read_builtin (global.get $BUILTIN_JSON_ALGEBRAIC_PREFIX)))
        (local.set $str_len (i32.load (call $string_id_to_abs (local.get $str_offset))))
        (local.set $out_pos (call $json_write_bytes
          (local.get $out_descriptor)
          (local.get $out_pos)
          (call $string_id_bytes_seg (local.get $str_offset))
          (local.get $str_len)))
        (local.set $json_array_pointer (i32.add
          (i32.load (call $abs (i32.add
            (call $algebraic_coefficients_of (local.get $data_lo)) (i32.const 16))))
          (global.get $GC_HEADER_SIZE)))
        (local.set $json_array_length (i32.load (call $abs (i32.add
          (call $algebraic_coefficients_of (local.get $data_lo)) (i32.const 8)))))
        (local.set $json_index (i32.const 0))
        (block $coefficients_done
          (loop $coefficients
            (br_if $coefficients_done
              (i32.ge_s (local.get $json_index) (local.get $json_array_length)))
            (if (local.get $json_index)
              (then (local.set $str_offset
                (call $read_builtin (global.get $BUILTIN_JSON_QUOTE_COMMA_QUOTE))))
              (else (local.set $str_offset
                (call $read_builtin (global.get $BUILTIN_JSON_QUOTE)))))
            (local.set $str_len (i32.load (call $string_id_to_abs (local.get $str_offset))))
            (local.set $out_pos (call $json_write_bytes
              (local.get $out_descriptor)
              (local.get $out_pos)
              (call $string_id_bytes_seg (local.get $str_offset))
              (local.get $str_len)))
            (local.set $str_offset (call $bigint_to_decimal
              (call $value_data_lo (i32.add (local.get $json_array_pointer)
                (i32.mul (local.get $json_index) (global.get $VALUE_SIZE))))))
            (if (global.get $memory_pressure_signaled)
              (then (return (i32.const -1))))
            (local.set $out_pos (call $json_write_escaped_string
              (local.get $out_descriptor)
              (local.get $out_pos)
              (local.get $str_offset)))
            (local.set $json_index (i32.add (local.get $json_index) (i32.const 1)))
            (br $coefficients)))
        (local.set $str_offset (call $read_builtin (global.get $BUILTIN_JSON_QUOTE)))
        (local.set $str_len (i32.load (call $string_id_to_abs (local.get $str_offset))))
        (local.set $out_pos (call $json_write_bytes
          (local.get $out_descriptor)
          (local.get $out_pos)
          (call $string_id_bytes_seg (local.get $str_offset))
          (local.get $str_len)))
        (local.set $str_offset (call $read_builtin (global.get $BUILTIN_JSON_ALGEBRAIC_MIDDLE)))
        (local.set $str_len (i32.load (call $string_id_to_abs (local.get $str_offset))))
        (local.set $out_pos (call $json_write_bytes
          (local.get $out_descriptor)
          (local.get $out_pos)
          (call $string_id_bytes_seg (local.get $str_offset))
          (local.get $str_len)))
        (local.set $json_array_pointer (i32.add
          (i32.load (call $abs (i32.add
            (call $algebraic_interval_of (local.get $data_lo)) (i32.const 16))))
          (global.get $GC_HEADER_SIZE)))
        (local.set $str_offset (call $read_builtin (global.get $BUILTIN_JSON_QUOTE)))
        (local.set $str_len (i32.load (call $string_id_to_abs (local.get $str_offset))))
        (local.set $out_pos (call $json_write_bytes
          (local.get $out_descriptor)
          (local.get $out_pos)
          (call $string_id_bytes_seg (local.get $str_offset))
          (local.get $str_len)))
        (local.set $str_offset (call $rational_to_decimal (local.get $json_array_pointer)))
        (if (global.get $memory_pressure_signaled)
          (then (return (i32.const -1))))
        (local.set $out_pos (call $json_write_escaped_string
          (local.get $out_descriptor)
          (local.get $out_pos)
          (local.get $str_offset)))
        (local.set $str_offset (call $read_builtin (global.get $BUILTIN_JSON_QUOTE_COMMA_QUOTE)))
        (local.set $str_len (i32.load (call $string_id_to_abs (local.get $str_offset))))
        (local.set $out_pos (call $json_write_bytes
          (local.get $out_descriptor)
          (local.get $out_pos)
          (call $string_id_bytes_seg (local.get $str_offset))
          (local.get $str_len)))
        (local.set $str_offset (call $rational_to_decimal
          (i32.add (local.get $json_array_pointer) (global.get $VALUE_SIZE))))
        (if (global.get $memory_pressure_signaled)
          (then (return (i32.const -1))))
        (local.set $out_pos (call $json_write_escaped_string
          (local.get $out_descriptor)
          (local.get $out_pos)
          (local.get $str_offset)))
        (local.set $str_offset (call $read_builtin (global.get $BUILTIN_JSON_QUOTE)))
        (local.set $str_len (i32.load (call $string_id_to_abs (local.get $str_offset))))
        (local.set $out_pos (call $json_write_bytes
          (local.get $out_descriptor)
          (local.get $out_pos)
          (call $string_id_bytes_seg (local.get $str_offset))
          (local.get $str_len)))
        (local.set $str_offset (call $read_builtin (global.get $BUILTIN_JSON_ALGEBRAIC_SUFFIX)))
        (local.set $str_len (i32.load (call $string_id_to_abs (local.get $str_offset))))
        (return (call $json_write_bytes
          (local.get $out_descriptor)
          (local.get $out_pos)
          (call $string_id_bytes_seg (local.get $str_offset))
          (local.get $str_len)))
      )
    )

    ;; string
    (if (i32.eq (local.get $type) (global.get $TYPE_STRING))
      (then
        ;; Write opening quote
        (local.set $out_pos (call $json_write_byte (local.get $out_descriptor) (local.get $out_pos) (i32.const 34)))
        ;; Write escaped string contents
        (local.set $out_pos (call $json_write_escaped_string (local.get $out_descriptor) (local.get $out_pos) (local.get $data_lo)))
        ;; Write closing quote
        (return (call $json_write_byte (local.get $out_descriptor) (local.get $out_pos) (i32.const 34)))
      )
    )

    ;; MSGPACK_REF — a lazily-decoded container (refs are only created
    ;; for msgpack arrays and maps; primitives decode eagerly).
    ;; Materialize through the count-proportional, pressure-checked
    ;; builders, then rewrite $type/$data_lo and FALL THROUGH to the
    ;; ARRAY/OBJECT branches below. The materialized tree is transient
    ;; and MessagePack data is acyclic, so the cycle detector needs no
    ;; special case. Nested refs materialize recursively through this
    ;; branch. Explicit handling prevents the unknown-type null fallback
    ;; from silently removing them from output.


    (if (i32.eq (local.get $type) (global.get $TYPE_MSGPACK_REF))
      (then
        ;; data_lo = parent_data_ptr, data_hi = offset (Layout A).
        (local.set $abs_str (call $msgpack_ref_absolute (local.get $data_lo) (local.get $data_hi)))
        (local.set $str_len (call $msgpack_ref_parent_end (local.get $data_lo)))
        (local.set $elem_type (call $msgpack_peek_type (local.get $abs_str) (local.get $str_len)))
        (if (i32.eq (local.get $elem_type) (global.get $MSGPACK_ARRAY))
          (then
            (local.set $object_pointer (call $msgpack_to_array
              (local.get $abs_str) (local.get $str_len) (local.get $data_lo)))
            ;; 0 = malformed input (error set) or pressure refusal
            ;; (flag set, no error) — both unwind on the -1 channel;
            ;; the handler distinguishes via $memory_pressure_signaled.
            (if (i32.eqz (local.get $object_pointer))
              (then (return (i32.const -1))))
            (local.set $type (global.get $TYPE_ARRAY))
            (local.set $data_lo (local.get $object_pointer))
          )
          (else
            (if (i32.eq (local.get $elem_type) (global.get $MSGPACK_MAP))
              (then
                (if (call $msgpack_to_object
                      (local.get $abs_str) (local.get $str_len) (local.get $data_lo))
                  (then (return (i32.const -1))))
                ;; to_object returns its result via the pending stack;
                ;; pop it straight back off (balanced — the serializer
                ;; otherwise never touches the pending stack).
                (local.set $element_pointer (call $pending_pop))
                (local.set $type (global.get $TYPE_OBJECT))
                (local.set $data_lo
                  (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 8)))))
              )
            )
            ;; Any other peek result means malformed bytes: leave $type
            ;; as MSGPACK_REF so the unknown-type fallback emits null,
            ;; matching the serializer's conservative convention.
          )
        )
      )
    )

    ;; array
    (if (i32.eq (local.get $type) (global.get $TYPE_ARRAY))
      (then
        (local.set $object_pointer (local.get $data_lo))

        ;; Check for circular reference
        (if (call $json_visited_contains (local.get $visited_descriptor) (local.get $object_pointer))
          (then
            (call $set_error (global.get $ERR_JSON_STRINGIFY) (i32.const 0))  ;; 1 = circular
            (return (i32.const -1))
          )
        )

        ;; Add to visited set (increments count automatically).
        (if (call $json_visited_add (local.get $visited_descriptor) (local.get $object_pointer))
          (then (return (i32.const -1))))

        ;; Write opening bracket
        (local.set $out_pos (call $json_write_byte (local.get $out_descriptor) (local.get $out_pos) (i32.const 91)))  ;; [

        ;; Get array info
        (local.set $arr_len (i32.load (call $abs (i32.add (local.get $object_pointer) (i32.const 8)))))
        (local.set $data_pointer (i32.load (call $abs (i32.add (local.get $object_pointer) (i32.const 16)))))

        ;; Iterate elements
        (local.set $i (i32.const 0))
        (local.set $first (i32.const 1))
        (block $arr_done
          (loop $arr_loop
            (br_if $arr_done (i32.ge_u (local.get $i) (local.get $arr_len)))

            ;; Write comma if not first; every element starts on its own
            ;; indented line in indented mode
            (if (i32.eqz (local.get $first))
              (then
                (local.set $out_pos (call $json_write_byte (local.get $out_descriptor) (local.get $out_pos) (i32.const 44)))  ;; ,
              )
            )
            (local.set $first (i32.const 0))
            (local.set $out_pos (call $json_write_newline_indent
              (local.get $out_descriptor) (local.get $out_pos)
              (local.get $indent_id) (i32.add (local.get $depth) (i32.const 1))))

            ;; Get element pointer
            (local.set $element_pointer (i32.add
              (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
              (i32.mul (local.get $i) (global.get $VALUE_SIZE))))

            ;; Get element type to check for function/undefined
            (local.set $elem_type (i32.load (call $abs (local.get $element_pointer))))

            ;; Functions become null in arrays
            (if (i32.or
                  (i32.eq (local.get $elem_type) (global.get $TYPE_FUNCTION))
                  (i32.eq (local.get $elem_type) (global.get $TYPE_BOUND_METHOD)))
              (then
                (local.set $data_ptr
                  (call $json_buffer_ensure (local.get $out_descriptor) (local.get $out_pos) (i32.const 4)))
                (if (i32.eq (local.get $data_ptr) (i32.const -1))
                  (then (return (i32.const -1))))
                (local.set $abs_pos (call $abs (i32.add (local.get $data_ptr) (local.get $out_pos))))
                (i32.store8 (local.get $abs_pos) (i32.const 110))  ;; n
                (i32.store8 (i32.add (local.get $abs_pos) (i32.const 1)) (i32.const 117))  ;; u
                (i32.store8 (i32.add (local.get $abs_pos) (i32.const 2)) (i32.const 108))  ;; l
                (i32.store8 (i32.add (local.get $abs_pos) (i32.const 3)) (i32.const 108))  ;; l
                (local.set $out_pos (i32.add (local.get $out_pos) (i32.const 4)))
              )
              (else
                ;; Stringify element recursively
                (local.set $out_pos (call $json_stringify_value
                  (local.get $element_pointer)
                  (local.get $out_descriptor)
                  (local.get $out_pos)
                  (local.get $visited_descriptor)
                  (local.get $indent_id)
                  (i32.add (local.get $depth) (i32.const 1))
                  (local.get $property_list)))

                ;; Check for error
                (if (i32.eq (local.get $out_pos) (i32.const -1))
                  (then (return (i32.const -1)))
                )
              )
            )

            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $arr_loop)
          )
        )

        ;; Remove from visited set (decrement count).
        (call $json_visited_set_count
          (local.get $visited_descriptor)
          (i32.sub (call $json_visited_count (local.get $visited_descriptor)) (i32.const 1)))

        ;; Closing bracket on its own line in indented mode (unless empty)
        (if (i32.eqz (local.get $first))
          (then
            (local.set $out_pos (call $json_write_newline_indent
              (local.get $out_descriptor) (local.get $out_pos)
              (local.get $indent_id) (local.get $depth)))))
        (return (call $json_write_byte (local.get $out_descriptor) (local.get $out_pos) (i32.const 93)))  ;; ]
      )
    )

    ;; object
    (if (i32.eq (local.get $type) (global.get $TYPE_OBJECT))
      (then
        (local.set $object_pointer (local.get $data_lo))

        ;; Check for circular reference
        (if (call $json_visited_contains (local.get $visited_descriptor) (local.get $object_pointer))
          (then
            (call $set_error (global.get $ERR_JSON_STRINGIFY) (i32.const 0))  ;; 1 = circular
            (return (i32.const -1))
          )
        )

        ;; Add to visited set (increments count automatically).
        (if (call $json_visited_add (local.get $visited_descriptor) (local.get $object_pointer))
          (then (return (i32.const -1))))

        ;; Write opening brace
        (local.set $out_pos (call $json_write_byte (local.get $out_descriptor) (local.get $out_pos) (i32.const 123)))  ;; {

        ;; Get object info (layout: [GC:8][prototype:4][count:4][capacity:4][entries:4])
        (local.set $obj_count (i32.load (call $abs (i32.add (local.get $object_pointer) (i32.const 12)))))
        (local.set $entries_pointer (i32.load (call $abs (i32.add (local.get $object_pointer) (i32.const 24)))))

        ;; Array replacer: iterate the PropertyList instead of the
        ;; object's entries — its ORDER wins (spec), and keys the object
        ;; doesn't own are skipped.
        (if (local.get $property_list)
          (then
            (local.set $obj_count
              (i32.load (call $abs (i32.add (local.get $property_list) (i32.const 8)))))))

        ;; Iterate properties
        (local.set $i (i32.const 0))
        (local.set $first (i32.const 1))
        (block $obj_done
          (loop $obj_loop
            (br_if $obj_done (i32.ge_u (local.get $i) (local.get $obj_count)))

            ;; Get entry pointer — by index normally, or by PropertyList
            ;; key lookup (own entries only, matching the index walk).
            (if (i32.eqz (local.get $property_list))
              (then
                (local.set $entry_pointer (i32.add
                  (i32.add (local.get $entries_pointer) (global.get $GC_HEADER_SIZE))
                  (i32.mul (local.get $i) (global.get $ENTRY_SIZE)))))
              (else
                (local.set $entry_pointer (call $object_find_own_entry
                  (local.get $object_pointer)
                  (i32.load (call $abs (i32.add
                    (i32.add
                      (i32.add
                        (i32.load (call $abs (i32.add (local.get $property_list) (i32.const 16))))
                        (global.get $GC_HEADER_SIZE))
                      (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
                    (i32.const 8))))))
                (if (i32.eqz (local.get $entry_pointer))
                  (then
                    (local.set $i (i32.add (local.get $i) (i32.const 1)))
                    (br $obj_loop)))))

            ;; '@'-prefixed keys are hidden (non-enumerable) — omit from JSON.
            (if (call $string_key_is_hidden
                  (i32.load (call $abs (local.get $entry_pointer))))
              (then
                (local.set $i (i32.add (local.get $i) (i32.const 1)))
                (br $obj_loop)
              )
            )

            ;; Get value type to check if we should skip
            (local.set $elem_type (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 4)))))

            ;; Skip functions and undefined (they are omitted from JSON objects)
            (if (i32.or
                  (i32.or
                    (i32.eq (local.get $elem_type) (global.get $TYPE_FUNCTION))
                    (i32.eq (local.get $elem_type) (global.get $TYPE_BOUND_METHOD)))
                  (i32.eq (local.get $elem_type) (global.get $TYPE_UNDEFINED)))
              (then
                ;; Skip this property
                (local.set $i (i32.add (local.get $i) (i32.const 1)))
                (br $obj_loop)
              )
            )

            ;; Getter-backed property: serialising it needs a callback
            ;; invocation the serializer can't do — flag it and unwind so
            ;; dispatch returns code 3 and the caller runs the
            ;; JSON_TRANSFORM driver (which invokes the getters and
            ;; re-runs stringify on the resolved copy). No error is set;
            ;; call paths that cannot drive convert the flag into the
            ;; loud accessor TypeError instead.
            (if (i32.eq (local.get $elem_type) (global.get $TYPE_ACCESSOR))
              (then
                (global.set $json_met_accessor (i32.const 1))
                (return (i32.const -1))
              )
            )

            ;; Write comma if not first; every property starts on its own
            ;; indented line in indented mode
            (if (i32.eqz (local.get $first))
              (then
                (local.set $out_pos (call $json_write_byte (local.get $out_descriptor) (local.get $out_pos) (i32.const 44)))  ;; ,
              )
            )
            (local.set $first (i32.const 0))
            (local.set $out_pos (call $json_write_newline_indent
              (local.get $out_descriptor) (local.get $out_pos)
              (local.get $indent_id) (i32.add (local.get $depth) (i32.const 1))))

            ;; Get key offset
            (local.set $key_offset (i32.load (call $abs (local.get $entry_pointer))))

            ;; Write key as quoted string
            (local.set $out_pos (call $json_write_byte (local.get $out_descriptor) (local.get $out_pos) (i32.const 34)))  ;; "
            (local.set $out_pos (call $json_write_escaped_string (local.get $out_descriptor) (local.get $out_pos) (local.get $key_offset)))
            (local.set $out_pos (call $json_write_byte (local.get $out_descriptor) (local.get $out_pos) (i32.const 34)))  ;; "

            ;; Write colon (followed by a space in indented mode)
            (local.set $out_pos (call $json_write_byte (local.get $out_descriptor) (local.get $out_pos) (i32.const 58)))  ;; :
            (if (local.get $indent_id)
              (then
                (local.set $out_pos (call $json_write_byte (local.get $out_descriptor) (local.get $out_pos) (i32.const 32)))  ;; space
              )
            )

            ;; Create a temp value slot for the entry value
            ;; Entry layout: [key:4][type:4][flags:4][data_lo:4][data_hi:4]
            ;; We need to read type, flags, data_lo, data_hi and call stringify

            ;; Read value directly from entry (offset +4 for type)
            (local.set $element_pointer (i32.add (local.get $entry_pointer) (i32.const 4)))

            ;; Stringify value recursively
            (local.set $out_pos (call $json_stringify_value
              (local.get $element_pointer)
              (local.get $out_descriptor)
              (local.get $out_pos)
              (local.get $visited_descriptor)
              (local.get $indent_id)
              (i32.add (local.get $depth) (i32.const 1))
              (local.get $property_list)))

            ;; Check for error
            (if (i32.eq (local.get $out_pos) (i32.const -1))
              (then (return (i32.const -1)))
            )

            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $obj_loop)
          )
        )

        ;; Remove from visited set (decrement count).
        (call $json_visited_set_count
          (local.get $visited_descriptor)
          (i32.sub (call $json_visited_count (local.get $visited_descriptor)) (i32.const 1)))

        ;; Closing brace on its own line in indented mode (unless empty)
        (if (i32.eqz (local.get $first))
          (then
            (local.set $out_pos (call $json_write_newline_indent
              (local.get $out_descriptor) (local.get $out_pos)
              (local.get $indent_id) (local.get $depth)))))
        (return (call $json_write_byte (local.get $out_descriptor) (local.get $out_pos) (i32.const 125)))  ;; }
      )
    )

    ;; For any other type (closure, bound method, etc.), return undefined behavior
    ;; which we treat as null for safety
    (local.set $data_ptr
      (call $json_buffer_ensure (local.get $out_descriptor) (local.get $out_pos) (i32.const 4)))
    (if (i32.eq (local.get $data_ptr) (i32.const -1))
      (then (return (i32.const -1))))
    (local.set $abs_pos (call $abs (i32.add (local.get $data_ptr) (local.get $out_pos))))
    (i32.store8 (local.get $abs_pos) (i32.const 110))  ;; n
    (i32.store8 (i32.add (local.get $abs_pos) (i32.const 1)) (i32.const 117))  ;; u
    (i32.store8 (i32.add (local.get $abs_pos) (i32.const 2)) (i32.const 108))  ;; l
    (i32.store8 (i32.add (local.get $abs_pos) (i32.const 3)) (i32.const 108))  ;; l
    (i32.add (local.get $out_pos) (i32.const 4))
  )

  ;; Main JSON.stringify entry point.
  ;; value_pointer: pointer to value to stringify.
  ;; Returns: string offset of result, or 0 on error OR on memory
  ;; pressure (refused buffer growth / result-intern overflow) — the
  ;; caller distinguishes via $memory_pressure_signaled.
  ;;
  ;; Allocates two growable heap buffers: one for the serialised output
  ;; (4 KB initial capacity, doubles on overflow) and one for the visited
  ;; set used in cycle detection (1 KB initial, doubles on overflow).
  ;; Both become garbage after this function returns.
  (func $json_stringify
    (param $value_pointer i32) (param $indent_id i32) (param $property_list i32)
    (result i32)
    (local $out_descriptor i32)
    (local $visited_descriptor i32)
    (local $out_pos i32)
    (local $data_ptr i32)

    ;; Allocate the output buffer (initial 4 KB).
    (local.set $out_descriptor (call $json_alloc_buffer (i32.const 4096)))

    ;; Allocate the visited-set buffer (initial 1 KB — room for 255 entries
    ;; after the 4-byte count cell; grows from there). The count cell is
    ;; already zero from allocate_arraybuffer's zero-init.
    (local.set $visited_descriptor (call $json_alloc_buffer (i32.const 1024)))

    ;; Stringify the value into the output buffer at offset 0.
    (local.set $out_pos (call $json_stringify_value
      (local.get $value_pointer)
      (local.get $out_descriptor)
      (i32.const 0)
      (local.get $visited_descriptor)
      (local.get $indent_id)
      (i32.const 0)
      (local.get $property_list)))

    ;; Check for error
    (if (i32.eq (local.get $out_pos) (i32.const -1))
      (then (return (i32.const 0)))
    )

    ;; Intern the result string from the output buffer's data area.
    ;; out_pos is the byte length of the serialised output.
    (local.set $data_ptr (call $json_buffer_data_ptr (local.get $out_descriptor)))
    (call $intern_string (call $abs (local.get $data_ptr)) (local.get $out_pos))
  )

  ;; ==========================================================================
  ;; msgpack.encode implementation
  ;; ==========================================================================

  (func $msgpack_encode_value
    (param $value_pointer i32)
    (param $out_descriptor i32)
    (param $out_pos i32)
    (param $visited_descriptor i32)
    (result i32)

    (local $type i32)
    (local $data_lo i32)
    (local $data_hi i32)
    (local $data_ptr i32)
    (local $abs_pos i32)
    (local $i64val i64)
    (local $i32val i32)
    (local $f64_val f64)
    (local $str_len i32)
    (local $str_bytes_seg i32)
    (local $object_pointer i32)
    (local $arr_len i32)
    (local $data_pointer i32)
    (local $element_pointer i32)
    (local $i i32)
    (local $obj_count i32)
    (local $entries_pointer i32)
    (local $entry_pointer i32)
    (local $key_offset i32)
    (local $elem_type i32)
    (local $numerator i32)
    (local $sign i32)
    (local $limb0 i32)
    (local $limb1 i32)
    (local $bigint_len i32)
    (local $msgpack_addr i32)
    (local $msgpack_end i32)
    (local $msgpack_size i32)
    (local $buf_ptr i32)
    (local $buf_len i32)
    (local $buf_offset i32)

    ;; A failed position from an earlier write propagates here through
    ;; the recursion — bail before it can be used as a buffer offset.
    (if (i32.eq (local.get $out_pos) (i32.const -1))
      (then (return (i32.const -1))))

    (local.set $type (i32.load (call $abs (local.get $value_pointer))))
    (local.set $data_lo (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 8)))))
    (local.set $data_hi (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 12)))))

    ;; null / undefined → 0xc0 (nil)
    (if (i32.or
          (i32.eq (local.get $type) (global.get $TYPE_NULL))
          (i32.eq (local.get $type) (global.get $TYPE_UNDEFINED)))
      (then
        (return (call $json_write_byte (local.get $out_descriptor) (local.get $out_pos) (i32.const 0xc0)))
      )
    )

    ;; boolean → 0xc2 (false) / 0xc3 (true)
    (if (i32.eq (local.get $type) (global.get $TYPE_BOOLEAN))
      (then
        (if (local.get $data_lo)
          (then
            (return (call $json_write_byte (local.get $out_descriptor) (local.get $out_pos) (i32.const 0xc3)))
          )
          (else
            (return (call $json_write_byte (local.get $out_descriptor) (local.get $out_pos) (i32.const 0xc2)))
          )
        )
      )
    )

    ;; float → 0xcb + 8 bytes big-endian f64. Under the JSON number model
    ;; (Schema documents: a JS host's JSON.parse + msgpack.encode collapse
    ;; integral floats into integers, and validation must see the same
    ;; bytes) an integral value inside the int64 range encodes as an int.
    (if (i32.eq (local.get $type) (global.get $TYPE_FLOAT))
      (then
        (local.set $f64_val (f64.load (call $abs (i32.add (local.get $value_pointer) (i32.const 8)))))
        (if (global.get $msgpack_encode_json_numbers)
          (then
            (if (i32.and
                  (f64.eq (local.get $f64_val) (f64.nearest (local.get $f64_val)))
                  (i32.and
                    (f64.ge (local.get $f64_val) (f64.const -9223372036854775808))
                    (f64.lt (local.get $f64_val) (f64.const 9223372036854775808))))
              (then
                (return (call $msgpack_encode_i64
                  (local.get $out_descriptor) (local.get $out_pos)
                  (i64.trunc_f64_s (local.get $f64_val))))))))
        (local.set $data_ptr
          (call $json_buffer_ensure (local.get $out_descriptor) (local.get $out_pos) (i32.const 9)))
        (if (i32.eq (local.get $data_ptr) (i32.const -1))
          (then (return (i32.const -1))))
        (local.set $abs_pos (call $abs (i32.add (local.get $data_ptr) (local.get $out_pos))))
        (i32.store8 (local.get $abs_pos) (i32.const 0xcb))
        (call $write_f64_be (i32.add (local.get $abs_pos) (i32.const 1)) (local.get $f64_val))
        (return (i32.add (local.get $out_pos) (i32.const 9)))
      )
    )

    ;; rational (integer)
    (if (i32.eq (local.get $type) (global.get $TYPE_RATIONAL))
      (then
        (if (call $rational_is_inline (local.get $value_pointer))
          (then
            (local.set $i64val (call $rational_read_inline (local.get $value_pointer)))
            (return (call $msgpack_encode_i64
              (local.get $out_descriptor) (local.get $out_pos) (local.get $i64val)))
          )
        )
        ;; Heap rational — must be integer (denom=1) for msgpack
        (if (call $rational_denominator_is_one (local.get $data_lo))
          (then
            (local.set $numerator (call $rational_numerator (local.get $data_lo)))
            (local.set $sign (call $bigint_sign (local.get $numerator)))
            (local.set $bigint_len (call $bigint_length (local.get $numerator)))
            ;; 1-limb bigint: fits in i32 → encode as i64
            (if (i32.eq (local.get $bigint_len) (i32.const 1))
              (then
                (local.set $limb0 (call $bigint_limb (local.get $numerator) (i32.const 0)))
                (if (local.get $sign)
                  (then
                    (return (call $msgpack_encode_i64
                      (local.get $out_descriptor) (local.get $out_pos)
                      (i64.sub (i64.const 0) (i64.extend_i32_u (local.get $limb0)))))
                  )
                  (else
                    (return (call $msgpack_encode_i64
                      (local.get $out_descriptor) (local.get $out_pos)
                      (i64.extend_i32_u (local.get $limb0))))
                  )
                )
              )
            )
            ;; 2-limb bigint: fits in i64
            (if (i32.eq (local.get $bigint_len) (i32.const 2))
              (then
                (local.set $limb0 (call $bigint_limb (local.get $numerator) (i32.const 0)))
                (local.set $limb1 (call $bigint_limb (local.get $numerator) (i32.const 1)))
                (local.set $i64val (i64.or
                  (i64.extend_i32_u (local.get $limb0))
                  (i64.shl (i64.extend_i32_u (local.get $limb1)) (i64.const 32))))
                (if (local.get $sign)
                  (then
                    (local.set $i64val (i64.sub (i64.const 0) (local.get $i64val)))
                  )
                )
                (return (call $msgpack_encode_i64
                  (local.get $out_descriptor) (local.get $out_pos) (local.get $i64val)))
              )
            )
            ;; >2 limbs: too large for msgpack int64 → TypeError
            (call $set_error (global.get $ERR_TYPE_ERROR) (i32.const 0))
            (return (i32.const -1))
          )
        )
        ;; Non-integer rational → TypeError
        (call $set_error (global.get $ERR_TYPE_ERROR) (i32.const 0))
        (return (i32.const -1))
      )
    )

    ;; bigint
    (if (i32.eq (local.get $type) (global.get $TYPE_BIGINT))
      (then
        (local.set $sign (call $bigint_sign (local.get $data_lo)))
        (local.set $bigint_len (call $bigint_length (local.get $data_lo)))
        (if (i32.eq (local.get $bigint_len) (i32.const 1))
          (then
            (local.set $limb0 (call $bigint_limb (local.get $data_lo) (i32.const 0)))
            (if (local.get $sign)
              (then
                (return (call $msgpack_encode_i64
                  (local.get $out_descriptor) (local.get $out_pos)
                  (i64.sub (i64.const 0) (i64.extend_i32_u (local.get $limb0)))))
              )
              (else
                (return (call $msgpack_encode_i64
                  (local.get $out_descriptor) (local.get $out_pos)
                  (i64.extend_i32_u (local.get $limb0))))
              )
            )
          )
        )
        (if (i32.eq (local.get $bigint_len) (i32.const 2))
          (then
            (local.set $limb0 (call $bigint_limb (local.get $data_lo) (i32.const 0)))
            (local.set $limb1 (call $bigint_limb (local.get $data_lo) (i32.const 1)))
            (local.set $i64val (i64.or
              (i64.extend_i32_u (local.get $limb0))
              (i64.shl (i64.extend_i32_u (local.get $limb1)) (i64.const 32))))
            (if (local.get $sign)
              (then
                (local.set $i64val (i64.sub (i64.const 0) (local.get $i64val)))
              )
            )
            (return (call $msgpack_encode_i64
              (local.get $out_descriptor) (local.get $out_pos) (local.get $i64val)))
          )
        )
        ;; >2 limbs → TypeError
        (call $set_error (global.get $ERR_TYPE_ERROR) (i32.const 0))
        (return (i32.const -1))
      )
    )

    ;; string → fixstr / str8 / str16 / str32 header + raw UTF-8 bytes
    (if (i32.eq (local.get $type) (global.get $TYPE_STRING))
      (then
        (local.set $str_len (i32.load (call $string_id_to_abs (local.get $data_lo))))
        (local.set $str_bytes_seg (call $string_id_bytes_seg (local.get $data_lo)))
        ;; fixstr (0xa0 | len) for len < 32
        (if (i32.lt_u (local.get $str_len) (i32.const 32))
          (then
            (local.set $out_pos (call $json_write_byte (local.get $out_descriptor) (local.get $out_pos)
              (i32.or (i32.const 0xa0) (local.get $str_len))))
            (if (local.get $str_len)
              (then
                (local.set $out_pos (call $json_write_bytes (local.get $out_descriptor)
                  (local.get $out_pos) (local.get $str_bytes_seg) (local.get $str_len)))
              )
            )
            (return (local.get $out_pos))
          )
        )
        ;; str8 (0xd9 + 1 byte len) for len < 256
        (if (i32.lt_u (local.get $str_len) (i32.const 256))
          (then
            (local.set $data_ptr
              (call $json_buffer_ensure (local.get $out_descriptor) (local.get $out_pos) (i32.const 2)))
            (if (i32.eq (local.get $data_ptr) (i32.const -1))
              (then (return (i32.const -1))))
            (local.set $abs_pos (call $abs (i32.add (local.get $data_ptr) (local.get $out_pos))))
            (i32.store8 (local.get $abs_pos) (i32.const 0xd9))
            (i32.store8 (i32.add (local.get $abs_pos) (i32.const 1)) (local.get $str_len))
            (local.set $out_pos (i32.add (local.get $out_pos) (i32.const 2)))
            (return (call $json_write_bytes (local.get $out_descriptor)
              (local.get $out_pos) (local.get $str_bytes_seg) (local.get $str_len)))
          )
        )
        ;; str16 (0xda + 2 byte len) for len < 65536
        (if (i32.lt_u (local.get $str_len) (i32.const 65536))
          (then
            (local.set $data_ptr
              (call $json_buffer_ensure (local.get $out_descriptor) (local.get $out_pos) (i32.const 3)))
            (if (i32.eq (local.get $data_ptr) (i32.const -1))
              (then (return (i32.const -1))))
            (local.set $abs_pos (call $abs (i32.add (local.get $data_ptr) (local.get $out_pos))))
            (i32.store8 (local.get $abs_pos) (i32.const 0xda))
            (call $write_u16_be (i32.add (local.get $abs_pos) (i32.const 1)) (local.get $str_len))
            (local.set $out_pos (i32.add (local.get $out_pos) (i32.const 3)))
            (return (call $json_write_bytes (local.get $out_descriptor)
              (local.get $out_pos) (local.get $str_bytes_seg) (local.get $str_len)))
          )
        )
        ;; str32 (0xdb + 4 byte len)
        (local.set $data_ptr
          (call $json_buffer_ensure (local.get $out_descriptor) (local.get $out_pos) (i32.const 5)))
        (if (i32.eq (local.get $data_ptr) (i32.const -1))
          (then (return (i32.const -1))))
        (local.set $abs_pos (call $abs (i32.add (local.get $data_ptr) (local.get $out_pos))))
        (i32.store8 (local.get $abs_pos) (i32.const 0xdb))
        (call $write_u32_be (i32.add (local.get $abs_pos) (i32.const 1)) (local.get $str_len))
        (local.set $out_pos (i32.add (local.get $out_pos) (i32.const 5)))
        (return (call $json_write_bytes (local.get $out_descriptor)
          (local.get $out_pos) (local.get $str_bytes_seg) (local.get $str_len)))
      )
    )

    ;; Uint8Array → bin8 / bin16 / bin32 header + raw bytes
    (if (i32.eq (local.get $type) (global.get $TYPE_UINT8ARRAY))
      (then
        (local.set $buf_ptr (i32.load (call $abs (local.get $data_lo))))
        (local.set $buf_offset (i32.load (call $abs (i32.add (local.get $data_lo) (i32.const 4)))))
        (local.set $buf_len (i32.load (call $abs (i32.add (local.get $data_lo) (i32.const 8)))))
        ;; Segment-relative pointer to the actual bytes
        (local.set $str_bytes_seg (i32.add (i32.add (local.get $buf_ptr) (i32.const 4)) (local.get $buf_offset)))
        ;; bin8 (0xc4 + 1 byte len) for len < 256
        (if (i32.lt_u (local.get $buf_len) (i32.const 256))
          (then
            (local.set $data_ptr
              (call $json_buffer_ensure (local.get $out_descriptor) (local.get $out_pos) (i32.const 2)))
            (if (i32.eq (local.get $data_ptr) (i32.const -1))
              (then (return (i32.const -1))))
            (local.set $abs_pos (call $abs (i32.add (local.get $data_ptr) (local.get $out_pos))))
            (i32.store8 (local.get $abs_pos) (i32.const 0xc4))
            (i32.store8 (i32.add (local.get $abs_pos) (i32.const 1)) (local.get $buf_len))
            (local.set $out_pos (i32.add (local.get $out_pos) (i32.const 2)))
            (if (local.get $buf_len)
              (then
                (local.set $out_pos (call $json_write_bytes (local.get $out_descriptor)
                  (local.get $out_pos) (local.get $str_bytes_seg) (local.get $buf_len)))
              )
            )
            (return (local.get $out_pos))
          )
        )
        ;; bin16 (0xc5 + 2 byte len) for len < 65536
        (if (i32.lt_u (local.get $buf_len) (i32.const 65536))
          (then
            (local.set $data_ptr
              (call $json_buffer_ensure (local.get $out_descriptor) (local.get $out_pos) (i32.const 3)))
            (if (i32.eq (local.get $data_ptr) (i32.const -1))
              (then (return (i32.const -1))))
            (local.set $abs_pos (call $abs (i32.add (local.get $data_ptr) (local.get $out_pos))))
            (i32.store8 (local.get $abs_pos) (i32.const 0xc5))
            (call $write_u16_be (i32.add (local.get $abs_pos) (i32.const 1)) (local.get $buf_len))
            (local.set $out_pos (i32.add (local.get $out_pos) (i32.const 3)))
            (return (call $json_write_bytes (local.get $out_descriptor)
              (local.get $out_pos) (local.get $str_bytes_seg) (local.get $buf_len)))
          )
        )
        ;; bin32 (0xc6 + 4 byte len)
        (local.set $data_ptr
          (call $json_buffer_ensure (local.get $out_descriptor) (local.get $out_pos) (i32.const 5)))
        (if (i32.eq (local.get $data_ptr) (i32.const -1))
          (then (return (i32.const -1))))
        (local.set $abs_pos (call $abs (i32.add (local.get $data_ptr) (local.get $out_pos))))
        (i32.store8 (local.get $abs_pos) (i32.const 0xc6))
        (call $write_u32_be (i32.add (local.get $abs_pos) (i32.const 1)) (local.get $buf_len))
        (local.set $out_pos (i32.add (local.get $out_pos) (i32.const 5)))
        (return (call $json_write_bytes (local.get $out_descriptor)
          (local.get $out_pos) (local.get $str_bytes_seg) (local.get $buf_len)))
      )
    )

    ;; array → fixarray / array16 / array32 header + recursive elements
    (if (i32.eq (local.get $type) (global.get $TYPE_ARRAY))
      (then
        (local.set $object_pointer (local.get $data_lo))
        ;; Cycle detection
        (if (call $json_visited_contains (local.get $visited_descriptor) (local.get $object_pointer))
          (then
            (call $set_error (global.get $ERR_TYPE_ERROR) (i32.const 0))
            (return (i32.const -1))
          )
        )
        (if (call $json_visited_add (local.get $visited_descriptor) (local.get $object_pointer))
          (then (return (i32.const -1))))
        ;; Read array length
        (local.set $arr_len (i32.load (call $abs (i32.add (local.get $object_pointer) (i32.const 8)))))
        (local.set $data_pointer (i32.load (call $abs (i32.add (local.get $object_pointer) (i32.const 16)))))
        ;; Write array header
        (if (i32.lt_u (local.get $arr_len) (i32.const 16))
          (then
            ;; fixarray (0x90 | len)
            (local.set $out_pos (call $json_write_byte (local.get $out_descriptor) (local.get $out_pos)
              (i32.or (i32.const 0x90) (local.get $arr_len))))
          )
          (else
            (if (i32.lt_u (local.get $arr_len) (i32.const 65536))
              (then
                ;; array16 (0xdc + 2 byte len)
                (local.set $data_ptr
                  (call $json_buffer_ensure (local.get $out_descriptor) (local.get $out_pos) (i32.const 3)))
                (if (i32.eq (local.get $data_ptr) (i32.const -1))
                  (then (return (i32.const -1))))
                (local.set $abs_pos (call $abs (i32.add (local.get $data_ptr) (local.get $out_pos))))
                (i32.store8 (local.get $abs_pos) (i32.const 0xdc))
                (call $write_u16_be (i32.add (local.get $abs_pos) (i32.const 1)) (local.get $arr_len))
                (local.set $out_pos (i32.add (local.get $out_pos) (i32.const 3)))
              )
              (else
                ;; array32 (0xdd + 4 byte len)
                (local.set $data_ptr
                  (call $json_buffer_ensure (local.get $out_descriptor) (local.get $out_pos) (i32.const 5)))
                (if (i32.eq (local.get $data_ptr) (i32.const -1))
                  (then (return (i32.const -1))))
                (local.set $abs_pos (call $abs (i32.add (local.get $data_ptr) (local.get $out_pos))))
                (i32.store8 (local.get $abs_pos) (i32.const 0xdd))
                (call $write_u32_be (i32.add (local.get $abs_pos) (i32.const 1)) (local.get $arr_len))
                (local.set $out_pos (i32.add (local.get $out_pos) (i32.const 5)))
              )
            )
          )
        )
        ;; Encode each element
        (local.set $i (i32.const 0))
        (block $arr_done
          (loop $arr_loop
            (br_if $arr_done (i32.ge_u (local.get $i) (local.get $arr_len)))
            (local.set $element_pointer (i32.add
              (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
              (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
            (local.set $out_pos (call $msgpack_encode_value
              (local.get $element_pointer)
              (local.get $out_descriptor)
              (local.get $out_pos)
              (local.get $visited_descriptor)))
            (if (i32.eq (local.get $out_pos) (i32.const -1))
              (then (return (i32.const -1)))
            )
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $arr_loop)
          )
        )
        ;; Remove from visited set
        (call $json_visited_set_count
          (local.get $visited_descriptor)
          (i32.sub (call $json_visited_count (local.get $visited_descriptor)) (i32.const 1)))
        (return (local.get $out_pos))
      )
    )

    ;; object → fixmap / map16 / map32 header + recursive key-value pairs
    (if (i32.eq (local.get $type) (global.get $TYPE_OBJECT))
      (then
        (local.set $object_pointer (local.get $data_lo))
        ;; Cycle detection
        (if (call $json_visited_contains (local.get $visited_descriptor) (local.get $object_pointer))
          (then
            (call $set_error (global.get $ERR_TYPE_ERROR) (i32.const 0))
            (return (i32.const -1))
          )
        )
        (if (call $json_visited_add (local.get $visited_descriptor) (local.get $object_pointer))
          (then (return (i32.const -1))))
        ;; Count enumerable entries (skip functions, undefined, symbols)
        (local.set $obj_count (i32.load (call $abs (i32.add (local.get $object_pointer) (i32.const 12)))))
        (local.set $entries_pointer (i32.load (call $abs (i32.add (local.get $object_pointer) (i32.const 24)))))
        ;; Count how many entries are data (not function/undefined)
        (local.set $arr_len (i32.const 0))
        (local.set $i (i32.const 0))
        (block $count_done
          (loop $count_loop
            (br_if $count_done (i32.ge_u (local.get $i) (local.get $obj_count)))
            (local.set $entry_pointer (i32.add
              (i32.add (local.get $entries_pointer) (global.get $GC_HEADER_SIZE))
              (i32.mul (local.get $i) (global.get $ENTRY_SIZE))))
            (local.set $elem_type (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 4)))))
            (if (i32.eqz (i32.or
                  (i32.or
                    (i32.eq (local.get $elem_type) (global.get $TYPE_FUNCTION))
                    (i32.eq (local.get $elem_type) (global.get $TYPE_BOUND_METHOD)))
                  (i32.eq (local.get $elem_type) (global.get $TYPE_UNDEFINED))))
              (then
                (local.set $arr_len (i32.add (local.get $arr_len) (i32.const 1)))
              )
            )
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $count_loop)
          )
        )
        ;; Write map header
        (if (i32.lt_u (local.get $arr_len) (i32.const 16))
          (then
            ;; fixmap (0x80 | len)
            (local.set $out_pos (call $json_write_byte (local.get $out_descriptor) (local.get $out_pos)
              (i32.or (i32.const 0x80) (local.get $arr_len))))
          )
          (else
            (if (i32.lt_u (local.get $arr_len) (i32.const 65536))
              (then
                ;; map16 (0xde + 2 byte len)
                (local.set $data_ptr
                  (call $json_buffer_ensure (local.get $out_descriptor) (local.get $out_pos) (i32.const 3)))
                (if (i32.eq (local.get $data_ptr) (i32.const -1))
                  (then (return (i32.const -1))))
                (local.set $abs_pos (call $abs (i32.add (local.get $data_ptr) (local.get $out_pos))))
                (i32.store8 (local.get $abs_pos) (i32.const 0xde))
                (call $write_u16_be (i32.add (local.get $abs_pos) (i32.const 1)) (local.get $arr_len))
                (local.set $out_pos (i32.add (local.get $out_pos) (i32.const 3)))
              )
              (else
                ;; map32 (0xdf + 4 byte len)
                (local.set $data_ptr
                  (call $json_buffer_ensure (local.get $out_descriptor) (local.get $out_pos) (i32.const 5)))
                (if (i32.eq (local.get $data_ptr) (i32.const -1))
                  (then (return (i32.const -1))))
                (local.set $abs_pos (call $abs (i32.add (local.get $data_ptr) (local.get $out_pos))))
                (i32.store8 (local.get $abs_pos) (i32.const 0xdf))
                (call $write_u32_be (i32.add (local.get $abs_pos) (i32.const 1)) (local.get $arr_len))
                (local.set $out_pos (i32.add (local.get $out_pos) (i32.const 5)))
              )
            )
          )
        )
        ;; Encode each key-value pair
        (local.set $i (i32.const 0))
        (block $obj_done
          (loop $obj_loop
            (br_if $obj_done (i32.ge_u (local.get $i) (local.get $obj_count)))
            (local.set $entry_pointer (i32.add
              (i32.add (local.get $entries_pointer) (global.get $GC_HEADER_SIZE))
              (i32.mul (local.get $i) (global.get $ENTRY_SIZE))))
            ;; Skip functions, undefined
            (local.set $elem_type (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 4)))))
            (if (i32.or
                  (i32.or
                    (i32.eq (local.get $elem_type) (global.get $TYPE_FUNCTION))
                    (i32.eq (local.get $elem_type) (global.get $TYPE_BOUND_METHOD)))
                  (i32.eq (local.get $elem_type) (global.get $TYPE_UNDEFINED)))
              (then
                (local.set $i (i32.add (local.get $i) (i32.const 1)))
                (br $obj_loop)
              )
            )
            ;; Encode key as msgpack string
            (local.set $key_offset (i32.load (call $abs (local.get $entry_pointer))))
            (local.set $str_len (i32.load (call $string_id_to_abs (local.get $key_offset))))
            (local.set $str_bytes_seg (call $string_id_bytes_seg (local.get $key_offset)))
            (if (i32.lt_u (local.get $str_len) (i32.const 32))
              (then
                (local.set $out_pos (call $json_write_byte (local.get $out_descriptor) (local.get $out_pos)
                  (i32.or (i32.const 0xa0) (local.get $str_len))))
              )
              (else
                (if (i32.lt_u (local.get $str_len) (i32.const 256))
                  (then
                    (local.set $data_ptr
                      (call $json_buffer_ensure (local.get $out_descriptor) (local.get $out_pos) (i32.const 2)))
                    (if (i32.eq (local.get $data_ptr) (i32.const -1))
                      (then (return (i32.const -1))))
                    (local.set $abs_pos (call $abs (i32.add (local.get $data_ptr) (local.get $out_pos))))
                    (i32.store8 (local.get $abs_pos) (i32.const 0xd9))
                    (i32.store8 (i32.add (local.get $abs_pos) (i32.const 1)) (local.get $str_len))
                    (local.set $out_pos (i32.add (local.get $out_pos) (i32.const 2)))
                  )
                  (else
                    (if (i32.lt_u (local.get $str_len) (i32.const 65536))
                      (then
                        (local.set $data_ptr
                          (call $json_buffer_ensure (local.get $out_descriptor) (local.get $out_pos) (i32.const 3)))
                        (if (i32.eq (local.get $data_ptr) (i32.const -1))
                          (then (return (i32.const -1))))
                        (local.set $abs_pos (call $abs (i32.add (local.get $data_ptr) (local.get $out_pos))))
                        (i32.store8 (local.get $abs_pos) (i32.const 0xda))
                        (call $write_u16_be (i32.add (local.get $abs_pos) (i32.const 1)) (local.get $str_len))
                        (local.set $out_pos (i32.add (local.get $out_pos) (i32.const 3)))
                      )
                      (else
                        (local.set $data_ptr
                          (call $json_buffer_ensure (local.get $out_descriptor) (local.get $out_pos) (i32.const 5)))
                        (if (i32.eq (local.get $data_ptr) (i32.const -1))
                          (then (return (i32.const -1))))
                        (local.set $abs_pos (call $abs (i32.add (local.get $data_ptr) (local.get $out_pos))))
                        (i32.store8 (local.get $abs_pos) (i32.const 0xdb))
                        (call $write_u32_be (i32.add (local.get $abs_pos) (i32.const 1)) (local.get $str_len))
                        (local.set $out_pos (i32.add (local.get $out_pos) (i32.const 5)))
                      )
                    )
                  )
                )
              )
            )
            (if (local.get $str_len)
              (then
                (local.set $out_pos (call $json_write_bytes (local.get $out_descriptor)
                  (local.get $out_pos) (local.get $str_bytes_seg) (local.get $str_len)))
              )
            )
            ;; Encode value recursively (entry_pointer + 4 is the value slot)
            (local.set $element_pointer (i32.add (local.get $entry_pointer) (i32.const 4)))
            (local.set $out_pos (call $msgpack_encode_value
              (local.get $element_pointer)
              (local.get $out_descriptor)
              (local.get $out_pos)
              (local.get $visited_descriptor)))
            (if (i32.eq (local.get $out_pos) (i32.const -1))
              (then (return (i32.const -1)))
            )
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $obj_loop)
          )
        )
        ;; Remove from visited set
        (call $json_visited_set_count
          (local.get $visited_descriptor)
          (i32.sub (call $json_visited_count (local.get $visited_descriptor)) (i32.const 1)))
        (return (local.get $out_pos))
      )
    )

    ;; MSGPACK_REF → raw byte copy (already encoded)
    (if (i32.eq (local.get $type) (global.get $TYPE_MSGPACK_REF))
      (then
        (local.set $msgpack_addr
          (call $msgpack_ref_absolute (local.get $data_lo) (local.get $data_hi)))
        (local.set $msgpack_end
          (call $msgpack_ref_parent_end (local.get $data_lo)))
        (local.set $msgpack_size
          (call $msgpack_skip_value (local.get $msgpack_addr) (local.get $msgpack_end)))
        (if (i32.eq (local.get $msgpack_size) (i32.const -1))
          (then
            (call $set_error (global.get $ERR_MSGPACK_INVALID) (i32.const 0))
            (return (i32.const -1))
          )
        )
        (local.set $buf_len (i32.sub (local.get $msgpack_size) (local.get $msgpack_addr)))
        (local.set $data_ptr
          (call $json_buffer_ensure (local.get $out_descriptor) (local.get $out_pos) (local.get $buf_len)))
        (if (i32.eq (local.get $data_ptr) (i32.const -1))
          (then (return (i32.const -1))))
        (local.set $abs_pos (call $abs (i32.add (local.get $data_ptr) (local.get $out_pos))))
        (memory.copy (local.get $abs_pos) (local.get $msgpack_addr) (local.get $buf_len))
        (return (i32.add (local.get $out_pos) (local.get $buf_len)))
      )
    )

    ;; Any other type (function, external, symbol, etc.) → TypeError
    (call $set_error (global.get $ERR_TYPE_ERROR) (i32.const 0))
    (i32.const -1)
  )

  ;; Encode a signed i64 as the smallest msgpack integer format.
  (func $msgpack_encode_i64
    (param $out_descriptor i32)
    (param $out_pos i32)
    (param $val i64)
    (result i32)

    (local $data_ptr i32)
    (local $abs_pos i32)
    (local $i32val i32)

    ;; Positive fixint: 0..127 → single byte
    (if (i32.and
          (i64.ge_s (local.get $val) (i64.const 0))
          (i64.le_s (local.get $val) (i64.const 127)))
      (then
        (return (call $json_write_byte (local.get $out_descriptor) (local.get $out_pos)
          (i32.wrap_i64 (local.get $val))))
      )
    )

    ;; Negative fixint: -32..-1 → single byte (0xe0..0xff)
    (if (i32.and
          (i64.ge_s (local.get $val) (i64.const -32))
          (i64.lt_s (local.get $val) (i64.const 0)))
      (then
        (return (call $json_write_byte (local.get $out_descriptor) (local.get $out_pos)
          (i32.and (i32.wrap_i64 (local.get $val)) (i32.const 0xff))))
      )
    )

    ;; uint8: 128..255
    (if (i32.and
          (i64.ge_s (local.get $val) (i64.const 128))
          (i64.le_s (local.get $val) (i64.const 255)))
      (then
        (local.set $data_ptr
          (call $json_buffer_ensure (local.get $out_descriptor) (local.get $out_pos) (i32.const 2)))
        (if (i32.eq (local.get $data_ptr) (i32.const -1))
          (then (return (i32.const -1))))
        (local.set $abs_pos (call $abs (i32.add (local.get $data_ptr) (local.get $out_pos))))
        (i32.store8 (local.get $abs_pos) (i32.const 0xcc))
        (i32.store8 (i32.add (local.get $abs_pos) (i32.const 1)) (i32.wrap_i64 (local.get $val)))
        (return (i32.add (local.get $out_pos) (i32.const 2)))
      )
    )

    ;; int8: -128..-33
    (if (i32.and
          (i64.ge_s (local.get $val) (i64.const -128))
          (i64.lt_s (local.get $val) (i64.const -32)))
      (then
        (local.set $data_ptr
          (call $json_buffer_ensure (local.get $out_descriptor) (local.get $out_pos) (i32.const 2)))
        (if (i32.eq (local.get $data_ptr) (i32.const -1))
          (then (return (i32.const -1))))
        (local.set $abs_pos (call $abs (i32.add (local.get $data_ptr) (local.get $out_pos))))
        (i32.store8 (local.get $abs_pos) (i32.const 0xd0))
        (i32.store8 (i32.add (local.get $abs_pos) (i32.const 1))
          (i32.and (i32.wrap_i64 (local.get $val)) (i32.const 0xff)))
        (return (i32.add (local.get $out_pos) (i32.const 2)))
      )
    )

    ;; uint16: 256..65535
    (if (i32.and
          (i64.ge_s (local.get $val) (i64.const 256))
          (i64.le_s (local.get $val) (i64.const 65535)))
      (then
        (local.set $data_ptr
          (call $json_buffer_ensure (local.get $out_descriptor) (local.get $out_pos) (i32.const 3)))
        (if (i32.eq (local.get $data_ptr) (i32.const -1))
          (then (return (i32.const -1))))
        (local.set $abs_pos (call $abs (i32.add (local.get $data_ptr) (local.get $out_pos))))
        (i32.store8 (local.get $abs_pos) (i32.const 0xcd))
        (call $write_u16_be (i32.add (local.get $abs_pos) (i32.const 1)) (i32.wrap_i64 (local.get $val)))
        (return (i32.add (local.get $out_pos) (i32.const 3)))
      )
    )

    ;; int16: -32768..-129
    (if (i32.and
          (i64.ge_s (local.get $val) (i64.const -32768))
          (i64.lt_s (local.get $val) (i64.const -128)))
      (then
        (local.set $data_ptr
          (call $json_buffer_ensure (local.get $out_descriptor) (local.get $out_pos) (i32.const 3)))
        (if (i32.eq (local.get $data_ptr) (i32.const -1))
          (then (return (i32.const -1))))
        (local.set $abs_pos (call $abs (i32.add (local.get $data_ptr) (local.get $out_pos))))
        (i32.store8 (local.get $abs_pos) (i32.const 0xd1))
        (call $write_u16_be (i32.add (local.get $abs_pos) (i32.const 1))
          (i32.and (i32.wrap_i64 (local.get $val)) (i32.const 0xffff)))
        (return (i32.add (local.get $out_pos) (i32.const 3)))
      )
    )

    ;; uint32: 65536..4294967295
    (if (i32.and
          (i64.ge_s (local.get $val) (i64.const 65536))
          (i64.le_s (local.get $val) (i64.const 4294967295)))
      (then
        (local.set $data_ptr
          (call $json_buffer_ensure (local.get $out_descriptor) (local.get $out_pos) (i32.const 5)))
        (if (i32.eq (local.get $data_ptr) (i32.const -1))
          (then (return (i32.const -1))))
        (local.set $abs_pos (call $abs (i32.add (local.get $data_ptr) (local.get $out_pos))))
        (i32.store8 (local.get $abs_pos) (i32.const 0xce))
        (call $write_u32_be (i32.add (local.get $abs_pos) (i32.const 1)) (i32.wrap_i64 (local.get $val)))
        (return (i32.add (local.get $out_pos) (i32.const 5)))
      )
    )

    ;; int32: -2147483648..-32769
    (if (i32.and
          (i64.ge_s (local.get $val) (i64.const -2147483648))
          (i64.lt_s (local.get $val) (i64.const -32768)))
      (then
        (local.set $data_ptr
          (call $json_buffer_ensure (local.get $out_descriptor) (local.get $out_pos) (i32.const 5)))
        (if (i32.eq (local.get $data_ptr) (i32.const -1))
          (then (return (i32.const -1))))
        (local.set $abs_pos (call $abs (i32.add (local.get $data_ptr) (local.get $out_pos))))
        (i32.store8 (local.get $abs_pos) (i32.const 0xd2))
        (call $write_u32_be (i32.add (local.get $abs_pos) (i32.const 1)) (i32.wrap_i64 (local.get $val)))
        (return (i32.add (local.get $out_pos) (i32.const 5)))
      )
    )

    ;; uint64: positive values > u32 max
    (if (i64.gt_s (local.get $val) (i64.const 4294967295))
      (then
        (local.set $data_ptr
          (call $json_buffer_ensure (local.get $out_descriptor) (local.get $out_pos) (i32.const 9)))
        (if (i32.eq (local.get $data_ptr) (i32.const -1))
          (then (return (i32.const -1))))
        (local.set $abs_pos (call $abs (i32.add (local.get $data_ptr) (local.get $out_pos))))
        (i32.store8 (local.get $abs_pos) (i32.const 0xcf))
        (call $write_u32_be (i32.add (local.get $abs_pos) (i32.const 1))
          (i32.wrap_i64 (i64.shr_u (local.get $val) (i64.const 32))))
        (call $write_u32_be (i32.add (local.get $abs_pos) (i32.const 5))
          (i32.wrap_i64 (local.get $val)))
        (return (i32.add (local.get $out_pos) (i32.const 9)))
      )
    )

    ;; int64: negative values < i32 min
    (local.set $data_ptr
      (call $json_buffer_ensure (local.get $out_descriptor) (local.get $out_pos) (i32.const 9)))
    (if (i32.eq (local.get $data_ptr) (i32.const -1))
      (then (return (i32.const -1))))
    (local.set $abs_pos (call $abs (i32.add (local.get $data_ptr) (local.get $out_pos))))
    (i32.store8 (local.get $abs_pos) (i32.const 0xd3))
    (call $write_u32_be (i32.add (local.get $abs_pos) (i32.const 1))
      (i32.wrap_i64 (i64.shr_u (local.get $val) (i64.const 32))))
    (call $write_u32_be (i32.add (local.get $abs_pos) (i32.const 5))
      (i32.wrap_i64 (local.get $val)))
    (i32.add (local.get $out_pos) (i32.const 9))
  )

  ;; Main msgpack.encode entry point.
  ;; value_pointer: pointer to value to encode.
  ;; Returns: typed array descriptor pointer, or 0 on error OR on memory
  ;; pressure — the caller distinguishes via $memory_pressure_signaled.
  (func $msgpack_encode (param $value_pointer i32) (result i32)
    (local $out_descriptor i32)
    (local $visited_descriptor i32)
    (local $out_pos i32)
    (local $data_ptr i32)
    (local $result_buffer i32)
    (local $result_descriptor i32)

    (local.set $out_descriptor (call $json_alloc_buffer (i32.const 4096)))
    (local.set $visited_descriptor (call $json_alloc_buffer (i32.const 1024)))

    (local.set $out_pos (call $msgpack_encode_value
      (local.get $value_pointer)
      (local.get $out_descriptor)
      (i32.const 0)
      (local.get $visited_descriptor)))

    (if (i32.eq (local.get $out_pos) (i32.const -1))
      (then (return (i32.const 0)))
    )

    ;; Allocate result ArrayBuffer + Uint8Array. Proportional pressure
    ;; pre-check — the exact output size is known now, and both
    ;; allocators below bump the heap blindly.
    (if (call $check_heap_overflow
          (i32.add
            (call $estimate_arraybuffer_size (local.get $out_pos))
            (call $estimate_typed_array_descriptor_size)))
      (then (return (i32.const 0))))
    (local.set $data_ptr (call $json_buffer_data_ptr (local.get $out_descriptor)))
    (local.set $result_buffer (call $allocate_arraybuffer (local.get $out_pos)))
    (if (local.get $out_pos)
      (then
        (memory.copy
          (call $abs (i32.add (local.get $result_buffer) (i32.const 4)))
          (call $abs (local.get $data_ptr))
          (local.get $out_pos))
      )
    )
    (local.set $result_descriptor
      (call $allocate_typed_array_descriptor
        (local.get $result_buffer)
        (i32.const 0)
        (local.get $out_pos)))
    (local.get $result_descriptor)
  )

  ;; ==========================================================================
  ;; msgpack.decode implementation
  ;; ==========================================================================

  ;; Decode a complete msgpack value from bytes, handling all types including
  ;; containers. Pushes the result to the pending stack.
  ;; Returns: 0 on success, -1 on error OR on a container allocation
  ;; refused under memory pressure (no error set, pressure flag set) —
  ;; the caller distinguishes via $memory_pressure_signaled.
  (func $msgpack_decode_any (param $addr i32) (param $end_addr i32) (param $parent_data_ptr i32) (result i32)
    (local $type i32)

    (local.set $type (call $msgpack_peek_type (local.get $addr) (local.get $end_addr)))
    (if (i32.eq (local.get $type) (global.get $MSGPACK_ERROR))
      (then (return (i32.const -1))))

    ;; Primitives (nil, bool, int, float, string)
    (if (i32.and
          (i32.ne (local.get $type) (global.get $MSGPACK_ARRAY))
          (i32.ne (local.get $type) (global.get $MSGPACK_MAP)))
      (then
        (return (call $msgpack_read_primitive (local.get $addr) (local.get $end_addr)))
      )
    )

    ;; Array → materialize as sandscript array
    (if (i32.eq (local.get $type) (global.get $MSGPACK_ARRAY))
      (then
        (local.set $type (call $msgpack_to_array (local.get $addr) (local.get $end_addr) (local.get $parent_data_ptr)))
        (if (i32.eqz (local.get $type))
          (then (return (i32.const -1)))
        )
        (call $pending_push (global.get $TYPE_ARRAY) (i32.const 0) (local.get $type) (i32.const 0))
        (return (i32.const 0))
      )
    )

    ;; Map → materialize as sandscript object
    (if (i32.eq (local.get $type) (global.get $MSGPACK_MAP))
      (then
        (return (call $msgpack_to_object
          (local.get $addr) (local.get $end_addr) (local.get $parent_data_ptr)))
      )
    )

    (i32.const -1)
  )

  ;; Materialize a msgpack map as a sandscript object.
  ;; Pushes the result object to the pending stack.
  ;; Returns: 0 on success, -1 on error OR on pressure refusal (no
  ;; error set, pressure flag set — see the pre-check below).
  ;; $parent_data_ptr is the segment-relative data pointer of the
  ;; OBJ.ARRAYBUFFER owning the msgpack bytes. Array values materialize
  ;; via $msgpack_to_array, whose container ELEMENTS become
  ;; TYPE_MSGPACK_REF values carrying this pointer — it used to be
  ;; passed as 0 here, producing refs the collector cannot forward:
  ;; they read correctly until the first compaction moved the blob,
  ;; then silently dangled (property reads returned undefined).
  (func $msgpack_to_object (param $addr i32) (param $end_addr i32) (param $parent_data_ptr i32) (result i32)
    (local $type i32)
    (local $header_size i32)
    (local $count i32)
    (local $object_pointer i32)
    (local $pos i32)
    (local $i i32)
    (local $key_type i32)
    (local $key_header_size i32)
    (local $key_data_size i32)
    (local $key_offset i32)
    (local $value_next i32)
    (local $val_pointer i32)

    (local.set $type (call $msgpack_peek_type (local.get $addr) (local.get $end_addr)))
    (if (i32.ne (local.get $type) (global.get $MSGPACK_MAP))
      (then
        (call $set_error (global.get $ERR_TYPE_ERROR) (i32.const 0))
        (return (i32.const -1))
      )
    )

    (local.set $header_size (call $msgpack_scratch_header_size))
    (local.set $count (call $msgpack_scratch_count))

    ;; Proportional pressure pre-check: one object with capacity for
    ;; count entries, allocated blindly below. Keys can't exceed the
    ;; declared count (duplicates update in place), so
    ;; object_set_property never hits its grow branch and this single
    ;; check covers the whole call — recursion included, since nested
    ;; maps re-enter this function and check their own counts. On
    ;; refusal: return -1 with NO error set (pressure flag
    ;; distinguishes); the METHOD_MSGPACK_DECODE handler yields
    ;; EXIT_MEMORY_PRESSURE and retries after GC.
    (if (call $check_heap_overflow (call $estimate_object_size (local.get $count)))
      (then (return (i32.const -1))))

    ;; Allocate object with capacity for count entries
    (local.set $object_pointer (call $allocate_object (local.get $count)))

    ;; Iterate map entries
    (local.set $pos (i32.add (local.get $addr) (local.get $header_size)))
    (local.set $i (i32.const 0))
    (block $done
      (loop $loop
        (br_if $done (i32.ge_u (local.get $i) (local.get $count)))

        ;; Read key — must be a string
        (local.set $key_type (call $msgpack_peek_type (local.get $pos) (local.get $end_addr)))
        (if (i32.ne (local.get $key_type) (global.get $MSGPACK_STRING))
          (then
            (call $set_error (global.get $ERR_TYPE_ERROR) (i32.const 0))
            (return (i32.const -1))
          )
        )
        (local.set $key_header_size (call $msgpack_scratch_header_size))
        (local.set $key_data_size (call $msgpack_scratch_data_size))
        (local.set $key_offset
          (call $msgpack_intern_string
            (i32.add (local.get $pos) (local.get $key_header_size))
            (local.get $key_data_size)))
        (local.set $pos (i32.add (local.get $pos) (i32.add (local.get $key_header_size) (local.get $key_data_size))))

        ;; Decode value — push to pending stack, then pop into object
        (local.set $value_next (call $msgpack_skip_value (local.get $pos) (local.get $end_addr)))
        (if (i32.eq (local.get $value_next) (i32.const -1))
          (then (return (i32.const -1)))
        )

        ;; For primitive values, use msgpack_read_primitive
        (local.set $key_type (call $msgpack_peek_type (local.get $pos) (local.get $end_addr)))
        (if (i32.eq (local.get $key_type) (global.get $MSGPACK_ERROR))
          (then (return (i32.const -1))))

        (if (i32.and
              (i32.ne (local.get $key_type) (global.get $MSGPACK_ARRAY))
              (i32.ne (local.get $key_type) (global.get $MSGPACK_MAP)))
          (then
            (if (call $msgpack_read_primitive (local.get $pos) (local.get $end_addr))
              (then (return (i32.const -1)))
            )
          )
          (else
            ;; Container value — for arrays, materialize; for maps, recurse
            (if (i32.eq (local.get $key_type) (global.get $MSGPACK_ARRAY))
              (then
                (local.set $key_data_size (call $msgpack_to_array
                  (local.get $pos) (local.get $end_addr) (local.get $parent_data_ptr)))
                (if (i32.eqz (local.get $key_data_size))
                  (then (return (i32.const -1)))
                )
                (call $pending_push (global.get $TYPE_ARRAY) (i32.const 0) (local.get $key_data_size) (i32.const 0))
              )
              (else
                (if (call $msgpack_to_object
                      (local.get $pos) (local.get $end_addr) (local.get $parent_data_ptr))
                  (then (return (i32.const -1)))
                )
              )
            )
          )
        )

        ;; Value is on the pending stack — pop it and set on the object.
        ;; The object was allocated at capacity = count (see the
        ;; proportional pre-check above) — grow unreachable, status
        ;; droppable.
        (local.set $val_pointer (call $pending_pop))
        (drop (call $object_set_property
          (local.get $object_pointer)
          (local.get $key_offset)
          (call $value_type (local.get $val_pointer))
          (call $value_flags (local.get $val_pointer))
          (call $value_data_lo (local.get $val_pointer))
          (call $value_data_hi (local.get $val_pointer))))

        (local.set $pos (local.get $value_next))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $loop)
      )
    )

    ;; Push the object to pending stack
    (call $pending_push (global.get $TYPE_OBJECT) (i32.const 0) (local.get $object_pointer) (i32.const 0))
    (i32.const 0)
  )

  ;; ==========================================================================
  ;; JSON.parse implementation
  ;; ==========================================================================

  ;; Skip whitespace in JSON input
  ;; Returns: new position
  (func $json_skip_ws (param $pos i32) (param $end i32) (result i32)
    (local $byte i32)

    (block $done
      (loop $skip
        (br_if $done (i32.ge_u (local.get $pos) (local.get $end)))
        (local.set $byte (i32.load8_u (call $abs (local.get $pos))))

        ;; Check for whitespace: space (32), tab (9), newline (10), carriage return (13)
        (br_if $done
          (i32.and
            (i32.ne (local.get $byte) (i32.const 32))
            (i32.and
              (i32.ne (local.get $byte) (i32.const 9))
              (i32.and
                (i32.ne (local.get $byte) (i32.const 10))
                (i32.ne (local.get $byte) (i32.const 13))))))

        (local.set $pos (i32.add (local.get $pos) (i32.const 1)))
        (br $skip)
      )
    )

    (local.get $pos)
  )

  ;; Parse a JSON string value.
  ;; pos: current position (should be at opening quote).
  ;; end: end of input.
  ;; scratch_descriptor: the JSON parse scratch buffer (used to assemble
  ;;   the unescaped string bytes before interning).
  ;; Returns: (new_pos, str_offset). On error, new_pos == -1 and the
  ;; str_offset is undefined.
  ;;
  ;; The scratch buffer is grown on demand. Worst-case unescaped output
  ;; size is the same as the source span (escapes shrink rather than
  ;; grow), so we pre-grow to fit `end - pos` and skip per-byte checks
  ;; in the loop.
  (func $json_parse_string
    (param $pos i32) (param $end i32) (param $scratch_descriptor i32)
    (result i32 i32)
    (local $byte i32)
    (local $out_pos i32)
    (local $abs_out i32)
    (local $str_len i32)
    (local $str_offset i32)
    (local $hex_val i32)
    (local $i i32)
    (local $digit i32)
    (local $data_ptr i32)

    ;; Skip opening quote
    (local.set $pos (i32.add (local.get $pos) (i32.const 1)))

    ;; Pre-grow scratch for the worst case (input span size — escapes can
    ;; only shrink output, never grow it, since the largest source escape
    ;; expansion is \uXXXX → 1–4 UTF-8 bytes from 6 source bytes).
    ;; A refused grow (memory pressure) surfaces as the same (-1, 0)
    ;; error return as a malformed string; the caller distinguishes via
    ;; $memory_pressure_signaled.
    (local.set $data_ptr
      (call $json_buffer_ensure
        (local.get $scratch_descriptor)
        (i32.const 0)
        (i32.sub (local.get $end) (local.get $pos))))
    (if (i32.eq (local.get $data_ptr) (i32.const -1))
      (then (return (i32.const -1) (i32.const 0))))

    ;; Output position is a byte offset within the scratch buffer (starts
    ;; at 0). out_pos tracks bytes written; we'll intern from
    ;; data_ptr[0..out_pos] at the end.
    (local.set $out_pos (i32.const 0))

    (block $done
      (loop $parse
        ;; Check bounds
        (if (i32.ge_u (local.get $pos) (local.get $end))
          (then (return (i32.const -1) (i32.const 0)))
        )

        (local.set $byte (i32.load8_u (call $abs (local.get $pos))))

        ;; Check for closing quote
        (if (i32.eq (local.get $byte) (i32.const 34))
          (then
            (local.set $pos (i32.add (local.get $pos) (i32.const 1)))
            (br $done)
          )
        )

        ;; Check for escape sequence
        (if (i32.eq (local.get $byte) (i32.const 92))  ;; \
          (then
            (local.set $pos (i32.add (local.get $pos) (i32.const 1)))
            (if (i32.ge_u (local.get $pos) (local.get $end))
              (then (return (i32.const -1) (i32.const 0)))
            )

            (local.set $byte (i32.load8_u (call $abs (local.get $pos))))
            (local.set $abs_out (call $abs (i32.add (local.get $data_ptr) (local.get $out_pos))))

            ;; Handle escape sequences
            (if (i32.eq (local.get $byte) (i32.const 34))  ;; \"
              (then
                (i32.store8 (local.get $abs_out) (i32.const 34))
                (local.set $out_pos (i32.add (local.get $out_pos) (i32.const 1)))
              )
              (else
                (if (i32.eq (local.get $byte) (i32.const 92))  ;; \\
                  (then
                    (i32.store8 (local.get $abs_out) (i32.const 92))
                    (local.set $out_pos (i32.add (local.get $out_pos) (i32.const 1)))
                  )
                  (else
                    (if (i32.eq (local.get $byte) (i32.const 110))  ;; \n
                      (then
                        (i32.store8 (local.get $abs_out) (i32.const 10))
                        (local.set $out_pos (i32.add (local.get $out_pos) (i32.const 1)))
                      )
                      (else
                        (if (i32.eq (local.get $byte) (i32.const 114))  ;; \r
                          (then
                            (i32.store8 (local.get $abs_out) (i32.const 13))
                            (local.set $out_pos (i32.add (local.get $out_pos) (i32.const 1)))
                          )
                          (else
                            (if (i32.eq (local.get $byte) (i32.const 116))  ;; \t
                              (then
                                (i32.store8 (local.get $abs_out) (i32.const 9))
                                (local.set $out_pos (i32.add (local.get $out_pos) (i32.const 1)))
                              )
                              (else
                                (if (i32.eq (local.get $byte) (i32.const 47))  ;; \/
                                  (then
                                    (i32.store8 (local.get $abs_out) (i32.const 47))
                                    (local.set $out_pos (i32.add (local.get $out_pos) (i32.const 1)))
                                  )
                                  (else
                                    (if (i32.eq (local.get $byte) (i32.const 98))  ;; \b
                                      (then
                                        (i32.store8 (local.get $abs_out) (i32.const 8))
                                        (local.set $out_pos (i32.add (local.get $out_pos) (i32.const 1)))
                                      )
                                      (else
                                        (if (i32.eq (local.get $byte) (i32.const 102))  ;; \f
                                          (then
                                            (i32.store8 (local.get $abs_out) (i32.const 12))
                                            (local.set $out_pos (i32.add (local.get $out_pos) (i32.const 1)))
                                          )
                                          (else
                                            (if (i32.eq (local.get $byte) (i32.const 117))  ;; \uXXXX
                                              (then
                                                ;; Parse 4 hex digits
                                                (local.set $pos (i32.add (local.get $pos) (i32.const 1)))
                                                (if (i32.gt_u (i32.add (local.get $pos) (i32.const 4)) (local.get $end))
                                                  (then (return (i32.const -1) (i32.const 0)))
                                                )

                                                (local.set $hex_val (i32.const 0))
                                                (local.set $i (i32.const 0))
                                                (block $hex_done
                                                  (loop $hex_loop
                                                    (br_if $hex_done (i32.ge_u (local.get $i) (i32.const 4)))
                                                    (local.set $digit (i32.load8_u (call $abs (i32.add (local.get $pos) (local.get $i)))))

                                                    ;; Convert hex digit
                                                    (if (i32.and (i32.ge_u (local.get $digit) (i32.const 48))
                                                                 (i32.le_u (local.get $digit) (i32.const 57)))
                                                      (then
                                                        (local.set $digit (i32.sub (local.get $digit) (i32.const 48)))
                                                      )
                                                      (else
                                                        (if (i32.and (i32.ge_u (local.get $digit) (i32.const 65))
                                                                     (i32.le_u (local.get $digit) (i32.const 70)))
                                                          (then
                                                            (local.set $digit (i32.sub (local.get $digit) (i32.const 55)))
                                                          )
                                                          (else
                                                            (if (i32.and (i32.ge_u (local.get $digit) (i32.const 97))
                                                                         (i32.le_u (local.get $digit) (i32.const 102)))
                                                              (then
                                                                (local.set $digit (i32.sub (local.get $digit) (i32.const 87)))
                                                              )
                                                              (else
                                                                (return (i32.const -1) (i32.const 0))
                                                              )
                                                            )
                                                          )
                                                        )
                                                      )
                                                    )

                                                    (local.set $hex_val (i32.or
                                                      (i32.shl (local.get $hex_val) (i32.const 4))
                                                      (local.get $digit)))
                                                    (local.set $i (i32.add (local.get $i) (i32.const 1)))
                                                    (br $hex_loop)
                                                  )
                                                )

                                                ;; Encode as UTF-8 at data_ptr + out_pos.
                                                (local.set $out_pos (i32.add (local.get $out_pos)
                                                  (call $utf8_encode_at
                                                    (i32.add (local.get $data_ptr) (local.get $out_pos))
                                                    (local.get $hex_val))))

                                                ;; Adjust pos (we consumed 4 more chars, but loop will add 1)
                                                (local.set $pos (i32.add (local.get $pos) (i32.const 3)))
                                              )
                                              (else
                                                ;; Unknown escape - error
                                                (return (i32.const -1) (i32.const 0))
                                              )
                                            )
                                          )
                                        )
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
          (else
            ;; Regular character
            (i32.store8
              (call $abs (i32.add (local.get $data_ptr) (local.get $out_pos)))
              (local.get $byte))
            (local.set $out_pos (i32.add (local.get $out_pos) (i32.const 1)))
          )
        )

        (local.set $pos (i32.add (local.get $pos) (i32.const 1)))
        (br $parse)
      )
    )

    ;; Intern the string from the scratch buffer's data area.
    (local.set $str_offset
      (call $intern_string (call $abs (local.get $data_ptr)) (local.get $out_pos)))

    ;; Return (new_pos, str_offset).
    (local.get $pos)
    (local.get $str_offset)
  )

  ;; Parse a JSON number.
  ;; pos: current position (at first character of number).
  ;; end: end of input.
  ;; Returns: (new_pos, f64_value). The number's source span is interned
  ;; via intern_string (since parse_float operates on string offsets),
  ;; then parsed via parse_float. No scratch buffer is needed — the
  ;; number's digits already live inside the JSON input string entry,
  ;; which is itself an interned-string offset.
  (func $json_parse_number
    (param $pos i32) (param $end i32)
    (result i32 f64)
    (local $start i32)
    (local $len i32)
    (local $str_offset i32)
    (local $byte i32)

    (local.set $start (local.get $pos))

    ;; Scan the number: optional minus, digits, optional decimal, optional exponent
    (block $done
      (loop $scan
        (br_if $done (i32.ge_u (local.get $pos) (local.get $end)))
        (local.set $byte (i32.load8_u (call $abs (local.get $pos))))

        ;; Continue if digit, minus, plus, dot, e, E
        (br_if $done
          (i32.and
            (i32.and
              (i32.or
                (i32.lt_u (local.get $byte) (i32.const 48))
                (i32.gt_u (local.get $byte) (i32.const 57)))
              (i32.ne (local.get $byte) (i32.const 45)))  ;; -
            (i32.and
              (i32.and
                (i32.ne (local.get $byte) (i32.const 43))  ;; +
                (i32.ne (local.get $byte) (i32.const 46))) ;; .
              (i32.and
                (i32.ne (local.get $byte) (i32.const 101))  ;; e
                (i32.ne (local.get $byte) (i32.const 69)))))) ;; E

        (local.set $pos (i32.add (local.get $pos) (i32.const 1)))
        (br $scan)
      )
    )

    ;; Intern the number's source span directly. The digits already sit
    ;; in the input string (which is itself an interned entry); we
    ;; intern them again as a self-contained entry so parse_float, which
    ;; takes a string-table offset, can read them.
    (local.set $len (i32.sub (local.get $pos) (local.get $start)))
    (local.set $str_offset
      (call $intern_string (call $abs (local.get $start)) (local.get $len)))

    ;; Return (new_pos, parsed_f64).
    (local.get $pos)
    (call $parse_float (local.get $str_offset))
  )

  ;; Push a 16-byte VALUE record onto the parse value stack.
  ;; stack_descriptor: the value stack's Uint8Array descriptor.
  ;; stack_pos: current byte offset within the stack buffer (== bytes
  ;;   used so far, == top-of-stack address).
  ;; type, flags, data_lo, data_hi: the 4 i32 fields of the VALUE record.
  ;; Returns: new stack_pos after the push, or -1 if the stack buffer
  ;; could not grow under memory pressure (nothing is written; the
  ;; caller must bail before any pop or store uses the position).
  (func $json_stack_push
    (param $stack_descriptor i32)
    (param $stack_pos i32)
    (param $type i32)
    (param $flags i32)
    (param $data_lo i32)
    (param $data_hi i32)
    (result i32)

    (local $data_ptr i32)
    (local $absolute_pointer i32)

    ;; Ensure room for one more VALUE_SIZE (16 byte) record.
    (local.set $data_ptr
      (call $json_buffer_ensure
        (local.get $stack_descriptor)
        (local.get $stack_pos)
        (global.get $VALUE_SIZE)))
    (if (i32.eq (local.get $data_ptr) (i32.const -1))
      (then (return (i32.const -1))))
    (local.set $absolute_pointer
      (call $abs (i32.add (local.get $data_ptr) (local.get $stack_pos))))

    (i32.store (local.get $absolute_pointer) (local.get $type))
    (i32.store (i32.add (local.get $absolute_pointer) (i32.const 4)) (local.get $flags))
    (i32.store (i32.add (local.get $absolute_pointer) (i32.const 8)) (local.get $data_lo))
    (i32.store (i32.add (local.get $absolute_pointer) (i32.const 12)) (local.get $data_hi))

    (i32.add (local.get $stack_pos) (global.get $VALUE_SIZE))
  )

  ;; Main JSON.parse entry point.
  ;; str_offset: string table offset of JSON input string.
  ;; Returns: 1 on success (result pushed to pending stack), 0 on error
  ;; OR on memory pressure. The two zero-cases are distinguished by
  ;; $memory_pressure_signaled: pressure paths (buffer growth or tree
  ;; allocation refused) never call set_error; the caller checks the
  ;; flag and yields EXIT_MEMORY_PRESSURE for a post-GC retry instead
  ;; of raising. Pressure can also be flagged on a 1-return (an intern
  ;; failed mid-parse and a sentinel string landed in the tree) — the
  ;; OP_CALL_METHOD pressure rollback discards the result and retries.
  ;;
  ;; Allocates three growable heap buffers:
  ;;   scratch_descriptor — used by $json_parse_string for unescape
  ;;     staging (4 KB initial).
  ;;   stack_descriptor — value stack of 16-byte VALUE records
  ;;     (4 KB initial, ~256 entries before first grow).
  ;;   context_descriptor — context stack of 12-byte records tracking
  ;;     nested array/object state (4 KB initial, ~341 entries).
  ;;
  ;; stack_pos and context_pos are byte offsets within their respective
  ;; buffers (== bytes used == top-of-stack). All three buffers fall out
  ;; of scope on return and become garbage at the next GC cycle.
  (func $json_parse (param $str_offset i32) (result i32)
    (local $str_len i32)
    (local $str_start i32)
    (local $pos i32)
    (local $end i32)
    (local $byte i32)
    (local $scratch_descriptor i32)
    (local $stack_descriptor i32)
    (local $stack_pos i32)
    (local $context_descriptor i32)
    (local $context_pos i32)
    (local $type i32)
    (local $data_lo i32)
    (local $result_type i32)
    (local $result_lo i32)
    (local $result_hi i32)
    (local $array_pointer i32)
    (local $object_pointer i32)
    (local $key_offset i32)
    (local $ctx_type i32)
    (local $ctx_state i32)
    (local $absolute_pointer i32)
    (local $stack_data_ptr i32)
    (local $context_data_ptr i32)
    (local $f64_val f64)
    (local $parsed_str_offset i32)

    ;; Get string info
    (local.set $str_len (i32.load (call $string_id_to_abs (local.get $str_offset))))
    (local.set $str_start (call $string_id_bytes_seg (local.get $str_offset)))
    (local.set $pos (local.get $str_start))
    (local.set $end (i32.add (local.get $str_start) (local.get $str_len)))

    ;; Allocate the three working buffers on the heap. All three become
    ;; garbage when this function returns.
    (local.set $scratch_descriptor (call $json_alloc_buffer (i32.const 4096)))
    (local.set $stack_descriptor (call $json_alloc_buffer (i32.const 4096)))
    (local.set $context_descriptor (call $json_alloc_buffer (i32.const 4096)))
    (local.set $stack_pos (i32.const 0))
    (local.set $context_pos (i32.const 0))

    ;; Parse the JSON value
    (local.set $pos (call $json_skip_ws (local.get $pos) (local.get $end)))

    (if (i32.ge_u (local.get $pos) (local.get $end))
      (then
        (call $set_error (global.get $ERR_JSON_PARSE) (i32.const 0))  ;; 2 = unexpected end
        (return (i32.const 0))
      )
    )

    ;; Main parse loop
    (block $parse_done
      (loop $parse_loop
        (local.set $pos (call $json_skip_ws (local.get $pos) (local.get $end)))

        (if (i32.ge_u (local.get $pos) (local.get $end))
          (then
            ;; End-of-input. Valid only if context stack is empty and
            ;; value stack holds exactly one entry (the final result).
            (if (i32.and
                  (i32.eqz (local.get $context_pos))
                  (i32.eq (local.get $stack_pos) (global.get $VALUE_SIZE)))
              (then (br $parse_done))
              (else
                (call $set_error (global.get $ERR_JSON_PARSE) (i32.const 0))
                (return (i32.const 0))
              )
            )
          )
        )

        (local.set $byte (i32.load8_u (call $abs (local.get $pos))))

        ;; Parse based on first character
        ;; null
        (if (i32.eq (local.get $byte) (i32.const 110))  ;; n
          (then
            (if (i32.le_u (i32.add (local.get $pos) (i32.const 4)) (local.get $end))
              (then
                (if (i32.and
                      (i32.eq (i32.load8_u (call $abs (i32.add (local.get $pos) (i32.const 1)))) (i32.const 117))
                      (i32.and
                        (i32.eq (i32.load8_u (call $abs (i32.add (local.get $pos) (i32.const 2)))) (i32.const 108))
                        (i32.eq (i32.load8_u (call $abs (i32.add (local.get $pos) (i32.const 3)))) (i32.const 108))))
                  (then
                    (local.set $stack_pos (call $json_stack_push
                      (local.get $stack_descriptor) (local.get $stack_pos)
                      (global.get $TYPE_NULL) (i32.const 0) (i32.const 0) (i32.const 0)))
                    (if (i32.eq (local.get $stack_pos) (i32.const -1))
                      (then (return (i32.const 0))))
                    (local.set $pos (i32.add (local.get $pos) (i32.const 4)))
                  )
                  (else
                    (call $set_error (global.get $ERR_JSON_PARSE) (local.get $pos))
                    (return (i32.const 0))
                  )
                )
              )
              (else
                (call $set_error (global.get $ERR_JSON_PARSE) (local.get $pos))
                (return (i32.const 0))
              )
            )
          )
        )

        ;; true
        (if (i32.eq (local.get $byte) (i32.const 116))  ;; t
          (then
            (if (i32.le_u (i32.add (local.get $pos) (i32.const 4)) (local.get $end))
              (then
                (if (i32.and
                      (i32.eq (i32.load8_u (call $abs (i32.add (local.get $pos) (i32.const 1)))) (i32.const 114))
                      (i32.and
                        (i32.eq (i32.load8_u (call $abs (i32.add (local.get $pos) (i32.const 2)))) (i32.const 117))
                        (i32.eq (i32.load8_u (call $abs (i32.add (local.get $pos) (i32.const 3)))) (i32.const 101))))
                  (then
                    (local.set $stack_pos (call $json_stack_push
                      (local.get $stack_descriptor) (local.get $stack_pos)
                      (global.get $TYPE_BOOLEAN) (i32.const 0) (i32.const 1) (i32.const 0)))
                    (if (i32.eq (local.get $stack_pos) (i32.const -1))
                      (then (return (i32.const 0))))
                    (local.set $pos (i32.add (local.get $pos) (i32.const 4)))
                  )
                  (else
                    (call $set_error (global.get $ERR_JSON_PARSE) (local.get $pos))
                    (return (i32.const 0))
                  )
                )
              )
              (else
                (call $set_error (global.get $ERR_JSON_PARSE) (local.get $pos))
                (return (i32.const 0))
              )
            )
          )
        )

        ;; false
        (if (i32.eq (local.get $byte) (i32.const 102))  ;; f
          (then
            (if (i32.le_u (i32.add (local.get $pos) (i32.const 5)) (local.get $end))
              (then
                (if (i32.and
                      (i32.eq (i32.load8_u (call $abs (i32.add (local.get $pos) (i32.const 1)))) (i32.const 97))
                      (i32.and
                        (i32.eq (i32.load8_u (call $abs (i32.add (local.get $pos) (i32.const 2)))) (i32.const 108))
                        (i32.and
                          (i32.eq (i32.load8_u (call $abs (i32.add (local.get $pos) (i32.const 3)))) (i32.const 115))
                          (i32.eq (i32.load8_u (call $abs (i32.add (local.get $pos) (i32.const 4)))) (i32.const 101)))))
                  (then
                    (local.set $stack_pos (call $json_stack_push
                      (local.get $stack_descriptor) (local.get $stack_pos)
                      (global.get $TYPE_BOOLEAN) (i32.const 0) (i32.const 0) (i32.const 0)))
                    (if (i32.eq (local.get $stack_pos) (i32.const -1))
                      (then (return (i32.const 0))))
                    (local.set $pos (i32.add (local.get $pos) (i32.const 5)))
                  )
                  (else
                    (call $set_error (global.get $ERR_JSON_PARSE) (local.get $pos))
                    (return (i32.const 0))
                  )
                )
              )
              (else
                (call $set_error (global.get $ERR_JSON_PARSE) (local.get $pos))
                (return (i32.const 0))
              )
            )
          )
        )

        ;; string
        (if (i32.eq (local.get $byte) (i32.const 34))  ;; "
          (then
            ;; $json_parse_string returns (new_pos, str_offset). The
            ;; results stack-up in declaration order.
            (call $json_parse_string
              (local.get $pos) (local.get $end) (local.get $scratch_descriptor))
            (local.set $parsed_str_offset)
            (local.set $pos)

            (if (i32.eq (local.get $pos) (i32.const -1))
              (then
                ;; -1 with the pressure flag set means the scratch buffer
                ;; could not grow — yield-and-retry, not a parse error.
                (if (global.get $memory_pressure_signaled)
                  (then (return (i32.const 0))))
                (call $set_error (global.get $ERR_JSON_PARSE) (i32.const 0))  ;; 3 = bad string
                (return (i32.const 0))
              )
            )
            (local.set $stack_pos (call $json_stack_push
              (local.get $stack_descriptor) (local.get $stack_pos)
              (global.get $TYPE_STRING) (i32.const 0) (local.get $parsed_str_offset) (i32.const 0)))
            (if (i32.eq (local.get $stack_pos) (i32.const -1))
              (then (return (i32.const 0))))
          )
        )

        ;; number (starts with digit or minus)
        (if (i32.or
              (i32.and
                (i32.ge_u (local.get $byte) (i32.const 48))
                (i32.le_u (local.get $byte) (i32.const 57)))
              (i32.eq (local.get $byte) (i32.const 45)))
          (then
            ;; $json_parse_number returns (new_pos, f64_value).
            (call $json_parse_number (local.get $pos) (local.get $end))
            (local.set $f64_val)
            (local.set $pos)

            ;; Push as float — store f64 in data_lo/data_hi positions of a
            ;; VALUE record. Use the byte-based push helper, which grows
            ;; the stack buffer if needed; then fix up the f64 store by
            ;; writing the 8 bytes directly via f64.store at the entry's
            ;; data_lo offset.
            (local.set $stack_pos (call $json_stack_push
              (local.get $stack_descriptor) (local.get $stack_pos)
              (global.get $TYPE_FLOAT) (i32.const 0) (i32.const 0) (i32.const 0)))
            (if (i32.eq (local.get $stack_pos) (i32.const -1))
              (then (return (i32.const 0))))
            ;; Overwrite the data_lo/data_hi pair with the f64. The
            ;; descriptor pointer is stable; re-fetch data_ptr in case
            ;; the push triggered a grow.
            (local.set $stack_data_ptr (call $json_buffer_data_ptr (local.get $stack_descriptor)))
            (f64.store
              (call $abs (i32.add
                (i32.add (local.get $stack_data_ptr)
                  (i32.sub (local.get $stack_pos) (global.get $VALUE_SIZE)))
                (i32.const 8)))
              (local.get $f64_val))
          )
        )

        ;; array start
        (if (i32.eq (local.get $byte) (i32.const 91))  ;; [
          (then
            ;; Allocate array with initial capacity 4 — $allocate_array
            ;; bumps the heap blindly, so pressure-check it here.
            (if (call $check_heap_overflow (call $estimate_array_size (i32.const 4)))
              (then (return (i32.const 0))))
            (local.set $array_pointer (call $allocate_array (i32.const 4)))
            ;; Reset length to 0 (allocate_array sets length = capacity for map operations)
            (i32.store (call $abs (i32.add (local.get $array_pointer) (i32.const 8))) (i32.const 0))
            ;; Push array to value stack
            (local.set $stack_pos (call $json_stack_push
              (local.get $stack_descriptor) (local.get $stack_pos)
              (global.get $TYPE_ARRAY) (i32.const 0) (local.get $array_pointer) (i32.const 0)))
            (if (i32.eq (local.get $stack_pos) (i32.const -1))
              (then (return (i32.const 0))))

            ;; Push context entry: 12 bytes [type=1 (array), ptr, value-stack base].
            ;; The base distinguishes an empty nested container from parent values
            ;; that happen to sit below it on the shared value stack.
            (if (i32.eq
                  (call $json_buffer_ensure
                    (local.get $context_descriptor) (local.get $context_pos) (i32.const 12))
                  (i32.const -1))
              (then (return (i32.const 0))))
            (local.set $context_data_ptr (call $json_buffer_data_ptr (local.get $context_descriptor)))
            (local.set $absolute_pointer
              (call $abs (i32.add (local.get $context_data_ptr) (local.get $context_pos))))
            (i32.store (local.get $absolute_pointer) (i32.const 1))  ;; type = array
            (i32.store (i32.add (local.get $absolute_pointer) (i32.const 4)) (local.get $array_pointer))
            (i32.store (i32.add (local.get $absolute_pointer) (i32.const 8)) (local.get $stack_pos))
            (local.set $context_pos (i32.add (local.get $context_pos) (i32.const 12)))
            (local.set $pos (i32.add (local.get $pos) (i32.const 1)))
          )
        )

        ;; array end
        (if (i32.eq (local.get $byte) (i32.const 93))  ;; ]
          (then
            ;; Check context is non-empty.
            (if (i32.eqz (local.get $context_pos))
              (then
                (call $set_error (global.get $ERR_JSON_PARSE) (local.get $pos))
                (return (i32.const 0))
              )
            )

            ;; Read top context entry (no pop yet).
            (local.set $context_data_ptr (call $json_buffer_data_ptr (local.get $context_descriptor)))
            (local.set $absolute_pointer
              (call $abs (i32.add (local.get $context_data_ptr)
                (i32.sub (local.get $context_pos) (i32.const 12)))))
            (local.set $ctx_type (i32.load (local.get $absolute_pointer)))
            (local.set $array_pointer
              (i32.load (i32.add (local.get $absolute_pointer) (i32.const 4))))
            (local.set $ctx_state
              (i32.load (i32.add (local.get $absolute_pointer) (i32.const 8))))

            ;; A pending value exists only above this array's own stack base.
            (if (i32.gt_u (local.get $stack_pos) (local.get $ctx_state))
              (then
                ;; Pop value from stack.
                (local.set $stack_pos (i32.sub (local.get $stack_pos) (global.get $VALUE_SIZE)))
                (local.set $stack_data_ptr (call $json_buffer_data_ptr (local.get $stack_descriptor)))
                (local.set $absolute_pointer
                  (call $abs (i32.add (local.get $stack_data_ptr) (local.get $stack_pos))))
                (local.set $result_type (i32.load (local.get $absolute_pointer)))
                (local.set $result_lo (i32.load (i32.add (local.get $absolute_pointer) (i32.const 8))))
                (local.set $result_hi (i32.load (i32.add (local.get $absolute_pointer) (i32.const 12))))
                ;; Add to array. The grow branch of $array_push_value
                ;; allocates blindly — pressure-check its worst case.
                (if (call $check_heap_overflow (call $estimate_array_grow_size
                      (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 12))))))
                  (then (return (i32.const 0))))
                ;; Status droppable: grow pre-checked just above.
                (drop (call $array_push_value
                  (local.get $array_pointer)
                  (local.get $result_type)
                  (i32.const 0)
                  (local.get $result_lo)
                  (local.get $result_hi)))
              )
            )

            ;; Pop context (12 bytes).
            (local.set $context_pos (i32.sub (local.get $context_pos) (i32.const 12)))
            (local.set $pos (i32.add (local.get $pos) (i32.const 1)))
          )
        )

        ;; object start
        (if (i32.eq (local.get $byte) (i32.const 123))  ;; {
          (then
            ;; Allocate object — $allocate_object bumps the heap blindly,
            ;; so pressure-check it here.
            (if (call $check_heap_overflow (call $estimate_object_size (i32.const 4)))
              (then (return (i32.const 0))))
            (local.set $object_pointer (call $allocate_object (i32.const 4)))
            ;; Push object to value stack
            (local.set $stack_pos (call $json_stack_push
              (local.get $stack_descriptor) (local.get $stack_pos)
              (global.get $TYPE_OBJECT) (i32.const 0) (local.get $object_pointer) (i32.const 0)))
            (if (i32.eq (local.get $stack_pos) (i32.const -1))
              (then (return (i32.const 0))))

            ;; Push context entry: 12 bytes [type=2 (object), ptr, value-stack base].
            (if (i32.eq
                  (call $json_buffer_ensure
                    (local.get $context_descriptor) (local.get $context_pos) (i32.const 12))
                  (i32.const -1))
              (then (return (i32.const 0))))
            (local.set $context_data_ptr (call $json_buffer_data_ptr (local.get $context_descriptor)))
            (local.set $absolute_pointer
              (call $abs (i32.add (local.get $context_data_ptr) (local.get $context_pos))))
            (i32.store (local.get $absolute_pointer) (i32.const 2))  ;; type = object
            (i32.store (i32.add (local.get $absolute_pointer) (i32.const 4)) (local.get $object_pointer))
            (i32.store (i32.add (local.get $absolute_pointer) (i32.const 8)) (local.get $stack_pos))
            (local.set $context_pos (i32.add (local.get $context_pos) (i32.const 12)))
            (local.set $pos (i32.add (local.get $pos) (i32.const 1)))
          )
        )

        ;; object end
        (if (i32.eq (local.get $byte) (i32.const 125))  ;; }
          (then
            ;; Check context is non-empty.
            (if (i32.eqz (local.get $context_pos))
              (then
                (call $set_error (global.get $ERR_JSON_PARSE) (local.get $pos))
                (return (i32.const 0))
              )
            )

            ;; Read top context entry.
            (local.set $context_data_ptr (call $json_buffer_data_ptr (local.get $context_descriptor)))
            (local.set $absolute_pointer
              (call $abs (i32.add (local.get $context_data_ptr)
                (i32.sub (local.get $context_pos) (i32.const 12)))))
            (local.set $ctx_type (i32.load (local.get $absolute_pointer)))
            (local.set $object_pointer
              (i32.load (i32.add (local.get $absolute_pointer) (i32.const 4))))
            (local.set $ctx_state
              (i32.load (i32.add (local.get $absolute_pointer) (i32.const 8))))

            ;; A pending key:value pair exists only above this object's stack base.
            (if (i32.gt_u (local.get $stack_pos) (local.get $ctx_state))
              (then
                ;; Pop value from stack.
                (local.set $stack_pos (i32.sub (local.get $stack_pos) (global.get $VALUE_SIZE)))
                (local.set $stack_data_ptr (call $json_buffer_data_ptr (local.get $stack_descriptor)))
                (local.set $absolute_pointer
                  (call $abs (i32.add (local.get $stack_data_ptr) (local.get $stack_pos))))
                (local.set $result_type (i32.load (local.get $absolute_pointer)))
                (local.set $result_lo (i32.load (i32.add (local.get $absolute_pointer) (i32.const 8))))
                (local.set $result_hi (i32.load (i32.add (local.get $absolute_pointer) (i32.const 12))))
                ;; Pop key from stack.
                (local.set $stack_pos (i32.sub (local.get $stack_pos) (global.get $VALUE_SIZE)))
                (local.set $absolute_pointer
                  (call $abs (i32.add (local.get $stack_data_ptr) (local.get $stack_pos))))
                (local.set $key_offset
                  (i32.load (i32.add (local.get $absolute_pointer) (i32.const 8))))
                ;; Add property. The grow branch of $object_set_property
                ;; allocates blindly — pressure-check its worst case.
                (if (call $check_heap_overflow (call $estimate_object_grow_size
                      (i32.load (call $abs (i32.add (local.get $object_pointer) (i32.const 16))))))
                  (then (return (i32.const 0))))
                (drop (call $object_set_property
                  (local.get $object_pointer)
                  (local.get $key_offset)
                  (local.get $result_type)
                  (i32.const 0)
                  (local.get $result_lo)
                  (local.get $result_hi)))
              )
            )

            ;; Pop context.
            (local.set $context_pos (i32.sub (local.get $context_pos) (i32.const 12)))
            (local.set $pos (i32.add (local.get $pos) (i32.const 1)))
          )
        )

        ;; comma - handle adding value to container
        (if (i32.eq (local.get $byte) (i32.const 44))  ;; ,
          (then
            (if (i32.eqz (local.get $context_pos))
              (then
                (call $set_error (global.get $ERR_JSON_PARSE) (local.get $pos))
                (return (i32.const 0))
              )
            )

            ;; Read top context entry.
            (local.set $context_data_ptr (call $json_buffer_data_ptr (local.get $context_descriptor)))
            (local.set $absolute_pointer
              (call $abs (i32.add (local.get $context_data_ptr)
                (i32.sub (local.get $context_pos) (i32.const 12)))))
            (local.set $ctx_type (i32.load (local.get $absolute_pointer)))
            (local.set $array_pointer
              (i32.load (i32.add (local.get $absolute_pointer) (i32.const 4))))

            ;; Pop value from stack.
            (local.set $stack_pos (i32.sub (local.get $stack_pos) (global.get $VALUE_SIZE)))
            (local.set $stack_data_ptr (call $json_buffer_data_ptr (local.get $stack_descriptor)))
            (local.set $absolute_pointer
              (call $abs (i32.add (local.get $stack_data_ptr) (local.get $stack_pos))))
            (local.set $result_type (i32.load (local.get $absolute_pointer)))
            (local.set $result_lo (i32.load (i32.add (local.get $absolute_pointer) (i32.const 8))))
            (local.set $result_hi (i32.load (i32.add (local.get $absolute_pointer) (i32.const 12))))

            (if (i32.eq (local.get $ctx_type) (i32.const 1))  ;; array
              (then
                ;; Pressure-check the blind grow branch (see array-end).
                (if (call $check_heap_overflow (call $estimate_array_grow_size
                      (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 12))))))
                  (then (return (i32.const 0))))
                ;; Status droppable: grow pre-checked just above.
                (drop (call $array_push_value
                  (local.get $array_pointer)
                  (local.get $result_type)
                  (i32.const 0)
                  (local.get $result_lo)
                  (local.get $result_hi)))
              )
              (else
                ;; Object - pop key from stack first.
                (local.set $stack_pos (i32.sub (local.get $stack_pos) (global.get $VALUE_SIZE)))
                (local.set $stack_data_ptr (call $json_buffer_data_ptr (local.get $stack_descriptor)))
                (local.set $absolute_pointer
                  (call $abs (i32.add (local.get $stack_data_ptr) (local.get $stack_pos))))
                (local.set $key_offset
                  (i32.load (i32.add (local.get $absolute_pointer) (i32.const 8))))
                ;; Pressure-check the blind grow branch (see object-end).
                (if (call $check_heap_overflow (call $estimate_object_grow_size
                      (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 16))))))
                  (then (return (i32.const 0))))
                (drop (call $object_set_property
                  (local.get $array_pointer)  ;; misnomer — actually the object pointer
                  (local.get $key_offset)
                  (local.get $result_type)
                  (i32.const 0)
                  (local.get $result_lo)
                  (local.get $result_hi)))
              )
            )

            (local.set $pos (i32.add (local.get $pos) (i32.const 1)))
          )
        )

        ;; colon - just skip, key is already on stack
        (if (i32.eq (local.get $byte) (i32.const 58))  ;; :
          (then
            (local.set $pos (i32.add (local.get $pos) (i32.const 1)))
          )
        )

        (br $parse_loop)
      )
    )

    ;; Handle final value if in container — drain remaining contexts.
    (block $final_done
      (loop $final_loop
        (br_if $final_done (i32.eqz (local.get $context_pos)))

        ;; Read top context.
        (local.set $context_pos (i32.sub (local.get $context_pos) (i32.const 12)))
        (local.set $context_data_ptr (call $json_buffer_data_ptr (local.get $context_descriptor)))
        (local.set $absolute_pointer
          (call $abs (i32.add (local.get $context_data_ptr) (local.get $context_pos))))
        (local.set $ctx_type (i32.load (local.get $absolute_pointer)))
        (local.set $array_pointer
          (i32.load (i32.add (local.get $absolute_pointer) (i32.const 4))))

        ;; Pop value from stack.
        (local.set $stack_pos (i32.sub (local.get $stack_pos) (global.get $VALUE_SIZE)))
        (local.set $stack_data_ptr (call $json_buffer_data_ptr (local.get $stack_descriptor)))
        (local.set $absolute_pointer
          (call $abs (i32.add (local.get $stack_data_ptr) (local.get $stack_pos))))
        (local.set $result_type (i32.load (local.get $absolute_pointer)))
        (local.set $result_lo (i32.load (i32.add (local.get $absolute_pointer) (i32.const 8))))
        (local.set $result_hi (i32.load (i32.add (local.get $absolute_pointer) (i32.const 12))))

        (if (i32.eq (local.get $ctx_type) (i32.const 1))  ;; array
          (then
            ;; Pressure-check the blind grow branch (see array-end).
            (if (call $check_heap_overflow (call $estimate_array_grow_size
                  (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 12))))))
              (then (return (i32.const 0))))
            ;; Status droppable: grow pre-checked just above.
            (drop (call $array_push_value
              (local.get $array_pointer)
              (local.get $result_type)
              (i32.const 0)
              (local.get $result_lo)
              (local.get $result_hi)))
          )
          (else
            ;; Object — pop key.
            (local.set $stack_pos (i32.sub (local.get $stack_pos) (global.get $VALUE_SIZE)))
            (local.set $stack_data_ptr (call $json_buffer_data_ptr (local.get $stack_descriptor)))
            (local.set $absolute_pointer
              (call $abs (i32.add (local.get $stack_data_ptr) (local.get $stack_pos))))
            (local.set $key_offset
              (i32.load (i32.add (local.get $absolute_pointer) (i32.const 8))))
            ;; Pressure-check the blind grow branch (see object-end).
            (if (call $check_heap_overflow (call $estimate_object_grow_size
                  (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 16))))))
              (then (return (i32.const 0))))
            (drop (call $object_set_property
              (local.get $array_pointer)
              (local.get $key_offset)
              (local.get $result_type)
              (i32.const 0)
              (local.get $result_lo)
              (local.get $result_hi)))
          )
        )

        (br $final_loop)
      )
    )

    ;; Pop the final result from the value stack and push it onto the
    ;; pending stack.
    (local.set $stack_pos (i32.sub (local.get $stack_pos) (global.get $VALUE_SIZE)))
    (local.set $stack_data_ptr (call $json_buffer_data_ptr (local.get $stack_descriptor)))
    (local.set $absolute_pointer
      (call $abs (i32.add (local.get $stack_data_ptr) (local.get $stack_pos))))

    (call $pending_push
      (i32.load (local.get $absolute_pointer))
      (i32.load (i32.add (local.get $absolute_pointer) (i32.const 4)))
      (i32.load (i32.add (local.get $absolute_pointer) (i32.const 8)))
      (i32.load (i32.add (local.get $absolute_pointer) (i32.const 12))))

    (i32.const 1)
  )

  ;; Helper: returns non-zero iff the array has ARRAY_FLAG_FROZEN set.
  ;; Callers should throw TypeError with MSG_FROZEN_OBJECT when true.
  (func $array_is_frozen (param $array_pointer i32) (result i32)
    (i32.and
      (i32.load (call $abs (i32.add (local.get $array_pointer) (global.get $ARRAY_FLAGS_OFFSET))))
      (global.get $ARRAY_FLAG_FROZEN))
  )

  ;; Helper: push a value onto an array (extracted from METHOD_PUSH)
  ;; estimate_array_grow_size(current_capacity) → bytes
  ;; Worst-case heap consumption of the grow branch of $array_push_value:
  ;; allocates a new data block at max(current_capacity * 2, 4) elements,
  ;; sized GC_HEADER_SIZE (8) + new_cap * VALUE_SIZE (16), 16-aligned.
  ;; If capacity is sufficient (no grow), no allocation happens — opcode
  ;; handlers should still pre-check this as the worst case.
  (func $estimate_array_grow_size (param $current_capacity i32) (result i32)
    (local $new_cap i32)
    (local.set $new_cap (i32.shl (local.get $current_capacity) (i32.const 1)))
    (if (i32.eqz (local.get $new_cap))
      (then (local.set $new_cap (i32.const 4))))
    (i32.and
      (i32.add
        (i32.add
          (global.get $GC_HEADER_SIZE)
          (i32.mul (local.get $new_cap) (global.get $VALUE_SIZE)))
        (i32.const 15))
      (i32.const -16))
  )

  ;; estimate_array_push_budget(current_capacity, needed_length) → bytes
  ;; Worst-case heap consumption of appending until capacity ≥ needed:
  ;; the doubling chain starts from the CURRENT capacity, so it
  ;; allocates blocks of 2c, 4c, … F elements — a geometric sum
  ;; bounded by 2 × the final block. Multi-element appends (push/
  ;; unshift/flatten with argc > 1) chain at most a few doublings;
  ;; single-element appends do exactly one.
  ;;
  ;; Do NOT use $estimate_collection_build_size for this: it models
  ;; the chain from capacity 4 (≈ 4 × needed REGARDLESS of what is
  ;; already allocated). A push onto a 16384-element array on a 2MB
  ;; vat charged ~2MB against ~1.8MB free and refused FOREVER — gc
  ;; reclaimed nothing (the array is live), so the retry loop never
  ;; progressed (found 2026-07-11 via the intern-saturation churn
  ;; test; the actual grow needs 512KB).
  (func $estimate_array_push_budget (param $current_capacity i32) (param $needed i32) (result i32)
    (local $final_cap i32)
    (local.set $final_cap (local.get $current_capacity))
    (if (i32.lt_u (local.get $final_cap) (i32.const 4))
      (then (local.set $final_cap (i32.const 4))))
    (block $done
      (loop $grow
        (br_if $done (i32.ge_u (local.get $final_cap) (local.get $needed)))
        (local.set $final_cap (i32.shl (local.get $final_cap) (i32.const 1)))
        (br $grow)))
    ;; Chain total < 2 × final block, plus per-step GC headers and
    ;; alignment slack (≤ 30 steps × 16).
    (i32.add
      (i32.const 480)
      (i32.shl
        (i32.add
          (global.get $GC_HEADER_SIZE)
          (i32.mul (local.get $final_cap) (global.get $VALUE_SIZE)))
        (i32.const 1)))
  )

  ;; Effective start index for ascending Array indexOf/includes searches
  ;; with an optional fromIndex argument (array semantics: negative counts
  ;; back from length, clamped to 0; non-numeric/NaN → 0). May return
  ;; length itself — the caller's ascending loop then exits immediately.
  (func $search_from_index (param $value_pointer i32) (param $length i32) (result i32)
    (local $from i32)
    (if (i32.eqz (call $value_is_numeric (local.get $value_pointer)))
      (then (return (i32.const 0))))
    (local.set $from (i32.trunc_sat_f64_s (call $value_to_f64 (local.get $value_pointer))))
    (if (i32.lt_s (local.get $from) (i32.const 0))
      (then
        (local.set $from (i32.add (local.get $from) (local.get $length)))
        (if (i32.lt_s (local.get $from) (i32.const 0))
          (then (return (i32.const 0))))))
    (if (i32.gt_s (local.get $from) (local.get $length))
      (then (return (local.get $length))))
    (local.get $from)
  )

  ;; Effective start index for descending Array lastIndexOf searches with
  ;; an optional fromIndex argument (array semantics: negative counts back
  ;; from length, clamped above to length-1; non-numeric/NaN → 0). Returns
  ;; -1 when the search space is empty — the caller's descending loop then
  ;; exits immediately.
  (func $search_last_index (param $value_pointer i32) (param $length i32) (result i32)
    (local $from i32)
    (if (i32.eqz (call $value_is_numeric (local.get $value_pointer)))
      (then (return (i32.const 0))))
    (local.set $from (i32.trunc_sat_f64_s (call $value_to_f64 (local.get $value_pointer))))
    (if (i32.lt_s (local.get $from) (i32.const 0))
      (then (local.set $from (i32.add (local.get $from) (local.get $length)))))
    (if (i32.ge_s (local.get $from) (local.get $length))
      (then (local.set $from (i32.sub (local.get $length) (i32.const 1)))))
    (if (i32.lt_s (local.get $from) (i32.const 0))
      (then (return (i32.const -1))))
    (local.get $from)
  )

  ;; Effective byte position for String position arguments (string
  ;; semantics: clamp to [0, length] with NO negative wrap; non-numeric/
  ;; NaN → 0). Matches the convention String.indexOf already used.
  (func $clamp_position (param $value_pointer i32) (param $length i32) (result i32)
    (local $position i32)
    (if (i32.eqz (call $value_is_numeric (local.get $value_pointer)))
      (then (return (i32.const 0))))
    (local.set $position (i32.trunc_sat_f64_s (call $value_to_f64 (local.get $value_pointer))))
    (if (i32.lt_s (local.get $position) (i32.const 0))
      (then (return (i32.const 0))))
    (if (i32.gt_s (local.get $position) (local.get $length))
      (then (return (local.get $length))))
    (local.get $position)
  )

  ;; Append one value, growing capacity if needed.
  ;;
  ;; Returns 0 on success; 1 when the grow's doubled reallocation would
  ;; overflow the heap — $check_heap_overflow has signaled pressure and
  ;; NOTHING was mutated. The caller must then restore whatever
  ;; operands it consumed and yield EXIT_MEMORY_PRESSURE, or propagate
  ;; the status to a handler. WAT requires each status result to be
  ;; consumed, so every call site handles it or explicitly documents a
  ;; pre-budgeted carve. A grow can span many elements and must request
  ;; collection before reaching the dispatcher's hard heap/code collision
  ;; check.



  (func $array_push_value
    (param $array_pointer i32)
    (param $val_type i32)
    (param $val_flags i32)
    (param $val_lo i32)
    (param $val_hi i32)
    (result i32)

    (local $arr_len i32)
    (local $arr_cap i32)
    (local $data_pointer i32)
    (local $new_cap i32)
    (local $new_data i32)
    (local $new_size i32)
    (local $heap_pointer i32)
    (local $i i32)
    (local $element_pointer i32)
    (local $dest i32)

    ;; Array layout: [GC:8][length:4][capacity:4][data_pointer:4]
    (local.set $arr_len (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 8)))))
    (local.set $arr_cap (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 12)))))
    (local.set $data_pointer (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 16)))))

    ;; Check if we need to grow
    (if (i32.ge_u (local.get $arr_len) (local.get $arr_cap))
      (then
        ;; Double capacity (minimum 4)
        (local.set $new_cap (i32.shl (local.get $arr_cap) (i32.const 1)))
        (if (i32.eqz (local.get $new_cap))
          (then (local.set $new_cap (i32.const 4)))
        )

        ;; Allocate new data block
        (local.set $heap_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))
        (local.set $new_data (local.get $heap_pointer))
        (local.set $new_size (i32.add (global.get $GC_HEADER_SIZE)
          (i32.mul (local.get $new_cap) (global.get $VALUE_SIZE))))
        ;; 16-align so downstream heap allocations stay on the shared grid.
        ;; GC_HEADER_SIZE (8) + k * VALUE_SIZE (16) is always 8 mod 16; round
        ;; up to 16 to avoid leaving the heap pointer misaligned.
        (local.set $new_size (i32.and
          (i32.add (local.get $new_size) (i32.const 15))
          (i32.const -16)))

        ;; Pressure gate — BEFORE any store. A refused grow leaves the
        ;; array, the heap pointer, and the value untouched.
        (if (call $check_heap_overflow (local.get $new_size))
          (then (return (i32.const 1))))

        ;; GC header — stores aligned size for the heap walker.
        (i32.store (call $abs (local.get $new_data))
          (i32.or (local.get $new_size) (i32.shl (global.get $OBJ_ARRAY_DATA) (i32.const 24))))
        (i32.store (call $abs (i32.add (local.get $new_data) (i32.const 4))) (i32.const 0))

        ;; Update heap pointer by aligned size.
        (call $write_state (global.get $STATE_HEAP_POINTER)
          (i32.add (local.get $new_data) (local.get $new_size)))

        ;; Copy existing elements
        (local.set $i (i32.const 0))
        (block $copy_done
          (loop $copy_loop
            (br_if $copy_done (i32.ge_u (local.get $i) (local.get $arr_len)))

            (local.set $element_pointer (i32.add
              (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
              (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
            (local.set $dest (i32.add
              (i32.add (local.get $new_data) (global.get $GC_HEADER_SIZE))
              (i32.mul (local.get $i) (global.get $VALUE_SIZE))))

            ;; Copy 16 bytes
            (i32.store (call $abs (local.get $dest))
              (i32.load (call $abs (local.get $element_pointer))))
            (i32.store (call $abs (i32.add (local.get $dest) (i32.const 4)))
              (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 4)))))
            (i32.store (call $abs (i32.add (local.get $dest) (i32.const 8)))
              (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 8)))))
            (i32.store (call $abs (i32.add (local.get $dest) (i32.const 12)))
              (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 12)))))

            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $copy_loop)
          )
        )

        ;; Update array header
        (i32.store (call $abs (i32.add (local.get $array_pointer) (i32.const 12))) (local.get $new_cap))
        (i32.store (call $abs (i32.add (local.get $array_pointer) (i32.const 16))) (local.get $new_data))
        (local.set $data_pointer (local.get $new_data))
      )
    )

    ;; Add new element at position arr_len
    (local.set $element_pointer (i32.add
      (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
      (i32.mul (local.get $arr_len) (global.get $VALUE_SIZE))))

    (i32.store (call $abs (local.get $element_pointer)) (local.get $val_type))
    (i32.store (call $abs (i32.add (local.get $element_pointer) (i32.const 4))) (local.get $val_flags))
    (i32.store (call $abs (i32.add (local.get $element_pointer) (i32.const 8))) (local.get $val_lo))
    (i32.store (call $abs (i32.add (local.get $element_pointer) (i32.const 12))) (local.get $val_hi))

    ;; Increment length
    (i32.store (call $abs (i32.add (local.get $array_pointer) (i32.const 8)))
      (i32.add (local.get $arr_len) (i32.const 1)))
    (i32.const 0)
  )

  ;; Lexicographic byte comparison of two TYPE_STRING values. $a/$b are
  ;; value pointers (as read by $value_type/$value_data_lo), not string
  ;; ids directly. Returns a signed delta: <0 if a<b, 0 if equal, >0 if
  ;; a>b — same convention as $bigint_compare/$rational_compare, so
  ;; callers can i32.lt_s/gt_s/le_s/ge_s the result directly.
  (func $string_compare (param $a i32) (param $b i32) (result i32)
    (local $a_str i32)
    (local $b_str i32)
    (local $a_len i32)
    (local $b_len i32)
    (local $min_len i32)
    (local $i i32)
    (local $a_byte i32)
    (local $b_byte i32)

    (local.set $a_str (call $string_id_to_seg (call $value_data_lo (local.get $a))))
    (local.set $b_str (call $string_id_to_seg (call $value_data_lo (local.get $b))))
    (local.set $a_len (i32.load (call $abs (local.get $a_str))))
    (local.set $b_len (i32.load (call $abs (local.get $b_str))))
    (local.set $min_len (local.get $a_len))
    (if (i32.lt_u (local.get $b_len) (local.get $min_len))
      (then (local.set $min_len (local.get $b_len))))
    (local.set $i (i32.const 0))
    (block $cmp_done
      (loop $cmp_loop
        (br_if $cmp_done (i32.ge_u (local.get $i) (local.get $min_len)))
        (local.set $a_byte (i32.load8_u (call $abs (i32.add
          (i32.add (local.get $a_str) (i32.const 4)) (local.get $i)))))
        (local.set $b_byte (i32.load8_u (call $abs (i32.add
          (i32.add (local.get $b_str) (i32.const 4)) (local.get $i)))))
        (if (i32.ne (local.get $a_byte) (local.get $b_byte))
          (then
            (return (i32.sub (local.get $a_byte) (local.get $b_byte)))
          )
        )
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $cmp_loop)
      )
    )
    (i32.sub (local.get $a_len) (local.get $b_len))
  )

  (func $default_sort_compare (param $a i32) (param $b i32) (result f64)
    (local $a_type i32)
    (local $b_type i32)
    (local $a_f64 f64)
    (local $b_f64 f64)

    (local.set $a_type (call $value_type (local.get $a)))
    (local.set $b_type (call $value_type (local.get $b)))

    ;; Both strings: lexicographic comparison
    (if (i32.and
          (i32.eq (local.get $a_type) (global.get $TYPE_STRING))
          (i32.eq (local.get $b_type) (global.get $TYPE_STRING)))
      (then
        (return (f64.convert_i32_s (call $string_compare (local.get $a) (local.get $b))))
      )
    )

    ;; Numeric comparison
    (local.set $a_f64 (call $value_to_f64 (local.get $a)))
    (local.set $b_f64 (call $value_to_f64 (local.get $b)))
    (f64.sub (local.get $a_f64) (local.get $b_f64))
  )

  ;; Flatten $source into $target up to $depth levels.
  ;;
  ;; Returns 0 on success; 1 when a push's grow was refused under
  ;; pressure (see $array_push_value). A pressure return may leave a
  ;; PARTIAL flatten in $target — safe only for callers that discard
  ;; the target on retry ($array_flat_method re-allocates it fresh each
  ;; dispatch) or that pre-budgeted the whole flatten so the status
  ;; cannot fire (the flatMap RETURN continuation).
  (func $flat_into
    (param $source i32)
    (param $target i32)
    (param $depth i32)
    (result i32)

    (local $len i32)
    (local $data i32)
    (local $i i32)
    (local $elem i32)
    (local $elem_type i32)
    (local $elem_lo i32)
    (local $sub_len i32)
    (local $sub_data i32)
    (local $k i32)
    (local $sub_elem i32)

    (local.set $len (i32.load (call $abs (i32.add (local.get $source) (i32.const 8)))))
    (local.set $data (i32.load (call $abs (i32.add (local.get $source) (i32.const 16)))))
    (local.set $i (i32.const 0))
    (block $done
      (loop $loop
        (br_if $done (i32.ge_u (local.get $i) (local.get $len)))
        (local.set $elem (i32.add
          (i32.add (local.get $data) (global.get $GC_HEADER_SIZE))
          (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
        (local.set $elem_type (i32.load (call $abs (local.get $elem))))
        (local.set $elem_lo (i32.load (call $abs (i32.add (local.get $elem) (i32.const 8)))))

        (if (i32.and
              (i32.eq (local.get $elem_type) (global.get $TYPE_ARRAY))
              (i32.gt_s (local.get $depth) (i32.const 0)))
          (then
            (if (call $flat_into (local.get $elem_lo) (local.get $target)
                  (i32.sub (local.get $depth) (i32.const 1)))
              (then (return (i32.const 1))))
          )
          (else
            (if (call $array_push_value
                  (local.get $target)
                  (i32.load (call $abs (local.get $elem)))
                  (i32.load (call $abs (i32.add (local.get $elem) (i32.const 4))))
                  (i32.load (call $abs (i32.add (local.get $elem) (i32.const 8))))
                  (i32.load (call $abs (i32.add (local.get $elem) (i32.const 12)))))
              (then (return (i32.const 1))))
          )
        )
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $loop)
      )
    )
    (i32.const 0)
  )

  ;; estimate_object_size(capacity) → bytes
  ;; Worst-case heap consumption of $allocate_object(capacity):
  ;;   OBJECT_HEADER_SIZE (32) + entries_aligned
  ;; where entries_raw = GC_HEADER_SIZE (8) + capacity * ENTRY_SIZE (20),
  ;; entries_aligned = (entries_raw + 15) & ~15.
  (func $estimate_object_size (param $capacity i32) (result i32)
    (i32.add
      (global.get $OBJECT_HEADER_SIZE)
      (i32.and
        (i32.add
          (i32.add
            (global.get $GC_HEADER_SIZE)
            (i32.mul (local.get $capacity) (global.get $ENTRY_SIZE)))
          (i32.const 15))
        (i32.const -16)))
  )

  ;; Helper: allocate an empty object with given capacity
  ;; Object layout: [GC:8][prototype:4][count:4][capacity:4][entries:4] = 24 bytes
  (func $allocate_object (param $capacity i32) (result i32)
    (local $heap_pointer i32)
    (local $object_pointer i32)
    (local $entries_pointer i32)
    (local $entries_size i32)
    (local $entries_aligned i32)

    (local.set $heap_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))

    ;; Allocate object header.
    ;; NOTE ON ALIGNMENT: Object header size is 28 bytes (not 16-aligned), but
    ;; the entries block ALWAYS follows immediately after, so misalignment
    ;; here is contained. The entries block itself MUST round its size up to
    ;; a 16-byte boundary so that downstream heap allocations (BigInt,
    ;; Rational, Complex, Expression — all of which use 16-aligned sizes)
    ;; start on the shared 16-byte grid. Without this, capacities where
    ;; 8 + n*20 is 8 (mod 16) — e.g. n ≡ 0 (mod 4) at certain positions —
    ;; corrupt downstream heap reads with "memory access out of bounds".
    (local.set $object_pointer (local.get $heap_pointer))
    ;; GC header: size=32, type=OBJ_OBJECT
    (i32.store (call $abs (local.get $object_pointer))
      (i32.or (global.get $OBJECT_HEADER_SIZE) (i32.shl (global.get $OBJ_OBJECT) (i32.const 24))))
    (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 4))) (i32.const 0))
    ;; prototype_pointer = 0 (null prototype for now)
    (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 8))) (i32.const 0))
    ;; count = 0
    (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 12))) (i32.const 0))
    ;; capacity
    (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 16))) (local.get $capacity))
    ;; flags = 0
    (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 20))) (i32.const 0))
    ;; sym_entries = 0 (lazy)
    (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 28))) (i32.const 0))

    ;; Allocate entries block
    (local.set $entries_pointer (i32.add (local.get $object_pointer) (global.get $OBJECT_HEADER_SIZE)))
    (local.set $entries_size (i32.add (global.get $GC_HEADER_SIZE)
      (i32.mul (local.get $capacity) (global.get $ENTRY_SIZE))))
    ;; Round up to 16-byte alignment so downstream heap allocations stay
    ;; on the shared grid.
    (local.set $entries_aligned (i32.and
      (i32.add (local.get $entries_size) (i32.const 15))
      (i32.const -16)))

    ;; GC header for entries — stores ALIGNED size so heap walker strides
    ;; past the whole block including alignment padding.
    (i32.store (call $abs (local.get $entries_pointer))
      (i32.or (local.get $entries_aligned) (i32.shl (global.get $OBJ_OBJECT_DATA) (i32.const 24))))
    (i32.store (call $abs (i32.add (local.get $entries_pointer) (i32.const 4))) (i32.const 0))

    ;; Store entries_pointer in object (offset 24)
    (i32.store (call $abs (i32.add (local.get $object_pointer) (i32.const 24))) (local.get $entries_pointer))

    ;; Update heap pointer by aligned size.
    (call $write_state (global.get $STATE_HEAP_POINTER)
      (i32.add (local.get $entries_pointer) (local.get $entries_aligned)))

    (local.get $object_pointer)
  )

  ;; Allocate an ordinary object with an internal [[BigIntData]] header
  ;; pointer at offset 32. The extended 48-byte header remains compatible
  ;; with all ordinary object property operations.
  (func $allocate_bigint_wrapper (param $bigint_header i32) (result i32)
    (local $object_pointer i32)
    (local $entries_pointer i32)
    (local.set $object_pointer
      (call $read_state (global.get $STATE_HEAP_POINTER)))
    (local.set $entries_pointer
      (i32.add (local.get $object_pointer) (i32.const 48)))
    (i32.store (call $abs (local.get $object_pointer))
      (i32.or (i32.const 48)
        (i32.shl (global.get $OBJ_OBJECT) (i32.const 24))))
    (i32.store
      (call $abs (i32.add (local.get $object_pointer) (i32.const 4)))
      (i32.const 0))
    (i32.store
      (call $abs (i32.add (local.get $object_pointer) (i32.const 8)))
      (call $read_state (global.get $STATE_BIGINT_PROTOTYPE)))
    (i32.store
      (call $abs (i32.add (local.get $object_pointer) (i32.const 12)))
      (i32.const 0))
    (i32.store
      (call $abs (i32.add (local.get $object_pointer) (i32.const 16)))
      (i32.const 0))
    (i32.store
      (call $abs (i32.add (local.get $object_pointer) (i32.const 20)))
      (i32.const 0))
    (i32.store
      (call $abs (i32.add (local.get $object_pointer) (i32.const 24)))
      (local.get $entries_pointer))
    (i32.store
      (call $abs (i32.add (local.get $object_pointer) (i32.const 28)))
      (i32.const 0))
    (i32.store
      (call $abs (i32.add (local.get $object_pointer) (i32.const 32)))
      (local.get $bigint_header))
    (i32.store
      (call $abs (i32.add (local.get $object_pointer) (i32.const 36)))
      (i32.const 0))
    (i32.store
      (call $abs (i32.add (local.get $object_pointer) (i32.const 40)))
      (i32.const 0))
    (i32.store
      (call $abs (i32.add (local.get $object_pointer) (i32.const 44)))
      (i32.const 0))
    (i32.store (call $abs (local.get $entries_pointer))
      (i32.or (i32.const 16)
        (i32.shl (global.get $OBJ_OBJECT_DATA) (i32.const 24))))
    (i32.store
      (call $abs (i32.add (local.get $entries_pointer) (i32.const 4)))
      (i32.const 0))
    (call $write_state (global.get $STATE_HEAP_POINTER)
      (i32.add (local.get $entries_pointer) (i32.const 16)))
    (local.get $object_pointer)
  )

  ;; ==========================================================================
  ;; IEEE 754 Power Function helpers
  ;; ==========================================================================

  ;; Get high 32 bits of f64
  (func $f64_hi (param $x f64) (result i32)
    (i32.wrap_i64 (i64.shr_u (i64.reinterpret_f64 (local.get $x)) (i64.const 32)))
  )

  ;; Get low 32 bits of f64
  (func $f64_lo (param $x f64) (result i32)
    (i32.wrap_i64 (i64.reinterpret_f64 (local.get $x)))
  )

  ;; Build f64 from hi/lo words
  (func $f64_from_words (param $hi i32) (param $lo i32) (result f64)
    (f64.reinterpret_i64
      (i64.or
        (i64.extend_i32_u (local.get $lo))
        (i64.shl (i64.extend_i32_u (local.get $hi)) (i64.const 32))))
  )

  ;; Set high word of f64
  (func $f64_set_hi (param $x f64) (param $hi i32) (result f64)
    (call $f64_from_words (local.get $hi) (call $f64_lo (local.get $x)))
  )

  ;; Set low word to zero (truncate to 32-bit precision)
  (func $f64_trunc_lo (param $x f64) (result f64)
    (call $f64_from_words (call $f64_hi (local.get $x)) (i32.const 0))
  )

  ;; scalbn(x, n) - multiply x by 2^n
  (func $scalbn (param $x f64) (param $n i32) (result f64)
    (local $hx i32)
    (local $k i32)

    (local.set $hx (call $f64_hi (local.get $x)))
    (local.set $k (i32.shr_u (i32.and (local.get $hx) (i32.const 0x7ff00000)) (i32.const 20)))

    ;; x is subnormal
    (if (i32.eqz (local.get $k))
      (then
        (local.set $x (f64.mul (local.get $x) (f64.const 1.80143985094819840000e+16))) ;; 2^54
        (local.set $hx (call $f64_hi (local.get $x)))
        (local.set $k (i32.sub
          (i32.shr_u (i32.and (local.get $hx) (i32.const 0x7ff00000)) (i32.const 20))
          (i32.const 54)))
        (if (i32.lt_s (i32.add (local.get $k) (local.get $n)) (i32.const -54))
          (then (return (f64.const 0.0)))
        )
      )
    )

    (local.set $k (i32.add (local.get $k) (local.get $n)))
    (if (i32.gt_s (local.get $k) (i32.const 0x7fe))
      (then (return (f64.mul (local.get $x) (f64.const 1.0e300))))
    )
    (if (i32.gt_s (local.get $k) (i32.const 0))
      (then
        (return (call $f64_set_hi (local.get $x)
          (i32.or
            (i32.and (local.get $hx) (i32.const 0x800fffff))
            (i32.shl (local.get $k) (i32.const 20)))))
      )
    )

    (if (i32.lt_s (local.get $k) (i32.const -54))
      (then (return (f64.const 0.0)))
    )

    (local.set $k (i32.add (local.get $k) (i32.const 54)))
    (local.set $x (call $f64_set_hi (local.get $x)
      (i32.or
        (i32.and (local.get $hx) (i32.const 0x800fffff))
        (i32.shl (local.get $k) (i32.const 20)))))
    (f64.mul (local.get $x) (f64.const 5.55111512312578270212e-17)) ;; 2^-54
  )

  ;; Main pow function: x ** y
  (func $pow (param $x f64) (param $y f64) (result f64)
    (local $z f64) (local $ax f64) (local $z_h f64) (local $z_l f64)
    (local $p_h f64) (local $p_l f64) (local $y1 f64) (local $t f64)
    (local $t1 f64) (local $t2 f64) (local $r f64) (local $s f64)
    (local $u f64) (local $v f64) (local $w f64)
    (local $ss f64) (local $s2 f64) (local $s_h f64) (local $s_l f64)
    (local $t_h f64) (local $t_l f64)
    (local $hx i32) (local $hy i32) (local $ix i32) (local $iy i32)
    (local $lx i32) (local $ly i32) (local $n i32) (local $j i32)
    (local $k i32) (local $yisint i32) (local $i i32)

    ;; Extract IEEE 754 bit patterns
    (local.set $hx (call $f64_hi (local.get $x)))
    (local.set $lx (call $f64_lo (local.get $x)))
    (local.set $hy (call $f64_hi (local.get $y)))
    (local.set $ly (call $f64_lo (local.get $y)))
    (local.set $ix (i32.and (local.get $hx) (i32.const 0x7fffffff)))
    (local.set $iy (i32.and (local.get $hy) (i32.const 0x7fffffff)))

    ;; y == 0: x**0 = 1
    (if (i32.eqz (i32.or (local.get $iy) (local.get $ly)))
      (then (return (f64.const 1.0)))
    )

    ;; x == 1: 1**y = 1
    (if (i32.and
          (i32.eq (local.get $hx) (i32.const 0x3ff00000))
          (i32.eqz (local.get $lx)))
      (then (return (f64.const 1.0)))
    )

    ;; NaN check for x
    (if (i32.or
          (i32.gt_u (local.get $ix) (i32.const 0x7ff00000))
          (i32.and
            (i32.eq (local.get $ix) (i32.const 0x7ff00000))
            (i32.ne (local.get $lx) (i32.const 0))))
      (then (return (f64.add (local.get $x) (local.get $y))))
    )

    ;; NaN check for y
    (if (i32.or
          (i32.gt_u (local.get $iy) (i32.const 0x7ff00000))
          (i32.and
            (i32.eq (local.get $iy) (i32.const 0x7ff00000))
            (i32.ne (local.get $ly) (i32.const 0))))
      (then (return (f64.add (local.get $x) (local.get $y))))
    )

    ;; Determine if y is odd integer when x < 0
    ;; yisint: 0=not int, 1=odd, 2=even
    (local.set $yisint (i32.const 0))
    (if (i32.lt_s (local.get $hx) (i32.const 0))
      (then
        (if (i32.ge_s (local.get $iy) (i32.const 0x43400000))
          (then (local.set $yisint (i32.const 2)))
          (else
            (if (i32.ge_s (local.get $iy) (i32.const 0x3ff00000))
              (then
                (local.set $k (i32.sub (i32.shr_u (local.get $iy) (i32.const 20)) (i32.const 0x3ff)))
                (if (i32.gt_s (local.get $k) (i32.const 20))
                  (then
                    (local.set $j (i32.shr_u (local.get $ly) (i32.sub (i32.const 52) (local.get $k))))
                    (if (i32.eq (i32.shl (local.get $j) (i32.sub (i32.const 52) (local.get $k))) (local.get $ly))
                      (then (local.set $yisint (i32.sub (i32.const 2) (i32.and (local.get $j) (i32.const 1)))))
                    )
                  )
                  (else
                    (if (i32.eqz (local.get $ly))
                      (then
                        (local.set $j (i32.shr_u (local.get $iy) (i32.sub (i32.const 20) (local.get $k))))
                        (if (i32.eq (i32.shl (local.get $j) (i32.sub (i32.const 20) (local.get $k))) (local.get $iy))
                          (then (local.set $yisint (i32.sub (i32.const 2) (i32.and (local.get $j) (i32.const 1)))))
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )

    ;; Special y values when ly==0
    (if (i32.eqz (local.get $ly))
      (then
        ;; y is +-inf
        (if (i32.eq (local.get $iy) (i32.const 0x7ff00000))
          (then
            ;; (-1)**+-inf = 1 (JS spec)
            (if (i32.eqz (i32.or (i32.sub (local.get $ix) (i32.const 0x3ff00000)) (local.get $lx)))
              (then (return (f64.const 1.0)))
            )
            (if (i32.ge_s (local.get $ix) (i32.const 0x3ff00000))
              (then (return (select (local.get $y) (f64.const 0.0) (i32.ge_s (local.get $hy) (i32.const 0)))))
              (else (return (select (f64.neg (local.get $y)) (f64.const 0.0) (i32.lt_s (local.get $hy) (i32.const 0)))))
            )
          )
        )
        ;; y is +-1
        (if (i32.eq (local.get $iy) (i32.const 0x3ff00000))
          (then
            (return (select (f64.div (f64.const 1.0) (local.get $x)) (local.get $x) (i32.lt_s (local.get $hy) (i32.const 0))))
          )
        )
        ;; y is 2
        (if (i32.eq (local.get $hy) (i32.const 0x40000000))
          (then (return (f64.mul (local.get $x) (local.get $x))))
        )
        ;; y is 0.5
        (if (i32.eq (local.get $hy) (i32.const 0x3fe00000))
          (then
            (if (i32.ge_s (local.get $hx) (i32.const 0))
              (then (return (f64.sqrt (local.get $x))))
            )
          )
        )
      )
    )

    (local.set $ax (f64.abs (local.get $x)))

    ;; Special x values (+-0, +-inf, +-1) when lx==0
    (if (i32.eqz (local.get $lx))
      (then
        (if (i32.or
              (i32.eq (local.get $ix) (i32.const 0x7ff00000))
              (i32.or (i32.eqz (local.get $ix)) (i32.eq (local.get $ix) (i32.const 0x3ff00000))))
          (then
            (local.set $z (local.get $ax))
            (if (i32.lt_s (local.get $hy) (i32.const 0))
              (then (local.set $z (f64.div (f64.const 1.0) (local.get $z))))
            )
            (if (i32.lt_s (local.get $hx) (i32.const 0))
              (then
                (if (i32.eqz (i32.or (i32.sub (local.get $ix) (i32.const 0x3ff00000)) (local.get $yisint)))
                  (then (local.set $z (f64.div (f64.sub (local.get $z) (local.get $z)) (f64.sub (local.get $z) (local.get $z)))))
                  (else
                    (if (i32.eq (local.get $yisint) (i32.const 1))
                      (then (local.set $z (f64.neg (local.get $z))))
                    )
                  )
                )
              )
            )
            (return (local.get $z))
          )
        )
      )
    )

    ;; Sign of result
    (local.set $s (f64.const 1.0))
    (if (i32.lt_s (local.get $hx) (i32.const 0))
      (then
        (if (i32.eqz (local.get $yisint))
          (then (return (f64.div (f64.sub (local.get $x) (local.get $x)) (f64.sub (local.get $x) (local.get $x)))))
        )
        (if (i32.eq (local.get $yisint) (i32.const 1))
          (then (local.set $s (f64.const -1.0)))
        )
      )
    )

    ;; |y| is huge
    (if (i32.gt_s (local.get $iy) (i32.const 0x41e00000))
      (then
        ;; |y| > 2^64: must overflow/underflow
        (if (i32.gt_s (local.get $iy) (i32.const 0x43f00000))
          (then
            (if (i32.le_s (local.get $ix) (i32.const 0x3fefffff))
              (then
                (return (select
                  (f64.mul (f64.const 1.0e300) (f64.const 1.0e300))
                  (f64.mul (f64.const 1.0e-300) (f64.const 1.0e-300))
                  (i32.lt_s (local.get $hy) (i32.const 0))))
              )
            )
            (if (i32.ge_s (local.get $ix) (i32.const 0x3ff00000))
              (then
                (return (select
                  (f64.mul (f64.const 1.0e300) (f64.const 1.0e300))
                  (f64.mul (f64.const 1.0e-300) (f64.const 1.0e-300))
                  (i32.gt_s (local.get $hy) (i32.const 0))))
              )
            )
          )
        )
        ;; Over/underflow if x not close to 1
        (if (i32.lt_s (local.get $ix) (i32.const 0x3fefffff))
          (then
            (return (f64.mul (local.get $s)
              (select
                (f64.mul (f64.const 1.0e300) (f64.const 1.0e300))
                (f64.mul (f64.const 1.0e-300) (f64.const 1.0e-300))
                (i32.lt_s (local.get $hy) (i32.const 0)))))
          )
        )
        (if (i32.gt_s (local.get $ix) (i32.const 0x3ff00000))
          (then
            (return (f64.mul (local.get $s)
              (select
                (f64.mul (f64.const 1.0e300) (f64.const 1.0e300))
                (f64.mul (f64.const 1.0e-300) (f64.const 1.0e-300))
                (i32.gt_s (local.get $hy) (i32.const 0)))))
          )
        )
        ;; |1-x| is tiny: use Taylor series for log
        (local.set $t (f64.sub (local.get $ax) (f64.const 1.0)))
        (local.set $w (f64.mul (f64.mul (local.get $t) (local.get $t))
          (f64.sub (f64.const 0.5)
            (f64.mul (local.get $t)
              (f64.sub (f64.const 0.3333333333333333) (f64.mul (local.get $t) (f64.const 0.25)))))))
        (local.set $u (f64.mul (f64.const 1.44269502162933349609e+00) (local.get $t)))
        (local.set $v (f64.sub
          (f64.mul (local.get $t) (f64.const 1.92596299112661746887e-08))
          (f64.mul (local.get $w) (f64.const 1.44269504088896338700e+00))))
        (local.set $t1 (call $f64_trunc_lo (f64.add (local.get $u) (local.get $v))))
        (local.set $t2 (f64.sub (local.get $v) (f64.sub (local.get $t1) (local.get $u))))
      )
      (else
        ;; General case: compute log2(ax)
        (local.set $n (i32.const 0))
        ;; Handle subnormal x
        (if (i32.lt_s (local.get $ix) (i32.const 0x00100000))
          (then
            (local.set $ax (f64.mul (local.get $ax) (f64.const 9007199254740992.0)))
            (local.set $n (i32.sub (local.get $n) (i32.const 53)))
            (local.set $ix (call $f64_hi (local.get $ax)))
          )
        )
        (local.set $n (i32.add (local.get $n) (i32.sub (i32.shr_u (local.get $ix) (i32.const 20)) (i32.const 0x3ff))))
        (local.set $j (i32.and (local.get $ix) (i32.const 0x000fffff)))
        (local.set $ix (i32.or (local.get $j) (i32.const 0x3ff00000)))
        (if (i32.le_s (local.get $j) (i32.const 0x3988E))
          (then (local.set $k (i32.const 0)))
          (else
            (if (i32.lt_s (local.get $j) (i32.const 0xBB67A))
              (then (local.set $k (i32.const 1)))
              (else
                (local.set $k (i32.const 0))
                (local.set $n (i32.add (local.get $n) (i32.const 1)))
                (local.set $ix (i32.sub (local.get $ix) (i32.const 0x00100000)))
              )
            )
          )
        )
        (local.set $ax (call $f64_set_hi (local.get $ax) (local.get $ix)))

        ;; Compute ss = (x-bp[k])/(x+bp[k])
        (if (i32.eqz (local.get $k))
          (then
            (local.set $u (f64.sub (local.get $ax) (f64.const 1.0)))
            (local.set $v (f64.div (f64.const 1.0) (f64.add (local.get $ax) (f64.const 1.0))))
          )
          (else
            (local.set $u (f64.sub (local.get $ax) (f64.const 1.5)))
            (local.set $v (f64.div (f64.const 1.0) (f64.add (local.get $ax) (f64.const 1.5))))
          )
        )
        (local.set $ss (f64.mul (local.get $u) (local.get $v)))
        (local.set $s_h (call $f64_trunc_lo (local.get $ss)))
        (local.set $t_h (call $f64_from_words
          (i32.add
            (i32.add (i32.or (i32.shr_u (local.get $ix) (i32.const 1)) (i32.const 0x20000000)) (i32.const 0x00080000))
            (i32.shl (local.get $k) (i32.const 18)))
          (i32.const 0)))
        (if (i32.eqz (local.get $k))
          (then (local.set $t_l (f64.sub (local.get $ax) (f64.sub (local.get $t_h) (f64.const 1.0)))))
          (else (local.set $t_l (f64.sub (local.get $ax) (f64.sub (local.get $t_h) (f64.const 1.5)))))
        )
        (local.set $s_l (f64.mul (local.get $v)
          (f64.sub (f64.sub (local.get $u) (f64.mul (local.get $s_h) (local.get $t_h)))
            (f64.mul (local.get $s_h) (local.get $t_l)))))

        ;; Compute log(ax) using polynomial
        (local.set $s2 (f64.mul (local.get $ss) (local.get $ss)))
        (local.set $r (f64.mul (f64.mul (local.get $s2) (local.get $s2))
          (f64.add (f64.const 5.99999999999994648725e-01)
            (f64.mul (local.get $s2)
              (f64.add (f64.const 4.28571428578550184252e-01)
                (f64.mul (local.get $s2)
                  (f64.add (f64.const 3.33333329818377432918e-01)
                    (f64.mul (local.get $s2)
                      (f64.add (f64.const 2.72728123808534006489e-01)
                        (f64.mul (local.get $s2)
                          (f64.add (f64.const 2.30660745775561754067e-01)
                            (f64.mul (local.get $s2) (f64.const 2.06975017800338417784e-01)))))))))))))
        (local.set $r (f64.add (local.get $r) (f64.mul (local.get $s_l) (f64.add (local.get $s_h) (local.get $ss)))))
        (local.set $s2 (f64.mul (local.get $s_h) (local.get $s_h)))
        (local.set $t_h (call $f64_trunc_lo (f64.add (f64.add (f64.const 3.0) (local.get $s2)) (local.get $r))))
        (local.set $t_l (f64.sub (local.get $r) (f64.sub (f64.sub (local.get $t_h) (f64.const 3.0)) (local.get $s2))))
        (local.set $u (f64.mul (local.get $s_h) (local.get $t_h)))
        (local.set $v (f64.add (f64.mul (local.get $s_l) (local.get $t_h)) (f64.mul (local.get $t_l) (local.get $ss))))
        (local.set $p_h (call $f64_trunc_lo (f64.add (local.get $u) (local.get $v))))
        (local.set $p_l (f64.sub (local.get $v) (f64.sub (local.get $p_h) (local.get $u))))
        (local.set $z_h (f64.mul (f64.const 9.61796700954437255859e-01) (local.get $p_h)))
        (if (i32.eqz (local.get $k))
          (then
            (local.set $z_l (f64.add
              (f64.add (f64.mul (f64.const -7.02846165095275826516e-09) (local.get $p_h))
                (f64.mul (local.get $p_l) (f64.const 9.61796693925975554329e-01)))
              (f64.const 0.0)))
          )
          (else
            (local.set $z_l (f64.add
              (f64.add (f64.mul (f64.const -7.02846165095275826516e-09) (local.get $p_h))
                (f64.mul (local.get $p_l) (f64.const 9.61796693925975554329e-01)))
              (f64.const 1.35003920212974897128e-08)))
          )
        )
        (local.set $t (f64.convert_i32_s (local.get $n)))
        (if (i32.eqz (local.get $k))
          (then (local.set $t1 (call $f64_trunc_lo (f64.add (f64.add (f64.add (local.get $z_h) (local.get $z_l)) (f64.const 0.0)) (local.get $t)))))
          (else (local.set $t1 (call $f64_trunc_lo (f64.add (f64.add (f64.add (local.get $z_h) (local.get $z_l)) (f64.const 5.84962487220764160156e-01)) (local.get $t)))))
        )
        (if (i32.eqz (local.get $k))
          (then (local.set $t2 (f64.sub (local.get $z_l) (f64.sub (f64.sub (f64.sub (local.get $t1) (local.get $t)) (f64.const 0.0)) (local.get $z_h)))))
          (else (local.set $t2 (f64.sub (local.get $z_l) (f64.sub (f64.sub (f64.sub (local.get $t1) (local.get $t)) (f64.const 5.84962487220764160156e-01)) (local.get $z_h)))))
        )
      )
    )

    ;; Split y and compute (y1+y2)*(t1+t2)
    (local.set $y1 (call $f64_trunc_lo (local.get $y)))
    (local.set $p_l (f64.add (f64.mul (f64.sub (local.get $y) (local.get $y1)) (local.get $t1)) (f64.mul (local.get $y) (local.get $t2))))
    (local.set $p_h (f64.mul (local.get $y1) (local.get $t1)))
    (local.set $z (f64.add (local.get $p_l) (local.get $p_h)))
    (local.set $j (call $f64_hi (local.get $z)))
    (local.set $i (call $f64_lo (local.get $z)))

    ;; Check overflow/underflow
    (if (i32.ge_s (local.get $j) (i32.const 0x40900000))
      (then
        (if (i32.ne (i32.or (i32.sub (local.get $j) (i32.const 0x40900000)) (local.get $i)) (i32.const 0))
          (then (return (f64.mul (local.get $s) (f64.mul (f64.const 1.0e300) (f64.const 1.0e300)))))
        )
        (if (f64.gt (f64.add (local.get $p_l) (f64.const 8.0085662595372944372e-17)) (f64.sub (local.get $z) (local.get $p_h)))
          (then (return (f64.mul (local.get $s) (f64.mul (f64.const 1.0e300) (f64.const 1.0e300)))))
        )
      )
      (else
        (if (i32.ge_s (i32.and (local.get $j) (i32.const 0x7fffffff)) (i32.const 0x4090cc00))
          (then
            (if (i32.ne (i32.or (i32.sub (local.get $j) (i32.const 0xc090cc00)) (local.get $i)) (i32.const 0))
              (then (return (f64.mul (local.get $s) (f64.mul (f64.const 1.0e-300) (f64.const 1.0e-300)))))
            )
            (if (f64.le (local.get $p_l) (f64.sub (local.get $z) (local.get $p_h)))
              (then (return (f64.mul (local.get $s) (f64.mul (f64.const 1.0e-300) (f64.const 1.0e-300)))))
            )
          )
        )
      )
    )

    ;; Compute 2**(p_h+p_l)
    (local.set $i (i32.and (local.get $j) (i32.const 0x7fffffff)))
    (local.set $k (i32.sub (i32.shr_u (local.get $i) (i32.const 20)) (i32.const 0x3ff)))
    (local.set $n (i32.const 0))
    (if (i32.gt_s (local.get $i) (i32.const 0x3fe00000))
      (then
        (local.set $n (i32.add (local.get $j) (i32.shr_u (i32.const 0x00100000) (i32.add (local.get $k) (i32.const 1)))))
        (local.set $k (i32.sub (i32.shr_u (i32.and (local.get $n) (i32.const 0x7fffffff)) (i32.const 20)) (i32.const 0x3ff)))
        (local.set $t (call $f64_from_words
          (i32.and (local.get $n) (i32.xor (i32.shr_u (i32.const 0x000fffff) (local.get $k)) (i32.const 0xffffffff)))
          (i32.const 0)))
        (local.set $n (i32.shr_u
          (i32.or (i32.and (local.get $n) (i32.const 0x000fffff)) (i32.const 0x00100000))
          (i32.sub (i32.const 20) (local.get $k))))
        (if (i32.lt_s (local.get $j) (i32.const 0))
          (then (local.set $n (i32.sub (i32.const 0) (local.get $n))))
        )
        (local.set $p_h (f64.sub (local.get $p_h) (local.get $t)))
      )
    )
    (local.set $t (call $f64_trunc_lo (f64.add (local.get $p_l) (local.get $p_h))))
    (local.set $u (f64.mul (local.get $t) (f64.const 6.93147182464599609375e-01)))
    (local.set $v (f64.add
      (f64.mul (f64.sub (local.get $p_l) (f64.sub (local.get $t) (local.get $p_h))) (f64.const 6.93147180559945286227e-01))
      (f64.mul (local.get $t) (f64.const -1.90465429995776804525e-09))))
    (local.set $z (f64.add (local.get $u) (local.get $v)))
    (local.set $w (f64.sub (local.get $v) (f64.sub (local.get $z) (local.get $u))))
    (local.set $t (f64.mul (local.get $z) (local.get $z)))
    (local.set $t1 (f64.sub (local.get $z)
      (f64.mul (local.get $t)
        (f64.add (f64.const 1.66666666666666019037e-01)
          (f64.mul (local.get $t)
            (f64.add (f64.const -2.77777777770155933842e-03)
              (f64.mul (local.get $t)
                (f64.add (f64.const 6.61375632143793436117e-05)
                  (f64.mul (local.get $t)
                    (f64.add (f64.const -1.65339022054652515390e-06)
                      (f64.mul (local.get $t) (f64.const 4.13813679705723846039e-08))))))))))))
    (local.set $r (f64.sub
      (f64.div (f64.mul (local.get $z) (local.get $t1)) (f64.sub (local.get $t1) (f64.const 2.0)))
      (f64.add (local.get $w) (f64.mul (local.get $z) (local.get $w)))))
    (local.set $z (f64.sub (f64.const 1.0) (f64.sub (local.get $r) (local.get $z))))
    (local.set $j (call $f64_hi (local.get $z)))
    (local.set $j (i32.add (local.get $j) (i32.shl (local.get $n) (i32.const 20))))
    (if (i32.le_s (i32.shr_s (local.get $j) (i32.const 20)) (i32.const 0))
      (then (local.set $z (call $scalbn (local.get $z) (local.get $n))))
      (else (local.set $z (call $f64_set_hi (local.get $z) (local.get $j))))
    )
    (f64.mul (local.get $s) (local.get $z))
  )

  ;; ==========================================================================
  ;; Wrapper functions for consistent naming (f64_* prefix)
  ;; ==========================================================================

  (func $f64_pow (param $x f64) (param $y f64) (result f64)
    (call $pow (local.get $x) (local.get $y))
  )

  ;; ==========================================================================
  ;; Natural logarithm using polynomial approximation
  ;; ln(x) = ln(m * 2^e) = ln(m) + e*ln(2)
  ;; where m is the mantissa normalized to [1, 2)
  ;; ==========================================================================
  ;; ==========================================================================
  ;; Natural logarithm using fdlibm algorithm (exact match to e_log.c)
  ;; Ported from Sun Microsystems fdlibm e_log.c
  ;; ==========================================================================
  (func $f64_log (param $x f64) (result f64)
    (local $hx i32) (local $lx i32) (local $k i32) (local $i i32) (local $j i32)
    (local $f f64) (local $s f64) (local $z f64) (local $w f64)
    (local $R f64) (local $t1 f64) (local $t2 f64) (local $hfsq f64) (local $dk f64)
    ;; fdlibm coefficients for log (minimax polynomial)
    ;; ln2_hi = 6.93147180369123816490e-01  (0x3fe62e42, 0xfee00000)
    ;; ln2_lo = 1.90821492927058770002e-10  (0x3dea39ef, 0x35793c76)

    (local.set $hx (call $f64_hi (local.get $x)))
    (local.set $lx (call $f64_lo (local.get $x)))

    (local.set $k (i32.const 0))

    ;; Special cases: x < 2**-1022 (subnormal or zero/negative)
    (if (i32.lt_s (local.get $hx) (i32.const 0x00100000))
      (then
        ;; log(+-0) = -inf
        (if (i32.eq (i32.or (i32.and (local.get $hx) (i32.const 0x7fffffff)) (local.get $lx)) (i32.const 0))
          (then (return (f64.div (f64.const -1) (f64.const 0))))
        )
        ;; log(negative) = NaN
        (if (i32.lt_s (local.get $hx) (i32.const 0))
          (then (return (f64.div (f64.const 0) (f64.const 0))))
        )
        ;; subnormal: scale up by 2^54
        (local.set $k (i32.sub (local.get $k) (i32.const 54)))
        (local.set $x (f64.mul (local.get $x) (f64.const 1.80143985094819840000e+16)))
        (local.set $hx (call $f64_hi (local.get $x)))
      )
    )
    ;; x >= 2^1024 (infinity or NaN)
    (if (i32.ge_s (local.get $hx) (i32.const 0x7ff00000))
      (then (return (f64.add (local.get $x) (local.get $x))))
    )

    ;; k += (hx>>20) - 1023
    (local.set $k (i32.add (local.get $k)
      (i32.sub (i32.shr_u (local.get $hx) (i32.const 20)) (i32.const 1023))))
    (local.set $hx (i32.and (local.get $hx) (i32.const 0x000fffff)))

    ;; i = (hx + 0x95f64) & 0x100000  -- determines if we normalize to x or x/2
    (local.set $i (i32.and (i32.add (local.get $hx) (i32.const 0x95f64)) (i32.const 0x100000)))

    ;; Set high word: hx | (i ^ 0x3ff00000) -- normalize x or x/2
    (local.set $x (call $f64_from_words
      (i32.or (local.get $hx) (i32.xor (local.get $i) (i32.const 0x3ff00000)))
      (call $f64_lo (local.get $x))))
    (local.set $k (i32.add (local.get $k) (i32.shr_u (local.get $i) (i32.const 20))))

    (local.set $f (f64.sub (local.get $x) (f64.const 1.0)))

    ;; Fast path for |f| < 2**-20: if ((0x000fffff & (2+hx)) < 3)
    (if (i32.lt_s (i32.and (i32.const 0x000fffff) (i32.add (i32.const 2) (local.get $hx))) (i32.const 3))
      (then
        (if (f64.eq (local.get $f) (f64.const 0))
          (then
            (if (i32.eq (local.get $k) (i32.const 0))
              (then (return (f64.const 0)))
            )
            (local.set $dk (f64.convert_i32_s (local.get $k)))
            (return (f64.add
              (f64.mul (local.get $dk) (f64.const 6.93147180369123816490e-01))
              (f64.mul (local.get $dk) (f64.const 1.90821492927058770002e-10))))
          )
        )
        ;; R = f*f*(0.5 - 0.33333333333333333*f)
        (local.set $R (f64.mul (f64.mul (local.get $f) (local.get $f))
          (f64.sub (f64.const 0.5)
            (f64.mul (f64.const 0.33333333333333333) (local.get $f)))))
        (if (i32.eq (local.get $k) (i32.const 0))
          (then (return (f64.sub (local.get $f) (local.get $R))))
        )
        (local.set $dk (f64.convert_i32_s (local.get $k)))
        (return (f64.sub
          (f64.mul (local.get $dk) (f64.const 6.93147180369123816490e-01))
          (f64.sub
            (f64.sub (local.get $R) (f64.mul (local.get $dk) (f64.const 1.90821492927058770002e-10)))
            (local.get $f))))
      )
    )

    ;; s = f / (2 + f)
    (local.set $s (f64.div (local.get $f) (f64.add (f64.const 2.0) (local.get $f))))
    (local.set $dk (f64.convert_i32_s (local.get $k)))
    (local.set $z (f64.mul (local.get $s) (local.get $s)))
    (local.set $i (i32.sub (local.get $hx) (i32.const 0x6147a)))
    (local.set $w (f64.mul (local.get $z) (local.get $z)))
    (local.set $j (i32.sub (i32.const 0x6b851) (local.get $hx)))

    ;; t1 = w*(Lg2 + w*(Lg4 + w*Lg6))
    (local.set $t1 (f64.mul (local.get $w)
      (f64.add (f64.const 3.999999999940941908e-01)
        (f64.mul (local.get $w)
          (f64.add (f64.const 2.222219843214978396e-01)
            (f64.mul (local.get $w) (f64.const 1.531383769920937332e-01)))))))

    ;; t2 = z*(Lg1 + w*(Lg3 + w*(Lg5 + w*Lg7)))
    (local.set $t2 (f64.mul (local.get $z)
      (f64.add (f64.const 6.666666666666735130e-01)
        (f64.mul (local.get $w)
          (f64.add (f64.const 2.857142874366239149e-01)
            (f64.mul (local.get $w)
              (f64.add (f64.const 1.818357216161805012e-01)
                (f64.mul (local.get $w) (f64.const 1.479819860511658591e-01)))))))))

    (local.set $i (i32.or (local.get $i) (local.get $j)))
    (local.set $R (f64.add (local.get $t2) (local.get $t1)))

    (if (i32.gt_s (local.get $i) (i32.const 0))
      (then
        ;; Use hfsq path: hfsq = 0.5*f*f
        (local.set $hfsq (f64.mul (f64.const 0.5) (f64.mul (local.get $f) (local.get $f))))
        (if (i32.eq (local.get $k) (i32.const 0))
          (then
            ;; return f - (hfsq - s*(hfsq+R))
            (return (f64.sub (local.get $f)
              (f64.sub (local.get $hfsq)
                (f64.mul (local.get $s) (f64.add (local.get $hfsq) (local.get $R))))))
          )
          (else
            ;; return dk*ln2_hi - ((hfsq - (s*(hfsq+R) + dk*ln2_lo)) - f)
            (return (f64.sub
              (f64.mul (local.get $dk) (f64.const 6.93147180369123816490e-01))
              (f64.sub
                (f64.sub (local.get $hfsq)
                  (f64.add
                    (f64.mul (local.get $s) (f64.add (local.get $hfsq) (local.get $R)))
                    (f64.mul (local.get $dk) (f64.const 1.90821492927058770002e-10))))
                (local.get $f))))
          )
        )
      )
      (else
        ;; Non-hfsq path
        (if (i32.eq (local.get $k) (i32.const 0))
          (then
            ;; return f - s*(f - R)
            (return (f64.sub (local.get $f)
              (f64.mul (local.get $s) (f64.sub (local.get $f) (local.get $R)))))
          )
          (else
            ;; return dk*ln2_hi - ((s*(f-R) - dk*ln2_lo) - f)
            (return (f64.sub
              (f64.mul (local.get $dk) (f64.const 6.93147180369123816490e-01))
              (f64.sub
                (f64.sub
                  (f64.mul (local.get $s) (f64.sub (local.get $f) (local.get $R)))
                  (f64.mul (local.get $dk) (f64.const 1.90821492927058770002e-10)))
                (local.get $f))))
          )
        )
      )
    )
    (unreachable)
  )

  ;; ==========================================================================
  ;; Log base 2 using V8/fdlibm algorithm (exact match to ieee754.cc)
  ;; Uses Dekker splitting for extra precision
  ;; ==========================================================================
  (func $f64_log2 (param $x f64) (result f64)
    (local $hx i32) (local $lx i32) (local $k i32) (local $i i32)
    (local $f f64) (local $s f64) (local $z f64) (local $w f64)
    (local $R f64) (local $hfsq f64) (local $y f64)
    (local $hi f64) (local $lo f64) (local $r f64)
    (local $val_hi f64) (local $val_lo f64)
    (local $t1 f64) (local $t2 f64)
    ;; Constants from V8:
    ;; ivln2hi = 1.44269504072144627571e+00  0x3FF71547, 0x65200000
    ;; ivln2lo = 1.67517131648865118353e-10  0x3DE705FC, 0x2EEFA200
    ;; two54   = 1.80143985094819840000e+16  0x43500000, 0x00000000
    ;; Lg1-Lg7 coefficients for k_log1p

    (local.set $hx (call $f64_hi (local.get $x)))
    (local.set $lx (call $f64_lo (local.get $x)))
    (local.set $k (i32.const 0))

    ;; x < 2**-1022 (subnormal or negative or zero)
    (if (i32.lt_s (local.get $hx) (i32.const 0x00100000))
      (then
        ;; log(+-0) = -inf
        (if (i32.eqz (i32.or (i32.and (local.get $hx) (i32.const 0x7FFFFFFF)) (local.get $lx)))
          (then (return (f64.div (f64.const -1) (f64.const 0))))
        )
        ;; log(-x) = NaN
        (if (i32.lt_s (local.get $hx) (i32.const 0))
          (then (return (f64.div (f64.const 0) (f64.const 0))))
        )
        ;; subnormal: scale up x
        (local.set $k (i32.sub (local.get $k) (i32.const 54)))
        (local.set $x (f64.mul (local.get $x) (f64.const 1.80143985094819840000e+16)))
        (local.set $hx (call $f64_hi (local.get $x)))
      )
    )

    ;; x = inf or NaN
    (if (i32.ge_s (local.get $hx) (i32.const 0x7FF00000))
      (then (return (f64.add (local.get $x) (local.get $x))))
    )

    ;; log(1) = +0
    (if (i32.and
          (i32.eq (local.get $hx) (i32.const 0x3FF00000))
          (i32.eqz (local.get $lx)))
      (then (return (f64.const 0)))
    )

    ;; k += (hx >> 20) - 1023
    (local.set $k (i32.add (local.get $k) (i32.sub (i32.shr_u (local.get $hx) (i32.const 20)) (i32.const 1023))))
    (local.set $hx (i32.and (local.get $hx) (i32.const 0x000FFFFF)))
    (local.set $i (i32.and (i32.add (local.get $hx) (i32.const 0x95F64)) (i32.const 0x100000)))
    ;; normalize x or x/2
    (local.set $x (call $f64_set_hi (local.get $x) (i32.or (local.get $hx) (i32.xor (local.get $i) (i32.const 0x3FF00000)))))
    (local.set $k (i32.add (local.get $k) (i32.shr_u (local.get $i) (i32.const 20))))
    (local.set $y (f64.convert_i32_s (local.get $k)))
    (local.set $f (f64.sub (local.get $x) (f64.const 1.0)))
    (local.set $hfsq (f64.mul (f64.const 0.5) (f64.mul (local.get $f) (local.get $f))))

    ;; k_log1p(f) - returns s*(hfsq+R)
    (local.set $s (f64.div (local.get $f) (f64.add (f64.const 2.0) (local.get $f))))
    (local.set $z (f64.mul (local.get $s) (local.get $s)))
    (local.set $w (f64.mul (local.get $z) (local.get $z)))
    ;; t1 = w*(Lg2 + w*(Lg4 + w*Lg6))
    (local.set $t1 (f64.mul (local.get $w)
      (f64.add (f64.const 3.999999999940941908e-01)
        (f64.mul (local.get $w)
          (f64.add (f64.const 2.222219843214978396e-01)
            (f64.mul (local.get $w) (f64.const 1.531383769920937332e-01)))))))
    ;; t2 = z*(Lg1 + w*(Lg3 + w*(Lg5 + w*Lg7)))
    (local.set $t2 (f64.mul (local.get $z)
      (f64.add (f64.const 6.666666666666735130e-01)
        (f64.mul (local.get $w)
          (f64.add (f64.const 2.857142874366239149e-01)
            (f64.mul (local.get $w)
              (f64.add (f64.const 1.818357216161805012e-01)
                (f64.mul (local.get $w) (f64.const 1.479819860511658591e-01)))))))))
    (local.set $R (f64.add (local.get $t2) (local.get $t1)))
    (local.set $r (f64.mul (local.get $s) (f64.add (local.get $hfsq) (local.get $R))))

    ;; Dekker splitting: hi = f - hfsq with low word cleared
    (local.set $hi (call $f64_trunc_lo (f64.sub (local.get $f) (local.get $hfsq))))
    (local.set $lo (f64.add (f64.sub (f64.sub (local.get $f) (local.get $hi)) (local.get $hfsq)) (local.get $r)))

    ;; val_hi = hi * ivln2hi
    ;; val_lo = (lo + hi) * ivln2lo + lo * ivln2hi
    (local.set $val_hi (f64.mul (local.get $hi) (f64.const 1.44269504072144627571e+00)))
    (local.set $val_lo (f64.add
      (f64.mul (f64.add (local.get $lo) (local.get $hi)) (f64.const 1.67517131648865118353e-10))
      (f64.mul (local.get $lo) (f64.const 1.44269504072144627571e+00))))

    ;; spadd(val_hi, val_lo, y)
    (local.set $w (f64.add (local.get $y) (local.get $val_hi)))
    (local.set $val_lo (f64.add (local.get $val_lo) (f64.add (f64.sub (local.get $y) (local.get $w)) (local.get $val_hi))))
    (local.set $val_hi (local.get $w))

    (f64.add (local.get $val_lo) (local.get $val_hi))
  )

  ;; ==========================================================================
  ;; log1p(x) = log(1+x) using V8/fdlibm algorithm (exact match to ieee754.cc)
  ;; More precise than log(1+x) for small x
  ;; ==========================================================================
  (func $f64_log1p (param $x f64) (result f64)
    (local $hx i32) (local $ax i32) (local $hu i32) (local $k i32)
    (local $f f64) (local $c f64) (local $s f64) (local $z f64) (local $R f64)
    (local $u f64) (local $hfsq f64)
    ;; Constants from V8:
    ;; ln2_hi = 6.93147180369123816490e-01  0x3FE62E42, 0xFEE00000
    ;; ln2_lo = 1.90821492927058770002e-10  0x3DEA39EF, 0x35793C76
    ;; two54  = 1.80143985094819840000e+16  0x43500000, 0x00000000
    ;; Lp1-Lp7 coefficients (same as Lg1-Lg7)

    (local.set $hx (call $f64_hi (local.get $x)))
    (local.set $ax (i32.and (local.get $hx) (i32.const 0x7FFFFFFF)))
    (local.set $k (i32.const 1))

    ;; 1+x < sqrt(2)+
    (if (i32.lt_s (local.get $hx) (i32.const 0x3FDA827A))
      (then
        ;; x <= -1.0
        (if (i32.ge_u (local.get $ax) (i32.const 0x3FF00000))
          (then
            (if (f64.eq (local.get $x) (f64.const -1.0))
              (then (return (f64.div (f64.const -1) (f64.const 0)))) ;; -inf
              (else (return (f64.div (f64.const 0) (f64.const 0)))) ;; NaN
            )
          )
        )
        ;; |x| < 2**-29
        (if (i32.lt_u (local.get $ax) (i32.const 0x3E200000))
          (then
            ;; |x| < 2**-54: return x
            (if (i32.lt_u (local.get $ax) (i32.const 0x3C900000))
              (then (return (local.get $x)))
              (else (return (f64.sub (local.get $x) (f64.mul (f64.mul (local.get $x) (local.get $x)) (f64.const 0.5)))))
            )
          )
        )
        ;; sqrt(2)/2- <= 1+x < sqrt(2)+
        (if (i32.or
              (i32.gt_s (local.get $hx) (i32.const 0))
              (i32.le_s (local.get $hx) (i32.const 0xBFD2BEC4)))
          (then
            (local.set $k (i32.const 0))
            (local.set $f (local.get $x))
            (local.set $hu (i32.const 1))
            (local.set $c (f64.const 0))
          )
        )
      )
    )

    ;; x = inf or NaN
    (if (i32.ge_s (local.get $hx) (i32.const 0x7FF00000))
      (then (return (f64.add (local.get $x) (local.get $x))))
    )

    (if (i32.ne (local.get $k) (i32.const 0))
      (then
        (if (i32.lt_s (local.get $hx) (i32.const 0x43400000))
          (then
            (local.set $u (f64.add (f64.const 1.0) (local.get $x)))
            (local.set $hu (call $f64_hi (local.get $u)))
            (local.set $k (i32.sub (i32.shr_u (local.get $hu) (i32.const 20)) (i32.const 1023)))
            ;; c = (k > 0) ? 1.0 - (u - x) : x - (u - 1.0)
            (if (i32.gt_s (local.get $k) (i32.const 0))
              (then (local.set $c (f64.sub (f64.const 1.0) (f64.sub (local.get $u) (local.get $x)))))
              (else (local.set $c (f64.sub (local.get $x) (f64.sub (local.get $u) (f64.const 1.0)))))
            )
            (local.set $c (f64.div (local.get $c) (local.get $u)))
          )
          (else
            (local.set $u (local.get $x))
            (local.set $hu (call $f64_hi (local.get $u)))
            (local.set $k (i32.sub (i32.shr_u (local.get $hu) (i32.const 20)) (i32.const 1023)))
            (local.set $c (f64.const 0))
          )
        )
        (local.set $hu (i32.and (local.get $hu) (i32.const 0x000FFFFF)))
        (if (i32.lt_u (local.get $hu) (i32.const 0x6A09E))
          (then
            ;; u ~< sqrt(2): normalize u
            (local.set $u (call $f64_set_hi (local.get $u) (i32.or (local.get $hu) (i32.const 0x3FF00000))))
          )
          (else
            ;; normalize u/2
            (local.set $k (i32.add (local.get $k) (i32.const 1)))
            (local.set $u (call $f64_set_hi (local.get $u) (i32.or (local.get $hu) (i32.const 0x3FE00000))))
            (local.set $hu (i32.shr_u (i32.sub (i32.const 0x00100000) (local.get $hu)) (i32.const 2)))
          )
        )
        (local.set $f (f64.sub (local.get $u) (f64.const 1.0)))
      )
    )

    (local.set $hfsq (f64.mul (f64.const 0.5) (f64.mul (local.get $f) (local.get $f))))

    ;; |f| < 2**-20
    (if (i32.eqz (local.get $hu))
      (then
        (if (f64.eq (local.get $f) (f64.const 0))
          (then
            (if (i32.eqz (local.get $k))
              (then (return (f64.const 0)))
              (else
                (local.set $c (f64.add (local.get $c) (f64.mul (f64.convert_i32_s (local.get $k)) (f64.const 1.90821492927058770002e-10))))
                (return (f64.add (f64.mul (f64.convert_i32_s (local.get $k)) (f64.const 6.93147180369123816490e-01)) (local.get $c)))
              )
            )
          )
        )
        (local.set $R (f64.mul (local.get $hfsq) (f64.sub (f64.const 1.0) (f64.mul (f64.const 0.66666666666666666) (local.get $f)))))
        (if (i32.eqz (local.get $k))
          (then (return (f64.sub (local.get $f) (local.get $R))))
          (else (return (f64.sub
            (f64.mul (f64.convert_i32_s (local.get $k)) (f64.const 6.93147180369123816490e-01))
            (f64.sub
              (f64.sub (local.get $R)
                (f64.add (f64.mul (f64.convert_i32_s (local.get $k)) (f64.const 1.90821492927058770002e-10)) (local.get $c)))
              (local.get $f)))))
        )
      )
    )

    (local.set $s (f64.div (local.get $f) (f64.add (f64.const 2.0) (local.get $f))))
    (local.set $z (f64.mul (local.get $s) (local.get $s)))
    ;; R = z*(Lp1 + z*(Lp2 + z*(Lp3 + z*(Lp4 + z*(Lp5 + z*(Lp6 + z*Lp7))))))
    (local.set $R (f64.mul (local.get $z)
      (f64.add (f64.const 6.666666666666735130e-01)
        (f64.mul (local.get $z)
          (f64.add (f64.const 3.999999999940941908e-01)
            (f64.mul (local.get $z)
              (f64.add (f64.const 2.857142874366239149e-01)
                (f64.mul (local.get $z)
                  (f64.add (f64.const 2.222219843214978396e-01)
                    (f64.mul (local.get $z)
                      (f64.add (f64.const 1.818357216161805012e-01)
                        (f64.mul (local.get $z)
                          (f64.add (f64.const 1.531383769920937332e-01)
                            (f64.mul (local.get $z) (f64.const 1.479819860511658591e-01)))))))))))))))

    (if (i32.eqz (local.get $k))
      (then (return (f64.sub (local.get $f) (f64.sub (local.get $hfsq) (f64.mul (local.get $s) (f64.add (local.get $hfsq) (local.get $R)))))))
      (else (return (f64.sub
        (f64.mul (f64.convert_i32_s (local.get $k)) (f64.const 6.93147180369123816490e-01))
        (f64.sub
          (f64.sub (local.get $hfsq)
            (f64.add (f64.mul (local.get $s) (f64.add (local.get $hfsq) (local.get $R)))
              (f64.add (f64.mul (f64.convert_i32_s (local.get $k)) (f64.const 1.90821492927058770002e-10)) (local.get $c))))
          (local.get $f)))))
    )
    (unreachable)
  )

  ;; ==========================================================================
  ;; Log base 10 using fdlibm algorithm
  ;; log10(x) = k*log10(2) + log10(1+f)
  ;; ==========================================================================
  (func $f64_log10 (param $x f64) (result f64)
    (local $hx i32) (local $k i32) (local $f f64) (local $s f64) (local $z f64)
    (local $R f64) (local $hfsq f64) (local $dk f64) (local $log_result f64)
    ;; ivln10   = 4.34294481903251816668e-01  (1/ln10)
    ;; log10_2hi = 3.01029995663611771306e-01
    ;; log10_2lo = 3.69423907715893078616e-13

    ;; Special cases
    (if (f64.le (local.get $x) (f64.const 0))
      (then
        (if (f64.eq (local.get $x) (f64.const 0))
          (then (return (f64.div (f64.const -1) (f64.const 0))))
        )
        (return (f64.div (f64.const 0) (f64.const 0)))
      )
    )
    (if (f64.ne (local.get $x) (local.get $x))
      (then (return (local.get $x)))
    )
    ;; Infinity returns Infinity
    (if (f64.eq (local.get $x) (f64.div (f64.const 1) (f64.const 0)))
      (then (return (local.get $x)))
    )

    ;; Extract exponent k
    (local.set $hx (call $f64_hi (local.get $x)))
    (local.set $k (i32.sub
      (i32.shr_u (i32.and (local.get $hx) (i32.const 0x7ff00000)) (i32.const 20))
      (i32.const 1023)))

    ;; Get f
    (local.set $f (f64.sub
      (call $f64_from_words
        (i32.or (i32.and (local.get $hx) (i32.const 0x000fffff)) (i32.const 0x3ff00000))
        (call $f64_lo (local.get $x)))
      (f64.const 1)))

    ;; Adjust for f > sqrt(2)-1
    (if (f64.gt (local.get $f) (f64.const 0.41421356237309504))
      (then
        (local.set $f (f64.sub (f64.mul (local.get $f) (f64.const 0.5))
                               (f64.const 0.5)))
        (local.set $k (i32.add (local.get $k) (i32.const 1)))
      )
    )

    (local.set $s (f64.div (local.get $f) (f64.add (f64.const 2) (local.get $f))))
    (local.set $z (f64.mul (local.get $s) (local.get $s)))

    (local.set $R
      (f64.mul (local.get $z)
        (f64.add (f64.const 6.666666666666735130e-01)
          (f64.mul (local.get $z)
            (f64.add (f64.const 3.999999999940941908e-01)
              (f64.mul (local.get $z)
                (f64.add (f64.const 2.857142874366239149e-01)
                  (f64.mul (local.get $z)
                    (f64.add (f64.const 2.222219843214978396e-01)
                      (f64.mul (local.get $z)
                        (f64.add (f64.const 1.818357216161805012e-01)
                          (f64.mul (local.get $z)
                            (f64.add (f64.const 1.531383769920937332e-01)
                              (f64.mul (local.get $z) (f64.const 1.479819860511658591e-01)))))))))))))))

    (local.set $hfsq (f64.mul (f64.const 0.5) (f64.mul (local.get $f) (local.get $f))))
    (local.set $dk (f64.convert_i32_s (local.get $k)))

    ;; log(1+f)
    (local.set $log_result
      (f64.sub
        (f64.add (local.get $f)
          (f64.mul (local.get $s) (f64.add (local.get $hfsq) (local.get $R))))
        (local.get $hfsq)))

    ;; result = k*log10_2 + log(1+f)/ln10
    ;; = k*log10_2hi + (k*log10_2lo + ivln10*log_result)
    (f64.add
      (f64.mul (local.get $dk) (f64.const 3.01029995663611771306e-01))  ;; k * log10_2hi
      (f64.add
        (f64.mul (local.get $dk) (f64.const 3.69423907715893078616e-13))  ;; k * log10_2lo
        (f64.mul (local.get $log_result) (f64.const 4.34294481903251816668e-01))))  ;; ivln10 * log_result
  )

  ;; ==========================================================================
  ;; Exponential function using fdlibm algorithm (exact match to e_exp.c)
  ;; Ported from Sun Microsystems fdlibm e_exp.c
  ;; ==========================================================================
  (func $f64_exp (param $x f64) (result f64)
    (local $hx i32) (local $xsb i32) (local $k i32)
    (local $hi f64) (local $lo f64) (local $t f64) (local $c f64) (local $y f64)
    ;; Constants:
    ;; o_threshold = 7.09782712893383973096e+02  (0x40862E42, 0xFEFA39EF)
    ;; u_threshold = -7.45133219101941108420e+02 (0xc0874910, 0xD52D3051)
    ;; ln2HI = 6.93147180369123816490e-01  (0x3fe62e42, 0xfee00000)
    ;; ln2LO = 1.90821492927058770002e-10  (0x3dea39ef, 0x35793c76)
    ;; invln2 = 1.44269504088896338700e+00 (0x3ff71547, 0x652b82fe)
    ;; twom1000 = 9.33263618503218878990e-302 (0x01700000, 0x00000000)

    (local.set $hx (call $f64_hi (local.get $x)))
    (local.set $xsb (i32.and (i32.shr_u (local.get $hx) (i32.const 31)) (i32.const 1)))
    (local.set $hx (i32.and (local.get $hx) (i32.const 0x7fffffff)))

    ;; Filter out non-finite argument
    (if (i32.ge_u (local.get $hx) (i32.const 0x40862E42))
      (then
        (if (i32.ge_u (local.get $hx) (i32.const 0x7ff00000))
          (then
            ;; NaN or Inf
            (if (i32.ne (i32.or (i32.and (local.get $hx) (i32.const 0xfffff)) (call $f64_lo (local.get $x))) (i32.const 0))
              (then (return (f64.add (local.get $x) (local.get $x)))) ;; NaN
            )
            (if (i32.eq (local.get $xsb) (i32.const 0))
              (then (return (local.get $x))) ;; +inf
              (else (return (f64.const 0))) ;; -inf -> 0
            )
          )
        )
        ;; Overflow
        (if (f64.gt (local.get $x) (f64.const 7.09782712893383973096e+02))
          (then (return (f64.mul (f64.const 1e300) (f64.const 1e300))))
        )
        ;; Underflow
        (if (f64.lt (local.get $x) (f64.const -7.45133219101941108420e+02))
          (then (return (f64.mul (f64.const 9.33263618503218878990e-302) (f64.const 9.33263618503218878990e-302))))
        )
      )
    )

    ;; Argument reduction
    (if (i32.gt_u (local.get $hx) (i32.const 0x3fd62e42))
      (then
        ;; |x| > 0.5*ln2
        (if (i32.lt_u (local.get $hx) (i32.const 0x3FF0A2B2))
          (then
            ;; |x| < 1.5*ln2: k = 1 - 2*xsb
            ;; Special case: exp(1) returns exact E constant (V8 does this too
            ;; because the fdlibm algorithm gets the last bit wrong)
            (if (f64.eq (local.get $x) (f64.const 1.0))
              (then (return (f64.const 2.718281828459045)))  ;; 0x4005BF0A_8B145769
            )
            (local.set $k (i32.sub (i32.const 1) (i32.shl (local.get $xsb) (i32.const 1))))
            (if (i32.eq (local.get $xsb) (i32.const 0))
              (then
                ;; x > 0: hi = x - ln2HI, lo = ln2LO
                (local.set $hi (f64.sub (local.get $x) (f64.const 6.93147180369123816490e-01)))
                (local.set $lo (f64.const 1.90821492927058770002e-10))
              )
              (else
                ;; x < 0: hi = x + ln2HI, lo = -ln2LO
                (local.set $hi (f64.add (local.get $x) (f64.const 6.93147180369123816490e-01)))
                (local.set $lo (f64.const -1.90821492927058770002e-10))
              )
            )
          )
          (else
            ;; |x| >= 1.5*ln2: k = floor(invln2*x + 0.5) or ceiling
            (if (i32.eq (local.get $xsb) (i32.const 0))
              (then
                (local.set $k (i32.trunc_f64_s
                  (f64.add (f64.mul (local.get $x) (f64.const 1.44269504088896338700e+00)) (f64.const 0.5))))
              )
              (else
                (local.set $k (i32.trunc_f64_s
                  (f64.sub (f64.mul (local.get $x) (f64.const 1.44269504088896338700e+00)) (f64.const 0.5))))
              )
            )
            (local.set $t (f64.convert_i32_s (local.get $k)))
            (local.set $hi (f64.sub (local.get $x) (f64.mul (local.get $t) (f64.const 6.93147180369123816490e-01))))
            (local.set $lo (f64.mul (local.get $t) (f64.const 1.90821492927058770002e-10)))
          )
        )
        (local.set $x (f64.sub (local.get $hi) (local.get $lo)))
      )
      (else
        (if (i32.lt_u (local.get $hx) (i32.const 0x3e300000))
          (then
            ;; |x| < 2**-28: return 1+x (trigger inexact)
            (if (f64.gt (f64.add (f64.const 1e300) (local.get $x)) (f64.const 1))
              (then (return (f64.add (f64.const 1) (local.get $x))))
            )
          )
        )
        (local.set $k (i32.const 0))
      )
    )

    ;; x is now in primary range
    (local.set $t (f64.mul (local.get $x) (local.get $x)))
    (local.set $c (f64.sub (local.get $x)
      (f64.mul (local.get $t)
        (f64.add (f64.const 1.66666666666666019037e-01)
          (f64.mul (local.get $t)
            (f64.add (f64.const -2.77777777770155933842e-03)
              (f64.mul (local.get $t)
                (f64.add (f64.const 6.61375632143793436117e-05)
                  (f64.mul (local.get $t)
                    (f64.add (f64.const -1.65339022054652515390e-06)
                      (f64.mul (local.get $t) (f64.const 4.13813679705723846039e-08))))))))))))

    (if (i32.eq (local.get $k) (i32.const 0))
      (then
        ;; return 1 - ((x*c)/(c-2) - x)
        (return (f64.sub (f64.const 1)
          (f64.sub
            (f64.div (f64.mul (local.get $x) (local.get $c))
                     (f64.sub (local.get $c) (f64.const 2)))
            (local.get $x))))
      )
      (else
        ;; y = 1 - ((lo - (x*c)/(2-c)) - hi)
        (local.set $y (f64.sub (f64.const 1)
          (f64.sub
            (f64.sub (local.get $lo)
              (f64.div (f64.mul (local.get $x) (local.get $c))
                       (f64.sub (f64.const 2) (local.get $c))))
            (local.get $hi))))
        ;; Scale by 2^k
        (return (call $scalbn (local.get $y) (local.get $k)))
      )
    )
    (unreachable)
  )

  ;; ==========================================================================
  ;; ==========================================================================
  ;; Sine and Cosine using fdlibm algorithm (sub-ULP accuracy)
  ;; Ported from Sun Microsystems fdlibm k_sin.c, k_cos.c, s_sin.c, e_rem_pio2.c
  ;; ==========================================================================

  ;; Kernel sine: compute sin(x) for x in [-pi/4, pi/4]
  ;; Uses fdlibm minimax polynomial coefficients (degree 13)
  ;; Error bound: |sin(x)/x - poly| <= 2^-58
  ;; kernel_sin(x, y, iy) - V8/fdlibm kernel sine
  ;; x is the reduced argument, y is the tail, iy indicates if y is valid (iy=1 means use y)
  (func $kernel_sin (param $x f64) (param $y f64) (param $iy i32) (result f64)
    (local $z f64) (local $v f64) (local $r f64) (local $ix i32)
    ;; fdlibm coefficients (minimax, NOT Taylor)
    ;; S1 = -1.66666666666666324348e-01  (0xBFC55555, 0x55555549)
    ;; S2 =  8.33333333332248946124e-03  (0x3F811111, 0x1110F8A6)
    ;; S3 = -1.98412698298579493134e-04  (0xBF2A01A0, 0x19C161D5)
    ;; S4 =  2.75573137070700676789e-06  (0x3EC71DE3, 0x57B1FE7D)
    ;; S5 = -2.50507602534068634195e-08  (0xBE5AE5E6, 0x8A2B9CEB)
    ;; S6 =  1.58969099521155010221e-10  (0x3DE5D93A, 0x5ACFD57C)

    (local.set $ix (i32.and (call $f64_hi (local.get $x)) (i32.const 0x7FFFFFFF)))

    ;; |x| < 2^-27: return x (with inexact)
    (if (i32.lt_u (local.get $ix) (i32.const 0x3E400000))
      (then (return (local.get $x)))
    )

    (local.set $z (f64.mul (local.get $x) (local.get $x)))
    (local.set $v (f64.mul (local.get $z) (local.get $x)))

    ;; r = S2 + z*(S3 + z*(S4 + z*(S5 + z*S6)))
    (local.set $r
      (f64.add (f64.const 8.33333333332248946124e-03)
        (f64.mul (local.get $z)
          (f64.add (f64.const -1.98412698298579493134e-04)
            (f64.mul (local.get $z)
              (f64.add (f64.const 2.75573137070700676789e-06)
                (f64.mul (local.get $z)
                  (f64.add (f64.const -2.50507602534068634195e-08)
                    (f64.mul (local.get $z) (f64.const 1.58969099521155010221e-10))))))))))

    ;; if iy == 0: return x + v*(S1 + z*r)
    ;; if iy != 0: return x - ((z*(half*y - v*r) - y) - v*S1)
    (if (i32.eqz (local.get $iy))
      (then
        (return (f64.add (local.get $x)
          (f64.mul (local.get $v)
            (f64.add (f64.const -1.66666666666666324348e-01)
              (f64.mul (local.get $z) (local.get $r))))))
      )
      (else
        (return (f64.sub (local.get $x)
          (f64.sub
            (f64.sub
              (f64.mul (local.get $z)
                (f64.sub (f64.mul (f64.const 0.5) (local.get $y))
                  (f64.mul (local.get $v) (local.get $r))))
              (local.get $y))
            (f64.mul (local.get $v) (f64.const -1.66666666666666324348e-01)))))
      )
    )
    (unreachable)
  )

  ;; kernel_cos(x, y) - V8/fdlibm kernel cosine
  ;; x is the reduced argument, y is the tail
  (func $kernel_cos (param $x f64) (param $y f64) (result f64)
    (local $z f64) (local $r f64) (local $ix i32) (local $qx f64) (local $iz f64) (local $a f64)
    ;; fdlibm coefficients (minimax, NOT Taylor)
    ;; C1 =  4.16666666666666019037e-02  (0x3FA55555, 0x5555554C)
    ;; C2 = -1.38888888888741095749e-03  (0xBF56C16C, 0x16C15177)
    ;; C3 =  2.48015872894767294178e-05  (0x3EFA01A0, 0x19CB1590)
    ;; C4 = -2.75573143513906633035e-07  (0xBE927E4F, 0x809C52AD)
    ;; C5 =  2.08757232129817482790e-09  (0x3E21EE9E, 0xBDB4B1C4)
    ;; C6 = -1.13596475577881948265e-11  (0xBDA8FAE9, 0xBE8838D4)

    (local.set $ix (i32.and (call $f64_hi (local.get $x)) (i32.const 0x7FFFFFFF)))

    ;; |x| < 2^-27: return 1
    (if (i32.lt_u (local.get $ix) (i32.const 0x3E400000))
      (then (return (f64.const 1)))
    )

    (local.set $z (f64.mul (local.get $x) (local.get $x)))
    ;; r = z*(C1 + z*(C2 + z*(C3 + z*(C4 + z*(C5 + z*C6)))))
    (local.set $r
      (f64.mul (local.get $z)
        (f64.add (f64.const 4.16666666666666019037e-02)
          (f64.mul (local.get $z)
            (f64.add (f64.const -1.38888888888741095749e-03)
              (f64.mul (local.get $z)
                (f64.add (f64.const 2.48015872894767294178e-05)
                  (f64.mul (local.get $z)
                    (f64.add (f64.const -2.75573143513906633035e-07)
                      (f64.mul (local.get $z)
                        (f64.add (f64.const 2.08757232129817482790e-09)
                          (f64.mul (local.get $z) (f64.const -1.13596475577881948265e-11)))))))))))))

    ;; if |x| < 0.3: return 1 - (0.5*z - (z*r - x*y))
    (if (i32.lt_u (local.get $ix) (i32.const 0x3FD33333))
      (then
        (return (f64.sub (f64.const 1)
          (f64.sub (f64.mul (f64.const 0.5) (local.get $z))
            (f64.sub (f64.mul (local.get $z) (local.get $r))
              (f64.mul (local.get $x) (local.get $y))))))
      )
    )

    ;; |x| >= 0.3
    (if (i32.gt_u (local.get $ix) (i32.const 0x3FE90000))
      (then
        ;; x > 0.78125: qx = 0.28125
        (local.set $qx (f64.const 0.28125))
      )
      (else
        ;; qx = x/4 (clear low 20 bits, subtract 2 from exponent)
        (local.set $qx (call $f64_from_words (i32.sub (local.get $ix) (i32.const 0x00200000)) (i32.const 0)))
      )
    )
    (local.set $iz (f64.sub (f64.mul (f64.const 0.5) (local.get $z)) (local.get $qx)))
    (local.set $a (f64.sub (f64.const 1) (local.get $qx)))
    (f64.sub (local.get $a)
      (f64.sub (local.get $iz)
        (f64.sub (f64.mul (local.get $z) (local.get $r))
          (f64.mul (local.get $x) (local.get $y)))))
  )

  ;; Range reduction: reduce x to [-pi/4, pi/4] and return quadrant
  ;; Returns n (quadrant info), stores y[0] in $rem_pio2_y0, y[1] in $rem_pio2_y1
  ;; Follows V8/fdlibm algorithm for high precision
  (func $rem_pio2 (param $x f64) (result i32)
    (local $hx i32) (local $ix i32) (local $n i32)
    (local $z f64) (local $r f64) (local $w f64) (local $t f64) (local $fn f64)
    (local $y0 f64) (local $y1 f64)
    ;; Constants from V8:
    ;; invpio2 = 6.36619772367581382433e-01  0x3FE45F30, 0x6DC9C883
    ;; pio2_1  = 1.57079632673412561417e+00  0x3FF921FB, 0x54400000
    ;; pio2_1t = 6.07710050650619224932e-11  0x3DD0B461, 0x1A626331
    ;; pio2_2  = 6.07710050630396597660e-11  0x3DD0B461, 0x1A600000
    ;; pio2_2t = 2.02226624879595063154e-21  0x3BA3198A, 0x2E037073
    ;; pio2_3  = 2.02226624871116645580e-21  0x3BA3198A, 0x2E000000
    ;; pio2_3t = 8.47842766036889956997e-32  0x397B839A, 0x252049C1

    (local.set $hx (call $f64_hi (local.get $x)))
    (local.set $ix (i32.and (local.get $hx) (i32.const 0x7FFFFFFF)))

    ;; |x| ~<= pi/4, no reduction needed
    (if (i32.le_s (local.get $ix) (i32.const 0x3FE921FB))
      (then
        (global.set $rem_pio2_y0 (local.get $x))
        (global.set $rem_pio2_y1 (f64.const 0))
        (return (i32.const 0))
      )
    )

    ;; |x| < 3pi/4, special case with n=+-1
    (if (i32.lt_s (local.get $ix) (i32.const 0x4002D97C))
      (then
        (if (i32.gt_s (local.get $hx) (i32.const 0))
          (then
            ;; x > 0
            (local.set $z (f64.sub (local.get $x) (f64.const 1.57079632673412561417e+00)))
            (if (i32.ne (local.get $ix) (i32.const 0x3FF921FB))
              (then
                ;; 33+53 bit pi is good enough
                (local.set $y0 (f64.sub (local.get $z) (f64.const 6.07710050650619224932e-11)))
                (local.set $y1 (f64.sub (f64.sub (local.get $z) (local.get $y0)) (f64.const 6.07710050650619224932e-11)))
              )
              (else
                ;; near pi/2, use 33+33+53 bit pi
                (local.set $z (f64.sub (local.get $z) (f64.const 6.07710050630396597660e-11)))
                (local.set $y0 (f64.sub (local.get $z) (f64.const 2.02226624879595063154e-21)))
                (local.set $y1 (f64.sub (f64.sub (local.get $z) (local.get $y0)) (f64.const 2.02226624879595063154e-21)))
              )
            )
            (global.set $rem_pio2_y0 (local.get $y0))
            (global.set $rem_pio2_y1 (local.get $y1))
            (return (i32.const 1))
          )
          (else
            ;; x < 0
            (local.set $z (f64.add (local.get $x) (f64.const 1.57079632673412561417e+00)))
            (if (i32.ne (local.get $ix) (i32.const 0x3FF921FB))
              (then
                ;; 33+53 bit pi is good enough
                (local.set $y0 (f64.add (local.get $z) (f64.const 6.07710050650619224932e-11)))
                (local.set $y1 (f64.add (f64.sub (local.get $z) (local.get $y0)) (f64.const 6.07710050650619224932e-11)))
              )
              (else
                ;; near pi/2, use 33+33+53 bit pi
                (local.set $z (f64.add (local.get $z) (f64.const 6.07710050630396597660e-11)))
                (local.set $y0 (f64.add (local.get $z) (f64.const 2.02226624879595063154e-21)))
                (local.set $y1 (f64.add (f64.sub (local.get $z) (local.get $y0)) (f64.const 2.02226624879595063154e-21)))
              )
            )
            (global.set $rem_pio2_y0 (local.get $y0))
            (global.set $rem_pio2_y1 (local.get $y1))
            (return (i32.const -1))
          )
        )
        (unreachable)
      )
    )

    ;; |x| ~<= 2^19*(pi/2), medium size - most common case
    (if (i32.le_s (local.get $ix) (i32.const 0x413921FB))
      (then
        (local.set $t (f64.abs (local.get $x)))
        (local.set $n (i32.trunc_f64_s (f64.add (f64.mul (local.get $t) (f64.const 6.36619772367581382433e-01)) (f64.const 0.5))))
        (local.set $fn (f64.convert_i32_s (local.get $n)))
        (local.set $r (f64.sub (local.get $t) (f64.mul (local.get $fn) (f64.const 1.57079632673412561417e+00))))
        (local.set $w (f64.mul (local.get $fn) (f64.const 6.07710050650619224932e-11)))
        (local.set $y0 (f64.sub (local.get $r) (local.get $w)))
        (local.set $y1 (f64.sub (f64.sub (local.get $r) (local.get $y0)) (local.get $w)))
        ;; Check if we need more precision (cancellation check)
        ;; j - i > 16 means significant cancellation occurred
        (if (i32.gt_s
              (i32.sub
                (i32.shr_u (local.get $ix) (i32.const 20))
                (i32.and (i32.shr_u (call $f64_hi (local.get $y0)) (i32.const 20)) (i32.const 0x7FF)))
              (i32.const 16))
          (then
            ;; 2nd iteration needed, good to 118 bits
            (local.set $t (local.get $r))
            (local.set $w (f64.mul (local.get $fn) (f64.const 6.07710050630396597660e-11)))
            (local.set $r (f64.sub (local.get $t) (local.get $w)))
            (local.set $w (f64.sub (f64.mul (local.get $fn) (f64.const 2.02226624879595063154e-21)) (f64.sub (f64.sub (local.get $t) (local.get $r)) (local.get $w))))
            (local.set $y0 (f64.sub (local.get $r) (local.get $w)))
            ;; Check if 3rd iteration needed
            (if (i32.gt_s
                  (i32.sub
                    (i32.shr_u (local.get $ix) (i32.const 20))
                    (i32.and (i32.shr_u (call $f64_hi (local.get $y0)) (i32.const 20)) (i32.const 0x7FF)))
                  (i32.const 49))
              (then
                ;; 3rd iteration, 151 bits accuracy
                (local.set $t (local.get $r))
                (local.set $w (f64.mul (local.get $fn) (f64.const 2.02226624871116645580e-21)))
                (local.set $r (f64.sub (local.get $t) (local.get $w)))
                (local.set $w (f64.sub (f64.mul (local.get $fn) (f64.const 8.47842766036889956997e-32)) (f64.sub (f64.sub (local.get $t) (local.get $r)) (local.get $w))))
                (local.set $y0 (f64.sub (local.get $r) (local.get $w)))
              )
            )
            (local.set $y1 (f64.sub (f64.sub (local.get $r) (local.get $y0)) (local.get $w)))
          )
        )
        ;; Apply sign
        (if (i32.lt_s (local.get $hx) (i32.const 0))
          (then
            (global.set $rem_pio2_y0 (f64.neg (local.get $y0)))
            (global.set $rem_pio2_y1 (f64.neg (local.get $y1)))
            (return (i32.sub (i32.const 0) (local.get $n)))
          )
          (else
            (global.set $rem_pio2_y0 (local.get $y0))
            (global.set $rem_pio2_y1 (local.get $y1))
            (return (local.get $n))
          )
        )
        (unreachable)
      )
    )

    ;; |x| is inf or NaN
    (if (i32.ge_s (local.get $ix) (i32.const 0x7FF00000))
      (then
        (local.set $y0 (f64.sub (local.get $x) (local.get $x)))
        (global.set $rem_pio2_y0 (local.get $y0))
        (global.set $rem_pio2_y1 (local.get $y0))
        (return (i32.const 0))
      )
    )

    ;; For very large |x| > 2^19*(pi/2), use simpler reduction
    ;; (The full V8 uses __kernel_rem_pio2 with extended precision tables)
    ;; For now, use iterative reduction which is less precise but works.
    (local.set $t (f64.abs (local.get $x)))
    ;; The iterative reduction needs n = round(t * 2/pi) to fit an i32.
    ;; Beyond that (|x| >= ~3.4e9) there is no usable reduction here:
    ;; the raw trunc TRAPPED the module (Math.sin(1e300) used to kill
    ;; the interpreter), and a saturated n yields a "remainder" of
    ;; ~1e300 that the kernels turn into sin(x) > 1 — garbage that
    ;; silently violates the trig range contract. Return NaN instead:
    ;; loud, honest, and range-preserving. (Exact reduction at this
    ;; magnitude needs __kernel_rem_pio2 — still future work.)
    (if (f64.ge (f64.mul (local.get $t) (f64.const 6.36619772367581382433e-01))
          (f64.const 2147483520))
      (then
        (global.set $rem_pio2_y0 (f64.div (f64.const 0) (f64.const 0)))
        (global.set $rem_pio2_y1 (f64.const 0))
        (return (i32.const 0))
      )
    )
    (local.set $n (i32.trunc_sat_f64_s (f64.add (f64.mul (local.get $t) (f64.const 6.36619772367581382433e-01)) (f64.const 0.5))))
    (local.set $fn (f64.convert_i32_s (local.get $n)))
    (local.set $r (f64.sub (local.get $t) (f64.mul (local.get $fn) (f64.const 1.57079632673412561417e+00))))
    (local.set $w (f64.mul (local.get $fn) (f64.const 6.07710050650619224932e-11)))
    (local.set $r (f64.sub (local.get $r) (local.get $w)))
    (local.set $w (f64.mul (local.get $fn) (f64.const 6.07710050630396597660e-11)))
    (local.set $r (f64.sub (local.get $r) (local.get $w)))
    (local.set $w (f64.mul (local.get $fn) (f64.const 2.02226624879595063154e-21)))
    (local.set $y0 (f64.sub (local.get $r) (local.get $w)))
    (local.set $y1 (f64.sub (f64.sub (local.get $r) (local.get $y0)) (local.get $w)))
    (if (i32.lt_s (local.get $hx) (i32.const 0))
      (then
        (global.set $rem_pio2_y0 (f64.neg (local.get $y0)))
        (global.set $rem_pio2_y1 (f64.neg (local.get $y1)))
        (return (i32.sub (i32.const 0) (local.get $n)))
      )
      (else
        (global.set $rem_pio2_y0 (local.get $y0))
        (global.set $rem_pio2_y1 (local.get $y1))
        (return (local.get $n))
      )
    )
    (unreachable)
  )

  ;; Globals to store rem_pio2 results (y[0] and y[1])
  (global $rem_pio2_y0 (mut f64) (f64.const 0))
  (global $rem_pio2_y1 (mut f64) (f64.const 0))
  ;; Keep old name for compatibility during transition
  (global $rem_pio2_result (mut f64) (f64.const 0))

  ;; ==========================================================================
  ;; expm1(x) = exp(x) - 1 using V8/fdlibm algorithm
  ;; More accurate than exp(x) - 1 for small x
  ;; ==========================================================================
  (func $f64_expm1 (param $x f64) (result f64)
    (local $hx i32) (local $xsb i32) (local $k i32)
    (local $y f64) (local $hi f64) (local $lo f64) (local $c f64)
    (local $t f64) (local $e f64) (local $hxs f64) (local $hfx f64) (local $r1 f64) (local $twopk f64)
    ;; Constants from V8:
    ;; o_threshold = 7.09782712893383973096e+02  0x40862E42, 0xFEFA39EF
    ;; ln2_hi = 6.93147180369123816490e-01      0x3FE62E42, 0xFEE00000
    ;; ln2_lo = 1.90821492927058770002e-10      0x3DEA39EF, 0x35793C76
    ;; invln2 = 1.44269504088896338700e+00      0x3FF71547, 0x652B82FE
    ;; Q1-Q5 coefficients

    (local.set $hx (call $f64_hi (local.get $x)))
    (local.set $xsb (i32.and (local.get $hx) (i32.const 0x80000000)))
    (local.set $hx (i32.and (local.get $hx) (i32.const 0x7FFFFFFF)))

    ;; Filter out huge and non-finite argument
    (if (i32.ge_u (local.get $hx) (i32.const 0x4043687A))
      (then
        (if (i32.ge_u (local.get $hx) (i32.const 0x40862E42))
          (then
            ;; inf or NaN
            (if (i32.ge_u (local.get $hx) (i32.const 0x7FF00000))
              (then
                (if (i32.ne (i32.or (i32.and (local.get $hx) (i32.const 0xFFFFF)) (call $f64_lo (local.get $x))) (i32.const 0))
                  (then (return (f64.add (local.get $x) (local.get $x)))) ;; NaN
                )
                (if (i32.eqz (local.get $xsb))
                  (then (return (local.get $x))) ;; +inf
                  (else (return (f64.const -1))) ;; -inf -> -1
                )
              )
            )
            ;; overflow
            (if (f64.gt (local.get $x) (f64.const 7.09782712893383973096e+02))
              (then (return (f64.mul (f64.const 1e300) (f64.const 1e300))))
            )
          )
        )
        ;; x < -56*ln2: return -1 with inexact
        (if (i32.ne (local.get $xsb) (i32.const 0))
          (then (return (f64.sub (f64.const 1e-300) (f64.const 1))))
        )
      )
    )

    ;; Argument reduction
    (if (i32.gt_u (local.get $hx) (i32.const 0x3FD62E42))
      (then
        (if (i32.lt_u (local.get $hx) (i32.const 0x3FF0A2B2))
          (then
            ;; |x| < 1.5*ln2
            (if (i32.eqz (local.get $xsb))
              (then
                (local.set $hi (f64.sub (local.get $x) (f64.const 6.93147180369123816490e-01)))
                (local.set $lo (f64.const 1.90821492927058770002e-10))
                (local.set $k (i32.const 1))
              )
              (else
                (local.set $hi (f64.add (local.get $x) (f64.const 6.93147180369123816490e-01)))
                (local.set $lo (f64.const -1.90821492927058770002e-10))
                (local.set $k (i32.const -1))
              )
            )
          )
          (else
            ;; |x| >= 1.5*ln2
            (if (i32.eqz (local.get $xsb))
              (then (local.set $k (i32.trunc_f64_s (f64.add (f64.mul (f64.const 1.44269504088896338700e+00) (local.get $x)) (f64.const 0.5)))))
              (else (local.set $k (i32.trunc_f64_s (f64.sub (f64.mul (f64.const 1.44269504088896338700e+00) (local.get $x)) (f64.const 0.5)))))
            )
            (local.set $t (f64.convert_i32_s (local.get $k)))
            (local.set $hi (f64.sub (local.get $x) (f64.mul (local.get $t) (f64.const 6.93147180369123816490e-01))))
            (local.set $lo (f64.mul (local.get $t) (f64.const 1.90821492927058770002e-10)))
          )
        )
        (local.set $x (f64.sub (local.get $hi) (local.get $lo)))
        (local.set $c (f64.sub (f64.sub (local.get $hi) (local.get $x)) (local.get $lo)))
      )
      (else
        ;; |x| < 2**-54: return x
        (if (i32.lt_u (local.get $hx) (i32.const 0x3C900000))
          (then (return (local.get $x)))
        )
        (local.set $k (i32.const 0))
        (local.set $c (f64.const 0))
      )
    )

    ;; x is now in primary range
    (local.set $hfx (f64.mul (f64.const 0.5) (local.get $x)))
    (local.set $hxs (f64.mul (local.get $x) (local.get $hfx)))
    ;; r1 = 1 + hxs*(Q1 + hxs*(Q2 + hxs*(Q3 + hxs*(Q4 + hxs*Q5))))
    (local.set $r1 (f64.add (f64.const 1)
      (f64.mul (local.get $hxs)
        (f64.add (f64.const -3.33333333333331316428e-02)
          (f64.mul (local.get $hxs)
            (f64.add (f64.const 1.58730158725481460165e-03)
              (f64.mul (local.get $hxs)
                (f64.add (f64.const -7.93650757867487942473e-05)
                  (f64.mul (local.get $hxs)
                    (f64.add (f64.const 4.00821782732936239552e-06)
                      (f64.mul (local.get $hxs) (f64.const -2.01099218183624371326e-07))))))))))))
    (local.set $t (f64.sub (f64.const 3.0) (f64.mul (local.get $r1) (local.get $hfx))))
    (local.set $e (f64.mul (local.get $hxs) (f64.div (f64.sub (local.get $r1) (local.get $t)) (f64.sub (f64.const 6.0) (f64.mul (local.get $x) (local.get $t))))))

    (if (i32.eqz (local.get $k))
      (then (return (f64.sub (local.get $x) (f64.sub (f64.mul (local.get $x) (local.get $e)) (local.get $hxs)))))
    )

    ;; 2^k
    (local.set $twopk (call $f64_from_words
      (i32.add (i32.const 0x3FF00000) (i32.shl (local.get $k) (i32.const 20)))
      (i32.const 0)))
    (local.set $e (f64.sub (f64.mul (local.get $x) (f64.sub (local.get $e) (local.get $c))) (local.get $c)))
    (local.set $e (f64.sub (local.get $e) (local.get $hxs)))

    (if (i32.eq (local.get $k) (i32.const -1))
      (then (return (f64.sub (f64.mul (f64.const 0.5) (f64.sub (local.get $x) (local.get $e))) (f64.const 0.5))))
    )
    (if (i32.eq (local.get $k) (i32.const 1))
      (then
        (if (f64.lt (local.get $x) (f64.const -0.25))
          (then (return (f64.mul (f64.const -2.0) (f64.sub (local.get $e) (f64.add (local.get $x) (f64.const 0.5))))))
          (else (return (f64.add (f64.const 1) (f64.mul (f64.const 2.0) (f64.sub (local.get $x) (local.get $e))))))
        )
      )
    )

    ;; k <= -2 or k > 56: return exp(x) - 1
    (if (i32.or (i32.le_s (local.get $k) (i32.const -2)) (i32.gt_s (local.get $k) (i32.const 56)))
      (then
        (local.set $y (f64.sub (f64.const 1) (f64.sub (local.get $e) (local.get $x))))
        (if (i32.eq (local.get $k) (i32.const 1024))
          (then (local.set $y (f64.mul (f64.mul (local.get $y) (f64.const 2.0)) (f64.const 8.98846567431158e+307))))
          (else (local.set $y (f64.mul (local.get $y) (local.get $twopk))))
        )
        (return (f64.sub (local.get $y) (f64.const 1)))
      )
    )

    (if (i32.lt_s (local.get $k) (i32.const 20))
      (then
        ;; t = 1 - 2^-k
        (local.set $t (call $f64_from_words
          (i32.sub (i32.const 0x3FF00000) (i32.shr_u (i32.const 0x200000) (local.get $k)))
          (i32.const 0)))
        (local.set $y (f64.sub (local.get $t) (f64.sub (local.get $e) (local.get $x))))
        (local.set $y (f64.mul (local.get $y) (local.get $twopk)))
      )
      (else
        ;; t = 2^-k
        (local.set $t (call $f64_from_words
          (i32.shl (i32.sub (i32.const 0x3FF) (local.get $k)) (i32.const 20))
          (i32.const 0)))
        (local.set $y (f64.add (f64.sub (local.get $x) (f64.add (local.get $e) (local.get $t))) (f64.const 1)))
        (local.set $y (f64.mul (local.get $y) (local.get $twopk)))
      )
    )
    (local.get $y)
  )

  ;; ==========================================================================
  ;; tanh(x) using V8/fdlibm algorithm with expm1
  ;; ==========================================================================
  (func $f64_tanh (param $x f64) (result f64)
    (local $jx i32) (local $ix i32) (local $t f64) (local $z f64)

    (local.set $jx (call $f64_hi (local.get $x)))
    (local.set $ix (i32.and (local.get $jx) (i32.const 0x7FFFFFFF)))

    ;; |x| >= INF
    (if (i32.ge_u (local.get $ix) (i32.const 0x7FF00000))
      (then
        (if (i32.ge_s (local.get $jx) (i32.const 0))
          (then (return (f64.add (f64.div (f64.const 1) (local.get $x)) (f64.const 1)))) ;; tanh(+inf) = 1
          (else (return (f64.sub (f64.div (f64.const 1) (local.get $x)) (f64.const 1)))) ;; tanh(-inf) = -1, tanh(NaN) = NaN
        )
      )
    )

    ;; |x| < 22
    (if (i32.lt_u (local.get $ix) (i32.const 0x40360000))
      (then
        ;; |x| < 2**-28: return x with inexact
        (if (i32.lt_u (local.get $ix) (i32.const 0x3E300000))
          (then (return (local.get $x)))
        )
        ;; |x| >= 1
        (if (i32.ge_u (local.get $ix) (i32.const 0x3FF00000))
          (then
            (local.set $t (call $f64_expm1 (f64.mul (f64.const 2) (f64.abs (local.get $x)))))
            (local.set $z (f64.sub (f64.const 1) (f64.div (f64.const 2) (f64.add (local.get $t) (f64.const 2)))))
          )
          (else
            ;; |x| < 1
            (local.set $t (call $f64_expm1 (f64.neg (f64.mul (f64.const 2) (f64.abs (local.get $x))))))
            (local.set $z (f64.div (f64.neg (local.get $t)) (f64.add (local.get $t) (f64.const 2))))
          )
        )
      )
      (else
        ;; |x| >= 22: return +-1
        (local.set $z (f64.sub (f64.const 1) (f64.const 1e-300)))
      )
    )

    (if (i32.ge_s (local.get $jx) (i32.const 0))
      (then (return (local.get $z)))
      (else (return (f64.neg (local.get $z))))
    )
    (unreachable)
  )

  ;; ==========================================================================
  ;; sinh(x) using V8 algorithm with expm1
  ;; ==========================================================================
  (func $f64_sinh (param $x f64) (result f64)
    (local $h f64) (local $ax f64) (local $t f64) (local $w f64)
    ;; Constants from V8:
    ;; TWO_M28 = 3.725290298461914e-9  (2^-28)
    ;; LOG_MAXD = 709.7822265625
    ;; KSINH_OVERFLOW = 710.4758600739439

    (local.set $h (select (f64.const -0.5) (f64.const 0.5) (f64.lt (local.get $x) (f64.const 0))))
    (local.set $ax (f64.abs (local.get $x)))

    ;; |x| < 22
    (if (f64.lt (local.get $ax) (f64.const 22))
      (then
        ;; |x| < 2^-28: return x
        (if (f64.lt (local.get $ax) (f64.const 3.725290298461914e-9))
          (then (return (local.get $x)))
        )
        (local.set $t (call $f64_expm1 (local.get $ax)))
        (if (f64.lt (local.get $ax) (f64.const 1))
          (then
            ;; h * (2*t - t*t/(t+1))
            (return (f64.mul (local.get $h)
              (f64.sub
                (f64.mul (f64.const 2) (local.get $t))
                (f64.div (f64.mul (local.get $t) (local.get $t)) (f64.add (local.get $t) (f64.const 1))))))
          )
          (else
            ;; h * (t + t/(t+1))
            (return (f64.mul (local.get $h)
              (f64.add (local.get $t) (f64.div (local.get $t) (f64.add (local.get $t) (f64.const 1))))))
          )
        )
      )
    )

    ;; |x| in [22, log(maxdouble)]
    (if (f64.lt (local.get $ax) (f64.const 709.7822265625))
      (then (return (f64.mul (local.get $h) (call $f64_exp (local.get $ax)))))
    )

    ;; |x| in [log(maxdouble), overflowthreshold]
    (if (f64.le (local.get $ax) (f64.const 710.4758600739439))
      (then
        (local.set $w (call $f64_exp (f64.mul (f64.const 0.5) (local.get $ax))))
        (local.set $t (f64.mul (local.get $h) (local.get $w)))
        (return (f64.mul (local.get $t) (local.get $w)))
      )
    )

    ;; overflow or NaN
    (f64.mul (local.get $x) (f64.const 1e307))
  )

  ;; ==========================================================================
  ;; asinh(x) using V8 algorithm with log1p
  ;; ==========================================================================
  (func $f64_asinh (param $x f64) (result f64)
    (local $hx i32) (local $ix i32) (local $t f64) (local $w f64)
    ;; Constants from V8:
    ;; ln2 = 6.93147180559945286227e-01

    (local.set $hx (call $f64_hi (local.get $x)))
    (local.set $ix (i32.and (local.get $hx) (i32.const 0x7FFFFFFF)))

    ;; inf or NaN
    (if (i32.ge_u (local.get $ix) (i32.const 0x7FF00000))
      (then (return (f64.add (local.get $x) (local.get $x))))
    )

    ;; |x| < 2^-28: return x with inexact
    (if (i32.lt_u (local.get $ix) (i32.const 0x3E300000))
      (then (return (local.get $x)))
    )

    ;; |x| > 2^28
    (if (i32.gt_u (local.get $ix) (i32.const 0x41B00000))
      (then
        (local.set $w (f64.add (call $f64_log (f64.abs (local.get $x))) (f64.const 6.93147180559945286227e-01)))
      )
      (else
        ;; 2^28 > |x| > 2.0
        (if (i32.gt_u (local.get $ix) (i32.const 0x40000000))
          (then
            (local.set $t (f64.abs (local.get $x)))
            (local.set $w (call $f64_log (f64.add
              (f64.mul (f64.const 2) (local.get $t))
              (f64.div (f64.const 1) (f64.add (f64.sqrt (f64.add (f64.mul (local.get $x) (local.get $x)) (f64.const 1))) (local.get $t))))))
          )
          (else
            ;; 2.0 > |x| > 2^-28
            (local.set $t (f64.mul (local.get $x) (local.get $x)))
            (local.set $w (call $f64_log1p (f64.add
              (f64.abs (local.get $x))
              (f64.div (local.get $t) (f64.add (f64.const 1) (f64.sqrt (f64.add (f64.const 1) (local.get $t))))))))
          )
        )
      )
    )

    (if (i32.gt_s (local.get $hx) (i32.const 0))
      (then (return (local.get $w)))
      (else (return (f64.neg (local.get $w))))
    )
    (unreachable)
  )

  ;; ==========================================================================
  ;; kernel_tan(x, y, iy) - V8/fdlibm kernel tangent on [-pi/4, pi/4]
  ;; iy=1: return tan(x+y), iy=-1: return -1/tan(x+y)
  ;; ==========================================================================
  (func $kernel_tan (param $x f64) (param $y f64) (param $iy i32) (result f64)
    (local $hx i32) (local $ix i32) (local $low i32)
    (local $z f64) (local $r f64) (local $v f64) (local $w f64) (local $s f64)
    (local $a f64) (local $t f64)
    ;; T0-T12 coefficients from V8
    ;; T0  = 3.33333333333334091986e-01   0x3FD55555, 0x55555563
    ;; T1  = 1.33333333333201242699e-01   0x3FC11111, 0x1110FE7A
    ;; T2  = 5.39682539762260521377e-02   0x3FABA1BA, 0x1BB341FE
    ;; T3  = 2.18694882948595424599e-02   0x3F9664F4, 0x8406D637
    ;; T4  = 8.86323982359930005737e-03   0x3F8226E3, 0xE96E8493
    ;; T5  = 3.59207910759131235356e-03   0x3F6D6D22, 0xC9560328
    ;; T6  = 1.45620945432529025516e-03   0x3F57DBC8, 0xFEE08315
    ;; T7  = 5.88041240820264096874e-04   0x3F4344D8, 0xF2F26501
    ;; T8  = 2.46463134818469906812e-04   0x3F3026F7, 0x1A8D1068
    ;; T9  = 7.81794442939557092300e-05   0x3F147E88, 0xA03792A6
    ;; T10 = 7.14072491382608190305e-05   0x3F12B80F, 0x32F0A7E9
    ;; T11 = -1.85586374855275456654e-05  0xBEF375CB, 0xDB605373
    ;; T12 = 2.59073051863633712884e-05   0x3EFB2A70, 0x74BF7AD4
    ;; pio4    = 7.85398163397448278999e-01  0x3FE921FB, 0x54442D18
    ;; pio4lo  = 3.06161699786838301793e-17  0x3C81A626, 0x33145C07

    (local.set $hx (call $f64_hi (local.get $x)))
    (local.set $ix (i32.and (local.get $hx) (i32.const 0x7FFFFFFF)))

    ;; |x| < 2^-28
    (if (i32.lt_u (local.get $ix) (i32.const 0x3E300000))
      (then
        (local.set $low (call $f64_lo (local.get $x)))
        (if (i32.eqz (i32.or (i32.or (local.get $ix) (local.get $low)) (i32.add (local.get $iy) (i32.const 1))))
          (then (return (f64.div (f64.const 1) (f64.abs (local.get $x)))))
        )
        (if (i32.eq (local.get $iy) (i32.const 1))
          (then (return (local.get $x)))
          (else
            ;; compute -1/(x+y) carefully
            (local.set $z (f64.add (local.get $x) (local.get $y)))
            (local.set $w (local.get $z))
            (local.set $z (call $f64_trunc_lo (local.get $z)))
            (local.set $v (f64.sub (local.get $y) (f64.sub (local.get $z) (local.get $x))))
            (local.set $a (f64.div (f64.const -1) (local.get $w)))
            (local.set $t (call $f64_trunc_lo (local.get $a)))
            (local.set $s (f64.add (f64.const 1) (f64.mul (local.get $t) (local.get $z))))
            (return (f64.add (local.get $t) (f64.mul (local.get $a) (f64.add (local.get $s) (f64.mul (local.get $t) (local.get $v))))))
          )
        )
      )
    )

    ;; |x| >= 0.6744
    (if (i32.ge_u (local.get $ix) (i32.const 0x3FE59428))
      (then
        (if (i32.lt_s (local.get $hx) (i32.const 0))
          (then
            (local.set $x (f64.neg (local.get $x)))
            (local.set $y (f64.neg (local.get $y)))
          )
        )
        (local.set $z (f64.sub (f64.const 7.85398163397448278999e-01) (local.get $x)))
        (local.set $w (f64.sub (f64.const 3.06161699786838301793e-17) (local.get $y)))
        (local.set $x (f64.add (local.get $z) (local.get $w)))
        (local.set $y (f64.const 0))
      )
    )

    (local.set $z (f64.mul (local.get $x) (local.get $x)))
    (local.set $w (f64.mul (local.get $z) (local.get $z)))

    ;; r = T1 + w*(T3 + w*(T5 + w*(T7 + w*(T9 + w*T11))))
    (local.set $r (f64.add (f64.const 1.33333333333201242699e-01)
      (f64.mul (local.get $w)
        (f64.add (f64.const 2.18694882948595424599e-02)
          (f64.mul (local.get $w)
            (f64.add (f64.const 3.59207910759131235356e-03)
              (f64.mul (local.get $w)
                (f64.add (f64.const 5.88041240820264096874e-04)
                  (f64.mul (local.get $w)
                    (f64.add (f64.const 7.81794442939557092300e-05)
                      (f64.mul (local.get $w) (f64.const -1.85586374855275456654e-05))))))))))))

    ;; v = z*(T2 + w*(T4 + w*(T6 + w*(T8 + w*(T10 + w*T12)))))
    (local.set $v (f64.mul (local.get $z)
      (f64.add (f64.const 5.39682539762260521377e-02)
        (f64.mul (local.get $w)
          (f64.add (f64.const 8.86323982359930005737e-03)
            (f64.mul (local.get $w)
              (f64.add (f64.const 1.45620945432529025516e-03)
                (f64.mul (local.get $w)
                  (f64.add (f64.const 2.46463134818469906812e-04)
                    (f64.mul (local.get $w)
                      (f64.add (f64.const 7.14072491382608190305e-05)
                        (f64.mul (local.get $w) (f64.const 2.59073051863633712884e-05)))))))))))))

    (local.set $s (f64.mul (local.get $z) (local.get $x)))
    (local.set $r (f64.add (local.get $y) (f64.mul (local.get $z) (f64.add (f64.mul (local.get $s) (f64.add (local.get $r) (local.get $v))) (local.get $y)))))
    (local.set $r (f64.add (local.get $r) (f64.mul (f64.const 3.33333333333334091986e-01) (local.get $s))))
    (local.set $w (f64.add (local.get $x) (local.get $r)))

    ;; |x| >= 0.6744: special formula
    (if (i32.ge_u (local.get $ix) (i32.const 0x3FE59428))
      (then
        (local.set $v (f64.convert_i32_s (local.get $iy)))
        (return (f64.mul
          (f64.convert_i32_s (i32.sub (i32.const 1) (i32.and (i32.shr_s (local.get $hx) (i32.const 30)) (i32.const 2))))
          (f64.sub (local.get $v)
            (f64.mul (f64.const 2)
              (f64.sub (local.get $x)
                (f64.sub (f64.div (f64.mul (local.get $w) (local.get $w)) (f64.add (local.get $w) (local.get $v))) (local.get $r)))))))
      )
    )

    (if (i32.eq (local.get $iy) (i32.const 1))
      (then (return (local.get $w)))
    )

    ;; compute -1/(x+r) accurately
    (local.set $z (call $f64_trunc_lo (local.get $w)))
    (local.set $v (f64.sub (local.get $r) (f64.sub (local.get $z) (local.get $x))))
    (local.set $a (f64.div (f64.const -1) (local.get $w)))
    (local.set $t (call $f64_trunc_lo (local.get $a)))
    (local.set $s (f64.add (f64.const 1) (f64.mul (local.get $t) (local.get $z))))
    (f64.add (local.get $t) (f64.mul (local.get $a) (f64.add (local.get $s) (f64.mul (local.get $t) (local.get $v)))))
  )

  ;; ==========================================================================
  ;; tan(x) using V8 algorithm with kernel_tan and rem_pio2
  ;; ==========================================================================
  (func $f64_tan (param $x f64) (result f64)
    (local $ix i32) (local $n i32) (local $y0 f64) (local $y1 f64)

    (local.set $ix (i32.and (call $f64_hi (local.get $x)) (i32.const 0x7FFFFFFF)))

    ;; |x| ~< pi/4
    (if (i32.le_u (local.get $ix) (i32.const 0x3FE921FB))
      (then (return (call $kernel_tan (local.get $x) (f64.const 0) (i32.const 1))))
    )

    ;; tan(Inf or NaN) is NaN
    (if (i32.ge_u (local.get $ix) (i32.const 0x7FF00000))
      (then (return (f64.sub (local.get $x) (local.get $x))))
    )

    ;; argument reduction needed
    (local.set $n (call $rem_pio2 (local.get $x)))
    (local.set $y0 (global.get $rem_pio2_y0))
    (local.set $y1 (global.get $rem_pio2_y1))

    ;; 1 -> n even, -1 -> n odd
    (call $kernel_tan (local.get $y0) (local.get $y1) (i32.sub (i32.const 1) (i32.shl (i32.and (local.get $n) (i32.const 1)) (i32.const 1))))
  )

  ;; ==========================================================================
  ;; cbrt(x) using V8/fdlibm algorithm - cube root
  ;; ==========================================================================
  (func $f64_cbrt (param $x f64) (result f64)
    (local $hx i32) (local $sign i32) (local $high i32) (local $low i32)
    (local $r f64) (local $s f64) (local $t f64) (local $w f64)
    (local $bits i64)
    ;; Constants from V8:
    ;; B1 = 715094163  (1023-1023/3-0.03306235651)*2**20
    ;; B2 = 696219795  (1023-1023/3-54/3-0.03306235651)*2**20
    ;; P0-P4 polynomial coefficients for 1/cbrt(r) approximation

    (local.set $hx (call $f64_hi (local.get $x)))
    (local.set $low (call $f64_lo (local.get $x)))
    (local.set $sign (i32.and (local.get $hx) (i32.const 0x80000000)))
    (local.set $hx (i32.xor (local.get $hx) (local.get $sign)))

    ;; cbrt(NaN, INF) is itself
    (if (i32.ge_u (local.get $hx) (i32.const 0x7FF00000))
      (then (return (f64.add (local.get $x) (local.get $x))))
    )

    ;; cbrt(0) is itself
    (if (i32.eqz (i32.or (local.get $hx) (local.get $low)))
      (then (return (local.get $x)))
    )

    ;; Rough cbrt to 5 bits
    (if (i32.lt_u (local.get $hx) (i32.const 0x00100000))
      (then
        ;; subnormal: scale up
        (local.set $t (call $f64_from_words (i32.const 0x43500000) (i32.const 0)))
        (local.set $t (f64.mul (local.get $t) (local.get $x)))
        (local.set $high (call $f64_hi (local.get $t)))
        (local.set $t (call $f64_from_words
          (i32.or (local.get $sign) (i32.add (i32.div_u (i32.and (local.get $high) (i32.const 0x7FFFFFFF)) (i32.const 3)) (i32.const 696219795)))
          (i32.const 0)))
      )
      (else
        (local.set $t (call $f64_from_words
          (i32.or (local.get $sign) (i32.add (i32.div_u (local.get $hx) (i32.const 3)) (i32.const 715094163)))
          (i32.const 0)))
      )
    )

    ;; New cbrt to 23 bits using polynomial P(r) where r = t^3/x
    (local.set $r (f64.mul (f64.mul (local.get $t) (local.get $t)) (f64.div (local.get $t) (local.get $x))))
    ;; t = t * ((P0 + r*(P1 + r*P2)) + (r*r*r)*(P3 + r*P4))
    (local.set $t (f64.mul (local.get $t)
      (f64.add
        (f64.add (f64.const 1.87595182427177009643)
          (f64.mul (local.get $r)
            (f64.add (f64.const -1.88497979543377169875)
              (f64.mul (local.get $r) (f64.const 1.621429720105354466140)))))
        (f64.mul (f64.mul (f64.mul (local.get $r) (local.get $r)) (local.get $r))
          (f64.add (f64.const -0.758397934778766047437)
            (f64.mul (local.get $r) (f64.const 0.145996192886612446982)))))))

    ;; Round t away from zero to 23 bits
    (local.set $bits (i64.reinterpret_f64 (local.get $t)))
    (local.set $bits (i64.and
      (i64.add (local.get $bits) (i64.const 0x80000000))
      (i64.const 0xFFFFFFFFC0000000)))
    (local.set $t (f64.reinterpret_i64 (local.get $bits)))

    ;; One step Newton iteration to 53 bits
    (local.set $s (f64.mul (local.get $t) (local.get $t)))
    (local.set $r (f64.div (local.get $x) (local.get $s)))
    (local.set $w (f64.add (local.get $t) (local.get $t)))
    (local.set $r (f64.div (f64.sub (local.get $r) (local.get $t)) (f64.add (local.get $w) (local.get $r))))
    (f64.add (local.get $t) (f64.mul (local.get $t) (local.get $r)))
  )

  ;; ==========================================================================
  ;; Sine: full implementation with range reduction
  ;; ==========================================================================
  (func $f64_sin (param $x f64) (result f64)
    (local $n i32) (local $y0 f64) (local $y1 f64) (local $ix i32)

    (local.set $ix (i32.and (call $f64_hi (local.get $x)) (i32.const 0x7FFFFFFF)))

    ;; |x| ~< pi/4, no reduction needed
    (if (i32.le_s (local.get $ix) (i32.const 0x3FE921FB))
      (then (return (call $kernel_sin (local.get $x) (f64.const 0) (i32.const 0))))
    )

    ;; sin(Inf or NaN) is NaN
    (if (i32.ge_s (local.get $ix) (i32.const 0x7FF00000))
      (then (return (f64.sub (local.get $x) (local.get $x))))
    )

    ;; Range reduction
    (local.set $n (call $rem_pio2 (local.get $x)))
    (local.set $y0 (global.get $rem_pio2_y0))
    (local.set $y1 (global.get $rem_pio2_y1))

    ;; Dispatch based on n&3
    ;; 0: sin(y), 1: cos(y), 2: -sin(y), 3: -cos(y)
    (if (i32.eq (i32.and (local.get $n) (i32.const 3)) (i32.const 0))
      (then (return (call $kernel_sin (local.get $y0) (local.get $y1) (i32.const 1))))
    )
    (if (i32.eq (i32.and (local.get $n) (i32.const 3)) (i32.const 1))
      (then (return (call $kernel_cos (local.get $y0) (local.get $y1))))
    )
    (if (i32.eq (i32.and (local.get $n) (i32.const 3)) (i32.const 2))
      (then (return (f64.neg (call $kernel_sin (local.get $y0) (local.get $y1) (i32.const 1)))))
    )
    ;; n&3 == 3
    (f64.neg (call $kernel_cos (local.get $y0) (local.get $y1)))
  )

  ;; ==========================================================================
  ;; Cosine: full implementation with range reduction
  ;; ==========================================================================
  (func $f64_cos (param $x f64) (result f64)
    (local $n i32) (local $y0 f64) (local $y1 f64) (local $ix i32)

    (local.set $ix (i32.and (call $f64_hi (local.get $x)) (i32.const 0x7FFFFFFF)))

    ;; |x| ~< pi/4, no reduction needed
    (if (i32.le_s (local.get $ix) (i32.const 0x3FE921FB))
      (then (return (call $kernel_cos (local.get $x) (f64.const 0))))
    )

    ;; cos(Inf or NaN) is NaN
    (if (i32.ge_s (local.get $ix) (i32.const 0x7FF00000))
      (then (return (f64.sub (local.get $x) (local.get $x))))
    )

    ;; Range reduction
    (local.set $n (call $rem_pio2 (local.get $x)))
    (local.set $y0 (global.get $rem_pio2_y0))
    (local.set $y1 (global.get $rem_pio2_y1))

    ;; Dispatch based on n&3
    ;; 0: cos(y), 1: -sin(y), 2: -cos(y), 3: sin(y)
    (if (i32.eq (i32.and (local.get $n) (i32.const 3)) (i32.const 0))
      (then (return (call $kernel_cos (local.get $y0) (local.get $y1))))
    )
    (if (i32.eq (i32.and (local.get $n) (i32.const 3)) (i32.const 1))
      (then (return (f64.neg (call $kernel_sin (local.get $y0) (local.get $y1) (i32.const 1)))))
    )
    (if (i32.eq (i32.and (local.get $n) (i32.const 3)) (i32.const 2))
      (then (return (f64.neg (call $kernel_cos (local.get $y0) (local.get $y1)))))
    )
    ;; n&3 == 3
    (call $kernel_sin (local.get $y0) (local.get $y1) (i32.const 1))
  )

  ;; ==========================================================================
  ;; Arcsine using V8/fdlibm algorithm (exact match to ieee754.cc)
  ;; ==========================================================================
  (func $f64_asin (param $x f64) (result f64)
    (local $hx i32) (local $ix i32)
    (local $t f64) (local $w f64) (local $p f64) (local $q f64) (local $c f64) (local $r f64) (local $s f64)
    ;; Constants
    ;; pio2_hi = 1.57079632679489655800e+00  0x3FF921FB, 0x54442D18
    ;; pio2_lo = 6.12323399573676603587e-17  0x3C91A626, 0x33145C07
    ;; pio4_hi = 7.85398163397448278999e-01  0x3FE921FB, 0x54442D18
    ;; pS0-pS5, qS1-qS4 coefficients for R(x^2)

    (local.set $hx (call $f64_hi (local.get $x)))
    (local.set $ix (i32.and (local.get $hx) (i32.const 0x7FFFFFFF)))

    ;; |x| >= 1
    (if (i32.ge_u (local.get $ix) (i32.const 0x3FF00000))
      (then
        ;; asin(1) = +-pi/2 with inexact
        (if (i32.eq (i32.or (i32.sub (local.get $ix) (i32.const 0x3FF00000)) (call $f64_lo (local.get $x))) (i32.const 0))
          (then
            (return (f64.add
              (f64.mul (local.get $x) (f64.const 1.57079632679489655800e+00))
              (f64.mul (local.get $x) (f64.const 6.12323399573676603587e-17))))
          )
        )
        ;; asin(|x|>1) is NaN
        (return (f64.div (f64.const 0) (f64.const 0)))
      )
    )

    ;; |x| < 0.5
    (if (i32.lt_u (local.get $ix) (i32.const 0x3FE00000))
      (then
        ;; |x| < 2^-27: return x
        (if (i32.lt_u (local.get $ix) (i32.const 0x3E400000))
          (then (return (local.get $x)))
        )
        (local.set $t (f64.mul (local.get $x) (local.get $x)))
        ;; p = t*(pS0 + t*(pS1 + t*(pS2 + t*(pS3 + t*(pS4 + t*pS5)))))
        (local.set $p (f64.mul (local.get $t)
          (f64.add (f64.const 1.66666666666666657415e-01)
            (f64.mul (local.get $t)
              (f64.add (f64.const -3.25565818622400915405e-01)
                (f64.mul (local.get $t)
                  (f64.add (f64.const 2.01212532134862925881e-01)
                    (f64.mul (local.get $t)
                      (f64.add (f64.const -4.00555345006794114027e-02)
                        (f64.mul (local.get $t)
                          (f64.add (f64.const 7.91534994289814532176e-04)
                            (f64.mul (local.get $t) (f64.const 3.47933107596021167570e-05)))))))))))))
        ;; q = 1 + t*(qS1 + t*(qS2 + t*(qS3 + t*qS4)))
        (local.set $q (f64.add (f64.const 1)
          (f64.mul (local.get $t)
            (f64.add (f64.const -2.40339491173441421878e+00)
              (f64.mul (local.get $t)
                (f64.add (f64.const 2.02094576023350569471e+00)
                  (f64.mul (local.get $t)
                    (f64.add (f64.const -6.88283971605453293030e-01)
                      (f64.mul (local.get $t) (f64.const 7.70381505559019352791e-02))))))))))
        (local.set $w (f64.div (local.get $p) (local.get $q)))
        (return (f64.add (local.get $x) (f64.mul (local.get $x) (local.get $w))))
      )
    )

    ;; 1 > |x| >= 0.5
    (local.set $w (f64.sub (f64.const 1) (f64.abs (local.get $x))))
    (local.set $t (f64.mul (local.get $w) (f64.const 0.5)))
    ;; p = t*(pS0 + t*(pS1 + t*(pS2 + t*(pS3 + t*(pS4 + t*pS5)))))
    (local.set $p (f64.mul (local.get $t)
      (f64.add (f64.const 1.66666666666666657415e-01)
        (f64.mul (local.get $t)
          (f64.add (f64.const -3.25565818622400915405e-01)
            (f64.mul (local.get $t)
              (f64.add (f64.const 2.01212532134862925881e-01)
                (f64.mul (local.get $t)
                  (f64.add (f64.const -4.00555345006794114027e-02)
                    (f64.mul (local.get $t)
                      (f64.add (f64.const 7.91534994289814532176e-04)
                        (f64.mul (local.get $t) (f64.const 3.47933107596021167570e-05)))))))))))))
    ;; q = 1 + t*(qS1 + t*(qS2 + t*(qS3 + t*qS4)))
    (local.set $q (f64.add (f64.const 1)
      (f64.mul (local.get $t)
        (f64.add (f64.const -2.40339491173441421878e+00)
          (f64.mul (local.get $t)
            (f64.add (f64.const 2.02094576023350569471e+00)
              (f64.mul (local.get $t)
                (f64.add (f64.const -6.88283971605453293030e-01)
                  (f64.mul (local.get $t) (f64.const 7.70381505559019352791e-02))))))))))
    (local.set $s (f64.sqrt (local.get $t)))

    ;; if |x| > 0.975 (ix >= 0x3FEF3333)
    (if (i32.ge_u (local.get $ix) (i32.const 0x3FEF3333))
      (then
        (local.set $w (f64.div (local.get $p) (local.get $q)))
        (local.set $t (f64.sub
          (f64.const 1.57079632679489655800e+00)
          (f64.sub
            (f64.mul (f64.const 2.0) (f64.add (local.get $s) (f64.mul (local.get $s) (local.get $w))))
            (f64.const 6.12323399573676603587e-17))))
      )
      (else
        ;; w = s with low word cleared
        (local.set $w (call $f64_trunc_lo (local.get $s)))
        (local.set $c (f64.div
          (f64.sub (local.get $t) (f64.mul (local.get $w) (local.get $w)))
          (f64.add (local.get $s) (local.get $w))))
        (local.set $r (f64.div (local.get $p) (local.get $q)))
        (local.set $p (f64.sub
          (f64.mul (f64.const 2.0) (f64.mul (local.get $s) (local.get $r)))
          (f64.sub (f64.const 6.12323399573676603587e-17) (f64.mul (f64.const 2.0) (local.get $c)))))
        (local.set $q (f64.sub (f64.const 7.85398163397448278999e-01) (f64.mul (f64.const 2.0) (local.get $w))))
        (local.set $t (f64.sub (f64.const 7.85398163397448278999e-01) (f64.sub (local.get $p) (local.get $q))))
      )
    )

    (if (i32.gt_s (local.get $hx) (i32.const 0))
      (then (return (local.get $t)))
      (else (return (f64.neg (local.get $t))))
    )
    (unreachable)
  )

  ;; ==========================================================================
  ;; Arccosine using V8/fdlibm algorithm (exact match to ieee754.cc)
  ;; ==========================================================================
  (func $f64_acos (param $x f64) (result f64)
    (local $hx i32) (local $ix i32) (local $lx i32)
    (local $z f64) (local $p f64) (local $q f64) (local $r f64) (local $w f64) (local $s f64) (local $c f64) (local $df f64)
    ;; Constants from V8 ieee754.cc:
    ;; pi        = 3.14159265358979311600e+00  0x400921FB, 0x54442D18
    ;; pio2_hi   = 1.57079632679489655800e+00  0x3FF921FB, 0x54442D18
    ;; pio2_lo   = 6.12323399573676603587e-17  0x3C91A626, 0x33145C07
    ;; pS0-pS5, qS1-qS4 same as asin

    (local.set $hx (call $f64_hi (local.get $x)))
    (local.set $ix (i32.and (local.get $hx) (i32.const 0x7FFFFFFF)))

    ;; |x| >= 1
    (if (i32.ge_u (local.get $ix) (i32.const 0x3FF00000))
      (then
        (local.set $lx (call $f64_lo (local.get $x)))
        ;; |x| == 1
        (if (i32.eq (i32.or (i32.sub (local.get $ix) (i32.const 0x3FF00000)) (local.get $lx)) (i32.const 0))
          (then
            ;; acos(1) = 0, acos(-1) = pi
            (if (i32.gt_s (local.get $hx) (i32.const 0))
              (then (return (f64.const 0)))
              (else (return (f64.add
                (f64.const 3.14159265358979311600e+00)
                (f64.mul (f64.const 2.0) (f64.const 6.12323399573676603587e-17)))))
            )
          )
        )
        ;; acos(|x|>1) is NaN
        (return (f64.div (f64.const 0) (f64.const 0)))
      )
    )

    ;; |x| < 0.5
    (if (i32.lt_u (local.get $ix) (i32.const 0x3FE00000))
      (then
        ;; |x| < 2^-57: return pio2_hi + pio2_lo
        (if (i32.le_u (local.get $ix) (i32.const 0x3C600000))
          (then (return (f64.add
            (f64.const 1.57079632679489655800e+00)
            (f64.const 6.12323399573676603587e-17))))
        )
        (local.set $z (f64.mul (local.get $x) (local.get $x)))
        ;; p = z*(pS0 + z*(pS1 + z*(pS2 + z*(pS3 + z*(pS4 + z*pS5)))))
        (local.set $p (f64.mul (local.get $z)
          (f64.add (f64.const 1.66666666666666657415e-01)
            (f64.mul (local.get $z)
              (f64.add (f64.const -3.25565818622400915405e-01)
                (f64.mul (local.get $z)
                  (f64.add (f64.const 2.01212532134862925881e-01)
                    (f64.mul (local.get $z)
                      (f64.add (f64.const -4.00555345006794114027e-02)
                        (f64.mul (local.get $z)
                          (f64.add (f64.const 7.91534994289814532176e-04)
                            (f64.mul (local.get $z) (f64.const 3.47933107596021167570e-05)))))))))))))
        ;; q = 1 + z*(qS1 + z*(qS2 + z*(qS3 + z*qS4)))
        (local.set $q (f64.add (f64.const 1)
          (f64.mul (local.get $z)
            (f64.add (f64.const -2.40339491173441421878e+00)
              (f64.mul (local.get $z)
                (f64.add (f64.const 2.02094576023350569471e+00)
                  (f64.mul (local.get $z)
                    (f64.add (f64.const -6.88283971605453293030e-01)
                      (f64.mul (local.get $z) (f64.const 7.70381505559019352791e-02))))))))))
        (local.set $r (f64.div (local.get $p) (local.get $q)))
        ;; return pio2_hi - (x - (pio2_lo - x*r))
        (return (f64.sub
          (f64.const 1.57079632679489655800e+00)
          (f64.sub (local.get $x)
            (f64.sub (f64.const 6.12323399573676603587e-17)
              (f64.mul (local.get $x) (local.get $r))))))
      )
    )

    ;; x < -0.5: return pi - 2*(s + w) where s = sqrt((1+x)/2)
    (if (i32.lt_s (local.get $hx) (i32.const 0))
      (then
        (local.set $z (f64.mul (f64.add (f64.const 1) (local.get $x)) (f64.const 0.5)))
        ;; p = z*(pS0 + z*(pS1 + z*(pS2 + z*(pS3 + z*(pS4 + z*pS5)))))
        (local.set $p (f64.mul (local.get $z)
          (f64.add (f64.const 1.66666666666666657415e-01)
            (f64.mul (local.get $z)
              (f64.add (f64.const -3.25565818622400915405e-01)
                (f64.mul (local.get $z)
                  (f64.add (f64.const 2.01212532134862925881e-01)
                    (f64.mul (local.get $z)
                      (f64.add (f64.const -4.00555345006794114027e-02)
                        (f64.mul (local.get $z)
                          (f64.add (f64.const 7.91534994289814532176e-04)
                            (f64.mul (local.get $z) (f64.const 3.47933107596021167570e-05)))))))))))))
        ;; q = 1 + z*(qS1 + z*(qS2 + z*(qS3 + z*qS4)))
        (local.set $q (f64.add (f64.const 1)
          (f64.mul (local.get $z)
            (f64.add (f64.const -2.40339491173441421878e+00)
              (f64.mul (local.get $z)
                (f64.add (f64.const 2.02094576023350569471e+00)
                  (f64.mul (local.get $z)
                    (f64.add (f64.const -6.88283971605453293030e-01)
                      (f64.mul (local.get $z) (f64.const 7.70381505559019352791e-02))))))))))
        (local.set $s (f64.sqrt (local.get $z)))
        (local.set $r (f64.div (local.get $p) (local.get $q)))
        (local.set $w (f64.sub (f64.mul (local.get $r) (local.get $s)) (f64.const 6.12323399573676603587e-17)))
        ;; return pi - 2.0 * (s + w)
        (return (f64.sub
          (f64.const 3.14159265358979311600e+00)
          (f64.mul (f64.const 2.0) (f64.add (local.get $s) (local.get $w)))))
      )
    )

    ;; x > 0.5: return 2*(df + w) where s = sqrt((1-x)/2), df = s with low word cleared
    (local.set $z (f64.mul (f64.sub (f64.const 1) (local.get $x)) (f64.const 0.5)))
    (local.set $s (f64.sqrt (local.get $z)))
    (local.set $df (call $f64_trunc_lo (local.get $s)))
    (local.set $c (f64.div
      (f64.sub (local.get $z) (f64.mul (local.get $df) (local.get $df)))
      (f64.add (local.get $s) (local.get $df))))
    ;; p = z*(pS0 + z*(pS1 + z*(pS2 + z*(pS3 + z*(pS4 + z*pS5)))))
    (local.set $p (f64.mul (local.get $z)
      (f64.add (f64.const 1.66666666666666657415e-01)
        (f64.mul (local.get $z)
          (f64.add (f64.const -3.25565818622400915405e-01)
            (f64.mul (local.get $z)
              (f64.add (f64.const 2.01212532134862925881e-01)
                (f64.mul (local.get $z)
                  (f64.add (f64.const -4.00555345006794114027e-02)
                    (f64.mul (local.get $z)
                      (f64.add (f64.const 7.91534994289814532176e-04)
                        (f64.mul (local.get $z) (f64.const 3.47933107596021167570e-05)))))))))))))
    ;; q = 1 + z*(qS1 + z*(qS2 + z*(qS3 + z*qS4)))
    (local.set $q (f64.add (f64.const 1)
      (f64.mul (local.get $z)
        (f64.add (f64.const -2.40339491173441421878e+00)
          (f64.mul (local.get $z)
            (f64.add (f64.const 2.02094576023350569471e+00)
              (f64.mul (local.get $z)
                (f64.add (f64.const -6.88283971605453293030e-01)
                  (f64.mul (local.get $z) (f64.const 7.70381505559019352791e-02))))))))))
    (local.set $r (f64.div (local.get $p) (local.get $q)))
    (local.set $w (f64.add (f64.mul (local.get $r) (local.get $s)) (local.get $c)))
    ;; return 2.0 * (df + w)
    (f64.mul (f64.const 2.0) (f64.add (local.get $df) (local.get $w)))
  )

  ;; ==========================================================================
  ;; Arctangent using V8/fdlibm algorithm (exact match to ieee754.cc)
  ;; ==========================================================================
  (func $f64_atan (param $x f64) (result f64)
    (local $hx i32) (local $ix i32) (local $id i32)
    (local $z f64) (local $w f64) (local $s1 f64) (local $s2 f64)
    ;; atanhi/atanlo constants for high precision
    ;; atanhi[0] = 4.63647609000806093515e-01  atan(0.5)hi 0x3FDDAC67, 0x0561BB4F
    ;; atanhi[1] = 7.85398163397448278999e-01  atan(1.0)hi 0x3FE921FB, 0x54442D18
    ;; atanhi[2] = 9.82793723247329054082e-01  atan(1.5)hi 0x3FEF730B, 0xD281F69B
    ;; atanhi[3] = 1.57079632679489655800e+00  atan(inf)hi 0x3FF921FB, 0x54442D18
    ;; atanlo[0] = 2.26987774529616870924e-17  0x3C7A2B7F, 0x222F65E2
    ;; atanlo[1] = 3.06161699786838301793e-17  0x3C81A626, 0x33145C07
    ;; atanlo[2] = 1.39033110312309984516e-17  0x3C700788, 0x7AF0CBBD
    ;; atanlo[3] = 6.12323399573676603587e-17  0x3C91A626, 0x33145C07

    (local.set $hx (call $f64_hi (local.get $x)))
    (local.set $ix (i32.and (local.get $hx) (i32.const 0x7FFFFFFF)))

    ;; if |x| >= 2^66, return +-pi/2
    (if (i32.ge_u (local.get $ix) (i32.const 0x44100000))
      (then
        ;; Check for NaN
        (if (i32.gt_u (local.get $ix) (i32.const 0x7FF00000))
          (then (return (f64.add (local.get $x) (local.get $x))))
        )
        (if (i32.eq (local.get $ix) (i32.const 0x7FF00000))
          (then
            (if (i32.ne (call $f64_lo (local.get $x)) (i32.const 0))
              (then (return (f64.add (local.get $x) (local.get $x)))) ;; NaN
            )
          )
        )
        ;; Return +-pi/2
        (if (i32.gt_s (local.get $hx) (i32.const 0))
          (then (return (f64.add
            (f64.const 1.57079632679489655800e+00)
            (f64.const 6.12323399573676603587e-17))))
          (else (return (f64.neg (f64.add
            (f64.const 1.57079632679489655800e+00)
            (f64.const 6.12323399573676603587e-17)))))
        )
      )
    )

    ;; |x| < 0.4375 (0x3FDC0000)
    (if (i32.lt_u (local.get $ix) (i32.const 0x3FDC0000))
      (then
        ;; |x| < 2^-27: return x
        (if (i32.lt_u (local.get $ix) (i32.const 0x3E400000))
          (then (return (local.get $x)))
        )
        (local.set $id (i32.const -1))
      )
      (else
        (local.set $x (f64.abs (local.get $x)))
        (if (i32.lt_u (local.get $ix) (i32.const 0x3FF30000))
          (then
            ;; |x| < 1.1875
            (if (i32.lt_u (local.get $ix) (i32.const 0x3FE60000))
              (then
                ;; 7/16 <= |x| < 11/16: x = (2x-1)/(2+x)
                (local.set $id (i32.const 0))
                (local.set $x (f64.div
                  (f64.sub (f64.mul (f64.const 2.0) (local.get $x)) (f64.const 1.0))
                  (f64.add (f64.const 2.0) (local.get $x))))
              )
              (else
                ;; 11/16 <= |x| < 19/16: x = (x-1)/(x+1)
                (local.set $id (i32.const 1))
                (local.set $x (f64.div
                  (f64.sub (local.get $x) (f64.const 1.0))
                  (f64.add (local.get $x) (f64.const 1.0))))
              )
            )
          )
          (else
            (if (i32.lt_u (local.get $ix) (i32.const 0x40038000))
              (then
                ;; |x| < 2.4375: x = (x-1.5)/(1+1.5*x)
                (local.set $id (i32.const 2))
                (local.set $x (f64.div
                  (f64.sub (local.get $x) (f64.const 1.5))
                  (f64.add (f64.const 1.0) (f64.mul (f64.const 1.5) (local.get $x)))))
              )
              (else
                ;; |x| >= 2.4375: x = -1/x
                (local.set $id (i32.const 3))
                (local.set $x (f64.div (f64.const -1.0) (local.get $x)))
              )
            )
          )
        )
      )
    )

    ;; Polynomial evaluation
    (local.set $z (f64.mul (local.get $x) (local.get $x)))
    (local.set $w (f64.mul (local.get $z) (local.get $z)))

    ;; s1 = z*(aT[0] + w*(aT[2] + w*(aT[4] + w*(aT[6] + w*(aT[8] + w*aT[10])))))
    (local.set $s1 (f64.mul (local.get $z)
      (f64.add (f64.const 3.33333333333329318027e-01)
        (f64.mul (local.get $w)
          (f64.add (f64.const 1.42857142725034663711e-01)
            (f64.mul (local.get $w)
              (f64.add (f64.const 9.09088713343650656196e-02)
                (f64.mul (local.get $w)
                  (f64.add (f64.const 6.66107313738753120669e-02)
                    (f64.mul (local.get $w)
                      (f64.add (f64.const 4.97687799461593236017e-02)
                        (f64.mul (local.get $w) (f64.const 1.62858201153657823623e-02)))))))))))))

    ;; s2 = w*(aT[1] + w*(aT[3] + w*(aT[5] + w*(aT[7] + w*aT[9]))))
    (local.set $s2 (f64.mul (local.get $w)
      (f64.add (f64.const -1.99999999998764832476e-01)
        (f64.mul (local.get $w)
          (f64.add (f64.const -1.11111104054623557880e-01)
            (f64.mul (local.get $w)
              (f64.add (f64.const -7.69187620504482999495e-02)
                (f64.mul (local.get $w)
                  (f64.add (f64.const -5.83357013379057348645e-02)
                    (f64.mul (local.get $w) (f64.const -3.65315727442169155270e-02)))))))))))

    ;; For id < 0: return x - x*(s1+s2)
    (if (i32.lt_s (local.get $id) (i32.const 0))
      (then
        (return (f64.sub (local.get $x)
          (f64.mul (local.get $x) (f64.add (local.get $s1) (local.get $s2)))))
      )
    )

    ;; z = atanhi[id] - ((x*(s1+s2) - atanlo[id]) - x)
    ;; For each id, use the appropriate constants
    (if (i32.eq (local.get $id) (i32.const 0))
      (then
        (local.set $z (f64.sub
          (f64.const 4.63647609000806093515e-01)
          (f64.sub
            (f64.sub (f64.mul (local.get $x) (f64.add (local.get $s1) (local.get $s2)))
                     (f64.const 2.26987774529616870924e-17))
            (local.get $x))))
      )
    )
    (if (i32.eq (local.get $id) (i32.const 1))
      (then
        (local.set $z (f64.sub
          (f64.const 7.85398163397448278999e-01)
          (f64.sub
            (f64.sub (f64.mul (local.get $x) (f64.add (local.get $s1) (local.get $s2)))
                     (f64.const 3.06161699786838301793e-17))
            (local.get $x))))
      )
    )
    (if (i32.eq (local.get $id) (i32.const 2))
      (then
        (local.set $z (f64.sub
          (f64.const 9.82793723247329054082e-01)
          (f64.sub
            (f64.sub (f64.mul (local.get $x) (f64.add (local.get $s1) (local.get $s2)))
                     (f64.const 1.39033110312309984516e-17))
            (local.get $x))))
      )
    )
    (if (i32.eq (local.get $id) (i32.const 3))
      (then
        (local.set $z (f64.sub
          (f64.const 1.57079632679489655800e+00)
          (f64.sub
            (f64.sub (f64.mul (local.get $x) (f64.add (local.get $s1) (local.get $s2)))
                     (f64.const 6.12323399573676603587e-17))
            (local.get $x))))
      )
    )

    (if (i32.lt_s (local.get $hx) (i32.const 0))
      (then (return (f64.neg (local.get $z))))
      (else (return (local.get $z)))
    )
    (unreachable)
  )

  ;; ==========================================================================
  ;; Two-argument arctangent (atan2)
  ;; atan2(y, x) = angle from positive x-axis to point (x, y)
  ;; ==========================================================================
  (func $f64_atan2 (param $y f64) (param $x f64) (result f64)
    ;; Handle special cases
    (if (f64.ne (local.get $y) (local.get $y))
      (then (return (local.get $y))) ;; NaN
    )
    (if (f64.ne (local.get $x) (local.get $x))
      (then (return (local.get $x))) ;; NaN
    )

    ;; x > 0: atan(y/x)
    (if (f64.gt (local.get $x) (f64.const 0))
      (then
        (return (call $f64_atan (f64.div (local.get $y) (local.get $x))))
      )
    )

    ;; x < 0, y >= 0: atan(y/x) + PI
    (if (f64.lt (local.get $x) (f64.const 0))
      (then
        (if (f64.ge (local.get $y) (f64.const 0))
          (then
            (return (f64.add
              (call $f64_atan (f64.div (local.get $y) (local.get $x)))
              (f64.const 3.141592653589793)))
          )
          (else
            ;; x < 0, y < 0: atan(y/x) - PI
            (return (f64.sub
              (call $f64_atan (f64.div (local.get $y) (local.get $x)))
              (f64.const 3.141592653589793)))
          )
        )
      )
    )

    ;; x == 0
    (if (f64.gt (local.get $y) (f64.const 0))
      (then (return (f64.const 1.5707963267948966))) ;; PI/2
    )
    (if (f64.lt (local.get $y) (f64.const 0))
      (then (return (f64.const -1.5707963267948966))) ;; -PI/2
    )

    ;; x == 0, y == 0: return 0
    (f64.const 0)
  )

  ;; ==========================================================================
  ;; Scope operations
  ;; ==========================================================================

  ;; Scope layout (after GC header):
  ;;   [parent:4][count:4][capacity:4][entries_pointer:4]
  ;; Entry layout: [key_offset:4][type:4][flags:4][data_lo:4][data_hi:4] = 20 bytes

  ;; estimate_scope_size() → bytes
  ;; Worst-case heap consumption of $scope_create:
  ;;   32 (scope header: GC 8 + parent 4 + count 4 + capacity 4
  ;;       + entries_pointer 4 + flags 4 + reserved 4)
  ;;   + 168 (entries block: GC 8 + 8 entries * ENTRY_SIZE 20)
  ;;   = 200 bytes.
  ;; (A recycling-cache hit consumes zero heap; this is the fresh-
  ;; allocation worst case the pressure pre-checks must cover.)
  (func $estimate_scope_size (result i32)
    (i32.const 200)
  )

  ;; estimate_scope_grow_size(current_capacity) → bytes
  ;; Worst-case heap consumption of the grow branch of $scope_define:
  ;;   GC_HEADER_SIZE (8) + (current_capacity * 2) * ENTRY_SIZE (20).
  ;; Returns the size of the new entries block when grow would fire.
  ;; Opcode handlers that may trigger a scope grow should pre-check this.
  (func $estimate_scope_grow_size (param $current_capacity i32) (result i32)
    (i32.add
      (global.get $GC_HEADER_SIZE)
      (i32.mul
        (i32.mul (local.get $current_capacity) (i32.const 2))
        (global.get $ENTRY_SIZE)))
  )

  ;; Allocate a new scope with given parent
  (func $scope_create (param $parent i32) (result i32)
    (local $pointer i32)
    (local $entries_pointer i32)
    (local $heap_pointer i32)

    ;; Recycling fast paths.
    ;; Pending slot first: the scope noted at RETURN dispatch. It may
    ;; still be the live current scope if that RETURN's continuation
    ;; parked before replacing it — the guard skips exactly that case.
    (local.set $pointer (global.get $scope_cache_pending))
    (if (i32.and
          (i32.ne (local.get $pointer) (i32.const 0))
          (i32.ne (local.get $pointer) (global.get $current_scope)))
      (then
        (global.set $scope_cache_pending (i32.const 0))
        (i32.store (call $abs (local.get $pointer)) (local.get $parent))
        (i32.store (call $abs (i32.add (local.get $pointer) (i32.const 4))) (i32.const 0))
        (return (local.get $pointer))))
    ;; Free list next: scopes fed by SCOPE_POP are off every chain; a
    ;; dead scope's parent field doubles as the list link. Capacity and
    ;; the entries block carry over (grown blocks stay grown).
    (local.set $pointer (global.get $scope_cache_list))
    (if (i32.ne (local.get $pointer) (i32.const 0))
      (then
        (global.set $scope_cache_list (i32.load (call $abs (local.get $pointer))))
        (i32.store (call $abs (local.get $pointer)) (local.get $parent))
        (i32.store (call $abs (i32.add (local.get $pointer) (i32.const 4))) (i32.const 0))
        (return (local.get $pointer))))

    ;; Allocate scope object: GC header (8) + parent (4) + count (4) + capacity (4)
    ;; + entries_pointer (4) + flags (4) + reserved (4) = 32 bytes
    (local.set $heap_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))
    (local.set $pointer (local.get $heap_pointer))

    ;; GC header: [size | (type << 24)]
    (i32.store (call $abs (local.get $pointer))
      (i32.or (i32.const 32) (i32.shl (global.get $OBJ_SCOPE) (i32.const 24))))
    ;; GC header word 2 (forwarding word — must stay zero between collections)
    (i32.store (call $abs (i32.add (local.get $pointer) (i32.const 4))) (i32.const 0))

    ;; Allocate entries array: GC header (8) + 8 entries × 20 bytes = 168 bytes
    (local.set $entries_pointer (i32.add (local.get $heap_pointer) (i32.const 32)))
    (i32.store (call $abs (local.get $entries_pointer))
      (i32.or (i32.const 168) (i32.shl (global.get $OBJ_SCOPE_ENTRIES) (i32.const 24))))
    (i32.store (call $abs (i32.add (local.get $entries_pointer) (i32.const 4))) (i32.const 0))

    ;; Scope data (after GC header)
    (i32.store (call $abs (i32.add (local.get $pointer) (i32.const 8))) (local.get $parent))  ;; parent
    (i32.store (call $abs (i32.add (local.get $pointer) (i32.const 12))) (i32.const 0))       ;; count = 0
    (i32.store (call $abs (i32.add (local.get $pointer) (i32.const 16))) (i32.const 8))       ;; capacity = 8
    (i32.store (call $abs (i32.add (local.get $pointer) (i32.const 20))) (local.get $entries_pointer)) ;; entries_pointer
    (i32.store (call $abs (i32.add (local.get $pointer) (i32.const 24))) (i32.const 0))       ;; flags (bit 0 = closure-captured)
    (i32.store (call $abs (i32.add (local.get $pointer) (i32.const 28))) (i32.const 0))       ;; reserved

    ;; Update heap pointer
    (call $write_state (global.get $STATE_HEAP_POINTER)
      (i32.add (local.get $entries_pointer) (i32.const 168)))

    ;; Return data pointer (after GC header)
    (i32.add (local.get $pointer) (global.get $GC_HEADER_SIZE))
  )

  ;; Mark every scope on the chain closure-captured (flags bit 0 at
  ;; data offset 16). A captured scope must never enter the recycling
  ;; cache: a closure may re-enter it at any later time, so its
  ;; identity has to be preserved until GC proves it dead. The walk
  ;; stops at the first already-marked scope: marking is monotone and
  ;; a marked scope's ancestors are already marked (induction over
  ;; every call to this function).
  (func $scope_mark_captured_chain (param $scope i32)
    (block $done
      (loop $walk
        (br_if $done (i32.eqz (local.get $scope)))
        (br_if $done (i32.and
          (i32.load (call $abs (i32.add (local.get $scope) (i32.const 16))))
          (i32.const 1)))
        (i32.store (call $abs (i32.add (local.get $scope) (i32.const 16)))
          (i32.or
            (i32.load (call $abs (i32.add (local.get $scope) (i32.const 16))))
            (i32.const 1)))
        (local.set $scope (i32.load (call $abs (local.get $scope))))
        (br $walk)))
  )

  ;; Look up variable in scope chain, return pointer to value or 0 if not found
  (func $scope_lookup (param $scope i32) (param $name i32) (result i32)
    (local $count i32)
    (local $entries i32)
    (local $i i32)
    (local $entry_pointer i32)
    (local $entry_key i32)

    (block $not_found
      (loop $scope_loop
        ;; If scope is 0 (null), not found
        (br_if $not_found (i32.eqz (local.get $scope)))

        ;; Read scope fields (scope points to data, after GC header)
        (local.set $count (i32.load (call $abs (i32.add (local.get $scope) (i32.const 4)))))
        (local.set $entries (i32.load (call $abs (i32.add (local.get $scope) (i32.const 12)))))

        ;; Search entries (entries_pointer points to GC object, data starts at +8)
        (local.set $i (i32.const 0))
        (block $found_in_scope
          (loop $entry_loop
            (br_if $found_in_scope (i32.ge_u (local.get $i) (local.get $count)))

            ;; entry_pointer = entries + 8 (GC header) + i * ENTRY_SIZE
            (local.set $entry_pointer
              (i32.add
                (i32.add (local.get $entries) (global.get $GC_HEADER_SIZE))
                (i32.mul (local.get $i) (global.get $ENTRY_SIZE))))

            (local.set $entry_key (i32.load (call $abs (local.get $entry_pointer))))

            (if (i32.eq (local.get $entry_key) (local.get $name))
              (then
                ;; Return pointer to value (entry + 4, which is type/flags/data)
                (return (i32.add (local.get $entry_pointer) (i32.const 4)))
              )
            )

            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $entry_loop)
          )
        )

        ;; Not found in this scope, try parent
        (local.set $scope (i32.load (call $abs (local.get $scope))))
        (br $scope_loop)
      )
    )

    (i32.const 0)
  )

  ;; Define the hidden `@newtarget` binding in a freshly created call scope.
  ;; Mirrors the `this` convention: every non-arrow invocation defines it
  ;; (arrows skip it and inherit lexically). nt_type/nt_lo carry TYPE_FUNCTION
  ;; + the callee closure header pointer for constructs, TYPE_UNDEFINED + 0
  ;; for plain calls, or the caller's propagated value for super() calls.
  (func $scope_define_new_target (param $scope i32) (param $nt_type i32) (param $nt_lo i32)
    (call $scope_define
      (local.get $scope)
      (call $read_builtin (i32.const 0x5C4))  ;; BUILTIN_NAME.NEW_TARGET
      (local.get $nt_type)
      (i32.const 0)
      (local.get $nt_lo)
      (i32.const 0)))

  ;; Bind `@newtarget` for a CALL_METHOD dispatch. operand2 bit 0 set means
  ;; "propagate the caller's value" — the parser sets it only on super()
  ;; emissions, where JS reports the most derived constructor inside the
  ;; parent constructor. Otherwise the binding is undefined.
  (func $scope_define_new_target_for_method (param $scope i32) (param $caller_scope i32) (param $propagate i32)
    (local $entry i32)
    (if (i32.and (local.get $propagate) (i32.const 1))
      (then
        (local.set $entry (call $scope_lookup (local.get $caller_scope)
          (call $read_builtin (i32.const 0x5C4))))  ;; BUILTIN_NAME.NEW_TARGET
        (if (local.get $entry)
          (then
            (call $scope_define_new_target (local.get $scope)
              (i32.load (call $abs (local.get $entry)))
              (i32.load (call $abs (i32.add (local.get $entry) (i32.const 8)))))
            (return)))))
    (call $scope_define_new_target (local.get $scope) (global.get $TYPE_UNDEFINED) (i32.const 0)))

  ;; Define variable in current scope (for LET_VAR)
  ;; Grows entries array if needed (doubles capacity)
  ;; Sets ERR_REDECLARATION if name already exists in current scope
  (func $scope_define (param $scope i32) (param $name i32)
                      (param $type i32) (param $flags i32) (param $data_lo i32) (param $data_hi i32)
    (local $count i32)
    (local $capacity i32)
    (local $entries i32)
    (local $entry_pointer i32)
    (local $new_capacity i32)
    (local $new_entries i32)
    (local $new_size i32)
    (local $heap_pointer i32)
    (local $i i32)
    (local $src i32)
    (local $dst i32)

    (local.set $count (i32.load (call $abs (i32.add (local.get $scope) (i32.const 4)))))
    (local.set $capacity (i32.load (call $abs (i32.add (local.get $scope) (i32.const 8)))))
    (local.set $entries (i32.load (call $abs (i32.add (local.get $scope) (i32.const 12)))))

    ;; Check for redeclaration in current scope only (not parent scopes)
    (local.set $i (i32.const 0))
    (block $check_done
      (loop $check_loop
        (br_if $check_done (i32.ge_u (local.get $i) (local.get $count)))

        ;; entry_pointer = entries + 8 (GC header) + i * ENTRY_SIZE
        (local.set $entry_pointer
          (i32.add
            (i32.add (local.get $entries) (global.get $GC_HEADER_SIZE))
            (i32.mul (local.get $i) (global.get $ENTRY_SIZE))))

        ;; Check if entry key matches name
        (if (i32.eq (i32.load (call $abs (local.get $entry_pointer))) (local.get $name))
          (then
            ;; Redeclaration error
            (call $set_error (global.get $ERR_REDECLARATION) (local.get $name))
            (return)
          )
        )

        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $check_loop)
      )
    )

    ;; Check if we need to grow
    (if (i32.ge_u (local.get $count) (local.get $capacity))
      (then
        ;; Double the capacity
        (local.set $new_capacity (i32.mul (local.get $capacity) (i32.const 2)))

        ;; Allocate new entries array: GC header (8) + new_capacity * ENTRY_SIZE bytes
        (local.set $new_size (i32.add (global.get $GC_HEADER_SIZE)
                                      (i32.mul (local.get $new_capacity) (global.get $ENTRY_SIZE))))
        (local.set $heap_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))
        (local.set $new_entries (local.get $heap_pointer))

        ;; Write GC header for new scope entries block
        (i32.store (call $abs (local.get $new_entries))
          (i32.or (local.get $new_size) (i32.shl (global.get $OBJ_SCOPE_ENTRIES) (i32.const 24))))
        (i32.store (call $abs (i32.add (local.get $new_entries) (i32.const 4))) (i32.const 0))

        ;; Update heap pointer
        (call $write_state (global.get $STATE_HEAP_POINTER)
          (i32.add (local.get $heap_pointer) (local.get $new_size)))

        ;; Copy existing entries (count * 20 bytes)
        (local.set $i (i32.const 0))
        (block $copy_done
          (loop $copy_loop
            (br_if $copy_done (i32.ge_u (local.get $i) (local.get $count)))

            (local.set $src (i32.add
              (i32.add (local.get $entries) (global.get $GC_HEADER_SIZE))
              (i32.mul (local.get $i) (global.get $ENTRY_SIZE))))
            (local.set $dst (i32.add
              (i32.add (local.get $new_entries) (global.get $GC_HEADER_SIZE))
              (i32.mul (local.get $i) (global.get $ENTRY_SIZE))))

            ;; Copy ENTRY_SIZE bytes (5 i32s)
            (i32.store (call $abs (local.get $dst))
              (i32.load (call $abs (local.get $src))))
            (i32.store (call $abs (i32.add (local.get $dst) (i32.const 4)))
              (i32.load (call $abs (i32.add (local.get $src) (i32.const 4)))))
            (i32.store (call $abs (i32.add (local.get $dst) (i32.const 8)))
              (i32.load (call $abs (i32.add (local.get $src) (i32.const 8)))))
            (i32.store (call $abs (i32.add (local.get $dst) (i32.const 12)))
              (i32.load (call $abs (i32.add (local.get $src) (i32.const 12)))))
            (i32.store (call $abs (i32.add (local.get $dst) (i32.const 16)))
              (i32.load (call $abs (i32.add (local.get $src) (i32.const 16)))))

            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $copy_loop)
          )
        )

        ;; Update scope to point to new entries and new capacity
        (local.set $entries (local.get $new_entries))
        (i32.store (call $abs (i32.add (local.get $scope) (i32.const 8))) (local.get $new_capacity))
        (i32.store (call $abs (i32.add (local.get $scope) (i32.const 12))) (local.get $new_entries))
      )
    )

    ;; entry_pointer = entries + 8 (GC header) + count * ENTRY_SIZE
    (local.set $entry_pointer
      (i32.add
        (i32.add (local.get $entries) (global.get $GC_HEADER_SIZE))
        (i32.mul (local.get $count) (global.get $ENTRY_SIZE))))

    ;; Write entry: [key][type][flags][data_lo][data_hi]
    (i32.store (call $abs (local.get $entry_pointer)) (local.get $name))
    (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 4))) (local.get $type))
    (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 8))) (local.get $flags))
    (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 12))) (local.get $data_lo))
    (i32.store (call $abs (i32.add (local.get $entry_pointer) (i32.const 16))) (local.get $data_hi))

    ;; Increment count
    (i32.store (call $abs (i32.add (local.get $scope) (i32.const 4)))
      (i32.add (local.get $count) (i32.const 1)))
  )

  ;; Set variable (find in chain and update, or error)
  (func $scope_set (param $scope i32) (param $name i32)
                   (param $type i32) (param $flags i32) (param $data_lo i32) (param $data_hi i32)
                   (result i32)  ;; returns 1 on success, 0 on not found
    (local $value_address i32)
    (local $existing_flags i32)

    (local.set $value_address (call $scope_lookup (local.get $scope) (local.get $name)))
    (if (i32.eqz (local.get $value_address))
      (then (return (i32.const 0)))
    )

    ;; Check if variable is const (flags are at value_pointer + 4)
    (local.set $existing_flags (i32.load (call $abs (i32.add (local.get $value_address) (i32.const 4)))))
    (if (i32.and (local.get $existing_flags) (global.get $SCOPE_FLAG_CONST))
      (then
        (call $set_error (global.get $ERR_CONST_ASSIGNMENT) (local.get $name))
        (return (i32.const 0))
      )
    )

    ;; Update value in place. Preserve the binding-level SCOPE_FLAG_CONST
    ;; (bit 31) across reassignment; take ALL value-level flags (bits
    ;; 0..30 — FLAG_RATIONAL_INLINE, bound-method receiver types in the
    ;; low byte) from the new value. The old low-byte preservation
    ;; destroyed receiver types on reassignment (m = arr.push broke m).
    (i32.store (call $abs (local.get $value_address)) (local.get $type))
    (i32.store (call $abs (i32.add (local.get $value_address) (i32.const 4)))
      (i32.or
        (i32.and (local.get $existing_flags) (global.get $SCOPE_FLAG_CONST))
        (i32.and (local.get $flags) (i32.const 0x7FFFFFFF))))
    (i32.store (call $abs (i32.add (local.get $value_address) (i32.const 8))) (local.get $data_lo))
    (i32.store (call $abs (i32.add (local.get $value_address) (i32.const 12))) (local.get $data_hi))

    (i32.const 1)
  )

  ;; ==========================================================================
  ;; Per-stack growth (Design B)
  ;;
  ;; Each of a context's four stacks (pending / call / try / grant) is its own
  ;; STACK_BLOCK heap object, located by three state-block fields: BASE (segment-
  ;; relative pointer to the block's first byte), LIMIT (base + capacity, one past
  ;; the last usable byte), and POINTER (the live top, between base and limit).
  ;;
  ;; $grow_stack reallocates ONE stack — the one named by the passed field
  ;; offsets — to a block of double the capacity, copies its live bytes over, and
  ;; rewrites its three fields. The other three stacks are untouched. The old
  ;; block is orphaned (gc reclaims it), exactly as array/map entries-block growth
  ;; does. This is realloc-and-copy, not chaining: the call/try/grant stacks are
  ;; walked by contiguous arithmetic (unwind, depth, frame-N), so the block must
  ;; stay one unbroken run.
  ;;
  ;; Returns 1 if the heap is too full to grow (caller must yield
  ;; EXIT_MEMORY_PRESSURE so the host gcs and retries), 0 on success.
  ;; ==========================================================================
  (func $grow_stack
        (param $base_field i32) (param $limit_field i32) (param $pointer_field i32)
        (result i32)
    (local $old_base i32)
    (local $old_limit i32)
    (local $old_pointer i32)
    (local $used i32)
    (local $old_capacity i32)
    (local $new_capacity i32)
    (local $new_size_aligned i32)
    (local $new_base i32)
    (local $heap_pointer i32)
    (local $i i32)

    (local.set $old_base (call $read_ctx (local.get $base_field)))
    (local.set $old_limit (call $read_ctx (local.get $limit_field)))
    (local.set $old_pointer (call $read_ctx (local.get $pointer_field)))
    (local.set $used (i32.sub (local.get $old_pointer) (local.get $old_base)))
    (local.set $old_capacity (i32.sub (local.get $old_limit) (local.get $old_base)))
    (local.set $new_capacity (i32.mul (local.get $old_capacity) (i32.const 2)))

    ;; Aligned total size of the new block: GC header + new capacity.
    (local.set $new_size_aligned
      (i32.and
        (i32.add
          (i32.add (global.get $GC_HEADER_SIZE) (local.get $new_capacity))
          (i32.const 15))
        (i32.const -16)))

    ;; Pre-check heap room. On pressure, signal + bail; the push site yields.
    (if (call $check_heap_overflow (local.get $new_size_aligned))
      (then (return (i32.const 1))))

    ;; Carve the new block: header at heap_pointer, data after it.
    (local.set $heap_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))
    (i32.store (call $abs (local.get $heap_pointer))
      (i32.or (local.get $new_size_aligned)
              (i32.shl (global.get $OBJ_STACK_BLOCK) (i32.const 24))))
    (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 4))) (i32.const 0))
    (local.set $new_base (i32.add (local.get $heap_pointer) (global.get $GC_HEADER_SIZE)))
    (call $write_state (global.get $STATE_HEAP_POINTER)
      (i32.add (local.get $heap_pointer) (local.get $new_size_aligned)))

    ;; Copy the live bytes (old_base..old_pointer) into the new block.
    (local.set $i (i32.const 0))
    (block $copy_done
      (loop $copy
        (br_if $copy_done (i32.ge_u (local.get $i) (local.get $used)))
        (i32.store
          (call $abs (i32.add (local.get $new_base) (local.get $i)))
          (i32.load (call $abs (i32.add (local.get $old_base) (local.get $i)))))
        (local.set $i (i32.add (local.get $i) (i32.const 4)))
        (br $copy)))

    ;; Rewrite the three fields to the new block. The top keeps its offset:
    ;; new_pointer = new_base + used.
    (call $write_ctx (local.get $base_field) (local.get $new_base))
    (call $write_ctx (local.get $limit_field)
      (i32.add (local.get $new_base) (local.get $new_capacity)))
    (call $write_ctx (local.get $pointer_field)
      (i32.add (local.get $new_base) (local.get $used)))
    (i32.const 0)
  )

  ;; Ensure the named stack has room for one more `element_size`-byte entry,
  ;; growing it if not. Returns 1 on pressure (caller yields), 0 if there is room
  ;; (either already, or after a successful grow).
  (func $ensure_stack_capacity
        (param $base_field i32) (param $limit_field i32) (param $pointer_field i32)
        (param $element_size i32)
        (result i32)
    (if (i32.le_u
          (i32.add (call $read_ctx (local.get $pointer_field)) (local.get $element_size))
          (call $read_ctx (local.get $limit_field)))
      (then (return (i32.const 0))))
    (call $grow_stack (local.get $base_field) (local.get $limit_field) (local.get $pointer_field))
  )

  ;; A call frame saves the pending-stack position to restore on return
  ;; (FRAME_PENDING_BASE). Because the pending stack is a heap block that
  ;; RELOCATES when it grows, that position must be stored as an OFFSET from the
  ;; pending base, not an absolute address — otherwise a grow between the call
  ;; and its return leaves the saved address pointing into the freed old block
  ;; (it sent CTX_PENDING_POINTER ~12KB below base, an unsigned-underflow in the
  ;; grow copy loop → hang). Save converts abs→offset; load converts offset→abs
  ;; against the CURRENT base, so it is correct no matter how the stack moved.
  (func $save_frame_pending_base (param $frame_pointer i32) (param $abs_pending i32)
    (i32.store
      (i32.add (local.get $frame_pointer) (global.get $FRAME_PENDING_POINTER))
      (i32.sub (local.get $abs_pending) (call $pending_base_seg))))

  (func $load_frame_pending_base (param $frame_pointer i32) (result i32)
    (i32.add
      (call $pending_base_seg)
      (i32.load (i32.add (local.get $frame_pointer) (global.get $FRAME_PENDING_POINTER)))))

  ;; ==========================================================================
  ;; Try Stack operations
  ;; ==========================================================================

  ;; Get current call frame depth (number of frames)
  ;; CTX_CALL_STACK_POINTER is segment-relative (context_base + offset)
  (func $get_frame_depth (result i32)
    (i32.div_u
      (i32.sub
        (call $read_ctx (global.get $CTX_CALL_STACK_POINTER))
        (call $call_stack_base_seg))
      (global.get $FRAME_SIZE)))

  ;; Push try entry - no code_block (only one code block per session)
  (func $try_push (param $catch_index i32) (param $finally_index i32)
    (local $try_pointer i32)
    (local $frame_depth i32)

    (local.set $try_pointer (call $read_ctx (global.get $CTX_TRY_STACK_POINTER)))
    (local.set $frame_depth (call $get_frame_depth))

    ;; Write try entry:
    ;; [catch_index:4][finally_index:4][frame_depth:4][scope:4]
    ;; [pending_position:4][completion_type:4][completion_value:16]
    (i32.store (call $abs (local.get $try_pointer)) (local.get $catch_index))
    (i32.store (call $abs (i32.add (local.get $try_pointer) (i32.const 4))) (local.get $finally_index))
    (i32.store (call $abs (i32.add (local.get $try_pointer) (i32.const 8))) (local.get $frame_depth))
    (i32.store (call $abs (i32.add (local.get $try_pointer) (i32.const 12))) (global.get $current_scope))
    ;; Saved pending position, block-relative (see $TRY_PENDING_POSITION).
    (i32.store (call $abs (i32.add (local.get $try_pointer) (i32.const 16)))
      (i32.sub
        (call $read_ctx (global.get $CTX_PENDING_POINTER))
        (call $pending_base_seg)))
    ;; No pending completion yet. The value bytes stay garbage — the GC
    ;; only scans them when the type is THROW or RETURN.
    (i32.store (call $abs (i32.add (local.get $try_pointer) (global.get $TRY_COMPLETION_TYPE)))
      (global.get $COMPLETION_NORMAL))
    ;; Grant-depth snapshot (v12): abrupt exits across this entry clamp
    ;; the grant stack back to this depth.
    (i32.store (call $abs (i32.add (local.get $try_pointer) (global.get $TRY_GRANT_DEPTH)))
      (i32.div_u
        (i32.sub
          (call $read_ctx (global.get $CTX_GRANT_STACK_POINTER))
          (call $read_ctx (global.get $CTX_GRANT_STACK_BASE)))
        (global.get $GRANT_ENTRY_SIZE)))

    ;; Advance try pointer
    (call $write_ctx (global.get $CTX_TRY_STACK_POINTER)
      (i32.add (local.get $try_pointer) (global.get $TRY_ENTRY_SIZE)))
  )

  ;; Clamp the grant stack down to the TOP try entry's snapshot (v12).
  ;; Called on handler entry (catch, finally divert) and at the top of
  ;; $try_pop, so every path that crosses a try region — throw, return,
  ;; break/continue, FINALLY_END re-dispatch, normal TRY_POP — releases
  ;; grant entries pushed inside it. Balanced flows find the stack
  ;; already at the snapshot (grant blocks are block-structured), so
  ;; the clamp is noop-or-correction, never an over-pop.
  (func $clamp_grants_to_top_try_entry
    (local $snapshot_pointer i32)
    (local.set $snapshot_pointer
      (i32.add
        (call $read_ctx (global.get $CTX_GRANT_STACK_BASE))
        (i32.mul
          (call $try_read (i32.const 0) (global.get $TRY_GRANT_DEPTH))
          (global.get $GRANT_ENTRY_SIZE))))
    (if (i32.gt_u
          (call $read_ctx (global.get $CTX_GRANT_STACK_POINTER))
          (local.get $snapshot_pointer))
      (then
        (call $write_ctx (global.get $CTX_GRANT_STACK_POINTER)
          (local.get $snapshot_pointer)))))

  ;; Pop grant entries that belong to the departing call frame (v12 —
  ;; the RETURN frame-pop trim). Entries record the call depth at their
  ;; GRANT_START, so a frame's own entries carry frameDepth ==
  ;; $departing_depth. Strict >= keeps airlock-staged inheritance
  ;; entries (frameDepth 0) on their existing lifecycle.
  (func $trim_grants_to_frame_depth (param $departing_depth i32)
    (local $grant_pointer i32)
    (local $grant_base i32)
    (block $done
      (loop $trim
        (local.set $grant_pointer (call $read_ctx (global.get $CTX_GRANT_STACK_POINTER)))
        (local.set $grant_base (call $read_ctx (global.get $CTX_GRANT_STACK_BASE)))
        (br_if $done (i32.le_u (local.get $grant_pointer) (local.get $grant_base)))
        (br_if $done
          (i32.lt_u
            (i32.load (call $abs
              (i32.add
                (i32.sub (local.get $grant_pointer) (global.get $GRANT_ENTRY_SIZE))
                (global.get $GRANT_FRAME_DEPTH))))
            (local.get $departing_depth)))
        (call $write_ctx (global.get $CTX_GRANT_STACK_POINTER)
          (i32.sub (local.get $grant_pointer) (global.get $GRANT_ENTRY_SIZE)))
        (br $trim)
      )
    )
  )

  ;; Restore the pending pointer to a try entry's saved position
  ;; (block-relative → absolute against the CURRENT pending base). Called
  ;; on every ABNORMAL handler entry — throw→catch, throw→finally,
  ;; return→finally — so handlers start at the try's own depth instead of
  ;; whatever mid-expression depth the abnormal exit left behind.
  (func $restore_try_pending (param $saved_relative i32)
    (call $write_ctx (global.get $CTX_PENDING_POINTER)
      (i32.add (call $pending_base_seg) (local.get $saved_relative))))

  ;; Pop try entry. Clamps the grant stack to the departing entry's
  ;; snapshot first (v12) — this one site covers every unwind-walk pop,
  ;; FINALLY_END's holder pop, and the normal TRY_POP opcode.
  (func $try_pop
    (call $clamp_grants_to_top_try_entry)
    (call $write_ctx (global.get $CTX_TRY_STACK_POINTER)
      (i32.sub
        (call $read_ctx (global.get $CTX_TRY_STACK_POINTER))
        (global.get $TRY_ENTRY_SIZE)))
  )

  ;; Get try stack depth
  ;; CTX_TRY_STACK_POINTER is segment-relative (context_base + offset)
  (func $try_depth (result i32)
    (i32.div_u
      (i32.sub
        (call $read_ctx (global.get $CTX_TRY_STACK_POINTER))
        (call $try_stack_base_seg))
      (global.get $TRY_ENTRY_SIZE)))

  ;; Read try entry field at given depth (0 = top)
  (func $try_read (param $depth i32) (param $field i32) (result i32)
    (local $entry_pointer i32)
    ;; entry_pointer = try_pointer - (depth + 1) * TRY_ENTRY_SIZE
    (local.set $entry_pointer
      (i32.sub
        (call $read_ctx (global.get $CTX_TRY_STACK_POINTER))
        (i32.mul
          (i32.add (local.get $depth) (i32.const 1))
          (global.get $TRY_ENTRY_SIZE))))
    (i32.load (call $abs (i32.add (local.get $entry_pointer) (local.get $field)))))

  ;; Write a field of the TOP try entry (v11 disarm/completion writes).
  (func $try_write_top (param $field i32) (param $value i32)
    (i32.store
      (call $abs
        (i32.add
          (i32.sub
            (call $read_ctx (global.get $CTX_TRY_STACK_POINTER))
            (global.get $TRY_ENTRY_SIZE))
          (local.get $field)))
      (local.get $value)))

  ;; Store a completion into the TOP try entry: type plus a 16-byte value
  ;; (type word / flags / lo / hi — the standard value-slot shape).
  (func $try_store_completion
      (param $completion_type i32)
      (param $value_type i32) (param $value_flags i32)
      (param $value_lo i32) (param $value_hi i32)
    (local $value_addr i32)
    (local.set $value_addr
      (call $abs
        (i32.add
          (i32.sub
            (call $read_ctx (global.get $CTX_TRY_STACK_POINTER))
            (global.get $TRY_ENTRY_SIZE))
          (global.get $TRY_COMPLETION_VALUE))))
    (call $try_write_top (global.get $TRY_COMPLETION_TYPE) (local.get $completion_type))
    (i32.store (local.get $value_addr) (local.get $value_type))
    (i32.store (i32.add (local.get $value_addr) (i32.const 4)) (local.get $value_flags))
    (i32.store (i32.add (local.get $value_addr) (i32.const 8)) (local.get $value_lo))
    (i32.store (i32.add (local.get $value_addr) (i32.const 12)) (local.get $value_hi))
  )

  ;; Push the TOP try entry's 16-byte completion value onto the pending
  ;; stack (FINALLY_END's RETURN re-dispatch reads it back this way).
  (func $try_push_completion_value_to_pending
    (local $value_addr i32)
    (local.set $value_addr
      (call $abs
        (i32.add
          (i32.sub
            (call $read_ctx (global.get $CTX_TRY_STACK_POINTER))
            (global.get $TRY_ENTRY_SIZE))
          (global.get $TRY_COMPLETION_VALUE))))
    (call $pending_push
      (i32.load (local.get $value_addr))
      (i32.load (i32.add (local.get $value_addr) (i32.const 4)))
      (i32.load (i32.add (local.get $value_addr) (i32.const 8)))
      (i32.load (i32.add (local.get $value_addr) (i32.const 12))))
  )

  ;; Copy the TOP try entry's 16-byte completion value into the context's
  ;; inline completion-value storage and point CTX_COMPLETION_VALUE at it
  ;; (FINALLY_END's THROW re-dispatch feeds $throw_dispatch this way).
  (func $try_copy_completion_value_to_ctx
    (local $src i32)
    (local $dst i32)
    (local.set $src
      (call $abs
        (i32.add
          (i32.sub
            (call $read_ctx (global.get $CTX_TRY_STACK_POINTER))
            (global.get $TRY_ENTRY_SIZE))
          (global.get $TRY_COMPLETION_VALUE))))
    (local.set $dst
      (i32.add
        (global.get $current_context_base)
        (global.get $CTX_COMPLETION_VALUE_STORAGE)))
    (i32.store (call $abs (local.get $dst)) (i32.load (local.get $src)))
    (i32.store (call $abs (i32.add (local.get $dst) (i32.const 4)))
      (i32.load (i32.add (local.get $src) (i32.const 4))))
    (i32.store (call $abs (i32.add (local.get $dst) (i32.const 8)))
      (i32.load (i32.add (local.get $src) (i32.const 8))))
    (i32.store (call $abs (i32.add (local.get $dst) (i32.const 12)))
      (i32.load (i32.add (local.get $src) (i32.const 12))))
    (call $write_ctx (global.get $CTX_COMPLETION_VALUE) (local.get $dst))
  )

  ;; ==========================================================================
  ;; v11 unwind machinery.
  ;;
  ;; One dispatch path for every abrupt completion. Entered handlers keep
  ;; their try entry on the stack, DISARMED (index fields zeroed), holding
  ;; the pending completion; FINALLY_END pops the entry and re-dispatches.
  ;; This is what makes the machinery re-entrant: a throw, return, call,
  ;; or nested try INSIDE a finally block never clobbers the pending
  ;; completion (it lives in the entry, not in a shared slot), and an
  ;; abrupt exit OUT of a finally simply pops the disarmed holder,
  ;; abandoning its completion — the JS semantics.
  ;; ==========================================================================

  ;; Throw dispatch: walk the try stack for a handler. Precondition: the
  ;; exception is saved in the context completion-value storage
  ;; (CTX_COMPLETION_VALUE set, CTX_COMPLETION_TYPE = THROW). A nonzero
  ;; error_code identifies a catchable engine error whose host-facing
  ;; metadata must survive finally diversion; zero identifies an ordinary
  ;; language-level throw.
  ;;
  ;; Returns 0 = handler found: CTX_INSTRUCTION_INDEX holds the handler
  ;; pc, scope and pending are restored. Returns 1 = no handler: the exit
  ;; condition is set (EXIT_ASYNC_REJECTED for async contexts, preserved
  ;; engine error or USER_THROW otherwise) and the caller must exit.
  (func $throw_dispatch
    (param $error_code i32)
    (param $error_detail i32)
    (param $error_instruction_index i32)
    (result i32)
    (local $catch_index i32)
    (local $finally_index i32)
    (local $frame_depth i32)
    (local $saved_scope i32)
    (local $saved_pending i32)
    (local $stack_pointer i32)
    (local $frame_pointer i32)
    (local $async_promise i32)
    (local $ctx_value i32)
    (block $handler_found
      (block $no_handler
        (loop $search_loop
          (br_if $no_handler (i32.eqz (call $try_depth)))

          (local.set $catch_index (call $try_read (i32.const 0) (global.get $TRY_CATCH_INDEX)))
          (local.set $finally_index (call $try_read (i32.const 0) (global.get $TRY_FINALLY_INDEX)))
          (local.set $frame_depth (call $try_read (i32.const 0) (global.get $TRY_FRAME_DEPTH)))
          (local.set $saved_scope (call $try_read (i32.const 0) (global.get $TRY_SCOPE)))
          (local.set $saved_pending (call $try_read (i32.const 0) (global.get $TRY_PENDING_POSITION)))

          ;; Catch handles the exception. The entry is KEPT, catch-disarmed
          ;; (v11): if it has a finally, abrupt exits from the catch block
          ;; still route through it; either way the catch block ends with a
          ;; parser-emitted TRY_POP that pops or diverts. Keeping the entry
          ;; unconditionally is what makes the parser's static unwind
          ;; counting (UNWIND_JUMP) valid inside catch blocks.
          (if (i32.ne (local.get $catch_index) (i32.const 0))
            (then
              (call $unwind_frames_to (local.get $frame_depth))
              (call $restore_try_pending (local.get $saved_pending))
              (call $clamp_grants_to_top_try_entry)
              (global.set $current_scope (local.get $saved_scope))
              (call $write_ctx (global.get $CTX_SCOPE) (local.get $saved_scope))
              (call $try_write_top (global.get $TRY_CATCH_INDEX) (i32.const 0))
              (call $try_write_top (global.get $TRY_COMPLETION_TYPE) (global.get $COMPLETION_NORMAL))
              (call $restore_completion_value)
              (call $write_ctx (global.get $CTX_COMPLETION_TYPE) (global.get $COMPLETION_NORMAL))
              (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $catch_index))
              (br $handler_found)
            )
          )

          ;; Finally without catch: divert through it. The entry stays as
          ;; the disarmed holder carrying the THROW completion.
          (if (i32.ne (local.get $finally_index) (i32.const 0))
            (then
              (call $unwind_frames_to (local.get $frame_depth))
              (call $restore_try_pending (local.get $saved_pending))
              (call $clamp_grants_to_top_try_entry)
              (global.set $current_scope (local.get $saved_scope))
              (call $write_ctx (global.get $CTX_SCOPE) (local.get $saved_scope))
              (call $try_write_top (global.get $TRY_FINALLY_INDEX) (i32.const 0))
              ;; Copy the exception from ctx storage into the entry.
              (local.set $ctx_value (call $read_ctx (global.get $CTX_COMPLETION_VALUE)))
              (call $try_store_completion
                (global.get $COMPLETION_THROW)
                (i32.load (call $abs (local.get $ctx_value)))
                (i32.load (call $abs (i32.add (local.get $ctx_value) (i32.const 4))))
                (i32.load (call $abs (i32.add (local.get $ctx_value) (i32.const 8))))
                (i32.load (call $abs (i32.add (local.get $ctx_value) (i32.const 12)))))
              (call $try_write_top
                (global.get $TRY_ERROR_CODE) (local.get $error_code))
              (call $try_write_top
                (global.get $TRY_ERROR_DETAIL) (local.get $error_detail))
              (call $try_write_top
                (global.get $TRY_ERROR_INSTRUCTION_INDEX)
                (local.get $error_instruction_index))
              (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $finally_index))
              (br $handler_found)
            )
          )

          ;; Neither armed (catch-only already consumed, or a disarmed
          ;; holder whose completion is now abandoned) — pop and continue.
          (call $try_pop)
          (br $search_loop)
        )
      )

      ;; No handler found — set the exit condition for the caller.
      ;; Generator context: the uncaught exception completes the
      ;; generator; the airlock rethrows it in the next() caller
      ;; (exception value is already in the completion slot).
      (if (i32.ne (call $read_ctx (global.get $CTX_GENERATOR_OBJECT)) (i32.const 0))
        (then
          (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_GENERATOR_THROW))
          (return (i32.const 1))
        )
      )
      (local.set $stack_pointer (call $read_ctx (global.get $CTX_CALL_STACK_POINTER)))
      (if (i32.gt_u (local.get $stack_pointer)
                    (call $call_stack_base_seg))
        (then
          (local.set $frame_pointer (call $abs
            (call $call_stack_base_seg)))
          (local.set $async_promise (i32.load (i32.add (local.get $frame_pointer) (global.get $FRAME_ASYNC_PROMISE))))
          (if (i32.ne (local.get $async_promise) (i32.const 0))
            (then
              (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_ASYNC_REJECTED))
              (return (i32.const 1))
            )
          )
        )
      )
      (if (local.get $error_code)
        (then
          (call $set_error
            (local.get $error_code)
            (local.get $error_detail))
          (call $stamp_error_info
            (local.get $error_code)
            (local.get $error_detail)
            (local.get $error_instruction_index)))
        (else
          (call $set_error (global.get $ERR_USER_THROW) (i32.const 0))))
      (return (i32.const 1))
    )

    ;; Handler found
    (i32.const 0)
  )

  ;; Return dispatch: find a finally to divert through before the current
  ;; frame's return completes. Pops catch-only and disarmed entries that
  ;; belong to the current call frame (the return abandons them); stops at
  ;; entries of outer frames. When an armed finally is found, the return
  ;; value is stored in the entry (COMPLETION_RETURN), the entry is
  ;; disarmed, scope and pending restored, and its finally pc returned.
  ;; Returns 0 when no finally intercepts (the caller runs its return
  ;; tail).
  (func $return_dispatch_finally
      (param $result_type i32) (param $result_flags i32)
      (param $result_lo i32) (param $result_hi i32)
      (result i32)
    (local $current_depth i32)
    (local $finally_index i32)
    (local.set $current_depth (call $get_frame_depth))
    (block $done
      (loop $search_loop
        (br_if $done (i32.eqz (call $try_depth)))
        (br_if $done
          (i32.ne
            (call $try_read (i32.const 0) (global.get $TRY_FRAME_DEPTH))
            (local.get $current_depth)))

        (local.set $finally_index (call $try_read (i32.const 0) (global.get $TRY_FINALLY_INDEX)))
        (if (i32.ne (local.get $finally_index) (i32.const 0))
          (then
            (call $restore_try_pending
              (call $try_read (i32.const 0) (global.get $TRY_PENDING_POSITION)))
            (call $clamp_grants_to_top_try_entry)
            (global.set $current_scope (call $try_read (i32.const 0) (global.get $TRY_SCOPE)))
            (call $try_write_top (global.get $TRY_CATCH_INDEX) (i32.const 0))
            (call $try_write_top (global.get $TRY_FINALLY_INDEX) (i32.const 0))
            (call $try_store_completion
              (global.get $COMPLETION_RETURN)
              (local.get $result_type) (local.get $result_flags)
              (local.get $result_lo) (local.get $result_hi))
            (return (local.get $finally_index))
          )
        )

        (call $try_pop)
        (br $search_loop)
      )
    )
    ;; No finally intercepts: the caller pops the frame. Trim the
    ;; frame's own grant entries first (v12) — grants pushed since the
    ;; frame's last try entry (or all of them, when the frame had no
    ;; trys) have no snapshot left to clamp them.
    (if (i32.gt_u (local.get $current_depth) (i32.const 0))
      (then (call $trim_grants_to_frame_depth (local.get $current_depth))))
    (i32.const 0)
  )

  ;; Jump unwind: pop $count try entries (all belong to the current call
  ;; frame — the parser counts them statically for break/continue),
  ;; diverting through each armed finally with a COMPLETION_JUMP carrying
  ;; {target, remaining}. Returns the finally pc to divert to, or 0 when
  ;; all entries are unwound (the caller jumps to $target).
  (func $unwind_toward (param $target i32) (param $count i32) (result i32)
    (local $finally_index i32)
    (block $done
      (loop $unwind_loop
        (br_if $done (i32.eqz (local.get $count)))

        (local.set $finally_index (call $try_read (i32.const 0) (global.get $TRY_FINALLY_INDEX)))
        (if (i32.ne (local.get $finally_index) (i32.const 0))
          (then
            (call $restore_try_pending
              (call $try_read (i32.const 0) (global.get $TRY_PENDING_POSITION)))
            (call $clamp_grants_to_top_try_entry)
            (global.set $current_scope (call $try_read (i32.const 0) (global.get $TRY_SCOPE)))
            (call $try_write_top (global.get $TRY_CATCH_INDEX) (i32.const 0))
            (call $try_write_top (global.get $TRY_FINALLY_INDEX) (i32.const 0))
            (call $try_store_completion
              (global.get $COMPLETION_JUMP)
              (i32.const 0) (i32.const 0)
              (local.get $target)
              (i32.sub (local.get $count) (i32.const 1)))
            (return (local.get $finally_index))
          )
        )

        (call $try_pop)
        (local.set $count (i32.sub (local.get $count) (i32.const 1)))
        (br $unwind_loop)
      )
    )
    (i32.const 0)
  )

  ;; ==========================================================================
  ;; Completion value operations
  ;; Design B: the completion value lives in 16 bytes of inline storage in the
  ;; context object (CTX_COMPLETION_VALUE_STORAGE). It used to sit in a reserved
  ;; slot just below the pending stack base, which only worked while the pending
  ;; stack was inside a larger slab; with each stack its own heap block that slot
  ;; would land in a neighbouring object.
  ;; ==========================================================================

  ;; Copy value from pending stack top to completion value slot
  (func $save_completion_value
    (local $src i32)
    (local $dst i32)

    ;; src = pending_pointer - VALUE_SIZE (current top value)
    (local.set $src (call $pending_peek))
    ;; dst = the context object's inline completion-value storage (segment-relative)
    (local.set $dst
      (i32.add
        (global.get $current_context_base)
        (global.get $CTX_COMPLETION_VALUE_STORAGE)))

    ;; Copy 16 bytes
    (i32.store (call $abs (local.get $dst))
      (i32.load (call $abs (local.get $src))))
    (i32.store (call $abs (i32.add (local.get $dst) (i32.const 4)))
      (i32.load (call $abs (i32.add (local.get $src) (i32.const 4)))))
    (i32.store (call $abs (i32.add (local.get $dst) (i32.const 8)))
      (i32.load (call $abs (i32.add (local.get $src) (i32.const 8)))))
    (i32.store (call $abs (i32.add (local.get $dst) (i32.const 12)))
      (i32.load (call $abs (i32.add (local.get $src) (i32.const 12)))))

    ;; Update COMPLETION_VALUE pointer
    (call $write_ctx (global.get $CTX_COMPLETION_VALUE) (local.get $dst))
  )

  ;; Push completion value back to pending stack
  (func $restore_completion_value
    (local $src i32)

    (local.set $src (call $read_ctx (global.get $CTX_COMPLETION_VALUE)))

    (call $pending_push
      (i32.load (call $abs (local.get $src)))
      (i32.load (call $abs (i32.add (local.get $src) (i32.const 4))))
      (i32.load (call $abs (i32.add (local.get $src) (i32.const 8))))
      (i32.load (call $abs (i32.add (local.get $src) (i32.const 12)))))
  )

  ;; ==========================================================================
  ;; extends-externals D3: stage an owed abortConstruction for a branded,
  ;; construction-pending receiver. Clears CONSTRUCTION_PENDING (the
  ;; exactly-once latch), chains any previously staged duty through the
  ;; receiver's pre-allocated @constructionLink hidden entry (a
  ;; TYPE_OBJECT value the ordinary object walk keeps alive), and makes
  ;; this receiver the duty head. The dispatch-loop head drains duties
  ;; before the next instruction executes, so the host abort runs before
  ;; the failure propagates into drone code.
  ;; ==========================================================================
  (func $stage_construction_abort (param $receiver i32)
    (local $entry i32)
    (local $tail i32)
    ;; Clear PENDING — exactly-once across suspension, retry, and nesting.
    (i32.store (call $abs (i32.add (local.get $receiver) (i32.const 20)))
      (i32.and
        (i32.load (call $abs (i32.add (local.get $receiver) (i32.const 20))))
        (i32.xor (global.get $OBJECT_FLAG_CONSTRUCTION_PENDING) (i32.const -1))))
    ;; This receiver's own chain slot terminates the chain.
    (local.set $entry (call $object_find_string_entry (local.get $receiver)
      (call $read_builtin (global.get $BUILTIN_CONSTRUCTION_LINK))))
    (if (i32.ne (local.get $entry) (i32.const 0))
      (then
        (i32.store (call $abs (i32.add (local.get $entry) (i32.const 4))) (global.get $TYPE_UNDEFINED))
        (i32.store (call $abs (i32.add (local.get $entry) (i32.const 12))) (i32.const 0))
      )
    )
    ;; The unwind walk pops innermost frames first and inner
    ;; constructions must abort first (LIFO), so a receiver staged
    ;; while a duty is already owed APPENDS at the chain's tail.
    (if (i32.eqz (call $read_ctx (global.get $CTX_CONSTRUCTION_DUTY)))
      (then
        (call $write_ctx (global.get $CTX_CONSTRUCTION_DUTY) (local.get $receiver))
      )
      (else
        (local.set $tail (call $read_ctx (global.get $CTX_CONSTRUCTION_DUTY)))
        (block $appended
          (loop $walk
            (local.set $entry (call $object_find_string_entry (local.get $tail)
              (call $read_builtin (global.get $BUILTIN_CONSTRUCTION_LINK))))
            ;; A chain member without a link slot is structurally
            ;; unreachable; stop rather than trap.
            (br_if $appended (i32.eqz (local.get $entry)))
            (if (i32.eq (i32.load (call $abs (i32.add (local.get $entry) (i32.const 4)))) (global.get $TYPE_OBJECT))
              (then
                (local.set $tail (i32.load (call $abs (i32.add (local.get $entry) (i32.const 12)))))
                (br $walk)
              )
            )
            (i32.store (call $abs (i32.add (local.get $entry) (i32.const 4))) (global.get $TYPE_OBJECT))
            (i32.store (call $abs (i32.add (local.get $entry) (i32.const 12))) (local.get $receiver))
          )
        )
      )
    )
  )

  ;; Unwind call frames to a target depth
  ;; Pops frames until frame_depth matches target, restoring scope
  (func $unwind_frames_to (param $target_depth i32)
    (local $stack_pointer i32)
    (local $stack_base i32)
    (local $frame_pointer i32)

    (block $done
      (loop $loop
        ;; current_depth = (stack_pointer - stack_base) / FRAME_SIZE
        (local.set $stack_pointer (call $read_ctx (global.get $CTX_CALL_STACK_POINTER)))
        ;; stack_base = the call stack block's base (read from state block)
        (local.set $stack_base (call $call_stack_base_seg))

        ;; If at target depth, done
        (br_if $done
          (i32.le_u
            (i32.div_u
              (i32.sub (local.get $stack_pointer) (local.get $stack_base))
              (global.get $FRAME_SIZE))
            (local.get $target_depth)))

        ;; Pop frame
        (local.set $stack_pointer (i32.sub (local.get $stack_pointer) (global.get $FRAME_SIZE)))
        (call $write_ctx (global.get $CTX_CALL_STACK_POINTER) (local.get $stack_pointer))

        ;; Restore scope from popped frame
        (local.set $frame_pointer (call $abs (local.get $stack_pointer)))
        (global.set $current_scope
          (i32.load (i32.add (local.get $frame_pointer) (global.get $FRAME_SCOPE_POINTER))))

        ;; extends-externals D3: an abruptly discarded constructor frame
        ;; whose receiver is still construction-pending owes an abort.
        (if (i32.and
              (i32.load (i32.add (local.get $frame_pointer) (global.get $FRAME_FLAGS)))
              (global.get $FRAME_FLAG_CONSTRUCTOR))
          (then
            (if (i32.and
                  (i32.load (call $abs (i32.add
                    (i32.load (i32.add (local.get $frame_pointer) (global.get $FRAME_CONTINUATION_STATE_1)))
                    (i32.const 20))))
                  (global.get $OBJECT_FLAG_CONSTRUCTION_PENDING))
              (then
                (call $stage_construction_abort
                  (i32.load (i32.add (local.get $frame_pointer) (global.get $FRAME_CONTINUATION_STATE_1))))
              )
            )
          )
        )

        ;; Restore pending pointer from frame
        (call $write_ctx (global.get $CTX_PENDING_POINTER)
          (call $load_frame_pending_base (local.get $frame_pointer)))

        (br $loop)
      )
    )
  )

  ;; ==========================================================================
  ;; Instruction reading (Reverse-Growing Code Block)
  ;;
  ;; Code block grows backward from STRING_START. Layout:
  ;;   [instr N]...[instr 1][instr 0][count:4][flags:4][GC:8] STRING_START
  ;;   ↑                             ↑                       ↑
  ;;   lowest addr              CODE_START            STRING_START
  ;;
  ;; CODE_START = STRING_START - 16 (fixed header position)
  ;; instr_address = CODE_START - (index + 1) * INSTRUCTION_SIZE
  ;;
  ;; Instruction format: [opcode:1][flags:1][reserved:2][astNode:4][operand1:4][operand2:4]
  ;; ==========================================================================

  ;; Get the fixed code block start (header position)
  (func $get_code_start (result i32)
    (i32.sub
      (call $read_state (global.get $STATE_STRING_START))
      (i32.const 16)))

  ;; Read instruction at index from the reverse-growing code block
  ;; instr_address = CODE_START - (index + 1) * 16
  (func $read_opcode (param $code_block i32) (param $index i32) (result i32)
    (local $instruction_pointer i32)
    (local.set $instruction_pointer
      (i32.sub
        (call $get_code_start)
        (i32.mul
          (i32.add (local.get $index) (i32.const 1))
          (global.get $INSTRUCTION_SIZE))))
    (i32.load8_u (call $abs (local.get $instruction_pointer)))
  )

  (func $read_operand1 (param $code_block i32) (param $index i32) (result i32)
    (local $instruction_pointer i32)
    (local.set $instruction_pointer
      (i32.sub
        (call $get_code_start)
        (i32.mul
          (i32.add (local.get $index) (i32.const 1))
          (global.get $INSTRUCTION_SIZE))))
    (i32.load (call $abs (i32.add (local.get $instruction_pointer) (i32.const 8))))
  )

  (func $read_operand2 (param $code_block i32) (param $index i32) (result i32)
    (local $instruction_pointer i32)
    (local.set $instruction_pointer
      (i32.sub
        (call $get_code_start)
        (i32.mul
          (i32.add (local.get $index) (i32.const 1))
          (global.get $INSTRUCTION_SIZE))))
    (i32.load (call $abs (i32.add (local.get $instruction_pointer) (i32.const 12))))
  )

  ;; Read instruction count from the fixed header
  (func $read_instr_count (param $code_block i32) (result i32)
    (i32.load (call $abs (call $get_code_start)))
  )

  ;; ==========================================================================
  ;; is_truthy: check if value is truthy
  ;; ==========================================================================
  (func $is_truthy (param $pointer i32) (result i32)
    (local $type i32)
    (local $data_lo i32)

    (local.set $type (call $value_type (local.get $pointer)))
    (local.set $data_lo (call $value_data_lo (local.get $pointer)))

    ;; null and undefined are falsy
    (if (i32.eq (local.get $type) (global.get $TYPE_NULL))
      (then (return (i32.const 0))))
    (if (i32.eq (local.get $type) (global.get $TYPE_UNDEFINED))
      (then (return (i32.const 0))))

    ;; boolean: check data_lo
    (if (i32.eq (local.get $type) (global.get $TYPE_BOOLEAN))
      (then (return (local.get $data_lo))))

    ;; integer: 0 is falsy
    (if (i32.eq (local.get $type) (global.get $TYPE_INTEGER))
      (then (return (i32.ne (local.get $data_lo) (i32.const 0)))))

    ;; float: 0.0 is falsy (check if both words are 0)
    (if (i32.eq (local.get $type) (global.get $TYPE_FLOAT))
      (then
        (return (i32.or
          (i32.ne (local.get $data_lo) (i32.const 0))
          (i32.ne (call $value_data_hi (local.get $pointer)) (i32.const 0))))))

    ;; rational: 0/1 is falsy. Inline: i64 payload == 0. Heap: numerator BigInt length == 0.
    (if (i32.eq (local.get $type) (global.get $TYPE_RATIONAL))
      (then
        (if (call $rational_is_inline (local.get $pointer))
          (then (return (i32.or
            (i32.ne (local.get $data_lo) (i32.const 0))
            (i32.ne (call $value_data_hi (local.get $pointer)) (i32.const 0))))))
        ;; Heap form: zero iff numerator BigInt has length 0
        (return (i32.ne
          (call $bigint_length (call $rational_numerator (local.get $data_lo)))
          (i32.const 0)))))

    ;; bigint: 0n is falsy (length == 0)
    (if (i32.eq (local.get $type) (global.get $TYPE_BIGINT))
      (then
        ;; data_lo is header pointer; length is at header + GC_HEADER_SIZE + 4
        (return (i32.ne
          (i32.load (call $abs (i32.add
            (i32.add (local.get $data_lo) (global.get $GC_HEADER_SIZE))
            (i32.const 4))))
          (i32.const 0)))))

    ;; string: empty string is falsy (check length at string offset).
    ;; data_lo is a table-relative interned string id under format v7; must
    ;; resolve via $string_id_to_abs, not $abs.
    (if (i32.eq (local.get $type) (global.get $TYPE_STRING))
      (then
        (return (i32.ne
          (i32.load (call $string_id_to_abs (local.get $data_lo)))
          (i32.const 0)))))

    ;; Everything else is truthy
    (i32.const 1)
  )

  ;; ==========================================================================
  ;; is_indexed_collection_callback_method
  ;;
  ;; Returns 1 for public Array and typed-array methods whose second
  ;; argument is a callback and whose optional next argument is `thisArg`.
  ;; This is entry-time public method classification, not continuation
  ;; dispatch; return-time control flow uses CONTINUATION_KIND exclusively.
  ;; ==========================================================================
  (func $is_indexed_collection_callback_method (param $method_id i32) (result i32)
    (i32.or
      (i32.or
        (i32.or
          ;; Array callback methods
          (i32.or
            (i32.or
              (i32.eq (local.get $method_id) (global.get $METHOD_MAP))
              (i32.eq (local.get $method_id) (global.get $METHOD_FILTER)))
            (i32.or
              (i32.or (i32.eq (local.get $method_id) (global.get $METHOD_REDUCE)) (i32.eq (local.get $method_id) (global.get $METHOD_ARRAY_REDUCE_RIGHT)))
              (i32.eq (local.get $method_id) (global.get $METHOD_FOR_EACH))))
          (i32.or
            (i32.or
              (i32.or
                (i32.eq (local.get $method_id) (global.get $METHOD_FIND))
                (i32.eq (local.get $method_id) (global.get $METHOD_FIND_INDEX)))
              (i32.or
                (i32.eq (local.get $method_id) (global.get $METHOD_FIND_LAST))
                (i32.eq (local.get $method_id) (global.get $METHOD_FIND_LAST_INDEX))))
            (i32.or
              (i32.eq (local.get $method_id) (global.get $METHOD_SOME))
              (i32.eq (local.get $method_id) (global.get $METHOD_EVERY)))))
        (i32.eq (local.get $method_id) (global.get $METHOD_FLAT_MAP)))
      ;; Uint8Array callback methods
      (i32.or
        (i32.or
          (i32.or
            (i32.eq (local.get $method_id) (global.get $METHOD_UINT8ARRAY_FOR_EACH))
            (i32.eq (local.get $method_id) (global.get $METHOD_UINT8ARRAY_MAP)))
          (i32.or
            (i32.eq (local.get $method_id) (global.get $METHOD_UINT8ARRAY_FILTER))
            (i32.eq (local.get $method_id) (global.get $METHOD_UINT8ARRAY_FIND))))
        (i32.or
          (i32.or
            (i32.or
              (i32.eq (local.get $method_id) (global.get $METHOD_UINT8ARRAY_FIND_INDEX))
              (i32.eq (local.get $method_id) (global.get $METHOD_UINT8ARRAY_FIND_LAST)))
            (i32.or
              (i32.eq (local.get $method_id) (global.get $METHOD_UINT8ARRAY_FIND_LAST_INDEX))
              (i32.eq (local.get $method_id) (global.get $METHOD_UINT8ARRAY_EVERY))))
          (i32.or
            (i32.or
              (i32.eq (local.get $method_id) (global.get $METHOD_UINT8ARRAY_SOME))
              (i32.eq (local.get $method_id) (global.get $METHOD_UINT8ARRAY_REDUCE)))
            (i32.eq (local.get $method_id) (global.get $METHOD_UINT8ARRAY_REDUCE_RIGHT))))))
  )

  ;; Map a public callback method identifier to the native continuation kind
  ;; stored in FRAME_CONTINUATION_KIND. The namespaces intentionally retain
  ;; equal wire values during migration, but every frame creation crosses this
  ;; checked boundary so future continuation numbering is independent.
  (func $continuation_kind_from_callback_method (param $method_id i32) (result i32)
    (if (i32.eq (local.get $method_id) (global.get $METHOD_MAP))
      (then (return (global.get $CONTINUATION_KIND_ARRAY_MAP))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_FILTER))
      (then (return (global.get $CONTINUATION_KIND_ARRAY_FILTER))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_REDUCE))
      (then (return (global.get $CONTINUATION_KIND_ARRAY_REDUCE))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_FOR_EACH))
      (then (return (global.get $CONTINUATION_KIND_ARRAY_FOR_EACH))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_FIND))
      (then (return (global.get $CONTINUATION_KIND_ARRAY_FIND))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_FIND_INDEX))
      (then (return (global.get $CONTINUATION_KIND_ARRAY_FIND_INDEX))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_FIND_LAST))
      (then (return (global.get $CONTINUATION_KIND_ARRAY_FIND_LAST))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_FIND_LAST_INDEX))
      (then (return (global.get $CONTINUATION_KIND_ARRAY_FIND_LAST_INDEX))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_SOME))
      (then (return (global.get $CONTINUATION_KIND_ARRAY_SOME))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_EVERY))
      (then (return (global.get $CONTINUATION_KIND_ARRAY_EVERY))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_SORT))
      (then (return (global.get $CONTINUATION_KIND_ARRAY_SORT))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_FLAT_MAP))
      (then (return (global.get $CONTINUATION_KIND_ARRAY_FLAT_MAP))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_ARRAY_REDUCE_RIGHT))
      (then (return (global.get $CONTINUATION_KIND_ARRAY_REDUCE_RIGHT))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_UINT8ARRAY_FOR_EACH))
      (then (return (global.get $CONTINUATION_KIND_TYPED_ARRAY_FOR_EACH))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_UINT8ARRAY_MAP))
      (then (return (global.get $CONTINUATION_KIND_TYPED_ARRAY_MAP))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_UINT8ARRAY_FILTER))
      (then (return (global.get $CONTINUATION_KIND_TYPED_ARRAY_FILTER))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_UINT8ARRAY_FIND))
      (then (return (global.get $CONTINUATION_KIND_TYPED_ARRAY_FIND))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_UINT8ARRAY_FIND_INDEX))
      (then (return (global.get $CONTINUATION_KIND_TYPED_ARRAY_FIND_INDEX))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_UINT8ARRAY_FIND_LAST))
      (then (return (global.get $CONTINUATION_KIND_TYPED_ARRAY_FIND_LAST))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_UINT8ARRAY_FIND_LAST_INDEX))
      (then (return (global.get $CONTINUATION_KIND_TYPED_ARRAY_FIND_LAST_INDEX))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_UINT8ARRAY_EVERY))
      (then (return (global.get $CONTINUATION_KIND_TYPED_ARRAY_EVERY))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_UINT8ARRAY_SOME))
      (then (return (global.get $CONTINUATION_KIND_TYPED_ARRAY_SOME))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_UINT8ARRAY_REDUCE))
      (then (return (global.get $CONTINUATION_KIND_TYPED_ARRAY_REDUCE))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_UINT8ARRAY_REDUCE_RIGHT))
      (then (return (global.get $CONTINUATION_KIND_TYPED_ARRAY_REDUCE_RIGHT))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_UINT8ARRAY_SORT))
      (then (return (global.get $CONTINUATION_KIND_TYPED_ARRAY_SORT))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_MAP_FOREACH))
      (then (return (global.get $CONTINUATION_KIND_MAP_FOR_EACH))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_SET_FOREACH))
      (then (return (global.get $CONTINUATION_KIND_SET_FOR_EACH))))
    (unreachable)
  )

  ;; ==========================================================================
  ;; is_uint8array_callback_method
  ;;
  ;; Returns 1 if method_id is a Uint8Array callback method, 0 otherwise.
  ;; Used to distinguish Uint8Array iteration from Array iteration.
  ;; ==========================================================================
  (func $is_uint8array_callback_method (param $method_id i32) (result i32)
    (i32.or
      (i32.or
        (i32.or
          (i32.eq (local.get $method_id) (global.get $METHOD_UINT8ARRAY_FOR_EACH))
          (i32.eq (local.get $method_id) (global.get $METHOD_UINT8ARRAY_MAP)))
        (i32.or
          (i32.eq (local.get $method_id) (global.get $METHOD_UINT8ARRAY_FILTER))
          (i32.eq (local.get $method_id) (global.get $METHOD_UINT8ARRAY_FIND))))
      (i32.or
        (i32.or
          (i32.or
            (i32.eq (local.get $method_id) (global.get $METHOD_UINT8ARRAY_FIND_INDEX))
            (i32.eq (local.get $method_id) (global.get $METHOD_UINT8ARRAY_FIND_LAST)))
          (i32.or
            (i32.eq (local.get $method_id) (global.get $METHOD_UINT8ARRAY_FIND_LAST_INDEX))
            (i32.eq (local.get $method_id) (global.get $METHOD_UINT8ARRAY_EVERY))))
        (i32.or
          (i32.or
            (i32.eq (local.get $method_id) (global.get $METHOD_UINT8ARRAY_SOME))
            (i32.eq (local.get $method_id) (global.get $METHOD_UINT8ARRAY_REDUCE)))
          (i32.eq (local.get $method_id) (global.get $METHOD_UINT8ARRAY_REDUCE_RIGHT)))))
  )

  ;; ==========================================================================
  ;; is_find_last_method
  ;;
  ;; Returns 1 if method_id is in the findLast family (findLast /
  ;; findLastIndex, both array kinds). These walk DESCENDING like
  ;; reduceRight: the iteration starts at len-1, the index decrements, and
  ;; completion falls out of the shared unsigned `index < len` check when
  ;; the index wraps at -1.
  ;; ==========================================================================
  (func $is_find_last_method (param $method_id i32) (result i32)
    (i32.or
      (i32.or
        (i32.eq (local.get $method_id) (global.get $METHOD_FIND_LAST))
        (i32.eq (local.get $method_id) (global.get $METHOD_FIND_LAST_INDEX)))
      (i32.or
        (i32.eq (local.get $method_id) (global.get $METHOD_UINT8ARRAY_FIND_LAST))
        (i32.eq (local.get $method_id) (global.get $METHOD_UINT8ARRAY_FIND_LAST_INDEX))))
  )

  ;; Classify the continuation discriminator after callback return. These
  ;; deliberately use the CONTINUATION_KIND namespace rather than relying on
  ;; its persisted numeric values matching the public METHOD namespace.
  (func $is_typed_array_continuation_kind (param $continuation_kind i32) (result i32)
    (i32.or
      (i32.eq
        (local.get $continuation_kind)
        (global.get $CONTINUATION_KIND_TYPED_ARRAY_SORT))
      (i32.or
        (i32.or
          (i32.or
            (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_TYPED_ARRAY_FOR_EACH))
            (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_TYPED_ARRAY_MAP)))
          (i32.or
            (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_TYPED_ARRAY_FILTER))
            (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_TYPED_ARRAY_FIND))))
        (i32.or
          (i32.or
            (i32.or
              (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_TYPED_ARRAY_FIND_INDEX))
              (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_TYPED_ARRAY_FIND_LAST)))
            (i32.or
              (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_TYPED_ARRAY_FIND_LAST_INDEX))
              (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_TYPED_ARRAY_EVERY))))
          (i32.or
            (i32.or
              (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_TYPED_ARRAY_SOME))
              (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_TYPED_ARRAY_REDUCE)))
            (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_TYPED_ARRAY_REDUCE_RIGHT))))))
  )

  (func $is_find_last_continuation_kind (param $continuation_kind i32) (result i32)
    (i32.or
      (i32.or
        (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ARRAY_FIND_LAST))
        (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ARRAY_FIND_LAST_INDEX)))
      (i32.or
        (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_TYPED_ARRAY_FIND_LAST))
        (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_TYPED_ARRAY_FIND_LAST_INDEX))))
  )

  ;; Reject corrupted or stale continuation discriminators before any client
  ;; state is interpreted. The ranges are the dedicated CONTINUATION_KIND
  ;; registry's occupied spans; holes remain invalid.
  (func $is_native_continuation_kind (param $continuation_kind i32) (result i32)
    (if (i32.eq
          (local.get $continuation_kind)
          (global.get $CONTINUATION_KIND_BIGINT_TO_PRIMITIVE))
      (then (return (i32.const 1))))
    ;; Regex replace/replaceAll callback frame: state_0 carries the
    ;; operation's existing state handle through publish unchanged (the
    ;; PROOF_UNIVERSES pattern — uses_state_handle, not indexed).
    (if (i32.eq
          (local.get $continuation_kind)
          (global.get $CONTINUATION_KIND_REGEXP_REPLACE))
      (then (return (i32.const 1))))
    ;; JSON.parse reviver walk: a state-array driver like JSON_TRANSFORM,
    ;; registered explicitly (0x283 sits outside every range below).
    (if (i32.eq
          (local.get $continuation_kind)
          (global.get $CONTINUATION_KIND_JSON_INTERNALIZE))
      (then (return (i32.const 1))))
    (i32.or
      (i32.eq
        (local.get $continuation_kind)
        (global.get $CONTINUATION_KIND_PROOF_UNIVERSES))
      (i32.or
        (i32.or
          (i32.or
            (i32.and
              (i32.ge_u (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ARRAY_MAP))
              (i32.le_u (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ARRAY_EVERY)))
            (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ARRAY_SORT)))
          (i32.or
            (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ARRAY_FLAT_MAP))
            (i32.or
              (i32.and
                (i32.ge_u (local.get $continuation_kind) (global.get $CONTINUATION_KIND_TYPED_ARRAY_FOR_EACH))
                (i32.le_u (local.get $continuation_kind) (global.get $CONTINUATION_KIND_TYPED_ARRAY_REDUCE_RIGHT)))
              (i32.and
                (i32.ge_u (local.get $continuation_kind) (global.get $CONTINUATION_KIND_TYPED_ARRAY_SORT))
                (i32.le_u (local.get $continuation_kind) (global.get $CONTINUATION_KIND_TYPED_ARRAY_FIND_LAST_INDEX))))))
        (i32.or
          (i32.or
            (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_MAP_FOR_EACH))
            (i32.or
              (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_MAP_SEED_FROM_ITERABLE))
              (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_SET_FOR_EACH))))
          (i32.or
            (i32.and
              (i32.ge_u (local.get $continuation_kind) (global.get $CONTINUATION_KIND_SET_SEED_FROM_ITERABLE))
              (i32.le_u (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ARRAY_REDUCE_RIGHT)))
            (i32.and
              (i32.ge_u (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ARRAY_FIND_LAST))
              (i32.le_u (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ARRAY_FIND_LAST_INDEX)))))))
  )

  (func $is_collection_driver_continuation_kind
    (param $continuation_kind i32) (result i32)
    (i32.or
      (i32.or
        (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_MAP_FOR_EACH))
        (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_SET_FOR_EACH)))
      (i32.or
        (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ARRAY_FROM_SEED))
        (i32.or
          (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_MAP_SEED_FROM_ITERABLE))
          (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_SET_SEED_FROM_ITERABLE)))))
  )

  (func $is_indexed_continuation_kind
    (param $continuation_kind i32) (result i32)
    (if (i32.eq
          (local.get $continuation_kind)
          (global.get $CONTINUATION_KIND_BIGINT_TO_PRIMITIVE))
      (then (return (i32.const 1))))
    (if (i32.eq
          (local.get $continuation_kind)
          (global.get $CONTINUATION_KIND_JSON_INTERNALIZE))
      (then (return (i32.const 1))))
    (i32.or
      (i32.or
        (call $is_collection_driver_continuation_kind
          (local.get $continuation_kind))
        (i32.or
          (i32.or
            (i32.eq
              (local.get $continuation_kind)
              (global.get $CONTINUATION_KIND_SETOP_HAS_DRIVEN))
            (i32.eq
              (local.get $continuation_kind)
              (global.get $CONTINUATION_KIND_SETOP_KEYS_DRIVEN)))
          (i32.or
            (i32.eq
              (local.get $continuation_kind)
              (global.get $CONTINUATION_KIND_JSON_TRANSFORM))
            (i32.eq
              (local.get $continuation_kind)
              (global.get $CONTINUATION_KIND_ASSIGN_SETTERS)))))
      (i32.or
        (i32.or
          (i32.and
            (i32.ge_u (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ARRAY_MAP))
            (i32.le_u (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ARRAY_EVERY)))
          (i32.or
            (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ARRAY_SORT))
            (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ARRAY_FLAT_MAP))))
        (i32.or
          (i32.or
            (i32.and
              (i32.ge_u (local.get $continuation_kind) (global.get $CONTINUATION_KIND_TYPED_ARRAY_FOR_EACH))
              (i32.le_u (local.get $continuation_kind) (global.get $CONTINUATION_KIND_TYPED_ARRAY_REDUCE_RIGHT)))
            (i32.and
              (i32.ge_u (local.get $continuation_kind) (global.get $CONTINUATION_KIND_TYPED_ARRAY_SORT))
              (i32.le_u (local.get $continuation_kind) (global.get $CONTINUATION_KIND_TYPED_ARRAY_FIND_LAST_INDEX))))
          (i32.or
            (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ARRAY_REDUCE_RIGHT))
            (i32.or
              (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ARRAY_FIND_LAST))
              (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ARRAY_FIND_LAST_INDEX)))))))
  )

  (func $indexed_state_1_is_header_pointer
    (param $continuation_kind i32) (result i32)
    (if (i32.eq
          (local.get $continuation_kind)
          (global.get $CONTINUATION_KIND_BIGINT_TO_PRIMITIVE))
      (then (return (i32.const 1))))
    (if (i32.eq
          (local.get $continuation_kind)
          (global.get $CONTINUATION_KIND_JSON_INTERNALIZE))
      (then (return (i32.const 1))))
    (i32.or
      (i32.or
        (call $is_collection_driver_continuation_kind
          (local.get $continuation_kind))
        (i32.or
          (i32.or
            (i32.eq
              (local.get $continuation_kind)
              (global.get $CONTINUATION_KIND_SETOP_HAS_DRIVEN))
            (i32.eq
              (local.get $continuation_kind)
              (global.get $CONTINUATION_KIND_SETOP_KEYS_DRIVEN)))
          (i32.or
            (i32.eq
              (local.get $continuation_kind)
              (global.get $CONTINUATION_KIND_JSON_TRANSFORM))
            (i32.eq
              (local.get $continuation_kind)
              (global.get $CONTINUATION_KIND_ASSIGN_SETTERS)))))
      (i32.or
        (i32.or
          (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ARRAY_MAP))
          (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ARRAY_FILTER)))
        (i32.or
          (i32.or
            (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ARRAY_REDUCE))
            (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ARRAY_REDUCE_RIGHT)))
          (i32.or
            (i32.or
              (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ARRAY_SORT))
              (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ARRAY_FLAT_MAP)))
            (i32.or
              (i32.or
                (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_TYPED_ARRAY_REDUCE))
                (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_TYPED_ARRAY_REDUCE_RIGHT)))
              (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_TYPED_ARRAY_SORT)))))))
  )
  (func $continuation_uses_state_handle
    (param $continuation_kind i32) (result i32)
    (i32.or
      (i32.or
        (i32.eq
          (local.get $continuation_kind)
          (global.get $CONTINUATION_KIND_PROOF_UNIVERSES))
        (i32.eq
          (local.get $continuation_kind)
          (global.get $CONTINUATION_KIND_REGEXP_REPLACE)))
      (i32.or
        (call $is_indexed_continuation_kind
          (local.get $continuation_kind))
        (i32.eq
          (local.get $continuation_kind)
          (global.get $CONTINUATION_KIND_ACCESSOR_RESOLVE))))
  )

  ;; Allocate private native-continuation operation state. The masks declare
  ;; the pointer kind of each of the five state words to the collector.
  (func $allocate_native_continuation_state
    (param $header_pointer_mask i32) (param $data_pointer_mask i32)
    (param $state_0 i32) (param $state_1 i32) (param $state_2 i32)
    (param $state_3 i32) (param $state_4 i32)
    (result i32)
    (local $header_pointer i32)
    (local $data_pointer i32)
    (if (i32.ne
          (i32.and (local.get $header_pointer_mask) (local.get $data_pointer_mask))
          (i32.const 0))
      (then (unreachable)))
    (local.set $header_pointer
      (call $read_state (global.get $STATE_HEAP_POINTER)))
    (i32.store (call $abs (local.get $header_pointer))
      (i32.or
        (global.get $NATIVE_CONTINUATION_STATE_SIZE)
        (i32.shl (global.get $OBJ_NATIVE_CONTINUATION_STATE) (i32.const 24))))
    (i32.store
      (call $abs (i32.add (local.get $header_pointer) (i32.const 4)))
      (i32.const 0))
    (local.set $data_pointer
      (i32.add (local.get $header_pointer) (global.get $GC_HEADER_SIZE)))
    (i32.store
      (call $abs (i32.add
        (local.get $data_pointer)
        (global.get $NATIVE_CONTINUATION_STATE_HEADER_MASK)))
      (local.get $header_pointer_mask))
    (i32.store
      (call $abs (i32.add
        (local.get $data_pointer)
        (global.get $NATIVE_CONTINUATION_STATE_DATA_MASK)))
      (local.get $data_pointer_mask))
    (i32.store
      (call $abs (i32.add
        (local.get $data_pointer)
        (global.get $NATIVE_CONTINUATION_STATE_VALUES)))
      (local.get $state_0))
    (i32.store
      (call $abs (i32.add
        (local.get $data_pointer)
        (i32.add (global.get $NATIVE_CONTINUATION_STATE_VALUES) (i32.const 4))))
      (local.get $state_1))
    (i32.store
      (call $abs (i32.add
        (local.get $data_pointer)
        (i32.add (global.get $NATIVE_CONTINUATION_STATE_VALUES) (i32.const 8))))
      (local.get $state_2))
    (i32.store
      (call $abs (i32.add
        (local.get $data_pointer)
        (i32.add (global.get $NATIVE_CONTINUATION_STATE_VALUES) (i32.const 12))))
      (local.get $state_3))
    (i32.store
      (call $abs (i32.add
        (local.get $data_pointer)
        (i32.add (global.get $NATIVE_CONTINUATION_STATE_VALUES) (i32.const 16))))
      (local.get $state_4))
    (call $write_state
      (global.get $STATE_HEAP_POINTER)
      (i32.add
        (local.get $header_pointer)
        (global.get $NATIVE_CONTINUATION_STATE_SIZE)))
    (local.get $header_pointer)
  )

  (func $native_continuation_state_get
    (param $state_handle i32) (param $state_index i32) (result i32)
    (i32.load (call $abs (i32.add
      (i32.add
        (local.get $state_handle)
        (global.get $GC_HEADER_SIZE))
      (i32.add
        (global.get $NATIVE_CONTINUATION_STATE_VALUES)
        (i32.mul (local.get $state_index) (i32.const 4))))))
  )

  (func $native_continuation_state_set
    (param $state_handle i32) (param $state_index i32) (param $value i32)
    (i32.store (call $abs (i32.add
      (i32.add
        (local.get $state_handle)
        (global.get $GC_HEADER_SIZE))
      (i32.add
        (global.get $NATIVE_CONTINUATION_STATE_VALUES)
        (i32.mul (local.get $state_index) (i32.const 4)))))
      (local.get $value))
  )

  ;; Initialize and publish one native-continuation frame. The call-stack
  ;; pointer is advanced last, so collection and return dispatch cannot observe
  ;; a partially initialized frame.
  (func $publish_native_continuation_frame
    (param $frame_pointer i32)
    (param $stack_pointer i32)
    (param $pending_base i32)
    (param $pending_count i32)
    (param $argument_count i32)
    (param $phase i32)
    (param $state_0 i32)
    (param $state_1 i32)
    (param $continuation_kind i32)
    (param $state_2 i32)
    (param $callback i32)
    (param $state_3 i32)
    (param $state_4 i32)
    (local $published_state_0 i32)
    (local $published_state_1 i32)
    (local $published_state_2 i32)
    (local $published_state_3 i32)
    (local $published_state_4 i32)
    (local $header_pointer_mask i32)
    (local $data_pointer_mask i32)
    (if (i32.eqz
          (call $is_native_continuation_kind
            (local.get $continuation_kind)))
      (then (unreachable)))
    (local.set $published_state_0 (local.get $state_0))
    (local.set $published_state_1 (local.get $state_1))
    (local.set $published_state_2 (local.get $state_2))
    (local.set $published_state_3 (local.get $state_3))
    (local.set $published_state_4 (local.get $state_4))
    (if (call $is_indexed_continuation_kind (local.get $continuation_kind))
      (then
        (if (call $indexed_state_1_is_header_pointer
              (local.get $continuation_kind))
          (then
            (local.set $header_pointer_mask
              (i32.or (local.get $header_pointer_mask) (i32.const 2)))))
        (if (i32.or
              (i32.eq
                (local.get $continuation_kind)
                (global.get $CONTINUATION_KIND_TYPED_ARRAY_MAP))
              (i32.eq
                (local.get $continuation_kind)
                (global.get $CONTINUATION_KIND_TYPED_ARRAY_FILTER)))
          (then
            (local.set $data_pointer_mask
              (i32.or (local.get $data_pointer_mask) (i32.const 2)))))
        (if (call $is_typed_array_continuation_kind
              (local.get $continuation_kind))
          (then
            (local.set $data_pointer_mask
              (i32.or (local.get $data_pointer_mask) (i32.const 4))))
          (else
            (if (i32.ne
                  (local.get $continuation_kind)
                  (global.get $CONTINUATION_KIND_BIGINT_TO_PRIMITIVE))
              (then
                (local.set $header_pointer_mask
                  (i32.or (local.get $header_pointer_mask) (i32.const 4)))))))
        (local.set $published_state_0
          (call $allocate_native_continuation_state
            (local.get $header_pointer_mask)
            (local.get $data_pointer_mask)
            (local.get $state_0) (local.get $state_1)
            (local.get $state_2) (local.get $state_3)
            (local.get $state_4)))
        (local.set $published_state_1 (i32.const 0))
        (local.set $published_state_2 (i32.const 0))
        (local.set $published_state_3 (i32.const 0))
        (local.set $published_state_4 (i32.const 0))))
    (i32.store
      (i32.add (local.get $frame_pointer) (global.get $FRAME_SCOPE_POINTER))
      (global.get $current_scope))
    (call $save_frame_pending_base
      (local.get $frame_pointer)
      (local.get $pending_base))
    (i32.store
      (i32.add (local.get $frame_pointer) (global.get $FRAME_PENDING_COUNT))
      (local.get $pending_count))
    (i32.store
      (i32.add (local.get $frame_pointer) (global.get $FRAME_FLAGS))
      (global.get $FRAME_FLAG_NATIVE_CONTINUATION))
    (i32.store
      (i32.add (local.get $frame_pointer) (global.get $FRAME_AST_NODE))
      (i32.const 0))
    (i32.store
      (i32.add (local.get $frame_pointer) (global.get $FRAME_ARGC))
      (local.get $argument_count))
    (i32.store
      (i32.add (local.get $frame_pointer) (global.get $FRAME_CONTINUATION_PHASE))
      (local.get $phase))
    (i32.store
      (i32.add (local.get $frame_pointer) (global.get $FRAME_CONTINUATION_STATE_HANDLE))
      (local.get $published_state_0))
    (i32.store
      (i32.add (local.get $frame_pointer) (global.get $FRAME_CONTINUATION_STATE_1))
      (local.get $published_state_1))
    (i32.store
      (i32.add (local.get $frame_pointer) (global.get $FRAME_CONTINUATION_KIND))
      (local.get $continuation_kind))
    (i32.store
      (i32.add (local.get $frame_pointer) (global.get $FRAME_CONTINUATION_STATE_2))
      (local.get $published_state_2))
    (i32.store
      (i32.add (local.get $frame_pointer) (global.get $FRAME_CONTINUATION_CALLBACK))
      (local.get $callback))
    (i32.store
      (i32.add (local.get $frame_pointer) (global.get $FRAME_CONTINUATION_STATE_3))
      (local.get $published_state_3))
    (i32.store
      (i32.add (local.get $frame_pointer) (global.get $FRAME_CONTINUATION_STATE_4))
      (local.get $published_state_4))
    (call $write_ctx
      (global.get $CTX_PENDING_POINTER)
      (local.get $pending_base))
    (call $write_ctx
      (global.get $CTX_CALL_STACK_POINTER)
      (i32.add (local.get $stack_pointer) (global.get $FRAME_SIZE)))
  )

  ;; Enter the callback already staged by the top native-continuation frame.
  ;; The frame is the single source of callback identity; request scratch is
  ;; reserved for host exits.
  (func $enter_staged_native_continuation_callback
    (param $frame_pointer i32) (result i32)
    (local $closure_pointer i32)
    (local $new_scope i32)
    (local $continuation_kind i32)
    (local $state_handle i32)
    (local $this_pointer i32)
    (local.set $closure_pointer
      (i32.load (i32.add
        (local.get $frame_pointer)
        (global.get $FRAME_CONTINUATION_CALLBACK))))
    (local.set $new_scope
      (call $scope_create
        (i32.load (call $abs (i32.add
          (local.get $closure_pointer) (i32.const 40))))))
    (global.set $current_scope (local.get $new_scope))
    (local.set $continuation_kind
      (i32.load (i32.add
        (local.get $frame_pointer)
        (global.get $FRAME_CONTINUATION_KIND))))
    (if (i32.eq
          (local.get $continuation_kind)
          (global.get $CONTINUATION_KIND_BIGINT_TO_PRIMITIVE))
      (then
        (local.set $state_handle
          (i32.load (i32.add
            (local.get $frame_pointer)
            (global.get $FRAME_CONTINUATION_STATE_HANDLE))))
        (local.set $this_pointer
          (call $native_continuation_state_get
            (local.get $state_handle) (i32.const 1)))))
    (if (i32.eqz (i32.and
          (i32.load (call $abs (i32.add
            (local.get $closure_pointer) (i32.const 44))))
          (global.get $CLOSURE_FLAG_ARROW)))
      (then
        (if (i32.eq
              (local.get $continuation_kind)
              (global.get $CONTINUATION_KIND_BIGINT_TO_PRIMITIVE))
          (then
            (call $scope_define
              (local.get $new_scope)
              (call $read_builtin (i32.const 0x18))
              (global.get $TYPE_OBJECT)
              (i32.const 0) (local.get $this_pointer) (i32.const 0)))
          (else
            (call $scope_define
              (local.get $new_scope)
              (call $read_builtin (i32.const 0x18))
              (global.get $TYPE_UNDEFINED)
              (i32.const 0) (i32.const 0) (i32.const 0))))
        (call $scope_define_new_target (local.get $new_scope)
          (global.get $TYPE_UNDEFINED) (i32.const 0)))
      )
    (i32.load (call $abs (i32.add
      (local.get $closure_pointer)
      (global.get $FUNCTION_CLOSURE_OFFSET))))
  )

  ;; RETURN pops an explicit result before a continuation step; an implicit
  ;; undefined return has no result slot. A resume-exact pressure retry must
  ;; restore only a value that was actually popped.
  (func $restage_return_value_for_retry
    (param $opcode i32)
    (param $result_type i32) (param $result_flags i32)
    (param $result_lo i32) (param $result_hi i32)
    (if (i32.eq (local.get $opcode) (global.get $OP_RETURN))
      (then
        (call $pending_push
          (local.get $result_type) (local.get $result_flags)
          (local.get $result_lo) (local.get $result_hi))))
  )

  ;; Stage ECMAScript ToPrimitive(number) for a BigInt-related conversion.
  ;; Original CALL operands stay below original_pending; callback arguments
  ;; are placed above them so return can replace target_pointer and retry.
  (func $stage_bigint_to_primitive
    (param $target_pointer i32) (param $object_pointer i32)
    (param $original_pending i32) (param $phase i32)
    (result i32)
    (local $entry_pointer i32)
    (local $entry_type i32)
    (local $closure_pointer i32)
    (local $stack_pointer i32)
    (local $frame_pointer i32)
    (local $param_count i32)
    (local $index i32)
    (block $found
      (loop $search
    (if (i32.gt_u (local.get $phase) (i32.const 2))
      (then
        (if (call $throw_type_error)
          (then (return (i32.const 2)))
          (else (return (i32.const 1))))))
        (if (i32.eqz (local.get $phase))
          (then
            (local.set $entry_pointer
              (call $object_find_symbol_entry
                (local.get $object_pointer)
                (call $read_state
                  (global.get $STATE_WELL_KNOWN_TO_PRIMITIVE_SYMBOL)))))
          (else
            (local.set $entry_pointer
              (call $object_find_string_entry
                (local.get $object_pointer)
                (call $read_builtin
                  (select
                    (global.get $BUILTIN_VALUE_OF)
                    (global.get $BUILTIN_TO_STRING_NAME)
                    (i32.eq (local.get $phase) (i32.const 1))))))))
        (if (i32.eqz (local.get $entry_pointer))
          (then
            (local.set $phase (i32.add (local.get $phase) (i32.const 1)))
            (if (i32.le_u (local.get $phase) (i32.const 2))
              (then (br $search)))
            (br $found)))
        (local.set $entry_type
          (i32.load
            (call $abs
              (i32.add (local.get $entry_pointer) (i32.const 4)))))
        (if (i32.eq (local.get $entry_type) (global.get $TYPE_FUNCTION))
          (then
            (local.set $closure_pointer
              (i32.load
                (call $abs
                  (i32.add (local.get $entry_pointer) (i32.const 12)))))
            (br $found)))
        (if (i32.and
              (i32.eqz (local.get $phase))
              (i32.ne (local.get $entry_type) (global.get $TYPE_UNDEFINED)))
          (then
            (if (call $throw_type_error)
              (then (return (i32.const 2)))
              (else (return (i32.const 1))))))
        (local.set $phase (i32.add (local.get $phase) (i32.const 1)))
        (if (i32.le_u (local.get $phase) (i32.const 2))
          (then (br $search)))))
    (if (i32.eqz (local.get $closure_pointer))
      (then
        (if (call $throw_type_error)
          (then (return (i32.const 2)))
          (else (return (i32.const 1))))))
    (if (call $check_heap_overflow
          (global.get $NATIVE_CONTINUATION_STATE_SIZE))
      (then (return (i32.const 0))))
    (local.set $stack_pointer
      (call $read_ctx (global.get $CTX_CALL_STACK_POINTER)))
    (local.set $frame_pointer (call $abs (local.get $stack_pointer)))
    ;; Spec list: Symbol.toPrimitive(hint) for phase 0; valueOf()/
    ;; toString() take no arguments.
    (local.set $param_count
      (call $callback_staged_argc (local.get $closure_pointer)
        (select (i32.const 1) (i32.const 0) (i32.eqz (local.get $phase)))))
    (call $publish_native_continuation_frame
      (local.get $frame_pointer) (local.get $stack_pointer)
      (local.get $original_pending) (i32.const 1)
      (local.get $param_count) (local.get $phase)
      (i32.sub (local.get $target_pointer) (call $pending_base_seg))
      (local.get $object_pointer)
      (global.get $CONTINUATION_KIND_BIGINT_TO_PRIMITIVE)
      (i32.sub (local.get $original_pending) (call $pending_base_seg))
      (local.get $closure_pointer)
      (i32.const 0) (i32.const 0))
    (local.set $index (i32.const 0))
    (block $arguments_done
      (loop $arguments
        (br_if $arguments_done
          (i32.ge_u (local.get $index) (local.get $param_count)))
        (if (i32.and
              (i32.eqz (local.get $phase))
              (i32.eqz (local.get $index)))
          (then
            (call $pending_push
              (global.get $TYPE_STRING) (i32.const 0)
              (call $read_builtin (global.get $BUILTIN_TYPEOF_NUMBER))
              (i32.const 0)))
          (else
            (call $pending_push
              (global.get $TYPE_UNDEFINED) (i32.const 0)
              (i32.const 0) (i32.const 0))))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $arguments)))
    (global.get $STATUS_NATIVE_CONTINUATION_STAGED)
  )

  ;; ==========================================================================
  ;; callback_staged_argc
  ;;
  ;; The ONE sizing rule for builtin callback staging
  ;; is based on callee-declared arity. Builtin higher-order
  ;; methods stage only as many arguments as the callee declares — an
  ;; allocation saving a fixed-arity callee cannot observe, because
  ;; RECONCILE_PARAMS pads missing declared tail parameters with undefined.
  ;; A rest parameter CAN observe it: it collects every staged argument,
  ;; so a rest-declaring callee must receive the method's FULL spec
  ;; argument list — exactly spec_argc, never the declared count, which
  ;; for `(a, b, ...rest)` shapes both under- and over-counts the list.
  ;;
  ;; Returns RECONCILE_PARAMS operand1 (declared count) for fixed arity,
  ;; spec_argc when operand2 (hasRest) is set, and 0 when the callee has
  ;; no RECONCILE_PARAMS prelude (a guard for any old code path that may
  ;; not emit it; the operand read replaced the earlier "count
  ;; consecutive LET_VAR" heuristic, which destructuring/default
  ;; emission broke).
  ;; ==========================================================================
  (func $callback_staged_argc (export "callback_staged_argc")
    (param $closure_pointer i32) (param $spec_argc i32) (result i32)
    (local $start_instr i32)
    (local.set $start_instr (i32.load (call $abs (i32.add (local.get $closure_pointer) (global.get $FUNCTION_CLOSURE_OFFSET)))))
    (if (i32.eq (call $read_opcode (i32.const 0) (local.get $start_instr)) (global.get $OP_RECONCILE_PARAMS))
      (then
        (if (call $read_operand2 (i32.const 0) (local.get $start_instr))
          (then (return (local.get $spec_argc))))
        (return (call $read_operand1 (i32.const 0) (local.get $start_instr)))))
    (i32.const 0)
  )

  ;; ==========================================================================
  ;; yield_external_call
  ;;
  ;; Shared yield path for EXIT_EXTERNAL_CALL — used by OP_CALL on TYPE_EXTERNAL
  ;; and TYPE_EXTERNAL_METHOD, by OP_CALL_METHOD on TYPE_EXTERNAL_METHOD, and by
  ;; OP_NEW on TYPE_EXTERNAL and TYPE_EXTERNAL_METHOD.
  ;;
  ;; Writes the external_request block, saves resume state, pre-positions the
  ;; pending pointer to reset_slot (where the host's marshalResult will write
  ;; the return value), and sets the exit condition. Caller follows with
  ;; (br $exit).
  ;;
  ;; Parameters:
  ;;   value_pointer  — slot of the callable (handleId from data_lo,
  ;;                    methodOffset from data_hi for METHOD form)
  ;;   argc           — argument count (instruction operand)
  ;;   method_offset  — 0 for direct call, else string offset for method call
  ;;   reset_slot     — slot to reset CTX_PENDING_POINTER to (so result lands
  ;;                    at the callable's slot for OP_CALL/OP_NEW/EXTERNAL,
  ;;                    or at the receiver's slot for OP_CALL_METHOD)
  ;;   pc             — current instruction index (resume at pc+1)
  ;;   fuel           — current fuel (1 charged for the yielding instruction)
  ;;
  ;; Returns: fuel - 1
  ;; ==========================================================================
  (func $yield_external_call
    (param $value_pointer i32)
    (param $argc i32)
    (param $method_offset i32)
    (param $reset_slot i32)
    (param $pc i32)
    (param $fuel i32)
    (result i32)

    ;; handleId = data_lo of the callable
    (i32.store (call $abs (global.get $external_request_base))
      (call $value_data_lo (local.get $value_pointer)))
    ;; methodOffset (0 = direct call)
    (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 4)))
      (local.get $method_offset))
    ;; argsPointer = first slot after the callable
    (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 8)))
      (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE)))
    ;; argCount
    (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 12)))
      (local.get $argc))
    ;; External handle VERSION is stored at +16. For a plain
    ;; TYPE_EXTERNAL callable, data_hi IS the version. For TYPE_EXTERNAL_METHOD,
    ;; data_hi is the methodOffset (not a version) — write 0 (skip validation).
    (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 16)))
      (if (result i32) (i32.eq (call $value_type (local.get $value_pointer)) (global.get $TYPE_EXTERNAL))
        (then (call $value_data_hi (local.get $value_pointer)))
        (else (i32.const 0))))

    ;; Save resume state. Instruction is complete from WASM's perspective —
    ;; resume at pc+1.
    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX)
      (i32.add (local.get $pc) (i32.const 1)))
    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))

    ;; Pre-position pending pointer: host's marshalResult writes at
    ;; pending_pointer, so reset_slot is where the return value lands.
    ;; The callable, receiver (if any), and args are effectively discarded.
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $reset_slot))

    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_EXTERNAL_CALL))

    (i32.sub (local.get $fuel) (i32.const 1))
  )

  ;; ==========================================================================
  ;; is_truthy_inline
  ;;
  ;; Like is_truthy but takes type, flags, data_lo, data_hi directly instead of ptr.
  ;; Flags needed for Rational inline/heap discrimination.
  ;; ==========================================================================
  (func $is_truthy_inline (param $type i32) (param $flags i32) (param $data_lo i32) (param $data_hi i32) (result i32)
    ;; null and undefined are falsy
    (if (i32.eq (local.get $type) (global.get $TYPE_NULL))
      (then (return (i32.const 0))))
    (if (i32.eq (local.get $type) (global.get $TYPE_UNDEFINED))
      (then (return (i32.const 0))))

    ;; boolean: check data_lo
    (if (i32.eq (local.get $type) (global.get $TYPE_BOOLEAN))
      (then (return (local.get $data_lo))))

    ;; integer: 0 is falsy
    (if (i32.eq (local.get $type) (global.get $TYPE_INTEGER))
      (then (return (i32.ne (local.get $data_lo) (i32.const 0)))))

    ;; float: 0.0 is falsy
    (if (i32.eq (local.get $type) (global.get $TYPE_FLOAT))
      (then
        (return (i32.or
          (i32.ne (local.get $data_lo) (i32.const 0))
          (i32.ne (local.get $data_hi) (i32.const 0))))))

    ;; rational: inline — i64 payload; heap — check numerator length
    (if (i32.eq (local.get $type) (global.get $TYPE_RATIONAL))
      (then
        (if (i32.and (local.get $flags) (global.get $FLAG_RATIONAL_INLINE))
          (then (return (i32.or
            (i32.ne (local.get $data_lo) (i32.const 0))
            (i32.ne (local.get $data_hi) (i32.const 0))))))
        (return (i32.ne
          (call $bigint_length (call $rational_numerator (local.get $data_lo)))
          (i32.const 0)))))

    ;; bigint: 0n is falsy (length == 0)
    (if (i32.eq (local.get $type) (global.get $TYPE_BIGINT))
      (then
        (return (i32.ne
          (i32.load (call $abs (i32.add
            (i32.add (local.get $data_lo) (global.get $GC_HEADER_SIZE))
            (i32.const 4))))
          (i32.const 0)))))

    ;; string: empty string is falsy. data_lo is a table-relative interned
    ;; string id under format v7; resolve via $string_id_to_abs, not $abs.
    (if (i32.eq (local.get $type) (global.get $TYPE_STRING))
      (then
        (return (i32.ne
          (i32.load (call $string_id_to_abs (local.get $data_lo)))
          (i32.const 0)))))

    ;; Everything else is truthy
    (i32.const 1)
  )

  ;; ==========================================================================
  ;; dispatch_via_table
  ;;
  ;; Supports the dispatch table's incremental migration path: as
  ;; each method_id gets a standalone function extracted from
  ;; dispatch_builtin_method (or from $run's constructor ladders),
  ;; that function is registered into $builtin_table at index
  ;; method_id. Callers (OP_CALL_METHOD, the RETURN/RETURN_UNDEFINED
  ;; iterating-frame re-entry, and any migrated method's own recursive
  ;; re-dispatch) call this helper FIRST. If the slot is populated
  ;; (non-null funcref), it calls through the table and returns that
  ;; function's real result. If the slot is still null (method_id not
  ;; yet migrated), it returns -1 as a sentinel meaning "not migrated,
  ;; fall back to the old if/else chain" — never a real
  ;; dispatch_builtin_method result, since 0/1/2/3/4/5/6 are all
  ;; taken (see constants.js's STATUS_* block) and this table's
  ;; results share that same result-code space by construction
  ;; ($builtin_sig's result type matches dispatch_builtin_method's).
  ;;
  ;; table.get + ref.is_null is the standard funcref-table liveness
  ;; check; call_indirect on a null slot would trap instead of
  ;; letting the caller fall back, so the null check must run first.
  (func $dispatch_via_table
    (param $method_id i32)
    (param $receiver_type i32)
    (param $receiver_pointer i32)
    (param $argc i32)
    (param $stack_base i32)
    (result i32)
    (local $proof_root i32) (local $result i32)
    (if (ref.is_null (table.get $builtin_table (local.get $method_id)))
      (then (return (i32.const -1))))
    (if (i32.and (call $is_proof_native_method (local.get $method_id))
      (i32.eqz (global.get $proof_operation_active)))
      (then (call $proof_operation_begin) (local.set $proof_root (i32.const 1))))
    (local.set $result (call_indirect $builtin_table (type $builtin_sig)
      (local.get $receiver_type)
      (local.get $receiver_pointer)
      (local.get $method_id)
      (local.get $argc)
      (local.get $stack_base)
      (local.get $method_id)))
    (if (local.get $proof_root) (then (call $proof_operation_end)))
    (local.get $result)
  )

  ;; ==========================================================================
  ;; call_apply_bind
  ;;
  ;; Function.prototype.call / apply / bind (closure receivers). First
  ;; method migrated to the dispatch table under the full dispatch-table
  ;; rework — chosen first because the audit flagged it
  ;; as the highest-risk extraction (it recurses into
  ;; dispatch_builtin_method for native TYPE_BOUND_METHOD receivers,
  ;; and its three method ids share interleaved logic rather than
  ;; splitting into three contiguous blocks).
  ;;
  ;; Matches $builtin_sig exactly, so it is a drop-in call_indirect
  ;; target. Re-derives the arg1/arg2 decode dispatch_builtin_method's
  ;; shared preamble used to do for it (see that function's own
  ;; comment on argument pointers) — this function no longer has
  ;; access to the caller's locals, so it cannot reuse that work; it
  ;; must redo exactly the same decode. Only arg1 and arg2 are used
  ;; here (this branch never reads a third argument).
  ;;
  ;; The function is read from the RECEIVER STACK SLOT (stack_base) —
  ;; the prototype-walk entry carries no receiver. call/apply prepare a
  ;; call scope (with `this` bound for non-arrows), rewrite the pending
  ;; stack into plain-argument shape at stack_base, write
  ;; [closure][scope][argc] into the request block, and return code 6:
  ;; the CALL_METHOD site stages the closure call from that. bind
  ;; clones the closure with a holder scope binding `this` (the A2
  ;; thisArg pattern); the clone's ARROW flag makes every call site
  ;; resolve `this` lexically through the holder. Loudly unsupported
  ;; (one message): async/generator callees, bind with partial
  ;; arguments, apply arrays beyond current pending capacity.
  ;;
  ;; Native bound-method receivers (Object.prototype.toString.call and
  ;; friends) recurse — per the 2026-07-08 design decision, this
  ;; recursive re-dispatch goes through $dispatch_via_table first (falling back to
  ;; dispatch_builtin_method only if the target method_id has not yet
  ;; been migrated into the table), not straight to
  ;; dispatch_builtin_method as the pre-migration code did.
  ;; ==========================================================================
  (func $call_apply_bind
    (param $receiver_type i32)
    (param $receiver_pointer i32)
    (param $method_id i32)
    (param $argc i32)
    (param $stack_base i32)
    (result i32)

    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $arg1_type i32)
    (local $arg1_flags i32)
    (local $arg1_lo i32)
    (local $arg1_hi i32)
    (local $argument2_pointer i32)
    (local $arg2_type i32)
    (local $arg2_lo i32)
    (local $count i32)
    (local $arr_len i32)
    (local $i i32)
    (local $element_pointer i32)
    (local $data_pointer i32)
    (local $i32_result i32)
    (local $new_arr i32)
    (local $heap_pointer i32)
    (local $dispatch_result i32)

    ;; Re-derive arg1/arg2 (see comment above — dispatch_builtin_method's
    ;; shared preamble, reproduced here since this function can no
    ;; longer reuse the caller's already-decoded locals).
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer)
          (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $arg1_type (call $value_type (local.get $argument1_pointer)))
        (local.set $arg1_flags (call $value_flags (local.get $argument1_pointer)))
        (local.set $arg1_lo (call $value_data_lo (local.get $argument1_pointer)))
        (local.set $arg1_hi (call $value_data_hi (local.get $argument1_pointer)))
      )
    )
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then
        (local.set $argument2_pointer (i32.add (local.get $argument1_pointer) (global.get $VALUE_SIZE)))
        (local.set $arg2_type (call $value_type (local.get $argument2_pointer)))
        (local.set $arg2_lo (call $value_data_lo (local.get $argument2_pointer)))
      )
    )

    ;; Native bound-method receivers (Object.prototype.toString.call
    ;; and friends): rewrite the stack into the method-call shape the
    ;; inner native expects — [thisArg, args...] with thisArg in the
    ;; receiver slot — and recurse into dispatch, via the table first,
    ;; with the bound method's id. bind builds a rebound method value.
    (if (i32.eq (call $value_type (local.get $stack_base)) (global.get $TYPE_BOUND_METHOD))
      (then
        (local.set $count (call $value_data_hi (local.get $stack_base)))  ;; inner method id
        (if (i32.eq (local.get $method_id) (global.get $METHOD_FUNCTION_BIND))
          (then
            (if (i32.ge_u (local.get $argc) (i32.const 2))
              (then
                (if (call $throw_type_error_with_type
                      (global.get $BUILTIN_MSG_FUNCTION_METHOD_UNSUPPORTED)
                      (global.get $TYPE_BOUND_METHOD))
                  (then (return (i32.const 2)))
                  (else (return (i32.const 1))))))
            (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
            (call $pending_push
              (global.get $TYPE_BOUND_METHOD)
              (select (local.get $arg1_type) (global.get $TYPE_UNDEFINED)
                (i32.ge_u (local.get $argc) (i32.const 1)))
              (select (local.get $arg1_lo) (i32.const 0)
                (i32.ge_u (local.get $argc) (i32.const 1)))
              (local.get $count))
            (return (i32.const 0))))
        (if (i32.eq (local.get $method_id) (global.get $METHOD_FUNCTION_CALL))
          (then
            ;; Shift [thisArg, args...] down over [bm, callBM]; an
            ;; absent thisArg becomes an undefined receiver slot.
            (local.set $arr_len
              (select
                (local.get $argc)
                (i32.const 1)
                (i32.ge_u (local.get $argc) (i32.const 1))))
            (local.set $i (i32.const 0))
            (if (i32.ge_u (local.get $argc) (i32.const 1))
              (then
                (block $bm_call_shift_done
                  (loop $bm_call_shift_loop
                    (br_if $bm_call_shift_done (i32.ge_u (local.get $i)
                      (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
                    (i32.store (call $abs (i32.add (local.get $stack_base) (local.get $i)))
                      (i32.load (call $abs (i32.add (local.get $argument1_pointer) (local.get $i)))))
                    (local.set $i (i32.add (local.get $i) (i32.const 4)))
                    (br $bm_call_shift_loop))))
              (else
                (i32.store (call $abs (local.get $stack_base)) (global.get $TYPE_UNDEFINED))
                (i32.store (call $abs (i32.add (local.get $stack_base) (i32.const 4))) (i32.const 0))
                (i32.store (call $abs (i32.add (local.get $stack_base) (i32.const 8))) (i32.const 0))
                (i32.store (call $abs (i32.add (local.get $stack_base) (i32.const 12))) (i32.const 0))))
            (call $write_ctx (global.get $CTX_PENDING_POINTER)
              (i32.add (local.get $stack_base)
                (i32.mul (local.get $arr_len) (global.get $VALUE_SIZE))))
            (local.set $dispatch_result (call $dispatch_via_table
              (local.get $count)
              (call $value_type (local.get $stack_base))
              (call $value_data_lo (local.get $stack_base))
              (i32.sub (local.get $arr_len) (i32.const 1))
              (local.get $stack_base)))
            ;; NOT a `select` — select evaluates both operands
            ;; unconditionally in WASM, which would run
            ;; dispatch_builtin_method a second, redundant time even
            ;; when the table dispatch already succeeded, corrupting
            ;; the pending stack. Must be a real conditional.
            (if (i32.ne (local.get $dispatch_result) (i32.const -1))
              (then (return (local.get $dispatch_result))))
            (return (call $dispatch_builtin_method
              (call $value_type (local.get $stack_base))
              (call $value_data_lo (local.get $stack_base))
              (local.get $count)
              (i32.sub (local.get $arr_len) (i32.const 1))
              (local.get $stack_base)))))
        ;; apply on a native method: thisArg into the receiver slot,
        ;; array elements above it.
        (local.set $arr_len (i32.const 0))
        (local.set $element_pointer (i32.const 0))
        (if (i32.ge_u (local.get $argc) (i32.const 2))
          (then
            (if (i32.and
                  (i32.ne (local.get $arg2_type) (global.get $TYPE_NULL))
                  (i32.ne (local.get $arg2_type) (global.get $TYPE_UNDEFINED)))
              (then
                (if (i32.ne (local.get $arg2_type) (global.get $TYPE_ARRAY))
                  (then
                    (if (call $throw_type_error_with_type
                          (global.get $BUILTIN_MSG_FUNCTION_METHOD_UNSUPPORTED)
                          (local.get $arg2_type))
                      (then (return (i32.const 2)))
                      (else (return (i32.const 1))))))
                (local.set $arr_len (i32.load (call $abs (i32.add (local.get $arg2_lo) (i32.const 8)))))
                (local.set $element_pointer (i32.add
                  (i32.load (call $abs (i32.add (local.get $arg2_lo) (i32.const 16))))
                  (global.get $GC_HEADER_SIZE)))))))
        (if (i32.gt_u
              (i32.add (local.get $stack_base)
                (i32.mul (i32.add (local.get $arr_len) (i32.const 1)) (global.get $VALUE_SIZE)))
              (call $read_ctx (global.get $CTX_PENDING_LIMIT)))
          (then
            (if (call $throw_type_error_with_type
                  (global.get $BUILTIN_MSG_FUNCTION_METHOD_UNSUPPORTED)
                  (global.get $TYPE_ARRAY))
              (then (return (i32.const 2)))
              (else (return (i32.const 1))))))
        (if (i32.ge_u (local.get $argc) (i32.const 1))
          (then
            (i32.store (call $abs (local.get $stack_base)) (local.get $arg1_type))
            (i32.store (call $abs (i32.add (local.get $stack_base) (i32.const 4))) (local.get $arg1_flags))
            (i32.store (call $abs (i32.add (local.get $stack_base) (i32.const 8))) (local.get $arg1_lo))
            (i32.store (call $abs (i32.add (local.get $stack_base) (i32.const 12))) (local.get $arg1_hi)))
          (else
            (i32.store (call $abs (local.get $stack_base)) (global.get $TYPE_UNDEFINED))
            (i32.store (call $abs (i32.add (local.get $stack_base) (i32.const 4))) (i32.const 0))
            (i32.store (call $abs (i32.add (local.get $stack_base) (i32.const 8))) (i32.const 0))
            (i32.store (call $abs (i32.add (local.get $stack_base) (i32.const 12))) (i32.const 0))))
        (local.set $i (i32.const 0))
        (block $bm_apply_unpack_done
          (loop $bm_apply_unpack_loop
            (br_if $bm_apply_unpack_done (i32.ge_u (local.get $i)
              (i32.mul (local.get $arr_len) (global.get $VALUE_SIZE))))
            (i32.store (call $abs (i32.add
                (i32.add (local.get $stack_base) (global.get $VALUE_SIZE))
                (local.get $i)))
              (i32.load (call $abs (i32.add (local.get $element_pointer) (local.get $i)))))
            (local.set $i (i32.add (local.get $i) (i32.const 4)))
            (br $bm_apply_unpack_loop)))
        (call $write_ctx (global.get $CTX_PENDING_POINTER)
          (i32.add (local.get $stack_base)
            (i32.mul (i32.add (local.get $arr_len) (i32.const 1)) (global.get $VALUE_SIZE))))
        (local.set $dispatch_result (call $dispatch_via_table
          (local.get $count)
          (call $value_type (local.get $stack_base))
          (call $value_data_lo (local.get $stack_base))
          (local.get $arr_len)
          (local.get $stack_base)))
        ;; NOT a `select` — see the METHOD_FUNCTION_CALL branch above
        ;; for why: select evaluates both operands unconditionally,
        ;; which would double-dispatch and corrupt the pending stack.
        (if (i32.ne (local.get $dispatch_result) (i32.const -1))
          (then (return (local.get $dispatch_result))))
        (return (call $dispatch_builtin_method
          (call $value_type (local.get $stack_base))
          (call $value_data_lo (local.get $stack_base))
          (local.get $count)
          (local.get $arr_len)
          (local.get $stack_base)))
      )
    )

    (if (i32.ne (call $value_type (local.get $stack_base)) (global.get $TYPE_FUNCTION))
      (then
        (if (call $throw_type_error_with_type
              (global.get $BUILTIN_MSG_NOT_A_FUNCTION)
              (call $value_type (local.get $stack_base)))
          (then (return (i32.const 2)))
          (else (return (i32.const 1))))))
    (local.set $data_pointer (call $value_data_lo (local.get $stack_base)))
    (local.set $i32_result (i32.load (call $abs (i32.add (local.get $data_pointer) (i32.const 44)))))

    ;; Async / generator callees are their own spawn paths — loud no.
    ;; Same for bind with partial arguments.
    (if (i32.or
          (i32.and (local.get $i32_result)
            (i32.or (global.get $CLOSURE_FLAG_ASYNC) (global.get $CLOSURE_FLAG_GENERATOR)))
          (i32.and
            (i32.eq (local.get $method_id) (global.get $METHOD_FUNCTION_BIND))
            (i32.ge_u (local.get $argc) (i32.const 2))))
      (then
        (if (call $throw_type_error_with_type
              (global.get $BUILTIN_MSG_FUNCTION_METHOD_UNSUPPORTED)
              (global.get $TYPE_FUNCTION))
          (then (return (i32.const 2)))
          (else (return (i32.const 1))))))

    (if (i32.eq (local.get $method_id) (global.get $METHOD_FUNCTION_BIND))
      (then
        ;; Arrow: `this` is lexical — bind is identity.
        (if (i32.and (local.get $i32_result) (global.get $CLOSURE_FLAG_ARROW))
          (then
            (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
            (call $pending_push (global.get $TYPE_FUNCTION) (i32.const 0)
              (local.get $data_pointer) (i32.const 0))
            (return (i32.const 0))))
        ;; Pressure pre-check: holder scope + closure clone.
        (if (call $check_heap_overflow
              (i32.add (call $estimate_scope_size) (global.get $FUNCTION_HEADER_SIZE)))
          (then (return (i32.const 0))))
        (local.set $new_arr (call $scope_create
          (i32.load (call $abs (i32.add (local.get $data_pointer) (i32.const 40))))))
        (if (i32.ge_u (local.get $argc) (i32.const 1))
          (then
            (call $scope_define (local.get $new_arr)
              (call $read_builtin (i32.const 0x18))   ;; BUILTIN_NAME.THIS
              (local.get $arg1_type) (local.get $arg1_flags)
              (local.get $arg1_lo) (local.get $arg1_hi)))
          (else
            (call $scope_define (local.get $new_arr)
              (call $read_builtin (i32.const 0x18))
              (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))))
        (call $scope_define_new_target (local.get $new_arr)
          (global.get $TYPE_UNDEFINED) (i32.const 0))
        ;; Clone the closure, patch scope := holder, flags |= ARROW.
        (local.set $heap_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))
        (local.set $i (i32.const 0))
        (block $bind_clone_done
          (loop $bind_clone_loop
            (br_if $bind_clone_done (i32.ge_u (local.get $i) (global.get $FUNCTION_HEADER_SIZE)))
            (i32.store (call $abs (i32.add (local.get $heap_pointer) (local.get $i)))
              (i32.load (call $abs (i32.add (local.get $data_pointer) (local.get $i)))))
            (local.set $i (i32.add (local.get $i) (i32.const 4)))
            (br $bind_clone_loop)))
        (call $write_state (global.get $STATE_HEAP_POINTER)
          (i32.add (local.get $heap_pointer) (global.get $FUNCTION_HEADER_SIZE)))
        (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 40)))
          (local.get $new_arr))
        ;; The clone captures the holder scope — mark it (its ancestors
        ;; are the original closure's chain, already marked).
        (call $scope_mark_captured_chain (local.get $new_arr))
        (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 44)))
          (i32.or
            (i32.load (call $abs (i32.add (local.get $heap_pointer) (i32.const 44))))
            (global.get $CLOSURE_FLAG_ARROW)))
        (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
        (call $pending_push (global.get $TYPE_FUNCTION) (i32.const 0)
          (local.get $heap_pointer) (i32.const 0))
        (return (i32.const 0))
      )
    )

    ;; call / apply: figure out the outgoing argument region first
    ;; (apply must fit within the current pending capacity — checked
    ;; before anything is allocated or moved, so a pressure retry
    ;; re-enters cleanly).
    (if (i32.eq (local.get $method_id) (global.get $METHOD_FUNCTION_APPLY))
      (then
        (local.set $arr_len (i32.const 0))
        (local.set $element_pointer (i32.const 0))
        (if (i32.ge_u (local.get $argc) (i32.const 2))
          (then
            (if (i32.and
                  (i32.ne (local.get $arg2_type) (global.get $TYPE_NULL))
                  (i32.ne (local.get $arg2_type) (global.get $TYPE_UNDEFINED)))
              (then
                (if (i32.ne (local.get $arg2_type) (global.get $TYPE_ARRAY))
                  (then
                    (if (call $throw_type_error_with_type
                          (global.get $BUILTIN_MSG_FUNCTION_METHOD_UNSUPPORTED)
                          (local.get $arg2_type))
                      (then (return (i32.const 2)))
                      (else (return (i32.const 1))))))
                (local.set $arr_len (i32.load (call $abs (i32.add (local.get $arg2_lo) (i32.const 8)))))
                (local.set $element_pointer (i32.add
                  (i32.load (call $abs (i32.add (local.get $arg2_lo) (i32.const 16))))
                  (global.get $GC_HEADER_SIZE)))))))
        (if (i32.gt_u
              (i32.add (local.get $stack_base)
                (i32.mul (local.get $arr_len) (global.get $VALUE_SIZE)))
              (call $read_ctx (global.get $CTX_PENDING_LIMIT)))
          (then
            (if (call $throw_type_error_with_type
                  (global.get $BUILTIN_MSG_FUNCTION_METHOD_UNSUPPORTED)
                  (global.get $TYPE_ARRAY))
              (then (return (i32.const 2)))
              (else (return (i32.const 1))))))
      )
      (else
        ;; call: args follow thisArg on the stack.
        (local.set $arr_len
          (select
            (i32.sub (local.get $argc) (i32.const 1))
            (i32.const 0)
            (i32.ge_u (local.get $argc) (i32.const 1))))
      )
    )

    ;; Pressure pre-check: the call scope.
    (if (call $check_heap_overflow (call $estimate_scope_size))
      (then (return (i32.const 0))))
    (local.set $new_arr (call $scope_create
      (i32.load (call $abs (i32.add (local.get $data_pointer) (i32.const 40))))))
    (if (i32.eqz (i32.and (local.get $i32_result) (global.get $CLOSURE_FLAG_ARROW)))
      (then
        (if (i32.ge_u (local.get $argc) (i32.const 1))
          (then
            (call $scope_define (local.get $new_arr)
              (call $read_builtin (i32.const 0x18))
              (local.get $arg1_type) (local.get $arg1_flags)
              (local.get $arg1_lo) (local.get $arg1_hi)))
          (else
            (call $scope_define (local.get $new_arr)
              (call $read_builtin (i32.const 0x18))
              (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))))
        (call $scope_define_new_target (local.get $new_arr)
          (global.get $TYPE_UNDEFINED) (i32.const 0))))

    ;; Request block: [closure][scope][argcOut].
    (i32.store (call $abs (global.get $external_request_base)) (local.get $data_pointer))
    (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 4)))
      (local.get $new_arr))
    (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 8)))
      (local.get $arr_len))

    ;; Rewrite the pending stack into plain-argument shape at
    ;; stack_base. call: shift args down over [f, method, thisArg]
    ;; (ascending copy, dest below source). apply: unpack the array.
    (local.set $i (i32.const 0))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_FUNCTION_CALL))
      (then
        (block $call_shift_done
          (loop $call_shift_loop
            (br_if $call_shift_done (i32.ge_u (local.get $i)
              (i32.mul (local.get $arr_len) (global.get $VALUE_SIZE))))
            (i32.store (call $abs (i32.add (local.get $stack_base) (local.get $i)))
              (i32.load (call $abs (i32.add
                (i32.add (local.get $argument1_pointer) (global.get $VALUE_SIZE))
                (local.get $i)))))
            (local.set $i (i32.add (local.get $i) (i32.const 4)))
            (br $call_shift_loop))))
      (else
        (block $apply_unpack_done
          (loop $apply_unpack_loop
            (br_if $apply_unpack_done (i32.ge_u (local.get $i)
              (i32.mul (local.get $arr_len) (global.get $VALUE_SIZE))))
            (i32.store (call $abs (i32.add (local.get $stack_base) (local.get $i)))
              (i32.load (call $abs (i32.add (local.get $element_pointer) (local.get $i)))))
            (local.set $i (i32.add (local.get $i) (i32.const 4)))
            (br $apply_unpack_loop))))
    )
    (call $write_ctx (global.get $CTX_PENDING_POINTER)
      (i32.add (local.get $stack_base)
