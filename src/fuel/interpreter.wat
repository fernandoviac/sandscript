                                (i32.ne (local.get $method_id) (global.get $METHOD_SORT)))))
                          (i32.or
                            (i32.eq (local.get $method_id) (global.get $METHOD_MAP_FOREACH))
                            (i32.eq (local.get $method_id) (global.get $METHOD_SET_FOREACH))))
                        (i32.ge_u (local.get $operand1) (i32.const 2)))
                      (i32.ne
                        (call $value_type (i32.add (local.get $value_pointer)
                          (i32.mul (i32.const 2) (global.get $VALUE_SIZE))))
                        (global.get $TYPE_UNDEFINED)))
                  (then
                    (local.set $value_pointer3 (i32.add (local.get $value_pointer) (global.get $VALUE_SIZE)))
                    (if (i32.eq (call $value_type (local.get $value_pointer3)) (global.get $TYPE_FUNCTION))
                      (then
                        (local.set $closure_pointer (call $value_data_lo (local.get $value_pointer3)))
                        (if (i32.eqz (i32.and
                              (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 44))))
                              (global.get $CLOSURE_FLAG_ARROW)))
                          (then
