  (global $BUILTIN_KEY_MAX_DEPTH i32 (i32.const 0x6DC))
  (global $BUILTIN_KEY_MAX_ERRORS i32 (i32.const 0x6E0))
  (global $BUILTIN_KEY_ARENA_BYTES i32 (i32.const 0x6E4))
  (global $BUILTIN_LIT_ANNOTATE i32 (i32.const 0x6E8))
  (global $BUILTIN_LIT_DIALECT_2020 i32 (i32.const 0x6EC))
  (global $BUILTIN_LIT_DIALECT_2019 i32 (i32.const 0x6F0))
  (global $BUILTIN_LIT_DIALECT_07 i32 (i32.const 0x6F4))
  (global $BUILTIN_LIT_DIALECT_06 i32 (i32.const 0x6F8))
  (global $BUILTIN_LIT_DIALECT_04 i32 (i32.const 0x6FC))
  (global $BUILTIN_KEY_DOLLAR_SCHEMA i32 (i32.const 0x700))
