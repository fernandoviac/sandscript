                (local.set $result_type (call $value_type (local.get $value_pointer)))
                (local.set $result_flags (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 4)))))
                (local.set $result_lo (call $value_data_lo (local.get $value_pointer)))
                (local.set $result_hi (call $value_data_hi (local.get $value_pointer))))
