    (call $expression_freeze_args_array (local.get $entries_pointer))
    (call $push_matrix (call $matrix_allocate
      (local.get $rows) (local.get $columns) (local.get $entries_pointer)))
    (i32.const 0)
  )

  ;; scale(k, A) — scalar-matrix multiplication. k must be in the entry
