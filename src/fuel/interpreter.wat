    (if (call $value_is_numeric (local.get $argument1_pointer))
      (then (local.set $i (i32.trunc_sat_f64_s (call $value_to_f64 (local.get $argument1_pointer)))))
      (else
        (call $pending_push (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))
        (return (i32.const 0))
      )
    )
    (if (i32.lt_s (local.get $i) (i32.const 0))
      (then (local.set $i (i32.add (local.get $str_len) (local.get $i))))
    )
    (if (i32.or
          (i32.lt_s (local.get $i) (i32.const 0))
          (i32.ge_u (local.get $i) (local.get $str_len)))
      (then
        (call $pending_push (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))
        (return (i32.const 0))
      )
    )
    (if (call $check_concat_scratch_overflow (i32.const 1))
      (then (return (i32.const 0))))
    (local.set $scratch_pointer
      (call $abs (call $read_state (global.get $STATE_HEAP_POINTER))))
    (i32.store8
      (local.get $scratch_pointer)
      (i32.load8_u (call $abs (i32.add
        (i32.add (local.get $receiver_pointer) (i32.const 4))
        (local.get $i)))))
    (call $pending_push (global.get $TYPE_STRING) (i32.const 0)
      (call $intern_string (local.get $scratch_pointer) (i32.const 1))
      (i32.const 0))
    (return (i32.const 0))
  )

  ;; Batch 18: Array.freeze/isFrozen, Object.freeze/isFrozen,
  ;; hasOwnProperty, Object.prototype.toString, Map/Set size getters,
  ;; Object.getOwnPropertyDescriptor, Object.getPrototypeOf. These are
  ;; receiver-type-agnostic (dispatched by method_id alone, using the
  ;; standard arg1/arg2 decode preamble) — no additional shared setup
  ;; beyond what dispatch_builtin_method's own preamble already reproduces
  ;; per extracted function. Hex values verified against each METHOD_*
  ;; global's own declaration.

  (func $array_freeze_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $arg1_type i32)
    (local $arg1_lo i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $arg1_type (call $value_type (local.get $argument1_pointer)))
        (local.set $arg1_lo (call $value_data_lo (local.get $argument1_pointer)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (i32.ne (local.get $arg1_type) (global.get $TYPE_ARRAY))
      (then
        (if (call $throw_type_error)
          (then (return (i32.const 2)))
          (else (return (i32.const 1)))
        )
      )
    )
    (i32.store
      (call $abs (i32.add (local.get $arg1_lo) (global.get $ARRAY_FLAGS_OFFSET)))
      (i32.or
        (i32.load (call $abs (i32.add (local.get $arg1_lo) (global.get $ARRAY_FLAGS_OFFSET))))
        (global.get $ARRAY_FLAG_FROZEN)))
    (call $pending_push (global.get $TYPE_ARRAY) (i32.const 0) (local.get $arg1_lo) (i32.const 0))
    (return (i32.const 0))
  )

