            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_RATIONAL))
                  (i32.eq (local.get $type2) (global.get $TYPE_RATIONAL)))
              (then
                (call $pending_push
                  (global.get $TYPE_BOOLEAN) (i32.const 0)
                  (i32.gt_s (call $rational_compare (local.get $value_pointer) (local.get $value_pointer2)) (i32.const 0))
                  (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )
            ;; Any numeric > any numeric — coerce via f64
            (if (i32.and
                  (call $value_is_numeric (local.get $value_pointer))
                  (call $value_is_numeric (local.get $value_pointer2)))
              (then
                (call $pending_push
                  (global.get $TYPE_BOOLEAN) (i32.const 0)
                  (f64.gt
                    (call $value_to_f64 (local.get $value_pointer))
                    (call $value_to_f64 (local.get $value_pointer2)))
                  (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )
