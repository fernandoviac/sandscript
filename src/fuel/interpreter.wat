          (then (return (i32.const 0))))))
    (call $map_set
      (local.get $receiver_pointer)
      (local.get $argument1_pointer)
      (local.get $argument2_pointer))
    (call $pending_push
      (global.get $TYPE_MAP) (i32.const 0)
      (local.get $receiver_pointer) (i32.const 0))
    (i32.const 0)
