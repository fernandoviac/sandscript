  ;; transpose(M) — pure slot rearrangement, (i, j) → (j, i).
  (func $matrix_transpose
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $arg1_type i32)
    (local $arg1_lo i32)
    (local $rows i32)
    (local $columns i32)
    (local $count i32)
    (local $entries_pointer i32)
    (local $entries_data i32)
    (local $a_data i32)
    (local $r i32)
    (local $c i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $arg1_type (call $value_type (local.get $argument1_pointer)))
        (local.set $arg1_lo (call $value_data_lo (local.get $argument1_pointer)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (i32.ne (local.get $arg1_type) (global.get $TYPE_MATRIX))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_MATRIX_NOT_MATRIX))))))
    (local.set $rows (call $matrix_rows_of (local.get $arg1_lo)))
    (local.set $columns (call $matrix_columns_of (local.get $arg1_lo)))
    (local.set $count (i32.mul (local.get $rows) (local.get $columns)))
    (local.set $entries_pointer (call $matrix_budget_and_alloc_entries (local.get $count)))
    (if (i32.eqz (local.get $entries_pointer))
      (then (return (i32.const 0))))
    (local.set $entries_data (i32.load (call $abs (i32.add (local.get $entries_pointer) (i32.const 16)))))
    (local.set $a_data (i32.load (call $abs (i32.add
      (call $matrix_entries_of (local.get $arg1_lo)) (i32.const 16)))))
    ;; dest[c * rows + r] = src[r * columns + c]
    (local.set $r (i32.const 0))
    (block $rows_done
      (loop $rows_loop
        (br_if $rows_done (i32.ge_u (local.get $r) (local.get $rows)))
        (local.set $c (i32.const 0))
        (block $cols_done
          (loop $cols_loop
            (br_if $cols_done (i32.ge_u (local.get $c) (local.get $columns)))
            (memory.copy
              (call $abs (i32.add
                (i32.add (local.get $entries_data) (global.get $GC_HEADER_SIZE))
                (i32.mul
                  (i32.add (i32.mul (local.get $c) (local.get $rows)) (local.get $r))
                  (global.get $VALUE_SIZE))))
              (call $abs (i32.add
                (i32.add (local.get $a_data) (global.get $GC_HEADER_SIZE))
                (i32.mul
                  (i32.add (i32.mul (local.get $r) (local.get $columns)) (local.get $c))
                  (global.get $VALUE_SIZE))))
              (global.get $VALUE_SIZE))
            (local.set $c (i32.add (local.get $c) (i32.const 1)))
            (br $cols_loop)))
        (local.set $r (i32.add (local.get $r) (i32.const 1)))
        (br $rows_loop)))
    (call $expression_freeze_args_array (local.get $entries_pointer))
    (call $push_matrix (call $matrix_allocate
      (local.get $columns) (local.get $rows) (local.get $entries_pointer)))
    (i32.const 0)
  )

