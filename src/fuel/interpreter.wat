    (call $pending_push (global.get $TYPE_ARRAY) (i32.const 0) (local.get $receiver_pointer) (i32.const 0))
    (return (i32.const 0))
  )

  (func $array_last_index_of_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $arg1_type i32)
    (local $arg1_lo i32)
    (local $arg1_hi i32)
    (local $argument2_pointer i32)
    (local $arg2_type i32)
    (local $arg2_lo i32)
    (local $arr_len i32)
    (local $data_pointer i32)
    (local $i i32)
    (local $found i32)
    (local $element_pointer i32)
    (local $materialize_result i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $arg1_type (call $value_type (local.get $argument1_pointer)))
        (local.set $arg1_lo (call $value_data_lo (local.get $argument1_pointer)))
        (local.set $arg1_hi (call $value_data_hi (local.get $argument1_pointer)))))
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then
        (local.set $argument2_pointer (i32.add (local.get $argument1_pointer) (global.get $VALUE_SIZE)))))
    (local.set $materialize_result (call $array_method_materialize (local.get $receiver_type) (local.get $receiver_pointer)))
    (if (i32.eq (local.get $materialize_result) (i32.const -1)) (then (return (i32.const 0))))
    (if (i32.eq (local.get $materialize_result) (i32.const -2)) (then (return (i32.const 2))))
    (local.set $receiver_pointer (local.get $materialize_result))
    (local.set $arr_len (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 8)))))
    (local.set $data_pointer (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 16)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))

    (local.set $i (i32.sub (local.get $arr_len) (i32.const 1)))
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then (local.set $i (call $search_last_index
        (local.get $argument2_pointer) (local.get $arr_len)))))
    (local.set $found (i32.const -1))
    (block $lidx_done
      (loop $lidx_loop
        (br_if $lidx_done (i32.lt_s (local.get $i) (i32.const 0)))
        (local.set $element_pointer (i32.add
          (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
          (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
        (local.set $arg2_type (i32.load (call $abs (local.get $element_pointer))))
        (local.set $arg2_lo (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 8)))))
        (if (i32.and
              (i32.and
                (i32.or
                  (i32.eq (local.get $arg1_type) (global.get $TYPE_FLOAT))
                  (i32.eq (local.get $arg1_type) (global.get $TYPE_RATIONAL)))
                (i32.or
                  (i32.eq (local.get $arg2_type) (global.get $TYPE_FLOAT))
                  (i32.eq (local.get $arg2_type) (global.get $TYPE_RATIONAL))))
              (i32.ne (local.get $arg1_type) (local.get $arg2_type)))
          (then
            (if (f64.eq
                  (call $value_to_f64 (local.get $argument1_pointer))
                  (call $value_to_f64 (local.get $element_pointer)))
              (then (local.set $found (local.get $i)) (br $lidx_done))
            )
          )
        )
        (if (i32.eq (local.get $arg1_type) (local.get $arg2_type))
          (then
            (if (i32.or
                  (i32.or
                    (i32.eq (local.get $arg1_type) (global.get $TYPE_NULL))
                    (i32.eq (local.get $arg1_type) (global.get $TYPE_UNDEFINED)))
                  (i32.or
                    (i32.eq (local.get $arg1_type) (global.get $TYPE_BOOLEAN))
                    (i32.eq (local.get $arg1_type) (global.get $TYPE_INTEGER))))
              (then
                (if (i32.eq (local.get $arg1_lo) (local.get $arg2_lo))
                  (then (local.set $found (local.get $i)) (br $lidx_done))
                )
              )
            )
            (if (i32.eq (local.get $arg1_type) (global.get $TYPE_FLOAT))
              (then
                (if (f64.eq
                      (call $read_f64 (local.get $argument1_pointer))
                      (call $read_f64 (local.get $element_pointer)))
                  (then (local.set $found (local.get $i)) (br $lidx_done))
                )
              )
            )
            (if (i32.eq (local.get $arg1_type) (global.get $TYPE_RATIONAL))
              (then
                (if (i32.and
                      (i32.eq (local.get $arg1_lo) (local.get $arg2_lo))
                      (i32.eq (local.get $arg1_hi)
                        (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 12))))))
                  (then (local.set $found (local.get $i)) (br $lidx_done))
                )
              )
            )
            (if (i32.eq (local.get $arg1_type) (global.get $TYPE_STRING))
              (then
                (if (i32.eq (local.get $arg1_lo) (local.get $arg2_lo))
                  (then (local.set $found (local.get $i)) (br $lidx_done))
                )
              )
            )
            (if (i32.or
                  (i32.eq (local.get $arg1_type) (global.get $TYPE_ARRAY))
                  (i32.eq (local.get $arg1_type) (global.get $TYPE_OBJECT)))
              (then
                (if (i32.eq (local.get $arg1_lo) (local.get $arg2_lo))
                  (then (local.set $found (local.get $i)) (br $lidx_done))
                )
              )
            )
          )
        )
        (local.set $i (i32.sub (local.get $i) (i32.const 1)))
        (br $lidx_loop)
      )
    )
    (call $push_f64 (f64.convert_i32_s (local.get $found)))
    (return (i32.const 0))
  )

  (func $array_copy_within_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $argument2_pointer i32)
    (local $argument3_pointer i32)
    (local $arr_len i32)
