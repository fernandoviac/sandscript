  ;; A count operand (or frame argc) contradicts the structure it
  ;; indexes — more values than a stack holds, paramCount above
  ;; $MAX_PARAMETER_COUNT, hasRest outside {0,1}. The parser never
  ;; emits these; the code block (or frame) was corrupted. Without the
  ;; tripwire a single corrupt count drives an unbounded write loop
  ;; (the observer incident's 218M-undefined pad flood). Detail = the
  ;; offending value.
  (global $ERR_CORRUPT_OPERAND i32 (i32.const 26))
  ;; The dispatcher's heap/code collision backstop fired: heap_pointer
  ;; reached code_pointer, meaning some carve wrote through the whole
  ;; slack red zone unguarded — the code block is likely already
  ;; corrupt. Distinct from
  ;; $ERR_OUT_OF_MEMORY (an honest allocation refusal with integrity
  ;; intact): this is a vat fault.
  (global $ERR_HEAP_CODE_COLLISION i32 (i32.const 27))

