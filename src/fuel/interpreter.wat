          (then
            (i32.store (call $abs (local.get $element_pointer))
              (i32.load (call $abs (local.get $argument1_pointer))))
            (i32.store (call $abs (i32.add (local.get $element_pointer) (i32.const 4)))
              (i32.load (call $abs (i32.add (local.get $argument1_pointer) (i32.const 4)))))
            (i32.store (call $abs (i32.add (local.get $element_pointer) (i32.const 8)))
              (i32.load (call $abs (i32.add (local.get $argument1_pointer) (i32.const 8)))))
            (i32.store (call $abs (i32.add (local.get $element_pointer) (i32.const 12)))
              (i32.load (call $abs (i32.add (local.get $argument1_pointer) (i32.const 12)))))
          )
          (else
            (i32.store (call $abs (local.get $element_pointer)) (global.get $TYPE_UNDEFINED))
            (i32.store (call $abs (i32.add (local.get $element_pointer) (i32.const 4))) (i32.const 0))
            (i32.store (call $abs (i32.add (local.get $element_pointer) (i32.const 8))) (i32.const 0))
            (i32.store (call $abs (i32.add (local.get $element_pointer) (i32.const 12))) (i32.const 0))
          )
