                )

                ;; flatMap — batch 26, same intercept shape.
                (if (i32.and
                      (i32.eq (local.get $opcode) (global.get $OP_CALL_METHOD))
                      (i32.eq (local.get $method_id) (global.get $METHOD_FLAT_MAP)))
