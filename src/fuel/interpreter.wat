  (global $ERR_CONST_ASSIGNMENT i32 (i32.const 19)) ;; Assignment to constant variable
  (global $ERR_GRANT_DENIED i32 (i32.const 20))    ;; External call requires grant not in stack
  (global $ERR_RANGE_ERROR i32 (i32.const 21))     ;; RangeError: invalid array length, buffer size
  (global $ERR_SYNTAX_ERROR i32 (i32.const 22))    ;; SyntaxError: invalid conversion text

  ;; Scope entry flags
  ;; Bit 31 (see constants.js): the low byte of the shared flags word
  ;; belongs to bound-method receiver types.
  (global $SCOPE_FLAG_CONST i32 (i32.const 0x80000000))

  ;; Completion types
  (global $COMPLETION_NORMAL i32 (i32.const 0))
  (global $COMPLETION_THROW i32 (i32.const 1))
  (global $COMPLETION_RETURN i32 (i32.const 2))
  ;; A pending break/continue crossing try frames (see OP_UNWIND_JUMP).
  (global $COMPLETION_JUMP i32 (i32.const 3))

  ;; Native continuation kinds. These are control-flow identifiers, not
  ;; callable method identifiers. Established numeric values are retained so
  ;; vat snapshots remain readable while return dispatch migrates.
  (global $CONTINUATION_KIND_ARRAY_MAP i32 (i32.const 0x0B))
  (global $CONTINUATION_KIND_ARRAY_FILTER i32 (i32.const 0x0C))
  (global $CONTINUATION_KIND_ARRAY_REDUCE i32 (i32.const 0x0D))
  (global $CONTINUATION_KIND_ARRAY_FOR_EACH i32 (i32.const 0x0E))
  (global $CONTINUATION_KIND_ARRAY_FIND i32 (i32.const 0x0F))
  (global $CONTINUATION_KIND_ARRAY_FIND_INDEX i32 (i32.const 0x10))
  (global $CONTINUATION_KIND_ARRAY_SOME i32 (i32.const 0x11))
