                  (call $algebraic_poly_coefficient
                    (call $algebraic_poly_coefficient
                      (local.get $real_by_imaginary_power) (local.get $j))
                    (local.get $real_power)))
                (call $algebraic_poly_set_coefficient
                  (local.get $inner_poly) (local.get $j)
                  (call $algebraic_poly_coefficient
                    (call $algebraic_poly_coefficient
                      (local.get $imaginary_by_imaginary_power) (local.get $j))
                    (local.get $real_power)))
                (local.set $j (i32.add (local.get $j) (i32.const 1)))
                (br $transpose_row)))
            (if (call $exact_value_poly_trim (local.get $retained_poly))
              (then (return (i32.const 0))))
            (if (call $exact_value_poly_trim (local.get $inner_poly))
              (then (return (i32.const 0))))
            (call $algebraic_poly_set_coefficient
              (local.get $real_by_real_power) (local.get $real_power)
              (local.get $retained_poly))
            (call $algebraic_poly_set_coefficient
              (local.get $imaginary_by_real_power) (local.get $real_power)
              (local.get $inner_poly))
            (local.set $real_power
              (i32.add (local.get $real_power) (i32.const 1)))
            (br $real_powers)))
        (call $algebraic_ypoly_trim (local.get $real_by_real_power))
        (call $algebraic_ypoly_trim (local.get $imaginary_by_real_power))
        (local.set $real_resultant (call $exact_value_ypoly_resultant
          (local.get $real_by_imaginary_power)
          (local.get $imaginary_by_imaginary_power)))
        (if (i32.eqz (local.get $real_resultant))
          (then (return (i32.const 0))))
        (local.set $imaginary_resultant (call $exact_value_ypoly_resultant
          (local.get $real_by_real_power) (local.get $imaginary_by_real_power)))
        (if (i32.eqz (local.get $imaginary_resultant))
          (then (return (i32.const 0))))
        (local.set $real_roots_slot
          (call $carve_scratch_blob (global.get $VALUE_SIZE)))
        (local.set $imaginary_roots_slot
          (call $carve_scratch_blob (global.get $VALUE_SIZE)))
        (local.set $status (call $complex_algebraic_real_roots_for_exact_poly
          (local.get $real_resultant) (local.get $real_roots_slot)))
        (if (i32.eq (local.get $status) (i32.const 1))
          (then (return (i32.const 0))))
        (if (i32.eq (local.get $status) (i32.const 2))
          (then (return (i32.const 1))))
        (if (i32.eq (local.get $status) (i32.const 3))
          (then (return (i32.const 2))))
        (local.set $status (call $complex_algebraic_real_roots_for_exact_poly
          (local.get $imaginary_resultant) (local.get $imaginary_roots_slot)))
        (if (i32.eq (local.get $status) (i32.const 1))
          (then (return (i32.const 0))))
        (if (i32.eq (local.get $status) (i32.const 2))
          (then (return (i32.const 1))))
        (if (i32.eq (local.get $status) (i32.const 3))
          (then (return (i32.const 2))))
        (local.set $real_roots_array
          (call $value_data_lo (local.get $real_roots_slot)))
        (local.set $imaginary_roots_array
          (call $value_data_lo (local.get $imaginary_roots_slot)))
        (local.set $real_root_count (i32.load (call $abs
          (i32.add (local.get $real_roots_array) (i32.const 8)))))
        (local.set $imaginary_root_count (i32.load (call $abs
          (i32.add (local.get $imaginary_roots_array) (i32.const 8)))))
        (local.set $real_roots_data (i32.add
          (i32.load (call $abs
            (i32.add (local.get $real_roots_array) (i32.const 16))))
          (global.get $GC_HEADER_SIZE)))
        (local.set $imaginary_roots_data (i32.add
          (i32.load (call $abs
            (i32.add (local.get $imaginary_roots_array) (i32.const 16))))
          (global.get $GC_HEADER_SIZE)))
        (if (local.get $all_coefficients_real)
          (then
            (local.set $real_coefficient_roots_array
              (call $value_data_lo (local.get $real_coefficient_roots_slot)))
            (local.set $real_coefficient_root_count (i32.load (call $abs
              (i32.add (local.get $real_coefficient_roots_array) (i32.const 8)))))
            (local.set $real_coefficient_roots_data (i32.add
              (i32.load (call $abs (i32.add
                (local.get $real_coefficient_roots_array) (i32.const 16))))
              (global.get $GC_HEADER_SIZE)))))
        (if (call $expression_walk_guard (i32.add (i32.const 128)
              (i32.mul (local.get $polynomial_degree) (global.get $VALUE_SIZE))))
          (then (return (i32.const 0))))
        (local.set $survivor_slots (call $carve_scratch_blob
          (i32.mul (local.get $polynomial_degree) (global.get $VALUE_SIZE))))
        (local.set $candidate_slot
          (call $carve_scratch_blob (global.get $VALUE_SIZE)))
        (local.set $accumulator_slot
          (call $carve_scratch_blob (global.get $VALUE_SIZE)))
        (local.set $product_slot
          (call $carve_scratch_blob (global.get $VALUE_SIZE)))
        (local.set $sum_slot
          (call $carve_scratch_blob (global.get $VALUE_SIZE)))
        ;; A real cubic has either only real roots or one real root plus one
        ;; conjugate pair. The coordinate resultants already prove the two
        ;; components of that pair; do not rebuild a large cross-field Horner
        ;; computation to rediscover the cubic conjugacy theorem.
        (if (local.get $all_coefficients_real)
          (then
            (local.set $nonzero_imaginary_root_count (i32.const 0))
            (local.set $j (i32.const 0))
            (block $imaginary_projection_counted
              (loop $count_imaginary_projection
                (br_if $imaginary_projection_counted
                  (i32.ge_s (local.get $j) (local.get $imaginary_root_count)))
                (local.set $zero_status (call $algebraic_slot_is_exact_zero
                  (i32.add (local.get $imaginary_roots_data)
                    (i32.mul (local.get $j) (global.get $VALUE_SIZE)))))
                (if (i32.eq (local.get $zero_status) (i32.const 2))
                  (then (return (i32.const 0))))
                (if (i32.eqz (local.get $zero_status))
                  (then (local.set $nonzero_imaginary_root_count (i32.add
                    (local.get $nonzero_imaginary_root_count) (i32.const 1)))))
                (local.set $j (i32.add (local.get $j) (i32.const 1)))
                (br $count_imaginary_projection)))
            (if (i32.eqz (local.get $nonzero_imaginary_root_count))
              (then (local.set $skip_candidate_filter (i32.const 1))))
            (if (i32.and
                  (i32.and
                    (i32.eq (local.get $polynomial_degree) (i32.const 3))
                    (i32.eq (local.get $real_coefficient_root_count) (i32.const 1)))
                  (i32.and
                    (i32.eq (local.get $real_root_count) (i32.const 2))
                    (i32.eq (local.get $nonzero_imaginary_root_count) (i32.const 2))))
              (then
                (local.set $cubic_nonreal_real_matches (i32.const 0))
                (local.set $i (i32.const 0))
                (block $cubic_real_projection_selected
                  (loop $select_cubic_real_projection
                    (br_if $cubic_real_projection_selected
                      (i32.ge_s (local.get $i) (local.get $real_root_count)))
                    (local.set $zero_status (call $complex_algebraic_equals_slots
                      (i32.add (local.get $real_roots_data)
                        (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
                      (local.get $real_coefficient_roots_data)))
                    (if (i32.eq (local.get $zero_status) (i32.const -2))
                      (then (return (i32.const 0))))
                    (if (i32.eqz (local.get $zero_status))
                      (then
                        (local.set $cubic_nonreal_real_index (local.get $i))
                        (local.set $cubic_nonreal_real_matches (i32.add
                          (local.get $cubic_nonreal_real_matches) (i32.const 1)))))
                    (local.set $i (i32.add (local.get $i) (i32.const 1)))
                    (br $select_cubic_real_projection)))
                (if (i32.eq (local.get $cubic_nonreal_real_matches) (i32.const 1))
                  (then
                    (local.set $j (i32.const 0))
                    (block $cubic_pair_materialized
                      (loop $materialize_cubic_pair
                        (br_if $cubic_pair_materialized
                          (i32.ge_s (local.get $j) (local.get $imaginary_root_count)))
                        (local.set $zero_status (call $algebraic_slot_is_exact_zero
                          (i32.add (local.get $imaginary_roots_data)
                            (i32.mul (local.get $j) (global.get $VALUE_SIZE)))))
                        (if (i32.eq (local.get $zero_status) (i32.const 2))
                          (then (return (i32.const 0))))
                        (if (i32.eqz (local.get $zero_status))
                          (then
                            (if (call $complex_algebraic_write_result
                                  (i32.add (local.get $real_roots_data)
                                    (i32.mul (local.get $cubic_nonreal_real_index)
                                      (global.get $VALUE_SIZE)))
                                  (i32.add (local.get $imaginary_roots_data)
                                    (i32.mul (local.get $j) (global.get $VALUE_SIZE)))
                                  (i32.add (local.get $survivor_slots)
                                    (i32.mul (local.get $survivor_count)
                                      (global.get $VALUE_SIZE))))
                              (then (return (i32.const 0))))
                            (local.set $survivor_count
                              (i32.add (local.get $survivor_count) (i32.const 1)))))
                        (local.set $j (i32.add (local.get $j) (i32.const 1)))
                        (br $materialize_cubic_pair)))
                    (if (i32.eq (local.get $survivor_count) (i32.const 2))
                      (then (local.set $skip_candidate_filter (i32.const 1)))
                      (else (local.set $survivor_count (i32.const 0))))))))))
        (if (i32.eqz (local.get $skip_candidate_filter))
          (then
            (local.set $i (i32.const 0))
        (block $real_candidates_done
          (loop $real_candidates
            (br_if $real_candidates_done
              (i32.ge_s (local.get $i) (local.get $real_root_count)))
            (local.set $j (i32.const 0))
            (block $imaginary_candidates_done
              (loop $imaginary_candidates
                (br_if $imaginary_candidates_done
                  (i32.ge_s (local.get $j) (local.get $imaginary_root_count)))
                (if (local.get $all_coefficients_real)
                  (then
                    (local.set $zero_status (call $algebraic_slot_is_exact_zero
                      (i32.add (local.get $imaginary_roots_data)
                        (i32.mul (local.get $j) (global.get $VALUE_SIZE)))))
                    (if (i32.eq (local.get $zero_status) (i32.const 2))
                      (then (return (i32.const 0))))
                    (if (local.get $zero_status)
                      (then
                        (local.set $j (i32.add (local.get $j) (i32.const 1)))
                        (br $imaginary_candidates)))))
                (call $complex_algebraic_write_result
                  (i32.add (local.get $real_roots_data)
                    (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
                  (i32.add (local.get $imaginary_roots_data)
                    (i32.mul (local.get $j) (global.get $VALUE_SIZE)))
                  (local.get $candidate_slot))
                (call $write_inline_rational
                  (local.get $accumulator_slot) (i64.const 0))
                (local.set $k (local.get $polynomial_degree))
                (block $horner_done
                  (loop $horner
                    (br_if $horner_done (i32.lt_s (local.get $k) (i32.const 0)))
                    (local.set $status (call $complex_algebraic_slot_arith
                      (i32.const 2) (local.get $accumulator_slot)
                      (local.get $candidate_slot) (local.get $product_slot)))
                    (if (local.get $status) (then (return (i32.const 0))))
                    (local.set $status (call $complex_algebraic_slot_arith
                      (i32.const 0) (local.get $product_slot)
                      (i32.add (local.get $evaluated_coefficients)
                        (i32.mul (local.get $k) (global.get $VALUE_SIZE)))
                      (local.get $sum_slot)))
                    (if (local.get $status) (then (return (i32.const 0))))
                    (memory.copy (call $abs (local.get $accumulator_slot))
                      (call $abs (local.get $sum_slot)) (global.get $VALUE_SIZE))
                    (local.set $k (i32.sub (local.get $k) (i32.const 1)))
                    (br $horner)))
                (local.set $zero_status (call $complex_algebraic_equals_slots
                  (local.get $accumulator_slot) (local.get $zero_slot)))
                (if (i32.eq (local.get $zero_status) (i32.const -2))
                  (then (return (i32.const 0))))
                (if (local.get $zero_status)
                  (then
                    (if (i32.ge_s (local.get $survivor_count)
                          (local.get $polynomial_degree))
                      (then (unreachable)))
                    (memory.copy
                      (call $abs (i32.add (local.get $survivor_slots)
                        (i32.mul (local.get $survivor_count)
                          (global.get $VALUE_SIZE))))
                      (call $abs (local.get $candidate_slot))
                      (global.get $VALUE_SIZE))
                    (local.set $survivor_count
                      (i32.add (local.get $survivor_count) (i32.const 1)))))
                (local.set $j (i32.add (local.get $j) (i32.const 1)))
                (br $imaginary_candidates)))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $real_candidates)))))
        (if (local.get $all_coefficients_real)
          (then
            (local.set $i (i32.const 0))
            (block $real_roots_appended
              (loop $append_real_roots
                (br_if $real_roots_appended
                  (i32.ge_s (local.get $i) (local.get $real_coefficient_root_count)))
                (if (i32.ge_s (local.get $survivor_count)
                      (local.get $polynomial_degree))
                  (then (unreachable)))
                (memory.copy
                  (call $abs (i32.add (local.get $survivor_slots)
                    (i32.mul (local.get $survivor_count) (global.get $VALUE_SIZE))))
                  (call $abs (i32.add (local.get $real_coefficient_roots_data)
                    (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
                  (global.get $VALUE_SIZE))
                (local.set $survivor_count
                  (i32.add (local.get $survivor_count) (i32.const 1)))
                (local.set $i (i32.add (local.get $i) (i32.const 1)))
                (br $append_real_roots)))))
        (if (call $expression_walk_guard
              (call $estimate_array_size (local.get $survivor_count)))
          (then (return (i32.const 0))))
        (local.set $result_array
          (call $allocate_array (local.get $survivor_count)))
        (local.set $result_data (i32.add
          (i32.load (call $abs (i32.add
            (local.get $result_array) (i32.const 16))))
          (global.get $GC_HEADER_SIZE)))
        (memory.copy (call $abs (local.get $result_data))
          (call $abs (local.get $survivor_slots))
          (i32.mul (local.get $survivor_count) (global.get $VALUE_SIZE)))
        (call $expression_freeze_args_array (local.get $result_array))
        (call $write_value (local.get $stack_base)
          (global.get $TYPE_ARRAY) (i32.const 0)
          (local.get $result_array) (i32.const 0))
        (call $write_ctx (global.get $CTX_PENDING_POINTER)
          (i32.add (local.get $stack_base) (global.get $VALUE_SIZE)))
        (return (i32.const 0))))

    ;; Remaining method identifiers are handled once their root/approximation
    ;; algorithms have validated the shared argument surface.
    unreachable
  )

  ;; Unary negation of the AlgebraicNumber in $slot, in place.
  ;; 0 ok / 1 pressure.
  (func $algebraic_operator_negate (param $slot i32) (result i32)
    (local $out_slot i32)
    (local $status i32)
    (if (call $expression_walk_guard (i32.add (global.get $VALUE_SIZE) (i32.const 96)))
      (then (return (i32.const 1))))
    (local.set $out_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (local.set $status (call $algebraic_value_scale_rational
      (call $value_data_lo (local.get $slot))
      (call $rational_new
        (call $algebraic_bigint_negate (call $bigint_one)) (call $bigint_one))
      (local.get $out_slot)))
    (if (local.get $status) (then (return (local.get $status))))
    (call $write_value (local.get $slot)
      (call $value_type (local.get $out_slot))
      (call $value_flags (local.get $out_slot))
      (call $value_data_lo (local.get $out_slot))
      (call $value_data_hi (local.get $out_slot)))
    (i32.const 0)
  )

  ;; ----- the Exact.AlgebraicNumber builtins ---------------------------------

  ;; compare / equals / sign / isZero. Arguments may be
  ;; AlgebraicNumber, Rational, or BigInt; sign/isZero compare against
  ;; zero. Kinds: 0 = both plain rationals, 1 = left algebraic,
  ;; 2 = right algebraic, 3 = both algebraic.
  (func $algebraic_predicate_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $argument2_pointer i32)
    (local $arg1_type i32)
    (local $arg2_type i32)
    (local $wants_two i32)
    (local $left_algebraic i32)
    (local $right_algebraic i32)
    (local $left_rational i32)
    (local $right_rational i32)
    (local $comparison i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $arg1_type (call $value_type (local.get $argument1_pointer)))))
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then
        (local.set $argument2_pointer (i32.add (local.get $argument1_pointer) (global.get $VALUE_SIZE)))
        (local.set $arg2_type (call $value_type (local.get $argument2_pointer)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (local.set $wants_two (i32.or
      (i32.eq (local.get $method_id) (global.get $METHOD_EXACT_ALGEBRAIC_COMPARE))
      (i32.eq (local.get $method_id) (global.get $METHOD_EXACT_ALGEBRAIC_EQUALS))))
    (if (i32.eqz (i32.or
          (i32.or
            (i32.eq (local.get $arg1_type) (global.get $TYPE_ALGEBRAIC))
            (i32.eq (local.get $arg1_type) (global.get $TYPE_RATIONAL)))
          (i32.eq (local.get $arg1_type) (global.get $TYPE_BIGINT))))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_ALGEBRAIC_ARGUMENT))))))
    (if (local.get $wants_two)
      (then
        (if (i32.eqz (i32.or
              (i32.or
                (i32.eq (local.get $arg2_type) (global.get $TYPE_ALGEBRAIC))
                (i32.eq (local.get $arg2_type) (global.get $TYPE_RATIONAL)))
              (i32.eq (local.get $arg2_type) (global.get $TYPE_BIGINT))))
          (then (return (i32.add (i32.const 1)
            (call $throw_type_error_with_message (global.get $BUILTIN_MSG_ALGEBRAIC_ARGUMENT))))))))
    ;; Normalise both sides to (algebraic header | rational header).
    (if (call $expression_walk_guard (i32.const 256))
      (then (return (i32.const 0))))
    (if (i32.eq (local.get $arg1_type) (global.get $TYPE_ALGEBRAIC))
      (then (local.set $left_algebraic (call $value_data_lo (local.get $argument1_pointer))))
      (else
        (if (i32.eq (local.get $arg1_type) (global.get $TYPE_BIGINT))
          (then (local.set $left_rational (call $rational_from_bigint
            (call $value_data_lo (local.get $argument1_pointer)))))
          (else (local.set $left_rational (call $rational_materialize
            (local.get $argument1_pointer)))))))
    (if (local.get $wants_two)
      (then
        (if (i32.eq (local.get $arg2_type) (global.get $TYPE_ALGEBRAIC))
          (then (local.set $right_algebraic (call $value_data_lo (local.get $argument2_pointer))))
          (else
            (if (i32.eq (local.get $arg2_type) (global.get $TYPE_BIGINT))
              (then (local.set $right_rational (call $rational_from_bigint
                (call $value_data_lo (local.get $argument2_pointer)))))
              (else (local.set $right_rational (call $rational_materialize
                (local.get $argument2_pointer))))))))
      (else
        ;; sign / isZero compare against zero.
        (local.set $right_rational (call $rational_new
          (call $bigint_zero) (call $bigint_one)))))
    (if (local.get $left_algebraic)
      (then
        (if (local.get $right_algebraic)
          (then (local.set $comparison (call $algebraic_compare_algebraic
            (local.get $left_algebraic) (local.get $right_algebraic))))
          (else (local.set $comparison (call $algebraic_compare_with_rational
            (local.get $left_algebraic) (local.get $right_rational))))))
      (else
        (if (local.get $right_algebraic)
          (then
            (local.set $comparison (call $algebraic_compare_with_rational
              (local.get $right_algebraic) (local.get $left_rational)))
            (if (i32.ne (local.get $comparison) (i32.const -2))
              (then (local.set $comparison (i32.sub (i32.const 0) (local.get $comparison))))))
          (else (local.set $comparison (call $rational_header_pair_compare
            (local.get $left_rational) (local.get $right_rational)))))))
    (if (i32.eq (local.get $comparison) (i32.const -2))
      (then (return (i32.const 0))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_EXACT_ALGEBRAIC_COMPARE))
      (then
        (call $push_rational_inline (i64.extend_i32_s (local.get $comparison)))
        (return (i32.const 0))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_EXACT_ALGEBRAIC_EQUALS))
      (then
        (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0)
          (i32.eqz (local.get $comparison)) (i32.const 0))
        (return (i32.const 0))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_EXACT_ALGEBRAIC_SIGN))
      (then
        (call $push_rational_inline (i64.extend_i32_s (local.get $comparison)))
        (return (i32.const 0))))
    ;; isZero
    (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0)
      (i32.eqz (local.get $comparison)) (i32.const 0))
    (i32.const 0)
  )

  ;; toApproximation(value, widthExponent) — refine to width ≤
  ;; 2^widthExponent, return the interval midpoint as a Float. The one
  ;; sanctioned exit to floating point. Rational/BigInt arguments
  ;; convert directly (the width is irrelevant to an exact rational).
  (func $algebraic_to_approximation
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $argument2_pointer i32)
    (local $arg1_type i32)
    (local $arg2_type i32)
    (local $width_exponent i64)
    (local $width_valid i32)
    (local $header i32)
    (local $target i32)
    (local $interval_data i32)
    (local $low i32)
    (local $high i32)
    (local $width i32)
    (local $mid i32)
    (local $mid_slot i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $arg1_type (call $value_type (local.get $argument1_pointer)))))
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then
        (local.set $argument2_pointer (i32.add (local.get $argument1_pointer) (global.get $VALUE_SIZE)))
        (local.set $arg2_type (call $value_type (local.get $argument2_pointer)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (i32.eqz (i32.or
          (i32.or
            (i32.eq (local.get $arg1_type) (global.get $TYPE_ALGEBRAIC))
            (i32.eq (local.get $arg1_type) (global.get $TYPE_RATIONAL)))
          (i32.eq (local.get $arg1_type) (global.get $TYPE_BIGINT))))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_ALGEBRAIC_ARGUMENT))))))
    ;; widthExponent: an integer-valued Rational or BigInt.
    (if (i32.eq (local.get $arg2_type) (global.get $TYPE_RATIONAL))
      (then
        (if (call $rational_is_inline (local.get $argument2_pointer))
          (then
            (local.set $width_exponent (call $rational_read_inline (local.get $argument2_pointer)))
            (local.set $width_valid (i32.const 1)))
          (else
            (if (call $rational_denominator_is_one
                  (call $value_data_lo (local.get $argument2_pointer)))
              (then
                (if (call $bigint_to_i64_fits (call $rational_numerator
                      (call $value_data_lo (local.get $argument2_pointer))))
                  (then
                    (local.set $width_exponent (global.get $bigint_to_i64_value))
                    (local.set $width_valid (i32.const 1)))))))))
      (else
        (if (i32.eq (local.get $arg2_type) (global.get $TYPE_BIGINT))
          (then
            (if (call $bigint_to_i64_fits (call $value_data_lo (local.get $argument2_pointer)))
              (then
                (local.set $width_exponent (global.get $bigint_to_i64_value))
                (local.set $width_valid (i32.const 1))))))))
    (if (i32.eqz (local.get $width_valid))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_ALGEBRAIC_WIDTH))))))
    (if (i32.or
          (i64.gt_s (local.get $width_exponent) (i64.const 1048576))
          (i64.lt_s (local.get $width_exponent) (i64.const -1048576)))
      (then (return (i32.add (i32.const 1)
        (call $throw_range_error_with_message (global.get $BUILTIN_MSG_ALGEBRAIC_WIDTH))))))
    ;; Exact rationals convert directly.
    (if (i32.ne (local.get $arg1_type) (global.get $TYPE_ALGEBRAIC))
      (then
        (call $push_f64 (call $value_to_f64 (local.get $argument1_pointer)))
        (return (i32.const 0))))
    (local.set $header (call $value_data_lo (local.get $argument1_pointer)))
    ;; Target width 2^w as a rational header.
    (if (call $expression_walk_guard (call $estimate_bigint_size (i32.add
          (i32.wrap_i64 (i64.shr_u (i64.const 1048576) (i64.const 5))) (i32.const 8))))
      (then (return (i32.const 0))))
    (if (i64.ge_s (local.get $width_exponent) (i64.const 0))
      (then (local.set $target (call $rational_new
        (call $bigint_shift_left_bits (call $bigint_one)
          (i32.wrap_i64 (local.get $width_exponent)))
        (call $bigint_one))))
      (else (local.set $target (call $rational_new
        (call $bigint_one)
        (call $bigint_shift_left_bits (call $bigint_one)
          (i32.wrap_i64 (i64.sub (i64.const 0) (local.get $width_exponent))))))))
    (block $narrow_done
      (loop $narrow
        (local.set $interval_data (i32.add
          (i32.load (call $abs (i32.add
            (call $algebraic_interval_of (local.get $header)) (i32.const 16))))
          (global.get $GC_HEADER_SIZE)))
        (if (call $expression_walk_guard (i32.const 512))
          (then (return (i32.const 0))))
        (local.set $low (call $rational_materialize (local.get $interval_data)))
        (local.set $high (call $rational_materialize
          (i32.add (local.get $interval_data) (global.get $VALUE_SIZE))))
        (local.set $width (call $rational_sub (local.get $high) (local.get $low)))
        (br_if $narrow_done (i32.le_s
          (call $rational_header_pair_compare (local.get $width) (local.get $target))
          (i32.const 0)))
        (if (call $algebraic_refine_step (local.get $header))
          (then (return (i32.const 0))))
        (br $narrow)))
    (local.set $mid (call $algebraic_rational_midpoint (local.get $low) (local.get $high)))
    (if (i32.eqz (local.get $mid)) (then (return (i32.const 0))))
    (if (call $expression_walk_guard (i32.const 64))
      (then (return (i32.const 0))))
    (local.set $mid_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (call $write_value (local.get $mid_slot)
      (global.get $TYPE_RATIONAL) (i32.const 0) (local.get $mid) (i32.const 0))
    (call $push_f64 (call $value_to_f64 (local.get $mid_slot)))
    (i32.const 0)
  )

  ;; definingPolynomial / isolatingInterval / isAlgebraicNumber.
  (func $algebraic_introspection_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $arg1_type i32)
    (local $header i32)
    (local $coefficients_array i32)
    (local $length i32)
    (local $list i32)
    (local $variable_slot i32)
    (local $variable_symbol i32)
    (local $destination_slot i32)
    (local $status i32)
    (local $interval_data i32)
    (local $result_array i32)
    (local $result_data i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $arg1_type (call $value_type (local.get $argument1_pointer)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_EXACT_ALGEBRAIC_IS_ALGEBRAIC_NUMBER))
      (then
        (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0)
          (i32.eq (local.get $arg1_type) (global.get $TYPE_ALGEBRAIC)) (i32.const 0))
        (return (i32.const 0))))
    (if (i32.ne (local.get $arg1_type) (global.get $TYPE_ALGEBRAIC))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_ALGEBRAIC_ARGUMENT))))))
    (local.set $header (call $value_data_lo (local.get $argument1_pointer)))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_EXACT_ALGEBRAIC_ISOLATING_INTERVAL))
      (then
        ;; A COPY of the interval — the stored one narrows under
        ;; refinement; the returned snapshot must not.
        (if (call $expression_walk_guard (i32.add
              (call $estimate_array_size (i32.const 2)) (i32.const 32)))
          (then (return (i32.const 0))))
        (local.set $result_array (call $allocate_array (i32.const 2)))
        (local.set $result_data (i32.add
          (i32.load (call $abs (i32.add (local.get $result_array) (i32.const 16))))
          (global.get $GC_HEADER_SIZE)))
        (local.set $interval_data (i32.add
          (i32.load (call $abs (i32.add
            (call $algebraic_interval_of (local.get $header)) (i32.const 16))))
          (global.get $GC_HEADER_SIZE)))
        (memory.copy (call $abs (local.get $result_data))
          (call $abs (local.get $interval_data))
          (i32.mul (i32.const 2) (global.get $VALUE_SIZE)))
        (call $expression_freeze_args_array (local.get $result_array))
        (call $pending_push (global.get $TYPE_ARRAY) (i32.const 0)
          (local.get $result_array) (i32.const 0))
        (return (i32.const 0))))
    ;; definingPolynomial: rebuild Σ c_i·x^i as a canonical Ring 2
    ;; expression in the registered Symbol x.
    (local.set $variable_symbol (call $symbol_registry_get_or_create
      (call $read_builtin (global.get $BUILTIN_EXACT_VARIABLE_X))))
    (if (i32.eqz (local.get $variable_symbol))
      (then (return (i32.const 0))))
    (local.set $coefficients_array (call $algebraic_coefficients_of (local.get $header)))
    (local.set $length (i32.load (call $abs (i32.add (local.get $coefficients_array) (i32.const 8)))))
    (local.set $list (i32.add
      (i32.load (call $abs (i32.add (local.get $coefficients_array) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (if (call $expression_walk_guard (i32.add (global.get $VALUE_SIZE)
          (i32.add (global.get $VALUE_SIZE) (i32.const 64))))
      (then (return (i32.const 0))))
    (local.set $variable_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (call $write_value (local.get $variable_slot)
      (global.get $TYPE_SYMBOL) (i32.const 0)
      (local.get $variable_symbol)
      (i32.const 0))
    (local.set $destination_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (local.set $status (call $poly_from_coefficient_list
      (local.get $list) (i32.sub (local.get $length) (i32.const 1))
      (local.get $variable_slot) (local.get $destination_slot) (i32.const 1)))
    (if (local.get $status) (then (return (i32.const 0))))
    (call $pending_push
      (call $value_type (local.get $destination_slot))
      (call $value_flags (local.get $destination_slot))
      (call $value_data_lo (local.get $destination_slot))
      (call $value_data_hi (local.get $destination_slot)))
    (i32.const 0)
  )

  ;; fromExpression — 6b form: simplify to canonical form, then
  ;; exactly evaluate the numeric-radical tree (numeric leaves, the
  ;; arithmetic heads, rational-exponent Power) into a Rational or
  ;; AlgebraicNumber. Symbols, Complex values, and non-rational
  ;; exponents are TypeErrors; division by an exact zero (and even
  ;; roots of negative values) surface as RangeErrors from the
  ;; evaluator itself.
  (func $algebraic_from_expression
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $arg1_type i32)
    (local $stage i32)
    (local $result_type i32)
    (local $out_slot i32)
    (local $status i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $arg1_type (call $value_type (local.get $argument1_pointer)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (i32.or
          (i32.eq (local.get $arg1_type) (global.get $TYPE_RATIONAL))
          (i32.eq (local.get $arg1_type) (global.get $TYPE_BIGINT)))
      (then
        (call $pending_push
          (call $value_type (local.get $argument1_pointer))
          (call $value_flags (local.get $argument1_pointer))
          (call $value_data_lo (local.get $argument1_pointer))
          (call $value_data_hi (local.get $argument1_pointer)))
        (return (i32.const 0))))
    (if (i32.eqz (i32.or
          (i32.eq (local.get $arg1_type) (global.get $TYPE_EXPRESSION))
          (i32.eq (local.get $arg1_type) (global.get $TYPE_SYMBOL))))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_ALGEBRAIC_FROM_EXPRESSION))))))
    (if (call $expression_walk_guard (i32.add (global.get $VALUE_SIZE) (i32.const 32)))
      (then (return (i32.const 0))))
    (local.set $stage (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (if (call $expression_simplify_into (local.get $argument1_pointer) (local.get $stage))
      (then (return (i32.const 0))))
    (local.set $result_type (call $value_type (local.get $stage)))
    (if (i32.or
          (i32.eq (local.get $result_type) (global.get $TYPE_RATIONAL))
          (i32.eq (local.get $result_type) (global.get $TYPE_BIGINT)))
      (then
        (call $pending_push
          (local.get $result_type)
          (call $value_flags (local.get $stage))
          (call $value_data_lo (local.get $stage))
          (call $value_data_hi (local.get $stage)))
        (return (i32.const 0))))
    ;; Not rational-valued after simplify: run the exact radical
    ;; evaluator over the canonical tree.
    (if (call $expression_walk_guard (i32.add (global.get $VALUE_SIZE) (i32.const 32)))
      (then (return (i32.const 0))))
    (local.set $out_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (local.set $status (call $algebraic_evaluate_node
      (local.get $stage) (local.get $out_slot) (i32.const 0)))
    (if (i32.eq (local.get $status) (i32.const 1)) (then (return (i32.const 0))))
    (if (i32.eq (local.get $status) (i32.const 2)) (then (return (i32.const 1))))
    (if (i32.eq (local.get $status) (i32.const 3)) (then (return (i32.const 2))))
    (if (i32.and
          (i32.eq (call $value_type (local.get $out_slot)) (global.get $TYPE_RATIONAL))
          (i32.eqz (call $rational_is_inline (local.get $out_slot))))
      (then
        (call $push_rational (call $value_data_lo (local.get $out_slot)))
        (return (i32.const 0))))
    (call $pending_push
      (call $value_type (local.get $out_slot))
      (call $value_flags (local.get $out_slot))
      (call $value_data_lo (local.get $out_slot))
      (call $value_data_hi (local.get $out_slot)))
    (i32.const 0)
  )

  ;; ----- 6b: roots and the radical-tree evaluator ---------------------------

  ;; Convert evaluator validation failures into either a real language
  ;; exception or a quiet "not foldable" status for simplify's speculative
  ;; radical decision pass.
  (func $algebraic_evaluation_failure
    (param $quiet i32) (param $range_error i32) (param $message i32)
    (result i32)
    (if (local.get $quiet) (then (return (i32.const 2))))
    (if (local.get $range_error)
      (then (return (i32.add (i32.const 2)
        (call $throw_range_error_with_message (local.get $message))))))
    (i32.add (i32.const 2)
      (call $throw_type_error_with_message (local.get $message)))
  )

  ;; n-th root core (n ≥ 2): value slot in (AlgebraicNumber /
  ;; Rational / BigInt), principal real root out. Even n of a negative
  ;; value is a RangeError; nthRoot(0) is 0. Rational radicands take
  ;; the direct v·x^n − u polynomial; algebraic radicands spread the
  ;; defining polynomial to p(x^n) and select among its isolated roots
  ;; by n-th-power interval overlap against the radicand's interval.
  ;; 0 ok / 1 pressure / 2 caught throw (or quiet refusal) / 3 uncaught throw.
  (func $algebraic_nth_root_core
    (param $value_slot i32) (param $n i32) (param $out_slot i32) (param $quiet i32)
    (result i32)
    (local $value_type i32)
    (local $rational_header i32)
    (local $header i32)
    (local $sign i32)
    (local $poly i32)
    (local $degree i32)
    (local $strip i32)
    (local $stripped i32)
    (local $spread i32)
    (local $spread_degree64 i64)
    (local $spread_degree i32)
    (local $zero_bigint i32)
    (local $i i32)
    (local $u i32)
    (local $v i32)
    (local $output i32)
    (local $count i32)
    (local $entry i32)
    (local $n_bigint i32)
    (local $interval_data i32)
    (local $v_low i32)
    (local $v_high i32)
    (local $matches i32)
    (local $chosen i32)
    (local $kind i32)
    (local $bound_low i32)
    (local $bound_high i32)
    (local $power_low i32)
    (local $power_high i32)
    (local $swap i32)
    (local $limbs64 i64)
    (local $straddles i32)
    (local $zero_rational i32)
    (local.set $value_type (call $value_type (local.get $value_slot)))
    (block $have_rational
      (if (i32.ne (local.get $value_type) (global.get $TYPE_ALGEBRAIC))
        (then
          (if (call $expression_walk_guard (i32.const 128))
            (then (return (i32.const 1))))
          (if (i32.eq (local.get $value_type) (global.get $TYPE_BIGINT))
            (then (local.set $rational_header (call $rational_from_bigint
              (call $value_data_lo (local.get $value_slot)))))
            (else (local.set $rational_header (call $rational_materialize (local.get $value_slot)))))
          (br $have_rational)))
      ;; Algebraic radicand.
      (local.set $header (call $value_data_lo (local.get $value_slot)))
      (if (call $expression_walk_guard (i32.const 96))
        (then (return (i32.const 1))))
      (local.set $zero_rational (call $rational_new (call $bigint_zero) (call $bigint_one)))
      (local.set $sign (call $algebraic_compare_with_rational
        (local.get $header) (local.get $zero_rational)))
      (if (i32.eq (local.get $sign) (i32.const -2)) (then (return (i32.const 1))))
      (if (i32.eqz (local.get $sign))
        (then
          (call $write_inline_rational (local.get $out_slot) (i64.const 0))
          (return (i32.const 0))))
      (if (i32.and
            (i32.lt_s (local.get $sign) (i32.const 0))
            (i32.eqz (i32.and (local.get $n) (i32.const 1))))
        (then (return (call $algebraic_evaluation_failure
          (local.get $quiet) (i32.const 1) (global.get $BUILTIN_MSG_ALGEBRAIC_ROOT_DOMAIN)))))
      (local.set $poly (call $algebraic_poly_from_array
        (call $algebraic_coefficients_of (local.get $header))))
      (if (i32.eqz (local.get $poly)) (then (return (i32.const 1))))
      (local.set $degree (call $algebraic_poly_degree (local.get $poly)))
      ;; A zero constant coefficient means x divides the defining
      ;; polynomial (squarefree ⇒ exactly once); the value is nonzero,
      ;; so strip that factor.
      (if (i32.eqz (call $bigint_length
            (call $algebraic_poly_coefficient (local.get $poly) (i32.const 0))))
        (then
          (local.set $stripped (call $algebraic_poly_carve
            (i32.sub (local.get $degree) (i32.const 1))))
          (if (i32.eqz (local.get $stripped)) (then (return (i32.const 1))))
          (local.set $i (i32.const 0))
          (block $strip_done
            (loop $strip_loop
              (br_if $strip_done (i32.gt_s (local.get $i)
                (i32.sub (local.get $degree) (i32.const 1))))
              (call $algebraic_poly_set_coefficient (local.get $stripped) (local.get $i)
                (call $algebraic_poly_coefficient (local.get $poly)
                  (i32.add (local.get $i) (i32.const 1))))
              (local.set $i (i32.add (local.get $i) (i32.const 1)))
              (br $strip_loop)))
          (local.set $poly (local.get $stripped))
          (local.set $degree (i32.sub (local.get $degree) (i32.const 1)))))
      (if (i32.eq (local.get $degree) (i32.const 1))
        (then
          ;; Non-canonically-typed rational value: take its rational
          ;; form and continue on the rational path.
          (if (call $expression_walk_guard (i32.mul (i32.const 3)
                (call $estimate_bigint_size (i32.add
                  (i32.add
                    (call $bigint_length (call $algebraic_poly_coefficient (local.get $poly) (i32.const 0)))
                    (call $bigint_length (call $algebraic_poly_coefficient (local.get $poly) (i32.const 1))))
                  (i32.const 2)))))
            (then (return (i32.const 1))))
          (local.set $rational_header (call $rational_new
            (call $algebraic_bigint_negate
              (call $algebraic_poly_coefficient (local.get $poly) (i32.const 0)))
            (call $algebraic_poly_coefficient (local.get $poly) (i32.const 1))))
          (br $have_rational)))
      ;; Spread p(x) to p(x^n).
      (local.set $spread_degree64 (i64.mul
        (i64.extend_i32_s (local.get $degree)) (i64.extend_i32_s (local.get $n))))
      (if (i64.gt_s (local.get $spread_degree64) (i64.const 1000000))
        (then (return (call $algebraic_evaluation_failure
          (local.get $quiet) (i32.const 1) (global.get $BUILTIN_MSG_ALGEBRAIC_DEGREE)))))
      (local.set $spread_degree (i32.wrap_i64 (local.get $spread_degree64)))
      (local.set $spread (call $algebraic_poly_carve (local.get $spread_degree)))
      (if (i32.eqz (local.get $spread)) (then (return (i32.const 1))))
      (if (call $expression_walk_guard (i32.const 32))
        (then (return (i32.const 1))))
      (local.set $zero_bigint (call $bigint_zero))
      (local.set $i (i32.const 0))
      (block $spread_fill_done
        (loop $spread_fill
          (br_if $spread_fill_done (i32.gt_s (local.get $i) (local.get $spread_degree)))
          (call $algebraic_poly_set_coefficient (local.get $spread) (local.get $i)
            (local.get $zero_bigint))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $spread_fill)))
      (local.set $i (i32.const 0))
      (block $spread_set_done
        (loop $spread_set
          (br_if $spread_set_done (i32.gt_s (local.get $i) (local.get $degree)))
          (call $algebraic_poly_set_coefficient (local.get $spread)
            (i32.mul (local.get $i) (local.get $n))
            (call $algebraic_poly_coefficient (local.get $poly) (local.get $i)))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $spread_set)))
      ;; p primitive/positive with nonzero constant term ⇒ p(x^n) is
      ;; already primitive, positive-leading, and squarefree.
      (if (call $expression_walk_guard (i32.add
            (i32.mul (local.get $spread_degree) (i32.const 20)) (i32.const 64)))
        (then (return (i32.const 1))))
      (local.set $output (call $carve_scratch_blob
        (i32.mul (local.get $spread_degree) (i32.const 20))))
      (if (call $algebraic_isolate (local.get $spread) (local.get $output))
        (then (return (i32.const 1))))
      (local.set $count (global.get $algebraic_isolate_count))
      (local.set $n_bigint (call $bigint_from_i64 (i64.extend_i32_s (local.get $n))))
      ;; Select the candidate whose n-th power straddles the radicand.
      (block $selected
        (loop $select
          (local.set $interval_data (i32.add
            (i32.load (call $abs (i32.add
              (call $algebraic_interval_of (local.get $header)) (i32.const 16))))
            (global.get $GC_HEADER_SIZE)))
          (if (call $expression_walk_guard (i32.const 512))
            (then (return (i32.const 1))))
          (local.set $v_low (call $rational_materialize (local.get $interval_data)))
          (local.set $v_high (call $rational_materialize
            (i32.add (local.get $interval_data) (global.get $VALUE_SIZE))))
          (local.set $matches (i32.const 0))
          (local.set $i (i32.const 0))
          (block $count_done
            (loop $count_loop
              (br_if $count_done (i32.ge_s (local.get $i) (local.get $count)))
              (local.set $entry (i32.add (local.get $output)
                (i32.mul (local.get $i) (i32.const 20))))
              (local.set $kind (i32.load (call $abs (local.get $entry))))
              (block $skip
                ;; Even n: only nonnegative candidates can be the
                ;; principal root.
                (local.set $bound_low (call $algebraic_entry_bound_rational
                  (local.get $entry) (i32.const 0)))
                (if (i32.eqz (local.get $bound_low)) (then (return (i32.const 1))))
                (local.set $bound_high (call $algebraic_entry_bound_rational
                  (local.get $entry) (i32.const 1)))
                (if (i32.eqz (local.get $bound_high)) (then (return (i32.const 1))))
                (if (i32.eqz (i32.and (local.get $n) (i32.const 1)))
                  (then
                    (if (i32.le_s (call $rational_header_pair_compare
                          (local.get $bound_high) (local.get $zero_rational)) (i32.const 0))
                      (then (br $skip)))))
                ;; Candidate power bounds.
                (local.set $limbs64 (i64.mul
                  (i64.extend_i32_u (i32.add
                    (call $estimate_rational_value_limbs_header (local.get $bound_low))
                    (call $estimate_rational_value_limbs_header (local.get $bound_high))))
                  (i64.extend_i32_u (local.get $n))))
                (if (i64.gt_u (local.get $limbs64) (i64.const 0xFFFFFF))
                  (then (local.set $limbs64 (i64.const 0xFFFFFF))))
                (if (call $expression_walk_guard (call $sat_budget_mul (i32.const 16)
                      (call $estimate_bigint_size
                        (i32.add (i32.wrap_i64 (local.get $limbs64)) (i32.const 2)))))
                  (then (return (i32.const 1))))
                (local.set $power_low (call $rational_pow (local.get $bound_low) (local.get $n_bigint)))
                (local.set $power_high (call $rational_pow (local.get $bound_high) (local.get $n_bigint)))
                (if (i32.and (local.get $n) (i32.const 1))
                  (then
                    ;; Odd powers are monotone.
                    )
                  (else
                    ;; Even powers: order the bounds; a zero-straddling
                    ;; candidate's power reaches down to zero.
                    (local.set $straddles (i32.and
                      (i32.lt_s (call $rational_header_pair_compare
                        (local.get $bound_low) (local.get $zero_rational)) (i32.const 0))
                      (i32.gt_s (call $rational_header_pair_compare
                        (local.get $bound_high) (local.get $zero_rational)) (i32.const 0))))
                    (if (i32.gt_s (call $rational_header_pair_compare
                          (local.get $power_low) (local.get $power_high)) (i32.const 0))
                      (then
                        (local.set $swap (local.get $power_low))
                        (local.set $power_low (local.get $power_high))
                        (local.set $power_high (local.get $swap))))
                    (if (local.get $straddles)
                      (then (local.set $power_low (local.get $zero_rational))))))
                ;; Overlap against the radicand's interval.
                (if (i32.and
                      (i32.le_s (call $rational_header_pair_compare
                        (local.get $power_low) (local.get $v_high)) (i32.const 0))
                      (i32.ge_s (call $rational_header_pair_compare
                        (local.get $power_high) (local.get $v_low)) (i32.const 0)))
                  (then
                    (local.set $matches (i32.add (local.get $matches) (i32.const 1)))
                    (local.set $chosen (local.get $entry)))))
              (local.set $i (i32.add (local.get $i) (i32.const 1)))
              (br $count_loop)))
          (if (i32.eqz (local.get $matches)) (then (unreachable)))
          (br_if $selected (i32.eq (local.get $matches) (i32.const 1)))
          (if (call $algebraic_refine_step (local.get $header))
            (then (return (i32.const 1))))
          (local.set $i (i32.const 0))
          (block $bisect_done
            (loop $bisect
              (br_if $bisect_done (i32.ge_s (local.get $i) (local.get $count)))
              (if (call $algebraic_entry_bisect (local.get $spread)
                    (i32.add (local.get $output) (i32.mul (local.get $i) (i32.const 20))))
                (then (return (i32.const 1))))
              (local.set $i (i32.add (local.get $i) (i32.const 1)))
              (br $bisect)))
          (br $select)))
      (if (call $algebraic_mint_entry
            (local.get $spread) (local.get $chosen) (i32.const 0) (local.get $out_slot))
        (then (return (i32.const 1))))
      (return (i32.const 0)))
    ;; Rational radicand u/v: roots of v·x^n − u.
    (local.set $u (call $rational_numerator (local.get $rational_header)))
    (local.set $v (call $rational_denominator (local.get $rational_header)))
    (if (i32.eqz (call $bigint_length (local.get $u)))
      (then
        (call $write_inline_rational (local.get $out_slot) (i64.const 0))
        (return (i32.const 0))))
    (if (i32.and
          (i32.ne (call $bigint_sign (local.get $u)) (i32.const 0))
          (i32.eqz (i32.and (local.get $n) (i32.const 1))))
      (then (return (call $algebraic_evaluation_failure
        (local.get $quiet) (i32.const 1) (global.get $BUILTIN_MSG_ALGEBRAIC_ROOT_DOMAIN)))))
    (local.set $poly (call $algebraic_poly_carve (local.get $n)))
    (if (i32.eqz (local.get $poly)) (then (return (i32.const 1))))
    (if (call $expression_walk_guard (i32.add (i32.const 64)
          (call $estimate_bigint_size (i32.add (call $bigint_length (local.get $u)) (i32.const 1)))))
      (then (return (i32.const 1))))
    (local.set $zero_bigint (call $bigint_zero))
    (local.set $i (i32.const 1))
    (block $mid_done
      (loop $mid_fill
        (br_if $mid_done (i32.ge_s (local.get $i) (local.get $n)))
        (call $algebraic_poly_set_coefficient (local.get $poly) (local.get $i) (local.get $zero_bigint))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $mid_fill)))
    (call $algebraic_poly_set_coefficient (local.get $poly) (local.get $n) (local.get $v))
    (call $algebraic_poly_set_coefficient (local.get $poly) (i32.const 0)
      (call $algebraic_bigint_negate (local.get $u)))
    ;; u/v is reduced, so the polynomial is primitive; v > 0 keeps the
    ;; leading coefficient positive; u ≠ 0 makes it squarefree.
    (if (call $expression_walk_guard (i32.add
          (i32.mul (local.get $n) (i32.const 20)) (i32.const 64)))
      (then (return (i32.const 1))))
    (local.set $output (call $carve_scratch_blob (i32.mul (local.get $n) (i32.const 20))))
    (if (call $algebraic_isolate (local.get $poly) (local.get $output))
      (then (return (i32.const 1))))
    (local.set $count (global.get $algebraic_isolate_count))
    ;; Odd n: the single real root. Even n: the entries are −r, +r in
    ;; ascending order — take the last (the principal root).
    (local.set $entry (i32.add (local.get $output)
      (i32.mul (i32.sub (local.get $count) (i32.const 1)) (i32.const 20))))
    (if (i32.and (local.get $n) (i32.const 1))
      (then (local.set $entry (local.get $output))))
    (if (call $algebraic_mint_entry
          (local.get $poly) (local.get $entry) (i32.const 0) (local.get $out_slot))
      (then (return (i32.const 1))))
    (i32.const 0)
  )

  ;; cosineOfTurns(rational) / sineOfTurns(rational) — exact cosine
  ;; and sine of a rational number of full turns; no transcendental
  ;; evaluation anywhere. Reduction: sin(r) = cos(r − 1/4); r reduces
  ;; to k/q with 0 ≤ k ≤ ⌊q/2⌋ by periodicity and evenness. The five
  ;; Niven denominators (1, 2, 3, 4, 6) return pure Rationals; all
  ;; others isolate the squarefree part of T_q(x) − 1 (Chebyshev first
  ;; kind, integer recurrence T_{n+1} = 2x·T_n − T_{n−1}), whose roots
  ;; in ascending order are cos(2πk/q) for k = ⌊q/2⌋ … 0 — selection
  ;; is exact by index.
  (func $algebraic_turns_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $arg1_type i32)
    (local $turns i32)
    (local $quarter i32)
    (local $numerator i32)
    (local $denominator i32)
    (local $k i32)
    (local $q64 i64)
    (local $q i32)
    (local $k64 i64)
    (local $k_int i32)
    (local $previous i32)
    (local $current i32)
    (local $next i32)
    (local $two_x i32)
    (local $n i32)
    (local $poly i32)
    (local $output i32)
    (local $count i32)
    (local $out_slot i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $arg1_type (call $value_type (local.get $argument1_pointer)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (i32.eqz (i32.or
          (i32.eq (local.get $arg1_type) (global.get $TYPE_RATIONAL))
          (i32.eq (local.get $arg1_type) (global.get $TYPE_BIGINT))))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_ALGEBRAIC_TURNS))))))
    (if (call $expression_walk_guard (i32.const 256))
      (then (return (i32.const 0))))
    (if (i32.eq (local.get $arg1_type) (global.get $TYPE_BIGINT))
      (then (local.set $turns (call $rational_from_bigint
        (call $value_data_lo (local.get $argument1_pointer)))))
      (else (local.set $turns (call $rational_materialize (local.get $argument1_pointer)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_EXACT_ALGEBRAIC_SINE_OF_TURNS))
      (then
        ;; sin(r) = cos(r − 1/4).
        (local.set $quarter (call $rational_new
          (call $bigint_one)
          (call $bigint_from_i64 (i64.const 4))))
        (if (call $algebraic_rational_guard (local.get $turns) (local.get $quarter))
          (then (return (i32.const 0))))
        (local.set $turns (call $rational_sub (local.get $turns) (local.get $quarter)))))
    (local.set $numerator (call $rational_numerator (local.get $turns)))
    (local.set $denominator (call $rational_denominator (local.get $turns)))
    (if (i32.eqz (call $bigint_to_i64_fits (local.get $denominator)))
      (then (return (i32.add (i32.const 1)
        (call $throw_range_error_with_message (global.get $BUILTIN_MSG_ALGEBRAIC_DEGREE))))))
    (local.set $q64 (global.get $bigint_to_i64_value))
    (if (i64.gt_s (local.get $q64) (i64.const 100000))
      (then (return (i32.add (i32.const 1)
        (call $throw_range_error_with_message (global.get $BUILTIN_MSG_ALGEBRAIC_DEGREE))))))
    (local.set $q (i32.wrap_i64 (local.get $q64)))
    ;; k = numerator mod q, folded to 0 … ⌊q/2⌋.
    (if (call $expression_walk_guard (i32.mul (i32.const 4)
          (call $estimate_bigint_size (i32.add
            (call $bigint_length (local.get $numerator)) (i32.const 2)))))
      (then (return (i32.const 0))))
    (drop (call $bigint_div (local.get $numerator) (local.get $denominator)))
    (local.set $k (call $bigint_last_remainder))
    (if (i32.eqz (call $bigint_to_i64_fits (local.get $k)))
      (then (unreachable)))
    (local.set $k64 (global.get $bigint_to_i64_value))
    (if (i64.lt_s (local.get $k64) (i64.const 0))
      (then (local.set $k64 (i64.add (local.get $k64) (local.get $q64)))))
    (if (i64.gt_s (i64.mul (local.get $k64) (i64.const 2)) (local.get $q64))
      (then (local.set $k64 (i64.sub (local.get $q64) (local.get $k64)))))
    (local.set $k_int (i32.wrap_i64 (local.get $k64)))
    ;; Niven denominators: the rational cosines.
    (if (i32.eqz (local.get $k_int))
      (then
        (call $push_rational_inline (i64.const 1))
        (return (i32.const 0))))
    (if (i32.eq (local.get $q) (i32.const 2))
      (then
        ;; k = 1: cos(π) = −1.
        (call $push_rational_inline (i64.const -1))
        (return (i32.const 0))))
    (if (i32.eq (local.get $q) (i32.const 3))
      (then
        ;; k = 1: cos(2π/3) = −1/2.
        (call $push_rational (call $rational_new
          (call $algebraic_bigint_negate (call $bigint_one))
          (call $bigint_from_i64 (i64.const 2))))
        (return (i32.const 0))))
    (if (i32.eq (local.get $q) (i32.const 4))
      (then
        ;; k = 1: 0; k = 2: −1.
        (if (i32.eq (local.get $k_int) (i32.const 1))
          (then (call $push_rational_inline (i64.const 0)))
          (else (call $push_rational_inline (i64.const -1))))
        (return (i32.const 0))))
    (if (i32.eq (local.get $q) (i32.const 6))
      (then
        ;; k = 1: 1/2; k = 2: −1/2; k = 3: −1.
        (if (i32.eq (local.get $k_int) (i32.const 3))
          (then
            (call $push_rational_inline (i64.const -1))
            (return (i32.const 0))))
        (call $push_rational (call $rational_new
          (select
            (call $bigint_one)
            (call $algebraic_bigint_negate (call $bigint_one))
            (i32.eq (local.get $k_int) (i32.const 1)))
          (call $bigint_from_i64 (i64.const 2))))
        (return (i32.const 0))))
    ;; General case: T_q − 1 by the integer recurrence.
    (local.set $previous (call $algebraic_poly_carve (i32.const 0)))
    (if (i32.eqz (local.get $previous)) (then (return (i32.const 0))))
    (if (call $expression_walk_guard (i32.const 96))
      (then (return (i32.const 0))))
    (call $algebraic_poly_set_coefficient (local.get $previous) (i32.const 0) (call $bigint_one))
    (local.set $current (call $algebraic_poly_carve (i32.const 1)))
    (if (i32.eqz (local.get $current)) (then (return (i32.const 0))))
    (call $algebraic_poly_set_coefficient (local.get $current) (i32.const 0) (call $bigint_zero))
    (call $algebraic_poly_set_coefficient (local.get $current) (i32.const 1) (call $bigint_one))
    (local.set $two_x (call $algebraic_poly_carve (i32.const 1)))
    (if (i32.eqz (local.get $two_x)) (then (return (i32.const 0))))
    (call $algebraic_poly_set_coefficient (local.get $two_x) (i32.const 0) (call $bigint_zero))
    (call $algebraic_poly_set_coefficient (local.get $two_x) (i32.const 1)
      (call $bigint_from_i64 (i64.const 2)))
    (local.set $n (i32.const 1))
    (block $recurrence_done
      (loop $recurrence
        (br_if $recurrence_done (i32.ge_s (local.get $n) (local.get $q)))
        (local.set $next (call $algebraic_poly_mul (local.get $two_x) (local.get $current)))
        (if (i32.eqz (local.get $next)) (then (return (i32.const 0))))
        (local.set $next (call $algebraic_poly_sub_poly (local.get $next) (local.get $previous)))
        (if (i32.eqz (local.get $next)) (then (return (i32.const 0))))
        (local.set $previous (local.get $current))
        (local.set $current (local.get $next))
        (local.set $n (i32.add (local.get $n) (i32.const 1)))
        (br $recurrence)))
    ;; T_q − 1.
    (if (call $expression_walk_guard (i32.const 64))
      (then (return (i32.const 0))))
    (call $algebraic_poly_set_coefficient (local.get $current) (i32.const 0)
      (call $bigint_sub
        (call $algebraic_poly_coefficient (local.get $current) (i32.const 0))
        (call $bigint_one)))
    (local.set $poly (call $algebraic_poly_normalize_squarefree (local.get $current)))
    (if (i32.eqz (local.get $poly)) (then (return (i32.const 0))))
    (if (call $expression_walk_guard (i32.add
          (i32.mul (call $algebraic_poly_degree (local.get $poly)) (i32.const 20))
          (i32.add (global.get $VALUE_SIZE) (i32.const 64))))
      (then (return (i32.const 0))))
    (local.set $output (call $carve_scratch_blob
      (i32.mul (call $algebraic_poly_degree (local.get $poly)) (i32.const 20))))
    (if (call $algebraic_isolate (local.get $poly) (local.get $output))
      (then (return (i32.const 0))))
    (local.set $count (global.get $algebraic_isolate_count))
    ;; count = ⌊q/2⌋ + 1 distinct cosines, ascending; index from the top.
    (if (i32.ne (local.get $count) (i32.add (i32.div_s (local.get $q) (i32.const 2)) (i32.const 1)))
      (then (unreachable)))
    (local.set $out_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (if (call $algebraic_mint_entry (local.get $poly)
          (i32.add (local.get $output)
            (i32.mul (i32.sub (i32.sub (local.get $count) (i32.const 1)) (local.get $k_int))
              (i32.const 20)))
          (i32.const 0)
          (local.get $out_slot))
      (then (return (i32.const 0))))
    (if (i32.and
          (i32.eq (call $value_type (local.get $out_slot)) (global.get $TYPE_RATIONAL))
          (i32.eqz (call $rational_is_inline (local.get $out_slot))))
      (then
        (call $push_rational (call $value_data_lo (local.get $out_slot)))
        (return (i32.const 0))))
    (call $pending_push
      (call $value_type (local.get $out_slot))
      (call $value_flags (local.get $out_slot))
      (call $value_data_lo (local.get $out_slot))
      (call $value_data_hi (local.get $out_slot)))
    (i32.const 0)
  )

  ;; Limb estimate for a rational HEADER (the slot-based
  ;; $estimate_rational_value_limbs needs a value slot).
  (func $estimate_rational_value_limbs_header (param $header i32) (result i32)
    (local $numerator_limbs i32)
    (local $denominator_limbs i32)
    (local.set $numerator_limbs (call $bigint_length (call $rational_numerator (local.get $header))))
    (local.set $denominator_limbs (call $bigint_length (call $rational_denominator (local.get $header))))
    (select (local.get $numerator_limbs) (local.get $denominator_limbs)
      (i32.gt_u (local.get $numerator_limbs) (local.get $denominator_limbs)))
  )

  ;; squareRoot(value) / nthRoot(value, n) — the explicit named roots.
  (func $algebraic_root_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $argument2_pointer i32)
    (local $arg1_type i32)
    (local $arg2_type i32)
    (local $n64 i64)
    (local $n_valid i32)
    (local $out_slot i32)
    (local $status i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $arg1_type (call $value_type (local.get $argument1_pointer)))))
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then
        (local.set $argument2_pointer (i32.add (local.get $argument1_pointer) (global.get $VALUE_SIZE)))
        (local.set $arg2_type (call $value_type (local.get $argument2_pointer)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (i32.eqz (i32.or
          (i32.or
            (i32.eq (local.get $arg1_type) (global.get $TYPE_ALGEBRAIC))
            (i32.eq (local.get $arg1_type) (global.get $TYPE_RATIONAL)))
          (i32.eq (local.get $arg1_type) (global.get $TYPE_BIGINT))))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_ALGEBRAIC_ARGUMENT))))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_EXACT_ALGEBRAIC_SQUARE_ROOT))
      (then
        (local.set $n64 (i64.const 2))
        (local.set $n_valid (i32.const 1)))
      (else
        (if (i32.eq (local.get $arg2_type) (global.get $TYPE_RATIONAL))
          (then
            (if (call $rational_is_inline (local.get $argument2_pointer))
              (then
                (local.set $n64 (call $rational_read_inline (local.get $argument2_pointer)))
                (local.set $n_valid (i32.const 1)))
              (else
                (if (call $rational_denominator_is_one
                      (call $value_data_lo (local.get $argument2_pointer)))
                  (then
                    (if (call $bigint_to_i64_fits (call $rational_numerator
                          (call $value_data_lo (local.get $argument2_pointer))))
                      (then
                        (local.set $n64 (global.get $bigint_to_i64_value))
                        (local.set $n_valid (i32.const 1)))))))))
          (else
            (if (i32.eq (local.get $arg2_type) (global.get $TYPE_BIGINT))
              (then
                (if (call $bigint_to_i64_fits (call $value_data_lo (local.get $argument2_pointer)))
                  (then
                    (local.set $n64 (global.get $bigint_to_i64_value))
                    (local.set $n_valid (i32.const 1))))))))))
    (if (i32.eqz (local.get $n_valid))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_ALGEBRAIC_ROOT_INDEX))))))
    (if (i32.or
          (i64.lt_s (local.get $n64) (i64.const 1))
          (i64.gt_s (local.get $n64) (i64.const 1000000)))
      (then (return (i32.add (i32.const 1)
        (call $throw_range_error_with_message (global.get $BUILTIN_MSG_ALGEBRAIC_ROOT_INDEX))))))
    (if (i64.eq (local.get $n64) (i64.const 1))
      (then
        (call $pending_push
          (call $value_type (local.get $argument1_pointer))
          (call $value_flags (local.get $argument1_pointer))
          (call $value_data_lo (local.get $argument1_pointer))
          (call $value_data_hi (local.get $argument1_pointer)))
        (return (i32.const 0))))
    (if (call $expression_walk_guard (i32.add (global.get $VALUE_SIZE) (i32.const 32)))
      (then (return (i32.const 0))))
    (local.set $out_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (local.set $status (call $algebraic_nth_root_core
      (local.get $argument1_pointer) (i32.wrap_i64 (local.get $n64))
      (local.get $out_slot) (i32.const 0)))
    (if (i32.eq (local.get $status) (i32.const 1)) (then (return (i32.const 0))))
    (if (i32.eq (local.get $status) (i32.const 2)) (then (return (i32.const 1))))
    (if (i32.eq (local.get $status) (i32.const 3)) (then (return (i32.const 2))))
    (call $pending_push
      (call $value_type (local.get $out_slot))
      (call $value_flags (local.get $out_slot))
      (call $value_data_lo (local.get $out_slot))
      (call $value_data_hi (local.get $out_slot)))
    (i32.const 0)
  )

  ;; Is a value slot an exact zero (Rational/BigInt zero, or an
  ;; AlgebraicNumber whose value is zero)? 0 no / 1 yes / 2 pressure.
  (func $algebraic_slot_is_exact_zero (param $slot i32) (result i32)
    (local $slot_type i32)
    (local.set $slot_type (call $value_type (local.get $slot)))
    (if (i32.eq (local.get $slot_type) (global.get $TYPE_BIGINT))
      (then (return (i32.eqz (call $bigint_length (call $value_data_lo (local.get $slot)))))))
    (if (i32.eq (local.get $slot_type) (global.get $TYPE_RATIONAL))
      (then
        (if (call $rational_is_inline (local.get $slot))
          (then (return (i64.eqz (call $rational_read_inline (local.get $slot)))))
          (else (return (i32.eqz (call $bigint_length
            (call $rational_numerator (call $value_data_lo (local.get $slot))))))))))
    (if (i32.eq (local.get $slot_type) (global.get $TYPE_ALGEBRAIC))
      (then (return (call $algebraic_value_is_zero (call $value_data_lo (local.get $slot))))))
    (i32.const 0)
  )

  ;; Recursive exact evaluator over simplified numeric-radical trees:
  ;; numeric leaves, Add / Subtract / Multiply / Divide / Negate, and
  ;; Power with a rational exponent. Anything else is the fromExpression
  ;; TypeError in public mode and status 2 in quiet speculative mode.
  (func $algebraic_evaluate_node
    (param $slot i32) (param $out_slot i32) (param $quiet i32) (result i32)
    (local $slot_type i32)
    (local $header i32)
    (local $head i32)
    (local $args_array i32)
    (local $argument_count i32)
    (local $arguments_data i32)
    (local $kind i32)
    (local $is_fold i32)
    (local $accumulator_slot i32)
    (local $operand_slot i32)
    (local $result_slot i32)
    (local $swap_slot i32)
    (local $status i32)
    (local $i i32)
    (local $exponent_slot i32)
    (local $exponent_type i32)
    (local $p64 i64)
    (local $q64 i64)
    (local $exponent_valid i32)
    (local $exponent_header i32)
    (local $one_slot i32)
    (local.set $slot_type (call $value_type (local.get $slot)))
    (if (i32.or
          (i32.eq (local.get $slot_type) (global.get $TYPE_RATIONAL))
          (i32.or
            (i32.eq (local.get $slot_type) (global.get $TYPE_BIGINT))
            (i32.eq (local.get $slot_type) (global.get $TYPE_ALGEBRAIC))))
      (then
        (call $write_value (local.get $out_slot)
          (local.get $slot_type)
          (call $value_flags (local.get $slot))
          (call $value_data_lo (local.get $slot))
          (call $value_data_hi (local.get $slot)))
        (return (i32.const 0))))
    (if (i32.ne (local.get $slot_type) (global.get $TYPE_EXPRESSION))
      (then (return (call $algebraic_evaluation_failure
        (local.get $quiet) (i32.const 0) (global.get $BUILTIN_MSG_ALGEBRAIC_FROM_EXPRESSION)))))
    (local.set $header (call $value_data_lo (local.get $slot)))
    (local.set $head (call $expression_head (local.get $header)))
    (local.set $args_array (call $expression_args (local.get $header)))
    (local.set $argument_count (i32.load (call $abs (i32.add (local.get $args_array) (i32.const 8)))))
    (local.set $arguments_data (i32.add
      (i32.load (call $abs (i32.add (local.get $args_array) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (if (i32.eqz (local.get $argument_count))
      (then (return (call $algebraic_evaluation_failure
        (local.get $quiet) (i32.const 0) (global.get $BUILTIN_MSG_ALGEBRAIC_FROM_EXPRESSION)))))
    (if (call $expression_walk_guard (i32.add
          (i32.mul (i32.const 3) (global.get $VALUE_SIZE)) (i32.const 32)))
      (then (return (i32.const 1))))
    (local.set $accumulator_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (local.set $operand_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (local.set $result_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    ;; Power(base, rationalExponent).
    (if (i32.eq (local.get $head) (call $symbol_registry_lookup
          (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_POWER))))
      (then
        (if (i32.ne (local.get $argument_count) (i32.const 2))
          (then (return (call $algebraic_evaluation_failure
            (local.get $quiet) (i32.const 0) (global.get $BUILTIN_MSG_ALGEBRAIC_FROM_EXPRESSION)))))
        (local.set $exponent_slot (i32.add (local.get $arguments_data) (global.get $VALUE_SIZE)))
        (local.set $exponent_type (call $value_type (local.get $exponent_slot)))
        (if (i32.eq (local.get $exponent_type) (global.get $TYPE_RATIONAL))
          (then
            (if (call $rational_is_inline (local.get $exponent_slot))
              (then
                (local.set $p64 (call $rational_read_inline (local.get $exponent_slot)))
                (local.set $q64 (i64.const 1))
                (local.set $exponent_valid (i32.const 1)))
              (else
                (local.set $exponent_header (call $value_data_lo (local.get $exponent_slot)))
                (if (call $bigint_to_i64_fits (call $rational_numerator (local.get $exponent_header)))
                  (then
                    (local.set $p64 (global.get $bigint_to_i64_value))
                    (if (call $bigint_to_i64_fits (call $rational_denominator (local.get $exponent_header)))
                      (then
                        (local.set $q64 (global.get $bigint_to_i64_value))
                        (local.set $exponent_valid (i32.const 1)))))))))
          (else
            (if (i32.eq (local.get $exponent_type) (global.get $TYPE_BIGINT))
              (then
                (if (call $bigint_to_i64_fits (call $value_data_lo (local.get $exponent_slot)))
                  (then
                    (local.set $p64 (global.get $bigint_to_i64_value))
                    (local.set $q64 (i64.const 1))
                    (local.set $exponent_valid (i32.const 1))))))))
        (if (i32.eqz (local.get $exponent_valid))
          (then (return (call $algebraic_evaluation_failure
            (local.get $quiet) (i32.const 0) (global.get $BUILTIN_MSG_ALGEBRAIC_FROM_EXPRESSION)))))
        (if (i32.or
              (i64.gt_s (local.get $p64) (i64.const 65535))
              (i32.or
                (i64.lt_s (local.get $p64) (i64.const -65535))
                (i64.gt_s (local.get $q64) (i64.const 1000000))))
          (then (return (call $algebraic_evaluation_failure
            (local.get $quiet) (i32.const 1) (global.get $BUILTIN_MSG_ALGEBRAIC_EXPONENT)))))
        (local.set $status (call $algebraic_evaluate_node
          (local.get $arguments_data) (local.get $accumulator_slot) (local.get $quiet)))
        (if (local.get $status) (then (return (local.get $status))))
        ;; Root first (q > 1), then the integer power.
        (if (i64.gt_s (local.get $q64) (i64.const 1))
          (then
            (local.set $status (call $algebraic_nth_root_core
              (local.get $accumulator_slot) (i32.wrap_i64 (local.get $q64))
              (local.get $operand_slot) (local.get $quiet)))
            (if (local.get $status) (then (return (local.get $status))))
            (local.set $swap_slot (local.get $accumulator_slot))
            (local.set $accumulator_slot (local.get $operand_slot))
            (local.set $operand_slot (local.get $swap_slot))))
        (if (i64.eqz (local.get $p64))
          (then
            (call $write_inline_rational (local.get $out_slot) (i64.const 1))
            (return (i32.const 0))))
        (if (i64.lt_s (local.get $p64) (i64.const 0))
          (then
            ;; t → 1/t, then the positive power. Zero base gets the
            ;; messaged fromExpression division RangeError.
            (local.set $status (call $algebraic_slot_is_exact_zero (local.get $accumulator_slot)))
            (if (i32.eq (local.get $status) (i32.const 2)) (then (return (i32.const 1))))
            (if (local.get $status)
              (then (return (call $algebraic_evaluation_failure
                (local.get $quiet) (i32.const 1)
                (global.get $BUILTIN_MSG_ALGEBRAIC_DIVIDE_BY_ZERO)))))
            (call $write_inline_rational (local.get $operand_slot) (i64.const 1))
            (local.set $status (call $algebraic_slot_arith (i32.const 3)
              (local.get $operand_slot) (local.get $accumulator_slot) (local.get $result_slot)))
            (if (local.get $status) (then (return (local.get $status))))
            (local.set $swap_slot (local.get $accumulator_slot))
            (local.set $accumulator_slot (local.get $result_slot))
            (local.set $result_slot (local.get $swap_slot))
            (local.set $p64 (i64.sub (i64.const 0) (local.get $p64)))))
        ;; accumulator^p by repeated multiplication.
        (call $write_value (local.get $operand_slot)
          (call $value_type (local.get $accumulator_slot))
          (call $value_flags (local.get $accumulator_slot))
          (call $value_data_lo (local.get $accumulator_slot))
          (call $value_data_hi (local.get $accumulator_slot)))
        (local.set $i (i32.const 1))
        (block $power_done
          (loop $power
            (br_if $power_done (i32.ge_s (local.get $i) (i32.wrap_i64 (local.get $p64))))
            (local.set $status (call $algebraic_slot_arith (i32.const 2)
              (local.get $accumulator_slot) (local.get $operand_slot) (local.get $result_slot)))
            (if (local.get $status) (then (return (local.get $status))))
            (local.set $swap_slot (local.get $accumulator_slot))
            (local.set $accumulator_slot (local.get $result_slot))
            (local.set $result_slot (local.get $swap_slot))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $power)))
        (call $write_value (local.get $out_slot)
          (call $value_type (local.get $accumulator_slot))
          (call $value_flags (local.get $accumulator_slot))
          (call $value_data_lo (local.get $accumulator_slot))
          (call $value_data_hi (local.get $accumulator_slot)))
        (return (i32.const 0))))
    ;; Negate(a) = 0 − a.
    (if (i32.eq (local.get $head) (call $symbol_registry_lookup
          (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_NEGATE))))
      (then
        (if (i32.ne (local.get $argument_count) (i32.const 1))
          (then (return (call $algebraic_evaluation_failure
            (local.get $quiet) (i32.const 0) (global.get $BUILTIN_MSG_ALGEBRAIC_FROM_EXPRESSION)))))
        (local.set $status (call $algebraic_evaluate_node
          (local.get $arguments_data) (local.get $accumulator_slot) (local.get $quiet)))
        (if (local.get $status) (then (return (local.get $status))))
        (call $write_inline_rational (local.get $operand_slot) (i64.const 0))
        (return (call $algebraic_slot_arith (i32.const 1)
          (local.get $operand_slot) (local.get $accumulator_slot) (local.get $out_slot)))))
    ;; Binary/n-ary arithmetic heads.
    (local.set $is_fold (i32.const 0))
    (if (i32.eq (local.get $head) (call $symbol_registry_lookup
          (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_ADD))))
      (then
        (local.set $kind (i32.const 0))
        (local.set $is_fold (i32.const 1))))
    (if (i32.eq (local.get $head) (call $symbol_registry_lookup
          (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY))))
      (then
        (local.set $kind (i32.const 2))
        (local.set $is_fold (i32.const 1))))
    (if (i32.eq (local.get $head) (call $symbol_registry_lookup
          (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_SUBTRACT))))
      (then
        (local.set $kind (i32.const 1))
        (local.set $is_fold (i32.const 2))))
    (if (i32.eq (local.get $head) (call $symbol_registry_lookup
          (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_DIVIDE))))
      (then
        (local.set $kind (i32.const 3))
        (local.set $is_fold (i32.const 2))))
    (if (i32.eqz (local.get $is_fold))
      (then (return (call $algebraic_evaluation_failure
        (local.get $quiet) (i32.const 0) (global.get $BUILTIN_MSG_ALGEBRAIC_FROM_EXPRESSION)))))
    (if (i32.and
          (i32.eq (local.get $is_fold) (i32.const 2))
          (i32.ne (local.get $argument_count) (i32.const 2)))
      (then (return (call $algebraic_evaluation_failure
        (local.get $quiet) (i32.const 0) (global.get $BUILTIN_MSG_ALGEBRAIC_FROM_EXPRESSION)))))
    (local.set $status (call $algebraic_evaluate_node
      (local.get $arguments_data) (local.get $accumulator_slot) (local.get $quiet)))
    (if (local.get $status) (then (return (local.get $status))))
    (local.set $i (i32.const 1))
    (block $fold_done
      (loop $fold
        (br_if $fold_done (i32.ge_s (local.get $i) (local.get $argument_count)))
        (local.set $status (call $algebraic_evaluate_node
          (i32.add (local.get $arguments_data) (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
          (local.get $operand_slot) (local.get $quiet)))
        (if (local.get $status) (then (return (local.get $status))))
        (if (i32.eq (local.get $kind) (i32.const 3))
          (then
            ;; Zero divisors get the messaged fromExpression
            ;; RangeError, not the generic operator one.
            (local.set $status (call $algebraic_slot_is_exact_zero (local.get $operand_slot)))
            (if (i32.eq (local.get $status) (i32.const 2)) (then (return (i32.const 1))))
            (if (local.get $status)
              (then (return (call $algebraic_evaluation_failure
                (local.get $quiet) (i32.const 1)
                (global.get $BUILTIN_MSG_ALGEBRAIC_DIVIDE_BY_ZERO)))))))
        (local.set $status (call $algebraic_slot_arith (local.get $kind)
          (local.get $accumulator_slot) (local.get $operand_slot) (local.get $result_slot)))
        (if (local.get $status) (then (return (local.get $status))))
        (local.set $swap_slot (local.get $accumulator_slot))
        (local.set $accumulator_slot (local.get $result_slot))
        (local.set $result_slot (local.get $swap_slot))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $fold)))
    (call $write_value (local.get $out_slot)
      (call $value_type (local.get $accumulator_slot))
      (call $value_flags (local.get $accumulator_slot))
      (call $value_data_lo (local.get $accumulator_slot))
      (call $value_data_hi (local.get $accumulator_slot)))
    (i32.const 0)
  )

  ;; ----- 6c: expression-level elimination -----------------------------------

  ;; First Symbol found in a tree (arg slots, recursively), excluding
  ;; one symbol pointer. 0 when none.
  (func $expression_find_first_symbol (param $slot i32) (param $exclude i32) (result i32)
    (local $slot_type i32)
    (local $header i32)
    (local $args_array i32)
    (local $length i32)
    (local $data i32)
    (local $i i32)
    (local $found i32)
    (local.set $slot_type (call $value_type (local.get $slot)))
    (if (i32.eq (local.get $slot_type) (global.get $TYPE_SYMBOL))
      (then
        (if (i32.eq (call $value_data_lo (local.get $slot)) (local.get $exclude))
          (then (return (i32.const 0))))
        (return (call $value_data_lo (local.get $slot)))))
    (if (i32.ne (local.get $slot_type) (global.get $TYPE_EXPRESSION))
      (then (return (i32.const 0))))
    (local.set $header (call $value_data_lo (local.get $slot)))
    (local.set $args_array (call $expression_args (local.get $header)))
    (local.set $length (i32.load (call $abs (i32.add (local.get $args_array) (i32.const 8)))))
    (local.set $data (i32.add
      (i32.load (call $abs (i32.add (local.get $args_array) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (local.set $i (i32.const 0))
    (block $done
      (loop $walk
        (br_if $done (i32.ge_u (local.get $i) (local.get $length)))
        (local.set $found (call $expression_find_first_symbol
          (i32.add (local.get $data) (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
          (local.get $exclude)))
        (if (local.get $found) (then (return (local.get $found))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $walk)))
    (i32.const 0)
  )

  ;; Collect every distinct AlgebraicNumber leaf in an expression tree.
  ;; The caller owns a $ALGEBRAIC_MAX_VARIABLES-entry registry and count cell.
  ;; Returns 0 / 1 pressure / 4 capacity exceeded.
  (func $expression_collect_algebraic_registry
    (param $slot i32) (param $registry i32) (param $count_cell i32) (result i32)
    (local $slot_type i32) (local $header i32) (local $args_array i32)
    (local $length i32) (local $data i32) (local $i i32)
    (local $count i32) (local $index i32) (local $status i32)
    (local.set $slot_type (call $value_type (local.get $slot)))
    (if (i32.eq (local.get $slot_type) (global.get $TYPE_ALGEBRAIC))
      (then
        (local.set $count (i32.load (call $abs (local.get $count_cell))))
        (local.set $index (call $algebraic_registry_index_of
          (local.get $registry) (local.get $count) (call $value_data_lo (local.get $slot))))
        (if (i32.eq (local.get $index) (i32.const -1)) (then (return (i32.const 1))))
        (if (i32.eq (local.get $index) (i32.const -2))
          (then
            (if (i32.ge_s (local.get $count) (global.get $ALGEBRAIC_MAX_VARIABLES))
              (then (return (i32.const 4))))
            (i32.store (call $abs (i32.add (local.get $registry)
              (i32.mul (local.get $count) (i32.const 4)))) (call $value_data_lo (local.get $slot)))
            (i32.store (call $abs (local.get $count_cell))
              (i32.add (local.get $count) (i32.const 1)))))
        (return (i32.const 0))))
    (if (i32.ne (local.get $slot_type) (global.get $TYPE_EXPRESSION))
      (then (return (i32.const 0))))
    (local.set $header (call $value_data_lo (local.get $slot)))
    (local.set $args_array (call $expression_args (local.get $header)))
    (local.set $length (i32.load (call $abs (i32.add (local.get $args_array) (i32.const 8)))))
    (local.set $data (i32.add
      (i32.load (call $abs (i32.add (local.get $args_array) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (local.set $i (i32.const 0))
    (block $done
      (loop $walk
        (br_if $done (i32.ge_u (local.get $i) (local.get $length)))
        (local.set $status (call $expression_collect_algebraic_registry
          (i32.add (local.get $data) (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
          (local.get $registry) (local.get $count_cell)))
        (if (local.get $status) (then (return (local.get $status))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $walk)))
    (i32.const 0)
  )

  ;; Convert a bivariate expression in y and optional x to a depth-3
  ;; nested polynomial y -> x -> gamma over Q.
  (func $expression_to_field_ypoly
    (param $poly_slot i32) (param $y_slot i32) (param $x_slot i32)
    (param $stage i32) (param $stage_capacity i32) (param $residual i32)
    (param $registry i32) (param $registry_count i32)
    (param $representations i32) (param $modulus i32)
    (param $degree_out i32) (result i32)
    (local $degree64 i64) (local $degree i32) (local $list i32)
    (local $status i32) (local $i i32) (local $j i32)
    (local $coefficient_slot i32) (local $inner_degree64 i64)
    (local $inner_degree i32) (local $inner_list i32) (local $inner_slot i32)
    (local $ypoly i32) (local $xpoly i32) (local $field_coefficient i32)
    (local $field_out i32)
    (local.set $degree64 (call $poly_degree_in
      (local.get $poly_slot) (local.get $y_slot) (local.get $stage)
      (local.get $stage_capacity) (local.get $residual)))
    (if (i64.eq (local.get $degree64) (i64.const -1)) (then (return (i32.const 0))))
    (if (i64.lt_s (local.get $degree64) (i64.const 0)) (then (return (i32.const 1))))
    (if (i64.gt_s (local.get $degree64) (i64.const 100000)) (then (return (i32.const 1))))
    (local.set $degree (i32.wrap_i64 (local.get $degree64)))
    (i32.store (call $abs (local.get $degree_out)) (local.get $degree))
    (if (call $expression_walk_guard
          (i32.add
            (i32.mul (i32.add (local.get $degree) (i32.const 1)) (global.get $VALUE_SIZE))
            (i32.const 16)))
      (then (return (i32.const 0))))
    (local.set $list (call $carve_scratch_blob
      (i32.mul (i32.add (local.get $degree) (i32.const 1)) (global.get $VALUE_SIZE))))
    (local.set $status (call $poly_extract_coefficients
      (local.get $poly_slot) (local.get $y_slot) (local.get $degree)
      (local.get $list) (local.get $stage) (local.get $stage_capacity) (local.get $residual)))
    (if (i32.eq (local.get $status) (i32.const 1)) (then (return (i32.const 0))))
    (if (local.get $status) (then (return (i32.const 1))))
    (local.set $field_out (call $carve_scratch_blob (i32.const 4)))
    (local.set $ypoly (call $algebraic_poly_carve (local.get $degree)))
    (if (i32.eqz (local.get $ypoly)) (then (return (i32.const 0))))
    (local.set $i (i32.const 0))
    (block $outer_done
      (loop $outer
        (br_if $outer_done (i32.gt_s (local.get $i) (local.get $degree)))
        (local.set $coefficient_slot (i32.add (local.get $list)
          (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
        (if (i32.eqz (local.get $x_slot))
          (then
            (local.set $inner_degree (i32.const 0))
            (local.set $inner_list (local.get $coefficient_slot)))
          (else
            (local.set $inner_degree64 (call $poly_degree_in
              (local.get $coefficient_slot) (local.get $x_slot)
              (local.get $stage) (local.get $stage_capacity) (local.get $residual)))
            (if (i64.eq (local.get $inner_degree64) (i64.const -1)) (then (return (i32.const 0))))
            (if (i64.lt_s (local.get $inner_degree64) (i64.const 0)) (then (return (i32.const 1))))
            (local.set $inner_degree (i32.wrap_i64 (local.get $inner_degree64)))
            (if (call $expression_walk_guard
                  (i32.mul (i32.add (local.get $inner_degree) (i32.const 1)) (global.get $VALUE_SIZE)))
              (then (return (i32.const 0))))
            (local.set $inner_list (call $carve_scratch_blob
              (i32.mul (i32.add (local.get $inner_degree) (i32.const 1)) (global.get $VALUE_SIZE))))
            (local.set $status (call $poly_extract_coefficients
              (local.get $coefficient_slot) (local.get $x_slot) (local.get $inner_degree)
              (local.get $inner_list) (local.get $stage) (local.get $stage_capacity) (local.get $residual)))
            (if (i32.eq (local.get $status) (i32.const 1)) (then (return (i32.const 0))))
            (if (local.get $status) (then (return (i32.const 1))))))
        (local.set $xpoly (call $algebraic_poly_carve (local.get $inner_degree)))
        (if (i32.eqz (local.get $xpoly)) (then (return (i32.const 0))))
        (local.set $j (i32.const 0))
        (block $inner_done
          (loop $inner
            (br_if $inner_done (i32.gt_s (local.get $j) (local.get $inner_degree)))
            (local.set $inner_slot (i32.add (local.get $inner_list)
              (i32.mul (local.get $j) (global.get $VALUE_SIZE))))
            (local.set $status (call $algebraic_apoly_of_coefficient_slot
              (local.get $inner_slot) (local.get $registry) (local.get $registry_count)
              (local.get $representations) (local.get $modulus) (local.get $field_out)))
            (if (i32.eq (local.get $status) (i32.const 1)) (then (return (i32.const 0))))
            (if (local.get $status) (then (return (i32.const 1))))
            (local.set $field_coefficient (i32.load (call $abs (local.get $field_out))))
            (call $algebraic_poly_set_coefficient
              (local.get $xpoly) (local.get $j) (local.get $field_coefficient))
            (local.set $j (i32.add (local.get $j) (i32.const 1)))
            (br $inner)))
        (call $algebraic_npoly_trim (local.get $xpoly) (i32.const 2))
        (call $algebraic_poly_set_coefficient (local.get $ypoly) (local.get $i) (local.get $xpoly))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $outer)))
    (call $algebraic_npoly_trim (local.get $ypoly) (i32.const 3))
    (local.get $ypoly)
  )

  ;; Fold the LCM of every Rational leaf denominator in a depth-generic
  ;; nested polynomial. The count cell initially holds bigint one.
  (func $algebraic_rational_npoly_lcm
    (param $poly i32) (param $depth i32) (param $lcm_cell i32) (result i32)
    (local $i i32) (local $entry i32) (local $lcm i32)
    (local $denominator i32) (local $gcd i32) (local $status i32)
    (if (i32.eqz (local.get $depth))
      (then
        (local.set $lcm (i32.load (call $abs (local.get $lcm_cell))))
        (local.set $denominator (call $rational_denominator (local.get $poly)))
        (local.set $gcd (call $algebraic_bigint_gcd_guarded
          (local.get $lcm) (local.get $denominator)))
        (if (i32.eqz (local.get $gcd)) (then (return (i32.const 1))))
        (i32.store (call $abs (local.get $lcm_cell))
          (call $bigint_mul (call $bigint_div (local.get $lcm) (local.get $gcd))
            (local.get $denominator)))
        (return (i32.const 0))))
    (local.set $i (i32.const 0))
    (block $done
      (loop $walk
        (br_if $done (i32.gt_s (local.get $i) (call $algebraic_poly_degree (local.get $poly))))
        (local.set $entry (call $algebraic_poly_coefficient (local.get $poly) (local.get $i)))
        (local.set $status (call $algebraic_rational_npoly_lcm
          (local.get $entry) (i32.sub (local.get $depth) (i32.const 1)) (local.get $lcm_cell)))
        (if (local.get $status) (then (return (local.get $status))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $walk)))
    (i32.const 0)
  )

  ;; Clone a rational-leaf nested polynomial as an integer-leaf npoly,
  ;; multiplying every leaf by one common denominator.
  (func $algebraic_rational_npoly_clear
    (param $poly i32) (param $depth i32) (param $lcm i32) (result i32)
    (local $result i32) (local $i i32) (local $entry i32)
    (local $cleared i32)
    (if (i32.eqz (local.get $depth))
      (then
        (return (call $bigint_mul
          (call $rational_numerator (local.get $poly))
          (call $bigint_div (local.get $lcm)
            (call $rational_denominator (local.get $poly)))))))
    (local.set $result (call $algebraic_poly_carve
      (call $algebraic_poly_degree (local.get $poly))))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (local.set $i (i32.const 0))
    (block $done
      (loop $copy
        (br_if $done (i32.gt_s (local.get $i) (call $algebraic_poly_degree (local.get $poly))))
        (local.set $entry (call $algebraic_poly_coefficient (local.get $poly) (local.get $i)))
        (local.set $cleared (call $algebraic_rational_npoly_clear
          (local.get $entry) (i32.sub (local.get $depth) (i32.const 1)) (local.get $lcm)))
        (if (i32.eqz (local.get $cleared)) (then (return (i32.const 0))))
        (call $algebraic_poly_set_coefficient (local.get $result) (local.get $i) (local.get $cleared))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $copy)))
    (call $algebraic_npoly_trim (local.get $result) (local.get $depth))
    (local.get $result)
  )

  ;; Algebraic-coefficient branch for Exact.Expression.resultant.
  ;; Returns 0 on completion/pressure, 1 for a rejected coefficient shape.
  (func $expression_resultant_over_algebraic_field
    (param $a_slot i32) (param $b_slot i32) (param $y_slot i32)
    (param $x_slot i32) (param $stage i32) (param $stage_capacity i32)
    (param $residual i32) (param $registry i32) (param $registry_count i32)
    (result i32)
    (local $generator_out i32) (local $representations i32)
    (local $generator i32) (local $modulus i32) (local $status i32)
    (local $degree_cell i32) (local $degree_a i32) (local $degree_b i32)
    (local $a_ypoly i32) (local $b_ypoly i32) (local $resultant i32)
    (local $result_degree i32) (local $result_list i32)
    (local $generator_slot i32) (local $coordinate_list i32)
    (local $coordinate_degree i32) (local $coefficient i32)
    (local $coefficient_expression i32) (local $i i32) (local $j i32)
    (local $dest i32)
    (local $a_lcm i32) (local $b_lcm i32) (local $lcm_cell i32)
    (local $divisor i32)
    (if (call $expression_walk_guard
          (i32.add
            (i32.mul (local.get $registry_count) (i32.const 4))
            (i32.add (i32.mul (i32.const 3) (global.get $VALUE_SIZE)) (i32.const 32))))
      (then (return (i32.const 0))))
    (local.set $generator_out (call $carve_scratch_blob (i32.const 4)))
    (local.set $representations (call $carve_scratch_blob
      (i32.mul (local.get $registry_count) (i32.const 4))))
    (local.set $status (call $algebraic_build_primitive_element
      (local.get $registry) (local.get $registry_count)
      (local.get $generator_out) (local.get $representations)))
    (if (i32.eq (local.get $status) (i32.const 1)) (then (return (i32.const 0))))
    (if (local.get $status) (then (return (i32.const 1))))
    (local.set $generator (i32.load (call $abs (local.get $generator_out))))
    (local.set $modulus (call $algebraic_apoly_from_bigint_poly
      (call $algebraic_poly_from_array (call $algebraic_coefficients_of (local.get $generator)))))
    (if (i32.eqz (local.get $modulus)) (then (return (i32.const 0))))
    (local.set $degree_cell (call $carve_scratch_blob (i32.const 4)))
    (local.set $a_ypoly (call $expression_to_field_ypoly
      (local.get $a_slot) (local.get $y_slot) (local.get $x_slot)
      (local.get $stage) (local.get $stage_capacity) (local.get $residual)
      (local.get $registry) (local.get $registry_count)
      (local.get $representations) (local.get $modulus) (local.get $degree_cell)))
    (if (i32.eqz (local.get $a_ypoly)) (then (return (i32.const 0))))
    (if (i32.eq (local.get $a_ypoly) (i32.const 1)) (then (return (i32.const 1))))
    (local.set $degree_a (i32.load (call $abs (local.get $degree_cell))))
    (local.set $b_ypoly (call $expression_to_field_ypoly
      (local.get $b_slot) (local.get $y_slot) (local.get $x_slot)
      (local.get $stage) (local.get $stage_capacity) (local.get $residual)
      (local.get $registry) (local.get $registry_count)
      (local.get $representations) (local.get $modulus) (local.get $degree_cell)))
    (if (i32.eqz (local.get $b_ypoly)) (then (return (i32.const 0))))
    (if (i32.eq (local.get $b_ypoly) (i32.const 1)) (then (return (i32.const 1))))
    (local.set $degree_b (i32.load (call $abs (local.get $degree_cell))))
    (local.set $lcm_cell (call $carve_scratch_blob (i32.const 4)))
    (i32.store (call $abs (local.get $lcm_cell)) (call $bigint_one))
    (local.set $status (call $algebraic_rational_npoly_lcm
      (local.get $a_ypoly) (i32.const 3) (local.get $lcm_cell)))
    (if (local.get $status) (then (return (i32.const 0))))
    (local.set $a_lcm (i32.load (call $abs (local.get $lcm_cell))))
    (local.set $a_ypoly (call $algebraic_rational_npoly_clear
      (local.get $a_ypoly) (i32.const 3) (local.get $a_lcm)))
    (if (i32.eqz (local.get $a_ypoly)) (then (return (i32.const 0))))
    (i32.store (call $abs (local.get $lcm_cell)) (call $bigint_one))
    (local.set $status (call $algebraic_rational_npoly_lcm
      (local.get $b_ypoly) (i32.const 3) (local.get $lcm_cell)))
    (if (local.get $status) (then (return (i32.const 0))))
    (local.set $b_lcm (i32.load (call $abs (local.get $lcm_cell))))
    (local.set $b_ypoly (call $algebraic_rational_npoly_clear
      (local.get $b_ypoly) (i32.const 3) (local.get $b_lcm)))
    (if (i32.eqz (local.get $b_ypoly)) (then (return (i32.const 0))))
    (local.set $divisor (call $bigint_mul
      (call $bigint_pow (local.get $a_lcm)
        (call $bigint_from_i64 (i64.extend_i32_s (local.get $degree_b))))
      (call $bigint_pow (local.get $b_lcm)
        (call $bigint_from_i64 (i64.extend_i32_s (local.get $degree_a))))))
    (local.set $resultant (call $algebraic_npoly_resultant
      (local.get $a_ypoly) (local.get $b_ypoly) (i32.const 3)))
    (if (i32.eqz (local.get $resultant)) (then (return (i32.const 0))))
    (call $algebraic_npoly_trim (local.get $resultant) (i32.const 2))
    (local.set $result_degree (call $algebraic_poly_degree (local.get $resultant)))
    (if (i32.lt_s (local.get $result_degree) (i32.const 0))
      (then
        (call $push_rational_inline (i64.const 0))
        (return (i32.const 0))))
    (if (call $expression_walk_guard
          (i32.add
            (i32.mul (i32.add (local.get $result_degree) (i32.const 1))
              (global.get $VALUE_SIZE))
            (i32.mul (i32.const 2) (global.get $VALUE_SIZE))))
      (then (return (i32.const 0))))
    (local.set $result_list (call $carve_scratch_blob
      (i32.mul (i32.add (local.get $result_degree) (i32.const 1))
        (global.get $VALUE_SIZE))))
    (local.set $generator_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (call $write_value (local.get $generator_slot)
      (global.get $TYPE_ALGEBRAIC) (i32.const 0) (local.get $generator) (i32.const 0))
    (local.set $i (i32.const 0))
    (block $coefficients_done
      (loop $coefficients
        (br_if $coefficients_done (i32.gt_s (local.get $i) (local.get $result_degree)))
        (local.set $coefficient (call $algebraic_poly_coefficient
          (local.get $resultant) (local.get $i)))
        (local.set $coordinate_degree (call $algebraic_poly_degree (local.get $coefficient)))
        (local.set $coefficient_expression (i32.add (local.get $result_list)
          (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
        (if (i32.lt_s (local.get $coordinate_degree) (i32.const 0))
          (then (call $expression_write_zero (local.get $coefficient_expression)))
          (else
            (if (call $expression_walk_guard
                  (i32.mul (i32.add (local.get $coordinate_degree) (i32.const 1))
                    (global.get $VALUE_SIZE)))
              (then (return (i32.const 0))))
            (local.set $coordinate_list (call $carve_scratch_blob
              (i32.mul (i32.add (local.get $coordinate_degree) (i32.const 1))
                (global.get $VALUE_SIZE))))
            (local.set $j (i32.const 0))
            (block $coordinates_done
              (loop $coordinates
                (br_if $coordinates_done (i32.gt_s (local.get $j) (local.get $coordinate_degree)))
                (call $write_value
                  (i32.add (local.get $coordinate_list)
                    (i32.mul (local.get $j) (global.get $VALUE_SIZE)))
                  (global.get $TYPE_RATIONAL) (i32.const 0)
                  (call $rational_new
                    (call $algebraic_poly_coefficient (local.get $coefficient) (local.get $j))
                    (local.get $divisor))
                  (i32.const 0))
                (local.set $j (i32.add (local.get $j) (i32.const 1)))
                (br $coordinates)))
            (local.set $status (call $poly_from_coefficient_list
              (local.get $coordinate_list) (local.get $coordinate_degree)
              (local.get $generator_slot) (local.get $coefficient_expression) (i32.const 1)))
            (if (local.get $status) (then (return (i32.const 0))))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $coefficients)))
    (if (i32.eqz (local.get $x_slot))
      (then
        (memory.copy
          (call $abs (call $read_ctx (global.get $CTX_PENDING_POINTER)))
          (call $abs (local.get $result_list)) (global.get $VALUE_SIZE))
        (call $write_ctx (global.get $CTX_PENDING_POINTER)
          (i32.add (call $read_ctx (global.get $CTX_PENDING_POINTER)) (global.get $VALUE_SIZE))))
      (else
        (local.set $dest (call $read_ctx (global.get $CTX_PENDING_POINTER)))
        (local.set $status (call $poly_from_coefficient_list
          (local.get $result_list) (local.get $result_degree)
          (local.get $x_slot) (local.get $dest) (i32.const 1)))
        (if (local.get $status) (then (return (i32.const 0))))
        (call $write_ctx (global.get $CTX_PENDING_POINTER)
          (i32.add (local.get $dest) (global.get $VALUE_SIZE)))))
    (i32.const 0)
  )

  ;; Extract a (simplified) polynomial-shaped expression into a ypoly
  ;; over ℤ[x]: outer variable $y_slot, secondary variable
  ;; $x_symbol_slot (0 slot pointer when the coefficients are pure
  ;; numerics), all denominators cleared by one polynomial-wide LCM,
  ;; which is stored at $lcm_out (a 4-byte cell holding a BigInt
  ;; header). Returns the ypoly, or 0 on pressure, or 1 on a
  ;; non-bivariate / non-rational shape (caller throws).
  (func $expression_to_integer_ypoly
    (param $poly_slot i32) (param $y_slot i32) (param $x_symbol_slot i32)
    (param $stage i32) (param $stage_capacity i32)
    (param $residual i32) (param $lcm_out i32)
    (result i32)
    (local $degree64 i64)
    (local $degree i32)
    (local $list i32)
    (local $status i32)
    (local $i i32)
    (local $j i32)
    (local $coefficient_slot i32)
    (local $inner_degree64 i64)
    (local $inner_degree i32)
    (local $inner_list i32)
    (local $inner_slot i32)
    (local $slot_type i32)
    (local $pairs_blob i32)
    (local $offsets_blob i32)
    (local $pair_count i32)
    (local $rational_header i32)
    (local $numerator i32)
    (local $denominator i32)
    (local $lcm i32)
    (local $gcd i32)
    (local $ypoly i32)
    (local $xpoly i32)
    (local $pair_base i32)
    (local $cursor i32)
    (local.set $degree64 (call $poly_degree_in
      (local.get $poly_slot) (local.get $y_slot) (local.get $stage)
      (local.get $stage_capacity) (local.get $residual)))
    (if (i64.eq (local.get $degree64) (i64.const -1)) (then (return (i32.const 0))))
    (if (i64.lt_s (local.get $degree64) (i64.const 0)) (then (return (i32.const 1))))
    (if (i64.gt_s (local.get $degree64) (i64.const 100000)) (then (return (i32.const 1))))
    (local.set $degree (i32.wrap_i64 (local.get $degree64)))
    (if (call $expression_walk_guard
          (i32.mul (i32.add (local.get $degree) (i32.const 1)) (global.get $VALUE_SIZE)))
      (then (return (i32.const 0))))
    (local.set $list (call $carve_scratch_blob
      (i32.mul (i32.add (local.get $degree) (i32.const 1)) (global.get $VALUE_SIZE))))
    (local.set $status (call $poly_extract_coefficients
      (local.get $poly_slot) (local.get $y_slot) (local.get $degree)
      (local.get $list) (local.get $stage) (local.get $stage_capacity)
      (local.get $residual)))
    (if (i32.eq (local.get $status) (i32.const 1)) (then (return (i32.const 0))))
    (if (local.get $status) (then (return (i32.const 1))))
    ;; Two-pass layout: first extract every coefficient's inner
    ;; rational pairs into one growing blob (offsets per outer index),
    ;; folding the global LCM; then build the integer xpolys.
    (if (call $expression_walk_guard (i32.add
          (i32.mul (i32.add (local.get $degree) (i32.const 2)) (i32.const 8)) (i32.const 64)))
      (then (return (i32.const 0))))
    (local.set $offsets_blob (call $carve_scratch_blob
      (i32.mul (i32.add (local.get $degree) (i32.const 1)) (i32.const 8))))
    (local.set $lcm (call $bigint_one))
    (local.set $i (i32.const 0))
    (block $outer_done
      (loop $outer
        (br_if $outer_done (i32.gt_s (local.get $i) (local.get $degree)))
        (local.set $coefficient_slot (i32.add (local.get $list)
          (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
        (if (i32.eqz (local.get $x_symbol_slot))
          (then
            ;; Pure-numeric mode: the coefficient IS the single pair.
            (local.set $inner_degree (i32.const 0))
            (local.set $inner_list (local.get $coefficient_slot)))
          (else
            (local.set $inner_degree64 (call $poly_degree_in
              (local.get $coefficient_slot) (local.get $x_symbol_slot)
              (local.get $stage) (local.get $stage_capacity)
              (local.get $residual)))
            (if (i64.eq (local.get $inner_degree64) (i64.const -1)) (then (return (i32.const 0))))
            (if (i64.lt_s (local.get $inner_degree64) (i64.const 0)) (then (return (i32.const 1))))
            (if (i64.gt_s (local.get $inner_degree64) (i64.const 100000)) (then (return (i32.const 1))))
            (local.set $inner_degree (i32.wrap_i64 (local.get $inner_degree64)))
            (if (call $expression_walk_guard
                  (i32.mul (i32.add (local.get $inner_degree) (i32.const 1)) (global.get $VALUE_SIZE)))
              (then (return (i32.const 0))))
            (local.set $inner_list (call $carve_scratch_blob
              (i32.mul (i32.add (local.get $inner_degree) (i32.const 1)) (global.get $VALUE_SIZE))))
            (local.set $status (call $poly_extract_coefficients
              (local.get $coefficient_slot) (local.get $x_symbol_slot) (local.get $inner_degree)
              (local.get $inner_list) (local.get $stage) (local.get $stage_capacity)
              (local.get $residual)))
            (if (i32.eq (local.get $status) (i32.const 1)) (then (return (i32.const 0))))
            (if (local.get $status) (then (return (i32.const 1))))))
        ;; Pairs blob for this outer coefficient.
        (if (call $expression_walk_guard (i32.add
              (i32.mul (i32.add (local.get $inner_degree) (i32.const 1)) (i32.const 8))
              (i32.const 32)))
          (then (return (i32.const 0))))
        (local.set $pairs_blob (call $carve_scratch_blob
          (i32.mul (i32.add (local.get $inner_degree) (i32.const 1)) (i32.const 8))))
        (i32.store (call $abs (i32.add (local.get $offsets_blob)
          (i32.mul (local.get $i) (i32.const 8)))) (local.get $pairs_blob))
        (i32.store (call $abs (i32.add
          (i32.add (local.get $offsets_blob) (i32.mul (local.get $i) (i32.const 8)))
          (i32.const 4))) (local.get $inner_degree))
        (local.set $j (i32.const 0))
        (block $inner_done
          (loop $inner
            (br_if $inner_done (i32.gt_s (local.get $j) (local.get $inner_degree)))
            (local.set $inner_slot (i32.add (local.get $inner_list)
              (i32.mul (local.get $j) (global.get $VALUE_SIZE))))
            (local.set $slot_type (call $value_type (local.get $inner_slot)))
            (if (i32.eqz (i32.or
                  (i32.eq (local.get $slot_type) (global.get $TYPE_RATIONAL))
                  (i32.eq (local.get $slot_type) (global.get $TYPE_BIGINT))))
              (then (return (i32.const 1))))
            (if (call $expression_walk_guard (i32.const 128))
              (then (return (i32.const 0))))
            (if (i32.eq (local.get $slot_type) (global.get $TYPE_BIGINT))
              (then
                (local.set $numerator (call $value_data_lo (local.get $inner_slot)))
                (local.set $denominator (call $bigint_one)))
              (else
                (local.set $rational_header (call $rational_materialize (local.get $inner_slot)))
                (local.set $numerator (call $rational_numerator (local.get $rational_header)))
                (local.set $denominator (call $rational_denominator (local.get $rational_header)))))
            (local.set $pair_base (i32.add (local.get $pairs_blob)
              (i32.mul (local.get $j) (i32.const 8))))
            (i32.store (call $abs (local.get $pair_base)) (local.get $numerator))
            (i32.store (call $abs (i32.add (local.get $pair_base) (i32.const 4)))
              (local.get $denominator))
            ;; Fold the LCM.
            (if (call $expression_walk_guard (i32.mul (i32.const 4)
                  (call $estimate_bigint_size (i32.add
                    (i32.add
                      (call $bigint_length (local.get $lcm))
                      (call $bigint_length (local.get $denominator)))
                    (i32.const 2)))))
              (then (return (i32.const 0))))
            (local.set $gcd (call $algebraic_bigint_gcd_guarded
              (local.get $lcm) (local.get $denominator)))
            (if (i32.eqz (local.get $gcd)) (then (return (i32.const 0))))
            (local.set $lcm (call $bigint_mul
              (call $bigint_div (local.get $lcm) (local.get $gcd))
              (local.get $denominator)))
            (local.set $j (i32.add (local.get $j) (i32.const 1)))
            (br $inner)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $outer)))
    ;; Pass two: integer xpolys with coefficient n·(L/d).
    (local.set $ypoly (call $algebraic_poly_carve (local.get $degree)))
    (if (i32.eqz (local.get $ypoly)) (then (return (i32.const 0))))
    (local.set $i (i32.const 0))
    (block $build_done
      (loop $build
        (br_if $build_done (i32.gt_s (local.get $i) (local.get $degree)))
        (local.set $cursor (i32.add (local.get $offsets_blob) (i32.mul (local.get $i) (i32.const 8))))
        (local.set $pairs_blob (i32.load (call $abs (local.get $cursor))))
        (local.set $inner_degree (i32.load (call $abs (i32.add (local.get $cursor) (i32.const 4)))))
        (local.set $xpoly (call $algebraic_poly_carve (local.get $inner_degree)))
        (if (i32.eqz (local.get $xpoly)) (then (return (i32.const 0))))
        (local.set $j (i32.const 0))
        (block $fill_done
          (loop $fill
            (br_if $fill_done (i32.gt_s (local.get $j) (local.get $inner_degree)))
            (local.set $pair_base (i32.add (local.get $pairs_blob)
              (i32.mul (local.get $j) (i32.const 8))))
            (local.set $numerator (i32.load (call $abs (local.get $pair_base))))
            (local.set $denominator (i32.load (call $abs (i32.add (local.get $pair_base) (i32.const 4)))))
            (if (call $expression_walk_guard (i32.mul (i32.const 3)
                  (call $estimate_bigint_size (i32.add
                    (i32.add
                      (call $bigint_length (local.get $numerator))
                      (call $bigint_length (local.get $lcm)))
                    (i32.const 2)))))
              (then (return (i32.const 0))))
            (call $algebraic_poly_set_coefficient (local.get $xpoly) (local.get $j)
              (call $bigint_mul (local.get $numerator)
                (call $bigint_div (local.get $lcm) (local.get $denominator))))
            (local.set $j (i32.add (local.get $j) (i32.const 1)))
            (br $fill)))
        (call $algebraic_poly_trim (local.get $xpoly))
        (call $algebraic_poly_set_coefficient (local.get $ypoly) (local.get $i) (local.get $xpoly))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $build)))
    (i32.store (call $abs (local.get $lcm_out)) (local.get $lcm))
    (local.get $ypoly)
  )

  ;; Exact.Expression.resultant(a, b, variable) — the resultant of two
  ;; polynomial-shaped expressions with respect to $variable,
  ;; eliminating it. Bivariate: at most one further Symbol may appear
  ;; in the coefficients (trivariate systems are Ring 7c's Gröbner
  ;; work). Computed as the Sylvester determinant over ℤ[x] with the
  ;; denominator-clearing factors divided back out exactly, so the
  ;; value matches the textbook Res_{deg a, deg b}. Constant results
  ;; come back numeric; otherwise a canonical expression in the
  ;; remaining symbol.
  (func $expression_resultant
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $argument2_pointer i32)
    (local $argument3_pointer i32)
    (local $scratch i32)
    (local $a_slot i32)
    (local $b_slot i32)
    (local $stage i32)
    (local $stage_slots i32)
    (local $residual i32)
    (local $x_symbol i32)
    (local $x_symbol_slot i32)
    (local $lcm_cell i32)
    (local $a_ypoly i32)
    (local $b_ypoly i32)
    (local $a_lcm i32)
    (local $b_lcm i32)
    (local $degree_a i32)
    (local $degree_b i32)
    (local $resultant i32)
    (local $divisor i32)
    (local $result_degree i32)
    (local $result_list i32)
    (local $i i32)
    (local $coefficient i32)
    (local $dest i32)
    (local $status i32)
    (local $registry i32)
    (local $registry_count_cell i32)
    (local $registry_count i32)
    (local $y_symbol i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))))
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then (local.set $argument2_pointer (i32.add (local.get $argument1_pointer) (global.get $VALUE_SIZE)))))
    (if (i32.ge_u (local.get $argc) (i32.const 3))
      (then (local.set $argument3_pointer (i32.add (local.get $argument2_pointer) (global.get $VALUE_SIZE)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (i32.or
          (i32.lt_u (local.get $argc) (i32.const 3))
          (i32.ne (call $value_type (local.get $argument3_pointer)) (global.get $TYPE_SYMBOL)))
      (then
        (if (call $throw_type_error)
          (then (return (i32.const 2)))
          (else (return (i32.const 1))))))
    (local.set $y_symbol (call $value_data_lo (local.get $argument3_pointer)))
    (if (i32.or
          (i32.eq (call $expression_polynomial_kind (local.get $argument1_pointer))
                  (global.get $POLY_KIND_NOT_POLYNOMIAL))
          (i32.eq (call $expression_polynomial_kind (local.get $argument2_pointer))
                  (global.get $POLY_KIND_NOT_POLYNOMIAL)))
      (then
        (if (call $throw_type_error)
          (then (return (i32.const 2)))
          (else (return (i32.const 1))))))
    (if (call $expression_walk_guard (i32.add
          (i32.mul (i32.const 4) (global.get $VALUE_SIZE)) (i32.const 24)))
      (then (return (i32.const 0))))
    (local.set $scratch (call $carve_scratch_blob (i32.add
      (i32.mul (i32.const 4) (global.get $VALUE_SIZE)) (i32.const 8))))
    (local.set $a_slot (local.get $scratch))
    (local.set $b_slot (i32.add (local.get $a_slot) (global.get $VALUE_SIZE)))
    (local.set $residual (i32.add (local.get $b_slot) (global.get $VALUE_SIZE)))
    (local.set $x_symbol_slot (i32.add (local.get $residual) (global.get $VALUE_SIZE)))
    (local.set $lcm_cell (i32.add (local.get $x_symbol_slot) (global.get $VALUE_SIZE)))
    (if (call $expression_simplify_into (local.get $argument1_pointer) (local.get $a_slot))
      (then (return (i32.const 0))))
    (if (call $expression_simplify_into (local.get $argument2_pointer) (local.get $b_slot))
      (then (return (i32.const 0))))
    ;; Res(0, ·) = Res(·, 0) = 0.
    (if (i32.or
          (call $expression_value_is_zero_wide (local.get $a_slot))
          (call $expression_value_is_zero_wide (local.get $b_slot)))
      (then
        (if (global.get $memory_pressure_signaled) (then (return (i32.const 0))))
        (call $push_rational_inline (i64.const 0))
        (return (i32.const 0))))
    (if (global.get $memory_pressure_signaled) (then (return (i32.const 0))))
    ;; Polynomial staging needs one 16-byte record per factor in the
    ;; largest term across either input.
    (call $write_value (local.get $lcm_cell)
      (global.get $TYPE_SYMBOL) (i32.const 0) (local.get $y_symbol) (i32.const 0))
    (drop (call $poly_measure_factors (local.get $a_slot)))
    (local.set $stage_slots (global.get $term_factors_count))
    (drop (call $poly_measure_factors (local.get $b_slot)))
    (if (i32.gt_u (global.get $term_factors_count) (local.get $stage_slots))
      (then (local.set $stage_slots (global.get $term_factors_count))))
    (if (call $expression_walk_guard
          (i32.add (i32.mul (local.get $stage_slots) (i32.const 16)) (i32.const 16)))
      (then (return (i32.const 0))))
    (local.set $stage (call $carve_scratch_blob (i32.mul (local.get $stage_slots) (i32.const 16))))
    ;; The secondary symbol (0 when the system is variable-free after
    ;; elimination).
    (local.set $x_symbol (call $expression_find_first_symbol
      (local.get $a_slot) (local.get $y_symbol)))
    (if (i32.eqz (local.get $x_symbol))
      (then (local.set $x_symbol (call $expression_find_first_symbol
        (local.get $b_slot) (local.get $y_symbol)))))
    (if (local.get $x_symbol)
      (then (call $write_value (local.get $x_symbol_slot)
        (global.get $TYPE_SYMBOL) (i32.const 0) (local.get $x_symbol) (i32.const 0))))
    ;; Algebraic leaves widen the coefficient field without widening the
    ;; symbol boundary. Rational-only inputs keep the established integer
    ;; path below; mixed inputs share one primitive coefficient field.
    (if (call $expression_walk_guard
          (i32.add
            (i32.mul (global.get $ALGEBRAIC_MAX_VARIABLES) (i32.const 4))
            (i32.const 8)))
      (then (return (i32.const 0))))
    (local.set $registry (call $carve_scratch_blob
      (i32.mul (global.get $ALGEBRAIC_MAX_VARIABLES) (i32.const 4))))
    (local.set $registry_count_cell (call $carve_scratch_blob (i32.const 4)))
    (local.set $status (call $expression_collect_algebraic_registry
      (local.get $a_slot) (local.get $registry) (local.get $registry_count_cell)))
    (if (i32.eq (local.get $status) (i32.const 1)) (then (return (i32.const 0))))
    (if (local.get $status)
      (then
        (if (call $throw_range_error_with_message
              (global.get $BUILTIN_MSG_ALGEBRAIC_TOO_MANY_VARIABLES))
          (then (return (i32.const 2)))
          (else (return (i32.const 1))))))
    (local.set $status (call $expression_collect_algebraic_registry
      (local.get $b_slot) (local.get $registry) (local.get $registry_count_cell)))
    (if (i32.eq (local.get $status) (i32.const 1)) (then (return (i32.const 0))))
    (if (local.get $status)
      (then
        (if (call $throw_range_error_with_message
              (global.get $BUILTIN_MSG_ALGEBRAIC_TOO_MANY_VARIABLES))
          (then (return (i32.const 2)))
          (else (return (i32.const 1))))))
    (local.set $registry_count (i32.load (call $abs (local.get $registry_count_cell))))
    (if (local.get $registry_count)
      (then
        (local.set $status (call $expression_resultant_over_algebraic_field
          (local.get $a_slot) (local.get $b_slot) (local.get $lcm_cell)
          (select (local.get $x_symbol_slot) (i32.const 0)
            (i32.ne (local.get $x_symbol) (i32.const 0)))
          (local.get $stage) (local.get $stage_slots) (local.get $residual)
          (local.get $registry) (local.get $registry_count)))
        (if (local.get $status)
          (then
            (if (call $throw_type_error)
              (then (return (i32.const 2)))
              (else (return (i32.const 1))))))
        (return (i32.const 0))))
    (local.set $a_ypoly (call $expression_to_integer_ypoly
      (local.get $a_slot) (local.get $lcm_cell)
      (select (local.get $x_symbol_slot) (i32.const 0) (i32.ne (local.get $x_symbol) (i32.const 0)))
      (local.get $stage) (local.get $stage_slots)
      (local.get $residual) (local.get $lcm_cell)))
    (if (i32.eqz (local.get $a_ypoly)) (then (return (i32.const 0))))
    (if (i32.eq (local.get $a_ypoly) (i32.const 1))
      (then
        (if (call $throw_type_error)
          (then (return (i32.const 2)))
          (else (return (i32.const 1))))))
    (local.set $a_lcm (i32.load (call $abs (local.get $lcm_cell))))
    (call $write_value (local.get $lcm_cell)
      (global.get $TYPE_SYMBOL) (i32.const 0) (local.get $y_symbol) (i32.const 0))
    (local.set $b_ypoly (call $expression_to_integer_ypoly
      (local.get $b_slot) (local.get $lcm_cell)
      (select (local.get $x_symbol_slot) (i32.const 0) (i32.ne (local.get $x_symbol) (i32.const 0)))
      (local.get $stage) (local.get $stage_slots)
      (local.get $residual) (local.get $lcm_cell)))
    (if (i32.eqz (local.get $b_ypoly)) (then (return (i32.const 0))))
    (if (i32.eq (local.get $b_ypoly) (i32.const 1))
      (then
        (if (call $throw_type_error)
          (then (return (i32.const 2)))
          (else (return (i32.const 1))))))
    (local.set $b_lcm (i32.load (call $abs (local.get $lcm_cell))))
    (local.set $degree_a (call $algebraic_poly_degree (local.get $a_ypoly)))
    (local.set $degree_b (call $algebraic_poly_degree (local.get $b_ypoly)))
    (local.set $resultant (call $algebraic_ypoly_resultant
      (local.get $a_ypoly) (local.get $b_ypoly)))
    (if (i32.eqz (local.get $resultant)) (then (return (i32.const 0))))
    (call $algebraic_poly_trim (local.get $resultant))
    ;; La^deg(b) · Lb^deg(a) · Res(a, b).
    (if (call $expression_walk_guard (call $sat_budget_mul (i32.const 16)
          (call $estimate_bigint_size (i32.add
            (i32.mul
              (i32.add
                (call $bigint_length (local.get $a_lcm))
                (call $bigint_length (local.get $b_lcm)))
              (i32.add
                (select (local.get $degree_a) (i32.const 1)
                  (i32.gt_s (local.get $degree_a) (i32.const 0)))
                (select (local.get $degree_b) (i32.const 1)
                  (i32.gt_s (local.get $degree_b) (i32.const 0)))))
            (i32.const 4)))))
      (then (return (i32.const 0))))
    (local.set $divisor (call $bigint_mul
      (call $bigint_pow (local.get $a_lcm)
        (call $bigint_from_i64 (i64.extend_i32_s (local.get $degree_b))))
      (call $bigint_pow (local.get $b_lcm)
        (call $bigint_from_i64 (i64.extend_i32_s (local.get $degree_a))))))
    (local.set $result_degree (call $algebraic_poly_degree (local.get $resultant)))
    (if (i32.le_s (local.get $result_degree) (i32.const 0))
      (then
        ;; Constant (possibly zero) resultant → numeric.
        (if (i32.lt_s (local.get $result_degree) (i32.const 0))
          (then
            (call $push_rational_inline (i64.const 0))
            (return (i32.const 0))))
        (if (call $expression_walk_guard (i32.mul (i32.const 3)
              (call $estimate_bigint_size (i32.add
                (i32.add
                  (call $bigint_length (call $algebraic_poly_coefficient
                    (local.get $resultant) (i32.const 0)))
                  (call $bigint_length (local.get $divisor)))
                (i32.const 2)))))
          (then (return (i32.const 0))))
        (call $push_rational (call $rational_new
          (call $algebraic_poly_coefficient (local.get $resultant) (i32.const 0))
          (local.get $divisor)))
        (return (i32.const 0))))
    ;; Rational coefficient list → canonical expression in x.
    (if (call $expression_walk_guard (i32.add
          (i32.mul (i32.add (local.get $result_degree) (i32.const 1)) (global.get $VALUE_SIZE))
          (global.get $VALUE_SIZE)))
      (then (return (i32.const 0))))
    (local.set $result_list (call $carve_scratch_blob
      (i32.mul (i32.add (local.get $result_degree) (i32.const 1)) (global.get $VALUE_SIZE))))
    (local.set $i (i32.const 0))
    (block $convert_done
      (loop $convert
        (br_if $convert_done (i32.gt_s (local.get $i) (local.get $result_degree)))
        (local.set $coefficient (call $algebraic_poly_coefficient
          (local.get $resultant) (local.get $i)))
        (if (call $expression_walk_guard (i32.mul (i32.const 3)
              (call $estimate_bigint_size (i32.add
                (i32.add
                  (call $bigint_length (local.get $coefficient))
                  (call $bigint_length (local.get $divisor)))
                (i32.const 2)))))
          (then (return (i32.const 0))))
        (call $write_value
          (i32.add (local.get $result_list) (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
          (global.get $TYPE_RATIONAL) (i32.const 0)
          (call $rational_new (local.get $coefficient) (local.get $divisor))
          (i32.const 0))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $convert)))
    (local.set $dest (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (local.set $status (call $poly_from_coefficient_list
      (local.get $result_list) (local.get $result_degree)
      (local.get $x_symbol_slot) (local.get $dest) (i32.const 1)))
    (if (local.get $status) (then (return (i32.const 0))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER)
      (i32.add (local.get $dest) (global.get $VALUE_SIZE)))
    (i32.const 0)
  )

  ;; =====================================================================
  ;; Multivariate coefficient classification generalizes the single-value
  ;; "r + q·α" scan to r distinct algebraic values, each raised to a
  ;; non-negative integer power, with products included: a coefficient
  ;; term is `scalar × Π αᵢ^eᵢ` for however many distinct algebraic
  ;; atoms it mentions.

  ;;
  ;; Monomial record (20 + 8*MAX_FACTORS bytes, MAX_FACTORS = 8 — a
  ;; documented, loud shield, not a silent limit; geometric
  ;; intersection coefficients never legitimately need more distinct
  ;; algebraic factors in one term):
  ;;   [scalar_header:4][factor_count:4][alpha0:4][exp0:4]…[alpha7:4][exp7:4]
  ;;
  ;; A caller owns one such record's scratch bytes and passes it to
  ;; $algebraic_classify_term, which fills it in from one term slot
  ;; (a value slot that is Rational/BigInt, TYPE_ALGEBRAIC, Power(α,k),
  ;; or Multiply(...) of such factors). Returns:
  ;;   0 ok / 1 pressure / 2 unrecognized shape (caller throws
  ;;   MSG_ALGEBRAIC_COEFFICIENT_TYPE) / 3 too many factors (caller
  ;;   throws MSG_ALGEBRAIC_TOO_MANY_FACTORS).
  ;; =====================================================================
  (global $ALGEBRAIC_MONOMIAL_MAX_FACTORS i32 (i32.const 8))
  (global $ALGEBRAIC_MONOMIAL_RECORD_SIZE i32 (i32.const 84)) ;; 4+4+8*8

  ;; Merge (alpha_header, exponent) into a monomial record's factor
  ;; list, deduping by VALUE equality (not pointer) — same discipline
  ;; as 6c's alpha_header check. Exponents of matched factors add.
  ;; 0 ok / 1 pressure / 3 too many factors.
  (func $algebraic_monomial_add_factor
    (param $record i32) (param $alpha_header i32) (param $exponent i32) (result i32)
    (local $count i32)
    (local $i i32)
    (local $entry i32)
    (local $existing_header i32)
    (local $compare_status i32)
    (local.set $count (i32.load (call $abs (i32.add (local.get $record) (i32.const 4)))))
    (local.set $i (i32.const 0))
    (block $scan_done
      (loop $scan
        (br_if $scan_done (i32.ge_s (local.get $i) (local.get $count)))
        (local.set $entry (i32.add (local.get $record)
          (i32.add (i32.const 8) (i32.mul (local.get $i) (i32.const 8)))))
        (local.set $existing_header (i32.load (call $abs (local.get $entry))))
        (local.set $compare_status (i32.const 1))
        (if (i32.ne (local.get $existing_header) (local.get $alpha_header))
          (then
            (local.set $compare_status (call $algebraic_compare_algebraic
              (local.get $existing_header) (local.get $alpha_header)))
            (if (i32.eq (local.get $compare_status) (i32.const -2)) (then (return (i32.const 1))))
            (local.set $compare_status (i32.eqz (local.get $compare_status))))
          (else (local.set $compare_status (i32.const 1))))
        (if (local.get $compare_status)
          (then
            (i32.store (call $abs (i32.add (local.get $entry) (i32.const 4)))
              (i32.add (i32.load (call $abs (i32.add (local.get $entry) (i32.const 4))))
                (local.get $exponent)))
            (return (i32.const 0))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $scan)))
    (if (i32.ge_s (local.get $count) (global.get $ALGEBRAIC_MONOMIAL_MAX_FACTORS))
      (then (return (i32.const 3))))
    (local.set $entry (i32.add (local.get $record)
      (i32.add (i32.const 8) (i32.mul (local.get $count) (i32.const 8)))))
    (i32.store (call $abs (local.get $entry)) (local.get $alpha_header))
    (i32.store (call $abs (i32.add (local.get $entry) (i32.const 4))) (local.get $exponent))
    (i32.store (call $abs (i32.add (local.get $record) (i32.const 4)))
      (i32.add (local.get $count) (i32.const 1)))
    (i32.const 0)
  )

  ;; Classify ONE term-list factor (a term ITSELF, or one arg inside a
  ;; Multiply) into the record's scalar/factor accumulation.
  ;; 0 ok / 1 pressure / 2 unrecognized shape / 3 too many factors.
  (func $algebraic_classify_factor (param $record i32) (param $factor_slot i32) (result i32)
    (local $factor_type i32)
    (local $factor_rational i32)
    (local $base_slot i32)
    (local $exponent_slot i32)
    (local $exponent_ok i32)
    (local $exponent32 i32)
    (local $scalar i32)
    (local $inner_args i32)
    (local.set $factor_type (call $value_type (local.get $factor_slot)))
    (if (i32.or
          (i32.eq (local.get $factor_type) (global.get $TYPE_RATIONAL))
          (i32.eq (local.get $factor_type) (global.get $TYPE_BIGINT)))
      (then
        (if (call $expression_walk_guard (i32.const 128)) (then (return (i32.const 1))))
        (if (i32.eq (local.get $factor_type) (global.get $TYPE_BIGINT))
          (then (local.set $factor_rational (call $rational_from_bigint
            (call $value_data_lo (local.get $factor_slot)))))
          (else (local.set $factor_rational (call $rational_materialize (local.get $factor_slot)))))
        (local.set $scalar (i32.load (call $abs (local.get $record))))
        (if (call $algebraic_rational_guard (local.get $scalar) (local.get $factor_rational))
          (then (return (i32.const 1))))
        (i32.store (call $abs (local.get $record))
          (call $rational_mul (local.get $scalar) (local.get $factor_rational)))
        (return (i32.const 0))))
    (if (i32.eq (local.get $factor_type) (global.get $TYPE_ALGEBRAIC))
      (then (return (call $algebraic_monomial_add_factor (local.get $record)
        (call $value_data_lo (local.get $factor_slot)) (i32.const 1)))))
    (if (i32.and
          (i32.eq (local.get $factor_type) (global.get $TYPE_EXPRESSION))
          (i32.eq
            (call $expression_head (call $value_data_lo (local.get $factor_slot)))
            (call $symbol_registry_lookup
              (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_POWER)))))
      (then
        (local.set $inner_args (call $expression_args (call $value_data_lo (local.get $factor_slot))))
        (if (i32.ne
              (i32.load (call $abs (i32.add (local.get $inner_args) (i32.const 8))))
              (i32.const 2))
          (then (return (i32.const 2))))
        (local.set $base_slot (i32.add
          (i32.load (call $abs (i32.add (local.get $inner_args) (i32.const 16))))
          (global.get $GC_HEADER_SIZE)))
        (if (i32.ne (call $value_type (local.get $base_slot)) (global.get $TYPE_ALGEBRAIC))
          (then (return (i32.const 2))))
        (local.set $exponent_slot (i32.add (local.get $base_slot) (global.get $VALUE_SIZE)))
        (local.set $exponent_ok (call $exponent_slot_to_i64 (local.get $exponent_slot)))
        (if (i32.eqz (local.get $exponent_ok)) (then (return (i32.const 2))))
        (if (i64.lt_s (global.get $bigint_to_i64_value) (i64.const 0))
          (then (return (i32.const 2))))
        (if (i64.gt_s (global.get $bigint_to_i64_value) (i64.const 64))
          (then (return (i32.const 3))))
        (local.set $exponent32 (i32.wrap_i64 (global.get $bigint_to_i64_value)))
        (if (i32.eqz (local.get $exponent32))
          (then (return (i32.const 0))))
        (return (call $algebraic_monomial_add_factor (local.get $record)
          (call $value_data_lo (local.get $base_slot)) (local.get $exponent32)))))
    (i32.const 2)
  )

  ;; Classify ONE coefficient term (a bare factor, or a Multiply of
  ;; factors) into a freshly-zeroed monomial record. Caller has
  ;; already written scalar_header = rational 1, factor_count = 0.
  ;; 0 ok / 1 pressure / 2 unrecognized shape / 3 too many factors.
  (func $algebraic_classify_term (param $record i32) (param $term_slot i32) (result i32)
    (local $term_type i32)
    (local $inner_args i32)
    (local $arg_count i32)
    (local $arg_data i32)
    (local $i i32)
    (local $status i32)
    (local.set $term_type (call $value_type (local.get $term_slot)))
    (if (i32.and
          (i32.eq (local.get $term_type) (global.get $TYPE_EXPRESSION))
          (i32.eq
            (call $expression_head (call $value_data_lo (local.get $term_slot)))
            (call $symbol_registry_lookup
              (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)))))
      (then
        (local.set $inner_args (call $expression_args (call $value_data_lo (local.get $term_slot))))
        (local.set $arg_count (i32.load (call $abs (i32.add (local.get $inner_args) (i32.const 8)))))
        (local.set $arg_data (i32.add
          (i32.load (call $abs (i32.add (local.get $inner_args) (i32.const 16))))
          (global.get $GC_HEADER_SIZE)))
        (local.set $i (i32.const 0))
        (block $args_done
          (loop $args
            (br_if $args_done (i32.ge_s (local.get $i) (local.get $arg_count)))
            (local.set $status (call $algebraic_classify_factor (local.get $record)
              (i32.add (local.get $arg_data) (i32.mul (local.get $i) (global.get $VALUE_SIZE)))))
            (if (local.get $status) (then (return (local.get $status))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $args)))
        (return (i32.const 0))))
    (call $algebraic_classify_factor (local.get $record) (local.get $term_slot))
  )

  ;; =====================================================================
  ;; Multivariate elimination-order norm construction consumes the
  ;; per-slot monomial lists $algebraic_classify_term produces and
  ;; builds the level-(r+1) coefficient polynomial G, then runs
  ;; successive-norm elimination down to a single level-1 integer
  ;; polynomial N(x), checking for degenerate collapse at every step.


  ;; =====================================================================

  ;; Register alpha_header into the dedup list at $registry (a flat
  ;; i32 array; $count is the current entry count, read/written via
  ;; the caller's own local — this function only compares and
  ;; conditionally appends). Returns the header's index, or -1 on
  ;; pressure during the compare.
  (func $algebraic_registry_index_of
    (param $registry i32) (param $count i32) (param $alpha_header i32) (result i32)
    (local $i i32)
    (local $existing i32)
    (local $compare_status i32)
    (local.set $i (i32.const 0))
    (block $done
      (loop $scan
        (br_if $done (i32.ge_s (local.get $i) (local.get $count)))
        (local.set $existing (i32.load (call $abs (i32.add (local.get $registry)
          (i32.mul (local.get $i) (i32.const 4))))))
        (if (i32.eq (local.get $existing) (local.get $alpha_header))
          (then (return (local.get $i))))
        (local.set $compare_status (call $algebraic_compare_algebraic
          (local.get $existing) (local.get $alpha_header)))
        (if (i32.eq (local.get $compare_status) (i32.const -2)) (then (return (i32.const -1))))
        (if (i32.eqz (local.get $compare_status)) (then (return (local.get $i))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $scan)))
    (i32.const -2) ;; not found (distinct from -1's pressure signal)
  )

  ;; Pre-pass: walk every term of every coefficient slot (the SAME
  ;; Add-fanout/term-list shape $algebraic_roots_of_polynomial's r=1
  ;; loop already uses) to grow $registry with every distinct
  ;; algebraic header seen (via $algebraic_classify_term run against a
  ;; throwaway scratch record per term — the monomial's factor shape
  ;; is discarded here; the real fold happens in
  ;; $algebraic_build_g's second pass once r is known) AND to track,
  ;; per registry index, the MAXIMUM exponent that variable is ever
  ;; raised to anywhere in the polynomial — into the caller-zeroed
  ;; $max_exponents array (capacity $ALGEBRAIC_MAX_VARIABLES i32s).
  ;; This bounds G's dense per-variable degree: every x-coefficient's
  ;; level-r sub-polynomial is sized by these same global maxima rather
  ;; than a per-branch minimum. This is simpler and stays within the
  ;; dense representation's cost tradeoff, though it may over-provision
  ;; branches beyond what their own monomials need.



  ;; Registry capacity is $ALGEBRAIC_MAX_VARIABLES; exceeding it
  ;; throws the documented shield.
  ;; Returns via $registry_count_out: 0 ok / 1 pressure / 2 unrecognized
  ;; coefficient shape / 3 too many factors in one term / 4 too many
  ;; distinct variables.
  (global $ALGEBRAIC_MAX_VARIABLES i32 (i32.const 16))
  (func $algebraic_collect_variable_registry
    (param $list i32) (param $degree i32) (param $registry i32)
    (param $max_exponents i32) (param $registry_count_out i32)
    (result i32)
    (local $i i32)
    (local $slot i32)
    (local $slot_type i32)
    (local $inner_args i32)
    (local $term_data i32)
    (local $term_count i32)
    (local $term_index i32)
    (local $term_slot i32)
    (local $record i32)
    (local $status i32)
    (local $factor_count i32)
    (local $f i32)
    (local $alpha_header i32)
    (local $exponent i32)
    (local $registry_count i32)
    (local $index i32)
    (local $existing_max i32)
    (local.set $registry_count (i32.const 0))
    (local.set $i (i32.const 0))
    (block $slots_done
      (loop $slots
        (br_if $slots_done (i32.gt_s (local.get $i) (local.get $degree)))
        (local.set $slot (i32.add (local.get $list) (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
        (local.set $slot_type (call $value_type (local.get $slot)))
        (if (i32.and
              (i32.eq (local.get $slot_type) (global.get $TYPE_EXPRESSION))
              (i32.eq
                (call $expression_head (call $value_data_lo (local.get $slot)))
                (call $symbol_registry_lookup
                  (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_ADD)))))
          (then
            (local.set $inner_args (call $expression_args (call $value_data_lo (local.get $slot))))
            (local.set $term_count (i32.load (call $abs (i32.add (local.get $inner_args) (i32.const 8)))))
            (local.set $term_data (i32.add
              (i32.load (call $abs (i32.add (local.get $inner_args) (i32.const 16))))
              (global.get $GC_HEADER_SIZE))))
          (else
            (local.set $term_data (local.get $slot))
            (local.set $term_count (i32.const 1))))
        (local.set $term_index (i32.const 0))
        (block $terms_done
          (loop $terms
            (br_if $terms_done (i32.ge_s (local.get $term_index) (local.get $term_count)))
            (local.set $term_slot (i32.add (local.get $term_data)
              (i32.mul (local.get $term_index) (global.get $VALUE_SIZE))))
            (if (call $expression_walk_guard (global.get $ALGEBRAIC_MONOMIAL_RECORD_SIZE))
              (then (i32.store (call $abs (local.get $registry_count_out)) (local.get $registry_count))
                (return (i32.const 1))))
            (local.set $record (call $carve_scratch_blob (global.get $ALGEBRAIC_MONOMIAL_RECORD_SIZE)))
            (i32.store (call $abs (local.get $record))
              (call $rational_new (call $bigint_one) (call $bigint_one)))
            (i32.store (call $abs (i32.add (local.get $record) (i32.const 4))) (i32.const 0))
            (local.set $status (call $algebraic_classify_term (local.get $record) (local.get $term_slot)))
            (if (local.get $status)
              (then (i32.store (call $abs (local.get $registry_count_out)) (local.get $registry_count))
                (return (local.get $status))))
            (local.set $factor_count (i32.load (call $abs (i32.add (local.get $record) (i32.const 4)))))
            (local.set $f (i32.const 0))
            (block $factors_done
              (loop $factors
                (br_if $factors_done (i32.ge_s (local.get $f) (local.get $factor_count)))
                (local.set $alpha_header (i32.load (call $abs (i32.add (local.get $record)
                  (i32.add (i32.const 8) (i32.mul (local.get $f) (i32.const 8)))))))
                (local.set $exponent (i32.load (call $abs (i32.add (local.get $record)
                  (i32.add (i32.const 12) (i32.mul (local.get $f) (i32.const 8)))))))
                (local.set $index (call $algebraic_registry_index_of
                  (local.get $registry) (local.get $registry_count) (local.get $alpha_header)))
                (if (i32.eq (local.get $index) (i32.const -1))
                  (then (i32.store (call $abs (local.get $registry_count_out)) (local.get $registry_count))
                    (return (i32.const 1))))
                (if (i32.eq (local.get $index) (i32.const -2))
                  (then
                    (if (i32.ge_s (local.get $registry_count) (global.get $ALGEBRAIC_MAX_VARIABLES))
                      (then (i32.store (call $abs (local.get $registry_count_out)) (local.get $registry_count))
                        (return (i32.const 4))))
                    (i32.store (call $abs (i32.add (local.get $registry)
                      (i32.mul (local.get $registry_count) (i32.const 4)))) (local.get $alpha_header))
                    (local.set $index (local.get $registry_count))
                    (local.set $registry_count (i32.add (local.get $registry_count) (i32.const 1)))))
                (local.set $existing_max (i32.load (call $abs (i32.add (local.get $max_exponents)
                  (i32.mul (local.get $index) (i32.const 4))))))
                (if (i32.gt_s (local.get $exponent) (local.get $existing_max))
                  (then (i32.store (call $abs (i32.add (local.get $max_exponents)
                    (i32.mul (local.get $index) (i32.const 4)))) (local.get $exponent))))
                (local.set $f (i32.add (local.get $f) (i32.const 1)))
                (br $factors)))
            (local.set $term_index (i32.add (local.get $term_index) (i32.const 1)))
            (br $terms)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $slots)))
    (i32.store (call $abs (local.get $registry_count_out)) (local.get $registry_count))
    (i32.const 0)
  )

  ;; Carve a fresh level-$depth polynomial of degree $degree with
  ;; every coefficient a freshly-carved ZERO entry at the next level
  ;; down (recursively, bottoming out at level 0 = bigint_zero).
  ;; $degrees is an array of $depth i32 degree bounds, OUTERMOST
  ;; level first (i.e. $degrees[0] is this call's own degree — the
  ;; SAME value as $degree, passed separately only so the recursive
  ;; calls can advance a pointer rather than an index). 0 on pressure.
  (func $algebraic_carve_zero_tree (param $degree i32) (param $depth i32) (param $degrees i32) (result i32)
    (local $poly i32)
    (local $i i32)
    (local $child i32)
    (if (i32.eqz (local.get $depth)) (then (return (call $bigint_zero))))
    (if (call $expression_walk_guard (i32.mul
          (i32.add (local.get $degree) (i32.const 2)) (i32.const 4)))
      (then (return (i32.const 0))))
    (local.set $poly (call $algebraic_poly_carve (local.get $degree)))
    (if (i32.eqz (local.get $poly)) (then (return (i32.const 0))))
    (local.set $i (i32.const 0))
    (block $done
      (loop $fill
        (br_if $done (i32.gt_s (local.get $i) (local.get $degree)))
        (local.set $child (call $algebraic_carve_zero_tree
          (i32.load (call $abs (local.get $degrees)))
          (i32.sub (local.get $depth) (i32.const 1))
          (i32.add (local.get $degrees) (i32.const 4))))
        (if (i32.and (i32.eqz (local.get $child))
              (i32.ne (i32.sub (local.get $depth) (i32.const 1)) (i32.const 0)))
          (then (return (i32.const 0))))
        (call $algebraic_poly_set_coefficient (local.get $poly) (local.get $i) (local.get $child))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $fill)))
    (local.get $poly)
  )

  ;; Descend $root (a level-$depth polynomial) along $exponents (an
  ;; array of $depth i32 indices, OUTERMOST level first — the SAME
  ;; order $algebraic_carve_zero_tree's $degrees used) and return the
  ;; ABSOLUTE MEMORY ADDRESS of the level-0 (bigint-header-slot)
  ;; ENTRY at that position — i.e. a pointer INTO the level-1 parent
  ;; polynomial's coefficient array, not the bigint itself, so the
  ;; caller can accumulate into it with plain i32.store. $root must
  ;; already be a fully-carved zero tree of sufficient degree at
  ;; every level (from $algebraic_carve_zero_tree with the same
  ;; degree bounds) — this function only walks, never grows.
  (func $algebraic_g_descend_slot (param $root i32) (param $depth i32) (param $exponents i32) (result i32)
    (local $index i32)
    (local $entry_addr i32)
    (if (i32.eq (local.get $depth) (i32.const 1))
      (then
        (local.set $index (i32.load (call $abs (local.get $exponents))))
        (return (call $abs (i32.add (local.get $root)
          (i32.add (i32.const 4) (i32.mul (local.get $index) (i32.const 4)))))))
      (else
        (local.set $index (i32.load (call $abs (local.get $exponents))))
        (return (call $algebraic_g_descend_slot
          (call $algebraic_poly_coefficient (local.get $root) (local.get $index))
          (i32.sub (local.get $depth) (i32.const 1))
          (i32.add (local.get $exponents) (i32.const 4))))))
    (i32.const 0)
  )

  ;; Build G (section 3.1): a level-(x-degree+1)... precisely, a
  ;; level-1 polynomial in x whose $degree+1 coefficients are each a
  ;; level-r polynomial (r = $registry_count), nested t_r (outermost)
  ;; down to t_1 (innermost) per $registry's order (index r-1 =
  ;; outermost = eliminated FIRST by the caller's loop, index 0 =
  ;; innermost = eliminated LAST). Every monomial's rational scalar is
  ;; cleared to an integer by ONE global LCM `L` over every scalar's
  ;; denominator across every coefficient slot (mirrors the r=1 path's
  ;; own clearing technique, generalized). Returns via $g_out (an
  ;; array of $degree+1 level-r polynomial pointers — the x-coefficients
  ;; of G, NOT a further-nested level-(r+2) nesting; the caller's
  ;; elimination loop indexes this array directly by x-power and never
  ;; needs G as one single polynomial object). 0 ok / 1 pressure.
  (func $algebraic_build_g
    (param $list i32) (param $degree i32)
    (param $registry i32) (param $registry_count i32) (param $max_exponents i32)
    (param $g_out i32)
    (result i32)
    (local $i i32)
    (local $slot i32)
    (local $slot_type i32)
    (local $inner_args i32)
    (local $term_data i32)
    (local $term_count i32)
    (local $term_index i32)
    (local $term_slot i32)
    (local $record i32)
    (local $status i32)
    (local $factor_count i32)
    (local $f i32)
    (local $alpha_header i32)
    (local $exponent i32)
    (local $index i32)
    (local $scalar i32)
    (local $common_multiple i32)
    (local $gcd i32)
    (local $degrees i32)
    (local $j i32)
    (local $exponents_scratch i32)
    (local $leaf_addr i32)
    (local $cleared i32)
    (local $existing i32)
    ;; One clearing multiple L: fold gcd/lcm over every monomial's
    ;; scalar denominator, across every term of every coefficient slot
    ;; (classify once here purely for the denominator; classified
    ;; again below to do the real fold — the r=1 path already accepts
    ;; this two-pass shape for its own single-alpha case).
    (local.set $common_multiple (call $bigint_one))
    (local.set $i (i32.const 0))
    (block $lcm_slots_done
      (loop $lcm_slots
        (br_if $lcm_slots_done (i32.gt_s (local.get $i) (local.get $degree)))
        (local.set $slot (i32.add (local.get $list) (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
        (local.set $slot_type (call $value_type (local.get $slot)))
        (if (i32.and
              (i32.eq (local.get $slot_type) (global.get $TYPE_EXPRESSION))
              (i32.eq
                (call $expression_head (call $value_data_lo (local.get $slot)))
                (call $symbol_registry_lookup
                  (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_ADD)))))
          (then
            (local.set $inner_args (call $expression_args (call $value_data_lo (local.get $slot))))
            (local.set $term_count (i32.load (call $abs (i32.add (local.get $inner_args) (i32.const 8)))))
            (local.set $term_data (i32.add
              (i32.load (call $abs (i32.add (local.get $inner_args) (i32.const 16))))
              (global.get $GC_HEADER_SIZE))))
          (else
            (local.set $term_data (local.get $slot))
            (local.set $term_count (i32.const 1))))
        (local.set $term_index (i32.const 0))
        (block $lcm_terms_done
          (loop $lcm_terms
            (br_if $lcm_terms_done (i32.ge_s (local.get $term_index) (local.get $term_count)))
            (local.set $term_slot (i32.add (local.get $term_data)
              (i32.mul (local.get $term_index) (global.get $VALUE_SIZE))))
            (if (call $expression_walk_guard (global.get $ALGEBRAIC_MONOMIAL_RECORD_SIZE))
              (then (return (i32.const 1))))
            (local.set $record (call $carve_scratch_blob (global.get $ALGEBRAIC_MONOMIAL_RECORD_SIZE)))
            (i32.store (call $abs (local.get $record))
              (call $rational_new (call $bigint_one) (call $bigint_one)))
            (i32.store (call $abs (i32.add (local.get $record) (i32.const 4))) (i32.const 0))
            (local.set $status (call $algebraic_classify_term (local.get $record) (local.get $term_slot)))
            (if (local.get $status) (then (return (i32.const 1))))
            (local.set $scalar (i32.load (call $abs (local.get $record))))
            (if (call $expression_walk_guard (i32.mul (i32.const 4)
                  (call $estimate_bigint_size (i32.add
                    (i32.add
                      (call $bigint_length (local.get $common_multiple))
                      (call $bigint_length (call $rational_denominator (local.get $scalar))))
                    (i32.const 2)))))
              (then (return (i32.const 1))))
            (local.set $gcd (call $algebraic_bigint_gcd_guarded
              (local.get $common_multiple) (call $rational_denominator (local.get $scalar))))
            (if (i32.eqz (local.get $gcd)) (then (return (i32.const 1))))
            (local.set $common_multiple (call $bigint_mul
              (call $bigint_div (local.get $common_multiple) (local.get $gcd))
              (call $rational_denominator (local.get $scalar))))
            (local.set $term_index (i32.add (local.get $term_index) (i32.const 1)))
            (br $lcm_terms)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $lcm_slots)))
    ;; Per-level degree array, OUTERMOST (t_r, registry index
    ;; registry_count-1) first, matching $algebraic_carve_zero_tree's
    ;; own $degrees convention.
    (local.set $degrees (call $carve_scratch_blob (i32.mul (local.get $registry_count) (i32.const 4))))
    (local.set $j (i32.const 0))
    (block $degrees_done
      (loop $degrees_fill
        (br_if $degrees_done (i32.ge_s (local.get $j) (local.get $registry_count)))
        (i32.store (call $abs (i32.add (local.get $degrees) (i32.mul (local.get $j) (i32.const 4))))
          (i32.load (call $abs (i32.add (local.get $max_exponents)
            (i32.mul (i32.sub (i32.sub (local.get $registry_count) (i32.const 1)) (local.get $j)) (i32.const 4))))))
        (local.set $j (i32.add (local.get $j) (i32.const 1)))
        (br $degrees_fill)))
    ;; Carve one zero tree per x-power, fold every monomial in.
    (local.set $exponents_scratch (call $carve_scratch_blob (i32.mul (local.get $registry_count) (i32.const 4))))
    (local.set $i (i32.const 0))
    (block $build_slots_done
      (loop $build_slots
        (br_if $build_slots_done (i32.gt_s (local.get $i) (local.get $degree)))
        (local.set $slot (i32.add (local.get $list) (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
        (local.set $slot_type (call $value_type (local.get $slot)))
        (if (i32.eqz (local.get $registry_count))
          (then
            ;; r = 0: G's x-coefficients are plain bigints (level-0),
            ;; not a tree — no algebraic values anywhere. Caller only
            ;; reaches $algebraic_build_g when $has_algebraic is true,
            ;; so this branch is not exercised by
            ;; algebraic_roots_of_polynomial today — but it must still
            ;; be CORRECT, not merely a placeholder: clear this slot's
            ;; own rational value by the SAME global L every algebraic
            ;; branch below uses, so a caller that ever does route
            ;; pure-rational input through this function gets the
            ;; right integer, not a silently-wrong zero.
            (if (i32.eq (local.get $slot_type) (global.get $TYPE_BIGINT))
              (then (i32.store (call $abs (i32.add (local.get $g_out) (i32.mul (local.get $i) (i32.const 4))))
                (call $bigint_mul (call $value_data_lo (local.get $slot)) (local.get $common_multiple))))
              (else
                (if (call $expression_walk_guard (i32.const 128)) (then (return (i32.const 1))))
                (local.set $scalar (call $rational_materialize (local.get $slot)))
                (if (call $expression_walk_guard (i32.mul (i32.const 4)
                      (call $estimate_bigint_size (i32.add
                        (i32.add
                          (call $bigint_length (call $rational_numerator (local.get $scalar)))
                          (call $bigint_length (local.get $common_multiple)))
                        (i32.const 4)))))
                  (then (return (i32.const 1))))
                (i32.store (call $abs (i32.add (local.get $g_out) (i32.mul (local.get $i) (i32.const 4))))
                  (call $bigint_mul
                    (call $rational_numerator (local.get $scalar))
                    (call $bigint_div (local.get $common_multiple)
                      (call $rational_denominator (local.get $scalar))))))))
          (else
            (i32.store (call $abs (i32.add (local.get $g_out) (i32.mul (local.get $i) (i32.const 4))))
              (call $algebraic_carve_zero_tree
                (i32.load (call $abs (local.get $degrees)))
                (local.get $registry_count) (i32.add (local.get $degrees) (i32.const 4))))
            (if (i32.eqz (i32.load (call $abs (i32.add (local.get $g_out) (i32.mul (local.get $i) (i32.const 4))))))
              (then (return (i32.const 1))))
            ;; Term-fold pass — classify every term of this slot and
            ;; accumulate into G's tree. Skipped entirely at r=0 (no
            ;; algebraic values anywhere): the branch above already
            ;; computed this slot's cleared integer value directly,
            ;; and there is no tree for $algebraic_g_descend_slot to
            ;; descend into at depth 0 (it expects a level->=1
            ;; polynomial, not a bare bigint).
            (if (i32.and
                  (i32.eq (local.get $slot_type) (global.get $TYPE_EXPRESSION))
                  (i32.eq
                    (call $expression_head (call $value_data_lo (local.get $slot)))
                    (call $symbol_registry_lookup
                      (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_ADD)))))
              (then
                (local.set $inner_args (call $expression_args (call $value_data_lo (local.get $slot))))
                (local.set $term_count (i32.load (call $abs (i32.add (local.get $inner_args) (i32.const 8)))))
                (local.set $term_data (i32.add
                  (i32.load (call $abs (i32.add (local.get $inner_args) (i32.const 16))))
                  (global.get $GC_HEADER_SIZE))))
              (else
                (local.set $term_data (local.get $slot))
                (local.set $term_count (i32.const 1))))
            (local.set $term_index (i32.const 0))
            (block $build_terms_done
              (loop $build_terms
                (br_if $build_terms_done (i32.ge_s (local.get $term_index) (local.get $term_count)))
                (local.set $term_slot (i32.add (local.get $term_data)
                  (i32.mul (local.get $term_index) (global.get $VALUE_SIZE))))
                (if (call $expression_walk_guard (global.get $ALGEBRAIC_MONOMIAL_RECORD_SIZE))
                  (then (return (i32.const 1))))
                (local.set $record (call $carve_scratch_blob (global.get $ALGEBRAIC_MONOMIAL_RECORD_SIZE)))
                (i32.store (call $abs (local.get $record))
                  (call $rational_new (call $bigint_one) (call $bigint_one)))
                (i32.store (call $abs (i32.add (local.get $record) (i32.const 4))) (i32.const 0))
                (local.set $status (call $algebraic_classify_term (local.get $record) (local.get $term_slot)))
                (if (local.get $status) (then (return (i32.const 1))))
                ;; Zero every exponents_scratch slot (a monomial may
                ;; omit some variables entirely — they get exponent 0).
                (local.set $j (i32.const 0))
                (block $zero_exp_done
                  (loop $zero_exp
                    (br_if $zero_exp_done (i32.ge_s (local.get $j) (local.get $registry_count)))
                    (i32.store (call $abs (i32.add (local.get $exponents_scratch) (i32.mul (local.get $j) (i32.const 4))))
                      (i32.const 0))
                    (local.set $j (i32.add (local.get $j) (i32.const 1)))
                    (br $zero_exp)))
                (local.set $factor_count (i32.load (call $abs (i32.add (local.get $record) (i32.const 4)))))
                (local.set $f (i32.const 0))
                (block $fill_exp_done
                  (loop $fill_exp
                    (br_if $fill_exp_done (i32.ge_s (local.get $f) (local.get $factor_count)))
                    (local.set $alpha_header (i32.load (call $abs (i32.add (local.get $record)
                      (i32.add (i32.const 8) (i32.mul (local.get $f) (i32.const 8)))))))
                    (local.set $exponent (i32.load (call $abs (i32.add (local.get $record)
                      (i32.add (i32.const 12) (i32.mul (local.get $f) (i32.const 8)))))))
                    (local.set $index (call $algebraic_registry_index_of
                      (local.get $registry) (local.get $registry_count) (local.get $alpha_header)))
                    (if (i32.lt_s (local.get $index) (i32.const 0)) (then (return (i32.const 1))))
                    ;; Position within $exponents_scratch: OUTERMOST
                    ;; (registry index registry_count-1) first, matching
                    ;; $degrees'/$algebraic_carve_zero_tree's convention.
                    (local.set $j (i32.sub (i32.sub (local.get $registry_count) (i32.const 1)) (local.get $index)))
                    (i32.store (call $abs (i32.add (local.get $exponents_scratch) (i32.mul (local.get $j) (i32.const 4))))
                      (local.get $exponent))
                    (local.set $f (i32.add (local.get $f) (i32.const 1)))
                    (br $fill_exp)))
                ;; Clear the scalar to an integer via L, then accumulate
                ;; into the leaf this monomial's exponent vector addresses.
                (local.set $scalar (i32.load (call $abs (local.get $record))))
                (if (call $expression_walk_guard (i32.mul (i32.const 4)
                      (call $estimate_bigint_size (i32.add
                        (i32.add
                          (call $bigint_length (call $rational_numerator (local.get $scalar)))
                          (call $bigint_length (local.get $common_multiple)))
                        (i32.const 4)))))
                  (then (return (i32.const 1))))
                (local.set $cleared (call $bigint_mul
                  (call $rational_numerator (local.get $scalar))
                  (call $bigint_div (local.get $common_multiple)
                    (call $rational_denominator (local.get $scalar)))))
                (local.set $leaf_addr (call $algebraic_g_descend_slot
                  (i32.load (call $abs (i32.add (local.get $g_out) (i32.mul (local.get $i) (i32.const 4)))))
                  (local.get $registry_count) (local.get $exponents_scratch)))
                (local.set $existing (i32.load (local.get $leaf_addr)))
                (if (call $expression_walk_guard (i32.mul (i32.const 2)
                      (call $estimate_bigint_size (i32.add
                        (i32.add (call $bigint_length (local.get $existing)) (call $bigint_length (local.get $cleared)))
                        (i32.const 2)))))
                  (then (return (i32.const 1))))
                (i32.store (local.get $leaf_addr) (call $bigint_add (local.get $existing) (local.get $cleared)))
                (local.set $term_index (i32.add (local.get $term_index) (i32.const 1)))
                (br $build_terms)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $build_slots)))
    (i32.const 0)
  )

  ;; Depth-generic content: gcd of every LEAF bigint across the whole
  ;; nested level-$depth structure (recursing through every level).
  ;; Section 3.2's ruling: content-stripping between elimination
  ;; steps is well-defined at any level (unlike squarefree
  ;; decomposition, which stays level-1-only, applied just once at
  ;; the very end via the EXISTING unmodified
  ;; $algebraic_poly_normalize_squarefree). 0 on pressure.
  (func $algebraic_npoly_content (param $poly i32) (param $depth i32) (result i32)
    (local $degree i32)
    (local $i i32)
    (local $content i32)
    (local $coefficient i32)
    (local $sub_content i32)
    (if (i32.eqz (local.get $depth))
      (then (return (call $bigint_length (local.get $poly)))))
    (local.set $degree (call $algebraic_poly_degree (local.get $poly)))
    (if (call $expression_walk_guard (i32.const 32)) (then (return (i32.const 0))))
    (local.set $content (call $bigint_zero))
    (local.set $i (i32.const 0))
    (block $done
      (loop $fold
        (br_if $done (i32.gt_s (local.get $i) (local.get $degree)))
        (local.set $coefficient (call $algebraic_poly_coefficient (local.get $poly) (local.get $i)))
        (if (i32.eq (local.get $depth) (i32.const 1))
          (then
            (if (i32.ne (call $bigint_length (local.get $coefficient)) (i32.const 0))
              (then
                (local.set $content (call $algebraic_bigint_gcd_guarded
                  (local.get $content) (local.get $coefficient)))
                (if (i32.eqz (local.get $content)) (then (return (i32.const 0)))))))
          (else
            (if (i32.ge_s (call $algebraic_poly_degree (local.get $coefficient)) (i32.const 0))
              (then
                (local.set $sub_content (call $algebraic_npoly_content
                  (local.get $coefficient) (i32.sub (local.get $depth) (i32.const 1))))
                (if (i32.eqz (local.get $sub_content)) (then (return (i32.const 0))))
                (local.set $content (call $algebraic_bigint_gcd_guarded
                  (local.get $content) (local.get $sub_content)))
                (if (i32.eqz (local.get $content)) (then (return (i32.const 0))))))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $fold)))
    (local.get $content)
  )
  ;; NOTE: the depth==0 branch above returns bigint_length (a byte
  ;; count), which is meaningless as a "content" bigint on its own —
  ;; depth 0 is unreachable in practice ($algebraic_npoly_content is
  ;; only ever called at depth>=1 by $algebraic_eliminate_multivariate
  ;; below, on N's CURRENT depth right after a resultant call, which
  ;; is always >=1 until the loop's final level-1 result, handled by
  ;; the existing $algebraic_poly_normalize_squarefree instead) — kept
  ;; as a defensive branch, not a real path, matching this file's
  ;; existing convention for r=0-shaped edge cases elsewhere in this
  ;; plan's functions.

  ;; Depth-generic scale-down: divide every LEAF bigint by $divisor
  ;; (positive), optionally negating, recursing through every level.
  ;; Direct depth-generic twin of $algebraic_poly_scale_down. 0 on
  ;; pressure.
  (func $algebraic_npoly_scale_down
    (param $poly i32) (param $depth i32) (param $divisor i32) (param $negate i32) (result i32)
    (local $degree i32)
    (local $result i32)
    (local $i i32)
    (local $coefficient i32)
    (local $scaled i32)
    (if (i32.eqz (local.get $depth))
      (then
        (local.set $scaled (call $bigint_div (local.get $poly) (local.get $divisor)))
        (if (local.get $negate) (then (local.set $scaled (call $algebraic_bigint_negate (local.get $scaled)))))
        (return (local.get $scaled))))
    (local.set $degree (call $algebraic_poly_degree (local.get $poly)))
    (local.set $result (call $algebraic_poly_carve (local.get $degree)))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (local.set $i (i32.const 0))
    (block $done
      (loop $scale
        (br_if $done (i32.gt_s (local.get $i) (local.get $degree)))
        (local.set $coefficient (call $algebraic_poly_coefficient (local.get $poly) (local.get $i)))
        (if (i32.eq (local.get $depth) (i32.const 1))
          (then
            (if (call $expression_walk_guard (i32.mul (i32.const 4)
                  (call $estimate_bigint_size (i32.add (call $bigint_length (local.get $coefficient)) (i32.const 2)))))
              (then (return (i32.const 0))))
            (local.set $scaled (call $bigint_div (local.get $coefficient) (local.get $divisor)))
            (if (local.get $negate) (then (local.set $scaled (call $algebraic_bigint_negate (local.get $scaled))))))
          (else
            (local.set $scaled (call $algebraic_npoly_scale_down
              (local.get $coefficient) (i32.sub (local.get $depth) (i32.const 1))
              (local.get $divisor) (local.get $negate)))
            (if (i32.and (i32.eqz (local.get $scaled))
                  (i32.ge_s (call $algebraic_poly_degree (local.get $coefficient)) (i32.const 0)))
              (then (return (i32.const 0))))))
        (call $algebraic_poly_set_coefficient (local.get $result) (local.get $i) (local.get $scaled))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $scale)))
    (local.get $result)
  )

  ;; Content-strip N at $depth: divide every leaf by content(N),
  ;; matching $algebraic_poly_primitive's sign convention (leading
  ;; coefficient stays positive — $negate flips every leaf if the
  ;; CURRENT leading coefficient, read via repeated descent to index
  ;; $degree at every level, is negative). Degree <= 0 (constant or
  ;; zero) passes through unchanged, matching
  ;; $algebraic_poly_primitive's own early return. 0 on pressure.
  (func $algebraic_npoly_content_strip (param $poly i32) (param $depth i32) (result i32)
    (local $degree i32)
    (local $content i32)
    (local $leading i32)
    (local $d i32)
    (if (i32.lt_s (call $algebraic_poly_degree (local.get $poly)) (i32.const 0))
      (then (return (local.get $poly))))
    (local.set $content (call $algebraic_npoly_content (local.get $poly) (local.get $depth)))
    (if (i32.eqz (local.get $content)) (then (return (i32.const 0))))
    ;; Leading-coefficient sign: descend to the highest-index entry at
    ;; every level down to a bigint leaf.
    (local.set $leading (local.get $poly))
    (local.set $d (local.get $depth))
    (block $descend_done
      (loop $descend
        (br_if $descend_done (i32.eqz (local.get $d)))
        (local.set $degree (call $algebraic_poly_degree (local.get $leading)))
        (local.set $leading (call $algebraic_poly_coefficient (local.get $leading) (local.get $degree)))
        (local.set $d (i32.sub (local.get $d) (i32.const 1)))
        (br $descend)))
    (call $algebraic_npoly_scale_down (local.get $poly) (local.get $depth) (local.get $content)
      (call $bigint_sign (local.get $leading)))
  )

  ;; Lift p_alpha's defining polynomial (a flat array of integer
  ;; coefficients, from $algebraic_coefficients_of — level-0 leaves)
  ;; to a level-$depth polynomial with CONSTANT coefficients (every
  ;; level below the outermost is a degree-0 poly wrapping the same
  ;; leaf) — the generalization of the r=1 path's own "A(t) = p_α(t)
  ;; with constant coefficients" lift (interpreter.wat, the
  ;; $a_typoly construction) to however many levels sit below the
  ;; eliminated variable's own position. 0 on pressure.
  (func $algebraic_lift_defining_poly (param $alpha_header i32) (param $depth i32) (result i32)
    (local $alpha_poly i32)
    (local $lifted i32)
    (local $zero_const i32)
    (local $i i32)
    (local $numerator i32)
    (local $wrapped i32)
    (local $j i32)
    (local.set $alpha_poly (call $algebraic_poly_from_array
      (call $algebraic_coefficients_of (local.get $alpha_header))))
    (if (i32.eqz (local.get $alpha_poly)) (then (return (i32.const 0))))
    (local.set $lifted (call $algebraic_poly_carve (call $algebraic_poly_degree (local.get $alpha_poly))))
    (if (i32.eqz (local.get $lifted)) (then (return (i32.const 0))))
    (local.set $zero_const (call $algebraic_npoly_zero (i32.sub (local.get $depth) (i32.const 1))))
    (local.set $i (i32.const 0))
    (block $lift_done
      (loop $lift
        (br_if $lift_done (i32.gt_s (local.get $i) (call $algebraic_poly_degree (local.get $alpha_poly))))
        (local.set $numerator (call $algebraic_poly_coefficient (local.get $alpha_poly) (local.get $i)))
        (if (i32.eqz (call $bigint_length (local.get $numerator)))
          (then (call $algebraic_poly_set_coefficient (local.get $lifted) (local.get $i) (local.get $zero_const)))
          (else
            ;; Wrap $numerator as a CONSTANT at every one of the
            ;; (depth-1) levels below this one: a chain of degree-0
            ;; polys, each one's sole coefficient being the PREVIOUS
            ;; wrap (bottoming out at $numerator itself, a bigint leaf).
            (local.set $wrapped (local.get $numerator))
            (local.set $j (i32.const 1))
            (block $wrap_done
              (loop $wrap
                (br_if $wrap_done (i32.ge_s (local.get $j) (local.get $depth)))
                (local.set $wrapped (call $algebraic_poly_carve (i32.const 0)))
                (if (i32.eqz (local.get $wrapped)) (then (return (i32.const 0))))
                (call $algebraic_poly_set_coefficient (local.get $wrapped) (i32.const 0) (local.get $numerator))
                (local.set $numerator (local.get $wrapped))
                (local.set $j (i32.add (local.get $j) (i32.const 1)))
                (br $wrap)
              )
            )
            (call $algebraic_poly_set_coefficient (local.get $lifted) (local.get $i) (local.get $wrapped))
          )
        )
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $lift)
      )
    )
    (local.get $lifted)
  )

  ;; Transpose the outer two levels of a level-$depth polynomial: $m
  ;; is level-$depth with variable X outermost (degree $x_degree),
  ;; each coefficient $m.coefficient(i) a level-($depth-1) polynomial
  ;; with variable T outermost (degree $t_degree). Returns a fresh
  ;; level-$depth polynomial with T outermost (degree $t_degree) whose
  ;; coefficients are level-($depth-1) polynomials with X outermost
  ;; (degree $x_degree) — i.e. result.coefficient(k).coefficient(i) ==
  ;; m.coefficient(i).coefficient(k) for every (i, k). $depth must be
  ;; >= 2 ($m's own coefficients must themselves be polynomials, not
  ;; bigint leaves). Missing/short coefficients on either side read as
  ;; the zero entry at that level (via $algebraic_npoly_zero), exactly
  ;; like $algebraic_poly_coefficient's own out-of-range behavior. Used
  ;; by $algebraic_eliminate_multivariate to bring the CURRENT
  ;; elimination target to the outer position before every
  ;; $algebraic_npoly_resultant call, since $algebraic_build_g places
  ;; every t_i outermost WITHIN each x-power slot, not across slots.
  ;; 0 on pressure.
  (func $algebraic_npoly_transpose_outer
    (param $m i32) (param $x_degree i32) (param $t_degree i32) (param $depth i32)
    (result i32)
    (local $result i32)
    (local $k i32)
    (local $i i32)
    (local $bucket i32)
    (local $x_coefficient i32)
    (local $t_coefficient i32)
    (local.set $result (call $algebraic_poly_carve (local.get $t_degree)))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (local.set $k (i32.const 0))
    (block $k_done
      (loop $k_loop
        (br_if $k_done (i32.gt_s (local.get $k) (local.get $t_degree)))
        (if (call $expression_walk_guard (i32.mul
              (i32.add (local.get $x_degree) (i32.const 2)) (i32.const 4)))
          (then (return (i32.const 0))))
        (local.set $bucket (call $algebraic_poly_carve (local.get $x_degree)))
        (if (i32.eqz (local.get $bucket)) (then (return (i32.const 0))))
        (local.set $i (i32.const 0))
        (block $i_done
          (loop $i_loop
            (br_if $i_done (i32.gt_s (local.get $i) (local.get $x_degree)))
            (local.set $x_coefficient (call $algebraic_poly_coefficient (local.get $m) (local.get $i)))
            (if (i32.lt_s (call $algebraic_poly_degree (local.get $x_coefficient)) (local.get $k))
              (then (local.set $t_coefficient (call $algebraic_npoly_zero (i32.sub (local.get $depth) (i32.const 2)))))
              (else (local.set $t_coefficient (call $algebraic_poly_coefficient (local.get $x_coefficient) (local.get $k)))))
            (call $algebraic_poly_set_coefficient (local.get $bucket) (local.get $i) (local.get $t_coefficient))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $i_loop)))
        (call $algebraic_npoly_trim (local.get $bucket) (i32.sub (local.get $depth) (i32.const 1)))
        (call $algebraic_poly_set_coefficient (local.get $result) (local.get $k) (local.get $bucket))
        (local.set $k (i32.add (local.get $k) (i32.const 1)))
        (br $k_loop)))
    (local.get $result)
  )

  ;; =====================================================================
  ;; apoly: rational-coefficient dense univariate polynomials
  ;; use rational value headers as coefficients.
  ;;
  ;; Same blob shape as $algebraic_poly_carve ([degree:4][entry0:4]...]),
  ;; but every entry is a TYPE_RATIONAL VALUE HEADER (a $rational_new
  ;; result), never a raw bigint. This is a genuinely distinct
  ;; coefficient domain from $algebraic_poly_*/$algebraic_npoly_*
  ;; (both bigint-leaf families) -- these polynomials represent
  ;; elements of ℚ[x]/(p_gamma), the primitive-element rewrite
  ;; coefficients, which are honest fractions, not integers.
  ;;
  ;; Reuses $algebraic_poly_carve/_degree/_coefficient/_set_coefficient/
  ;; _trim directly (the blob shape and header-degree convention are
  ;; identical; those accessors are already depth/type-agnostic i32
  ;; load/store). Only the ARITHMETIC needs new, rational-aware
  ;; functions -- $algebraic_poly_trim's own zero-check
  ;; (bigint_length==0) is WRONG for apoly leaves (a rational header
  ;; is never a bigint), so apoly has its own trim.
  ;; =====================================================================

  ;; A rational entry is zero iff its numerator's bigint_length is 0
  ;; (rational_new's own zero-numerator canonicalization guarantees
  ;; the denominator is bigint_one() whenever the value is zero, so
  ;; checking the numerator alone is sufficient and matches
  ;; $rational_materialize's own zero-test convention elsewhere).
  (func $algebraic_apoly_entry_is_zero (param $entry i32) (result i32)
    (i32.eqz (call $bigint_length (call $rational_numerator (local.get $entry))))
  )

  ;; Depth-generic-style trim, but for the single-level rational
  ;; coefficient domain: drop leading zero RATIONAL entries.
  (func $algebraic_apoly_trim (param $poly i32)
    (local $degree i32)
    (local.set $degree (call $algebraic_poly_degree (local.get $poly)))
    (block $done
      (loop $trim
        (br_if $done (i32.lt_s (local.get $degree) (i32.const 0)))
        (br_if $done (i32.eqz (call $algebraic_apoly_entry_is_zero
          (call $algebraic_poly_coefficient (local.get $poly) (local.get $degree)))))
        (local.set $degree (i32.sub (local.get $degree) (i32.const 1)))
        (br $trim)))
    (call $algebraic_poly_set_degree (local.get $poly) (local.get $degree))
  )

  ;; Carve a fresh degree-$degree apoly with every entry the rational
  ;; zero (0/1). 0 on pressure.
  (func $algebraic_apoly_zero_poly (param $degree i32) (result i32)
    (local $result i32)
    (local $zero_rational i32)
    (local $i i32)
    (local.set $result (call $algebraic_poly_carve (local.get $degree)))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (if (call $expression_walk_guard (i32.mul (i32.add (local.get $degree) (i32.const 1)) (i32.const 16)))
      (then (return (i32.const 0))))
    (local.set $zero_rational (call $rational_new (call $bigint_zero) (call $bigint_one)))
    (local.set $i (i32.const 0))
    (block $done
      (loop $fill
        (br_if $done (i32.gt_s (local.get $i) (local.get $degree)))
        (call $algebraic_poly_set_coefficient (local.get $result) (local.get $i) (local.get $zero_rational))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $fill)))
    (local.get $result)
  )

  ;; Wrap a single rational as a degree-0 apoly. 0 on pressure.
  (func $algebraic_apoly_from_rational (param $rational i32) (result i32)
    (local $result i32)
    (local.set $result (call $algebraic_poly_carve (i32.const 0)))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (call $algebraic_poly_set_coefficient (local.get $result) (i32.const 0) (local.get $rational))
    (call $algebraic_apoly_trim (local.get $result))
    (local.get $result)
  )

  ;; Materialize a persistent frozen coordinate Array as a scratch apoly.
  ;; Coordinate entries are ordinary Rational VALUEs. 0 on pressure.
  (func $algebraic_apoly_from_coordinates_array (param $coordinates_array i32) (result i32)
    (local $length i32)
    (local $data i32)
    (local $result i32)
    (local $i i32)
    (local.set $length (i32.load (call $abs (i32.add (local.get $coordinates_array) (i32.const 8)))))
    (if (i32.eqz (local.get $length)) (then (unreachable)))
    (local.set $result (call $algebraic_poly_carve (i32.sub (local.get $length) (i32.const 1))))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (local.set $data (i32.add
      (i32.load (call $abs (i32.add (local.get $coordinates_array) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (local.set $i (i32.const 0))
    (block $done
      (loop $copy
        (br_if $done (i32.ge_u (local.get $i) (local.get $length)))
        (call $algebraic_poly_set_coefficient (local.get $result) (local.get $i)
          (call $rational_materialize
            (i32.add (local.get $data) (i32.mul (local.get $i) (global.get $VALUE_SIZE)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $copy)))
    (call $algebraic_apoly_trim (local.get $result))
    (local.get $result)
  )

  ;; Freeze a scratch apoly as a persistent coordinate Array. The zero
  ;; polynomial is stored canonically as the one-entry array [0]. 0 on
  ;; pressure.
  (func $algebraic_coordinates_array_from_apoly (param $poly i32) (result i32)
    (local $degree i32)
    (local $length i32)
    (local $coordinates_array i32)
    (local $data i32)
    (local $coefficient i32)
    (local $i i32)
    (local.set $degree (call $algebraic_poly_degree (local.get $poly)))
    (local.set $length (i32.add
      (if (result i32) (i32.lt_s (local.get $degree) (i32.const 0))
        (then (i32.const 0))
        (else (local.get $degree)))
      (i32.const 1)))
    (if (call $expression_walk_guard (i32.add
          (call $estimate_array_size (local.get $length)) (i32.const 32)))
      (then (return (i32.const 0))))
    (local.set $coordinates_array (call $allocate_array (local.get $length)))
    (local.set $data (i32.add
      (i32.load (call $abs (i32.add (local.get $coordinates_array) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (local.set $i (i32.const 0))
    (block $done
      (loop $store
        (br_if $done (i32.ge_u (local.get $i) (local.get $length)))
        (if (i32.lt_s (local.get $degree) (i32.const 0))
          (then
            (local.set $coefficient (call $rational_new (call $bigint_zero) (call $bigint_one))))
          (else
            (local.set $coefficient
              (call $algebraic_poly_coefficient (local.get $poly) (local.get $i)))))
        (call $write_value
          (i32.add (local.get $data) (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
          (global.get $TYPE_RATIONAL) (i32.const 0) (local.get $coefficient) (i32.const 0))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $store)))
    (call $expression_freeze_args_array (local.get $coordinates_array))
    (local.get $coordinates_array)
  )

  ;; a + b, both apolys. 0 on pressure.
  (func $algebraic_apoly_add (param $a i32) (param $b i32) (result i32)
    (local $degree_a i32)
    (local $degree_b i32)
    (local $degree i32)
    (local $result i32)
    (local $i i32)
    (local $sum i32)
    (local.set $degree_a (call $algebraic_poly_degree (local.get $a)))
    (local.set $degree_b (call $algebraic_poly_degree (local.get $b)))
    (local.set $degree (local.get $degree_a))
    (if (i32.gt_s (local.get $degree_b) (local.get $degree)) (then (local.set $degree (local.get $degree_b))))
    (if (i32.lt_s (local.get $degree) (i32.const 0)) (then (return (call $algebraic_poly_carve (i32.const -1)))))
    (local.set $result (call $algebraic_poly_carve (local.get $degree)))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (local.set $i (i32.const 0))
    (block $done
      (loop $add
        (br_if $done (i32.gt_s (local.get $i) (local.get $degree)))
        (if (i32.gt_s (local.get $i) (local.get $degree_a))
          (then (local.set $sum (call $algebraic_poly_coefficient (local.get $b) (local.get $i))))
          (else
            (if (i32.gt_s (local.get $i) (local.get $degree_b))
              (then (local.set $sum (call $algebraic_poly_coefficient (local.get $a) (local.get $i))))
              (else
                (if (call $expression_walk_guard (i32.const 64))
                  (then (return (i32.const 0))))
                (local.set $sum (call $rational_add
                  (call $algebraic_poly_coefficient (local.get $a) (local.get $i))
                  (call $algebraic_poly_coefficient (local.get $b) (local.get $i))))))))
        (call $algebraic_poly_set_coefficient (local.get $result) (local.get $i) (local.get $sum))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $add)))
    (call $algebraic_apoly_trim (local.get $result))
    (local.get $result)
  )

  ;; a - b, both apolys. 0 on pressure.
  (func $algebraic_apoly_sub (param $a i32) (param $b i32) (result i32)
    (local $degree_a i32)
    (local $degree_b i32)
    (local $degree i32)
    (local $result i32)
    (local $i i32)
    (local $zero i32)
    (local $diff i32)
    (local.set $degree_a (call $algebraic_poly_degree (local.get $a)))
    (local.set $degree_b (call $algebraic_poly_degree (local.get $b)))
    (local.set $degree (local.get $degree_a))
    (if (i32.gt_s (local.get $degree_b) (local.get $degree)) (then (local.set $degree (local.get $degree_b))))
    (if (i32.lt_s (local.get $degree) (i32.const 0)) (then (return (call $algebraic_poly_carve (i32.const -1)))))
    (local.set $result (call $algebraic_poly_carve (local.get $degree)))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (local.set $zero (call $rational_new (call $bigint_zero) (call $bigint_one)))
    (local.set $i (i32.const 0))
    (block $done
      (loop $sub
        (br_if $done (i32.gt_s (local.get $i) (local.get $degree)))
        (if (call $expression_walk_guard (i32.const 64))
          (then (return (i32.const 0))))
        (if (i32.gt_s (local.get $i) (local.get $degree_a))
          (then (local.set $diff (call $rational_sub (local.get $zero)
            (call $algebraic_poly_coefficient (local.get $b) (local.get $i)))))
          (else
            (if (i32.gt_s (local.get $i) (local.get $degree_b))
              (then (local.set $diff (call $algebraic_poly_coefficient (local.get $a) (local.get $i))))
              (else (local.set $diff (call $rational_sub
                (call $algebraic_poly_coefficient (local.get $a) (local.get $i))
                (call $algebraic_poly_coefficient (local.get $b) (local.get $i))))))))
        (call $algebraic_poly_set_coefficient (local.get $result) (local.get $i) (local.get $diff))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $sub)))
    (call $algebraic_apoly_trim (local.get $result))
    (local.get $result)
  )

  ;; a * b, both apolys. 0 on pressure.
  (func $algebraic_apoly_mul (param $a i32) (param $b i32) (result i32)
    (local $degree_a i32)
    (local $degree_b i32)
    (local $result i32)
    (local $i i32)
    (local $j i32)
    (local $ca i32)
    (local $cb i32)
    (local $accumulator i32)
    (local $zero i32)
    (local.set $degree_a (call $algebraic_poly_degree (local.get $a)))
    (local.set $degree_b (call $algebraic_poly_degree (local.get $b)))
    (if (i32.or (i32.lt_s (local.get $degree_a) (i32.const 0)) (i32.lt_s (local.get $degree_b) (i32.const 0)))
      (then (return (call $algebraic_poly_carve (i32.const -1)))))
    (local.set $zero (call $rational_new (call $bigint_zero) (call $bigint_one)))
    (local.set $result (call $algebraic_apoly_zero_poly (i32.add (local.get $degree_a) (local.get $degree_b))))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (local.set $i (i32.const 0))
    (block $rows_done
      (loop $rows
        (br_if $rows_done (i32.gt_s (local.get $i) (local.get $degree_a)))
        (local.set $ca (call $algebraic_poly_coefficient (local.get $a) (local.get $i)))
        (if (i32.eqz (call $algebraic_apoly_entry_is_zero (local.get $ca)))
          (then
            (local.set $j (i32.const 0))
            (block $cols_done
              (loop $cols
                (br_if $cols_done (i32.gt_s (local.get $j) (local.get $degree_b)))
                (local.set $cb (call $algebraic_poly_coefficient (local.get $b) (local.get $j)))
                (if (i32.eqz (call $algebraic_apoly_entry_is_zero (local.get $cb)))
                  (then
                    (if (call $expression_walk_guard (i32.const 96))
                      (then (return (i32.const 0))))
                    (local.set $accumulator (call $algebraic_poly_coefficient
                      (local.get $result) (i32.add (local.get $i) (local.get $j))))
                    (call $algebraic_poly_set_coefficient (local.get $result) (i32.add (local.get $i) (local.get $j))
                      (call $rational_add (local.get $accumulator) (call $rational_mul (local.get $ca) (local.get $cb))))))
                (local.set $j (i32.add (local.get $j) (i32.const 1)))
                (br $cols)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $rows)))
    (call $algebraic_apoly_trim (local.get $result))
    (local.get $result)
  )

  ;; Polynomial long division remainder: f mod m (m must be nonzero,
  ;; i.e. degree(m) >= 0). Standard schoolbook division over the FIELD
  ;; ℚ (exact division at every step -- no fraction-free tricks
  ;; needed, unlike the bigint-only families, since rational
  ;; coefficients are already a field). Returns the remainder
  ;; (degree < degree(m)), a FRESH apoly. 0 on pressure.
  (func $algebraic_apoly_mod (param $f i32) (param $m i32) (result i32)
    (local $degree_m i32)
    (local $remainder i32)
    (local $degree_r i32)
    (local $lead_m i32)
    (local $lead_r i32)
    (local $factor i32)
    (local $shift i32)
    (local $shifted_coefficient i32)
    (local $new_coefficient i32)
    (local $i i32)
    (local.set $degree_m (call $algebraic_poly_degree (local.get $m)))
    (if (i32.lt_s (local.get $degree_m) (i32.const 0)) (then (unreachable)))
    (local.set $lead_m (call $algebraic_poly_coefficient (local.get $m) (local.get $degree_m)))
    (local.set $remainder (call $algebraic_apoly_zero_poly (call $algebraic_poly_degree (local.get $f))))
    (if (i32.eqz (local.get $remainder)) (then (return (i32.const 0))))
    (local.set $i (i32.const 0))
    (block $copy_done
      (loop $copy
        (br_if $copy_done (i32.gt_s (local.get $i) (call $algebraic_poly_degree (local.get $f))))
        (call $algebraic_poly_set_coefficient (local.get $remainder) (local.get $i)
          (call $algebraic_poly_coefficient (local.get $f) (local.get $i)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $copy)))
    (call $algebraic_apoly_trim (local.get $remainder))
    (block $reduce_done
      (loop $reduce
        (local.set $degree_r (call $algebraic_poly_degree (local.get $remainder)))
        (br_if $reduce_done (i32.lt_s (local.get $degree_r) (local.get $degree_m)))
        (local.set $lead_r (call $algebraic_poly_coefficient (local.get $remainder) (local.get $degree_r)))
        (if (call $expression_walk_guard (i32.const 64))
          (then (return (i32.const 0))))
        (local.set $factor (call $rational_new
          (call $bigint_mul (call $rational_numerator (local.get $lead_r)) (call $rational_denominator (local.get $lead_m)))
          (call $bigint_mul (call $rational_denominator (local.get $lead_r)) (call $rational_numerator (local.get $lead_m)))))
        (local.set $shift (i32.sub (local.get $degree_r) (local.get $degree_m)))
        (local.set $i (i32.const 0))
        (block $sub_done
          (loop $sub
            (br_if $sub_done (i32.gt_s (local.get $i) (local.get $degree_m)))

            (if (call $expression_walk_guard (i32.const 64))
              (then (return (i32.const 0))))
            (local.set $shifted_coefficient (call $rational_mul (local.get $factor)
              (call $algebraic_poly_coefficient (local.get $m) (local.get $i))))
            (local.set $new_coefficient (call $rational_sub
              (call $algebraic_poly_coefficient (local.get $remainder) (i32.add (local.get $i) (local.get $shift)))
              (local.get $shifted_coefficient)))
            (call $algebraic_poly_set_coefficient (local.get $remainder) (i32.add (local.get $i) (local.get $shift))
              (local.get $new_coefficient))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $sub)))
        (call $algebraic_apoly_trim (local.get $remainder))
        (br $reduce)))
    (local.get $remainder)
  )

  ;; Return this value's reduced coordinates in its effective field. A zero
  ;; coordinate pointer is the standalone-generator identity polynomial x.
  ;; 0 on pressure.
  (func $algebraic_field_coordinates_apoly (param $header i32) (result i32)
    (local $coordinates_array i32)
    (local $identity i32)
    (local.set $coordinates_array (call $algebraic_field_coordinates_of (local.get $header)))
    (if (local.get $coordinates_array)
      (then (return (call $algebraic_apoly_from_coordinates_array (local.get $coordinates_array)))))
    (local.set $identity (call $algebraic_apoly_zero_poly (i32.const 1)))
    (if (i32.eqz (local.get $identity)) (then (return (i32.const 0))))
    (call $algebraic_poly_set_coefficient (local.get $identity) (i32.const 1)
      (call $rational_new (call $bigint_one) (call $bigint_one)))
    (local.get $identity)
  )

  ;; Res_y(p_gamma(y), D*x - D*A(y)); squarefree but not necessarily
  ;; irreducible. D clears the retained coordinate denominators. 0 pressure.
  (func $algebraic_field_element_resultant (param $header i32) (result i32)
    (local $generator i32) (local $coordinates i32) (local $modulus i32)
    (local $modulus_degree i32) (local $coordinates_degree i32)
    (local $denominator_product i32) (local $coefficient i32)
    (local $scaled_coefficient i32) (local $modulus_ypoly i32)
    (local $relation_ypoly i32) (local $x_polynomial i32)
    (local $zero_polynomial i32) (local $resultant i32) (local $i i32)
    (local.set $generator (call $algebraic_field_generator_of (local.get $header)))
    (local.set $coordinates (call $algebraic_field_coordinates_apoly (local.get $header)))
    (if (i32.eqz (local.get $coordinates)) (then (return (i32.const 0))))
    (local.set $modulus (call $algebraic_poly_from_array
      (call $algebraic_coefficients_of (local.get $generator))))
    (if (i32.eqz (local.get $modulus)) (then (return (i32.const 0))))
    (local.set $modulus_degree (call $algebraic_poly_degree (local.get $modulus)))
    (local.set $coordinates_degree (call $algebraic_poly_degree (local.get $coordinates)))
    (local.set $denominator_product (call $bigint_one))
    (local.set $i (i32.const 0))
    (block $denominators_done
      (loop $denominators
        (br_if $denominators_done (i32.gt_s (local.get $i) (local.get $coordinates_degree)))
        (if (call $expression_walk_guard (i32.const 64)) (then (return (i32.const 0))))
        (local.set $denominator_product (call $bigint_mul
          (local.get $denominator_product)
          (call $rational_denominator
            (call $algebraic_poly_coefficient (local.get $coordinates) (local.get $i)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $denominators)))
    (local.set $zero_polynomial (call $algebraic_poly_carve (i32.const -1)))
    (if (i32.eqz (local.get $zero_polynomial)) (then (return (i32.const 0))))
    (local.set $modulus_ypoly (call $algebraic_poly_carve (local.get $modulus_degree)))
    (if (i32.eqz (local.get $modulus_ypoly)) (then (return (i32.const 0))))
    (local.set $i (i32.const 0))
    (block $modulus_done
      (loop $modulus_loop
        (br_if $modulus_done (i32.gt_s (local.get $i) (local.get $modulus_degree)))
        (local.set $coefficient
          (call $algebraic_poly_coefficient (local.get $modulus) (local.get $i)))
        (if (i32.eqz (call $bigint_length (local.get $coefficient)))
          (then (call $algebraic_poly_set_coefficient
            (local.get $modulus_ypoly) (local.get $i) (local.get $zero_polynomial)))
          (else
            (local.set $x_polynomial (call $algebraic_poly_carve (i32.const 0)))
            (if (i32.eqz (local.get $x_polynomial)) (then (return (i32.const 0))))
            (call $algebraic_poly_set_coefficient
              (local.get $x_polynomial) (i32.const 0) (local.get $coefficient))
            (call $algebraic_poly_set_coefficient
              (local.get $modulus_ypoly) (local.get $i) (local.get $x_polynomial))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $modulus_loop)))
    (local.set $relation_ypoly (call $algebraic_poly_carve (local.get $coordinates_degree)))
    (if (i32.eqz (local.get $relation_ypoly)) (then (return (i32.const 0))))
    (local.set $i (i32.const 0))
    (block $relation_done
      (loop $relation_loop
        (br_if $relation_done (i32.gt_s (local.get $i) (local.get $coordinates_degree)))
        (if (call $expression_walk_guard (i32.const 96)) (then (return (i32.const 0))))
        (local.set $coefficient
          (call $algebraic_poly_coefficient (local.get $coordinates) (local.get $i)))
        (local.set $scaled_coefficient (call $algebraic_bigint_negate
          (call $bigint_mul
            (call $rational_numerator (local.get $coefficient))
            (call $bigint_div
              (local.get $denominator_product)
              (call $rational_denominator (local.get $coefficient))))))
        (local.set $x_polynomial (call $algebraic_poly_carve
          (select (i32.const 1) (i32.const 0) (i32.eqz (local.get $i)))))
        (if (i32.eqz (local.get $x_polynomial)) (then (return (i32.const 0))))
        (call $algebraic_poly_set_coefficient
          (local.get $x_polynomial) (i32.const 0) (local.get $scaled_coefficient))
        (if (i32.eqz (local.get $i))
          (then (call $algebraic_poly_set_coefficient
            (local.get $x_polynomial) (i32.const 1) (local.get $denominator_product))))
        (call $algebraic_poly_set_coefficient
          (local.get $relation_ypoly) (local.get $i) (local.get $x_polynomial))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $relation_loop)))
    (local.set $resultant
      (call $algebraic_ypoly_resultant (local.get $modulus_ypoly) (local.get $relation_ypoly)))
    (if (i32.eqz (local.get $resultant)) (then (return (i32.const 0))))
    (call $algebraic_poly_normalize_squarefree (local.get $resultant))
  )

  ;; Evaluate retained rational coordinates over gamma's current rational
  ;; interval with outward-exact interval Horner arithmetic. Writes low/high
  ;; rational headers to raw i32 output slots. 0 ok / 1 pressure.
  (func $algebraic_field_element_interval
    (param $header i32) (param $low_out i32) (param $high_out i32) (result i32)
    (local $generator i32) (local $coordinates i32) (local $degree i32)
    (local $interval_array i32) (local $interval_data i32)
    (local $gamma_low i32) (local $gamma_high i32)
    (local $low i32) (local $high i32) (local $coefficient i32)
    (local $product1 i32) (local $product2 i32)
    (local $product3 i32) (local $product4 i32)
    (local $candidate i32) (local $i i32)
    (local.set $generator (call $algebraic_field_generator_of (local.get $header)))
    (local.set $coordinates (call $algebraic_field_coordinates_apoly (local.get $header)))
    (if (i32.eqz (local.get $coordinates)) (then (return (i32.const 1))))
    (local.set $degree (call $algebraic_poly_degree (local.get $coordinates)))
    (local.set $interval_array (call $algebraic_interval_of (local.get $generator)))
    (local.set $interval_data (i32.add
      (i32.load (call $abs (i32.add (local.get $interval_array) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (local.set $gamma_low (call $rational_materialize (local.get $interval_data)))
    (local.set $gamma_high (call $rational_materialize
      (i32.add (local.get $interval_data) (global.get $VALUE_SIZE))))
    (local.set $coefficient
      (call $algebraic_poly_coefficient (local.get $coordinates) (local.get $degree)))
    (local.set $low (local.get $coefficient))
    (local.set $high (local.get $coefficient))
    (local.set $i (i32.sub (local.get $degree) (i32.const 1)))
    (block $horner_done
      (loop $horner
        (br_if $horner_done (i32.lt_s (local.get $i) (i32.const 0)))
        (if (call $expression_walk_guard (i32.const 320))
          (then (return (i32.const 1))))
        (local.set $product1 (call $rational_mul (local.get $low) (local.get $gamma_low)))
        (local.set $product2 (call $rational_mul (local.get $low) (local.get $gamma_high)))
        (local.set $product3 (call $rational_mul (local.get $high) (local.get $gamma_low)))
        (local.set $product4 (call $rational_mul (local.get $high) (local.get $gamma_high)))
        (local.set $low (local.get $product1))
        (local.set $high (local.get $product1))
        (local.set $candidate (local.get $product2))
        (if (i32.lt_s (call $rational_header_pair_compare
              (local.get $candidate) (local.get $low)) (i32.const 0))
          (then (local.set $low (local.get $candidate))))
        (if (i32.gt_s (call $rational_header_pair_compare
              (local.get $candidate) (local.get $high)) (i32.const 0))
          (then (local.set $high (local.get $candidate))))
        (local.set $candidate (local.get $product3))
        (if (i32.lt_s (call $rational_header_pair_compare
              (local.get $candidate) (local.get $low)) (i32.const 0))
          (then (local.set $low (local.get $candidate))))
        (if (i32.gt_s (call $rational_header_pair_compare
              (local.get $candidate) (local.get $high)) (i32.const 0))
          (then (local.set $high (local.get $candidate))))
        (local.set $candidate (local.get $product4))
        (if (i32.lt_s (call $rational_header_pair_compare
              (local.get $candidate) (local.get $low)) (i32.const 0))
          (then (local.set $low (local.get $candidate))))
        (if (i32.gt_s (call $rational_header_pair_compare
              (local.get $candidate) (local.get $high)) (i32.const 0))
          (then (local.set $high (local.get $candidate))))
        (local.set $coefficient
          (call $algebraic_poly_coefficient (local.get $coordinates) (local.get $i)))
        (local.set $low (call $rational_add (local.get $low) (local.get $coefficient)))
        (local.set $high (call $rational_add (local.get $high) (local.get $coefficient)))
        (local.set $i (i32.sub (local.get $i) (i32.const 1)))
        (br $horner)))
    (i32.store (call $abs (local.get $low_out)) (local.get $low))
    (i32.store (call $abs (local.get $high_out)) (local.get $high))
    (i32.const 0)
  )

  ;; Populate the standalone polynomial/interval cache of a field-backed
  ;; value on demand. Cache publication occurs only after a complete minted
  ;; value exists, so pressure retries never expose a half-built cache.
  ;; 0 ok / 1 pressure.
  (func $algebraic_materialize_standalone_cache (param $header i32) (result i32)
    (local $resultant i32) (local $factors_out i32) (local $factor_count i32)
    (local $factor i32) (local $candidate i32) (local $matches i32)
    (local $low_out i32) (local $high_out i32)
    (local $low i32) (local $high i32)
    (local $chain i32) (local $variations_low i32)
    (local $variations_high i32) (local $root_count i32)
    (local $generator i32) (local $round i32) (local $i i32)
    (local $temporary_slot i32) (local $status i32) (local $minted_header i32)
    (if (i32.load (call $abs
          (i32.add (local.get $header) (global.get $GC_HEADER_SIZE))))
      (then (return (i32.const 0))))
    (local.set $resultant
      (call $algebraic_field_element_resultant (local.get $header)))
    (if (i32.eqz (local.get $resultant)) (then (return (i32.const 1))))
    (local.set $factors_out (call $carve_scratch_blob (i32.mul (i32.const 16) (i32.const 4))))
    (local.set $factor_count (call $algebraic_zz_zassenhaus
      (local.get $resultant) (local.get $factors_out) (i32.const 16)))
    (if (i32.eq (local.get $factor_count) (i32.const -1))
      (then (return (i32.const 1))))
    (if (i32.lt_s (local.get $factor_count) (i32.const 1)) (then (unreachable)))
    (local.set $low_out (call $carve_scratch_blob (i32.const 4)))
    (local.set $high_out (call $carve_scratch_blob (i32.const 4)))
    (local.set $generator (call $algebraic_field_generator_of (local.get $header)))
    (local.set $round (i32.const 0))
    (block $selected
      (loop $select
        (if (i32.ge_s (local.get $round) (i32.const 256)) (then (unreachable)))
        (if (call $algebraic_field_element_interval
              (local.get $header) (local.get $low_out) (local.get $high_out))
          (then (return (i32.const 1))))
        (local.set $low (i32.load (call $abs (local.get $low_out))))
        (local.set $high (i32.load (call $abs (local.get $high_out))))
        (local.set $matches (i32.const 0))
        (local.set $factor (i32.const 0))
        (local.set $i (i32.const 0))
        (block $scan_done
          (loop $scan
            (br_if $scan_done (i32.ge_s (local.get $i) (local.get $factor_count)))
            (local.set $candidate (i32.load (call $abs
              (i32.add (local.get $factors_out) (i32.mul (local.get $i) (i32.const 4))))))
            (local.set $chain (call $algebraic_sturm_build (local.get $candidate)))
            (if (i32.eqz (local.get $chain)) (then (return (i32.const 1))))
            (local.set $variations_low (call $algebraic_variations_at
              (local.get $chain)
              (call $rational_numerator (local.get $low))
              (call $rational_denominator (local.get $low))))
            (if (i32.lt_s (local.get $variations_low) (i32.const 0))
              (then (return (i32.const 1))))
            (local.set $variations_high (call $algebraic_variations_at
              (local.get $chain)
              (call $rational_numerator (local.get $high))
              (call $rational_denominator (local.get $high))))
            (if (i32.lt_s (local.get $variations_high) (i32.const 0))
              (then (return (i32.const 1))))
            (local.set $root_count
              (i32.sub (local.get $variations_low) (local.get $variations_high)))
            (if (i32.eq (local.get $root_count) (i32.const 1))
              (then
                (local.set $factor (local.get $candidate))
                (local.set $matches (i32.add (local.get $matches) (i32.const 1)))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $scan)))
        (br_if $selected (i32.eq (local.get $matches) (i32.const 1)))
        (if (call $algebraic_refine_step (local.get $generator))
          (then (return (i32.const 1))))
        (local.set $round (i32.add (local.get $round) (i32.const 1)))
        (br $select)))
    (local.set $temporary_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (local.set $status (call $algebraic_mint_poly_interval
      (local.get $factor) (local.get $low) (local.get $high)
      (i32.const 1) (local.get $temporary_slot)))
    (if (local.get $status) (then (return (local.get $status))))
    (if (i32.ne (call $value_type (local.get $temporary_slot)) (global.get $TYPE_ALGEBRAIC))
      (then (unreachable)))
    (local.set $minted_header (call $value_data_lo (local.get $temporary_slot)))
    (i32.store (call $abs
      (i32.add (local.get $header) (global.get $GC_HEADER_SIZE)))
      (i32.load (call $abs
        (i32.add (local.get $minted_header) (global.get $GC_HEADER_SIZE)))))
    (i32.store (call $abs (i32.add (local.get $header) (i32.const 12)))
      (i32.load (call $abs (i32.add (local.get $minted_header) (i32.const 12)))))
    (i32.const 0)
  )

  ;; Commit a non-rational field element without eagerly deriving its
  ;; standalone polynomial. Accessors materialize that cache on demand.
  ;; 0 ok / 1 pressure.
  (func $algebraic_mint_lazy_field_element
    (param $generator i32) (param $coordinates i32) (param $out_slot i32)
    (result i32)
    (local $coordinates_array i32)
    (local $header i32)
    (local.set $coordinates_array
      (call $algebraic_coordinates_array_from_apoly (local.get $coordinates)))
    (if (i32.eqz (local.get $coordinates_array)) (then (return (i32.const 1))))
    (local.set $header
      (call $algebraic_allocate (i32.const 0) (i32.const 0)))
    (i32.store (call $abs (i32.add (local.get $header) (i32.const 16)))
      (local.get $generator))
    (i32.store (call $abs (i32.add (local.get $header) (i32.const 20)))
      (local.get $coordinates_array))
    (call $write_value (local.get $out_slot)
      (global.get $TYPE_ALGEBRAIC) (i32.const 0) (local.get $header) (i32.const 0))
    (i32.const 0)
  )

  ;; Attach a shared-field representation to an already-minted standalone
  ;; result. This is construction-time mutation before the result escapes.
  ;; Rational results need no field metadata. 0 ok / 1 pressure.
  (func $algebraic_attach_field_coordinates
    (param $out_slot i32) (param $generator i32) (param $coordinates i32)
    (result i32)
    (local $header i32)
    (local $coordinates_array i32)
    (if (i32.ne (call $value_type (local.get $out_slot)) (global.get $TYPE_ALGEBRAIC))
      (then (return (i32.const 0))))
    (local.set $coordinates_array
      (call $algebraic_coordinates_array_from_apoly (local.get $coordinates)))
    (if (i32.eqz (local.get $coordinates_array)) (then (return (i32.const 1))))
    (local.set $header (call $value_data_lo (local.get $out_slot)))
    (i32.store (call $abs (i32.add (local.get $header) (i32.const 16)))
      (local.get $generator))
    (i32.store (call $abs (i32.add (local.get $header) (i32.const 20)))
      (local.get $coordinates_array))
    (i32.const 0)
  )

  ;; Merge two distinct effective fields once, rewrite both operands into
  ;; the merged generator, and retain that field on the lazy result.
  (func $algebraic_compose_different_fields
    (param $a_header i32) (param $b_header i32) (param $kind i32) (param $out_slot i32)
    (result i32)
    (local $registry i32)
    (local $representations i32)
    (local $gamma_out i32)
    (local $gamma i32)
    (local $a_coordinates i32)
    (local $b_coordinates i32)
    (local $a_merged i32)
    (local $b_merged i32)
    (local $combined i32)
    (local $modulus_bigint i32)
    (local $modulus i32)
    (local $status i32)
    (local $combined_degree i32)
    (local.set $registry (call $carve_scratch_blob (i32.const 8)))
    (local.set $representations (call $carve_scratch_blob (i32.const 8)))
    (local.set $gamma_out (call $carve_scratch_blob (i32.const 4)))
    (i32.store (call $abs (local.get $registry))
      (call $algebraic_field_generator_of (local.get $a_header)))
    (i32.store (call $abs (i32.add (local.get $registry) (i32.const 4)))
      (call $algebraic_field_generator_of (local.get $b_header)))
    (local.set $status (call $algebraic_build_primitive_element
      (local.get $registry) (i32.const 2)
      (local.get $gamma_out) (local.get $representations)))
    (if (local.get $status) (then (return (local.get $status))))
    (local.set $gamma (i32.load (call $abs (local.get $gamma_out))))
    (local.set $modulus_bigint (call $algebraic_poly_from_array
      (call $algebraic_coefficients_of (local.get $gamma))))
    (if (i32.eqz (local.get $modulus_bigint)) (then (return (i32.const 1))))
    (local.set $modulus (call $algebraic_apoly_from_bigint_poly (local.get $modulus_bigint)))
    (if (i32.eqz (local.get $modulus)) (then (return (i32.const 1))))
    (local.set $a_coordinates (call $algebraic_field_coordinates_apoly (local.get $a_header)))
    (if (i32.eqz (local.get $a_coordinates)) (then (return (i32.const 1))))
    (local.set $b_coordinates (call $algebraic_field_coordinates_apoly (local.get $b_header)))
    (if (i32.eqz (local.get $b_coordinates)) (then (return (i32.const 1))))
    (local.set $a_merged (call $algebraic_apoly_horner_eval
      (local.get $a_coordinates)
      (i32.load (call $abs (local.get $representations)))
      (local.get $modulus)))
    (if (i32.eqz (local.get $a_merged)) (then (return (i32.const 1))))
    (local.set $b_merged (call $algebraic_apoly_horner_eval
      (local.get $b_coordinates)
      (i32.load (call $abs (i32.add (local.get $representations) (i32.const 4))))
      (local.get $modulus)))
    (if (i32.eqz (local.get $b_merged)) (then (return (i32.const 1))))
    (if (i32.eqz (local.get $kind))
      (then (local.set $combined (call $algebraic_apoly_add
        (local.get $a_merged) (local.get $b_merged))))
      (else (local.set $combined (call $algebraic_apoly_mul
        (local.get $a_merged) (local.get $b_merged)))))
    (if (i32.eqz (local.get $combined)) (then (return (i32.const 1))))
    (local.set $combined (call $algebraic_apoly_mod (local.get $combined) (local.get $modulus)))
    (if (i32.eqz (local.get $combined)) (then (return (i32.const 1))))
    (local.set $combined_degree (call $algebraic_poly_degree (local.get $combined)))
    (if (i32.lt_s (local.get $combined_degree) (i32.const 0))
      (then
        (call $write_inline_rational (local.get $out_slot) (i64.const 0))
        (return (i32.const 0))))
    (if (i32.eqz (local.get $combined_degree))
      (then
        (call $write_value (local.get $out_slot)
          (global.get $TYPE_RATIONAL) (i32.const 0)
          (call $algebraic_poly_coefficient (local.get $combined) (i32.const 0))
          (i32.const 0))
        (return (i32.const 0))))
    (call $algebraic_mint_lazy_field_element
      (local.get $gamma) (local.get $combined) (local.get $out_slot))
  )
  ;; Compose operands already known to share one field by reduced coordinate
  ;; arithmetic. Standalone polynomial data is materialized only on demand.
  ;; kind 0 sum / 1 product. 0 ok / 1 pressure.
  (func $algebraic_compose_same_field
    (param $a_header i32) (param $b_header i32) (param $kind i32) (param $out_slot i32)
    (result i32)
    (local $generator i32)
    (local $a_coordinates i32)
    (local $b_coordinates i32)
    (local $combined i32)
    (local $modulus_bigint i32)
    (local $modulus i32)
    (local $status i32)
    (local $combined_degree i32)
    (local.set $generator (call $algebraic_field_generator_of (local.get $a_header)))
    (local.set $a_coordinates (call $algebraic_field_coordinates_apoly (local.get $a_header)))
    (if (i32.eqz (local.get $a_coordinates)) (then (return (i32.const 1))))
    (local.set $b_coordinates (call $algebraic_field_coordinates_apoly (local.get $b_header)))
    (if (i32.eqz (local.get $b_coordinates)) (then (return (i32.const 1))))
    (if (i32.eqz (local.get $kind))
      (then (local.set $combined
        (call $algebraic_apoly_add (local.get $a_coordinates) (local.get $b_coordinates))))
      (else
        (local.set $combined
          (call $algebraic_apoly_mul (local.get $a_coordinates) (local.get $b_coordinates)))))
    (if (i32.eqz (local.get $combined)) (then (return (i32.const 1))))
    (local.set $modulus_bigint (call $algebraic_poly_from_array
      (call $algebraic_coefficients_of (local.get $generator))))
    (if (i32.eqz (local.get $modulus_bigint)) (then (return (i32.const 1))))
    (local.set $modulus (call $algebraic_apoly_from_bigint_poly (local.get $modulus_bigint)))
    (if (i32.eqz (local.get $modulus)) (then (return (i32.const 1))))
    (local.set $combined (call $algebraic_apoly_mod (local.get $combined) (local.get $modulus)))
    (if (i32.eqz (local.get $combined)) (then (return (i32.const 1))))
    (local.set $combined_degree (call $algebraic_poly_degree (local.get $combined)))
    ;; A field operation can collapse exactly to Q. Return the canonical
    ;; Rational immediately instead of constructing, isolating, and factoring
    ;; a resultant whose selected root is already known.
    (if (i32.lt_s (local.get $combined_degree) (i32.const 0))
      (then
        (call $write_inline_rational (local.get $out_slot) (i64.const 0))
        (return (i32.const 0))))
    (if (i32.eqz (local.get $combined_degree))
      (then
        (call $write_value (local.get $out_slot)
          (global.get $TYPE_RATIONAL) (i32.const 0)
          (call $algebraic_poly_coefficient (local.get $combined) (i32.const 0))
          (i32.const 0))
        (return (i32.const 0))))
    (call $algebraic_mint_lazy_field_element
      (local.get $generator) (local.get $combined) (local.get $out_slot))
  )

  ;; Ordinary (non-fraction-free) Euclidean GCD over ℚ[x]: rational
  ;; coefficients make every step an exact division, so no Bareiss/
  ;; subresultant bookkeeping is needed, unlike the bigint-only
  ;; families elsewhere in this file. Returns a MONIC gcd (leading
  ;; coefficient normalized to 1) for a canonical result -- callers
  ;; needing the rewrite root (section 1's gcd(h, p_alpha) step)
  ;; divide by the (monic) linear factor's own coefficients directly.
  ;; 0 on pressure.
  (func $algebraic_apoly_gcd (param $a i32) (param $b i32) (result i32)
    (local $x i32)
    (local $y i32)
    (local $remainder i32)
    (local $degree_y i32)
    (local $lead i32)
    (local $inverse_lead i32)
    (local $result i32)
    (local $i i32)
    (local.set $x (local.get $a))
    (local.set $y (local.get $b))
    (block $done
      (loop $euclid
        (br_if $done (i32.lt_s (call $algebraic_poly_degree (local.get $y)) (i32.const 0)))
        (if (call $expression_walk_guard (i32.const 32))
          (then (return (i32.const 0))))
        (local.set $remainder (call $algebraic_apoly_mod (local.get $x) (local.get $y)))
        (if (i32.eqz (local.get $remainder))
          (then
            (if (i32.ge_s (call $algebraic_poly_degree (local.get $x)) (i32.const 0)) (then (return (i32.const 0))))))
        (local.set $x (local.get $y))
        (local.set $y (local.get $remainder))
        (br $euclid)))
    (local.set $degree_y (call $algebraic_poly_degree (local.get $x)))
    (if (i32.lt_s (local.get $degree_y) (i32.const 0)) (then (return (local.get $x))))
    (local.set $lead (call $algebraic_poly_coefficient (local.get $x) (local.get $degree_y)))
    (local.set $inverse_lead (call $rational_new
      (call $rational_denominator (local.get $lead)) (call $rational_numerator (local.get $lead))))
    (local.set $result (call $algebraic_apoly_zero_poly (local.get $degree_y)))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (local.set $i (i32.const 0))
    (block $normalize_done
      (loop $normalize
        (br_if $normalize_done (i32.gt_s (local.get $i) (local.get $degree_y)))
        (if (call $expression_walk_guard (i32.const 64))
          (then (return (i32.const 0))))
        (call $algebraic_poly_set_coefficient (local.get $result) (local.get $i)
          (call $rational_mul (local.get $inverse_lead) (call $algebraic_poly_coefficient (local.get $x) (local.get $i))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $normalize)))
    (local.get $result)
  )

  ;; Extended Euclidean algorithm over ℚ[x]: find u, v with
  ;; u*a + v*b = gcd(a,b) (monic). Writes u to $u_out, v to $v_out (raw
  ;; scratch i32 slots the caller owns), returns the (monic) gcd
  ;; itself. Used for modular inverse: when b = an irreducible modulus
  ;; and gcd(a,b) = 1, u IS a's inverse mod b. 0 on pressure.
  (func $algebraic_apoly_extended_gcd
    (param $a i32) (param $b i32) (param $u_out i32) (param $v_out i32)
    (result i32)
    (local $old_r i32) (local $r i32)
    (local $old_s i32) (local $s i32)
    (local $old_t i32) (local $t i32)
    (local $quotient i32)
    (local $remainder i32)
    (local $degree_r i32) (local $degree_old_r i32)
    (local $lead i32)
    (local $q_times_r i32)
    (local $q_times_t i32)
    (local $q_times_s i32)
    (local $one_apoly i32)
    (local $zero_apoly i32)
    (local $inverse_lead i32)
    (local $i i32)
    (local $result i32)
    (local $prev_r i32) (local $prev_s i32) (local $prev_t i32)
    (local.set $one_apoly (call $algebraic_apoly_zero_poly (i32.const 0)))
    (if (i32.eqz (local.get $one_apoly)) (then (return (i32.const 0))))
    (call $algebraic_poly_set_coefficient (local.get $one_apoly) (i32.const 0)
      (call $rational_new (call $bigint_one) (call $bigint_one)))
    (local.set $zero_apoly (call $algebraic_apoly_zero_poly (i32.const -1)))
    (if (i32.eqz (local.get $zero_apoly)) (then (return (i32.const 0))))
    (local.set $old_r (local.get $a)) (local.set $r (local.get $b))
    (local.set $old_s (local.get $one_apoly)) (local.set $s (local.get $zero_apoly))
    (local.set $old_t (local.get $zero_apoly)) (local.set $t (local.get $one_apoly))
    (block $euclid_done
      (loop $euclid
        (br_if $euclid_done (i32.lt_s (call $algebraic_poly_degree (local.get $r)) (i32.const 0)))
        (if (call $expression_walk_guard (i32.const 32))
          (then (return (i32.const 0))))
        (local.set $degree_old_r (call $algebraic_poly_degree (local.get $old_r)))
        (local.set $degree_r (call $algebraic_poly_degree (local.get $r)))
        ;; quotient of old_r / r via the SAME division-with-remainder
        ;; mechanics as $algebraic_apoly_mod, built term-by-term so the
        ;; quotient polynomial itself is captured (mod alone discards it).
        ;; deg(old_r) can be LESS than deg(r) here (e.g. the very first
        ;; call with deg(a) < deg(b), matching how ordinary long
        ;; division degrades to "quotient 0, remainder old_r" in that
        ;; case) -- algebraic_poly_carve only treats -1 as the safe
        ;; empty/zero sentinel, so the quotient's degree must be
        ;; clamped there, never carved with an arbitrary negative
        ;; value (carving degree -4, for instance, computes a negative
        ;; byte size and corrupts memory -- confirmed live via this
        ;; exact case, sqrt2's gcd(c1=degree-0, p_gamma=degree-4)).
        (local.set $quotient (call $algebraic_apoly_zero_poly
          (select (i32.const -1) (i32.sub (local.get $degree_old_r) (local.get $degree_r))
            (i32.lt_s (local.get $degree_old_r) (local.get $degree_r)))))
        (if (i32.eqz (local.get $quotient)) (then (return (i32.const 0))))
        (local.set $remainder (call $algebraic_apoly_zero_poly (local.get $degree_old_r)))
        (if (i32.eqz (local.get $remainder)) (then (return (i32.const 0))))
        (local.set $i (i32.const 0))
        (block $copy_done
          (loop $copy
            (br_if $copy_done (i32.gt_s (local.get $i) (local.get $degree_old_r)))
            (call $algebraic_poly_set_coefficient (local.get $remainder) (local.get $i)
              (call $algebraic_poly_coefficient (local.get $old_r) (local.get $i)))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $copy)))
        (call $algebraic_apoly_trim (local.get $remainder))
        (local.set $lead (call $algebraic_poly_coefficient (local.get $r) (local.get $degree_r)))
        (local.set $inverse_lead (call $rational_new
          (call $rational_denominator (local.get $lead)) (call $rational_numerator (local.get $lead))))
        (block $reduce_done
          (loop $reduce
            (local.set $degree_old_r (call $algebraic_poly_degree (local.get $remainder)))
            (br_if $reduce_done (i32.lt_s (local.get $degree_old_r) (local.get $degree_r)))
            (if (call $expression_walk_guard (i32.const 64))
              (then (return (i32.const 0))))
            (local.set $lead (call $rational_mul (local.get $inverse_lead)
              (call $algebraic_poly_coefficient (local.get $remainder) (local.get $degree_old_r))))
            (call $algebraic_poly_set_coefficient (local.get $quotient)
              (i32.sub (local.get $degree_old_r) (local.get $degree_r)) (local.get $lead))
            (local.set $i (i32.const 0))
            (block $sub_done
              (loop $sub
                (br_if $sub_done (i32.gt_s (local.get $i) (local.get $degree_r)))
                (call $algebraic_poly_set_coefficient (local.get $remainder)
                  (i32.add (local.get $i) (i32.sub (local.get $degree_old_r) (local.get $degree_r)))
                  (call $rational_sub
                    (call $algebraic_poly_coefficient (local.get $remainder)
                      (i32.add (local.get $i) (i32.sub (local.get $degree_old_r) (local.get $degree_r))))
                    (call $rational_mul (local.get $lead)
                      (call $algebraic_poly_coefficient (local.get $r) (local.get $i)))))
                (local.set $i (i32.add (local.get $i) (i32.const 1)))
                (br $sub)))
            (call $algebraic_apoly_trim (local.get $remainder))
            (br $reduce)))
        (call $algebraic_apoly_trim (local.get $quotient))
        (local.set $q_times_r (local.get $remainder))
        (local.set $q_times_s (call $algebraic_apoly_mul (local.get $quotient) (local.get $s)))
        (if (i32.eqz (local.get $q_times_s))
          (then (if (i32.ge_s (call $algebraic_poly_degree (local.get $s)) (i32.const 0)) (then (return (i32.const 0))))))
        (local.set $q_times_t (call $algebraic_apoly_mul (local.get $quotient) (local.get $t)))
        (if (i32.eqz (local.get $q_times_t))
          (then (if (i32.ge_s (call $algebraic_poly_degree (local.get $t)) (i32.const 0)) (then (return (i32.const 0))))))
        ;; Standard extended-Euclidean simultaneous update
        ;; (old_r,r) := (r, old_r - q*r); same for s, t. $q_times_r
        ;; is ALREADY old_r - quotient*r (it's exactly $remainder from
        ;; the division above, not quotient*r alone) so the new r is
        ;; that value directly, with NO further subtraction -- unlike
        ;; s/t, which still need old_s - quotient*s / old_t -
        ;; quotient*t computed here. Every read of old_r/old_s/old_t
        ;; MUST happen before any of them are overwritten (the earlier,
        ;; buggy version overwrote old_s before reading it for the new
        ;; s, corrupting every Bezout coefficient past the first step
        ;; — confirmed against SymPy's own dup_gcdex doctest example,
        ;; which is where this bug was actually caught).
        (local.set $prev_r (local.get $r)) (local.set $prev_s (local.get $s)) (local.set $prev_t (local.get $t))
        (local.set $r (local.get $q_times_r))
        (local.set $s (call $algebraic_apoly_sub (local.get $old_s) (local.get $q_times_s)))
        (if (i32.eqz (local.get $s))
          (then (if (i32.ge_s (call $algebraic_poly_degree (local.get $old_s)) (i32.const 0)) (then (return (i32.const 0))))))
        (local.set $t (call $algebraic_apoly_sub (local.get $old_t) (local.get $q_times_t)))
        (if (i32.eqz (local.get $t))
          (then (if (i32.ge_s (call $algebraic_poly_degree (local.get $old_t)) (i32.const 0)) (then (return (i32.const 0))))))
        (local.set $old_r (local.get $prev_r)) (local.set $old_s (local.get $prev_s)) (local.set $old_t (local.get $prev_t))
        (br $euclid)))
    ;; old_r is the gcd (unnormalized); normalize to monic, scaling
    ;; old_s/old_t by the same inverse-leading-coefficient factor.
    (local.set $degree_r (call $algebraic_poly_degree (local.get $old_r)))
    (if (i32.lt_s (local.get $degree_r) (i32.const 0))
      (then
        (i32.store (call $abs (local.get $u_out)) (local.get $old_s))
        (i32.store (call $abs (local.get $v_out)) (local.get $old_t))
        (return (local.get $old_r))))
    (local.set $lead (call $algebraic_poly_coefficient (local.get $old_r) (local.get $degree_r)))
    (local.set $inverse_lead (call $rational_new
      (call $rational_denominator (local.get $lead)) (call $rational_numerator (local.get $lead))))
    (local.set $result (call $algebraic_apoly_zero_poly (local.get $degree_r)))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (local.set $i (i32.const 0))
    (block $normalize_done
      (loop $normalize
        (br_if $normalize_done (i32.gt_s (local.get $i) (local.get $degree_r)))
        (call $algebraic_poly_set_coefficient (local.get $result) (local.get $i)
          (call $rational_mul (local.get $inverse_lead) (call $algebraic_poly_coefficient (local.get $old_r) (local.get $i))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $normalize)))
    (i32.store (call $abs (local.get $u_out)) (call $algebraic_apoly_scale (local.get $old_s) (local.get $inverse_lead)))
    (i32.store (call $abs (local.get $v_out)) (call $algebraic_apoly_scale (local.get $old_t) (local.get $inverse_lead)))
    (local.get $result)
  )

  ;; Scale every coefficient of an apoly by a fixed rational. 0 on
  ;; pressure.
  (func $algebraic_apoly_scale (param $poly i32) (param $scalar i32) (result i32)
    (local $degree i32)
    (local $result i32)
    (local $i i32)
    (local.set $degree (call $algebraic_poly_degree (local.get $poly)))
    (local.set $result (call $algebraic_apoly_zero_poly (local.get $degree)))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (local.set $i (i32.const 0))
    (block $done
      (loop $scale
        (br_if $done (i32.gt_s (local.get $i) (local.get $degree)))
        (if (call $expression_walk_guard (i32.const 64))
          (then (return (i32.const 0))))
        (call $algebraic_poly_set_coefficient (local.get $result) (local.get $i)
          (call $rational_mul (local.get $scalar) (call $algebraic_poly_coefficient (local.get $poly) (local.get $i))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $scale)))
    (local.get $result)
  )

  ;; Lift a bigint-coefficient depth-1 poly (e.g. an AlgebraicNumber's
  ;; own coefficients_array, or an existing $algebraic_poly_* result)
  ;; into an apoly: wrap every bigint coefficient as rational_new(c, 1).
  ;; 0 on pressure.
  (func $algebraic_apoly_from_bigint_poly (param $poly i32) (result i32)
    (local $degree i32)
    (local $result i32)
    (local $i i32)
    (local.set $degree (call $algebraic_poly_degree (local.get $poly)))
    (local.set $result (call $algebraic_apoly_zero_poly (local.get $degree)))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (local.set $i (i32.const 0))
    (block $done
      (loop $lift
        (br_if $done (i32.gt_s (local.get $i) (local.get $degree)))
        (if (call $expression_walk_guard (i32.const 32))
          (then (return (i32.const 0))))
        (call $algebraic_poly_set_coefficient (local.get $result) (local.get $i)
          (call $rational_new (call $algebraic_poly_coefficient (local.get $poly) (local.get $i)) (call $bigint_one)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $lift)))
    (local.get $result)
  )

  ;; Lift a bigint-coefficient polynomial (in x) to a modpoly (each
  ;; coefficient wrapped as a constant, degree-0 apoly -- rational
  ;; numbers are trivially K-elements). This lifts the rational-coefficient
  ;; eliminant $norm, whose roots are the candidates, into the same
  ;; modpoly family as the Horner filter accumulator, so
  ;; $algebraic_modpoly_mod can reduce accumulator degree after every
  ;; multiply. Returns 0 on pressure.

  (func $algebraic_modpoly_from_bigint_poly (param $poly i32) (result i32)
    (local $degree i32)
    (local $result i32)
    (local $i i32)
    (local $constant i32)
    (local.set $degree (call $algebraic_poly_degree (local.get $poly)))
    (local.set $result (call $algebraic_poly_carve (local.get $degree)))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (local.set $i (i32.const 0))
    (block $done
      (loop $lift
        (br_if $done (i32.gt_s (local.get $i) (local.get $degree)))
        (if (call $expression_walk_guard (i32.const 32))
          (then (return (i32.const 0))))
        (local.set $constant (call $algebraic_apoly_from_rational
          (call $rational_new (call $algebraic_poly_coefficient (local.get $poly) (local.get $i)) (call $bigint_one))))
        (if (i32.eqz (local.get $constant)) (then (return (i32.const 0))))
        (call $algebraic_poly_set_coefficient (local.get $result) (local.get $i) (local.get $constant))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $lift)))
    (call $algebraic_modpoly_trim (local.get $result))
    (local.get $result)
  )

  ;; =====================================================================
  ;; Primitive-element compression builds gamma = sum(s_i * alpha_i)
  ;; and rewrites each alpha_i as a polynomial in gamma.

  ;; =====================================================================

  ;; Res_y(p_a(y), p_b(x - s*y)) for an integer multiplier $s: the SAME
  ;; binomial-expansion Taylor-shift $algebraic_compose_binary's own
  ;; kind=0 (sum) branch already uses for s=1, generalized with an
  ;; extra s^i factor per term (coefficient of y^k in p_b(x-s*y) is
  ;; Sum_i q_{k+i}*C(k+i,k)*(-s)^i*x^i — the (-1)^k*C(k+i,k) binomial
  ;; part is UNCHANGED from the s=1 case; only the extra (-s)^i/(-1)^i
  ;; = s^i scaling is new). Returns the RAW resultant (trimmed, NOT
  ;; squarefree-normalized — the caller decides what a non-squarefree
  ;; result means). 0 on pressure.
  (func $algebraic_shift_sum_resultant
    (param $pa i32) (param $pb i32) (param $s i32) (result i32)
    (local $m i32)
    (local $n i32)
    (local $a_ypoly i32)
    (local $b_ypoly i32)
    (local $zero_poly i32)
    (local $xk i32)
    (local $i i32)
    (local $k i32)
    (local $binomial i32)
    (local $s_power i32)
    (local $s_bigint i32)
    (local $coefficient i32)
    (local $term i32)
    (local $resultant i32)
    (local.set $m (call $algebraic_poly_degree (local.get $pa)))
    (local.set $n (call $algebraic_poly_degree (local.get $pb)))
    (local.set $s_bigint (call $bigint_from_i64 (i64.extend_i32_s (local.get $s))))
    (local.set $a_ypoly (call $algebraic_poly_carve (local.get $m)))
    (if (i32.eqz (local.get $a_ypoly)) (then (return (i32.const 0))))
    (local.set $zero_poly (call $algebraic_poly_carve (i32.const -1)))
    (if (i32.eqz (local.get $zero_poly)) (then (return (i32.const 0))))
    (local.set $i (i32.const 0))
    (block $lift_done
      (loop $lift
        (br_if $lift_done (i32.gt_s (local.get $i) (local.get $m)))
        (local.set $coefficient (call $algebraic_poly_coefficient (local.get $pa) (local.get $i)))
        (if (i32.eqz (call $bigint_length (local.get $coefficient)))
          (then (call $algebraic_poly_set_coefficient
            (local.get $a_ypoly) (local.get $i) (local.get $zero_poly)))
          (else
            (local.set $xk (call $algebraic_poly_carve (i32.const 0)))
            (if (i32.eqz (local.get $xk)) (then (return (i32.const 0))))
            (call $algebraic_poly_set_coefficient (local.get $xk) (i32.const 0) (local.get $coefficient))
            (call $algebraic_poly_set_coefficient (local.get $a_ypoly) (local.get $i) (local.get $xk))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $lift)))
    (local.set $b_ypoly (call $algebraic_poly_carve (local.get $n)))
    (if (i32.eqz (local.get $b_ypoly)) (then (return (i32.const 0))))
    ;; p_b(x - s*y); coefficient of y^k is
    ;; Sum_i q_{k+i}*C(k+i,k)*(-1)^k*s^i*x^i.
    (local.set $k (i32.const 0))
    (block $shift_done
      (loop $shift
        (br_if $shift_done (i32.gt_s (local.get $k) (local.get $n)))
        (local.set $xk (call $algebraic_poly_carve (i32.sub (local.get $n) (local.get $k))))
        (if (i32.eqz (local.get $xk)) (then (return (i32.const 0))))
        (if (call $expression_walk_guard (i32.const 32))
          (then (return (i32.const 0))))
        (local.set $binomial (call $bigint_one))
        (local.set $s_power (call $bigint_one))
        (local.set $i (i32.const 0))
        (block $row_done
          (loop $row
            (br_if $row_done (i32.gt_s (local.get $i) (i32.sub (local.get $n) (local.get $k))))
            (if (i32.gt_s (local.get $i) (i32.const 0))
              (then
                (if (call $expression_walk_guard (i32.mul (i32.const 4)
                      (call $estimate_bigint_size (i32.add
                        (call $bigint_length (local.get $binomial)) (i32.const 3)))))
                  (then (return (i32.const 0))))
                (local.set $binomial (call $bigint_div
                  (call $bigint_mul (local.get $binomial)
                    (call $bigint_from_i64 (i64.extend_i32_s
                      (i32.add (local.get $k) (local.get $i)))))
                  (call $bigint_from_i64 (i64.extend_i32_s (local.get $i)))))
                (if (call $expression_walk_guard (i32.mul (i32.const 3)
                      (call $estimate_bigint_size (i32.add
                        (call $bigint_length (local.get $s_power))
                        (call $bigint_length (local.get $s_bigint))))))
                  (then (return (i32.const 0))))
                (local.set $s_power (call $bigint_mul (local.get $s_power) (local.get $s_bigint)))))
            (local.set $coefficient (call $algebraic_poly_coefficient
              (local.get $pb) (i32.add (local.get $k) (local.get $i))))
            (if (call $expression_walk_guard (i32.mul (i32.const 4)
                  (call $estimate_bigint_size (i32.add
                    (i32.add
                      (call $bigint_length (local.get $coefficient))
                      (call $bigint_length (local.get $binomial)))
                    (i32.add (call $bigint_length (local.get $s_power)) (i32.const 3))))))
              (then (return (i32.const 0))))
            (local.set $term (call $bigint_mul
              (call $bigint_mul (local.get $coefficient) (local.get $binomial)) (local.get $s_power)))
            (if (i32.and (local.get $k) (i32.const 1))
              (then (local.set $term (call $algebraic_bigint_negate (local.get $term)))))
            (call $algebraic_poly_set_coefficient (local.get $xk) (local.get $i) (local.get $term))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $row)))
        (call $algebraic_poly_trim (local.get $xk))
        (call $algebraic_poly_set_coefficient (local.get $b_ypoly) (local.get $k) (local.get $xk))
        (local.set $k (i32.add (local.get $k) (i32.const 1)))
        (br $shift)))
    (local.set $resultant (call $algebraic_ypoly_resultant (local.get $a_ypoly) (local.get $b_ypoly)))
    (if (i32.eqz (local.get $resultant)) (then (return (i32.const 0))))
    (call $algebraic_poly_trim (local.get $resultant))
    (local.get $resultant)
  )

  ;; =====================================================================
  ;; modpoly: polynomials in z whose COEFFICIENTS are apoly elements of
  ;; the field K = ℚ(gamma') = ℚ[y]/(p_gamma'(y)) -- i.e. each
  ;; coefficient is itself an apoly of degree < deg(p_gamma'), reduced
  ;; mod p_gamma' after every multiply. Same [degree][entry...] blob
  ;; shape as apoly/npoly; entries are apoly POINTERS, not rationals.
  ;; Needed for the rewrite step's gcd(h, p_alpha) over K[z]
  ;; because the rewrite step needs polynomial gcd over ℚ(γ).

  ;; =====================================================================

  (func $algebraic_modpoly_entry_is_zero (param $entry i32) (result i32)
    (i32.lt_s (call $algebraic_poly_degree (local.get $entry)) (i32.const 0))
  )

  (func $algebraic_modpoly_trim (param $poly i32)
    (local $degree i32)
    (local.set $degree (call $algebraic_poly_degree (local.get $poly)))
    (block $done
      (loop $trim
        (br_if $done (i32.lt_s (local.get $degree) (i32.const 0)))
        (br_if $done (i32.eqz (call $algebraic_modpoly_entry_is_zero
          (call $algebraic_poly_coefficient (local.get $poly) (local.get $degree)))))
        (local.set $degree (i32.sub (local.get $degree) (i32.const 1)))
        (br $trim)))
    (call $algebraic_poly_set_degree (local.get $poly) (local.get $degree))
  )

  ;; Multiply two modpoly coefficients (apoly elements of K), reducing
  ;; the product mod $p_gamma (an apoly, gamma's own defining
  ;; polynomial lifted via $algebraic_apoly_from_bigint_poly). This is
  ;; the field-K multiplication every modpoly arithmetic op needs.
  ;; 0 on pressure.
  (func $algebraic_modpoly_coefficient_mul
    (param $a i32) (param $b i32) (param $p_gamma i32) (result i32)
    (local $product i32)
    (local.set $product (call $algebraic_apoly_mul (local.get $a) (local.get $b)))
    (if (i32.eqz (local.get $product))
      (then (if (i32.and (i32.ge_s (call $algebraic_poly_degree (local.get $a)) (i32.const 0))
                 (i32.ge_s (call $algebraic_poly_degree (local.get $b)) (i32.const 0))) (then (return (i32.const 0))))))
    (call $algebraic_apoly_mod (local.get $product) (local.get $p_gamma))
  )

  ;; a + b, both modpolys (coefficient add needs no K-reduction --
  ;; apoly_add already produces a degree-bounded, reduced-form result
  ;; whenever a and b already were). 0 on pressure.
  (func $algebraic_modpoly_add (param $a i32) (param $b i32) (result i32)
    (local $degree_a i32)
    (local $degree_b i32)
    (local $degree i32)
    (local $result i32)
    (local $i i32)
    (local $sum i32)
    (local $zero_k i32)
    (local.set $degree_a (call $algebraic_poly_degree (local.get $a)))
    (local.set $degree_b (call $algebraic_poly_degree (local.get $b)))
    (local.set $degree (local.get $degree_a))
    (if (i32.gt_s (local.get $degree_b) (local.get $degree)) (then (local.set $degree (local.get $degree_b))))
    (if (i32.lt_s (local.get $degree) (i32.const 0)) (then (return (call $algebraic_poly_carve (i32.const -1)))))
    (local.set $result (call $algebraic_poly_carve (local.get $degree)))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (local.set $zero_k (call $algebraic_apoly_zero_poly (i32.const -1)))
    (local.set $i (i32.const 0))
    (block $done
      (loop $add
        (br_if $done (i32.gt_s (local.get $i) (local.get $degree)))
        (if (call $expression_walk_guard (i32.const 32))
          (then (return (i32.const 0))))
        (if (i32.gt_s (local.get $i) (local.get $degree_a))
          (then (local.set $sum (call $algebraic_poly_coefficient (local.get $b) (local.get $i))))
          (else
            (if (i32.gt_s (local.get $i) (local.get $degree_b))
              (then (local.set $sum (call $algebraic_poly_coefficient (local.get $a) (local.get $i))))
              (else (local.set $sum (call $algebraic_apoly_add
                (call $algebraic_poly_coefficient (local.get $a) (local.get $i))
                (call $algebraic_poly_coefficient (local.get $b) (local.get $i))))))))
        (if (i32.eqz (local.get $sum)) (then (local.set $sum (local.get $zero_k))))
        (call $algebraic_poly_set_coefficient (local.get $result) (local.get $i) (local.get $sum))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $add)))
    (call $algebraic_modpoly_trim (local.get $result))
    (local.get $result)
  )

  ;; a * b mod $p_gamma, both modpolys. 0 on pressure.
  (func $algebraic_modpoly_mul (param $a i32) (param $b i32) (param $p_gamma i32) (result i32)
    (local $degree_a i32)
    (local $degree_b i32)
    (local $result i32)
    (local $i i32)
    (local $j i32)
    (local $ca i32)
    (local $cb i32)
    (local $accumulator i32)
    (local $product i32)
    (local.set $degree_a (call $algebraic_poly_degree (local.get $a)))
    (local.set $degree_b (call $algebraic_poly_degree (local.get $b)))
    (if (i32.or (i32.lt_s (local.get $degree_a) (i32.const 0)) (i32.lt_s (local.get $degree_b) (i32.const 0)))
      (then (return (call $algebraic_poly_carve (i32.const -1)))))
    (local.set $result (call $algebraic_poly_carve (i32.add (local.get $degree_a) (local.get $degree_b))))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (local.set $i (i32.const 0))
    (block $init_done
      (loop $init
        (br_if $init_done (i32.gt_s (local.get $i) (i32.add (local.get $degree_a) (local.get $degree_b))))
        (call $algebraic_poly_set_coefficient (local.get $result) (local.get $i) (call $algebraic_apoly_zero_poly (i32.const -1)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $init)))
    (local.set $i (i32.const 0))
    (block $rows_done
      (loop $rows
        (br_if $rows_done (i32.gt_s (local.get $i) (local.get $degree_a)))
        (local.set $ca (call $algebraic_poly_coefficient (local.get $a) (local.get $i)))
        (if (i32.eqz (call $algebraic_modpoly_entry_is_zero (local.get $ca)))
          (then
            (local.set $j (i32.const 0))
            (block $cols_done
              (loop $cols
                (br_if $cols_done (i32.gt_s (local.get $j) (local.get $degree_b)))
                (local.set $cb (call $algebraic_poly_coefficient (local.get $b) (local.get $j)))
                (if (i32.eqz (call $algebraic_modpoly_entry_is_zero (local.get $cb)))
                  (then
                    (if (call $expression_walk_guard (i32.const 32))
                      (then (return (i32.const 0))))
                    (local.set $product (call $algebraic_modpoly_coefficient_mul (local.get $ca) (local.get $cb) (local.get $p_gamma)))
                    (if (i32.eqz (local.get $product)) (then (return (i32.const 0))))
                    (local.set $accumulator (call $algebraic_poly_coefficient (local.get $result) (i32.add (local.get $i) (local.get $j))))
                    (call $algebraic_poly_set_coefficient (local.get $result) (i32.add (local.get $i) (local.get $j))
                      (call $algebraic_apoly_add (local.get $accumulator) (local.get $product)))))
                (local.set $j (i32.add (local.get $j) (i32.const 1)))
                (br $cols)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $rows)))
    (call $algebraic_modpoly_trim (local.get $result))
    (local.get $result)
  )

  ;; f mod m, both modpolys (division-with-remainder over the field K
  ;; -- leading coefficients are inverted via $algebraic_apoly_gcd's
  ;; own leading-coefficient inverse trick, generalized to a genuine
  ;; K-element inverse via extended gcd against $p_gamma). 0 on
  ;; pressure.
  (func $algebraic_modpoly_mod (param $f i32) (param $m i32) (param $p_gamma i32) (result i32)
    (local $degree_m i32)
    (local $remainder i32)
    (local $degree_r i32)
    (local $lead_m i32)
    (local $lead_m_inv_u i32)
    (local $lead_m_inv_v i32)
    (local $lead_m_inverse i32)
    (local $factor i32)
    (local $shift i32)
    (local $i i32)
    (local $product i32)
    (local.set $degree_m (call $algebraic_poly_degree (local.get $m)))
    (if (i32.lt_s (local.get $degree_m) (i32.const 0)) (then (unreachable)))
    (local.set $lead_m (call $algebraic_poly_coefficient (local.get $m) (local.get $degree_m)))
    (local.set $lead_m_inv_u (call $carve_scratch_blob (i32.const 4)))
    (local.set $lead_m_inv_v (call $carve_scratch_blob (i32.const 4)))
    (local.set $lead_m_inverse (call $algebraic_apoly_extended_gcd
      (local.get $lead_m) (local.get $p_gamma) (local.get $lead_m_inv_u) (local.get $lead_m_inv_v)))
    (if (i32.eqz (local.get $lead_m_inverse)) (then (return (i32.const 0))))
    (if (i32.ne (call $algebraic_poly_degree (local.get $lead_m_inverse)) (i32.const 0)) (then (return (i32.const 0))))
    (local.set $lead_m_inverse (i32.load (call $abs (local.get $lead_m_inv_u))))
    (local.set $remainder (call $algebraic_poly_carve (call $algebraic_poly_degree (local.get $f))))
    (if (i32.eqz (local.get $remainder)) (then (return (i32.const 0))))
    (local.set $i (i32.const 0))
    (block $copy_done
      (loop $copy
        (br_if $copy_done (i32.gt_s (local.get $i) (call $algebraic_poly_degree (local.get $f))))
        (call $algebraic_poly_set_coefficient (local.get $remainder) (local.get $i)
          (call $algebraic_poly_coefficient (local.get $f) (local.get $i)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $copy)))
    (call $algebraic_modpoly_trim (local.get $remainder))
    (block $reduce_done
      (loop $reduce
        (local.set $degree_r (call $algebraic_poly_degree (local.get $remainder)))
        (br_if $reduce_done (i32.lt_s (local.get $degree_r) (local.get $degree_m)))
        (if (call $expression_walk_guard (i32.const 32))
          (then (return (i32.const 0))))
        (local.set $factor (call $algebraic_modpoly_coefficient_mul
          (call $algebraic_poly_coefficient (local.get $remainder) (local.get $degree_r))
          (local.get $lead_m_inverse) (local.get $p_gamma)))
        (if (i32.eqz (local.get $factor)) (then (return (i32.const 0))))
        (local.set $shift (i32.sub (local.get $degree_r) (local.get $degree_m)))
        (local.set $i (i32.const 0))
        (block $sub_done
          (loop $sub
            (br_if $sub_done (i32.gt_s (local.get $i) (local.get $degree_m)))
            (local.set $product (call $algebraic_modpoly_coefficient_mul
              (local.get $factor) (call $algebraic_poly_coefficient (local.get $m) (local.get $i)) (local.get $p_gamma)))
            (if (i32.eqz (local.get $product)) (then (return (i32.const 0))))
            (call $algebraic_poly_set_coefficient (local.get $remainder) (i32.add (local.get $i) (local.get $shift))
              (call $algebraic_apoly_sub
                (call $algebraic_poly_coefficient (local.get $remainder) (i32.add (local.get $i) (local.get $shift)))
                (local.get $product)))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $sub)))
        (call $algebraic_modpoly_trim (local.get $remainder))
        (br $reduce)))
    (local.get $remainder)
  )

  ;; Ordinary Euclidean gcd over the field K = ℚ(gamma') -- structurally
  ;; identical to $algebraic_apoly_gcd, but every arithmetic op reduces
  ;; mod $p_gamma. Returns a MONIC-over-K gcd (leading coefficient
  ;; scaled to the K-unit 1). 0 on pressure.
  (func $algebraic_modpoly_gcd (param $a i32) (param $b i32) (param $p_gamma i32) (result i32)
    (local $x i32)
    (local $y i32)
    (local $remainder i32)
    (local $degree_y i32)
    (local $lead i32)
    (local $inv_u i32)
    (local $inv_v i32)
    (local $inverse_lead i32)
    (local $result i32)
    (local $i i32)
    (local.set $x (local.get $a))
    (local.set $y (local.get $b))
    (block $done
      (loop $euclid
        (br_if $done (i32.lt_s (call $algebraic_poly_degree (local.get $y)) (i32.const 0)))
        (if (call $expression_walk_guard (i32.const 32))
          (then (return (i32.const 0))))
        (local.set $remainder (call $algebraic_modpoly_mod (local.get $x) (local.get $y) (local.get $p_gamma)))
        (if (i32.eqz (local.get $remainder))
          (then (if (i32.ge_s (call $algebraic_poly_degree (local.get $x)) (i32.const 0)) (then (return (i32.const 0))))))
        (local.set $x (local.get $y))
        (local.set $y (local.get $remainder))
        (br $euclid)))
    (local.set $degree_y (call $algebraic_poly_degree (local.get $x)))
    (if (i32.lt_s (local.get $degree_y) (i32.const 0)) (then (return (local.get $x))))
    (local.set $lead (call $algebraic_poly_coefficient (local.get $x) (local.get $degree_y)))
    (local.set $inv_u (call $carve_scratch_blob (i32.const 4)))
    (local.set $inv_v (call $carve_scratch_blob (i32.const 4)))
    (local.set $inverse_lead (call $algebraic_apoly_extended_gcd
      (local.get $lead) (local.get $p_gamma) (local.get $inv_u) (local.get $inv_v)))
    (if (i32.eqz (local.get $inverse_lead)) (then (return (i32.const 0))))
    (if (i32.ne (call $algebraic_poly_degree (local.get $inverse_lead)) (i32.const 0)) (then (return (i32.const 0))))
    (local.set $inverse_lead (i32.load (call $abs (local.get $inv_u))))
    (local.set $result (call $algebraic_poly_carve (local.get $degree_y)))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (local.set $i (i32.const 0))
    (block $normalize_done
      (loop $normalize
        (br_if $normalize_done (i32.gt_s (local.get $i) (local.get $degree_y)))
        (if (call $expression_walk_guard (i32.const 32))
          (then (return (i32.const 0))))
        (call $algebraic_poly_set_coefficient (local.get $result) (local.get $i)
          (call $algebraic_modpoly_coefficient_mul
            (local.get $inverse_lead) (call $algebraic_poly_coefficient (local.get $x) (local.get $i)) (local.get $p_gamma)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $normalize)))
    (local.get $result)
  )

  ;; Build h(z) = p_gamma_old(gamma_new - s*z) as a modpoly. The
  ;; coefficient of z^k is (-s)^k * Sum_{j>=k}
  ;; c_j*C(j,k)*gamma_new^(j-k), an apoly monomial-scaled sum.
  ;; Every entry is reduced mod $p_gamma_new so powers at or above its
  ;; degree remain valid K elements.

  ;; 0 on pressure.
  (func $algebraic_modpoly_shift_of
    (param $p_gamma_old i32) (param $gamma_new_apoly i32) (param $s i32) (param $p_gamma_new i32)
    (result i32)
    (local $d i32)
    (local $result i32)
    (local $k i32)
    (local $j i32)
    (local $binomial i32)
    (local $s_power i32)
    (local $s_bigint i32)
    (local $c_j i32)
    (local $gamma_power i32)
    (local $term_apoly i32)
    (local $term_rational_scaled i32)
    (local $accumulator i32)
    (local.set $d (call $algebraic_poly_degree (local.get $p_gamma_old)))
    (local.set $s_bigint (call $bigint_from_i64 (i64.extend_i32_s (local.get $s))))
    (local.set $result (call $algebraic_poly_carve (local.get $d)))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    ;; The coefficient of z^k carries one constant s^k factor. Advance
    ;; that factor once per outer iteration; it must not vary with j.
    (local.set $s_power (call $bigint_one))
    (local.set $k (i32.const 0))
    (block $k_done
      (loop $k_loop
        (br_if $k_done (i32.gt_s (local.get $k) (local.get $d)))
        (if (call $expression_walk_guard (i32.const 32))
          (then (return (i32.const 0))))
        (local.set $accumulator (call $algebraic_apoly_zero_poly (i32.const -1)))
        ;; binomial C(j,k) walked incrementally starting at j=k (C(k,k)=1);
        ;; gamma_power tracks gamma_new^(j-k), starting at gamma_new^0=1.
        (local.set $binomial (call $bigint_one))
        (local.set $gamma_power (call $algebraic_apoly_zero_poly (i32.const 0)))
        (call $algebraic_poly_set_coefficient (local.get $gamma_power) (i32.const 0)
          (call $rational_new (call $bigint_one) (call $bigint_one)))
        (local.set $j (local.get $k))
        (block $j_done
          (loop $j_loop
            (br_if $j_done (i32.gt_s (local.get $j) (local.get $d)))
            (if (call $expression_walk_guard (i32.const 64))
              (then (return (i32.const 0))))
            (local.set $c_j (call $algebraic_poly_coefficient (local.get $p_gamma_old) (local.get $j)))
            (if (i32.eqz (call $bigint_length (local.get $c_j)))
              (then)
              (else
                (local.set $term_rational_scaled (call $rational_new
                  (call $bigint_mul (call $bigint_mul (local.get $c_j) (local.get $binomial)) (local.get $s_power))
                  (call $bigint_one)))
                (local.set $term_apoly (call $algebraic_apoly_scale (local.get $gamma_power) (local.get $term_rational_scaled)))
                (if (i32.eqz (local.get $term_apoly))
                  (then (if (i32.ge_s (call $algebraic_poly_degree (local.get $gamma_power)) (i32.const 0)) (then (return (i32.const 0))))))
                (local.set $accumulator (call $algebraic_apoly_add (local.get $accumulator) (local.get $term_apoly)))))
            ;; Advance for next j: binomial *= (j+1)/(j+1-k);
            ;; gamma_power *= gamma_new (mod p_gamma_new).
            (if (i32.lt_s (local.get $j) (local.get $d))
              (then
                (local.set $binomial (call $bigint_div
                  (call $bigint_mul (local.get $binomial) (call $bigint_from_i64 (i64.extend_i32_s (i32.add (local.get $j) (i32.const 1)))))
                  (call $bigint_from_i64 (i64.extend_i32_s (i32.add (i32.sub (local.get $j) (local.get $k)) (i32.const 1))))))
                (local.set $gamma_power (call $algebraic_apoly_mul (local.get $gamma_power) (local.get $gamma_new_apoly)))
                (if (i32.eqz (local.get $gamma_power)) (then (return (i32.const 0))))
                (local.set $gamma_power (call $algebraic_apoly_mod (local.get $gamma_power) (local.get $p_gamma_new)))
                (if (i32.eqz (local.get $gamma_power)) (then (return (i32.const 0))))
              ))
            (local.set $j (i32.add (local.get $j) (i32.const 1)))
            (br $j_loop)))
        ;; coefficient of z^k gets an extra (-1)^k factor, completing
        ;; (-s)^k for p_gamma_old(gamma_new - s*z).
        (if (i32.and (local.get $k) (i32.const 1))
          (then (local.set $accumulator (call $algebraic_apoly_scale (local.get $accumulator)
            (call $rational_new (call $algebraic_bigint_negate (call $bigint_one)) (call $bigint_one))))))
        (call $algebraic_poly_set_coefficient (local.get $result) (local.get $k) (local.get $accumulator))
        (local.set $s_power (call $bigint_mul (local.get $s_power) (local.get $s_bigint)))
        (local.set $k (i32.add (local.get $k) (i32.const 1)))
        (br $k_loop)))
    (call $algebraic_modpoly_trim (local.get $result))
    (local.get $result)
  )

  ;; One step of primitive-element construction: mint gamma_new =
  ;; gamma_old + s*alpha (via the EXISTING degree-preserving
  ;; algebraic_value_scale_rational + algebraic_compose_binary sum --
  ;; the ONLY place this whole plan still calls algebraic_compose_
  ;; binary's numeric disambiguation loop, exactly once per registered
  ;; value, matching how often Sage's own AlgebraicGenerator.union
  ;; invokes isolating_interval per the section 0 reading), then finds
  ;; alpha's OWN representation as a polynomial in gamma_new via
  ;; gcd(h, p_alpha) over K=ℚ(gamma_new) (section 1's rewrite step),
  ;; then re-expresses every ALREADY-KNOWN rep (for earlier registry
  ;; entries, previously expressed in gamma_old) in terms of gamma_new
  ;; by substituting gamma_old = gamma_new - s*alpha = gamma_new -
  ;; s*(alpha's own new rep) -- i.e. evaluating each old rep (itself an
  ;; apoly in gamma_old) at the apoly value (gamma_new_unit -
  ;; s*alpha_rep), which needs apoly-composition (Horner evaluation of
  ;; one apoly at ANOTHER apoly's value, reduced mod p_gamma_new after
  ;; every step -- this is exactly $algebraic_modpoly_*'s own
  ;; multiply-and-reduce discipline, reused directly since "apoly
  ;; evaluated at an apoly point" is just repeated modpoly-coefficient
  ;; multiplication).
  ;; $reps_out[i] for i < $rep_count are REWRITTEN in place;
  ;; $reps_out[$rep_count] receives the new value's own rep.
  ;; 0 ok / 1 pressure / 2 shift-search limit exceeded (propagated,
  ;; not generated here).
  (func $algebraic_build_primitive_element_step
    (param $gamma_old_header i32) (param $alpha_header i32) (param $s i32)
    (param $reps_out i32) (param $rep_count i32)
    (param $gamma_out i32)
    (result i32)
    (local $tmp_slot i32)
    (local $status i32)
    (local $s_rational i32)
    (local $scaled_alpha_slot i32)
    (local $p_gamma_new i32)
    (local $gamma_new_slot i32)
    (local $gamma_new_header i32)
    (local $p_gamma_new_apoly i32)
    (local $p_alpha i32)
    (local $p_alpha_modpoly i32)
    (local $p_gamma_old i32)
    (local $h i32)
    (local $g i32)
    (local $u_out i32)
    (local $v_out i32)
    (local $gcd_result i32)
    (local $c0 i32)
    (local $c1 i32)
    (local $c1_inv_u i32)
    (local $c1_inv_v i32)
    (local $c1_inverse i32)
    (local $alpha_rep i32)
    (local $gamma_new_apoly_unit i32)
    (local $neg_s_alpha_rep i32)
    (local $i i32)
    (local $old_rep i32)
    (local $new_rep i32)
    (local.set $tmp_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (local.set $scaled_alpha_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (local.set $gamma_new_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (local.set $s_rational (call $rational_new (call $bigint_from_i64 (i64.extend_i32_s (local.get $s))) (call $bigint_one)))
    (local.set $status (call $algebraic_value_scale_rational (local.get $alpha_header) (local.get $s_rational) (local.get $scaled_alpha_slot)))
    (if (local.get $status) (then (return (local.get $status))))
    ;; gamma_old + s*alpha via the general slot-arith add (handles both
    ;; the algebraic and, in principle, degenerate-rational case
    ;; uniformly -- s*alpha stays algebraic here since alpha is).
    (call $write_value (local.get $tmp_slot) (global.get $TYPE_ALGEBRAIC) (i32.const 0) (local.get $gamma_old_header) (i32.const 0))
    (local.set $status (call $algebraic_compose_binary
      (local.get $gamma_old_header) (call $value_data_lo (local.get $scaled_alpha_slot))
      (i32.const 0) (local.get $gamma_new_slot)))
    (if (i32.eq (local.get $status) (i32.const 1)) (then (return (i32.const 1))))
    (if (local.get $status) (then (return (i32.const 1))))
    (if (i32.ne (call $value_type (local.get $gamma_new_slot)) (global.get $TYPE_ALGEBRAIC)) (then (return (i32.const 4))))
    (local.set $gamma_new_header (call $value_data_lo (local.get $gamma_new_slot)))
    ;; p_gamma_new is gamma_new's OWN true (irreducible) minimal
    ;; polynomial, exactly as algebraic_slot_arith/algebraic_compose_binary
    ;; already numerically disambiguated it -- NOT a separately-computed
    ;; raw/squarefree resultant (that resultant is generally REDUCIBLE,
    ;; a product over all conjugate choices of s, and using a reducible
    ;; modulus for the field-K arithmetic below (K = QQ[z]/(p_gamma_new))
    ;; is unsound: the quotient ring isn't even a field, so the extended-
    ;; gcd "inverse" step is meaningless). The modulus must therefore be
    ;; reduced to the selected irreducible factor.
    (local.set $p_gamma_new (call $algebraic_poly_from_array
      (call $algebraic_coefficients_of (local.get $gamma_new_header))))
    (if (i32.eqz (local.get $p_gamma_new)) (then (return (i32.const 1))))
    (local.set $p_gamma_new_apoly (call $algebraic_apoly_from_bigint_poly (local.get $p_gamma_new)))
    (if (i32.eqz (local.get $p_gamma_new_apoly)) (then (return (i32.const 1))))
    ;; gamma_new_apoly_unit: gamma_new itself, as the degree-1 apoly
    ;; monomial "z^1" (the K-element gamma_new IS just its own
    ;; primitive-generator power-1 monomial, by construction).
    (local.set $gamma_new_apoly_unit (call $algebraic_apoly_zero_poly (i32.const 1)))
    (if (i32.eqz (local.get $gamma_new_apoly_unit)) (then (return (i32.const 1))))
    (call $algebraic_poly_set_coefficient (local.get $gamma_new_apoly_unit) (i32.const 1)
      (call $rational_new (call $bigint_one) (call $bigint_one)))
    (local.set $p_gamma_old (call $algebraic_poly_from_array (call $algebraic_coefficients_of (local.get $gamma_old_header))))
    (if (i32.eqz (local.get $p_gamma_old)) (then (return (i32.const 1))))
    (local.set $h (call $algebraic_modpoly_shift_of
      (local.get $p_gamma_old) (local.get $gamma_new_apoly_unit) (local.get $s) (local.get $p_gamma_new_apoly)))
    (if (i32.eqz (local.get $h)) (then (return (i32.const 1))))
    (local.set $p_alpha (call $algebraic_poly_from_array (call $algebraic_coefficients_of (local.get $alpha_header))))
    (if (i32.eqz (local.get $p_alpha)) (then (return (i32.const 1))))
    ;; Lift p_alpha to a modpoly: constant-apoly coefficients (p_alpha's
    ;; own bigint coefficients, wrapped as degree-0 apoly constants).
    (local.set $p_alpha_modpoly (call $algebraic_poly_carve (call $algebraic_poly_degree (local.get $p_alpha))))
    (if (i32.eqz (local.get $p_alpha_modpoly)) (then (return (i32.const 1))))
    (local.set $i (i32.const 0))
    (block $lift_done
      (loop $lift
        (br_if $lift_done (i32.gt_s (local.get $i) (call $algebraic_poly_degree (local.get $p_alpha))))
        (if (call $expression_walk_guard (i32.const 32)) (then (return (i32.const 1))))
        (call $algebraic_poly_set_coefficient (local.get $p_alpha_modpoly) (local.get $i)
          (call $algebraic_apoly_zero_poly (i32.const -1)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $lift)))
    (local.set $i (i32.const 0))
    (block $lift2_done
      (loop $lift2
        (br_if $lift2_done (i32.gt_s (local.get $i) (call $algebraic_poly_degree (local.get $p_alpha))))
        (if (i32.ne (call $bigint_length (call $algebraic_poly_coefficient (local.get $p_alpha) (local.get $i))) (i32.const 0))
          (then
            (local.set $c0 (call $algebraic_apoly_zero_poly (i32.const 0)))
            (call $algebraic_poly_set_coefficient (local.get $c0) (i32.const 0)
              (call $rational_new (call $algebraic_poly_coefficient (local.get $p_alpha) (local.get $i)) (call $bigint_one)))
            (call $algebraic_poly_set_coefficient (local.get $p_alpha_modpoly) (local.get $i) (local.get $c0))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $lift2)))
    (call $algebraic_modpoly_trim (local.get $p_alpha_modpoly))
    (local.set $gcd_result (call $algebraic_modpoly_gcd (local.get $h) (local.get $p_alpha_modpoly) (local.get $p_gamma_new_apoly)))
    (if (i32.eqz (local.get $gcd_result)) (then (return (i32.const 1))))
    (if (i32.ne (call $algebraic_poly_degree (local.get $gcd_result)) (i32.const 1))
      (then (return (i32.const 3))))
    (local.set $c0 (call $algebraic_poly_coefficient (local.get $gcd_result) (i32.const 0)))
    (local.set $c1 (call $algebraic_poly_coefficient (local.get $gcd_result) (i32.const 1)))
    ;; gcd is already monic-over-K (algebraic_modpoly_gcd's own
    ;; postcondition), so c1 should be the K-unit 1 already -- but
    ;; invert defensively rather than assume, matching this file's
    ;; established discipline of not trusting an invariant it can
    ;; cheaply verify.
    (local.set $c1_inv_u (call $carve_scratch_blob (i32.const 4)))
    (local.set $c1_inv_v (call $carve_scratch_blob (i32.const 4)))
    (local.set $c1_inverse (call $algebraic_apoly_extended_gcd
      (local.get $c1) (local.get $p_gamma_new_apoly) (local.get $c1_inv_u) (local.get $c1_inv_v)))
    (if (i32.eqz (local.get $c1_inverse)) (then (return (i32.const 1))))
    (if (i32.ne (call $algebraic_poly_degree (local.get $c1_inverse)) (i32.const 0)) (then (unreachable)))
    (local.set $c1_inverse (i32.load (call $abs (local.get $c1_inv_u))))
    (local.set $alpha_rep (call $algebraic_apoly_mul (local.get $c0) (local.get $c1_inverse)))
    (if (i32.eqz (local.get $alpha_rep))
      (then (if (i32.and (i32.ge_s (call $algebraic_poly_degree (local.get $c0)) (i32.const 0))
                 (i32.ge_s (call $algebraic_poly_degree (local.get $c1_inverse)) (i32.const 0))) (then (return (i32.const 1))))))
    (local.set $alpha_rep (call $algebraic_apoly_mod (local.get $alpha_rep) (local.get $p_gamma_new_apoly)))
    (if (i32.eqz (local.get $alpha_rep)) (then (return (i32.const 1))))
    (local.set $alpha_rep (call $algebraic_apoly_scale (local.get $alpha_rep)
      (call $rational_new (call $algebraic_bigint_negate (call $bigint_one)) (call $bigint_one))))
    (if (i32.eqz (local.get $alpha_rep)) (then (return (i32.const 1))))
    ;; Re-express every existing reps[0..rep_count-1] (currently a poly
    ;; in gamma_old) in terms of gamma_new, by substituting
    ;; gamma_old -> (gamma_new_unit - s*alpha_rep) -- Horner-evaluate
    ;; each old rep at that apoly value, mod p_gamma_new.
    (local.set $neg_s_alpha_rep (call $algebraic_apoly_scale (local.get $alpha_rep)
      (call $rational_new (call $bigint_from_i64 (i64.extend_i32_s (i32.sub (i32.const 0) (local.get $s)))) (call $bigint_one))))
    (if (i32.eqz (local.get $neg_s_alpha_rep)) (then (return (i32.const 1))))
    (local.set $old_rep (call $algebraic_apoly_add (local.get $gamma_new_apoly_unit) (local.get $neg_s_alpha_rep)))
    (if (i32.eqz (local.get $old_rep)) (then (return (i32.const 1))))
    (local.set $old_rep (call $algebraic_apoly_mod (local.get $old_rep) (local.get $p_gamma_new_apoly)))
    (if (i32.eqz (local.get $old_rep)) (then (return (i32.const 1))))
    ;; $old_rep is now "gamma_old, as a K-element (apoly in gamma_new)".
    (local.set $i (i32.const 0))
    (block $rewrite_done
      (loop $rewrite
        (br_if $rewrite_done (i32.ge_s (local.get $i) (local.get $rep_count)))
        (local.set $new_rep (call $algebraic_apoly_horner_eval
          (i32.load (call $abs (i32.add (local.get $reps_out) (i32.mul (local.get $i) (i32.const 4)))))
          (local.get $old_rep) (local.get $p_gamma_new_apoly)))
        (if (i32.eqz (local.get $new_rep)) (then (return (i32.const 1))))
        (i32.store (call $abs (i32.add (local.get $reps_out) (i32.mul (local.get $i) (i32.const 4)))) (local.get $new_rep))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $rewrite)))
    (i32.store (call $abs (i32.add (local.get $reps_out) (i32.mul (local.get $rep_count) (i32.const 4)))) (local.get $alpha_rep))
    (i32.store (call $abs (local.get $gamma_out)) (local.get $gamma_new_header))
    (i32.const 0)
  )

  ;; Horner-evaluate a modpoly-style poly $f (coefficients are apoly K-
  ;; elements, itself a poly in some OLD variable) at an apoly VALUE
  ;; $at (a K-element, i.e. itself an apoly in the NEW generator),
  ;; reduced mod $p_gamma throughout. This is exactly what "rewrite an
  ;; old rep in terms of the new gamma" needs -- $f's own coefficients
  ;; are combined with $at via ordinary apoly arithmetic (mod
  ;; p_gamma), since both live in the same field K once gamma_old is
  ;; expressed as a K-element. 0 on pressure.
  (func $algebraic_apoly_horner_eval (param $f i32) (param $at i32) (param $p_gamma i32) (result i32)
    (local $degree i32)
    (local $accumulator i32)
    (local $i i32)
    (local $product i32)
    (local.set $degree (call $algebraic_poly_degree (local.get $f)))
    (if (i32.lt_s (local.get $degree) (i32.const 0))
      (then (return (call $algebraic_apoly_zero_poly (i32.const -1)))))
    (local.set $accumulator (call $algebraic_apoly_from_rational
      (call $algebraic_poly_coefficient (local.get $f) (local.get $degree))))
    (if (i32.eqz (local.get $accumulator))
      (then (return (i32.const 0))))
    (local.set $i (i32.sub (local.get $degree) (i32.const 1)))
    (block $done
      (loop $horner
        (br_if $done (i32.lt_s (local.get $i) (i32.const 0)))
        (if (call $expression_walk_guard (i32.const 32))
          (then (return (i32.const 0))))
        (local.set $product (call $algebraic_apoly_mul (local.get $accumulator) (local.get $at)))
        (if (i32.eqz (local.get $product))
          (then (if (i32.and (i32.ge_s (call $algebraic_poly_degree (local.get $accumulator)) (i32.const 0))
                     (i32.ge_s (call $algebraic_poly_degree (local.get $at)) (i32.const 0)))
            (then (return (i32.const 0))))))
        (local.set $product (call $algebraic_apoly_mod (local.get $product) (local.get $p_gamma)))
        (if (i32.eqz (local.get $product))
          (then (return (i32.const 0))))
        (local.set $accumulator (call $algebraic_apoly_add (local.get $product)
          (call $algebraic_apoly_from_rational (call $algebraic_poly_coefficient (local.get $f) (local.get $i)))))
        (if (i32.eqz (local.get $accumulator))
          (then (return (i32.const 0))))
        (local.set $i (i32.sub (local.get $i) (i32.const 1)))
        (br $horner)))
    (local.get $accumulator)
  )

  ;; Horner-evaluate a plain ARRAY of apoly coefficients (index 0 =
  ;; constant term, ascending -- the SAME layout $coefficient_apolys/
  ;; $reps_out already use, NOT an algebraic_poly-shaped blob with
  ;; rational entries) at an apoly VALUE $at, mod $p_gamma throughout.
  ;; This is $algebraic_apoly_horner_eval's twin for the case where the
  ;; "polynomial" being evaluated already has APOLY coefficients
  ;; directly (a rewritten coefficient list), rather than a poly whose
  ;; entries are bare rationals needing $algebraic_apoly_from_rational
  ;; wrapping first. 0 on pressure.
  (func $algebraic_apoly_array_horner_eval
    (param $coefficients i32) (param $count i32) (param $at i32) (param $p_gamma i32) (result i32)
    (local $accumulator i32)
    (local $i i32)
    (local $product i32)
    (if (i32.le_s (local.get $count) (i32.const 0))
      (then (return (call $algebraic_apoly_zero_poly (i32.const -1)))))
    (local.set $accumulator (i32.load (call $abs
      (i32.add (local.get $coefficients) (i32.mul (i32.sub (local.get $count) (i32.const 1)) (i32.const 4))))))
    (local.set $i (i32.sub (local.get $count) (i32.const 2)))
    (block $done
      (loop $horner
        (br_if $done (i32.lt_s (local.get $i) (i32.const 0)))
        (if (call $expression_walk_guard (i32.const 32)) (then (return (i32.const 0))))
        (local.set $product (call $algebraic_apoly_mul (local.get $accumulator) (local.get $at)))
        (if (i32.eqz (local.get $product))
          (then (if (i32.and (i32.ge_s (call $algebraic_poly_degree (local.get $accumulator)) (i32.const 0))
                     (i32.ge_s (call $algebraic_poly_degree (local.get $at)) (i32.const 0)))
            (then (return (i32.const 0))))))
        (local.set $product (call $algebraic_apoly_mod (local.get $product) (local.get $p_gamma)))
        (if (i32.eqz (local.get $product)) (then (return (i32.const 0))))
        (local.set $accumulator (call $algebraic_apoly_add (local.get $product)
          (i32.load (call $abs (i32.add (local.get $coefficients) (i32.mul (local.get $i) (i32.const 4)))))))
        (if (i32.eqz (local.get $accumulator)) (then (return (i32.const 0))))
        (local.set $i (i32.sub (local.get $i) (i32.const 1)))
        (br $horner)))
    (local.get $accumulator)
  )

  ;; base^exponent mod p_gamma, both apolys (exponent a plain, small,
  ;; non-negative i32 -- the classify_term factor-exponent bound of 64
  ;; already caps how large this ever needs to go). Simple repeated
  ;; multiply-and-reduce (not binary exponentiation -- exponent <= 64
  ;; makes the O(exponent) cost irrelevant next to a single apoly_mul's
  ;; own cost). 0 on pressure.
  (func $algebraic_apoly_pow (param $base i32) (param $exponent i32) (param $p_gamma i32) (result i32)
    (local $result i32)
    (local $i i32)
    (local.set $result (call $algebraic_apoly_from_rational
      (call $rational_new (call $bigint_one) (call $bigint_one))))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (local.set $i (i32.const 0))
    (block $done
      (loop $pow
        (br_if $done (i32.ge_s (local.get $i) (local.get $exponent)))
        (if (call $expression_walk_guard (i32.const 32)) (then (return (i32.const 0))))
        (local.set $result (call $algebraic_apoly_mul (local.get $result) (local.get $base)))
        (if (i32.eqz (local.get $result))
          (then (if (i32.and (i32.ge_s (call $algebraic_poly_degree (local.get $result)) (i32.const 0))
                     (i32.ge_s (call $algebraic_poly_degree (local.get $base)) (i32.const 0)))
            (then (return (i32.const 0))))))
        (local.set $result (call $algebraic_apoly_mod (local.get $result) (local.get $p_gamma)))
        (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $pow)))
    (local.get $result)
  )

  ;; Evaluate ONE classified monomial term (scalar * Pi registry[f]^exp)
  ;; as an apoly in gamma, using $reps (registry[i]'s own apoly-in-gamma
  ;; representation, from $algebraic_build_primitive_element) instead
  ;; of $algebraic_evaluate_node -- this is the whole point of Option B:
  ;; no algebraic_compose_binary call anywhere in this path. 0 on
  ;; pressure.
  (func $algebraic_apoly_of_monomial_record
    (param $record i32) (param $registry i32) (param $registry_count i32)
    (param $reps i32) (param $p_gamma i32) (result i32)
    (local $result i32)
    (local $factor_count i32)
    (local $f i32)
    (local $alpha_header i32)
    (local $exponent i32)
    (local $index i32)
    (local $rep_power i32)
    (local $scalar i32)
    (local.set $scalar (i32.load (call $abs (local.get $record))))
    (local.set $result (call $algebraic_apoly_from_rational (local.get $scalar)))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (local.set $factor_count (i32.load (call $abs (i32.add (local.get $record) (i32.const 4)))))
    (local.set $f (i32.const 0))
    (block $factors_done
      (loop $factors
        (br_if $factors_done (i32.ge_s (local.get $f) (local.get $factor_count)))
        (local.set $alpha_header (i32.load (call $abs (i32.add (local.get $record)
          (i32.add (i32.const 8) (i32.mul (local.get $f) (i32.const 8)))))))
        (local.set $exponent (i32.load (call $abs (i32.add (local.get $record)
          (i32.add (i32.const 12) (i32.mul (local.get $f) (i32.const 8)))))))
        (local.set $index (call $algebraic_registry_index_of
          (local.get $registry) (local.get $registry_count) (local.get $alpha_header)))
        (if (i32.lt_s (local.get $index) (i32.const 0)) (then (return (i32.const 0))))
        (local.set $rep_power (call $algebraic_apoly_pow
          (i32.load (call $abs (i32.add (local.get $reps) (i32.mul (local.get $index) (i32.const 4)))))
          (local.get $exponent) (local.get $p_gamma)))
        (if (i32.eqz (local.get $rep_power)) (then (return (i32.const 0))))
        (local.set $result (call $algebraic_apoly_mul (local.get $result) (local.get $rep_power)))
        (if (i32.eqz (local.get $result))
          (then (if (i32.and (i32.ge_s (call $algebraic_poly_degree (local.get $result)) (i32.const 0))
                     (i32.ge_s (call $algebraic_poly_degree (local.get $rep_power)) (i32.const 0)))
            (then (return (i32.const 0))))))
        (local.set $result (call $algebraic_apoly_mod (local.get $result) (local.get $p_gamma)))
        (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
        (local.set $f (i32.add (local.get $f) (i32.const 1)))
        (br $factors)))
    (local.get $result)
  )

  ;; Evaluate ONE coefficient slot (an Add-fanout of monomial terms, or
  ;; a single bare term -- the SAME shape $algebraic_collect_variable_
  ;; registry's own pre-pass already walks) as an apoly in gamma. Sums
  ;; each term's $algebraic_apoly_of_monomial_record result. 0 ok /
  ;; 1 pressure / 2 unrecognized shape / 3 too many factors (propagated
  ;; from $algebraic_classify_term, not generated here).
  (func $algebraic_apoly_of_coefficient_slot
    (param $slot i32) (param $registry i32) (param $registry_count i32)
    (param $reps i32) (param $p_gamma i32) (param $out i32) (result i32)
    (local $slot_type i32)
    (local $inner_args i32)
    (local $term_count i32)
    (local $term_data i32)
    (local $term_index i32)
    (local $term_slot i32)
    (local $record i32)
    (local $status i32)
    (local $term_apoly i32)
    (local $accumulator i32)
    (local.set $slot_type (call $value_type (local.get $slot)))
    (if (i32.and
          (i32.eq (local.get $slot_type) (global.get $TYPE_EXPRESSION))
          (i32.eq
            (call $expression_head (call $value_data_lo (local.get $slot)))
            (call $symbol_registry_lookup
              (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_ADD)))))
      (then
        (local.set $inner_args (call $expression_args (call $value_data_lo (local.get $slot))))
        (local.set $term_count (i32.load (call $abs (i32.add (local.get $inner_args) (i32.const 8)))))
        (local.set $term_data (i32.add
          (i32.load (call $abs (i32.add (local.get $inner_args) (i32.const 16))))
          (global.get $GC_HEADER_SIZE))))
      (else
        (local.set $term_data (local.get $slot))
        (local.set $term_count (i32.const 1))))
    (local.set $accumulator (call $algebraic_apoly_from_rational
      (call $rational_new (call $bigint_zero) (call $bigint_one))))
    (if (i32.eqz (local.get $accumulator)) (then (return (i32.const 1))))
    (local.set $term_index (i32.const 0))
    (block $terms_done
      (loop $terms
        (br_if $terms_done (i32.ge_s (local.get $term_index) (local.get $term_count)))
        (if (call $expression_walk_guard (global.get $ALGEBRAIC_MONOMIAL_RECORD_SIZE))
          (then (return (i32.const 1))))
        (local.set $term_slot (i32.add (local.get $term_data)
          (i32.mul (local.get $term_index) (global.get $VALUE_SIZE))))
        (local.set $record (call $carve_scratch_blob (global.get $ALGEBRAIC_MONOMIAL_RECORD_SIZE)))
        (i32.store (call $abs (local.get $record))
          (call $rational_new (call $bigint_one) (call $bigint_one)))
        (i32.store (call $abs (i32.add (local.get $record) (i32.const 4))) (i32.const 0))
        (local.set $status (call $algebraic_classify_term (local.get $record) (local.get $term_slot)))
        (if (local.get $status) (then (return (local.get $status))))
        (local.set $term_apoly (call $algebraic_apoly_of_monomial_record
          (local.get $record) (local.get $registry) (local.get $registry_count)
          (local.get $reps) (local.get $p_gamma)))
        (if (i32.eqz (local.get $term_apoly)) (then (return (i32.const 1))))
        (local.set $accumulator (call $algebraic_apoly_add (local.get $accumulator) (local.get $term_apoly)))
        (if (i32.eqz (local.get $accumulator)) (then (return (i32.const 1))))
        (local.set $term_index (i32.add (local.get $term_index) (i32.const 1)))
        (br $terms)))
    (i32.store (call $abs (local.get $out)) (local.get $accumulator))
    (i32.const 0)
  )

  ;; Build gamma = alpha1 + s2*alpha2 + s3*alpha3 + ... incrementally,
  ;; verifying at each step that the running gamma generates the full
  ;; compositum. The integer multiplier s escalates 1, 2, 3, ... only
  ;; when $algebraic_build_primitive_element_step reports a collision
  ;; through its gcd-over-K degree check. A separately computed
  ;; resultant's squarefree status is not an acceptance criterion:
  ;; squarefree reducible resultants are normal and do not imply a
  ;; primitive-element collision.



  ;; $registry/$registry_count is the distinct-algebraic-value registry
  ;; produced by $algebraic_collect_variable_registry. Returns via
  ;; $gamma_out (the minted AlgebraicNumber header) and $reps_out
  ;; (a scratch array of $registry_count apoly pointers, where reps[i]
  ;; is the polynomial q_i such that q_i(gamma) = registry[i], each of
  ;; degree below gamma's defining polynomial).
  ;; 0 ok / 1 pressure / 2 shift-search limit exceeded.
  (func $algebraic_build_primitive_element
    (param $registry i32) (param $registry_count i32)
    (param $gamma_out i32) (param $reps_out i32)
    (result i32)
    (local $i i32)
    (local $gamma_header i32)
    (local $alpha_header i32)
    (local $s i32)
    (local $unit_apoly i32)
    (local $status i32)
    ;; i = 0: gamma = alpha_0, reps[0] = the identity apoly (gamma^1).
    (local.set $gamma_header (i32.load (call $abs (local.get $registry))))
    (if (call $expression_walk_guard (i32.const 32))
      (then (return (i32.const 1))))
    (local.set $unit_apoly (call $algebraic_apoly_zero_poly (i32.const 1)))
    (if (i32.eqz (local.get $unit_apoly)) (then (return (i32.const 1))))
    (call $algebraic_poly_set_coefficient (local.get $unit_apoly) (i32.const 1)
      (call $rational_new (call $bigint_one) (call $bigint_one)))
    (i32.store (call $abs (local.get $reps_out)) (local.get $unit_apoly))
    (local.set $i (i32.const 1))
    (block $build_done
      (loop $build
        (br_if $build_done (i32.ge_s (local.get $i) (local.get $registry_count)))
        (local.set $alpha_header (i32.load (call $abs (i32.add (local.get $registry) (i32.mul (local.get $i) (i32.const 4))))))
        ;; Escalate s when the candidate generator fails to separate fields:
        ;; status 3 is a non-linear rewrite gcd; status 4 means
        ;; gamma_old + s*alpha collapsed to a Rational because the two
        ;; registered generators were already algebraically dependent.
        ;; Squarefree status alone is insufficient for irreducibility:
        ;; a reducible squarefree resultant is normal (for example, two
        ;; conjugate roots of the same irreducible cubic give a reducible
        ;; degree-9 resultant whose squarefree part is still not gamma's
        ;; minimal polynomial). gamma_new's true minimal polynomial
        ;; comes from algebraic_slot_arith's numeric disambiguation.


        ;; inside _step, one bounded compose_binary call per registry
        ;; element -- not from this loop at all.
        (local.set $s (i32.const 1))
        (block $step_search_done
          (loop $step_search
            (if (i32.gt_s (local.get $s) (i32.const 64))
              (then (return (i32.const 2))))
            (local.set $status (call $algebraic_build_primitive_element_step
              (local.get $gamma_header) (local.get $alpha_header) (local.get $s)
              (local.get $reps_out) (local.get $i)
              (local.get $gamma_out)))
            (br_if $step_search_done (i32.eqz (i32.or
              (i32.eq (local.get $status) (i32.const 3))
              (i32.eq (local.get $status) (i32.const 4)))))
            (local.set $s (i32.add (local.get $s) (i32.const 1)))
            (br $step_search)))
        (if (local.get $status) (then (return (local.get $status))))
        (local.set $gamma_header (i32.load (call $abs (local.get $gamma_out))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $build)))
    (i32.store (call $abs (local.get $gamma_out)) (local.get $gamma_header))
    (i32.const 0)
  )

  ;; Successive-norms elimination (section 3.2): $g_arr (the
  ;; degree+1 x-coefficients from $algebraic_build_g, each a level-r
  ;; polynomial nested t_r outermost down to t_1 innermost) is packed
  ;; into one level-(r+1) polynomial N — x outermost, t_r..t_1 nested
  ;; inside each x-coefficient exactly as $algebraic_build_g produced
  ;; them. Since $algebraic_npoly_resultant (like
  ;; $algebraic_ypoly_resultant, its depth-1 oracle) always eliminates
  ;; ITS OWN OUTER variable, and the variable to eliminate at each
  ;; step (t_r, then t_{r-1}, ...) sits ONE LEVEL BELOW x within every
  ;; x-power slot (not at N's own outer position), N is transposed via
  ;; $algebraic_npoly_transpose_outer before every resultant call to
  ;; bring the CURRENT target to the outer position, matching
  ;; $algebraic_lift_defining_poly's lifted p_alpha (also built with
  ;; the target variable outermost). The resultant's result already
  ;; has x back in the outer position (one level: the eliminated t
  ;; disappears, x — previously one level further in — becomes
  ;; outermost again), ready for the next iteration's transpose against
  ;; the next t. Content-stripped between steps (never full squarefree
  ;; — that stays level-1-only, applied once by the EXISTING
  ;; $algebraic_poly_normalize_squarefree on the final result, by this
  ;; function's caller). Checks for degenerate collapse (degree <= 0
  ;; in whatever N's new outermost variable is) after EVERY step, not
  ;; just the final one (section 6.3) — the caller throws
  ;; MSG_ALGEBRAIC_ZERO_POLYNOMIAL on a nonzero return.
  ;; Returns via $norm_out: 0 ok / 1 pressure / 2 degenerate norm.
  (func $algebraic_eliminate_multivariate
    (param $g_arr i32) (param $g_degree i32)
    (param $registry i32) (param $registry_count i32)
    (param $norm_out i32)
    (result i32)
    (local $n i32)
    (local $depth i32)
    (local $regidx i32)
    (local $alpha_header i32)
    (local $a i32)
    (local $i i32)
    (local $t_degree i32)
    (local $transposed i32)
    ;; Pack: N starts as a level-(registry_count+1) polynomial of
    ;; degree $g_degree in x, coefficients = $g_arr entries verbatim.
    (local.set $n (call $algebraic_poly_carve (local.get $g_degree)))
    (if (i32.eqz (local.get $n)) (then (return (i32.const 1))))
    (local.set $i (i32.const 0))
    (block $pack_done
      (loop $pack
        (br_if $pack_done (i32.gt_s (local.get $i) (local.get $g_degree)))
        (call $algebraic_poly_set_coefficient (local.get $n) (local.get $i)
          (i32.load (call $abs (i32.add (local.get $g_arr) (i32.mul (local.get $i) (i32.const 4))))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $pack)))
    (local.set $depth (i32.add (local.get $registry_count) (i32.const 1)))
    ;; Eliminate one registered variable per step, OUTERMOST-WITHIN-
    ;; EACH-SLOT first: registry index registry_count-1 (t_r, nested
    ;; one level under x in every x-power slot) down to registry index
    ;; 0 (t_1, innermost) -- matching $algebraic_build_g's own
    ;; j = registry_count-1-index placement.
    (local.set $regidx (i32.sub (local.get $registry_count) (i32.const 1)))
    (block $eliminate_done
      (loop $eliminate
        (br_if $eliminate_done (i32.lt_s (local.get $regidx) (i32.const 0)))
        (local.set $alpha_header (i32.load (call $abs (i32.add (local.get $registry)
          (i32.mul (local.get $regidx) (i32.const 4))))))
        ;; Bring the current target t (registry index $regidx) to N's
        ;; outer position: N is currently level-$depth with x outer
        ;; (degree = N's OWN current degree, which may have grown past
        ;; $g_degree after a prior resultant call's Sylvester-matrix
        ;; arithmetic) and the target t nested one level in. $t_degree
        ;; is read LIVE as the max over every x-coefficient's own outer
        ;; (t) degree -- NOT from $max_exponents, which only bounds the
        ;; ORIGINAL polynomial's degree in t and goes stale after the
        ;; first elimination step: a resultant computation can and does
        ;; raise the t-degree of intermediate results (e.g. t appearing
        ;; to the 1st power in G can appear squared in N after one
        ;; elimination step) -- transpose swaps them.
        (local.set $t_degree (i32.const -1))
        (local.set $i (i32.const 0))
        (block $t_degree_scan_done
          (loop $t_degree_scan
            (br_if $t_degree_scan_done (i32.gt_s (local.get $i) (call $algebraic_poly_degree (local.get $n))))
            (if (i32.gt_s
                  (call $algebraic_poly_degree (call $algebraic_poly_coefficient (local.get $n) (local.get $i)))
                  (local.get $t_degree))
              (then (local.set $t_degree
                (call $algebraic_poly_degree (call $algebraic_poly_coefficient (local.get $n) (local.get $i))))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $t_degree_scan)))
        (if (i32.lt_s (local.get $t_degree) (i32.const 0)) (then (local.set $t_degree (i32.const 0))))
        (local.set $transposed (call $algebraic_npoly_transpose_outer
          (local.get $n) (call $algebraic_poly_degree (local.get $n)) (local.get $t_degree) (local.get $depth)))
        (if (i32.eqz (local.get $transposed)) (then (return (i32.const 1))))
        ;; A = p_alpha(t) lifted to the SAME depth as N's current
        ;; outermost level (constant at every level below it).
        (local.set $a (call $algebraic_lift_defining_poly (local.get $alpha_header) (local.get $depth)))
        (if (i32.eqz (local.get $a)) (then (return (i32.const 1))))
        (local.set $n (call $algebraic_npoly_resultant (local.get $a) (local.get $transposed) (local.get $depth)))
        (if (i32.eqz (local.get $n)) (then (return (i32.const 1))))
        (local.set $depth (i32.sub (local.get $depth) (i32.const 1)))
        ;; $depth is always >= 1 here: this loop runs exactly
        ;; $registry_count times, starting from depth = registry_count+1,
        ;; so the final iteration lands on depth=1 (a plain xpoly),
        ;; never 0 — $algebraic_npoly_trim already IS depth-generic
        ;; down to and including depth=1 (its own depth-0 leaf check
        ;; is bigint_length==0, matching $algebraic_poly_trim exactly).
        (call $algebraic_npoly_trim (local.get $n) (local.get $depth))
        ;; Degenerate: N collapsed to degree <= 0 in its new outermost
        ;; variable (section 6.3 — a genuinely reachable degeneracy at
        ;; r >= 2's intermediate steps, unlike r=1's own rare "reducible
        ;; sibling root" case; the disjoint-support argument that made
        ;; it rare there no longer applies once several values with
        ;; possibly-related minimal polynomials are combined).
        (if (i32.le_s (call $algebraic_poly_degree (local.get $n)) (i32.const 0))
          (then (return (i32.const 2))))
        ;; Content-strip BETWEEN steps only (never full squarefree at
        ;; intermediate levels — section 3.2's ruling) to keep
        ;; coefficient bigints from growing purely from a shared
        ;; factor. The FINAL step (depth reaches 1, a plain xpoly) is
        ;; deliberately left un-stripped here: the caller applies the
        ;; EXISTING, unmodified $algebraic_poly_normalize_squarefree
        ;; to the final result exactly once, matching the r=1 path's
        ;; own convention precisely (content-strip + squarefree in one
        ;; call, no redundant work).
        (if (i32.gt_s (local.get $depth) (i32.const 1))
          (then
            (local.set $n (call $algebraic_npoly_content_strip (local.get $n) (local.get $depth)))
            (if (i32.eqz (local.get $n)) (then (return (i32.const 1))))))
        (local.set $regidx (i32.sub (local.get $regidx) (i32.const 1)))
        (br $eliminate)))
    (i32.store (call $abs (local.get $norm_out)) (local.get $n))
    (i32.const 0)
  )

  ;; Given a (possibly reducible) squarefree polynomial $norm, its
  ;; pre-computed irreducible factor list ($factors/$factor_count, from
  ;; $algebraic_zz_zassenhaus), and an isolation $entry for one of
  ;; norm's roots, finds the ONE irreducible factor that actually
  ;; brackets that root (a genuine sign change across the entry's own
  ;; isolating interval — the same bracketing test $algebraic_isolate
  ;; itself uses) and writes it to $factor_out. A point entry, or
  ;; factor_count<=1, short-circuits to $norm itself (no bracketing
  ;; needed — mirrors $algebraic_compose_binary's own established
  ;; fallback for the analogous resultant-factoring case).
  ;; 0 ok / 1 pressure. unreachable if no factor brackets the root
  ;; (norm IS a root of the input, hence of exactly one factor — a
  ;; miss here means something upstream is inconsistent).
  (func $algebraic_bracket_norm_factor
    (param $norm i32) (param $factors i32) (param $factor_count i32)
    (param $entry i32) (param $factor_out i32)
    (result i32)
    (local $low i32)
    (local $high i32)
    (local $i i32)
    (local $candidate i32)
    (local $sign_low i32)
    (local $sign_high i32)
    (local $found i32)
    (if (i32.or (i32.eqz (i32.load (call $abs (local.get $entry))))
          (i32.le_s (local.get $factor_count) (i32.const 1)))
      (then
        (i32.store (call $abs (local.get $factor_out)) (local.get $norm))
        (return (i32.const 0))))
    (local.set $low (call $algebraic_entry_bound_rational (local.get $entry) (i32.const 0)))
    (if (i32.eqz (local.get $low)) (then (return (i32.const 1))))
    (local.set $high (call $algebraic_entry_bound_rational (local.get $entry) (i32.const 1)))
    (if (i32.eqz (local.get $high)) (then (return (i32.const 1))))
    (local.set $found (i32.const 0))
    (local.set $i (i32.const 0))
    (block $search_done
      (loop $search
        (br_if $search_done (i32.ge_s (local.get $i) (local.get $factor_count)))
        (local.set $candidate (i32.load (call $abs
          (i32.add (local.get $factors) (i32.mul (local.get $i) (i32.const 4))))))
        (local.set $sign_low (call $algebraic_sign_at (local.get $candidate)
          (call $rational_numerator (local.get $low)) (call $rational_denominator (local.get $low))))
        (if (i32.eq (local.get $sign_low) (i32.const 2)) (then (return (i32.const 1))))
        (local.set $sign_high (call $algebraic_sign_at (local.get $candidate)
          (call $rational_numerator (local.get $high)) (call $rational_denominator (local.get $high))))
        (if (i32.eq (local.get $sign_high) (i32.const 2)) (then (return (i32.const 1))))
        (if (i32.or (i32.ne (local.get $sign_low) (local.get $sign_high))
              (i32.eqz (local.get $sign_low)))
          (then
            (i32.store (call $abs (local.get $factor_out)) (local.get $candidate))
            (local.set $found (i32.const 1))
            (br $search_done)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $search)))
    (if (i32.eqz (local.get $found)) (then (unreachable)))
    (i32.const 0)
  )

  ;; Multiply two closed rational intervals. The four endpoint products
  ;; are exact; min/max therefore gives a rigorous enclosure. Writes
  ;; Rational headers to the two caller-owned pointer slots.
  ;; 0 ok / 1 pressure.
  (func $algebraic_interval_multiply
    (param $left_low i32) (param $left_high i32)
    (param $right_low i32) (param $right_high i32)
    (param $low_out i32) (param $high_out i32)
    (result i32)
    (local $product i32)
    (local $minimum i32)
    (local $maximum i32)
    (if (call $algebraic_rational_guard (local.get $left_low) (local.get $right_low))
      (then (return (i32.const 1))))
    (local.set $product (call $rational_mul (local.get $left_low) (local.get $right_low)))
    (local.set $minimum (local.get $product))
    (local.set $maximum (local.get $product))
    (if (call $algebraic_rational_guard (local.get $left_low) (local.get $right_high))
      (then (return (i32.const 1))))
    (local.set $product (call $rational_mul (local.get $left_low) (local.get $right_high)))
    (if (i32.lt_s (call $rational_header_pair_compare
          (local.get $product) (local.get $minimum)) (i32.const 0))
      (then (local.set $minimum (local.get $product))))
    (if (i32.gt_s (call $rational_header_pair_compare
          (local.get $product) (local.get $maximum)) (i32.const 0))
      (then (local.set $maximum (local.get $product))))
    (if (call $algebraic_rational_guard (local.get $left_high) (local.get $right_low))
      (then (return (i32.const 1))))
    (local.set $product (call $rational_mul (local.get $left_high) (local.get $right_low)))
    (if (i32.lt_s (call $rational_header_pair_compare
          (local.get $product) (local.get $minimum)) (i32.const 0))
      (then (local.set $minimum (local.get $product))))
    (if (i32.gt_s (call $rational_header_pair_compare
          (local.get $product) (local.get $maximum)) (i32.const 0))
      (then (local.set $maximum (local.get $product))))
    (if (call $algebraic_rational_guard (local.get $left_high) (local.get $right_high))
      (then (return (i32.const 1))))
    (local.set $product (call $rational_mul (local.get $left_high) (local.get $right_high)))
    (if (i32.lt_s (call $rational_header_pair_compare
          (local.get $product) (local.get $minimum)) (i32.const 0))
      (then (local.set $minimum (local.get $product))))
    (if (i32.gt_s (call $rational_header_pair_compare
          (local.get $product) (local.get $maximum)) (i32.const 0))
      (then (local.set $maximum (local.get $product))))
    (i32.store (call $abs (local.get $low_out)) (local.get $minimum))
    (i32.store (call $abs (local.get $high_out)) (local.get $maximum))
    (i32.const 0)
  )

  ;; Rigorous interval prefilter for one isolated eliminant root. Evaluates
  ;; the original polynomial by interval Horner arithmetic, directly from
  ;; its classified rational/algebraic coefficient terms. A result interval
  ;; disjoint from zero proves the candidate false; an interval containing
  ;; zero is deliberately inconclusive and falls through to the exact field
  ;; filter. 0 inconclusive / 1 definitely nonzero / 2 pressure.
  (func $algebraic_candidate_interval_excludes_zero
    (param $list i32) (param $degree i32) (param $entry i32)
    (result i32)
    (local $x_low i32)
    (local $x_high i32)
    (local $zero i32)
    (local $coefficient_index i32)
    (local $accumulator_initialized i32)
    (local $accumulator_low i32)
    (local $accumulator_high i32)
    (local $coefficient_low i32)
    (local $coefficient_high i32)
    (local $slot i32)
    (local $slot_type i32)
    (local $inner_args i32)
    (local $term_count i32)
    (local $term_data i32)
    (local $term_index i32)
    (local $term_slot i32)
    (local $record i32)
    (local $status i32)
    (local $term_low i32)
    (local $term_high i32)
    (local $factor_count i32)
    (local $factor_index i32)
    (local $alpha_header i32)
    (local $exponent i32)
    (local $exponent_index i32)
    (local $interval_data i32)
    (local $factor_low i32)
    (local $factor_high i32)
    (local $multiplied_low_out i32)
    (local $multiplied_high_out i32)
    (local.set $x_low (call $algebraic_entry_bound_rational
      (local.get $entry) (i32.const 0)))
    (if (i32.eqz (local.get $x_low)) (then (return (i32.const 2))))
    (local.set $x_high (call $algebraic_entry_bound_rational
      (local.get $entry) (i32.const 1)))
    (if (i32.eqz (local.get $x_high)) (then (return (i32.const 2))))
    (if (call $expression_walk_guard (i32.const 64))
      (then (return (i32.const 2))))
    (local.set $multiplied_low_out (call $carve_scratch_blob (i32.const 4)))
    (local.set $multiplied_high_out (call $carve_scratch_blob (i32.const 4)))
    (local.set $zero (call $rational_new (call $bigint_zero) (call $bigint_one)))
    (local.set $coefficient_index (local.get $degree))
    (local.set $accumulator_initialized (i32.const 0))
    (block $coefficients_done
      (loop $coefficients
        (br_if $coefficients_done (i32.lt_s (local.get $coefficient_index) (i32.const 0)))
        (local.set $slot (i32.add (local.get $list)
          (i32.mul (local.get $coefficient_index) (global.get $VALUE_SIZE))))
        (local.set $slot_type (call $value_type (local.get $slot)))
        (if (i32.and
              (i32.eq (local.get $slot_type) (global.get $TYPE_EXPRESSION))
              (i32.eq
                (call $expression_head (call $value_data_lo (local.get $slot)))
                (call $symbol_registry_lookup
                  (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_ADD)))))
          (then
            (local.set $inner_args (call $expression_args (call $value_data_lo (local.get $slot))))
            (local.set $term_count
              (i32.load (call $abs (i32.add (local.get $inner_args) (i32.const 8)))))
            (local.set $term_data (i32.add
              (i32.load (call $abs (i32.add (local.get $inner_args) (i32.const 16))))
              (global.get $GC_HEADER_SIZE))))
          (else
            (local.set $term_count (i32.const 1))
            (local.set $term_data (local.get $slot))))
        (local.set $coefficient_low (local.get $zero))
        (local.set $coefficient_high (local.get $zero))
        (local.set $term_index (i32.const 0))
        (block $terms_done
          (loop $terms
            (br_if $terms_done (i32.ge_s (local.get $term_index) (local.get $term_count)))
            (if (call $expression_walk_guard (global.get $ALGEBRAIC_MONOMIAL_RECORD_SIZE))
              (then (return (i32.const 2))))
            (local.set $term_slot (i32.add (local.get $term_data)
              (i32.mul (local.get $term_index) (global.get $VALUE_SIZE))))
            (local.set $record (call $carve_scratch_blob
              (global.get $ALGEBRAIC_MONOMIAL_RECORD_SIZE)))
            (i32.store (call $abs (local.get $record))
              (call $rational_new (call $bigint_one) (call $bigint_one)))
            (i32.store (call $abs (i32.add (local.get $record) (i32.const 4)))
              (i32.const 0))
            (local.set $status (call $algebraic_classify_term
              (local.get $record) (local.get $term_slot)))
            (if (i32.eq (local.get $status) (i32.const 1))
              (then (return (i32.const 2))))
            (if (local.get $status) (then (unreachable)))
            (local.set $term_low (i32.load (call $abs (local.get $record))))
            (local.set $term_high (local.get $term_low))
            (local.set $factor_count
              (i32.load (call $abs (i32.add (local.get $record) (i32.const 4)))))
            (local.set $factor_index (i32.const 0))
            (block $factors_done
              (loop $factors
                (br_if $factors_done
                  (i32.ge_s (local.get $factor_index) (local.get $factor_count)))
                (local.set $alpha_header (i32.load (call $abs
                  (i32.add (local.get $record)
                    (i32.add (i32.const 8)
                      (i32.mul (local.get $factor_index) (i32.const 8)))))))
                (local.set $exponent (i32.load (call $abs
                  (i32.add (local.get $record)
                    (i32.add (i32.const 12)
                      (i32.mul (local.get $factor_index) (i32.const 8)))))))
                (local.set $interval_data (i32.add
                  (i32.load (call $abs (i32.add
                    (call $algebraic_interval_of (local.get $alpha_header))
                    (i32.const 16))))
                  (global.get $GC_HEADER_SIZE)))
                (local.set $factor_low
                  (call $rational_materialize (local.get $interval_data)))
                (local.set $factor_high (call $rational_materialize
                  (i32.add (local.get $interval_data) (global.get $VALUE_SIZE))))
                (local.set $exponent_index (i32.const 0))
                (block $powers_done
                  (loop $powers
                    (br_if $powers_done
                      (i32.ge_s (local.get $exponent_index) (local.get $exponent)))
                    (if (call $algebraic_interval_multiply
                          (local.get $term_low) (local.get $term_high)
                          (local.get $factor_low) (local.get $factor_high)
                          (local.get $multiplied_low_out) (local.get $multiplied_high_out))
                      (then (return (i32.const 2))))
                    (local.set $term_low
                      (i32.load (call $abs (local.get $multiplied_low_out))))
                    (local.set $term_high
                      (i32.load (call $abs (local.get $multiplied_high_out))))
                    (local.set $exponent_index
                      (i32.add (local.get $exponent_index) (i32.const 1)))
                    (br $powers)))
                (local.set $factor_index
                  (i32.add (local.get $factor_index) (i32.const 1)))
                (br $factors)))
            (if (call $algebraic_rational_guard
                  (local.get $coefficient_low) (local.get $term_low))
              (then (return (i32.const 2))))
            (local.set $coefficient_low
              (call $rational_add (local.get $coefficient_low) (local.get $term_low)))
            (if (call $algebraic_rational_guard
                  (local.get $coefficient_high) (local.get $term_high))
              (then (return (i32.const 2))))
            (local.set $coefficient_high
              (call $rational_add (local.get $coefficient_high) (local.get $term_high)))
            (local.set $term_index (i32.add (local.get $term_index) (i32.const 1)))
            (br $terms)))
        (if (i32.eqz (local.get $accumulator_initialized))
          (then
            (local.set $accumulator_low (local.get $coefficient_low))
            (local.set $accumulator_high (local.get $coefficient_high))
            (local.set $accumulator_initialized (i32.const 1)))
          (else
            (if (call $algebraic_interval_multiply
                  (local.get $accumulator_low) (local.get $accumulator_high)
                  (local.get $x_low) (local.get $x_high)
                  (local.get $multiplied_low_out) (local.get $multiplied_high_out))
              (then (return (i32.const 2))))
            (if (call $algebraic_rational_guard
                  (i32.load (call $abs (local.get $multiplied_low_out)))
                  (local.get $coefficient_low))
              (then (return (i32.const 2))))
            (local.set $accumulator_low (call $rational_add
              (i32.load (call $abs (local.get $multiplied_low_out)))
              (local.get $coefficient_low)))
            (if (call $algebraic_rational_guard
                  (i32.load (call $abs (local.get $multiplied_high_out)))
                  (local.get $coefficient_high))
              (then (return (i32.const 2))))
            (local.set $accumulator_high (call $rational_add
              (i32.load (call $abs (local.get $multiplied_high_out)))
              (local.get $coefficient_high)))))
        (local.set $coefficient_index
          (i32.sub (local.get $coefficient_index) (i32.const 1)))
        (br $coefficients)))
    (if (i32.lt_s
          (call $rational_header_pair_compare
            (local.get $accumulator_high) (local.get $zero))
          (i32.const 0))
      (then (return (i32.const 1))))
    (if (i32.gt_s
          (call $rational_header_pair_compare
            (local.get $accumulator_low) (local.get $zero))
          (i32.const 0))
      (then (return (i32.const 1))))
    (i32.const 0)
  )

  ;; rootsOfPolynomial(expression, variable) — all real roots in
  ;; increasing order: exact Rationals where the value is rational
  ;; (dyadic bisection hits and the degree-1 renormalisation),
  ;; AlgebraicNumbers otherwise. 6a accepts rational numeric
  ;; coefficients only.
  (func $algebraic_roots_of_polynomial
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $argument2_pointer i32)
    (local $arg2_type i32)
    (local $stage i32)
    (local $stage2 i32)
    (local $stage_slots i32)
    (local $residual i32)
    (local $degree64 i64)
    (local $degree i32)
    (local $list i32)
    (local $status i32)
    (local $i i32)
    (local $slot i32)
    (local $slot_type i32)
    (local $pairs i32)
    (local $one_header i32)
    (local $rational_header i32)
    (local $numerator i32)
    (local $denominator i32)
    (local $common_multiple i32)
    (local $gcd i32)
    (local $poly i32)
    (local $leading i32)
    (local $content i32)
    (local $squarefree_degree i32)
    (local $output i32)
    (local $count i32)
    (local $result_array i32)
    (local $result_data i32)
    (local $entry i32)
    (local $entry_kind i32)
    (local $root_rational i32)
    (local $has_algebraic i32)
    (local $norm i32)
    (local $x0_slot i32)
    (local $survivor_count i32)
    (local $registry i32)
    (local $max_exponents i32)
    (local $count_scratch i32)
    (local $registry_count i32)
    (local $g_out i32)
    (local $norm_out i32)
    (local $norm_factors i32)
    (local $norm_factor_count i32)
    (local $minimal_factor i32)
    (local $minimal_factor_out i32)
    (local $bracket_status i32)
    (local $primitive_generator_out i32)
    (local $primitive_generator_header i32)
    (local $primitive_representations i32)
    (local $primitive_modulus i32)
    (local $coefficient_field_elements i32)
    (local $coefficient_field_element_out i32)
    (local $candidate_representations i32)
    (local $candidate_generator_out i32)
    (local $candidate_generator_header i32)
    (local $candidate_modulus i32)
    (local $candidate_representation i32)
    (local $candidate_coefficient_field_elements i32)
    (local $candidate_evaluation i32)
    (local $generator_unit i32)
    (local $scaled_candidate_representation i32)
    (local $old_generator_representation i32)
    (local $rewritten_coefficient i32)
    (local $shift_multiplier i32)
    (local $candidate_interval_status i32)
    (local $candidate_interval_round i32)
    (local $candidate_interval_refine_index i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))))
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then
        (local.set $argument2_pointer (i32.add (local.get $argument1_pointer) (global.get $VALUE_SIZE)))
        (local.set $arg2_type (call $value_type (local.get $argument2_pointer)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (i32.ne (local.get $arg2_type) (global.get $TYPE_SYMBOL))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_ALGEBRAIC_VARIABLE))))))
    ;; Canonicalize the input.
    (if (call $expression_walk_guard (i32.add
          (i32.mul (i32.const 2) (global.get $VALUE_SIZE)) (i32.const 32)))
      (then (return (i32.const 0))))
    (local.set $stage (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (local.set $residual (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (if (call $expression_simplify_into (local.get $argument1_pointer) (local.get $stage))
      (then (return (i32.const 0))))
    (if (call $expression_value_is_zero_wide (local.get $stage))
      (then
        (if (global.get $memory_pressure_signaled) (then (return (i32.const 0))))
        (return (i32.add (i32.const 1)
          (call $throw_range_error_with_message (global.get $BUILTIN_MSG_ALGEBRAIC_ZERO_POLYNOMIAL))))))
    (if (global.get $memory_pressure_signaled) (then (return (i32.const 0))))
    (drop (call $poly_measure_factors (local.get $stage)))
    (local.set $stage_slots (global.get $term_factors_count))
    (if (call $expression_walk_guard
          (i32.add (i32.mul (local.get $stage_slots) (i32.const 16)) (i32.const 16)))
      (then (return (i32.const 0))))
    (local.set $stage2 (call $carve_scratch_blob
      (i32.mul (local.get $stage_slots) (i32.const 16))))
    (local.set $degree64 (call $poly_degree_in
      (local.get $stage) (local.get $argument2_pointer)
      (local.get $stage2) (local.get $stage_slots) (local.get $residual)))
    (if (i64.eq (local.get $degree64) (i64.const -1))
      (then (return (i32.const 0))))
    (if (i64.lt_s (local.get $degree64) (i64.const 0))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_ALGEBRAIC_NOT_POLYNOMIAL))))))
    (if (i64.gt_s (local.get $degree64) (i64.const 1000000))
      (then (return (i32.add (i32.const 1)
        (call $throw_range_error_with_message (global.get $BUILTIN_MSG_ALGEBRAIC_DEGREE))))))
    (local.set $degree (i32.wrap_i64 (local.get $degree64)))
    ;; Extract and validate the coefficients.
    (if (call $expression_walk_guard
          (i32.mul (i32.add (local.get $degree) (i32.const 1)) (global.get $VALUE_SIZE)))
      (then (return (i32.const 0))))
    (local.set $list (call $carve_scratch_blob
      (i32.mul (i32.add (local.get $degree) (i32.const 1)) (global.get $VALUE_SIZE))))
    (local.set $status (call $poly_extract_coefficients
      (local.get $stage) (local.get $argument2_pointer) (local.get $degree)
      (local.get $list) (local.get $stage2) (local.get $stage_slots)
      (local.get $residual)))
    (if (i32.eq (local.get $status) (i32.const 1)) (then (return (i32.const 0))))
    (if (local.get $status)
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_ALGEBRAIC_NOT_POLYNOMIAL))))))
    ;; Coefficients may be rational numerics or products and powers of
    ;; any finite set of distinct algebraic values, generalizing the
    ;; single-α ℚ-linear form. Collect the distinct-variable registry and
    ;; build G, the level-(r+1) nested polynomial in x and the registered
    ;; variables, before rewriting $list's original coefficients.
    ;; The original expression tree must remain intact while
    ;; $algebraic_build_g scans its terms through
    ;; algebraic_classify_term) needs the tree structure intact. Only
    ;; AFTER that is each slot rewritten to its computed VALUE (via the
    ;; general $algebraic_evaluate_node, the same evaluator
    ;; Exact.fromExpression uses) for the later Horner filter, which
    ;; needs actual algebraic/rational values, not expression trees.
    (if (call $expression_walk_guard (i32.mul
          (i32.const 2) (i32.mul (global.get $ALGEBRAIC_MAX_VARIABLES) (i32.const 4))))
      (then (return (i32.const 0))))
    (local.set $registry (call $carve_scratch_blob
      (i32.mul (global.get $ALGEBRAIC_MAX_VARIABLES) (i32.const 4))))
    (local.set $max_exponents (call $carve_scratch_blob
      (i32.mul (global.get $ALGEBRAIC_MAX_VARIABLES) (i32.const 4))))
    (local.set $count_scratch (call $carve_scratch_blob (i32.const 4)))
    (local.set $status (call $algebraic_collect_variable_registry
      (local.get $list) (local.get $degree) (local.get $registry)
      (local.get $max_exponents) (local.get $count_scratch)))
    (if (i32.eq (local.get $status) (i32.const 1)) (then (return (i32.const 0))))
    (if (i32.eq (local.get $status) (i32.const 2))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_ALGEBRAIC_COEFFICIENT_TYPE))))))
    (if (i32.eq (local.get $status) (i32.const 3))
      (then (return (i32.add (i32.const 1)
        (call $throw_range_error_with_message (global.get $BUILTIN_MSG_ALGEBRAIC_TOO_MANY_FACTORS))))))
    (if (i32.eq (local.get $status) (i32.const 4))
      (then (return (i32.add (i32.const 1)
        (call $throw_range_error_with_message (global.get $BUILTIN_MSG_ALGEBRAIC_TOO_MANY_VARIABLES))))))
    (local.set $registry_count (i32.load (call $abs (local.get $count_scratch))))
    (local.set $has_algebraic (i32.ne (local.get $registry_count) (i32.const 0)))
    (if (local.get $has_algebraic)
      (then
        ;; Option B: build one primitive generator for the coefficient
        ;; field, rewrite every original coefficient as a closed field
        ;; element, and retain the expression slots unchanged for build_g.
        (if (call $expression_walk_guard (i32.add
              (i32.mul (local.get $registry_count) (i32.const 4))
              (i32.add (i32.mul (i32.add (local.get $degree) (i32.const 1)) (i32.const 4))
                (i32.const 32))))
          (then (return (i32.const 0))))
        (local.set $primitive_generator_out (call $carve_scratch_blob (i32.const 4)))
        (local.set $primitive_representations (call $carve_scratch_blob
          (i32.mul (local.get $registry_count) (i32.const 4))))
        (local.set $coefficient_field_elements (call $carve_scratch_blob
          (i32.mul (i32.add (local.get $degree) (i32.const 1)) (i32.const 4))))
        (local.set $coefficient_field_element_out (call $carve_scratch_blob (i32.const 4)))
        (local.set $status (call $algebraic_build_primitive_element
          (local.get $registry) (local.get $registry_count)
          (local.get $primitive_generator_out) (local.get $primitive_representations)))
        (if (i32.eq (local.get $status) (i32.const 1)) (then (return (i32.const 0))))
        (if (i32.eq (local.get $status) (i32.const 2))
          (then (return (i32.add (i32.const 1)
            (call $throw_range_error_with_message
              (global.get $BUILTIN_MSG_ALGEBRAIC_PRIMITIVE_ELEMENT_SHIFT_LIMIT))))))
        (if (local.get $status) (then (unreachable)))
        (local.set $primitive_generator_header
          (i32.load (call $abs (local.get $primitive_generator_out))))
        (local.set $primitive_modulus (call $algebraic_apoly_from_bigint_poly
          (call $algebraic_poly_from_array
            (call $algebraic_coefficients_of (local.get $primitive_generator_header)))))
        (if (i32.eqz (local.get $primitive_modulus)) (then (return (i32.const 0))))
        (local.set $i (i32.const 0))
        (block $coefficient_field_elements_done
          (loop $coefficient_field_elements_loop
            (br_if $coefficient_field_elements_done
              (i32.gt_s (local.get $i) (local.get $degree)))
            (local.set $slot (i32.add (local.get $list)
              (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
            (local.set $status (call $algebraic_apoly_of_coefficient_slot
              (local.get $slot) (local.get $registry) (local.get $registry_count)
              (local.get $primitive_representations) (local.get $primitive_modulus)
              (local.get $coefficient_field_element_out)))
            (if (i32.eq (local.get $status) (i32.const 1)) (then (return (i32.const 0))))
            (if (i32.eq (local.get $status) (i32.const 2))
              (then (return (i32.add (i32.const 1)
                (call $throw_type_error_with_message
                  (global.get $BUILTIN_MSG_ALGEBRAIC_COEFFICIENT_TYPE))))))
            (if (i32.eq (local.get $status) (i32.const 3))
              (then (return (i32.add (i32.const 1)
                (call $throw_range_error_with_message
                  (global.get $BUILTIN_MSG_ALGEBRAIC_TOO_MANY_FACTORS))))))
            (i32.store (call $abs (i32.add (local.get $coefficient_field_elements)
              (i32.mul (local.get $i) (i32.const 4))))
              (i32.load (call $abs (local.get $coefficient_field_element_out))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $coefficient_field_elements_loop)))
        (if (call $expression_walk_guard
              (i32.mul (i32.add (local.get $degree) (i32.const 1)) (i32.const 4)))
          (then (return (i32.const 0))))
        (local.set $g_out (call $carve_scratch_blob
          (i32.mul (i32.add (local.get $degree) (i32.const 1)) (i32.const 4))))
        (local.set $status (call $algebraic_build_g
          (local.get $list) (local.get $degree)
          (local.get $registry) (local.get $registry_count) (local.get $max_exponents)
          (local.get $g_out)))
        (if (i32.eq (local.get $status) (i32.const 1)) (then (return (i32.const 0))))
        (if (local.get $status)
          (then (return (i32.add (i32.const 1)
            (call $throw_type_error_with_message (global.get $BUILTIN_MSG_ALGEBRAIC_COEFFICIENT_TYPE))))))
        (local.set $norm_out (call $carve_scratch_blob (i32.const 4)))
        (local.set $status (call $algebraic_eliminate_multivariate
          (local.get $g_out) (local.get $degree) (local.get $registry) (local.get $registry_count)
          (local.get $norm_out)))
        (if (i32.eq (local.get $status) (i32.const 1)) (then (return (i32.const 0))))
        (if (i32.eq (local.get $status) (i32.const 2))
          (then (return (i32.add (i32.const 1)
            (call $throw_range_error_with_message (global.get $BUILTIN_MSG_ALGEBRAIC_ZERO_POLYNOMIAL))))))
        (local.set $norm (i32.load (call $abs (local.get $norm_out))))
        (local.set $norm (call $algebraic_poly_normalize_squarefree (local.get $norm)))
        (if (i32.eqz (local.get $norm)) (then (return (i32.const 0))))
        ;; $norm is only squarefree; it is not checked for irreducibility,
        ;; just as in $algebraic_compose_binary. Minting x0 against the
        ;; raw, possibly reducible norm still gives a valid root because
        ;; x0 belongs to exactly one irreducible factor, but it carries
        ;; an unnecessarily large defining polynomial into later work.



        ;; operation on x0 (the Horner filter below still calls
        ;; algebraic_slot_arith/compose_binary), which can turn a small
        ;; true field into an intractable one (confirmed: a degree-32
        ;; norm that factors into two genuine degree-16 irreducibles,
        ;; from `x^2-(sqrt2+sqrt3+sqrt5)*x+sqrt2*sqrt3`). Factor once
        ;; here (not per-candidate -- norm doesn't change across
        ;; candidates), fall back to treating norm as irreducible on
        ;; -2/-3 (a generous/no-prime-found degradation, never wrong,
        ;; matching compose_binary's own established fallback).
        (local.set $norm_factors (call $carve_scratch_blob (i32.mul (i32.const 16) (i32.const 4))))
        (local.set $norm_factor_count (call $algebraic_zz_zassenhaus
          (local.get $norm) (local.get $norm_factors) (i32.const 16)))
        (if (i32.or (i32.eq (local.get $norm_factor_count) (i32.const -3)) (i32.eq (local.get $norm_factor_count) (i32.const -2)))
          (then (local.set $norm_factor_count (i32.const 1))))
        (if (i32.lt_s (local.get $norm_factor_count) (i32.const 0))
          (then (return (i32.const 0))))))
    ;; Degree 0: a nonzero constant — no roots.
    (if (i32.eqz (local.get $degree))
      (then
        (if (call $expression_walk_guard (call $estimate_array_size (i32.const 0)))
          (then (return (i32.const 0))))
        (local.set $result_array (call $allocate_array (i32.const 0)))
        (call $expression_freeze_args_array (local.get $result_array))
        (call $pending_push (global.get $TYPE_ARRAY) (i32.const 0)
          (local.get $result_array) (i32.const 0))
        (return (i32.const 0))))
    ;; ---- Multivariate norm elimination and exact filtering ----
    ;; $norm (computed above, before the rewrite pass) is a rational-
    ;; coefficient polynomial in x whose roots contain F's — isolate,
    ;; then filter EXACTLY: each candidate is minted and F
    ;; Horner-evaluated at it as closed arithmetic in one primitive
    ;; field; survivors are the answer (no interval-iteration or
    ;; compose_binary candidate-matching loop).
    (if (local.get $has_algebraic)
      (then
        (if (call $expression_walk_guard (i32.add
              (i32.mul (call $algebraic_poly_degree (local.get $norm)) (i32.const 20))
              (i32.add (global.get $VALUE_SIZE)
                (i32.add
                  (i32.mul (i32.add (local.get $registry_count) (i32.const 1)) (i32.const 4))
                  (i32.add
                    (i32.mul (i32.add (local.get $degree) (i32.const 1)) (i32.const 4))
                    (i32.const 64))))))
          (then (return (i32.const 0))))
        (local.set $output (call $carve_scratch_blob
          (i32.mul (call $algebraic_poly_degree (local.get $norm)) (i32.const 20))))
        (if (call $algebraic_isolate (local.get $norm) (local.get $output))
          (then (return (i32.const 0))))
        (local.set $count (global.get $algebraic_isolate_count))
        (local.set $x0_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
        (local.set $candidate_representations (call $carve_scratch_blob
          (i32.mul (i32.add (local.get $registry_count) (i32.const 1)) (i32.const 4))))
        (local.set $candidate_generator_out (call $carve_scratch_blob (i32.const 4)))
        (local.set $candidate_coefficient_field_elements (call $carve_scratch_blob
          (i32.mul (i32.add (local.get $degree) (i32.const 1)) (i32.const 4))))
        ;; Reject candidates first with rigorous rational interval Horner
        ;; arithmetic. Only candidates whose enclosure still contains zero
        ;; pay for the exact shared-field test below. Survivors compact down
        ;; in place (order preserved — output is ascending).
        (local.set $survivor_count (i32.const 0))
        (local.set $i (i32.const 0))
        (block $filter_done
          (loop $filter
            (br_if $filter_done (i32.ge_s (local.get $i) (local.get $count)))
            (local.set $entry (i32.add (local.get $output)
              (i32.mul (local.get $i) (i32.const 20))))
            (local.set $candidate_interval_round (i32.const 0))
            (block $candidate_prefilter_done
              (loop $candidate_prefilter
                (local.set $candidate_interval_status
                  (call $algebraic_candidate_interval_excludes_zero
                    (local.get $list) (local.get $degree) (local.get $entry)))
                (if (i32.eq (local.get $candidate_interval_status) (i32.const 2))
                  (then (return (i32.const 0))))
                (if (i32.eq (local.get $candidate_interval_status) (i32.const 1))
                  (then
                    (local.set $i (i32.add (local.get $i) (i32.const 1)))
                    (br $filter)))
                (br_if $candidate_prefilter_done
                  (i32.ge_s (local.get $candidate_interval_round) (i32.const 8)))
                ;; Narrow every distinct coefficient atom and this candidate
                ;; together. The enclosures remain nested, so every rejection
                ;; remains a proof; eight rounds are only a cheap prefilter cap.
                (local.set $candidate_interval_refine_index (i32.const 0))
                (block $coefficient_refinement_done
                  (loop $coefficient_refinement
                    (br_if $coefficient_refinement_done
                      (i32.ge_s (local.get $candidate_interval_refine_index)
                        (local.get $registry_count)))
                    (if (call $algebraic_refine_step
                          (i32.load (call $abs (i32.add (local.get $registry)
                            (i32.mul (local.get $candidate_interval_refine_index)
                              (i32.const 4))))))
                      (then (return (i32.const 0))))
                    (local.set $candidate_interval_refine_index
                      (i32.add (local.get $candidate_interval_refine_index)
                        (i32.const 1)))
                    (br $coefficient_refinement)))
                (if (i32.ne (i32.load (call $abs (local.get $entry))) (i32.const 0))
                  (then
                    (if (call $algebraic_entry_bisect
                          (local.get $norm) (local.get $entry))
                      (then (return (i32.const 0))))))
                (local.set $candidate_interval_round
                  (i32.add (local.get $candidate_interval_round) (i32.const 1)))
                (br $candidate_prefilter)))
            (local.set $minimal_factor_out (call $carve_scratch_blob (i32.const 4)))
            (local.set $bracket_status (call $algebraic_bracket_norm_factor
              (local.get $norm) (local.get $norm_factors) (local.get $norm_factor_count)
              (local.get $entry) (local.get $minimal_factor_out)))
            (if (local.get $bracket_status) (then (return (i32.const 0))))
            (local.set $minimal_factor (i32.load (call $abs (local.get $minimal_factor_out))))
            (if (call $algebraic_mint_entry
                  (local.get $minimal_factor) (local.get $entry) (i32.const 1) (local.get $x0_slot))
              (then (return (i32.const 0))))
            (if (i32.eq (call $value_type (local.get $x0_slot)) (global.get $TYPE_RATIONAL))
              (then
                ;; A rational candidate is already an element of the
                ;; coefficient field; no generator extension is needed.
                (local.set $candidate_representation (call $algebraic_apoly_from_rational
                  (call $rational_materialize (local.get $x0_slot))))
                (if (i32.eqz (local.get $candidate_representation)) (then (return (i32.const 0))))
                (local.set $candidate_evaluation (call $algebraic_apoly_array_horner_eval
                  (local.get $coefficient_field_elements) (i32.add (local.get $degree) (i32.const 1))
                  (local.get $candidate_representation) (local.get $primitive_modulus))))
              (else
                (if (i32.ne (call $value_type (local.get $x0_slot)) (global.get $TYPE_ALGEBRAIC))
                  (then (unreachable)))
                ;; Extend the coefficient field with this candidate. The
                ;; successful step rewrites coefficient-field reps in place
                ;; and appends x0's own representation.
                (local.set $shift_multiplier (i32.const 1))
                (block $candidate_shift_done
                  (loop $candidate_shift
                    (if (i32.gt_s (local.get $shift_multiplier) (i32.const 64))
                      (then (return (i32.add (i32.const 1)
                        (call $throw_range_error_with_message
                          (global.get $BUILTIN_MSG_ALGEBRAIC_PRIMITIVE_ELEMENT_SHIFT_LIMIT))))))
                    (memory.copy (call $abs (local.get $candidate_representations))
                      (call $abs (local.get $primitive_representations))
                      (i32.mul (local.get $registry_count) (i32.const 4)))
                    (local.set $status (call $algebraic_build_primitive_element_step
                      (local.get $primitive_generator_header) (call $value_data_lo (local.get $x0_slot))
                      (local.get $shift_multiplier) (local.get $candidate_representations)
                      (local.get $registry_count) (local.get $candidate_generator_out)))
                    (br_if $candidate_shift_done (i32.and
                      (i32.ne (local.get $status) (i32.const 3))
                      (i32.ne (local.get $status) (i32.const 4))))
                    (local.set $shift_multiplier
                      (i32.add (local.get $shift_multiplier) (i32.const 1)))
                    (br $candidate_shift)))
                (if (i32.eq (local.get $status) (i32.const 1)) (then (return (i32.const 0))))
                (if (i32.eq (local.get $status) (i32.const 2))
                  (then (return (i32.add (i32.const 1)
                    (call $throw_range_error_with_message
                      (global.get $BUILTIN_MSG_ALGEBRAIC_PRIMITIVE_ELEMENT_SHIFT_LIMIT))))))
                (if (local.get $status) (then (unreachable)))
                (local.set $candidate_generator_header
                  (i32.load (call $abs (local.get $candidate_generator_out))))
                (local.set $candidate_modulus (call $algebraic_apoly_from_bigint_poly
                  (call $algebraic_poly_from_array
                    (call $algebraic_coefficients_of (local.get $candidate_generator_header)))))
                (if (i32.eqz (local.get $candidate_modulus)) (then (return (i32.const 0))))
                (local.set $candidate_representation (i32.load (call $abs
                  (i32.add (local.get $candidate_representations)
                    (i32.mul (local.get $registry_count) (i32.const 4))))))
                ;; gamma_old = gamma_new - shift*x0 in the extended field.
                (local.set $generator_unit (call $algebraic_apoly_zero_poly (i32.const 1)))
                (if (i32.eqz (local.get $generator_unit)) (then (return (i32.const 0))))
                (call $algebraic_poly_set_coefficient (local.get $generator_unit) (i32.const 1)
                  (call $rational_new (call $bigint_one) (call $bigint_one)))
                (local.set $scaled_candidate_representation (call $algebraic_apoly_scale
                  (local.get $candidate_representation)
                  (call $rational_new
                    (call $bigint_from_i64 (i64.extend_i32_s
                      (i32.sub (i32.const 0) (local.get $shift_multiplier))))
                    (call $bigint_one))))
                (if (i32.eqz (local.get $scaled_candidate_representation)) (then (return (i32.const 0))))
                (local.set $old_generator_representation (call $algebraic_apoly_add
                  (local.get $generator_unit) (local.get $scaled_candidate_representation)))
                (if (i32.eqz (local.get $old_generator_representation)) (then (return (i32.const 0))))
                (local.set $old_generator_representation (call $algebraic_apoly_mod
                  (local.get $old_generator_representation) (local.get $candidate_modulus)))
                (if (i32.eqz (local.get $old_generator_representation)) (then (return (i32.const 0))))
                (local.set $rewritten_coefficient (i32.const 0))
                (block $candidate_coefficients_done
                  (loop $candidate_coefficients
                    (br_if $candidate_coefficients_done
                      (i32.gt_s (local.get $rewritten_coefficient) (local.get $degree)))
                    (local.set $candidate_evaluation (call $algebraic_apoly_horner_eval
                      (i32.load (call $abs (i32.add (local.get $coefficient_field_elements)
                        (i32.mul (local.get $rewritten_coefficient) (i32.const 4)))))
                      (local.get $old_generator_representation) (local.get $candidate_modulus)))
                    (if (i32.eqz (local.get $candidate_evaluation)) (then (return (i32.const 0))))
                    (i32.store (call $abs (i32.add (local.get $candidate_coefficient_field_elements)
                      (i32.mul (local.get $rewritten_coefficient) (i32.const 4))))
                      (local.get $candidate_evaluation))
                    (local.set $rewritten_coefficient
                      (i32.add (local.get $rewritten_coefficient) (i32.const 1)))
                    (br $candidate_coefficients)))
                (local.set $candidate_evaluation (call $algebraic_apoly_array_horner_eval
                  (local.get $candidate_coefficient_field_elements)
                  (i32.add (local.get $degree) (i32.const 1))
                  (local.get $candidate_representation) (local.get $candidate_modulus)))))
            (if (i32.eqz (local.get $candidate_evaluation)) (then (return (i32.const 0))))
            (if (i32.lt_s (call $algebraic_poly_degree (local.get $candidate_evaluation)) (i32.const 0))
              (then
                (if (i32.ne (local.get $survivor_count) (local.get $i))
                  (then
                    (memory.copy
                      (call $abs (i32.add (local.get $output)
                        (i32.mul (local.get $survivor_count) (i32.const 20))))
                      (call $abs (local.get $entry))
                      (i32.const 20))))
                (local.set $survivor_count (i32.add (local.get $survivor_count) (i32.const 1)))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $filter)))
        (if (call $expression_walk_guard (i32.add
              (call $estimate_array_size (local.get $survivor_count)) (i32.const 64)))
          (then (return (i32.const 0))))
        (local.set $result_array (call $allocate_array (local.get $survivor_count)))
        (local.set $result_data (i32.add
          (i32.load (call $abs (i32.add (local.get $result_array) (i32.const 16))))
          (global.get $GC_HEADER_SIZE)))
        (local.set $i (i32.const 0))
        (block $emit_done
          (loop $emit
            (br_if $emit_done (i32.ge_s (local.get $i) (local.get $survivor_count)))
            (local.set $entry (i32.add (local.get $output) (i32.mul (local.get $i) (i32.const 20))))
            (local.set $minimal_factor_out (call $carve_scratch_blob (i32.const 4)))
            (local.set $bracket_status (call $algebraic_bracket_norm_factor
              (local.get $norm) (local.get $norm_factors) (local.get $norm_factor_count)
              (local.get $entry) (local.get $minimal_factor_out)))
            (if (local.get $bracket_status) (then (return (i32.const 0))))
            (local.set $minimal_factor (i32.load (call $abs (local.get $minimal_factor_out))))
            (if (call $algebraic_mint_entry
                  (local.get $minimal_factor) (local.get $entry) (i32.const 1) (local.get $x0_slot))
              (then (return (i32.const 0))))
            (call $write_value
              (i32.add (local.get $result_data) (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
              (call $value_type (local.get $x0_slot))
              (call $value_flags (local.get $x0_slot))
              (call $value_data_lo (local.get $x0_slot))
              (call $value_data_hi (local.get $x0_slot)))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $emit)))
        (call $expression_freeze_args_array (local.get $result_array))
        (call $pending_push (global.get $TYPE_ARRAY) (i32.const 0)
          (local.get $result_array) (i32.const 0))
        (return (i32.const 0))))

    ;; Clear denominators: collect numerator/denominator headers and
    ;; fold the least common multiple.
    (if (call $expression_walk_guard (i32.add
          (i32.mul (i32.add (local.get $degree) (i32.const 1)) (i32.const 8)) (i32.const 96)))
      (then (return (i32.const 0))))
    (local.set $pairs (call $carve_scratch_blob
      (i32.mul (i32.add (local.get $degree) (i32.const 1)) (i32.const 8))))
    (local.set $one_header (call $bigint_one))
    (local.set $i (i32.const 0))
    (block $collect_done
      (loop $collect
        (br_if $collect_done (i32.gt_s (local.get $i) (local.get $degree)))
        (local.set $slot (i32.add (local.get $list)
          (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
        (if (i32.eq (call $value_type (local.get $slot)) (global.get $TYPE_BIGINT))
          (then
            (local.set $numerator (call $value_data_lo (local.get $slot)))
            (local.set $denominator (local.get $one_header)))
          (else
            (if (call $expression_walk_guard (i32.const 128))
              (then (return (i32.const 0))))
            (local.set $rational_header (call $rational_materialize (local.get $slot)))
            (local.set $numerator (call $rational_numerator (local.get $rational_header)))
            (local.set $denominator (call $rational_denominator (local.get $rational_header)))))
        (i32.store (call $abs (i32.add (local.get $pairs) (i32.mul (local.get $i) (i32.const 8))))
          (local.get $numerator))
        (i32.store (call $abs (i32.add
          (i32.add (local.get $pairs) (i32.mul (local.get $i) (i32.const 8))) (i32.const 4)))
          (local.get $denominator))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $collect)))
    (local.set $common_multiple (local.get $one_header))
    (local.set $i (i32.const 0))
    (block $fold_done
      (loop $fold
        (br_if $fold_done (i32.gt_s (local.get $i) (local.get $degree)))
        (local.set $denominator (i32.load (call $abs (i32.add
          (i32.add (local.get $pairs) (i32.mul (local.get $i) (i32.const 8))) (i32.const 4)))))
        (if (call $expression_walk_guard (i32.mul (i32.const 4)
              (call $estimate_bigint_size (i32.add
                (call $bigint_length (local.get $common_multiple))
                (i32.add (call $bigint_length (local.get $denominator)) (i32.const 2))))))
          (then (return (i32.const 0))))
        (local.set $gcd (call $algebraic_bigint_gcd_guarded
          (local.get $common_multiple) (local.get $denominator)))
        (if (i32.eqz (local.get $gcd)) (then (return (i32.const 0))))
        (local.set $common_multiple (call $bigint_mul
          (call $bigint_div (local.get $common_multiple) (local.get $gcd))
          (local.get $denominator)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $fold)))
    ;; Integer coefficients: c_i = numerator_i · (L / denominator_i).
    (local.set $poly (call $algebraic_poly_carve (local.get $degree)))
    (if (i32.eqz (local.get $poly)) (then (return (i32.const 0))))
    (local.set $i (i32.const 0))
    (block $scale_done
      (loop $scale
        (br_if $scale_done (i32.gt_s (local.get $i) (local.get $degree)))
        (local.set $numerator (i32.load (call $abs (i32.add
          (local.get $pairs) (i32.mul (local.get $i) (i32.const 8))))))
        (local.set $denominator (i32.load (call $abs (i32.add
          (i32.add (local.get $pairs) (i32.mul (local.get $i) (i32.const 8))) (i32.const 4)))))
        (if (call $expression_walk_guard (i32.mul (i32.const 3)
              (call $estimate_bigint_size (i32.add
                (i32.add
                  (call $bigint_length (local.get $numerator))
                  (call $bigint_length (local.get $common_multiple)))
                (i32.const 2)))))
          (then (return (i32.const 0))))
        (call $algebraic_poly_set_coefficient (local.get $poly) (local.get $i)
          (call $bigint_mul (local.get $numerator)
            (call $bigint_div (local.get $common_multiple) (local.get $denominator))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $scale)))
    ;; Primitive, positive leading, squarefree.
    (local.set $content (call $algebraic_poly_content (local.get $poly)))
    (if (i32.eqz (local.get $content)) (then (return (i32.const 0))))
    (local.set $leading (call $algebraic_poly_coefficient (local.get $poly) (local.get $degree)))
    (local.set $poly (call $algebraic_poly_scale_down
      (local.get $poly) (local.get $content)
      (i32.ne (call $bigint_sign (local.get $leading)) (i32.const 0))))
    (if (i32.eqz (local.get $poly)) (then (return (i32.const 0))))
    (local.set $poly (call $algebraic_poly_squarefree_part (local.get $poly)))
    (if (i32.eqz (local.get $poly)) (then (return (i32.const 0))))
    (local.set $squarefree_degree (call $algebraic_poly_degree (local.get $poly)))
    ;; Degree 1 renormalises to the single rational root −c0/c1.
    (if (i32.eq (local.get $squarefree_degree) (i32.const 1))
      (then
        (if (call $expression_walk_guard (i32.add
              (call $estimate_array_size (i32.const 1))
              (i32.mul (i32.const 3) (call $estimate_bigint_size (i32.add
                (call $bigint_length (call $algebraic_poly_coefficient (local.get $poly) (i32.const 0)))
                (i32.add
                  (call $bigint_length (call $algebraic_poly_coefficient (local.get $poly) (i32.const 1)))
                  (i32.const 2)))))))
          (then (return (i32.const 0))))
        (local.set $root_rational (call $rational_new
          (call $algebraic_bigint_negate
            (call $algebraic_poly_coefficient (local.get $poly) (i32.const 0)))
          (call $algebraic_poly_coefficient (local.get $poly) (i32.const 1))))
        (local.set $result_array (call $allocate_array (i32.const 1)))
        (local.set $result_data (i32.add
          (i32.load (call $abs (i32.add (local.get $result_array) (i32.const 16))))
          (global.get $GC_HEADER_SIZE)))
        (call $write_value (local.get $result_data)
          (global.get $TYPE_RATIONAL) (i32.const 0) (local.get $root_rational) (i32.const 0))
        (call $expression_freeze_args_array (local.get $result_array))
        (call $pending_push (global.get $TYPE_ARRAY) (i32.const 0)
          (local.get $result_array) (i32.const 0))
        (return (i32.const 0))))
    ;; Isolate.
    (if (call $expression_walk_guard
          (i32.add (i32.mul (local.get $squarefree_degree) (i32.const 20)) (i32.const 32)))
      (then (return (i32.const 0))))
    (local.set $output (call $carve_scratch_blob
      (i32.mul (local.get $squarefree_degree) (i32.const 20))))
    (if (call $algebraic_isolate (local.get $poly) (local.get $output))
      (then (return (i32.const 0))))
    (local.set $count (global.get $algebraic_isolate_count))
    ;; Assemble each root through the representation mint. It selects the
    ;; irreducible factor for this interval, so rational roots of a reducible
    ;; polynomial become Rationals instead of carrying the full polynomial.
    (if (call $expression_walk_guard (i32.add
          (call $estimate_array_size (local.get $count)) (i32.const 64)))
      (then (return (i32.const 0))))
    (local.set $result_array (call $allocate_array (local.get $count)))
    (local.set $result_data (i32.add
      (i32.load (call $abs (i32.add (local.get $result_array) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (local.set $i (i32.const 0))
    (block $mint_done
      (loop $mint
        (br_if $mint_done (i32.ge_s (local.get $i) (local.get $count)))
        (local.set $entry (i32.add (local.get $output)
          (i32.mul (local.get $i) (i32.const 20))))
        (local.set $entry_kind (i32.load (call $abs (local.get $entry))))
        (if (call $expression_walk_guard (i32.add
              (call $estimate_array_size (i32.const 2)) (i32.const 256)))
          (then (return (i32.const 0))))
        (if (i32.eqz (local.get $entry_kind))
          (then
            ;; Exact dyadic rational root.
            (local.set $root_rational (call $rational_new
              (i32.load (call $abs (i32.add (local.get $entry) (i32.const 4))))
              (call $algebraic_dyadic_denominator
                (i32.load (call $abs (i32.add (local.get $entry) (i32.const 8)))))))
            (call $write_value
              (i32.add (local.get $result_data)
                (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
              (global.get $TYPE_RATIONAL) (i32.const 0)
              (local.get $root_rational) (i32.const 0)))
          (else
            (if (call $algebraic_mint_entry
                  (local.get $poly) (local.get $entry) (i32.const 0)
                  (i32.add (local.get $result_data)
                    (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
              (then (return (i32.const 0))))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $mint)))
    (call $expression_freeze_args_array (local.get $result_array))
    (call $pending_push (global.get $TYPE_ARRAY) (i32.const 0)
      (local.get $result_array) (i32.const 0))
    (i32.const 0)
  )

  ;; =====================================================================
  ;; GF(p) polynomial arithmetic stores plain i32 coefficients already
  ;; reduced modulo a small prime p (p < 2^31, selected by the caller);
  ;; no bigint is needed for the modulus arithmetic itself. It uses the
  ;; same [degree][entry...] blob shape as
  ;; arithmetic itself). Same [degree][entry...] blob shape as
  ;; algebraic_poly_* (ascending, index 0 = constant term) — reuses
  ;; algebraic_poly_carve/_degree/_coefficient/_set_coefficient
  ;; VERBATIM, since those are pure blob accessors indifferent to
  ;; whether a slot holds a raw value or a pointer. Only trim needs
  ;; its own version (checks the raw i32 against 0, not
  ;; bigint_length). Ported from SymPy's galoistools.py -- algorithm
  ;; SHAPE only; SymPy's own `dup` convention is DESCENDING (index 0 =
  ;; leading term), the opposite of this file's ascending convention,
  ;; so every loop below is mirrored relative to the SymPy source, not
  ;; transliterated index-for-index.
  ;; =====================================================================

  ;; Euclidean (always non-negative) reduction of an arbitrary-size
  ;; bigint modulo a small prime p (0 < p < 2^31) -- $bigint_div
  ;; truncates toward zero, so its remainder can be negative; this
  ;; fixes that up into [0, p). Returns a plain i32.
  (func $galois_reduce_bigint (param $value i32) (param $p i32) (result i32)
    (local $p_bigint i32)
    (local $remainder_bigint i32)
    (local $remainder i32)
    (local.set $p_bigint (call $bigint_from_i64 (i64.extend_i32_u (local.get $p))))
    (drop (call $bigint_div (local.get $value) (local.get $p_bigint)))
    (local.set $remainder_bigint (call $bigint_last_remainder))
    (if (i32.eqz (call $bigint_to_i64_fits (local.get $remainder_bigint)))
      (then (unreachable)))
    (local.set $remainder (i32.wrap_i64 (global.get $bigint_to_i64_value)))
    (if (i32.lt_s (local.get $remainder) (i32.const 0))
      (then (local.set $remainder (i32.add (local.get $remainder) (local.get $p)))))
    (local.get $remainder)
  )

  ;; Lift a bigint-coefficient poly (algebraic_poly_* shape) to a
  ;; GF(p) poly (same shape, raw i32 entries, each coefficient reduced
  ;; mod p). 0 on pressure.
  (func $galois_poly_from_bigint_poly (param $poly i32) (param $p i32) (result i32)
    (local $degree i32)
    (local $result i32)
    (local $i i32)
    (local.set $degree (call $algebraic_poly_degree (local.get $poly)))
    (local.set $result (call $algebraic_poly_carve (local.get $degree)))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (local.set $i (i32.const 0))
    (block $done
      (loop $lift
        (br_if $done (i32.gt_s (local.get $i) (local.get $degree)))
        (if (call $expression_walk_guard (i32.const 32))
          (then (return (i32.const 0))))
        (call $algebraic_poly_set_coefficient (local.get $result) (local.get $i)
          (call $galois_reduce_bigint
            (call $algebraic_poly_coefficient (local.get $poly) (local.get $i))
            (local.get $p)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $lift)))
    (call $galois_poly_trim (local.get $result))
    (local.get $result)
  )

  (func $galois_poly_trim (param $poly i32)
    (local $degree i32)
    (local.set $degree (call $algebraic_poly_degree (local.get $poly)))
    (block $done
      (loop $trim
        (br_if $done (i32.lt_s (local.get $degree) (i32.const 0)))
        (br_if $done (i32.ne
          (call $algebraic_poly_coefficient (local.get $poly) (local.get $degree))
          (i32.const 0)))
        (local.set $degree (i32.sub (local.get $degree) (i32.const 1)))
        (br $trim)))
    (call $algebraic_poly_set_degree (local.get $poly) (local.get $degree))
  )

  (func $galois_poly_zero (param $degree i32) (result i32)
    (local $result i32)
    (local $i i32)
    (local.set $result (call $algebraic_poly_carve (local.get $degree)))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (local.set $i (i32.const 0))
    (block $done
      (loop $fill
        (br_if $done (i32.gt_s (local.get $i) (local.get $degree)))
        (call $algebraic_poly_set_coefficient (local.get $result) (local.get $i) (i32.const 0))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $fill)))
    (local.get $result)
  )

  (func $galois_poly_add (param $a i32) (param $b i32) (param $p i32) (result i32)
    (local $degree_a i32)
    (local $degree_b i32)
    (local $degree i32)
    (local $result i32)
    (local $i i32)
    (local $sum i32)
    (local.set $degree_a (call $algebraic_poly_degree (local.get $a)))
    (local.set $degree_b (call $algebraic_poly_degree (local.get $b)))
    (local.set $degree (local.get $degree_a))
    (if (i32.gt_s (local.get $degree_b) (local.get $degree)) (then (local.set $degree (local.get $degree_b))))
    (if (i32.lt_s (local.get $degree) (i32.const 0)) (then (return (call $algebraic_poly_carve (i32.const -1)))))
    (local.set $result (call $algebraic_poly_carve (local.get $degree)))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (local.set $i (i32.const 0))
    (block $done
      (loop $add
        (br_if $done (i32.gt_s (local.get $i) (local.get $degree)))
        (local.set $sum (i32.const 0))
        (if (i32.le_s (local.get $i) (local.get $degree_a))
          (then (local.set $sum (call $algebraic_poly_coefficient (local.get $a) (local.get $i)))))
        (if (i32.le_s (local.get $i) (local.get $degree_b))
          (then (local.set $sum (i32.add (local.get $sum)
            (call $algebraic_poly_coefficient (local.get $b) (local.get $i))))))
        (call $algebraic_poly_set_coefficient (local.get $result) (local.get $i)
          (i32.rem_u (local.get $sum) (local.get $p)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $add)))
    (call $galois_poly_trim (local.get $result))
    (local.get $result)
  )

  (func $galois_poly_sub (param $a i32) (param $b i32) (param $p i32) (result i32)
    (local $degree_a i32)
    (local $degree_b i32)
    (local $degree i32)
    (local $result i32)
    (local $i i32)
    (local $left i32)
    (local $right i32)
    (local.set $degree_a (call $algebraic_poly_degree (local.get $a)))
    (local.set $degree_b (call $algebraic_poly_degree (local.get $b)))
    (local.set $degree (local.get $degree_a))
    (if (i32.gt_s (local.get $degree_b) (local.get $degree)) (then (local.set $degree (local.get $degree_b))))
    (if (i32.lt_s (local.get $degree) (i32.const 0)) (then (return (call $algebraic_poly_carve (i32.const -1)))))
    (local.set $result (call $algebraic_poly_carve (local.get $degree)))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (local.set $i (i32.const 0))
    (block $done
      (loop $sub
        (br_if $done (i32.gt_s (local.get $i) (local.get $degree)))
        (local.set $left (i32.const 0))
        (local.set $right (i32.const 0))
        (if (i32.le_s (local.get $i) (local.get $degree_a))
          (then (local.set $left (call $algebraic_poly_coefficient (local.get $a) (local.get $i)))))
        (if (i32.le_s (local.get $i) (local.get $degree_b))
          (then (local.set $right (call $algebraic_poly_coefficient (local.get $b) (local.get $i)))))
        (call $algebraic_poly_set_coefficient (local.get $result) (local.get $i)
          (i32.rem_u (i32.add (i32.sub (local.get $left) (local.get $right)) (local.get $p)) (local.get $p)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $sub)))
    (call $galois_poly_trim (local.get $result))
    (local.get $result)
  )

  (func $galois_poly_mul (param $a i32) (param $b i32) (param $p i32) (result i32)
    (local $degree_a i32)
    (local $degree_b i32)
    (local $result i32)
    (local $i i32)
    (local $j i32)
    (local $ca i64)
    (local $cb i64)
    (local $accumulator i64)
    (local.set $degree_a (call $algebraic_poly_degree (local.get $a)))
    (local.set $degree_b (call $algebraic_poly_degree (local.get $b)))
    (if (i32.or (i32.lt_s (local.get $degree_a) (i32.const 0)) (i32.lt_s (local.get $degree_b) (i32.const 0)))
      (then (return (call $algebraic_poly_carve (i32.const -1)))))
    (local.set $result (call $galois_poly_zero (i32.add (local.get $degree_a) (local.get $degree_b))))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (local.set $i (i32.const 0))
    (block $rows_done
      (loop $rows
        (br_if $rows_done (i32.gt_s (local.get $i) (local.get $degree_a)))
        (local.set $ca (i64.extend_i32_u (call $algebraic_poly_coefficient (local.get $a) (local.get $i))))
        (if (i32.ne (i32.wrap_i64 (local.get $ca)) (i32.const 0))
          (then
            (local.set $j (i32.const 0))
            (block $cols_done
              (loop $cols
                (br_if $cols_done (i32.gt_s (local.get $j) (local.get $degree_b)))
                (if (call $expression_walk_guard (i32.const 32))
                  (then (return (i32.const 0))))
                (local.set $cb (i64.extend_i32_u (call $algebraic_poly_coefficient (local.get $b) (local.get $j))))
                (local.set $accumulator (i64.extend_i32_u (call $algebraic_poly_coefficient
                  (local.get $result) (i32.add (local.get $i) (local.get $j)))))
                (local.set $accumulator (i64.rem_u
                  (i64.add (local.get $accumulator) (i64.mul (local.get $ca) (local.get $cb)))
                  (i64.extend_i32_u (local.get $p))))
                (call $algebraic_poly_set_coefficient (local.get $result) (i32.add (local.get $i) (local.get $j))
                  (i32.wrap_i64 (local.get $accumulator)))
                (local.set $j (i32.add (local.get $j) (i32.const 1)))
                (br $cols)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $rows)))
    (call $galois_poly_trim (local.get $result))
    (local.get $result)
  )

  ;; Modular multiplicative inverse of a (mod p), p PRIME, via
  ;; Fermat's little theorem (a^(p-2) mod p) -- avoids needing a
  ;; separate extended-Euclid-on-i32 routine since p is always a
  ;; genuine small prime here (checked by the caller's prime search).
  (func $galois_inverse (param $a i32) (param $p i32) (result i32)
    (local $result i64)
    (local $base i64)
    (local $exponent i32)
    (local.set $result (i64.const 1))
    (local.set $base (i64.extend_i32_u (i32.rem_u (local.get $a) (local.get $p))))
    (local.set $exponent (i32.sub (local.get $p) (i32.const 2)))
    (block $done
      (loop $pow
        (br_if $done (i32.eqz (local.get $exponent)))
        (if (i32.and (local.get $exponent) (i32.const 1))
          (then (local.set $result (i64.rem_u (i64.mul (local.get $result) (local.get $base)) (i64.extend_i32_u (local.get $p))))))
        (local.set $base (i64.rem_u (i64.mul (local.get $base) (local.get $base)) (i64.extend_i32_u (local.get $p))))
        (local.set $exponent (i32.shr_u (local.get $exponent) (i32.const 1)))
        (br $pow)))
    (i32.wrap_i64 (local.get $result))
  )

  ;; f = lc(f) * monic, returns (lc, monic) via out-params (lc_out may
  ;; be 0 if the caller doesn't need it -- pass a dummy scratch slot).
  (func $galois_poly_monic (param $f i32) (param $p i32) (param $lc_out i32) (result i32)
    (local $degree i32)
    (local $lc i32)
    (local $inv i64)
    (local $result i32)
    (local $i i32)
    (local.set $degree (call $algebraic_poly_degree (local.get $f)))
    (if (i32.lt_s (local.get $degree) (i32.const 0))
      (then
        (if (local.get $lc_out) (then (i32.store (call $abs (local.get $lc_out)) (i32.const 0))))
        (return (call $algebraic_poly_carve (i32.const -1)))))
    (local.set $lc (call $algebraic_poly_coefficient (local.get $f) (local.get $degree)))
    (if (local.get $lc_out) (then (i32.store (call $abs (local.get $lc_out)) (local.get $lc))))
    (if (i32.eq (local.get $lc) (i32.const 1)) (then (return (local.get $f))))
    (local.set $inv (i64.extend_i32_u (call $galois_inverse (local.get $lc) (local.get $p))))
    (local.set $result (call $algebraic_poly_carve (local.get $degree)))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (local.set $i (i32.const 0))
    (block $done
      (loop $scale
        (br_if $done (i32.gt_s (local.get $i) (local.get $degree)))
        (call $algebraic_poly_set_coefficient (local.get $result) (local.get $i)
          (i32.wrap_i64 (i64.rem_u
            (i64.mul (local.get $inv) (i64.extend_i32_u (call $algebraic_poly_coefficient (local.get $f) (local.get $i))))
            (i64.extend_i32_u (local.get $p)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $scale)))
    (local.get $result)
  )

  ;; Division with remainder: f = q*g + r, both out via slots.
  ;; Requires deg(g) >= 0 (caller's responsibility -- p is prime so
  ;; every nonzero GF(p) polynomial's leading coefficient is
  ;; invertible; there is no other failure mode here besides pressure).
  (func $galois_poly_divmod
    (param $f i32) (param $g i32) (param $p i32)
    (param $quotient_out i32) (param $remainder_out i32)
    (result i32)
    (local $degree_f i32)
    (local $degree_g i32)
    (local $inv i64)
    (local $work i32)
    (local $i i32)
    (local $j i32)
    (local $coefficient i64)
    (local $lead i64)
    (local $quotient i32)
    (local.set $degree_f (call $algebraic_poly_degree (local.get $f)))
    (local.set $degree_g (call $algebraic_poly_degree (local.get $g)))
    (if (i32.lt_s (local.get $degree_f) (local.get $degree_g))
      (then
        (i32.store (call $abs (local.get $quotient_out)) (call $algebraic_poly_carve (i32.const -1)))
        (i32.store (call $abs (local.get $remainder_out)) (local.get $f))
        (return (i32.const 0))))
    (local.set $inv (i64.extend_i32_u (call $galois_inverse
      (call $algebraic_poly_coefficient (local.get $g) (local.get $degree_g)) (local.get $p))))
    ;; $work: a mutable copy of f's coefficients (ascending), degree_f+1 slots.
    (local.set $work (call $algebraic_poly_carve (local.get $degree_f)))
    (if (i32.eqz (local.get $work)) (then (return (i32.const 0))))
    (local.set $i (i32.const 0))
    (block $copy_done
      (loop $copy
        (br_if $copy_done (i32.gt_s (local.get $i) (local.get $degree_f)))
        (call $algebraic_poly_set_coefficient (local.get $work) (local.get $i)
          (call $algebraic_poly_coefficient (local.get $f) (local.get $i)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $copy)))
    (local.set $quotient (call $galois_poly_zero (i32.sub (local.get $degree_f) (local.get $degree_g))))
    (if (i32.eqz (local.get $quotient)) (then (return (i32.const 0))))
    ;; Standard schoolbook long division, working from the HIGHEST
    ;; remaining degree down to degree_g (ascending-index equivalent:
    ;; i counts down from degree_f to degree_g).
    (local.set $i (local.get $degree_f))
    (block $div_done
      (loop $div
        (br_if $div_done (i32.lt_s (local.get $i) (local.get $degree_g)))
        (if (call $expression_walk_guard (i32.const 32))
          (then (return (i32.const 0))))
        (local.set $lead (i64.extend_i32_u (call $algebraic_poly_coefficient (local.get $work) (local.get $i))))
        (if (i32.ne (i32.wrap_i64 (local.get $lead)) (i32.const 0))
          (then
            (local.set $coefficient (i64.rem_u (i64.mul (local.get $lead) (local.get $inv)) (i64.extend_i32_u (local.get $p))))
            (call $algebraic_poly_set_coefficient (local.get $quotient)
              (i32.sub (local.get $i) (local.get $degree_g)) (i32.wrap_i64 (local.get $coefficient)))
            (local.set $j (i32.const 0))
            (block $sub_done
              (loop $sub
                (br_if $sub_done (i32.gt_s (local.get $j) (local.get $degree_g)))
                (call $algebraic_poly_set_coefficient (local.get $work) (i32.sub (local.get $i) (i32.sub (local.get $degree_g) (local.get $j)))
                  (i32.wrap_i64 (i64.rem_u
                    (i64.add
                      (i64.extend_i32_u (call $algebraic_poly_coefficient (local.get $work)
                        (i32.sub (local.get $i) (i32.sub (local.get $degree_g) (local.get $j)))))
                      (i64.sub (i64.extend_i32_u (local.get $p))
                        (i64.rem_u (i64.mul (local.get $coefficient)
                          (i64.extend_i32_u (call $algebraic_poly_coefficient (local.get $g) (local.get $j))))
                          (i64.extend_i32_u (local.get $p)))))
                    (i64.extend_i32_u (local.get $p)))))
                (local.set $j (i32.add (local.get $j) (i32.const 1)))
                (br $sub)))))
        (local.set $i (i32.sub (local.get $i) (i32.const 1)))
        (br $div)))
    (call $galois_poly_trim (local.get $work))
    (call $galois_poly_trim (local.get $quotient))
    (i32.store (call $abs (local.get $quotient_out)) (local.get $quotient))
    (i32.store (call $abs (local.get $remainder_out)) (local.get $work))
    (i32.const 0)
  )

  (func $galois_poly_rem (param $f i32) (param $g i32) (param $p i32) (result i32)
    (local $q_out i32)
    (local $r_out i32)
    (local $status i32)
    (local.set $q_out (call $carve_scratch_blob (i32.const 4)))
    (local.set $r_out (call $carve_scratch_blob (i32.const 4)))
    (local.set $status (call $galois_poly_divmod (local.get $f) (local.get $g) (local.get $p) (local.get $q_out) (local.get $r_out)))
    (if (local.get $status) (then (return (i32.const 0))))
    (i32.load (call $abs (local.get $r_out)))
  )

  (func $galois_poly_quo (param $f i32) (param $g i32) (param $p i32) (result i32)
    (local $q_out i32)
    (local $r_out i32)
    (local $status i32)
    (local.set $q_out (call $carve_scratch_blob (i32.const 4)))
    (local.set $r_out (call $carve_scratch_blob (i32.const 4)))
    (local.set $status (call $galois_poly_divmod (local.get $f) (local.get $g) (local.get $p) (local.get $q_out) (local.get $r_out)))
    (if (local.get $status) (then (return (i32.const 0))))
    (i32.load (call $abs (local.get $q_out)))
  )

  (func $galois_poly_gcd (param $f i32) (param $g i32) (param $p i32) (result i32)
    (local $x i32)
    (local $y i32)
    (local $remainder i32)
    (local.set $x (local.get $f))
    (local.set $y (local.get $g))
    (block $done
      (loop $euclid
        (br_if $done (i32.lt_s (call $algebraic_poly_degree (local.get $y)) (i32.const 0)))
        (if (call $expression_walk_guard (i32.const 32)) (then (return (i32.const 0))))
        (local.set $remainder (call $galois_poly_rem (local.get $x) (local.get $y) (local.get $p)))
        (if (i32.eqz (local.get $remainder))
          (then (if (i32.ge_s (call $algebraic_poly_degree (local.get $x)) (i32.const 0)) (then (return (i32.const 0))))))
        (local.set $x (local.get $y))
        (local.set $y (local.get $remainder))
        (br $euclid)))
    (call $galois_poly_monic (local.get $x) (local.get $p) (i32.const 0))
  )

  ;; Derivative, mod p (standard power-rule differentiation, applied
  ;; entrywise; the classic characteristic-p pathology -- derivative
  ;; identically zero e.g. for f = x^p + 1 -- is handled by the
  ;; SQUAREFREE layer above this one, not here).
  (func $galois_poly_diff (param $f i32) (param $p i32) (result i32)
    (local $degree i32)
    (local $result i32)
    (local $i i32)
    (local.set $degree (call $algebraic_poly_degree (local.get $f)))
    (if (i32.le_s (local.get $degree) (i32.const 0)) (then (return (call $algebraic_poly_carve (i32.const -1)))))
    (local.set $result (call $galois_poly_zero (i32.sub (local.get $degree) (i32.const 1))))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (local.set $i (i32.const 1))
    (block $done
      (loop $diff
        (br_if $done (i32.gt_s (local.get $i) (local.get $degree)))
        (call $algebraic_poly_set_coefficient (local.get $result) (i32.sub (local.get $i) (i32.const 1))
          (i32.wrap_i64 (i64.rem_u
            (i64.mul (i64.extend_i32_u (local.get $i))
              (i64.extend_i32_u (call $algebraic_poly_coefficient (local.get $f) (local.get $i))))
            (i64.extend_i32_u (local.get $p)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $diff)))
    (call $galois_poly_trim (local.get $result))
    (local.get $result)
  )

  (func $galois_poly_mul_ground (param $f i32) (param $c i32) (param $p i32) (result i32)
    (local $degree i32)
    (local $result i32)
    (local $i i32)
    (local $cc i64)
    (local.set $degree (call $algebraic_poly_degree (local.get $f)))
    (if (i32.lt_s (local.get $degree) (i32.const 0)) (then (return (call $algebraic_poly_carve (i32.const -1)))))
    (if (i32.eqz (i32.rem_u (local.get $c) (local.get $p))) (then (return (call $algebraic_poly_carve (i32.const -1)))))
    (local.set $result (call $algebraic_poly_carve (local.get $degree)))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (local.set $cc (i64.extend_i32_u (i32.rem_u (local.get $c) (local.get $p))))
    (local.set $i (i32.const 0))
    (block $done
      (loop $scale
        (br_if $done (i32.gt_s (local.get $i) (local.get $degree)))
        (call $algebraic_poly_set_coefficient (local.get $result) (local.get $i)
          (i32.wrap_i64 (i64.rem_u
            (i64.mul (local.get $cc) (i64.extend_i32_u (call $algebraic_poly_coefficient (local.get $f) (local.get $i))))
            (i64.extend_i32_u (local.get $p)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $scale)))
    (call $galois_poly_trim (local.get $result))
    (local.get $result)
  )

  ;; a - b*c, all GF(p) polys.
  (func $galois_poly_sub_mul (param $a i32) (param $b i32) (param $c i32) (param $p i32) (result i32)
    (call $galois_poly_sub (local.get $a) (call $galois_poly_mul (local.get $b) (local.get $c) (local.get $p)) (local.get $p))
  )

  ;; Extended Euclidean algorithm: s,t,h with s*f + t*g = h = gcd(f,g)
  ;; (h monic). Ported from SymPy's gf_gcdex (galoistools.py) --
  ;; needed by Hensel lifting's own gcdex-based combination step
  ;; and returns 0 on
  ;; pressure (via the out-slots being left unwritten; caller checks
  ;; the returned status).
  (func $galois_poly_gcdex
    (param $f i32) (param $g i32) (param $p i32)
    (param $s_out i32) (param $t_out i32) (param $h_out i32)
    (result i32)
    (local $degree_f i32)
    (local $degree_g i32)
    (local $lc0 i32)
    (local $lc1 i32)
    (local $p0 i32)
    (local $p1 i32)
    (local $r0 i32)
    (local $r1 i32)
    (local $s0 i32)
    (local $s1 i32)
    (local $t0 i32)
    (local $t1 i32)
    (local $q_out i32)
    (local $rem_out i32)
    (local $status i32)
    (local $quotient i32)
    (local $remainder i32)
    (local $lc i32)
    (local $inv i32)
    (local $s i32)
    (local $t i32)
    (local.set $degree_f (call $algebraic_poly_degree (local.get $f)))
    (local.set $degree_g (call $algebraic_poly_degree (local.get $g)))
    (if (i32.and (i32.lt_s (local.get $degree_f) (i32.const 0)) (i32.lt_s (local.get $degree_g) (i32.const 0)))
      (then
        (i32.store (call $abs (local.get $s_out)) (call $galois_poly_zero (i32.const 0)))
        (call $algebraic_poly_set_coefficient (i32.load (call $abs (local.get $s_out))) (i32.const 0) (i32.const 1))
        (i32.store (call $abs (local.get $t_out)) (call $algebraic_poly_carve (i32.const -1)))
        (i32.store (call $abs (local.get $h_out)) (call $algebraic_poly_carve (i32.const -1)))
        (return (i32.const 0))))
    (local.set $lc0 (call $carve_scratch_blob (i32.const 4)))
    (local.set $lc1 (call $carve_scratch_blob (i32.const 4)))
    (local.set $p0 (call $galois_poly_monic (local.get $f) (local.get $p) (local.get $lc0)))
    (local.set $r0 (local.get $p0))
    (local.set $p1 (call $galois_poly_monic (local.get $g) (local.get $p) (local.get $lc1)))
    (local.set $r1 (local.get $p1))
    (if (i32.lt_s (local.get $degree_f) (i32.const 0))
      (then
        (i32.store (call $abs (local.get $s_out)) (call $algebraic_poly_carve (i32.const -1)))
        (local.set $t0 (call $galois_poly_zero (i32.const 0)))
        (call $algebraic_poly_set_coefficient (local.get $t0) (i32.const 0)
          (call $galois_inverse (i32.load (call $abs (local.get $lc1))) (local.get $p)))
        (i32.store (call $abs (local.get $t_out)) (local.get $t0))
        (i32.store (call $abs (local.get $h_out)) (local.get $r1))
        (return (i32.const 0))))
    (if (i32.lt_s (local.get $degree_g) (i32.const 0))
      (then
        (local.set $s0 (call $galois_poly_zero (i32.const 0)))
        (call $algebraic_poly_set_coefficient (local.get $s0) (i32.const 0)
          (call $galois_inverse (i32.load (call $abs (local.get $lc0))) (local.get $p)))
        (i32.store (call $abs (local.get $s_out)) (local.get $s0))
        (i32.store (call $abs (local.get $t_out)) (call $algebraic_poly_carve (i32.const -1)))
        (i32.store (call $abs (local.get $h_out)) (local.get $r0))
        (return (i32.const 0))))
    (local.set $s0 (call $galois_poly_zero (i32.const 0)))
    (call $algebraic_poly_set_coefficient (local.get $s0) (i32.const 0)
      (call $galois_inverse (i32.load (call $abs (local.get $lc0))) (local.get $p)))
    (local.set $s1 (call $algebraic_poly_carve (i32.const -1)))
    (local.set $t0 (call $algebraic_poly_carve (i32.const -1)))
    (local.set $t1 (call $galois_poly_zero (i32.const 0)))
    (call $algebraic_poly_set_coefficient (local.get $t1) (i32.const 0)
      (call $galois_inverse (i32.load (call $abs (local.get $lc1))) (local.get $p)))
    (local.set $q_out (call $carve_scratch_blob (i32.const 4)))
    (local.set $rem_out (call $carve_scratch_blob (i32.const 4)))
    (block $done
      (loop $euclid
        (if (call $expression_walk_guard (i32.const 32)) (then (return (i32.const 1))))
        (local.set $status (call $galois_poly_divmod (local.get $r0) (local.get $r1) (local.get $p) (local.get $q_out) (local.get $rem_out)))
        (if (local.get $status) (then (return (i32.const 1))))
        (local.set $quotient (i32.load (call $abs (local.get $q_out))))
        (local.set $remainder (i32.load (call $abs (local.get $rem_out))))
        (br_if $done (i32.lt_s (call $algebraic_poly_degree (local.get $remainder)) (i32.const 0)))
        (local.set $lc (call $algebraic_poly_coefficient (local.get $remainder)
          (call $algebraic_poly_degree (local.get $remainder))))
        (local.set $r0 (local.get $r1))
        (local.set $r1 (call $galois_poly_monic (local.get $remainder) (local.get $p) (i32.const 0)))
        (local.set $inv (call $galois_inverse (local.get $lc) (local.get $p)))
        (local.set $s (call $galois_poly_sub_mul (local.get $s0) (local.get $s1) (local.get $quotient) (local.get $p)))
        (local.set $t (call $galois_poly_sub_mul (local.get $t0) (local.get $t1) (local.get $quotient) (local.get $p)))
        (local.set $s0 (local.get $s1))
        (local.set $s1 (call $galois_poly_mul_ground (local.get $s) (local.get $inv) (local.get $p)))
        (local.set $t0 (local.get $t1))
        (local.set $t1 (call $galois_poly_mul_ground (local.get $t) (local.get $inv) (local.get $p)))
        (br $euclid)))
    (i32.store (call $abs (local.get $s_out)) (local.get $s1))
    (i32.store (call $abs (local.get $t_out)) (local.get $t1))
    (i32.store (call $abs (local.get $h_out)) (local.get $r1))
    (i32.const 0)
  )

  ;; GF(p) squarefree decomposition follows SymPy's gf_sqf_list.
  ;; When the derivative vanishes because every exponent is divisible
  ;; by p, f(x) = h(x^p); h is recovered by selecting every p-th
  ;; ascending coefficient. This is the same index relation as SymPy's
  ;; descending representation.




  ;;
  ;; $factors_out: caller-provided scratch, $max_factors entries of
  ;; 8 bytes each ([poly_pointer:4][multiplicity:4]), ascending by
  ;; multiplicity (matches SymPy's own documented ordering). Returns
  ;; the factor COUNT via return value, or -1 on pressure, -2 if
  ;; $max_factors was exceeded (caller's shield against a
  ;; pathological input, mirroring this file's existing
  ;; ALGEBRAIC_MONOMIAL_MAX_FACTORS-style bounded scratch discipline).
  ;; $lc_out receives f's original leading coefficient (mod p).
  (func $galois_sqf_list
    (param $f i32) (param $p i32)
    (param $factors_out i32) (param $max_factors i32) (param $lc_out i32)
    (result i32)
    (local $n i32)
    (local $sqf i32)
    (local $count i32)
    (local $lc i32)
    (local $monic_f i32)
    (local $derivative i32)
    (local $g i32)
    (local $h i32)
    (local $i i32)
    (local $gg i32)
    (local $hh i32)
    (local $entry i32)
    (local $d i32)
    (local $inflated i32)
    (local $j i32)
    (local.set $n (i32.const 1))
    (local.set $sqf (i32.const 0))
    (local.set $count (i32.const 0))
    (local.set $lc (call $carve_scratch_blob (i32.const 4)))
    (local.set $monic_f (call $galois_poly_monic (local.get $f) (local.get $p) (local.get $lc)))
    (i32.store (call $abs (local.get $lc_out)) (i32.load (call $abs (local.get $lc))))
    (if (i32.lt_s (call $algebraic_poly_degree (local.get $monic_f)) (i32.const 1))
      (then (return (i32.const 0))))
    (block $outer_done
      (loop $outer
        (local.set $derivative (call $galois_poly_diff (local.get $monic_f) (local.get $p)))
        (if (i32.ge_s (call $algebraic_poly_degree (local.get $derivative)) (i32.const 0))
          (then
            (local.set $g (call $galois_poly_gcd (local.get $monic_f) (local.get $derivative) (local.get $p)))
            (if (i32.eqz (local.get $g)) (then (return (i32.const -1))))
            (local.set $h (call $galois_poly_quo (local.get $monic_f) (local.get $g) (local.get $p)))
            (if (i32.eqz (local.get $h)) (then (return (i32.const -1))))
            (local.set $i (i32.const 1))
            (block $inner_done
              (loop $inner
                (br_if $inner_done (i32.and
                  (i32.eqz (call $algebraic_poly_degree (local.get $h)))
                  (i32.eq (call $algebraic_poly_coefficient (local.get $h) (i32.const 0)) (i32.const 1))))
                (if (call $expression_walk_guard (i32.const 32)) (then (return (i32.const -1))))
                (local.set $gg (call $galois_poly_gcd (local.get $g) (local.get $h) (local.get $p)))
                (if (i32.eqz (local.get $gg)) (then (return (i32.const -1))))
                (local.set $hh (call $galois_poly_quo (local.get $h) (local.get $gg) (local.get $p)))
                (if (i32.eqz (local.get $hh)) (then (return (i32.const -1))))
                (if (i32.gt_s (call $algebraic_poly_degree (local.get $hh)) (i32.const 0))
                  (then
                    (if (i32.ge_s (local.get $count) (local.get $max_factors)) (then (return (i32.const -2))))
                    (local.set $entry (i32.add (local.get $factors_out) (i32.mul (local.get $count) (i32.const 8))))
                    (i32.store (call $abs (local.get $entry)) (local.get $hh))
                    (i32.store (call $abs (i32.add (local.get $entry) (i32.const 4)))
                      (i32.mul (local.get $i) (local.get $n)))
                    (local.set $count (i32.add (local.get $count) (i32.const 1)))))
                (local.set $g (call $galois_poly_quo (local.get $g) (local.get $gg) (local.get $p)))
                (if (i32.eqz (local.get $g)) (then (return (i32.const -1))))
                (local.set $h (local.get $gg))
                (local.set $i (i32.add (local.get $i) (i32.const 1)))
                (br $inner)))
            (if (i32.and
                  (i32.eqz (call $algebraic_poly_degree (local.get $g)))
                  (i32.eq (call $algebraic_poly_coefficient (local.get $g) (i32.const 0)) (i32.const 1)))
              (then (local.set $sqf (i32.const 1)))
              (else (local.set $monic_f (local.get $g))))))
        (if (i32.eqz (local.get $sqf))
          (then
            (local.set $d (i32.div_s (call $algebraic_poly_degree (local.get $monic_f)) (local.get $p)))
            (local.set $inflated (call $algebraic_poly_carve (local.get $d)))
            (if (i32.eqz (local.get $inflated)) (then (return (i32.const -1))))
            (local.set $j (i32.const 0))
            (block $inflate_done
              (loop $inflate
                (br_if $inflate_done (i32.gt_s (local.get $j) (local.get $d)))
                (call $algebraic_poly_set_coefficient (local.get $inflated) (local.get $j)
                  (call $algebraic_poly_coefficient (local.get $monic_f) (i32.mul (local.get $j) (local.get $p))))
                (local.set $j (i32.add (local.get $j) (i32.const 1)))
                (br $inflate)))
            (call $galois_poly_trim (local.get $inflated))
            (local.set $monic_f (local.get $inflated))
            (local.set $n (i32.mul (local.get $n) (local.get $p))))
          (else (br $outer_done)))
        (br $outer)))
    (local.get $count)
  )

  ;; f^n mod g, in GF(p)[x]/(g), via repeated squaring. Ported from
  ;; SymPy's gf_pow_mod.
  (func $galois_pow_mod (param $f i32) (param $n i64) (param $g i32) (param $p i32) (result i32)
    (local $h i32)
    (local $base i32)
    (local $exponent i64)
    (if (i64.eqz (local.get $n))
      (then
        (local.set $h (call $galois_poly_zero (i32.const 0)))
        (call $algebraic_poly_set_coefficient (local.get $h) (i32.const 0) (i32.const 1))
        (return (local.get $h))))
    (local.set $h (call $galois_poly_zero (i32.const 0)))
    (call $algebraic_poly_set_coefficient (local.get $h) (i32.const 0) (i32.const 1))
    (local.set $base (local.get $f))
    (local.set $exponent (local.get $n))
    (block $done
      (loop $pow
        (br_if $done (i64.eqz (local.get $exponent)))
        (if (call $expression_walk_guard (i32.const 32)) (then (return (i32.const 0))))
        (if (i64.ne (i64.and (local.get $exponent) (i64.const 1)) (i64.const 0))
          (then
            (local.set $h (call $galois_poly_mul (local.get $h) (local.get $base) (local.get $p)))
            (if (i32.eqz (local.get $h)) (then (return (i32.const 0))))
            (local.set $h (call $galois_poly_rem (local.get $h) (local.get $g) (local.get $p)))
            (if (i32.eqz (local.get $h)) (then (return (i32.const 0))))))
        (local.set $exponent (i64.shr_u (local.get $exponent) (i64.const 1)))
        (if (i64.eqz (local.get $exponent)) (then (br $done)))
        (local.set $base (call $galois_poly_mul (local.get $base) (local.get $base) (local.get $p)))
        (if (i32.eqz (local.get $base)) (then (return (i32.const 0))))
        (local.set $base (call $galois_poly_rem (local.get $base) (local.get $g) (local.get $p)))
        (if (i32.eqz (local.get $base)) (then (return (i32.const 0))))
        (br $pow)))
    (local.get $h)
  )

  ;; b[i] = x^(i*p) mod g, for i = 0..n-1 (n = deg(g)). Ported from
  ;; SymPy's gf_frobenius_monomial_base -- used by both DDF (Frobenius
  ;; map for the x^p mod f test) and EDF's odd-p branch.
  ;; $base_out: caller-provided scratch, n entries of 4 bytes each
  ;; (polynomial pointers). 0 ok / -1 pressure.
  (func $galois_frobenius_monomial_base (param $g i32) (param $p i32) (param $base_out i32) (result i32)
    (local $n i32)
    (local $i i32)
    (local $b1 i32)
    (local $monomial i32)
    (local $x i32)
    (local.set $n (call $algebraic_poly_degree (local.get $g)))
    (if (i32.le_s (local.get $n) (i32.const 0)) (then (return (i32.const 0))))
    (local.set $monomial (call $galois_poly_zero (i32.const 0)))
    (call $algebraic_poly_set_coefficient (local.get $monomial) (i32.const 0) (i32.const 1))
    (i32.store (call $abs (local.get $base_out)) (local.get $monomial))
    (if (i32.eq (local.get $n) (i32.const 1)) (then (return (i32.const 0))))
    ;; x, as a degree-1 GF(p) polynomial (ascending: [0, 1]).
    (local.set $x (call $galois_poly_zero (i32.const 1)))
    (call $algebraic_poly_set_coefficient (local.get $x) (i32.const 1) (i32.const 1))
    (local.set $b1 (call $galois_pow_mod (local.get $x) (i64.extend_i32_u (local.get $p)) (local.get $g) (local.get $p)))
    (if (i32.eqz (local.get $b1)) (then (return (i32.const -1))))
    (i32.store (call $abs (i32.add (local.get $base_out) (i32.const 4))) (local.get $b1))
    (local.set $i (i32.const 2))
    (block $done
      (loop $build
        (br_if $done (i32.ge_s (local.get $i) (local.get $n)))
        (if (call $expression_walk_guard (i32.const 32)) (then (return (i32.const -1))))
        (local.set $monomial (call $galois_poly_mul
          (i32.load (call $abs (i32.add (local.get $base_out) (i32.mul (i32.sub (local.get $i) (i32.const 1)) (i32.const 4)))))
          (local.get $b1) (local.get $p)))
        (if (i32.eqz (local.get $monomial)) (then (return (i32.const -1))))
        (local.set $monomial (call $galois_poly_rem (local.get $monomial) (local.get $g) (local.get $p)))
        (if (i32.eqz (local.get $monomial)) (then (return (i32.const -1))))
        (i32.store (call $abs (i32.add (local.get $base_out) (i32.mul (local.get $i) (i32.const 4)))) (local.get $monomial))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $build)))
    (i32.const 0)
  )

  ;; Compute f^p mod g using the precomputed Frobenius monomial base
  ;; (avoids a fresh repeated-squaring pow_mod call). Ported from
  ;; SymPy's gf_frobenius_map.
  (func $galois_frobenius_map (param $f i32) (param $g i32) (param $base i32) (param $p i32) (result i32)
    (local $m i32)
    (local $reduced i32)
    (local $n i32)
    (local $sf i32)
    (local $i i32)
    (local $term i32)
    (local.set $m (call $algebraic_poly_degree (local.get $g)))
    (local.set $reduced (local.get $f))
    (if (i32.ge_s (call $algebraic_poly_degree (local.get $f)) (local.get $m))
      (then
        (local.set $reduced (call $galois_poly_rem (local.get $f) (local.get $g) (local.get $p)))
        (if (i32.eqz (local.get $reduced)) (then (return (i32.const 0))))))
    (if (i32.lt_s (call $algebraic_poly_degree (local.get $reduced)) (i32.const 0))
      (then (return (call $algebraic_poly_carve (i32.const -1)))))
    (local.set $n (call $algebraic_poly_degree (local.get $reduced)))
    ;; sf := f[0] (SymPy's sf = [f[-1]], the CONSTANT term in its
    ;; descending convention -- ascending index 0), as a constant
    ;; polynomial.
    (local.set $sf (call $galois_poly_zero (i32.const 0)))
    (call $algebraic_poly_set_coefficient (local.get $sf) (i32.const 0)
      (call $algebraic_poly_coefficient (local.get $reduced) (i32.const 0)))
    (local.set $i (i32.const 1))
    (block $done
      (loop $accumulate
        (br_if $done (i32.gt_s (local.get $i) (local.get $n)))
        (if (call $expression_walk_guard (i32.const 32)) (then (return (i32.const 0))))
        (local.set $term (call $galois_poly_mul_ground
          (i32.load (call $abs (i32.add (local.get $base) (i32.mul (local.get $i) (i32.const 4)))))
          (call $algebraic_poly_coefficient (local.get $reduced) (local.get $i))
          (local.get $p)))
        (if (i32.eqz (local.get $term))
          (then (if (i32.ge_s (call $algebraic_poly_degree
                      (i32.load (call $abs (i32.add (local.get $base) (i32.mul (local.get $i) (i32.const 4))))))
                    (i32.const 0)) (then (return (i32.const 0))))))
        (local.set $sf (call $galois_poly_add (local.get $sf) (local.get $term) (local.get $p)))
        (if (i32.eqz (local.get $sf)) (then (return (i32.const 0))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $accumulate)))
    (local.get $sf)
  )

  ;; Cantor-Zassenhaus distinct-degree factorization: given a monic
  ;; squarefree f, computes partial factorization f_1...f_d where
  ;; deg(f_i) != deg(f_j) for i != j, each f_i being the PRODUCT of
  ;; all irreducible factors of that one degree (further split by EDF
  ;; later). Ported from SymPy's gf_ddf_zassenhaus.
  ;; $factors_out: caller scratch, $max_factors entries of 8 bytes
  ;; ([poly:4][degree:4]). Returns factor count, or -1 pressure, -2
  ;; too many factors.
  ;; f - x, f a GF(p) poly (subtracts 1 from the degree-1 coefficient,
  ;; ascending index 1 -- matches SymPy's gf_sub(g, [1,0], p, K)).
  (func $galois_poly_sub_x (param $f i32) (param $p i32) (result i32)
    (local $x i32)
    (local.set $x (call $galois_poly_zero (i32.const 1)))
    (call $algebraic_poly_set_coefficient (local.get $x) (i32.const 1) (i32.const 1))
    (call $galois_poly_sub (local.get $f) (local.get $x) (local.get $p))
  )

  (func $galois_ddf_zassenhaus
    (param $f i32) (param $p i32) (param $factors_out i32) (param $max_factors i32)
    (result i32)
    (local $i i32)
    (local $g i32)
    (local $b i32)
    (local $h i32)
    (local $count i32)
    (local $entry i32)
    (local.set $i (i32.const 1))
    (local.set $count (i32.const 0))
    (local.set $g (call $galois_poly_zero (i32.const 1)))
    (call $algebraic_poly_set_coefficient (local.get $g) (i32.const 1) (i32.const 1))
    (local.set $b (call $carve_scratch_blob (i32.mul (call $algebraic_poly_degree (local.get $f)) (i32.const 4))))
    (if (i32.eq (call $galois_frobenius_monomial_base (local.get $f) (local.get $p) (local.get $b)) (i32.const -1))
      (then (return (i32.const -1))))
    (block $outer_done
      (loop $outer
        (br_if $outer_done (i32.gt_s (i32.mul (i32.const 2) (local.get $i)) (call $algebraic_poly_degree (local.get $f))))
        (if (call $expression_walk_guard (i32.const 32)) (then (return (i32.const -1))))
        (local.set $g (call $galois_frobenius_map (local.get $g) (local.get $f) (local.get $b) (local.get $p)))
        (if (i32.eqz (local.get $g)) (then (return (i32.const -1))))
        (local.set $h (call $galois_poly_gcd (local.get $f) (call $galois_poly_sub_x (local.get $g) (local.get $p)) (local.get $p)))
        (if (i32.eqz (local.get $h)) (then (return (i32.const -1))))
        (if (i32.eqz (i32.and
              (i32.eqz (call $algebraic_poly_degree (local.get $h)))
              (i32.eq (call $algebraic_poly_coefficient (local.get $h) (i32.const 0)) (i32.const 1))))
          (then
            (if (i32.ge_s (local.get $count) (local.get $max_factors)) (then (return (i32.const -2))))
            (local.set $entry (i32.add (local.get $factors_out) (i32.mul (local.get $count) (i32.const 8))))
            (i32.store (call $abs (local.get $entry)) (local.get $h))
            (i32.store (call $abs (i32.add (local.get $entry) (i32.const 4))) (local.get $i))
            (local.set $count (i32.add (local.get $count) (i32.const 1)))
            (local.set $f (call $galois_poly_quo (local.get $f) (local.get $h) (local.get $p)))
            (if (i32.eqz (local.get $f)) (then (return (i32.const -1))))
            (local.set $g (call $galois_poly_rem (local.get $g) (local.get $f) (local.get $p)))
            (if (i32.eqz (local.get $g)) (then (return (i32.const -1))))
            (local.set $b (call $carve_scratch_blob (i32.mul (call $algebraic_poly_degree (local.get $f)) (i32.const 4))))
            (if (i32.eq (call $galois_frobenius_monomial_base (local.get $f) (local.get $p) (local.get $b)) (i32.const -1))
              (then (return (i32.const -1))))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $outer)))
    (if (i32.ge_s (call $algebraic_poly_degree (local.get $f)) (i32.const 1))
      (then
        (if (i32.ge_s (local.get $count) (local.get $max_factors)) (then (return (i32.const -2))))
        (local.set $entry (i32.add (local.get $factors_out) (i32.mul (local.get $count) (i32.const 8))))
        (i32.store (call $abs (local.get $entry)) (local.get $f))
        (i32.store (call $abs (i32.add (local.get $entry) (i32.const 4))) (call $algebraic_poly_degree (local.get $f)))
        (local.set $count (i32.add (local.get $count) (i32.const 1)))))
    (local.get $count)
  )

  ;; xorshift32, advancing the session-wide $galois_prng_state. Never
  ;; entropy-sensitive: EDF's correctness only needs to EVENTUALLY find
  ;; a splitting polynomial, not any specific one.
  (func $galois_prng_next (result i32)
    (local $x i32)
    (local.set $x (global.get $galois_prng_state))
    (local.set $x (i32.xor (local.get $x) (i32.shl (local.get $x) (i32.const 13))))
    (local.set $x (i32.xor (local.get $x) (i32.shr_u (local.get $x) (i32.const 17))))
    (local.set $x (i32.xor (local.get $x) (i32.shl (local.get $x) (i32.const 5))))
    (if (i32.eqz (local.get $x)) (then (local.set $x (i32.const 88172645))))
    (global.set $galois_prng_state (local.get $x))
    (local.get $x)
  )

  ;; Monic random GF(p) polynomial of degree n (SymPy's gf_random):
  ;; leading coefficient forced to 1, remaining n coefficients uniform
  ;; in [0, p).
  (func $galois_random_poly (param $n i32) (param $p i32) (result i32)
    (local $result i32)
    (local $i i32)
    (local.set $result (call $algebraic_poly_carve (local.get $n)))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (call $algebraic_poly_set_coefficient (local.get $result) (local.get $n) (i32.const 1))
    (local.set $i (i32.const 0))
    (block $done
      (loop $fill
        (br_if $done (i32.ge_s (local.get $i) (local.get $n)))
        (call $algebraic_poly_set_coefficient (local.get $result) (local.get $i)
          (i32.rem_u (call $galois_prng_next) (local.get $p)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $fill)))
    (call $galois_poly_trim (local.get $result))
    (local.get $result)
  )

  ;; f^((p^n - 1)/2) in GF(p)[x]/(g), via f * f^p * ... * f^(p^(n-1)),
  ;; then raised to (p-1)/2. Ported from SymPy's _gf_pow_pnm1d2 (a
  ;; gf_edf_zassenhaus helper for the odd-p branch).
  (func $galois_pow_pnm1d2 (param $f i32) (param $n i32) (param $g i32) (param $base i32) (param $p i32) (result i32)
    (local $reduced i32)
    (local $h i32)
    (local $r i32)
    (local $i i32)
    (local.set $reduced (call $galois_poly_rem (local.get $f) (local.get $g) (local.get $p)))
    (if (i32.eqz (local.get $reduced)) (then (return (i32.const 0))))
    (local.set $h (local.get $reduced))
    (local.set $r (local.get $reduced))
    (local.set $i (i32.const 1))
    (block $done
      (loop $accumulate
        (br_if $done (i32.ge_s (local.get $i) (local.get $n)))
        (if (call $expression_walk_guard (i32.const 32)) (then (return (i32.const 0))))
        (local.set $h (call $galois_frobenius_map (local.get $h) (local.get $g) (local.get $base) (local.get $p)))
        (if (i32.eqz (local.get $h)) (then (return (i32.const 0))))
        (local.set $r (call $galois_poly_mul (local.get $r) (local.get $h) (local.get $p)))
        (if (i32.eqz (local.get $r)) (then (return (i32.const 0))))
        (local.set $r (call $galois_poly_rem (local.get $r) (local.get $g) (local.get $p)))
        (if (i32.eqz (local.get $r)) (then (return (i32.const 0))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $accumulate)))
    (call $galois_pow_mod (local.get $r) (i64.div_u (i64.sub (i64.extend_i32_u (local.get $p)) (i64.const 1)) (i64.const 2))
      (local.get $g) (local.get $p))
  )

  ;; Cantor-Zassenhaus (probabilistic) equal-degree factorization:
  ;; given a monic squarefree f (all irreducible factors of the SAME
  ;; degree n), splits it into its individual irreducible factors.
  ;; Ported from SymPy's gf_edf_zassenhaus -- both the p==2 (Cohen
  ;; 3.4.8) and odd-p (Geddes 8.9) branches (p==2 is a real, reachable
  ;; case in practice, not skipped as untested dead code).
  ;; $factors_out: caller scratch, $max_factors entries of 4 bytes
  ;; each (polynomial pointers). Returns factor count, -1 pressure,
  ;; -2 too many factors.
  (func $galois_edf_zassenhaus
    (param $f i32) (param $n i32) (param $p i32)
    (param $factors_out i32) (param $max_factors i32)
    (result i32)
    (local $degree_f i32)
    (local $base i32)
    (local $t i32)
    (local $x_squared i32)
    (local $h i32)
    (local $r i32)
    (local $i i32)
    (local $g i32)
    (local $g_is_trivial i32)
    (local $one_poly i32)
    (local $quotient i32)
    (local $left_out i32)
    (local $right_out i32)
    (local $left_count i32)
    (local $right_count i32)
    (local.set $degree_f (call $algebraic_poly_degree (local.get $f)))
    (if (i32.le_s (local.get $degree_f) (local.get $n))
      (then
        (if (i32.ge_s (i32.const 1) (local.get $max_factors)) (then (return (i32.const -2))))
        (i32.store (call $abs (local.get $factors_out)) (local.get $f))
        (return (i32.const 1))))
    (if (i32.ne (local.get $p) (i32.const 2))
      (then
        (local.set $base (call $carve_scratch_blob (i32.mul (local.get $degree_f) (i32.const 4))))
        (if (i32.eq (call $galois_frobenius_monomial_base (local.get $f) (local.get $p) (local.get $base)) (i32.const -1))
          (then (return (i32.const -1))))))
    (local.set $x_squared (call $galois_poly_zero (i32.const 2)))
    (call $algebraic_poly_set_coefficient (local.get $x_squared) (i32.const 2) (i32.const 1))
    (local.set $one_poly (call $galois_poly_zero (i32.const 0)))
    (call $algebraic_poly_set_coefficient (local.get $one_poly) (i32.const 0) (i32.const 1))
    ;; t := x (ascending [0,1]) -- the p==2 branch's own random-ish
    ;; probe sequence: x, x^3, x^5, ... (SymPy's t += [0,0] on its
    ;; descending list is exactly "multiply by x^2" here).
    (local.set $t (call $galois_poly_zero (i32.const 1)))
    (call $algebraic_poly_set_coefficient (local.get $t) (i32.const 1) (i32.const 1))
    (block $found
      (loop $retry
        (if (call $expression_walk_guard (i32.const 64)) (then (return (i32.const -1))))
        (if (i32.eq (local.get $p) (i32.const 2))
          (then
            (local.set $h (local.get $t))
            (local.set $r (local.get $t))
            (local.set $i (i32.const 0))
            (block $sq_done
              (loop $sq
                (br_if $sq_done (i32.ge_s (local.get $i) (i32.sub (local.get $n) (i32.const 1))))
                (local.set $r (call $galois_pow_mod (local.get $r) (i64.const 2) (local.get $f) (local.get $p)))
                (if (i32.eqz (local.get $r)) (then (return (i32.const -1))))
                (local.set $h (call $galois_poly_add (local.get $h) (local.get $r) (local.get $p)))
                (if (i32.eqz (local.get $h)) (then (return (i32.const -1))))
                (local.set $i (i32.add (local.get $i) (i32.const 1)))
                (br $sq)))
            (local.set $g (call $galois_poly_gcd (local.get $f) (local.get $h) (local.get $p)))
            (if (i32.eqz (local.get $g)) (then (return (i32.const -1))))
            (local.set $t (call $galois_poly_mul (local.get $t) (local.get $x_squared) (local.get $p)))
            (if (i32.eqz (local.get $t)) (then (return (i32.const -1)))))
          (else
            (local.set $r (call $galois_random_poly (i32.sub (i32.mul (i32.const 2) (local.get $n)) (i32.const 1)) (local.get $p)))
            (local.set $h (call $galois_pow_pnm1d2 (local.get $r) (local.get $n) (local.get $f) (local.get $base) (local.get $p)))
            (if (i32.eqz (local.get $h)) (then (return (i32.const -1))))
            (local.set $h (call $galois_poly_sub (local.get $h) (local.get $one_poly) (local.get $p)))
            (if (i32.eqz (local.get $h)) (then (return (i32.const -1))))
            (local.set $g (call $galois_poly_gcd (local.get $f) (local.get $h) (local.get $p)))
            (if (i32.eqz (local.get $g)) (then (return (i32.const -1))))))
        (local.set $g_is_trivial (i32.or
          (i32.and (i32.eqz (call $algebraic_poly_degree (local.get $g)))
            (i32.eq (call $algebraic_poly_coefficient (local.get $g) (i32.const 0)) (i32.const 1)))
          (i32.eq (call $algebraic_poly_degree (local.get $g)) (local.get $degree_f))))
        (br_if $found (i32.eqz (local.get $g_is_trivial)))
        (br $retry)))
    (local.set $quotient (call $galois_poly_quo (local.get $f) (local.get $g) (local.get $p)))
    (if (i32.eqz (local.get $quotient)) (then (return (i32.const -1))))
    (local.set $left_out (call $carve_scratch_blob (i32.mul (local.get $max_factors) (i32.const 4))))
    (local.set $left_count (call $galois_edf_zassenhaus
      (local.get $g) (local.get $n) (local.get $p) (local.get $left_out) (local.get $max_factors)))
    (if (i32.lt_s (local.get $left_count) (i32.const 0)) (then (return (local.get $left_count))))
    (local.set $right_out (call $carve_scratch_blob (i32.mul (local.get $max_factors) (i32.const 4))))
    (local.set $right_count (call $galois_edf_zassenhaus
      (local.get $quotient) (local.get $n) (local.get $p) (local.get $right_out) (local.get $max_factors)))
    (if (i32.lt_s (local.get $right_count) (i32.const 0)) (then (return (local.get $right_count))))
    (if (i32.gt_s (i32.add (local.get $left_count) (local.get $right_count)) (local.get $max_factors))
      (then (return (i32.const -2))))
    (local.set $i (i32.const 0))
    (block $copy_left_done
      (loop $copy_left
        (br_if $copy_left_done (i32.ge_s (local.get $i) (local.get $left_count)))
        (i32.store (call $abs (i32.add (local.get $factors_out) (i32.mul (local.get $i) (i32.const 4))))
          (i32.load (call $abs (i32.add (local.get $left_out) (i32.mul (local.get $i) (i32.const 4))))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $copy_left)))
    (local.set $i (i32.const 0))
    (block $copy_right_done
      (loop $copy_right
        (br_if $copy_right_done (i32.ge_s (local.get $i) (local.get $right_count)))
        (i32.store (call $abs (i32.add (local.get $factors_out)
          (i32.mul (i32.add (local.get $left_count) (local.get $i)) (i32.const 4))))
          (i32.load (call $abs (i32.add (local.get $right_out) (i32.mul (local.get $i) (i32.const 4))))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $copy_right)))
    (i32.add (local.get $left_count) (local.get $right_count))
  )

  ;; Full factorization of a monic squarefree GF(p) poly into ALL its
  ;; individual irreducible factors: DDF (distinct-degree groups) then
  ;; EDF (splits each group). Ported from SymPy's gf_zassenhaus.
  ;; $result_out: caller scratch, $max_factors entries of 4 bytes each.
  ;; Returns factor count, or -1 pressure, -2 too many factors.
  (func $galois_ddf_factor_full
    (param $f i32) (param $p i32) (param $result_out i32) (param $max_factors i32)
    (result i32)
    (local $ddf_out i32)
    (local $ddf_count i32)
    (local $i i32)
    (local $group_poly i32)
    (local $group_degree i32)
    (local $edf_out i32)
    (local $edf_count i32)
    (local $total i32)
    (local $j i32)
    (local.set $ddf_out (call $carve_scratch_blob (i32.mul (local.get $max_factors) (i32.const 8))))
    (local.set $ddf_count (call $galois_ddf_zassenhaus (local.get $f) (local.get $p) (local.get $ddf_out) (local.get $max_factors)))
    (if (i32.lt_s (local.get $ddf_count) (i32.const 0)) (then (return (local.get $ddf_count))))
    (local.set $total (i32.const 0))
    (local.set $i (i32.const 0))
    (block $groups_done
      (loop $groups
        (br_if $groups_done (i32.ge_s (local.get $i) (local.get $ddf_count)))
        (local.set $group_poly (i32.load (call $abs (i32.add (local.get $ddf_out) (i32.mul (local.get $i) (i32.const 8))))))
        (local.set $group_degree (i32.load (call $abs (i32.add (i32.add (local.get $ddf_out) (i32.mul (local.get $i) (i32.const 8))) (i32.const 4)))))
        (local.set $edf_out (call $carve_scratch_blob (i32.mul (local.get $max_factors) (i32.const 4))))
        (local.set $edf_count (call $galois_edf_zassenhaus
          (local.get $group_poly) (local.get $group_degree) (local.get $p) (local.get $edf_out) (local.get $max_factors)))
        (if (i32.lt_s (local.get $edf_count) (i32.const 0)) (then (return (local.get $edf_count))))
        (if (i32.gt_s (i32.add (local.get $total) (local.get $edf_count)) (local.get $max_factors))
          (then (return (i32.const -2))))
        (local.set $j (i32.const 0))
        (block $copy_done
          (loop $copy
            (br_if $copy_done (i32.ge_s (local.get $j) (local.get $edf_count)))
            (i32.store (call $abs (i32.add (local.get $result_out) (i32.mul (i32.add (local.get $total) (local.get $j)) (i32.const 4))))
              (i32.load (call $abs (i32.add (local.get $edf_out) (i32.mul (local.get $j) (i32.const 4))))))
            (local.set $j (i32.add (local.get $j) (i32.const 1)))
            (br $copy)))
        (local.set $total (i32.add (local.get $total) (local.get $edf_count)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $groups)))
    (local.get $total)
  )

  ;; =====================================================================
  ;; Hensel lifting maps a GF(p) factorization to Z/(p^l) via Newton's
  ;; method, with quadratic convergence from doubling precision each step.
  ;; It operates on plain integer polynomials using the bigint-coefficient
  ;; $algebraic_poly_* family; GF(p) polynomials instead store raw i32
  ;; coefficients.

  ;; =====================================================================

  ;; Balanced reduction: each coefficient into (-M/2, M/2], per
  ;; SymPy's dup_trunc. 0 on pressure.
  (func $algebraic_poly_trunc (param $f i32) (param $m i32) (result i32)
    (local $degree i32)
    (local $result i32)
    (local $i i32)
    (local $c i32)
    (local $half i32)
    (local.set $degree (call $algebraic_poly_degree (local.get $f)))
    (if (i32.lt_s (local.get $degree) (i32.const 0)) (then (return (local.get $f))))
    (local.set $result (call $algebraic_poly_carve (local.get $degree)))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (local.set $half (call $bigint_div (local.get $m) (call $bigint_from_i64 (i64.const 2))))
    (local.set $i (i32.const 0))
    (block $done
      (loop $trunc
        (br_if $done (i32.gt_s (local.get $i) (local.get $degree)))
        (if (call $expression_walk_guard (i32.const 64)) (then (return (i32.const 0))))
        (local.set $c (call $galois_reduce_bigint_general
          (call $algebraic_poly_coefficient (local.get $f) (local.get $i)) (local.get $m)))
        (if (i32.gt_s (call $bigint_compare (local.get $c) (local.get $half)) (i32.const 0))
          (then (local.set $c (call $bigint_sub (local.get $c) (local.get $m)))))
        (call $algebraic_poly_set_coefficient (local.get $result) (local.get $i) (local.get $c))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $trunc)))
    (call $algebraic_poly_trim (local.get $result))
    (local.get $result)
  )

  ;; Euclidean (non-negative) reduction of a bigint modulo an
  ;; ARBITRARY-SIZE bigint modulus m (unlike $galois_reduce_bigint,
  ;; which assumes a small i32-fitting prime -- Hensel lifting's
  ;; modulus p^l quickly exceeds i32 range). Returns a bigint.
  (func $galois_reduce_bigint_general (param $value i32) (param $m i32) (result i32)
    (local $remainder i32)
    (drop (call $bigint_div (local.get $value) (local.get $m)))
    (local.set $remainder (call $bigint_last_remainder))
    (if (i32.ne (call $bigint_sign (local.get $remainder)) (i32.const 0))
      (then (local.set $remainder (call $bigint_add (local.get $remainder) (local.get $m)))))
    (local.get $remainder)
  )

  ;; Lift a GF(p) poly (raw i32 coefficients) to a plain integer poly
  ;; (bigint coefficients), taking each coefficient's value verbatim
  ;; (already in [0, p)). 0 on pressure.
  (func $galois_poly_to_bigint_poly (param $f i32) (result i32)
    (local $degree i32)
    (local $result i32)
    (local $i i32)
    (local.set $degree (call $algebraic_poly_degree (local.get $f)))
    (local.set $result (call $algebraic_poly_carve (local.get $degree)))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (local.set $i (i32.const 0))
    (block $done
      (loop $lift
        (br_if $done (i32.gt_s (local.get $i) (local.get $degree)))
        (call $algebraic_poly_set_coefficient (local.get $result) (local.get $i)
          (call $bigint_from_i64 (i64.extend_i32_u (call $algebraic_poly_coefficient (local.get $f) (local.get $i)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $lift)))
    (call $algebraic_poly_trim (local.get $result))
    (local.get $result)
  )

  ;; Extended Euclidean algorithm on plain integers (bigints): returns
  ;; gcd(a,b) and writes Bezout coefficients u,v (a*u+b*v=gcd) via
  ;; out-slots. Needed for $algebraic_hensel_lift's base case
  ;; (K.gcdex(lc, p**l) in SymPy -- the modular inverse of f's leading
  ;; coefficient mod p^l).
  (func $bigint_extended_gcd (param $a i32) (param $b i32) (param $u_out i32) (param $v_out i32) (result i32)
    (local $old_r i32)
    (local $r i32)
    (local $old_s i32)
    (local $s i32)
    (local $old_t i32)
    (local $t i32)
    (local $quotient i32)
    (local $prev_r i32)
    (local $prev_s i32)
    (local $prev_t i32)
    (local.set $old_r (local.get $a))
    (local.set $r (local.get $b))
    (local.set $old_s (call $bigint_one))
    (local.set $s (call $bigint_from_i64 (i64.const 0)))
    (local.set $old_t (call $bigint_from_i64 (i64.const 0)))
    (local.set $t (call $bigint_one))
    (block $done
      (loop $euclid
        (br_if $done (i32.eqz (call $bigint_length (local.get $r))))
        (local.set $quotient (call $bigint_div (local.get $old_r) (local.get $r)))
        (local.set $prev_r (local.get $r))
        (local.set $prev_s (local.get $s))
        (local.set $prev_t (local.get $t))
        (local.set $r (call $bigint_last_remainder))
        (local.set $s (call $bigint_sub (local.get $old_s) (call $bigint_mul (local.get $quotient) (local.get $s))))
        (local.set $t (call $bigint_sub (local.get $old_t) (call $bigint_mul (local.get $quotient) (local.get $t))))
        (local.set $old_r (local.get $prev_r))
        (local.set $old_s (local.get $prev_s))
        (local.set $old_t (local.get $prev_t))
        (br $euclid)))
    (i32.store (call $abs (local.get $u_out)) (local.get $old_s))
    (i32.store (call $abs (local.get $v_out)) (local.get $old_t))
    (local.get $old_r)
  )

  ;; Division with remainder of a in Z[x] by a MONIC divisor b
  ;; (schoolbook long division; a monic divisor's leading coefficient
  ;; is 1, so ordinary integer subtraction never needs to check
  ;; divisibility -- SymPy's own dup_rr_div only special-cases the
  ;; non-monic-divisor case, which $algebraic_hensel_step never hits
  ;; since its h/new_h are always monic by construction). Writes
  ;; quotient/remainder via out-slots. 0 on pressure.
  (func $algebraic_poly_divmod_monic
    (param $a i32) (param $b i32) (param $quotient_out i32) (param $remainder_out i32)
    (result i32)
    (local $degree_a i32)
    (local $degree_b i32)
    (local $work i32)
    (local $quotient i32)
    (local $k i32)
    (local $j i32)
    (local $index i32)
    (local $coefficient i32)
    (local $coefficient_b i32)
    (local $product i32)
    (local $i i32)
    (local.set $degree_a (call $algebraic_poly_degree (local.get $a)))
    (local.set $degree_b (call $algebraic_poly_degree (local.get $b)))
    (if (i32.lt_s (local.get $degree_a) (local.get $degree_b))
      (then
        (i32.store (call $abs (local.get $quotient_out)) (call $algebraic_poly_carve (i32.const -1)))
        (i32.store (call $abs (local.get $remainder_out)) (local.get $a))
        (return (i32.const 0))))
    (local.set $work (call $algebraic_poly_carve (local.get $degree_a)))
    (if (i32.eqz (local.get $work)) (then (return (i32.const 0))))
    (local.set $i (i32.const 0))
    (block $copy_done
      (loop $copy
        (br_if $copy_done (i32.gt_s (local.get $i) (local.get $degree_a)))
        (call $algebraic_poly_set_coefficient (local.get $work) (local.get $i)
          (call $algebraic_poly_coefficient (local.get $a) (local.get $i)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $copy)))
    (local.set $quotient (call $algebraic_poly_carve (i32.sub (local.get $degree_a) (local.get $degree_b))))
    (if (i32.eqz (local.get $quotient)) (then (return (i32.const 0))))
    (local.set $k (local.get $degree_a))
    (block $div_done
      (loop $div
        (br_if $div_done (i32.lt_s (local.get $k) (local.get $degree_b)))
        (if (call $expression_walk_guard (i32.const 64)) (then (return (i32.const 0))))
        (local.set $coefficient (call $algebraic_poly_coefficient (local.get $work) (local.get $k)))
        ;; ALWAYS write the quotient coefficient (even when zero) --
        ;; algebraic_poly_carve does NOT zero-initialize its slots, so
        ;; skipping this write on a zero coefficient leaves that
        ;; quotient slot as uninitialized heap garbage. Only the
        ;; (redundant, since multiplying by zero changes nothing)
        ;; subtraction work is worth skipping.
        (call $algebraic_poly_set_coefficient (local.get $quotient)
          (i32.sub (local.get $k) (local.get $degree_b)) (local.get $coefficient))
        (if (i32.ne (call $bigint_length (local.get $coefficient)) (i32.const 0))
          (then
            (local.set $j (i32.const 0))
            (block $sub_done
              (loop $sub
                (br_if $sub_done (i32.gt_s (local.get $j) (local.get $degree_b)))
                (local.set $index (i32.sub (local.get $k) (i32.sub (local.get $degree_b) (local.get $j))))
                (local.set $coefficient_b (call $algebraic_poly_coefficient (local.get $b) (local.get $j)))
                (local.set $product (call $bigint_mul (local.get $coefficient) (local.get $coefficient_b)))
                (call $algebraic_poly_set_coefficient (local.get $work) (local.get $index)
                  (call $bigint_sub (call $algebraic_poly_coefficient (local.get $work) (local.get $index)) (local.get $product)))
                (local.set $j (i32.add (local.get $j) (i32.const 1)))
                (br $sub)))))
        (local.set $k (i32.sub (local.get $k) (i32.const 1)))
        (br $div)))
    (call $algebraic_poly_trim (local.get $work))
    (call $algebraic_poly_trim (local.get $quotient))
    (i32.store (call $abs (local.get $quotient_out)) (local.get $quotient))
    (i32.store (call $abs (local.get $remainder_out)) (local.get $work))
    (i32.const 0)
  )

  ;; One step of quadratic Hensel lifting: given m, f=g*h (mod m),
  ;; s*g+t*h=1 (mod m), lc(f) a unit mod m, lc(h)=1, returns G,H,S,T
  ;; with f=G*H (mod m^2), S*G+T*H=1 (mod m^2). Ported from SymPy's
  ;; dup_zz_hensel_step. All polynomials here are PLAIN INTEGER
  ;; (bigint-coefficient) polys; $m is a bigint.
  (func $algebraic_hensel_step
    (param $m i32) (param $f i32) (param $g i32) (param $h i32) (param $s i32) (param $t i32)
    (param $g_out i32) (param $h_out i32) (param $s_out i32) (param $t_out i32)
    (result i32)
    (local $mm i32)
    (local $e i32)
    (local $q i32)
    (local $r i32)
    (local $u i32)
    (local $new_g i32)
    (local $new_h i32)
    (local $b i32)
    (local $c i32)
    (local $d i32)
    (local $new_s i32)
    (local $new_t i32)
    (local $one i32)
    (local $q_out i32)
    (local $r_out i32)
    (local.set $mm (call $bigint_mul (local.get $m) (local.get $m)))
    (local.set $q_out (call $carve_scratch_blob (i32.const 4)))
    (local.set $r_out (call $carve_scratch_blob (i32.const 4)))
    (local.set $one (call $algebraic_poly_carve (i32.const 0)))
    (call $algebraic_poly_set_coefficient (local.get $one) (i32.const 0) (call $bigint_one))
    (local.set $e (call $algebraic_poly_sub_poly (local.get $f) (call $algebraic_poly_mul (local.get $g) (local.get $h))))
    (if (i32.eqz (local.get $e)) (then (return (i32.const 0))))
    (local.set $e (call $algebraic_poly_trunc (local.get $e) (local.get $mm)))
    (if (i32.eqz (local.get $e)) (then (return (i32.const 0))))
    (if (call $algebraic_poly_divmod_monic
          (call $algebraic_poly_mul (local.get $s) (local.get $e)) (local.get $h) (local.get $q_out) (local.get $r_out))
      (then (return (i32.const 0))))
    (local.set $q (i32.load (call $abs (local.get $q_out))))
    (local.set $r (i32.load (call $abs (local.get $r_out))))
    (local.set $q (call $algebraic_poly_trunc (local.get $q) (local.get $mm)))
    (local.set $r (call $algebraic_poly_trunc (local.get $r) (local.get $mm)))
    (local.set $u (call $algebraic_poly_add_poly
      (call $algebraic_poly_mul (local.get $t) (local.get $e)) (call $algebraic_poly_mul (local.get $q) (local.get $g))))
    (if (i32.eqz (local.get $u)) (then (return (i32.const 0))))
    (local.set $new_g (call $algebraic_poly_trunc (call $algebraic_poly_add_poly (local.get $g) (local.get $u)) (local.get $mm)))
    (if (i32.eqz (local.get $new_g)) (then (return (i32.const 0))))
    (local.set $new_h (call $algebraic_poly_trunc (call $algebraic_poly_add_poly (local.get $h) (local.get $r)) (local.get $mm)))
    (if (i32.eqz (local.get $new_h)) (then (return (i32.const 0))))
    (local.set $u (call $algebraic_poly_add_poly
      (call $algebraic_poly_mul (local.get $s) (local.get $new_g)) (call $algebraic_poly_mul (local.get $t) (local.get $new_h))))
    (if (i32.eqz (local.get $u)) (then (return (i32.const 0))))
    (local.set $b (call $algebraic_poly_trunc (call $algebraic_poly_sub_poly (local.get $u) (local.get $one)) (local.get $mm)))
    (if (i32.eqz (local.get $b)) (then (return (i32.const 0))))
    (if (call $algebraic_poly_divmod_monic
          (call $algebraic_poly_mul (local.get $s) (local.get $b)) (local.get $new_h) (local.get $q_out) (local.get $r_out))
      (then (return (i32.const 0))))
    (local.set $c (i32.load (call $abs (local.get $q_out))))
    (local.set $d (i32.load (call $abs (local.get $r_out))))
    (local.set $c (call $algebraic_poly_trunc (local.get $c) (local.get $mm)))
    (local.set $d (call $algebraic_poly_trunc (local.get $d) (local.get $mm)))
    (local.set $u (call $algebraic_poly_add_poly
      (call $algebraic_poly_mul (local.get $t) (local.get $b)) (call $algebraic_poly_mul (local.get $c) (local.get $new_g))))
    (if (i32.eqz (local.get $u)) (then (return (i32.const 0))))
    (local.set $new_s (call $algebraic_poly_trunc (call $algebraic_poly_sub_poly (local.get $s) (local.get $d)) (local.get $mm)))
    (if (i32.eqz (local.get $new_s)) (then (return (i32.const 0))))
    (local.set $new_t (call $algebraic_poly_trunc (call $algebraic_poly_sub_poly (local.get $t) (local.get $u)) (local.get $mm)))
    (if (i32.eqz (local.get $new_t)) (then (return (i32.const 0))))
    (i32.store (call $abs (local.get $g_out)) (local.get $new_g))
    (i32.store (call $abs (local.get $h_out)) (local.get $new_h))
    (i32.store (call $abs (local.get $s_out)) (local.get $new_s))
    (i32.store (call $abs (local.get $t_out)) (local.get $new_t))
    (i32.const 0)
  )

  ;; Multifactor Hensel lifting in Z[x] accepts a prime p, an integer
  ;; polynomial f whose leading coefficient is a unit mod p, and monic,
  ;; pairwise-coprime GF(p) factors f_1..f_r in raw-i32 representation.
  ;; They satisfy f = lc(f)*f_1*...*f_r (mod p). For exponent l, it
  ;; returns monic integer polynomials F_1..F_r satisfying
  ;; f = lc(f)*F_1*...*F_r (mod p^l) and F_i = f_i (mod p).
  ;; The construction follows SymPy's dup_zz_hensel_lift.


  ;; $f_list: r entries of 4 bytes each (GF(p) poly pointers).
  ;; $result_out: r entries of 4 bytes each (bigint-coefficient poly
  ;; pointers), caller-provided scratch of the SAME size as $f_list.
  ;; 0 ok / 1 pressure.
  (func $algebraic_hensel_lift
    (param $p i32) (param $f i32) (param $f_list i32) (param $r i32) (param $l i32)
    (param $result_out i32)
    (result i32)
    (local $lc i32)
    (local $inv_u i32)
    (local $inv_v i32)
    (local $pl i32)
    (local $gcd_result i32)
    (local $scaled i32)
    (local $k i32)
    (local $d i32)
    (local $g_gf i32)
    (local $h_gf i32)
    (local $i i32)
    (local $g i32)
    (local $h i32)
    (local $s i32)
    (local $t i32)
    (local $s_gf i32)
    (local $t_gf i32)
    (local $h_out_gf i32)
    (local $m i32)
    (local $g_out i32)
    (local $h_out i32)
    (local $s_out i32)
    (local $t_out i32)
    (local $step_status i32)
    (local $left_list i32)
    (local $right_list i32)
    (local $left_out i32)
    (local $right_out i32)
    (if (i32.eq (local.get $r) (i32.const 1))
      (then
        (local.set $lc (call $algebraic_poly_coefficient (local.get $f) (call $algebraic_poly_degree (local.get $f))))
        (local.set $pl (call $bigint_pow (call $bigint_from_i64 (i64.extend_i32_u (local.get $p)))
          (call $bigint_from_i64 (i64.extend_i32_u (local.get $l)))))
        (local.set $inv_u (call $carve_scratch_blob (i32.const 4)))
        (local.set $inv_v (call $carve_scratch_blob (i32.const 4)))
        (drop (call $bigint_extended_gcd (local.get $lc) (local.get $pl) (local.get $inv_u) (local.get $inv_v)))
        (local.set $scaled (call $algebraic_poly_carve (call $algebraic_poly_degree (local.get $f))))
        (if (i32.eqz (local.get $scaled)) (then (return (i32.const 1))))
        (local.set $i (i32.const 0))
        (block $scale_done
          (loop $scale
            (br_if $scale_done (i32.gt_s (local.get $i) (call $algebraic_poly_degree (local.get $f))))
            (call $algebraic_poly_set_coefficient (local.get $scaled) (local.get $i)
              (call $bigint_mul (call $algebraic_poly_coefficient (local.get $f) (local.get $i))
                (i32.load (call $abs (local.get $inv_u)))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $scale)))
        (call $algebraic_poly_trim (local.get $scaled))
        (i32.store (call $abs (local.get $result_out)) (call $algebraic_poly_trunc (local.get $scaled) (local.get $pl)))
        (return (i32.const 0))))
    (local.set $m (call $bigint_from_i64 (i64.extend_i32_u (local.get $p))))
    (local.set $k (i32.div_s (local.get $r) (i32.const 2)))
    ;; d = ceil(log2(l)) via bit_length(l-1) (l>=1 guaranteed by caller).
    (local.set $d (i32.sub (i32.const 32) (i32.clz (i32.sub (local.get $l) (i32.const 1)))))
    (if (i32.le_s (local.get $l) (i32.const 1)) (then (local.set $d (i32.const 0))))
    (local.set $lc (call $algebraic_poly_coefficient (local.get $f) (call $algebraic_poly_degree (local.get $f))))
    (local.set $g_gf (call $galois_poly_zero (i32.const 0)))
    (call $algebraic_poly_set_coefficient (local.get $g_gf) (i32.const 0) (call $galois_reduce_bigint (local.get $lc) (local.get $p)))
    (local.set $i (i32.const 0))
    (block $g_done
      (loop $g_mul
        (br_if $g_done (i32.ge_s (local.get $i) (local.get $k)))
        (local.set $g_gf (call $galois_poly_mul (local.get $g_gf)
          (i32.load (call $abs (i32.add (local.get $f_list) (i32.mul (local.get $i) (i32.const 4))))) (local.get $p)))
        (if (i32.eqz (local.get $g_gf)) (then (return (i32.const 1))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $g_mul)))
    (local.set $h_gf (i32.load (call $abs (i32.add (local.get $f_list) (i32.mul (local.get $k) (i32.const 4))))))
    (local.set $i (i32.add (local.get $k) (i32.const 1)))
    (block $h_done
      (loop $h_mul
        (br_if $h_done (i32.ge_s (local.get $i) (local.get $r)))
        (local.set $h_gf (call $galois_poly_mul (local.get $h_gf)
          (i32.load (call $abs (i32.add (local.get $f_list) (i32.mul (local.get $i) (i32.const 4))))) (local.get $p)))
        (if (i32.eqz (local.get $h_gf)) (then (return (i32.const 1))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $h_mul)))
    (local.set $s_gf (call $carve_scratch_blob (i32.const 4)))
    (local.set $t_gf (call $carve_scratch_blob (i32.const 4)))
    (local.set $h_out_gf (call $carve_scratch_blob (i32.const 4)))
    (if (call $galois_poly_gcdex (local.get $g_gf) (local.get $h_gf) (local.get $p)
          (local.get $s_gf) (local.get $t_gf) (local.get $h_out_gf))
      (then (return (i32.const 1))))
    (local.set $g (call $galois_poly_to_bigint_poly (local.get $g_gf)))
    (local.set $h (call $galois_poly_to_bigint_poly (local.get $h_gf)))
    (local.set $s (call $galois_poly_to_bigint_poly (i32.load (call $abs (local.get $s_gf)))))
    (local.set $t (call $galois_poly_to_bigint_poly (i32.load (call $abs (local.get $t_gf)))))
    (local.set $g_out (call $carve_scratch_blob (i32.const 4)))
    (local.set $h_out (call $carve_scratch_blob (i32.const 4)))
    (local.set $s_out (call $carve_scratch_blob (i32.const 4)))
    (local.set $t_out (call $carve_scratch_blob (i32.const 4)))
    (local.set $i (i32.const 1))
    (block $lift_done
      (loop $lift
        (br_if $lift_done (i32.gt_s (local.get $i) (local.get $d)))
        (if (call $expression_walk_guard (i32.const 128)) (then (return (i32.const 1))))
        (local.set $step_status (call $algebraic_hensel_step
          (local.get $m) (local.get $f) (local.get $g) (local.get $h) (local.get $s) (local.get $t)
          (local.get $g_out) (local.get $h_out) (local.get $s_out) (local.get $t_out)))
        (if (local.get $step_status) (then (return (i32.const 1))))
        (local.set $g (i32.load (call $abs (local.get $g_out))))
        (local.set $h (i32.load (call $abs (local.get $h_out))))
        (local.set $s (i32.load (call $abs (local.get $s_out))))
        (local.set $t (i32.load (call $abs (local.get $t_out))))
        (local.set $m (call $bigint_mul (local.get $m) (local.get $m)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $lift)))
    (local.set $left_list (call $carve_scratch_blob (i32.mul (local.get $k) (i32.const 4))))
    (local.set $i (i32.const 0))
    (block $copy_left_list_done
      (loop $copy_left_list
        (br_if $copy_left_list_done (i32.ge_s (local.get $i) (local.get $k)))
        (i32.store (call $abs (i32.add (local.get $left_list) (i32.mul (local.get $i) (i32.const 4))))
          (i32.load (call $abs (i32.add (local.get $f_list) (i32.mul (local.get $i) (i32.const 4))))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $copy_left_list)))
    (local.set $right_list (call $carve_scratch_blob (i32.mul (i32.sub (local.get $r) (local.get $k)) (i32.const 4))))
    (local.set $i (local.get $k))
    (block $copy_right_list_done
      (loop $copy_right_list
        (br_if $copy_right_list_done (i32.ge_s (local.get $i) (local.get $r)))
        (i32.store (call $abs (i32.add (local.get $right_list) (i32.mul (i32.sub (local.get $i) (local.get $k)) (i32.const 4))))
          (i32.load (call $abs (i32.add (local.get $f_list) (i32.mul (local.get $i) (i32.const 4))))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $copy_right_list)))
    (local.set $left_out (call $carve_scratch_blob (i32.mul (local.get $k) (i32.const 4))))
    (if (call $algebraic_hensel_lift (local.get $p) (local.get $g) (local.get $left_list) (local.get $k) (local.get $l) (local.get $left_out))
      (then (return (i32.const 1))))
    (local.set $right_out (call $carve_scratch_blob (i32.mul (i32.sub (local.get $r) (local.get $k)) (i32.const 4))))
    (if (call $algebraic_hensel_lift (local.get $p) (local.get $h) (local.get $right_list)
          (i32.sub (local.get $r) (local.get $k)) (local.get $l) (local.get $right_out))
      (then (return (i32.const 1))))
    (local.set $i (i32.const 0))
    (block $copy_left_result_done
      (loop $copy_left_result
        (br_if $copy_left_result_done (i32.ge_s (local.get $i) (local.get $k)))
        (i32.store (call $abs (i32.add (local.get $result_out) (i32.mul (local.get $i) (i32.const 4))))
          (i32.load (call $abs (i32.add (local.get $left_out) (i32.mul (local.get $i) (i32.const 4))))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $copy_left_result)))
    (local.set $i (i32.const 0))
    (block $copy_right_result_done
      (loop $copy_right_result
        (br_if $copy_right_result_done (i32.ge_s (local.get $i) (i32.sub (local.get $r) (local.get $k))))
        (i32.store (call $abs (i32.add (local.get $result_out) (i32.mul (i32.add (local.get $k) (local.get $i)) (i32.const 4))))
          (i32.load (call $abs (i32.add (local.get $right_out) (i32.mul (local.get $i) (i32.const 4))))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $copy_right_result)))
    (i32.const 0)
  )

  ;; =====================================================================
  ;; Zassenhaus assembly performs prime selection, Mignotte bounding,
  ;; Hensel lifting to sufficient precision, subset-product recombination,
  ;; and trial division. It follows SymPy's dup_zz_zassenhaus and
  ;; requires $f to be primitive and squarefree; callers normalize it
  ;; before entry. Multiplicity recovery happens outside this routine.



  ;; =====================================================================

  ;; Trial-division primality test for small non-negative i32 values.
  (func $galois_is_prime (param $n i32) (result i32)
    (local $i i32)
    (if (i32.lt_s (local.get $n) (i32.const 2)) (then (return (i32.const 0))))
    (if (i32.eq (local.get $n) (i32.const 2)) (then (return (i32.const 1))))
    (if (i32.eqz (i32.rem_u (local.get $n) (i32.const 2))) (then (return (i32.const 0))))
    (local.set $i (i32.const 3))
    (block $done
      (loop $trial
        (br_if $done (i32.gt_s (i32.mul (local.get $i) (local.get $i)) (local.get $n)))
        (if (i32.eqz (i32.rem_u (local.get $n) (local.get $i))) (then (return (i32.const 0))))
        (local.set $i (i32.add (local.get $i) (i32.const 2)))
        (br $trial)))
    (i32.const 1)
  )

  ;; Integer square root (floor) of a small non-negative i32, via
  ;; Newton's method -- needed for the Mignotte bound's K.sqrt(n+1).
  (func $galois_isqrt (param $n i32) (result i32)
    (local $x i32)
    (local $y i32)
    (if (i32.le_s (local.get $n) (i32.const 1)) (then (return (local.get $n))))
    (local.set $x (local.get $n))
    (local.set $y (i32.div_s (i32.add (local.get $x) (i32.const 1)) (i32.const 2)))
    (block $done
      (loop $newton
        (br_if $done (i32.ge_s (local.get $y) (local.get $x)))
        (local.set $x (local.get $y))
        (local.set $y (i32.div_s (i32.add (local.get $x) (i32.div_s (local.get $n) (local.get $x))) (i32.const 2)))
        (br $newton)))
    (local.get $x)
  )

  ;; Max-norm (largest absolute-value coefficient), as a bigint.
  (func $algebraic_poly_max_norm (param $f i32) (result i32)
    (local $degree i32)
    (local $i i32)
    (local $result i32)
    (local $abs_c i32)
    (local $zero i32)
    (local.set $degree (call $algebraic_poly_degree (local.get $f)))
    (local.set $zero (call $bigint_from_i64 (i64.const 0)))
    (local.set $result (local.get $zero))
    (local.set $i (i32.const 0))
    (block $done
      (loop $walk
        (br_if $done (i32.gt_s (local.get $i) (local.get $degree)))
        (local.set $abs_c (call $algebraic_poly_coefficient (local.get $f) (local.get $i)))
        (if (i32.ne (call $bigint_sign (local.get $abs_c)) (i32.const 0))
          (then (local.set $abs_c (call $bigint_sub (local.get $zero) (local.get $abs_c)))))
        (if (i32.gt_s (call $bigint_compare (local.get $abs_c) (local.get $result)) (i32.const 0))
          (then (local.set $result (local.get $abs_c))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $walk)))
    (local.get $result)
  )

  ;; L1-norm (sum of absolute-value coefficients), as a bigint.
  (func $algebraic_poly_l1_norm (param $f i32) (result i32)
    (local $degree i32)
    (local $i i32)
    (local $result i32)
    (local $abs_c i32)
    (local $zero i32)
    (local.set $degree (call $algebraic_poly_degree (local.get $f)))
    (local.set $zero (call $bigint_from_i64 (i64.const 0)))
    (local.set $result (local.get $zero))
    (local.set $i (i32.const 0))
    (block $done
      (loop $walk
        (br_if $done (i32.gt_s (local.get $i) (local.get $degree)))
        (local.set $abs_c (call $algebraic_poly_coefficient (local.get $f) (local.get $i)))
        (if (i32.ne (call $bigint_sign (local.get $abs_c)) (i32.const 0))
          (then (local.set $abs_c (call $bigint_sub (local.get $zero) (local.get $abs_c)))))
        (local.set $result (call $bigint_add (local.get $result) (local.get $abs_c)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $walk)))
    (local.get $result)
  )

  ;; Zassenhaus factorization of a PRIMITIVE SQUAREFREE integer
  ;; polynomial f (degree >= 2 -- callers handle degree <= 1
  ;; trivially, matching SymPy's own dup_zz_zassenhaus early-return
  ;; for degree 1). $result_out: caller scratch, $max_factors entries
  ;; of 4 bytes each (bigint-coefficient poly pointers). Returns
  ;; factor count, or -1 pressure, -2 too many factors, -3 no prime
  ;; found within the search bound (a genuine, loud failure -- never
  ;; silently returns a wrong/partial factorization).
  (func $algebraic_zz_zassenhaus
    (param $f i32) (param $result_out i32) (param $max_factors i32)
    (result i32)
    (local $n i32)
    (local $fc i32)
    (local $a_norm i32)
    (local $b i32)
    (local $bb i32)
    (local $cc i32)
    (local $gamma i32)
    (local $bound i32)
    (local $px i32)
    (local $best_p i32)
    (local $best_count i32)
    (local $best_factors i32)
    (local $primes_tried i32)
    (local $fp i32)
    (local $sqf_factors i32)
    (local $sqf_count i32)
    (local $sqf_lc_out i32)
    (local $trial_count i32)
    (local $trial_factors i32)
    (local $i i32)
    (local $l i32)
    (local $pl_pow i32)
    (local $f_list i32)
    (local $lifted_out i32)
    (local $lift_status i32)
    (local $r i32)
    (local $mask i32)
    (local $full_mask i32)
    (local $s i32)
    (local $popcount i32)
    (local $g_product i32)
    (local $h_product i32)
    (local $j i32)
    (local $remaining_count i32)
    (local $remaining i32)
    (local $q_const i32)
    (local $g_norm i32)
    (local $h_norm i32)
    (local $found i32)
    (local $new_remaining i32)
    (local $new_remaining_count i32)
    (local $g_primitive i32)
    (local $g_primitive_for_qtest i32)
    (local $f_primitive i32)
    (local $subset_accepted i32)
    (local $fp_monic i32)
    (local $fp_monic_lc_out i32)
    (local $mask_heap_checkpoint i32)
    (local.set $n (call $algebraic_poly_degree (local.get $f)))
    (local.set $fc (call $algebraic_poly_coefficient (local.get $f) (i32.const 0)))
    (local.set $a_norm (call $algebraic_poly_max_norm (local.get $f)))
    (local.set $b (call $algebraic_poly_coefficient (local.get $f) (local.get $n)))
    ;; B = floor(sqrt(n+1) * 2^n * A * b) -- computed via bigint
    ;; throughout since A, b can be large; sqrt(n+1) itself is a SMALL
    ;; integer (n is a polynomial degree), computed via galois_isqrt.
    (local.set $bb (call $bigint_mul
      (call $bigint_mul
        (call $bigint_from_i64 (i64.extend_i32_u (call $galois_isqrt (i32.add (local.get $n) (i32.const 1)))))
        (call $bigint_pow (call $bigint_from_i64 (i64.const 2)) (call $bigint_from_i64 (i64.extend_i32_u (local.get $n)))))
      (call $bigint_mul (local.get $a_norm)
        (select (local.get $b) (call $bigint_sub (call $bigint_from_i64 (i64.const 0)) (local.get $b))
          (i32.eq (call $bigint_sign (local.get $b)) (i32.const 0))))))
    ;; C = (n+1)^(2n) * A^(2n-1)
    (local.set $cc (call $bigint_mul
      (call $bigint_pow (call $bigint_from_i64 (i64.extend_i32_u (i32.add (local.get $n) (i32.const 1))))
        (call $bigint_from_i64 (i64.extend_i32_u (i32.mul (i32.const 2) (local.get $n)))))
      (call $bigint_pow (local.get $a_norm)
        (call $bigint_from_i64 (i64.extend_i32_u (i32.sub (i32.mul (i32.const 2) (local.get $n)) (i32.const 1)))))))
    ;; gamma = ceil(2*log2(C)) -- log2(C) via bit_length (a slight
    ;; over-estimate vs a true log2, which only widens the search
    ;; bound -- always safe, never under-estimates).
    (local.set $gamma (i32.mul (i32.const 2) (call $bigint_bit_length (local.get $cc))))
    ;; bound = 2*gamma*ln(gamma) -- ln(gamma) approximated as
    ;; bit_length(gamma) (natural log <= bit_length*ln(2) < bit_length
    ;; for gamma>=2 in bits -- again a safe over-estimate that only
    ;; widens the prime search, never narrows it below what SymPy's
    ;; own exact ln would require).
    (local.set $bound (i32.mul (i32.mul (i32.const 2) (local.get $gamma))
      (i32.add (i32.const 1) (call $bigint_bit_length (call $bigint_from_i64 (i64.extend_i32_u (local.get $gamma)))))))
    (if (i32.lt_s (local.get $bound) (i32.const 100)) (then (local.set $bound (i32.const 100))))
    (local.set $best_count (i32.const -1))
    (local.set $primes_tried (i32.const 0))
    (local.set $px (i32.const 3))
    ;; Try primes until either a genuinely small factor count is found
    ;; (< 15, SymPy's own threshold) or 5 primes have been tried --
    ;; THEN pick the minimum-factor-count prime among those tried.
    ;; Never commit to the very FIRST prime found, even if it gives
    ;; best_count<=1 -- f mod p can be irreducible for some specific p
    ;; while f itself is genuinely reducible over Z (Galois-theoretic
    ;; fact, not a corner case): stopping the search early on such a p
    ;; silently under-factor. A degree-8 polynomial reducible over Z into
    ;; two degree-4 factors demonstrates the failure: the first usable
    ;; prime (3) can leave it irreducible mod 3, so an early exit returns
    ;; it unfactored.
    (block $search_done
      (loop $search
        (br_if $search_done (i32.gt_s (local.get $px) (local.get $bound)))
        (if (call $expression_walk_guard (i32.const 64)) (then (return (i32.const -1))))
        (if (i32.and (call $galois_is_prime (local.get $px))
              (i32.ne (i32.rem_u (call $galois_reduce_bigint (local.get $b) (local.get $px)) (local.get $px)) (i32.const 0)))
          (then
            (local.set $fp (call $galois_poly_from_bigint_poly (local.get $f) (local.get $px)))
            (if (i32.eqz (local.get $fp)) (then (return (i32.const -1))))
            (local.set $sqf_lc_out (call $carve_scratch_blob (i32.const 4)))
            (local.set $sqf_factors (call $carve_scratch_blob (i32.mul (local.get $max_factors) (i32.const 8))))
            (local.set $sqf_count (call $galois_sqf_list (local.get $fp) (local.get $px)
              (local.get $sqf_factors) (local.get $max_factors) (local.get $sqf_lc_out)))
            ;; f mod px must ITSELF be squarefree (sqf_count entries
            ;; must all have multiplicity 1, and there must be exactly
            ;; one nontrivial squarefree factor covering the whole
            ;; degree n -- SymPy's gf_sqf_p check). Cheaply verified:
            ;; sqf_count==1 and that one factor's multiplicity==1.
            (if (i32.and (i32.eq (local.get $sqf_count) (i32.const 1))
                  (i32.eq (i32.load (call $abs (i32.add (local.get $sqf_factors) (i32.const 4)))) (i32.const 1)))
              (then
                ;; galois_ddf_zassenhaus/edf_zassenhaus (SymPy's
                ;; gf_ddf_zassenhaus/gf_edf_zassenhaus) assume a MONIC
                ;; input and return MONIC factors -- SymPy's own
                ;; gf_factor_sqf always monic-izes first (gf_monic) and
                ;; discards the extracted lc, since dup_zz_zassenhaus
                ;; separately uses the ORIGINAL f's leading coefficient
                ;; (dup_LC(f) reduced mod p) to seed the Hensel lift's
                ;; g_gf. Skipping this monic-ization here left
                ;; galois_ddf_factor_full returning mathematically-valid
                ;; but NON-monic factors whenever b mod px != 1 (e.g.
                ;; [1,1] and [1,1,2] for a case whose true monic
                ;; factors are [1,1] and [2,2,1]) -- Hensel lifting a
                ;; non-monic factor silently produces garbage
                ;; (confirmed: a degree-3 b=8 resultant lifted to a
                ;; degree-90 polynomial of huge random-looking
                ;; coefficients instead of the true degree-1/degree-2
                ;; split), which the subset-recombination loop then
                ;; correctly rejects every subset of -- reporting the
                ;; polynomial unfactored even though it's reducible.
                (local.set $fp_monic_lc_out (call $carve_scratch_blob (i32.const 4)))
                (local.set $fp_monic (call $galois_poly_monic (local.get $fp) (local.get $px) (local.get $fp_monic_lc_out)))
                (local.set $trial_factors (call $carve_scratch_blob (i32.mul (local.get $max_factors) (i32.const 4))))
                (local.set $trial_count (call $galois_ddf_factor_full
                  (local.get $fp_monic) (local.get $px) (local.get $trial_factors) (local.get $max_factors)))
                (if (i32.lt_s (local.get $trial_count) (i32.const 0)) (then (return (local.get $trial_count))))
                (if (i32.or (i32.eq (local.get $best_count) (i32.const -1))
                      (i32.lt_s (local.get $trial_count) (local.get $best_count)))
                  (then
                    (local.set $best_count (local.get $trial_count))
                    (local.set $best_p (local.get $px))
                    (local.set $best_factors (local.get $trial_factors))))
                (local.set $primes_tried (i32.add (local.get $primes_tried) (i32.const 1)))
                (if (i32.or (i32.lt_s (local.get $trial_count) (i32.const 15))
                      (i32.gt_s (local.get $primes_tried) (i32.const 4)))
                  (then (br $search_done)))))))
        (local.set $px (i32.add (local.get $px) (i32.const 1)))
        (br $search)))
    (if (i32.eq (local.get $best_count) (i32.const -1)) (then (return (i32.const -3))))
    (if (i32.eq (local.get $best_count) (i32.const 1))
      (then
        (i32.store (call $abs (local.get $result_out)) (local.get $f))
        (return (i32.const 1))))
    ;; l = ceil(log_p(2B+1)) -- computed via repeated multiplication
    ;; (p is small, l is typically single-digit, so a direct loop is
    ;; simpler and just as correct as a logarithm approximation).
    (local.set $l (i32.const 1))
    (local.set $pl_pow (call $bigint_from_i64 (i64.extend_i32_u (local.get $best_p))))
    (local.set $q_const (call $bigint_add (call $bigint_mul (local.get $bb) (call $bigint_from_i64 (i64.const 2))) (call $bigint_one)))
    (block $l_done
      (loop $l_loop
        (br_if $l_done (i32.gt_s (call $bigint_compare (local.get $pl_pow) (local.get $q_const)) (i32.const 0)))
        (local.set $pl_pow (call $bigint_mul (local.get $pl_pow) (call $bigint_from_i64 (i64.extend_i32_u (local.get $best_p)))))
        (local.set $l (i32.add (local.get $l) (i32.const 1)))
        (br $l_loop)))
    (local.set $f_list (call $carve_scratch_blob (i32.mul (local.get $best_count) (i32.const 4))))
    (i32.store (call $abs (local.get $f_list)) (i32.const 0))
    (local.set $r (local.get $best_count))
    (local.set $i (i32.const 0))
    (block $copy_bf_done
      (loop $copy_bf
        (br_if $copy_bf_done (i32.ge_s (local.get $i) (local.get $r)))
        (i32.store (call $abs (i32.add (local.get $f_list) (i32.mul (local.get $i) (i32.const 4))))
          (i32.load (call $abs (i32.add (local.get $best_factors) (i32.mul (local.get $i) (i32.const 4))))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $copy_bf)))
    (local.set $lifted_out (call $carve_scratch_blob (i32.mul (local.get $r) (i32.const 4))))
    (local.set $lift_status (call $algebraic_hensel_lift
      (local.get $best_p) (local.get $f) (local.get $f_list) (local.get $r) (local.get $l) (local.get $lifted_out)))
    (if (local.get $lift_status) (then (return (i32.const -1))))
    ;; Subset-product recombination: try every subset size s=1,2,...
    ;; of the remaining lifted factors, smallest first, testing
    ;; whether the subset's product (times original lc) recombines
    ;; into a genuine factor of f (norm bound test). Bitmask
    ;; enumeration over $remaining_count bits (r is always small in
    ;; this project's actual use -- resultants of a handful of
    ;; algebraic values -- so this never approaches the classical
    ;; worst-case subset-search blowup in practice).
    (local.set $remaining_count (local.get $r))
    (local.set $remaining (call $carve_scratch_blob (i32.mul (local.get $r) (i32.const 4))))
    (local.set $i (i32.const 0))
    (block $copy_rem_done
      (loop $copy_rem
        (br_if $copy_rem_done (i32.ge_s (local.get $i) (local.get $r)))
        (i32.store (call $abs (i32.add (local.get $remaining) (i32.mul (local.get $i) (i32.const 4))))
          (i32.load (call $abs (i32.add (local.get $lifted_out) (i32.mul (local.get $i) (i32.const 4))))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $copy_rem)))
    (local.set $f_primitive (local.get $f))
    (local.set $j (i32.const 0))
    (local.set $s (i32.const 1))
    (block $recombine_done
      (loop $recombine
        (br_if $recombine_done (i32.gt_s (i32.mul (i32.const 2) (local.get $s)) (local.get $remaining_count)))
        (local.set $full_mask (i32.shl (i32.const 1) (local.get $remaining_count)))
        (local.set $mask (i32.const 0))
        (local.set $subset_accepted (i32.const 0))
        (block $mask_done
          (loop $mask_loop
            (local.set $mask (i32.add (local.get $mask) (i32.const 1)))
            (br_if $mask_done (i32.ge_s (local.get $mask) (local.get $full_mask)))
            (local.set $mask_heap_checkpoint
              (call $read_state (global.get $STATE_HEAP_POINTER)))
            (if (call $expression_walk_guard (i32.const 32)) (then (return (i32.const -1))))
            (local.set $popcount (i32.popcnt (local.get $mask)))
            (if (i32.eq (local.get $popcount) (local.get $s))
              (then
                (local.set $g_product (call $algebraic_poly_carve (i32.const 0)))
                (call $algebraic_poly_set_coefficient (local.get $g_product) (i32.const 0) (local.get $b))
                (local.set $i (i32.const 0))
                (block $g_build_done
                  (loop $g_build
                    (br_if $g_build_done (i32.ge_s (local.get $i) (local.get $remaining_count)))
                    (if (i32.and (i32.shr_u (local.get $mask) (local.get $i)) (i32.const 1))
                      (then
                        (local.set $g_product (call $algebraic_poly_mul (local.get $g_product)
                          (i32.load (call $abs (i32.add (local.get $remaining) (i32.mul (local.get $i) (i32.const 4)))))))
                        (if (i32.eqz (local.get $g_product)) (then (return (i32.const -1))))))
                    (local.set $i (i32.add (local.get $i) (i32.const 1)))
                    (br $g_build)))
                (local.set $g_product (call $algebraic_poly_trunc (local.get $g_product) (local.get $pl_pow)))
                (if (i32.eqz (local.get $g_product)) (then (return (i32.const -1))))
                ;; SymPy's b!=1 branch takes the PRIMITIVE PART of G
                ;; here for q=G[-1]'s divisibility test ONLY -- the
                ;; norm check just below still uses the RAW (non-
                ;; primitive) g_product, matching SymPy's own G_norm =
                ;; dup_l1_norm(G) computed BEFORE that function's own
                ;; later (post-norm-check) primitive-part extraction.
                ;; Conflating the two (taking primitive once and
                ;; reusing it for both) was an earlier bug here: without
                ;; ever taking ANY primitive part, q_const carried a
                ;; spurious content skew from b!=1 and broke the
                ;; divisibility test outright, producing a false negative
                ;; for a degree-8 resultant with b=4 by rejecting every subset.
                (local.set $g_primitive_for_qtest (call $algebraic_poly_primitive (local.get $g_product) (i32.const 0)))
                (if (i32.eqz (local.get $g_primitive_for_qtest)) (then (return (i32.const -1))))
                (local.set $q_const (call $algebraic_poly_coefficient (local.get $g_primitive_for_qtest) (i32.const 0)))
                (if (i32.eqz (call $bigint_length (local.get $q_const)))
                  (then (local.set $found (i32.const 1)))
                  (else
                    (drop (call $bigint_div (local.get $fc) (local.get $q_const)))
                    (local.set $found (i32.eqz (call $bigint_length (call $bigint_last_remainder))))))
                (if (local.get $found)
                  (then
                    (local.set $h_product (call $algebraic_poly_carve (i32.const 0)))
                    (call $algebraic_poly_set_coefficient (local.get $h_product) (i32.const 0) (local.get $b))
                    (local.set $i (i32.const 0))
                    (block $h_build_done
                      (loop $h_build
                        (br_if $h_build_done (i32.ge_s (local.get $i) (local.get $remaining_count)))
                        (if (i32.eqz (i32.and (i32.shr_u (local.get $mask) (local.get $i)) (i32.const 1)))
                          (then
                            (local.set $h_product (call $algebraic_poly_mul (local.get $h_product)
                              (i32.load (call $abs (i32.add (local.get $remaining) (i32.mul (local.get $i) (i32.const 4)))))))
                            (if (i32.eqz (local.get $h_product)) (then (return (i32.const -1))))))
                        (local.set $i (i32.add (local.get $i) (i32.const 1)))
                        (br $h_build)))
                    (local.set $h_product (call $algebraic_poly_trunc (local.get $h_product) (local.get $pl_pow)))
                    (if (i32.eqz (local.get $h_product)) (then (return (i32.const -1))))
                    (local.set $g_norm (call $algebraic_poly_l1_norm (local.get $g_product)))
                    (local.set $h_norm (call $algebraic_poly_l1_norm (local.get $h_product)))
                    (if (i32.le_s (call $bigint_compare (call $bigint_mul (local.get $g_norm) (local.get $h_norm)) (local.get $bb)) (i32.const 0))
                      (then
                        (if (i32.ge_s (local.get $j) (local.get $max_factors)) (then (return (i32.const -2))))
                        (local.set $g_primitive (call $algebraic_poly_primitive (local.get $g_product) (i32.const 0)))
                        (i32.store (call $abs (i32.add (local.get $result_out) (i32.mul (local.get $j) (i32.const 4)))) (local.get $g_primitive))
                        (local.set $j (i32.add (local.get $j) (i32.const 1)))
                        (local.set $f_primitive (call $algebraic_poly_primitive (local.get $h_product) (i32.const 0)))
                        (local.set $b (call $algebraic_poly_coefficient (local.get $f_primitive)
                          (call $algebraic_poly_degree (local.get $f_primitive))))
                        (local.set $new_remaining (call $carve_scratch_blob (i32.mul (local.get $remaining_count) (i32.const 4))))
                        (local.set $new_remaining_count (i32.const 0))
                        (local.set $i (i32.const 0))
                        (block $filter_done
                          (loop $filter
                            (br_if $filter_done (i32.ge_s (local.get $i) (local.get $remaining_count)))
                            (if (i32.eqz (i32.and (i32.shr_u (local.get $mask) (local.get $i)) (i32.const 1)))
                              (then
                                (i32.store (call $abs (i32.add (local.get $new_remaining) (i32.mul (local.get $new_remaining_count) (i32.const 4))))
                                  (i32.load (call $abs (i32.add (local.get $remaining) (i32.mul (local.get $i) (i32.const 4))))))
                                (local.set $new_remaining_count (i32.add (local.get $new_remaining_count) (i32.const 1)))))
                            (local.set $i (i32.add (local.get $i) (i32.const 1)))
                            (br $filter)))
                        (local.set $remaining (local.get $new_remaining))
                        (local.set $remaining_count (local.get $new_remaining_count))
                        (local.set $subset_accepted (i32.const 1))
                        (br $mask_done)))))))
            ;; Rejected subsets contribute no factor or remaining-list state.
            ;; Reclaim their polynomial products before trying the next mask;
            ;; irreducible inputs otherwise accumulate every failed subset
            ;; inside one non-resumable factorization call.
            (call $write_state
              (global.get $STATE_HEAP_POINTER) (local.get $mask_heap_checkpoint))
            (br $mask_loop)))
        (if (i32.eqz (local.get $subset_accepted)) (then (local.set $s (i32.add (local.get $s) (i32.const 1)))))
        (br $recombine)))
    (if (i32.ge_s (local.get $j) (local.get $max_factors)) (then (return (i32.const -2))))
    (i32.store (call $abs (i32.add (local.get $result_out) (i32.mul (local.get $j) (i32.const 4)))) (local.get $f_primitive))
    (i32.add (local.get $j) (i32.const 1))
  )

  ;; Pretty-print: algebraic(x^3 - 2, (5/4, 3/2)). Composes with
  ;; $string_concat like $complex_to_decimal; callers poll the
  ;; pressure flag.
  (func $algebraic_to_decimal (param $header i32) (result i32)
    (local $coefficients_array i32)
    (local $length i32)
    (local $data i32)
    (local $interval_data i32)
    (local $result i32)
    (local $i i32)
    (local $coefficient i32)
    (local $negative i32)
    (local $first i32)
    (local $magnitude i32)
    (local.set $coefficients_array (call $algebraic_coefficients_of (local.get $header)))
    (local.set $length (i32.load (call $abs (i32.add (local.get $coefficients_array) (i32.const 8)))))
    (local.set $data (i32.add
      (i32.load (call $abs (i32.add (local.get $coefficients_array) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (local.set $interval_data (i32.add
      (i32.load (call $abs (i32.add
        (call $algebraic_interval_of (local.get $header)) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (local.set $result (call $read_builtin (global.get $BUILTIN_ALGEBRAIC_TOSTRING_PREFIX)))
    (local.set $first (i32.const 1))
    (local.set $i (i32.sub (local.get $length) (i32.const 1)))
    (block $terms_done
      (loop $terms
        (br_if $terms_done (i32.lt_s (local.get $i) (i32.const 0)))
        (local.set $coefficient (call $value_data_lo (i32.add (local.get $data)
          (i32.mul (local.get $i) (global.get $VALUE_SIZE)))))
        (if (i32.eqz (call $bigint_length (local.get $coefficient)))
          (then
            (local.set $i (i32.sub (local.get $i) (i32.const 1)))
            (br $terms)))
        (local.set $negative (i32.ne (call $bigint_sign (local.get $coefficient)) (i32.const 0)))
        (if (local.get $first)
          (then
            (local.set $first (i32.const 0))
            (if (local.get $negative)
              (then (local.set $result (call $string_concat (local.get $result)
                (call $read_builtin (global.get $BUILTIN_EXACT_MINUS)))))))
          (else
            (if (local.get $negative)
              (then (local.set $result (call $string_concat (local.get $result)
                (call $read_builtin (global.get $BUILTIN_EXACT_MINUS_SEP)))))
              (else (local.set $result (call $string_concat (local.get $result)
                (call $read_builtin (global.get $BUILTIN_EXACT_PLUS_SEP))))))))
        ;; |coefficient| — elided when 1 on a variable term.
        (if (call $expression_walk_guard (i32.const 96))
          (then (return (local.get $result))))
        (local.set $magnitude (call $bigint_abs_copy (local.get $coefficient)))
        (if (i32.or
              (i32.eqz (local.get $i))
              (i32.eqz (call $bigint_is_one (local.get $magnitude))))
          (then (local.set $result (call $string_concat (local.get $result)
            (call $bigint_to_decimal (local.get $magnitude))))))
        (if (i32.ge_s (local.get $i) (i32.const 1))
          (then
            (local.set $result (call $string_concat (local.get $result)
              (call $read_builtin (global.get $BUILTIN_EXACT_VARIABLE_X))))))
        (if (i32.ge_s (local.get $i) (i32.const 2))
          (then
            (local.set $result (call $string_concat (local.get $result)
              (call $read_builtin (global.get $BUILTIN_EXACT_CARET))))
            (if (call $expression_walk_guard (i32.const 96))
              (then (return (local.get $result))))
            (local.set $result (call $string_concat (local.get $result)
              (call $bigint_to_decimal (call $bigint_from_i64 (i64.extend_i32_s (local.get $i))))))))
        (local.set $i (i32.sub (local.get $i) (i32.const 1)))
        (br $terms)))
    (local.set $result (call $string_concat (local.get $result)
      (call $read_builtin (global.get $BUILTIN_EXACT_COMMA_SEP))))
    (local.set $result (call $string_concat (local.get $result)
      (call $read_builtin (global.get $BUILTIN_EXACT_OPEN_PAREN))))
    (local.set $result (call $string_concat (local.get $result)
      (call $rational_to_decimal (local.get $interval_data))))
    (local.set $result (call $string_concat (local.get $result)
      (call $read_builtin (global.get $BUILTIN_EXACT_COMMA_SEP))))
    (local.set $result (call $string_concat (local.get $result)
      (call $rational_to_decimal (i32.add (local.get $interval_data) (global.get $VALUE_SIZE)))))
    (local.set $result (call $string_concat (local.get $result)
      (call $read_builtin (global.get $BUILTIN_EXACT_CLOSE_PAREN))))
    (call $string_concat (local.get $result)
      (call $read_builtin (global.get $BUILTIN_EXACT_CLOSE_PAREN)))
  )

  ;; ==========================================================================
  ;; Ring 7c: sparse distributed multivariate polynomials.
  ;;
  ;; A polynomial is an inert committed-heap scratch record:
  ;;   [termCount:4][termCapacity:4][variableCount:4][termSize:4]
  ;; followed by lex-descending terms:
  ;;   [coefficient VALUE:16][exponent0:i32]...[exponentN:i32].
  ;; Coefficients span the complete exact real/complex tower. Scratch records
  ;; are deliberately unrooted: a pressure yield discards the entire
  ;; calculation, collection reclaims it, and the public method restarts from
  ;; its still-live arguments.
  ;; ==========================================================================

  (global $SPARSE_POLYNOMIAL_HEADER_SIZE i32 (i32.const 16))

  (func $sparse_coefficient_type (param $type i32) (result i32)
    (i32.or
      (call $exact_real_tower_type (local.get $type))
      (i32.or
        (i32.eq (local.get $type) (global.get $TYPE_COMPLEX))
        (i32.eq (local.get $type) (global.get $TYPE_COMPLEX_ALGEBRAIC)))))

  (func $sparse_polynomial_term_size (param $variable_count i32) (result i32)
    (local $term_size i64)
    (local.set $term_size
      (i64.add (i64.extend_i32_u (global.get $VALUE_SIZE))
        (i64.mul (i64.extend_i32_u (local.get $variable_count)) (i64.const 4))))
    (if (i64.gt_u (local.get $term_size) (i64.const 0xFFFFE8))
      (then
        (global.set $memory_pressure_signaled (i32.const 1))
        (return (i32.const 0))))
    (i32.wrap_i64 (local.get $term_size))
  )

  (func $sparse_polynomial_term (param $polynomial i32) (param $index i32) (result i32)
    (i32.add
      (i32.add (local.get $polynomial) (global.get $SPARSE_POLYNOMIAL_HEADER_SIZE))
      (i32.mul (local.get $index)
        (i32.load (call $abs (i32.add (local.get $polynomial) (i32.const 12)))))))

  (func $sparse_polynomial_allocate
    (param $capacity i32) (param $variable_count i32) (result i32)
    (local $payload_size i32)
    (local $payload_size_i64 i64)
    (local $polynomial i32)
    (local $term_size i32)
    (local.set $term_size
      (call $sparse_polynomial_term_size (local.get $variable_count)))
    (if (i32.eqz (local.get $term_size)) (then (return (i32.const 0))))
    (local.set $payload_size_i64
      (i64.add (i64.extend_i32_u (global.get $SPARSE_POLYNOMIAL_HEADER_SIZE))
        (i64.mul
          (i64.extend_i32_u (local.get $capacity))
          (i64.extend_i32_u (local.get $term_size)))))
    ;; A GC header has a 24-bit aligned-size field. Including its 8-byte
    ;; header, 0xFFFFE8 is the largest payload that still aligns below 2^24.
    (if (i64.gt_u (local.get $payload_size_i64) (i64.const 0xFFFFE8))
      (then
        (global.set $memory_pressure_signaled (i32.const 1))
        (return (i32.const 0))))
    (local.set $payload_size (i32.wrap_i64 (local.get $payload_size_i64)))
    (if (call $expression_walk_guard
          (i32.add (local.get $payload_size) (i32.const 32)))
      (then (return (i32.const 0))))
    (local.set $polynomial (call $carve_scratch_blob (local.get $payload_size)))
    (i32.store (call $abs (local.get $polynomial)) (i32.const 0))
    (i32.store (call $abs (i32.add (local.get $polynomial) (i32.const 4)))
      (local.get $capacity))
    (i32.store (call $abs (i32.add (local.get $polynomial) (i32.const 8)))
      (local.get $variable_count))
    (i32.store (call $abs (i32.add (local.get $polynomial) (i32.const 12)))
      (local.get $term_size))
    (local.get $polynomial)
  )

  ;; Lex comparison of exponent vectors. 1 left > right, -1 left < right.
  (func $sparse_monomial_compare
    (param $left i32) (param $right i32) (param $variable_count i32) (result i32)
    (local $index i32)
    (local $left_exponent i32)
    (local $right_exponent i32)
    (local.set $index (i32.const 0))
    (block $done
      (loop $compare
        (br_if $done (i32.ge_u (local.get $index) (local.get $variable_count)))
        (local.set $left_exponent (i32.load (call $abs
          (i32.add (local.get $left) (i32.mul (local.get $index) (i32.const 4))))))
        (local.set $right_exponent (i32.load (call $abs
          (i32.add (local.get $right) (i32.mul (local.get $index) (i32.const 4))))))
        (if (i32.gt_u (local.get $left_exponent) (local.get $right_exponent))
          (then (return (i32.const 1))))
        (if (i32.lt_u (local.get $left_exponent) (local.get $right_exponent))
          (then (return (i32.const -1))))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $compare)))
    (i32.const 0)
  )

  (func $sparse_monomial_divides
    (param $divisor i32) (param $dividend i32) (param $variable_count i32) (result i32)
    (local $index i32)
    (local.set $index (i32.const 0))
    (block $done
      (loop $scan
        (br_if $done (i32.ge_u (local.get $index) (local.get $variable_count)))
        (if (i32.gt_u
              (i32.load (call $abs
                (i32.add (local.get $divisor) (i32.mul (local.get $index) (i32.const 4)))))
              (i32.load (call $abs
                (i32.add (local.get $dividend) (i32.mul (local.get $index) (i32.const 4))))))
          (then (return (i32.const 0))))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $scan)))
    (i32.const 1)
  )

  (func $sparse_monomial_is_constant
    (param $exponents i32) (param $variable_count i32) (result i32)
    (local $index i32)
    (local.set $index (i32.const 0))
    (block $done
      (loop $scan
        (br_if $done (i32.ge_u (local.get $index) (local.get $variable_count)))
        (if (i32.load (call $abs
              (i32.add (local.get $exponents) (i32.mul (local.get $index) (i32.const 4)))))
          (then (return (i32.const 0))))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $scan)))
    (i32.const 1)
  )

  ;; Insert or combine one term while preserving descending lex order.
  ;; 0 ok / 1 pressure.
  (func $sparse_polynomial_add_term
    (param $polynomial i32) (param $coefficient i32) (param $exponents i32)
    (param $zero_slot i32) (result i32)
    (local $term_count i32)
    (local $capacity i32)
    (local $term_size i32)
    (local $index i32)
    (local $term i32)
    (local $comparison i32)
    (local $zero_comparison i32)
    (local $sum_slot i32)
    (local $status i32)
    (local.set $zero_comparison
      (call $complex_algebraic_equals_slots
        (local.get $coefficient) (local.get $zero_slot)))
    (if (i32.eq (local.get $zero_comparison) (i32.const -2))
      (then (return (i32.const 1))))
    (if (local.get $zero_comparison) (then (return (i32.const 0))))
    (local.set $term_count (i32.load (call $abs (local.get $polynomial))))
    (local.set $capacity
      (i32.load (call $abs (i32.add (local.get $polynomial) (i32.const 4)))))
    (local.set $term_size
      (i32.load (call $abs (i32.add (local.get $polynomial) (i32.const 12)))))
    (local.set $index (i32.const 0))
    (block $insertion_found
      (loop $scan
        (br_if $insertion_found (i32.ge_u (local.get $index) (local.get $term_count)))
        (local.set $term
          (call $sparse_polynomial_term (local.get $polynomial) (local.get $index)))
        (local.set $comparison (call $sparse_monomial_compare
          (local.get $exponents)
          (i32.add (local.get $term) (global.get $VALUE_SIZE))
          (i32.load (call $abs (i32.add (local.get $polynomial) (i32.const 8))))))
        (if (i32.eqz (local.get $comparison))
          (then
            (if (call $expression_walk_guard (i32.const 48))
              (then (return (i32.const 1))))
            (local.set $sum_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
            (local.set $status (call $complex_algebraic_slot_arith
              (i32.const 0) (local.get $term) (local.get $coefficient)
              (local.get $sum_slot)))
            (if (local.get $status) (then (return (i32.const 1))))
            (local.set $zero_comparison (call $complex_algebraic_equals_slots
              (local.get $sum_slot) (local.get $zero_slot)))
            (if (i32.eq (local.get $zero_comparison) (i32.const -2))
              (then (return (i32.const 1))))
            (if (local.get $zero_comparison)
              (then
                (memory.copy
                  (call $abs (local.get $term))
                  (call $abs (i32.add (local.get $term) (local.get $term_size)))
                  (i32.mul
                    (i32.sub
                      (i32.sub (local.get $term_count) (local.get $index))
                      (i32.const 1))
                    (local.get $term_size)))
                (i32.store (call $abs (local.get $polynomial))
                  (i32.sub (local.get $term_count) (i32.const 1))))
              (else
                (memory.copy (call $abs (local.get $term))
                  (call $abs (local.get $sum_slot)) (global.get $VALUE_SIZE))))
            (return (i32.const 0))))
        (br_if $insertion_found (i32.gt_s (local.get $comparison) (i32.const 0)))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $scan)))
    (if (i32.ge_u (local.get $term_count) (local.get $capacity))
      (then unreachable))
    (local.set $term
      (call $sparse_polynomial_term (local.get $polynomial) (local.get $index)))
    (memory.copy
      (call $abs (i32.add (local.get $term) (local.get $term_size)))
      (call $abs (local.get $term))
      (i32.mul (i32.sub (local.get $term_count) (local.get $index))
        (local.get $term_size)))
    (memory.copy (call $abs (local.get $term))
      (call $abs (local.get $coefficient)) (global.get $VALUE_SIZE))
    (memory.copy
      (call $abs (i32.add (local.get $term) (global.get $VALUE_SIZE)))
      (call $abs (local.get $exponents))
      (i32.mul
        (i32.load (call $abs (i32.add (local.get $polynomial) (i32.const 8))))
        (i32.const 4)))
    (i32.store (call $abs (local.get $polynomial))
      (i32.add (local.get $term_count) (i32.const 1)))
    (i32.const 0)
  )

  (func $sparse_polynomial_clone (param $source i32) (result i32)
    (local $term_count i32)
    (local $variable_count i32)
    (local $term_size i32)
    (local $result i32)
    (local.set $term_count (i32.load (call $abs (local.get $source))))
    (local.set $variable_count
      (i32.load (call $abs (i32.add (local.get $source) (i32.const 8)))))
    (local.set $term_size
      (i32.load (call $abs (i32.add (local.get $source) (i32.const 12)))))
    (local.set $result
      (call $sparse_polynomial_allocate (local.get $term_count) (local.get $variable_count)))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (i32.store (call $abs (local.get $result)) (local.get $term_count))
    (memory.copy
      (call $abs (i32.add (local.get $result) (global.get $SPARSE_POLYNOMIAL_HEADER_SIZE)))
      (call $abs (i32.add (local.get $source) (global.get $SPARSE_POLYNOMIAL_HEADER_SIZE)))
      (i32.mul (local.get $term_count) (local.get $term_size)))
    (local.get $result)
  )

  (func $sparse_polynomial_constant
    (param $coefficient i32) (param $variable_count i32) (param $zero_slot i32)
    (result i32)
    (local $result i32)
    (local $exponents i32)
    (local.set $result
      (call $sparse_polynomial_allocate (i32.const 1) (local.get $variable_count)))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (if (call $expression_walk_guard
          (i32.add (i32.mul (local.get $variable_count) (i32.const 4)) (i32.const 32)))
      (then (return (i32.const 0))))
    (local.set $exponents
      (call $carve_scratch_blob (i32.mul (local.get $variable_count) (i32.const 4))))
    (memory.fill (call $abs (local.get $exponents)) (i32.const 0)
      (i32.mul (local.get $variable_count) (i32.const 4)))
    (if (call $sparse_polynomial_add_term
          (local.get $result) (local.get $coefficient)
          (local.get $exponents) (local.get $zero_slot))
      (then (return (i32.const 0))))
    (local.get $result)
  )

  ;; base + scale * monomialShift * added.
  (func $sparse_polynomial_scaled_shift_sum
    (param $base i32) (param $added i32) (param $scale i32)
    (param $exponent_shift i32) (param $zero_slot i32) (result i32)
    (local $base_count i32)
    (local $added_count i32)
    (local $variable_count i32)
    (local $term_size i32)
    (local $result i32)
    (local $product_slot i32)
    (local $shifted_exponents i32)
    (local $added_term i32)
    (local $index i32)
    (local $variable_index i32)
    (local $status i32)
    (local $added_exponent i32)
    (local $shift_exponent i32)
    (local $exponent_sum i32)
    (local.set $base_count (i32.load (call $abs (local.get $base))))
    (local.set $added_count (i32.load (call $abs (local.get $added))))
    (local.set $variable_count
      (i32.load (call $abs (i32.add (local.get $base) (i32.const 8)))))
    (local.set $term_size
      (i32.load (call $abs (i32.add (local.get $base) (i32.const 12)))))
    (local.set $result (call $sparse_polynomial_allocate
      (i32.add (local.get $base_count) (local.get $added_count))
      (local.get $variable_count)))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (i32.store (call $abs (local.get $result)) (local.get $base_count))
    (memory.copy
      (call $abs (i32.add (local.get $result) (global.get $SPARSE_POLYNOMIAL_HEADER_SIZE)))
      (call $abs (i32.add (local.get $base) (global.get $SPARSE_POLYNOMIAL_HEADER_SIZE)))
      (i32.mul (local.get $base_count) (local.get $term_size)))
    (if (i32.eqz (local.get $added_count)) (then (return (local.get $result))))
    (if (call $expression_walk_guard
          (i32.add (global.get $VALUE_SIZE)
            (i32.add (i32.mul (local.get $variable_count) (i32.const 4))
              (i32.const 32))))
      (then (return (i32.const 0))))
    (local.set $product_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (local.set $shifted_exponents
      (call $carve_scratch_blob (i32.mul (local.get $variable_count) (i32.const 4))))
    (local.set $index (i32.const 0))
    (block $done
      (loop $terms
        (br_if $done (i32.ge_u (local.get $index) (local.get $added_count)))
        (local.set $added_term
          (call $sparse_polynomial_term (local.get $added) (local.get $index)))
        (local.set $status (call $complex_algebraic_slot_arith
          (i32.const 2) (local.get $scale) (local.get $added_term)
          (local.get $product_slot)))
        (if (local.get $status) (then (return (i32.const 0))))
        (local.set $variable_index (i32.const 0))
        (block $exponents_done
          (loop $exponents
            (br_if $exponents_done
              (i32.ge_u (local.get $variable_index) (local.get $variable_count)))
            (local.set $added_exponent
              (i32.load (call $abs
                (i32.add
                  (i32.add (local.get $added_term) (global.get $VALUE_SIZE))
                  (i32.mul (local.get $variable_index) (i32.const 4))))))
            (local.set $shift_exponent
              (i32.load (call $abs
                (i32.add (local.get $exponent_shift)
                  (i32.mul (local.get $variable_index) (i32.const 4))))))
            (local.set $exponent_sum
              (i32.add (local.get $added_exponent) (local.get $shift_exponent)))
            (if (i32.lt_u (local.get $exponent_sum) (local.get $added_exponent))
              (then (return (i32.const 2))))
            (i32.store
              (call $abs (i32.add (local.get $shifted_exponents)
                (i32.mul (local.get $variable_index) (i32.const 4))))
              (local.get $exponent_sum))
            (local.set $variable_index
              (i32.add (local.get $variable_index) (i32.const 1)))
            (br $exponents)))
        (if (call $sparse_polynomial_add_term
              (local.get $result) (local.get $product_slot)
              (local.get $shifted_exponents) (local.get $zero_slot))
          (then (return (i32.const 0))))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $terms)))
    (local.get $result)
  )

  (func $sparse_polynomial_add_subtract
    (param $left i32) (param $right i32) (param $subtract i32)
    (param $zero_slot i32) (param $one_slot i32) (result i32)
    (local $variable_count i32)
    (local $shift i32)
    (local $scale i32)
    (local $status i32)
    (local.set $variable_count
      (i32.load (call $abs (i32.add (local.get $left) (i32.const 8)))))
    (if (call $expression_walk_guard
          (i32.add (global.get $VALUE_SIZE)
            (i32.add (i32.mul (local.get $variable_count) (i32.const 4))
              (i32.const 32))))
      (then (return (i32.const 0))))
    (local.set $shift
      (call $carve_scratch_blob (i32.mul (local.get $variable_count) (i32.const 4))))
    (memory.fill (call $abs (local.get $shift)) (i32.const 0)
      (i32.mul (local.get $variable_count) (i32.const 4)))
    (if (local.get $subtract)
      (then
        (local.set $scale (call $carve_scratch_blob (global.get $VALUE_SIZE)))
        (local.set $status (call $complex_algebraic_slot_arith
          (i32.const 1) (local.get $zero_slot) (local.get $one_slot)
          (local.get $scale)))
        (if (local.get $status) (then (return (i32.const 0)))))
      (else (local.set $scale (local.get $one_slot))))
    (call $sparse_polynomial_scaled_shift_sum
      (local.get $left) (local.get $right) (local.get $scale)
      (local.get $shift) (local.get $zero_slot))
  )

  (func $sparse_polynomial_multiply
    (param $left i32) (param $right i32) (param $zero_slot i32) (result i32)
    (local $left_count i32)
    (local $right_count i32)
    (local $variable_count i32)
    (local $result i32)
    (local $product_slot i32)
    (local $product_exponents i32)
    (local $left_term i32)
    (local $right_term i32)
    (local $left_index i32)
    (local $right_index i32)
    (local $variable_index i32)
    (local $status i32)
    (local $left_exponent i32)
    (local $right_exponent i32)
    (local $exponent_sum i32)
    (local $capacity_i64 i64)
    (local.set $left_count (i32.load (call $abs (local.get $left))))
    (local.set $right_count (i32.load (call $abs (local.get $right))))
    (local.set $variable_count
      (i32.load (call $abs (i32.add (local.get $left) (i32.const 8)))))
    (local.set $capacity_i64
      (i64.mul
        (i64.extend_i32_u (local.get $left_count))
        (i64.extend_i32_u (local.get $right_count))))
    (if (i64.gt_u (local.get $capacity_i64) (i64.const 0xFFFFFFFF))
      (then
        (global.set $memory_pressure_signaled (i32.const 1))
        (return (i32.const 0))))
    (local.set $result (call $sparse_polynomial_allocate
      (i32.wrap_i64 (local.get $capacity_i64))
      (local.get $variable_count)))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (if (i32.or (i32.eqz (local.get $left_count)) (i32.eqz (local.get $right_count)))
      (then (return (local.get $result))))
    (if (call $expression_walk_guard
          (i32.add (global.get $VALUE_SIZE)
            (i32.add (i32.mul (local.get $variable_count) (i32.const 4))
              (i32.const 32))))
      (then (return (i32.const 0))))
    (local.set $product_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (local.set $product_exponents
      (call $carve_scratch_blob (i32.mul (local.get $variable_count) (i32.const 4))))
    (local.set $left_index (i32.const 0))
    (block $left_done
      (loop $left_terms
        (br_if $left_done (i32.ge_u (local.get $left_index) (local.get $left_count)))
        (local.set $left_term
          (call $sparse_polynomial_term (local.get $left) (local.get $left_index)))
        (local.set $right_index (i32.const 0))
        (block $right_done
          (loop $right_terms
            (br_if $right_done
              (i32.ge_u (local.get $right_index) (local.get $right_count)))
            (local.set $right_term
              (call $sparse_polynomial_term (local.get $right) (local.get $right_index)))
            (local.set $status (call $complex_algebraic_slot_arith
              (i32.const 2) (local.get $left_term) (local.get $right_term)
              (local.get $product_slot)))
            (if (local.get $status) (then (return (i32.const 0))))
            (local.set $variable_index (i32.const 0))
            (block $exponents_done
              (loop $exponents
                (br_if $exponents_done
                  (i32.ge_u (local.get $variable_index) (local.get $variable_count)))
                (local.set $left_exponent
                  (i32.load (call $abs
                    (i32.add
                      (i32.add (local.get $left_term) (global.get $VALUE_SIZE))
                      (i32.mul (local.get $variable_index) (i32.const 4))))))
                (local.set $right_exponent
                  (i32.load (call $abs
                    (i32.add
                      (i32.add (local.get $right_term) (global.get $VALUE_SIZE))
                      (i32.mul (local.get $variable_index) (i32.const 4))))))
                (local.set $exponent_sum
                  (i32.add (local.get $left_exponent) (local.get $right_exponent)))
                (if (i32.lt_u (local.get $exponent_sum) (local.get $left_exponent))
                  (then (return (i32.const 2))))
                (i32.store
                  (call $abs (i32.add (local.get $product_exponents)
                    (i32.mul (local.get $variable_index) (i32.const 4))))
                  (local.get $exponent_sum))
                (local.set $variable_index
                  (i32.add (local.get $variable_index) (i32.const 1)))
                (br $exponents)))
            (if (call $sparse_polynomial_add_term
                  (local.get $result) (local.get $product_slot)
                  (local.get $product_exponents) (local.get $zero_slot))
              (then (return (i32.const 0))))
            (local.set $right_index
              (i32.add (local.get $right_index) (i32.const 1)))
            (br $right_terms)))
        (local.set $left_index (i32.add (local.get $left_index) (i32.const 1)))
        (br $left_terms)))
    (local.get $result)
  )

  (func $sparse_polynomial_power
    (param $base i32) (param $exponent i32)
    (param $zero_slot i32) (param $one_slot i32) (result i32)
    (local $result i32)
    (local $factor i32)
    (local $remaining i32)
    (local.set $result (call $sparse_polynomial_constant
      (local.get $one_slot)
      (i32.load (call $abs (i32.add (local.get $base) (i32.const 8))))
      (local.get $zero_slot)))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (local.set $factor (local.get $base))
    (local.set $remaining (local.get $exponent))
    (block $done
      (loop $power
        (br_if $done (i32.eqz (local.get $remaining)))
        (if (i32.and (local.get $remaining) (i32.const 1))
          (then
            (local.set $result (call $sparse_polynomial_multiply
              (local.get $result) (local.get $factor) (local.get $zero_slot)))
            (if (i32.le_u (local.get $result) (i32.const 2))
              (then (return (local.get $result))))))
        (local.set $remaining (i32.shr_u (local.get $remaining) (i32.const 1)))
        (if (local.get $remaining)
          (then
            (local.set $factor (call $sparse_polynomial_multiply
              (local.get $factor) (local.get $factor) (local.get $zero_slot)))
            (if (i32.le_u (local.get $factor) (i32.const 2))
              (then (return (local.get $factor))))))
        (br $power)))
    (local.get $result)
  )

  ;; Parse an expression tree directly into the sparse form. Returns 0 on
  ;; pressure, 1 for a non-polynomial shape, 2 for exponent overflow, or a polynomial.
  (func $sparse_polynomial_from_expression
    (param $slot i32) (param $variables_data i32) (param $variable_count i32)
    (param $zero_slot i32) (param $one_slot i32) (result i32)
    (local $type i32)
    (local $symbol i32)
    (local $variable_index i32)
    (local $result i32)
    (local $exponents i32)
    (local $header i32)
    (local $head i32)
    (local $args_array i32)
    (local $argument_count i32)
    (local $arguments_data i32)
    (local $left i32)
    (local $right i32)
    (local $index i32)
    (local $exponent i64)
    (local $divisor_term i32)
    (local $term_count i32)
    (local $quotient i32)
    (local $term i32)
    (local $quotient_slot i32)
    (local $status i32)
    (local.set $type (call $value_type (local.get $slot)))
    (if (call $sparse_coefficient_type (local.get $type))
      (then
        (return (call $sparse_polynomial_constant
          (local.get $slot) (local.get $variable_count) (local.get $zero_slot)))))
    (if (i32.eq (local.get $type) (global.get $TYPE_SYMBOL))
      (then
        (local.set $symbol (call $value_data_lo (local.get $slot)))
        (local.set $variable_index (i32.const 0))
        (block $variable_found
          (loop $variables
            (br_if $variable_found
              (i32.ge_u (local.get $variable_index) (local.get $variable_count)))
            (br_if $variable_found
              (i32.eq
                (call $value_data_lo
                  (i32.add (local.get $variables_data)
                    (i32.mul (local.get $variable_index) (global.get $VALUE_SIZE))))
                (local.get $symbol)))
            (local.set $variable_index
              (i32.add (local.get $variable_index) (i32.const 1)))
            (br $variables)))
        (if (i32.ge_u (local.get $variable_index) (local.get $variable_count))
          (then (return (i32.const 1))))
        (local.set $result
          (call $sparse_polynomial_allocate (i32.const 1) (local.get $variable_count)))
        (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
        (if (call $expression_walk_guard
              (i32.add (i32.mul (local.get $variable_count) (i32.const 4))
                (i32.const 32)))
          (then (return (i32.const 0))))
        (local.set $exponents
          (call $carve_scratch_blob (i32.mul (local.get $variable_count) (i32.const 4))))
        (memory.fill (call $abs (local.get $exponents)) (i32.const 0)
          (i32.mul (local.get $variable_count) (i32.const 4)))
        (i32.store
          (call $abs (i32.add (local.get $exponents)
            (i32.mul (local.get $variable_index) (i32.const 4))))
          (i32.const 1))
        (if (call $sparse_polynomial_add_term
              (local.get $result) (local.get $one_slot)
              (local.get $exponents) (local.get $zero_slot))
          (then (return (i32.const 0))))
        (return (local.get $result))))
    (if (i32.ne (local.get $type) (global.get $TYPE_EXPRESSION))
      (then (return (i32.const 1))))
    (local.set $header (call $value_data_lo (local.get $slot)))
    (local.set $head (call $expression_head (local.get $header)))
    (local.set $args_array (call $expression_args (local.get $header)))
    (local.set $argument_count
      (i32.load (call $abs (i32.add (local.get $args_array) (i32.const 8)))))
    (local.set $arguments_data (i32.add
      (i32.load (call $abs (i32.add (local.get $args_array) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    ;; Add and Multiply admit their canonical n-ary forms.
    (if (i32.eq (local.get $head) (call $symbol_registry_lookup
          (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_ADD))))
      (then
        (local.set $result
          (call $sparse_polynomial_allocate (i32.const 0) (local.get $variable_count)))
        (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
        (local.set $index (i32.const 0))
        (block $add_done
          (loop $add
            (br_if $add_done (i32.ge_u (local.get $index) (local.get $argument_count)))
            (local.set $right (call $sparse_polynomial_from_expression
              (i32.add (local.get $arguments_data)
                (i32.mul (local.get $index) (global.get $VALUE_SIZE)))
              (local.get $variables_data) (local.get $variable_count)
              (local.get $zero_slot) (local.get $one_slot)))
            (if (i32.le_u (local.get $right) (i32.const 2))
              (then (return (local.get $right))))
            (local.set $result (call $sparse_polynomial_add_subtract
              (local.get $result) (local.get $right) (i32.const 0)
              (local.get $zero_slot) (local.get $one_slot)))
            (if (i32.le_u (local.get $result) (i32.const 2))
              (then (return (local.get $result))))
            (local.set $index (i32.add (local.get $index) (i32.const 1)))
            (br $add)))
        (return (local.get $result))))
    (if (i32.eq (local.get $head) (call $symbol_registry_lookup
          (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY))))
      (then
        (local.set $result (call $sparse_polynomial_constant
          (local.get $one_slot) (local.get $variable_count) (local.get $zero_slot)))
        (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
        (local.set $index (i32.const 0))
        (block $multiply_done
          (loop $multiply
            (br_if $multiply_done
              (i32.ge_u (local.get $index) (local.get $argument_count)))
            (local.set $right (call $sparse_polynomial_from_expression
              (i32.add (local.get $arguments_data)
                (i32.mul (local.get $index) (global.get $VALUE_SIZE)))
              (local.get $variables_data) (local.get $variable_count)
              (local.get $zero_slot) (local.get $one_slot)))
            (if (i32.le_u (local.get $right) (i32.const 2))
              (then (return (local.get $right))))
            (local.set $result (call $sparse_polynomial_multiply
              (local.get $result) (local.get $right) (local.get $zero_slot)))
            (if (i32.le_u (local.get $result) (i32.const 2))
              (then (return (local.get $result))))
            (local.set $index (i32.add (local.get $index) (i32.const 1)))
            (br $multiply)))
        (return (local.get $result))))
    ;; Binary Subtract.
    (if (i32.eq (local.get $head) (call $symbol_registry_lookup
          (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_SUBTRACT))))
      (then
        (if (i32.ne (local.get $argument_count) (i32.const 2))
          (then (return (i32.const 1))))
        (local.set $left (call $sparse_polynomial_from_expression
          (local.get $arguments_data)
          (local.get $variables_data) (local.get $variable_count)
          (local.get $zero_slot) (local.get $one_slot)))
        (if (i32.le_u (local.get $left) (i32.const 2))
          (then (return (local.get $left))))
        (local.set $right (call $sparse_polynomial_from_expression
          (i32.add (local.get $arguments_data) (global.get $VALUE_SIZE))
          (local.get $variables_data) (local.get $variable_count)
          (local.get $zero_slot) (local.get $one_slot)))
        (if (i32.le_u (local.get $right) (i32.const 2))
          (then (return (local.get $right))))
        (return (call $sparse_polynomial_add_subtract
          (local.get $left) (local.get $right) (i32.const 1)
          (local.get $zero_slot) (local.get $one_slot)))))
    ;; Unary Negate.
    (if (i32.eq (local.get $head) (call $symbol_registry_lookup
          (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_NEGATE))))
      (then
        (if (i32.ne (local.get $argument_count) (i32.const 1))
          (then (return (i32.const 1))))
        (local.set $right (call $sparse_polynomial_from_expression
          (local.get $arguments_data)
          (local.get $variables_data) (local.get $variable_count)
          (local.get $zero_slot) (local.get $one_slot)))
        (if (i32.le_u (local.get $right) (i32.const 2))
          (then (return (local.get $right))))
        (local.set $left
          (call $sparse_polynomial_allocate (i32.const 0) (local.get $variable_count)))
        (if (i32.eqz (local.get $left)) (then (return (i32.const 0))))
        (return (call $sparse_polynomial_add_subtract
          (local.get $left) (local.get $right) (i32.const 1)
          (local.get $zero_slot) (local.get $one_slot)))))
    ;; Divide is polynomial only when its divisor is a nonzero constant.
    (if (i32.eq (local.get $head) (call $symbol_registry_lookup
          (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_DIVIDE))))
      (then
        (if (i32.ne (local.get $argument_count) (i32.const 2))
          (then (return (i32.const 1))))
        (local.set $left (call $sparse_polynomial_from_expression
          (local.get $arguments_data)
          (local.get $variables_data) (local.get $variable_count)
          (local.get $zero_slot) (local.get $one_slot)))
        (if (i32.le_u (local.get $left) (i32.const 2))
          (then (return (local.get $left))))
        (local.set $right (call $sparse_polynomial_from_expression
          (i32.add (local.get $arguments_data) (global.get $VALUE_SIZE))
          (local.get $variables_data) (local.get $variable_count)
          (local.get $zero_slot) (local.get $one_slot)))
        (if (i32.le_u (local.get $right) (i32.const 2))
          (then (return (local.get $right))))
        (if (i32.ne (i32.load (call $abs (local.get $right))) (i32.const 1))
          (then (return (i32.const 1))))
        (local.set $divisor_term
          (call $sparse_polynomial_term (local.get $right) (i32.const 0)))
        (if (i32.eqz (call $sparse_monomial_is_constant
              (i32.add (local.get $divisor_term) (global.get $VALUE_SIZE))
              (local.get $variable_count)))
          (then (return (i32.const 1))))
        (local.set $term_count (i32.load (call $abs (local.get $left))))
        (local.set $result
          (call $sparse_polynomial_allocate (local.get $term_count) (local.get $variable_count)))
        (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
        (if (call $expression_walk_guard (i32.const 48))
          (then (return (i32.const 0))))
        (local.set $quotient_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
        (local.set $index (i32.const 0))
        (block $divide_done
          (loop $divide
            (br_if $divide_done (i32.ge_u (local.get $index) (local.get $term_count)))
            (local.set $term
              (call $sparse_polynomial_term (local.get $left) (local.get $index)))
            (local.set $status (call $complex_algebraic_slot_arith
              (i32.const 3) (local.get $term) (local.get $divisor_term)
              (local.get $quotient_slot)))
            (if (local.get $status) (then (return (i32.const 0))))
            (if (call $sparse_polynomial_add_term
                  (local.get $result) (local.get $quotient_slot)
                  (i32.add (local.get $term) (global.get $VALUE_SIZE))
                  (local.get $zero_slot))
              (then (return (i32.const 0))))
            (local.set $index (i32.add (local.get $index) (i32.const 1)))
            (br $divide)))
        (return (local.get $result))))
    ;; Power requires a non-negative integer exponent that fits the unsigned
    ;; exponent-vector cells.
    (if (i32.eq (local.get $head) (call $symbol_registry_lookup
          (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_POWER))))
      (then
        (if (i32.ne (local.get $argument_count) (i32.const 2))
          (then (return (i32.const 1))))
        (if (i32.eqz (call $exponent_slot_to_i64
              (i32.add (local.get $arguments_data) (global.get $VALUE_SIZE))))
          (then (return (i32.const 1))))
        (local.set $exponent (global.get $bigint_to_i64_value))
        (if (i64.lt_s (local.get $exponent) (i64.const 0))
          (then (return (i32.const 1))))
        (if (i64.gt_u (local.get $exponent) (i64.const 4294967295))
          (then (return (i32.const 2))))
        (local.set $left (call $sparse_polynomial_from_expression
          (local.get $arguments_data)
          (local.get $variables_data) (local.get $variable_count)
          (local.get $zero_slot) (local.get $one_slot)))
        (if (i32.le_u (local.get $left) (i32.const 2))
          (then (return (local.get $left))))
        (return (call $sparse_polynomial_power
          (local.get $left) (i32.wrap_i64 (local.get $exponent))
          (local.get $zero_slot) (local.get $one_slot)))))
    (i32.const 1)
  )

  (func $sparse_polynomial_monic
    (param $polynomial i32) (result i32)
    (local $term_count i32)
    (local $variable_count i32)
    (local $term_size i32)
    (local $leading_term i32)
    (local $result i32)
    (local $source_term i32)
    (local $destination_term i32)
    (local $quotient_slot i32)
    (local $index i32)
    (local $status i32)
    (local.set $term_count (i32.load (call $abs (local.get $polynomial))))
    (if (i32.eqz (local.get $term_count))
      (then (return (call $sparse_polynomial_clone (local.get $polynomial)))))
    (local.set $variable_count
      (i32.load (call $abs (i32.add (local.get $polynomial) (i32.const 8)))))
    (local.set $term_size
      (i32.load (call $abs (i32.add (local.get $polynomial) (i32.const 12)))))
    (local.set $leading_term
      (call $sparse_polynomial_term (local.get $polynomial) (i32.const 0)))
    (local.set $result
      (call $sparse_polynomial_allocate (local.get $term_count) (local.get $variable_count)))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (if (call $expression_walk_guard (i32.const 48))
      (then (return (i32.const 0))))
    (local.set $quotient_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (local.set $index (i32.const 0))
    (block $done
      (loop $terms
        (br_if $done (i32.ge_u (local.get $index) (local.get $term_count)))
        (local.set $source_term
          (call $sparse_polynomial_term (local.get $polynomial) (local.get $index)))
        (local.set $destination_term
          (call $sparse_polynomial_term (local.get $result) (local.get $index)))
        (local.set $status (call $complex_algebraic_slot_arith
          (i32.const 3) (local.get $source_term) (local.get $leading_term)
          (local.get $quotient_slot)))
        (if (local.get $status) (then (return (i32.const 0))))
        (memory.copy (call $abs (local.get $destination_term))
          (call $abs (local.get $quotient_slot)) (global.get $VALUE_SIZE))
        (memory.copy
          (call $abs (i32.add (local.get $destination_term) (global.get $VALUE_SIZE)))
          (call $abs (i32.add (local.get $source_term) (global.get $VALUE_SIZE)))
          (i32.sub (local.get $term_size) (global.get $VALUE_SIZE)))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $terms)))
    (i32.store (call $abs (local.get $result)) (local.get $term_count))
    (local.get $result)
  )

  ;; Scratch basis record: [count:4][polynomialPointer0:4]...
  (func $sparse_basis_empty (result i32)
    (local $basis i32)
    (if (call $expression_walk_guard (i32.const 36))
      (then (return (i32.const 0))))
    (local.set $basis (call $carve_scratch_blob (i32.const 4)))
    (i32.store (call $abs (local.get $basis)) (i32.const 0))
    (local.get $basis)
  )

  (func $sparse_basis_append
    (param $basis i32) (param $polynomial i32) (result i32)
    (local $count i32)
    (local $result i32)
    (local $payload_size i32)
    (local.set $count (i32.load (call $abs (local.get $basis))))
    (local.set $payload_size
      (i32.add (i32.const 4)
        (i32.mul (i32.add (local.get $count) (i32.const 1)) (i32.const 4))))
    (if (call $expression_walk_guard
          (i32.add (local.get $payload_size) (i32.const 32)))
      (then (return (i32.const 0))))
    (local.set $result (call $carve_scratch_blob (local.get $payload_size)))
    (i32.store (call $abs (local.get $result))
      (i32.add (local.get $count) (i32.const 1)))
    (memory.copy
      (call $abs (i32.add (local.get $result) (i32.const 4)))
      (call $abs (i32.add (local.get $basis) (i32.const 4)))
      (i32.mul (local.get $count) (i32.const 4)))
    (i32.store
      (call $abs (i32.add
        (i32.add (local.get $result) (i32.const 4))
        (i32.mul (local.get $count) (i32.const 4))))
      (local.get $polynomial))
    (local.get $result)
  )

  (func $sparse_basis_polynomial
    (param $basis i32) (param $index i32) (result i32)
    (i32.load (call $abs
      (i32.add (i32.add (local.get $basis) (i32.const 4))
        (i32.mul (local.get $index) (i32.const 4))))))

  ;; Multivariate normal form by exact field division. The Buchberger
  ;; S-polynomial path below is fraction-free (cross-multiplied leading
  ;; coefficients); division remains here because a public normal form must
  ;; preserve its exact scalar, not merely ideal membership up to content.
  (func $sparse_polynomial_normal_form
    (param $polynomial i32) (param $basis i32)
    (param $zero_slot i32) (result i32)
    (local $work i32)
    (local $remainder i32)
    (local $basis_count i32)
    (local $work_count i32)
    (local $remainder_count i32)
    (local $work_leading i32)
    (local $divisor i32)
    (local $divisor_leading i32)
    (local $basis_index i32)
    (local $reducer_found i32)
    (local $variable_count i32)
    (local $term_size i32)
    (local $shift i32)
    (local $quotient_slot i32)
    (local $negative_quotient_slot i32)
    (local $new_remainder i32)
    (local $destination_term i32)
    (local $variable_index i32)
    (local $status i32)
    (local.set $work (call $sparse_polynomial_clone (local.get $polynomial)))
    (if (i32.eqz (local.get $work)) (then (return (i32.const 0))))
    (local.set $variable_count
      (i32.load (call $abs (i32.add (local.get $polynomial) (i32.const 8)))))
    (local.set $term_size
      (i32.load (call $abs (i32.add (local.get $polynomial) (i32.const 12)))))
    (local.set $remainder
      (call $sparse_polynomial_allocate (i32.const 0) (local.get $variable_count)))
    (if (i32.eqz (local.get $remainder)) (then (return (i32.const 0))))
    (if (call $expression_walk_guard
          (i32.add (i32.mul (local.get $variable_count) (i32.const 4))
            (i32.add (i32.mul (i32.const 2) (global.get $VALUE_SIZE))
              (i32.const 32))))
      (then (return (i32.const 0))))
    (local.set $shift
      (call $carve_scratch_blob (i32.mul (local.get $variable_count) (i32.const 4))))
    (local.set $quotient_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (local.set $negative_quotient_slot
      (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (block $done
      (loop $reduce
        (local.set $work_count (i32.load (call $abs (local.get $work))))
        (br_if $done (i32.eqz (local.get $work_count)))
        (local.set $work_leading
          (call $sparse_polynomial_term (local.get $work) (i32.const 0)))
        (local.set $basis_count (i32.load (call $abs (local.get $basis))))
        (local.set $basis_index (i32.const 0))
        (local.set $reducer_found (i32.const 0))
        (block $reducer_scan_done
          (loop $reducer_scan
            (br_if $reducer_scan_done
              (i32.ge_u (local.get $basis_index) (local.get $basis_count)))
            (local.set $divisor (call $sparse_basis_polynomial
              (local.get $basis) (local.get $basis_index)))
            (if (i32.load (call $abs (local.get $divisor)))
              (then
                (local.set $divisor_leading
                  (call $sparse_polynomial_term (local.get $divisor) (i32.const 0)))
                (if (call $sparse_monomial_divides
                      (i32.add (local.get $divisor_leading) (global.get $VALUE_SIZE))
                      (i32.add (local.get $work_leading) (global.get $VALUE_SIZE))
                      (local.get $variable_count))
                  (then
                    (local.set $reducer_found (i32.const 1))
                    (br $reducer_scan_done)))))
            (local.set $basis_index
              (i32.add (local.get $basis_index) (i32.const 1)))
            (br $reducer_scan)))
        (if (local.get $reducer_found)
          (then
            (local.set $status (call $complex_algebraic_slot_arith
              (i32.const 3) (local.get $work_leading) (local.get $divisor_leading)
              (local.get $quotient_slot)))
            (if (local.get $status) (then (return (i32.const 0))))
            (local.set $status (call $complex_algebraic_slot_arith
              (i32.const 1) (local.get $zero_slot) (local.get $quotient_slot)
              (local.get $negative_quotient_slot)))
            (if (local.get $status) (then (return (i32.const 0))))
            (local.set $variable_index (i32.const 0))
            (block $shift_done
              (loop $shift_loop
                (br_if $shift_done
                  (i32.ge_u (local.get $variable_index) (local.get $variable_count)))
                (i32.store
                  (call $abs (i32.add (local.get $shift)
                    (i32.mul (local.get $variable_index) (i32.const 4))))
                  (i32.sub
                    (i32.load (call $abs
                      (i32.add
                        (i32.add (local.get $work_leading) (global.get $VALUE_SIZE))
                        (i32.mul (local.get $variable_index) (i32.const 4)))))
                    (i32.load (call $abs
                      (i32.add
                        (i32.add (local.get $divisor_leading) (global.get $VALUE_SIZE))
                        (i32.mul (local.get $variable_index) (i32.const 4)))))))
                (local.set $variable_index
                  (i32.add (local.get $variable_index) (i32.const 1)))
                (br $shift_loop)))
            (local.set $work (call $sparse_polynomial_scaled_shift_sum
              (local.get $work) (local.get $divisor)
              (local.get $negative_quotient_slot) (local.get $shift)
              (local.get $zero_slot)))
            (if (i32.le_u (local.get $work) (i32.const 2))
              (then (return (local.get $work)))))
          (else
            ;; No leading monomial divides: move the leading term to the
            ;; remainder and remove it from work.
            (local.set $remainder_count
              (i32.load (call $abs (local.get $remainder))))
            (local.set $new_remainder (call $sparse_polynomial_allocate
              (i32.add (local.get $remainder_count) (i32.const 1))
              (local.get $variable_count)))
            (if (i32.eqz (local.get $new_remainder))
              (then (return (i32.const 0))))
            (i32.store (call $abs (local.get $new_remainder))
              (local.get $remainder_count))
            (memory.copy
              (call $abs (i32.add (local.get $new_remainder)
                (global.get $SPARSE_POLYNOMIAL_HEADER_SIZE)))
              (call $abs (i32.add (local.get $remainder)
                (global.get $SPARSE_POLYNOMIAL_HEADER_SIZE)))
              (i32.mul (local.get $remainder_count) (local.get $term_size)))
            (if (call $sparse_polynomial_add_term
                  (local.get $new_remainder) (local.get $work_leading)
                  (i32.add (local.get $work_leading) (global.get $VALUE_SIZE))
                  (local.get $zero_slot))
              (then (return (i32.const 0))))
            (local.set $remainder (local.get $new_remainder))
            (memory.copy
              (call $abs (local.get $work_leading))
              (call $abs (i32.add (local.get $work_leading) (local.get $term_size)))
              (i32.mul (i32.sub (local.get $work_count) (i32.const 1))
                (local.get $term_size)))
            (i32.store (call $abs (local.get $work))
              (i32.sub (local.get $work_count) (i32.const 1)))))
        (br $reduce)))
    (local.get $remainder)
  )

  (func $sparse_leading_monomials_coprime
    (param $left i32) (param $right i32) (param $variable_count i32) (result i32)
    (local $index i32)
    (local.set $index (i32.const 0))
    (block $done
      (loop $scan
        (br_if $done (i32.ge_u (local.get $index) (local.get $variable_count)))
        (if (i32.and
              (i32.ne (i32.load (call $abs
                (i32.add (local.get $left)
                  (i32.mul (local.get $index) (i32.const 4))))) (i32.const 0))
              (i32.ne (i32.load (call $abs
                (i32.add (local.get $right)
                  (i32.mul (local.get $index) (i32.const 4))))) (i32.const 0)))
          (then (return (i32.const 0))))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $scan)))
    (i32.const 1)
  )

  ;; Fraction-free S-polynomial:
  ;; lc(right) * L/lm(left) * left - lc(left) * L/lm(right) * right.
  (func $sparse_s_polynomial
    (param $left i32) (param $right i32)
    (param $zero_slot i32) (result i32)
    (local $variable_count i32)
    (local $left_leading i32)
    (local $right_leading i32)
    (local $left_shift i32)
    (local $right_shift i32)
    (local $empty i32)
    (local $result i32)
    (local $negative_left_coefficient i32)
    (local $index i32)
    (local $left_exponent i32)
    (local $right_exponent i32)
    (local $least_common_multiple i32)
    (local $status i32)
    (local.set $variable_count
      (i32.load (call $abs (i32.add (local.get $left) (i32.const 8)))))
    (local.set $left_leading
      (call $sparse_polynomial_term (local.get $left) (i32.const 0)))
    (local.set $right_leading
      (call $sparse_polynomial_term (local.get $right) (i32.const 0)))
    (if (call $expression_walk_guard
          (i32.add (global.get $VALUE_SIZE)
            (i32.add (i32.mul (i32.mul (local.get $variable_count) (i32.const 2))
              (i32.const 4)) (i32.const 32))))
      (then (return (i32.const 0))))
    (local.set $left_shift
      (call $carve_scratch_blob (i32.mul (local.get $variable_count) (i32.const 4))))
    (local.set $right_shift
      (call $carve_scratch_blob (i32.mul (local.get $variable_count) (i32.const 4))))
    (local.set $negative_left_coefficient
      (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (local.set $index (i32.const 0))
    (block $shifts_done
      (loop $shifts
        (br_if $shifts_done
          (i32.ge_u (local.get $index) (local.get $variable_count)))
        (local.set $left_exponent (i32.load (call $abs
          (i32.add
            (i32.add (local.get $left_leading) (global.get $VALUE_SIZE))
            (i32.mul (local.get $index) (i32.const 4))))))
        (local.set $right_exponent (i32.load (call $abs
          (i32.add
            (i32.add (local.get $right_leading) (global.get $VALUE_SIZE))
            (i32.mul (local.get $index) (i32.const 4))))))
        (local.set $least_common_multiple
          (select (local.get $left_exponent) (local.get $right_exponent)
            (i32.gt_u (local.get $left_exponent) (local.get $right_exponent))))
        (i32.store
          (call $abs (i32.add (local.get $left_shift)
            (i32.mul (local.get $index) (i32.const 4))))
          (i32.sub (local.get $least_common_multiple) (local.get $left_exponent)))
        (i32.store
          (call $abs (i32.add (local.get $right_shift)
            (i32.mul (local.get $index) (i32.const 4))))
          (i32.sub (local.get $least_common_multiple) (local.get $right_exponent)))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $shifts)))
    (local.set $status (call $complex_algebraic_slot_arith
      (i32.const 1) (local.get $zero_slot) (local.get $left_leading)
      (local.get $negative_left_coefficient)))
    (if (local.get $status) (then (return (i32.const 0))))
    (local.set $empty
      (call $sparse_polynomial_allocate (i32.const 0) (local.get $variable_count)))
    (if (i32.eqz (local.get $empty)) (then (return (i32.const 0))))
    (local.set $result (call $sparse_polynomial_scaled_shift_sum
      (local.get $empty) (local.get $left) (local.get $right_leading)
      (local.get $left_shift) (local.get $zero_slot)))
    (if (i32.le_u (local.get $result) (i32.const 2))
      (then (return (local.get $result))))
    (call $sparse_polynomial_scaled_shift_sum
      (local.get $result) (local.get $right) (local.get $negative_left_coefficient)
      (local.get $right_shift) (local.get $zero_slot))
  )

  ;; Processed-zero pair records: [count:4][left:4,right:4]...
  (func $sparse_zero_pairs_empty (result i32)
    (local $records i32)
    (if (call $expression_walk_guard (i32.const 36))
      (then (return (i32.const 0))))
    (local.set $records (call $carve_scratch_blob (i32.const 4)))
    (i32.store (call $abs (local.get $records)) (i32.const 0))
    (local.get $records)
  )

  (func $sparse_zero_pairs_append
    (param $records i32) (param $left i32) (param $right i32) (result i32)
    (local $count i32)
    (local $result i32)
    (local $payload_size i32)
    (local $small i32)
    (local $large i32)
    (local.set $count (i32.load (call $abs (local.get $records))))
    (local.set $payload_size
      (i32.add (i32.const 4)
        (i32.mul (i32.add (local.get $count) (i32.const 1)) (i32.const 8))))
    (if (call $expression_walk_guard
          (i32.add (local.get $payload_size) (i32.const 32)))
      (then (return (i32.const 0))))
    (local.set $result (call $carve_scratch_blob (local.get $payload_size)))
    (local.set $small
      (select (local.get $left) (local.get $right)
        (i32.lt_u (local.get $left) (local.get $right))))
    (local.set $large
      (select (local.get $right) (local.get $left)
        (i32.lt_u (local.get $left) (local.get $right))))
    (i32.store (call $abs (local.get $result))
      (i32.add (local.get $count) (i32.const 1)))
    (memory.copy
      (call $abs (i32.add (local.get $result) (i32.const 4)))
      (call $abs (i32.add (local.get $records) (i32.const 4)))
      (i32.mul (local.get $count) (i32.const 8)))
    (i32.store (call $abs
      (i32.add (i32.add (local.get $result) (i32.const 4))
        (i32.mul (local.get $count) (i32.const 8)))) (local.get $small))
    (i32.store (call $abs
      (i32.add
        (i32.add (i32.add (local.get $result) (i32.const 4))
          (i32.mul (local.get $count) (i32.const 8)))
        (i32.const 4))) (local.get $large))
    (local.get $result)
  )

  (func $sparse_zero_pairs_contains
    (param $records i32) (param $left i32) (param $right i32) (result i32)
    (local $count i32)
    (local $small i32)
    (local $large i32)
    (local $index i32)
    (local $record i32)
    (local.set $count (i32.load (call $abs (local.get $records))))
    (local.set $small
      (select (local.get $left) (local.get $right)
        (i32.lt_u (local.get $left) (local.get $right))))
    (local.set $large
      (select (local.get $right) (local.get $left)
        (i32.lt_u (local.get $left) (local.get $right))))
    (local.set $index (i32.const 0))
    (block $done
      (loop $scan
        (br_if $done (i32.ge_u (local.get $index) (local.get $count)))
        (local.set $record
          (i32.add (i32.add (local.get $records) (i32.const 4))
            (i32.mul (local.get $index) (i32.const 8))))
        (if (i32.and
              (i32.eq (i32.load (call $abs (local.get $record))) (local.get $small))
              (i32.eq (i32.load (call $abs (i32.add (local.get $record) (i32.const 4))))
                (local.get $large)))
          (then (return (i32.const 1))))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $scan)))
    (i32.const 0)
  )

  ;; Buchberger chain criterion: some k has leading(k) dividing the least common
  ;; multiple of leading(i) and leading(j), with both smaller pairs already zero.
  (func $sparse_chain_criterion
    (param $basis i32) (param $zero_pairs i32)
    (param $left_index i32) (param $right_index i32)
    (param $variable_count i32) (result i32)
    (local $left i32)
    (local $right i32)
    (local $left_leading i32)
    (local $right_leading i32)
    (local $candidate i32)
    (local $candidate_leading i32)
    (local $least_common_multiple i32)
    (local $basis_count i32)
    (local $index i32)
    (local $variable_index i32)
    (local $left_exponent i32)
    (local $right_exponent i32)
    (local.set $left (call $sparse_basis_polynomial
      (local.get $basis) (local.get $left_index)))
    (local.set $right (call $sparse_basis_polynomial
      (local.get $basis) (local.get $right_index)))
    (local.set $left_leading
      (call $sparse_polynomial_term (local.get $left) (i32.const 0)))
    (local.set $right_leading
      (call $sparse_polynomial_term (local.get $right) (i32.const 0)))
    (if (call $expression_walk_guard
          (i32.add (i32.mul (local.get $variable_count) (i32.const 4))
            (i32.const 32)))
      (then (return (i32.const -1))))
    (local.set $least_common_multiple
      (call $carve_scratch_blob (i32.mul (local.get $variable_count) (i32.const 4))))
    (local.set $variable_index (i32.const 0))
    (block $least_common_multiple_done
      (loop $least_common_multiple_loop
        (br_if $least_common_multiple_done
          (i32.ge_u (local.get $variable_index) (local.get $variable_count)))
        (local.set $left_exponent (i32.load (call $abs
          (i32.add
            (i32.add (local.get $left_leading) (global.get $VALUE_SIZE))
            (i32.mul (local.get $variable_index) (i32.const 4))))))
        (local.set $right_exponent (i32.load (call $abs
          (i32.add
            (i32.add (local.get $right_leading) (global.get $VALUE_SIZE))
            (i32.mul (local.get $variable_index) (i32.const 4))))))
        (i32.store
          (call $abs (i32.add (local.get $least_common_multiple)
            (i32.mul (local.get $variable_index) (i32.const 4))))
          (select (local.get $left_exponent) (local.get $right_exponent)
            (i32.gt_u (local.get $left_exponent) (local.get $right_exponent))))
        (local.set $variable_index
          (i32.add (local.get $variable_index) (i32.const 1)))
        (br $least_common_multiple_loop)))
    (local.set $basis_count (i32.load (call $abs (local.get $basis))))
    (local.set $index (i32.const 0))
    (block $done
      (loop $scan
        (br_if $done (i32.ge_u (local.get $index) (local.get $basis_count)))
        (if (i32.and
              (i32.ne (local.get $index) (local.get $left_index))
              (i32.ne (local.get $index) (local.get $right_index)))
          (then
            (local.set $candidate (call $sparse_basis_polynomial
              (local.get $basis) (local.get $index)))
            (local.set $candidate_leading
              (call $sparse_polynomial_term (local.get $candidate) (i32.const 0)))
            (if (i32.and
                  (call $sparse_monomial_divides
                    (i32.add (local.get $candidate_leading) (global.get $VALUE_SIZE))
                    (local.get $least_common_multiple) (local.get $variable_count))
                  (i32.and
                    (call $sparse_zero_pairs_contains
                      (local.get $zero_pairs) (local.get $left_index) (local.get $index))
                    (call $sparse_zero_pairs_contains
                      (local.get $zero_pairs) (local.get $index) (local.get $right_index))))
              (then (return (i32.const 1))))))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $scan)))
    (i32.const 0)
  )

  (func $sparse_buchberger
    (param $basis i32) (param $variable_count i32)
    (param $zero_slot i32) (result i32)
    (local $zero_pairs i32)
    (local $left_index i32)
    (local $right_index i32)
    (local $basis_count i32)
    (local $left i32)
    (local $right i32)
    (local $left_leading i32)
    (local $right_leading i32)
    (local $criterion i32)
    (local $s_polynomial i32)
    (local $remainder i32)
    (local.set $zero_pairs (call $sparse_zero_pairs_empty))
    (if (i32.eqz (local.get $zero_pairs)) (then (return (i32.const 0))))
    (local.set $right_index (i32.const 1))
    (local.set $left_index (i32.const 0))
    (block $done
      (loop $pairs
        (local.set $basis_count (i32.load (call $abs (local.get $basis))))
        (br_if $done (i32.ge_u (local.get $right_index) (local.get $basis_count)))
        (if (i32.ge_u (local.get $left_index) (local.get $right_index))
          (then
            (local.set $right_index
              (i32.add (local.get $right_index) (i32.const 1)))
            (local.set $left_index (i32.const 0))
            (br $pairs)))
        (local.set $left (call $sparse_basis_polynomial
          (local.get $basis) (local.get $left_index)))
        (local.set $right (call $sparse_basis_polynomial
          (local.get $basis) (local.get $right_index)))
        (local.set $left_leading
          (call $sparse_polynomial_term (local.get $left) (i32.const 0)))
        (local.set $right_leading
          (call $sparse_polynomial_term (local.get $right) (i32.const 0)))
        (if (call $sparse_leading_monomials_coprime
              (i32.add (local.get $left_leading) (global.get $VALUE_SIZE))
              (i32.add (local.get $right_leading) (global.get $VALUE_SIZE))
              (local.get $variable_count))
          (then
            (local.set $zero_pairs (call $sparse_zero_pairs_append
              (local.get $zero_pairs) (local.get $left_index) (local.get $right_index)))
            (if (i32.eqz (local.get $zero_pairs)) (then (return (i32.const 0)))))
          (else
            (local.set $criterion (call $sparse_chain_criterion
              (local.get $basis) (local.get $zero_pairs)
              (local.get $left_index) (local.get $right_index)
              (local.get $variable_count)))
            (if (i32.eq (local.get $criterion) (i32.const -1))
              (then (return (i32.const 0))))
            (if (local.get $criterion)
              (then
                (local.set $zero_pairs (call $sparse_zero_pairs_append
                  (local.get $zero_pairs) (local.get $left_index) (local.get $right_index)))
                (if (i32.eqz (local.get $zero_pairs))
                  (then (return (i32.const 0)))))
              (else
                (local.set $s_polynomial (call $sparse_s_polynomial
                  (local.get $left) (local.get $right) (local.get $zero_slot)))
                (if (i32.le_u (local.get $s_polynomial) (i32.const 2))
                  (then (return (local.get $s_polynomial))))
                (local.set $remainder (call $sparse_polynomial_normal_form
                  (local.get $s_polynomial) (local.get $basis) (local.get $zero_slot)))
                (if (i32.le_u (local.get $remainder) (i32.const 2))
                  (then (return (local.get $remainder))))
                (if (i32.eqz (i32.load (call $abs (local.get $remainder))))
                  (then
                    (local.set $zero_pairs (call $sparse_zero_pairs_append
                      (local.get $zero_pairs)
                      (local.get $left_index) (local.get $right_index)))
                    (if (i32.eqz (local.get $zero_pairs))
                      (then (return (i32.const 0)))))
                  (else
                    (local.set $remainder
                      (call $sparse_polynomial_monic (local.get $remainder)))
                    (if (i32.eqz (local.get $remainder))
                      (then (return (i32.const 0))))
                    (local.set $basis (call $sparse_basis_append
                      (local.get $basis) (local.get $remainder)))
                    (if (i32.eqz (local.get $basis))
                      (then (return (i32.const 0))))))))))
        (local.set $left_index
          (i32.add (local.get $left_index) (i32.const 1)))
        (br $pairs)))
    (local.get $basis)
  )

  (func $sparse_interreduce_basis
    (param $basis i32) (param $variable_count i32)
    (param $zero_slot i32) (result i32)
    (local $basis_count i32)
    (local $minimal_basis i32)
    (local $reduced_basis i32)
    (local $other_basis i32)
    (local $polynomial i32)
    (local $other i32)
    (local $leading i32)
    (local $other_leading i32)
    (local $remainder i32)
    (local $drop i32)
    (local $comparison i32)
    (local $index i32)
    (local $other_index i32)
    (local $swap i32)
    (local.set $basis_count (i32.load (call $abs (local.get $basis))))
    (local.set $minimal_basis (call $sparse_basis_empty))
    (if (i32.eqz (local.get $minimal_basis)) (then (return (i32.const 0))))
    ;; Remove leading monomials divisible by another leading monomial.
    (local.set $index (i32.const 0))
    (block $minimal_done
      (loop $minimal
        (br_if $minimal_done (i32.ge_u (local.get $index) (local.get $basis_count)))
        (local.set $polynomial
          (call $sparse_basis_polynomial (local.get $basis) (local.get $index)))
        (local.set $leading
          (call $sparse_polynomial_term (local.get $polynomial) (i32.const 0)))
        (local.set $drop (i32.const 0))
        (local.set $other_index (i32.const 0))
        (block $divisor_scan_done
          (loop $divisor_scan
            (br_if $divisor_scan_done
              (i32.ge_u (local.get $other_index) (local.get $basis_count)))
            (if (i32.ne (local.get $other_index) (local.get $index))
              (then
                (local.set $other (call $sparse_basis_polynomial
                  (local.get $basis) (local.get $other_index)))
                (local.set $other_leading
                  (call $sparse_polynomial_term (local.get $other) (i32.const 0)))
                (if (call $sparse_monomial_divides
                      (i32.add (local.get $other_leading) (global.get $VALUE_SIZE))
                      (i32.add (local.get $leading) (global.get $VALUE_SIZE))
                      (local.get $variable_count))
                  (then
                    (local.set $comparison (call $sparse_monomial_compare
                      (i32.add (local.get $other_leading) (global.get $VALUE_SIZE))
                      (i32.add (local.get $leading) (global.get $VALUE_SIZE))
                      (local.get $variable_count)))
                    (if (i32.or
                          (local.get $comparison)
                          (i32.lt_u (local.get $other_index) (local.get $index)))
                      (then
                        (local.set $drop (i32.const 1))
                        (br $divisor_scan_done)))))))
            (local.set $other_index
              (i32.add (local.get $other_index) (i32.const 1)))
            (br $divisor_scan)))
        (if (i32.eqz (local.get $drop))
          (then
            (local.set $minimal_basis (call $sparse_basis_append
              (local.get $minimal_basis) (local.get $polynomial)))
            (if (i32.eqz (local.get $minimal_basis))
              (then (return (i32.const 0))))))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $minimal)))
    ;; Reduce each surviving polynomial by all the others and make it monic.
    (local.set $basis_count (i32.load (call $abs (local.get $minimal_basis))))
    (local.set $reduced_basis (call $sparse_basis_empty))
    (if (i32.eqz (local.get $reduced_basis)) (then (return (i32.const 0))))
    (local.set $index (i32.const 0))
    (block $reduce_done
      (loop $reduce
        (br_if $reduce_done (i32.ge_u (local.get $index) (local.get $basis_count)))
        (local.set $other_basis (call $sparse_basis_empty))
        (if (i32.eqz (local.get $other_basis)) (then (return (i32.const 0))))
        (local.set $other_index (i32.const 0))
        (block $others_done
          (loop $others
            (br_if $others_done
              (i32.ge_u (local.get $other_index) (local.get $basis_count)))
            (if (i32.ne (local.get $other_index) (local.get $index))
              (then
                (local.set $other_basis (call $sparse_basis_append
                  (local.get $other_basis)
                  (call $sparse_basis_polynomial
                    (local.get $minimal_basis) (local.get $other_index))))
                (if (i32.eqz (local.get $other_basis))
                  (then (return (i32.const 0))))))
            (local.set $other_index
              (i32.add (local.get $other_index) (i32.const 1)))
            (br $others)))
        (local.set $remainder (call $sparse_polynomial_normal_form
          (call $sparse_basis_polynomial (local.get $minimal_basis) (local.get $index))
          (local.get $other_basis) (local.get $zero_slot)))
        (if (i32.le_u (local.get $remainder) (i32.const 2))
          (then (return (local.get $remainder))))
        (if (i32.load (call $abs (local.get $remainder)))
          (then
            (local.set $remainder
              (call $sparse_polynomial_monic (local.get $remainder)))
            (if (i32.eqz (local.get $remainder)) (then (return (i32.const 0))))
            (local.set $reduced_basis (call $sparse_basis_append
              (local.get $reduced_basis) (local.get $remainder)))
            (if (i32.eqz (local.get $reduced_basis))
              (then (return (i32.const 0))))))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $reduce)))
    ;; Canonical output order: descending leading monomial.
    (local.set $basis_count (i32.load (call $abs (local.get $reduced_basis))))
    (local.set $index (i32.const 0))
    (block $sort_done
      (loop $sort_outer
        (br_if $sort_done (i32.ge_u (local.get $index) (local.get $basis_count)))
        (local.set $other_index
          (i32.add (local.get $index) (i32.const 1)))
        (block $sort_inner_done
          (loop $sort_inner
            (br_if $sort_inner_done
              (i32.ge_u (local.get $other_index) (local.get $basis_count)))
            (local.set $polynomial (call $sparse_basis_polynomial
              (local.get $reduced_basis) (local.get $index)))
            (local.set $other (call $sparse_basis_polynomial
              (local.get $reduced_basis) (local.get $other_index)))
            (local.set $comparison (call $sparse_monomial_compare
              (i32.add
                (call $sparse_polynomial_term (local.get $other) (i32.const 0))
                (global.get $VALUE_SIZE))
              (i32.add
                (call $sparse_polynomial_term (local.get $polynomial) (i32.const 0))
                (global.get $VALUE_SIZE))
              (local.get $variable_count)))
            (if (i32.gt_s (local.get $comparison) (i32.const 0))
              (then
                (local.set $swap (local.get $polynomial))
                (i32.store (call $abs
                  (i32.add (i32.add (local.get $reduced_basis) (i32.const 4))
                    (i32.mul (local.get $index) (i32.const 4))))
                  (local.get $other))
                (i32.store (call $abs
                  (i32.add (i32.add (local.get $reduced_basis) (i32.const 4))
                    (i32.mul (local.get $other_index) (i32.const 4))))
                  (local.get $swap))))
            (local.set $other_index
              (i32.add (local.get $other_index) (i32.const 1)))
            (br $sort_inner)))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $sort_outer)))
    (local.get $reduced_basis)
  )

  (func $sparse_groebner_basis
    (param $basis i32) (param $variable_count i32)
    (param $zero_slot i32) (result i32)
    (local $polynomial i32)
    (local $term i32)
    (local $constant_basis i32)
    (local $count i32)
    (local $index i32)
    ;; Any nonzero constant generates the whole ring.
    (local.set $count (i32.load (call $abs (local.get $basis))))
    (local.set $index (i32.const 0))
    (block $constant_scan_done
      (loop $constant_scan
        (br_if $constant_scan_done (i32.ge_u (local.get $index) (local.get $count)))
        (local.set $polynomial
          (call $sparse_basis_polynomial (local.get $basis) (local.get $index)))
        (if (i32.eq (i32.load (call $abs (local.get $polynomial))) (i32.const 1))
          (then
            (local.set $term
              (call $sparse_polynomial_term (local.get $polynomial) (i32.const 0)))
            (if (call $sparse_monomial_is_constant
                  (i32.add (local.get $term) (global.get $VALUE_SIZE))
                  (local.get $variable_count))
              (then
                (local.set $polynomial
                  (call $sparse_polynomial_monic (local.get $polynomial)))
                (if (i32.eqz (local.get $polynomial))
                  (then (return (i32.const 0))))
                (local.set $constant_basis (call $sparse_basis_empty))
                (if (i32.eqz (local.get $constant_basis))
                  (then (return (i32.const 0))))
                (return (call $sparse_basis_append
                  (local.get $constant_basis) (local.get $polynomial)))))))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $constant_scan)))
    (if (i32.le_u (local.get $count) (i32.const 1))
      (then (return (call $sparse_interreduce_basis
        (local.get $basis) (local.get $variable_count) (local.get $zero_slot)))))
    (local.set $basis (call $sparse_buchberger
      (local.get $basis) (local.get $variable_count) (local.get $zero_slot)))
    (if (i32.le_u (local.get $basis) (i32.const 2))
      (then (return (local.get $basis))))
    (call $sparse_interreduce_basis
      (local.get $basis) (local.get $variable_count) (local.get $zero_slot))
  )

  (func $sparse_expression_binary
    (param $head_builtin i32) (param $left i32) (param $right i32)
    (param $out_slot i32) (result i32)
    (if (call $expression_walk_guard (i32.const 256))
      (then (return (i32.const 1))))
    (call $write_value (local.get $out_slot)
      (global.get $TYPE_EXPRESSION) (i32.const 0)
      (call $expression_build
        (call $symbol_registry_lookup (call $read_builtin (local.get $head_builtin)))
        (call $expression_alloc_args2 (local.get $left) (local.get $right)))
      (i32.const 0))
    (select (i32.const 1) (i32.const 0) (global.get $memory_pressure_signaled))
  )

  (func $sparse_polynomial_to_expression
    (param $polynomial i32) (param $variables_data i32)
    (param $zero_slot i32) (param $out_slot i32) (result i32)
    (local $term_count i32)
    (local $variable_count i32)
    (local $term i32)
    (local $work i32)
    (local $term_slot i32)
    (local $factor_slot i32)
    (local $exponent_slot i32)
    (local $sum_slot i32)
    (local $temporary_slot i32)
    (local $term_index i32)
    (local $variable_index i32)
    (local $exponent i32)
    (local $status i32)
    (local.set $term_count (i32.load (call $abs (local.get $polynomial))))
    (local.set $variable_count
      (i32.load (call $abs (i32.add (local.get $polynomial) (i32.const 8)))))
    (if (i32.eqz (local.get $term_count))
      (then
        (memory.copy (call $abs (local.get $out_slot))
          (call $abs (local.get $zero_slot)) (global.get $VALUE_SIZE))
        (return (i32.const 0))))
    (if (call $expression_walk_guard
          (i32.add (i32.mul (i32.const 5) (global.get $VALUE_SIZE))
            (i32.const 32)))
      (then (return (i32.const 1))))
    (local.set $work
      (call $carve_scratch_blob (i32.mul (i32.const 5) (global.get $VALUE_SIZE))))
    (local.set $term_slot (local.get $work))
    (local.set $factor_slot (i32.add (local.get $work) (global.get $VALUE_SIZE)))
    (local.set $exponent_slot
      (i32.add (local.get $factor_slot) (global.get $VALUE_SIZE)))
    (local.set $sum_slot
      (i32.add (local.get $exponent_slot) (global.get $VALUE_SIZE)))
    (local.set $temporary_slot
      (i32.add (local.get $sum_slot) (global.get $VALUE_SIZE)))
    (local.set $term_index (i32.const 0))
    (block $terms_done
      (loop $terms
        (br_if $terms_done (i32.ge_u (local.get $term_index) (local.get $term_count)))
        (local.set $term
          (call $sparse_polynomial_term (local.get $polynomial) (local.get $term_index)))
        (memory.copy (call $abs (local.get $term_slot))
          (call $abs (local.get $term)) (global.get $VALUE_SIZE))
        (local.set $variable_index (i32.const 0))
        (block $variables_done
          (loop $variables
            (br_if $variables_done
              (i32.ge_u (local.get $variable_index) (local.get $variable_count)))
            (local.set $exponent (i32.load (call $abs
              (i32.add
                (i32.add (local.get $term) (global.get $VALUE_SIZE))
                (i32.mul (local.get $variable_index) (i32.const 4))))))
            (if (local.get $exponent)
              (then
                (if (i32.eq (local.get $exponent) (i32.const 1))
                  (then
                    (memory.copy (call $abs (local.get $factor_slot))
                      (call $abs (i32.add (local.get $variables_data)
                        (i32.mul (local.get $variable_index) (global.get $VALUE_SIZE))))
                      (global.get $VALUE_SIZE)))
                  (else
                    (call $write_inline_rational
                      (local.get $exponent_slot) (i64.extend_i32_u (local.get $exponent)))
                    (local.set $status (call $sparse_expression_binary
                      (global.get $BUILTIN_EXPRESSION_HEAD_POWER)
                      (i32.add (local.get $variables_data)
                        (i32.mul (local.get $variable_index) (global.get $VALUE_SIZE)))
                      (local.get $exponent_slot) (local.get $factor_slot)))
                    (if (local.get $status) (then (return (i32.const 1))))))
                (local.set $status (call $sparse_expression_binary
                  (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
                  (local.get $term_slot) (local.get $factor_slot)
                  (local.get $temporary_slot)))
                (if (local.get $status) (then (return (i32.const 1))))
                (memory.copy (call $abs (local.get $term_slot))
                  (call $abs (local.get $temporary_slot)) (global.get $VALUE_SIZE))))
            (local.set $variable_index
              (i32.add (local.get $variable_index) (i32.const 1)))
            (br $variables)))
        (if (i32.eqz (local.get $term_index))
          (then
            (memory.copy (call $abs (local.get $sum_slot))
              (call $abs (local.get $term_slot)) (global.get $VALUE_SIZE)))
          (else
            (local.set $status (call $sparse_expression_binary
              (global.get $BUILTIN_EXPRESSION_HEAD_ADD)
              (local.get $sum_slot) (local.get $term_slot)
              (local.get $temporary_slot)))
            (if (local.get $status) (then (return (i32.const 1))))
            (memory.copy (call $abs (local.get $sum_slot))
              (call $abs (local.get $temporary_slot)) (global.get $VALUE_SIZE))))
        (local.set $term_index
          (i32.add (local.get $term_index) (i32.const 1)))
        (br $terms)))
    (call $expression_simplify_into (local.get $sum_slot) (local.get $out_slot))
  )

  (func $expression_groebner_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $argument2_pointer i32)
    (local $argument3_pointer i32)
    (local $basis_array_slot i32)
    (local $variables_array_slot i32)
    (local $target_slot i32)
    (local $basis_array i32)
    (local $basis_length i32)
    (local $basis_data i32)
    (local $variables_array i32)
    (local $variable_count i32)
    (local $variables_data i32)
    (local $basis i32)
    (local $polynomial i32)
    (local $normal_form i32)
    (local $zero_slot i32)
    (local $one_slot i32)
    (local $work i32)
    (local $result_array i32)
    (local $result_data i32)
    (local $basis_count i32)
    (local $index i32)
    (local $other_index i32)
    (local $type_error_status i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer
          (i32.sub (local.get $pending_pointer)
            (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))))
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then
        (local.set $argument2_pointer
          (i32.add (local.get $argument1_pointer) (global.get $VALUE_SIZE)))))
    (if (i32.ge_u (local.get $argc) (i32.const 3))
      (then
        (local.set $argument3_pointer
          (i32.add (local.get $argument2_pointer) (global.get $VALUE_SIZE)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (i32.eq (local.get $method_id)
          (global.get $METHOD_EXACT_EXPRESSION_GROEBNER_BASIS))
      (then
        (if (i32.ne (local.get $argc) (i32.const 2))
          (then
            (if (call $throw_type_error)
              (then (return (i32.const 2)))
              (else (return (i32.const 1))))))
        (local.set $basis_array_slot (local.get $argument1_pointer))
        (local.set $variables_array_slot (local.get $argument2_pointer)))
      (else
        (if (i32.ne (local.get $argc) (i32.const 3))
          (then
            (if (call $throw_type_error)
              (then (return (i32.const 2)))
              (else (return (i32.const 1))))))
        (local.set $target_slot (local.get $argument1_pointer))
        (local.set $basis_array_slot (local.get $argument2_pointer))
        (local.set $variables_array_slot (local.get $argument3_pointer))))
    (if (i32.or
          (i32.ne (call $value_type (local.get $basis_array_slot)) (global.get $TYPE_ARRAY))
          (i32.ne (call $value_type (local.get $variables_array_slot)) (global.get $TYPE_ARRAY)))
      (then
        (if (call $throw_type_error)
          (then (return (i32.const 2)))
          (else (return (i32.const 1))))))
    (local.set $basis_array (call $value_data_lo (local.get $basis_array_slot)))
    (local.set $basis_length
      (i32.load (call $abs (i32.add (local.get $basis_array) (i32.const 8)))))
    (local.set $basis_data (i32.add
      (i32.load (call $abs (i32.add (local.get $basis_array) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (local.set $variables_array
      (call $value_data_lo (local.get $variables_array_slot)))
    (local.set $variable_count
      (i32.load (call $abs (i32.add (local.get $variables_array) (i32.const 8)))))
    (local.set $variables_data (i32.add
      (i32.load (call $abs (i32.add (local.get $variables_array) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    ;; Variables must be distinct Symbols.
    (local.set $index (i32.const 0))
    (block $variables_validated
      (loop $validate_variables
        (br_if $variables_validated
          (i32.ge_u (local.get $index) (local.get $variable_count)))
        (if (i32.ne
              (call $value_type
                (i32.add (local.get $variables_data)
                  (i32.mul (local.get $index) (global.get $VALUE_SIZE))))
              (global.get $TYPE_SYMBOL))
          (then
            (if (call $throw_type_error)
              (then (return (i32.const 2)))
              (else (return (i32.const 1))))))
        (local.set $other_index (i32.const 0))
        (block $duplicates_done
          (loop $duplicates
            (br_if $duplicates_done
              (i32.ge_u (local.get $other_index) (local.get $index)))
            (if (i32.eq
                  (call $value_data_lo
                    (i32.add (local.get $variables_data)
                      (i32.mul (local.get $index) (global.get $VALUE_SIZE))))
                  (call $value_data_lo
                    (i32.add (local.get $variables_data)
                      (i32.mul (local.get $other_index) (global.get $VALUE_SIZE)))))
              (then
                (if (call $throw_type_error)
                  (then (return (i32.const 2)))
                  (else (return (i32.const 1))))))
            (local.set $other_index
              (i32.add (local.get $other_index) (i32.const 1)))
            (br $duplicates)))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $validate_variables)))
    (if (call $expression_walk_guard
          (i32.add (i32.mul (i32.const 2) (global.get $VALUE_SIZE))
            (i32.const 32)))
      (then (return (i32.const 0))))
    (local.set $work
      (call $carve_scratch_blob (i32.mul (i32.const 2) (global.get $VALUE_SIZE))))
    (local.set $zero_slot (local.get $work))
    (local.set $one_slot (i32.add (local.get $work) (global.get $VALUE_SIZE)))
    (call $write_inline_rational (local.get $zero_slot) (i64.const 0))
    (call $write_inline_rational (local.get $one_slot) (i64.const 1))
    (local.set $basis (call $sparse_basis_empty))
    (if (i32.eqz (local.get $basis)) (then (return (i32.const 0))))
    (local.set $index (i32.const 0))
    (block $basis_built
      (loop $build_basis
        (br_if $basis_built (i32.ge_u (local.get $index) (local.get $basis_length)))
        (local.set $polynomial (call $sparse_polynomial_from_expression
          (i32.add (local.get $basis_data)
            (i32.mul (local.get $index) (global.get $VALUE_SIZE)))
          (local.get $variables_data) (local.get $variable_count)
          (local.get $zero_slot) (local.get $one_slot)))
        (if (i32.eqz (local.get $polynomial)) (then (return (i32.const 0))))
        (if (i32.eq (local.get $polynomial) (i32.const 2))
          (then
            (if (call $throw_range_error_with_message
                  (global.get $BUILTIN_MSG_GROEBNER_EXPONENT_RANGE))
              (then (return (i32.const 2)))
              (else (return (i32.const 1))))))
        (if (i32.eq (local.get $polynomial) (i32.const 1))
          (then
            (if (call $throw_type_error)
              (then (return (i32.const 2)))
              (else (return (i32.const 1))))))
        (if (i32.load (call $abs (local.get $polynomial)))
          (then
            (local.set $polynomial
              (call $sparse_polynomial_monic (local.get $polynomial)))
            (if (i32.eqz (local.get $polynomial)) (then (return (i32.const 0))))
            (local.set $basis
              (call $sparse_basis_append (local.get $basis) (local.get $polynomial)))
            (if (i32.eqz (local.get $basis)) (then (return (i32.const 0))))))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $build_basis)))
    (local.set $basis (call $sparse_groebner_basis
      (local.get $basis) (local.get $variable_count) (local.get $zero_slot)))
    (if (i32.eqz (local.get $basis)) (then (return (i32.const 0))))
    (if (i32.eq (local.get $basis) (i32.const 2))
      (then
        (if (call $throw_range_error_with_message
              (global.get $BUILTIN_MSG_GROEBNER_EXPONENT_RANGE))
          (then (return (i32.const 2)))
          (else (return (i32.const 1))))))
    (if (i32.eq (local.get $method_id)
          (global.get $METHOD_EXACT_EXPRESSION_POLYNOMIAL_REDUCE))
      (then
        (local.set $polynomial (call $sparse_polynomial_from_expression
          (local.get $target_slot)
          (local.get $variables_data) (local.get $variable_count)
          (local.get $zero_slot) (local.get $one_slot)))
        (if (i32.eqz (local.get $polynomial)) (then (return (i32.const 0))))
        (if (i32.eq (local.get $polynomial) (i32.const 2))
          (then
            (if (call $throw_range_error_with_message
                  (global.get $BUILTIN_MSG_GROEBNER_EXPONENT_RANGE))
              (then (return (i32.const 2)))
              (else (return (i32.const 1))))))
        (if (i32.eq (local.get $polynomial) (i32.const 1))
          (then
            (if (call $throw_type_error)
              (then (return (i32.const 2)))
              (else (return (i32.const 1))))))
        (local.set $normal_form (call $sparse_polynomial_normal_form
          (local.get $polynomial) (local.get $basis) (local.get $zero_slot)))
        (if (i32.eqz (local.get $normal_form)) (then (return (i32.const 0))))
        (if (i32.eq (local.get $normal_form) (i32.const 2))
          (then
            (if (call $throw_range_error_with_message
                  (global.get $BUILTIN_MSG_GROEBNER_EXPONENT_RANGE))
              (then (return (i32.const 2)))
              (else (return (i32.const 1))))))
        (if (call $expression_walk_guard
              (i32.add (global.get $VALUE_SIZE) (i32.const 32)))
          (then (return (i32.const 0))))
        (local.set $work (call $carve_scratch_blob (global.get $VALUE_SIZE)))
        (if (call $sparse_polynomial_to_expression
              (local.get $normal_form) (local.get $variables_data)
              (local.get $zero_slot) (local.get $work))
          (then (return (i32.const 0))))
        (call $pending_push
          (call $value_type (local.get $work))
          (call $value_flags (local.get $work))
          (call $value_data_lo (local.get $work))
          (call $value_data_hi (local.get $work)))
        (return (i32.const 0))))
    (local.set $basis_count (i32.load (call $abs (local.get $basis))))
    (if (call $expression_walk_guard
          (i32.add (call $estimate_array_size (local.get $basis_count))
            (i32.const 64)))
      (then (return (i32.const 0))))
    (local.set $result_array (call $allocate_array (local.get $basis_count)))
    (local.set $result_data (i32.add
      (i32.load (call $abs (i32.add (local.get $result_array) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (local.set $index (i32.const 0))
    (block $output_done
      (loop $output
        (br_if $output_done (i32.ge_u (local.get $index) (local.get $basis_count)))
        (if (call $sparse_polynomial_to_expression
              (call $sparse_basis_polynomial (local.get $basis) (local.get $index))
              (local.get $variables_data) (local.get $zero_slot)
              (i32.add (local.get $result_data)
                (i32.mul (local.get $index) (global.get $VALUE_SIZE))))
          (then (return (i32.const 0))))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $output)))
