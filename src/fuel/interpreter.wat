        (if (i32.ge_s (local.get $found) (local.get $arr_len))
          (then (local.set $found (local.get $arr_len))))))
    (local.set $i (i32.const 0))
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then
        (if (call $value_is_numeric (local.get $argument2_pointer))
          (then (local.set $i (i32.trunc_sat_f64_s (call $value_to_f64 (local.get $argument2_pointer))))))
        (if (i32.lt_s (local.get $i) (i32.const 0))
          (then
            (local.set $i (i32.add (local.get $arr_len) (local.get $i)))
            (if (i32.lt_s (local.get $i) (i32.const 0))
              (then (local.set $i (i32.const 0))))))
        (if (i32.ge_s (local.get $i) (local.get $arr_len))
          (then (local.set $i (local.get $arr_len))))))
    (local.set $end_idx (local.get $arr_len))
    (if (i32.ge_u (local.get $argc) (i32.const 3))
      (then
        (if (call $value_is_numeric (local.get $argument3_pointer))
          (then (local.set $end_idx (i32.trunc_sat_f64_s (call $value_to_f64 (local.get $argument3_pointer))))))
        (if (i32.lt_s (local.get $end_idx) (i32.const 0))
          (then
            (local.set $end_idx (i32.add (local.get $arr_len) (local.get $end_idx)))
            (if (i32.lt_s (local.get $end_idx) (i32.const 0))
              (then (local.set $end_idx (i32.const 0))))))
        (if (i32.ge_s (local.get $end_idx) (local.get $arr_len))
          (then (local.set $end_idx (local.get $arr_len))))))
    (local.set $slice_len (i32.sub (local.get $end_idx) (local.get $i)))
    (if (i32.lt_s (local.get $slice_len) (i32.const 0))
      (then (local.set $slice_len (i32.const 0))))
    (if (i32.gt_s (i32.add (local.get $found) (local.get $slice_len)) (local.get $arr_len))
      (then (local.set $slice_len (i32.sub (local.get $arr_len) (local.get $found)))))
    (local.set $source_pointer (call $abs (i32.add (i32.add (local.get $data_pointer) (i32.const 4)) (local.get $start_idx))))
    (if (i32.lt_s (local.get $found) (local.get $i))
      (then
        (local.set $j (i32.const 0))
        (block $copy_done
          (loop $copy_loop
            (br_if $copy_done (i32.ge_u (local.get $j) (local.get $slice_len)))
            (local.set $result_f64 (call $read_typed_element
              (local.get $receiver_type)
              (i32.add (local.get $source_pointer) (i32.mul (i32.add (local.get $i) (local.get $j)) (local.get $bytes_per_element)))))
            (call $write_typed_element
              (local.get $receiver_type)
              (i32.add (local.get $source_pointer) (i32.mul (i32.add (local.get $found) (local.get $j)) (local.get $bytes_per_element)))
              (local.get $result_f64))
            (local.set $j (i32.add (local.get $j) (i32.const 1)))
            (br $copy_loop))))
      (else
        (local.set $j (i32.sub (local.get $slice_len) (i32.const 1)))
        (block $copy_done
          (loop $copy_loop
            (br_if $copy_done (i32.lt_s (local.get $j) (i32.const 0)))
            (local.set $result_f64 (call $read_typed_element
              (local.get $receiver_type)
              (i32.add (local.get $source_pointer) (i32.mul (i32.add (local.get $i) (local.get $j)) (local.get $bytes_per_element)))))
            (call $write_typed_element
              (local.get $receiver_type)
              (i32.add (local.get $source_pointer) (i32.mul (i32.add (local.get $found) (local.get $j)) (local.get $bytes_per_element)))
              (local.get $result_f64))
            (local.set $j (i32.sub (local.get $j) (i32.const 1)))
            (br $copy_loop)))))
    (call $pending_push
      (local.get $receiver_type) (i32.const 0) (local.get $receiver_pointer) (i32.const 0))
    (i32.const 0)
  )

  (func $typed_array_join
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $arg1_type i32)
    (local $arg1_lo i32)
    (local $data_pointer i32)
    (local $start_idx i32)
    (local $arr_len i32)
    (local $bytes_per_element i32)
    (local $separator_id i32)
    (local $scratch_base i32)
    (local $source_pointer i32)
    (local $result_f64 f64)
    (local $new_arr i32)
    (local $i i32)
    (local $dest i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $arg1_type (call $value_type (local.get $argument1_pointer)))
        (local.set $arg1_lo (call $value_data_lo (local.get $argument1_pointer)))))
    (local.set $data_pointer (i32.load (call $abs (local.get $receiver_pointer))))
    (local.set $start_idx (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 4)))))
    (local.set $arr_len (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 8)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (local.set $bytes_per_element (call $get_bytes_per_element (local.get $receiver_type)))
    (if (i32.and
          (i32.ge_u (local.get $argc) (i32.const 1))
          (i32.eq (local.get $arg1_type) (global.get $TYPE_STRING)))
      (then
        (local.set $separator_id (local.get $arg1_lo)))
      (else
        ;; Default "," — 1-byte scratch stage + intern, the same pattern
        ;; as $array_to_string. intern_string dedups, so the cost
        ;; amortizes to a hash lookup after the first call.
        (local.set $scratch_base (call $scratch_ptr (i32.const 0) (i32.const 1)))
        (i32.store8 (local.get $scratch_base) (i32.const 44)) ;; ','
        (local.set $separator_id (call $intern_string (local.get $scratch_base) (i32.const 1)))
        (if (global.get $memory_pressure_signaled)
          (then (return (i32.const 0))))))
    (local.set $source_pointer (call $abs (i32.add (i32.add (local.get $data_pointer) (i32.const 4)) (local.get $start_idx))))
    (if (i32.eqz (local.get $arr_len))
      (then
        (call $pending_push (global.get $TYPE_STRING) (i32.const 0)
          (call $read_builtin (global.get $BUILTIN_LIT_EMPTY_STRING)) (i32.const 0))
        (return (i32.const 0))))
    (local.set $result_f64 (call $read_typed_element (local.get $receiver_type) (local.get $source_pointer)))
    (local.set $new_arr (call $f64_to_string (local.get $result_f64)))
    (local.set $i (i32.const 1))
    (block $join_done
      (loop $join_loop
        (br_if $join_done (i32.ge_u (local.get $i) (local.get $arr_len)))
        (local.set $new_arr (call $string_concat
          (local.get $new_arr)
          (local.get $separator_id)))
        (local.set $result_f64 (call $read_typed_element
          (local.get $receiver_type)
          (i32.add (local.get $source_pointer) (i32.mul (local.get $i) (local.get $bytes_per_element)))))
        (local.set $dest (call $f64_to_string (local.get $result_f64)))
        (local.set $new_arr (call $string_concat (local.get $new_arr) (local.get $dest)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $join_loop)))
    (call $pending_push
      (global.get $TYPE_STRING) (i32.const 0) (local.get $new_arr) (i32.const 0))
    (i32.const 0)
  )

  ;; typed_array_to_string_method — explicit TypedArray.prototype.toString.
  ;; Thin method-shaped wrapper over $typed_array_to_string (the same
  ;; conversion implicit coercion uses via $value_to_string), so the
  ;; explicit and implicit paths agree by construction. Arguments are
  ;; ignored, matching JS (TypedArray toString IS Array.prototype
  ;; .toString, which takes none). On pressure the conversion returns 0
  ;; with memory_pressure_signaled set; return STATUS_SUCCESS untouched
  ;; and let the CALL_METHOD pressure rollback re-expose the stack for
  ;; retry.
  (func $typed_array_to_string_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $result_id i32)
    (if (i32.eqz (call $is_typed_array (local.get $receiver_type)))
      (then
        (call $set_error (global.get $ERR_TYPE_ERROR) (local.get $receiver_type))
        (return (i32.const 2))
      )
    )
    (local.set $result_id (call $typed_array_to_string (local.get $receiver_type) (local.get $receiver_pointer)))
    (if (global.get $memory_pressure_signaled)
      (then (return (i32.const 0))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (call $pending_push
      (global.get $TYPE_STRING) (i32.const 0) (local.get $result_id) (i32.const 0))
    (i32.const 0)
  )

  ;; typed_array_sort_method — default (no-comparator) TypedArray
  ;; .prototype.sort. Unlike Array sort's string default, the typed
  ;; default comparator is NUMERIC ascending (spec: %TypedArray%
  ;; .prototype.sort), NaN sorts last, and -0 orders before +0. Sorts
  ;; IN PLACE on the descriptor's window (byte_offset + length — a
  ;; subarray sort must not touch bytes outside its window), no
  ;; allocation, then pushes the receiver. In-place insertion sort,
  ;; same O(n^2) shape as $array_sort_method.
  ;;
  ;; A function comparator never reaches this path from OP_CALL_METHOD
  ;; (its intercept routes to $typed_array_sort_comparator_method
  ;; first); it CAN arrive via the dispatch table (Function.prototype
  ;; .call/apply re-dispatch), where the callback-pending protocol has
  ;; no handler — push undefined and return, the same fallback shape
  ;; $array_sort_method uses for that path.
  (func $typed_array_sort_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $arg1_type i32)
    (local $element_base i32)
    (local $bytes_per_element i32)
    (local $arr_len i32)
    (local $i i32)
    (local $j i32)
    (local $key f64)
    (local $current f64)
    (local $greater i32)
    (if (i32.eqz (call $is_typed_array (local.get $receiver_type)))
      (then
        (call $set_error (global.get $ERR_TYPE_ERROR) (local.get $receiver_type))
        (return (i32.const 2))
      )
    )
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $arg1_type (call $value_type
          (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE)))))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (i32.eq (local.get $arg1_type) (global.get $TYPE_FUNCTION))
      (then
        (call $pending_push (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))
        (return (i32.const 0))
      )
    )
    ;; Descriptor: [buffer_ptr:4][byte_offset:4][length:4]; elements
    ;; start at buffer_ptr + 4 (past byteLength) + byte_offset.
    (local.set $element_base (i32.add
      (i32.add (i32.load (call $abs (local.get $receiver_pointer))) (i32.const 4))
      (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 4))))))
    (local.set $arr_len (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 8)))))
    (local.set $bytes_per_element (call $get_bytes_per_element (local.get $receiver_type)))
    (local.set $i (i32.const 1))
    (block $sort_done
      (loop $sort_loop
        (br_if $sort_done (i32.ge_u (local.get $i) (local.get $arr_len)))
        (local.set $key (call $read_typed_element (local.get $receiver_type)
          (call $abs (i32.add (local.get $element_base)
            (i32.mul (local.get $i) (local.get $bytes_per_element))))))
        (local.set $j (i32.sub (local.get $i) (i32.const 1)))
        (block $inner_done
          (loop $inner_loop
            (br_if $inner_done (i32.lt_s (local.get $j) (i32.const 0)))
            (local.set $current (call $read_typed_element (local.get $receiver_type)
              (call $abs (i32.add (local.get $element_base)
                (i32.mul (local.get $j) (local.get $bytes_per_element))))))
            ;; greater := current orders after key under the default
            ;; comparator: NaN after everything, then numeric, and for
            ;; numerically-equal zeros +0 after -0.
            (if (f64.ne (local.get $current) (local.get $current))
              (then (local.set $greater (f64.eq (local.get $key) (local.get $key))))
              (else
                (if (f64.ne (local.get $key) (local.get $key))
                  (then (local.set $greater (i32.const 0)))
                  (else
                    (if (f64.gt (local.get $current) (local.get $key))
                      (then (local.set $greater (i32.const 1)))
                      (else
                        (if (f64.lt (local.get $current) (local.get $key))
                          (then (local.set $greater (i32.const 0)))
                          (else
                            (local.set $greater (i32.and
                              (i32.eqz (i32.wrap_i64 (i64.shr_u
                                (i64.reinterpret_f64 (local.get $current)) (i64.const 63))))
                              (i32.wrap_i64 (i64.shr_u
                                (i64.reinterpret_f64 (local.get $key)) (i64.const 63)))))
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
            (br_if $inner_done (i32.eqz (local.get $greater)))
            (call $write_typed_element (local.get $receiver_type)
              (call $abs (i32.add (local.get $element_base)
                (i32.mul (i32.add (local.get $j) (i32.const 1)) (local.get $bytes_per_element))))
              (local.get $current))
            (local.set $j (i32.sub (local.get $j) (i32.const 1)))
            (br $inner_loop)
          )
        )
        (call $write_typed_element (local.get $receiver_type)
          (call $abs (i32.add (local.get $element_base)
            (i32.mul (i32.add (local.get $j) (i32.const 1)) (local.get $bytes_per_element))))
          (local.get $key))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $sort_loop)
      )
    )
    (call $pending_push (local.get $receiver_type) (i32.const 0) (local.get $receiver_pointer) (i32.const 0))
    (i32.const 0)
  )

  ;; ==========================================================================
  ;; DataView methods (dispatch-table migration, batch 6). Each
  ;; function re-derives the DataView
  ;; descriptor (data_pointer/start_idx/arr_len from receiver_pointer)
  ;; and whichever arg1/arg2/arg3 fields it uses, matching this
  ;; migration's established preamble-reproduction pattern.
  ;; ==========================================================================

  (func $dataview_get_int8
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $data_pointer i32)
    (local $start_idx i32)
    (local $arr_len i32)
    (local $i i32)
    (local $source_pointer i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))))
    (local.set $data_pointer (i32.load (call $abs (local.get $receiver_pointer))))
    (local.set $start_idx (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 4)))))
    (local.set $arr_len (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 8)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (local.set $i (i32.const 0))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (if (call $value_is_numeric (local.get $argument1_pointer))
          (then (local.set $i (i32.trunc_sat_f64_s (call $value_to_f64 (local.get $argument1_pointer))))))))
    (if (i32.or (i32.lt_s (local.get $i) (i32.const 0))
                (i32.gt_u (i32.add (local.get $i) (i32.const 1)) (local.get $arr_len)))
      (then (return (i32.add (i32.const 1) (call $throw_range_error_with_context (global.get $BUILTIN_MSG_OUT_OF_BOUNDS) (local.get $i) (local.get $arr_len) (i32.const 1))))))
    (local.set $source_pointer (call $abs (i32.add (i32.add (local.get $data_pointer) (i32.const 4)) (i32.add (local.get $start_idx) (local.get $i)))))
    (call $push_f64 (f64.convert_i32_s (i32.load8_s (local.get $source_pointer))))
    (i32.const 0)
  )

  (func $dataview_get_uint8
    (param $receiver_type i32) (param $receiver_pointer i32)
