        (block $cwf_done
          (loop $cwf_loop
            (br_if $cwf_done (i32.ge_u (local.get $i) (local.get $count)))
            (local.set $element_pointer (i32.add
              (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
              (i32.mul (i32.add (local.get $start_idx) (local.get $i)) (global.get $VALUE_SIZE))))
            (local.set $string_pointer (i32.add
              (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
              (i32.mul (i32.add (local.get $i32_result) (local.get $i)) (global.get $VALUE_SIZE))))
            (i32.store (call $abs (local.get $string_pointer))
              (i32.load (call $abs (local.get $element_pointer))))
            (i32.store (call $abs (i32.add (local.get $string_pointer) (i32.const 4)))
              (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 4)))))
            (i32.store (call $abs (i32.add (local.get $string_pointer) (i32.const 8)))
              (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 8)))))
            (i32.store (call $abs (i32.add (local.get $string_pointer) (i32.const 12)))
              (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 12)))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $cwf_loop)
          )
        )
      )
    )
    (call $pending_push (global.get $TYPE_ARRAY) (i32.const 0) (local.get $receiver_pointer) (i32.const 0))
    (return (i32.const 0))
  )

  (func $array_splice_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $argument2_pointer i32)
    (local $arr_len i32)
    (local $arr_cap i32)
    (local $data_pointer i32)
    (local $start_idx i32)
    (local $end_idx i32)
    (local $count i32)
    (local $i32_result i32)
    (local $new_arr i32)
    (local $new_data i32)
    (local $i i32)
    (local $j i32)
    (local $element_pointer i32)
    (local $string_pointer i32)
    (local $heap_pointer i32)
    (local $scratch_pointer i32)
    (local $slice_len i32)
    (local $dest i32)
    (local $argument_pointer i32)
    (local $materialize_result i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))))
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then
        (local.set $argument2_pointer (i32.add (local.get $argument1_pointer) (global.get $VALUE_SIZE)))))
    (local.set $materialize_result (call $array_method_materialize (local.get $receiver_type) (local.get $receiver_pointer)))
    (if (i32.eq (local.get $materialize_result) (i32.const -1)) (then (return (i32.const 0))))
    (if (i32.eq (local.get $materialize_result) (i32.const -2)) (then (return (i32.const 2))))
    (local.set $receiver_pointer (local.get $materialize_result))
    (local.set $arr_len (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 8)))))
    (local.set $arr_cap (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 12)))))
    (local.set $data_pointer (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 16)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))

    (if (call $array_is_frozen (local.get $receiver_pointer))
      (then
        (if (call $throw_type_error_with_type (global.get $BUILTIN_MSG_FROZEN_OBJECT) (i32.const 0))
          (then (return (i32.const 2)))
          (else (return (i32.const 1)))
        )
      )
    )
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (if (call $value_is_numeric (local.get $argument1_pointer))
          (then (local.set $start_idx (i32.trunc_sat_f64_s (call $value_to_f64 (local.get $argument1_pointer)))))
          (else (local.set $start_idx (i32.const 0)))
        )
        (if (i32.lt_s (local.get $start_idx) (i32.const 0))
          (then
            (local.set $start_idx (i32.add (local.get $arr_len) (local.get $start_idx)))
            (if (i32.lt_s (local.get $start_idx) (i32.const 0))
              (then (local.set $start_idx (i32.const 0))))
          )
        )
        (if (i32.gt_s (local.get $start_idx) (local.get $arr_len))
          (then (local.set $start_idx (local.get $arr_len))))
      )
      (else (local.set $start_idx (i32.const 0)))
    )
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then
        (if (call $value_is_numeric (local.get $argument2_pointer))
          (then (local.set $count (i32.trunc_sat_f64_s (call $value_to_f64 (local.get $argument2_pointer)))))
          (else (local.set $count (i32.const 0)))
        )
        (if (i32.lt_s (local.get $count) (i32.const 0))
          (then (local.set $count (i32.const 0))))
        (if (i32.gt_s (local.get $count) (i32.sub (local.get $arr_len) (local.get $start_idx)))
          (then (local.set $count (i32.sub (local.get $arr_len) (local.get $start_idx)))))
      )
      (else (local.set $count (i32.sub (local.get $arr_len) (local.get $start_idx))))
    )
    (local.set $i32_result (i32.const 0))
    (if (i32.gt_u (local.get $argc) (i32.const 2))
      (then (local.set $i32_result (i32.sub (local.get $argc) (i32.const 2)))))

    (local.set $end_idx (i32.sub (i32.add (local.get $arr_len) (local.get $i32_result)) (local.get $count)))
    ;; The grow branch below reallocates at max(arr_cap * 2, end_idx)
    ;; elements — a large multi-insert (splice(i, 0, ...many)) can push
    ;; end_idx past the doubled capacity, so budget the larger of the
    ;; two shapes, not just the doubling
    ;; because both allocations consume the heap/code free span.
    (if (call $check_heap_overflow
          (i32.add
            (call $estimate_array_size (local.get $count))
            (if (result i32) (i32.gt_u (local.get $end_idx) (local.get $arr_cap))
              (then
                (select
                  (call $estimate_array_grow_size (local.get $arr_cap))
                  (call $estimate_array_size (local.get $end_idx))
                  (i32.gt_u
                    (call $estimate_array_grow_size (local.get $arr_cap))
                    (call $estimate_array_size (local.get $end_idx)))))
              (else (i32.const 0)))))
      (then (return (i32.const 0))))

    (local.set $new_arr (call $allocate_array (local.get $count)))
    (i32.store (call $abs (i32.add (local.get $new_arr) (i32.const 8))) (local.get $count))
    (local.set $new_data (i32.load (call $abs (i32.add (local.get $new_arr) (i32.const 16)))))
    (local.set $i (i32.const 0))
    (block $rem_done
      (loop $rem_loop
        (br_if $rem_done (i32.ge_u (local.get $i) (local.get $count)))
        (local.set $element_pointer (i32.add
          (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
          (i32.mul (i32.add (local.get $start_idx) (local.get $i)) (global.get $VALUE_SIZE))))
        (local.set $string_pointer (i32.add
          (i32.add (local.get $new_data) (global.get $GC_HEADER_SIZE))
          (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
        (i32.store (call $abs (local.get $string_pointer))
          (i32.load (call $abs (local.get $element_pointer))))
        (i32.store (call $abs (i32.add (local.get $string_pointer) (i32.const 4)))
          (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 4)))))
        (i32.store (call $abs (i32.add (local.get $string_pointer) (i32.const 8)))
          (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 8)))))
        (i32.store (call $abs (i32.add (local.get $string_pointer) (i32.const 12)))
          (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 12)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $rem_loop)
      )
    )

    (if (i32.gt_u (local.get $end_idx) (local.get $arr_cap))
      (then
        (local.set $arr_cap (i32.shl (local.get $arr_cap) (i32.const 1)))
        (if (i32.lt_u (local.get $arr_cap) (local.get $end_idx))
          (then (local.set $arr_cap (local.get $end_idx))))
        (local.set $heap_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))
        (local.set $scratch_pointer (local.get $heap_pointer))
        (local.set $slice_len (i32.add (global.get $GC_HEADER_SIZE)
          (i32.mul (local.get $arr_cap) (global.get $VALUE_SIZE))))
        (i32.store (call $abs (local.get $scratch_pointer))
          (i32.or (local.get $slice_len) (i32.shl (global.get $OBJ_ARRAY_DATA) (i32.const 24))))
        (i32.store (call $abs (i32.add (local.get $scratch_pointer) (i32.const 4))) (i32.const 0))
        (local.set $i (i32.const 0))
        (block $cpre_done
          (loop $cpre_loop
            (br_if $cpre_done (i32.ge_u (local.get $i) (local.get $start_idx)))
            (local.set $element_pointer (i32.add
              (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
              (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
            (local.set $dest (i32.add
              (i32.add (local.get $scratch_pointer) (global.get $GC_HEADER_SIZE))
              (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
            (i32.store (call $abs (local.get $dest)) (i32.load (call $abs (local.get $element_pointer))))
            (i32.store (call $abs (i32.add (local.get $dest) (i32.const 4)))
              (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 4)))))
            (i32.store (call $abs (i32.add (local.get $dest) (i32.const 8)))
              (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 8)))))
            (i32.store (call $abs (i32.add (local.get $dest) (i32.const 12)))
              (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 12)))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $cpre_loop)
          )
        )
        (local.set $i (i32.const 0))
        (local.set $j (i32.sub (local.get $arr_len) (i32.add (local.get $start_idx) (local.get $count))))
        (block $cpost_done
          (loop $cpost_loop
            (br_if $cpost_done (i32.ge_u (local.get $i) (local.get $j)))
            (local.set $element_pointer (i32.add
              (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
              (i32.mul (i32.add (i32.add (local.get $start_idx) (local.get $count)) (local.get $i)) (global.get $VALUE_SIZE))))
            (local.set $dest (i32.add
              (i32.add (local.get $scratch_pointer) (global.get $GC_HEADER_SIZE))
              (i32.mul (i32.add (i32.add (local.get $start_idx) (local.get $i32_result)) (local.get $i)) (global.get $VALUE_SIZE))))
            (i32.store (call $abs (local.get $dest)) (i32.load (call $abs (local.get $element_pointer))))
            (i32.store (call $abs (i32.add (local.get $dest) (i32.const 4)))
              (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 4)))))
            (i32.store (call $abs (i32.add (local.get $dest) (i32.const 8)))
              (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 8)))))
            (i32.store (call $abs (i32.add (local.get $dest) (i32.const 12)))
              (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 12)))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $cpost_loop)
          )
        )
        (call $write_state (global.get $STATE_HEAP_POINTER)
          (i32.add (local.get $scratch_pointer) (local.get $slice_len)))
        (local.set $data_pointer (local.get $scratch_pointer))
        (i32.store (call $abs (i32.add (local.get $receiver_pointer) (i32.const 12))) (local.get $arr_cap))
        (i32.store (call $abs (i32.add (local.get $receiver_pointer) (i32.const 16))) (local.get $data_pointer))
      )
      (else
        (if (i32.ne (local.get $i32_result) (local.get $count))
          (then
            (local.set $j (i32.sub (local.get $arr_len) (i32.add (local.get $start_idx) (local.get $count))))
            (if (i32.gt_s (local.get $i32_result) (local.get $count))
              (then
                (local.set $i (i32.sub (local.get $j) (i32.const 1)))
                (block $sr_done
                  (loop $sr_loop
                    (br_if $sr_done (i32.lt_s (local.get $i) (i32.const 0)))
                    (local.set $element_pointer (i32.add
                      (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
                      (i32.mul (i32.add (i32.add (local.get $start_idx) (local.get $count)) (local.get $i)) (global.get $VALUE_SIZE))))
                    (local.set $dest (i32.add
                      (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
                      (i32.mul (i32.add (i32.add (local.get $start_idx) (local.get $i32_result)) (local.get $i)) (global.get $VALUE_SIZE))))
                    (i32.store (call $abs (local.get $dest)) (i32.load (call $abs (local.get $element_pointer))))
                    (i32.store (call $abs (i32.add (local.get $dest) (i32.const 4)))
                      (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 4)))))
                    (i32.store (call $abs (i32.add (local.get $dest) (i32.const 8)))
                      (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 8)))))
                    (i32.store (call $abs (i32.add (local.get $dest) (i32.const 12)))
                      (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 12)))))
                    (local.set $i (i32.sub (local.get $i) (i32.const 1)))
                    (br $sr_loop)
                  )
                )
              )
              (else
                (local.set $i (i32.const 0))
                (block $sl_done
                  (loop $sl_loop
                    (br_if $sl_done (i32.ge_u (local.get $i) (local.get $j)))
                    (local.set $element_pointer (i32.add
                      (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
                      (i32.mul (i32.add (i32.add (local.get $start_idx) (local.get $count)) (local.get $i)) (global.get $VALUE_SIZE))))
                    (local.set $dest (i32.add
                      (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
                      (i32.mul (i32.add (i32.add (local.get $start_idx) (local.get $i32_result)) (local.get $i)) (global.get $VALUE_SIZE))))
                    (i32.store (call $abs (local.get $dest)) (i32.load (call $abs (local.get $element_pointer))))
                    (i32.store (call $abs (i32.add (local.get $dest) (i32.const 4)))
                      (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 4)))))
                    (i32.store (call $abs (i32.add (local.get $dest) (i32.const 8)))
                      (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 8)))))
                    (i32.store (call $abs (i32.add (local.get $dest) (i32.const 12)))
                      (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 12)))))
                    (local.set $i (i32.add (local.get $i) (i32.const 1)))
                    (br $sl_loop)
                  )
                )
              )
            )
          )
        )
      )
    )
    (local.set $i (i32.const 0))
    (block $ins_done
      (loop $ins_loop
        (br_if $ins_done (i32.ge_u (local.get $i) (local.get $i32_result)))
        (local.set $argument_pointer (i32.add (local.get $argument1_pointer)
          (i32.mul (i32.add (i32.const 2) (local.get $i)) (global.get $VALUE_SIZE))))
        (local.set $dest (i32.add
          (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
          (i32.mul (i32.add (local.get $start_idx) (local.get $i)) (global.get $VALUE_SIZE))))
        (i32.store (call $abs (local.get $dest))
          (i32.load (call $abs (local.get $argument_pointer))))
        (i32.store (call $abs (i32.add (local.get $dest) (i32.const 4)))
          (i32.load (call $abs (i32.add (local.get $argument_pointer) (i32.const 4)))))
        (i32.store (call $abs (i32.add (local.get $dest) (i32.const 8)))
          (i32.load (call $abs (i32.add (local.get $argument_pointer) (i32.const 8)))))
        (i32.store (call $abs (i32.add (local.get $dest) (i32.const 12)))
          (i32.load (call $abs (i32.add (local.get $argument_pointer) (i32.const 12)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $ins_loop)
      )
    )
    (i32.store (call $abs (i32.add (local.get $receiver_pointer) (i32.const 8))) (local.get $end_idx))
    (call $pending_push (global.get $TYPE_ARRAY) (i32.const 0) (local.get $new_arr) (i32.const 0))
    (return (i32.const 0))
  )

  (func $array_flat_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $count i32)
    (local $new_arr i32)
    (local $materialize_result i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))))
    (local.set $materialize_result (call $array_method_materialize (local.get $receiver_type) (local.get $receiver_pointer)))
    (if (i32.eq (local.get $materialize_result) (i32.const -1)) (then (return (i32.const 0))))
    (if (i32.eq (local.get $materialize_result) (i32.const -2)) (then (return (i32.const 2))))
    (local.set $receiver_pointer (local.get $materialize_result))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))

    (local.set $count (i32.const 1))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (if (call $value_is_numeric (local.get $argument1_pointer))
          (then (local.set $count (i32.trunc_sat_f64_s (call $value_to_f64 (local.get $argument1_pointer)))))
        )
      )
    )
    (if (i32.lt_s (local.get $count) (i32.const 0))
      (then (local.set $count (i32.const 0))))

    (if (call $check_heap_overflow (call $estimate_array_size (i32.const 4)))
      (then (return (i32.const 0))))
    (local.set $new_arr (call $allocate_array (i32.const 4)))
    (i32.store (call $abs (i32.add (local.get $new_arr) (i32.const 8))) (i32.const 0))

    ;; Pressure mid-flatten: the flag is already signaled; return 0 and
    ;; the CALL_METHOD rollback re-runs this whole method after the gc.
    ;; The partial $new_arr is garbage, not a duplicate — a retry
    ;; allocates a fresh target.
    (if (call $flat_into (local.get $receiver_pointer) (local.get $new_arr) (local.get $count))
      (then (return (i32.const 0))))

    (call $pending_push (global.get $TYPE_ARRAY) (i32.const 0) (local.get $new_arr) (i32.const 0))
    (return (i32.const 0))
  )

  (func $array_sort_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $arg1_type i32)
    (local $arr_len i32)
    (local $data_pointer i32)
    (local $i i32)
    (local $j i32)
    (local $element_pointer i32)
    (local $string_pointer i32)
    (local $dest i32)
    (local $val_type i32)
    (local $val_flags i32)
    (local $val_lo i32)
    (local $val_hi i32)
    (local $f64_result f64)
    (local $scratch_pointer i32)
    (local $materialize_result i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $arg1_type (call $value_type (local.get $argument1_pointer)))))
    (local.set $materialize_result (call $array_method_materialize (local.get $receiver_type) (local.get $receiver_pointer)))
    (if (i32.eq (local.get $materialize_result) (i32.const -1)) (then (return (i32.const 0))))
    (if (i32.eq (local.get $materialize_result) (i32.const -2)) (then (return (i32.const 2))))
    (local.set $receiver_pointer (local.get $materialize_result))
    (local.set $arr_len (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 8)))))
    (local.set $data_pointer (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 16)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))

    (if (call $array_is_frozen (local.get $receiver_pointer))
      (then
        (if (call $throw_type_error_with_type (global.get $BUILTIN_MSG_FROZEN_OBJECT) (i32.const 0))
          (then (return (i32.const 2)))
          (else (return (i32.const 1)))
        )
      )
    )
    (if (i32.and (i32.ge_u (local.get $argc) (i32.const 1))
                 (i32.eq (local.get $arg1_type) (global.get $TYPE_FUNCTION)))
      (then
        (call $pending_push (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))
        (return (i32.const 0))
      )
    )

    (local.set $i (i32.const 1))
    (block $sort_done
      (loop $sort_loop
        (br_if $sort_done (i32.ge_u (local.get $i) (local.get $arr_len)))

        (local.set $element_pointer (i32.add
          (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
          (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
        (local.set $val_type (i32.load (call $abs (local.get $element_pointer))))
        (local.set $val_flags (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 4)))))
        (local.set $val_lo (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 8)))))
        (local.set $val_hi (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 12)))))

        (local.set $f64_result (call $default_sort_compare (local.get $element_pointer) (local.get $element_pointer)))
        (local.set $scratch_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))
        (i32.store (call $abs (local.get $scratch_pointer))
          (i32.load (call $abs (local.get $element_pointer))))
        (i32.store (call $abs (i32.add (local.get $scratch_pointer) (i32.const 4)))
          (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 4)))))
        (i32.store (call $abs (i32.add (local.get $scratch_pointer) (i32.const 8)))
          (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 8)))))
        (i32.store (call $abs (i32.add (local.get $scratch_pointer) (i32.const 12)))
          (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 12)))))

        (local.set $j (i32.sub (local.get $i) (i32.const 1)))
        (block $inner_done
          (loop $inner_loop
            (br_if $inner_done (i32.lt_s (local.get $j) (i32.const 0)))
            (local.set $string_pointer (i32.add
              (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
              (i32.mul (local.get $j) (global.get $VALUE_SIZE))))
            (br_if $inner_done (f64.le
              (call $default_sort_compare (local.get $string_pointer) (local.get $scratch_pointer))
              (f64.const 0)))
            (local.set $dest (i32.add
              (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
              (i32.mul (i32.add (local.get $j) (i32.const 1)) (global.get $VALUE_SIZE))))
            (i32.store (call $abs (local.get $dest))
              (i32.load (call $abs (local.get $string_pointer))))
            (i32.store (call $abs (i32.add (local.get $dest) (i32.const 4)))
              (i32.load (call $abs (i32.add (local.get $string_pointer) (i32.const 4)))))
            (i32.store (call $abs (i32.add (local.get $dest) (i32.const 8)))
              (i32.load (call $abs (i32.add (local.get $string_pointer) (i32.const 8)))))
            (i32.store (call $abs (i32.add (local.get $dest) (i32.const 12)))
              (i32.load (call $abs (i32.add (local.get $string_pointer) (i32.const 12)))))
            (local.set $j (i32.sub (local.get $j) (i32.const 1)))
            (br $inner_loop)
          )
        )
        (local.set $dest (i32.add
          (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
          (i32.mul (i32.add (local.get $j) (i32.const 1)) (global.get $VALUE_SIZE))))
        (i32.store (call $abs (local.get $dest)) (local.get $val_type))
        (i32.store (call $abs (i32.add (local.get $dest) (i32.const 4))) (local.get $val_flags))
        (i32.store (call $abs (i32.add (local.get $dest) (i32.const 8))) (local.get $val_lo))
        (i32.store (call $abs (i32.add (local.get $dest) (i32.const 12))) (local.get $val_hi))

        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $sort_loop)
      )
    )
    (call $pending_push (global.get $TYPE_ARRAY) (i32.const 0) (local.get $receiver_pointer) (i32.const 0))
    (return (i32.const 0))
  )

  (func $array_iterator_factory_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $object_pointer i32)
    (local $materialize_result i32)
    (local $kind i32)
    (local.set $materialize_result (call $array_method_materialize (local.get $receiver_type) (local.get $receiver_pointer)))
    (if (i32.eq (local.get $materialize_result) (i32.const -1)) (then (return (i32.const 0))))
    (if (i32.eq (local.get $materialize_result) (i32.const -2)) (then (return (i32.const 2))))
    (local.set $receiver_pointer (local.get $materialize_result))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))

    ;; Derive @kind from the factory method id (the Map/Set factory
    ;; convention): keys=0, values=1, entries=2. Symbol.iterator and
    ;; values() share METHOD_ARRAY_ITERATOR_FACTORY — both are kind 1.
    (if (i32.eq (local.get $method_id) (global.get $METHOD_ARRAY_KEYS))
      (then (local.set $kind (i32.const 0)))
      (else
        (if (i32.eq (local.get $method_id) (global.get $METHOD_ARRAY_ENTRIES))
          (then (local.set $kind (i32.const 2)))
          (else (local.set $kind (i32.const 1)))
        )
      )
    )

    (if (call $check_heap_overflow
          (i32.add
            (call $estimate_object_size (i32.const 4))
            (call $estimate_object_sym_entries_size)))
      (then (return (i32.const 0))))
    (local.set $object_pointer (call $allocate_object (i32.const 4)))
    (drop (call $object_set_property
      (local.get $object_pointer)
      (call $read_builtin (global.get $BUILTIN_ITER_HIDDEN_ARRAY))
      (global.get $TYPE_ARRAY)
      (i32.const 0)
      (local.get $receiver_pointer)
      (i32.const 0)))
    (drop (call $object_set_property
      (local.get $object_pointer)
      (call $read_builtin (global.get $BUILTIN_ITER_HIDDEN_INDEX))
      (global.get $TYPE_RATIONAL)
      (global.get $FLAG_RATIONAL_INLINE)
      (i32.const 0)
      (i32.const 0)))
    (drop (call $object_set_property
      (local.get $object_pointer)
      (call $read_builtin (global.get $BUILTIN_ITER_NEXT_KEY))
      (global.get $TYPE_BOUND_METHOD)
      (global.get $TYPE_OBJECT)
      (local.get $object_pointer)
      (global.get $METHOD_ARRAY_ITERATOR_NEXT)))
    ;; Slot 3: @kind — appended LAST so the fixed slot offsets the next
    ;; method reads (@array lo at entries+20, @index lo at entries+40)
    ;; stay where they always were; @kind lo is at entries+80.
    (drop (call $object_set_property
      (local.get $object_pointer)
      (call $read_builtin (global.get $BUILTIN_ITER_HIDDEN_KIND))
      (global.get $TYPE_RATIONAL)
      (global.get $FLAG_RATIONAL_INLINE)
      (local.get $kind)
      (i32.const 0)))
    ;; Symbol.iterator on the iterator itself returns `this` so the
    ;; iterator is iterable — `for (const [i, v] of arr.entries())`
    ;; works (mirrors $build_collection_iterator).
    (call $object_set_sym_entry
      (local.get $object_pointer)
      (call $read_state (global.get $STATE_WELL_KNOWN_ITERATOR_SYMBOL))
      (global.get $TYPE_BOUND_METHOD)
      (global.get $TYPE_OBJECT)
      (local.get $object_pointer)
      (global.get $METHOD_ITERATOR_RETURN_SELF))
    (call $pending_push
      (global.get $TYPE_OBJECT)
      (i32.const 0)
      (local.get $object_pointer)
      (i32.const 0))
    (return (i32.const 0))
  )

  ;; Batch 17: String instance methods + string iterator factory. Hex
  ;; values verified against each METHOD_* global's own declaration.
  ;;
  ;; Every STRING-instance method shares this preamble in the original
  ;; inline code: receiver_pointer arrives as a table-relative string id
  ;; and gets converted to segment-relative form (`$string_id_to_seg`)
  ;; before any byte-access; str_len is read from the segment header.
  ;; Reproduced verbatim in each extracted function below. The iterator
  ;; factory is the one exception — it stores the ORIGINAL table-relative
  ;; id into the iterator object, so it must run before the conversion.

  (func $string_iterator_factory_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $object_pointer i32)
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (call $check_heap_overflow (call $estimate_object_size (i32.const 4)))
      (then (return (i32.const 0))))
    (local.set $object_pointer (call $allocate_object (i32.const 4)))
    (drop (call $object_set_property
      (local.get $object_pointer)
      (call $read_builtin (global.get $BUILTIN_ITER_HIDDEN_STRING))
      (global.get $TYPE_STRING) (i32.const 0)
      (local.get $receiver_pointer)
      (i32.const 0)))
    (drop (call $object_set_property
      (local.get $object_pointer)
      (call $read_builtin (global.get $BUILTIN_ITER_HIDDEN_BYTE_OFFSET))
      (global.get $TYPE_RATIONAL)
      (global.get $FLAG_RATIONAL_INLINE)
      (i32.const 0) (i32.const 0)))
    (drop (call $object_set_property
      (local.get $object_pointer)
      (call $read_builtin (global.get $BUILTIN_ITER_NEXT_KEY))
      (global.get $TYPE_BOUND_METHOD)
      (global.get $TYPE_OBJECT)
      (local.get $object_pointer)
      (global.get $METHOD_STRING_ITERATOR_NEXT)))
    (call $pending_push
      (global.get $TYPE_OBJECT) (i32.const 0)
      (local.get $object_pointer) (i32.const 0))
    (return (i32.const 0))
  )

  (func $string_char_at_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $arg1_type i32)
    (local $arg1_lo i32)
    (local $str_len i32)
    (local $i i32)
    (local $start_idx i32)
    (local $slice_len i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $arg1_type (call $value_type (local.get $argument1_pointer)))
        (local.set $arg1_lo (call $value_data_lo (local.get $argument1_pointer)))))
    (local.set $receiver_pointer (call $string_id_to_seg (local.get $receiver_pointer)))
    (local.set $str_len (i32.load (call $abs (local.get $receiver_pointer))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))

    (if (call $value_is_numeric (local.get $argument1_pointer))
      (then
        (local.set $i (i32.trunc_sat_f64_s (call $value_to_f64 (local.get $argument1_pointer))))
      )
      (else
        (if (i32.eq (local.get $arg1_type) (global.get $TYPE_INTEGER))
          (then (local.set $i (local.get $arg1_lo)))
          (else (local.set $i (i32.const 0)))
        )
      )
    )

    (local.set $start_idx (call $utf8_char_to_byte_offset (call $seg_to_string_id (local.get $receiver_pointer)) (local.get $i)))

    (if (i32.or
          (i32.lt_s (local.get $i) (i32.const 0))
          (i32.lt_s (local.get $start_idx) (i32.const 0)))
      (then
        (call $pending_push (global.get $TYPE_STRING) (i32.const 0)
          (call $read_builtin (global.get $BUILTIN_LIT_EMPTY_STRING)) (i32.const 0))
        (return (i32.const 0))
      )
    )

    (if (i32.ge_s (local.get $start_idx) (local.get $str_len))
      (then
        (call $pending_push (global.get $TYPE_STRING) (i32.const 0)
          (call $read_builtin (global.get $BUILTIN_LIT_EMPTY_STRING)) (i32.const 0))
        (return (i32.const 0))
      )
    )

    (local.set $slice_len (call $utf8_char_byte_len (local.get $receiver_pointer) (local.get $start_idx)))

    ;; Intern the char directly from the receiver's bytes — the
    ;; $string_iterator_next_method pattern. Dedups, and the capacity
    ;; check lives in $intern_string.
    (call $pending_push (global.get $TYPE_STRING) (i32.const 0)
      (call $intern_string
        (call $abs (i32.add
          (i32.add (local.get $receiver_pointer) (i32.const 4))
          (local.get $start_idx)))
        (local.get $slice_len))
      (i32.const 0))
    (return (i32.const 0))
  )

  (func $string_char_code_at_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $arg1_type i32)
    (local $arg1_lo i32)
    (local $str_len i32)
    (local $i i32)
    (local $start_idx i32)
    (local $char_code i32)
