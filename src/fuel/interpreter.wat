            ;; cleanup, grant trimming, scope recycling, and native-frame teardown.
            (call $proof_native_builder_return_gate (local.get $opcode) (local.get $fuel))
            (local.set $fuel) (local.set $result_i32)
            (if (i32.or (i32.eq (local.get $result_i32) (i32.const 1)) (i32.eq (local.get $result_i32) (i32.const 2)))
