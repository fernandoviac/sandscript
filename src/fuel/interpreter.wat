  (global $SCHEMA_PROGRAM_BUFFER i32 (i32.const 16))
  (global $SCHEMA_OPTIONS i32 (i32.const 20))
  (global $SCHEMA_MAX_DEPTH i32 (i32.const 24))
  (global $SCHEMA_MAX_ERRORS i32 (i32.const 28))
  (global $SCHEMA_ARENA_BYTES i32 (i32.const 32))
  (global $SCHEMA_COMPILE_FUEL i32 (i32.const 36))
  (global $SCHEMA_SIZE i32 (i32.const 40))
  (global $METHOD_SCHEMA_CONSTRUCTOR i32 (i32.const 0x2C0))
  (global $METHOD_SCHEMA_COMPILE i32 (i32.const 0x2C1))
  (global $METHOD_SCHEMA_TEST_STATIC i32 (i32.const 0x2C2))
