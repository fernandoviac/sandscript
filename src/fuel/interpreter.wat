      )
    )
    (if (i32.or
          (i32.or
            (i32.eq (local.get $method_id) (global.get $METHOD_SET_UNION))
            (i32.eq (local.get $method_id) (global.get $METHOD_SET_INTERSECTION)))
          (i32.or
            (i32.eq (local.get $method_id) (global.get $METHOD_SET_DIFFERENCE))
            (i32.eq (local.get $method_id) (global.get $METHOD_SET_SYMMETRIC_DIFFERENCE))))
      (then
        (if (call $check_heap_overflow
              (call $estimate_collection_build_size
                (global.get $SET_SLOT_STRIDE)
                (i32.add
                  (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 8))))
                  (i32.load (call $abs (i32.add (local.get $arg1_lo) (i32.const 8)))))))
          (then (return (i32.const 0))))
      )
    )
    (if (i32.eq (local.get $method_id) (global.get $METHOD_SET_UNION))
      (then
        (local.set $heap_pointer (call $allocate_collection
          (global.get $OBJ_SET) (global.get $OBJ_SET_ENTRIES)
          (global.get $SET_SLOT_STRIDE) (i32.const 4)))
        (call $set_iterate_into_result
          (local.get $receiver_pointer) (local.get $heap_pointer)
          (i32.const 0) (i32.const 0))
        (call $set_iterate_into_result
          (local.get $arg1_lo) (local.get $heap_pointer)
          (i32.const 0) (i32.const 0))
        (call $pending_push (global.get $TYPE_SET) (i32.const 0)
          (local.get $heap_pointer) (i32.const 0))
        (return (i32.const 0))
      )
    )
    (if (i32.eq (local.get $method_id) (global.get $METHOD_SET_INTERSECTION))
      (then
        (local.set $heap_pointer (call $allocate_collection
          (global.get $OBJ_SET) (global.get $OBJ_SET_ENTRIES)
          (global.get $SET_SLOT_STRIDE) (i32.const 4)))
        (call $set_iterate_into_result
          (local.get $receiver_pointer) (local.get $heap_pointer)
          (local.get $arg1_lo) (i32.const 1))
        (call $pending_push (global.get $TYPE_SET) (i32.const 0)
          (local.get $heap_pointer) (i32.const 0))
        (return (i32.const 0))
      )
    )
    (if (i32.eq (local.get $method_id) (global.get $METHOD_SET_DIFFERENCE))
      (then
        (local.set $heap_pointer (call $allocate_collection
          (global.get $OBJ_SET) (global.get $OBJ_SET_ENTRIES)
          (global.get $SET_SLOT_STRIDE) (i32.const 4)))
        (call $set_iterate_into_result
          (local.get $receiver_pointer) (local.get $heap_pointer)
          (local.get $arg1_lo) (i32.const 2))
        (call $pending_push (global.get $TYPE_SET) (i32.const 0)
          (local.get $heap_pointer) (i32.const 0))
