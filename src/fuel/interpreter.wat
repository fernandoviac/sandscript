  (global $METHOD_SCHEMA_IS_SCHEMA i32 (i32.const 0x2C4))
  (global $METHOD_SCHEMA_TEST i32 (i32.const 0x2C5))
  (global $METHOD_SCHEMA_VALIDATE i32 (i32.const 0x2C6))
  (global $METHOD_SCHEMA_ASSERT i32 (i32.const 0x2C7))
  (global $METHOD_SCHEMA_ERRORS i32 (i32.const 0x2C8))
