                                  (i32.add (local.get $pc) (i32.const 1)))
                                (call $publish_native_continuation_frame
                                  (local.get $frame_pointer) (local.get $stack_pointer)
                                  (local.get $value_pointer)
                                  (i32.const 1) (i32.const 0) (i32.const 0)
                                  (i32.const 0) (i32.const 0)
                                  (global.get $CONTINUATION_KIND_MAP_SEED_FROM_ITERABLE)
                                  (local.get $heap_pointer) (local.get $closure_pointer)
                                  (global.get $TYPE_MAP) (i32.const 0))
