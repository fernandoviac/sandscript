                      (global.get $TYPE_STRING)
                      (call $value_data_lo (local.get $data_pointer))
                      (i32.shr_u (local.get $arr_len) (i32.const 16)))
                    (call $write_value
                      (i32.add (local.get $element_pointer) (global.get $VALUE_SIZE))
