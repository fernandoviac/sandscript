  ;; ==========================================================================
  ;; Number/String static methods (dispatch-table migration, batch 11).
  ;; receiver_type = TYPE_CONSTRUCTOR
  ;; for both. fromCharCode/fromCodePoint write to heap-tail scratch
  ;; (STATE_STRING_POINTER) during their loops; unlike btoa/atob, the
  ;; per-iteration conversion ($value_to_f64) is a pure read (no
  ;; allocation — confirmed by reading its body), so interleaving it
  ;; with the scratch writes is safe and was not reordered.
  ;; ==========================================================================

  (func $number_is_nan
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $f64_result f64)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (call $value_is_numeric (local.get $argument1_pointer))
      (then
        (local.set $f64_result (call $value_to_f64 (local.get $argument1_pointer)))
        (if (f64.ne (local.get $f64_result) (local.get $f64_result))
          (then (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (i32.const 1) (i32.const 0)))
          (else (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (i32.const 0) (i32.const 0)))))
      (else (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (i32.const 0) (i32.const 0))))
    (i32.const 0)
  )

  (func $number_is_finite
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $f64_result f64)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (call $value_is_numeric (local.get $argument1_pointer))
      (then
        (local.set $f64_result (call $value_to_f64 (local.get $argument1_pointer)))
        (if (i32.and
              (f64.eq (local.get $f64_result) (local.get $f64_result))
              (f64.lt (f64.abs (local.get $f64_result)) (f64.const inf)))
          (then (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (i32.const 1) (i32.const 0)))
          (else (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (i32.const 0) (i32.const 0)))))
      (else (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (i32.const 0) (i32.const 0))))
    (i32.const 0)
  )

  (func $number_is_integer
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $f64_result f64)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (call $value_is_numeric (local.get $argument1_pointer))
      (then
        (local.set $f64_result (call $value_to_f64 (local.get $argument1_pointer)))
        (if (i32.and
              (i32.and
                (f64.eq (local.get $f64_result) (local.get $f64_result))
                (f64.lt (f64.abs (local.get $f64_result)) (f64.const inf)))
              (f64.eq (f64.trunc (local.get $f64_result)) (local.get $f64_result)))
          (then (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (i32.const 1) (i32.const 0)))
          (else (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (i32.const 0) (i32.const 0)))))
      (else (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (i32.const 0) (i32.const 0))))
