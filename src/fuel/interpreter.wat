            ;; type tags differ, canonicalize to f64 and compare. This
            ;; mirrors what OP_LT does and is what JS spec requires
            ;; (`1 === 1.0`, `host_returned_3 === 3`). BigInt is excluded
            ;; on purpose: per JS, `3n === 3` is false.
            (if (i32.and
                  (i32.ne (local.get $type1) (local.get $type2))
                  (i32.and
                    (i32.or
                      (i32.eq (local.get $type1) (global.get $TYPE_FLOAT))
                      (i32.eq (local.get $type1) (global.get $TYPE_RATIONAL)))
                    (i32.or
                      (i32.eq (local.get $type2) (global.get $TYPE_FLOAT))
                      (i32.eq (local.get $type2) (global.get $TYPE_RATIONAL)))))
              (then
                (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0)
                  (f64.eq
                    (call $value_to_f64 (local.get $value_pointer))
                    (call $value_to_f64 (local.get $value_pointer2)))
                  (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Different types are never equal (strict equality)
            (if (i32.ne (local.get $type1) (local.get $type2))
              (then
                (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (i32.const 0) (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Float comparison: use f64.eq (handles NaN !== NaN correctly)
            (if (i32.eq (local.get $type1) (global.get $TYPE_FLOAT))
              (then
                (call $pending_push
                  (global.get $TYPE_BOOLEAN)
                  (i32.const 0)
                  (f64.eq
                    (call $read_f64 (local.get $value_pointer))
                    (call $read_f64 (local.get $value_pointer2)))
                  (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
