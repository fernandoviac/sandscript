  (global $CONTINUATION_KIND_SET_FOR_EACH i32 (i32.const 0x1B5))
  (global $CONTINUATION_KIND_ARRAY_REDUCE_RIGHT i32 (i32.const 0x1CC))
  (global $CONTINUATION_KIND_ARRAY_FIND_LAST i32 (i32.const 0x1D9))
  (global $CONTINUATION_KIND_ARRAY_FIND_LAST_INDEX i32 (i32.const 0x1DA))

  ;; Type tags (16-byte value format: [type:i32][flags:i32][data:i64])
  (global $TYPE_NULL i32 (i32.const 0x00))
  (global $TYPE_UNDEFINED i32 (i32.const 0x01))
  (global $TYPE_BOOLEAN i32 (i32.const 0x02))
  (global $TYPE_INTEGER i32 (i32.const 0x03))
  (global $TYPE_FLOAT i32 (i32.const 0x04))
  (global $TYPE_STRING i32 (i32.const 0x05))
  (global $TYPE_ARRAY i32 (i32.const 0x06))
  (global $TYPE_OBJECT i32 (i32.const 0x07))
  (global $TYPE_FUNCTION i32 (i32.const 0x08))
  (global $TYPE_SCOPE i32 (i32.const 0x09))
  (global $TYPE_BOUND_METHOD i32 (i32.const 0x0e))
  (global $TYPE_CONSTRUCTOR i32 (i32.const 0x0f))  ;; callable object (Array, Object, String, Number)
  (global $TYPE_EXTERNAL i32 (i32.const 0x0a))     ;; opaque external handle
  (global $TYPE_EXTERNAL_METHOD i32 (i32.const 0x0b))  ;; method reference on external (handleId + methodName)
  (global $TYPE_MSGPACK_REF i32 (i32.const 0x0d))  ;; read-only msgpack reference
  (global $TYPE_ARRAYBUFFER i32 (i32.const 0x10))  ;; ArrayBuffer - owns bytes on heap
  (global $TYPE_UINT8ARRAY i32 (i32.const 0x11))   ;; Uint8Array - view into ArrayBuffer
  (global $TYPE_DATAVIEW i32 (i32.const 0x12))     ;; DataView - explicit endianness binary access
  ;; Additional typed arrays
  (global $TYPE_INT8ARRAY i32 (i32.const 0x14))
  (global $TYPE_UINT8CLAMPEDARRAY i32 (i32.const 0x15))
  (global $TYPE_INT16ARRAY i32 (i32.const 0x16))
  (global $TYPE_UINT16ARRAY i32 (i32.const 0x17))
  (global $TYPE_INT32ARRAY i32 (i32.const 0x18))
  (global $TYPE_UINT32ARRAY i32 (i32.const 0x19))
  (global $TYPE_FLOAT32ARRAY i32 (i32.const 0x1A))
  (global $TYPE_FLOAT64ARRAY i32 (i32.const 0x1B))
  (global $TYPE_PROMISE i32 (i32.const 0x1C))
  (global $TYPE_BIGINT i32 (i32.const 0x1D))
  (global $TYPE_BIGINT64ARRAY i32 (i32.const 0x1E))
  (global $TYPE_BIGUINT64ARRAY i32 (i32.const 0x1F))
  (global $TYPE_RATIONAL i32 (i32.const 0x0C))
  (global $TYPE_COMPLEX i32 (i32.const 0x13))
  (global $TYPE_SYMBOL i32 (i32.const 0x20))
  (global $TYPE_EXPRESSION i32 (i32.const 0x21))
  (global $TYPE_PROMISE_RESOLVE i32 (i32.const 0x22))  ;; Promise executor's resolve continuation; data_lo = promise data pointer
  (global $TYPE_PROMISE_REJECT i32 (i32.const 0x23))   ;; Promise executor's reject continuation; data_lo = promise data pointer
  (global $TYPE_MAP i32 (i32.const 0x24))              ;; ES Map (slice 5)
  (global $TYPE_SET i32 (i32.const 0x25))              ;; ES Set (slice 5)
  (global $TYPE_ACCESSOR i32 (i32.const 0x26))         ;; getter/setter property value: data_lo = getter closure (0 = none), data_hi = setter closure (0 = none)
  (global $TYPE_MATRIX i32 (i32.const 0x27))           ;; Ring 4 matrix; data_lo = heap header pointer
  (global $TYPE_THEOREM i32 (i32.const 0x28))          ;; Ring 5 theorem; data_lo = heap header pointer; kernel-minted only
  (global $TYPE_ALGEBRAIC i32 (i32.const 0x29))        ;; Ring 6 real algebraic number; data_lo = heap header pointer
  (global $TYPE_COMPLEX_ALGEBRAIC i32 (i32.const 0x2A)) ;; Ring 7 exact non-real algebraic number
  (global $TYPE_REGEXP i32 (i32.const 0x2B))           ;; RegExp; data_lo = heap header pointer to the OBJ_REGEXP descriptor

  ;; Flag bit set on a TYPE_RATIONAL value slot when it carries an inline
  ;; i64 numerator in [data_lo:4][data_hi:4] with implicit denominator 1,
  ;; instead of pointing at a heap Rational object. Uses a high bit to
  ;; avoid collision with scope-entry flags (SCOPE_FLAG_CONST = 0x01).
  (global $FLAG_RATIONAL_INLINE i32 (i32.const 0x100))

  ;; Scratch global holding the i64 result of $bigint_to_i64_fits when it
  ;; returns true. Callers must read immediately after calling the function.
  (global $bigint_to_i64_value (mut i64) (i64.const 0))
  ;; Out-params of $decode_exact_slot_fraction (the allocation-free
  ;; exact-numeric comparison family): the decoded numerator and
  ;; denominator BigInt header pointers (real heap headers, or pseudo
  ;; headers staged in tail scratch for inline values).
  (global $fraction_decode_num (mut i32) (i32.const 0))
  (global $fraction_decode_den (mut i32) (i32.const 0))
  ;; Out-params of $term_factors_info (Ring 3 monomial machinery): the
  ;; first factor slot and factor-slot count of a term's non-coefficient
  ;; part.
  (global $term_factors_data (mut i32) (i32.const 0))
  (global $term_factors_count (mut i32) (i32.const 0))
  ;; Out-params of $sum_term_list (Ring 3 expansion): first term slot
  ;; and term count of an Add's summand list (or the value itself as a
  ;; single term).
  (global $sum_terms_data (mut i32) (i32.const 0))
  (global $sum_terms_count (mut i32) (i32.const 0))
  ;; Ring 3 (3b): set while Exact.Expression.expand drives a simplify —
  ;; disables the MAX_EXPANSION_TERMS cap so every distribution and
  ;; sum-power expansion fires regardless of predicted size.
  (global $expansion_cap_disabled (mut i32) (i32.const 0))

  ;; Promise status values
  (global $PROMISE_STATUS_PENDING i32 (i32.const 0))
  (global $PROMISE_STATUS_RESOLVED i32 (i32.const 1))
  (global $PROMISE_STATUS_REJECTED i32 (i32.const 2))

  ;; Promise layout (offsets from data pointer)
  (global $PROMISE_STATUS i32 (i32.const 0x00))  ;; 4 bytes
  (global $PROMISE_VALUE i32 (i32.const 0x04))   ;; 16 bytes (inline tagged value)
  (global $PROMISE_WAITERS i32 (i32.const 0x14)) ;; 4 bytes (head of waiter list, -1 for empty)
  (global $PROMISE_HANDLERS i32 (i32.const 0x18)) ;; 4 bytes (head of .then handler list, -1 for none)
  (global $PROMISE_DATA_SIZE i32 (i32.const 40))
  (global $PROMISE_WAITER_CONTEXT_SLOT i32 (i32.const 0x00))
  (global $PROMISE_WAITER_CONTEXT_GENERATION i32 (i32.const 0x04))
  (global $PROMISE_WAITER_NEXT i32 (i32.const 0x08))
  (global $PROMISE_WAITER_TOTAL_SIZE i32 (i32.const 32))

  ;; GC object types
  (global $OBJ_ARRAY i32 (i32.const 0))
  (global $OBJ_OBJECT i32 (i32.const 1))
  (global $OBJ_SCOPE i32 (i32.const 2))
  (global $OBJ_FUNCTION i32 (i32.const 3))
  (global $OBJ_ARRAY_DATA i32 (i32.const 5))
  (global $OBJ_CODE_BLOCK i32 (i32.const 6))
  (global $OBJ_OBJECT_DATA i32 (i32.const 7))
  (global $OBJ_ARRAYBUFFER i32 (i32.const 8))
  (global $OBJ_SCOPE_ENTRIES i32 (i32.const 9))
  (global $OBJ_TYPED_ARRAY_DESCRIPTOR i32 (i32.const 10))
  (global $OBJ_PROMISE i32 (i32.const 11))
  (global $OBJ_PROMISE_WAITER i32 (i32.const 30))
  (global $OBJ_BIGINT i32 (i32.const 13))
  (global $OBJ_RATIONAL i32 (i32.const 14))
  (global $OBJ_COMPLEX i32 (i32.const 15))
  (global $OBJ_SYMBOL i32 (i32.const 16))
  (global $OBJ_EXPRESSION i32 (i32.const 17))
  (global $OBJ_MAP i32 (i32.const 18))           ;; Map header data (slice 5)
  (global $OBJ_SET i32 (i32.const 19))           ;; Set header data
  (global $OBJ_MAP_ENTRIES i32 (i32.const 20))   ;; Map entries block (36 bytes/slot)
  (global $OBJ_SET_ENTRIES i32 (i32.const 21))   ;; Set entries block (20 bytes/slot)
  (global $OBJ_CONTEXT i32 (i32.const 22))       ;; Execution context object (state block)
  (global $OBJ_STACK_BLOCK i32 (i32.const 23))   ;; A context's stack storage block
  ;; Inert, pointer-free heap filler: a committed working buffer (the
  ;; expression walks' flatten/collect scratch) carved with a real GC
  ;; header so the collectors' linear header walks parse over it. Never
  ;; marked, so every collection reclaims it as plain garbage. Exists
  ;; because a headerless bump-carve below STATE_HEAP_POINTER tears the
  ;; forwarding walk and corrupts whatever live objects sit above it
  ;; (the gc-after-simplify pin in tests/fuel/expression_heap_walk_test.js).
  (global $OBJ_SCRATCH i32 (i32.const 24))
  ;; Ring 4 matrix: [rowCount:4][columnCount:4][entriesArrayPointer:4]
  ;; [reserved:4]. entriesArrayPointer is a frozen row-major Array
  ;; (HEADER pointer) — the same storage pattern as OBJ_EXPRESSION's
  ;; argument array.
  (global $OBJ_MATRIX i32 (i32.const 25))

  ;; Theorem layout (data-relative, after 8-byte GC header):
  ;;   [statementPointer:4][hypothesesArrayPointer:4][ruleTag:4]
  ;;   [premisesArrayPointer:4] = 16 bytes; object aligned to 32.
  ;; statement is an EXPRESSION header; hypotheses/premises are frozen
  ;; Arrays (HEADER pointers). Ring 5 (5b).
  (global $OBJ_THEOREM i32 (i32.const 26))
  (global $OBJ_ALGEBRAIC i32 (i32.const 27))
  (global $OBJ_COMPLEX_ALGEBRAIC i32 (i32.const 28))
  ;; Private native-continuation operation state:
  ;; [headerPointerMask:4][dataPointerMask:4][state0..state4:20].
  ;; Bit N declares how stateN is traced; masks must not overlap.
  (global $OBJ_NATIVE_CONTINUATION_STATE i32 (i32.const 29))
  (global $NATIVE_CONTINUATION_STATE_SIZE i32 (i32.const 40))
  (global $NATIVE_CONTINUATION_STATE_HEADER_MASK i32 (i32.const 0))
  (global $NATIVE_CONTINUATION_STATE_DATA_MASK i32 (i32.const 4))
  (global $NATIVE_CONTINUATION_STATE_VALUES i32 (i32.const 8))
  ;; RegExp descriptor layout (data-relative, after 8-byte GC header):
  ;;   [patternStringOffset:4][flagsBitfield:4][lastIndex:4]
  ;;   [programBufferDataPointer:4] = 16 bytes.
  ;; The pattern is an interned-string id; flags reuse the engine's
  ;; REGEX_FLAG bits; lastIndex counts Unicode scalar values; the program
  ;; pointer is a DATA pointer to an OBJ_ARRAYBUFFER holding the validated
  ;; engine program, zero until compilation commits.
  (global $OBJ_REGEXP i32 (i32.const 31))
  (global $REGEXP_PATTERN_STRING i32 (i32.const 0))
  (global $REGEXP_FLAGS i32 (i32.const 4))
  (global $REGEXP_LAST_INDEX i32 (i32.const 8))
  (global $REGEXP_PROGRAM_BUFFER i32 (i32.const 12))
  (global $REGEXP_SIZE i32 (i32.const 16))
  ;; Accepted flag bits — must match REGEX_FLAG in regex-engine-contract.js
  ;; (the parser emits the same bits into LIT_REGEXP's second operand).
  (global $REGEXP_FLAG_GLOBAL i32 (i32.const 1))
  (global $REGEXP_FLAG_IGNORE_CASE i32 (i32.const 2))
  (global $REGEXP_FLAG_MULTILINE i32 (i32.const 4))
  (global $REGEXP_FLAG_DOT_ALL i32 (i32.const 8))
  (global $REGEXP_FLAG_HAS_INDICES i32 (i32.const 32))
  (global $REGEXP_FLAG_STICKY i32 (i32.const 128))

