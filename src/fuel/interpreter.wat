    (local $j i32)
    (local $entry_pointer i32)
    (local $key_offset i32)
    (local $val_type i32)
    (local $val_flags i32)
    (local $val_lo i32)
    (local $val_hi i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $arg1_type (call $value_type (local.get $argument1_pointer)))
        (local.set $arg1_lo (call $value_data_lo (local.get $argument1_pointer)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))

    (if (i32.ne (local.get $arg1_type) (global.get $TYPE_OBJECT))
      (then
        (call $pending_push (local.get $arg1_type) (i32.const 0) (local.get $arg1_lo) (i32.const 0))
        (return (i32.const 0))
      )
    )

    (local.set $object_pointer (local.get $arg1_lo))

    (local.set $i (i32.const 1))
    (local.set $argument_pointer (i32.add (local.get $argument1_pointer) (global.get $VALUE_SIZE)))
    (block $sources_done
      (loop $sources_loop
        (br_if $sources_done (i32.ge_u (local.get $i) (local.get $argc)))

        (local.set $arg_type (call $value_type (local.get $argument_pointer)))

        (if (i32.eq (local.get $arg_type) (global.get $TYPE_MSGPACK_REF))
          (then
            (if (call $msgpack_assign_to_object
                  (local.get $object_pointer)
                  (call $msgpack_ref_absolute
                    (call $value_data_lo (local.get $argument_pointer))
                    (call $value_data_hi (local.get $argument_pointer)))
                  (call $msgpack_ref_parent_end
                    (call $value_data_lo (local.get $argument_pointer)))
                  (call $value_data_lo (local.get $argument_pointer)))
              (then (return (i32.const 0))))
          )
          (else
            (if (i32.eq (local.get $arg_type) (global.get $TYPE_OBJECT))
              (then
                (local.set $source_pointer (call $value_data_lo (local.get $argument_pointer)))
                (local.set $src_count (i32.load (call $abs (i32.add (local.get $source_pointer) (i32.const 12)))))
                (local.set $src_entries (i32.load (call $abs (i32.add (local.get $source_pointer) (i32.const 24)))))

                (local.set $j (i32.const 0))
                (block $entries_done
                  (loop $entries_loop
                    (br_if $entries_done (i32.ge_u (local.get $j) (local.get $src_count)))

                    (local.set $entry_pointer (i32.add
                      (i32.add (local.get $src_entries) (global.get $GC_HEADER_SIZE))
                      (i32.mul (local.get $j) (global.get $ENTRY_SIZE))))

                    (local.set $key_offset (i32.load (call $abs (local.get $entry_pointer))))

                    ;; '@'-prefixed keys are hidden (non-enumerable).
                    (if (call $string_key_is_hidden (local.get $key_offset))
                      (then
                        (local.set $j (i32.add (local.get $j) (i32.const 1)))
                        (br $entries_loop)))
                    (local.set $val_type (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 4)))))
                    (local.set $val_flags (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 8)))))
                    (local.set $val_lo (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 12)))))
                    (local.set $val_hi (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 16)))))

                    (if (i32.eq (local.get $val_type) (global.get $TYPE_ACCESSOR))
                      (then
                        (if (call $throw_type_error_with_type
                              (global.get $BUILTIN_MSG_ACCESSOR_UNSUPPORTED) (global.get $TYPE_ACCESSOR))
                          (then (return (i32.const 2)))
                          (else (return (i32.const 1)))
                        )
                      )
                    )

                    (if (call $check_heap_overflow (call $estimate_object_grow_size
                          (i32.load (call $abs (i32.add (local.get $object_pointer) (i32.const 16))))))
                      (then (return (i32.const 0))))
                    ;; Grow pre-budgeted just above — status droppable.
                    (drop (call $object_set_property
                      (local.get $object_pointer)
                      (local.get $key_offset)
                      (local.get $val_type)
                      (local.get $val_flags)
                      (local.get $val_lo)
                      (local.get $val_hi)))

                    (local.set $j (i32.add (local.get $j) (i32.const 1)))
                    (br $entries_loop)
                  )
                )

                (local.set $src_entries
                  (i32.load (call $abs (i32.add (local.get $source_pointer) (global.get $OBJECT_SYM_ENTRIES_OFFSET)))))
                (if (i32.ne (local.get $src_entries) (i32.const 0))
                  (then
                    (local.set $src_count (i32.load (call $abs (i32.add (local.get $src_entries) (i32.const 8)))))
                    (local.set $j (i32.const 0))
                    (block $sym_entries_done
                      (loop $sym_entries_loop
                        (br_if $sym_entries_done (i32.ge_u (local.get $j) (local.get $src_count)))
                        (local.set $entry_pointer (i32.add
                          (i32.add (local.get $src_entries) (i32.const 16))
                          (i32.mul (local.get $j) (global.get $ENTRY_SIZE))))
                        (if (call $sym_block_set
                              (i32.add (local.get $object_pointer) (global.get $OBJECT_SYM_ENTRIES_OFFSET))
                              (i32.load (call $abs (local.get $entry_pointer)))
                              (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 4))))
                              (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 8))))
                              (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 12))))
                              (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 16)))))
                          (then (return (i32.const 0))))
                        (local.set $j (i32.add (local.get $j) (i32.const 1)))
                        (br $sym_entries_loop)
                      )
                    )
                  )
                )
              )
            )
          )
        )

        (local.set $argument_pointer (i32.add (local.get $argument_pointer) (global.get $VALUE_SIZE)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $sources_loop)
      )
    )

    (call $pending_push (global.get $TYPE_OBJECT) (i32.const 0) (local.get $object_pointer) (i32.const 0))
    (return (i32.const 0))
  )

  (func $array_is_array
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $arg1_type i32)
    (local $arg1_lo i32)
    (local $arg1_hi i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
