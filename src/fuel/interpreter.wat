                        (i32.add (local.get $data_pointer) (global.get $VALUE_SIZE)))
                      (i32.load (call $abs (i32.add
                        (i32.add (local.get $data_pointer) (global.get $VALUE_SIZE))
                        (i32.const 4))))
                      (call $value_data_lo
                        (i32.add (local.get $data_pointer) (global.get $VALUE_SIZE)))
                      (call $value_data_hi
                        (i32.add (local.get $data_pointer) (global.get $VALUE_SIZE))))
