  (func $has_own_property_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $actual_receiver_type i32)
    (local $actual_receiver_pointer i32)
    (local $key_offset i32)
    (local $object_pointer i32)
    (local $count i32)
    (local $entries_pointer i32)
    (local $found i32)
    (local $i i32)
    (local $entry_pointer i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))

    (local.set $actual_receiver_type (call $value_type (local.get $stack_base)))
    (local.set $actual_receiver_pointer (call $value_data_lo (local.get $stack_base)))

    (if (i32.ne (local.get $actual_receiver_type) (global.get $TYPE_OBJECT))
      (then
        (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (i32.const 0) (i32.const 0))
        (return (i32.const 0))
      )
    )

    (local.set $key_offset (call $value_to_string (local.get $argument1_pointer)))

    (local.set $object_pointer (local.get $actual_receiver_pointer))
    (local.set $count (i32.load (call $abs (i32.add (local.get $object_pointer) (i32.const 12)))))
    (local.set $entries_pointer (i32.load (call $abs (i32.add (local.get $object_pointer) (i32.const 24)))))

    (local.set $found (i32.const 0))
    (local.set $i (i32.const 0))
    (block $search_done
      (loop $search_loop
        (br_if $search_done (i32.ge_u (local.get $i) (local.get $count)))

        (local.set $entry_pointer (i32.add
          (i32.add (local.get $entries_pointer) (global.get $GC_HEADER_SIZE))
          (i32.mul (local.get $i) (global.get $ENTRY_SIZE))))

        (if (i32.eq
              (i32.load (call $abs (local.get $entry_pointer)))
              (local.get $key_offset))
