                    ;; ArrayBuffer layout: [GC:8][byteLength:4][bytes...]
                    ;; buffer_ptr points after GC header, so bytes start at buffer_ptr + 4
                    (local.set $data_pointer (i32.load (call $abs (local.get $heap_pointer))))
                    ;; byte_addr = buffer_ptr + 4 + index * bytes_per_element
                    (local.set $element_pointer (i32.add
                      (i32.add (local.get $data_pointer) (i32.const 4))
                      (i32.mul (local.get $index) (call $get_bytes_per_element (local.get $receiver_type)))))
                    ;; Convert result to f64 and write using typed element writer
                    (if (i32.eq (local.get $result_type) (global.get $TYPE_FLOAT))
                      (then
                        (local.set $float_result (f64.reinterpret_i64
                          (i64.or
                            (i64.extend_i32_u (local.get $result_lo))
                            (i64.shl (i64.extend_i32_u (local.get $result_hi)) (i64.const 32)))))
                      )
                      (else
                        ;; Handle integer or other - convert to f64
                        (local.set $float_result (f64.convert_i32_s (local.get $result_lo)))
                      )
                    )
                    (call $write_typed_element (local.get $receiver_type) (call $abs (local.get $element_pointer)) (local.get $float_result))
                  )
                )

                (if (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ARRAY_FILTER))
                  (then
                    ;; filter: if result is truthy, append current element to result array
                    (if (call $is_truthy_inline (local.get $result_type) (local.get $result_flags) (local.get $result_lo) (local.get $result_hi))
                      (then
                        ;; Get current element from source array
                        ;; data_pointer points to start of data block (includes GC header), add 8 to skip it
                        (local.set $data_pointer (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 16)))))
                        (local.set $element_pointer (i32.add
                          (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
                          (i32.mul (local.get $index) (global.get $VALUE_SIZE))))

                        ;; Get result array length
                        (local.set $count (i32.load (call $abs (i32.add (local.get $heap_pointer) (i32.const 8)))))

                        ;; Write element to result array at position count
                        (local.set $new_data_pointer (i32.load (call $abs (i32.add (local.get $heap_pointer) (i32.const 16)))))
                        (local.set $dest (i32.add
                          (i32.add (local.get $new_data_pointer) (global.get $GC_HEADER_SIZE))
                          (i32.mul (local.get $count) (global.get $VALUE_SIZE))))
                        (call $write_value (local.get $dest)
                          (call $value_type (local.get $element_pointer))
                          (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 4))))
                          (call $value_data_lo (local.get $element_pointer))
                          (call $value_data_hi (local.get $element_pointer)))

                        ;; Increment result array length
                        (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 8)))
                          (i32.add (local.get $count) (i32.const 1)))
                      )
                    )
                  )
                )

                (if (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_TYPED_ARRAY_FILTER))
                  (then
                    ;; Typed array filter: if result is truthy, append current element to result buffer
                    (if (call $is_truthy_inline (local.get $result_type) (local.get $result_flags) (local.get $result_lo) (local.get $result_hi))
                      (then
                        ;; Get current element from source typed array
                        ;; array_pointer is descriptor: [buffer_ptr:4][byte_offset:4][length:4]
                        ;; ArrayBuffer layout: [GC:8][byteLength:4][bytes...]
                        ;; buffer_ptr points after GC header, so bytes start at buffer_ptr + 4
                        (local.set $data_pointer (i32.load (call $abs (local.get $array_pointer))))
                        (local.set $operand2 (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 4)))))
                        ;; byte_addr = buffer_ptr + 4 + byte_offset + index * bytes_per_element
                        (local.set $element_pointer (i32.add
                          (i32.add
                            (i32.add (local.get $data_pointer) (i32.const 4))
                            (local.get $operand2))
                          (i32.mul (local.get $index) (call $get_bytes_per_element (local.get $receiver_type)))))

                        ;; Read element value
                        (local.set $float_result (call $read_typed_element (local.get $receiver_type) (call $abs (local.get $element_pointer))))

                        ;; Get result buffer current count from descriptor length (element count)
                        (local.set $count (i32.load (call $abs (i32.add (local.get $heap_pointer) (i32.const 8)))))

                        ;; Get result buffer base (buffer_ptr + 4 to skip byteLength)
                        ;; dest_byte_addr = buffer_ptr + 4 + count * bytes_per_element
                        (local.set $new_data_pointer (i32.load (call $abs (local.get $heap_pointer))))
                        (local.set $dest (i32.add
                          (i32.add (local.get $new_data_pointer) (i32.const 4))
                          (i32.mul (local.get $count) (call $get_bytes_per_element (local.get $receiver_type)))))

                        ;; Write element
                        (call $write_typed_element (local.get $receiver_type) (call $abs (local.get $dest)) (local.get $float_result))

                        ;; Increment result descriptor length (element count)
                        (i32.store (call $abs (i32.add (local.get $heap_pointer) (i32.const 8)))
                          (i32.add (local.get $count) (i32.const 1)))
                      )
                    )
                  )
                )

                (if (i32.or (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ARRAY_REDUCE)) (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ARRAY_REDUCE_RIGHT)))
                  (then
                    ;; reduce: store result as new accumulator
                    ;; heap_pointer is accumulator array, data_pointer at offset 16 (includes GC header)
                    (local.set $data_pointer (i32.load (call $abs (i32.add (local.get $heap_pointer) (i32.const 16)))))
                    (call $write_value (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
                      (local.get $result_type) (local.get $result_flags)
                      (local.get $result_lo) (local.get $result_hi))
                  )
                )

                ;; Uint8Array reduce uses same accumulator storage as Array reduce
                (if (i32.or
                      (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_TYPED_ARRAY_REDUCE))
                      (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_TYPED_ARRAY_REDUCE_RIGHT)))
                  (then
                    ;; reduce: store result as new accumulator
                    ;; heap_pointer is accumulator array, data_pointer at offset 16 (includes GC header)
                    (local.set $data_pointer (i32.load (call $abs (i32.add (local.get $heap_pointer) (i32.const 16)))))
                    (call $write_value (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
                      (local.get $result_type) (local.get $result_flags)
                      (local.get $result_lo) (local.get $result_hi))
                  )
                )

                ;; forEach: no result processing needed

                (if (i32.or
                      (i32.or
                        (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ARRAY_FIND))
                        (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_TYPED_ARRAY_FIND)))
                      (i32.or
                        (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ARRAY_FIND_LAST))
                        (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_TYPED_ARRAY_FIND_LAST))))
                  (then
                    ;; find/findLast: if result is truthy, return the element
                    (if (call $is_truthy_inline (local.get $result_type) (local.get $result_flags) (local.get $result_lo) (local.get $result_hi))
                      (then
                        ;; Pop iteration frame
                        (local.set $stack_pointer (i32.sub (local.get $stack_pointer) (global.get $FRAME_SIZE)))
                        (call $write_ctx (global.get $CTX_CALL_STACK_POINTER) (local.get $stack_pointer))

                        ;; Restore from iteration frame
                        (local.set $code_block (call $read_state (global.get $STATE_CODE_BLOCK)))
                        (local.set $return_pc (i32.load (i32.add (local.get $frame_pointer) (global.get $FRAME_INSTRUCTION_INDEX))))
                        (local.set $caller_scope (i32.load (i32.add (local.get $frame_pointer) (global.get $FRAME_SCOPE_POINTER))))
                        (call $write_ctx (global.get $CTX_PENDING_POINTER)
                          (call $load_frame_pending_base (local.get $frame_pointer)))
                        (global.set $current_scope (local.get $caller_scope))

                        ;; Push found element as result
                        (if (i32.or
                              (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_TYPED_ARRAY_FIND))
                              (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_TYPED_ARRAY_FIND_LAST)))
                          (then
                            ;; Typed array: return element as number
                            ;; ArrayBuffer layout: [GC:8][byteLength:4][bytes...]
                            ;; buffer_ptr points after GC header, so bytes start at buffer_ptr + 4
                            (local.set $data_pointer (i32.load (call $abs (local.get $array_pointer))))
                            (local.set $operand2 (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 4)))))
                            ;; byte_addr = buffer_ptr + 4 + byte_offset + index * bytes_per_element
                            (local.set $element_pointer (i32.add
                              (i32.add
                                (i32.add (local.get $data_pointer) (i32.const 4))
                                (local.get $operand2))
                              (i32.mul (local.get $index) (call $get_bytes_per_element (local.get $receiver_type)))))
                            (call $push_f64 (call $read_typed_element (local.get $receiver_type) (call $abs (local.get $element_pointer))))
                          )
                          (else
                            ;; Array: Get current element (data_pointer includes GC header, add 8 to skip)
                            (local.set $data_pointer (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 16)))))
                            (local.set $element_pointer (i32.add
                              (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
                              (i32.mul (local.get $index) (global.get $VALUE_SIZE))))
                            (call $pending_push
                              (call $value_type (local.get $element_pointer))
                              (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 4))))
                              (call $value_data_lo (local.get $element_pointer))
                              (call $value_data_hi (local.get $element_pointer)))
                          )
                        )

                        (local.set $instr_count (call $read_instr_count (local.get $code_block)))
                        (local.set $pc (local.get $return_pc))
                        (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                        (br $loop)
                      )
                    )
                  )
                )

                (if (i32.or
                      (i32.or
                        (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ARRAY_FIND_INDEX))
                        (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_TYPED_ARRAY_FIND_INDEX)))
                      (i32.or
                        (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ARRAY_FIND_LAST_INDEX))
                        (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_TYPED_ARRAY_FIND_LAST_INDEX))))
                  (then
                    ;; findIndex/findLastIndex: if result is truthy, return the index
                    (if (call $is_truthy_inline (local.get $result_type) (local.get $result_flags) (local.get $result_lo) (local.get $result_hi))
                      (then
                        ;; Pop iteration frame
                        (local.set $stack_pointer (i32.sub (local.get $stack_pointer) (global.get $FRAME_SIZE)))
                        (call $write_ctx (global.get $CTX_CALL_STACK_POINTER) (local.get $stack_pointer))

                        ;; Restore from iteration frame
                        (local.set $code_block (call $read_state (global.get $STATE_CODE_BLOCK)))
                        (local.set $return_pc (i32.load (i32.add (local.get $frame_pointer) (global.get $FRAME_INSTRUCTION_INDEX))))
                        (local.set $caller_scope (i32.load (i32.add (local.get $frame_pointer) (global.get $FRAME_SCOPE_POINTER))))
                        (call $write_ctx (global.get $CTX_PENDING_POINTER)
                          (call $load_frame_pending_base (local.get $frame_pointer)))
                        (global.set $current_scope (local.get $caller_scope))

                        ;; Push index as result (as float for consistency)
                        (call $push_f64 (f64.convert_i32_s (local.get $index)))

                        (local.set $instr_count (call $read_instr_count (local.get $code_block)))
                        (local.set $pc (local.get $return_pc))
                        (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                        (br $loop)
                      )
                    )
                  )
                )

                (if (i32.or
                      (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ARRAY_SOME))
                      (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_TYPED_ARRAY_SOME)))
                  (then
                    ;; some: if result is truthy, return true
                    (if (call $is_truthy_inline (local.get $result_type) (local.get $result_flags) (local.get $result_lo) (local.get $result_hi))
                      (then
                        ;; Pop iteration frame
                        (local.set $stack_pointer (i32.sub (local.get $stack_pointer) (global.get $FRAME_SIZE)))
                        (call $write_ctx (global.get $CTX_CALL_STACK_POINTER) (local.get $stack_pointer))

                        ;; Restore from iteration frame
                        (local.set $code_block (call $read_state (global.get $STATE_CODE_BLOCK)))
                        (local.set $return_pc (i32.load (i32.add (local.get $frame_pointer) (global.get $FRAME_INSTRUCTION_INDEX))))
                        (local.set $caller_scope (i32.load (i32.add (local.get $frame_pointer) (global.get $FRAME_SCOPE_POINTER))))
                        (call $write_ctx (global.get $CTX_PENDING_POINTER)
                          (call $load_frame_pending_base (local.get $frame_pointer)))
                        (global.set $current_scope (local.get $caller_scope))

                        ;; Push true
                        (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (i32.const 1) (i32.const 0))

                        (local.set $instr_count (call $read_instr_count (local.get $code_block)))
                        (local.set $pc (local.get $return_pc))
                        (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                        (br $loop)
                      )
                    )
                  )
                )

                (if (i32.or
                      (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ARRAY_EVERY))
                      (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_TYPED_ARRAY_EVERY)))
                  (then
                    ;; every: if result is falsy, return false
                    (if (i32.eqz (call $is_truthy_inline (local.get $result_type) (local.get $result_flags) (local.get $result_lo) (local.get $result_hi)))
                      (then
                        ;; Pop iteration frame
                        (local.set $stack_pointer (i32.sub (local.get $stack_pointer) (global.get $FRAME_SIZE)))
                        (call $write_ctx (global.get $CTX_CALL_STACK_POINTER) (local.get $stack_pointer))

                        ;; Restore from iteration frame
                        (local.set $code_block (call $read_state (global.get $STATE_CODE_BLOCK)))
                        (local.set $return_pc (i32.load (i32.add (local.get $frame_pointer) (global.get $FRAME_INSTRUCTION_INDEX))))
                        (local.set $caller_scope (i32.load (i32.add (local.get $frame_pointer) (global.get $FRAME_SCOPE_POINTER))))
                        (call $write_ctx (global.get $CTX_PENDING_POINTER)
                          (call $load_frame_pending_base (local.get $frame_pointer)))
                        (global.set $current_scope (local.get $caller_scope))

                        ;; Push false
                        (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (i32.const 0) (i32.const 0))

                        (local.set $instr_count (call $read_instr_count (local.get $code_block)))
                        (local.set $pc (local.get $return_pc))
                        (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                        (br $loop)
                      )
                    )
                  )
                )

                ;; Sort comparator RETURN handler
                (if (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ARRAY_SORT))
                  (then
                    ;; Read comparator result as f64
                    (local.set $float_result (call $value_to_f64 (local.get $value_pointer)))
                    ;; Read the sort inner index from operation-owned state.
                    (local.set $operand2
                      (call $native_continuation_state_get
                        (local.get $state_handle) (i32.const 4)))
                    (local.set $data_pointer (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 16)))))

                    (if (f64.lt (local.get $float_result) (f64.const 0))
                      (then
                        ;; Comparator < 0: key should come before arr[j], shift arr[j] right
                        (local.set $element_pointer (i32.add
                          (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
                          (i32.mul (local.get $operand2) (global.get $VALUE_SIZE))))
                        (local.set $dest (i32.add
                          (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
                          (i32.mul (i32.add (local.get $operand2) (i32.const 1)) (global.get $VALUE_SIZE))))
                        (i32.store (call $abs (local.get $dest)) (i32.load (call $abs (local.get $element_pointer))))
                        (i32.store (call $abs (i32.add (local.get $dest) (i32.const 4)))
                          (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 4)))))
                        (i32.store (call $abs (i32.add (local.get $dest) (i32.const 8)))
                          (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 8)))))
                        (i32.store (call $abs (i32.add (local.get $dest) (i32.const 12)))
                          (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 12)))))

                        ;; Decrement j
                        (local.set $operand2 (i32.sub (local.get $operand2) (i32.const 1)))
                        (call $native_continuation_state_set
                          (local.get $state_handle) (i32.const 4)
                          (local.get $operand2))

                        (if (i32.ge_s (local.get $operand2) (i32.const 0))
                          (then
                            ;; More comparisons needed: call comparator(key, arr[j])
                            (call $write_ctx (global.get $CTX_PENDING_POINTER)
                              (call $load_frame_pending_base (local.get $frame_pointer)))
                            (local.set $param_count (call $callback_staged_argc (local.get $closure_pointer) (i32.const 2)))
                            ;; Push key from temp array
                            (local.set $dest (i32.add
                              (i32.load (call $abs (i32.add (local.get $heap_pointer) (i32.const 16))))
                              (global.get $GC_HEADER_SIZE)))
                            (if (i32.ge_u (local.get $param_count) (i32.const 1))
                              (then
                                (call $pending_push
                                  (call $value_type (local.get $dest))
                                  (i32.load (call $abs (i32.add (local.get $dest) (i32.const 4))))
                                  (call $value_data_lo (local.get $dest))
                                  (call $value_data_hi (local.get $dest)))
                              )
                            )
                            ;; Push arr[j]
                            (if (i32.ge_u (local.get $param_count) (i32.const 2))
                              (then
                                (local.set $element_pointer (i32.add
                                  (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
                                  (i32.mul (local.get $operand2) (global.get $VALUE_SIZE))))
                                (call $pending_push
                                  (call $value_type (local.get $element_pointer))
                                  (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 4))))
                                  (call $value_data_lo (local.get $element_pointer))
                                  (call $value_data_hi (local.get $element_pointer)))
                              )
                            )
                            (local.set $captured_scope (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 40)))))
                            (local.set $closure_flags (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 44)))))
                            (local.set $new_scope (call $scope_create (local.get $captured_scope)))
                            (global.set $current_scope (local.get $new_scope))
                            (if (i32.eqz (i32.and (local.get $closure_flags) (global.get $CLOSURE_FLAG_ARROW)))
                              (then
                                (call $scope_define (local.get $new_scope)
                                  (call $read_builtin (i32.const 0x18))
                                  (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))
                                (call $scope_define_new_target (local.get $new_scope)
                                  (global.get $TYPE_UNDEFINED) (i32.const 0))
                              )
                            )
                            (local.set $pc (i32.load (call $abs (i32.add (local.get $closure_pointer) (global.get $FUNCTION_CLOSURE_OFFSET)))))
                            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                            (br $loop)
                          )
                        )
                      )
                    )

                    ;; Comparator <= 0 or j < 0: place key at arr[j+1]
                    (local.set $dest (i32.add
                      (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
                      (i32.mul (i32.add (local.get $operand2) (i32.const 1)) (global.get $VALUE_SIZE))))
                    ;; Copy key from temp array
                    (local.set $element_pointer (i32.add
                      (i32.load (call $abs (i32.add (local.get $heap_pointer) (i32.const 16))))
                      (global.get $GC_HEADER_SIZE)))
                    (i32.store (call $abs (local.get $dest)) (i32.load (call $abs (local.get $element_pointer))))
                    (i32.store (call $abs (i32.add (local.get $dest) (i32.const 4)))
                      (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 4)))))
                    (i32.store (call $abs (i32.add (local.get $dest) (i32.const 8)))
                      (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 8)))))
                    (i32.store (call $abs (i32.add (local.get $dest) (i32.const 12)))
                      (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 12)))))

                    ;; Advance outer i
                    (local.set $index (i32.add (local.get $index) (i32.const 1)))
                    (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_CONTINUATION_PHASE)) (local.get $index))

                    (if (i32.lt_u (local.get $index) (local.get $arr_len))
                      (then
                        ;; Save new key = arr[i] into temp
                        (local.set $element_pointer (i32.add
                          (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
                          (i32.mul (local.get $index) (global.get $VALUE_SIZE))))
                        (local.set $dest (i32.add
                          (i32.load (call $abs (i32.add (local.get $heap_pointer) (i32.const 16))))
                          (global.get $GC_HEADER_SIZE)))
                        (i32.store (call $abs (local.get $dest)) (i32.load (call $abs (local.get $element_pointer))))
                        (i32.store (call $abs (i32.add (local.get $dest) (i32.const 4)))
                          (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 4)))))
                        (i32.store (call $abs (i32.add (local.get $dest) (i32.const 8)))
                          (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 8)))))
                        (i32.store (call $abs (i32.add (local.get $dest) (i32.const 12)))
                          (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 12)))))

                        ;; Set j = i - 1
                        (local.set $operand2 (i32.sub (local.get $index) (i32.const 1)))
                        (call $native_continuation_state_set
                          (local.get $state_handle) (i32.const 4)
                          (local.get $operand2))

                        ;; Call comparator(key, arr[j])
                        (call $write_ctx (global.get $CTX_PENDING_POINTER)
                          (call $load_frame_pending_base (local.get $frame_pointer)))
                        (local.set $param_count (call $callback_staged_argc (local.get $closure_pointer) (i32.const 2)))
                        (if (i32.ge_u (local.get $param_count) (i32.const 1))
                          (then
                            (call $pending_push
                              (call $value_type (local.get $dest))
                              (i32.load (call $abs (i32.add (local.get $dest) (i32.const 4))))
                              (call $value_data_lo (local.get $dest))
                              (call $value_data_hi (local.get $dest)))
                          )
                        )
                        (if (i32.ge_u (local.get $param_count) (i32.const 2))
                          (then
                            (local.set $element_pointer (i32.add
                              (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
                              (i32.mul (local.get $operand2) (global.get $VALUE_SIZE))))
                            (call $pending_push
                              (call $value_type (local.get $element_pointer))
                              (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 4))))
                              (call $value_data_lo (local.get $element_pointer))
                              (call $value_data_hi (local.get $element_pointer)))
                          )
                        )
                        (local.set $captured_scope (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 40)))))
                        (local.set $closure_flags (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 44)))))
                        (local.set $new_scope (call $scope_create (local.get $captured_scope)))
                        (global.set $current_scope (local.get $new_scope))
                        (if (i32.eqz (i32.and (local.get $closure_flags) (global.get $CLOSURE_FLAG_ARROW)))
                          (then
                            (call $scope_define (local.get $new_scope)
                              (call $read_builtin (i32.const 0x18))
                              (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))
                            (call $scope_define_new_target (local.get $new_scope)
                              (global.get $TYPE_UNDEFINED) (i32.const 0))
                          )
                        )
                        (local.set $pc (i32.load (call $abs (i32.add (local.get $closure_pointer) (global.get $FUNCTION_CLOSURE_OFFSET)))))
                        (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                        (br $loop)
                      )
                      (else
                        ;; Sort complete — pop frame, return sorted array
                        (local.set $stack_pointer (i32.sub
                          (call $read_ctx (global.get $CTX_CALL_STACK_POINTER))
                          (global.get $FRAME_SIZE)))
                        (call $write_ctx (global.get $CTX_CALL_STACK_POINTER) (local.get $stack_pointer))
                        (call $write_ctx (global.get $CTX_PENDING_POINTER)
                          (call $load_frame_pending_base (local.get $frame_pointer)))
                        (global.set $current_scope
                          (i32.load (i32.add (local.get $frame_pointer) (global.get $FRAME_SCOPE_POINTER))))
                        (call $pending_push (global.get $TYPE_ARRAY) (i32.const 0) (local.get $array_pointer) (i32.const 0))
                        (local.set $pc (i32.load (i32.add (local.get $frame_pointer) (global.get $FRAME_INSTRUCTION_INDEX))))
                        (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                        (br $loop)
                      )
                    )
                  )
                )

                ;; Typed-array sort with comparator — same insertion-sort
                ;; walk as METHOD_SORT above, but elements live in the
                ;; descriptor's typed window (read/write via
                ;; $read_typed_element/$write_typed_element) and the key
                ;; temp array holds a TYPE_FLOAT value. array_pointer is
                ;; the DESCRIPTOR pointer here; heap_pointer the temp.
                (if (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_TYPED_ARRAY_SORT))
                  (then
                    ;; Read comparator result as f64
                    (local.set $float_result (call $value_to_f64 (local.get $value_pointer)))
                    ;; Read the sort inner index from operation-owned state.
                    (local.set $operand2
                      (call $native_continuation_state_get
                        (local.get $state_handle) (i32.const 4)))
                    ;; Element base = buffer_ptr + 4 (past byteLength) + byte_offset
                    (local.set $data_pointer (i32.add
                      (i32.add (i32.load (call $abs (local.get $array_pointer))) (i32.const 4))
                      (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 4))))))

                    (if (f64.lt (local.get $float_result) (f64.const 0))
                      (then
                        ;; Comparator < 0: key should come before arr[j], shift arr[j] right
                        (call $write_typed_element (local.get $receiver_type)
                          (call $abs (i32.add (local.get $data_pointer)
                            (i32.mul (i32.add (local.get $operand2) (i32.const 1))
                              (call $get_bytes_per_element (local.get $receiver_type)))))
                          (call $read_typed_element (local.get $receiver_type)
                            (call $abs (i32.add (local.get $data_pointer)
                              (i32.mul (local.get $operand2)
                                (call $get_bytes_per_element (local.get $receiver_type)))))))

                        ;; Decrement j
                        (local.set $operand2 (i32.sub (local.get $operand2) (i32.const 1)))
                        (call $native_continuation_state_set
                          (local.get $state_handle) (i32.const 4)
                          (local.get $operand2))

                        (if (i32.ge_s (local.get $operand2) (i32.const 0))
                          (then
                            ;; More comparisons needed: call comparator(key, arr[j])
                            (call $write_ctx (global.get $CTX_PENDING_POINTER)
                              (call $load_frame_pending_base (local.get $frame_pointer)))
                            (local.set $param_count (call $callback_staged_argc (local.get $closure_pointer) (i32.const 2)))
                            ;; Push key from temp array
                            (local.set $dest (i32.add
                              (i32.load (call $abs (i32.add (local.get $heap_pointer) (i32.const 16))))
                              (global.get $GC_HEADER_SIZE)))
                            (if (i32.ge_u (local.get $param_count) (i32.const 1))
                              (then
                                (call $pending_push
                                  (call $value_type (local.get $dest))
                                  (i32.load (call $abs (i32.add (local.get $dest) (i32.const 4))))
                                  (call $value_data_lo (local.get $dest))
                                  (call $value_data_hi (local.get $dest)))
                              )
                            )
                            ;; Push arr[j]
                            (if (i32.ge_u (local.get $param_count) (i32.const 2))
                              (then
                                (call $push_f64 (call $read_typed_element (local.get $receiver_type)
                                  (call $abs (i32.add (local.get $data_pointer)
                                    (i32.mul (local.get $operand2)
                                      (call $get_bytes_per_element (local.get $receiver_type)))))))
                              )
                            )
                            (local.set $captured_scope (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 40)))))
                            (local.set $closure_flags (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 44)))))
                            (local.set $new_scope (call $scope_create (local.get $captured_scope)))
                            (global.set $current_scope (local.get $new_scope))
                            (if (i32.eqz (i32.and (local.get $closure_flags) (global.get $CLOSURE_FLAG_ARROW)))
                              (then
                                (call $scope_define (local.get $new_scope)
                                  (call $read_builtin (i32.const 0x18))
                                  (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))
                                (call $scope_define_new_target (local.get $new_scope)
                                  (global.get $TYPE_UNDEFINED) (i32.const 0))
                              )
                            )
                            (local.set $pc (i32.load (call $abs (i32.add (local.get $closure_pointer) (global.get $FUNCTION_CLOSURE_OFFSET)))))
                            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                            (br $loop)
                          )
                        )
                      )
                    )

                    ;; Comparator >= 0 (or NaN) or j < 0: place key at arr[j+1]
                    (local.set $element_pointer (i32.add
                      (i32.load (call $abs (i32.add (local.get $heap_pointer) (i32.const 16))))
                      (global.get $GC_HEADER_SIZE)))
                    (call $write_typed_element (local.get $receiver_type)
                      (call $abs (i32.add (local.get $data_pointer)
                        (i32.mul (i32.add (local.get $operand2) (i32.const 1))
                          (call $get_bytes_per_element (local.get $receiver_type)))))
                      (call $value_to_f64 (local.get $element_pointer)))

                    ;; Advance outer i
                    (local.set $index (i32.add (local.get $index) (i32.const 1)))
                    (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_CONTINUATION_PHASE)) (local.get $index))

                    (if (i32.lt_u (local.get $index) (local.get $arr_len))
                      (then
                        ;; Save new key = arr[i] into temp as a TYPE_FLOAT value
                        (local.set $float_result (call $read_typed_element (local.get $receiver_type)
                          (call $abs (i32.add (local.get $data_pointer)
                            (i32.mul (local.get $index)
                              (call $get_bytes_per_element (local.get $receiver_type)))))))
                        (local.set $dest (i32.add
                          (i32.load (call $abs (i32.add (local.get $heap_pointer) (i32.const 16))))
                          (global.get $GC_HEADER_SIZE)))
                        (i32.store (call $abs (local.get $dest)) (global.get $TYPE_FLOAT))
                        (i32.store (call $abs (i32.add (local.get $dest) (i32.const 4))) (i32.const 0))
                        (i32.store (call $abs (i32.add (local.get $dest) (i32.const 8)))
                          (i32.wrap_i64 (i64.reinterpret_f64 (local.get $float_result))))
                        (i32.store (call $abs (i32.add (local.get $dest) (i32.const 12)))
                          (i32.wrap_i64 (i64.shr_u (i64.reinterpret_f64 (local.get $float_result)) (i64.const 32))))

                        ;; Set j = i - 1
                        (local.set $operand2 (i32.sub (local.get $index) (i32.const 1)))
                        (call $native_continuation_state_set
                          (local.get $state_handle) (i32.const 4)
                          (local.get $operand2))

                        ;; Call comparator(key, arr[j])
                        (call $write_ctx (global.get $CTX_PENDING_POINTER)
                          (call $load_frame_pending_base (local.get $frame_pointer)))
                        (local.set $param_count (call $callback_staged_argc (local.get $closure_pointer) (i32.const 2)))
                        (if (i32.ge_u (local.get $param_count) (i32.const 1))
                          (then
                            (call $pending_push
                              (call $value_type (local.get $dest))
                              (i32.load (call $abs (i32.add (local.get $dest) (i32.const 4))))
                              (call $value_data_lo (local.get $dest))
                              (call $value_data_hi (local.get $dest)))
                          )
                        )
                        (if (i32.ge_u (local.get $param_count) (i32.const 2))
                          (then
                            (call $push_f64 (call $read_typed_element (local.get $receiver_type)
                              (call $abs (i32.add (local.get $data_pointer)
                                (i32.mul (local.get $operand2)
                                  (call $get_bytes_per_element (local.get $receiver_type)))))))
                          )
                        )
                        (local.set $captured_scope (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 40)))))
                        (local.set $closure_flags (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 44)))))
                        (local.set $new_scope (call $scope_create (local.get $captured_scope)))
                        (global.set $current_scope (local.get $new_scope))
                        (if (i32.eqz (i32.and (local.get $closure_flags) (global.get $CLOSURE_FLAG_ARROW)))
                          (then
                            (call $scope_define (local.get $new_scope)
                              (call $read_builtin (i32.const 0x18))
                              (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))
                            (call $scope_define_new_target (local.get $new_scope)
                              (global.get $TYPE_UNDEFINED) (i32.const 0))
                          )
                        )
                        (local.set $pc (i32.load (call $abs (i32.add (local.get $closure_pointer) (global.get $FUNCTION_CLOSURE_OFFSET)))))
                        (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                        (br $loop)
                      )
                      (else
                        ;; Sort complete — pop frame, return the typed array
                        (local.set $stack_pointer (i32.sub
                          (call $read_ctx (global.get $CTX_CALL_STACK_POINTER))
                          (global.get $FRAME_SIZE)))
                        (call $write_ctx (global.get $CTX_CALL_STACK_POINTER) (local.get $stack_pointer))
                        (call $write_ctx (global.get $CTX_PENDING_POINTER)
                          (call $load_frame_pending_base (local.get $frame_pointer)))
                        (global.set $current_scope
                          (i32.load (i32.add (local.get $frame_pointer) (global.get $FRAME_SCOPE_POINTER))))
                        (call $pending_push (local.get $receiver_type) (i32.const 0) (local.get $array_pointer) (i32.const 0))
                        (local.set $pc (i32.load (i32.add (local.get $frame_pointer) (global.get $FRAME_INSTRUCTION_INDEX))))
                        (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                        (br $loop)
                      )
                    )
                  )
                )

                ;; FlatMap RETURN handler: flatten callback result one level into output.
                ;;
                ;; The output array is a PERSISTENT accumulator across
                ;; callback returns, so a pressure refusal mid-append
                ;; would duplicate elements on retry. Pre-budget the
                ;; whole append BEFORE touching the array (same
                ;; resume-exact contract as the map/set seeding park
                ;; below: re-push the popped result, park on this
                ;; RETURN, nothing else mutated), then (drop) the
                ;; now-guaranteed push statuses.
                (if (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ARRAY_FLAT_MAP))
                  (then
                    (if (i32.eq (local.get $result_type) (global.get $TYPE_ARRAY))
                      (then
                        ;; Result is an array — flatten one level. Budget:
                        ;; grow to hold out_len + sub_len elements.
                        (if (i32.gt_u
                              (i32.add
                                (i32.load (call $abs (i32.add (local.get $heap_pointer) (i32.const 8))))
                                (i32.load (call $abs (i32.add (local.get $result_lo) (i32.const 8)))))
                              (i32.load (call $abs (i32.add (local.get $heap_pointer) (i32.const 12)))))
                          (then
                            (if (call $check_heap_overflow
                                  (call $estimate_array_push_budget
                                    (i32.load (call $abs (i32.add (local.get $heap_pointer) (i32.const 12))))
                                    (i32.add
                                      (i32.load (call $abs (i32.add (local.get $heap_pointer) (i32.const 8))))
                                      (i32.load (call $abs (i32.add (local.get $result_lo) (i32.const 8)))))))
                              (then
                                (call $restage_return_value_for_retry
                                  (local.get $opcode) (local.get $result_type) (local.get $result_flags)
                                  (local.get $result_lo) (local.get $result_hi))
                                (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                                (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                                (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                                (br $exit)
                              )
                            )
                          )
                        )
                        (drop (call $flat_into (local.get $result_lo) (local.get $heap_pointer) (i32.const 0)))
                      )
                      (else
                        ;; Result is not an array — push directly. Budget:
                        ;; one grow of the current capacity, only if full.
                        (if (i32.ge_u
                              (i32.load (call $abs (i32.add (local.get $heap_pointer) (i32.const 8))))
                              (i32.load (call $abs (i32.add (local.get $heap_pointer) (i32.const 12)))))
                          (then
                            (if (call $check_heap_overflow
                                  (call $estimate_array_grow_size
                                    (i32.load (call $abs (i32.add (local.get $heap_pointer) (i32.const 12))))))
                              (then
                                (call $restage_return_value_for_retry
                                  (local.get $opcode) (local.get $result_type) (local.get $result_flags)
                                  (local.get $result_lo) (local.get $result_hi))
                                (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                                (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                                (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                                (br $exit)
                              )
                            )
                          )
                        )
                        (drop (call $array_push_value
                          (local.get $heap_pointer)
                          (local.get $result_type) (local.get $result_flags)
                          (local.get $result_lo) (local.get $result_hi)))
                      )
                    )
                  )
                )

                ;; Map/Set constructor seeding from a general iterable — the
                ;; foreign-callable re-entry continuation. Slot roles are set
                ;; by OP_NEW's seeding path: $index = phase, $array_pointer =
                ;; the collection, $heap_pointer = the iterator object,
                ;; $closure_pointer = the closure that just returned.
                ;; Phase 0: the Symbol.iterator call returned the iterator
                ;; object — resolve its `next` method and call it. Phase 1:
                ;; next() returned a step object — read done/value, add the
                ;; entry, call next() again (or pop the frame and land the
                ;; finished collection at the constructor's slot).
                (if (i32.or
                      (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_MAP_SEED_FROM_ITERABLE))
                      (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_SET_SEED_FROM_ITERABLE)))
                  (then
                    ;; Both phases require an object result (iterator
                    ;; protocol: GetIterator / IteratorResult must be
                    ;; objects).
                    (if (i32.ne (local.get $result_type) (global.get $TYPE_OBJECT))
                      (then
                        (if (call $throw_type_error_with_type
                              (global.get $BUILTIN_MSG_NOT_AN_OBJECT) (local.get $result_type))
                          (then (br $exit)))
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop)
                      )
                    )
                    (if (i32.eqz (local.get $index))
                      (then
                        ;; Phase 0 → store the iterator object, resolve `next`.
                        (call $native_continuation_state_set
                          (local.get $state_handle) (i32.const 1)
                          (local.get $result_lo))
                        (local.set $entry_pointer (call $object_find_string_entry
                          (local.get $result_lo)
                          (call $read_builtin (global.get $BUILTIN_ITER_NEXT_KEY))))
                        (if (i32.eqz (call $entry_value_is_function (local.get $entry_pointer)))
                          (then
                            (if (call $throw_type_error_with_type
                                  (global.get $BUILTIN_MSG_NOT_A_FUNCTION) (local.get $result_type))
                              (then (br $exit)))
                            (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                            (br $loop)
                          )
                        )
                        (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_CONTINUATION_CALLBACK))
                          (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 12)))))
                        (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_CONTINUATION_PHASE)) (i32.const 1))
                      )
                      (else
                        ;; Phase 1 → result_lo = step object header. Done?
                        (local.set $entry_pointer (call $object_find_string_entry
                          (local.get $result_lo)
                          (call $read_builtin (global.get $BUILTIN_ITER_DONE_KEY))))
                        (if (call $entry_value_is_truthy (local.get $entry_pointer))
                          (then
                            ;; Done: pop the frame, land the collection.
                            (local.set $stack_pointer (i32.sub (local.get $stack_pointer) (global.get $FRAME_SIZE)))
                            (call $write_ctx (global.get $CTX_CALL_STACK_POINTER) (local.get $stack_pointer))
                            (local.set $return_pc (i32.load (i32.add (local.get $frame_pointer) (global.get $FRAME_INSTRUCTION_INDEX))))
                            (local.set $caller_scope (i32.load (i32.add (local.get $frame_pointer) (global.get $FRAME_SCOPE_POINTER))))
                            (call $write_ctx (global.get $CTX_PENDING_POINTER)
                              (call $load_frame_pending_base (local.get $frame_pointer)))
                            (global.set $current_scope (local.get $caller_scope))
                            (call $pending_push (local.get $receiver_type) (i32.const 0)
                              (local.get $array_pointer) (i32.const 0))
                            (local.set $pc (local.get $return_pc))
                            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                            (br $loop)
                          )
                        )
                        ;; Not done: pre-check the grow budget BEFORE adding.
                        ;; On refusal, re-push the step object and park the pc
                        ;; on this RETURN — the retry re-pops it and re-enters
                        ;; here with nothing else mutated (the user iterator
                        ;; does NOT advance again).
                        (if (call $check_heap_overflow
                              (call $estimate_collection_grow_size
                                (if (result i32) (i32.eq (local.get $receiver_type) (global.get $TYPE_MAP))
                                  (then (global.get $MAP_SLOT_STRIDE))
                                  (else (global.get $SET_SLOT_STRIDE)))
                                (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 16))))))
                          (then
                            (call $restage_return_value_for_retry
                              (local.get $opcode) (local.get $result_type) (local.get $result_flags)
                              (local.get $result_lo) (local.get $result_hi))
                            (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                            (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                            (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                            (br $exit)
                          )
                        )
                        ;; step.value (absent → undefined)
                        (local.set $entry_pointer (call $object_find_string_entry
                          (local.get $result_lo)
                          (call $read_builtin (global.get $BUILTIN_ITER_VALUE_KEY))))
                        (if (i32.eq (local.get $receiver_type) (global.get $TYPE_SET))
                          (then
                            (if (i32.ne (local.get $entry_pointer) (i32.const 0))
                              (then
                                (call $set_add (local.get $array_pointer)
                                  (i32.add (local.get $entry_pointer) (i32.const 4))))
                              (else
                                ;; Missing value: add undefined via a slot
                                ;; staged on the pending stack (truncated
                                ;; again before the next() call below).
                                (call $pending_push (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))
                                (call $set_add (local.get $array_pointer)
                                  (i32.sub (call $read_ctx (global.get $CTX_PENDING_POINTER)) (global.get $VALUE_SIZE)))
                              )
                            )
                          )
                          (else
                            ;; Map: the step value must be an entry array
                            ;; holding at least [key, value].
                            (if (i32.or
                                  (i32.eqz (local.get $entry_pointer))
                                  (i32.ne
                                    (if (result i32) (i32.eqz (local.get $entry_pointer))
                                      (then (global.get $TYPE_UNDEFINED))
                                      (else (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 4))))))
                                    (global.get $TYPE_ARRAY)))
                              (then
                                (if (call $throw_type_error_with_type
                                      (global.get $BUILTIN_MSG_NOT_AN_OBJECT)
                                      (if (result i32) (i32.eqz (local.get $entry_pointer))
                                        (then (global.get $TYPE_UNDEFINED))
                                        (else (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 4)))))))
                                  (then (br $exit)))
                                (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                                (br $loop)
                              )
                            )
                            (local.set $object_pointer
                              (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 12)))))
                            (if (i32.lt_u
                                  (i32.load (call $abs (i32.add (local.get $object_pointer) (i32.const 8))))
                                  (i32.const 2))
                              (then
                                (if (call $throw_type_error_with_type
                                      (global.get $BUILTIN_MSG_NOT_AN_OBJECT) (global.get $TYPE_ARRAY))
                                  (then (br $exit)))
                                (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                                (br $loop)
                              )
                            )
                            (local.set $new_data_pointer (i32.load (call $abs (i32.add (local.get $object_pointer) (i32.const 16)))))
                            (call $map_set
                              (local.get $array_pointer)
                              (i32.add (local.get $new_data_pointer) (global.get $GC_HEADER_SIZE))
                              (i32.add
                                (i32.add (local.get $new_data_pointer) (global.get $GC_HEADER_SIZE))
                                (global.get $VALUE_SIZE)))
                          )
                        )
                      )
                    )
                    ;; Invoke iterator.next() with `this` = the iterator —
                    ;; or, for a generator source (ITER_CALLBACK = 0),
                    ;; drive the native next(): write the generator
                    ;; request and park at the sentinel RETURN. The
                    ;; settled step object lands on the pending stack and
                    ;; the sentinel RETURN re-enters this continuation
                    ;; with it as the staged call's result.
                    (local.set $closure_pointer
                      (i32.load (i32.add (local.get $frame_pointer) (global.get $FRAME_CONTINUATION_CALLBACK))))
                    (call $write_ctx (global.get $CTX_PENDING_POINTER)
                      (call $load_frame_pending_base (local.get $frame_pointer)))
                    (if (i32.eqz (local.get $closure_pointer))
                      (then
                        (i32.store (call $abs (global.get $external_request_base))
                          (call $native_continuation_state_get
                            (local.get $state_handle) (i32.const 1)))
                        (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 4))) (i32.const 0))
                        (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 8)))
                          (global.get $TYPE_UNDEFINED))
                        (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 12))) (i32.const 0))
                        (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 16))) (i32.const 0))
                        (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 20))) (i32.const 0))
                        (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX)
                          (i32.sub (local.get $instr_count) (i32.const 1)))
                        (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                        (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_GENERATOR_NEXT))
                        (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                        (br $exit)
                      )
                    )
                    (local.set $new_scope (call $scope_create
                      (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 40))))))
                    (global.set $current_scope (local.get $new_scope))
                    (if (i32.eqz (i32.and
                          (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 44))))
                          (global.get $CLOSURE_FLAG_ARROW)))
                      (then
                        (call $scope_define (local.get $new_scope)
                          (call $read_builtin (i32.const 0x18))   ;; BUILTIN_NAME.THIS
                          (global.get $TYPE_OBJECT) (i32.const 0)
                          (call $native_continuation_state_get
                            (local.get $state_handle) (i32.const 1))
                          (i32.const 0))
                        (call $scope_define_new_target (local.get $new_scope)
                          (global.get $TYPE_UNDEFINED) (i32.const 0))))
                    (local.set $pc (i32.load (call $abs (i32.add (local.get $closure_pointer) (global.get $FUNCTION_CLOSURE_OFFSET)))))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )

                ;; Array.from over a user iterable — same two-phase protocol
                ;; as the Map/Set seeding above, but the entries accumulate
                ;; into an array (FRAME_CONTINUATION_STATE_2) and completion pokes
                ;; that array into the source operand slot (frame pending
                ;; base − ITER_LENGTH) and RE-RUNS the original call
                ;; instruction, so the Array-source paths (clone, mapFn
                ;; rewrite) then apply.
                (if (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ARRAY_FROM_SEED))
                  (then
                    (if (i32.ne (local.get $result_type) (global.get $TYPE_OBJECT))
                      (then
                        (if (call $throw_type_error_with_type
                              (global.get $BUILTIN_MSG_NOT_AN_OBJECT) (local.get $result_type))
                          (then (br $exit)))
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop)
                      )
                    )
                    (if (i32.eqz (local.get $index))
                      (then
                        ;; Phase 0 → store the iterator object, resolve `next`.
                        (call $native_continuation_state_set
                          (local.get $state_handle) (i32.const 1)
                          (local.get $result_lo))
                        (local.set $entry_pointer (call $object_find_string_entry
                          (local.get $result_lo)
                          (call $read_builtin (global.get $BUILTIN_ITER_NEXT_KEY))))
                        (if (i32.eqz (call $entry_value_is_function (local.get $entry_pointer)))
                          (then
                            (if (call $throw_type_error_with_type
                                  (global.get $BUILTIN_MSG_NOT_A_FUNCTION) (local.get $result_type))
                              (then (br $exit)))
                            (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                            (br $loop)
                          )
                        )
                        (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_CONTINUATION_CALLBACK))
                          (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 12)))))
                        (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_CONTINUATION_PHASE)) (i32.const 1))
                      )
                      (else
                        ;; Phase 1 → result_lo = step object header. Done?
                        (local.set $entry_pointer (call $object_find_string_entry
                          (local.get $result_lo)
                          (call $read_builtin (global.get $BUILTIN_ITER_DONE_KEY))))
                        (if (call $entry_value_is_truthy (local.get $entry_pointer))
                          (then
                            ;; Done: pop the frame, poke the drained array
                            ;; into the source slot, re-run the blocked call.
                            (local.set $stack_pointer (i32.sub (local.get $stack_pointer) (global.get $FRAME_SIZE)))
                            (call $write_ctx (global.get $CTX_CALL_STACK_POINTER) (local.get $stack_pointer))
                            (local.set $return_pc (i32.load (i32.add (local.get $frame_pointer) (global.get $FRAME_INSTRUCTION_INDEX))))
                            (local.set $caller_scope (i32.load (i32.add (local.get $frame_pointer) (global.get $FRAME_SCOPE_POINTER))))
                            (global.set $current_scope (local.get $caller_scope))
                            (local.set $result_i32 (i32.sub
                              (call $load_frame_pending_base (local.get $frame_pointer))
                              (call $native_continuation_state_get
                                (local.get $state_handle) (i32.const 0))))
                            (i32.store (call $abs (local.get $result_i32)) (global.get $TYPE_ARRAY))
                            (i32.store (call $abs (i32.add (local.get $result_i32) (i32.const 4))) (i32.const 0))
                            (i32.store (call $abs (i32.add (local.get $result_i32) (i32.const 8))) (local.get $array_pointer))
                            (i32.store (call $abs (i32.add (local.get $result_i32) (i32.const 12))) (i32.const 0))
                            (call $write_ctx (global.get $CTX_PENDING_POINTER)
                              (call $load_frame_pending_base (local.get $frame_pointer)))
                            (local.set $pc (local.get $return_pc))
                            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                            (br $loop)
                          )
                        )
                        ;; Not done: if the accumulator is at capacity, the
                        ;; push below will grow it — pre-check that budget
                        ;; with a resume-exact retry (re-push the step
                        ;; object, park on this RETURN; the user iterator
                        ;; does NOT advance again).
                        (if (i32.ge_u
                              (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 8))))
                              (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 12)))))
                          (then
                            (if (call $check_heap_overflow
                                  (call $estimate_array_grow_size
                                    (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 12))))))
                              (then
                                (call $restage_return_value_for_retry
                                  (local.get $opcode) (local.get $result_type) (local.get $result_flags)
                                  (local.get $result_lo) (local.get $result_hi))
                                (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                                (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                                (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                                (br $exit)
                              )
                            )
                          )
                        )
                        ;; Append step.value (absent → undefined).
                        (local.set $entry_pointer (call $object_find_string_entry
                          (local.get $result_lo)
                          (call $read_builtin (global.get $BUILTIN_ITER_VALUE_KEY))))
                        ;; Statuses droppable: the grow budget was
                        ;; pre-checked above with a resume-exact park.
                        (if (i32.ne (local.get $entry_pointer) (i32.const 0))
                          (then
                            (drop (call $array_push_value (local.get $array_pointer)
                              (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 4))))
                              (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 8))))
                              (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 12))))
                              (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 16)))))))
                          (else
                            (drop (call $array_push_value (local.get $array_pointer)
                              (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0)))
                          )
                        )
                      )
                    )
                    ;; Invoke iterator.next() with `this` = the iterator —
                    ;; or, for a generator source (ITER_CALLBACK = 0),
                    ;; drive the native next(): write the generator
                    ;; request and park at the sentinel RETURN. The
                    ;; settled step object lands on the pending stack and
                    ;; the sentinel RETURN re-enters this continuation
                    ;; with it as the staged call's result.
                    (local.set $closure_pointer
                      (i32.load (i32.add (local.get $frame_pointer) (global.get $FRAME_CONTINUATION_CALLBACK))))
                    (call $write_ctx (global.get $CTX_PENDING_POINTER)
                      (call $load_frame_pending_base (local.get $frame_pointer)))
                    (if (i32.eqz (local.get $closure_pointer))
                      (then
                        (i32.store (call $abs (global.get $external_request_base))
                          (call $native_continuation_state_get
                            (local.get $state_handle) (i32.const 1)))
                        (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 4))) (i32.const 0))
                        (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 8)))
                          (global.get $TYPE_UNDEFINED))
                        (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 12))) (i32.const 0))
                        (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 16))) (i32.const 0))
                        (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 20))) (i32.const 0))
                        (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX)
                          (i32.sub (local.get $instr_count) (i32.const 1)))
                        (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                        (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_GENERATOR_NEXT))
                        (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                        (br $exit)
                      )
                    )
                    (local.set $new_scope (call $scope_create
                      (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 40))))))
                    (global.set $current_scope (local.get $new_scope))
                    (if (i32.eqz (i32.and
                          (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 44))))
                          (global.get $CLOSURE_FLAG_ARROW)))
                      (then
                        (call $scope_define (local.get $new_scope)
                          (call $read_builtin (i32.const 0x18))   ;; BUILTIN_NAME.THIS
                          (global.get $TYPE_OBJECT) (i32.const 0)
                          (call $native_continuation_state_get
                            (local.get $state_handle) (i32.const 1))
                          (i32.const 0))
                        (call $scope_define_new_target (local.get $new_scope)
                          (global.get $TYPE_UNDEFINED) (i32.const 0))))
                    (local.set $pc (i32.load (call $abs (i32.add (local.get $closure_pointer) (global.get $FUNCTION_CLOSURE_OFFSET)))))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )

                ;; JSON transform: a staged getter or replacer call just
                ;; returned. The continuation consumes it per the driver's
                ;; substate and either stages the next call or completes
                ;; (re-running the blocked stringify with the resolved
                ;; copy substituted).
                (if (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_JSON_TRANSFORM))
                  (then
                    (local.set $result_i32 (call $json_transform_continue (local.get $frame_pointer)
                      (local.get $result_type) (local.get $result_flags)
                      (local.get $result_lo) (local.get $result_hi)))
                    (if (i32.eq (local.get $result_i32) (i32.const -1))
                      (then
                        (if (call $throw_from_set_error) (then (br $exit)))
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop)))
                    (if (i32.eq (local.get $result_i32) (i32.const -2))
                      (then
                        (call $restage_return_value_for_retry
                          (local.get $opcode) (local.get $result_type) (local.get $result_flags)
                          (local.get $result_lo) (local.get $result_hi))
                        (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                        (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                        (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                        (br $exit)))
                    (local.set $pc (local.get $result_i32))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )

                ;; JSON internalize: a staged reviver call just returned.
                ;; The continuation applies it (delete/replace the awaited
                ;; entry, or land the root) and either stages the next
                ;; reviver call or completes by pushing the revived result
                ;; and continuing AFTER the blocked parse call.
                (if (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_JSON_INTERNALIZE))
                  (then
                    (local.set $result_i32 (call $json_internalize_continue (local.get $frame_pointer)
                      (local.get $result_type) (local.get $result_flags)
                      (local.get $result_lo) (local.get $result_hi)))
                    (if (i32.eq (local.get $result_i32) (i32.const -1))
                      (then
                        (if (call $throw_from_set_error) (then (br $exit)))
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop)))
                    (if (i32.eq (local.get $result_i32) (i32.const -2))
                      (then
                        (call $restage_return_value_for_retry
                          (local.get $opcode) (local.get $result_type) (local.get $result_flags)
                          (local.get $result_lo) (local.get $result_hi))
                        (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                        (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                        (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                        (br $exit)))
                    (local.set $pc (local.get $result_i32))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )

                ;; Object.assign setter drive: the setter's return value is
                ;; discarded (assignment semantics); resume the walk.
                (if (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ASSIGN_SETTERS))
                  (then
                    (local.set $result_i32 (call $assign_setters_step (local.get $frame_pointer)))
                    (if (i32.eq (local.get $result_i32) (i32.const -1))
                      (then
                        (if (call $throw_from_set_error) (then (br $exit)))
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop)))
                    (if (i32.eq (local.get $result_i32) (i32.const -2))
                      (then
                        (call $restage_return_value_for_retry
                          (local.get $opcode) (local.get $result_type) (local.get $result_flags)
                          (local.get $result_lo) (local.get $result_hi))
                        (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                        (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                        (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                        (br $exit)))
                    (local.set $pc (local.get $result_i32))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )

                ;; Set-theoretic methods over a Set-like: hand the callee's
                ;; return to the shared continuation helpers; they either
                ;; stage the next foreign call or complete, returning the
                ;; pc to continue at (-1 = error set, -2 = pressure with a
                ;; resume-exact retry parked on this RETURN).
                (if (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_SETOP_HAS_DRIVEN))
                  (then
                    (local.set $result_i32 (call $setop_has_continue (local.get $frame_pointer)
                      (call $is_truthy_inline (local.get $result_type) (local.get $result_flags)
                        (local.get $result_lo) (local.get $result_hi))))
                    (if (i32.eq (local.get $result_i32) (i32.const -1))
                      (then
                        (if (call $throw_from_set_error) (then (br $exit)))
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop)))
                    (if (i32.eq (local.get $result_i32) (i32.const -2))
                      (then
                        (call $restage_return_value_for_retry
                          (local.get $opcode) (local.get $result_type) (local.get $result_flags)
                          (local.get $result_lo) (local.get $result_hi))
                        (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                        (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                        (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                        (br $exit)))
                    (local.set $pc (local.get $result_i32))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )
                (if (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_SETOP_KEYS_DRIVEN))
                  (then
                    (local.set $result_i32 (call $setop_keys_continue (local.get $frame_pointer)
                      (local.get $result_type) (local.get $result_lo)))
                    (if (i32.eq (local.get $result_i32) (i32.const -1))
                      (then
                        (if (call $throw_from_set_error) (then (br $exit)))
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop)))
                    (if (i32.eq (local.get $result_i32) (i32.const -2))
                      (then
                        (call $restage_return_value_for_retry
                          (local.get $opcode) (local.get $result_type) (local.get $result_flags)
                          (local.get $result_lo) (local.get $result_hi))
                        (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                        (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                        (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                        (br $exit)))
                    (local.set $pc (local.get $result_i32))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )

                ;; Accessor resolver: a getter just returned — write its
                ;; value into the data-only copy and take the next step
                ;; (stage the next getter, or complete by substituting the
                ;; copy into the blocked instruction's operand slot and
                ;; re-running it).
                (if (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ACCESSOR_RESOLVE))
                  (then
                    (local.set $pc (call $accessor_resolve_continue (local.get $frame_pointer)
                      (local.get $result_type) (local.get $result_flags)
                      (local.get $result_lo) (local.get $result_hi)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )

                ;; Map.prototype.forEach / Set.prototype.forEach RETURN handler.
                ;; The callback's return value is ignored (forEach always
                ;; returns undefined). Entirely self-contained: advances
                ;; past tombstones or finishes, then jumps back into the
                ;; loop — never falls through to the array increment path
                ;; below, whose stride/element layout doesn't apply here.
                (if (i32.or
                      (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_MAP_FOR_EACH))
                      (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_SET_FOR_EACH)))
                  (then
                    ;; array_pointer holds FRAME_CONTINUATION_STATE_2 — the Map/Set
                    ;; header pointer, not the entries block. Re-read entries
                    ;; pointer and slotCount fresh each time (same as
                    ;; map_iterator_next/set_iterator_next), so slots added
                    ;; by the callback mutating the collection mid-iteration
                    ;; are visited, matching spec semantics for live sets.
                    (local.set $data_pointer
                      (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 20)))))
                    (local.set $arr_len
                      (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 12)))))
                    (local.set $index (i32.add (local.get $index) (i32.const 1)))
                    (block $ms_foreach_return_found
                      (loop $ms_foreach_return_scan
                        (br_if $ms_foreach_return_found (i32.ge_u (local.get $index) (local.get $arr_len)))
                        (local.set $element_pointer
                          (i32.add
                            (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
                            (i32.mul (local.get $index)
                              (if (result i32) (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_MAP_FOR_EACH))
                                (then (global.get $MAP_SLOT_STRIDE))
                                (else (global.get $SET_SLOT_STRIDE))))))
                        (if (i32.eqz (i32.load (call $abs (local.get $element_pointer))))
                          (then (br $ms_foreach_return_found)))
                        (local.set $index (i32.add (local.get $index) (i32.const 1)))
                        (br $ms_foreach_return_scan)
                      )
                    )
                    (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_CONTINUATION_PHASE)) (local.get $index))

                    (if (i32.lt_u (local.get $index) (local.get $arr_len))
                      (then
                        ;; More live entries - call callback again.
                        (call $write_ctx (global.get $CTX_PENDING_POINTER)
                          (call $load_frame_pending_base (local.get $frame_pointer)))
                        (local.set $captured_scope (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 40)))))
                        (local.set $closure_flags (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 44)))))
                        (call $push_map_set_foreach_args
                          (local.get $continuation_kind) (local.get $data_pointer) (local.get $index)
                          (local.get $array_pointer)
                          (call $callback_staged_argc (local.get $closure_pointer) (i32.const 3)))
                        (local.set $new_scope (call $scope_create (local.get $captured_scope)))
                        (global.set $current_scope (local.get $new_scope))
                        (if (i32.eqz (i32.and (local.get $closure_flags) (global.get $CLOSURE_FLAG_ARROW)))
                          (then
                            (call $scope_define (local.get $new_scope)
                              (call $read_builtin (i32.const 0x18))
                              (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))
                            (call $scope_define_new_target (local.get $new_scope)
                              (global.get $TYPE_UNDEFINED) (i32.const 0))
                          )
                        )
                        (local.set $pc (i32.load (call $abs (i32.add (local.get $closure_pointer) (global.get $FUNCTION_CLOSURE_OFFSET)))))
                        (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                        (br $loop)
                      )
                      (else
                        ;; Iteration complete - pop frame, return undefined.
                        (local.set $stack_pointer (i32.sub (local.get $stack_pointer) (global.get $FRAME_SIZE)))
                        (call $write_ctx (global.get $CTX_CALL_STACK_POINTER) (local.get $stack_pointer))
                        (local.set $return_pc (i32.load (i32.add (local.get $frame_pointer) (global.get $FRAME_INSTRUCTION_INDEX))))
                        (local.set $caller_scope (i32.load (i32.add (local.get $frame_pointer) (global.get $FRAME_SCOPE_POINTER))))
                        (call $write_ctx (global.get $CTX_PENDING_POINTER)
                          (call $load_frame_pending_base (local.get $frame_pointer)))
                        (global.set $current_scope (local.get $caller_scope))
                        (call $pending_push (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))
                        (local.set $pc (local.get $return_pc))
                        (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                        (br $loop)
                      )
                    )
                  )
                )

                ;; Advance the index — the reduceRight and findLast
                ;; families walk DOWN. The shared continue check
                ;; `index < len` unsigned-wraps at -1, so descending
                ;; completion needs no separate test.
                (if (i32.or
                      (i32.or
                        (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ARRAY_REDUCE_RIGHT))
                        (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_TYPED_ARRAY_REDUCE_RIGHT)))
                      (call $is_find_last_continuation_kind (local.get $continuation_kind)))
                  (then (local.set $index (i32.sub (local.get $index) (i32.const 1))))
                  (else (local.set $index (i32.add (local.get $index) (i32.const 1)))))
                (i32.store (i32.add (local.get $frame_pointer) (global.get $FRAME_CONTINUATION_PHASE)) (local.get $index))

                ;; Check if more elements
                (if (i32.lt_u (local.get $index) (local.get $arr_len))
                  (then
                    ;; More elements - call callback again
                    ;; Clear pending stack for new args
                    (call $write_ctx (global.get $CTX_PENDING_POINTER)
                      (call $load_frame_pending_base (local.get $frame_pointer)))

                    ;; Get callback closure details (from header pointer)
                    (local.set $captured_scope (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 40)))))
                    (local.set $closure_flags (i32.load (call $abs (i32.add (local.get $closure_pointer) (i32.const 44)))))

                    ;; Stage per the shared sizing rule — reduce families
                    ;; take (acc, elem, idx, arr), the rest (elem, idx, arr).
                    (local.set $param_count (call $callback_staged_argc
                      (local.get $closure_pointer)
                      (select (i32.const 4) (i32.const 3)
                        (i32.or
                          (i32.or
                            (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ARRAY_REDUCE))
                            (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ARRAY_REDUCE_RIGHT)))
                          (i32.or
                            (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_TYPED_ARRAY_REDUCE))
                            (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_TYPED_ARRAY_REDUCE_RIGHT)))))))

                    (if (call $is_typed_array_continuation_kind (local.get $continuation_kind))
                      (then
                        ;; Typed array callback - get element at index
                        (local.set $data_pointer (i32.load (call $abs (local.get $array_pointer))))
                        (local.set $operand2 (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 4)))))
                        ;; byte_addr = buffer_ptr + 4 + byte_offset + index * bytes_per_element
                        (local.set $element_pointer (i32.add
                          (i32.add
                            (i32.add (local.get $data_pointer) (i32.const 4))
                            (local.get $operand2))
                          (i32.mul (local.get $index) (call $get_bytes_per_element (local.get $receiver_type)))))

                        ;; Read element value
                        (local.set $float_result (call $read_typed_element (local.get $receiver_type) (call $abs (local.get $element_pointer))))

                        ;; Push only as many args as callback expects
                        (if (i32.or
                              (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_TYPED_ARRAY_REDUCE))
                              (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_TYPED_ARRAY_REDUCE_RIGHT)))
                          (then
                            ;; Reduce: fn(acc, elem, idx, arr)
                            (if (i32.ge_u (local.get $param_count) (i32.const 1))
                              (then
                                (local.set $dest (i32.add
                                  (i32.load (call $abs (i32.add (local.get $heap_pointer) (i32.const 16))))
                                  (global.get $GC_HEADER_SIZE)))
                                (call $pending_push
                                  (call $value_type (local.get $dest))
                                  (i32.load (call $abs (i32.add (local.get $dest) (i32.const 4))))
                                  (call $value_data_lo (local.get $dest))
                                  (call $value_data_hi (local.get $dest)))
                              )
                            )
                            ;; Integer typed arrays push Rational; Float32/64 push Float.
                            (if (i32.ge_u (local.get $param_count) (i32.const 2))
                              (then
                                (if (i32.or
                                      (i32.eq (local.get $receiver_type) (global.get $TYPE_FLOAT32ARRAY))
                                      (i32.eq (local.get $receiver_type) (global.get $TYPE_FLOAT64ARRAY)))
                                  (then (call $push_f64 (local.get $float_result)))
                                  (else (call $push_rational_inline (i64.trunc_sat_f64_s (local.get $float_result))))
                                )
                              )
                            )
                            (if (i32.ge_u (local.get $param_count) (i32.const 3))
                              (then (call $push_rational_inline (i64.extend_i32_s (local.get $index)))))
                            (if (i32.ge_u (local.get $param_count) (i32.const 4))
                              (then (call $pending_push (local.get $receiver_type) (i32.const 0) (local.get $array_pointer) (i32.const 0))))
                          )
                          (else
                            ;; Non-reduce: fn(elem, idx, arr) — integer typed arrays push Rational.
                            (if (i32.ge_u (local.get $param_count) (i32.const 1))
                              (then
                                (if (i32.or
                                      (i32.eq (local.get $receiver_type) (global.get $TYPE_FLOAT32ARRAY))
                                      (i32.eq (local.get $receiver_type) (global.get $TYPE_FLOAT64ARRAY)))
                                  (then (call $push_f64 (local.get $float_result)))
                                  (else (call $push_rational_inline (i64.trunc_sat_f64_s (local.get $float_result))))
                                )
                              )
                            )
                            (if (i32.ge_u (local.get $param_count) (i32.const 2))
                              (then (call $push_rational_inline (i64.extend_i32_s (local.get $index)))))
                            (if (i32.ge_u (local.get $param_count) (i32.const 3))
                              (then (call $pending_push (local.get $receiver_type) (i32.const 0) (local.get $array_pointer) (i32.const 0))))
                          )
                        )
                      )
                      (else
                        ;; Array callback - get element at index
                        (local.set $data_pointer (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 16)))))
                        (local.set $element_pointer (i32.add
                          (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
                          (i32.mul (local.get $index) (global.get $VALUE_SIZE))))

                        ;; Push only as many args as callback expects
                        (if (i32.or (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ARRAY_REDUCE)) (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ARRAY_REDUCE_RIGHT)))
                          (then
                            ;; Reduce: fn(acc, elem, idx, arr)
                            (if (i32.ge_u (local.get $param_count) (i32.const 1))
                              (then
                                (local.set $dest (i32.add
                                  (i32.load (call $abs (i32.add (local.get $heap_pointer) (i32.const 16))))
                                  (global.get $GC_HEADER_SIZE)))
                                (call $pending_push
                                  (call $value_type (local.get $dest))
                                  (i32.load (call $abs (i32.add (local.get $dest) (i32.const 4))))
                                  (call $value_data_lo (local.get $dest))
                                  (call $value_data_hi (local.get $dest)))
                              )
                            )
                            (if (i32.ge_u (local.get $param_count) (i32.const 2))
                              (then
                                (call $pending_push
                                  (call $value_type (local.get $element_pointer))
                                  (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 4))))
                                  (call $value_data_lo (local.get $element_pointer))
                                  (call $value_data_hi (local.get $element_pointer)))
                              )
                            )
                            (if (i32.ge_u (local.get $param_count) (i32.const 3))
                              (then (call $push_f64 (f64.convert_i32_s (local.get $index)))))
                            (if (i32.ge_u (local.get $param_count) (i32.const 4))
                              (then (call $pending_push (global.get $TYPE_ARRAY) (i32.const 0) (local.get $array_pointer) (i32.const 0))))
                          )
                          (else
                            ;; Non-reduce: fn(elem, idx, arr)
                            (if (i32.ge_u (local.get $param_count) (i32.const 1))
                              (then
                                (call $pending_push
                                  (call $value_type (local.get $element_pointer))
                                  (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 4))))
                                  (call $value_data_lo (local.get $element_pointer))
                                  (call $value_data_hi (local.get $element_pointer)))
                              )
                            )
                            (if (i32.ge_u (local.get $param_count) (i32.const 2))
                              (then (call $push_f64 (f64.convert_i32_s (local.get $index)))))
                            (if (i32.ge_u (local.get $param_count) (i32.const 3))
                              (then (call $pending_push (global.get $TYPE_ARRAY) (i32.const 0) (local.get $array_pointer) (i32.const 0))))
                          )
                        )
                      )
                    )

                    ;; Create new scope for callback
                    (local.set $new_scope (call $scope_create (local.get $captured_scope)))
                    (global.set $current_scope (local.get $new_scope))
                    (if (i32.eqz (i32.and (local.get $closure_flags) (global.get $CLOSURE_FLAG_ARROW)))
                      (then
                        (call $scope_define (local.get $new_scope)
                          (call $read_builtin (i32.const 0x18))
                          (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))
                        (call $scope_define_new_target (local.get $new_scope)
                          (global.get $TYPE_UNDEFINED) (i32.const 0))
                      )
                    )

                    ;; Jump to callback - closure_pointer is closure data pointer
                    ;; Read start_instr from offset 0
                    (local.set $pc (i32.load (call $abs (i32.add (local.get $closure_pointer) (global.get $FUNCTION_CLOSURE_OFFSET)))))

                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                  (else
                    ;; Iteration complete - return final result

                    ;; Pop iteration frame
                    (local.set $stack_pointer (i32.sub (local.get $stack_pointer) (global.get $FRAME_SIZE)))
                    (call $write_ctx (global.get $CTX_CALL_STACK_POINTER) (local.get $stack_pointer))

                    ;; Restore from iteration frame
                    (local.set $code_block (call $read_state (global.get $STATE_CODE_BLOCK)))
                    (local.set $return_pc (i32.load (i32.add (local.get $frame_pointer) (global.get $FRAME_INSTRUCTION_INDEX))))
                    (local.set $caller_scope (i32.load (i32.add (local.get $frame_pointer) (global.get $FRAME_SCOPE_POINTER))))
                    (call $write_ctx (global.get $CTX_PENDING_POINTER)
                      (call $load_frame_pending_base (local.get $frame_pointer)))
                    (global.set $current_scope (local.get $caller_scope))

                    ;; Push final result based on method
                    (if (i32.or
                          (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ARRAY_MAP))
                          (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ARRAY_FILTER)))
                      (then
                        ;; Return result array
                        (call $pending_push (global.get $TYPE_ARRAY) (i32.const 0) (local.get $heap_pointer) (i32.const 0))
                      )
                      (else
                        (if (i32.or
                              (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_TYPED_ARRAY_MAP))
                              (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_TYPED_ARRAY_FILTER)))
                          (then
                            ;; Return result typed array (same type as receiver)
                            (call $pending_push (local.get $receiver_type) (i32.const 0) (local.get $heap_pointer) (i32.const 0))
                          )
                          (else
                            (if (i32.or
                                  (i32.or (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ARRAY_REDUCE)) (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ARRAY_REDUCE_RIGHT)))
                                  (i32.or
                                    (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_TYPED_ARRAY_REDUCE))
                                    (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_TYPED_ARRAY_REDUCE_RIGHT))))
                              (then
                                ;; Return accumulator value
                                ;; heap_pointer is accumulator array, data_pointer at offset 16 (includes GC header)
                                (local.set $data_pointer (i32.add
                                  (i32.load (call $abs (i32.add (local.get $heap_pointer) (i32.const 16))))
                                  (global.get $GC_HEADER_SIZE)))
                                (call $pending_push
                                  (call $value_type (local.get $data_pointer))
                                  (i32.load (call $abs (i32.add (local.get $data_pointer) (i32.const 4))))
                                  (call $value_data_lo (local.get $data_pointer))
                                  (call $value_data_hi (local.get $data_pointer)))
                              )
                              (else
                                (if (i32.or
                                      (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ARRAY_FOR_EACH))
                                      (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_TYPED_ARRAY_FOR_EACH)))
                                  (then
                                    ;; forEach returns undefined
                                    (call $pending_push (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))
                                  )
                                  (else
                                    (if (i32.or
                                          (i32.or
                                            (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ARRAY_FIND))
                                            (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_TYPED_ARRAY_FIND)))
                                          (i32.or
                                            (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ARRAY_FIND_LAST))
                                            (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_TYPED_ARRAY_FIND_LAST))))
                                      (then
                                        ;; find/findLast exhausted - return undefined
                                        (call $pending_push (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))
                                      )
                                      (else
                                        (if (i32.or
                                              (i32.or
                                                (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ARRAY_FIND_INDEX))
                                                (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_TYPED_ARRAY_FIND_INDEX)))
                                              (i32.or
                                                (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ARRAY_FIND_LAST_INDEX))
                                                (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_TYPED_ARRAY_FIND_LAST_INDEX))))
                                          (then
                                            ;; findIndex/findLastIndex exhausted - return -1 (as float for consistency)
                                            (call $push_f64 (f64.const -1))
                                          )
                                          (else
                                            (if (i32.or
                                                  (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ARRAY_SOME))
                                                  (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_TYPED_ARRAY_SOME)))
                                              (then
                                                ;; some exhausted - return false
                                                (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (i32.const 0) (i32.const 0))
                                              )
                                              (else
                                                (if (i32.eq (local.get $continuation_kind) (global.get $CONTINUATION_KIND_ARRAY_FLAT_MAP))
                                                  (then
                                                    ;; flatMap exhausted - return result array
                                                    (call $pending_push (global.get $TYPE_ARRAY) (i32.const 0) (local.get $heap_pointer) (i32.const 0))
                                                  )
                                                  (else
                                                    ;; every exhausted - return true
                                                    (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (i32.const 1) (i32.const 0))
                                                  )
                                                )
                                              )
                                            )
                                          )
                                        )
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    )

                    (local.set $instr_count (call $read_instr_count (local.get $code_block)))
                    (local.set $pc (local.get $return_pc))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )
              )
            )

            ;; Normal return (non-iteration)
            ;; v7: FRAME_FLAG_CALLBACK removed - callbacks run in their own contexts

            ;; Generator completion occurs when the
            ;; body's bottom-frame return completes the generator with
            ;; { value, done: true } built by the airlock.
            (if (i32.and
                  (i32.ne (call $read_ctx (global.get $CTX_GENERATOR_OBJECT)) (i32.const 0))
                  (i32.le_u
                    (i32.sub (local.get $stack_pointer) (global.get $FRAME_SIZE))
                    (call $call_stack_base_seg)))
              (then
                (call $pending_push (local.get $result_type) (local.get $result_flags) (local.get $result_lo) (local.get $result_hi))
                (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_GENERATOR_COMPLETE))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $exit)
              )
            )

            ;; Check for async function completion
            ;; If FRAME_ASYNC_PROMISE is set and this is the last frame, signal async completion
            (local.set $async_promise (i32.load (i32.add (local.get $frame_pointer) (global.get $FRAME_ASYNC_PROMISE))))
            (if (i32.and
                  (i32.ne (local.get $async_promise) (i32.const 0))
                  (i32.le_u
                    (i32.sub (local.get $stack_pointer) (global.get $FRAME_SIZE))
                    (call $call_stack_base_seg)))
              (then
                ;; Async function returning - push result and signal completion
                (call $pending_push (local.get $result_type) (local.get $result_flags) (local.get $result_lo) (local.get $result_hi))
                (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_ASYNC_COMPLETE))
                ;; Consume fuel for RETURN instruction before exiting
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $exit)
              )
            )

            ;; Pop the frame now
            (local.set $stack_pointer (i32.sub (local.get $stack_pointer) (global.get $FRAME_SIZE)))
            (local.set $frame_pointer (call $abs (local.get $stack_pointer)))
            (call $write_ctx (global.get $CTX_CALL_STACK_POINTER) (local.get $stack_pointer))

            ;; Restore state from frame - v6: CODE_BLOCK removed
            (local.set $return_pc (i32.load (i32.add (local.get $frame_pointer) (global.get $FRAME_INSTRUCTION_INDEX))))
            (local.set $caller_scope (i32.load (i32.add (local.get $frame_pointer) (global.get $FRAME_SCOPE_POINTER))))

            ;; Restore pending pointer to frame's pending base (discard any leftover args)
            (call $write_ctx (global.get $CTX_PENDING_POINTER)
              (call $load_frame_pending_base (local.get $frame_pointer)))

            ;; Restore scope
            (global.set $current_scope (local.get $caller_scope))

            ;; Push result to caller's pending stack — unless the frame asks
            ;; for the result to be discarded (accessor setter calls: the
            ;; assignment's value already sits below the restored base).
            (if (i32.eqz (i32.and
                  (i32.load (i32.add (local.get $frame_pointer) (global.get $FRAME_FLAGS)))
                  (global.get $FRAME_FLAG_DISCARD_RESULT)))
              (then
                (call $pending_push (local.get $result_type) (local.get $result_flags) (local.get $result_lo) (local.get $result_hi))
              )
            )

            ;; Update instr_count since code_block may have changed (it shouldn't for same code block, but be safe)
            (local.set $instr_count (call $read_instr_count (local.get $code_block)))

            ;; Continue at return address
            (local.set $pc (local.get $return_pc))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )


        ;; =====================================================================
        ;; SPECIAL
        ;; =====================================================================
        (if (i32.eq (local.get $opcode) (global.get $OP_POP))
          (then
            (drop (call $pending_pop))
            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; NOP: no operation - does nothing, no stack effect
        (if (i32.eq (local.get $opcode) (global.get $OP_NOP))
          (then
            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; DUP: duplicate top of pending stack
        (if (i32.eq (local.get $opcode) (global.get $OP_DUP))
          (then
            ;; Peek top value (don't pop)
            (local.set $value_pointer (i32.sub
              (call $read_ctx (global.get $CTX_PENDING_POINTER))
              (global.get $VALUE_SIZE)))
            ;; Push copy
            (call $pending_push
              (i32.load (call $abs (local.get $value_pointer)))
              (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 4))))
              (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 8))))
              (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 12)))))
            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; SWAP: swap top two values on pending stack
        ;; Stack: [a, b] → [b, a]
        (if (i32.eq (local.get $opcode) (global.get $OP_SWAP))
          (then
            ;; Get pointers to top two values
            (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
            ;; top value at pending_pointer - 16, second at pending_pointer - 32
            (local.set $value_pointer (i32.sub (local.get $pending_pointer) (global.get $VALUE_SIZE)))
            (local.set $value_pointer2 (i32.sub (local.get $pending_pointer) (i32.mul (global.get $VALUE_SIZE) (i32.const 2))))

            ;; Read top value (b) into temp storage
            (local.set $type1 (i32.load (call $abs (local.get $value_pointer))))
            (local.set $swap_flags (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 4)))))
            (local.set $data1_lo (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 8)))))
            (local.set $data1_hi (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 12)))))

            ;; Copy second value (a) to top position
            (i32.store (call $abs (local.get $value_pointer))
              (i32.load (call $abs (local.get $value_pointer2))))
            (i32.store (call $abs (i32.add (local.get $value_pointer) (i32.const 4)))
              (i32.load (call $abs (i32.add (local.get $value_pointer2) (i32.const 4)))))
            (i32.store (call $abs (i32.add (local.get $value_pointer) (i32.const 8)))
              (i32.load (call $abs (i32.add (local.get $value_pointer2) (i32.const 8)))))
            (i32.store (call $abs (i32.add (local.get $value_pointer) (i32.const 12)))
              (i32.load (call $abs (i32.add (local.get $value_pointer2) (i32.const 12)))))

            ;; Write temp (b) to second position
            (i32.store (call $abs (local.get $value_pointer2)) (local.get $type1))
            (i32.store (call $abs (i32.add (local.get $value_pointer2) (i32.const 4))) (local.get $swap_flags))
            (i32.store (call $abs (i32.add (local.get $value_pointer2) (i32.const 8))) (local.get $data1_lo))
            (i32.store (call $abs (i32.add (local.get $value_pointer2) (i32.const 12))) (local.get $data1_hi))

            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; =====================================================================
        ;; ARRAY_PUSH_ONE (0x86): peek-array under top value, append top.
        ;; Stack: [arr, v] → [arr]. Used by array-literal spread and call-site
        ;; spread builders to accumulate elements one at a time.
        ;; =====================================================================
        (if (i32.eq (local.get $opcode) (global.get $OP_ARRAY_PUSH_ONE))
          (then
            (local.set $value_pointer (call $pending_pop))    ;; the value to append
            (local.set $array_pointer
              (call $value_data_lo (call $pending_peek)))     ;; array remains on stack
            ;; Grow refused under pressure: nothing was mutated — restore
            ;; the popped value (its slot bytes are intact; pending_push
            ;; rewrites them in place and re-bumps the pointer) and park
            ;; WITHOUT advancing pc; the retry re-runs this op after the
            ;; host gc. This op is the spread builders' accumulator: a
            ;; large `f(...bigArray)` allocates ~80 transient bytes per
            ;; element and NEEDS mid-loop gc cycles to survive small
            ;; heaps.
            (if (call $array_push_value
                  (local.get $array_pointer)
                  (i32.load (call $abs (local.get $value_pointer)))
                  (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 4))))
                  (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 8))))
                  (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 12)))))
              (then
                (call $pending_push
                  (i32.load (call $abs (local.get $value_pointer)))
                  (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 4))))
                  (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 8))))
                  (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 12)))))
                (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                (br $exit)
              )
            )
            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; =====================================================================
        ;; OBJ_MERGE_SPREAD (0x87): peek-object under source. Copy source's own
        ;; enumerable string-keyed properties into the object. Stack:
        ;; [obj, src] → [obj]. JS spec: spread of null/undefined and other
        ;; primitives (numbers, booleans) is a no-op — they contribute no
        ;; own enumerable string-keyed properties. Objects contribute their
        ;; entries; arrays, strings and typed arrays contribute their
        ;; indexed elements under decimal string keys ("0", "1", …) —
        ;; `length` is non-enumerable and is not copied; msgpack map refs
        ;; contribute their entries and msgpack array refs their indexed
        ;; elements (same $msgpack_assign_to_object path Object.assign
        ;; uses). Object sources also contribute their own symbol-keyed
        ;; properties (sym_entries walk, per CopyDataProperties).
        ;;
        ;; Pressure protocol: index keys and code-point slices intern
        ;; mid-loop, $object_set_property's grow branch allocates blindly,
        ;; and BigInt elements allocate — so each chokepoint pre-checks
        ;; and, on refusal, re-pushes the source via
        ;; $obj_merge_spread_pressure_yield and yields; the retry re-runs
        ;; the whole op (idempotent — existing keys update in place).
        ;; =====================================================================
        (if (i32.eq (local.get $opcode) (global.get $OP_OBJ_MERGE_SPREAD))
          (then
            (local.set $value_pointer (call $pending_pop))    ;; the source
            (local.set $type1 (i32.load (call $abs (local.get $value_pointer))))
            (local.set $result_flags (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 4)))))
            (local.set $data1_lo (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 8)))))
            (local.set $data1_hi (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 12)))))

            ;; Destination object (still on pending stack, top after pop above).
            (local.set $dest (call $value_data_lo (call $pending_peek)))

            ;; Object source: walk entries.
            (if (i32.eq (local.get $type1) (global.get $TYPE_OBJECT))
              (then
                (local.set $object_pointer (local.get $data1_lo))
                ;; Layout: [GC:8][prototype:4][count:4][capacity:4][flags:4][entries:4][sym_entries:4]
                (local.set $count
                  (i32.load (call $abs (i32.add (local.get $object_pointer) (i32.const 12)))))
                (local.set $entries_pointer
                  (i32.load (call $abs (i32.add (local.get $object_pointer) (i32.const 24)))))

                ;; For each source entry, copy via $object_set_property.
                (local.set $i (i32.const 0))
                (block $merge_done
                  (loop $merge_loop
                    (br_if $merge_done (i32.ge_u (local.get $i) (local.get $count)))
                    (local.set $entry_pointer (i32.add
                      (i32.add (local.get $entries_pointer) (global.get $GC_HEADER_SIZE))
                      (i32.mul (local.get $i) (global.get $ENTRY_SIZE))))
                    (local.set $key_offset (i32.load (call $abs (local.get $entry_pointer))))
                    ;; '@'-prefixed keys are hidden (non-enumerable) — the
                    ;; spread copies only enumerable string keys.
                    (if (call $string_key_is_hidden (local.get $key_offset))
                      (then
                        (local.set $i (i32.add (local.get $i) (i32.const 1)))
                        (br $merge_loop)
                      )
                    )
                    ;; Getter-backed property: resolve the source into a
                    ;; data-only copy (its getters run through an
                    ;; ACCESSOR_RESOLVE continuation frame), then re-run
                    ;; this spread against the copy. The source is
                    ;; re-pushed first so the re-run — and a pressure
                    ;; retry — sees the original [target, source] shape;
                    ;; entries merged before this point re-merge in place.
                    (if (i32.eq
                          (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 4))))
                          (global.get $TYPE_ACCESSOR))
                      (then
                        (call $pending_push (local.get $type1) (local.get $result_flags)
                          (local.get $data1_lo) (local.get $data1_hi))
                        (local.set $result_i32 (call $accessor_resolve_begin
                          (local.get $object_pointer) (global.get $VALUE_SIZE) (local.get $pc)))
                        (if (i32.eq (local.get $result_i32) (i32.const -2))
                          (then
                            (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                            (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                            (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                            (br $exit)))
                        (local.set $pc (local.get $result_i32))
                        (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                        (br $loop)
                      )
                    )
                    ;; $object_set_property's grow branch allocates blindly —
                    ;; pressure-check the worst case per entry.
                    (if (call $check_heap_overflow (call $estimate_object_grow_size
                          (i32.load (call $abs (i32.add (local.get $dest) (i32.const 16))))))
                      (then
                        (call $obj_merge_spread_pressure_yield (local.get $pc)
                          (local.get $type1) (local.get $result_flags)
                          (local.get $data1_lo) (local.get $data1_hi))
                        (br $exit)))
                    ;; Entry value at entry_pointer + 4: [type:4][flags:4][lo:4][hi:4]
                    ;; Grow pre-budgeted just above — status droppable.
                    (drop (call $object_set_property
                      (local.get $dest)
                      (local.get $key_offset)
                      (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 4))))
                      (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 8))))
                      (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 12))))
                      (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 16))))))
                    (local.set $i (i32.add (local.get $i) (i32.const 1)))
                    (br $merge_loop)
                  )
                )

                ;; Own symbol-keyed properties (sym_entries block): JS
                ;; CopyDataProperties copies own enumerable symbol keys
                ;; too. Values are plain data (symbol-keyed accessors are
                ;; not authorable), so a raw copy through $sym_block_set
                ;; (dedup + lazy-alloc + grow, pressure-guarded) is exact.
                ;; On pressure the whole op yields and retries — earlier
                ;; sym entries re-copy in place via the dedup.
                (local.set $entries_pointer
                  (i32.load (call $abs (i32.add (local.get $object_pointer) (global.get $OBJECT_SYM_ENTRIES_OFFSET)))))
                (if (i32.ne (local.get $entries_pointer) (i32.const 0))
                  (then
                    (local.set $count (i32.load (call $abs (i32.add (local.get $entries_pointer) (i32.const 8)))))
                    (local.set $i (i32.const 0))
                    (block $sym_merge_done
                      (loop $sym_merge_loop
                        (br_if $sym_merge_done (i32.ge_u (local.get $i) (local.get $count)))
                        (local.set $entry_pointer (i32.add
                          (i32.add (local.get $entries_pointer) (i32.const 16))
                          (i32.mul (local.get $i) (global.get $ENTRY_SIZE))))
                        (if (call $sym_block_set
                              (i32.add (local.get $dest) (global.get $OBJECT_SYM_ENTRIES_OFFSET))
                              (i32.load (call $abs (local.get $entry_pointer)))
                              (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 4))))
                              (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 8))))
                              (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 12))))
                              (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 16)))))
                          (then
                            (call $obj_merge_spread_pressure_yield (local.get $pc)
                              (local.get $type1) (local.get $result_flags)
                              (local.get $data1_lo) (local.get $data1_hi))
                            (br $exit)))
                        (local.set $i (i32.add (local.get $i) (i32.const 1)))
                        (br $sym_merge_loop)
                      )
                    )
                  )
                )

                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Array source: indexed elements land under decimal string keys.
            (if (i32.eq (local.get $type1) (global.get $TYPE_ARRAY))
              (then
                (local.set $array_pointer (local.get $data1_lo))
                (local.set $arr_len (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 8)))))
                (local.set $data_pointer (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 16)))))
                (local.set $i (i32.const 0))
                (block $spread_array_done
                  (loop $spread_array_loop
                    (br_if $spread_array_done (i32.ge_u (local.get $i) (local.get $arr_len)))
                    ;; Chokepoint: $f64_to_string interns and self-signals
                    ;; pressure (sentinel id 0) on string-table overflow.
                    (local.set $key_offset (call $f64_to_string (f64.convert_i32_u (local.get $i))))
                    (if (global.get $memory_pressure_signaled)
                      (then
                        (call $obj_merge_spread_pressure_yield (local.get $pc)
                          (local.get $type1) (local.get $result_flags)
                          (local.get $data1_lo) (local.get $data1_hi))
                        (br $exit)))
                    (if (call $check_heap_overflow (call $estimate_object_grow_size
                          (i32.load (call $abs (i32.add (local.get $dest) (i32.const 16))))))
                      (then
                        (call $obj_merge_spread_pressure_yield (local.get $pc)
                          (local.get $type1) (local.get $result_flags)
                          (local.get $data1_lo) (local.get $data1_hi))
                        (br $exit)))
                    (local.set $element_pointer (i32.add
                      (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
                      (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
                    ;; Grow pre-budgeted just above — status droppable.
                    (drop (call $object_set_property
                      (local.get $dest)
                      (local.get $key_offset)
                      (i32.load (call $abs (local.get $element_pointer)))
                      (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 4))))
                      (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 8))))
                      (i32.load (call $abs (i32.add (local.get $element_pointer) (i32.const 12))))))
                    (local.set $i (i32.add (local.get $i) (i32.const 1)))
                    (br $spread_array_loop)
                  )
                )

                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; String source: one single-code-point string per decimal index
            ;; key, same UTF-8 slicing as the string iterator's .next().
            (if (i32.eq (local.get $type1) (global.get $TYPE_STRING))
              (then
                ;; data1_lo = string id. Walk bytes; $i counts code points.
                (local.set $data_size (i32.load (call $string_id_to_abs (local.get $data1_lo))))
                (local.set $data_pointer (call $string_id_to_seg (local.get $data1_lo)))
                (local.set $index (i32.const 0))   ;; byte offset into the source
                (local.set $i (i32.const 0))       ;; code-point index
                (block $spread_string_done
                  (loop $spread_string_loop
                    (br_if $spread_string_done (i32.ge_u (local.get $index) (local.get $data_size)))
                    (local.set $count (call $utf8_char_byte_len (local.get $data_pointer) (local.get $index)))
                    ;; Chokepoints: both interns self-signal pressure.
                    ;; intern_string takes an ABSOLUTE byte pointer; bytes
                    ;; start at entry + 4 (past the length prefix).
                    (local.set $left_id (call $intern_string
                      (call $abs (i32.add
                        (i32.add (local.get $data_pointer) (i32.const 4))
                        (local.get $index)))
                      (local.get $count)))
                    (if (global.get $memory_pressure_signaled)
                      (then
                        (call $obj_merge_spread_pressure_yield (local.get $pc)
                          (local.get $type1) (local.get $result_flags)
                          (local.get $data1_lo) (local.get $data1_hi))
                        (br $exit)))
                    (local.set $key_offset (call $f64_to_string (f64.convert_i32_u (local.get $i))))
                    (if (global.get $memory_pressure_signaled)
                      (then
                        (call $obj_merge_spread_pressure_yield (local.get $pc)
                          (local.get $type1) (local.get $result_flags)
                          (local.get $data1_lo) (local.get $data1_hi))
                        (br $exit)))
                    (if (call $check_heap_overflow (call $estimate_object_grow_size
                          (i32.load (call $abs (i32.add (local.get $dest) (i32.const 16))))))
                      (then
                        (call $obj_merge_spread_pressure_yield (local.get $pc)
                          (local.get $type1) (local.get $result_flags)
                          (local.get $data1_lo) (local.get $data1_hi))
                        (br $exit)))
                    ;; Grow pre-budgeted just above — status droppable.
                    (drop (call $object_set_property
                      (local.get $dest) (local.get $key_offset)
                      (global.get $TYPE_STRING) (i32.const 0)
                      (local.get $left_id) (i32.const 0)))
                    (local.set $index (i32.add (local.get $index) (local.get $count)))
                    (local.set $i (i32.add (local.get $i) (i32.const 1)))
                    (br $spread_string_loop)
                  )
                )

                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Typed-array source: elements land under decimal string keys.
            ;; Value shape matches GET_INDEX: BigInt arrays build heap
            ;; BigInts, float arrays stay floats, integer arrays become
            ;; inline Rationals (exact compare against integer literals).
            (if (call $is_typed_array (local.get $type1))
              (then
                ;; Descriptor: [bufferPtr:4][byteOffset:4][length:4][sym_entries:4]
                (local.set $data_pointer (i32.load (call $abs (local.get $data1_lo))))
                (local.set $arr_cap (i32.load (call $abs (i32.add (local.get $data1_lo) (i32.const 4)))))
                (local.set $arr_len (i32.load (call $abs (i32.add (local.get $data1_lo) (i32.const 8)))))
                (local.set $result_lo (call $get_bytes_per_element (local.get $type1)))
                (local.set $i (i32.const 0))
                (block $spread_typed_done
                  (loop $spread_typed_loop
                    (br_if $spread_typed_done (i32.ge_u (local.get $i) (local.get $arr_len)))
                    ;; Chokepoint: index-key interning.
                    (local.set $key_offset (call $f64_to_string (f64.convert_i32_u (local.get $i))))
                    (if (global.get $memory_pressure_signaled)
                      (then
                        (call $obj_merge_spread_pressure_yield (local.get $pc)
                          (local.get $type1) (local.get $result_flags)
                          (local.get $data1_lo) (local.get $data1_hi))
                        (br $exit)))
                    ;; ArrayBuffer layout: [GC:8][byteLength:4][bytes...] —
                    ;; bytes start at bufferPtr + 4.
                    (local.set $element_pointer (call $abs (i32.add
                      (i32.add
                        (i32.add (local.get $data_pointer) (i32.const 4))
                        (local.get $arr_cap))
                      (i32.mul (local.get $i) (local.get $result_lo)))))
                    (if (i32.or
                          (i32.eq (local.get $type1) (global.get $TYPE_BIGINT64ARRAY))
                          (i32.eq (local.get $type1) (global.get $TYPE_BIGUINT64ARRAY)))
                      (then
                        ;; One combined check: fresh 2-limb BigInt + possible
                        ;; entries grow (separate checks could each pass while
                        ;; the sum overflows).
                        (if (call $check_heap_overflow (i32.add
                              (call $estimate_bigint_size (i32.const 2))
                              (call $estimate_object_grow_size
                                (i32.load (call $abs (i32.add (local.get $dest) (i32.const 16)))))))
                          (then
                            (call $obj_merge_spread_pressure_yield (local.get $pc)
                              (local.get $type1) (local.get $result_flags)
                              (local.get $data1_lo) (local.get $data1_hi))
                            (br $exit)))
                        (local.set $set_val_type (global.get $TYPE_BIGINT))
                        (local.set $set_val_flags (i32.const 0))
                        (local.set $set_val_lo
                          (call $bigint_from_typed_i64 (local.get $type1) (local.get $element_pointer)))
                        (local.set $set_val_hi (i32.const 0))
                      )
                      (else
                        (if (call $check_heap_overflow (call $estimate_object_grow_size
                              (i32.load (call $abs (i32.add (local.get $dest) (i32.const 16))))))
                          (then
                            (call $obj_merge_spread_pressure_yield (local.get $pc)
                              (local.get $type1) (local.get $result_flags)
                              (local.get $data1_lo) (local.get $data1_hi))
                            (br $exit)))
                        (if (i32.or
                              (i32.eq (local.get $type1) (global.get $TYPE_FLOAT32ARRAY))
                              (i32.eq (local.get $type1) (global.get $TYPE_FLOAT64ARRAY)))
                          (then
                            (local.set $result_i64 (i64.reinterpret_f64
                              (call $read_typed_element (local.get $type1) (local.get $element_pointer))))
                            (local.set $set_val_type (global.get $TYPE_FLOAT))
                            (local.set $set_val_flags (i32.const 0))
                          )
                          (else
                            (local.set $result_i64 (i64.trunc_sat_f64_s
                              (call $read_typed_element (local.get $type1) (local.get $element_pointer))))
                            (local.set $set_val_type (global.get $TYPE_RATIONAL))
                            (local.set $set_val_flags (global.get $FLAG_RATIONAL_INLINE))
                          )
                        )
                        (local.set $set_val_lo (i32.wrap_i64 (local.get $result_i64)))
                        (local.set $set_val_hi (i32.wrap_i64 (i64.shr_u (local.get $result_i64) (i64.const 32))))
                      )
                    )
                    ;; Grow pre-budgeted just above — status droppable.
                    (drop (call $object_set_property
                      (local.get $dest) (local.get $key_offset)
                      (local.get $set_val_type) (local.get $set_val_flags)
                      (local.get $set_val_lo) (local.get $set_val_hi)))
                    (local.set $i (i32.add (local.get $i) (i32.const 1)))
                    (br $spread_typed_loop)
                  )
                )

                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Msgpack container ref source: same copy path Object.assign
            ;; uses — maps contribute their entries, arrays their indexed
            ;; elements under decimal string keys. A nonzero return means
            ;; an allocation was refused under pressure. Primitive refs
            ;; contribute nothing (spec no-op).
            (if (i32.eq (local.get $type1) (global.get $TYPE_MSGPACK_REF))
              (then
                (if (call $msgpack_assign_to_object
                      (local.get $dest)
                      (call $msgpack_ref_absolute (local.get $data1_lo) (local.get $data1_hi))
                      (call $msgpack_ref_parent_end (local.get $data1_lo))
                      (local.get $data1_lo))
                  (then
                    (call $obj_merge_spread_pressure_yield (local.get $pc)
                      (local.get $type1) (local.get $result_flags)
                      (local.get $data1_lo) (local.get $data1_hi))
                    (br $exit)))

                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Everything else (null, undefined, numbers, booleans, …):
            ;; no own enumerable string-keyed properties — no-op (spec).
            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; CALL_SPREAD (0x88) and CALL_METHOD_SPREAD (0x89) are handled by the
        ;; shared CALL / CALL_METHOD handlers above (spread prologue unpacks
        ;; the packed args array, then every callee kind takes its regular
        ;; branch).

        ;; =====================================================================
        ;; WRAP_GETTER (0x8A) / WRAP_SETTER (0x8B): pop a closure, push a
        ;; TYPE_ACCESSOR property value carrying it in the getter (data_lo)
        ;; or setter (data_hi) half, the other half 0. Parser-only: emitted
        ;; for `get prop() {}` / `set prop(v) {}` in object literals; the
        ;; property-store paths merge halves when one key defines both.
        ;; =====================================================================
        (if (i32.or
              (i32.eq (local.get $opcode) (global.get $OP_WRAP_GETTER))
              (i32.eq (local.get $opcode) (global.get $OP_WRAP_SETTER)))
          (then
            (local.set $value_pointer (call $pending_pop))
            (if (i32.ne (call $value_type (local.get $value_pointer)) (global.get $TYPE_FUNCTION))
              (then
                ;; Internal: the parser always emits a closure directly
                ;; before this opcode.
                (if (call $raise_error (global.get $ERR_TYPE_ERROR)
                      (call $value_type (local.get $value_pointer)))
                  (then (br $exit)))
                (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                (br $loop)
              )
            )
            (if (i32.eq (local.get $opcode) (global.get $OP_WRAP_GETTER))
              (then
                (call $pending_push (global.get $TYPE_ACCESSOR) (i32.const 0)
                  (call $value_data_lo (local.get $value_pointer)) (i32.const 0))
              )
              (else
                (call $pending_push (global.get $TYPE_ACCESSOR) (i32.const 0)
                  (i32.const 0) (call $value_data_lo (local.get $value_pointer)))
              )
            )
            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; =====================================================================
        ;; RECONCILE_PARAMS: reshape pending stack to match the function's
        ;; declared parameter list. First instruction of every function body.
        ;;
        ;; operand1 = paramCount (number of declared parameters, including rest)
        ;; operand2 = hasRest (1 if last param is a rest parameter, 0 otherwise)
        ;;
        ;; Reads FRAME.ARGC (the count of actual args passed by the caller).
        ;; - argc < (hasRest ? paramCount-1 : paramCount): pads with undefined
        ;; - argc >= (hasRest ? paramCount-1 : paramCount) and hasRest=1:
        ;;     packs excess into an array as the rest param's value
        ;; - argc > paramCount and hasRest=0: drops excess
        ;; =====================================================================
        (if (i32.eq (local.get $opcode) (global.get $OP_RECONCILE_PARAMS))
          (then
            ;; Corrupt-operand tripwires. $pending_push writes blind, so
            ;; a corrupt paramCount would flood undefineds from the
            ;; pending-stack block to the end of linear memory. The
            ;; parser caps declared parameters at $MAX_PARAMETER_COUNT
            ;; and emits hasRest only as 0/1 (with at least one declared
            ;; param when 1) — anything else is a corrupted code block,
            ;; never a program.
            (if (i32.gt_u (local.get $operand1) (global.get $MAX_PARAMETER_COUNT))
              (then
                (call $fault_error (global.get $ERR_CORRUPT_OPERAND) (local.get $operand1) (local.get $pc))
                (br $exit)))
            (if (i32.or
                  (i32.gt_u (local.get $operand2) (i32.const 1))
                  (i32.and (i32.eq (local.get $operand2) (i32.const 1))
                           (i32.eqz (local.get $operand1))))
              (then
                (call $fault_error (global.get $ERR_CORRUPT_OPERAND) (local.get $operand2) (local.get $pc))
                (br $exit)))

            ;; Read argc. Two cases:
            ;;   (a) There is a frame on the call stack (sync OP_CALL, iteration,
            ;;       OP_NEW, async-call airlock all push frames): read FRAME.ARGC.
            ;;   (b) No frame (setupCallbackContext: callback dispatched from
            ;;       host with args pre-pushed on a fresh pending stack):
            ;;       compute argc from pending stack depth.
            (local.set $stack_pointer (call $read_ctx (global.get $CTX_CALL_STACK_POINTER)))
            (if (i32.gt_u (local.get $stack_pointer)
                          (call $call_stack_base_seg))
              (then
                ;; Have a frame — read FRAME.ARGC.
                (local.set $frame_pointer
                  (call $abs (i32.sub (local.get $stack_pointer) (global.get $FRAME_SIZE))))
                (local.set $count
                  (i32.load (i32.add (local.get $frame_pointer) (global.get $FRAME_ARGC))))
                ;; ARGC holds a call op's argc operand verbatim — a
                ;; value claiming more arguments than the operand stack
                ;; holds is the same fault class as a corrupt operand,
                ;; and would drive the pad loop below unbounded.
                (if (i32.gt_u (local.get $count)
                      (i32.div_u
                        (i32.sub
                          (call $read_ctx (global.get $CTX_PENDING_POINTER))
                          (call $pending_base_seg))
                        (global.get $VALUE_SIZE)))
                  (then
                    (call $fault_error (global.get $ERR_CORRUPT_OPERAND) (local.get $count) (local.get $pc))
                    (br $exit)))
              )
              (else
                ;; No frame — argc = pending depth (in VALUE_SIZE units).
                (local.set $count
                  (i32.div_u
                    (i32.sub
                      (call $read_ctx (global.get $CTX_PENDING_POINTER))
                      (call $pending_base_seg))
                    (global.get $VALUE_SIZE)))
              )
            )
            (local.set $param_count (local.get $operand1))                                  ;; paramCount

            (if (local.get $operand2)
              (then
                ;; hasRest=1: nonRestCount = paramCount - 1
                (local.set $i (i32.sub (local.get $param_count) (i32.const 1)))
                (if (i32.lt_s (local.get $count) (local.get $i))
                  (then
                    ;; argc < nonRestCount: pad with undefined to nonRestCount,
                    ;; then push empty array as rest.
                    ;;
                    ;; Pre-grow the pending stack for the whole burst
                    ;; (pad + rest array + safepoint slack): $pending_push
                    ;; writes blind, and the per-instruction safepoint
                    ;; only guarantees slack for 4 values. Same shape as
                    ;; the spread-unpack capacity loops: $grow_stack
                    ;; doubles, so loop until it fits. Nothing is pushed
                    ;; until capacity is assured, and growth keeps all
                    ;; three ctx fields consistent — a pressure yield
                    ;; here needs no pointer restore.
                    (block $pad_capacity_ok
                      (loop $pad_capacity_loop
                        (br_if $pad_capacity_ok
                          (i32.le_u
                            (i32.add
                              (call $read_ctx (global.get $CTX_PENDING_POINTER))
                              (i32.mul
                                (i32.add (i32.sub (local.get $i) (local.get $count)) (i32.const 5))
                                (global.get $VALUE_SIZE)))
                            (call $read_ctx (global.get $CTX_PENDING_LIMIT))))
                        (if (call $grow_stack
                              (global.get $CTX_PENDING_BASE) (global.get $CTX_PENDING_LIMIT)
                              (global.get $CTX_PENDING_POINTER))
                          (then
                            (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                            (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                            (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                            (br $exit)))
                        (br $pad_capacity_loop)
                      )
                    )
                    ;; Pressure pre-check: empty rest array. After the
                    ;; capacity loop — stack growth consumes heap.
                    ;; Nothing has been pushed yet, so there is nothing
                    ;; to restore.
                    (if (call $check_heap_overflow (call $estimate_array_size (i32.const 0)))
                      (then
                        (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                        (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                        (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                        (br $exit)))
                    (block $pad_done
                      (loop $pad_loop
                        (br_if $pad_done (i32.ge_s (local.get $count) (local.get $i)))
                        (call $pending_push
                          (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))
                        (local.set $count (i32.add (local.get $count) (i32.const 1)))
                        (br $pad_loop)
                      )
                    )
                    ;; Push empty array
                    (local.set $array_pointer (call $allocate_array (i32.const 0)))
                    (call $pending_push
                      (global.get $TYPE_ARRAY) (i32.const 0) (local.get $array_pointer) (i32.const 0))
                  )
                  (else
                    ;; argc >= nonRestCount: pack (argc - nonRestCount) into array.
                    (local.set $arr_len (i32.sub (local.get $count) (local.get $i)))
                    ;; Pressure pre-check: rest array sized to packed
                    ;; count. Nothing has been popped yet, so there is
                    ;; nothing to restore.
                    (if (call $check_heap_overflow
                          (call $estimate_array_size (local.get $arr_len)))
                      (then
                        (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                        (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                        (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                        (br $exit)))
                    (local.set $array_pointer (call $allocate_array (local.get $arr_len)))
                    ;; data_pointer = array_pointer + 16 (header) + GC_HEADER_SIZE
                    ;; Actually array's data_pointer field is at offset 16.
                    (local.set $data_pointer
                      (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 16)))))
                    ;; Copy values from pending stack to array data (preserving order).
                    ;; Top of pending stack is the last rest arg, which goes at array[arr_len-1].
                    ;; Pop one at a time, writing in reverse index order.
                    (local.set $index (local.get $arr_len))
                    (block $pack_done
                      (loop $pack_loop
                        (br_if $pack_done (i32.eqz (local.get $index)))
                        (local.set $index (i32.sub (local.get $index) (i32.const 1)))
                        (local.set $value_pointer (call $pending_pop))
                        ;; Destination in array data: data_pointer + GC_HEADER_SIZE + index * VALUE_SIZE
                        (local.set $dest
                          (i32.add
                            (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
                            (i32.mul (local.get $index) (global.get $VALUE_SIZE))))
                        ;; Copy 16 bytes from value_pointer to dest
                        (i32.store (call $abs (local.get $dest))
                          (i32.load (call $abs (local.get $value_pointer))))
                        (i32.store (call $abs (i32.add (local.get $dest) (i32.const 4)))
                          (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 4)))))
                        (i32.store (call $abs (i32.add (local.get $dest) (i32.const 8)))
                          (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 8)))))
                        (i32.store (call $abs (i32.add (local.get $dest) (i32.const 12)))
                          (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 12)))))
                        (br $pack_loop)
                      )
                    )
                    ;; Push the rest array as the last value.
                    (call $pending_push
                      (global.get $TYPE_ARRAY) (i32.const 0) (local.get $array_pointer) (i32.const 0))
                  )
                )
              )
              (else
                ;; hasRest=0: reconcile against paramCount.
                (if (i32.lt_s (local.get $count) (local.get $param_count))
                  (then
                    ;; argc < paramCount: pad with undefined. Pre-grow
                    ;; the pending stack for the whole pad burst first —
                    ;; $pending_push writes blind, and the per-instruction
                    ;; safepoint only guarantees slack for 4 values.
                    (block $pad_capacity_ok2
                      (loop $pad_capacity_loop2
                        (br_if $pad_capacity_ok2
                          (i32.le_u
                            (i32.add
                              (call $read_ctx (global.get $CTX_PENDING_POINTER))
                              (i32.mul
                                (i32.add (i32.sub (local.get $param_count) (local.get $count)) (i32.const 4))
                                (global.get $VALUE_SIZE)))
                            (call $read_ctx (global.get $CTX_PENDING_LIMIT))))
                        (if (call $grow_stack
                              (global.get $CTX_PENDING_BASE) (global.get $CTX_PENDING_LIMIT)
                              (global.get $CTX_PENDING_POINTER))
                          (then
                            (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                            (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                            (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                            (br $exit)))
                        (br $pad_capacity_loop2)
                      )
                    )
                    (block $pad_done2
                      (loop $pad_loop2
                        (br_if $pad_done2 (i32.ge_s (local.get $count) (local.get $param_count)))
                        (call $pending_push
                          (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))
                        (local.set $count (i32.add (local.get $count) (i32.const 1)))
                        (br $pad_loop2)
                      )
                    )
                  )
                  (else
                    ;; argc > paramCount: drop excess from top.
                    (block $drop_done
                      (loop $drop_loop
                        (br_if $drop_done (i32.le_s (local.get $count) (local.get $param_count)))
                        (drop (call $pending_pop))
                        (local.set $count (i32.sub (local.get $count) (i32.const 1)))
                        (br $drop_loop)
                      )
                    )
                  )
                )
              )
            )

            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; Unknown opcode - error.
        ;; If this fires, either (a) the bytecode region was corrupted
        ;; (e.g., heap allocator overran the code block), or (b) the
        ;; compiler emitted an undefined opcode. Detail = the byte the
        ;; dispatcher fetched.
        (call $fault_error (global.get $ERR_UNKNOWN_OPCODE) (local.get $opcode) (local.get $pc))
        (br $exit)
      )
    )

    ;; Step ring: record final state after the exit
    (call $step_ring_write (local.get $context_slot) (local.get $pc) (local.get $opcode))

    ;; Return remaining fuel. Status is in CTX_STATUS.
    (local.get $fuel)
  )

  ;; ==========================================================================
  ;; GARBAGE COLLECTOR
  ;; ==========================================================================

  ;; collector.js is the differential oracle. Every $gc_mark_* function
  ;; mirrors its markX counterpart, including deliberate leniencies
  ;; such as heap-bound skips, string-id clamps, and unknown types as
  ;; silent leaves.

  ;;
  ;; Working memory lives OUTSIDE the vat segment in the host-written
  ;; GC scratch block (gc-scratch-layout.js): knowledge tables, the
  ;; string-mark bitmap, AST visited bitmap + worklist, the
  ;; handle-liveness bitmap, and the external-root block.
  ;;
  ;; Failure: detected violations stamp [code][detail][phase] via
  ;; $gc_stamp_error_info and trap; the JS wrapper converts either
  ;; channel into FatalCollectionError + sticky poisoning.
  ;; ==========================================================================

  ;; Scratch-block header field offsets (must verify against
  ;; constants.js GC_SCRATCH_HEADER via the layout verifier).
  (global $GC_SCRATCH_OPERAND_KINDS_OFFSET i32 (i32.const 0))
  (global $GC_SCRATCH_INTRINSIC_CELLS_OFFSET i32 (i32.const 4))
  (global $GC_SCRATCH_INTRINSIC_CELL_COUNT i32 (i32.const 8))
  (global $GC_SCRATCH_AST_LAYOUT_OFFSET i32 (i32.const 12))
  (global $GC_SCRATCH_AST_LAYOUT_TAG_CAPACITY i32 (i32.const 16))
  (global $GC_SCRATCH_STRING_MARK_BITMAP_OFFSET i32 (i32.const 20))
  (global $GC_SCRATCH_STRING_MARK_BITMAP_SIZE i32 (i32.const 24))
  (global $GC_SCRATCH_AST_VISITED_BITMAP_OFFSET i32 (i32.const 28))
  (global $GC_SCRATCH_AST_VISITED_BITMAP_SIZE i32 (i32.const 32))
  (global $GC_SCRATCH_AST_WORKLIST_OFFSET i32 (i32.const 36))
  (global $GC_SCRATCH_AST_WORKLIST_CAPACITY i32 (i32.const 40))
  (global $GC_SCRATCH_HANDLE_BITMAP_OFFSET i32 (i32.const 44))
  (global $GC_SCRATCH_HANDLE_BITMAP_CAPACITY i32 (i32.const 48))
  (global $GC_SCRATCH_ROOT_BLOCK_OFFSET i32 (i32.const 52))
  (global $GC_SCRATCH_ROOT_CAPACITY i32 (i32.const 56))
  (global $GC_SCRATCH_ROOT_COUNT i32 (i32.const 60))
  (global $GC_SCRATCH_STRING_FORWARDING_OFFSET i32 (i32.const 64))
  (global $GC_SCRATCH_STRING_FORWARDING_ENTRIES i32 (i32.const 68))

  ;; Constants the collector needs that had no WAT mirror before.
  (global $BUILTINS_SIZE i32 (i32.const 4096))
  (global $OBJ_PARAM_LIST i32 (i32.const 4))
  (global $OBJ_THEN_HANDLER i32 (i32.const 12))
  (global $CONTEXT_STATUS_FREE i32 (i32.const 0xFF))
  (global $THEN_HANDLER_ON_RESOLVED i32 (i32.const 0x00))
  (global $THEN_HANDLER_ON_REJECTED i32 (i32.const 0x04))
  (global $THEN_HANDLER_CHILD_PROMISE i32 (i32.const 0x08))
  (global $THEN_HANDLER_NEXT i32 (i32.const 0x0C))
  (global $STATE_AST_REGION_BASE i32 (i32.const 0x94))    ;; 16 + 0x84
  (global $STATE_AST_REGION_SIZE i32 (i32.const 0x98))    ;; 16 + 0x88
  (global $STATE_AST_REGION_POINTER i32 (i32.const 0x9C)) ;; 16 + 0x8C
  (global $AST_REGION_FIRST_ROOT i32 (i32.const 0x08))
  (global $STATE_ROOT_SCOPE i32 (i32.const 0x8C))        ;; 16 + 0x7C
  (global $GC_ERR_SEGMENT_BOUNDS i32 (i32.const 0x40))
  (global $GC_ERR_COPY_RANGE i32 (i32.const 0x41))
  (global $GC_ERR_HANDLE_SLOT_RANGE i32 (i32.const 0x42))
  (global $GC_ERR_ROOT_BLOCK_RANGE i32 (i32.const 0x43))
  (global $GC_ERR_AST_TAG i32 (i32.const 0x44))
  (global $GC_ERR_AST_WORKLIST i32 (i32.const 0x45))
  (global $GC_ERR_HEAP_HEADER i32 (i32.const 0x46))
  (global $GC_PHASE_MARK i32 (i32.const 1))
  (global $GC_PHASE_COMPUTE i32 (i32.const 2))
  (global $GC_PHASE_UPDATE i32 (i32.const 3))
  (global $GC_PHASE_MOVE i32 (i32.const 4))
  (global $GC_PHASE_STRINGS i32 (i32.const 5))
  (global $GC_PHASE_HASH_REBUILD i32 (i32.const 6))

  ;; Per-collection cached state (absolute addresses unless noted).
  (global $gc_phase (mut i32) (i32.const 0))
  (global $gc_heap_start (mut i32) (i32.const 0))       ;; segment-relative
  (global $gc_heap_end (mut i32) (i32.const 0))         ;; segment-relative (heap pointer at entry)
  (global $gc_string_data_start (mut i32) (i32.const 0)) ;; table-relative first id
  (global $gc_string_bitmap (mut i32) (i32.const 0))
  (global $gc_string_bitmap_size (mut i32) (i32.const 0))
  (global $gc_handle_bitmap (mut i32) (i32.const 0))
  (global $gc_handle_capacity (mut i32) (i32.const 0))
  (global $gc_operand_kinds (mut i32) (i32.const 0))
  (global $gc_intrinsic_cells (mut i32) (i32.const 0))
  (global $gc_intrinsic_count (mut i32) (i32.const 0))
  (global $gc_ast_layout (mut i32) (i32.const 0))
  (global $gc_ast_tag_capacity (mut i32) (i32.const 0))
  (global $gc_ast_visited (mut i32) (i32.const 0))
  (global $gc_ast_worklist (mut i32) (i32.const 0))
  (global $gc_ast_worklist_capacity (mut i32) (i32.const 0))
  (global $gc_ast_worklist_sp (mut i32) (i32.const 0))
  (global $gc_root_block (mut i32) (i32.const 0))
  (global $gc_root_count (mut i32) (i32.const 0))
  (global $gc_string_forwarding (mut i32) (i32.const 0))
  (global $gc_string_forwarding_entries (mut i32) (i32.const 0))
  (global $gc_ast_visited_size (mut i32) (i32.const 0))
  (global $gc_segment_lo (mut i32) (i32.const 0))  ;; abs(0)
  (global $gc_segment_hi (mut i32) (i32.const 0))  ;; abs(SEGMENT_SIZE)

  ;; The collector's failure stamp: [code][detail][phase] — the phase
  ;; id rides in the pc slot; GC_ERR codes tell readers it is a phase.
  ;; Allowlisted error-info writer (verify-region-write-discipline).
  (func $gc_stamp_error_info (param $code i32) (param $detail i32) (param $phase i32)
    (i32.store (call $abs (global.get $error_info_base)) (local.get $code))
    (i32.store (call $abs (i32.add (global.get $error_info_base) (i32.const 4))) (local.get $detail))
    (i32.store (call $abs (i32.add (global.get $error_info_base) (i32.const 8))) (local.get $phase))
  )

  (func $gc_fail (param $code i32) (param $detail i32)
    (call $gc_stamp_error_info (local.get $code) (local.get $detail) (global.get $gc_phase))
    unreachable
  )

  ;; The segment-bounds guard (error-reporting design): every
  ;; image-derived ABSOLUTE address the collector dereferences must lie
  ;; inside the vat segment. Tighter than the JS collector's
  ;; buffer-bounds abs() throw — in a multi-vat memory a corrupt
  ;; pointer must never read or write a NEIGHBORING vat (or the GC
  ;; scratch pages). The wrap-safe form: addr in [lo, hi - bytes].
  (func $gc_check_abs (param $addr_abs i32) (param $bytes i32)
    (if (i32.lt_u (local.get $addr_abs) (global.get $gc_segment_lo))
      (then (call $gc_fail (global.get $GC_ERR_SEGMENT_BOUNDS) (local.get $addr_abs))))
    (if (i32.gt_u (local.get $addr_abs)
          (i32.sub (global.get $gc_segment_hi) (local.get $bytes)))
      (then (call $gc_fail (global.get $GC_ERR_SEGMENT_BOUNDS) (local.get $addr_abs))))
  )

  ;; Mirror of collector.js markString: clamp id 0 / hash-table ids /
  ;; out-of-bitmap ids to no-ops — NEVER a failure (parity).
  (func $gc_mark_string (param $id i32)
    (local $bit i32)
    (local $byte i32)
    (local $addr i32)
    (if (i32.eqz (local.get $id)) (then (return)))
    (if (i32.lt_u (local.get $id) (global.get $gc_string_data_start)) (then (return)))
    (local.set $bit (i32.shr_u (i32.sub (local.get $id) (global.get $gc_string_data_start)) (i32.const 2)))
    (local.set $byte (i32.shr_u (local.get $bit) (i32.const 3)))
    (if (i32.ge_u (local.get $byte) (global.get $gc_string_bitmap_size)) (then (return)))
    (local.set $addr (i32.add (global.get $gc_string_bitmap) (local.get $byte)))
    (i32.store8 (local.get $addr)
      (i32.or (i32.load8_u (local.get $addr))
        (i32.shl (i32.const 1) (i32.and (local.get $bit) (i32.const 7)))))
  )

  ;; The valueObserver equivalent: record live handle slots into the
  ;; handle bitmap at the exact point markValue observes them.
  (func $gc_observe_handle (param $type i32) (param $data_lo i32)
    (local $addr i32)
    (if (i32.and
          (i32.ne (local.get $type) (global.get $TYPE_EXTERNAL))
          (i32.ne (local.get $type) (global.get $TYPE_EXTERNAL_METHOD)))
      (then (return)))
    (if (i32.ge_u (local.get $data_lo) (global.get $gc_handle_capacity))
      (then (call $gc_fail (global.get $GC_ERR_HANDLE_SLOT_RANGE) (local.get $data_lo))))
    (local.set $addr (i32.add (global.get $gc_handle_bitmap)
      (i32.shr_u (local.get $data_lo) (i32.const 3))))
    (i32.store8 (local.get $addr)
      (i32.or (i32.load8_u (local.get $addr))
        (i32.shl (i32.const 1) (i32.and (local.get $data_lo) (i32.const 7)))))
  )

  ;; True iff receiver type stores a DATA pointer in a BOUND_METHOD's
  ;; data_lo (mirror of the markValue BOUND_METHOD case).
  (func $gc_is_typed_array_type (param $type i32) (result i32)
    (i32.or (i32.or
      (i32.eq (local.get $type) (global.get $TYPE_UINT8ARRAY))
      (i32.and
        (i32.ge_u (local.get $type) (global.get $TYPE_INT8ARRAY))
        (i32.le_u (local.get $type) (global.get $TYPE_FLOAT64ARRAY))))
      (i32.or
        (i32.eq (local.get $type) (global.get $TYPE_BIGINT64ARRAY))
        (i32.eq (local.get $type) (global.get $TYPE_BIGUINT64ARRAY))))
  )

  ;; Mirror of markValue: dispatch a 16-byte value slot's heap/string
  ;; edge. $value_addr is segment-relative.
  (func $gc_mark_value (param $value_addr i32)
    (local $abs i32)
    (local $type i32)
    (local $data_lo i32)
    (local $flags i32)
    (local $recv_type i32)
    (local.set $abs (call $abs (local.get $value_addr)))
    (call $gc_check_abs (local.get $abs) (global.get $VALUE_SIZE))
    (local.set $type (i32.load (local.get $abs)))
    (local.set $data_lo (i32.load (i32.add (local.get $abs) (i32.const 8))))

    (call $gc_observe_handle (local.get $type) (local.get $data_lo))

    ;; Promise executor continuations carry a Promise DATA pointer. They may
    ;; outlive the executor when stored in user objects.
    (if (i32.or
          (i32.eq (local.get $type) (global.get $TYPE_PROMISE_RESOLVE))
          (i32.eq (local.get $type) (global.get $TYPE_PROMISE_REJECT)))
      (then
        (if (i32.ne (local.get $data_lo) (i32.const 0))
          (then (call $gc_mark_object_by_header
            (i32.sub (local.get $data_lo) (global.get $GC_HEADER_SIZE)))))
        (return)))

    ;; HEADER-pointer class.
    (if (i32.or (i32.or (i32.or (i32.or (i32.or
          (i32.eq (local.get $type) (global.get $TYPE_ARRAY))
          (i32.eq (local.get $type) (global.get $TYPE_OBJECT)))
          (i32.or
            (i32.eq (local.get $type) (global.get $TYPE_FUNCTION))
            (i32.eq (local.get $type) (global.get $TYPE_CONSTRUCTOR))))
          (i32.or
            (i32.eq (local.get $type) (global.get $TYPE_PROMISE))
            (i32.eq (local.get $type) (global.get $TYPE_EXPRESSION))))
          (i32.or
            (i32.eq (local.get $type) (global.get $TYPE_BIGINT))
            (i32.eq (local.get $type) (global.get $TYPE_COMPLEX))))
          (i32.or (i32.or
            (i32.eq (local.get $type) (global.get $TYPE_SYMBOL))
            (i32.eq (local.get $type) (global.get $TYPE_MAP)))
            (i32.or
              (i32.eq (local.get $type) (global.get $TYPE_SET))
              (i32.or
                (i32.eq (local.get $type) (global.get $TYPE_MATRIX))
                (i32.or
                  (i32.eq (local.get $type) (global.get $TYPE_THEOREM))
                  (i32.or
                    (i32.eq (local.get $type) (global.get $TYPE_ALGEBRAIC))
                    (i32.or
                      (i32.eq (local.get $type) (global.get $TYPE_COMPLEX_ALGEBRAIC))
                      (i32.or
                        (i32.eq (local.get $type) (global.get $TYPE_REGEXP))
                        (i32.eq (local.get $type) (global.get $TYPE_SCHEMA))))))))))
      (then
        (if (i32.ne (local.get $data_lo) (i32.const 0))
          (then (call $gc_mark_object_by_header (local.get $data_lo))))
        (return)))

    ;; ACCESSOR: two closure header pointers — getter in data_lo, setter
    ;; in data_hi, either may be 0.
    (if (i32.eq (local.get $type) (global.get $TYPE_ACCESSOR))
      (then
        (if (i32.ne (local.get $data_lo) (i32.const 0))
          (then (call $gc_mark_object_by_header (local.get $data_lo))))
        (local.set $flags (i32.load (i32.add (local.get $abs) (i32.const 12))))
        (if (i32.ne (local.get $flags) (i32.const 0))
          (then (call $gc_mark_object_by_header (local.get $flags))))
        (return)))

    ;; RATIONAL: header pointer unless inline (i64 payload).
    (if (i32.eq (local.get $type) (global.get $TYPE_RATIONAL))
      (then
        (local.set $flags (i32.load (i32.add (local.get $abs) (i32.const 4))))
        (if (i32.and (local.get $flags) (global.get $FLAG_RATIONAL_INLINE))
          (then (return)))
        (if (i32.ne (local.get $data_lo) (i32.const 0))
          (then (call $gc_mark_object_by_header (local.get $data_lo))))
        (return)))

    ;; DATA-pointer class: SCOPE, ARRAYBUFFER, MSGPACK_REF, typed arrays.
    (if (i32.or (i32.or (i32.or
          (i32.eq (local.get $type) (global.get $TYPE_SCOPE))
          (i32.eq (local.get $type) (global.get $TYPE_ARRAYBUFFER)))
          (i32.eq (local.get $type) (global.get $TYPE_MSGPACK_REF)))
          (call $gc_is_typed_array_type (local.get $type)))
      (then
        (if (i32.ne (local.get $data_lo) (i32.const 0))
          (then (call $gc_mark_object_by_header
            (i32.sub (local.get $data_lo) (global.get $GC_HEADER_SIZE)))))
        (return)))

    (if (i32.eq (local.get $type) (global.get $TYPE_STRING))
      (then
        (call $gc_mark_string (local.get $data_lo))
        (return)))

    (if (i32.eq (local.get $type) (global.get $TYPE_EXTERNAL_METHOD))
      (then
        ;; data_hi is the method name's interned-string id.
        (call $gc_mark_string (i32.load (i32.add (local.get $abs) (i32.const 12))))
        (return)))

    (if (i32.eq (local.get $type) (global.get $TYPE_BOUND_METHOD))
      (then
        (local.set $flags (i32.load (i32.add (local.get $abs) (i32.const 4))))
        (local.set $recv_type (i32.and (local.get $flags) (i32.const 0xff)))
        (if (i32.eqz (local.get $data_lo)) (then (return)))
        (if (i32.eq (local.get $recv_type) (global.get $TYPE_STRING))
          (then
            (call $gc_mark_string (local.get $data_lo))
            (return)))
        (if (i32.or (i32.or
              (i32.eq (local.get $recv_type) (global.get $TYPE_MSGPACK_REF))
              (call $gc_is_typed_array_type (local.get $recv_type)))
              (i32.eq (local.get $recv_type) (global.get $TYPE_SCOPE)))
          (then
            (call $gc_mark_object_by_header
              (i32.sub (local.get $data_lo) (global.get $GC_HEADER_SIZE)))
            (return)))
        (call $gc_mark_object_by_header (local.get $data_lo))
        (return)))
    ;; Other types carry no heap edge.
  )

  ;; Mirror of markObjectByHeaderPointer: bounds-skip, cycle check via
  ;; the mark bit, set mark, dispatch traversal by OBJ type. Unknown
  ;; types are silent leaves (no default case in the JS switch).
  (func $gc_mark_object_by_header (param $header i32)
    (local $abs i32)
    (local $word i32)
    (local $obj_type i32)
    (local $data i32)
    (local $val i32)
    (if (i32.lt_u (local.get $header) (global.get $gc_heap_start)) (then (return)))
    (if (i32.ge_u (local.get $header) (global.get $gc_heap_end)) (then (return)))
    (local.set $abs (call $abs (local.get $header)))
    (local.set $word (i32.load (local.get $abs)))
    (if (i32.and (local.get $word) (i32.const 0x80000000)) (then (return)))
    (i32.store (local.get $abs) (i32.or (local.get $word) (i32.const 0x80000000)))

    (local.set $data (i32.add (local.get $header) (global.get $GC_HEADER_SIZE)))
    (local.set $obj_type (i32.and (i32.shr_u (local.get $word) (i32.const 24)) (i32.const 0x7f)))

    (if (i32.eq (local.get $obj_type) (global.get $OBJ_ARRAY))
      (then (call $gc_mark_array (local.get $data)) (return)))
    (if (i32.eq (local.get $obj_type) (global.get $OBJ_OBJECT))
      (then (call $gc_mark_object_entries (local.get $data)) (return)))
    (if (i32.eq (local.get $obj_type) (global.get $OBJ_SCOPE))
      (then (call $gc_mark_scope (local.get $data)) (return)))
    (if (i32.eq (local.get $obj_type) (global.get $OBJ_FUNCTION))
      (then (call $gc_mark_closure (local.get $data)) (return)))
    (if (i32.eq (local.get $obj_type) (global.get $OBJ_PARAM_LIST))
      (then (call $gc_mark_param_list (local.get $data)) (return)))
    (if (i32.eq (local.get $obj_type) (global.get $OBJ_TYPED_ARRAY_DESCRIPTOR))
      (then
        ;; [bufferPtr:4][byteOffset:4][length:4][sym_entries:4]
        (if (i32.ne (i32.load (call $abs (local.get $data))) (i32.const 0))
          (then (call $gc_mark_object_by_header
            (i32.sub (i32.load (call $abs (local.get $data))) (global.get $GC_HEADER_SIZE)))))
        (call $gc_mark_sym_entries
          (i32.load (call $abs (i32.add (local.get $data) (i32.const 12)))))
        (return)))
    (if (i32.eq (local.get $obj_type) (global.get $OBJ_PROMISE))
      (then (call $gc_mark_promise (local.get $data)) (return)))
    (if (i32.eq (local.get $obj_type) (global.get $OBJ_PROMISE_WAITER))
      (then (call $gc_mark_promise_waiter (local.get $data)) (return)))
    (if (i32.eq (local.get $obj_type) (global.get $OBJ_THEN_HANDLER))
      (then (call $gc_mark_then_handler (local.get $data)) (return)))
    (if (i32.eq (local.get $obj_type) (global.get $OBJ_RATIONAL))
      (then
        ;; [numeratorPointer:4][denominatorPointer:4] — header pointers.
        (if (i32.ne (i32.load (call $abs (local.get $data))) (i32.const 0))
          (then (call $gc_mark_object_by_header (i32.load (call $abs (local.get $data))))))
        (if (i32.ne (i32.load (call $abs (i32.add (local.get $data) (i32.const 4)))) (i32.const 0))
          (then (call $gc_mark_object_by_header
            (i32.load (call $abs (i32.add (local.get $data) (i32.const 4)))))))
        (return)))
    (if (i32.eq (local.get $obj_type) (global.get $OBJ_COMPLEX))
      (then
        ;; [realPointer:4][imaginaryPointer:4] — header pointers.
        (if (i32.ne (i32.load (call $abs (local.get $data))) (i32.const 0))
          (then (call $gc_mark_object_by_header (i32.load (call $abs (local.get $data))))))
        (if (i32.ne (i32.load (call $abs (i32.add (local.get $data) (i32.const 4)))) (i32.const 0))
          (then (call $gc_mark_object_by_header
            (i32.load (call $abs (i32.add (local.get $data) (i32.const 4)))))))
        (return)))
    (if (i32.eq (local.get $obj_type) (global.get $OBJ_SYMBOL))
      (then
        ;; [descriptionStringOffset:4][reserved:4]
        (call $gc_mark_string (i32.load (call $abs (local.get $data))))
        (return)))
    (if (i32.eq (local.get $obj_type) (global.get $OBJ_EXPRESSION))
      (then
        ;; [headPointer:4][argumentArrayPointer:4] — header pointers.
        (if (i32.ne (i32.load (call $abs (local.get $data))) (i32.const 0))
          (then (call $gc_mark_object_by_header (i32.load (call $abs (local.get $data))))))
        (if (i32.ne (i32.load (call $abs (i32.add (local.get $data) (i32.const 4)))) (i32.const 0))
          (then (call $gc_mark_object_by_header
            (i32.load (call $abs (i32.add (local.get $data) (i32.const 4)))))))
        (return)))
    (if (i32.eq (local.get $obj_type) (global.get $OBJ_MATRIX))
      (then
        ;; [rowCount:4][columnCount:4][entriesArrayPointer:4][reserved:4]
        ;; — only the entries Array (HEADER pointer at data+8) is an edge;
        ;; its elements are marked transitively via the OBJ_ARRAY case.
        (if (i32.ne (i32.load (call $abs (i32.add (local.get $data) (i32.const 8)))) (i32.const 0))
          (then (call $gc_mark_object_by_header
            (i32.load (call $abs (i32.add (local.get $data) (i32.const 8)))))))
        (return)))
    (if (i32.eq (local.get $obj_type) (global.get $OBJ_THEOREM))
      (then
        ;; [artifactOrUniverseOwnerDataPointer:4][index:4][kind:4]
        ;; [universeOwnerDataPointer:4]. Both pointers are DATA edges;
        ;; composed levels and terms retain their callback's owner state.
        (if (i32.ne (i32.load (call $abs (local.get $data))) (i32.const 0))
          (then (call $gc_mark_object_by_header
            (i32.sub
              (i32.load (call $abs (local.get $data)))
              (global.get $GC_HEADER_SIZE)))))
        (if (i32.ne (i32.load (call $abs (i32.add (local.get $data) (i32.const 12)))) (i32.const 0))
          (then (call $gc_mark_object_by_header
            (i32.sub
              (i32.load (call $abs (i32.add (local.get $data) (i32.const 12))))
              (global.get $GC_HEADER_SIZE)))))
        (return)))
    (if (i32.eq (local.get $obj_type) (global.get $OBJ_REGEXP))
      (then
        ;; [patternStringOffset:4][flagsBitfield:4][lastIndex:4]
        ;; [programBufferDataPointer:4] — RegExp descriptor. The pattern
        ;; is an interned-string id; the program buffer uses the
        ;; ArrayBuffer DATA-pointer convention and is zero until
        ;; compilation commits. Flags and lastIndex are scalars.
        (call $gc_mark_string
          (i32.load (call $abs
            (i32.add (local.get $data) (global.get $REGEXP_PATTERN_STRING)))))
        (if (i32.ne
              (i32.load (call $abs
                (i32.add (local.get $data) (global.get $REGEXP_PROGRAM_BUFFER))))
              (i32.const 0))
          (then (call $gc_mark_object_by_header
            (i32.sub
              (i32.load (call $abs
                (i32.add (local.get $data) (global.get $REGEXP_PROGRAM_BUFFER))))
              (global.get $GC_HEADER_SIZE)))))
        (return)))
    (if (i32.eq (local.get $obj_type) (global.get $OBJ_SCHEMA))
      (then
        ;; Schema descriptor: a 16-byte source value slot at data+0
        ;; (traced like an array element) and the program ArrayBuffer
        ;; DATA pointer at data+16; the rest is scalar.
        (call $gc_mark_value (i32.add (local.get $data) (global.get $SCHEMA_SOURCE)))
        (if (i32.ne
              (i32.load (call $abs
                (i32.add (local.get $data) (global.get $SCHEMA_PROGRAM_BUFFER))))
              (i32.const 0))
          (then (call $gc_mark_object_by_header
            (i32.sub
              (i32.load (call $abs
                (i32.add (local.get $data) (global.get $SCHEMA_PROGRAM_BUFFER))))
              (global.get $GC_HEADER_SIZE)))))
        (return)))
    (if (i32.eq (local.get $obj_type) (global.get $OBJ_ALGEBRAIC))
      (then
        ;; [coefficientsArrayPointer:4][intervalArrayPointer:4]
        ;; [fieldGeneratorPointer:4][coordinatesArrayPointer:4]. The field
        ;; pair is optional. Every nonzero field is a header pointer.
        (if (i32.ne (i32.load (call $abs (local.get $data))) (i32.const 0))
          (then (call $gc_mark_object_by_header
            (i32.load (call $abs (local.get $data))))))
        (if (i32.ne (i32.load (call $abs (i32.add (local.get $data) (i32.const 4)))) (i32.const 0))
          (then (call $gc_mark_object_by_header
            (i32.load (call $abs (i32.add (local.get $data) (i32.const 4)))))))
        (if (i32.ne (i32.load (call $abs (i32.add (local.get $data) (i32.const 8)))) (i32.const 0))
          (then (call $gc_mark_object_by_header
            (i32.load (call $abs (i32.add (local.get $data) (i32.const 8)))))))
        (if (i32.ne (i32.load (call $abs (i32.add (local.get $data) (i32.const 12)))) (i32.const 0))
          (then (call $gc_mark_object_by_header
            (i32.load (call $abs (i32.add (local.get $data) (i32.const 12)))))))
        (return)))
    (if (i32.eq (local.get $obj_type) (global.get $OBJ_COMPLEX_ALGEBRAIC))
      (then
        ;; [realPointer:4][imaginaryPointer:4] — HEADER pointers naming
        ;; canonical BigInt, Rational, or AlgebraicNumber component values.
        (if (i32.ne (i32.load (call $abs (local.get $data))) (i32.const 0))
          (then (call $gc_mark_object_by_header
            (i32.load (call $abs (local.get $data))))))
        (if (i32.ne (i32.load (call $abs (i32.add (local.get $data) (i32.const 4)))) (i32.const 0))
          (then (call $gc_mark_object_by_header
            (i32.load (call $abs (i32.add (local.get $data) (i32.const 4)))))))
        (return)))
    (if (i32.eq
          (local.get $obj_type)
          (global.get $OBJ_NATIVE_CONTINUATION_STATE))
      (then
        (local.set $word (i32.load (call $abs (local.get $data))))
        (local.set $abs
          (i32.load (call $abs (i32.add (local.get $data) (i32.const 4)))))
        (if (i32.ne (i32.and (local.get $word) (local.get $abs)) (i32.const 0))
          (then (unreachable)))
        (local.set $obj_type (i32.const 0))
        (block $state_done
          (loop $state_loop
            (br_if $state_done (i32.ge_u (local.get $obj_type) (i32.const 5)))
            (local.set $data
              (i32.add
                (i32.add (local.get $header) (global.get $GC_HEADER_SIZE))
                (i32.add
                  (global.get $NATIVE_CONTINUATION_STATE_VALUES)
                  (i32.mul (local.get $obj_type) (i32.const 4)))))
            (local.set $val (i32.load (call $abs (local.get $data))))
            (if (i32.ne (local.get $val) (i32.const 0))
              (then
                (if (i32.and
                      (local.get $word)
                      (i32.shl (i32.const 1) (local.get $obj_type)))
                  (then (call $gc_mark_object_by_header (local.get $val)))
                  (else
                    (if (i32.and
                          (local.get $abs)
                          (i32.shl (i32.const 1) (local.get $obj_type)))
                      (then
                        (call $gc_mark_object_by_header
                          (i32.sub (local.get $val) (global.get $GC_HEADER_SIZE)))))))))
            (local.set $obj_type (i32.add (local.get $obj_type) (i32.const 1)))
            (br $state_loop)))
        (return)))
    (if (i32.or
          (i32.eq (local.get $obj_type) (global.get $OBJ_MAP))
          (i32.eq (local.get $obj_type) (global.get $OBJ_SET)))
      (then (call $gc_mark_map_set (local.get $obj_type) (local.get $data)) (return)))
    ;; OBJ_ARRAY_DATA / OBJ_OBJECT_DATA / OBJ_SCOPE_ENTRIES /
    ;; OBJ_MAP_ENTRIES / OBJ_SET_ENTRIES: contents walked by the parent
    ;; (live-count-bounded — the tail-slot invariant). OBJ_ARRAYBUFFER /
    ;; OBJ_BIGINT: leaves. OBJ_CONTEXT / OBJ_STACK_BLOCK: contents
    ;; walked as context roots. Unknown types: silent leaves.
  )

  ;; Mirror of markArray. $data is the array header's DATA pointer.
  (func $gc_mark_array (param $data i32)
    (local $abs i32)
    (local $length i32)
    (local $block i32)
    (local $elems i32)
    (local $i i32)
    (local.set $abs (call $abs (local.get $data)))
    ;; (data-relative) [length:4][capacity:4][data_ptr:4][flags:4][sym_entries:4]
    (local.set $length (i32.load (local.get $abs)))
    (local.set $block (i32.load (i32.add (local.get $abs) (i32.const 8))))
    (call $gc_mark_sym_entries (i32.load (i32.add (local.get $abs) (i32.const 16))))
    (if (i32.eqz (local.get $block)) (then (return)))
    ;; data_ptr is a HEADER pointer; bounds-skip mirrors the JS guard.
    (if (i32.lt_u (local.get $block) (global.get $gc_heap_start)) (then (return)))
    (if (i32.ge_u (local.get $block) (global.get $gc_heap_end)) (then (return)))
    (i32.store (call $abs (local.get $block))
      (i32.or (i32.load (call $abs (local.get $block))) (i32.const 0x80000000)))
    (local.set $elems (i32.add (local.get $block) (global.get $GC_HEADER_SIZE)))
    (local.set $i (i32.const 0))
    (block $done
      (loop $loop
        (br_if $done (i32.ge_u (local.get $i) (local.get $length)))
        (call $gc_mark_value
          (i32.add (local.get $elems) (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $loop)))
  )

  ;; Mirror of markObjectEntries. $data is the object's DATA pointer.
  ;; (data-relative) [prototype:4][count:4][capacity:4][flags:4][entries:4][sym_entries:4]
  (func $gc_mark_object_entries (param $data i32)
    (local $abs i32)
    (local $count i32)
    (local $entries i32)
    (local $entry i32)
    (local $i i32)
    (local.set $abs (call $abs (local.get $data)))
    (if (i32.ne (i32.load (local.get $abs)) (i32.const 0))
      (then (call $gc_mark_object_by_header (i32.load (local.get $abs)))))
    ;; BigInt wrappers have a 48-byte OBJ_OBJECT header and carry their
    ;; [[BigIntData]] HEADER pointer at data-relative +24.
    (if (i32.gt_u
          (i32.and
            (i32.load (call $abs
              (i32.sub (local.get $data) (global.get $GC_HEADER_SIZE))))
            (i32.const 0x00ffffff))
          (global.get $OBJECT_HEADER_SIZE))
      (then
        (if (i32.ne
              (i32.load (i32.add (local.get $abs) (i32.const 24)))
              (i32.const 0))
          (then
            (call $gc_mark_object_by_header
              (i32.load (i32.add (local.get $abs) (i32.const 24))))))))
    (local.set $count (i32.load (i32.add (local.get $abs) (i32.const 4))))
    (local.set $entries (i32.load (i32.add (local.get $abs) (i32.const 16))))
    (if (i32.ne (local.get $entries) (i32.const 0))
      (then
        (i32.store (call $abs (local.get $entries))
          (i32.or (i32.load (call $abs (local.get $entries))) (i32.const 0x80000000)))
        (local.set $entry (i32.add (local.get $entries) (global.get $GC_HEADER_SIZE)))
        (local.set $i (i32.const 0))
        (block $done
          (loop $loop
            (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
            ;; Entry: [key_offset:4][type:4][flags:4][data_lo:4][data_hi:4]
            (call $gc_mark_string (i32.load (call $abs (local.get $entry))))
            (call $gc_mark_value (i32.add (local.get $entry) (i32.const 4)))
            (local.set $entry (i32.add (local.get $entry) (i32.const 20)))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $loop)))))
    (call $gc_mark_sym_entries (i32.load (i32.add (local.get $abs) (i32.const 20))))
  )

  ;; Mirror of markSymEntriesBlock: bounds-SKIP on a clobbered pointer
  ;; (defense in depth, same as JS), then walk sym_count entries.
  ;; Block: [GC:8][sym_count:4][sym_capacity:4][entries...] — 20 B each.
  (func $gc_mark_sym_entries (param $header i32)
    (local $data i32)
    (local $count i32)
    (local $entry i32)
    (local $i i32)
    (if (i32.eqz (local.get $header)) (then (return)))
    (if (i32.lt_u (local.get $header) (global.get $gc_heap_start)) (then (return)))
    (if (i32.ge_u (local.get $header) (global.get $gc_heap_end)) (then (return)))
    (i32.store (call $abs (local.get $header))
      (i32.or (i32.load (call $abs (local.get $header))) (i32.const 0x80000000)))
    (local.set $data (i32.add (local.get $header) (global.get $GC_HEADER_SIZE)))
    (local.set $count (i32.load (call $abs (local.get $data))))
    (local.set $entry (i32.add (local.get $data) (i32.const 8)))
    (local.set $i (i32.const 0))
    (block $done
      (loop $loop
        (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
        ;; Key is a HEADER pointer to a symbol heap object.
        (if (i32.ne (i32.load (call $abs (local.get $entry))) (i32.const 0))
          (then (call $gc_mark_object_by_header (i32.load (call $abs (local.get $entry))))))
        (call $gc_mark_value (i32.add (local.get $entry) (i32.const 4)))
        (local.set $entry (i32.add (local.get $entry) (i32.const 20)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $loop)))
  )

  ;; Mirror of markScope. Scope: [parent:4][count:4][capacity:4][entries:4]
  (func $gc_mark_scope (param $data i32)
    (local $abs i32)
    (local $count i32)
    (local $entries i32)
    (local $entry i32)
    (local $i i32)
    (local.set $abs (call $abs (local.get $data)))
    (if (i32.ne (i32.load (local.get $abs)) (i32.const 0))
      (then (call $gc_mark_object_by_header
        (i32.sub (i32.load (local.get $abs)) (global.get $GC_HEADER_SIZE)))))
    (local.set $count (i32.load (i32.add (local.get $abs) (i32.const 4))))
    (local.set $entries (i32.load (i32.add (local.get $abs) (i32.const 12))))
    (if (i32.eqz (local.get $entries)) (then (return)))
    (i32.store (call $abs (local.get $entries))
      (i32.or (i32.load (call $abs (local.get $entries))) (i32.const 0x80000000)))
    (local.set $entry (i32.add (local.get $entries) (global.get $GC_HEADER_SIZE)))
    (local.set $i (i32.const 0))
    (block $done
      (loop $loop
        (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
        ;; Entry: [key:4][type:4][flags:4][data_lo:4][data_hi:4]
        (call $gc_mark_string (i32.load (call $abs (local.get $entry))))
        (call $gc_mark_value (i32.add (local.get $entry) (i32.const 4)))
        (local.set $entry (i32.add (local.get $entry) (i32.const 20)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $loop)))
  )

  ;; Mirror of markClosure: object header walk + captured scope at
  ;; data-relative offset 32 (FUNCTION_CLOSURE_OFFSET - GC header).
  (func $gc_mark_closure (param $data i32)
    (local $scope i32)
    (call $gc_mark_object_entries (local.get $data))
    (local.set $scope (i32.load (call $abs (i32.add (local.get $data) (i32.const 32)))))
    (if (i32.ne (local.get $scope) (i32.const 0))
      (then (call $gc_mark_object_by_header
        (i32.sub (local.get $scope) (global.get $GC_HEADER_SIZE)))))
  )

  ;; Mirror of markPromise: value slot through the canonical walker,
  ;; handler list via the -1 sentinel.
  (func $gc_mark_promise (param $data i32)
    (local $head i32)
    (call $gc_mark_value (i32.add (local.get $data) (global.get $PROMISE_VALUE)))
    (local.set $head (i32.load (call $abs (i32.add (local.get $data) (global.get $PROMISE_WAITERS)))))
    (if (i32.ne (local.get $head) (i32.const 0))
      (then (call $gc_mark_object_by_header
        (i32.sub (local.get $head) (global.get $GC_HEADER_SIZE)))))
    (local.set $head (i32.load (call $abs (i32.add (local.get $data) (global.get $PROMISE_HANDLERS)))))
    (if (i32.ne (local.get $head) (i32.const -1))
      (then (call $gc_mark_object_by_header
        (i32.sub (local.get $head) (global.get $GC_HEADER_SIZE)))))
  )

  (func $gc_mark_promise_waiter (param $data i32)
    (local $next i32)
    (local.set $next
      (i32.load
        (call $abs
          (i32.add (local.get $data) (global.get $PROMISE_WAITER_NEXT)))))
    (if (i32.ne (local.get $next) (i32.const 0))
      (then
        (call $gc_mark_object_by_header
          (i32.sub (local.get $next) (global.get $GC_HEADER_SIZE)))))
  )

  ;; Mirror of markThenHandler.
  (func $gc_mark_then_handler (param $data i32)
    (local $ptr i32)
    (local.set $ptr (i32.load (call $abs (i32.add (local.get $data) (global.get $THEN_HANDLER_ON_RESOLVED)))))
    (if (i32.ne (local.get $ptr) (i32.const 0))
      (then (call $gc_mark_object_by_header (local.get $ptr))))
    (local.set $ptr (i32.load (call $abs (i32.add (local.get $data) (global.get $THEN_HANDLER_ON_REJECTED)))))
    (if (i32.ne (local.get $ptr) (i32.const 0))
      (then (call $gc_mark_object_by_header (local.get $ptr))))
    (local.set $ptr (i32.load (call $abs (i32.add (local.get $data) (global.get $THEN_HANDLER_CHILD_PROMISE)))))
    (if (i32.ne (local.get $ptr) (i32.const 0))
      (then (call $gc_mark_object_by_header
        (i32.sub (local.get $ptr) (global.get $GC_HEADER_SIZE)))))
    (local.set $ptr (i32.load (call $abs (i32.add (local.get $data) (global.get $THEN_HANDLER_NEXT)))))
    (if (i32.ne (local.get $ptr) (i32.const -1))
      (then (call $gc_mark_object_by_header
        (i32.sub (local.get $ptr) (global.get $GC_HEADER_SIZE)))))
  )

  ;; Mirror of markParamList: [count:4][string offset:4]...
  (func $gc_mark_param_list (param $data i32)
    (local $abs i32)
    (local $count i32)
    (local $i i32)
    (local.set $abs (call $abs (local.get $data)))
    (local.set $count (i32.load (local.get $abs)))
    (local.set $i (i32.const 0))
    (block $done
      (loop $loop
        (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
        (call $gc_mark_string (i32.load (i32.add
          (i32.add (local.get $abs) (i32.const 4))
          (i32.mul (local.get $i) (i32.const 4)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $loop)))
  )

  ;; Mirror of the OBJ.MAP/OBJ.SET case: mark the entries block live,
  ;; walk slots bounded by slotCount (tombstones included), sym entries.
  ;; Header (data-relative): [size:4][slotCount:4][capacity:4][entriesHeader:4][sym_entries:4]
  (func $gc_mark_map_set (param $obj_type i32) (param $data i32)
    (local $abs i32)
    (local $slot_count i32)
    (local $entries i32)
    (local $slot i32)
    (local $i i32)
    (local.set $abs (call $abs (local.get $data)))
    (local.set $slot_count (i32.load (i32.add (local.get $abs) (i32.const 4))))
    (local.set $entries (i32.load (i32.add (local.get $abs) (i32.const 12))))
    (if (i32.ne (local.get $entries) (i32.const 0))
      (then
        (call $gc_mark_object_by_header (local.get $entries))
        (local.set $slot (i32.add (local.get $entries) (global.get $GC_HEADER_SIZE)))
        (local.set $i (i32.const 0))
        (if (i32.eq (local.get $obj_type) (global.get $OBJ_MAP))
          (then
            ;; Map slot: [tombstone:4][key:16][value:16] = 36 bytes.
            (block $done_map
              (loop $loop_map
                (br_if $done_map (i32.ge_u (local.get $i) (local.get $slot_count)))
                (call $gc_mark_value (i32.add (local.get $slot) (i32.const 4)))
                (call $gc_mark_value (i32.add (local.get $slot) (i32.const 20)))
                (local.set $slot (i32.add (local.get $slot) (i32.const 36)))
                (local.set $i (i32.add (local.get $i) (i32.const 1)))
                (br $loop_map))))
          (else
            ;; Set slot: [tombstone:4][value:16] = 20 bytes.
            (block $done_set
              (loop $loop_set
                (br_if $done_set (i32.ge_u (local.get $i) (local.get $slot_count)))
                (call $gc_mark_value (i32.add (local.get $slot) (i32.const 4)))
                (local.set $slot (i32.add (local.get $slot) (i32.const 20)))
                (local.set $i (i32.add (local.get $i) (i32.const 1)))
                (br $loop_set)))))))
    (call $gc_mark_sym_entries (i32.load (i32.add (local.get $abs) (i32.const 16))))
  )

  ;; Mirror of _isLivePromise.
  (func $gc_is_live_promise (param $data i32) (result i32)
    (local $header i32)
    (local.set $header (i32.sub (local.get $data) (global.get $GC_HEADER_SIZE)))
    (if (i32.lt_u (local.get $header) (global.get $gc_heap_start))
      (then (return (i32.const 0))))
    (if (i32.ge_u (local.get $header) (global.get $gc_heap_end))
      (then (return (i32.const 0))))
    (i32.eq
      (i32.and (i32.shr_u (i32.load (call $abs (local.get $header))) (i32.const 24)) (i32.const 0x7f))
      (global.get $OBJ_PROMISE))
  )

  ;; Mirror of markRequestBaseForContext: per-EXIT request payloads.
  (func $gc_mark_request_base (param $ctx_base i32)
    (local $exit i32)
    (local $req i32)
    (local $req_abs i32)
    (local $ptr i32)
    (local $args i32)
    (local $argc i32)
    (local $i i32)
    (local.set $exit (i32.load (call $abs (i32.add (local.get $ctx_base) (global.get $CTX_EXIT_CONDITION)))))
    (local.set $req (i32.add (local.get $ctx_base) (global.get $CTX_REQUEST_BLOCK)))
    (local.set $req_abs (call $abs (local.get $req)))

    (if (i32.eq (local.get $exit) (global.get $EXIT_AWAIT))
      (then
        ;; Settled path (isPending = 0): +8 = promise_data + PROMISE.VALUE.
        (if (i32.eqz (i32.load (local.get $req_abs)))
          (then
            (local.set $ptr (i32.load (i32.add (local.get $req_abs) (i32.const 8))))
            (if (i32.ne (local.get $ptr) (i32.const 0))
              (then
                (local.set $ptr (i32.sub (local.get $ptr) (global.get $PROMISE_VALUE)))
                (if (call $gc_is_live_promise (local.get $ptr))
                  (then (call $gc_mark_object_by_header
                    (i32.sub (local.get $ptr) (global.get $GC_HEADER_SIZE)))))))))
        (return)))

    (if (i32.eq (local.get $exit) (global.get $EXIT_PROMISE_SETTLE))
      (then
        (local.set $ptr (i32.load (local.get $req_abs)))
        (if (i32.ne (local.get $ptr) (i32.const 0))
          (then (call $gc_mark_object_by_header
            (i32.sub (local.get $ptr) (global.get $GC_HEADER_SIZE)))))
        (return)))

    (if (i32.eq (local.get $exit) (global.get $EXIT_PROMISE_METHOD))
      (then
        ;; [promiseHeaderPointer:4][methodId:4][argsPointer:4][argCount:4]
        (local.set $ptr (i32.load (local.get $req_abs)))
        (if (i32.ne (local.get $ptr) (i32.const 0))
          (then (call $gc_mark_object_by_header (local.get $ptr))))
        (local.set $args (i32.load (i32.add (local.get $req_abs) (i32.const 8))))
        (local.set $argc (i32.load (i32.add (local.get $req_abs) (i32.const 12))))
        (local.set $i (i32.const 0))
        (block $done_pm
          (loop $loop_pm
            (br_if $done_pm (i32.ge_u (local.get $i) (local.get $argc)))
            (call $gc_mark_value (i32.add (local.get $args)
              (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $loop_pm)))
        (return)))

    (if (i32.eq (local.get $exit) (global.get $EXIT_ASYNC_CALL))
      (then
        ;; [closureHeaderPointer:4][argsPointer:4][argCount:4][receiver VALUE at +12]
        (local.set $ptr (i32.load (local.get $req_abs)))
        (if (i32.ne (local.get $ptr) (i32.const 0))
          (then (call $gc_mark_object_by_header (local.get $ptr))))
        (call $gc_mark_value (i32.add (local.get $req) (i32.const 12)))
        (return)))

    (if (i32.or (i32.or
          (i32.eq (local.get $exit) (global.get $EXIT_EXTERNAL_CALL))
          (i32.eq (local.get $exit) (global.get $EXIT_EXTERNAL_PROPERTY)))
          (i32.eq (local.get $exit) (global.get $EXIT_EXTERNAL_PROPERTY_SET)))
      (then
        ;; [handleId:4][methodOffset:4][argsPointer:4][argCount:4]
        (call $gc_mark_string (i32.load (i32.add (local.get $req_abs) (i32.const 4))))
        (local.set $args (i32.load (i32.add (local.get $req_abs) (i32.const 8))))
        (local.set $argc (i32.load (i32.add (local.get $req_abs) (i32.const 12))))
        (local.set $i (i32.const 0))
        (block $done_ex
          (loop $loop_ex
            (br_if $done_ex (i32.ge_u (local.get $i) (local.get $argc)))
            (call $gc_mark_value (i32.add (local.get $args)
              (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $loop_ex)))
        ;; extends-externals D3: a parked construction request carries a
        ;; heap HEADER pointer at +20 (receiver for complete/abort,
        ;; new.target closure for begin). Gate on the interned
        ;; construction method names.
        (if (i32.and
              (i32.eq (local.get $exit) (global.get $EXIT_EXTERNAL_CALL))
              (i32.or (i32.or
                (i32.eq (i32.load (i32.add (local.get $req_abs) (i32.const 4)))
                  (call $read_builtin (global.get $BUILTIN_CONSTRUCT_BEGIN)))
                (i32.eq (i32.load (i32.add (local.get $req_abs) (i32.const 4)))
                  (call $read_builtin (global.get $BUILTIN_CONSTRUCT_COMPLETE))))
                (i32.eq (i32.load (i32.add (local.get $req_abs) (i32.const 4)))
                  (call $read_builtin (global.get $BUILTIN_CONSTRUCT_ABORT)))))
          (then
            (local.set $ptr (i32.load (i32.add (local.get $req_abs) (i32.const 20))))
            (if (i32.ne (local.get $ptr) (i32.const 0))
              (then (call $gc_mark_object_by_header (local.get $ptr))))))
        (return)))
  )

  ;; Mirror of markContextRoots — same walk order. The 512-byte window
  ;; covers every CTX field read/written below; a context object can
  ;; never legitimately sit that close to the segment end (the string
  ;; table's hash region alone is 16 KB above the heap).
  (func $gc_mark_context_roots (param $ctx_base i32)
    (local $ctx_abs i32)
    (local $pending_base i32)
    (local $pending_ptr i32)
    (local $call_base i32)
    (local $call_ptr i32)
    (local $grant_base i32)
    (local $grant_ptr i32)
    (local $try_base i32)
    (local $try_ptr i32)
    (local $scope i32)
    (local $addr i32)
    (local $frame_abs i32)
    (local $val i32)
    (local.set $ctx_abs (call $abs (local.get $ctx_base)))
    (call $gc_check_abs (local.get $ctx_abs) (i32.const 512))
    (local.set $pending_base (i32.load (i32.add (local.get $ctx_abs) (global.get $CTX_PENDING_BASE))))
    (local.set $pending_ptr (i32.load (i32.add (local.get $ctx_abs) (global.get $CTX_PENDING_POINTER))))
    (local.set $call_base (i32.load (i32.add (local.get $ctx_abs) (global.get $CTX_CALL_STACK_BASE))))
    (local.set $call_ptr (i32.load (i32.add (local.get $ctx_abs) (global.get $CTX_CALL_STACK_POINTER))))
    (local.set $grant_base (i32.load (i32.add (local.get $ctx_abs) (global.get $CTX_GRANT_STACK_BASE))))
    (local.set $grant_ptr (i32.load (i32.add (local.get $ctx_abs) (global.get $CTX_GRANT_STACK_POINTER))))
    (local.set $try_base (i32.load (i32.add (local.get $ctx_abs) (global.get $CTX_TRY_STACK_BASE))))
    (local.set $try_ptr (i32.load (i32.add (local.get $ctx_abs) (global.get $CTX_TRY_STACK_POINTER))))
    (local.set $scope (i32.load (i32.add (local.get $ctx_abs) (global.get $CTX_SCOPE))))

    ;; 0. The context object and its four stack blocks (data pointers).
    (call $gc_mark_object_by_header (i32.sub (local.get $ctx_base) (global.get $GC_HEADER_SIZE)))
    (call $gc_mark_object_by_header (i32.sub (local.get $pending_base) (global.get $GC_HEADER_SIZE)))
    (call $gc_mark_object_by_header (i32.sub (local.get $call_base) (global.get $GC_HEADER_SIZE)))
    (call $gc_mark_object_by_header (i32.sub (local.get $grant_base) (global.get $GC_HEADER_SIZE)))
    (call $gc_mark_object_by_header (i32.sub (local.get $try_base) (global.get $GC_HEADER_SIZE)))

    ;; 1. Scope.
    (if (i32.ne (local.get $scope) (i32.const 0))
      (then (call $gc_mark_object_by_header
        (i32.sub (local.get $scope) (global.get $GC_HEADER_SIZE)))))

    ;; 2. Pending stack values.
    (local.set $addr (local.get $pending_base))
    (block $done_pending
      (loop $loop_pending
        (br_if $done_pending (i32.ge_u (local.get $addr) (local.get $pending_ptr)))
        (call $gc_mark_value (local.get $addr))
        (local.set $addr (i32.add (local.get $addr) (global.get $VALUE_SIZE)))
        (br $loop_pending)))

    ;; 3. Call stack frames: scope, iteration state, ASYNC_PROMISE.
    (local.set $addr (local.get $call_base))
    (block $done_frames
      (loop $loop_frames
        (br_if $done_frames (i32.ge_u (local.get $addr) (local.get $call_ptr)))
        (local.set $frame_abs (call $abs (local.get $addr)))
        (call $gc_check_abs (local.get $frame_abs) (global.get $FRAME_SIZE))
        (local.set $val (i32.load (i32.add (local.get $frame_abs) (global.get $FRAME_SCOPE_POINTER))))
        (if (i32.ne (local.get $val) (i32.const 0))
          (then (call $gc_mark_object_by_header
            (i32.sub (local.get $val) (global.get $GC_HEADER_SIZE)))))
        (if (i32.and
              (i32.load (i32.add (local.get $frame_abs) (global.get $FRAME_FLAGS)))
              (global.get $FRAME_FLAG_NATIVE_CONTINUATION))
          (then
            (local.set $val
              (i32.load (i32.add
                (local.get $frame_abs)
                (global.get $FRAME_CONTINUATION_KIND))))
            (local.set $val
              (i32.load (i32.add
                (local.get $frame_abs)
                (global.get $FRAME_CONTINUATION_STATE_HANDLE))))
            (if (i32.eqz (local.get $val))
              (then (unreachable)))
            (call $gc_mark_object_by_header (local.get $val))
            (local.set $val (i32.load (i32.add (local.get $frame_abs) (global.get $FRAME_CONTINUATION_CALLBACK))))
            (if (i32.ne (local.get $val) (i32.const 0))
              (then (call $gc_mark_object_by_header (local.get $val)))))
          (else
            ;; ASYNC_PROMISE: bits 0-1 are flags; the rest is a data
            ;; pointer, but only on ordinary call frames. Native continuation
            ;; frames own operation state through STATE_HANDLE.
            (local.set $val (i32.and
              (i32.load (i32.add (local.get $frame_abs) (global.get $FRAME_ASYNC_PROMISE)))
              (i32.const -4)))
            (if (i32.ne (local.get $val) (i32.const 0))
              (then (call $gc_mark_object_by_header
                (i32.sub (local.get $val) (global.get $GC_HEADER_SIZE)))))))
        (local.set $addr (i32.add (local.get $addr) (global.get $FRAME_SIZE)))
        (br $loop_frames)))

    ;; 4. Grant stack: identifier value at +0, saved scope pointer.
    (local.set $addr (local.get $grant_base))
    (block $done_grants
      (loop $loop_grants
        (br_if $done_grants (i32.ge_u (local.get $addr) (local.get $grant_ptr)))
        (call $gc_mark_value (local.get $addr))
        (local.set $val (i32.load (call $abs
          (i32.add (local.get $addr) (global.get $GRANT_SCOPE_POINTER)))))
        (if (i32.ne (local.get $val) (i32.const 0))
          (then (call $gc_mark_object_by_header
            (i32.sub (local.get $val) (global.get $GC_HEADER_SIZE)))))
        (local.set $addr (i32.add (local.get $addr) (global.get $GRANT_ENTRY_SIZE)))
        (br $loop_grants)))

    ;; 4b. Try stack: saved scope pointers, plus v11 pending completion
    ;; values (a disarmed holder's THROW exception or RETURN value must
    ;; survive a GC that runs while its finally block executes).
    (local.set $addr (local.get $try_base))
    (block $done_tries
      (loop $loop_tries
        (br_if $done_tries (i32.ge_u (local.get $addr) (local.get $try_ptr)))
        (local.set $val (i32.load (call $abs
          (i32.add (local.get $addr) (global.get $TRY_SCOPE)))))
        (if (i32.ne (local.get $val) (i32.const 0))
          (then (call $gc_mark_object_by_header
            (i32.sub (local.get $val) (global.get $GC_HEADER_SIZE)))))
        (local.set $val (i32.load (call $abs
          (i32.add (local.get $addr) (global.get $TRY_COMPLETION_TYPE)))))
        (if (i32.or
              (i32.eq (local.get $val) (global.get $COMPLETION_THROW))
              (i32.eq (local.get $val) (global.get $COMPLETION_RETURN)))
          (then (call $gc_mark_value
            (i32.add (local.get $addr) (global.get $TRY_COMPLETION_VALUE)))))
        (local.set $addr (i32.add (local.get $addr) (global.get $TRY_ENTRY_SIZE)))
        (br $loop_tries)))

    ;; 5. Completion value (pointer to a 16-byte slot).
    (if (i32.and
          (i32.ne (i32.load (i32.add (local.get $ctx_abs) (global.get $CTX_COMPLETION_TYPE))) (i32.const 0))
          (i32.ne (i32.load (i32.add (local.get $ctx_abs) (global.get $CTX_COMPLETION_VALUE))) (i32.const 0)))
      (then (call $gc_mark_value
        (i32.load (i32.add (local.get $ctx_abs) (global.get $CTX_COMPLETION_VALUE))))))

    ;; 5b. Generator object (header pointer; 0 = not a generator context).
    (local.set $val (i32.load (i32.add (local.get $ctx_abs) (global.get $CTX_GENERATOR_OBJECT))))
    (if (i32.ne (local.get $val) (i32.const 0))
      (then (call $gc_mark_object_by_header (local.get $val))))

    ;; 5c. Paused RegExp operation state (header pointer; 0 = none). The
    ;; NATIVE_CONTINUATION_STATE object's masks trace its buffers.
    (local.set $val (i32.load (i32.add (local.get $ctx_abs) (global.get $CTX_REGEX_STATE))))
    (if (i32.ne (local.get $val) (i32.const 0))
      (then (call $gc_mark_object_by_header (local.get $val))))

    ;; 5d. Construction abort duty (header pointer of the branded
    ;; receiver whose abortConstruction is owed; 0 = none). The chained
    ;; receivers reach each other through their @constructionLink
    ;; entries, which the ordinary object walk traces.
    (local.set $val (i32.load (i32.add (local.get $ctx_abs) (global.get $CTX_CONSTRUCTION_DUTY))))
    (if (i32.ne (local.get $val) (i32.const 0))
      (then (call $gc_mark_object_by_header (local.get $val))))

    ;; 6. Request-base payload for the slot's exit condition.
    (call $gc_mark_request_base (local.get $ctx_base))
  )

  ;; Context discovery + per-slot marking. Mirrors getAllocatedContexts
  ;; including the stale-FREE table-entry zeroing (a discovery WRITE).
  (func $gc_mark_contexts
    (local $count i32)
    (local $table i32)
    (local $generation_table i32)
    (local $slot i32)
    (local $entry_abs i32)
    (local $ctx_base i32)
    (local.set $count (call $read_state (global.get $STATE_CONTEXT_COUNT)))
    (local.set $table (call $read_state (global.get $STATE_CONTEXT_TABLE_POINTER)))
    ;; The table is itself a heap object (layout v10) — mark it so
    ;; compaction retains it. Entries are forwarded per-slot by
    ;; $gc_update_context, not by the generic object walk.
    (call $gc_mark_object_by_header
      (i32.sub (local.get $table) (global.get $GC_HEADER_SIZE)))
    (local.set $generation_table
      (call $read_state
        (global.get $STATE_CONTEXT_GENERATION_TABLE_POINTER)))
    (call $gc_mark_object_by_header
      (i32.sub
        (local.get $generation_table)
        (global.get $GC_HEADER_SIZE)))
    (local.set $slot (i32.const 0))
    (block $done
      (loop $loop
        (br_if $done (i32.ge_u (local.get $slot) (local.get $count)))
        (local.set $entry_abs (call $abs (i32.add (local.get $table)
          (i32.mul (local.get $slot) (i32.const 4)))))
        (local.set $ctx_base (i32.load (local.get $entry_abs)))
        (if (i32.ne (local.get $ctx_base) (i32.const 0))
          (then
            (if (i32.eq
                  (i32.load (call $abs (i32.add (local.get $ctx_base) (global.get $CTX_EXIT_CONDITION))))
                  (global.get $CONTEXT_STATUS_FREE))
              (then
                ;; Stale FREE entry: zero it NOW (phantom-context guard).
                (i32.store (local.get $entry_abs) (i32.const 0)))
              (else
                (call $gc_mark_context_roots (local.get $ctx_base))))))
        (local.set $slot (i32.add (local.get $slot) (i32.const 1)))
        (br $loop)))
  )

  ;; External roots from the scratch block (host-written HEADER ptrs).
  (func $gc_mark_external_roots
    (local $i i32)
    (local $ptr i32)
    (local.set $i (i32.const 0))
    (block $done
      (loop $loop
        (br_if $done (i32.ge_u (local.get $i) (global.get $gc_root_count)))
        (local.set $ptr (i32.load (i32.add
          (i32.add (global.get $gc_root_block) (i32.const 4))
          (i32.mul (local.get $i) (i32.const 4)))))
        (if (i32.ne (local.get $ptr) (i32.const 0))
          (then (call $gc_mark_object_by_header (local.get $ptr))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $loop)))
  )

  ;; Code-block operands: STRING_OFFSET and HEAP_POINTER operand1 kinds,
  ;; classified by the host-written operand-kind table.
  (func $gc_mark_code_block
    (local $code_start i32)
    (local $count i32)
    (local $i i32)
    (local $instr_abs i32)
    (local $kind i32)
    (local $operand i32)
    (local.set $code_start (call $read_state (global.get $STATE_CODE_BLOCK)))
    (local.set $count (i32.load (call $abs (local.get $code_start))))
    (local.set $i (i32.const 0))
    (block $done
      (loop $loop
        (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
        ;; instr_ptr = code_start - (i + 1) * INSTRUCTION_SIZE
        (local.set $instr_abs (call $abs (i32.sub (local.get $code_start)
          (i32.mul (i32.add (local.get $i) (i32.const 1)) (global.get $INSTRUCTION_SIZE)))))
        (local.set $kind (i32.load8_u (i32.add (global.get $gc_operand_kinds)
          (i32.load8_u (local.get $instr_abs)))))
        (local.set $operand (i32.load (i32.add (local.get $instr_abs) (i32.const 8))))
        (if (i32.eq (local.get $kind) (i32.const 3))  ;; OPERAND_KIND.STRING_OFFSET
          (then
            (if (i32.ne (local.get $operand) (i32.const 0))
              (then (call $gc_mark_string (local.get $operand))))))
        (if (i32.eq (local.get $kind) (i32.const 4))  ;; OPERAND_KIND.HEAP_POINTER
          (then
            (if (i32.ne (local.get $operand) (i32.const 0))
              (then (call $gc_mark_object_by_header (local.get $operand))))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $loop)))
  )

  ;; Every non-zero u32 slot in the BUILTINS region is a string id.
  (func $gc_mark_builtin_strings
    (local $offset i32)
    (local $id i32)
    (local.set $offset (i32.const 0))
    (block $done
      (loop $loop
        (br_if $done (i32.ge_u (local.get $offset) (global.get $BUILTINS_SIZE)))
        (local.set $id (call $read_builtin (local.get $offset)))
        (if (i32.ne (local.get $id) (i32.const 0))
          (then (call $gc_mark_string (local.get $id))))
        (local.set $offset (i32.add (local.get $offset) (i32.const 4)))
        (br $loop)))
  )

  ;; AST worklist push (bounds-checked; overflow is provably impossible
  ;; per the astRegionSize/4 capacity bound — a hit means the layout is
  ;; wrong).
  (func $gc_ast_push (param $offset i32)
    (if (i32.ge_u (global.get $gc_ast_worklist_sp) (global.get $gc_ast_worklist_capacity))
      (then (call $gc_fail (global.get $GC_ERR_AST_WORKLIST) (global.get $gc_ast_worklist_sp))))
    (i32.store (i32.add (global.get $gc_ast_worklist)
      (i32.mul (global.get $gc_ast_worklist_sp) (i32.const 4)))
      (local.get $offset))
    (global.set $gc_ast_worklist_sp (i32.add (global.get $gc_ast_worklist_sp) (i32.const 1)))
  )

  ;; Mirror of iterateStringFields (the NODE_LAYOUT graph walk), fed by
  ;; the host-written AST layout records. Visited bitmap + explicit
  ;; worklist live in the scratch block. Unknown tags fail — matching
  ;; the JS walk's throw. $forward = 0: mark string ids (mark phase);
  ;; $forward = 1: rewrite string fields through the string-forwarding
  ;; table (compactStrings' updateAstStrings). The caller zeroes the
  ;; visited bitmap before each walk.
  (func $gc_walk_ast_strings (param $forward i32)
    (local $base i32)
    (local $offset i32)
    (local $node_abs i32)
    (local $tag i32)
    (local $record i32)
    (local $bit i32)
    (local $byte_addr i32)
    (local $mask i32)
    (local $n i32)
    (local $i i32)
    (local $field i32)
    (local $id i32)
    (local $cnt i32)
    (if (i32.eqz (call $read_state (global.get $STATE_AST_REGION_SIZE))) (then (return)))
    (local.set $base (call $read_state (global.get $STATE_AST_REGION_BASE)))
    ;; isAstRegionInitialized: pointer > base.
    (if (i32.le_u (call $read_state (global.get $STATE_AST_REGION_POINTER)) (local.get $base))
      (then (return)))
    (local.set $offset (i32.load (call $abs (i32.add (local.get $base) (global.get $AST_REGION_FIRST_ROOT)))))
    (if (i32.eqz (local.get $offset)) (then (return)))

    (global.set $gc_ast_worklist_sp (i32.const 0))
    (call $gc_ast_push (local.get $offset))

    (block $walk_done
      (loop $walk
        (br_if $walk_done (i32.eqz (global.get $gc_ast_worklist_sp)))
        (global.set $gc_ast_worklist_sp (i32.sub (global.get $gc_ast_worklist_sp) (i32.const 1)))
        (local.set $offset (i32.load (i32.add (global.get $gc_ast_worklist)
          (i32.mul (global.get $gc_ast_worklist_sp) (i32.const 4)))))
        (if (i32.eqz (local.get $offset)) (then (br $walk)))

        ;; Visited check (1 bit per 4 bytes of region).
        (local.set $bit (i32.shr_u (local.get $offset) (i32.const 2)))
        (local.set $byte_addr (i32.add (global.get $gc_ast_visited)
          (i32.shr_u (local.get $bit) (i32.const 3))))
        (local.set $mask (i32.shl (i32.const 1) (i32.and (local.get $bit) (i32.const 7))))
        (if (i32.and (i32.load8_u (local.get $byte_addr)) (local.get $mask))
          (then (br $walk)))
        (i32.store8 (local.get $byte_addr)
          (i32.or (i32.load8_u (local.get $byte_addr)) (local.get $mask)))

        (local.set $node_abs (call $abs (i32.add (local.get $base) (local.get $offset))))
        (local.set $tag (i32.load16_u (local.get $node_abs)))
        (if (i32.ge_u (local.get $tag) (global.get $gc_ast_tag_capacity))
          (then (call $gc_fail (global.get $GC_ERR_AST_TAG) (local.get $tag))))
        (local.set $record (i32.add (global.get $gc_ast_layout)
          (i32.mul (local.get $tag) (i32.const 12))))
        (if (i32.ne (i32.load8_u (i32.add (local.get $record) (i32.const 11))) (i32.const 1))
          (then (call $gc_fail (global.get $GC_ERR_AST_TAG) (local.get $tag))))

        ;; String field: mark it, or forward it in place.
        (local.set $field (i32.load8_u (i32.add (local.get $record) (i32.const 7))))
        (if (i32.ne (local.get $field) (i32.const 0xFF))
          (then
            (local.set $id (i32.load (i32.add (local.get $node_abs) (local.get $field))))
            (if (i32.ne (local.get $id) (i32.const 0))
              (then
                (if (i32.eqz (local.get $forward))
                  (then (call $gc_mark_string (local.get $id)))
                  (else (call $gc_forward_string_field
                    (i32.add (local.get $node_abs) (local.get $field)))))))))

        ;; Scalar children.
        (local.set $n (i32.load8_u (local.get $record)))
        (local.set $i (i32.const 0))
        (block $kids_done
          (loop $kids
            (br_if $kids_done (i32.ge_u (local.get $i) (local.get $n)))
            (call $gc_ast_push (i32.load (i32.add (local.get $node_abs)
              (i32.load8_u (i32.add (i32.add (local.get $record) (i32.const 1)) (local.get $i))))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $kids)))

        ;; Count-prefixed child array.
        (local.set $field (i32.load8_u (i32.add (local.get $record) (i32.const 8))))
        (if (i32.ne (local.get $field) (i32.const 0xFF))
          (then
            (local.set $cnt (i32.load (i32.add (local.get $node_abs) (local.get $field))))
            (local.set $field (i32.load8_u (i32.add (local.get $record) (i32.const 9))))
            (local.set $i (i32.const 0))
            (block $arr_done
              (loop $arr
                (br_if $arr_done (i32.ge_u (local.get $i) (local.get $cnt)))
                (call $gc_ast_push (i32.load (i32.add
                  (i32.add (local.get $node_abs) (local.get $field))
                  (i32.mul (local.get $i) (i32.const 4)))))
                (local.set $i (i32.add (local.get $i) (i32.const 1)))
                (br $arr)))))

        ;; Chain edge (ROOT's nextRoot).
        (local.set $field (i32.load8_u (i32.add (local.get $record) (i32.const 10))))
        (if (i32.ne (local.get $field) (i32.const 0xFF))
          (then (call $gc_ast_push
            (i32.load (i32.add (local.get $node_abs) (local.get $field))))))
        (br $walk)))
  )

  ;; Intrinsic STATE cells from the host-written table.
  (func $gc_mark_intrinsics
    (local $i i32)
    (local $ptr i32)
    (local.set $i (i32.const 0))
    (block $done
      (loop $loop
        (br_if $done (i32.ge_u (local.get $i) (global.get $gc_intrinsic_count)))
        (local.set $ptr (call $read_state (i32.load (i32.add
          (global.get $gc_intrinsic_cells)
          (i32.mul (local.get $i) (i32.const 4))))))
        (if (i32.ne (local.get $ptr) (i32.const 0))
          (then (call $gc_mark_object_by_header (local.get $ptr))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $loop)))
  )

  ;; Decode a heap object's physical allocation size. Only ArrayBuffers
  ;; use the zero packed-size sentinel; +8 retains physical byteLength
  ;; throughout marking, forwarding and movement (+4 remains forwarding).
  ;; Zero for other types or unrepresentable sizes remains invalid.
  (func $gc_object_size (param $header i32) (param $word i32) (result i32)
    (local $size i32)
    (local $extended_size i64)
    (local.set $size (i32.and (local.get $word) (i32.const 0x00ffffff)))
    (if (i32.or (local.get $size)
          (i32.ne
            (i32.and (i32.shr_u (local.get $word) (i32.const 24)) (i32.const 0x7f))
            (global.get $OBJ_ARRAYBUFFER)))
      (then (return (local.get $size))))
    (local.set $extended_size (call $arraybuffer_size_i64
      (i32.load (call $abs (i32.add (local.get $header) (global.get $GC_HEADER_SIZE))))))
    (if (i64.gt_u (local.get $extended_size) (i64.const 0xffffffff))
      (then (return (i32.const 0))))
    (i32.wrap_i64 (local.get $extended_size))
  )

  ;; Clear every heap object's mark bit, rejecting invalid object sizes.
  (func $gc_clear_all_marks
    (local $hp i32)
    (local $abs i32)
    (local $word i32)
    (local $size i32)
    (local.set $hp (global.get $gc_heap_start))
    (block $done
      (loop $loop
        (br_if $done (i32.ge_u (local.get $hp) (global.get $gc_heap_end)))
        (local.set $abs (call $abs (local.get $hp)))
        (local.set $word (i32.load (local.get $abs)))
        (local.set $size (call $gc_object_size (local.get $hp) (local.get $word)))
        (if (i32.or (i32.eqz (local.get $size))
              (i32.gt_u (local.get $size)
                (i32.sub (global.get $gc_heap_end) (local.get $hp))))
          (then (call $gc_fail (global.get $GC_ERR_HEAP_HEADER) (local.get $hp))))
        (i32.store (local.get $abs) (i32.and (local.get $word) (i32.const 0x7fffffff)))
        (local.set $hp (i32.add (local.get $hp) (local.get $size)))
        (br $loop)))
  )

  ;; ==========================================================================
  ;; COMPACTION (phases 2-4) — mirrors of the JS update/move machinery.
  ;; ==========================================================================

  ;; getNewHeaderPointer: bounds-guarded forwarding-word read; 0 or
  ;; self-forwarding means "not moving" (returns the old pointer).
  (func $gc_new_header (param $old i32) (result i32)
    (local $fwd i32)
    (if (i32.lt_u (local.get $old) (global.get $gc_heap_start))
      (then (return (local.get $old))))
    (if (i32.ge_u (local.get $old) (global.get $gc_heap_end))
      (then (return (local.get $old))))
    (local.set $fwd (i32.load (i32.add (call $abs (local.get $old)) (i32.const 4))))
    (if (i32.or (i32.eqz (local.get $fwd)) (i32.eq (local.get $fwd) (local.get $old)))
      (then (return (local.get $old))))
    (local.get $fwd)
  )

  ;; getNewDataPointer: DATA-pointer flavor (bounds-guards the DATA
  ;; pointer itself, exactly like the JS).
  (func $gc_new_data (param $old i32) (result i32)
    (local $fwd i32)
    (if (i32.lt_u (local.get $old) (global.get $gc_heap_start))
      (then (return (local.get $old))))
    (if (i32.ge_u (local.get $old) (global.get $gc_heap_end))
      (then (return (local.get $old))))
    (local.set $fwd (i32.load (i32.add
      (call $abs (i32.sub (local.get $old) (global.get $GC_HEADER_SIZE)))
      (i32.const 4))))
    (if (i32.or (i32.eqz (local.get $fwd))
          (i32.eq (local.get $fwd) (i32.sub (local.get $old) (global.get $GC_HEADER_SIZE))))
      (then (return (local.get $old))))
    (i32.add (local.get $fwd) (global.get $GC_HEADER_SIZE))
  )

  ;; Rewrite a u32 field holding a HEADER pointer, if it forwards.
  (func $gc_forward_header_field (param $field_abs i32)
    (local $old i32)
    (local $new i32)
    (call $gc_check_abs (local.get $field_abs) (i32.const 4))
    (local.set $old (i32.load (local.get $field_abs)))
    (if (i32.eqz (local.get $old)) (then (return)))
    (local.set $new (call $gc_new_header (local.get $old)))
    (if (i32.ne (local.get $new) (local.get $old))
      (then (i32.store (local.get $field_abs) (local.get $new))))
  )

  ;; Rewrite a u32 field holding a DATA pointer, if it forwards.
  (func $gc_forward_data_field (param $field_abs i32)
    (local $old i32)
    (local $new i32)
    (call $gc_check_abs (local.get $field_abs) (i32.const 4))
    (local.set $old (i32.load (local.get $field_abs)))
    (if (i32.eqz (local.get $old)) (then (return)))
    (local.set $new (call $gc_new_data (local.get $old)))
    (if (i32.ne (local.get $new) (local.get $old))
      (then (i32.store (local.get $field_abs) (local.get $new))))
  )

  ;; Mirror of updateValuePointer: full type dispatch over a 16-byte
  ;; value slot.
  (func $gc_update_value (param $value_addr i32)
    (local $abs i32)
    (local $type i32)
    (local $flags i32)
    (local $recv_type i32)
    (local.set $abs (call $abs (local.get $value_addr)))
    (call $gc_check_abs (local.get $abs) (global.get $VALUE_SIZE))
    (local.set $type (i32.load (local.get $abs)))

    ;; Promise executor continuations carry a Promise DATA pointer.
    (if (i32.or
          (i32.eq (local.get $type) (global.get $TYPE_PROMISE_RESOLVE))
          (i32.eq (local.get $type) (global.get $TYPE_PROMISE_REJECT)))
      (then
        (call $gc_forward_data_field (i32.add (local.get $abs) (i32.const 8)))
        (return)))

    ;; HEADER-pointer class: ARRAY/OBJECT/FUNCTION/PROMISE/EXPRESSION,
    ;; CONSTRUCTOR, BIGINT/COMPLEX, SYMBOL, MAP/SET.
    (if (i32.or (i32.or (i32.or (i32.or (i32.or
          (i32.eq (local.get $type) (global.get $TYPE_ARRAY))
          (i32.eq (local.get $type) (global.get $TYPE_OBJECT)))
          (i32.or
            (i32.eq (local.get $type) (global.get $TYPE_FUNCTION))
            (i32.eq (local.get $type) (global.get $TYPE_CONSTRUCTOR))))
          (i32.or
            (i32.eq (local.get $type) (global.get $TYPE_PROMISE))
            (i32.eq (local.get $type) (global.get $TYPE_EXPRESSION))))
          (i32.or
            (i32.eq (local.get $type) (global.get $TYPE_BIGINT))
            (i32.eq (local.get $type) (global.get $TYPE_COMPLEX))))
          (i32.or (i32.or
            (i32.eq (local.get $type) (global.get $TYPE_SYMBOL))
            (i32.eq (local.get $type) (global.get $TYPE_MAP)))
            (i32.or
              (i32.eq (local.get $type) (global.get $TYPE_SET))
              (i32.or
                (i32.eq (local.get $type) (global.get $TYPE_MATRIX))
                (i32.or
                  (i32.eq (local.get $type) (global.get $TYPE_THEOREM))
                  (i32.or
                    (i32.eq (local.get $type) (global.get $TYPE_ALGEBRAIC))
                    (i32.or
                      (i32.eq (local.get $type) (global.get $TYPE_COMPLEX_ALGEBRAIC))
                      (i32.or
                        (i32.eq (local.get $type) (global.get $TYPE_REGEXP))
                        (i32.eq (local.get $type) (global.get $TYPE_SCHEMA))))))))))
      (then
        (call $gc_forward_header_field (i32.add (local.get $abs) (i32.const 8)))
        (return)))

    ;; ACCESSOR: forward both closure header pointers (getter data_lo,
    ;; setter data_hi; either may be 0 — the forwarder skips zeros).
    (if (i32.eq (local.get $type) (global.get $TYPE_ACCESSOR))
      (then
        (call $gc_forward_header_field (i32.add (local.get $abs) (i32.const 8)))
        (call $gc_forward_header_field (i32.add (local.get $abs) (i32.const 12)))
        (return)))

    ;; RATIONAL: header pointer unless inline.
    (if (i32.eq (local.get $type) (global.get $TYPE_RATIONAL))
      (then
        (local.set $flags (i32.load (i32.add (local.get $abs) (i32.const 4))))
        (if (i32.eqz (i32.and (local.get $flags) (global.get $FLAG_RATIONAL_INLINE)))
          (then (call $gc_forward_header_field (i32.add (local.get $abs) (i32.const 8)))))
        (return)))

    ;; DATA-pointer class: SCOPE, ARRAYBUFFER, MSGPACK_REF, typed arrays.
    (if (i32.or (i32.or (i32.or
          (i32.eq (local.get $type) (global.get $TYPE_SCOPE))
          (i32.eq (local.get $type) (global.get $TYPE_ARRAYBUFFER)))
          (i32.eq (local.get $type) (global.get $TYPE_MSGPACK_REF)))
          (call $gc_is_typed_array_type (local.get $type)))
      (then
        (call $gc_forward_data_field (i32.add (local.get $abs) (i32.const 8)))
        (return)))

    ;; BOUND_METHOD: receiver-type-dependent convention. String
    ;; receivers are ids (string phase); MSGPACK_REF / typed-array /
    ;; SCOPE receivers are DATA pointers; the rest HEADER pointers.
    (if (i32.eq (local.get $type) (global.get $TYPE_BOUND_METHOD))
      (then
        (local.set $flags (i32.load (i32.add (local.get $abs) (i32.const 4))))
        (local.set $recv_type (i32.and (local.get $flags) (i32.const 0xff)))
        (if (i32.eq (local.get $recv_type) (global.get $TYPE_STRING))
          (then (return)))
        (if (i32.or (i32.or
              (i32.eq (local.get $recv_type) (global.get $TYPE_MSGPACK_REF))
              (call $gc_is_typed_array_type (local.get $recv_type)))
              (i32.eq (local.get $recv_type) (global.get $TYPE_SCOPE)))
          (then
            (call $gc_forward_data_field (i32.add (local.get $abs) (i32.const 8)))
            (return)))
        (call $gc_forward_header_field (i32.add (local.get $abs) (i32.const 8)))
        (return)))
  )

  ;; Mirror of updateSymEntriesSlot: forward the block pointer, then
  ;; the symbol-pointer keys and value slots at the OLD block address.
  (func $gc_update_sym_entries (param $slot_addr i32)
    (local $old_header i32)
    (local $data i32)
    (local $count i32)
    (local $entry i32)
    (local $i i32)
    (local.set $old_header (i32.load (call $abs (local.get $slot_addr))))
    (if (i32.eqz (local.get $old_header)) (then (return)))
    (call $gc_forward_header_field (call $abs (local.get $slot_addr)))
    (local.set $data (i32.add (local.get $old_header) (global.get $GC_HEADER_SIZE)))
    (local.set $count (i32.load (call $abs (local.get $data))))
    (local.set $entry (i32.add (local.get $data) (i32.const 8)))
    (local.set $i (i32.const 0))
    (block $done
      (loop $loop
        (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
        (call $gc_forward_header_field (call $abs (local.get $entry)))
        (call $gc_update_value (i32.add (local.get $entry) (i32.const 4)))
        (local.set $entry (i32.add (local.get $entry) (i32.const 20)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $loop)))
  )

  ;; Mirror of updateObjectPointers' per-type walkers.
  (func $gc_update_array (param $data i32)
    (local $abs i32)
    (local $length i32)
    (local $old_block i32)
    (local $elems i32)
    (local $i i32)
    (local.set $abs (call $abs (local.get $data)))
    (local.set $length (i32.load (local.get $abs)))
    (local.set $old_block (i32.load (i32.add (local.get $abs) (i32.const 8))))
    (if (i32.ne (local.get $old_block) (i32.const 0))
      (then
        (call $gc_forward_header_field (i32.add (local.get $abs) (i32.const 8)))
        ;; Walk elements at the OLD block address (nothing has moved yet).
        (local.set $elems (i32.add (local.get $old_block) (global.get $GC_HEADER_SIZE)))
        (local.set $i (i32.const 0))
        (block $done
          (loop $loop
            (br_if $done (i32.ge_u (local.get $i) (local.get $length)))
            (call $gc_update_value
              (i32.add (local.get $elems) (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $loop)))))
    (call $gc_update_sym_entries (i32.add (local.get $data) (i32.const 16)))
  )

  (func $gc_update_object_entries (param $data i32)
    (local $abs i32)
    (local $count i32)
    (local $old_entries i32)
    (local $entry i32)
    (local $i i32)
    (local.set $abs (call $abs (local.get $data)))
    (call $gc_forward_header_field (local.get $abs))  ;; prototype
    ;; Forward a BigInt wrapper's internal [[BigIntData]] HEADER pointer.
    (if (i32.gt_u
          (i32.and
            (i32.load (call $abs
              (i32.sub (local.get $data) (global.get $GC_HEADER_SIZE))))
            (i32.const 0x00ffffff))
          (global.get $OBJECT_HEADER_SIZE))
      (then
        (call $gc_forward_header_field
          (i32.add (local.get $abs) (i32.const 24)))))
    (local.set $count (i32.load (i32.add (local.get $abs) (i32.const 4))))
    (local.set $old_entries (i32.load (i32.add (local.get $abs) (i32.const 16))))
    (if (i32.ne (local.get $old_entries) (i32.const 0))
      (then
        (call $gc_forward_header_field (i32.add (local.get $abs) (i32.const 16)))
        (local.set $entry (i32.add (local.get $old_entries) (global.get $GC_HEADER_SIZE)))
        (local.set $i (i32.const 0))
        (block $done
          (loop $loop
            (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
            (call $gc_update_value (i32.add (local.get $entry) (i32.const 4)))
            (local.set $entry (i32.add (local.get $entry) (i32.const 20)))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $loop)))))
    (call $gc_update_sym_entries (i32.add (local.get $data) (i32.const 20)))
  )

  (func $gc_update_scope (param $data i32)
    (local $abs i32)
    (local $count i32)
    (local $old_entries i32)
    (local $entry i32)
    (local $i i32)
    (local.set $abs (call $abs (local.get $data)))
    (call $gc_forward_data_field (local.get $abs))  ;; parent scope
    (local.set $count (i32.load (i32.add (local.get $abs) (i32.const 4))))
    (local.set $old_entries (i32.load (i32.add (local.get $abs) (i32.const 12))))
    (if (i32.ne (local.get $old_entries) (i32.const 0))
      (then
        (call $gc_forward_header_field (i32.add (local.get $abs) (i32.const 12)))
        (local.set $entry (i32.add (local.get $old_entries) (global.get $GC_HEADER_SIZE)))
        (local.set $i (i32.const 0))
        (block $done
          (loop $loop
            (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
            (call $gc_update_value (i32.add (local.get $entry) (i32.const 4)))
            (local.set $entry (i32.add (local.get $entry) (i32.const 20)))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $loop)))))
  )

  (func $gc_update_closure (param $data i32)
    (call $gc_update_object_entries (local.get $data))
    (call $gc_forward_data_field (call $abs (i32.add (local.get $data) (i32.const 32))))
  )

  (func $gc_update_promise (param $data i32)
    (local $handlers_abs i32)
    (local $old i32)
    (call $gc_update_value (i32.add (local.get $data) (global.get $PROMISE_VALUE)))
    (call $gc_forward_data_field
      (call $abs
        (i32.add (local.get $data) (global.get $PROMISE_WAITERS))))
    (local.set $handlers_abs (call $abs (i32.add (local.get $data) (global.get $PROMISE_HANDLERS))))
    (local.set $old (i32.load (local.get $handlers_abs)))
    (if (i32.ne (local.get $old) (i32.const -1))
      (then (call $gc_forward_data_field (local.get $handlers_abs))))
  )

  (func $gc_update_promise_waiter (param $data i32)
    (call $gc_forward_data_field
      (call $abs
        (i32.add (local.get $data) (global.get $PROMISE_WAITER_NEXT))))
  )

  (func $gc_update_then_handler (param $data i32)
    (local $next_abs i32)
    (call $gc_forward_header_field (call $abs (i32.add (local.get $data) (global.get $THEN_HANDLER_ON_RESOLVED))))
    (call $gc_forward_header_field (call $abs (i32.add (local.get $data) (global.get $THEN_HANDLER_ON_REJECTED))))
    (call $gc_forward_data_field (call $abs (i32.add (local.get $data) (global.get $THEN_HANDLER_CHILD_PROMISE))))
    (local.set $next_abs (call $abs (i32.add (local.get $data) (global.get $THEN_HANDLER_NEXT))))
    (if (i32.ne (i32.load (local.get $next_abs)) (i32.const -1))
      (then (call $gc_forward_data_field (local.get $next_abs))))
  )

  ;; RATIONAL / COMPLEX / EXPRESSION share the [ptr:4][ptr:4]
  ;; header-pointer-pair shape. NOTE the JS updateRational/Complex/
  (func $gc_update_native_continuation_state (param $data i32)
    (local $header_pointer_mask i32)
    (local $data_pointer_mask i32)
    (local $state_index i32)
    (local $slot i32)
    (local.set $header_pointer_mask
      (i32.load (call $abs (local.get $data))))
    (local.set $data_pointer_mask
      (i32.load (call $abs (i32.add (local.get $data) (i32.const 4)))))
    (if (i32.ne
          (i32.and
            (local.get $header_pointer_mask)
            (local.get $data_pointer_mask))
          (i32.const 0))
      (then (unreachable)))
    (local.set $state_index (i32.const 0))
    (block $done
      (loop $loop
        (br_if $done (i32.ge_u (local.get $state_index) (i32.const 5)))
        (local.set $slot
          (call $abs (i32.add
            (local.get $data)
            (i32.add
              (global.get $NATIVE_CONTINUATION_STATE_VALUES)
              (i32.mul (local.get $state_index) (i32.const 4))))))
        (if (i32.and
              (local.get $header_pointer_mask)
              (i32.shl (i32.const 1) (local.get $state_index)))
          (then (call $gc_forward_header_field (local.get $slot)))
          (else
            (if (i32.and
                  (local.get $data_pointer_mask)
                  (i32.shl (i32.const 1) (local.get $state_index)))
              (then (call $gc_forward_data_field (local.get $slot))))))
        (local.set $state_index
          (i32.add (local.get $state_index) (i32.const 1)))
        (br $loop)))
  )

  ;; Expression write UNCONDITIONALLY when non-zero (no != check) —
  ;; same final bytes either way.
  (func $gc_update_header_pair (param $data i32)
    (call $gc_forward_header_field (call $abs (local.get $data)))
    (call $gc_forward_header_field (call $abs (i32.add (local.get $data) (i32.const 4))))
  )

  (func $gc_update_typed_descriptor (param $data i32)
    ;; bufferPtr is a DATA pointer; JS writes new unconditionally when
    ;; non-zero — same final bytes as conditional.
    (call $gc_forward_data_field (call $abs (local.get $data)))
    (call $gc_update_sym_entries (i32.add (local.get $data) (i32.const 12)))
  )

  (func $gc_update_map_set (param $obj_type i32) (param $data i32)
    (local $abs i32)
    (local $slot_count i32)
    (local $old_entries i32)
    (local $slot i32)
    (local $i i32)
    (local.set $abs (call $abs (local.get $data)))
    (local.set $slot_count (i32.load (i32.add (local.get $abs) (i32.const 4))))
    (local.set $old_entries (i32.load (i32.add (local.get $abs) (i32.const 12))))
    (if (i32.ne (local.get $old_entries) (i32.const 0))
      (then
        (call $gc_forward_header_field (i32.add (local.get $abs) (i32.const 12)))
        ;; Walk slots at the OLD entries address.
        (local.set $slot (i32.add (local.get $old_entries) (global.get $GC_HEADER_SIZE)))
        (local.set $i (i32.const 0))
        (if (i32.eq (local.get $obj_type) (global.get $OBJ_MAP))
          (then
            (block $done_map
              (loop $loop_map
                (br_if $done_map (i32.ge_u (local.get $i) (local.get $slot_count)))
                (call $gc_update_value (i32.add (local.get $slot) (i32.const 4)))
                (call $gc_update_value (i32.add (local.get $slot) (i32.const 20)))
                (local.set $slot (i32.add (local.get $slot) (i32.const 36)))
                (local.set $i (i32.add (local.get $i) (i32.const 1)))
                (br $loop_map))))
          (else
            (block $done_set
              (loop $loop_set
                (br_if $done_set (i32.ge_u (local.get $i) (local.get $slot_count)))
                (call $gc_update_value (i32.add (local.get $slot) (i32.const 4)))
                (local.set $slot (i32.add (local.get $slot) (i32.const 20)))
                (local.set $i (i32.add (local.get $i) (i32.const 1)))
                (br $loop_set)))))))
    (call $gc_update_sym_entries (i32.add (local.get $abs) (i32.const 16))
    )
  )

  ;; Mirror of updateObjectPointers: dispatch by OBJ type.
  (func $gc_update_object (param $header i32)
    (local $word i32)
    (local $obj_type i32)
    (local $data i32)
    (local.set $word (i32.load (call $abs (local.get $header))))
    (local.set $obj_type (i32.and (i32.shr_u (local.get $word) (i32.const 24)) (i32.const 0x7f)))
    (local.set $data (i32.add (local.get $header) (global.get $GC_HEADER_SIZE)))
    (if (i32.eq (local.get $obj_type) (global.get $OBJ_ARRAY))
      (then (call $gc_update_array (local.get $data)) (return)))
    (if (i32.eq (local.get $obj_type) (global.get $OBJ_OBJECT))
      (then (call $gc_update_object_entries (local.get $data)) (return)))
    (if (i32.eq (local.get $obj_type) (global.get $OBJ_SCOPE))
      (then (call $gc_update_scope (local.get $data)) (return)))
    (if (i32.eq (local.get $obj_type) (global.get $OBJ_FUNCTION))
      (then (call $gc_update_closure (local.get $data)) (return)))
    (if (i32.eq (local.get $obj_type) (global.get $OBJ_TYPED_ARRAY_DESCRIPTOR))
      (then (call $gc_update_typed_descriptor (local.get $data)) (return)))
    (if (i32.eq (local.get $obj_type) (global.get $OBJ_PROMISE))
      (then (call $gc_update_promise (local.get $data)) (return)))
    (if (i32.eq (local.get $obj_type) (global.get $OBJ_PROMISE_WAITER))
      (then (call $gc_update_promise_waiter (local.get $data)) (return)))
    (if (i32.eq (local.get $obj_type) (global.get $OBJ_THEN_HANDLER))
      (then (call $gc_update_then_handler (local.get $data)) (return)))
    (if (i32.or (i32.or (i32.or
          (i32.eq (local.get $obj_type) (global.get $OBJ_RATIONAL))
          (i32.eq (local.get $obj_type) (global.get $OBJ_COMPLEX)))
          (i32.eq (local.get $obj_type) (global.get $OBJ_EXPRESSION)))
          (i32.eq (local.get $obj_type) (global.get $OBJ_COMPLEX_ALGEBRAIC)))
      (then (call $gc_update_header_pair (local.get $data)) (return)))
    (if (i32.eq
          (local.get $obj_type)
          (global.get $OBJ_NATIVE_CONTINUATION_STATE))
      (then
        (call $gc_update_native_continuation_state (local.get $data))
        (return)))
    (if (i32.eq (local.get $obj_type) (global.get $OBJ_MATRIX))
      (then
        ;; Forward the entries Array header pointer at data+8; the
        ;; counts are not pointers.
        (call $gc_forward_header_field (call $abs (i32.add (local.get $data) (i32.const 8))))
        (return)))
    (if (i32.eq (local.get $obj_type) (global.get $OBJ_THEOREM))
      (then
        ;; Forward both the artifact (or parameter owner) and optional
        ;; composed-value owner DATA pointers. Index and kind are scalars.
        (call $gc_forward_data_field (call $abs (local.get $data)))
        (call $gc_forward_data_field (call $abs (i32.add (local.get $data) (i32.const 12))))
        (return)))
    (if (i32.eq (local.get $obj_type) (global.get $OBJ_REGEXP))
      (then
        ;; Forward the compiled-program ArrayBuffer DATA pointer at
        ;; data+12. The pattern string id is forwarded by the string
        ;; compaction pass; flags and lastIndex are scalars.
        (call $gc_forward_data_field (call $abs
          (i32.add (local.get $data) (global.get $REGEXP_PROGRAM_BUFFER))))
        (return)))
    (if (i32.eq (local.get $obj_type) (global.get $OBJ_SCHEMA))
      (then
        ;; Forward the source value slot and the program buffer DATA
        ;; pointer (mirror of the mark-phase OBJ_SCHEMA case).
        (call $gc_update_value (i32.add (local.get $data) (global.get $SCHEMA_SOURCE)))
        (call $gc_forward_data_field (call $abs
          (i32.add (local.get $data) (global.get $SCHEMA_PROGRAM_BUFFER))))
        (return)))
    (if (i32.eq (local.get $obj_type) (global.get $OBJ_ALGEBRAIC))
      (then
        ;; Forward the defining-polynomial Array, interval Array, optional
        ;; field-generator AlgebraicNumber, and optional coordinates Array.
        (call $gc_forward_header_field (call $abs (local.get $data)))
        (call $gc_forward_header_field (call $abs (i32.add (local.get $data) (i32.const 4))))
        (call $gc_forward_header_field (call $abs (i32.add (local.get $data) (i32.const 8))))
        (call $gc_forward_header_field (call $abs (i32.add (local.get $data) (i32.const 12))))
        (return)))
    (if (i32.or
          (i32.eq (local.get $obj_type) (global.get $OBJ_MAP))
          (i32.eq (local.get $obj_type) (global.get $OBJ_SET)))
      (then (call $gc_update_map_set (local.get $obj_type) (local.get $data)) (return)))
    ;; ARRAY_DATA / OBJECT_DATA / *_ENTRIES: parent-walked. ARRAYBUFFER /
    ;; BIGINT / SYMBOL: leaves. CONTEXT / STACK_BLOCK: forwarded by
    ;; $gc_update_context. Unknown: leaves.
  )

  ;; Mirror of computeForwardingAddresses.
  (func $gc_compute_forwarding
    (local $read i32)
    (local $write i32)
    (local $word i32)
    (local $size i32)
    (local.set $read (global.get $gc_heap_start))
    (local.set $write (global.get $gc_heap_start))
    (block $done
      (loop $loop
        (br_if $done (i32.ge_u (local.get $read) (global.get $gc_heap_end)))
        (local.set $word (i32.load (call $abs (local.get $read))))
        (local.set $size (call $gc_object_size (local.get $read) (local.get $word)))
        (if (i32.or (i32.eqz (local.get $size))
              (i32.gt_u (local.get $size)
                (i32.sub (global.get $gc_heap_end) (local.get $read))))
          (then (call $gc_fail (global.get $GC_ERR_HEAP_HEADER) (local.get $read))))
        (if (i32.and (local.get $word) (i32.const 0x80000000))
          (then
            (i32.store (i32.add (call $abs (local.get $read)) (i32.const 4)) (local.get $write))
            (local.set $write (i32.add (local.get $write) (local.get $size)))))
        (local.set $read (i32.add (local.get $read) (local.get $size)))
        (br $loop)))
  )

  ;; Rewrite the host's root block entries in place with their
  ;; forwarded addresses (mirror of buildExternalForwarding — same
  ;; final bytes: unmoved roots stay as-is).
  (func $gc_forward_root_block
    (local $i i32)
    (local $entry_addr i32)
    (local.set $i (i32.const 0))
    (block $done
      (loop $loop
        (br_if $done (i32.ge_u (local.get $i) (global.get $gc_root_count)))
        (local.set $entry_addr (i32.add
          (i32.add (global.get $gc_root_block) (i32.const 4))
          (i32.mul (local.get $i) (i32.const 4))))
        (if (i32.ne (i32.load (local.get $entry_addr)) (i32.const 0))
          (then (i32.store (local.get $entry_addr)
            (call $gc_new_header (i32.load (local.get $entry_addr))))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $loop)))
  )

  ;; Mirror of _forwardStackBlock.
  (func $gc_forward_stack_block (param $ctx_abs i32) (param $base_field i32)
      (param $limit_field i32) (param $top_field i32)
      (param $old_base i32) (param $old_top i32)
    (local $new_base i32)
    (local $delta i32)
    (local.set $new_base (call $gc_new_data (local.get $old_base)))
    (if (i32.eq (local.get $new_base) (local.get $old_base)) (then (return)))
    (local.set $delta (i32.sub (local.get $new_base) (local.get $old_base)))
    (i32.store (i32.add (local.get $ctx_abs) (local.get $base_field)) (local.get $new_base))
    (i32.store (i32.add (local.get $ctx_abs) (local.get $limit_field))
      (i32.add (i32.load (i32.add (local.get $ctx_abs) (local.get $limit_field))) (local.get $delta)))
    (i32.store (i32.add (local.get $ctx_abs) (local.get $top_field))
      (i32.add (local.get $old_top) (local.get $delta)))
  )

  ;; Mirror of updateRequestBasePointersForContext.
  (func $gc_update_request_base (param $ctx_base i32) (param $pending_delta i32)
    (local $exit i32)
    (local $req i32)
    (local $req_abs i32)
    (local $old i32)
    (local $new i32)
    (local $args i32)
    (local $argc i32)
    (local $i i32)
    (local.set $exit (i32.load (call $abs (i32.add (local.get $ctx_base) (global.get $CTX_EXIT_CONDITION)))))
    (local.set $req (i32.add (local.get $ctx_base) (global.get $CTX_REQUEST_BLOCK)))
    (local.set $req_abs (call $abs (local.get $req)))

    (if (i32.eq (local.get $exit) (global.get $EXIT_AWAIT))
      (then
        (if (i32.eqz (i32.load (local.get $req_abs)))
          (then
            (local.set $old (i32.load (i32.add (local.get $req_abs) (i32.const 8))))
            (if (i32.ne (local.get $old) (i32.const 0))
              (then
                (local.set $old (i32.sub (local.get $old) (global.get $PROMISE_VALUE)))
                (if (call $gc_is_live_promise (local.get $old))
                  (then
                    (local.set $new (call $gc_new_data (local.get $old)))
                    (if (i32.ne (local.get $new) (local.get $old))
                      (then (i32.store (i32.add (local.get $req_abs) (i32.const 8))
                        (i32.add (local.get $new) (global.get $PROMISE_VALUE)))))))))))
        (return)))

    (if (i32.eq (local.get $exit) (global.get $EXIT_PROMISE_SETTLE))
      (then
        (call $gc_forward_data_field (local.get $req_abs))
        (return)))

    (if (i32.eq (local.get $exit) (global.get $EXIT_PROMISE_METHOD))
      (then
        (call $gc_forward_header_field (local.get $req_abs))
        (local.set $args (i32.load (i32.add (local.get $req_abs) (i32.const 8))))
        (local.set $argc (i32.load (i32.add (local.get $req_abs) (i32.const 12))))
        (local.set $i (i32.const 0))
        (block $done_pm
          (loop $loop_pm
            (br_if $done_pm (i32.ge_u (local.get $i) (local.get $argc)))
            (call $gc_update_value (i32.add (local.get $args)
              (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $loop_pm)))
        (if (i32.and (i32.ne (local.get $args) (i32.const 0))
              (i32.ne (local.get $pending_delta) (i32.const 0)))
          (then (i32.store (i32.add (local.get $req_abs) (i32.const 8))
            (i32.add (local.get $args) (local.get $pending_delta)))))
        (return)))

    (if (i32.eq (local.get $exit) (global.get $EXIT_ASYNC_CALL))
      (then
        (call $gc_forward_header_field (local.get $req_abs))
        (call $gc_update_value (i32.add (local.get $req) (i32.const 12)))
        (local.set $old (i32.load (i32.add (local.get $req_abs) (i32.const 4))))
        (if (i32.and (i32.ne (local.get $old) (i32.const 0))
              (i32.ne (local.get $pending_delta) (i32.const 0)))
          (then (i32.store (i32.add (local.get $req_abs) (i32.const 4))
            (i32.add (local.get $old) (local.get $pending_delta)))))
        (return)))

    (if (i32.or (i32.or
          (i32.eq (local.get $exit) (global.get $EXIT_EXTERNAL_CALL))
          (i32.eq (local.get $exit) (global.get $EXIT_EXTERNAL_PROPERTY)))
          (i32.eq (local.get $exit) (global.get $EXIT_EXTERNAL_PROPERTY_SET)))
      (then
        (local.set $args (i32.load (i32.add (local.get $req_abs) (i32.const 8))))
        (local.set $argc (i32.load (i32.add (local.get $req_abs) (i32.const 12))))
        (local.set $i (i32.const 0))
        (block $done_ex
          (loop $loop_ex
            (br_if $done_ex (i32.ge_u (local.get $i) (local.get $argc)))
            (call $gc_update_value (i32.add (local.get $args)
              (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $loop_ex)))
        (if (i32.and (i32.ne (local.get $args) (i32.const 0))
              (i32.ne (local.get $pending_delta) (i32.const 0)))
          (then (i32.store (i32.add (local.get $req_abs) (i32.const 8))
            (i32.add (local.get $args) (local.get $pending_delta)))))
        ;; extends-externals D3: forward the construction pointer at +20
        ;; (mirror of the mark phase).
        (if (i32.and
              (i32.eq (local.get $exit) (global.get $EXIT_EXTERNAL_CALL))
              (i32.or (i32.or
                (i32.eq (i32.load (i32.add (local.get $req_abs) (i32.const 4)))
                  (call $read_builtin (global.get $BUILTIN_CONSTRUCT_BEGIN)))
                (i32.eq (i32.load (i32.add (local.get $req_abs) (i32.const 4)))
                  (call $read_builtin (global.get $BUILTIN_CONSTRUCT_COMPLETE))))
                (i32.eq (i32.load (i32.add (local.get $req_abs) (i32.const 4)))
                  (call $read_builtin (global.get $BUILTIN_CONSTRUCT_ABORT)))))
          (then
            (call $gc_forward_header_field (i32.add (local.get $req_abs) (i32.const 20)))))
        (return)))
  )

  ;; Mirror of updateContextPointers — strict internal order: content
  ;; forwarders on OLD bounds, scope + completion, stack-block rebase,
  ;; request-base with the pending delta, slot table entry LAST.
  (func $gc_update_context (param $ctx_base i32) (param $table_entry_abs i32)
    (local $ctx_abs i32)
    (local $pending_base i32)
    (local $pending_ptr i32)
    (local $call_base i32)
    (local $call_ptr i32)
    (local $grant_base i32)
    (local $grant_ptr i32)
    (local $try_base i32)
    (local $try_ptr i32)
    (local $addr i32)
    (local $frame_abs i32)
    (local $old i32)
    (local $flag_bits i32)
    (local $new i32)
    (local.set $ctx_abs (call $abs (local.get $ctx_base)))
    (call $gc_check_abs (local.get $ctx_abs) (i32.const 512))
    (local.set $pending_base (i32.load (i32.add (local.get $ctx_abs) (global.get $CTX_PENDING_BASE))))
    (local.set $pending_ptr (i32.load (i32.add (local.get $ctx_abs) (global.get $CTX_PENDING_POINTER))))
    (local.set $call_base (i32.load (i32.add (local.get $ctx_abs) (global.get $CTX_CALL_STACK_BASE))))
    (local.set $call_ptr (i32.load (i32.add (local.get $ctx_abs) (global.get $CTX_CALL_STACK_POINTER))))
    (local.set $grant_base (i32.load (i32.add (local.get $ctx_abs) (global.get $CTX_GRANT_STACK_BASE))))
    (local.set $grant_ptr (i32.load (i32.add (local.get $ctx_abs) (global.get $CTX_GRANT_STACK_POINTER))))
    (local.set $try_base (i32.load (i32.add (local.get $ctx_abs) (global.get $CTX_TRY_STACK_BASE))))
    (local.set $try_ptr (i32.load (i32.add (local.get $ctx_abs) (global.get $CTX_TRY_STACK_POINTER))))

    ;; Pending stack values.
    (local.set $addr (local.get $pending_base))
    (block $done_pending
      (loop $loop_pending
        (br_if $done_pending (i32.ge_u (local.get $addr) (local.get $pending_ptr)))
        (call $gc_update_value (local.get $addr))
        (local.set $addr (i32.add (local.get $addr) (global.get $VALUE_SIZE)))
        (br $loop_pending)))

    ;; Call-stack frames.
    (local.set $addr (local.get $call_base))
    (block $done_frames
      (loop $loop_frames
        (br_if $done_frames (i32.ge_u (local.get $addr) (local.get $call_ptr)))
        (local.set $frame_abs (call $abs (local.get $addr)))
        (call $gc_check_abs (local.get $frame_abs) (global.get $FRAME_SIZE))
        (call $gc_forward_data_field (i32.add (local.get $frame_abs) (global.get $FRAME_SCOPE_POINTER)))
        (if (i32.and
              (i32.load (i32.add (local.get $frame_abs) (global.get $FRAME_FLAGS)))
              (global.get $FRAME_FLAG_NATIVE_CONTINUATION))
          (then
            (local.set $old
              (i32.load (i32.add
                (local.get $frame_abs)
                (global.get $FRAME_CONTINUATION_KIND))))
            (call $gc_forward_header_field
              (i32.add
                (local.get $frame_abs)
                (global.get $FRAME_CONTINUATION_STATE_HANDLE)))
            (call $gc_forward_header_field (i32.add (local.get $frame_abs) (global.get $FRAME_CONTINUATION_CALLBACK))))
          (else
            ;; ASYNC_PROMISE: preserve the low flag bits across forwarding.
            ;; This is ordinary-call-frame state; native continuation frames
            ;; own operation state through STATE_HANDLE.
            (local.set $old (i32.load (i32.add (local.get $frame_abs) (global.get $FRAME_ASYNC_PROMISE))))
            (local.set $flag_bits (i32.and (local.get $old) (i32.const 3)))
            (local.set $old (i32.and (local.get $old) (i32.const -4)))
            (if (i32.ne (local.get $old) (i32.const 0))
              (then
                (local.set $new (call $gc_new_data (local.get $old)))
                (if (i32.ne (local.get $new) (local.get $old))
                  (then (i32.store (i32.add (local.get $frame_abs) (global.get $FRAME_ASYNC_PROMISE))
                    (i32.or (local.get $new) (local.get $flag_bits)))))))))
        (local.set $addr (i32.add (local.get $addr) (global.get $FRAME_SIZE)))
        (br $loop_frames)))

    ;; Grant stack: identifier value + saved scope.
    (local.set $addr (local.get $grant_base))
    (block $done_grants
      (loop $loop_grants
        (br_if $done_grants (i32.ge_u (local.get $addr) (local.get $grant_ptr)))
        (call $gc_update_value (local.get $addr))
        (call $gc_forward_data_field (call $abs
          (i32.add (local.get $addr) (global.get $GRANT_SCOPE_POINTER))))
        (local.set $addr (i32.add (local.get $addr) (global.get $GRANT_ENTRY_SIZE)))
        (br $loop_grants)))

    ;; Try stack: saved scopes, plus v11 pending completion values.
    (local.set $addr (local.get $try_base))
    (block $done_tries
      (loop $loop_tries
        (br_if $done_tries (i32.ge_u (local.get $addr) (local.get $try_ptr)))
        (call $gc_forward_data_field (call $abs
          (i32.add (local.get $addr) (global.get $TRY_SCOPE))))
        (local.set $new (i32.load (call $abs
          (i32.add (local.get $addr) (global.get $TRY_COMPLETION_TYPE)))))
        (if (i32.or
              (i32.eq (local.get $new) (global.get $COMPLETION_THROW))
              (i32.eq (local.get $new) (global.get $COMPLETION_RETURN)))
          (then (call $gc_update_value
            (i32.add (local.get $addr) (global.get $TRY_COMPLETION_VALUE)))))
        (local.set $addr (i32.add (local.get $addr) (global.get $TRY_ENTRY_SIZE)))
        (br $loop_tries)))

    ;; Scope + completion value.
    (call $gc_forward_data_field (i32.add (local.get $ctx_abs) (global.get $CTX_SCOPE)))
    (if (i32.and
          (i32.ne (i32.load (i32.add (local.get $ctx_abs) (global.get $CTX_COMPLETION_TYPE))) (i32.const 0))
          (i32.ne (i32.load (i32.add (local.get $ctx_abs) (global.get $CTX_COMPLETION_VALUE))) (i32.const 0)))
      (then (call $gc_update_value
        (i32.load (i32.add (local.get $ctx_abs) (global.get $CTX_COMPLETION_VALUE))))))

    ;; Generator object (header pointer).
    (call $gc_forward_header_field (i32.add (local.get $ctx_abs) (global.get $CTX_GENERATOR_OBJECT)))

    ;; Paused RegExp operation state (header pointer).
    (call $gc_forward_header_field (i32.add (local.get $ctx_abs) (global.get $CTX_REGEX_STATE)))

    ;; Construction abort duty (header pointer).
    (call $gc_forward_header_field (i32.add (local.get $ctx_abs) (global.get $CTX_CONSTRUCTION_DUTY)))

    ;; Stack-block base/limit/top rebase (order: pending, call, try, grant).
    (call $gc_forward_stack_block (local.get $ctx_abs)
      (global.get $CTX_PENDING_BASE) (global.get $CTX_PENDING_LIMIT)
      (global.get $CTX_PENDING_POINTER) (local.get $pending_base) (local.get $pending_ptr))
    (call $gc_forward_stack_block (local.get $ctx_abs)
      (global.get $CTX_CALL_STACK_BASE) (global.get $CTX_CALL_STACK_LIMIT)
      (global.get $CTX_CALL_STACK_POINTER) (local.get $call_base) (local.get $call_ptr))
    (call $gc_forward_stack_block (local.get $ctx_abs)
      (global.get $CTX_TRY_STACK_BASE) (global.get $CTX_TRY_STACK_LIMIT)
      (global.get $CTX_TRY_STACK_POINTER) (local.get $try_base) (local.get $try_ptr))
    (call $gc_forward_stack_block (local.get $ctx_abs)
      (global.get $CTX_GRANT_STACK_BASE) (global.get $CTX_GRANT_STACK_LIMIT)
      (global.get $CTX_GRANT_STACK_POINTER) (local.get $grant_base) (local.get $grant_ptr))

    ;; Request-base payload, with the pending block's move delta.
    (call $gc_update_request_base (local.get $ctx_base)
      (i32.sub (call $gc_new_data (local.get $pending_base)) (local.get $pending_base)))

    ;; Slot table entry LAST.
    (local.set $new (call $gc_new_data (local.get $ctx_base)))
    (if (i32.ne (local.get $new) (local.get $ctx_base))
      (then (i32.store (local.get $table_entry_abs) (local.get $new))))
  )

  ;; Mirror of updatePointers: heap walk over marked objects, contexts,
  ;; intrinsics (+ROOT_SCOPE tail), code-block heap operands.
  (func $gc_update_pointers
    (local $hp i32)
    (local $word i32)
    (local $size i32)
    (local $count i32)
    (local $table i32)
    (local $slot i32)
    (local $entry_abs i32)
    (local $ctx_base i32)
    (local $i i32)
    (local $cell i32)
    (local $old i32)
    (local $new i32)
    (local $code_start i32)
    (local $instr_abs i32)
    ;; (a) heap walk.
    (local.set $hp (global.get $gc_heap_start))
    (block $walk_done
      (loop $walk
        (br_if $walk_done (i32.ge_u (local.get $hp) (global.get $gc_heap_end)))
        (local.set $word (i32.load (call $abs (local.get $hp))))
        (local.set $size (call $gc_object_size (local.get $hp) (local.get $word)))
        (if (i32.or (i32.eqz (local.get $size))
              (i32.gt_u (local.get $size)
                (i32.sub (global.get $gc_heap_end) (local.get $hp))))
          (then (call $gc_fail (global.get $GC_ERR_HEAP_HEADER) (local.get $hp))))
        (if (i32.and (local.get $word) (i32.const 0x80000000))
          (then (call $gc_update_object (local.get $hp))))
        (local.set $hp (i32.add (local.get $hp) (local.get $size)))
        (br $walk)))
    ;; (b) contexts (same discovery as the mark phase; stale FREE
    ;; entries were already zeroed there). $table is the OLD address —
    ;; per-slot entry writes must land in the old bytes (moveObjects
    ;; copies them); the cell itself is forwarded in (c) below.
    (local.set $count (call $read_state (global.get $STATE_CONTEXT_COUNT)))
    (local.set $table (call $read_state (global.get $STATE_CONTEXT_TABLE_POINTER)))
    (local.set $slot (i32.const 0))
    (block $ctx_done
      (loop $ctx_loop
        (br_if $ctx_done (i32.ge_u (local.get $slot) (local.get $count)))
        (local.set $entry_abs (call $abs (i32.add (local.get $table)
          (i32.mul (local.get $slot) (i32.const 4)))))
        (local.set $ctx_base (i32.load (local.get $entry_abs)))
        (if (i32.ne (local.get $ctx_base) (i32.const 0))
          (then
            (if (i32.ne
                  (i32.load (call $abs (i32.add (local.get $ctx_base) (global.get $CTX_EXIT_CONDITION))))
                  (global.get $CONTEXT_STATUS_FREE))
              (then (call $gc_update_context (local.get $ctx_base) (local.get $entry_abs)))
              (else (i32.store (local.get $entry_abs) (i32.const 0))))))
        (local.set $slot (i32.add (local.get $slot) (i32.const 1)))
        (br $ctx_loop)))
    ;; (c) intrinsic STATE cells + the ROOT_SCOPE data-pointer tail.
    (local.set $i (i32.const 0))
    (block $intr_done
      (loop $intr_loop
        (br_if $intr_done (i32.ge_u (local.get $i) (global.get $gc_intrinsic_count)))
        (local.set $cell (i32.load (i32.add (global.get $gc_intrinsic_cells)
          (i32.mul (local.get $i) (i32.const 4)))))
        (local.set $old (call $read_state (local.get $cell)))
        (if (i32.ne (local.get $old) (i32.const 0))
          (then
            (local.set $new (call $gc_new_header (local.get $old)))
            (if (i32.ne (local.get $new) (local.get $old))
              (then (call $write_state (local.get $cell) (local.get $new))))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $intr_loop)))
    (local.set $old (call $read_state (global.get $STATE_ROOT_SCOPE)))
    (if (i32.ne (local.get $old) (i32.const 0))
      (then
        (local.set $new (call $gc_new_data (local.get $old)))
        (if (i32.ne (local.get $new) (local.get $old))
          (then
            (call $write_state (global.get $STATE_ROOT_SCOPE) (local.get $new))
            (call $header_event_ring_write
              (global.get $HEADER_EVENT_KIND_FIELD_WRITE)
              (global.get $HEADER_EVENT_FIELD_ROOT_SCOPE)
              (global.get $HEADER_EVENT_SITE_WAT_GC_UPDATE_POINTERS)
              (i32.const 0xFF)
              (local.get $old) (local.get $new))))))
    ;; The context-table cell holds a DATA pointer — same forwarding rule
    ;; as ROOT_SCOPE. Runs AFTER (b): the per-slot entry writes there
    ;; resolve the table through this cell and need the OLD address.
    (local.set $old (call $read_state (global.get $STATE_CONTEXT_TABLE_POINTER)))
    (local.set $new (call $gc_new_data (local.get $old)))
    (if (i32.ne (local.get $new) (local.get $old))
      (then
        (call $write_state (global.get $STATE_CONTEXT_TABLE_POINTER) (local.get $new))
        (call $header_event_ring_write
          (global.get $HEADER_EVENT_KIND_FIELD_WRITE)
          (global.get $HEADER_EVENT_FIELD_CONTEXT_TABLE_POINTER)
          (global.get $HEADER_EVENT_SITE_WAT_GC_UPDATE_POINTERS)
          (i32.const 0xFF)
          (local.get $old) (local.get $new))))
    (local.set $old
      (call $read_state
        (global.get $STATE_CONTEXT_GENERATION_TABLE_POINTER)))
    (local.set $new (call $gc_new_data (local.get $old)))
    (if (i32.ne (local.get $new) (local.get $old))
      (then
        (call $write_state
          (global.get $STATE_CONTEXT_GENERATION_TABLE_POINTER)
          (local.get $new))))
    ;; (d) code-block heap operands.
    (local.set $code_start (call $read_state (global.get $STATE_CODE_BLOCK)))
    (local.set $count (i32.load (call $abs (local.get $code_start))))
    (local.set $i (i32.const 0))
    (block $code_done
      (loop $code_loop
        (br_if $code_done (i32.ge_u (local.get $i) (local.get $count)))
        (local.set $instr_abs (call $abs (i32.sub (local.get $code_start)
          (i32.mul (i32.add (local.get $i) (i32.const 1)) (global.get $INSTRUCTION_SIZE)))))
        (if (i32.eq
              (i32.load8_u (i32.add (global.get $gc_operand_kinds)
                (i32.load8_u (local.get $instr_abs))))
              (i32.const 4))  ;; OPERAND_KIND.HEAP_POINTER
          (then (call $gc_forward_header_field (i32.add (local.get $instr_abs) (i32.const 8)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $code_loop)))
  )

  ;; Mirror of moveObjects: ascending memmove; clear mark + zero
  ;; forwarding at the NEW location; heap-pointer commit.
  (func $gc_move_objects
    (local $read i32)
    (local $word i32)
    (local $size i32)
    (local $new i32)
    (local $new_hp i32)
    (local $new_abs i32)
    (local $old_hp i32)
    (local.set $old_hp (global.get $gc_heap_end))
    (local.set $read (global.get $gc_heap_start))
    (local.set $new_hp (global.get $gc_heap_start))
    (block $done
      (loop $loop
        (br_if $done (i32.ge_u (local.get $read) (global.get $gc_heap_end)))
        (local.set $word (i32.load (call $abs (local.get $read))))
        (local.set $size (call $gc_object_size (local.get $read) (local.get $word)))
        (if (i32.or (i32.eqz (local.get $size))
              (i32.gt_u (local.get $size)
                (i32.sub (global.get $gc_heap_end) (local.get $read))))
          (then (call $gc_fail (global.get $GC_ERR_HEAP_HEADER) (local.get $read))))
        (if (i32.and (local.get $word) (i32.const 0x80000000))
          (then
            (local.set $new (i32.load (i32.add (call $abs (local.get $read)) (i32.const 4))))
            (if (i32.ne (local.get $new) (local.get $read))
              (then
                ;; A corrupt size or forwarding target must never copy
                ;; outside the segment (GC_ERR_COPY_RANGE).
                (if (i64.gt_u
                      (i64.add (i64.extend_i32_u (local.get $read)) (i64.extend_i32_u (local.get $size)))
                      (i64.extend_i32_u (global.get $gc_heap_end)))
                  (then (call $gc_fail (global.get $GC_ERR_COPY_RANGE) (local.get $read))))
                (if (i64.gt_u
                      (i64.add (i64.extend_i32_u (local.get $new)) (i64.extend_i32_u (local.get $size)))
                      (i64.extend_i32_u (global.get $gc_heap_end)))
                  (then (call $gc_fail (global.get $GC_ERR_COPY_RANGE) (local.get $new))))
                (memory.copy (call $abs (local.get $new))
                  (call $abs (local.get $read)) (local.get $size))))
            ;; Clear mark + forwarding at the new location.
            (local.set $new_abs (call $abs (local.get $new)))
            (i32.store (local.get $new_abs)
              (i32.and (i32.load (local.get $new_abs)) (i32.const 0x7fffffff)))
            (i32.store (i32.add (local.get $new_abs) (i32.const 4)) (i32.const 0))
            (local.set $new_hp (i32.add (local.get $new) (local.get $size)))))
        (local.set $read (i32.add (local.get $read) (local.get $size)))
        (br $loop)))
    (call $write_state (global.get $STATE_HEAP_POINTER) (local.get $new_hp))
    (if (i32.ne (local.get $new_hp) (local.get $old_hp))
      (then
        (call $header_event_ring_write
          (global.get $HEADER_EVENT_KIND_FIELD_WRITE)
          (global.get $HEADER_EVENT_FIELD_HEAP_POINTER)
          (global.get $HEADER_EVENT_SITE_WAT_GC_MOVE_OBJECTS)
          (i32.const 0xFF)
          (local.get $old_hp) (local.get $new_hp))))
    (global.set $gc_heap_end (local.get $new_hp))
  )

  ;; ==========================================================================
  ;; STRING COMPACTION (phase 5) — mirrors of the compactStrings family.
  ;; The forwarding table (scratch block): 1 u32 per 4 bytes of string
  ;; data. 0xFFFFFFFF = absent (live, unmoved), 0 = dead, else new id.
  ;; ==========================================================================

  (func $gc_string_id_abs (param $id i32) (result i32)
    (call $abs (i32.add (global.get $string_start) (local.get $id)))
  )

  ;; forwarding.get(id): 0xFFFFFFFF when the id has no table slot.
  (func $gc_string_forward_lookup (param $id i32) (result i32)
    (local $idx i32)
    (if (i32.lt_u (local.get $id) (global.get $gc_string_data_start))
      (then (return (i32.const 0xFFFFFFFF))))
    (local.set $idx (i32.shr_u
      (i32.sub (local.get $id) (global.get $gc_string_data_start)) (i32.const 2)))
    (if (i32.ge_u (local.get $idx) (global.get $gc_string_forwarding_entries))
      (then (return (i32.const 0xFFFFFFFF))))
    (i32.load (i32.add (global.get $gc_string_forwarding)
      (i32.mul (local.get $idx) (i32.const 4))))
  )

  ;; THE string-rewrite skip rule (parity invariant 7): rewrite only
  ;; when the forwarding target exists, is non-zero, AND differs. Dead
  ;; ids are left in place, never zeroed.
  (func $gc_forward_string_field (param $field_abs i32)
    (local $old i32)
    (local $new i32)
    (call $gc_check_abs (local.get $field_abs) (i32.const 4))
    (local.set $old (i32.load (local.get $field_abs)))
    (local.set $new (call $gc_string_forward_lookup (local.get $old)))
    (if (i32.eq (local.get $new) (i32.const 0xFFFFFFFF)) (then (return)))
    (if (i32.eqz (local.get $new)) (then (return)))
    (if (i32.eq (local.get $new) (local.get $old)) (then (return)))
    (i32.store (local.get $field_abs) (local.get $new))
  )

  ;; Mirror of updateValueStringOffset: STRING data_lo, BOUND_METHOD
  ;; string receivers, EXTERNAL_METHOD's data_hi method name.
  (func $gc_update_value_string (param $value_addr i32)
    (local $abs i32)
    (local $type i32)
    (local.set $abs (call $abs (local.get $value_addr)))
    (call $gc_check_abs (local.get $abs) (global.get $VALUE_SIZE))
    (local.set $type (i32.load (local.get $abs)))
    (if (i32.eq (local.get $type) (global.get $TYPE_STRING))
      (then
        (call $gc_forward_string_field (i32.add (local.get $abs) (i32.const 8)))
        (return)))
    (if (i32.eq (local.get $type) (global.get $TYPE_BOUND_METHOD))
      (then
        (if (i32.eq
              (i32.and (i32.load (i32.add (local.get $abs) (i32.const 4))) (i32.const 0xff))
              (global.get $TYPE_STRING))
          (then (call $gc_forward_string_field (i32.add (local.get $abs) (i32.const 8)))))
        (return)))
    (if (i32.eq (local.get $type) (global.get $TYPE_EXTERNAL_METHOD))
      (then
        (call $gc_forward_string_field (i32.add (local.get $abs) (i32.const 12)))
        (return)))
  )

  ;; Is a string id marked live? (ids below the data start read as
  ;; live; out-of-bitmap ids read as dead — exact isStringMarked.)
  (func $gc_is_string_marked (param $id i32) (result i32)
    (local $bit i32)
    (local $byte i32)
    (if (i32.eqz (local.get $id)) (then (return (i32.const 1))))
    (if (i32.lt_u (local.get $id) (global.get $gc_string_data_start))
      (then (return (i32.const 1))))
    (local.set $bit (i32.shr_u (i32.sub (local.get $id) (global.get $gc_string_data_start)) (i32.const 2)))
    (local.set $byte (i32.shr_u (local.get $bit) (i32.const 3)))
    (if (i32.ge_u (local.get $byte) (global.get $gc_string_bitmap_size))
      (then (return (i32.const 0))))
    (i32.ne
      (i32.and
        (i32.load8_u (i32.add (global.get $gc_string_bitmap) (local.get $byte)))
        (i32.shl (i32.const 1) (i32.and (local.get $bit) (i32.const 7))))
      (i32.const 0))
  )

  ;; Mirror of computeStringForwarding. Returns the number of table
  ;; writes — 0 means nothing dead and nothing moving (the JS
  ;; forwarding.size === 0 early-return condition).
  (func $gc_compute_string_forwarding (result i32)
    (local $end i32)
    (local $read i32)
    (local $write i32)
    (local $len i32)
    (local $aligned i32)
    (local $writes i32)
    (local $idx i32)
    (local.set $end (i32.sub
      (call $read_state (global.get $STATE_STRING_POINTER))
      (global.get $string_start)))
    (local.set $read (global.get $gc_string_data_start))
    (local.set $write (global.get $gc_string_data_start))
    (local.set $writes (i32.const 0))
    (block $done
      (loop $loop
        (br_if $done (i32.ge_u (local.get $read) (local.get $end)))
        (local.set $len (i32.load (call $gc_string_id_abs (local.get $read))))
        (local.set $aligned (i32.and
          (i32.add (i32.add (local.get $len) (i32.const 4)) (i32.const 3))
          (i32.const -4)))
        (local.set $idx (i32.shr_u
          (i32.sub (local.get $read) (global.get $gc_string_data_start)) (i32.const 2)))
        (if (call $gc_is_string_marked (local.get $read))
          (then
            (if (i32.ne (local.get $read) (local.get $write))
              (then
                (i32.store (i32.add (global.get $gc_string_forwarding)
                  (i32.mul (local.get $idx) (i32.const 4))) (local.get $write))
                (local.set $writes (i32.add (local.get $writes) (i32.const 1)))))
            (local.set $write (i32.add (local.get $write) (local.get $aligned))))
          (else
            (i32.store (i32.add (global.get $gc_string_forwarding)
              (i32.mul (local.get $idx) (i32.const 4))) (i32.const 0))
            (local.set $writes (i32.add (local.get $writes) (i32.const 1)))))
        (local.set $read (i32.add (local.get $read) (local.get $aligned)))
        (br $loop)))
    (local.get $writes)
  )

  ;; Mirror of updateObjectStringOffsets: per-type string-id rewrites,
  ;; walked over the COMPACTED heap.
  (func $gc_update_object_strings (param $header i32)
    (local $word i32)
    (local $obj_type i32)
    (local $data i32)
    (local $abs i32)
    (local $count i32)
    (local $block i32)
    (local $entry i32)
    (local $i i32)
    (local.set $word (i32.load (call $abs (local.get $header))))
    (local.set $obj_type (i32.and (i32.shr_u (local.get $word) (i32.const 24)) (i32.const 0x7f)))
    (local.set $data (i32.add (local.get $header) (global.get $GC_HEADER_SIZE)))
    (local.set $abs (call $abs (local.get $data)))

    (if (i32.eq (local.get $obj_type) (global.get $OBJ_ARRAY))
      (then
        ;; Elements (post-move data_ptr), then sym-entry values.
        (local.set $count (i32.load (local.get $abs)))
        (local.set $block (i32.load (i32.add (local.get $abs) (i32.const 8))))
        (if (i32.ne (local.get $block) (i32.const 0))
          (then
            (local.set $entry (i32.add (local.get $block) (global.get $GC_HEADER_SIZE)))
            (local.set $i (i32.const 0))
            (block $arr_done
              (loop $arr_loop
                (br_if $arr_done (i32.ge_u (local.get $i) (local.get $count)))
                (call $gc_update_value_string (i32.add (local.get $entry)
                  (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
                (local.set $i (i32.add (local.get $i) (i32.const 1)))
                (br $arr_loop)))))
        (call $gc_update_sym_entry_strings (i32.add (local.get $data) (i32.const 16)))
        (return)))

    (if (i32.or
          (i32.eq (local.get $obj_type) (global.get $OBJ_OBJECT))
          (i32.eq (local.get $obj_type) (global.get $OBJ_FUNCTION)))
      (then
        ;; Sym-entry values first (JS order), then keyed entries.
        (call $gc_update_sym_entry_strings (i32.add (local.get $data) (i32.const 20)))
        (local.set $count (i32.load (i32.add (local.get $abs) (i32.const 4))))
        (local.set $block (i32.load (i32.add (local.get $abs) (i32.const 16))))
        (if (i32.ne (local.get $block) (i32.const 0))
          (then
            (local.set $entry (i32.add (local.get $block) (global.get $GC_HEADER_SIZE)))
            (local.set $i (i32.const 0))
            (block $obj_done
              (loop $obj_loop
                (br_if $obj_done (i32.ge_u (local.get $i) (local.get $count)))
                (call $gc_forward_string_field (call $abs (local.get $entry)))
                (call $gc_update_value_string (i32.add (local.get $entry) (i32.const 4)))
                (local.set $entry (i32.add (local.get $entry) (i32.const 20)))
                (local.set $i (i32.add (local.get $i) (i32.const 1)))
                (br $obj_loop)))))
        (return)))

    (if (i32.eq (local.get $obj_type) (global.get $OBJ_SCOPE))
      (then
        (local.set $count (i32.load (i32.add (local.get $abs) (i32.const 4))))
        (local.set $block (i32.load (i32.add (local.get $abs) (i32.const 12))))
        (if (i32.eqz (local.get $block)) (then (return)))
        ;; Bounds-skip mirrors updateScopeStringOffsets' sanity check.
        (if (i32.lt_u (local.get $block) (global.get $gc_heap_start)) (then (return)))
        (if (i32.ge_u (local.get $block) (global.get $gc_heap_end)) (then (return)))
        (local.set $entry (i32.add (local.get $block) (global.get $GC_HEADER_SIZE)))
        (local.set $i (i32.const 0))
        (block $scope_done
          (loop $scope_loop
            (br_if $scope_done (i32.ge_u (local.get $i) (local.get $count)))
            (call $gc_forward_string_field (call $abs (local.get $entry)))
            (call $gc_update_value_string (i32.add (local.get $entry) (i32.const 4)))
            (local.set $entry (i32.add (local.get $entry) (i32.const 20)))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $scope_loop)))
        (return)))

    (if (i32.eq (local.get $obj_type) (global.get $OBJ_PARAM_LIST))
      (then
        (local.set $count (i32.load (local.get $abs)))
        (local.set $i (i32.const 0))
        (block $pl_done
          (loop $pl_loop
            (br_if $pl_done (i32.ge_u (local.get $i) (local.get $count)))
            (call $gc_forward_string_field (i32.add
              (i32.add (local.get $abs) (i32.const 4))
              (i32.mul (local.get $i) (i32.const 4))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $pl_loop)))
        (return)))

    (if (i32.eq (local.get $obj_type) (global.get $OBJ_TYPED_ARRAY_DESCRIPTOR))
      (then
        (call $gc_update_sym_entry_strings (i32.add (local.get $data) (i32.const 12)))
        (return)))

    (if (i32.eq (local.get $obj_type) (global.get $OBJ_SYMBOL))
      (then
        (call $gc_forward_string_field (local.get $abs))
        (return)))

    (if (i32.eq (local.get $obj_type) (global.get $OBJ_REGEXP))
      (then
        ;; [patternStringOffset:4] at data+0 — an interned-string id;
        ;; forward it like any other string reference (mirror of the
        ;; mark-phase OBJ_REGEXP case).
        (call $gc_forward_string_field (local.get $abs))
        (return)))
    (if (i32.eq (local.get $obj_type) (global.get $OBJ_SCHEMA))
      (then
        ;; the source value slot is traced like an array element
        (call $gc_update_value_string (i32.add (local.get $data) (global.get $SCHEMA_SOURCE)))
        (return)))

    (if (i32.or
          (i32.eq (local.get $obj_type) (global.get $OBJ_MAP))
          (i32.eq (local.get $obj_type) (global.get $OBJ_SET)))
      (then
        (local.set $count (i32.load (i32.add (local.get $abs) (i32.const 4))))
        (local.set $block (i32.load (i32.add (local.get $abs) (i32.const 12))))
        (if (i32.ne (local.get $block) (i32.const 0))
          (then
            (local.set $entry (i32.add (local.get $block) (global.get $GC_HEADER_SIZE)))
            (local.set $i (i32.const 0))
            (if (i32.eq (local.get $obj_type) (global.get $OBJ_MAP))
              (then
                (block $map_done
                  (loop $map_loop
                    (br_if $map_done (i32.ge_u (local.get $i) (local.get $count)))
                    (call $gc_update_value_string (i32.add (local.get $entry) (i32.const 4)))
                    (call $gc_update_value_string (i32.add (local.get $entry) (i32.const 20)))
                    (local.set $entry (i32.add (local.get $entry) (i32.const 36)))
                    (local.set $i (i32.add (local.get $i) (i32.const 1)))
                    (br $map_loop))))
              (else
                (block $set_done
                  (loop $set_loop
                    (br_if $set_done (i32.ge_u (local.get $i) (local.get $count)))
                    (call $gc_update_value_string (i32.add (local.get $entry) (i32.const 4)))
                    (local.set $entry (i32.add (local.get $entry) (i32.const 20)))
                    (local.set $i (i32.add (local.get $i) (i32.const 1)))
                    (br $set_loop)))))))
        (call $gc_update_sym_entry_strings (i32.add (local.get $data) (i32.const 16)))
        (return)))

    (if (i32.eq (local.get $obj_type) (global.get $OBJ_PROMISE))
      (then
        (call $gc_update_value_string (i32.add (local.get $data) (global.get $PROMISE_VALUE)))
        (return)))
  )

  ;; Mirror of updateSymEntriesStringOffsets (values only; keys are
  ;; symbol pointers).
  (func $gc_update_sym_entry_strings (param $slot_addr i32)
    (local $header i32)
    (local $data i32)
    (local $count i32)
    (local $entry i32)
    (local $i i32)
    (local.set $header (i32.load (call $abs (local.get $slot_addr))))
    (if (i32.eqz (local.get $header)) (then (return)))
    (local.set $data (i32.add (local.get $header) (global.get $GC_HEADER_SIZE)))
    (local.set $count (i32.load (call $abs (local.get $data))))
    (local.set $entry (i32.add (local.get $data) (i32.const 8)))
    (local.set $i (i32.const 0))
    (block $done
      (loop $loop
        (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
        (call $gc_update_value_string (i32.add (local.get $entry) (i32.const 4)))
        (local.set $entry (i32.add (local.get $entry) (i32.const 20)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $loop)))
  )

  ;; The collector's builtins-slot writer (allowlisted — see
  ;; verify-region-write-discipline).
  (func $gc_update_builtin_strings
    (local $offset i32)
    (local.set $offset (i32.const 0))
    (block $done
      (loop $loop
        (br_if $done (i32.ge_u (local.get $offset) (global.get $BUILTINS_SIZE)))
        (if (i32.ne (call $read_builtin (local.get $offset)) (i32.const 0))
          (then (call $gc_forward_string_field
            (call $abs (i32.add (global.get $builtins_base) (local.get $offset))))))
        (local.set $offset (i32.add (local.get $offset) (i32.const 4)))
        (br $loop)))
  )

  ;; Mirror of moveStrings: ascending copy of marked entries; string
  ;; bump-pointer commit.
  (func $gc_move_strings
    (local $end i32)
    (local $read i32)
    (local $len i32)
    (local $aligned i32)
    (local $target i32)
    (local $fwd i32)
    (local $new_write i32)
    (local.set $end (i32.sub
      (call $read_state (global.get $STATE_STRING_POINTER))
      (global.get $string_start)))
    (local.set $read (global.get $gc_string_data_start))
    (local.set $new_write (global.get $gc_string_data_start))
    (block $done
      (loop $loop
        (br_if $done (i32.ge_u (local.get $read) (local.get $end)))
        (local.set $len (i32.load (call $gc_string_id_abs (local.get $read))))
        (local.set $aligned (i32.and
          (i32.add (i32.add (local.get $len) (i32.const 4)) (i32.const 3))
          (i32.const -4)))
        (if (call $gc_is_string_marked (local.get $read))
          (then
            (local.set $fwd (call $gc_string_forward_lookup (local.get $read)))
            (local.set $target (local.get $read))
            (if (i32.and
                  (i32.ne (local.get $fwd) (i32.const 0xFFFFFFFF))
                  (i32.ne (local.get $fwd) (i32.const 0)))
              (then (local.set $target (local.get $fwd))))
            (if (i32.ne (local.get $target) (local.get $read))
              (then
                ;; A corrupt length must never copy outside the segment.
                (call $gc_check_abs
                  (call $gc_string_id_abs (local.get $read)) (local.get $aligned))
                (call $gc_check_abs
                  (call $gc_string_id_abs (local.get $target)) (local.get $aligned))
                (memory.copy
                  (call $gc_string_id_abs (local.get $target))
                  (call $gc_string_id_abs (local.get $read))
                  (local.get $aligned))))
            (local.set $new_write (i32.add (local.get $target) (local.get $aligned)))))
        (local.set $read (i32.add (local.get $read) (local.get $aligned)))
        (br $loop)))
    (call $write_state (global.get $STATE_STRING_POINTER)
      (i32.add (global.get $string_start) (local.get $new_write)))
  )

  ;; Mirror of rebuildHashTable: clear, re-insert ascending, FNV-1a,
  ;; mod-bucket, ascending linear probe.
  (func $gc_rebuild_hash_table
    (local $end i32)
    (local $id i32)
    (local $len i32)
    (local $aligned i32)
    (local $hash i32)
    (local $bucket i32)
    (local $probe i32)
    (local $bucket_abs i32)
    (local $byte_abs i32)
    (local $i i32)
    (local $table_abs i32)
    (local.set $table_abs (call $abs (global.get $hash_table_start_seg)))
    (memory.fill (local.get $table_abs) (i32.const 0)
      (global.get $hash_table_size))
    (local.set $end (i32.sub
      (call $read_state (global.get $STATE_STRING_POINTER))
      (global.get $string_start)))
    (local.set $id (global.get $gc_string_data_start))
    (block $walk_done
      (loop $walk
        (br_if $walk_done (i32.ge_u (local.get $id) (local.get $end)))
        (local.set $len (i32.load (call $gc_string_id_abs (local.get $id))))
        (local.set $aligned (i32.and
          (i32.add (i32.add (local.get $len) (i32.const 4)) (i32.const 3))
          (i32.const -4)))
        ;; FNV-1a over the entry's bytes.
        (local.set $hash (global.get $FNV_OFFSET_BASIS))
        (local.set $byte_abs (i32.add (call $gc_string_id_abs (local.get $id)) (i32.const 4)))
        (local.set $i (i32.const 0))
        (block $hash_done
          (loop $hash_loop
            (br_if $hash_done (i32.ge_u (local.get $i) (local.get $len)))
            (local.set $hash (i32.mul
              (i32.xor (local.get $hash)
                (i32.load8_u (i32.add (local.get $byte_abs) (local.get $i))))
              (global.get $FNV_PRIME)))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $hash_loop)))
        ;; Insert with ascending linear probing. Exhausting every
        ;; bucket is proven-impossible (index sized past the data
        ;; span's max entry count) — the pre-fix loop completed
        ;; silently and LEFT the entry out of the index, breaking
        ;; dedup for every string past the bucket count. Trap instead.
        ;; A bucket is free iff its OFFSET column is 0 (valid ids are
        ;; >= STRING_DATA_START > 0) — the hash column is 0 for a
        ;; legit string whose FNV-1a hash is 0, so testing the hash
        ;; column (as the pre-fix code did) could overwrite a live
        ;; bucket.
        (local.set $bucket (i32.rem_u (local.get $hash) (global.get $hash_table_buckets)))
        (local.set $probe (i32.const 0))
        (block $ins_done
          (loop $ins_loop
            (if (i32.ge_u (local.get $probe) (global.get $hash_table_buckets))
              (then (unreachable)))
            (local.set $bucket_abs (i32.add (local.get $table_abs)
              (i32.mul (local.get $bucket) (i32.const 8))))
            (if (i32.eqz (i32.load (i32.add (local.get $bucket_abs) (i32.const 4))))
              (then
                (i32.store (local.get $bucket_abs) (local.get $hash))
                (i32.store (i32.add (local.get $bucket_abs) (i32.const 4)) (local.get $id))
                (br $ins_done)))
            (local.set $bucket (i32.rem_u
              (i32.add (local.get $bucket) (i32.const 1))
              (global.get $hash_table_buckets)))
            (local.set $probe (i32.add (local.get $probe) (i32.const 1)))
            (br $ins_loop)))
        (local.set $id (i32.add (local.get $id) (local.get $aligned)))
        (br $walk)))
  )

  ;; Mirror of compactStrings: forwarding table, early return when
  ;; nothing changes, all string-id rewrites, move, hash rebuild.
  (func $gc_compact_strings
    (local $hp i32)
    (local $word i32)
    (local $size i32)
    (local $count i32)
    (local $table i32)
    (local $slot i32)
    (local $ctx_base i32)
    (local $ctx_abs i32)
    (local $addr i32)
    (local $limit i32)
    (local $exit i32)
    (local $req_abs i32)
    (local $code_start i32)
    (local $i i32)
    (local $instr_abs i32)

    ;; Fill the forwarding table with the absent sentinel, then compute.
    (memory.fill (global.get $gc_string_forwarding) (i32.const 0xFF)
      (i32.mul (global.get $gc_string_forwarding_entries) (i32.const 4)))
    (if (i32.eqz (call $gc_compute_string_forwarding))
      (then (return)))

    ;; Heap walk over the COMPACTED heap.
    (local.set $hp (global.get $gc_heap_start))
    (block $walk_done
      (loop $walk
        (br_if $walk_done (i32.ge_u (local.get $hp) (global.get $gc_heap_end)))
        (local.set $word (i32.load (call $abs (local.get $hp))))
        (local.set $size (call $gc_object_size (local.get $hp) (local.get $word)))
        (if (i32.or (i32.eqz (local.get $size))
              (i32.gt_u (local.get $size)
                (i32.sub (global.get $gc_heap_end) (local.get $hp))))
          (then (call $gc_fail (global.get $GC_ERR_HEAP_HEADER) (local.get $hp))))
        (call $gc_update_object_strings (local.get $hp))
        (local.set $hp (i32.add (local.get $hp) (local.get $size)))
        (br $walk)))

    ;; Contexts: pending values, grant identifiers, request-base
    ;; methodOffset + args, completion value.
    (local.set $count (call $read_state (global.get $STATE_CONTEXT_COUNT)))
    (local.set $table (call $read_state (global.get $STATE_CONTEXT_TABLE_POINTER)))
    (local.set $slot (i32.const 0))
    (block $ctx_done
      (loop $ctx_loop
        (br_if $ctx_done (i32.ge_u (local.get $slot) (local.get $count)))
        (local.set $ctx_base (i32.load (call $abs (i32.add (local.get $table)
          (i32.mul (local.get $slot) (i32.const 4))))))
        (if (i32.and (i32.ne (local.get $ctx_base) (i32.const 0))
              (i32.ne
                (i32.load (call $abs (i32.add (local.get $ctx_base) (global.get $CTX_EXIT_CONDITION))))
                (global.get $CONTEXT_STATUS_FREE)))
          (then
            (local.set $ctx_abs (call $abs (local.get $ctx_base)))
            ;; Pending stack.
            (local.set $addr (i32.load (i32.add (local.get $ctx_abs) (global.get $CTX_PENDING_BASE))))
            (local.set $limit (i32.load (i32.add (local.get $ctx_abs) (global.get $CTX_PENDING_POINTER))))
            (block $pend_done
              (loop $pend_loop
                (br_if $pend_done (i32.ge_u (local.get $addr) (local.get $limit)))
                (call $gc_update_value_string (local.get $addr))
                (local.set $addr (i32.add (local.get $addr) (global.get $VALUE_SIZE)))
                (br $pend_loop)))
            ;; Grant stack identifiers.
            (local.set $addr (i32.load (i32.add (local.get $ctx_abs) (global.get $CTX_GRANT_STACK_BASE))))
            (local.set $limit (i32.load (i32.add (local.get $ctx_abs) (global.get $CTX_GRANT_STACK_POINTER))))
            (block $grant_done
              (loop $grant_loop
                (br_if $grant_done (i32.ge_u (local.get $addr) (local.get $limit)))
                (call $gc_update_value_string (local.get $addr))
                (local.set $addr (i32.add (local.get $addr) (global.get $GRANT_ENTRY_SIZE)))
                (br $grant_loop)))
            ;; Request base (external exits only).
            (local.set $exit (i32.load (i32.add (local.get $ctx_abs) (global.get $CTX_EXIT_CONDITION))))
            (if (i32.or (i32.or
                  (i32.eq (local.get $exit) (global.get $EXIT_EXTERNAL_CALL))
                  (i32.eq (local.get $exit) (global.get $EXIT_EXTERNAL_PROPERTY)))
                  (i32.eq (local.get $exit) (global.get $EXIT_EXTERNAL_PROPERTY_SET)))
              (then
                (local.set $req_abs (call $abs
                  (i32.add (local.get $ctx_base) (global.get $CTX_REQUEST_BLOCK))))
                (if (i32.ne (i32.load (i32.add (local.get $req_abs) (i32.const 4))) (i32.const 0))
                  (then (call $gc_forward_string_field
                    (i32.add (local.get $req_abs) (i32.const 4)))))
                (local.set $addr (i32.load (i32.add (local.get $req_abs) (i32.const 8))))
                (local.set $limit (i32.add (local.get $addr)
                  (i32.mul (i32.load (i32.add (local.get $req_abs) (i32.const 12)))
                    (global.get $VALUE_SIZE))))
                (block $req_done
                  (loop $req_loop
                    (br_if $req_done (i32.ge_u (local.get $addr) (local.get $limit)))
                    (call $gc_update_value_string (local.get $addr))
                    (local.set $addr (i32.add (local.get $addr) (global.get $VALUE_SIZE)))
                    (br $req_loop)))))
            ;; Completion value.
            (if (i32.and
                  (i32.ne (i32.load (i32.add (local.get $ctx_abs) (global.get $CTX_COMPLETION_TYPE))) (i32.const 0))
                  (i32.ne (i32.load (i32.add (local.get $ctx_abs) (global.get $CTX_COMPLETION_VALUE))) (i32.const 0)))
              (then (call $gc_update_value_string
                (i32.load (i32.add (local.get $ctx_abs) (global.get $CTX_COMPLETION_VALUE))))))
            ;; v11: try-entry pending completion values.
            (local.set $addr (i32.load (i32.add (local.get $ctx_abs) (global.get $CTX_TRY_STACK_BASE))))
            (local.set $limit (i32.load (i32.add (local.get $ctx_abs) (global.get $CTX_TRY_STACK_POINTER))))
            (block $try_str_done
              (loop $try_str_loop
                (br_if $try_str_done (i32.ge_u (local.get $addr) (local.get $limit)))
                (local.set $exit (i32.load (call $abs
                  (i32.add (local.get $addr) (global.get $TRY_COMPLETION_TYPE)))))
                (if (i32.or
                      (i32.eq (local.get $exit) (global.get $COMPLETION_THROW))
                      (i32.eq (local.get $exit) (global.get $COMPLETION_RETURN)))
                  (then (call $gc_update_value_string
                    (i32.add (local.get $addr) (global.get $TRY_COMPLETION_VALUE)))))
                (local.set $addr (i32.add (local.get $addr) (global.get $TRY_ENTRY_SIZE)))
                (br $try_str_loop)))))
        (local.set $slot (i32.add (local.get $slot) (i32.const 1)))
        (br $ctx_loop)))

    ;; Code-block string operands.
    (local.set $code_start (call $read_state (global.get $STATE_CODE_BLOCK)))
    (local.set $count (i32.load (call $abs (local.get $code_start))))
    (local.set $i (i32.const 0))
    (block $code_done
      (loop $code_loop
        (br_if $code_done (i32.ge_u (local.get $i) (local.get $count)))
        (local.set $instr_abs (call $abs (i32.sub (local.get $code_start)
          (i32.mul (i32.add (local.get $i) (i32.const 1)) (global.get $INSTRUCTION_SIZE)))))
        (if (i32.eq
              (i32.load8_u (i32.add (global.get $gc_operand_kinds)
                (i32.load8_u (local.get $instr_abs))))
              (i32.const 3))  ;; OPERAND_KIND.STRING_OFFSET
          (then
            (if (i32.ne (i32.load (i32.add (local.get $instr_abs) (i32.const 8))) (i32.const 0))
              (then (call $gc_forward_string_field
                (i32.add (local.get $instr_abs) (i32.const 8)))))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $code_loop)))

    ;; Builtins region, then AST fields (BEFORE moving string bytes).
    (call $gc_update_builtin_strings)
    (memory.fill (global.get $gc_ast_visited) (i32.const 0) (global.get $gc_ast_visited_size))
    (call $gc_walk_ast_strings (i32.const 1))

    ;; Move + hash rebuild.
    (call $gc_move_strings)
    (global.set $gc_phase (global.get $GC_PHASE_HASH_REBUILD))
    (call $gc_rebuild_hash_table)
  )

  ;; ==========================================================================
  ;; gc_collect(scratch_ptr, mode) → status
  ;;
  ;; scratch_ptr: ABSOLUTE address of the GC scratch block (outside any
  ;; vat segment, gc-scratch-layout.js interior). mode 1 = mark-only
  ;; (phase 1 + handle bitmap; marks left set — collectLiveHandleSlots
  ;; parity). mode 0 = full collection (NOT IMPLEMENTED YET — traps).
  ;; Returns 0 on success; detected failures stamp error info and trap.
  ;; ==========================================================================
  (func $gc_collect (export "gc_collect") (param $scratch_ptr i32) (param $mode i32) (result i32)
    (local $mem_bytes i32)
    (local $header i32)
    (local $capacity i32)
    (local.set $mem_bytes (i32.mul (memory.size) (i32.const 65536)))
    (global.set $gc_phase (global.get $GC_PHASE_MARK))

    ;; Entry validation: the header itself, then each section end.
    (if (i32.gt_u (i32.add (local.get $scratch_ptr) (i32.const 64)) (local.get $mem_bytes))
      (then (call $gc_fail (global.get $GC_ERR_SEGMENT_BOUNDS) (local.get $scratch_ptr))))
    (local.set $header (local.get $scratch_ptr))

    (global.set $gc_operand_kinds (i32.add (local.get $scratch_ptr)
      (i32.load (i32.add (local.get $header) (global.get $GC_SCRATCH_OPERAND_KINDS_OFFSET)))))
    (global.set $gc_intrinsic_cells (i32.add (local.get $scratch_ptr)
      (i32.load (i32.add (local.get $header) (global.get $GC_SCRATCH_INTRINSIC_CELLS_OFFSET)))))
    (global.set $gc_intrinsic_count
      (i32.load (i32.add (local.get $header) (global.get $GC_SCRATCH_INTRINSIC_CELL_COUNT))))
    (global.set $gc_ast_layout (i32.add (local.get $scratch_ptr)
      (i32.load (i32.add (local.get $header) (global.get $GC_SCRATCH_AST_LAYOUT_OFFSET)))))
    (global.set $gc_ast_tag_capacity
      (i32.load (i32.add (local.get $header) (global.get $GC_SCRATCH_AST_LAYOUT_TAG_CAPACITY))))
    (global.set $gc_string_bitmap (i32.add (local.get $scratch_ptr)
      (i32.load (i32.add (local.get $header) (global.get $GC_SCRATCH_STRING_MARK_BITMAP_OFFSET)))))
    (global.set $gc_string_bitmap_size
      (i32.load (i32.add (local.get $header) (global.get $GC_SCRATCH_STRING_MARK_BITMAP_SIZE))))
    (global.set $gc_ast_visited (i32.add (local.get $scratch_ptr)
      (i32.load (i32.add (local.get $header) (global.get $GC_SCRATCH_AST_VISITED_BITMAP_OFFSET)))))
    (global.set $gc_ast_worklist (i32.add (local.get $scratch_ptr)
      (i32.load (i32.add (local.get $header) (global.get $GC_SCRATCH_AST_WORKLIST_OFFSET)))))
    (global.set $gc_ast_worklist_capacity
      (i32.load (i32.add (local.get $header) (global.get $GC_SCRATCH_AST_WORKLIST_CAPACITY))))
    (global.set $gc_handle_bitmap (i32.add (local.get $scratch_ptr)
      (i32.load (i32.add (local.get $header) (global.get $GC_SCRATCH_HANDLE_BITMAP_OFFSET)))))
    (global.set $gc_handle_capacity
      (i32.load (i32.add (local.get $header) (global.get $GC_SCRATCH_HANDLE_BITMAP_CAPACITY))))
    (global.set $gc_root_block (i32.add (local.get $scratch_ptr)
      (i32.load (i32.add (local.get $header) (global.get $GC_SCRATCH_ROOT_BLOCK_OFFSET)))))
    (global.set $gc_root_count
      (i32.load (i32.add (local.get $header) (global.get $GC_SCRATCH_ROOT_COUNT))))
    (global.set $gc_string_forwarding (i32.add (local.get $scratch_ptr)
      (i32.load (i32.add (local.get $header) (global.get $GC_SCRATCH_STRING_FORWARDING_OFFSET)))))
    (global.set $gc_string_forwarding_entries
      (i32.load (i32.add (local.get $header) (global.get $GC_SCRATCH_STRING_FORWARDING_ENTRIES))))
    (global.set $gc_ast_visited_size
      (i32.load (i32.add (local.get $header) (global.get $GC_SCRATCH_AST_VISITED_BITMAP_SIZE))))

    ;; Root block sanity: count within capacity, block within memory.
    (local.set $capacity
      (i32.load (i32.add (local.get $header) (global.get $GC_SCRATCH_ROOT_CAPACITY))))
    (if (i32.gt_u (global.get $gc_root_count) (local.get $capacity))
      (then (call $gc_fail (global.get $GC_ERR_ROOT_BLOCK_RANGE) (global.get $gc_root_count))))
    (if (i32.gt_u
          (i32.add (i32.add (global.get $gc_root_block) (i32.const 4))
            (i32.mul (local.get $capacity) (i32.const 4)))
          (local.get $mem_bytes))
      (then (call $gc_fail (global.get $GC_ERR_SEGMENT_BOUNDS) (global.get $gc_root_block))))
    (if (i32.gt_u (i32.add (global.get $gc_string_bitmap) (global.get $gc_string_bitmap_size))
          (local.get $mem_bytes))
      (then (call $gc_fail (global.get $GC_ERR_SEGMENT_BOUNDS) (global.get $gc_string_bitmap))))
    (if (i32.gt_u
          (i32.add (global.get $gc_handle_bitmap)
            (i32.shr_u (i32.add (global.get $gc_handle_capacity) (i32.const 7)) (i32.const 3)))
          (local.get $mem_bytes))
      (then (call $gc_fail (global.get $GC_ERR_SEGMENT_BOUNDS) (global.get $gc_handle_bitmap))))

    ;; Cache heap bounds, segment bounds, and the first string id.
    (global.set $gc_heap_start (call $read_state (global.get $STATE_HEAP_START)))
    (global.set $gc_heap_end (call $read_state (global.get $STATE_HEAP_POINTER)))
    (global.set $gc_string_data_start (global.get $STRING_DATA_START))
    (global.set $gc_segment_lo (call $abs (i32.const 0)))
    (global.set $gc_segment_hi (call $abs (call $read_state (global.get $STATE_SEGMENT_SIZE))))

    ;; Header-event ring: refresh cached region metadata (not on the
    ;; per-instruction dispatch path, so no need to cache across $run).
    (call $header_event_ring_refresh)

    ;; Phase 1: MARK (same call order as markPhase).
    (call $gc_clear_all_marks)
    (memory.fill (global.get $gc_string_bitmap) (i32.const 0) (global.get $gc_string_bitmap_size))
    (memory.fill (global.get $gc_handle_bitmap) (i32.const 0)
      (i32.shr_u (i32.add (global.get $gc_handle_capacity) (i32.const 7)) (i32.const 3)))
    (call $gc_mark_contexts)
    (call $gc_mark_external_roots)
    (call $gc_mark_code_block)
    (call $gc_mark_builtin_strings)
    (memory.fill (global.get $gc_ast_visited) (i32.const 0) (global.get $gc_ast_visited_size))
    (call $gc_walk_ast_strings (i32.const 0))
    (call $gc_mark_intrinsics)

    (if (i32.eq (local.get $mode) (i32.const 1))
      (then (return (i32.const 0))))

    ;; Header-event ring: a real (non mark-only) collection is
    ;; committed to running to completion from here on ($gc_fail traps
    ;; unreachable, so GC_CYCLE_END below only fires on success).
    ;; oldValue carries the pre-collection HEAP_POINTER so a reader can
    ;; see the live-bytes-before figure without a separate lookup.
    (call $header_event_ring_write
      (global.get $HEADER_EVENT_KIND_GC_CYCLE_START)
      (global.get $HEADER_EVENT_FIELD_NONE)
      (global.get $HEADER_EVENT_SITE_WAT_GC_COLLECT)
      (i32.const 0xFF)
      (global.get $gc_heap_end) (i32.const 0))
    ;; Snapshot which
    ;; context slots are parked at exactly this moment (exit conditions
    ;; are read-only through mark phase, so this reflects the same state
    ;; the mark phase above just walked).
    (call $header_event_ring_write_parked_slots
      (global.get $HEADER_EVENT_SITE_WAT_GC_COLLECT))

    ;; Phase 2: COMPUTE forwarding addresses (slide-down targets into
    ;; the GC-header forwarding words of live objects).
    (global.set $gc_phase (global.get $GC_PHASE_COMPUTE))
    (call $gc_compute_forwarding)

    ;; Phase 2b: rewrite the host's root block in place with forwarded
    ;; addresses (before move zeroes the forwarding words).
    (call $gc_forward_root_block)

    ;; Phase 3: UPDATE every pointer through the forwarding words.
    (global.set $gc_phase (global.get $GC_PHASE_UPDATE))
    (call $gc_update_pointers)

    ;; Phase 4: MOVE (ascending memmove; heap-pointer commit).
    (global.set $gc_phase (global.get $GC_PHASE_MOVE))
    (call $gc_move_objects)

    ;; Phase 5: STRING compaction + hash rebuild.
    (global.set $gc_phase (global.get $GC_PHASE_STRINGS))
    (call $gc_compact_strings)

    ;; Header-event ring: cycle complete. newValue carries the
    ;; post-collection HEAP_POINTER — paired with GC_CYCLE_START's
    ;; oldValue, a reader gets bytes-reclaimed without re-deriving it
    ;; from surrounding step-ring entries.
    (call $header_event_ring_write
      (global.get $HEADER_EVENT_KIND_GC_CYCLE_END)
      (global.get $HEADER_EVENT_FIELD_NONE)
      (global.get $HEADER_EVENT_SITE_WAT_GC_COLLECT)
      (i32.const 0xFF)
      (i32.const 0) (call $read_state (global.get $STATE_HEAP_POINTER)))

    (i32.const 0)
  )
)
