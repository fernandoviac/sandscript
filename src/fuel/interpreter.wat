  ;; array_method_materialize(receiver_type, receiver_pointer) -> receiver_pointer
  ;;
  ;; Shared preamble every Array-instance method below reproduces: if the
  ;; receiver is a msgpack array ref, materialize it to a real TYPE_ARRAY
  ;; first. Since $builtin_sig functions take receiver_type/receiver_pointer
  ;; by value (not by the caller's mutable locals), this helper returns the
  ;; possibly-substituted array pointer; the caller always treats the
  ;; receiver as TYPE_ARRAY afterward, matching the original inline
  ;; reassignment of receiver_type/receiver_pointer.
  (func $array_method_materialize
    (param $receiver_type i32) (param $receiver_pointer i32)
    (result i32)
    (local $array_pointer i32)
    (if (i32.eq (i32.and (local.get $receiver_type) (i32.const 0xff)) (global.get $TYPE_MSGPACK_REF))
      (then
        (if (i32.eq
              (call $msgpack_peek_type
                (call $msgpack_ref_absolute
                  (local.get $receiver_pointer)
                  (i32.shr_u (local.get $receiver_type) (i32.const 8)))
                (call $msgpack_ref_parent_end (local.get $receiver_pointer)))
              (global.get $MSGPACK_ARRAY))
          (then
            (if (call $check_heap_overflow
                  (call $estimate_array_size (call $msgpack_scratch_count)))
              (then (return (i32.const -1))))
          )
        )
        (local.set $array_pointer (call $msgpack_to_array
          (call $msgpack_ref_absolute
            (local.get $receiver_pointer)
            (i32.shr_u (local.get $receiver_type) (i32.const 8)))
          (call $msgpack_ref_parent_end (local.get $receiver_pointer))
          (local.get $receiver_pointer)))
        (if (i32.eqz (local.get $array_pointer))
          (then (return (i32.const -2))))
        (return (local.get $array_pointer))
      )
    )
    (return (local.get $receiver_pointer))
  )

  (func $array_push_method
    (param $receiver_type i32) (param $receiver_pointer i32)
