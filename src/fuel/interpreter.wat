      (then (return (call $number_is_finite (local.get $receiver_type) (local.get $receiver_pointer) (local.get $method_id) (local.get $argc) (local.get $stack_base)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_NUMBER_IS_INTEGER))
      (then (return (call $number_is_integer (local.get $receiver_type) (local.get $receiver_pointer) (local.get $method_id) (local.get $argc) (local.get $stack_base)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_STRING_FROM_CHAR_CODE))
      (then (return (call $string_from_char_code (local.get $receiver_type) (local.get $receiver_pointer) (local.get $method_id) (local.get $argc) (local.get $stack_base)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_STRING_FROM_CODE_POINT))
      (then (return (call $string_from_code_point (local.get $receiver_type) (local.get $receiver_pointer) (local.get $method_id) (local.get $argc) (local.get $stack_base)))))

    ;; ============================================
    ;; Typed array static methods — migrated to the dispatch table
    ;; (batch 12). Range checks
    ;; kept as-is per the decided design (one shared function per
    ;; range) rather than split into 11 near-identical functions.
    (if (i32.and
          (i32.ge_u (local.get $method_id) (global.get $METHOD_UINT8ARRAY_FROM))
          (i32.le_u (local.get $method_id) (global.get $METHOD_BIGUINT64ARRAY_FROM)))
      (then (return (call $typed_array_from (local.get $receiver_type) (local.get $receiver_pointer) (local.get $method_id) (local.get $argc) (local.get $stack_base)))))
    (if (i32.and
          (i32.ge_u (local.get $method_id) (global.get $METHOD_UINT8ARRAY_OF))
          (i32.le_u (local.get $method_id) (global.get $METHOD_BIGUINT64ARRAY_OF)))
      (then (return (call $typed_array_of (local.get $receiver_type) (local.get $receiver_pointer) (local.get $method_id) (local.get $argc) (local.get $stack_base)))))

    ;; ============================================
    ;; JSON methods — migrated to the dispatch table
    ;; (batch 13).
    (if (i32.eq (local.get $method_id) (global.get $METHOD_JSON_STRINGIFY))
      (then (return (call $json_stringify_method (local.get $receiver_type) (local.get $receiver_pointer) (local.get $method_id) (local.get $argc) (local.get $stack_base)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_JSON_PARSE))
      (then (return (call $json_parse_method (local.get $receiver_type) (local.get $receiver_pointer) (local.get $method_id) (local.get $argc) (local.get $stack_base)))))

    ;; ============================================
    ;; MessagePack methods — migrated to the dispatch table
    ;; (batch 14).
    (if (i32.eq (local.get $method_id) (global.get $METHOD_MSGPACK_ENCODE))
      (then (return (call $msgpack_encode_method (local.get $receiver_type) (local.get $receiver_pointer) (local.get $method_id) (local.get $argc) (local.get $stack_base)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_MSGPACK_DECODE))
      (then (return (call $msgpack_decode_method (local.get $receiver_type) (local.get $receiver_pointer) (local.get $method_id) (local.get $argc) (local.get $stack_base)))))

    ;; ============================================
    ;; OBJECT STATIC METHODS — migrated to the dispatch table
    ;; (batch 15). Each of these ids
    ;; is registered in $builtin_table; called directly here (not via
    ;; $dispatch_via_table) since we're already inside the fallback.
    ;; ============================================

    (if (i32.eq (local.get $method_id) (global.get $METHOD_OBJECT_KEYS))
      (then (return (call $object_keys (local.get $receiver_type) (local.get $receiver_pointer) (local.get $method_id) (local.get $argc) (local.get $stack_base)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_OBJECT_VALUES))
      (then (return (call $object_values (local.get $receiver_type) (local.get $receiver_pointer) (local.get $method_id) (local.get $argc) (local.get $stack_base)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_OBJECT_ENTRIES))
      (then (return (call $object_entries (local.get $receiver_type) (local.get $receiver_pointer) (local.get $method_id) (local.get $argc) (local.get $stack_base)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_OBJECT_ASSIGN))
      (then (return (call $object_assign (local.get $receiver_type) (local.get $receiver_pointer) (local.get $method_id) (local.get $argc) (local.get $stack_base)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_ARRAY_IS_ARRAY))
      (then (return (call $array_is_array (local.get $receiver_type) (local.get $receiver_pointer) (local.get $method_id) (local.get $argc) (local.get $stack_base)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_ARRAY_OF))
      (then (return (call $array_of (local.get $receiver_type) (local.get $receiver_pointer) (local.get $method_id) (local.get $argc) (local.get $stack_base)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_OBJECT_FROM_ENTRIES))
      (then (return (call $object_from_entries (local.get $receiver_type) (local.get $receiver_pointer) (local.get $method_id) (local.get $argc) (local.get $stack_base)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_NUMBER_TO_STRING))
      (then (return (call $number_to_string_method (local.get $receiver_type) (local.get $receiver_pointer) (local.get $method_id) (local.get $argc) (local.get $stack_base)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_NUMBER_TO_FIXED))
      (then (return (call $number_to_fixed_method (local.get $receiver_type) (local.get $receiver_pointer) (local.get $method_id) (local.get $argc) (local.get $stack_base)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_TYPED_ARRAY_AT))
      (then (return (call $typed_array_at (local.get $receiver_type) (local.get $receiver_pointer) (local.get $method_id) (local.get $argc) (local.get $stack_base)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_ARRAY_FROM))
      (then (return (call $array_from_method (local.get $receiver_type) (local.get $receiver_pointer) (local.get $method_id) (local.get $argc) (local.get $stack_base)))))

    ;; Array.freeze/isFrozen, Object.freeze/isFrozen, hasOwnProperty,
    ;; Object.prototype.toString — migrated to the dispatch table
    ;; (batch 18).
    (if (i32.eq (local.get $method_id) (global.get $METHOD_ARRAY_FREEZE))
      (then (return (call $array_freeze_method (local.get $receiver_type) (local.get $receiver_pointer) (local.get $method_id) (local.get $argc) (local.get $stack_base)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_ARRAY_IS_FROZEN))
      (then (return (call $array_is_frozen_method (local.get $receiver_type) (local.get $receiver_pointer) (local.get $method_id) (local.get $argc) (local.get $stack_base)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_OBJECT_FREEZE))
      (then (return (call $object_freeze_method (local.get $receiver_type) (local.get $receiver_pointer) (local.get $method_id) (local.get $argc) (local.get $stack_base)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_OBJECT_IS_FROZEN))
      (then (return (call $object_is_frozen_method (local.get $receiver_type) (local.get $receiver_pointer) (local.get $method_id) (local.get $argc) (local.get $stack_base)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_HAS_OWN_PROPERTY))
      (then (return (call $has_own_property_method (local.get $receiver_type) (local.get $receiver_pointer) (local.get $method_id) (local.get $argc) (local.get $stack_base)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_OBJECT_TO_STRING))
      (then (return (call $object_to_string_method (local.get $receiver_type) (local.get $receiver_pointer) (local.get $method_id) (local.get $argc) (local.get $stack_base)))))


    ;; =========================================================================
    ;; Generator object methods.
    ;;
    ;; Migrated to $generator_self_method / $generator_next_return_throw_method
    ;; (batch 27 — the last of task #11's
    ;; scope). Registered into $builtin_table at these four method ids;
    ;; called directly here rather than through call_indirect, matching the
    ;; thin-forward style used for every other already-migrated method.
    ;; =========================================================================
    (if (i32.eq (local.get $method_id) (global.get $METHOD_GENERATOR_SELF))
      (then
        (return (call $generator_self_method
          (local.get $receiver_type) (local.get $receiver_pointer)
          (local.get $method_id) (local.get $argc) (local.get $stack_base)))
      )
    )

    (if (i32.or
          (i32.or
            (i32.eq (local.get $method_id) (global.get $METHOD_GENERATOR_NEXT))
            (i32.eq (local.get $method_id) (global.get $METHOD_GENERATOR_RETURN)))
          (i32.eq (local.get $method_id) (global.get $METHOD_GENERATOR_THROW)))
      (then
        (return (call $generator_next_return_throw_method
          (local.get $receiver_type) (local.get $receiver_pointer)
          (local.get $method_id) (local.get $argc) (local.get $stack_base)))
      )
    )

    ;; =========================================================================
    ;; Function.prototype.call / apply / bind (closure receivers).
    ;;
    ;; Migrated to $call_apply_bind (first method group extracted
    ;; under the full dispatch-table rework). Registered into
    ;; $builtin_table at these three method
    ;; ids; called directly here rather than through
    ;; $dispatch_via_table's null-check, since this call site already
    ;; knows unconditionally that these three ids are migrated.
    ;; =========================================================================
    (if (i32.or
          (i32.or
            (i32.eq (local.get $method_id) (global.get $METHOD_FUNCTION_CALL))
            (i32.eq (local.get $method_id) (global.get $METHOD_FUNCTION_APPLY)))
          (i32.eq (local.get $method_id) (global.get $METHOD_FUNCTION_BIND)))
      (then
        (return (call $call_apply_bind
          (local.get $receiver_type)
          (local.get $receiver_pointer)
          (local.get $method_id)
          (local.get $argc)
          (local.get $stack_base)))
      )
    )

    ;; Map/Set size getters, Object.getOwnPropertyDescriptor,
    ;; Object.getPrototypeOf — migrated to the dispatch table
    ;; (batch 18).
    (if (i32.or
          (i32.eq (local.get $method_id) (global.get $METHOD_MAP_SIZE_GETTER))
          (i32.eq (local.get $method_id) (global.get $METHOD_SET_SIZE_GETTER)))
      (then (return (call $map_set_size_getter_method (local.get $receiver_type) (local.get $receiver_pointer) (local.get $method_id) (local.get $argc) (local.get $stack_base)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_OBJECT_GET_OWN_PROPERTY_DESCRIPTOR))
      (then (return (call $object_get_own_property_descriptor_method (local.get $receiver_type) (local.get $receiver_pointer) (local.get $method_id) (local.get $argc) (local.get $stack_base)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_OBJECT_GET_PROTOTYPE_OF))
      (then (return (call $object_get_prototype_of_method (local.get $receiver_type) (local.get $receiver_pointer) (local.get $method_id) (local.get $argc) (local.get $stack_base)))))

    ;; =========================================================================
    ;; TextEncoder.prototype.encode(str) -> Uint8Array
    ;;
    ;; SS strings are stored as UTF-8 bytes natively, so encode is a memcpy:
    ;; read the string's byte length, allocate an ArrayBuffer of that size,
    ;; copy the UTF-8 bytes in, then wrap with a Uint8Array descriptor.
    ;;
    ;; arg1 is the string to encode. If missing or not a string, coerce via
    ;; value_to_string (matches JS, which coerces non-string args).
    ;; =========================================================================
    ;; TextEncoder.encode, TextDecoder.decode, Promise.resolve/reject —
    ;; migrated to the dispatch table (batch 19).
    (if (i32.eq (local.get $method_id) (global.get $METHOD_TEXT_ENCODER_ENCODE))
      (then (return (call $text_encoder_encode_method (local.get $receiver_type) (local.get $receiver_pointer) (local.get $method_id) (local.get $argc) (local.get $stack_base)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_TEXT_DECODER_DECODE))
      (then (return (call $text_decoder_decode_method (local.get $receiver_type) (local.get $receiver_pointer) (local.get $method_id) (local.get $argc) (local.get $stack_base)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_PROMISE_RESOLVE))
      (then (return (call $promise_resolve_method (local.get $receiver_type) (local.get $receiver_pointer) (local.get $method_id) (local.get $argc) (local.get $stack_base)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_PROMISE_REJECT))
      (then (return (call $promise_reject_method (local.get $receiver_type) (local.get $receiver_pointer) (local.get $method_id) (local.get $argc) (local.get $stack_base)))))

    ;; Native Proof.Term methods. These are intentionally dispatched here as
    ;; well as registered in the table: the fallback remains authoritative
    ;; until the interpreter's table migration is complete.
    (if (call $is_proof_native_method (local.get $method_id))
      (then (return (call $dispatch_via_table (local.get $method_id)
        (local.get $receiver_type) (local.get $receiver_pointer)
        (local.get $argc) (local.get $stack_base)))))
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    

    ;; Unknown method - reset stack and push undefined
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (call $pending_push (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))
    (i32.const 0)  ;; return success
  )

  ;; ==========================================================================
  ;; DEBUG: Export debug info for diagnosing throw handling
  (func (export "debug_get_ctx_status") (result i32)
    (call $read_ctx (global.get $CTX_EXIT_CONDITION))
  )
  (func (export "debug_get_code_block") (result i32)
    (call $read_state (global.get $STATE_CODE_BLOCK))
  )
  (func (export "debug_get_current_context_base") (result i32)
    (global.get $current_context_base)
  )
  (func (export "debug_get_try_depth") (result i32)
    (call $try_depth)
  )
  (func (export "debug_get_instr_count") (result i32)
    (call $read_instr_count (call $read_state (global.get $STATE_CODE_BLOCK)))
  )
  (func (export "debug_get_pc") (result i32)
    (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX))
  )
  (func (export "debug_get_current_scope") (result i32)
    (global.get $current_scope)
  )
  (func (export "debug_get_ctx_scope") (result i32)
    (call $read_ctx (global.get $CTX_SCOPE))
  )
  (func (export "debug_get_try_catch_index") (param $depth i32) (result i32)
    (call $try_read (local.get $depth) (global.get $TRY_CATCH_INDEX))
  )
  (func (export "debug_get_call_stack_depth") (result i32)
    (i32.div_u
      (i32.sub
        (call $read_ctx (global.get $CTX_CALL_STACK_POINTER))
        (call $call_stack_base_seg))
      (global.get $FRAME_SIZE))
  )
  (func (export "debug_get_pending_depth") (result i32)
    (i32.div_u
      (i32.sub
        (call $read_ctx (global.get $CTX_PENDING_POINTER))
        (call $pending_base_seg))
      (global.get $VALUE_SIZE))
  )
  (func (export "debug_read_opcode") (param $index i32) (result i32)
    (call $read_opcode (call $read_state (global.get $STATE_CODE_BLOCK)) (local.get $index))
  )

  ;; debug_read_operand1(index) → i32. Reads the 16-bit operand1 of the
  ;; instruction at $index (after the opcode byte). Each instruction is
  ;; 5 bytes: [opcode:1][operand1:2][operand2:2].
  (func (export "debug_read_operand1") (param $index i32) (result i32)
    (call $read_operand1 (call $read_state (global.get $STATE_CODE_BLOCK)) (local.get $index))
  )

  ;; debug_read_operand2(index) → i32. Reads operand2.
  (func (export "debug_read_operand2") (param $index i32) (result i32)
    (call $read_operand2 (call $read_state (global.get $STATE_CODE_BLOCK)) (local.get $index))
  )

  ;; debug_check_heap_overflow(total_size) → i32. Predicts whether
  ;; $check_heap_overflow would fire for a given budget RIGHT NOW.
  ;; NOTE: this also sets/clears the pressure flag as a side effect
  ;; — debug-only, do not interleave with production code paths.
  (func (export "debug_check_heap_overflow") (param $total_size i32) (result i32)
    (call $check_heap_overflow (local.get $total_size))
  )

  ;; Per-estimator debug exports. Each lets JS-side debug call the
  ;; estimator directly so size formulas can be verified without
  ;; recomputing in JS.
  (func (export "debug_estimate_array_size") (param $capacity i32) (result i32)
    (call $estimate_array_size (local.get $capacity)))
  (func (export "debug_estimate_object_size") (param $capacity i32) (result i32)
    (call $estimate_object_size (local.get $capacity)))
  (func (export "debug_estimate_arraybuffer_size") (param $byte_length i32) (result i32)
    (call $estimate_arraybuffer_size (local.get $byte_length)))
  (func (export "debug_estimate_typed_array_descriptor_size") (result i32)
    (call $estimate_typed_array_descriptor_size))
  (func (export "debug_estimate_promise_size") (result i32)
    (call $estimate_promise_size))
  (func (export "debug_estimate_collection_size") (param $slot_stride i32) (param $capacity i32) (result i32)
    (call $estimate_collection_size (local.get $slot_stride) (local.get $capacity)))
  (func (export "debug_estimate_bigint_size") (param $length i32) (result i32)
    (call $estimate_bigint_size (local.get $length)))
  (func (export "debug_estimate_rational_size") (result i32)
    (call $estimate_rational_size))
  (func (export "debug_estimate_complex_size") (result i32)
    (call $estimate_complex_size))
  (func (export "debug_estimate_symbol_size") (result i32)
    (call $estimate_symbol_size))
  (func (export "debug_estimate_expression_size") (result i32)
    (call $estimate_expression_size))
  (func (export "debug_estimate_scope_size") (result i32)
    (call $estimate_scope_size))
  (func (export "debug_estimate_expression_op_budget") (result i32)
    (call $estimate_expression_op_budget))

  ;; step_ring_write(slot, pc, opcode)
  ;;
  ;; Write one 40-byte entry into the step ring if enabled. Called from
  ;; the dispatch loop after fetch (captures the instruction about to
  ;; execute plus the current state) and once after the exit block
  ;; (captures the final state). Gated on $step_ring_capacity — if the
  ;; ring region was not allocated (size 0), this is a no-op.
  ;;
  ;; Publication follows the ring publication contract
  ;; (docs/ring-publication-contract.md): reserve the head atomically
  ;; BEFORE touching the reused slot, invalidate the entry's token to
  ;; the 0 sentinel, land the payload with atomic word stores (wasm has
  ;; no store fence; only seq-cst atomics respect program order), then
  ;; publish the exact 1-based entry index as the token. A concurrent
  ;; shared-memory reader validates the token before and after decoding
  ;; and can never accept a torn record — and never pauses this writer.
  ;; ==========================================================================
  (func $step_ring_write (param $slot i32) (param $pc i32) (param $opcode i32)
    (local $entry_abs i32)
    (local $index i32)
    (local $generation i32)
    (if (i32.eqz (global.get $step_ring_capacity))
      (then (return))
    )


    ;; A terminally exhausted ring drops diagnostics without impeding
    ;; interpreter execution. A wrap publishes generation 0 as a
    ;; transition seqlock, resets the head, publishes the successor,
    ;; and drops this diagnostic; token 0 is never published.
    (if
      (i32.ne
        (i32.and
          (i32.atomic.load
            (i32.add (call $abs (global.get $step_ring_base)) (i32.const 4)))
          (global.get $RING_FLAG_SEGMENT_SPACE_EXHAUSTED))
        (i32.const 0))
      (then (return)))
    (if (i32.eq (global.get $step_ring_write_head) (i32.const -1))
      (then
        (local.set $generation
          (i32.atomic.load
            (i32.add (call $abs (global.get $step_ring_base)) (i32.const 12))))
        (if (i32.eq (local.get $generation) (i32.const -1))
          (then
            (i32.atomic.store
              (i32.add (call $abs (global.get $step_ring_base)) (i32.const 4))
              (i32.or
                (i32.atomic.load
                  (i32.add (call $abs (global.get $step_ring_base)) (i32.const 4)))
                (global.get $RING_FLAG_SEGMENT_SPACE_EXHAUSTED)))
            (return)))
        (i32.atomic.store
          (i32.add (call $abs (global.get $step_ring_base)) (i32.const 12))
          (i32.const 0))
        (global.set $step_ring_write_head (i32.const 0))
        (i32.atomic.store
          (call $abs (global.get $step_ring_base))
          (i32.const 0))
        (i32.atomic.store
          (i32.add (call $abs (global.get $step_ring_base)) (i32.const 12))
          (i32.add (local.get $generation) (i32.const 1)))
        (return))
    )

    ;; entry_abs = abs(base + header + (writeHead % capacity) * 40)
    (local.set $entry_abs
      (call $abs
        (i32.add
          (i32.add
            (global.get $step_ring_base)
            (global.get $STEP_RING_HEADER_SIZE))
          (i32.mul
            (i32.rem_u (global.get $step_ring_write_head) (global.get $step_ring_capacity))
            (global.get $STEP_RING_ENTRY_SIZE)))))

    ;; Reserve the head, then invalidate the slot's token.
    (local.set $index (i32.add (global.get $step_ring_write_head) (i32.const 1)))
    (global.set $step_ring_write_head (local.get $index))
    (i32.atomic.store (call $abs (global.get $step_ring_base)) (local.get $index))
    (i32.atomic.store (local.get $entry_abs) (i32.const 0))

    ;; instructionIndex (u32 at offset 4)
    (i32.atomic.store (i32.add (local.get $entry_abs) (i32.const 4)) (local.get $pc))
    ;; scopePointer (u32 at offset 8)
    (i32.atomic.store (i32.add (local.get $entry_abs) (i32.const 8))
      (global.get $current_scope))
    ;; heapPointer (u32 at offset 12)
    (i32.atomic.store (i32.add (local.get $entry_abs) (i32.const 12))
      (call $read_state (global.get $STATE_HEAP_POINTER)))
    ;; stringPointer (u32 at offset 16)
    (i32.atomic.store (i32.add (local.get $entry_abs) (i32.const 16))
      (call $read_state (global.get $STATE_STRING_POINTER)))
    ;; opcode (u16 at 20) | pendingDepth (u16 at 22)
    (i32.atomic.store (i32.add (local.get $entry_abs) (i32.const 20))
      (i32.or
        (i32.and (local.get $opcode) (i32.const 0xFFFF))
        (i32.shl
          (i32.and
            (i32.div_u
              (i32.sub
                (call $read_ctx (global.get $CTX_PENDING_POINTER))
                (call $pending_base_seg))
              (global.get $VALUE_SIZE))
            (i32.const 0xFFFF))
          (i32.const 16))))
    ;; callDepth (u16 at 24) | tryDepth (u16 at 26)
    (i32.atomic.store (i32.add (local.get $entry_abs) (i32.const 24))
      (i32.or
        (i32.and (call $get_frame_depth) (i32.const 0xFFFF))
        (i32.shl (i32.and (call $try_depth) (i32.const 0xFFFF)) (i32.const 16))))
    ;; grantDepth (u16 at 28) | slot (u8 at 30) | status (u8 at 31)
    (i32.atomic.store (i32.add (local.get $entry_abs) (i32.const 28))
      (i32.or
        (i32.or
          (i32.and
            (i32.div_u
              (i32.sub
                (call $read_ctx (global.get $CTX_GRANT_STACK_POINTER))
                (call $grant_stack_base_seg))
              (global.get $GRANT_ENTRY_SIZE))
            (i32.const 0xFFFF))
          (i32.shl (i32.and (local.get $slot) (i32.const 0xFF)) (i32.const 16)))
        (i32.shl
          (i32.and (call $read_ctx (global.get $CTX_EXIT_CONDITION)) (i32.const 0xFF))
          (i32.const 24))))
    ;; errorCode (u8 at 32) | completionType (u8 at 33); bytes 34..35 reserved
    (i32.atomic.store (i32.add (local.get $entry_abs) (i32.const 32))
      (i32.or
        (i32.and (call $error_info_code) (i32.const 0xFF))
        (i32.shl
          (i32.and (call $read_ctx (global.get $CTX_COMPLETION_TYPE)) (i32.const 0xFF))
          (i32.const 8))))
    ;; reserved word at 36
    (i32.atomic.store (i32.add (local.get $entry_abs) (i32.const 36)) (i32.const 0))

    ;; Publish the exact 1-based entry index as the token (u32 at 0).
    (i32.atomic.store (local.get $entry_abs) (local.get $index))
  )

  ;; ==========================================================================
  ;; header_event_ring_refresh()
  ;;
  ;; Re-reads the header-event ring region metadata from STATE once at
  ;; the top of $gc_collect. Unlike the step ring, this is not on the
  ;; per-instruction dispatch path, so it need not be cached across $run.

  ;; ==========================================================================
  (func $header_event_ring_refresh
    (global.set $header_event_ring_base
      (call $read_state (global.get $STATE_HEADER_EVENT_RING_BASE)))
    (if (i32.eqz (call $read_state (global.get $STATE_HEADER_EVENT_RING_SIZE)))
      (then
        (global.set $header_event_ring_capacity (i32.const 0))
        (return)))
    (global.set $header_event_ring_capacity
      (i32.div_u
        (i32.sub
          (call $read_state (global.get $STATE_HEADER_EVENT_RING_SIZE))
          (global.get $HEADER_EVENT_RING_HEADER_SIZE))
        (global.get $HEADER_EVENT_RING_ENTRY_SIZE)))
    (global.set $header_event_ring_write_head
      (i32.atomic.load (call $abs (global.get $header_event_ring_base))))
  )

  ;; ==========================================================================
  ;; header_event_ring_write(kind, field, site, slot, oldValue, newValue)
  ;;
  ;; Write one 32-byte entry into the header-event ring if enabled. Gated
  ;; on $header_event_ring_capacity — if the ring region was not allocated
  ;; (size 0), this is a no-op. Called from GC-compaction call sites only
  ;; (see $gc_update_pointers, $gc_move_objects, $gc_collect) — never from
  ;; the per-instruction dispatch loop, so this has no hot-path cost.
  ;; ==========================================================================
  (func $header_event_ring_write
    (param $kind i32) (param $field i32) (param $site i32) (param $slot i32)
    (param $old_value i32) (param $new_value i32)
    (local $entry_abs i32)
    (local $index i32)
    (local $generation i32)

    (if (i32.eqz (global.get $header_event_ring_capacity))
      (then (return))
    )

    (if
      (i32.ne
        (i32.and
          (i32.atomic.load
            (i32.add (call $abs (global.get $header_event_ring_base)) (i32.const 4)))
          (global.get $RING_FLAG_SEGMENT_SPACE_EXHAUSTED))
        (i32.const 0))
      (then (return)))
    (if (i32.eq (global.get $header_event_ring_write_head) (i32.const -1))
      (then
        (local.set $generation
          (i32.atomic.load
            (i32.add (call $abs (global.get $header_event_ring_base)) (i32.const 12))))
        (if (i32.eq (local.get $generation) (i32.const -1))
          (then
            (i32.atomic.store
              (i32.add (call $abs (global.get $header_event_ring_base)) (i32.const 4))
              (i32.or
                (i32.atomic.load
                  (i32.add (call $abs (global.get $header_event_ring_base)) (i32.const 4)))
                (global.get $RING_FLAG_SEGMENT_SPACE_EXHAUSTED)))
            (return)))
        (i32.atomic.store
          (i32.add (call $abs (global.get $header_event_ring_base)) (i32.const 12))
          (i32.const 0))
        (global.set $header_event_ring_write_head (i32.const 0))
        (i32.atomic.store
          (call $abs (global.get $header_event_ring_base))
          (i32.const 0))
        (i32.atomic.store
          (i32.add (call $abs (global.get $header_event_ring_base)) (i32.const 12))
          (i32.add (local.get $generation) (i32.const 1)))
        (return))
    )

    ;; entry_abs = abs(base + header + (writeHead % capacity) * 32)
    (local.set $entry_abs
      (call $abs
        (i32.add
          (i32.add
            (global.get $header_event_ring_base)
            (global.get $HEADER_EVENT_RING_HEADER_SIZE))
          (i32.mul
            (i32.rem_u (global.get $header_event_ring_write_head) (global.get $header_event_ring_capacity))
            (global.get $HEADER_EVENT_RING_ENTRY_SIZE)))))

    ;; Ring publication contract (docs/ring-publication-contract.md):
    ;; 1. reserve the head atomically BEFORE touching the reused slot;
    ;; 2. invalidate the slot's publication token to the 0 sentinel
    ;;    (the previous lap's token equals exactly the index a slow
    ;;    reader still expects — leaving it valid lets that reader
    ;;    accept a torn record);
    ;; 3. store the payload with atomic accesses (wasm has no store
    ;;    fence; only seq-cst atomics respect program order);
    ;; 4. publish the exact 1-based entry index as the token.
    (local.set $index (i32.add (global.get $header_event_ring_write_head) (i32.const 1)))
    (global.set $header_event_ring_write_head (local.get $index))
    (i32.atomic.store (call $abs (global.get $header_event_ring_base)) (local.get $index))

    ;; invalidate token (u32 at offset 12)
    (i32.atomic.store (i32.add (local.get $entry_abs) (i32.const 12)) (i32.const 0))

    ;; kind|field|site|slot packed little-endian into the word at offset 0
    (i32.atomic.store (local.get $entry_abs)
      (i32.or
        (i32.or
          (i32.and (local.get $kind) (i32.const 0xFF))
          (i32.shl (i32.and (local.get $field) (i32.const 0xFF)) (i32.const 8)))
        (i32.or
          (i32.shl (i32.and (local.get $site) (i32.const 0xFF)) (i32.const 16))
          (i32.shl (i32.and (local.get $slot) (i32.const 0xFF)) (i32.const 24)))))
    ;; oldValue (u32 at offset 4)
    (i32.atomic.store (i32.add (local.get $entry_abs) (i32.const 4)) (local.get $old_value))
    ;; newValue (u32 at offset 8)
    (i32.atomic.store (i32.add (local.get $entry_abs) (i32.const 8)) (local.get $new_value))
    ;; reserved words at 16..31 zeroed (a wraparound reuse may hold a
    ;; prior parked-slot bitmap)
    (i32.atomic.store (i32.add (local.get $entry_abs) (i32.const 16)) (i32.const 0))
    (i32.atomic.store (i32.add (local.get $entry_abs) (i32.const 20)) (i32.const 0))
    (i32.atomic.store (i32.add (local.get $entry_abs) (i32.const 24)) (i32.const 0))
    (i32.atomic.store (i32.add (local.get $entry_abs) (i32.const 28)) (i32.const 0))

    ;; publish the token (u32 at offset 12)
    (i32.atomic.store (i32.add (local.get $entry_abs) (i32.const 12)) (local.get $index))
  )

  ;; ==========================================================================
  ;; header_event_ring_write_parked_slots()
  ;;
  ;; Twin of
  ;; header-event-ring.js's writeParkedSlotsSnapshotEntry — separate
  ;; implementation (matching this ring's existing WAT/JS twin-writer
  ;; convention), same entry layout. Called immediately after a
  ;; GC_CYCLE_START write (see $gc_collect): snapshots which context
  ;; slots are parked (allocated, not FREE, exit condition not
  ;; done/error/never-yielded) at exactly this moment, writes a
  ;; GC_CYCLE_PARKED_SLOTS entry with oldValue=total parked count,
  ;; newValue=count truncated past the inline bitmap capacity, and the
  ;; bitmap itself in the entry's RESERVED bytes (one bit per slot index
  ;; 0..HEADER_EVENT_PARKED_BITMAP_BITS-1). A reader must treat
  ;; newValue > 0 as "snapshot truncated."
  ;;
  ;; Duplicates $gc_mark_contexts' allocated-slot iteration shape rather
  ;; than reusing it — this must run BEFORE the stale-FREE-entry zeroing
  ;; side effect that function performs, and it needs a different
  ;; per-slot action (bitmap bit vs mark), so a shared helper would need
  ;; a mode flag for one call site. Kept separate, matching the WAT/JS
  ;; twin-writer split above.
  ;; ==========================================================================
  (func $header_event_ring_write_parked_slots
    (param $site i32)
    (local $entry_abs i32)
    (local $index i32)
    (local $count i32)
    (local $table i32)
    (local $slot i32)
    (local $table_entry_abs i32)
    (local $ctx_base i32)
    (local $exit_condition i32)
    (local $parked_count i32)
    (local $truncated_count i32)
    (local $word_i i32)
    (local $bitmap0 i32)
    (local $bitmap1 i32)
    (local $bitmap2 i32)
    (local $bitmap3 i32)
    (local $generation i32)

    (if (i32.eqz (global.get $header_event_ring_capacity))
      (then (return))
    )

    (if
      (i32.ne
        (i32.and
          (i32.atomic.load
            (i32.add (call $abs (global.get $header_event_ring_base)) (i32.const 4)))
          (global.get $RING_FLAG_SEGMENT_SPACE_EXHAUSTED))
        (i32.const 0))
      (then (return)))

    (local.set $entry_abs
      (call $abs
        (i32.add
          (i32.add
            (global.get $header_event_ring_base)
            (global.get $HEADER_EVENT_RING_HEADER_SIZE))
          (i32.mul
            (i32.rem_u (global.get $header_event_ring_write_head) (global.get $header_event_ring_capacity))
            (global.get $HEADER_EVENT_RING_ENTRY_SIZE)))))

    ;; Build the parked bitmap in locals first — the ring publication
    ;; contract wants the slot invalidated for the SHORTEST possible
    ;; window, and bitmap words then land with single atomic stores.
    (local.set $count (call $read_state (global.get $STATE_CONTEXT_COUNT)))
    (local.set $table (call $read_state (global.get $STATE_CONTEXT_TABLE_POINTER)))
    (local.set $slot (i32.const 0))
    (local.set $parked_count (i32.const 0))
    (local.set $truncated_count (i32.const 0))
    (local.set $bitmap0 (i32.const 0))
    (local.set $bitmap1 (i32.const 0))
    (local.set $bitmap2 (i32.const 0))
    (local.set $bitmap3 (i32.const 0))
    (block $slots_done
      (loop $slots_loop
        (br_if $slots_done (i32.ge_u (local.get $slot) (local.get $count)))
        (local.set $table_entry_abs (call $abs (i32.add (local.get $table)
          (i32.mul (local.get $slot) (i32.const 4)))))
        (local.set $ctx_base (i32.load (local.get $table_entry_abs)))
        (if (i32.ne (local.get $ctx_base) (i32.const 0))
          (then
            (local.set $exit_condition
              (i32.load (call $abs (i32.add (local.get $ctx_base) (global.get $CTX_EXIT_CONDITION)))))
            (if (i32.and
                  (i32.and
                    (i32.ne (local.get $exit_condition) (global.get $CONTEXT_STATUS_FREE))
                    (i32.ne (local.get $exit_condition) (i32.const 0)))
                  (i32.and
                    (i32.ne (local.get $exit_condition) (global.get $EXIT_DONE))
                    (i32.ne (local.get $exit_condition) (global.get $EXIT_ERROR))))
              (then
                (local.set $parked_count (i32.add (local.get $parked_count) (i32.const 1)))
                (if (i32.lt_u (local.get $slot) (global.get $HEADER_EVENT_PARKED_BITMAP_BITS))
                  (then
                    (local.set $word_i (i32.shr_u (local.get $slot) (i32.const 5)))
                    (if (i32.eqz (local.get $word_i))
                      (then (local.set $bitmap0 (i32.or (local.get $bitmap0)
                        (i32.shl (i32.const 1) (i32.and (local.get $slot) (i32.const 31))))))
                      (else (if (i32.eq (local.get $word_i) (i32.const 1))
                        (then (local.set $bitmap1 (i32.or (local.get $bitmap1)
                          (i32.shl (i32.const 1) (i32.and (local.get $slot) (i32.const 31))))))
                        (else (if (i32.eq (local.get $word_i) (i32.const 2))
                          (then (local.set $bitmap2 (i32.or (local.get $bitmap2)
                            (i32.shl (i32.const 1) (i32.and (local.get $slot) (i32.const 31))))))
                          (else (local.set $bitmap3 (i32.or (local.get $bitmap3)
                            (i32.shl (i32.const 1) (i32.and (local.get $slot) (i32.const 31))))))))))))
                  (else
                    (local.set $truncated_count (i32.add (local.get $truncated_count) (i32.const 1))))))))
        )
        (local.set $slot (i32.add (local.get $slot) (i32.const 1)))
        (br $slots_loop)))

    ;; A transition seqlock belongs immediately before reservation,
    ;; after the parked bitmap has been assembled in locals. The
    ;; boundary diagnostic is dropped and token 0 is never published.
    (if (i32.eq (global.get $header_event_ring_write_head) (i32.const -1))
      (then
        (local.set $generation
          (i32.atomic.load
            (i32.add (call $abs (global.get $header_event_ring_base)) (i32.const 12))))
        (if (i32.eq (local.get $generation) (i32.const -1))
          (then
            (i32.atomic.store
              (i32.add (call $abs (global.get $header_event_ring_base)) (i32.const 4))
              (i32.or
                (i32.atomic.load
                  (i32.add (call $abs (global.get $header_event_ring_base)) (i32.const 4)))
                (global.get $RING_FLAG_SEGMENT_SPACE_EXHAUSTED)))
            (return)))
        (i32.atomic.store
          (i32.add (call $abs (global.get $header_event_ring_base)) (i32.const 12))
          (i32.const 0))
        (global.set $header_event_ring_write_head (i32.const 0))
        (i32.atomic.store
          (call $abs (global.get $header_event_ring_base))
          (i32.const 0))
        (i32.atomic.store
          (i32.add (call $abs (global.get $header_event_ring_base)) (i32.const 12))
          (i32.add (local.get $generation) (i32.const 1)))
        (return))
    )
    ;; Publish under the ring publication contract: reserve, invalidate,
    ;; atomic payload, exact 1-based token (see $header_event_ring_write).
    (local.set $index (i32.add (global.get $header_event_ring_write_head) (i32.const 1)))
    (global.set $header_event_ring_write_head (local.get $index))
    (i32.atomic.store (call $abs (global.get $header_event_ring_base)) (local.get $index))

    (i32.atomic.store (i32.add (local.get $entry_abs) (i32.const 12)) (i32.const 0))

    ;; kind|field|site|slot(0xFF) packed into the word at offset 0
    (i32.atomic.store (local.get $entry_abs)
      (i32.or
        (i32.or
          (i32.and (global.get $HEADER_EVENT_KIND_GC_CYCLE_PARKED_SLOTS) (i32.const 0xFF))
          (i32.shl (i32.and (global.get $HEADER_EVENT_FIELD_NONE) (i32.const 0xFF)) (i32.const 8)))
        (i32.or
          (i32.shl (i32.and (local.get $site) (i32.const 0xFF)) (i32.const 16))
          (i32.const 0xFF000000))))
    (i32.atomic.store (i32.add (local.get $entry_abs) (i32.const 4)) (local.get $parked_count))
    (i32.atomic.store (i32.add (local.get $entry_abs) (i32.const 8)) (local.get $truncated_count))
    (i32.atomic.store (i32.add (local.get $entry_abs) (i32.const 16)) (local.get $bitmap0))
    (i32.atomic.store (i32.add (local.get $entry_abs) (i32.const 20)) (local.get $bitmap1))
    (i32.atomic.store (i32.add (local.get $entry_abs) (i32.const 24)) (local.get $bitmap2))
    (i32.atomic.store (i32.add (local.get $entry_abs) (i32.const 28)) (local.get $bitmap3))

    (i32.atomic.store (i32.add (local.get $entry_abs) (i32.const 12)) (local.get $index))
  )

  ;; ==========================================================================
  ;; run(fuel) → status
  ;;
  ;; Execute instructions until fuel runs out, completion, or error.
  ;; Returns remaining fuel. Status is written to CTX_STATUS in memory.
  ;; ==========================================================================
  ;; ==========================================================================
  ;; obj_merge_spread_pressure_yield(pc, type, flags, lo, hi)
  ;;
  ;; Shared pressure-yield tail for OBJ_MERGE_SPREAD's per-element
  ;; chokepoints (index-key interning, code-point interning, entries
  ;; grow, BigInt allocation). Re-pushes the popped spread source from
  ;; the saved quad — re-push rather than pointer arithmetic because the
  ;; slot may have been clobbered by nested stack use (msgpack primitive
  ;; reads push through the same slots) — parks the pc on this op so the
  ;; retry re-runs it from the top (idempotent: existing keys update in
  ;; place), and marks the memory-pressure yield. The caller br $exits.
  ;; ==========================================================================
  (func $obj_merge_spread_pressure_yield
    (param $pc i32) (param $source_type i32) (param $source_flags i32)
    (param $source_lo i32) (param $source_hi i32)
    (call $pending_push (local.get $source_type) (local.get $source_flags)
      (local.get $source_lo) (local.get $source_hi))
    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
  )

  ;; ==========================================================================
  ;; call_pressure_restore_pending(opcode, entry_pending_pointer,
  ;;                               callee_pointer, spread_array_pointer)
  ;;
  ;; Restore the pending stack for a memory-pressure retry of a call-family
  ;; opcode (the pc is parked on the same op, so the retry re-runs it from
  ;; scratch after GC).
  ;;
  ;; Plain CALL / CALL_METHOD: the operand region below the entry pending
  ;; pointer is untouched at every pressure chokepoint (methods fail before
  ;; pushing results), so restoring the entry pointer re-exposes
  ;; [receiver,] callee, args verbatim.
  ;;
  ;; CALL_SPREAD / CALL_METHOD_SPREAD: the prologue popped the packed args
  ;; array and unpacked its elements in place, clobbering the array's slot
  ;; — the entry pointer no longer describes a re-runnable shape. Rebuild
  ;; it: rewrite the slot above the callee with the spread source array
  ;; (its heap object is untouched; elements were copied out, not moved)
  ;; and truncate the stack right above it. The retry then re-pops and
  ;; re-unpacks.
  ;; ==========================================================================
  ;; OP_NEW's twin of $call_pressure_restore_pending below. Every pressure
  ;; yield inside the shared OP_NEW / OP_NEW_SPREAD handler calls this
  ;; before parking: for plain NEW it restores the entry pending pointer;
  ;; for NEW_SPREAD it re-packs the [constructor, args_array] shape the
  ;; prologue consumed (the args array's header pointer survives in a
  ;; dedicated local), so the retry's unpack runs cleanly.
  (func $new_pressure_restore_pending
    (param $opcode i32) (param $entry_pending_pointer i32)
    (param $packed_pending_pointer i32) (param $spread_array_pointer i32)
    (local $slot i32)
    (if (i32.eq (local.get $opcode) (global.get $OP_NEW_SPREAD))
      (then
        (local.set $slot (i32.sub (local.get $packed_pending_pointer) (global.get $VALUE_SIZE)))
        (i32.store (call $abs (local.get $slot)) (global.get $TYPE_ARRAY))
        (i32.store (call $abs (i32.add (local.get $slot) (i32.const 4))) (i32.const 0))
        (i32.store (call $abs (i32.add (local.get $slot) (i32.const 8))) (local.get $spread_array_pointer))
        (i32.store (call $abs (i32.add (local.get $slot) (i32.const 12))) (i32.const 0))
        (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $packed_pending_pointer))
      )
      (else
        (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $entry_pending_pointer))
      )
    )
  )

  (func $call_pressure_restore_pending
    (param $opcode i32) (param $entry_pending_pointer i32)
    (param $callee_pointer i32) (param $spread_array_pointer i32)
    (local $slot i32)
    (if (i32.or
          (i32.eq (local.get $opcode) (global.get $OP_CALL_SPREAD))
          (i32.eq (local.get $opcode) (global.get $OP_CALL_METHOD_SPREAD)))
      (then
        (local.set $slot (i32.add (local.get $callee_pointer) (global.get $VALUE_SIZE)))
        (i32.store (call $abs (local.get $slot)) (global.get $TYPE_ARRAY))
        (i32.store (call $abs (i32.add (local.get $slot) (i32.const 4))) (i32.const 0))
        (i32.store (call $abs (i32.add (local.get $slot) (i32.const 8))) (local.get $spread_array_pointer))
        (i32.store (call $abs (i32.add (local.get $slot) (i32.const 12))) (i32.const 0))
        (call $write_ctx (global.get $CTX_PENDING_POINTER)
          (i32.add (local.get $slot) (global.get $VALUE_SIZE)))
      )
      (else
        (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $entry_pending_pointer))
      )
    )
  )

  (func $run (export "run") (param $fuel i32) (param $context_slot i32) (result i32)
    (local $code_block i32)
    (local $pc i32)
    (local $instr_count i32)
    (local $heap_slack i32)
    (local $opcode i32)
    (local $operand1 i32)
    (local $operand2 i32)
    (local $value_pointer i32)
    (local $value_pointer2 i32)
    (local $value_pointer3 i32)
    (local $value_pointer4 i32)
    (local $type1 i32)
    (local $type2 i32)
    (local $type3 i32)
    (local $type4 i32)
    (local $coerced_id i32)
    (local $coerce_key i32)
    (local $left_id i32)
    (local $data1_lo i32)
    (local $data1_hi i32)
    (local $data2_lo i32)
    (local $data2_hi i32)
    (local $result_i32 i32)
    (local $result_f64 f64)
    (local $result_i64 i64)
    (local $found i32)
    (local $new_scope i32)
    ;; For MAKE_ARRAY / MAKE_OBJECT / GET_INDEX / SET_INDEX / GET_PROP
    (local $count i32)
    (local $heap_pointer i32)
    (local $array_pointer i32)
    (local $object_pointer i32)
    (local $data_pointer i32)
    (local $data_size i32)
    (local $obj_size i32)
    (local $i i32)
    (local $dest i32)
    (local $entry_pointer i32)
    (local $key_offset i32)
    (local $index i32)
    (local $arr_len i32)
    (local $arr_cap i32)
    (local $new_cap i32)
    (local $new_data_pointer i32)
    (local $new_data_size i32)
    (local $element_pointer i32)
    (local $obj_count i32)
    (local $obj_cap i32)
    (local $entries_pointer i32)
    (local $new_entries_pointer i32)
    (local $new_entries_size i32)
    (local $prop_key i32)
    ;; For SET_INDEX value storage
    (local $set_val_type i32)
    (local $set_val_flags i32)
    (local $set_val_lo i32)
    (local $set_val_hi i32)
    ;; For CALL / RETURN / CALL_METHOD
    (local $closure_pointer i32)
    (local $start_instr i32)
    (local $captured_scope i32)
    (local $stack_pointer i32)
    (local $frame_pointer i32)
    (local $pending_pointer i32)
    (local $result_type i32)
    (local $result_flags i32)
    (local $result_lo i32)
    (local $result_hi i32)
    (local $returned_type i32)
    (local $returned_flags i32)
    (local $returned_lo i32)
    (local $returned_hi i32)
    (local $return_pc i32)
    (local $caller_scope i32)
    (local $closure_flags i32)
    ;; For SWAP
    (local $swap_flags i32)
    ;; For bound method dispatch
    (local $method_id i32)
    (local $continuation_kind i32)
    (local $state_handle i32)
    (local $receiver_type i32)
    (local $receiver_pointer i32)
    ;; For msgpack parsing
    (local $mp_type i32)
    (local $mp_addr i32)
    (local $mp_end i32)
    (local $mp_length i32)
    (local $mp_header_size i32)
    (local $mp_data_size i32)
    (local $mp_count i32)
    ;; For prototype chain walking
    (local $current_obj i32)
    (local $proto_depth i32)
    ;; For exception handling scope restoration
    (local $saved_scope i32)
    ;; For callback parameter counting
    (local $param_count i32)
    ;; For async function handling
    (local $async_promise i32)
    ;; For await handling
    (local $promise_ptr i32)
    (local $promise_status i32)
    (local $waiter_head i32)
    (local $waiter_node i32)
    (local $request_base i32)
    ;; For typed array element write
    (local $float_result f64)
    ;; For dispatch_builtin_method result
    (local $dispatch_result i32)
    ;; For the pending-base diagnostic watchpoint
    (local $watch_current_type i32)
    ;; Saved pending position when entering a try handler (v9)
    (local $try_saved_pending i32)
    ;; CALL_SPREAD / CALL_METHOD_SPREAD: the packed args array's header
    ;; pointer, held across the shared call dispatch for pressure-retry
    ;; stack restoration (see $call_pressure_restore_pending)
    (local $spread_array_pointer i32)
    ;; NEW_SPREAD prologue captures — dedicated locals, never reassigned
    ;; inside the OP_NEW body, so every pressure site can re-pack the
    ;; [constructor, args_array] shape for a clean retry.
    (local $new_packed_pending i32)
    (local $new_spread_array_pointer i32)

    ;; The context object lives on the heap and can move under compaction.
    ;; STATE_CONTEXT_TABLE_POINTER points at the slot→pointer table (one
    ;; segment-relative context-object pointer per slot) — itself a heap
    ;; object that moves too; the cell is forwarded with it. Look up this
    ;; slot's current context-object address.
    (global.set $current_context_base
      (call $read_state
        (i32.add
          (call $read_state (global.get $STATE_CONTEXT_TABLE_POINTER))
          (i32.mul (local.get $context_slot) (i32.const 4)))))

    ;; Layout v8: the request block is per-context. Recompute the cache
    ;; each entry — the context object can move under JS-side compaction
    ;; between runs, exactly like $current_context_base above.
    (global.set $external_request_base
      (i32.add (global.get $current_context_base) (global.get $CTX_REQUEST_BLOCK)))

    ;; Load execution state
    (local.set $code_block (call $read_state (global.get $STATE_CODE_BLOCK)))
    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
    ;; Load current scope
    (global.set $current_scope (call $read_ctx (global.get $CTX_SCOPE)))

    ;; Reset the scope recycling cache. A collection (either collector,
    ;; JS-driven, between runs) may have moved or reclaimed cached dead
    ;; scopes; zeroing here makes stale heads unreachable before any
    ;; $scope_create can take from them.
    (global.set $scope_cache_list (i32.const 0))
    (global.set $scope_cache_pending (i32.const 0))

    ;; Refresh step ring metadata from STATE. resizeRegions() can move
    ;; the ring between run() calls, so this must not be cached at init.
    (global.set $step_ring_base (call $read_state (global.get $STATE_STEP_RING_BASE)))
    (local.set $i (call $read_state (global.get $STATE_STEP_RING_SIZE)))
    (if (i32.eqz (local.get $i))
      (then
        (global.set $step_ring_capacity (i32.const 0))
      )
      (else
        (global.set $step_ring_capacity
          (i32.div_u
            (i32.sub (local.get $i) (global.get $STEP_RING_HEADER_SIZE))
            (global.get $STEP_RING_ENTRY_SIZE)))
        (global.set $step_ring_write_head
          (i32.atomic.load (call $abs (global.get $step_ring_base))))
      )
    )

    ;; Clear the memory-pressure flag at function entry. The flag is
    ;; set by $intern_string / $string_concat when a bounds check
    ;; would overflow; the dispatcher exits on signal so the flag
    ;; never crosses an instruction boundary within a run, but it
    ;; can carry over from a previous run() that yielded. Clear
    ;; explicitly to make the contract independent of caller hygiene.
    (global.set $memory_pressure_signaled (i32.const 0))

    ;; Exit condition is OUTPUT only - never check it on entry.
    ;; The host decides when to call run(), not the interpreter.

    ;; If no code block set, done
    (if (i32.eqz (local.get $code_block))
      (then
        (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_DONE))
        (return (local.get $fuel))
      )
    )

    (local.set $instr_count (call $read_instr_count (local.get $code_block)))

    ;; Check RESPONSE_TYPE (host → interpreter signal for exceptions)
    ;; This handles external call rejections, grant denials, etc.
    (if (i32.eq (call $read_ctx (global.get $CTX_RESPONSE_TYPE)) (global.get $RESPONSE_THROW))
      (then
        ;; Clear response type
        (call $write_ctx (global.get $CTX_RESPONSE_TYPE) (global.get $RESPONSE_NORMAL))

        ;; Exception is on pending stack - save to completion value
        (local.set $value_pointer (call $pending_pop))
        (call $pending_push
          (call $value_type (local.get $value_pointer))
          (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 4))))
          (call $value_data_lo (local.get $value_pointer))
          (call $value_data_hi (local.get $value_pointer)))
        (call $save_completion_value)
        (drop (call $pending_pop))

        ;; Set completion type to throw
        (call $write_ctx (global.get $CTX_COMPLETION_TYPE) (global.get $COMPLETION_THROW))

        ;; Unified v11 handler walk (keep+disarm semantics).
        (if (call $throw_dispatch (i32.const 0) (i32.const 0) (i32.const 0))
          (then (return (local.get $fuel))))
        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
        ;; Handler found - pc is updated, continue to main loop
      )
    )

    ;; RESPONSE_RETURN (generator.return(v)): the
    ;; prepared value is on the pending stack; enter at the sentinel
    ;; RETURN so the v11 return walk runs the body's finallys and the
    ;; bottom-of-context return exits EXIT_GENERATOR_COMPLETE.
    (if (i32.eq (call $read_ctx (global.get $CTX_RESPONSE_TYPE)) (global.get $RESPONSE_RETURN))
      (then
        (call $write_ctx (global.get $CTX_RESPONSE_TYPE) (global.get $RESPONSE_NORMAL))
        (local.set $pc (i32.sub (local.get $instr_count) (i32.const 1)))
      )
    )

    ;; Main execution loop
    (block $exit
      (loop $loop
        ;; Check if we've reached the end (before fuel, so done wins over paused)
        (if (i32.ge_u (local.get $pc) (local.get $instr_count))
          (then
            ;; Persist the final pc, same as every other exit. Without
            ;; this, a completed slot's CTX_INSTRUCTION_INDEX still
            ;; holds whatever the last yield (or a host setInstruction/
            ;; grant finalize) wrote — a lie that snapshots persist and
            ;; that makes any stale re-drive of a done slot re-execute
            ;; code instead of immediately re-exiting done
            ;; after restoring the instruction pointer.

            (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
            (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
            (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_DONE))
            ;; NOTE: the final top-level expression's value is intentionally
            ;; left on the pending stack as the program result (the host/API
            ;; reads it). We do NOT reset the pending pointer here. The
            ;; pending_pop clamp (see $pending_pop) prevents the prior
            ;; underflow-past-base corruption that motivated an earlier reset.
            (br $exit)
          )
        )

        ;; Check fuel
        (if (i32.le_s (local.get $fuel) (i32.const 0))
          (then
            ;; Save state and pause
            (call $write_state (global.get $STATE_CODE_BLOCK) (local.get $code_block))
            (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
            (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
            (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_PAUSED_FUEL))
            (return (local.get $fuel))
          )
        )

        ;; Check that the heap has not overrun the code block. The code
        ;; block grows downward from STRING_START; the heap grows upward
        ;; from HEAP_START. If heap_pointer >= code_pointer, the heap has
        ;; (or is about to) corrupt bytecode. This is a per-instruction
        ;; check at the dispatcher level — catches WAT-side allocations
        ;; that bumped heap_pointer past code_pointer without a per-site
        ;; bounds check. See
        ;; BUGREPORT-gc-corrupts-state-during-sequential-await-loop.md.
        ;; NOTE: with the heap-slack safepoint below, reaching THIS check
        ;; means a single instruction carved through the whole slack
        ;; headroom unguarded — defense-in-depth only; the code block is
        ;; likely already corrupt if this fires
        ;; because this check detects a heap/code collision after writes.
        (if (i32.ge_u
              (call $read_state (global.get $STATE_HEAP_POINTER))
              (call $read_state (global.get $STATE_CODE_POINTER)))
          (then
            (global.set $current_executing_pc (local.get $pc))
            (call $fault_error (global.get $ERR_HEAP_CODE_COLLISION) (i32.const 0) (local.get $pc))
            (br $exit)
          )
        )

        ;; Per-instruction HEAP-SLACK safepoint (same design as the stack
        ;; safepoint below). Most heap
        ;; carves are bump-then-write with no per-site bounds check, and
        ;; the collision check above fires only AFTER a write has already
        ;; landed in the code block — detection after corruption. Instead:
        ;; before executing, require a slack of free span between
        ;; heap_pointer and code_pointer. Any instruction whose unguarded
        ;; carves total less than the slack can never reach code.
        ;; Yielding EXIT_MEMORY_PRESSURE saves pc so this instruction
        ;; re-runs after the host gcs; a heap that STAYS within the
        ;; slack of code after gc surfaces the host's own clean
        ;; no-progress error ("the single pending operation does not
        ;; fit") — the slack bytes are a red zone, never writable.
        ;; The slack SCALES with the vat: min(HEAP_SLACK_HEADROOM,
        ;; heap_span/16) — a 4MB production heap reserves the full 64KB,
        ;; a 64KB test heap reserves 4KB (a fixed 64KB would swallow
        ;; small vats whole; the heap-pressure test tier runs 64-96KB
        ;; heaps on purpose). Derived from existing STATE fields per
        ;; dispatch — no new layout field, nothing for snapshots to
        ;; carry. Size-parametrized carves that can exceed the slack in
        ;; ONE instruction (large arrays/objects/buffers, big-structure
        ;; doubling) still need per-site guards — the open sweep in the
        ;; BUG file.
        (local.set $heap_slack
          (i32.shr_u
            (i32.sub
              (call $read_state (global.get $STATE_HEAP_END))
              (call $read_state (global.get $STATE_HEAP_START)))
            (i32.const 4)))
        (if (i32.gt_u (local.get $heap_slack) (global.get $HEAP_SLACK_HEADROOM))
          (then (local.set $heap_slack (global.get $HEAP_SLACK_HEADROOM))))
        (if (i32.lt_u
              (i32.sub
                (call $read_state (global.get $STATE_CODE_POINTER))
                (call $read_state (global.get $STATE_HEAP_POINTER)))
              (local.get $heap_slack))
          (then
            (call $write_state (global.get $STATE_CODE_BLOCK) (local.get $code_block))
            (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
            (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
            (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
            (br $exit)))

        ;; Per-instruction stack-capacity safepoint (Design B). Each of the
        ;; four context stacks is a small heap block that grows on demand. A
        ;; single instruction adds at most a few entries to any one stack
        ;; (worst case: a reduce-callback continuation pushes 4 operands; a
        ;; call pushes 1 frame; try/grant push 1 entry). Before executing,
        ;; ensure each stack has slack for its worst single-instruction burst,
        ;; growing it if not. Growing is inline (bump the heap) in the common
        ;; case; only a genuinely full heap yields EXIT_MEMORY_PRESSURE, which
        ;; saves pc so this instruction re-runs after the host gcs. This is the
        ;; single chokepoint that makes every push site safe without per-opcode
        ;; capacity checks.
        (if (i32.or
              (i32.or
                (call $ensure_stack_capacity
                  (global.get $CTX_PENDING_BASE) (global.get $CTX_PENDING_LIMIT)
                  (global.get $CTX_PENDING_POINTER) (i32.const 64))    ;; 4 values
                (call $ensure_stack_capacity
                  (global.get $CTX_CALL_STACK_BASE) (global.get $CTX_CALL_STACK_LIMIT)
                  (global.get $CTX_CALL_STACK_POINTER) (global.get $FRAME_SIZE)))
              (i32.or
                (call $ensure_stack_capacity
                  (global.get $CTX_TRY_STACK_BASE) (global.get $CTX_TRY_STACK_LIMIT)
                  (global.get $CTX_TRY_STACK_POINTER) (global.get $TRY_ENTRY_SIZE))
                (call $ensure_stack_capacity
                  (global.get $CTX_GRANT_STACK_BASE) (global.get $CTX_GRANT_STACK_LIMIT)
                  (global.get $CTX_GRANT_STACK_POINTER) (global.get $GRANT_ENTRY_SIZE))))
          (then
            (call $write_state (global.get $STATE_CODE_BLOCK) (local.get $code_block))
            (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
            (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
            (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
            (br $exit)))

        ;; extends-externals D3: drain a staged construction abort BEFORE the
        ;; next instruction (typically a just-entered catch/finally handler)
        ;; executes. The airlock runs the registered abortConstruction and
        ;; resumes valuelessly at this same pc; a chained duty re-arms
        ;; CTX_CONSTRUCTION_DUTY so nested constructions abort in LIFO order.
        (if (i32.ne (call $read_ctx (global.get $CTX_CONSTRUCTION_DUTY)) (i32.const 0))
          (then
            (local.set $receiver_pointer (call $read_ctx (global.get $CTX_CONSTRUCTION_DUTY)))
            (call $write_ctx (global.get $CTX_CONSTRUCTION_DUTY) (i32.const 0))
            (local.set $entry_pointer (call $object_find_string_entry (local.get $receiver_pointer)
              (call $read_builtin (global.get $BUILTIN_EXTERNAL_BACKING))))
            ;; A receiver with no brand entry cannot name its registration —
            ;; structurally unreachable (the brand is written before PENDING
            ;; is ever set); skip rather than trap.
            (if (i32.ne (local.get $entry_pointer) (i32.const 0))
              (then
                ;; parent handle slot rides the brand entry's flags word (+1).
                (i32.store (call $abs (global.get $external_request_base))
                  (i32.sub (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 8)))) (i32.const 1)))
                (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 4)))
                  (call $read_builtin (global.get $BUILTIN_CONSTRUCT_ABORT)))
                (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 8))) (i32.const 0))
                (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 12))) (i32.const 0))
                (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 16))) (i32.const 0))
                (i32.store (call $abs (i32.add (global.get $external_request_base) (i32.const 20)))
                  (local.get $receiver_pointer))
                (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_EXTERNAL_CALL))
                (br $exit)
              )
            )
          )
        )

        ;; Fetch instruction
        (local.set $opcode (call $read_opcode (local.get $code_block) (local.get $pc)))
        (local.set $operand1 (call $read_operand1 (local.get $code_block) (local.get $pc)))
        (local.set $operand2 (call $read_operand2 (local.get $code_block) (local.get $pc)))

        ;; Diagnostic: stash PC so set_error can stamp the failing site.
        (global.set $current_executing_pc (local.get $pc))

        ;; Step ring: record instruction about to execute + current state
        (call $step_ring_write (local.get $context_slot) (local.get $pc) (local.get $opcode))

        ;; DIAGNOSTIC watchpoint: detect the type word at pending base+0
        ;; flipping to TYPE_ARRAY while the operand stack is non-empty.
        ;; The sentinel (pc 0xFEFE) lands in the ring right AFTER the
        ;; writer's entry.
        (if (global.get $watch_pending_enabled)
          (then
            (local.set $watch_current_type
              (i32.load (call $abs (call $read_ctx (global.get $CTX_PENDING_BASE)))))
            (if (i32.ne (local.get $watch_current_type) (global.get $watch_pending_prev_type))
              (then
                (if (i32.and
                      (i32.eq (local.get $watch_current_type) (global.get $TYPE_ARRAY))
                      (i32.gt_u
                        (call $read_ctx (global.get $CTX_PENDING_POINTER))
                        (call $read_ctx (global.get $CTX_PENDING_BASE))))
                  (then
                    (call $step_ring_write (local.get $context_slot)
                      (i32.const 0xFEFE) (i32.const 0xFE))))
                (global.set $watch_pending_prev_type (local.get $watch_current_type))))))

        ;; Decode and execute
        ;; =====================================================================
        ;; LITERALS
        ;; =====================================================================
        ;; Note: LIT_INT is no longer emitted by parser (all numbers are f64)
        ;; Keep handler for backwards compatibility with any existing bytecode

        (if (i32.eq (local.get $opcode) (global.get $OP_LIT_FLOAT))
          (then
            (call $pending_push (global.get $TYPE_FLOAT) (i32.const 0) (local.get $operand1) (local.get $operand2))
            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        (if (i32.eq (local.get $opcode) (global.get $OP_LIT_STRING))
          (then
            (call $pending_push (global.get $TYPE_STRING) (i32.const 0) (local.get $operand1) (i32.const 0))
            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        (if (i32.eq (local.get $opcode) (global.get $OP_LIT_NULL))
          (then
            (call $pending_push (global.get $TYPE_NULL) (i32.const 0) (i32.const 0) (i32.const 0))
            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        (if (i32.eq (local.get $opcode) (global.get $OP_LIT_UNDEFINED))
          (then
            (call $pending_push (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))
            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        (if (i32.eq (local.get $opcode) (global.get $OP_LIT_TRUE))
          (then
            (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (i32.const 1) (i32.const 0))
            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        (if (i32.eq (local.get $opcode) (global.get $OP_LIT_FALSE))
          (then
            (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (i32.const 0) (i32.const 0))
            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; LIT_BIGINT: push BigInt value (operand1 = heap header pointer)
        (if (i32.eq (local.get $opcode) (global.get $OP_LIT_BIGINT))
          (then
            (call $pending_push (global.get $TYPE_BIGINT) (i32.const 0) (local.get $operand1) (i32.const 0))
            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; LIT_RATIONAL_INTEGER: push inline small-Rational (operand1,2 = i64 numerator lo/hi)
        (if (i32.eq (local.get $opcode) (global.get $OP_LIT_RATIONAL_INTEGER))
          (then
            (call $pending_push
              (global.get $TYPE_RATIONAL)
              (global.get $FLAG_RATIONAL_INLINE)
              (local.get $operand1)
              (local.get $operand2))
            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; LIT_RATIONAL_BIGINT: push heap Rational with integer value
        ;; (operand1 = BigInt header pointer; denominator implicitly 1).
        (if (i32.eq (local.get $opcode) (global.get $OP_LIT_RATIONAL_BIGINT))
          (then
            (call $pending_push
              (global.get $TYPE_RATIONAL)
              (i32.const 0)
              (call $rational_allocate (local.get $operand1) (call $bigint_one))
              (i32.const 0))
            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; LIT_WELL_KNOWN_SYMBOL: push a canonical well-known symbol value.
        ;; operand1 = 0 → Symbol.iterator, 1 → Symbol.asyncIterator,
        ;; 2 → Symbol.toStringTag.
        ;; The symbol pointer is read from STATE (written at bootstrap).
        (if (i32.eq (local.get $opcode) (global.get $OP_LIT_WELL_KNOWN_SYMBOL))
          (then
            (if (i32.eqz (local.get $operand1))
              (then
                (call $pending_push
                  (global.get $TYPE_SYMBOL)
                  (i32.const 0)
                  (call $read_state (global.get $STATE_WELL_KNOWN_ITERATOR_SYMBOL))
                  (i32.const 0)))
              (else
                (if (i32.eq (local.get $operand1) (i32.const 1))
                  (then
                    (call $pending_push
                      (global.get $TYPE_SYMBOL)
                      (i32.const 0)
                      (call $read_state (global.get $STATE_WELL_KNOWN_ASYNC_ITERATOR_SYMBOL))
                      (i32.const 0)))
                  (else
                    (call $pending_push
                      (global.get $TYPE_SYMBOL)
                      (i32.const 0)
                      (call $read_state (global.get $STATE_WELL_KNOWN_TO_STRING_TAG_SYMBOL))
                      (i32.const 0))))))
            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )
        ;; =====================================================================
        ;; LIT_REGEXP: compile operand1's pattern (string id) with operand2's
        ;; flag bitfield through the statically imported regex engine and
        ;; push a TYPE_REGEXP descriptor. Resumable: a mid-compile fuel
        ;; exhaustion parks the engine workspaces in CTX_REGEX_STATE and
        ;; re-dispatches this same pc on the next grant; memory pressure
        ;; yields without consuming anything and retries the current phase.
        ;; =====================================================================
        (if (i32.eq (local.get $opcode) (global.get $OP_LIT_REGEXP))
          (then
            (global.set $current_executing_pc (local.get $pc))
            (call $lit_regexp_step
              (local.get $operand1) (local.get $operand2) (local.get $fuel))
            (local.set $fuel)
            (local.set $result_i32)
            ;; 0 = done: value pushed, advance.
            (if (i32.eqz (local.get $result_i32))
              (then
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (br $loop)))
            ;; 1 = paused on fuel: state saved; the loop head pauses at
            ;; this pc with the engine's remaining (zero) fuel.
            (if (i32.eq (local.get $result_i32) (i32.const 1))
              (then
                (local.set $fuel (i32.const 0))
                (br $loop)))
            ;; 2 = memory pressure: yield for gc-and-retry of this pc.
            (if (i32.eq (local.get $result_i32) (i32.const 2))
              (then
                (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                (br $exit)))
            ;; 4 = thrown and caught: continue at the handler.
            (if (i32.eq (local.get $result_i32) (i32.const 4))
              (then
                (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                (br $loop)))
            ;; 3 = thrown and uncaught (or substrate fault).
            (br $exit)
          )
        )


        ;; =====================================================================
        ;; VARIABLES
        ;; =====================================================================
        (if (i32.eq (local.get $opcode) (global.get $OP_GET_VAR))
          (then
            ;; Look up variable
            (local.set $value_pointer (call $scope_lookup (global.get $current_scope) (local.get $operand1)))
            (if (i32.eqz (local.get $value_pointer))
              (then
                ;; Proof is a native, pointer-free global namespace. Resolve
                ;; it here rather than injecting a host-side prelude or
                ;; extending the host-built builtin object image.
                (if (call $proof_native_identifier_is_proof (local.get $operand1))
                  (then
                    (call $pending_push
                      (global.get $TYPE_PROOF_NAMESPACE)
                      (i32.const 0)
                      (global.get $PROOF_NAMESPACE_ROOT)
                      (i32.const 0))
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)))
                (if (call $throw_reference_error_with_name
                      (global.get $BUILTIN_MSG_NOT_DEFINED)
                      (local.get $operand1))
                  (then (br $exit))
                  (else
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)))))
            ;; Check if TYPE_MSGPACK_REF
            (local.set $type1 (i32.load (call $abs (local.get $value_pointer))))
            (if (i32.eq (local.get $type1) (global.get $TYPE_MSGPACK_REF))
              (then
                ;; Layout A: data_lo = parent_data_ptr, data_hi = offset
                (local.set $data1_lo (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 8)))))
                (local.set $data1_hi (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 12)))))
                ;; Peek the type to determine if scalar or container
                (local.set $mp_type (call $msgpack_peek_type
                  (call $msgpack_ref_absolute (local.get $data1_lo) (local.get $data1_hi))
                  (call $msgpack_ref_parent_end (local.get $data1_lo))))
                (if (i32.eq (local.get $mp_type) (global.get $MSGPACK_ERROR))
                  (then
                    (if (call $raise_error (global.get $ERR_MSGPACK_INVALID) (i32.const 0))
                      (then (br $exit)))
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)
                  )
                )
                ;; For direct types (nil, bool, int, float, string, bin),
                ;; read the value
                (if (call $msgpack_is_direct_type (local.get $mp_type))
                  (then
                    ;; Read primitive directly to pending stack
                    (if (i32.eq (call $msgpack_read_primitive
                                  (call $msgpack_ref_absolute (local.get $data1_lo) (local.get $data1_hi))
                                  (call $msgpack_ref_parent_end (local.get $data1_lo)))
                                (i32.const -1))
                      (then
                        ;; -1 with the pressure flag = a refused
                        ;; allocation (string intern or bin
                        ;; materialization): yield and retry this
                        ;; instruction — nothing was pushed or consumed.
                        ;; -1 with the flag clear = malformed input.
                        (if (global.get $memory_pressure_signaled)
                          (then
                            (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                            (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                            (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                            (br $exit)
                          )
                        )
                        (if (call $raise_error (global.get $ERR_MSGPACK_INVALID) (i32.const 1))
                          (then (br $exit)))
                        (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                        (br $loop)
                      )
                    )
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)
                  )
                )
                ;; For containers (array, map), keep as TYPE_MSGPACK_REF (same data_lo/data_hi)
                (call $pending_push
                  (global.get $TYPE_MSGPACK_REF)
                  (i32.const 0)
                  (local.get $data1_lo)
                  (local.get $data1_hi))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )
            ;; Push value to pending stack (non-msgpack case). Mask out the
            ;; binding-level SCOPE_FLAG_CONST (bit 31) — the pushed VALUE's
            ;; flags word must carry only value-level flags (a const-bound
            ;; method's receiver type would otherwise read as
            ;; type | 0x80000000 at dispatch).
            (call $pending_push
              (i32.load (call $abs (local.get $value_pointer)))
              (i32.and
                (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 4))))
                (i32.const 0x7FFFFFFF))
              (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 8))))
              (i32.load (call $abs (i32.add (local.get $value_pointer) (i32.const 12)))))
            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        (if (i32.eq (local.get $opcode) (global.get $OP_SET_VAR))
          (then
            ;; Pop value
            (local.set $value_pointer (call $pending_pop))
            (local.set $type1 (call $value_type (local.get $value_pointer)))
            (local.set $data1_lo (call $value_data_lo (local.get $value_pointer)))
            (local.set $data1_hi (call $value_data_hi (local.get $value_pointer)))

            ;; Set in scope chain. Preserve value-level flags (e.g.
            ;; FLAG_RATIONAL_INLINE) by reading them from the source value;
            ;; $scope_set ignores scope flags on assignment (it cares only
            ;; about whether the existing entry is const).
            (local.set $found (call $scope_set
              (global.get $current_scope)
              (local.get $operand1)
              (local.get $type1)
              (call $value_flags (local.get $value_pointer))
              (local.get $data1_lo)
              (local.get $data1_hi)))

            (if (i32.eqz (local.get $found))
              (then
                ;; Check if error was already set (e.g., const assignment)
                (if (i32.eq (call $read_ctx (global.get $CTX_EXIT_CONDITION)) (global.get $EXIT_ERROR))
                  (then
                    (if (call $throw_from_set_error)
                      (then (br $exit)))
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)))
                ;; Otherwise, variable not found
                (if (call $raise_error (global.get $ERR_ASSIGN_UNDEFINED) (local.get $operand1))
                  (then (br $exit)))
                (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                (br $loop)
              )
            )

            ;; Push value back (assignment is an expression). Preserve flags.
            (call $pending_push (local.get $type1) (call $value_flags (local.get $value_pointer)) (local.get $data1_lo) (local.get $data1_hi))
            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        (if (i32.eq (local.get $opcode) (global.get $OP_LET_VAR))
          (then
            ;; Pressure pre-check: $scope_define may grow the entries block
            ;; if count >= capacity. Worst case: allocate a doubled entries
            ;; block. Reading current_scope's capacity (offset 8 from the
            ;; scope data pointer; the data pointer is what $current_scope
            ;; stores, post-GC-header).
            (if (call $check_heap_overflow
                  (call $estimate_scope_grow_size
                    (i32.load (call $abs
                      (i32.add (global.get $current_scope) (i32.const 8))))))
              (then
                (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                (br $exit)))

            ;; Pop value
            (local.set $value_pointer (call $pending_pop))

            ;; Define in current scope. Operand2 contains scope flags
            ;; (e.g. SCOPE_FLAG_CONST). These live in the low byte. Value-level
            ;; flags (e.g. FLAG_RATIONAL_INLINE) live in higher bits and must
            ;; be preserved across the copy into the scope entry.
            (call $scope_define
              (global.get $current_scope)
              (local.get $operand1)
              (call $value_type (local.get $value_pointer))
              (i32.or (local.get $operand2) (call $value_flags (local.get $value_pointer)))
              (call $value_data_lo (local.get $value_pointer))
              (call $value_data_hi (local.get $value_pointer)))

            ;; Check if redeclaration error occurred
            (if (i32.eq (call $read_ctx (global.get $CTX_EXIT_CONDITION)) (global.get $EXIT_ERROR))
              (then
                (if (call $throw_from_set_error)
                  (then (br $exit)))
                (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                (br $loop)))

            (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
            (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
            (br $loop)
          )
        )

        ;; =====================================================================
        ;; ARITHMETIC (f64 - JS semantics: all numbers are floats)
        ;; =====================================================================
        (if (i32.eq (local.get $opcode) (global.get $OP_ADD))
          (then
            ;; Peek operands without popping. The string-allocating
            ;; branches may signal memory pressure deep inside the
            ;; helper chain; we must leave the pending stack untouched
            ;; until we're committed to the result. Numeric branches
            ;; (float/bigint/rational/complex) don't allocate strings,
            ;; so for them the late-pop reorder is purely cosmetic.
            (local.set $value_pointer2
              (i32.sub
                (call $read_ctx (global.get $CTX_PENDING_POINTER))
                (global.get $VALUE_SIZE)))
            (local.set $value_pointer
              (i32.sub
                (call $read_ctx (global.get $CTX_PENDING_POINTER))
                (i32.mul (global.get $VALUE_SIZE) (i32.const 2))))
            (local.set $type1 (call $value_type (local.get $value_pointer)))
            (local.set $type2 (call $value_type (local.get $value_pointer2)))

            ;; Ring 2: Symbol and Expression reject implicit coercion on +.
            ;; Symbol behavior matches JS spec; Expression is a math-domain
            ;; value with no meaningful implicit conversion — user must call
            ;; Exact.Expression.add(...) explicitly. Runs before string-concat
            ;; so 'x' + Symbol('y') or 'x' + expression throw rather than
            ;; silently stringifying.
            (if (i32.or
                  (i32.or
                    (i32.eq (local.get $type1) (global.get $TYPE_SYMBOL))
                    (i32.eq (local.get $type2) (global.get $TYPE_SYMBOL)))
                  (i32.or
                    (i32.eq (local.get $type1) (global.get $TYPE_EXPRESSION))
                    (i32.eq (local.get $type2) (global.get $TYPE_EXPRESSION))))
              (then
                ;; Pop here — type-error path consumes operands and either
                ;; throws (br $exit on uncaught) or replaces the pending
                ;; top with an exception value.
                (drop (call $pending_pop))
                (drop (call $pending_pop))
                (if (call $throw_type_error)
                  (then (br $exit))
                  (else
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)
                  )
                )
              )
            )

            ;; Float + Float (no string allocation)
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_FLOAT))
                  (i32.eq (local.get $type2) (global.get $TYPE_FLOAT)))
              (then
                (local.set $result_f64
                  (f64.add
                    (call $read_f64 (local.get $value_pointer))
                    (call $read_f64 (local.get $value_pointer2))))
                (drop (call $pending_pop))
                (drop (call $pending_pop))
                (call $push_f64 (local.get $result_f64))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; String + String concatenation
            ;;
            ;; Chokepoint design: $string_concat (and the $intern_string
            ;; it calls) self-signal memory pressure on overflow. After
            ;; the call, the dispatcher checks $memory_pressure_signaled
            ;; and yields without popping operands. Resume re-enters the
            ;; same pressure-sensitive string operation.

            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_STRING))
                  (i32.eq (local.get $type2) (global.get $TYPE_STRING)))
              (then
                (local.set $result_i32
                  (call $string_concat
                    (call $value_data_lo (local.get $value_pointer))
                    (call $value_data_lo (local.get $value_pointer2))))
                (if (global.get $memory_pressure_signaled)
                  (then
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)
                  )
                )
                (drop (call $pending_pop))
                (drop (call $pending_pop))
                (call $pending_push
                  (global.get $TYPE_STRING)
                  (i32.const 0)
                  (local.get $result_i32)
                  (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; String + other (coerce to string) - left is string
            ;;
            ;; $value_to_string for non-trivial types (rational, complex)
            ;; uses the pending stack as scratch — but here we haven't
            ;; popped, so $value_pointer / $value_pointer2 point into
            ;; the *occupied* stack region. $complex_to_decimal's
            ;; $push_rational calls would write above pp, NOT
            ;; clobbering our peeked slots. Safe.
            ;;
            ;; Chokepoint: after $string_concat returns, check the
            ;; pressure flag. If set, yield without popping.
            (if (i32.eq (local.get $type1) (global.get $TYPE_STRING))
              (then
                (local.set $left_id (call $value_data_lo (local.get $value_pointer)))
                (local.set $coerced_id (call $value_to_string (local.get $value_pointer2)))
                (if (global.get $memory_pressure_signaled)
                  (then
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)
                  )
                )
                (local.set $result_i32
                  (call $string_concat (local.get $left_id) (local.get $coerced_id)))
                (if (global.get $memory_pressure_signaled)
                  (then
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)
                  )
                )
                (drop (call $pending_pop))
                (drop (call $pending_pop))
                (call $pending_push
                  (global.get $TYPE_STRING)
                  (i32.const 0)
                  (local.get $result_i32)
                  (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; other + String (coerce to string) - right is string
            ;; Symmetric to the previous branch.
            (if (i32.eq (local.get $type2) (global.get $TYPE_STRING))
              (then
                (local.set $left_id (call $value_data_lo (local.get $value_pointer2)))
                (local.set $coerced_id (call $value_to_string (local.get $value_pointer)))
                (if (global.get $memory_pressure_signaled)
                  (then
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)
                  )
                )
                (local.set $result_i32
                  (call $string_concat (local.get $coerced_id) (local.get $left_id)))
                (if (global.get $memory_pressure_signaled)
                  (then
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)
                  )
                )
                (drop (call $pending_pop))
                (drop (call $pending_pop))
                (call $pending_push
                  (global.get $TYPE_STRING)
                  (i32.const 0)
                  (local.get $result_i32)
                  (i32.const 0))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Ring 7 exact complex-algebraic arithmetic, including the first
            ;; crossing between a legacy rational Complex and AlgebraicNumber.
            (if (call $complex_algebraic_pair_dispatchable
                  (local.get $type1) (local.get $type2))
              (then
                (local.set $result_i32 (call $complex_algebraic_operator_arith
                  (i32.const 0) (local.get $value_pointer) (local.get $value_pointer2)))
                (if (i32.eq (local.get $result_i32) (i32.const 1))
                  (then
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)))
                (if (i32.eq (local.get $result_i32) (i32.const 3))
                  (then (br $exit)))
                (if (i32.eq (local.get $result_i32) (i32.const 2))
                  (then
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)))
            ;; AlgebraicNumber arithmetic (Ring 6b): exact tower
            ;; dispatch over {AlgebraicNumber, Rational, BigInt}
            ;; pairs. The engine guards every allocation itself; on
            ;; pressure nothing has been consumed and the retry
            ;; re-runs the opcode. Float/Complex mixes fall through
            ;; to the coercion-refuse TypeError below.
            (if (call $algebraic_pair_dispatchable (local.get $type1) (local.get $type2))
              (then
                (local.set $result_i32 (call $algebraic_operator_arith
                  (i32.const 0) (local.get $value_pointer) (local.get $value_pointer2)))
                (if (i32.eq (local.get $result_i32) (i32.const 1))
                  (then
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)))
                (if (i32.eq (local.get $result_i32) (i32.const 3))
                  (then (br $exit)))
                (if (i32.eq (local.get $result_i32) (i32.const 2))
                  (then
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)))

            ;; The remaining branches (BigInt/Rational/Complex/Object,
            ;; etc.) are non-string. Before they pop their operands, do
            ;; the heap-pressure pre-check appropriate to the operand
            ;; types. The peek-pointers (value_pointer/value_pointer2)
            ;; from the top of OP_ADD still address the un-popped
            ;; operands. On overflow, restore pc/scope and yield WITHOUT
            ;; touching the pending stack — retry re-runs OP_ADD.
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_BIGINT))
                  (i32.eq (local.get $type2) (global.get $TYPE_BIGINT)))
              (then
                (if (call $check_heap_overflow
                      (call $estimate_bigint_add_budget
                        (local.get $value_pointer) (local.get $value_pointer2)))
                  (then
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)))))
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_RATIONAL))
                  (i32.eq (local.get $type2) (global.get $TYPE_RATIONAL)))
              (then
                ;; Heap path runs only when at least one operand is non-
                ;; inline OR the inline-overflow fallback fires. Both
                ;; cases need the same conservative budget; pre-check
                ;; unconditionally so the inline-fast-path's small
                ;; overhead is one extra arithmetic comparison.
                (if (call $check_heap_overflow
                      (call $estimate_rational_add_budget
                        (local.get $value_pointer) (local.get $value_pointer2)))
                  (then
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)))))
            ;; Cross-type combos: rational/bigint, bigint/rational,
            ;; complex/anything. Uses the type-agnostic
            ;; $estimate_cross_type_arith_budget which handles all
            ;; cases (promotion + arithmetic + complex doubling).
            (if (i32.or
                  (i32.or
                    (i32.and
                      (i32.eq (local.get $type1) (global.get $TYPE_RATIONAL))
                      (i32.eq (local.get $type2) (global.get $TYPE_BIGINT)))
                    (i32.and
                      (i32.eq (local.get $type1) (global.get $TYPE_BIGINT))
                      (i32.eq (local.get $type2) (global.get $TYPE_RATIONAL))))
                  (i32.or
                    (i32.eq (local.get $type1) (global.get $TYPE_COMPLEX))
                    (i32.eq (local.get $type2) (global.get $TYPE_COMPLEX))))
              (then
                (if (call $check_heap_overflow
                      (call $estimate_cross_type_arith_budget
                        (local.get $value_pointer) (local.get $value_pointer2)))
                  (then
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)))))

            (local.set $value_pointer2 (call $pending_pop))
            (local.set $value_pointer (call $pending_pop))

            ;; BigInt + BigInt
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_BIGINT))
                  (i32.eq (local.get $type2) (global.get $TYPE_BIGINT)))
              (then
                (call $push_bigint
                  (call $bigint_add
                    (call $value_data_lo (local.get $value_pointer))
                    (call $value_data_lo (local.get $value_pointer2))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Complex + Complex
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_COMPLEX))
                  (i32.eq (local.get $type2) (global.get $TYPE_COMPLEX)))
              (then
                (call $push_complex
                  (call $complex_add
                    (call $value_data_lo (local.get $value_pointer))
                    (call $value_data_lo (local.get $value_pointer2))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Complex + Rational → promote Rational to Complex
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_COMPLEX))
                  (i32.eq (local.get $type2) (global.get $TYPE_RATIONAL)))
              (then
                (call $push_complex
                  (call $complex_add
                    (call $value_data_lo (local.get $value_pointer))
                    (call $complex_from_rational
                      (call $rational_materialize (local.get $value_pointer2)))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Rational + Complex → promote Rational to Complex
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_RATIONAL))
                  (i32.eq (local.get $type2) (global.get $TYPE_COMPLEX)))
              (then
                (call $push_complex
                  (call $complex_add
                    (call $complex_from_rational
                      (call $rational_materialize (local.get $value_pointer)))
                    (call $value_data_lo (local.get $value_pointer2))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Complex + BigInt → promote BigInt to Complex (via Rational)
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_COMPLEX))
                  (i32.eq (local.get $type2) (global.get $TYPE_BIGINT)))
              (then
                (call $push_complex
                  (call $complex_add
                    (call $value_data_lo (local.get $value_pointer))
                    (call $complex_from_rational
                      (call $rational_from_bigint
                        (call $value_data_lo (local.get $value_pointer2))))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; BigInt + Complex → promote BigInt to Complex
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_BIGINT))
                  (i32.eq (local.get $type2) (global.get $TYPE_COMPLEX)))
              (then
                (call $push_complex
                  (call $complex_add
                    (call $complex_from_rational
                      (call $rational_from_bigint
                        (call $value_data_lo (local.get $value_pointer))))
                    (call $value_data_lo (local.get $value_pointer2))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Complex + Float / Float + Complex → TypeError
            (if (i32.or
                  (i32.and
                    (i32.eq (local.get $type1) (global.get $TYPE_COMPLEX))
                    (i32.eq (local.get $type2) (global.get $TYPE_FLOAT)))
                  (i32.and
                    (i32.eq (local.get $type1) (global.get $TYPE_FLOAT))
                    (i32.eq (local.get $type2) (global.get $TYPE_COMPLEX))))
              (then
                (if (call $throw_type_error_with_type (global.get $BUILTIN_MSG_MIXED_BIGINT) (local.get $type1))
                  (then (br $exit))
                  (else
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)
                  )
                )
              )
            )

            ;; Rational + Rational
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_RATIONAL))
                  (i32.eq (local.get $type2) (global.get $TYPE_RATIONAL)))
              (then
                ;; Inline + inline fast path: i64 arithmetic with overflow check.
                (if (i32.and
                      (call $rational_is_inline (local.get $value_pointer))
                      (call $rational_is_inline (local.get $value_pointer2)))
                  (then
                    (local.set $result_i64 (i64.add
                      (call $rational_read_inline (local.get $value_pointer))
                      (call $rational_read_inline (local.get $value_pointer2))))
                    ;; Overflow: if both inputs same sign and result has opposite sign.
                    (if (call $i64_add_overflowed
                          (call $rational_read_inline (local.get $value_pointer))
                          (call $rational_read_inline (local.get $value_pointer2))
                          (local.get $result_i64))
                      (then
                        ;; Fall through to heap path (materialize both)
                        (call $push_rational
                          (call $rational_add
                            (call $rational_materialize (local.get $value_pointer))
                            (call $rational_materialize (local.get $value_pointer2))))
                        (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                        (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                        (br $loop)))
                    (call $push_rational_inline (local.get $result_i64))
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)))
                ;; Heap path: materialize any inline inputs, then use $rational_add.
                (call $push_rational
                  (call $rational_add
                    (call $rational_materialize (local.get $value_pointer))
                    (call $rational_materialize (local.get $value_pointer2))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Rational + BigInt → promote BigInt to Rational, result Rational
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_RATIONAL))
                  (i32.eq (local.get $type2) (global.get $TYPE_BIGINT)))
              (then
                (call $push_rational
                  (call $rational_add
                    (call $rational_materialize (local.get $value_pointer))
                    (call $rational_from_bigint
                      (call $value_data_lo (local.get $value_pointer2)))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; BigInt + Rational → promote BigInt to Rational, result Rational
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_BIGINT))
                  (i32.eq (local.get $type2) (global.get $TYPE_RATIONAL)))
              (then
                (call $push_rational
                  (call $rational_add
                    (call $rational_from_bigint
                      (call $value_data_lo (local.get $value_pointer)))
                    (call $rational_materialize (local.get $value_pointer2))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Rational + Float — contagion rule: approximate Rational as f64, add as Float.
            (if (i32.or
                  (i32.and
                    (i32.eq (local.get $type1) (global.get $TYPE_RATIONAL))
                    (i32.eq (local.get $type2) (global.get $TYPE_FLOAT)))
                  (i32.and
                    (i32.eq (local.get $type1) (global.get $TYPE_FLOAT))
                    (i32.eq (local.get $type2) (global.get $TYPE_RATIONAL))))
              (then
                (call $push_f64
                  (f64.add
                    (call $value_to_f64 (local.get $value_pointer))
                    (call $value_to_f64 (local.get $value_pointer2))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; BigInt + Number or Number + BigInt → TypeError
            (if (i32.or
                  (i32.and
                    (i32.eq (local.get $type1) (global.get $TYPE_BIGINT))
                    (i32.eq (local.get $type2) (global.get $TYPE_FLOAT)))
                  (i32.and
                    (i32.eq (local.get $type1) (global.get $TYPE_FLOAT))
                    (i32.eq (local.get $type2) (global.get $TYPE_BIGINT))))
              (then
                (if (call $throw_type_error_with_type (global.get $BUILTIN_MSG_MIXED_BIGINT) (local.get $type1))
                  (then (br $exit))
                  (else
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)
                  )
                )
              )
            )

            (if (call $raise_error (global.get $ERR_INVALID_OPERAND) (i32.const 0))
              (then (br $exit)))
            (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
            (br $loop)
          )
        )

        (if (i32.eq (local.get $opcode) (global.get $OP_SUB))
          (then
            ;; Peek operands first so we can pre-check heap pressure.
            (local.set $value_pointer2
              (i32.sub
                (call $read_ctx (global.get $CTX_PENDING_POINTER))
                (global.get $VALUE_SIZE)))
            (local.set $value_pointer
              (i32.sub
                (call $read_ctx (global.get $CTX_PENDING_POINTER))
                (i32.mul (global.get $VALUE_SIZE) (i32.const 2))))
            (call $coerce_to_number_at (local.get $value_pointer))
            (call $coerce_to_number_at (local.get $value_pointer2))
            (local.set $type1 (call $value_type (local.get $value_pointer)))
            (local.set $type2 (call $value_type (local.get $value_pointer2)))

            ;; Symbol / Expression refuse numeric coercion (JS spec for
            ;; Symbol; Ring 2 math-domain rule for Expression) — throw
            ;; the same messaged TypeError as unary +/- instead of the
            ;; message-less INVALID_OPERAND fallthrough.
            (if (i32.or
                  (i32.or
                    (i32.eq (local.get $type1) (global.get $TYPE_SYMBOL))
                    (i32.eq (local.get $type1) (global.get $TYPE_EXPRESSION)))
                  (i32.or
                    (i32.eq (local.get $type2) (global.get $TYPE_SYMBOL))
                    (i32.eq (local.get $type2) (global.get $TYPE_EXPRESSION))))
              (then
                (drop (call $pending_pop))
                (drop (call $pending_pop))
                (if (call $throw_type_error_with_type
                      (global.get $BUILTIN_MSG_CANNOT_CONVERT_TO_NUMBER)
                      (select (local.get $type1) (local.get $type2)
                        (i32.or
                          (i32.eq (local.get $type1) (global.get $TYPE_SYMBOL))
                          (i32.eq (local.get $type1) (global.get $TYPE_EXPRESSION)))))
                  (then (br $exit))
                  (else
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)))))

            (if (call $complex_algebraic_pair_dispatchable
                  (local.get $type1) (local.get $type2))
              (then
                (local.set $result_i32 (call $complex_algebraic_operator_arith
                  (i32.const 1) (local.get $value_pointer) (local.get $value_pointer2)))
                (if (i32.eq (local.get $result_i32) (i32.const 1))
                  (then
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)))
                (if (i32.eq (local.get $result_i32) (i32.const 3))
                  (then (br $exit)))
                (if (i32.eq (local.get $result_i32) (i32.const 2))
                  (then
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)))
            ;; AlgebraicNumber arithmetic (Ring 6b) — see OP_ADD.
            (if (call $algebraic_pair_dispatchable (local.get $type1) (local.get $type2))
              (then
                (local.set $result_i32 (call $algebraic_operator_arith
                  (i32.const 1) (local.get $value_pointer) (local.get $value_pointer2)))
                (if (i32.eq (local.get $result_i32) (i32.const 1))
                  (then
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)))
                (if (i32.eq (local.get $result_i32) (i32.const 3))
                  (then (br $exit)))
                (if (i32.eq (local.get $result_i32) (i32.const 2))
                  (then
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)))

            ;; Pre-check by type. Operands stay on stack — retry re-runs
            ;; OP_SUB. Same budget pattern as OP_ADD.
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_BIGINT))
                  (i32.eq (local.get $type2) (global.get $TYPE_BIGINT)))
              (then
                (if (call $check_heap_overflow
                      (call $estimate_bigint_add_budget
                        (local.get $value_pointer) (local.get $value_pointer2)))
                  (then
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)))))
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_RATIONAL))
                  (i32.eq (local.get $type2) (global.get $TYPE_RATIONAL)))
              (then
                (if (call $check_heap_overflow
                      (call $estimate_rational_add_budget
                        (local.get $value_pointer) (local.get $value_pointer2)))
                  (then
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)))))
            ;; Cross-type combos (rational/bigint, complex/anything).
            (if (i32.or
                  (i32.or
                    (i32.and
                      (i32.eq (local.get $type1) (global.get $TYPE_RATIONAL))
                      (i32.eq (local.get $type2) (global.get $TYPE_BIGINT)))
                    (i32.and
                      (i32.eq (local.get $type1) (global.get $TYPE_BIGINT))
                      (i32.eq (local.get $type2) (global.get $TYPE_RATIONAL))))
                  (i32.or
                    (i32.eq (local.get $type1) (global.get $TYPE_COMPLEX))
                    (i32.eq (local.get $type2) (global.get $TYPE_COMPLEX))))
              (then
                (if (call $check_heap_overflow
                      (call $estimate_cross_type_arith_budget
                        (local.get $value_pointer) (local.get $value_pointer2)))
                  (then
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)))))

            (local.set $value_pointer2 (call $pending_pop))
            (local.set $value_pointer (call $pending_pop))

            ;; BigInt - BigInt
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_BIGINT))
                  (i32.eq (local.get $type2) (global.get $TYPE_BIGINT)))
              (then
                (call $push_bigint
                  (call $bigint_sub
                    (call $value_data_lo (local.get $value_pointer))
                    (call $value_data_lo (local.get $value_pointer2))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Complex - Complex
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_COMPLEX))
                  (i32.eq (local.get $type2) (global.get $TYPE_COMPLEX)))
              (then
                (call $push_complex
                  (call $complex_sub
                    (call $value_data_lo (local.get $value_pointer))
                    (call $value_data_lo (local.get $value_pointer2))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Complex - Rational
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_COMPLEX))
                  (i32.eq (local.get $type2) (global.get $TYPE_RATIONAL)))
              (then
                (call $push_complex
                  (call $complex_sub
                    (call $value_data_lo (local.get $value_pointer))
                    (call $complex_from_rational
                      (call $rational_materialize (local.get $value_pointer2)))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Rational - Complex
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_RATIONAL))
                  (i32.eq (local.get $type2) (global.get $TYPE_COMPLEX)))
              (then
                (call $push_complex
                  (call $complex_sub
                    (call $complex_from_rational
                      (call $rational_materialize (local.get $value_pointer)))
                    (call $value_data_lo (local.get $value_pointer2))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Complex - BigInt
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_COMPLEX))
                  (i32.eq (local.get $type2) (global.get $TYPE_BIGINT)))
              (then
                (call $push_complex
                  (call $complex_sub
                    (call $value_data_lo (local.get $value_pointer))
                    (call $complex_from_rational
                      (call $rational_from_bigint
                        (call $value_data_lo (local.get $value_pointer2))))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; BigInt - Complex
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_BIGINT))
                  (i32.eq (local.get $type2) (global.get $TYPE_COMPLEX)))
              (then
                (call $push_complex
                  (call $complex_sub
                    (call $complex_from_rational
                      (call $rational_from_bigint
                        (call $value_data_lo (local.get $value_pointer))))
                    (call $value_data_lo (local.get $value_pointer2))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Complex / Float mix → TypeError
            (if (i32.or
                  (i32.and
                    (i32.eq (local.get $type1) (global.get $TYPE_COMPLEX))
                    (i32.eq (local.get $type2) (global.get $TYPE_FLOAT)))
                  (i32.and
                    (i32.eq (local.get $type1) (global.get $TYPE_FLOAT))
                    (i32.eq (local.get $type2) (global.get $TYPE_COMPLEX))))
              (then
                (if (call $throw_type_error_with_type (global.get $BUILTIN_MSG_MIXED_BIGINT) (local.get $type1))
                  (then (br $exit))
                  (else
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)
                  )
                )
              )
            )

            ;; Rational - Rational
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_RATIONAL))
                  (i32.eq (local.get $type2) (global.get $TYPE_RATIONAL)))
              (then
                ;; Inline - inline fast path
                (if (i32.and
                      (call $rational_is_inline (local.get $value_pointer))
                      (call $rational_is_inline (local.get $value_pointer2)))
                  (then
                    (local.set $result_i64 (i64.sub
                      (call $rational_read_inline (local.get $value_pointer))
                      (call $rational_read_inline (local.get $value_pointer2))))
                    (if (call $i64_sub_overflowed
                          (call $rational_read_inline (local.get $value_pointer))
                          (call $rational_read_inline (local.get $value_pointer2))
                          (local.get $result_i64))
                      (then
                        (call $push_rational
                          (call $rational_sub
                            (call $rational_materialize (local.get $value_pointer))
                            (call $rational_materialize (local.get $value_pointer2))))
                        (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                        (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                        (br $loop)))
                    (call $push_rational_inline (local.get $result_i64))
                    (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                    (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                    (br $loop)))
                (call $push_rational
                  (call $rational_sub
                    (call $rational_materialize (local.get $value_pointer))
                    (call $rational_materialize (local.get $value_pointer2))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Rational - BigInt
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_RATIONAL))
                  (i32.eq (local.get $type2) (global.get $TYPE_BIGINT)))
              (then
                (call $push_rational
                  (call $rational_sub
                    (call $rational_materialize (local.get $value_pointer))
                    (call $rational_from_bigint
                      (call $value_data_lo (local.get $value_pointer2)))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; BigInt - Rational
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_BIGINT))
                  (i32.eq (local.get $type2) (global.get $TYPE_RATIONAL)))
              (then
                (call $push_rational
                  (call $rational_sub
                    (call $rational_from_bigint
                      (call $value_data_lo (local.get $value_pointer)))
                    (call $rational_materialize (local.get $value_pointer2))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Rational - Float — contagion rule: approximate Rational as f64, subtract as Float.
            (if (i32.or
                  (i32.and
                    (i32.eq (local.get $type1) (global.get $TYPE_RATIONAL))
                    (i32.eq (local.get $type2) (global.get $TYPE_FLOAT)))
                  (i32.and
                    (i32.eq (local.get $type1) (global.get $TYPE_FLOAT))
                    (i32.eq (local.get $type2) (global.get $TYPE_RATIONAL))))
              (then
                (call $push_f64
                  (f64.sub
                    (call $value_to_f64 (local.get $value_pointer))
                    (call $value_to_f64 (local.get $value_pointer2))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_FLOAT))
                  (i32.eq (local.get $type2) (global.get $TYPE_FLOAT)))
              (then
                (call $push_f64
                  (f64.sub
                    (call $read_f64 (local.get $value_pointer))
                    (call $read_f64 (local.get $value_pointer2))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )
            (if (call $raise_error (global.get $ERR_INVALID_OPERAND) (i32.const 0))
              (then (br $exit)))
            (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
            (br $loop)
          )
        )

        (if (i32.eq (local.get $opcode) (global.get $OP_MUL))
          (then
            ;; Peek operands first so we can pre-check heap pressure.
            (local.set $value_pointer2
              (i32.sub
                (call $read_ctx (global.get $CTX_PENDING_POINTER))
                (global.get $VALUE_SIZE)))
            (local.set $value_pointer
              (i32.sub
                (call $read_ctx (global.get $CTX_PENDING_POINTER))
                (i32.mul (global.get $VALUE_SIZE) (i32.const 2))))
            (call $coerce_to_number_at (local.get $value_pointer))
            (call $coerce_to_number_at (local.get $value_pointer2))
            (local.set $type1 (call $value_type (local.get $value_pointer)))
            (local.set $type2 (call $value_type (local.get $value_pointer2)))

            ;; Symbol / Expression refuse numeric coercion — same
            ;; messaged TypeError as OP_SUB (see comment there).
            (if (i32.or
                  (i32.or
                    (i32.eq (local.get $type1) (global.get $TYPE_SYMBOL))
                    (i32.eq (local.get $type1) (global.get $TYPE_EXPRESSION)))
                  (i32.or
                    (i32.eq (local.get $type2) (global.get $TYPE_SYMBOL))
                    (i32.eq (local.get $type2) (global.get $TYPE_EXPRESSION))))
              (then
                (drop (call $pending_pop))
                (drop (call $pending_pop))
                (if (call $throw_type_error_with_type
                      (global.get $BUILTIN_MSG_CANNOT_CONVERT_TO_NUMBER)
                      (select (local.get $type1) (local.get $type2)
                        (i32.or
                          (i32.eq (local.get $type1) (global.get $TYPE_SYMBOL))
                          (i32.eq (local.get $type1) (global.get $TYPE_EXPRESSION)))))
                  (then (br $exit))
                  (else
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)))))

            (if (call $complex_algebraic_pair_dispatchable
                  (local.get $type1) (local.get $type2))
              (then
                (local.set $result_i32 (call $complex_algebraic_operator_arith
                  (i32.const 2) (local.get $value_pointer) (local.get $value_pointer2)))
                (if (i32.eq (local.get $result_i32) (i32.const 1))
                  (then
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)))
                (if (i32.eq (local.get $result_i32) (i32.const 3))
                  (then (br $exit)))
                (if (i32.eq (local.get $result_i32) (i32.const 2))
                  (then
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)))
            ;; AlgebraicNumber arithmetic (Ring 6b) — see OP_ADD.
            (if (call $algebraic_pair_dispatchable (local.get $type1) (local.get $type2))
              (then
                (local.set $result_i32 (call $algebraic_operator_arith
                  (i32.const 2) (local.get $value_pointer) (local.get $value_pointer2)))
                (if (i32.eq (local.get $result_i32) (i32.const 1))
                  (then
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)))
                (if (i32.eq (local.get $result_i32) (i32.const 3))
                  (then (br $exit)))
                (if (i32.eq (local.get $result_i32) (i32.const 2))
                  (then
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)))

            ;; Pre-check by type. bigint_mul allocates la+lb limbs;
            ;; rational_mul allocates 3 bigints + 1 rational. We use the
            ;; conservative rational_add budget for both (which exceeds
            ;; rational_mul). Operands stay on stack for retry.
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_BIGINT))
                  (i32.eq (local.get $type2) (global.get $TYPE_BIGINT)))
              (then
                (if (call $check_heap_overflow
                      (call $estimate_bigint_mul_budget
                        (local.get $value_pointer) (local.get $value_pointer2)))
                  (then
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)))))
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_RATIONAL))
                  (i32.eq (local.get $type2) (global.get $TYPE_RATIONAL)))
              (then
                (if (call $check_heap_overflow
                      (call $estimate_rational_add_budget
                        (local.get $value_pointer) (local.get $value_pointer2)))
                  (then
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)))))
            ;; Cross-type combos.
            (if (i32.or
                  (i32.or
                    (i32.and
                      (i32.eq (local.get $type1) (global.get $TYPE_RATIONAL))
                      (i32.eq (local.get $type2) (global.get $TYPE_BIGINT)))
                    (i32.and
                      (i32.eq (local.get $type1) (global.get $TYPE_BIGINT))
                      (i32.eq (local.get $type2) (global.get $TYPE_RATIONAL))))
                  (i32.or
                    (i32.eq (local.get $type1) (global.get $TYPE_COMPLEX))
                    (i32.eq (local.get $type2) (global.get $TYPE_COMPLEX))))
              (then
                (if (call $check_heap_overflow
                      (call $estimate_cross_type_arith_budget
                        (local.get $value_pointer) (local.get $value_pointer2)))
                  (then
                    (call $write_ctx (global.get $CTX_INSTRUCTION_INDEX) (local.get $pc))
                    (call $write_ctx (global.get $CTX_SCOPE) (global.get $current_scope))
                    (call $write_ctx (global.get $CTX_EXIT_CONDITION) (global.get $EXIT_MEMORY_PRESSURE))
                    (br $exit)))))

            (local.set $value_pointer2 (call $pending_pop))
            (local.set $value_pointer (call $pending_pop))

            ;; BigInt * BigInt
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_BIGINT))
                  (i32.eq (local.get $type2) (global.get $TYPE_BIGINT)))
              (then
                (call $push_bigint
                  (call $bigint_mul
                    (call $value_data_lo (local.get $value_pointer))
                    (call $value_data_lo (local.get $value_pointer2))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Complex * Complex
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_COMPLEX))
                  (i32.eq (local.get $type2) (global.get $TYPE_COMPLEX)))
              (then
                (call $push_complex
                  (call $complex_mul
                    (call $value_data_lo (local.get $value_pointer))
                    (call $value_data_lo (local.get $value_pointer2))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Complex * Rational
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_COMPLEX))
                  (i32.eq (local.get $type2) (global.get $TYPE_RATIONAL)))
              (then
                (call $push_complex
                  (call $complex_mul
                    (call $value_data_lo (local.get $value_pointer))
                    (call $complex_from_rational
                      (call $rational_materialize (local.get $value_pointer2)))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Rational * Complex
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_RATIONAL))
                  (i32.eq (local.get $type2) (global.get $TYPE_COMPLEX)))
              (then
                (call $push_complex
                  (call $complex_mul
                    (call $complex_from_rational
                      (call $rational_materialize (local.get $value_pointer)))
                    (call $value_data_lo (local.get $value_pointer2))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Complex * BigInt
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_COMPLEX))
                  (i32.eq (local.get $type2) (global.get $TYPE_BIGINT)))
              (then
                (call $push_complex
                  (call $complex_mul
                    (call $value_data_lo (local.get $value_pointer))
                    (call $complex_from_rational
                      (call $rational_from_bigint
                        (call $value_data_lo (local.get $value_pointer2))))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; BigInt * Complex
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_BIGINT))
                  (i32.eq (local.get $type2) (global.get $TYPE_COMPLEX)))
              (then
                (call $push_complex
                  (call $complex_mul
                    (call $complex_from_rational
                      (call $rational_from_bigint
                        (call $value_data_lo (local.get $value_pointer))))
                    (call $value_data_lo (local.get $value_pointer2))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Complex / Float mix → TypeError
            (if (i32.or
                  (i32.and
                    (i32.eq (local.get $type1) (global.get $TYPE_COMPLEX))
                    (i32.eq (local.get $type2) (global.get $TYPE_FLOAT)))
                  (i32.and
                    (i32.eq (local.get $type1) (global.get $TYPE_FLOAT))
                    (i32.eq (local.get $type2) (global.get $TYPE_COMPLEX))))
              (then
                (if (call $throw_type_error_with_type (global.get $BUILTIN_MSG_MIXED_BIGINT) (local.get $type1))
                  (then (br $exit))
                  (else
                    (local.set $pc (call $read_ctx (global.get $CTX_INSTRUCTION_INDEX)))
                    (br $loop)
                  )
                )
              )
            )

            ;; Rational * Rational
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_RATIONAL))
                  (i32.eq (local.get $type2) (global.get $TYPE_RATIONAL)))
              (then
                ;; Inline * inline fast path — only when both magnitudes fit
                ;; in 31 bits so the i64 product is safe.
                (if (i32.and
                      (call $rational_is_inline (local.get $value_pointer))
                      (call $rational_is_inline (local.get $value_pointer2)))
                  (then
                    (if (call $i64_mul_safe
                          (call $rational_read_inline (local.get $value_pointer))
                          (call $rational_read_inline (local.get $value_pointer2)))
                      (then
                        (call $push_rational_inline
                          (i64.mul
                            (call $rational_read_inline (local.get $value_pointer))
                            (call $rational_read_inline (local.get $value_pointer2))))
                        (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                        (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                        (br $loop)))))
                (call $push_rational
                  (call $rational_mul
                    (call $rational_materialize (local.get $value_pointer))
                    (call $rational_materialize (local.get $value_pointer2))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; Rational * BigInt
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_RATIONAL))
                  (i32.eq (local.get $type2) (global.get $TYPE_BIGINT)))
              (then
                (call $push_rational
                  (call $rational_mul
                    (call $rational_materialize (local.get $value_pointer))
                    (call $rational_from_bigint
                      (call $value_data_lo (local.get $value_pointer2)))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
                (br $loop)
              )
            )

            ;; BigInt * Rational
            (if (i32.and
                  (i32.eq (local.get $type1) (global.get $TYPE_BIGINT))
                  (i32.eq (local.get $type2) (global.get $TYPE_RATIONAL)))
              (then
                (call $push_rational
                  (call $rational_mul
                    (call $rational_from_bigint
                      (call $value_data_lo (local.get $value_pointer)))
                    (call $rational_materialize (local.get $value_pointer2))))
                (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
                (local.set $fuel (i32.sub (local.get $fuel) (i32.const 1)))
