  (global $METHOD_SCHEMA_MATCH i32 (i32.const 0x2CA))
  (global $METHOD_SCHEMA_MATCH_ALL i32 (i32.const 0x2CB))
  (global $BUILTIN_COMPILE i32 (i32.const 0x6A8))
  (global $BUILTIN_VALIDATE i32 (i32.const 0x6AC))
  (global $BUILTIN_ASSERT i32 (i32.const 0x6B0))
  (global $BUILTIN_ERRORS i32 (i32.const 0x6B4))
  (global $BUILTIN_IS_SCHEMA i32 (i32.const 0x6B8))
  (global $BUILTIN_FORMATS i32 (i32.const 0x6BC))
  (global $BUILTIN_KEY_SCHEMA i32 (i32.const 0x6C0))
  (global $BUILTIN_KEY_DIALECT i32 (i32.const 0x6C4))
  (global $BUILTIN_KEY_VALID i32 (i32.const 0x6C8))
