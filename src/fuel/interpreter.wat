  (func $exact_to_string_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $argument1_type i32)
    (local $description i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub
          (local.get $pending_pointer)
          (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $argument1_type (call $value_type (local.get $argument1_pointer)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    ;; Exact symbol text is the mathematical atom name, not Symbol(name).
    ;; An undescribed Symbol has no atom name, so use its explicit Symbol()
    ;; spelling instead of the generic empty-string fallback.
    (if (i32.eq (local.get $argument1_type) (global.get $TYPE_SYMBOL))
      (then
        (local.set $description (call $symbol_description
          (call $value_data_lo (local.get $argument1_pointer))))
        (if (i32.eqz (local.get $description))
          (then (local.set $description
            (call $read_builtin (global.get $BUILTIN_SYMBOL_LIT_EMPTY)))))
        (call $pending_push (global.get $TYPE_STRING) (i32.const 0)
          (local.get $description) (i32.const 0))
        (return (i32.const 0))))
    (call $pending_push (global.get $TYPE_STRING) (i32.const 0)
      (call $value_to_string (local.get $argument1_pointer))
      (i32.const 0))
    (i32.const 0)
  )

  ;; ==========================================================================
  ;; Typed array methods (dispatch-table migration, batch 5). Each
  ;; function re-derives the typed-array
  ;; descriptor fields (data_pointer/start_idx/arr_len from
  ;; receiver_pointer) that dispatch_builtin_method's outer
  ;; is_typed_array wrapper previously decoded once for the whole
  ;; section — every method needs its own copy now, since it can no
  ;; longer share the caller's locals. Also re-derives whichever
  ;; arg1/arg2/arg3 fields it actually uses, matching this migration's
  ;; established preamble-reproduction pattern.
  ;; ==========================================================================

  (func $typed_array_iterator_factory
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $object_pointer i32)
    (local $kind i32)
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))

    ;; Derive @kind from the factory method id: keys=0, values=1,
    ;; entries=2. Symbol.iterator and values() share
    ;; METHOD_TYPED_ARRAY_ITERATOR_FACTORY — both are kind 1.
    (if (i32.eq (local.get $method_id) (global.get $METHOD_TYPED_ARRAY_KEYS))
      (then (local.set $kind (i32.const 0)))
      (else
        (if (i32.eq (local.get $method_id) (global.get $METHOD_TYPED_ARRAY_ENTRIES))
          (then (local.set $kind (i32.const 2)))
          (else (local.set $kind (i32.const 1)))
        )
      )
    )

    (if (call $check_heap_overflow
          (i32.add
            (call $estimate_object_size (i32.const 4))
            (call $estimate_object_sym_entries_size)))
      (then (return (i32.const 0))))
    (local.set $object_pointer (call $allocate_object (i32.const 4)))
    (drop (call $object_set_property
      (local.get $object_pointer)
      (call $read_builtin (global.get $BUILTIN_ITER_HIDDEN_BUFFER))
      (local.get $receiver_type)
      (i32.const 0)
      (local.get $receiver_pointer)
      (i32.const 0)))
    (drop (call $object_set_property
      (local.get $object_pointer)
      (call $read_builtin (global.get $BUILTIN_ITER_HIDDEN_INDEX))
      (global.get $TYPE_RATIONAL)
      (global.get $FLAG_RATIONAL_INLINE)
      (i32.const 0)
      (i32.const 0)))
    (drop (call $object_set_property
      (local.get $object_pointer)
      (call $read_builtin (global.get $BUILTIN_ITER_NEXT_KEY))
      (global.get $TYPE_BOUND_METHOD)
      (global.get $TYPE_OBJECT)
      (local.get $object_pointer)
      (global.get $METHOD_TYPED_ARRAY_ITERATOR_NEXT)))
    ;; Slot 3: @kind — appended LAST so the fixed slot offsets the next
    ;; method reads (@buffer type at entries+12, lo at entries+20,
    ;; @index lo at entries+40) stay put; @kind lo is at entries+80.
    (drop (call $object_set_property
      (local.get $object_pointer)
      (call $read_builtin (global.get $BUILTIN_ITER_HIDDEN_KIND))
      (global.get $TYPE_RATIONAL)
      (global.get $FLAG_RATIONAL_INLINE)
      (local.get $kind)
      (i32.const 0)))
    ;; Symbol.iterator on the iterator itself returns `this` (mirrors
    ;; $build_collection_iterator) — `for (const [i, v] of b.entries())`.
    (call $object_set_sym_entry
      (local.get $object_pointer)
      (call $read_state (global.get $STATE_WELL_KNOWN_ITERATOR_SYMBOL))
      (global.get $TYPE_BOUND_METHOD)
      (global.get $TYPE_OBJECT)
      (local.get $object_pointer)
      (global.get $METHOD_ITERATOR_RETURN_SELF))
    (call $pending_push
      (global.get $TYPE_OBJECT)
      (i32.const 0)
      (local.get $object_pointer)
      (i32.const 0))
    (i32.const 0)
  )

  (func $typed_array_subarray
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $argument2_pointer i32)
    (local $data_pointer i32)
    (local $start_idx i32)
    (local $arr_len i32)
    (local $bytes_per_element i32)
    (local $i i32)
    (local $end_idx i32)
    (local $slice_len i32)
    (local $found i32)
    (local $element_pointer i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))))
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then (local.set $argument2_pointer (i32.add (local.get $argument1_pointer) (global.get $VALUE_SIZE)))))
    (local.set $data_pointer (i32.load (call $abs (local.get $receiver_pointer))))
    (local.set $start_idx (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 4)))))
    (local.set $arr_len (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 8)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (call $check_heap_overflow (call $estimate_typed_array_descriptor_size))
      (then (return (i32.const 0))))
    (local.set $bytes_per_element (call $get_bytes_per_element (local.get $receiver_type)))
    (local.set $i (i32.const 0))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (if (call $value_is_numeric (local.get $argument1_pointer))
          (then (local.set $i (i32.trunc_sat_f64_s (call $value_to_f64 (local.get $argument1_pointer))))))
        (if (i32.lt_s (local.get $i) (i32.const 0))
          (then
            (local.set $i (i32.add (local.get $arr_len) (local.get $i)))
            (if (i32.lt_s (local.get $i) (i32.const 0))
              (then (local.set $i (i32.const 0))))))
        (if (i32.gt_s (local.get $i) (local.get $arr_len))
          (then (local.set $i (local.get $arr_len))))))
    (local.set $end_idx (local.get $arr_len))
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then
        (if (call $value_is_numeric (local.get $argument2_pointer))
          (then (local.set $end_idx (i32.trunc_sat_f64_s (call $value_to_f64 (local.get $argument2_pointer))))))
        (if (i32.lt_s (local.get $end_idx) (i32.const 0))
          (then
            (local.set $end_idx (i32.add (local.get $arr_len) (local.get $end_idx)))
            (if (i32.lt_s (local.get $end_idx) (i32.const 0))
              (then (local.set $end_idx (i32.const 0))))))
        (if (i32.gt_s (local.get $end_idx) (local.get $arr_len))
          (then (local.set $end_idx (local.get $arr_len))))))
    (local.set $slice_len (i32.sub (local.get $end_idx) (local.get $i)))
    (if (i32.lt_s (local.get $slice_len) (i32.const 0))
      (then (local.set $slice_len (i32.const 0))))
    (local.set $found (i32.add (local.get $start_idx) (i32.mul (local.get $i) (local.get $bytes_per_element))))
    (local.set $element_pointer
      (call $allocate_typed_array_descriptor
        (local.get $data_pointer) (local.get $found) (local.get $slice_len)))
    (call $pending_push
      (local.get $receiver_type) (i32.const 0) (local.get $element_pointer) (i32.const 0))
    (i32.const 0)
  )

  (func $typed_array_slice
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $argument2_pointer i32)
    (local $data_pointer i32)
    (local $start_idx i32)
    (local $arr_len i32)
    (local $bytes_per_element i32)
    (local $i i32)
    (local $end_idx i32)
    (local $slice_len i32)
    (local $new_arr i32)
    (local $source_pointer i32)
    (local $dest i32)
    (local $count i32)
    (local $j i32)
    (local $element_pointer i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))))
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then (local.set $argument2_pointer (i32.add (local.get $argument1_pointer) (global.get $VALUE_SIZE)))))
    (local.set $data_pointer (i32.load (call $abs (local.get $receiver_pointer))))
    (local.set $start_idx (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 4)))))
    (local.set $arr_len (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 8)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (local.set $bytes_per_element (call $get_bytes_per_element (local.get $receiver_type)))
    (local.set $i (i32.const 0))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (if (call $value_is_numeric (local.get $argument1_pointer))
          (then (local.set $i (i32.trunc_sat_f64_s (call $value_to_f64 (local.get $argument1_pointer))))))
        (if (i32.lt_s (local.get $i) (i32.const 0))
          (then
            (local.set $i (i32.add (local.get $arr_len) (local.get $i)))
            (if (i32.lt_s (local.get $i) (i32.const 0))
              (then (local.set $i (i32.const 0))))))
        (if (i32.gt_s (local.get $i) (local.get $arr_len))
          (then (local.set $i (local.get $arr_len))))))
    (local.set $end_idx (local.get $arr_len))
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then
        (if (call $value_is_numeric (local.get $argument2_pointer))
          (then (local.set $end_idx (i32.trunc_sat_f64_s (call $value_to_f64 (local.get $argument2_pointer))))))
        (if (i32.lt_s (local.get $end_idx) (i32.const 0))
          (then
            (local.set $end_idx (i32.add (local.get $arr_len) (local.get $end_idx)))
            (if (i32.lt_s (local.get $end_idx) (i32.const 0))
              (then (local.set $end_idx (i32.const 0))))))
        (if (i32.gt_s (local.get $end_idx) (local.get $arr_len))
          (then (local.set $end_idx (local.get $arr_len))))))
    (local.set $slice_len (i32.sub (local.get $end_idx) (local.get $i)))
    (if (i32.lt_s (local.get $slice_len) (i32.const 0))
      (then (local.set $slice_len (i32.const 0))))
    (if (call $check_heap_overflow
          (i32.add
            (call $estimate_arraybuffer_size (i32.mul (local.get $slice_len) (local.get $bytes_per_element)))
            (call $estimate_typed_array_descriptor_size)))
      (then (return (i32.const 0))))
    (local.set $new_arr (call $allocate_arraybuffer (i32.mul (local.get $slice_len) (local.get $bytes_per_element))))
    (local.set $source_pointer
      (call $abs (i32.add
        (i32.add (local.get $data_pointer) (i32.const 4))
        (i32.add (local.get $start_idx) (i32.mul (local.get $i) (local.get $bytes_per_element))))))
    (local.set $dest (call $abs (i32.add (local.get $new_arr) (i32.const 4))))
    (local.set $count (i32.mul (local.get $slice_len) (local.get $bytes_per_element)))
    (local.set $j (i32.const 0))
    (block $copy_done
      (loop $copy_loop
        (br_if $copy_done (i32.ge_u (local.get $j) (local.get $count)))
        (i32.store8
          (i32.add (local.get $dest) (local.get $j))
          (i32.load8_u (i32.add (local.get $source_pointer) (local.get $j))))
        (local.set $j (i32.add (local.get $j) (i32.const 1)))
        (br $copy_loop)))
    (local.set $element_pointer
      (call $allocate_typed_array_descriptor
        (local.get $new_arr) (i32.const 0) (local.get $slice_len)))
    (call $pending_push
      (local.get $receiver_type) (i32.const 0) (local.get $element_pointer) (i32.const 0))
    (i32.const 0)
  )

  (func $typed_array_fill
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $argument2_pointer i32)
    (local $argument3_pointer i32)
    (local $data_pointer i32)
    (local $start_idx i32)
    (local $arr_len i32)
    (local $bytes_per_element i32)
    (local $i i32)
    (local $end_idx i32)
    (local $result_f64 f64)
    (local $source_pointer i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))))
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then (local.set $argument2_pointer (i32.add (local.get $argument1_pointer) (global.get $VALUE_SIZE)))))
    (if (i32.ge_u (local.get $argc) (i32.const 3))
      (then (local.set $argument3_pointer (i32.add (local.get $argument2_pointer) (global.get $VALUE_SIZE)))))
    (local.set $data_pointer (i32.load (call $abs (local.get $receiver_pointer))))
    (local.set $start_idx (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 4)))))
    (local.set $arr_len (i32.load (call $abs (i32.add (local.get $receiver_pointer) (i32.const 8)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (local.set $result_f64 (f64.const 0))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (if (call $value_is_numeric (local.get $argument1_pointer))
          (then (local.set $result_f64 (call $value_to_f64 (local.get $argument1_pointer)))))))
    (local.set $i (i32.const 0))
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then
        (if (call $value_is_numeric (local.get $argument2_pointer))
          (then (local.set $i (i32.trunc_sat_f64_s (call $value_to_f64 (local.get $argument2_pointer))))))
        (if (i32.lt_s (local.get $i) (i32.const 0))
          (then
            (local.set $i (i32.add (local.get $arr_len) (local.get $i)))
            (if (i32.lt_s (local.get $i) (i32.const 0))
              (then (local.set $i (i32.const 0))))))
        (if (i32.gt_s (local.get $i) (local.get $arr_len))
          (then (local.set $i (local.get $arr_len))))))
    (local.set $end_idx (local.get $arr_len))
    (if (i32.ge_u (local.get $argc) (i32.const 3))
      (then
        (if (call $value_is_numeric (local.get $argument3_pointer))
          (then (local.set $end_idx (i32.trunc_sat_f64_s (call $value_to_f64 (local.get $argument3_pointer))))))
        (if (i32.lt_s (local.get $end_idx) (i32.const 0))
          (then
            (local.set $end_idx (i32.add (local.get $arr_len) (local.get $end_idx)))
            (if (i32.lt_s (local.get $end_idx) (i32.const 0))
              (then (local.set $end_idx (i32.const 0))))))
        (if (i32.gt_s (local.get $end_idx) (local.get $arr_len))
