  ;; ==========================================================================
  ;; Matrix multiplication + trace + determinant — Ring 4 (4c)
  ;; ==========================================================================

  ;; Exact division of one entry by another: Divide(a, b) + simplify.
  ;; Numeric operands fold exactly (the Divide desugar); symbolic
  ;; operands ride Ring 3d's cancellation — Bareiss guarantees the
  ;; division is exact, so cancellation reduces the quotient to a
  ;; polynomial. `b` semantically 1 short-circuits to a copy (the
  ;; first elimination step always divides by 1). This is the UNCAPPED
  ;; path in the sense that matters: no MAX_EXPANSION_TERMS decision
  ;; gates whether the division happens — an oversized symbolic
  ;; quotient stays a (correct) Divide form rather than being dropped.
  (func $matrix_entry_divide
    (param $a_slot i32) (param $b_slot i32) (param $dest_slot i32)
    (result i32)
    (local $scratch i32)
    (if (call $expression_value_is_one_wide (local.get $b_slot))
      (then
        (memory.copy
          (call $abs (local.get $dest_slot))
          (call $abs (local.get $a_slot))
          (global.get $VALUE_SIZE))
        (return (i32.const 0))))
    (if (call $expression_walk_guard (i32.const 160))
      (then (return (i32.const 1))))
    (local.set $scratch (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (i32.store (call $abs (local.get $scratch)) (global.get $TYPE_EXPRESSION))
    (i32.store (call $abs (i32.add (local.get $scratch) (i32.const 4))) (i32.const 0))
    (i32.store (call $abs (i32.add (local.get $scratch) (i32.const 8)))
      (call $expression_build
        (call $symbol_registry_lookup (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_DIVIDE)))
        (call $expression_alloc_args2 (local.get $a_slot) (local.get $b_slot))))
    (i32.store (call $abs (i32.add (local.get $scratch) (i32.const 12))) (i32.const 0))
    (call $expression_simplify_into (local.get $scratch) (local.get $dest_slot))
  )

  ;; multiply(A, B) — standard row-by-column product. A is m × p, B is
  ;; p × n; result m × n with entry (i, j) = Σ_k A[i,k] · B[k,j].
  ;; p = 0 is legal: every entry is an empty sum (Rational 0).
  (func $matrix_multiply
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $arg1_type i32)
    (local $arg1_lo i32)
    (local $argument2_pointer i32)
    (local $arg2_type i32)
    (local $arg2_lo i32)
    (local $m i32)
    (local $p i32)
    (local $n i32)
    (local $count i32)
    (local $entries_pointer i32)
    (local $entries_data i32)
    (local $a_data i32)
    (local $b_data i32)
    (local $product_slot i32)
    (local $dest_slot i32)
    (local $i i32)
    (local $j i32)
    (local $k i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $arg1_type (call $value_type (local.get $argument1_pointer)))
        (local.set $arg1_lo (call $value_data_lo (local.get $argument1_pointer)))))
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then
        (local.set $argument2_pointer (i32.add (local.get $argument1_pointer) (global.get $VALUE_SIZE)))
        (local.set $arg2_type (call $value_type (local.get $argument2_pointer)))
        (local.set $arg2_lo (call $value_data_lo (local.get $argument2_pointer)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (i32.or
          (i32.ne (local.get $arg1_type) (global.get $TYPE_MATRIX))
          (i32.ne (local.get $arg2_type) (global.get $TYPE_MATRIX)))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_MATRIX_NOT_MATRIX))))))
    (local.set $m (call $matrix_rows_of (local.get $arg1_lo)))
    (local.set $p (call $matrix_columns_of (local.get $arg1_lo)))
    (local.set $n (call $matrix_columns_of (local.get $arg2_lo)))
    (if (i32.ne (local.get $p) (call $matrix_rows_of (local.get $arg2_lo)))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_MATRIX_SHAPE_MISMATCH))))))
    (local.set $count (i32.mul (local.get $m) (local.get $n)))
    (local.set $entries_pointer (call $matrix_budget_and_alloc_entries (local.get $count)))
    (if (i32.eqz (local.get $entries_pointer))
      (then (return (i32.const 0))))
    (local.set $entries_data (i32.load (call $abs (i32.add (local.get $entries_pointer) (i32.const 16)))))
    ;; Zero-fill up front so the p = 0 empty-sum convention and the
    ;; accumulator init are one and the same.
    (call $matrix_fill_zero (local.get $entries_data) (local.get $count))
    (local.set $a_data (i32.load (call $abs (i32.add
      (call $matrix_entries_of (local.get $arg1_lo)) (i32.const 16)))))
    (local.set $b_data (i32.load (call $abs (i32.add
      (call $matrix_entries_of (local.get $arg2_lo)) (i32.const 16)))))
    ;; One reusable committed scratch slot for the per-step product.
    (if (call $expression_walk_guard (i32.const 32))
      (then (return (i32.const 0))))
    (local.set $product_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (local.set $i (i32.const 0))
    (block $rows_done
      (loop $rows_loop
        (br_if $rows_done (i32.ge_u (local.get $i) (local.get $m)))
        (local.set $j (i32.const 0))
        (block $cols_done
          (loop $cols_loop
            (br_if $cols_done (i32.ge_u (local.get $j) (local.get $n)))
            (local.set $dest_slot (i32.add
              (i32.add (local.get $entries_data) (global.get $GC_HEADER_SIZE))
              (i32.mul
                (i32.add (i32.mul (local.get $i) (local.get $n)) (local.get $j))
                (global.get $VALUE_SIZE))))
            (local.set $k (i32.const 0))
            (block $sum_done
              (loop $sum_loop
                (br_if $sum_done (i32.ge_u (local.get $k) (local.get $p)))
                (if (call $matrix_entry_binary (i32.const 2)
                      (i32.add
                        (i32.add (local.get $a_data) (global.get $GC_HEADER_SIZE))
                        (i32.mul
                          (i32.add (i32.mul (local.get $i) (local.get $p)) (local.get $k))
                          (global.get $VALUE_SIZE)))
                      (i32.add
                        (i32.add (local.get $b_data) (global.get $GC_HEADER_SIZE))
                        (i32.mul
                          (i32.add (i32.mul (local.get $k) (local.get $n)) (local.get $j))
                          (global.get $VALUE_SIZE)))
                      (local.get $product_slot))
                  (then (return (i32.const 0))))
                (if (global.get $memory_pressure_signaled)
                  (then (return (i32.const 0))))
                (if (i32.eqz (local.get $k))
                  (then
                    ;; First term replaces the zero-filled accumulator.
                    (memory.copy
                      (call $abs (local.get $dest_slot))
                      (call $abs (local.get $product_slot))
                      (global.get $VALUE_SIZE)))
                  (else
                    (if (call $matrix_entry_binary (i32.const 0)
                          (local.get $dest_slot) (local.get $product_slot) (local.get $dest_slot))
                      (then (return (i32.const 0))))
                    (if (global.get $memory_pressure_signaled)
                      (then (return (i32.const 0))))))
                (local.set $k (i32.add (local.get $k) (i32.const 1)))
                (br $sum_loop)))
            (local.set $j (i32.add (local.get $j) (i32.const 1)))
            (br $cols_loop)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $rows_loop)))
    (call $expression_freeze_args_array (local.get $entries_pointer))
    (call $push_matrix (call $matrix_allocate
      (local.get $m) (local.get $n) (local.get $entries_pointer)))
    (i32.const 0)
  )

  ;; trace(M) — sum of the diagonal. Square-only. Returns a Ring 1
  ;; number when all diagonal entries are numeric, a Ring 2 Expression
  ;; otherwise. trace of the 0x0 matrix is Rational 0 (empty sum).
  (func $matrix_trace
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $arg1_type i32)
    (local $arg1_lo i32)
    (local $n i32)
    (local $a_data i32)
    (local $accumulator_slot i32)
    (local $k i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $arg1_type (call $value_type (local.get $argument1_pointer)))
        (local.set $arg1_lo (call $value_data_lo (local.get $argument1_pointer)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (i32.ne (local.get $arg1_type) (global.get $TYPE_MATRIX))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_MATRIX_NOT_MATRIX))))))
    (local.set $n (call $matrix_rows_of (local.get $arg1_lo)))
    (if (i32.ne (local.get $n) (call $matrix_columns_of (local.get $arg1_lo)))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_MATRIX_NOT_SQUARE))))))
    (if (call $expression_walk_guard (i32.const 32))
      (then (return (i32.const 0))))
    (local.set $accumulator_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (call $expression_write_zero (local.get $accumulator_slot))
    (local.set $a_data (i32.load (call $abs (i32.add
      (call $matrix_entries_of (local.get $arg1_lo)) (i32.const 16)))))
    (local.set $k (i32.const 0))
    (block $done
      (loop $diagonal
        (br_if $done (i32.ge_u (local.get $k) (local.get $n)))
        (if (i32.eqz (local.get $k))
          (then
            (memory.copy
              (call $abs (local.get $accumulator_slot))
              (call $abs (i32.add
                (i32.add (local.get $a_data) (global.get $GC_HEADER_SIZE))
                (i32.mul
                  (i32.mul (local.get $k) (i32.add (local.get $n) (i32.const 1)))
                  (global.get $VALUE_SIZE))))
              (global.get $VALUE_SIZE)))
          (else
            (if (call $matrix_entry_binary (i32.const 0)
                  (local.get $accumulator_slot)
                  (i32.add
                    (i32.add (local.get $a_data) (global.get $GC_HEADER_SIZE))
                    (i32.mul
                      (i32.mul (local.get $k) (i32.add (local.get $n) (i32.const 1)))
                      (global.get $VALUE_SIZE)))
                  (local.get $accumulator_slot))
              (then (return (i32.const 0))))
            (if (global.get $memory_pressure_signaled)
              (then (return (i32.const 0))))))
        (local.set $k (i32.add (local.get $k) (i32.const 1)))
        (br $diagonal)))
    (call $pending_push
      (call $value_type (local.get $accumulator_slot))
      (call $value_flags (local.get $accumulator_slot))
      (call $value_data_lo (local.get $accumulator_slot))
      (call $value_data_hi (local.get $accumulator_slot)))
    (i32.const 0)
  )

  ;; determinant(M) — fraction-free Bareiss elimination over the
  ;; exact/symbolic ring, uniform for every n >= 1 (0x0 returns the
  ;; empty product 1). One code path instead of the plan's special-
  ;; cased 2x2/3x3 formulae — at those sizes Bareiss performs the
  ;; same multiplications, and the single path keeps the exact-
  ;; division discipline in one place.
  ;;
  ;; Working matrix is a committed OBJ_SCRATCH blob (slice-0
  ;; discipline): n*n entry slots + prev-pivot + two product slots +
  ;; numerator + swap temp. A pivot is any entry not semantically
  ;; zero after simplify — a Symbol is a valid pivot (the result is
  ;; conditional on it being nonzero; Ring 5's owed work).
  (func $matrix_determinant
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $arg1_type i32)
    (local $arg1_lo i32)
    (local $n i32)
    (local $a_data i32)
    (local $work i32)
    (local $prev_slot i32)
    (local $t1_slot i32)
    (local $t2_slot i32)
    (local $num_slot i32)
    (local $tmp_slot i32)
    (local $sign i32)
    (local $k i32)
    (local $i i32)
    (local $j i32)
    (local $r i32)
    (local $swap_row i32)
    (local $result_slot i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $arg1_type (call $value_type (local.get $argument1_pointer)))
        (local.set $arg1_lo (call $value_data_lo (local.get $argument1_pointer)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (i32.ne (local.get $arg1_type) (global.get $TYPE_MATRIX))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_MATRIX_NOT_MATRIX))))))
    (local.set $n (call $matrix_rows_of (local.get $arg1_lo)))
    (if (i32.ne (local.get $n) (call $matrix_columns_of (local.get $arg1_lo)))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_MATRIX_NOT_SQUARE))))))
    ;; 0x0: empty product.
    (if (i32.eqz (local.get $n))
      (then
        (call $push_rational_inline (i64.const 1))
        (return (i32.const 0))))
    ;; Working blob: n*n + 5 value slots.
    (if (call $expression_walk_guard
          (i32.add
            (i32.mul
              (i32.add (i32.mul (local.get $n) (local.get $n)) (i32.const 5))
              (global.get $VALUE_SIZE))
            (i32.const 64)))
      (then (return (i32.const 0))))
    (local.set $work (call $carve_scratch_blob
      (i32.mul
        (i32.add (i32.mul (local.get $n) (local.get $n)) (i32.const 5))
        (global.get $VALUE_SIZE))))
    (local.set $prev_slot (i32.add (local.get $work)
      (i32.mul (i32.mul (local.get $n) (local.get $n)) (global.get $VALUE_SIZE))))
    (local.set $t1_slot (i32.add (local.get $prev_slot) (global.get $VALUE_SIZE)))
    (local.set $t2_slot (i32.add (local.get $t1_slot) (global.get $VALUE_SIZE)))
    (local.set $num_slot (i32.add (local.get $t2_slot) (global.get $VALUE_SIZE)))
    (local.set $tmp_slot (i32.add (local.get $num_slot) (global.get $VALUE_SIZE)))
    ;; Copy the source entries into the working matrix; prev = 1.
    (local.set $a_data (i32.load (call $abs (i32.add
      (call $matrix_entries_of (local.get $arg1_lo)) (i32.const 16)))))
    (memory.copy
      (call $abs (local.get $work))
      (call $abs (i32.add (local.get $a_data) (global.get $GC_HEADER_SIZE)))
      (i32.mul (i32.mul (local.get $n) (local.get $n)) (global.get $VALUE_SIZE)))
    (call $expression_write_one (local.get $prev_slot))
    (local.set $sign (i32.const 0))
    ;; Elimination.
    (local.set $k (i32.const 0))
    (block $elim_done
      (loop $elim
        (br_if $elim_done (i32.ge_u (local.get $k)
          (i32.sub (local.get $n) (i32.const 1))))
        ;; Pivot selection: if work[k][k] is semantically zero, find a
        ;; lower row with a nonzero entry in column k and swap (sign
        ;; flips). No candidate → determinant is exactly zero.
        (if (call $expression_value_is_zero_wide (i32.add (local.get $work)
              (i32.mul
                (i32.add (i32.mul (local.get $k) (local.get $n)) (local.get $k))
                (global.get $VALUE_SIZE))))
          (then
            (local.set $swap_row (i32.const -1))
            (local.set $r (i32.add (local.get $k) (i32.const 1)))
            (block $find_done
              (loop $find
                (br_if $find_done (i32.ge_u (local.get $r) (local.get $n)))
                (if (i32.eqz (call $expression_value_is_zero_wide (i32.add (local.get $work)
                      (i32.mul
                        (i32.add (i32.mul (local.get $r) (local.get $n)) (local.get $k))
                        (global.get $VALUE_SIZE)))))
                  (then
                    (local.set $swap_row (local.get $r))
                    (br $find_done)))
                (local.set $r (i32.add (local.get $r) (i32.const 1)))
                (br $find)))
            (if (i32.lt_s (local.get $swap_row) (i32.const 0))
              (then
                (call $push_rational_inline (i64.const 0))
                (return (i32.const 0))))
            ;; Swap rows k and swap_row.
            (local.set $j (i32.const 0))
            (block $swap_done
              (loop $swap
                (br_if $swap_done (i32.ge_u (local.get $j) (local.get $n)))
                (memory.copy (call $abs (local.get $tmp_slot))
                  (call $abs (i32.add (local.get $work)
                    (i32.mul (i32.add (i32.mul (local.get $k) (local.get $n)) (local.get $j))
                      (global.get $VALUE_SIZE))))
                  (global.get $VALUE_SIZE))
                (memory.copy
                  (call $abs (i32.add (local.get $work)
                    (i32.mul (i32.add (i32.mul (local.get $k) (local.get $n)) (local.get $j))
                      (global.get $VALUE_SIZE))))
                  (call $abs (i32.add (local.get $work)
                    (i32.mul (i32.add (i32.mul (local.get $swap_row) (local.get $n)) (local.get $j))
                      (global.get $VALUE_SIZE))))
                  (global.get $VALUE_SIZE))
                (memory.copy
                  (call $abs (i32.add (local.get $work)
                    (i32.mul (i32.add (i32.mul (local.get $swap_row) (local.get $n)) (local.get $j))
                      (global.get $VALUE_SIZE))))
                  (call $abs (local.get $tmp_slot))
                  (global.get $VALUE_SIZE))
                (local.set $j (i32.add (local.get $j) (i32.const 1)))
                (br $swap)))
            (local.set $sign (i32.xor (local.get $sign) (i32.const 1)))))
        ;; Fraction-free update of the trailing block.
        (local.set $i (i32.add (local.get $k) (i32.const 1)))
        (block $i_done
          (loop $i_loop
            (br_if $i_done (i32.ge_u (local.get $i) (local.get $n)))
            (local.set $j (i32.add (local.get $k) (i32.const 1)))
            (block $j_done
              (loop $j_loop
                (br_if $j_done (i32.ge_u (local.get $j) (local.get $n)))
                ;; t1 = work[k][k] * work[i][j]
                (if (call $matrix_entry_binary (i32.const 2)
                      (i32.add (local.get $work)
                        (i32.mul (i32.add (i32.mul (local.get $k) (local.get $n)) (local.get $k))
                          (global.get $VALUE_SIZE)))
                      (i32.add (local.get $work)
                        (i32.mul (i32.add (i32.mul (local.get $i) (local.get $n)) (local.get $j))
                          (global.get $VALUE_SIZE)))
                      (local.get $t1_slot))
                  (then (return (i32.const 0))))
                (if (global.get $memory_pressure_signaled) (then (return (i32.const 0))))
                ;; t2 = work[i][k] * work[k][j]
                (if (call $matrix_entry_binary (i32.const 2)
                      (i32.add (local.get $work)
                        (i32.mul (i32.add (i32.mul (local.get $i) (local.get $n)) (local.get $k))
                          (global.get $VALUE_SIZE)))
                      (i32.add (local.get $work)
                        (i32.mul (i32.add (i32.mul (local.get $k) (local.get $n)) (local.get $j))
                          (global.get $VALUE_SIZE)))
                      (local.get $t2_slot))
                  (then (return (i32.const 0))))
                (if (global.get $memory_pressure_signaled) (then (return (i32.const 0))))
                ;; num = t1 - t2
                (if (call $matrix_entry_binary (i32.const 1)
                      (local.get $t1_slot) (local.get $t2_slot) (local.get $num_slot))
                  (then (return (i32.const 0))))
                (if (global.get $memory_pressure_signaled) (then (return (i32.const 0))))
                ;; work[i][j] = num / prev (exact)
                (if (call $matrix_entry_divide
                      (local.get $num_slot) (local.get $prev_slot)
                      (i32.add (local.get $work)
                        (i32.mul (i32.add (i32.mul (local.get $i) (local.get $n)) (local.get $j))
                          (global.get $VALUE_SIZE))))
                  (then (return (i32.const 0))))
                (if (global.get $memory_pressure_signaled) (then (return (i32.const 0))))
                (local.set $j (i32.add (local.get $j) (i32.const 1)))
                (br $j_loop)))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $i_loop)))
        ;; prev = work[k][k]
        (memory.copy
          (call $abs (local.get $prev_slot))
          (call $abs (i32.add (local.get $work)
            (i32.mul (i32.add (i32.mul (local.get $k) (local.get $n)) (local.get $k))
              (global.get $VALUE_SIZE))))
          (global.get $VALUE_SIZE))
        (local.set $k (i32.add (local.get $k) (i32.const 1)))
        (br $elim)))
    ;; det = work[n-1][n-1], negated when the swap parity is odd.
    (local.set $result_slot (i32.add (local.get $work)
      (i32.mul
        (i32.sub (i32.mul (local.get $n) (local.get $n)) (i32.const 1))
        (global.get $VALUE_SIZE))))
    (if (local.get $sign)
      (then
        (if (call $matrix_entry_unary (i32.const 0)
              (local.get $result_slot) (local.get $tmp_slot))
          (then (return (i32.const 0))))
        (if (global.get $memory_pressure_signaled) (then (return (i32.const 0))))
        (local.set $result_slot (local.get $tmp_slot))))
    (call $pending_push
      (call $value_type (local.get $result_slot))
      (call $value_flags (local.get $result_slot))
      (call $value_data_lo (local.get $result_slot))
      (call $value_data_hi (local.get $result_slot)))
    (i32.const 0)
  )

  ;; ==========================================================================
  ;; Shared fraction-free row reduction + inverse / solve / rank — Ring 4 (4d)
  ;; ==========================================================================

  ;; Montante's method (fraction-free Gauss-Jordan): for each pivot
  ;; column, eliminate EVERY other row with the Bareiss update
  ;; (pivot·target − pivotcol·pivotrow) / previous-pivot — entries stay
  ;; ring elements, divisions are exact by construction. On a
  ;; full-rank square left block the left side ends diagonal with every
  ;; diagonal entry equal to the final pivot (±det), which is what
  ;; makes inverse/solve one exact division per output entry.
  ;;
  ;; $work is the segment-relative base of row_count × total_columns
  ;; value slots (a committed OBJ_SCRATCH area carved by the caller,
  ;; slice-0 discipline); the five scratch slots follow it. Pivot rule:
  ;; any entry not semantically zero after simplify — a Symbol is a
  ;; valid pivot (result conditional on it being nonzero; Ring 5's
  ;; owed work). Rank (pivot count) lands in $matrix_reduce_rank.
  ;; Returns walk status: 0 ok, 1 pressure-abort.
  (func $matrix_reduce_montante
    (param $work i32) (param $row_count i32)
    (param $total_columns i32) (param $left_columns i32)
    (param $prev_slot i32) (param $t1_slot i32) (param $t2_slot i32)
    (param $num_slot i32) (param $tmp_slot i32)
    (result i32)
    (local $rank i32)
    (local $col i32)
    (local $pivot_row i32)
    (local $r i32)
    (local $i i32)
    (local $j i32)
    (call $expression_write_one (local.get $prev_slot))
    (local.set $rank (i32.const 0))
    (local.set $col (i32.const 0))
    (block $cols_done
      (loop $cols
        (br_if $cols_done (i32.ge_u (local.get $col) (local.get $left_columns)))
        ;; Pivot search in this column, rows rank..row_count-1.
        (local.set $pivot_row (i32.const -1))
        (local.set $r (local.get $rank))
        (block $find_done
          (loop $find
            (br_if $find_done (i32.ge_u (local.get $r) (local.get $row_count)))
            (if (i32.eqz (call $expression_value_is_zero_wide
                  (i32.add (local.get $work) (i32.mul
                    (i32.add (i32.mul (local.get $r) (local.get $total_columns)) (local.get $col))
                    (global.get $VALUE_SIZE)))))
              (then
                (local.set $pivot_row (local.get $r))
                (br $find_done)))
            (local.set $r (i32.add (local.get $r) (i32.const 1)))
            (br $find)))
        ;; No pivot: the column contributes no rank.
        (if (i32.lt_s (local.get $pivot_row) (i32.const 0))
          (then
            (local.set $col (i32.add (local.get $col) (i32.const 1)))
            (br $cols)))
        ;; Swap the pivot row into position `rank`.
        (if (i32.ne (local.get $pivot_row) (local.get $rank))
          (then
            (local.set $j (i32.const 0))
            (block $swap_done
              (loop $swap
                (br_if $swap_done (i32.ge_u (local.get $j) (local.get $total_columns)))
                (memory.copy (call $abs (local.get $tmp_slot))
                  (call $abs (i32.add (local.get $work) (i32.mul
                    (i32.add (i32.mul (local.get $rank) (local.get $total_columns)) (local.get $j))
                    (global.get $VALUE_SIZE))))
                  (global.get $VALUE_SIZE))
                (memory.copy
                  (call $abs (i32.add (local.get $work) (i32.mul
                    (i32.add (i32.mul (local.get $rank) (local.get $total_columns)) (local.get $j))
                    (global.get $VALUE_SIZE))))
                  (call $abs (i32.add (local.get $work) (i32.mul
                    (i32.add (i32.mul (local.get $pivot_row) (local.get $total_columns)) (local.get $j))
                    (global.get $VALUE_SIZE))))
                  (global.get $VALUE_SIZE))
                (memory.copy
                  (call $abs (i32.add (local.get $work) (i32.mul
                    (i32.add (i32.mul (local.get $pivot_row) (local.get $total_columns)) (local.get $j))
                    (global.get $VALUE_SIZE))))
                  (call $abs (local.get $tmp_slot))
                  (global.get $VALUE_SIZE))
                (local.set $j (i32.add (local.get $j) (i32.const 1)))
                (br $swap)))))
        ;; Eliminate every row except the pivot row.
        (local.set $i (i32.const 0))
        (block $i_done
          (loop $i_loop
            (br_if $i_done (i32.ge_u (local.get $i) (local.get $row_count)))
            (if (i32.eq (local.get $i) (local.get $rank))
              (then
                (local.set $i (i32.add (local.get $i) (i32.const 1)))
                (br $i_loop)))
            (local.set $j (i32.const 0))
            (block $j_done
              (loop $j_loop
                (br_if $j_done (i32.ge_u (local.get $j) (local.get $total_columns)))
                (if (i32.eq (local.get $j) (local.get $col))
                  (then
                    (local.set $j (i32.add (local.get $j) (i32.const 1)))
                    (br $j_loop)))
                ;; t1 = pivot · work[i][j]
                (if (call $matrix_entry_binary (i32.const 2)
                      (i32.add (local.get $work) (i32.mul
                        (i32.add (i32.mul (local.get $rank) (local.get $total_columns)) (local.get $col))
                        (global.get $VALUE_SIZE)))
                      (i32.add (local.get $work) (i32.mul
                        (i32.add (i32.mul (local.get $i) (local.get $total_columns)) (local.get $j))
                        (global.get $VALUE_SIZE)))
                      (local.get $t1_slot))
                  (then (return (i32.const 1))))
                (if (global.get $memory_pressure_signaled) (then (return (i32.const 1))))
                ;; t2 = work[i][col] · work[rank][j]
                (if (call $matrix_entry_binary (i32.const 2)
                      (i32.add (local.get $work) (i32.mul
                        (i32.add (i32.mul (local.get $i) (local.get $total_columns)) (local.get $col))
                        (global.get $VALUE_SIZE)))
                      (i32.add (local.get $work) (i32.mul
                        (i32.add (i32.mul (local.get $rank) (local.get $total_columns)) (local.get $j))
                        (global.get $VALUE_SIZE)))
                      (local.get $t2_slot))
                  (then (return (i32.const 1))))
                (if (global.get $memory_pressure_signaled) (then (return (i32.const 1))))
                ;; num = t1 − t2
                (if (call $matrix_entry_binary (i32.const 1)
                      (local.get $t1_slot) (local.get $t2_slot) (local.get $num_slot))
                  (then (return (i32.const 1))))
                (if (global.get $memory_pressure_signaled) (then (return (i32.const 1))))
                ;; work[i][j] = num / prev (exact)
                (if (call $matrix_entry_divide
                      (local.get $num_slot) (local.get $prev_slot)
                      (i32.add (local.get $work) (i32.mul
                        (i32.add (i32.mul (local.get $i) (local.get $total_columns)) (local.get $j))
                        (global.get $VALUE_SIZE))))
                  (then (return (i32.const 1))))
                (if (global.get $memory_pressure_signaled) (then (return (i32.const 1))))
                (local.set $j (i32.add (local.get $j) (i32.const 1)))
                (br $j_loop)))
            ;; The eliminated column entry becomes exactly zero.
            (call $expression_write_zero
              (i32.add (local.get $work) (i32.mul
                (i32.add (i32.mul (local.get $i) (local.get $total_columns)) (local.get $col))
                (global.get $VALUE_SIZE))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $i_loop)))
        ;; Ring 5 (5c): record the selected pivot when it is not a
        ;; numeric fact — a symbolic pivot is an ASSUMPTION the
        ;; result is conditional on. The pivot row is untouched by
        ;; its own elimination step, so the cell still holds the
        ;; selected value here.
        (if (global.get $matrix_pivot_record_base)
          (then
            (if (i32.eqz (call $expression_slot_is_numeric
                  (i32.add (local.get $work) (i32.mul
                    (i32.add (i32.mul (local.get $rank) (local.get $total_columns)) (local.get $col))
                    (global.get $VALUE_SIZE)))))
              (then
                (memory.copy
                  (call $abs (i32.add (global.get $matrix_pivot_record_base)
                    (i32.mul (global.get $matrix_pivot_record_count) (global.get $VALUE_SIZE))))
                  (call $abs (i32.add (local.get $work) (i32.mul
                    (i32.add (i32.mul (local.get $rank) (local.get $total_columns)) (local.get $col))
                    (global.get $VALUE_SIZE))))
                  (global.get $VALUE_SIZE))
                (global.set $matrix_pivot_record_count
                  (i32.add (global.get $matrix_pivot_record_count) (i32.const 1)))))))
        (if (global.get $matrix_solve_pivot_columns)
          (then (i32.store (call $abs (i32.add (global.get $matrix_solve_pivot_columns)
            (i32.mul (local.get $rank) (i32.const 4)))) (local.get $col))))
        ;; prev = this pivot; advance.
        (memory.copy
          (call $abs (local.get $prev_slot))
          (call $abs (i32.add (local.get $work) (i32.mul
            (i32.add (i32.mul (local.get $rank) (local.get $total_columns)) (local.get $col))
            (global.get $VALUE_SIZE))))
          (global.get $VALUE_SIZE))
        (local.set $rank (i32.add (local.get $rank) (i32.const 1)))
        (local.set $col (i32.add (local.get $col) (i32.const 1)))
        (br $cols)))
    (global.set $matrix_reduce_rank (local.get $rank))
    (i32.const 0)
  )

  ;; Carve the engine's working area: slot_count value slots + the five
  ;; scratch slots (prev, t1, t2, num, tmp). Returns the work base, or
  ;; 0 on pressure refusal.
  (func $matrix_reduce_carve (param $slot_count i32) (result i32)
    (if (call $expression_walk_guard
          (i32.add
            (i32.mul
              (i32.add (local.get $slot_count) (i32.const 5))
              (global.get $VALUE_SIZE))
            (i32.const 64)))
      (then (return (i32.const 0))))
    (call $carve_scratch_blob
      (i32.mul
        (i32.add (local.get $slot_count) (i32.const 5))
        (global.get $VALUE_SIZE)))
  )

  ;; inverse(M) — Montante on [M | I]; full rank required. Every output
  ;; entry is one exact division: right-block entry over the row's
  ;; diagonal pivot.
  (func $matrix_inverse
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $arg1_type i32)
    (local $arg1_lo i32)
    (local $n i32)
    (local $tc i32)
    (local $a_data i32)
    (local $work i32)
    (local $prev_slot i32)
    (local $t1_slot i32)
    (local $t2_slot i32)
    (local $num_slot i32)
    (local $tmp_slot i32)
    (local $entries_pointer i32)
    (local $entries_data i32)
    (local $i i32)
    (local $j i32)
    (local $slot i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $arg1_type (call $value_type (local.get $argument1_pointer)))
        (local.set $arg1_lo (call $value_data_lo (local.get $argument1_pointer)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (i32.ne (local.get $arg1_type) (global.get $TYPE_MATRIX))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_MATRIX_NOT_MATRIX))))))
    (local.set $n (call $matrix_rows_of (local.get $arg1_lo)))
    (if (i32.ne (local.get $n) (call $matrix_columns_of (local.get $arg1_lo)))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_MATRIX_NOT_SQUARE))))))
    ;; 0x0 is its own inverse.
    (if (i32.eqz (local.get $n))
      (then
        (local.set $entries_pointer (call $matrix_budget_and_alloc_entries (i32.const 0)))
        (if (i32.eqz (local.get $entries_pointer))
          (then (return (i32.const 0))))
        (call $expression_freeze_args_array (local.get $entries_pointer))
        (call $push_matrix (call $matrix_allocate
          (i32.const 0) (i32.const 0) (local.get $entries_pointer)))
        (return (i32.const 0))))
    ;; Working area: n × 2n augmented [M | I].
    (local.set $tc (i32.mul (local.get $n) (i32.const 2)))
    (local.set $work (call $matrix_reduce_carve (i32.mul (local.get $n) (local.get $tc))))
    (if (i32.eqz (local.get $work))
      (then (return (i32.const 0))))
    (local.set $prev_slot (i32.add (local.get $work)
      (i32.mul (i32.mul (local.get $n) (local.get $tc)) (global.get $VALUE_SIZE))))
    (local.set $t1_slot (i32.add (local.get $prev_slot) (global.get $VALUE_SIZE)))
    (local.set $t2_slot (i32.add (local.get $t1_slot) (global.get $VALUE_SIZE)))
    (local.set $num_slot (i32.add (local.get $t2_slot) (global.get $VALUE_SIZE)))
    (local.set $tmp_slot (i32.add (local.get $num_slot) (global.get $VALUE_SIZE)))
    (local.set $a_data (i32.load (call $abs (i32.add
      (call $matrix_entries_of (local.get $arg1_lo)) (i32.const 16)))))
    ;; Fill [M | I] row by row.
    (local.set $i (i32.const 0))
    (block $fill_done
      (loop $fill
        (br_if $fill_done (i32.ge_u (local.get $i) (local.get $n)))
        (memory.copy
          (call $abs (i32.add (local.get $work)
            (i32.mul (i32.mul (local.get $i) (local.get $tc)) (global.get $VALUE_SIZE))))
          (call $abs (i32.add
            (i32.add (local.get $a_data) (global.get $GC_HEADER_SIZE))
            (i32.mul (i32.mul (local.get $i) (local.get $n)) (global.get $VALUE_SIZE))))
          (i32.mul (local.get $n) (global.get $VALUE_SIZE)))
        (local.set $j (i32.const 0))
        (block $identity_done
          (loop $identity
            (br_if $identity_done (i32.ge_u (local.get $j) (local.get $n)))
            (local.set $slot (i32.add (local.get $work)
              (i32.mul
                (i32.add
                  (i32.add (i32.mul (local.get $i) (local.get $tc)) (local.get $n))
                  (local.get $j))
                (global.get $VALUE_SIZE))))
            (if (i32.eq (local.get $i) (local.get $j))
              (then (call $expression_write_one (local.get $slot)))
              (else (call $expression_write_zero (local.get $slot))))
            (local.set $j (i32.add (local.get $j) (i32.const 1)))
            (br $identity)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $fill)))
    (if (call $matrix_reduce_montante
          (local.get $work) (local.get $n) (local.get $tc) (local.get $n)
          (local.get $prev_slot) (local.get $t1_slot) (local.get $t2_slot)
          (local.get $num_slot) (local.get $tmp_slot))
      (then (return (i32.const 0))))
    (if (i32.lt_u (global.get $matrix_reduce_rank) (local.get $n))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_MATRIX_SINGULAR))))))
    ;; Result entries: right block over the row's diagonal pivot.
    (local.set $entries_pointer (call $matrix_budget_and_alloc_entries
      (i32.mul (local.get $n) (local.get $n))))
    (if (i32.eqz (local.get $entries_pointer))
      (then (return (i32.const 0))))
    (local.set $entries_data (i32.load (call $abs (i32.add (local.get $entries_pointer) (i32.const 16)))))
    (local.set $i (i32.const 0))
    (block $out_done
      (loop $out_rows
        (br_if $out_done (i32.ge_u (local.get $i) (local.get $n)))
        (local.set $j (i32.const 0))
        (block $out_row_done
          (loop $out_row
            (br_if $out_row_done (i32.ge_u (local.get $j) (local.get $n)))
            (if (call $matrix_entry_divide
                  (i32.add (local.get $work)
                    (i32.mul
                      (i32.add
                        (i32.add (i32.mul (local.get $i) (local.get $tc)) (local.get $n))
                        (local.get $j))
                      (global.get $VALUE_SIZE)))
                  (i32.add (local.get $work)
                    (i32.mul
                      (i32.add (i32.mul (local.get $i) (local.get $tc)) (local.get $i))
                      (global.get $VALUE_SIZE)))
                  (i32.add
                    (i32.add (local.get $entries_data) (global.get $GC_HEADER_SIZE))
                    (i32.mul
                      (i32.add (i32.mul (local.get $i) (local.get $n)) (local.get $j))
                      (global.get $VALUE_SIZE))))
              (then (return (i32.const 0))))
            (if (global.get $memory_pressure_signaled) (then (return (i32.const 0))))
            (local.set $j (i32.add (local.get $j) (i32.const 1)))
            (br $out_row)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $out_rows)))
    (call $expression_freeze_args_array (local.get $entries_pointer))
    (call $push_matrix (call $matrix_allocate
      (local.get $n) (local.get $n) (local.get $entries_pointer)))
    (i32.const 0)
  )

  ;; solve(A, b) — Montante on [A | b]. b is an m × 1 Matrix or a plain
  ;; Array of m entries. Throws on inconsistent systems (a zeroed row
  ;; with nonzero augmented entry) and on underdetermined ones
  ;; (rank < columns). Result is n × 1.
  (func $matrix_solve
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $arg1_type i32)
    (local $arg1_lo i32)
    (local $argument2_pointer i32)
    (local $arg2_type i32)
    (local $arg2_lo i32)
    (local $m i32)
    (local $n i32)
    (local $tc i32)
    (local $a_data i32)
    (local $b_data i32)
    (local $b_is_array i32)
    (local $work i32)
    (local $prev_slot i32)
    (local $t1_slot i32)
    (local $t2_slot i32)
    (local $num_slot i32)
    (local $tmp_slot i32)
    (local $entries_pointer i32)
    (local $entries_data i32)
    (local $i i32)
    (local $r i32)
    (local $pivot_columns i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $arg1_type (call $value_type (local.get $argument1_pointer)))
        (local.set $arg1_lo (call $value_data_lo (local.get $argument1_pointer)))))
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then
        (local.set $argument2_pointer (i32.add (local.get $argument1_pointer) (global.get $VALUE_SIZE)))
        (local.set $arg2_type (call $value_type (local.get $argument2_pointer)))
        (local.set $arg2_lo (call $value_data_lo (local.get $argument2_pointer)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (i32.ne (local.get $arg1_type) (global.get $TYPE_MATRIX))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_MATRIX_NOT_MATRIX))))))
    (local.set $m (call $matrix_rows_of (local.get $arg1_lo)))
    (local.set $n (call $matrix_columns_of (local.get $arg1_lo)))
    ;; b: an m × 1 Matrix, or a plain Array of m allowed entries.
    (local.set $b_is_array (i32.const 0))
    (if (i32.eq (local.get $arg2_type) (global.get $TYPE_MATRIX))
      (then
        (if (i32.or
              (i32.ne (call $matrix_rows_of (local.get $arg2_lo)) (local.get $m))
              (i32.ne (call $matrix_columns_of (local.get $arg2_lo)) (i32.const 1)))
          (then (return (i32.add (i32.const 1)
            (call $throw_type_error_with_message (global.get $BUILTIN_MSG_MATRIX_SHAPE_MISMATCH))))))
        (local.set $b_data (i32.load (call $abs (i32.add
          (call $matrix_entries_of (local.get $arg2_lo)) (i32.const 16))))))
      (else
        (if (i32.ne (local.get $arg2_type) (global.get $TYPE_ARRAY))
          (then (return (i32.add (i32.const 1)
            (call $throw_type_error_with_message (global.get $BUILTIN_MSG_MATRIX_NOT_MATRIX))))))
        (local.set $b_is_array (i32.const 1))
        (if (i32.ne (i32.load (call $abs (i32.add (local.get $arg2_lo) (i32.const 8)))) (local.get $m))
          (then (return (i32.add (i32.const 1)
            (call $throw_type_error_with_message (global.get $BUILTIN_MSG_MATRIX_SHAPE_MISMATCH))))))
        (local.set $b_data (i32.load (call $abs (i32.add (local.get $arg2_lo) (i32.const 16)))))
        (local.set $i (i32.const 0))
        (block $validate_done
          (loop $validate
            (br_if $validate_done (i32.ge_u (local.get $i) (local.get $m)))
            (if (i32.eqz (call $matrix_entry_type_ok (call $value_type (i32.add
                  (i32.add (local.get $b_data) (global.get $GC_HEADER_SIZE))
                  (i32.mul (local.get $i) (global.get $VALUE_SIZE))))))
              (then (return (i32.add (i32.const 1)
                (call $throw_type_error_with_message (global.get $BUILTIN_MSG_MATRIX_ENTRY_TYPE))))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $validate)))))
    ;; Working area: m × (n + 1) augmented [A | b].
    (local.set $tc (i32.add (local.get $n) (i32.const 1)))
    (local.set $work (call $matrix_reduce_carve (i32.mul (local.get $m) (local.get $tc))))
    (if (i32.eqz (local.get $work))
      (then (return (i32.const 0))))
    (local.set $prev_slot (i32.add (local.get $work)
      (i32.mul (i32.mul (local.get $m) (local.get $tc)) (global.get $VALUE_SIZE))))
    (local.set $t1_slot (i32.add (local.get $prev_slot) (global.get $VALUE_SIZE)))
    (local.set $t2_slot (i32.add (local.get $t1_slot) (global.get $VALUE_SIZE)))
    (local.set $num_slot (i32.add (local.get $t2_slot) (global.get $VALUE_SIZE)))
    (local.set $tmp_slot (i32.add (local.get $num_slot) (global.get $VALUE_SIZE)))
    (local.set $a_data (i32.load (call $abs (i32.add
      (call $matrix_entries_of (local.get $arg1_lo)) (i32.const 16)))))
    (local.set $i (i32.const 0))
    (block $fill_done
      (loop $fill
        (br_if $fill_done (i32.ge_u (local.get $i) (local.get $m)))
        (memory.copy
          (call $abs (i32.add (local.get $work)
            (i32.mul (i32.mul (local.get $i) (local.get $tc)) (global.get $VALUE_SIZE))))
          (call $abs (i32.add
            (i32.add (local.get $a_data) (global.get $GC_HEADER_SIZE))
            (i32.mul (i32.mul (local.get $i) (local.get $n)) (global.get $VALUE_SIZE))))
          (i32.mul (local.get $n) (global.get $VALUE_SIZE)))
        (memory.copy
          (call $abs (i32.add (local.get $work)
            (i32.mul
              (i32.add (i32.mul (local.get $i) (local.get $tc)) (local.get $n))
              (global.get $VALUE_SIZE))))
          (call $abs (i32.add
            (i32.add (local.get $b_data) (global.get $GC_HEADER_SIZE))
            (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
          (global.get $VALUE_SIZE))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $fill)))
    (if (call $expression_walk_guard (i32.mul (local.get $n) (i32.const 4)))
      (then (return (i32.const 0))))
    (local.set $pivot_columns (call $carve_scratch_blob
      (i32.mul (local.get $n) (i32.const 4))))
    (global.set $matrix_solve_pivot_columns (local.get $pivot_columns))
    (if (call $matrix_reduce_montante
          (local.get $work) (local.get $m) (local.get $tc) (local.get $n)
          (local.get $prev_slot) (local.get $t1_slot) (local.get $t2_slot)
          (local.get $num_slot) (local.get $tmp_slot))
      (then
        (global.set $matrix_solve_pivot_columns (i32.const 0))
        (return (i32.const 0))))
    (global.set $matrix_solve_pivot_columns (i32.const 0))
    ;; Tagged results ensure a
    ;; mathematically valid system never throws. Inconsistency: a
    ;; rank-exhausted row whose augmented entry is nonzero reduces to
    ;; [0 ... 0 | nonzero] -> { kind: "none" }.
    (local.set $r (global.get $matrix_reduce_rank))
    (block $consistent_done
      (loop $consistent
        (br_if $consistent_done (i32.ge_u (local.get $r) (local.get $m)))
        (if (i32.eqz (call $expression_value_is_zero_wide
              (i32.add (local.get $work)
                (i32.mul
                  (i32.add (i32.mul (local.get $r) (local.get $tc)) (local.get $n))
                  (global.get $VALUE_SIZE)))))
          (then (return (call $matrix_solve_emit_none (local.get $stack_base)))))
        (local.set $r (i32.add (local.get $r) (i32.const 1)))
        (br $consistent)))
    (if (i32.lt_u (global.get $matrix_reduce_rank) (local.get $n))
      (then (return (call $matrix_solve_emit_family
        (local.get $work) (local.get $tc) (local.get $n)
        (local.get $pivot_columns) (global.get $matrix_reduce_rank)))))
    ;; Unique solution: x[i] = work[i][n] / work[i][i], as n x 1.
    (local.set $entries_pointer (call $matrix_budget_and_alloc_entries (local.get $n)))
    (if (i32.eqz (local.get $entries_pointer))
      (then (return (i32.const 0))))
    (local.set $entries_data (i32.load (call $abs (i32.add (local.get $entries_pointer) (i32.const 16)))))
    (local.set $i (i32.const 0))
    (block $out_done
      (loop $out
        (br_if $out_done (i32.ge_u (local.get $i) (local.get $n)))
        (if (call $matrix_entry_divide
              (i32.add (local.get $work)
                (i32.mul
                  (i32.add (i32.mul (local.get $i) (local.get $tc)) (local.get $n))
                  (global.get $VALUE_SIZE)))
              (i32.add (local.get $work)
                (i32.mul
                  (i32.add (i32.mul (local.get $i) (local.get $tc)) (local.get $i))
                  (global.get $VALUE_SIZE)))
              (i32.add
                (i32.add (local.get $entries_data) (global.get $GC_HEADER_SIZE))
                (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
          (then (return (i32.const 0))))
        (if (global.get $memory_pressure_signaled) (then (return (i32.const 0))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $out)))
    (call $expression_freeze_args_array (local.get $entries_pointer))
    (return (call $matrix_solve_emit_tagged
      (global.get $BUILTIN_LIT_SOLVE_UNIQUE)
      (global.get $BUILTIN_KEY_SOLUTION)
      (call $matrix_allocate (local.get $n) (i32.const 1) (local.get $entries_pointer))))
  )

  ;; { kind: "none" } for inconsistent systems.
  (func $matrix_solve_emit_none (param $stack_base i32) (result i32)
    (local $slot i32)
    (local $pairs i32)
    (local $record i32)
    (if (call $expression_walk_guard (i32.const 512))
      (then (return (i32.const 0))))
    (local.set $slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (local.set $pairs (call $carve_scratch_blob (i32.const 8)))
    (call $write_value (local.get $slot)
      (global.get $TYPE_STRING) (i32.const 0)
      (call $read_builtin (global.get $BUILTIN_LIT_SOLVE_NONE)) (i32.const 0))
    (i32.store (call $abs (local.get $pairs)) (global.get $BUILTIN_KEY_KIND))
    (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 4))) (local.get $slot))
    (local.set $record (call $calculus_record (local.get $pairs) (i32.const 1)))
    (if (i32.eqz (local.get $record)) (then (return (i32.const 0))))
    (call $pending_push (global.get $TYPE_OBJECT) (i32.const 0)
      (local.get $record) (i32.const 0))
    (i32.const 0)
  )

  ;; { kind, <key>: matrix-or-array } tagged record.
  (func $matrix_solve_emit_tagged
    (param $kind_builtin i32) (param $value_key i32) (param $matrix_header i32)
    (result i32)
    (local $slots i32)
    (local $pairs i32)
    (local $record i32)
    (if (call $expression_walk_guard (i32.const 512))
      (then (return (i32.const 0))))
    (local.set $slots (call $carve_scratch_blob (i32.const 32)))
    (local.set $pairs (call $carve_scratch_blob (i32.const 16)))
    (call $write_value (local.get $slots)
      (global.get $TYPE_STRING) (i32.const 0)
      (call $read_builtin (local.get $kind_builtin)) (i32.const 0))
    (call $write_value (i32.add (local.get $slots) (i32.const 16))
      (global.get $TYPE_MATRIX) (i32.const 0) (local.get $matrix_header) (i32.const 0))
    (i32.store (call $abs (local.get $pairs)) (global.get $BUILTIN_KEY_KIND))
    (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 4))) (local.get $slots))
    (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 8))) (local.get $value_key))
    (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 12)))
      (i32.add (local.get $slots) (i32.const 16)))
    (local.set $record (call $calculus_record (local.get $pairs) (i32.const 2)))
    (if (i32.eqz (local.get $record)) (then (return (i32.const 0))))
    (call $pending_push (global.get $TYPE_OBJECT) (i32.const 0)
      (local.get $record) (i32.const 0))
    (i32.const 0)
  )

  ;; { kind: "family", particular, basis } for consistent underdetermined
  ;; systems. particular sets every free variable to zero; basis holds one
  ;; n x 1 Matrix per free column (that free variable set to one).
  (func $matrix_solve_emit_family
    (param $work i32) (param $total_columns i32) (param $columns i32)
    (param $pivot_columns i32) (param $rank i32)
    (result i32)
    (local $entries_pointer i32)
    (local $entries_data i32)
    (local $i i32)
    (local $r i32)
    (local $free_count i32)
    (local $is_pivot i32)
    (local $basis_array i32)
    (local $basis_data i32)
    (local $basis_index i32)
    (local $pivot_column i32)
    (local $zero_slot i32)
    (local $negated_slot i32)
    (local $slots i32)
    (local $pairs i32)
    (local $record i32)
    (local $particular i32)
    (if (call $expression_walk_guard (i32.add (i32.const 2048)
          (i32.mul (local.get $columns) (i32.const 64))))
      (then (return (i32.const 0))))
    (local.set $is_pivot (call $carve_scratch_blob
      (i32.mul (local.get $columns) (i32.const 4))))
    (local.set $zero_slot (call $carve_scratch_blob (i32.const 32)))
    (local.set $negated_slot (i32.add (local.get $zero_slot) (i32.const 16)))
    (call $write_inline_rational (local.get $zero_slot) (i64.const 0))
    (local.set $i (i32.const 0))
    (block $flags_done
      (loop $flags
        (br_if $flags_done (i32.ge_u (local.get $i) (local.get $columns)))
        (i32.store (call $abs (i32.add (local.get $is_pivot)
          (i32.mul (local.get $i) (i32.const 4)))) (i32.const 0))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $flags)))
    (local.set $r (i32.const 0))
    (block $mark_done
      (loop $mark
        (br_if $mark_done (i32.ge_u (local.get $r) (local.get $rank)))
        (i32.store (call $abs (i32.add (local.get $is_pivot)
          (i32.mul (i32.load (call $abs (i32.add (local.get $pivot_columns)
            (i32.mul (local.get $r) (i32.const 4))))) (i32.const 4))))
          (i32.const 1))
        (local.set $r (i32.add (local.get $r) (i32.const 1)))
        (br $mark)))
    (local.set $free_count (i32.sub (local.get $columns) (local.get $rank)))
    ;; Particular solution: free variables zero, pivot variables solved.
    (local.set $entries_pointer (call $matrix_budget_and_alloc_entries (local.get $columns)))
    (if (i32.eqz (local.get $entries_pointer)) (then (return (i32.const 0))))
    (local.set $entries_data (i32.add
      (i32.load (call $abs (i32.add (local.get $entries_pointer) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (local.set $i (i32.const 0))
    (block $particular_zero_done
      (loop $particular_zero
        (br_if $particular_zero_done (i32.ge_u (local.get $i) (local.get $columns)))
        (call $write_inline_rational (i32.add (local.get $entries_data)
          (i32.mul (local.get $i) (global.get $VALUE_SIZE))) (i64.const 0))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $particular_zero)))
    (local.set $r (i32.const 0))
    (block $particular_done
      (loop $particular_fill
        (br_if $particular_done (i32.ge_u (local.get $r) (local.get $rank)))
        (local.set $pivot_column (i32.load (call $abs (i32.add (local.get $pivot_columns)
          (i32.mul (local.get $r) (i32.const 4))))))
        (if (call $matrix_entry_divide
              (i32.add (local.get $work) (i32.mul
                (i32.add (i32.mul (local.get $r) (local.get $total_columns))
                  (local.get $columns))
                (global.get $VALUE_SIZE)))
              (i32.add (local.get $work) (i32.mul
                (i32.add (i32.mul (local.get $r) (local.get $total_columns))
                  (local.get $pivot_column))
                (global.get $VALUE_SIZE)))
              (i32.add (local.get $entries_data)
                (i32.mul (local.get $pivot_column) (global.get $VALUE_SIZE))))
          (then (return (i32.const 0))))
        (if (global.get $memory_pressure_signaled) (then (return (i32.const 0))))
        (local.set $r (i32.add (local.get $r) (i32.const 1)))
        (br $particular_fill)))
    (call $expression_freeze_args_array (local.get $entries_pointer))
    (local.set $particular (call $matrix_allocate
      (local.get $columns) (i32.const 1) (local.get $entries_pointer)))
    ;; Basis: one column vector per free column.
    (local.set $basis_array (call $allocate_array (local.get $free_count)))
    (local.set $basis_data (i32.add
      (i32.load (call $abs (i32.add (local.get $basis_array) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (local.set $basis_index (i32.const 0))
    (local.set $i (i32.const 0))
    (block $basis_done
      (loop $basis
        (br_if $basis_done (i32.ge_u (local.get $i) (local.get $columns)))
        (if (i32.eqz (i32.load (call $abs (i32.add (local.get $is_pivot)
              (i32.mul (local.get $i) (i32.const 4))))))
          (then
            (local.set $entries_pointer (call $matrix_budget_and_alloc_entries
              (local.get $columns)))
            (if (i32.eqz (local.get $entries_pointer)) (then (return (i32.const 0))))
            (local.set $entries_data (i32.add
              (i32.load (call $abs (i32.add (local.get $entries_pointer) (i32.const 16))))
              (global.get $GC_HEADER_SIZE)))
            (local.set $r (i32.const 0))
            (block $vector_zero_done
              (loop $vector_zero
                (br_if $vector_zero_done (i32.ge_u (local.get $r) (local.get $columns)))
                (call $write_inline_rational (i32.add (local.get $entries_data)
                  (i32.mul (local.get $r) (global.get $VALUE_SIZE))) (i64.const 0))
                (local.set $r (i32.add (local.get $r) (i32.const 1)))
                (br $vector_zero)))
            (call $write_inline_rational (i32.add (local.get $entries_data)
              (i32.mul (local.get $i) (global.get $VALUE_SIZE))) (i64.const 1))
            (local.set $r (i32.const 0))
            (block $vector_done
              (loop $vector_fill
                (br_if $vector_done (i32.ge_u (local.get $r) (local.get $rank)))
                (local.set $pivot_column (i32.load (call $abs
                  (i32.add (local.get $pivot_columns)
                    (i32.mul (local.get $r) (i32.const 4))))))
                (if (call $matrix_entry_divide
                      (i32.add (local.get $work) (i32.mul
                        (i32.add (i32.mul (local.get $r) (local.get $total_columns))
                          (local.get $i))
                        (global.get $VALUE_SIZE)))
                      (i32.add (local.get $work) (i32.mul
                        (i32.add (i32.mul (local.get $r) (local.get $total_columns))
                          (local.get $pivot_column))
                        (global.get $VALUE_SIZE)))
                      (local.get $negated_slot))
                  (then (return (i32.const 0))))
                (if (global.get $memory_pressure_signaled) (then (return (i32.const 0))))
                ;; v[pivot] = 0 - quotient.
                (if (call $matrix_entry_binary (i32.const 1)
                      (local.get $zero_slot) (local.get $negated_slot)
                      (i32.add (local.get $entries_data)
                        (i32.mul (local.get $pivot_column) (global.get $VALUE_SIZE))))
                  (then (return (i32.const 0))))
                (if (global.get $memory_pressure_signaled) (then (return (i32.const 0))))
                (local.set $r (i32.add (local.get $r) (i32.const 1)))
                (br $vector_fill)))
            (call $expression_freeze_args_array (local.get $entries_pointer))
            (call $write_value (i32.add (local.get $basis_data)
              (i32.mul (local.get $basis_index) (global.get $VALUE_SIZE)))
              (global.get $TYPE_MATRIX) (i32.const 0)
              (call $matrix_allocate (local.get $columns) (i32.const 1)
                (local.get $entries_pointer))
              (i32.const 0))
            (local.set $basis_index (i32.add (local.get $basis_index) (i32.const 1)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $basis)))
    (call $expression_freeze_args_array (local.get $basis_array))
    ;; { kind: "family", particular, basis }.
    (local.set $slots (call $carve_scratch_blob (i32.const 48)))
    (local.set $pairs (call $carve_scratch_blob (i32.const 24)))
    (call $write_value (local.get $slots)
      (global.get $TYPE_STRING) (i32.const 0)
      (call $read_builtin (global.get $BUILTIN_LIT_SOLVE_FAMILY)) (i32.const 0))
    (call $write_value (i32.add (local.get $slots) (i32.const 16))
      (global.get $TYPE_MATRIX) (i32.const 0) (local.get $particular) (i32.const 0))
    (call $write_value (i32.add (local.get $slots) (i32.const 32))
      (global.get $TYPE_ARRAY) (i32.const 0) (local.get $basis_array) (i32.const 0))
    (i32.store (call $abs (local.get $pairs)) (global.get $BUILTIN_KEY_KIND))
    (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 4))) (local.get $slots))
    (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 8)))
      (global.get $BUILTIN_KEY_PARTICULAR))
    (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 12)))
      (i32.add (local.get $slots) (i32.const 16)))
    (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 16)))
      (global.get $BUILTIN_KEY_BASIS))
    (i32.store (call $abs (i32.add (local.get $pairs) (i32.const 20)))
      (i32.add (local.get $slots) (i32.const 32)))
    (local.set $record (call $calculus_record (local.get $pairs) (i32.const 3)))
    (if (i32.eqz (local.get $record)) (then (return (i32.const 0))))
    (call $pending_push (global.get $TYPE_OBJECT) (i32.const 0)
      (local.get $record) (i32.const 0))
    (i32.const 0)
  )

  ;; rank(M) — pivot count of the fraction-free reduction. For symbolic
  ;; entries the result is conditional on the pivoting Symbols being
  ;; nonzero (same caveat as inverse).
  (func $matrix_rank
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $arg1_type i32)
    (local $arg1_lo i32)
    (local $m i32)
    (local $n i32)
    (local $work i32)
    (local $prev_slot i32)
    (local $t1_slot i32)
    (local $t2_slot i32)
    (local $num_slot i32)
    (local $tmp_slot i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $arg1_type (call $value_type (local.get $argument1_pointer)))
        (local.set $arg1_lo (call $value_data_lo (local.get $argument1_pointer)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (i32.ne (local.get $arg1_type) (global.get $TYPE_MATRIX))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_MATRIX_NOT_MATRIX))))))
    (local.set $m (call $matrix_rows_of (local.get $arg1_lo)))
    (local.set $n (call $matrix_columns_of (local.get $arg1_lo)))
    (if (i32.eqz (i32.mul (local.get $m) (local.get $n)))
      (then
        (call $push_rational_inline (i64.const 0))
        (return (i32.const 0))))
    (local.set $work (call $matrix_reduce_carve (i32.mul (local.get $m) (local.get $n))))
    (if (i32.eqz (local.get $work))
      (then (return (i32.const 0))))
    (local.set $prev_slot (i32.add (local.get $work)
      (i32.mul (i32.mul (local.get $m) (local.get $n)) (global.get $VALUE_SIZE))))
    (local.set $t1_slot (i32.add (local.get $prev_slot) (global.get $VALUE_SIZE)))
    (local.set $t2_slot (i32.add (local.get $t1_slot) (global.get $VALUE_SIZE)))
    (local.set $num_slot (i32.add (local.get $t2_slot) (global.get $VALUE_SIZE)))
    (local.set $tmp_slot (i32.add (local.get $num_slot) (global.get $VALUE_SIZE)))
    (memory.copy
      (call $abs (local.get $work))
      (call $abs (i32.add
        (i32.load (call $abs (i32.add
          (call $matrix_entries_of (local.get $arg1_lo)) (i32.const 16))))
        (global.get $GC_HEADER_SIZE)))
      (i32.mul (i32.mul (local.get $m) (local.get $n)) (global.get $VALUE_SIZE)))
    (if (call $matrix_reduce_montante
          (local.get $work) (local.get $m) (local.get $n) (local.get $n)
          (local.get $prev_slot) (local.get $t1_slot) (local.get $t2_slot)
          (local.get $num_slot) (local.get $tmp_slot))
      (then (return (i32.const 0))))
    (call $push_rational_inline (i64.extend_i32_u (global.get $matrix_reduce_rank)))
    (i32.const 0)
  )

  ;; ==========================================================================
  ;; Expression equality + substitution — Ring 2 (2c)
  ;; ==========================================================================

  ;; Deep structural equality for two value slots. Used by
  ;; Exact.Expression.equal. Returns 1/0.
  ;;
  ;; For atoms, uses Ring 1 semantic equality for numerics (so Add(2n, x)
  ;; equals Add(2, x) at the leaf level) and pointer equality for Symbols
  ;; (which gives registry-backed identity for free). For expressions,
  ;; head-and-args recurse.
  (func $expression_values_equal (param $a_pointer i32) (param $b_pointer i32) (result i32)
    (local $a_type i32)
    (local $b_type i32)
    (local $a_lo i32)
    (local $b_lo i32)
    (local $a_args i32)
    (local $b_args i32)
    (local $a_length i32)
    (local $b_length i32)
    (local $a_data i32)
    (local $b_data i32)
    (local $i i32)

    (local.set $a_type (call $value_type (local.get $a_pointer)))
    (local.set $b_type (call $value_type (local.get $b_pointer)))
    (local.set $a_lo (call $value_data_lo (local.get $a_pointer)))
    (local.set $b_lo (call $value_data_lo (local.get $b_pointer)))

    ;; Symbol == Symbol: pointer equality (registry-backed or fresh-same).
    (if (i32.and
          (i32.eq (local.get $a_type) (global.get $TYPE_SYMBOL))
          (i32.eq (local.get $b_type) (global.get $TYPE_SYMBOL)))
      (then (return (i32.eq (local.get $a_lo) (local.get $b_lo)))))

    ;; Both Expressions: same head AND same-length args AND all args equal.
    (if (i32.and
          (i32.eq (local.get $a_type) (global.get $TYPE_EXPRESSION))
          (i32.eq (local.get $b_type) (global.get $TYPE_EXPRESSION)))
      (then
        ;; Head equality (Symbol pointer compare).
        (if (i32.ne
              (call $expression_head (local.get $a_lo))
              (call $expression_head (local.get $b_lo)))
          (then (return (i32.const 0))))
        (local.set $a_args (call $expression_args (local.get $a_lo)))
        (local.set $b_args (call $expression_args (local.get $b_lo)))
        (local.set $a_length (i32.load (call $abs (i32.add (local.get $a_args) (i32.const 8)))))
        (local.set $b_length (i32.load (call $abs (i32.add (local.get $b_args) (i32.const 8)))))
        (if (i32.ne (local.get $a_length) (local.get $b_length))
          (then (return (i32.const 0))))
        (if (i32.eqz (local.get $a_length))
          (then (return (i32.const 1))))
        (local.set $a_data (i32.load (call $abs (i32.add (local.get $a_args) (i32.const 16)))))
        (local.set $b_data (i32.load (call $abs (i32.add (local.get $b_args) (i32.const 16)))))
        (local.set $i (i32.const 0))
        (block $done
          (loop $compare_loop
            (br_if $done (i32.ge_u (local.get $i) (local.get $a_length)))
            (if (i32.eqz (call $expression_values_equal
                  (i32.add
                    (i32.add (local.get $a_data) (global.get $GC_HEADER_SIZE))
                    (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
                  (i32.add
                    (i32.add (local.get $b_data) (global.get $GC_HEADER_SIZE))
                    (i32.mul (local.get $i) (global.get $VALUE_SIZE)))))
              (then (return (i32.const 0))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $compare_loop)
          )
        )
        (return (i32.const 1))
      )
    )

    ;; Both Matrices: structural recursion (shape + per-entry equality).
    ;; Ring 4 — a Matrix inside an Expression is an honorary atom keyed
    ;; by this structural equality.
    (if (i32.and
          (i32.eq (local.get $a_type) (global.get $TYPE_MATRIX))
          (i32.eq (local.get $b_type) (global.get $TYPE_MATRIX)))
      (then (return (call $matrix_structural_equal (local.get $a_lo) (local.get $b_lo)))))

    ;; ComplexAlgebraicNumber leaves use stable component-header identity
    ;; for this allocation-free structural walker. Semantic equality remains
    ;; the public exact componentwise predicate.
    (if (i32.and
          (i32.eq (local.get $a_type) (global.get $TYPE_COMPLEX_ALGEBRAIC))
          (i32.eq (local.get $b_type) (global.get $TYPE_COMPLEX_ALGEBRAIC)))
      (then
        (if (i32.eq (local.get $a_lo) (local.get $b_lo))
          (then (return (i32.const 1))))
        (return (i32.and
          (i32.eq
            (call $complex_algebraic_real_pointer (local.get $a_lo))
            (call $complex_algebraic_real_pointer (local.get $b_lo)))
          (i32.eq
            (call $complex_algebraic_imaginary_pointer (local.get $a_lo))
            (call $complex_algebraic_imaginary_pointer (local.get $b_lo))))))
    )

    ;; Both AlgebraicNumbers (Ring 6c): structural snapshot equality —
    ;; same header, or same coefficients AND same current interval
    ;; endpoints. Allocation-free like the rest of this walker; the
    ;; SEMANTIC decision (same value through different defining
    ;; polynomials, which needs gcd + refinement) stays with
    ;; Exact.AlgebraicNumber.equals.
    (if (i32.and
          (i32.eq (local.get $a_type) (global.get $TYPE_ALGEBRAIC))
          (i32.eq (local.get $b_type) (global.get $TYPE_ALGEBRAIC)))
      (then
        (if (i32.eq (local.get $a_lo) (local.get $b_lo))
          (then (return (i32.const 1))))
        (local.set $a_args (call $algebraic_coefficients_of (local.get $a_lo)))
        (local.set $b_args (call $algebraic_coefficients_of (local.get $b_lo)))
        (local.set $a_length (i32.load (call $abs (i32.add (local.get $a_args) (i32.const 8)))))
        (local.set $b_length (i32.load (call $abs (i32.add (local.get $b_args) (i32.const 8)))))
        (if (i32.ne (local.get $a_length) (local.get $b_length))
          (then (return (i32.const 0))))
        (local.set $a_data (i32.load (call $abs (i32.add (local.get $a_args) (i32.const 16)))))
        (local.set $b_data (i32.load (call $abs (i32.add (local.get $b_args) (i32.const 16)))))
        (local.set $i (i32.const 0))
        (block $coefficients_done
          (loop $coefficients_loop
            (br_if $coefficients_done (i32.ge_u (local.get $i) (local.get $a_length)))
            (if (i32.ne (call $bigint_compare
                  (call $value_data_lo (i32.add
                    (i32.add (local.get $a_data) (global.get $GC_HEADER_SIZE))
                    (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
                  (call $value_data_lo (i32.add
                    (i32.add (local.get $b_data) (global.get $GC_HEADER_SIZE))
                    (i32.mul (local.get $i) (global.get $VALUE_SIZE)))))
                (i32.const 0))
              (then (return (i32.const 0))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $coefficients_loop)))
        (local.set $a_data (i32.add
          (i32.load (call $abs (i32.add
            (call $algebraic_interval_of (local.get $a_lo)) (i32.const 16))))
          (global.get $GC_HEADER_SIZE)))
        (local.set $b_data (i32.add
          (i32.load (call $abs (i32.add
            (call $algebraic_interval_of (local.get $b_lo)) (i32.const 16))))
          (global.get $GC_HEADER_SIZE)))
        (if (i32.ne (call $exact_numeric_slots_compare
              (local.get $a_data) (local.get $b_data)) (i32.const 0))
          (then (return (i32.const 0))))
        (return (i32.eqz (call $exact_numeric_slots_compare
          (i32.add (local.get $a_data) (global.get $VALUE_SIZE))
          (i32.add (local.get $b_data) (global.get $VALUE_SIZE)))))))

    ;; Numeric atom vs numeric atom: semantic equality via the
    ;; allocation-free comparison family (Ring 1 Exact.equal semantics)
    ;; so Add(2n, x) equals Add(2, x) structurally. Equality never
    ;; commits heap bytes; a compare too large for the tail scratch
    ;; sets the pressure flag and the caller aborts/retries.
    (if (i32.and
          (i32.eq (local.get $a_type) (global.get $TYPE_BIGINT))
          (i32.eq (local.get $b_type) (global.get $TYPE_BIGINT)))
      (then (return (i32.eqz (call $bigint_compare (local.get $a_lo) (local.get $b_lo))))))
    (if (i32.and
          (i32.eq (local.get $a_type) (global.get $TYPE_COMPLEX))
          (i32.eq (local.get $b_type) (global.get $TYPE_COMPLEX)))
      (then (return (call $complex_eq (local.get $a_lo) (local.get $b_lo)))))
    ;; Rational ↔ Rational/BigInt in any mix: cross-compare equality.
    (if (i32.and
          (i32.or
            (i32.eq (local.get $a_type) (global.get $TYPE_RATIONAL))
            (i32.eq (local.get $a_type) (global.get $TYPE_BIGINT)))
          (i32.or
            (i32.eq (local.get $b_type) (global.get $TYPE_RATIONAL))
            (i32.eq (local.get $b_type) (global.get $TYPE_BIGINT))))
      (then (return (i32.eqz (call $exact_numeric_slots_compare
        (local.get $a_pointer) (local.get $b_pointer))))))
    ;; Complex ↔ real slot: true iff imag==0 and real parts equal.
    (if (i32.and
          (i32.eq (local.get $a_type) (global.get $TYPE_COMPLEX))
          (i32.or
            (i32.eq (local.get $b_type) (global.get $TYPE_RATIONAL))
            (i32.eq (local.get $b_type) (global.get $TYPE_BIGINT))))
      (then
        (if (i32.eqz (call $complex_is_real (local.get $a_lo)))
          (then (return (i32.const 0))))
        (return (i32.eqz (call $exact_slot_vs_rational_header_compare
          (local.get $b_pointer) (call $complex_real (local.get $a_lo)))))))
    (if (i32.and
          (i32.or
            (i32.eq (local.get $a_type) (global.get $TYPE_RATIONAL))
            (i32.eq (local.get $a_type) (global.get $TYPE_BIGINT)))
          (i32.eq (local.get $b_type) (global.get $TYPE_COMPLEX)))
      (then
        (if (i32.eqz (call $complex_is_real (local.get $b_lo)))
          (then (return (i32.const 0))))
        (return (i32.eqz (call $exact_slot_vs_rational_header_compare
          (local.get $a_pointer) (call $complex_real (local.get $b_lo)))))))

    ;; Different kinds that aren't semantically comparable: not equal.
    (i32.const 0)
  )

  ;; Ring 5 (5a): structural pattern matching core. Pattern Symbols
  ;; listed in the variables area are pattern variables: the first
  ;; occurrence binds the subject subterm, repeats must agree via
  ;; $expression_values_equal. Unlisted Symbols are constants matching
  ;; only themselves. Both Expressions: heads and arity must agree
  ;; exactly, args recurse. Both Matrices: shape must agree, entries
  ;; recurse (Ring 4's owed matrix pattern matching). Everything else:
  ;; semantic structural equality, same rules as Exact.Expression.equal.
  ;;
  ;; $variables_data / $bindings_data are the first 16-byte slots of
  ;; two $variable_count-slot areas. Binding slots start zeroed; no
  ;; legal binding has value type 0, so type 0 reads as unbound.
  ;; Allocation-free; numeric-leaf compares may signal pressure —
  ;; callers poll the flag. Returns 1 matched, 0 mismatch.
  (func $expression_match_value
    (param $pattern_slot i32) (param $subject_slot i32)
    (param $variables_data i32) (param $variable_count i32)
    (param $bindings_data i32)
    (result i32)
    (local $pattern_type i32)
    (local $pattern_lo i32)
    (local $subject_lo i32)
    (local $i i32)
    (local $binding_slot i32)
    (local $pattern_args i32)
    (local $subject_args i32)
    (local $length i32)
    (local $pattern_data i32)
    (local $subject_data i32)

    (local.set $pattern_type (call $value_type (local.get $pattern_slot)))
    (local.set $pattern_lo (call $value_data_lo (local.get $pattern_slot)))

    ;; Pattern variable: scan the variables area for this Symbol.
    (if (i32.eq (local.get $pattern_type) (global.get $TYPE_SYMBOL))
      (then
        (local.set $i (i32.const 0))
        (block $scan_done
          (loop $scan
            (br_if $scan_done (i32.ge_u (local.get $i) (local.get $variable_count)))
            (if (i32.eq
                  (call $value_data_lo (i32.add (local.get $variables_data)
                    (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
                  (local.get $pattern_lo))
              (then
                (local.set $binding_slot (i32.add (local.get $bindings_data)
                  (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
                ;; First occurrence binds; repeats must agree.
                (if (i32.eqz (call $value_type (local.get $binding_slot)))
                  (then
                    (memory.copy
                      (call $abs (local.get $binding_slot))
                      (call $abs (local.get $subject_slot))
                      (global.get $VALUE_SIZE))
                    (return (i32.const 1))))
                (return (call $expression_values_equal
                  (local.get $binding_slot) (local.get $subject_slot)))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $scan)))))

    ;; Both Expressions: same head, same arity, args match pairwise.
    (if (i32.and
          (i32.eq (local.get $pattern_type) (global.get $TYPE_EXPRESSION))
          (i32.eq (call $value_type (local.get $subject_slot))
                  (global.get $TYPE_EXPRESSION)))
      (then
        (local.set $subject_lo (call $value_data_lo (local.get $subject_slot)))
        (if (i32.ne
              (call $expression_head (local.get $pattern_lo))
              (call $expression_head (local.get $subject_lo)))
          (then (return (i32.const 0))))
        (local.set $pattern_args (call $expression_args (local.get $pattern_lo)))
        (local.set $subject_args (call $expression_args (local.get $subject_lo)))
        (local.set $length (i32.load (call $abs (i32.add (local.get $pattern_args) (i32.const 8)))))
        (if (i32.ne (local.get $length)
              (i32.load (call $abs (i32.add (local.get $subject_args) (i32.const 8)))))
          (then (return (i32.const 0))))
        (local.set $pattern_data (i32.load (call $abs (i32.add (local.get $pattern_args) (i32.const 16)))))
        (local.set $subject_data (i32.load (call $abs (i32.add (local.get $subject_args) (i32.const 16)))))
        (local.set $i (i32.const 0))
        (block $args_done
          (loop $args_walk
            (br_if $args_done (i32.ge_u (local.get $i) (local.get $length)))
            (if (i32.eqz (call $expression_match_value
                  (i32.add
                    (i32.add (local.get $pattern_data) (global.get $GC_HEADER_SIZE))
                    (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
                  (i32.add
                    (i32.add (local.get $subject_data) (global.get $GC_HEADER_SIZE))
                    (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
                  (local.get $variables_data) (local.get $variable_count)
                  (local.get $bindings_data)))
              (then (return (i32.const 0))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $args_walk)))
        (return (i32.const 1))))

    ;; Both Matrices: shape match, entries match pairwise.
    (if (i32.and
          (i32.eq (local.get $pattern_type) (global.get $TYPE_MATRIX))
          (i32.eq (call $value_type (local.get $subject_slot))
                  (global.get $TYPE_MATRIX)))
      (then
        (local.set $subject_lo (call $value_data_lo (local.get $subject_slot)))
        (if (i32.ne
              (call $matrix_rows_of (local.get $pattern_lo))
              (call $matrix_rows_of (local.get $subject_lo)))
          (then (return (i32.const 0))))
        (if (i32.ne
              (call $matrix_columns_of (local.get $pattern_lo))
              (call $matrix_columns_of (local.get $subject_lo)))
          (then (return (i32.const 0))))
        (local.set $length (i32.mul
          (call $matrix_rows_of (local.get $pattern_lo))
          (call $matrix_columns_of (local.get $pattern_lo))))
        (if (i32.eqz (local.get $length))
          (then (return (i32.const 1))))
        (local.set $pattern_data (i32.load (call $abs (i32.add
          (call $matrix_entries_of (local.get $pattern_lo)) (i32.const 16)))))
        (local.set $subject_data (i32.load (call $abs (i32.add
          (call $matrix_entries_of (local.get $subject_lo)) (i32.const 16)))))
        (local.set $i (i32.const 0))
        (block $entries_done
          (loop $entries_walk
            (br_if $entries_done (i32.ge_u (local.get $i) (local.get $length)))
            (if (i32.eqz (call $expression_match_value
                  (i32.add
                    (i32.add (local.get $pattern_data) (global.get $GC_HEADER_SIZE))
                    (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
                  (i32.add
                    (i32.add (local.get $subject_data) (global.get $GC_HEADER_SIZE))
                    (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
                  (local.get $variables_data) (local.get $variable_count)
                  (local.get $bindings_data)))
              (then (return (i32.const 0))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $entries_walk)))
        (return (i32.const 1))))

    ;; Everything else: semantic structural equality.
    (call $expression_values_equal (local.get $pattern_slot) (local.get $subject_slot))
  )

  ;; Ring 5 (5a): substitution descends into Matrix atom entries — a
  ;; symbol inside an entry is a genuine free occurrence (pointwise
  ;; semantics; theorem instantiation must reach it). Rebuilds the
  ;; matrix with substituted entries; the fresh entries array is frozen
  ;; like every constructor's. Returns walk status: 0 ok, 1 pressure.
  (func $matrix_substitute_entries
    (param $matrix_pointer i32)
    (param $target_sym_pointer i32)
    (param $replacement_slot i32)
    (param $dest_slot i32)
    (result i32)
    (local $rows i32)
    (local $columns i32)
    (local $count i32)
    (local $old_data i32)
    (local $new_entries i32)
    (local $new_data i32)
    (local $i i32)
    (local.set $rows (call $matrix_rows_of (local.get $matrix_pointer)))
    (local.set $columns (call $matrix_columns_of (local.get $matrix_pointer)))
    (local.set $count (i32.mul (local.get $rows) (local.get $columns)))
    ;; Admission: fresh entries array + the 32-byte matrix object.
    (if (call $expression_walk_guard
          (i32.add (call $estimate_array_size (local.get $count)) (i32.const 96)))
      (then (return (i32.const 1))))
    (local.set $new_entries (call $allocate_array (local.get $count)))
    (local.set $new_data (i32.load (call $abs (i32.add (local.get $new_entries) (i32.const 16)))))
    (local.set $old_data (i32.load (call $abs (i32.add
      (call $matrix_entries_of (local.get $matrix_pointer)) (i32.const 16)))))
    (local.set $i (i32.const 0))
    (block $done
      (loop $walk
        (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
        (if (call $expression_substitute_into
              (i32.add
                (i32.add (local.get $old_data) (global.get $GC_HEADER_SIZE))
                (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
              (local.get $target_sym_pointer)
              (local.get $replacement_slot)
              (i32.add
                (i32.add (local.get $new_data) (global.get $GC_HEADER_SIZE))
                (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
          (then (return (i32.const 1))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $walk)))
    (call $expression_freeze_args_array (local.get $new_entries))
    (i32.store (call $abs (local.get $dest_slot)) (global.get $TYPE_MATRIX))
    (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 4))) (i32.const 0))
    (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 8)))
      (call $matrix_allocate
        (local.get $rows) (local.get $columns) (local.get $new_entries)))
    (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 12))) (i32.const 0))
    (i32.const 0)
  )

  ;; Substitute: walk an Expression tree, replacing every occurrence of
  ;; `target_sym` in argument positions with `replacement`. Writes the
  ;; result into the 16-byte DEST slot. The input tree is never mutated.
  ;;
  ;; Head positions are NOT substituted — only argument slots — matching
  ;; the plan's decision: a variable never appears as a head in well-formed
  ;; math, and including heads would be a footgun.
  ;;
  ;; Caller owns $dest_slot (a 16-byte absolute? segment-relative slot).
  ;; Returns walk status: 0 ok, 1 pressure-abort.
  (func $expression_substitute_into
    (param $src_slot i32)            ;; segment-relative value slot (source)
    (param $target_sym_pointer i32)  ;; Symbol heap pointer to match
    (param $replacement_slot i32)    ;; segment-relative value slot (replacement)
    (param $dest_slot i32)           ;; segment-relative value slot (destination)
    (result i32)
    (local $src_type i32)
    (local $src_lo i32)

    (local.set $src_type (call $value_type (local.get $src_slot)))
    (local.set $src_lo (call $value_data_lo (local.get $src_slot)))

    ;; If src is the target Symbol, copy replacement into dest.
    (if (i32.and
          (i32.eq (local.get $src_type) (global.get $TYPE_SYMBOL))
          (i32.eq (local.get $src_lo) (local.get $target_sym_pointer)))
      (then
        (memory.copy
          (call $abs (local.get $dest_slot))
          (call $abs (local.get $replacement_slot))
          (global.get $VALUE_SIZE))
        (return (i32.const 0))))

    ;; If src is an Expression, substitute into its args.
    (if (i32.eq (local.get $src_type) (global.get $TYPE_EXPRESSION))
      (then
        (return (call $expression_substitute_tree
          (local.get $src_lo)
          (local.get $target_sym_pointer)
          (local.get $replacement_slot)
          (local.get $dest_slot)))))

    ;; If src is a Matrix, substitute into its entries — Ring 5 (5a):
    ;; a symbol inside an entry is a genuine free occurrence.
    (if (i32.eq (local.get $src_type) (global.get $TYPE_MATRIX))
      (then
        (return (call $matrix_substitute_entries
          (local.get $src_lo)
          (local.get $target_sym_pointer)
          (local.get $replacement_slot)
          (local.get $dest_slot)))))

    ;; Otherwise pass through unchanged: copy the source slot verbatim.
    (memory.copy
      (call $abs (local.get $dest_slot))
      (call $abs (local.get $src_slot))
      (global.get $VALUE_SIZE))
    (i32.const 0)
  )

  ;; Substitute inside an Expression tree: builds a new Expression with
  ;; substituted args and writes a TYPE_EXPRESSION value slot into dest.
  ;; Returns walk status: 0 ok, 1 pressure-abort.
  (func $expression_substitute_tree
    (param $expression_pointer i32)
    (param $target_sym_pointer i32)
    (param $replacement_slot i32)
    (param $dest_slot i32)
    (result i32)
    (local $head i32)
    (local $old_args_array i32)
    (local $length i32)
    (local $old_data i32)
    (local $new_array i32)
    (local $new_data i32)
    (local $new_size i32)
    (local $new_aligned i32)
    (local $i i32)
    (local $src_element i32)
    (local $dest_element i32)
    (local $new_expression i32)
    (local $integral_bound_shortcut i32)

    (local.set $head (call $expression_head (local.get $expression_pointer)))
    (local.set $old_args_array (call $expression_args (local.get $expression_pointer)))
    (local.set $length (i32.load (call $abs (i32.add (local.get $old_args_array) (i32.const 8)))))

    ;; Per-node admission: the fresh args Array is this node's
    ;; size-parametrized carve; the walk floor absorbs the fixed rest.
    (local.set $new_size (i32.add (global.get $GC_HEADER_SIZE)
      (i32.mul (local.get $length) (global.get $VALUE_SIZE))))
    (local.set $new_aligned (i32.and
      (i32.add (local.get $new_size) (i32.const 15))
      (i32.const -16)))
    (if (call $expression_walk_guard (local.get $new_aligned))
      (then (return (i32.const 1))))

    ;; Allocate a new args Array.
    (local.set $new_array (call $read_state (global.get $STATE_HEAP_POINTER)))
    (local.set $new_data (call $write_array_header
      (local.get $new_array) (local.get $length) (local.get $length) (local.get $new_aligned)))

    (call $write_state (global.get $STATE_HEAP_POINTER)
      (i32.add (local.get $new_data) (local.get $new_aligned)))

    ;; Walk each source arg and write the substituted version directly
    ;; into the corresponding new_data slot.
    (local.set $old_data (i32.load (call $abs (i32.add (local.get $old_args_array) (i32.const 16)))))
    ;; An Integral node binds its second argument: substituting the bound
    ;; symbol rewrites the bounds only, never the integrand.
    (local.set $integral_bound_shortcut (i32.const 0))
    (if (i32.and
          (i32.eq (call $symbol_description (local.get $head))
            (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_INTEGRAL)))
          (i32.ge_u (local.get $length) (i32.const 2)))
      (then
        (if (i32.and
              (i32.eq (call $value_type (i32.add
                (i32.add (local.get $old_data) (global.get $GC_HEADER_SIZE))
                (global.get $VALUE_SIZE)))
                (global.get $TYPE_SYMBOL))
              (i32.eq (call $value_data_lo (i32.add
                (i32.add (local.get $old_data) (global.get $GC_HEADER_SIZE))
                (global.get $VALUE_SIZE)))
                (local.get $target_sym_pointer)))
          (then (local.set $integral_bound_shortcut (i32.const 1))))))
    (local.set $i (i32.const 0))
    (block $done
      (loop $walk
        (br_if $done (i32.ge_u (local.get $i) (local.get $length)))
        (local.set $src_element (i32.add
          (i32.add (local.get $old_data) (global.get $GC_HEADER_SIZE))
          (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
        (local.set $dest_element (i32.add
          (i32.add (local.get $new_data) (global.get $GC_HEADER_SIZE))
          (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
        (if (i32.and (local.get $integral_bound_shortcut)
              (i32.lt_u (local.get $i) (i32.const 2)))
          (then
            (memory.copy (call $abs (local.get $dest_element))
              (call $abs (local.get $src_element)) (global.get $VALUE_SIZE))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $walk)))
        (if (call $expression_substitute_into
              (local.get $src_element)
              (local.get $target_sym_pointer)
              (local.get $replacement_slot)
              (local.get $dest_element))
          (then (return (i32.const 1))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $walk)
      )
    )

    ;; Build the new Expression and write it into dest_slot.
    (local.set $new_expression (call $expression_build
      (local.get $head)
      (local.get $new_array)))
    (i32.store (call $abs (local.get $dest_slot)) (global.get $TYPE_EXPRESSION))
    (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 4))) (i32.const 0))
    (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 8))) (local.get $new_expression))
    (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 12))) (i32.const 0))
    (i32.const 0)
  )

  ;; ==========================================================================
  ;; Expression simplify — Ring 2 (2d)
  ;; ==========================================================================
  ;;
  ;; simplify is a bottom-up recursive pass: first simplify each child,
  ;; then apply local rewrite rules on the simplified form. Writes into a
  ;; caller-owned 16-byte value slot, same contract as substitute.
  ;;
  ;; 2d.1 scope: skeleton + identity elimination.
  ;;   Negate(Negate(x)) → x
  ;;   Add(x) → x         (single-arg collapse)
  ;;   Multiply(x) → x
  ;;   Add(0, x) → x      (identity annihilation, when 0 appears)
  ;;   Multiply(0, x) → 0
  ;;   Multiply(1, x) → x
  ;;   Power(x, 0) → 1
  ;;   Power(x, 1) → x
  ;;   Power(1, x) → 1
  ;;
  ;; Flatten / sort / constant folding / Subtract-Divide desugar come in
  ;; 2d.2 and 2d.3. Until then, simplify(Add(1, 2, x)) stays Add(1, 2, x)
  ;; rather than Add(3, x); simplify(Add(x, 1)) doesn't swap to Add(1, x).

  ;; Helpers: test whether a value slot is the exact Rational 0 or 1.
  ;; Used by identity-elimination rules. Floats are excluded from
  ;; Expression args (2b.3), so no Float check needed here.
  (func $expression_value_is_zero (param $slot i32) (result i32)
    (local $type i32)
    (local $lo i32)
    (local.set $type (call $value_type (local.get $slot)))
    (local.set $lo (call $value_data_lo (local.get $slot)))
    ;; Inline integer Rational: data_lo/hi hold an i64; zero check.
    (if (i32.eq (local.get $type) (global.get $TYPE_RATIONAL))
      (then
        (if (call $rational_is_inline (local.get $slot))
          (then (return (i64.eqz (call $rational_read_inline (local.get $slot))))))
        ;; Heap Rational: numerator length == 0 means zero.
        (return (i32.eqz (call $bigint_length
          (call $rational_numerator (local.get $lo)))))))
    (if (i32.eq (local.get $type) (global.get $TYPE_BIGINT))
      (then (return (i32.eqz (call $bigint_length (local.get $lo))))))
    (i32.const 0)
  )

  (func $expression_value_is_one (param $slot i32) (result i32)
    (local $type i32)
    (local $lo i32)
    (local $numerator i32)
    (local $denominator i32)
    (local.set $type (call $value_type (local.get $slot)))
    (local.set $lo (call $value_data_lo (local.get $slot)))
    (if (i32.eq (local.get $type) (global.get $TYPE_RATIONAL))
      (then
        (if (call $rational_is_inline (local.get $slot))
          (then (return (i64.eq (call $rational_read_inline (local.get $slot)) (i64.const 1)))))
        ;; Heap Rational: numerator = 1, denominator = 1, positive sign.
        (local.set $numerator (call $rational_numerator (local.get $lo)))
        (local.set $denominator (call $rational_denominator (local.get $lo)))
        (return (i32.and
          (i32.and
            (i32.eqz (call $bigint_sign (local.get $numerator)))
            (i32.and
              (i32.eq (call $bigint_length (local.get $numerator)) (i32.const 1))
              (i32.eq (call $bigint_limb (local.get $numerator) (i32.const 0)) (i32.const 1))))
          (i32.and
            (i32.eq (call $bigint_length (local.get $denominator)) (i32.const 1))
            (i32.eq (call $bigint_limb (local.get $denominator) (i32.const 0)) (i32.const 1)))))))
    (if (i32.eq (local.get $type) (global.get $TYPE_BIGINT))
      (then (return (i32.and
        (i32.eqz (call $bigint_sign (local.get $lo)))
        (i32.and
          (i32.eq (call $bigint_length (local.get $lo)) (i32.const 1))
          (i32.eq (call $bigint_limb (local.get $lo) (i32.const 0)) (i32.const 1)))))))
    (i32.const 0)
  )

  ;; Write the canonical exact zero (inline Rational 0) into a dest slot.
  (func $expression_write_zero (param $dest_slot i32)
    (i32.store (call $abs (local.get $dest_slot)) (global.get $TYPE_RATIONAL))
    (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 4)))
      (global.get $FLAG_RATIONAL_INLINE))
    (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 8))) (i32.const 0))
    (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 12))) (i32.const 0))
  )

  ;; Write the canonical exact one (inline Rational 1) into a dest slot.
  (func $expression_write_one (param $dest_slot i32)
    (i32.store (call $abs (local.get $dest_slot)) (global.get $TYPE_RATIONAL))
    (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 4)))
      (global.get $FLAG_RATIONAL_INLINE))
    (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 8))) (i32.const 1))
    (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 12))) (i32.const 0))
  )

  ;; Return 1 if a value slot belongs to the complete exact numeric tower.
  (func $expression_slot_is_numeric (param $slot i32) (result i32)
    (local $t i32)
    (local.set $t (call $value_type (local.get $slot)))
    (i32.or
      (i32.or
        (i32.eq (local.get $t) (global.get $TYPE_RATIONAL))
        (i32.eq (local.get $t) (global.get $TYPE_BIGINT)))
      (i32.or
        (i32.eq (local.get $t) (global.get $TYPE_COMPLEX))
        (i32.or
          (i32.eq (local.get $t) (global.get $TYPE_ALGEBRAIC))
          (i32.eq (local.get $t) (global.get $TYPE_COMPLEX_ALGEBRAIC)))))
  )

  ;; Fold two exact-numeric value slots via addition, writing the result
  ;; (type-promoted as needed) into dest_slot. Ring 1 arithmetic under
  ;; the hood: Rational+Rational stays Rational; BigInt+BigInt stays
  ;; BigInt; any Complex operand promotes to Complex.
  (func $expression_fold_add_slots
    (param $a_slot i32) (param $b_slot i32) (param $dest_slot i32)
    (local $a_type i32)
    (local $b_type i32)
    (local $a_rational i32)
    (local $b_rational i32)
    (local $a_complex i32)
    (local $b_complex i32)
    (local $result_rational i32)
    (local $result_complex i32)

    (local.set $a_type (call $value_type (local.get $a_slot)))
    (local.set $b_type (call $value_type (local.get $b_slot)))
    ;; Algebraic operands use the complete exact real/complex arithmetic
    ;; engine, including promotion of Rational, BigInt, and Complex peers.
    (if (i32.or
          (i32.or
            (i32.eq (local.get $a_type) (global.get $TYPE_ALGEBRAIC))
            (i32.eq (local.get $a_type) (global.get $TYPE_COMPLEX_ALGEBRAIC)))
          (i32.or
            (i32.eq (local.get $b_type) (global.get $TYPE_ALGEBRAIC))
            (i32.eq (local.get $b_type) (global.get $TYPE_COMPLEX_ALGEBRAIC))))
      (then
        (if (call $complex_algebraic_slot_arith
              (i32.const 0) (local.get $a_slot) (local.get $b_slot)
              (local.get $dest_slot))
          (then (return)))
        (return)))

    ;; BigInt + BigInt → BigInt.
    (if (i32.and
          (i32.eq (local.get $a_type) (global.get $TYPE_BIGINT))
          (i32.eq (local.get $b_type) (global.get $TYPE_BIGINT)))
      (then
        (i32.store (call $abs (local.get $dest_slot)) (global.get $TYPE_BIGINT))
        (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 4))) (i32.const 0))
        (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 8)))
          (call $bigint_add
            (call $value_data_lo (local.get $a_slot))
            (call $value_data_lo (local.get $b_slot))))
        (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 12))) (i32.const 0))
        (return)))

    ;; Complex + anything → Complex.
    (if (i32.or
          (i32.eq (local.get $a_type) (global.get $TYPE_COMPLEX))
          (i32.eq (local.get $b_type) (global.get $TYPE_COMPLEX)))
      (then
        (if (i32.eq (local.get $a_type) (global.get $TYPE_COMPLEX))
          (then (local.set $a_complex (call $value_data_lo (local.get $a_slot))))
          (else (local.set $a_complex (call $complex_from_rational
            (call $expression_to_rational (local.get $a_slot))))))
        (if (i32.eq (local.get $b_type) (global.get $TYPE_COMPLEX))
          (then (local.set $b_complex (call $value_data_lo (local.get $b_slot))))
          (else (local.set $b_complex (call $complex_from_rational
            (call $expression_to_rational (local.get $b_slot))))))
        (local.set $result_complex (call $complex_add (local.get $a_complex) (local.get $b_complex)))
        (i32.store (call $abs (local.get $dest_slot)) (global.get $TYPE_COMPLEX))
        (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 4))) (i32.const 0))
        (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 8))) (local.get $result_complex))
        (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 12))) (i32.const 0))
        (return)))

    ;; Otherwise Rational + BigInt or pure Rational: materialize both to
    ;; Rational and add. $rational_add returns a heap Rational.
    (local.set $a_rational (call $expression_to_rational (local.get $a_slot)))
    (local.set $b_rational (call $expression_to_rational (local.get $b_slot)))
    (local.set $result_rational (call $rational_add (local.get $a_rational) (local.get $b_rational)))
    (i32.store (call $abs (local.get $dest_slot)) (global.get $TYPE_RATIONAL))
    (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 4))) (i32.const 0))
    (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 8))) (local.get $result_rational))
    (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 12))) (i32.const 0))
  )

  ;; Multiplication counterpart of $expression_fold_add_slots.
  (func $expression_fold_mul_slots
    (param $a_slot i32) (param $b_slot i32) (param $dest_slot i32)
    (local $a_type i32)
    (local $b_type i32)
    (local $a_rational i32)
    (local $b_rational i32)
    (local $a_complex i32)
    (local $b_complex i32)
    (local $result_rational i32)
    (local $result_complex i32)

    (local.set $a_type (call $value_type (local.get $a_slot)))
    (local.set $b_type (call $value_type (local.get $b_slot)))
    ;; Algebraic operands use the complete exact real/complex arithmetic
    ;; engine, including promotion of Rational, BigInt, and Complex peers.
    (if (i32.or
          (i32.or
            (i32.eq (local.get $a_type) (global.get $TYPE_ALGEBRAIC))
            (i32.eq (local.get $a_type) (global.get $TYPE_COMPLEX_ALGEBRAIC)))
          (i32.or
            (i32.eq (local.get $b_type) (global.get $TYPE_ALGEBRAIC))
            (i32.eq (local.get $b_type) (global.get $TYPE_COMPLEX_ALGEBRAIC))))
      (then
        (if (call $complex_algebraic_slot_arith
              (i32.const 2) (local.get $a_slot) (local.get $b_slot)
              (local.get $dest_slot))
          (then (return)))
        (return)))

    ;; BigInt * BigInt → BigInt.
    (if (i32.and
          (i32.eq (local.get $a_type) (global.get $TYPE_BIGINT))
          (i32.eq (local.get $b_type) (global.get $TYPE_BIGINT)))
      (then
        (i32.store (call $abs (local.get $dest_slot)) (global.get $TYPE_BIGINT))
        (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 4))) (i32.const 0))
        (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 8)))
          (call $bigint_mul
            (call $value_data_lo (local.get $a_slot))
            (call $value_data_lo (local.get $b_slot))))
        (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 12))) (i32.const 0))
        (return)))

    ;; Complex * anything → Complex.
    (if (i32.or
          (i32.eq (local.get $a_type) (global.get $TYPE_COMPLEX))
          (i32.eq (local.get $b_type) (global.get $TYPE_COMPLEX)))
      (then
        (if (i32.eq (local.get $a_type) (global.get $TYPE_COMPLEX))
          (then (local.set $a_complex (call $value_data_lo (local.get $a_slot))))
          (else (local.set $a_complex (call $complex_from_rational
            (call $expression_to_rational (local.get $a_slot))))))
        (if (i32.eq (local.get $b_type) (global.get $TYPE_COMPLEX))
          (then (local.set $b_complex (call $value_data_lo (local.get $b_slot))))
          (else (local.set $b_complex (call $complex_from_rational
            (call $expression_to_rational (local.get $b_slot))))))
        (local.set $result_complex (call $complex_mul (local.get $a_complex) (local.get $b_complex)))
        (i32.store (call $abs (local.get $dest_slot)) (global.get $TYPE_COMPLEX))
        (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 4))) (i32.const 0))
        (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 8))) (local.get $result_complex))
        (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 12))) (i32.const 0))
        (return)))

    ;; Otherwise Rational * BigInt or pure Rational.
    (local.set $a_rational (call $expression_to_rational (local.get $a_slot)))
    (local.set $b_rational (call $expression_to_rational (local.get $b_slot)))
    (local.set $result_rational (call $rational_mul (local.get $a_rational) (local.get $b_rational)))
    (i32.store (call $abs (local.get $dest_slot)) (global.get $TYPE_RATIONAL))
    (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 4))) (i32.const 0))
    (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 8))) (local.get $result_rational))
    (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 12))) (i32.const 0))
  )

  ;; Promote a numeric value slot to a heap Rational pointer. BigInt is
  ;; wrapped via $rational_from_bigint; Rational is materialized.
  ;; Caller must have already verified the slot is Rational or BigInt.
  (func $expression_to_rational (param $slot i32) (result i32)
    (if (i32.eq (call $value_type (local.get $slot)) (global.get $TYPE_BIGINT))
      (then (return (call $rational_from_bigint (call $value_data_lo (local.get $slot))))))
    (call $rational_materialize (local.get $slot))
  )

  ;; Count how many total slots result from flattening an args array
  ;; against a given head: for each arg, if it's an Expression with the
  ;; same head, add that expression's arg count; else add 1.
  (func $expression_flatten_count (param $args_array i32) (param $head_sym i32) (result i32)
    (local $length i32)
    (local $data i32)
    (local $i i32)
    (local $slot i32)
    (local $total i32)
    (local $inner_args i32)

    (local.set $length (i32.load (call $abs (i32.add (local.get $args_array) (i32.const 8)))))
    (local.set $data (i32.load (call $abs (i32.add (local.get $args_array) (i32.const 16)))))
    (local.set $i (i32.const 0))
    (local.set $total (i32.const 0))

    (block $done
      (loop $count
        (br_if $done (i32.ge_u (local.get $i) (local.get $length)))
        (local.set $slot (i32.add
          (i32.add (local.get $data) (global.get $GC_HEADER_SIZE))
          (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
        (if (i32.and
              (i32.eq (call $value_type (local.get $slot)) (global.get $TYPE_EXPRESSION))
              (i32.eq (call $expression_head
                        (call $value_data_lo (local.get $slot)))
                      (local.get $head_sym)))
          (then
            (local.set $inner_args (call $expression_args
              (call $value_data_lo (local.get $slot))))
            (local.set $total (i32.add (local.get $total)
              (i32.load (call $abs (i32.add (local.get $inner_args) (i32.const 8)))))))
          (else (local.set $total (i32.add (local.get $total) (i32.const 1)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $count)
      )
    )
    (local.get $total)
  )

  ;; Write the flattened args of a same-head-expression tree into a
  ;; contiguous memory region starting at $dest_data. Walks args, and for
  ;; each arg either copies the slot or (if it's an Expression with the
  ;; same head) recursively splices its args.
  ;; Returns the number of slots written.
  (func $expression_flatten_into
    (param $args_array i32)
    (param $head_sym i32)
    (param $dest_data i32)
    (param $dest_start_index i32)
    (result i32)
    (local $length i32)
    (local $data i32)
    (local $i i32)
    (local $slot i32)
    (local $dest_index i32)
    (local $inner_args i32)

    (local.set $length (i32.load (call $abs (i32.add (local.get $args_array) (i32.const 8)))))
    (local.set $data (i32.load (call $abs (i32.add (local.get $args_array) (i32.const 16)))))
    (local.set $dest_index (local.get $dest_start_index))
    (local.set $i (i32.const 0))

    (block $done
      (loop $walk
        (br_if $done (i32.ge_u (local.get $i) (local.get $length)))
        (local.set $slot (i32.add
          (i32.add (local.get $data) (global.get $GC_HEADER_SIZE))
          (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
        (if (i32.and
              (i32.eq (call $value_type (local.get $slot)) (global.get $TYPE_EXPRESSION))
              (i32.eq (call $expression_head
                        (call $value_data_lo (local.get $slot)))
                      (local.get $head_sym)))
          (then
            ;; Recurse into this sub-expression's args.
            (local.set $inner_args (call $expression_args
              (call $value_data_lo (local.get $slot))))
            (local.set $dest_index (call $expression_flatten_into
              (local.get $inner_args)
              (local.get $head_sym)
              (local.get $dest_data)
              (local.get $dest_index))))
          (else
            (memory.copy
              (call $abs (i32.add
                (local.get $dest_data)
                (i32.mul (local.get $dest_index) (global.get $VALUE_SIZE))))
              (call $abs (local.get $slot))
              (global.get $VALUE_SIZE))
            (local.set $dest_index (i32.add (local.get $dest_index) (i32.const 1)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $walk)
      )
    )
    (local.get $dest_index)
  )

  ;; Negate a numeric value slot, writing -x into dest_slot. Implemented
  ;; as Multiply(-1, x) via $expression_fold_mul_slots so type promotion
  ;; (BigInt → Rational on mixed-type operands) is handled uniformly.
  ;; Returns walk status: 0 ok, 1 pressure-abort.
  (func $expression_negate_numeric (param $src_slot i32) (param $dest_slot i32) (result i32)
    (local $neg_one_slot i32)
    (if (call $expression_walk_guard
          (i32.add (i32.const 32)
            (call $estimate_cross_type_arith_budget
              (local.get $src_slot) (local.get $src_slot))))
      (then (return (i32.const 1))))
    ;; Committed scratch slot holding inline Rational(-1); the fold
    ;; below allocates, so this cannot live in tail scratch.
    (local.set $neg_one_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (i32.store (call $abs (local.get $neg_one_slot)) (global.get $TYPE_RATIONAL))
    (i32.store (call $abs (i32.add (local.get $neg_one_slot) (i32.const 4)))
      (global.get $FLAG_RATIONAL_INLINE))
    (i32.store (call $abs (i32.add (local.get $neg_one_slot) (i32.const 8))) (i32.const -1))
    (i32.store (call $abs (i32.add (local.get $neg_one_slot) (i32.const 12))) (i32.const -1))
    (call $expression_fold_mul_slots
      (local.get $neg_one_slot) (local.get $src_slot) (local.get $dest_slot))
    (i32.const 0)
  )

  ;; Ring 4 (4b): fold Conjugate over a numeric slot. Identity on
  ;; Rational/BigInt (copy); on Complex, flips the imaginary
  ;; component's sign. Returns walk status: 0 ok, 1 pressure-abort.
  (func $expression_conjugate_numeric (param $src_slot i32) (param $dest_slot i32) (result i32)
    (local $header i32)
    (if (i32.ne (call $value_type (local.get $src_slot)) (global.get $TYPE_COMPLEX))
      (then
        (memory.copy
          (call $abs (local.get $dest_slot))
          (call $abs (local.get $src_slot))
          (global.get $VALUE_SIZE))
        (return (i32.const 0))))
    ;; rational_negate copies the numerator BigInt — size the guard by
    ;; the operand like $expression_negate_numeric does.
    (if (call $expression_walk_guard
          (i32.add (i32.const 64)
            (call $estimate_cross_type_arith_budget
              (local.get $src_slot) (local.get $src_slot))))
      (then (return (i32.const 1))))
    (local.set $header (call $value_data_lo (local.get $src_slot)))
    (i32.store (call $abs (local.get $dest_slot)) (global.get $TYPE_COMPLEX))
    (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 4))) (i32.const 0))
    (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 8)))
      (call $complex_allocate
        (call $complex_real (local.get $header))
        (call $rational_negate (call $complex_imaginary (local.get $header)))))
    (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 12))) (i32.const 0))
    (i32.const 0)
  )

  ;; ==========================================================================
  ;; Commutative sort comparator — Ring 2 (2d.3)
  ;; ==========================================================================
  ;;
  ;; Strict total order over any value that can appear in a simplified
  ;; Add/Multiply arg list. Class priority:
  ;;   0 — numeric (Rational, BigInt, Complex)
  ;;   1 — Symbol
  ;;   2 — Expression
  ;; Within class: numerical compare / alphabetical / head-then-args.
  ;; Ties use heap-pointer ordering so the comparator is total and stable
  ;; across a single simplify call.
  ;;
  ;; Returns negative i32 for a<b, 0 for a==b, positive for a>b.

  ;; Type-class predicate. Class 3 (Matrix — Ring 4) is dispatched
  ;; before the class-2 default: the class-2 comparator reads
  ;; Expression fields (head, args) off data_lo, which on a Matrix
  ;; pointer would be garbage reads.
  (func $expression_type_class (param $type i32) (result i32)
    (if (i32.or
          (i32.or
            (i32.eq (local.get $type) (global.get $TYPE_RATIONAL))
            (i32.eq (local.get $type) (global.get $TYPE_BIGINT)))
          (i32.eq (local.get $type) (global.get $TYPE_COMPLEX)))
      (then (return (i32.const 0))))
    (if (i32.eq (local.get $type) (global.get $TYPE_SYMBOL))
      (then (return (i32.const 1))))
    (if (i32.eq (local.get $type) (global.get $TYPE_MATRIX))
      (then (return (i32.const 3))))
    ;; Ring 6c: AlgebraicNumber atoms are their own class — opaque to
    ;; the numeric folds (class 0 would route them into Ring 1
    ;; arithmetic), ordered structurally after Matrix.
    (if (i32.eq (local.get $type) (global.get $TYPE_ALGEBRAIC))
      (then (return (i32.const 4))))
    (if (i32.eq (local.get $type) (global.get $TYPE_COMPLEX_ALGEBRAIC))
      (then (return (i32.const 5))))
    (i32.const 2)
  )

  ;; Compare two interned strings lexicographically (byte-compare).
  ;; Returns <0, 0, >0. Strings are stored as [length:4][bytes]. Equal
  ;; prefix with shorter-length wins.
  ;; Inputs are TABLE-RELATIVE interned-string ids.
  (func $expression_string_compare (param $a_id i32) (param $b_id i32) (result i32)
    (local $a_len i32)
    (local $b_len i32)
    (local $min_len i32)
    (local $i i32)
    (local $a_byte i32)
    (local $b_byte i32)
    (local $a_bytes_seg i32)
    (local $b_bytes_seg i32)
    (if (i32.eq (local.get $a_id) (local.get $b_id))
      (then (return (i32.const 0))))
    (local.set $a_len (i32.load (call $string_id_to_abs (local.get $a_id))))
    (local.set $b_len (i32.load (call $string_id_to_abs (local.get $b_id))))
    (local.set $a_bytes_seg (call $string_id_bytes_seg (local.get $a_id)))
    (local.set $b_bytes_seg (call $string_id_bytes_seg (local.get $b_id)))
    (local.set $min_len (local.get $a_len))
    (if (i32.lt_u (local.get $b_len) (local.get $a_len))
      (then (local.set $min_len (local.get $b_len))))
    (local.set $i (i32.const 0))
    (block $done
      (loop $scan
        (br_if $done (i32.ge_u (local.get $i) (local.get $min_len)))
        (local.set $a_byte (i32.load8_u
          (call $abs (i32.add
            (local.get $a_bytes_seg)
            (local.get $i)))))
        (local.set $b_byte (i32.load8_u
          (call $abs (i32.add
            (local.get $b_bytes_seg)
            (local.get $i)))))
        (if (i32.ne (local.get $a_byte) (local.get $b_byte))
          (then (return (i32.sub (local.get $a_byte) (local.get $b_byte)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $scan)
      )
    )
    ;; Prefixes equal → shorter is less.
    (i32.sub (local.get $a_len) (local.get $b_len))
  )

  ;; Numeric comparator. Handles Rational-Rational, Rational-BigInt, and
  ;; both-Complex. Complex vs Rational/BigInt: Complex sorts AFTER pure
  ;; reals (imag != 0 means "lives in a different subspace"). Two Complex
  ;; values compare by (real part, imaginary part). Allocation-free
  ;; throughout (this fires O(n²) times inside sort/collection): the
  ;; noalloc comparison family stages any cross products in tail
  ;; scratch. The Ring 2 version passed Rational HEADER pointers into
  ;; the slot-based $rational_compare on the both-Complex path — a raw
  ;; OOB trap, pinned by tests/fuel/expression_complex_sort_test.js.
  (func $expression_numeric_compare (param $a_slot i32) (param $b_slot i32) (result i32)
    (local $a_type i32)
    (local $b_type i32)
    (local $a_lo i32)
    (local $b_lo i32)
    (local $cmp i32)
    (local.set $a_type (call $value_type (local.get $a_slot)))
    (local.set $b_type (call $value_type (local.get $b_slot)))
    (local.set $a_lo (call $value_data_lo (local.get $a_slot)))
    (local.set $b_lo (call $value_data_lo (local.get $b_slot)))

    ;; Both BigInt: direct compare.
    (if (i32.and
          (i32.eq (local.get $a_type) (global.get $TYPE_BIGINT))
          (i32.eq (local.get $b_type) (global.get $TYPE_BIGINT)))
      (then (return (call $bigint_compare (local.get $a_lo) (local.get $b_lo)))))

    ;; Both Complex: compare real parts, then imaginary if real equal.
    (if (i32.and
          (i32.eq (local.get $a_type) (global.get $TYPE_COMPLEX))
          (i32.eq (local.get $b_type) (global.get $TYPE_COMPLEX)))
      (then
        (local.set $cmp (call $rational_header_pair_compare
          (call $complex_real (local.get $a_lo))
          (call $complex_real (local.get $b_lo))))
        (if (i32.ne (local.get $cmp) (i32.const 0))
          (then (return (local.get $cmp))))
        (return (call $rational_header_pair_compare
          (call $complex_imaginary (local.get $a_lo))
          (call $complex_imaginary (local.get $b_lo))))))

    ;; Complex vs non-Complex: Complex sorts AFTER pure reals in the
    ;; total order. This is arbitrary but consistent.
    (if (i32.eq (local.get $a_type) (global.get $TYPE_COMPLEX))
      (then (return (i32.const 1))))
    (if (i32.eq (local.get $b_type) (global.get $TYPE_COMPLEX))
      (then (return (i32.const -1))))

    ;; Otherwise Rational / BigInt in any mix.
    (call $exact_numeric_slots_compare (local.get $a_slot) (local.get $b_slot))
  )

  ;; Full slot comparator. Sorts class-0 (numeric) first, then class-1
  ;; (Symbol) alphabetical, then class-2 (Expression) by head then args.
  ;; Ties on same-class/same-value use heap pointer ordering as a stable
  ;; tie-breaker so the comparator is a strict total order.
  (func $expression_compare_slots (param $a_slot i32) (param $b_slot i32) (result i32)
    (local $a_type i32)
    (local $b_type i32)
    (local $a_class i32)
    (local $b_class i32)
    (local $a_lo i32)
    (local $b_lo i32)
    (local $cmp i32)
    (local $a_args i32)
    (local $b_args i32)
    (local $a_length i32)
    (local $b_length i32)
    (local $a_data i32)
    (local $b_data i32)
    (local $i i32)

    (local.set $a_type (call $value_type (local.get $a_slot)))
    (local.set $b_type (call $value_type (local.get $b_slot)))
    (local.set $a_class (call $expression_type_class (local.get $a_type)))
    (local.set $b_class (call $expression_type_class (local.get $b_type)))

    (if (i32.ne (local.get $a_class) (local.get $b_class))
      (then (return (i32.sub (local.get $a_class) (local.get $b_class)))))

    (local.set $a_lo (call $value_data_lo (local.get $a_slot)))
    (local.set $b_lo (call $value_data_lo (local.get $b_slot)))

    ;; Class 0: numeric.
    (if (i32.eqz (local.get $a_class))
      (then (return (call $expression_numeric_compare
        (local.get $a_slot) (local.get $b_slot)))))

    ;; Class 1: Symbol — compare descriptions lexicographically.
    (if (i32.eq (local.get $a_class) (i32.const 1))
      (then
        (local.set $cmp (call $expression_string_compare
          (call $symbol_description (local.get $a_lo))
          (call $symbol_description (local.get $b_lo))))
        (if (i32.ne (local.get $cmp) (i32.const 0))
          (then (return (local.get $cmp))))
        ;; Same description but different heap pointers (fresh symbols):
        ;; tie-break on pointer for stability.
        (return (i32.sub (local.get $a_lo) (local.get $b_lo)))))

    ;; Class 3: Matrix (Ring 4) — shape, then entries recursively,
    ;; then pointer tie-break. Allocation-free like the rest.
    (if (i32.eq (local.get $a_class) (i32.const 3))
      (then
        (local.set $cmp (i32.sub
          (call $matrix_rows_of (local.get $a_lo))
          (call $matrix_rows_of (local.get $b_lo))))
        (if (i32.ne (local.get $cmp) (i32.const 0))
          (then (return (local.get $cmp))))
        (local.set $cmp (i32.sub
          (call $matrix_columns_of (local.get $a_lo))
          (call $matrix_columns_of (local.get $b_lo))))
        (if (i32.ne (local.get $cmp) (i32.const 0))
          (then (return (local.get $cmp))))
        (local.set $a_length (i32.mul
          (call $matrix_rows_of (local.get $a_lo))
          (call $matrix_columns_of (local.get $a_lo))))
        (local.set $a_data (i32.load (call $abs (i32.add
          (call $matrix_entries_of (local.get $a_lo)) (i32.const 16)))))
        (local.set $b_data (i32.load (call $abs (i32.add
          (call $matrix_entries_of (local.get $b_lo)) (i32.const 16)))))
        (local.set $i (i32.const 0))
        (block $matrix_done
          (loop $matrix_recurse
            (br_if $matrix_done (i32.ge_u (local.get $i) (local.get $a_length)))
            (local.set $cmp (call $expression_compare_slots
              (i32.add
                (i32.add (local.get $a_data) (global.get $GC_HEADER_SIZE))
                (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
              (i32.add
                (i32.add (local.get $b_data) (global.get $GC_HEADER_SIZE))
                (i32.mul (local.get $i) (global.get $VALUE_SIZE)))))
            (if (i32.ne (local.get $cmp) (i32.const 0))
              (then (return (local.get $cmp))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $matrix_recurse)))
        (return (i32.sub (local.get $a_lo) (local.get $b_lo)))))

    ;; Class 5: ComplexAlgebraicNumber — opaque exact-numeric atom.
    ;; Component semantics are unavailable to this allocation-free sort;
    ;; pointer order is a strict, session-stable tie-break.
    (if (i32.eq (local.get $a_class) (i32.const 5))
      (then (return (i32.sub (local.get $a_lo) (local.get $b_lo)))))

    ;; Class 4: AlgebraicNumber (Ring 6c) — structural, allocation-
    ;; free, refinement-aware: coefficients arrays (length, then
    ;; per-slot bigint compare), then value order via the interval
    ;; low endpoints (distinct roots of one polynomial have disjoint
    ;; intervals whose order is refinement-stable), then pointer
    ;; tie-break like Symbol/Matrix.
    (if (i32.eq (local.get $a_class) (i32.const 4))
      (then
        (local.set $a_args (call $algebraic_coefficients_of (local.get $a_lo)))
        (local.set $b_args (call $algebraic_coefficients_of (local.get $b_lo)))
        (local.set $a_length (i32.load (call $abs (i32.add (local.get $a_args) (i32.const 8)))))
        (local.set $b_length (i32.load (call $abs (i32.add (local.get $b_args) (i32.const 8)))))
        (if (i32.ne (local.get $a_length) (local.get $b_length))
          (then (return (i32.sub (local.get $a_length) (local.get $b_length)))))
        (local.set $a_data (i32.load (call $abs (i32.add (local.get $a_args) (i32.const 16)))))
        (local.set $b_data (i32.load (call $abs (i32.add (local.get $b_args) (i32.const 16)))))
        (local.set $i (i32.const 0))
        (block $algebraic_done
          (loop $algebraic_coefficients
            (br_if $algebraic_done (i32.ge_u (local.get $i) (local.get $a_length)))
            (local.set $cmp (call $bigint_compare
              (call $value_data_lo (i32.add
                (i32.add (local.get $a_data) (global.get $GC_HEADER_SIZE))
                (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
              (call $value_data_lo (i32.add
                (i32.add (local.get $b_data) (global.get $GC_HEADER_SIZE))
                (i32.mul (local.get $i) (global.get $VALUE_SIZE))))))
            (if (i32.ne (local.get $cmp) (i32.const 0))
              (then (return (local.get $cmp))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $algebraic_coefficients)))
        (local.set $cmp (call $exact_numeric_slots_compare
          (i32.add
            (i32.load (call $abs (i32.add
              (call $algebraic_interval_of (local.get $a_lo)) (i32.const 16))))
            (global.get $GC_HEADER_SIZE))
          (i32.add
            (i32.load (call $abs (i32.add
              (call $algebraic_interval_of (local.get $b_lo)) (i32.const 16))))
            (global.get $GC_HEADER_SIZE))))
        (if (i32.ne (local.get $cmp) (i32.const 0))
          (then (return (local.get $cmp))))
        (return (i32.sub (local.get $a_lo) (local.get $b_lo)))))

    ;; Class 2: Expression — compare heads, then arg counts, then args.
    (local.set $cmp (call $expression_string_compare
      (call $symbol_description (call $expression_head (local.get $a_lo)))
      (call $symbol_description (call $expression_head (local.get $b_lo)))))
    (if (i32.ne (local.get $cmp) (i32.const 0))
      (then (return (local.get $cmp))))
    (local.set $a_args (call $expression_args (local.get $a_lo)))
    (local.set $b_args (call $expression_args (local.get $b_lo)))
    (local.set $a_length (i32.load (call $abs (i32.add (local.get $a_args) (i32.const 8)))))
    (local.set $b_length (i32.load (call $abs (i32.add (local.get $b_args) (i32.const 8)))))
    (if (i32.ne (local.get $a_length) (local.get $b_length))
      (then (return (i32.sub (local.get $a_length) (local.get $b_length)))))
    (local.set $a_data (i32.load (call $abs (i32.add (local.get $a_args) (i32.const 16)))))
    (local.set $b_data (i32.load (call $abs (i32.add (local.get $b_args) (i32.const 16)))))
    (local.set $i (i32.const 0))
    (block $done
      (loop $recurse
        (br_if $done (i32.ge_u (local.get $i) (local.get $a_length)))
        (local.set $cmp (call $expression_compare_slots
          (i32.add
            (i32.add (local.get $a_data) (global.get $GC_HEADER_SIZE))
            (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
          (i32.add
            (i32.add (local.get $b_data) (global.get $GC_HEADER_SIZE))
            (i32.mul (local.get $i) (global.get $VALUE_SIZE)))))
        (if (i32.ne (local.get $cmp) (i32.const 0))
          (then (return (local.get $cmp))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $recurse)
      )
    )
    (i32.const 0)
  )

  ;; Insertion-sort a contiguous region of VALUE_SIZE slots in place.
  ;; For small arrays (typical Expression arg counts are 2-10), insertion
  ;; sort is O(n²) but has minimal constant overhead. The comparator is
  ;; chosen by context: Multiply args sort in monomial-factor order
  ;; (numeric coefficient first, then base ascending / exponent
  ;; descending); Add args sort in canonical monomial order using the
  ;; caller-owned staging areas. Comparators are allocation-free but
  ;; may signal pressure on oversized tail-scratch staging; the outer
  ;; loop polls the flag and aborts. Returns walk status: 0 ok, 1
  ;; pressure-abort (the region may be partially reordered — the caller
  ;; abandons the walk, so partial order is never observable).
  (func $expression_sort_slots
    (param $data_start i32) (param $count i32)
    (param $is_multiply i32)
    (param $stage_a i32) (param $stage_b i32)
    (param $stage_capacity i32)
    (result i32)
    (local $i i32)
    (local $j i32)
    (local $src i32)
    (local $dest i32)
    (local $tmp_slot i32)
    (local $cmp i32)

    (if (i32.le_u (local.get $count) (i32.const 1))
      (then (return (i32.const 0))))

    ;; Committed scratch slot for the shift step (the comparator uses
    ;; tail scratch, so the key must not live there).
    (if (call $expression_walk_guard (i32.const 32))
      (then (return (i32.const 1))))
    (local.set $tmp_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))

    (local.set $i (i32.const 1))
    (block $outer_done
      (loop $outer
        (br_if $outer_done (i32.ge_u (local.get $i) (local.get $count)))
        ;; key = data[i]; copy to tmp_slot.
        (memory.copy
          (call $abs (local.get $tmp_slot))
          (call $abs (i32.add (local.get $data_start)
            (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
          (global.get $VALUE_SIZE))
        ;; Shift greater elements right.
        (local.set $j (local.get $i))
        (block $inner_done
          (loop $inner
            (br_if $inner_done (i32.eqz (local.get $j)))
            (local.set $src (i32.add (local.get $data_start)
              (i32.mul (i32.sub (local.get $j) (i32.const 1)) (global.get $VALUE_SIZE))))
            (if (local.get $is_multiply)
              (then (local.set $cmp (call $expression_factor_compare
                (local.get $src) (local.get $tmp_slot))))
              (else (local.set $cmp (call $expression_monomial_term_compare
                (local.get $src) (local.get $tmp_slot)
                (local.get $stage_a) (local.get $stage_b)
                (local.get $stage_capacity)))))
            (if (i32.le_s (local.get $cmp) (i32.const 0))
              (then (br $inner_done)))
            ;; data[j] = data[j-1]
            (local.set $dest (i32.add (local.get $data_start)
              (i32.mul (local.get $j) (global.get $VALUE_SIZE))))
            (memory.copy
              (call $abs (local.get $dest))
              (call $abs (local.get $src))
              (global.get $VALUE_SIZE))
            (local.set $j (i32.sub (local.get $j) (i32.const 1)))
            (br $inner)
          )
        )
        ;; data[j] = key
        (memory.copy
          (call $abs (i32.add (local.get $data_start)
            (i32.mul (local.get $j) (global.get $VALUE_SIZE))))
          (call $abs (local.get $tmp_slot))
          (global.get $VALUE_SIZE))
        ;; Poll the pressure flag: a comparator that could not stage its
        ;; cross products returned a dummy 0 — abandon the sort.
        (if (global.get $memory_pressure_signaled)
          (then (return (i32.const 1))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $outer)
      )
    )
    (i32.const 0)
  )

  ;; ==========================================================================
  ;; Polynomial recognition + monomial machinery — Ring 3 (3a)
  ;;
  ;; A polynomial is a SHAPE of Ring 2 Expression tree, recognised, not
  ;; represented (no TYPE_POLYNOMIAL). Opaque subterms (unrecognised
  ;; heads like Sin(x)) are honorary atoms: they participate in
  ;; monomial factor lists keyed by structural equality, so
  ;; 2·Sin(x) + 3·Sin(x) collects to 5·Sin(x) without knowing what Sin
  ;; means. See INTERNALS.md (Polynomial-Aware Expression Simplification).
  ;; ==========================================================================

  ;; Ring 3 (3b): the auto-expansion result-size cap. simplify expands
  ;; Multiply-over-Add distributions and Power(sum, n) only when the
  ;; PREDICTED post-expansion term count fits; Exact.Expression.expand
  ;; bypasses the cap. Hardcoded by design (Q3): predictability over
  ;; tunability.
  (global $MAX_EXPANSION_TERMS i32 (i32.const 50))

  ;; Polynomial-shape kinds (values are internal; the public surface is
  ;; the isPolynomial boolean).
  (global $POLY_KIND_ATOM_NUMERIC i32 (i32.const 0))
  (global $POLY_KIND_ATOM_SYMBOL i32 (i32.const 1))
  (global $POLY_KIND_ATOM_POWER i32 (i32.const 2))
  (global $POLY_KIND_ATOM_OPAQUE i32 (i32.const 3))
  (global $POLY_KIND_MONOMIAL i32 (i32.const 4))
  (global $POLY_KIND_POLYNOMIAL i32 (i32.const 5))
  (global $POLY_KIND_NOT_POLYNOMIAL i32 (i32.const 6))

  ;; Classify a value slot as an exact integer exponent fitting i64:
  ;; returns 1 and sets $bigint_to_i64_value on success, 0 otherwise
  ;; (non-numeric, non-integer, or too large).
  (func $exponent_slot_to_i64 (param $slot i32) (result i32)
    (local $type i32)
    (local $header i32)
    (local.set $type (call $value_type (local.get $slot)))
    (if (i32.eq (local.get $type) (global.get $TYPE_RATIONAL))
      (then
        (if (call $rational_is_inline (local.get $slot))
          (then
            (global.set $bigint_to_i64_value (call $rational_read_inline (local.get $slot)))
            (return (i32.const 1))))
        (local.set $header (call $value_data_lo (local.get $slot)))
        (if (i32.eqz (call $bigint_is_one (call $rational_denominator (local.get $header))))
          (then (return (i32.const 0))))
        (return (call $bigint_to_i64_fits (call $rational_numerator (local.get $header))))))
    (if (i32.eq (local.get $type) (global.get $TYPE_BIGINT))
      (then (return (call $bigint_to_i64_fits (call $value_data_lo (local.get $slot))))))
    (i32.const 0)
  )

  ;; Exponent classification for Power classification:
  ;;   2 — non-negative integer (any magnitude)
  ;;   1 — negative integer (any magnitude)
  ;;   0 — anything else (non-integer numeric, Complex, Symbol, tree)
  (func $power_exponent_class (param $slot i32) (result i32)
    (local $type i32)
    (local $header i32)
    (local $numerator i32)
    (local.set $type (call $value_type (local.get $slot)))
    (if (i32.eq (local.get $type) (global.get $TYPE_RATIONAL))
      (then
        (if (call $rational_is_inline (local.get $slot))
          (then
            (if (i64.lt_s (call $rational_read_inline (local.get $slot)) (i64.const 0))
              (then (return (i32.const 1))))
            (return (i32.const 2))))
        (local.set $header (call $value_data_lo (local.get $slot)))
        (if (i32.eqz (call $bigint_is_one (call $rational_denominator (local.get $header))))
          (then (return (i32.const 0))))
        (local.set $numerator (call $rational_numerator (local.get $header)))
        (if (call $bigint_sign (local.get $numerator))
          (then (return (i32.const 1))))
        (return (i32.const 2))))
    (if (i32.eq (local.get $type) (global.get $TYPE_BIGINT))
      (then
        (if (call $bigint_sign (call $value_data_lo (local.get $slot)))
          (then (return (i32.const 1))))
        (return (i32.const 2))))
    (i32.const 0)
  )

  ;; The widened polynomial-shape predicate. Recursive: NOT_POLYNOMIAL
  ;; propagates up through Add / Subtract / Multiply / Negate / Power
  ;; args; every unrecognised head is an honorary atom without looking
  ;; inside it. Pure reads, no allocation.
  (func $expression_polynomial_kind (param $slot i32) (result i32)
    (local $type i32)
    (local $pointer i32)
    (local $head_description i32)
    (local $args_array i32)
    (local $length i32)
    (local $data i32)
    (local $i i32)
    (local $arg_kind i32)
    (local $exponent_class i32)
    (local $base_slot i32)

    (local.set $type (call $value_type (local.get $slot)))
    (if (call $expression_slot_is_numeric (local.get $slot))
      (then (return (global.get $POLY_KIND_ATOM_NUMERIC))))
    ;; Ring 6c: AlgebraicNumber leaves are numeric COEFFICIENT
    ;; material, never candidate variables (deliberately not added to
    ;; $expression_slot_is_numeric — the numeric folds cannot combine
    ;; them; they stay opaque atoms to simplify until Ring 7a).
    (if (i32.or
          (i32.eq (local.get $type) (global.get $TYPE_ALGEBRAIC))
          (i32.eq (local.get $type) (global.get $TYPE_COMPLEX_ALGEBRAIC)))
      (then (return (global.get $POLY_KIND_ATOM_NUMERIC))))
    (if (i32.eq (local.get $type) (global.get $TYPE_SYMBOL))
      (then (return (global.get $POLY_KIND_ATOM_SYMBOL))))
    (if (i32.ne (local.get $type) (global.get $TYPE_EXPRESSION))
      (then (return (global.get $POLY_KIND_NOT_POLYNOMIAL))))

    (local.set $pointer (call $value_data_lo (local.get $slot)))
    (local.set $head_description (call $symbol_description
      (call $expression_head (local.get $pointer))))
    (local.set $args_array (call $expression_args (local.get $pointer)))
    (local.set $length (i32.load (call $abs (i32.add (local.get $args_array) (i32.const 8)))))
    (local.set $data (i32.load (call $abs (i32.add (local.get $args_array) (i32.const 16)))))

    ;; Divide is never polynomial-shaped (simplify desugars it away;
    ;; a raw Divide tree is classified as-is).
    (if (i32.eq (local.get $head_description)
                (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_DIVIDE)))
      (then (return (global.get $POLY_KIND_NOT_POLYNOMIAL))))

    ;; Power(base, exponent): non-negative integer exponent over a
    ;; Symbol base is the canonical power atom; over any base that is
    ;; itself polynomial-shaped it is an honorary atom; negative or
    ;; non-integer exponents are actively not polynomial.
    (if (i32.and
          (i32.eq (local.get $head_description)
                  (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_POWER)))
          (i32.eq (local.get $length) (i32.const 2)))
      (then
        (local.set $base_slot (i32.add (local.get $data) (global.get $GC_HEADER_SIZE)))
        (local.set $exponent_class (call $power_exponent_class
          (i32.add (local.get $base_slot) (global.get $VALUE_SIZE))))
        (if (i32.ne (local.get $exponent_class) (i32.const 2))
          (then (return (global.get $POLY_KIND_NOT_POLYNOMIAL))))
        (if (i32.eq (call $expression_polynomial_kind (local.get $base_slot))
                    (global.get $POLY_KIND_NOT_POLYNOMIAL))
          (then (return (global.get $POLY_KIND_NOT_POLYNOMIAL))))
        (if (i32.and
              (i32.eq (call $value_type (local.get $base_slot)) (global.get $TYPE_SYMBOL))
              (call $exponent_slot_to_i64
                (i32.add (local.get $base_slot) (global.get $VALUE_SIZE))))
          (then (return (global.get $POLY_KIND_ATOM_POWER))))
        (return (global.get $POLY_KIND_ATOM_OPAQUE))))

    ;; Negate(x): a scaled term — monomial over x's own shape.
    (if (i32.and
          (i32.eq (local.get $head_description)
                  (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_NEGATE)))
          (i32.eq (local.get $length) (i32.const 1)))
      (then
        (local.set $arg_kind (call $expression_polynomial_kind
          (i32.add (local.get $data) (global.get $GC_HEADER_SIZE))))
        (if (i32.eq (local.get $arg_kind) (global.get $POLY_KIND_NOT_POLYNOMIAL))
          (then (return (global.get $POLY_KIND_NOT_POLYNOMIAL))))
        (if (i32.eq (local.get $arg_kind) (global.get $POLY_KIND_POLYNOMIAL))
          (then (return (global.get $POLY_KIND_POLYNOMIAL))))
        (return (global.get $POLY_KIND_MONOMIAL))))

    ;; Multiply: a monomial iff no arg is actively not polynomial.
    (if (i32.eq (local.get $head_description)
                (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)))
      (then
        (local.set $i (i32.const 0))
        (block $mul_done
          (loop $mul_scan
            (br_if $mul_done (i32.ge_u (local.get $i) (local.get $length)))
            (if (i32.eq
                  (call $expression_polynomial_kind (i32.add
                    (i32.add (local.get $data) (global.get $GC_HEADER_SIZE))
                    (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
                  (global.get $POLY_KIND_NOT_POLYNOMIAL))
              (then (return (global.get $POLY_KIND_NOT_POLYNOMIAL))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $mul_scan)))
        (return (global.get $POLY_KIND_MONOMIAL))))

    ;; Add / Subtract: a polynomial iff no arg is actively not polynomial.
    (if (i32.or
          (i32.eq (local.get $head_description)
                  (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_ADD)))
          (i32.eq (local.get $head_description)
                  (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_SUBTRACT))))
      (then
        (local.set $i (i32.const 0))
        (block $add_done
          (loop $add_scan
            (br_if $add_done (i32.ge_u (local.get $i) (local.get $length)))
            (if (i32.eq
                  (call $expression_polynomial_kind (i32.add
                    (i32.add (local.get $data) (global.get $GC_HEADER_SIZE))
                    (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
                  (global.get $POLY_KIND_NOT_POLYNOMIAL))
              (then (return (global.get $POLY_KIND_NOT_POLYNOMIAL))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $add_scan)))
        (return (global.get $POLY_KIND_POLYNOMIAL))))

    ;; Any other head: an honorary atom, no matter its arguments.
    (global.get $POLY_KIND_ATOM_OPAQUE)
  )

  ;; Wide zero / one checks: like $expression_value_is_zero / _is_one
  ;; but Complex-aware (Complex(0,0) folds can arise from collection,
  ;; e.g. i·x + (−i)·x).
  (func $expression_value_is_zero_wide (param $slot i32) (result i32)
    (local $header i32)
    (if (i32.eq (call $value_type (local.get $slot)) (global.get $TYPE_COMPLEX))
      (then
        (local.set $header (call $value_data_lo (local.get $slot)))
        (return (i32.and
          (i32.eqz (call $bigint_length
            (call $rational_numerator (call $complex_real (local.get $header)))))
          (i32.eqz (call $bigint_length
            (call $rational_numerator (call $complex_imaginary (local.get $header)))))))))
    (call $expression_value_is_zero (local.get $slot))
  )

  (func $expression_value_is_one_wide (param $slot i32) (result i32)
    (local $header i32)
    (local $real i32)
    (if (i32.eq (call $value_type (local.get $slot)) (global.get $TYPE_COMPLEX))
      (then
        (local.set $header (call $value_data_lo (local.get $slot)))
        (if (i32.eqz (call $complex_is_real (local.get $header)))
          (then (return (i32.const 0))))
        (local.set $real (call $complex_real (local.get $header)))
        (return (i32.and
          (call $bigint_is_one (call $rational_numerator (local.get $real)))
          (call $bigint_is_one (call $rational_denominator (local.get $real)))))))
    (call $expression_value_is_one (local.get $slot))
  )

  ;; Decompose a term into (coefficient, factors). The coefficient is
  ;; the leading numeric arg of a canonical Multiply (or the term
  ;; itself when the term IS numeric); the factors are the remaining
  ;; slots. Out-params in $term_factors_data / $term_factors_count;
  ;; returns the coefficient slot pointer, or 0 for an implicit 1.
  (func $term_split (param $term_slot i32) (result i32)
    (local $pointer i32)
    (local $args_array i32)
    (local $length i32)
    (local $data i32)
    (local $first_slot i32)
    (if (call $expression_slot_is_numeric (local.get $term_slot))
      (then
        (global.set $term_factors_data (i32.const 0))
        (global.set $term_factors_count (i32.const 0))
        (return (local.get $term_slot))))
    (if (i32.eq (call $value_type (local.get $term_slot)) (global.get $TYPE_EXPRESSION))
      (then
        (local.set $pointer (call $value_data_lo (local.get $term_slot)))
        (if (i32.eq
              (call $symbol_description (call $expression_head (local.get $pointer)))
              (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)))
          (then
            (local.set $args_array (call $expression_args (local.get $pointer)))
            (local.set $length (i32.load (call $abs
              (i32.add (local.get $args_array) (i32.const 8)))))
            (local.set $data (i32.load (call $abs
              (i32.add (local.get $args_array) (i32.const 16)))))
            (local.set $first_slot (i32.add (local.get $data) (global.get $GC_HEADER_SIZE)))
            (if (i32.and
                  (i32.gt_u (local.get $length) (i32.const 0))
                  (call $expression_slot_is_numeric (local.get $first_slot)))
              (then
                (global.set $term_factors_data
                  (i32.add (local.get $first_slot) (global.get $VALUE_SIZE)))
                (global.set $term_factors_count
                  (i32.sub (local.get $length) (i32.const 1)))
                (return (local.get $first_slot))))
            (global.set $term_factors_data (local.get $first_slot))
            (global.set $term_factors_count (local.get $length))
            (return (i32.const 0))))))
    ;; Any non-Multiply, non-numeric term is a single factor.
    (global.set $term_factors_data (local.get $term_slot))
    (global.set $term_factors_count (i32.const 1))
    (i32.const 0)
  )

  ;; Stage a term's collapsed factor list at $dest (committed staging
  ;; area owned by the caller). Entry layout, 16 bytes each:
  ;;   [base_slot_ptr:4][exp_lo:4][exp_hi:4][exp_slot_ptr:4]
  ;; exp_slot_ptr == 0          → exponent is the i64 in exp_lo/hi
  ;; exp_slot_ptr == 0xFFFFFFFF → incomparable (i64 overflow sentinel)
  ;; otherwise                  → exponent lives in that value slot
  ;; Adjacent factors with structurally equal bases and i64 exponents
  ;; collapse (x·x → (x,2)). Returns the entry count.
  (func $stage_factor_entries
    (param $term_slot i32) (param $dest i32) (param $capacity i32) (result i32)
    (local $count i32)
    (local $factors_data i32)
    (local $factors_count i32)
    (local $i i32)
    (local $factor_slot i32)
    (local $base_slot i32)
    (local $exp_slot i32)
    (local $exp_value i64)
    (local $has_i64 i32)
    (local $pointer i32)
    (local $power_args i32)
    (local $power_data i32)
    (local $previous i32)
    (local $previous_exp i64)
    (local $sum i64)

    (drop (call $term_split (local.get $term_slot)))
    (local.set $factors_data (global.get $term_factors_data))
    (local.set $factors_count (global.get $term_factors_count))
    (local.set $count (i32.const 0))
    (local.set $i (i32.const 0))
    (block $done
      (loop $walk
        (br_if $done (i32.ge_u (local.get $i) (local.get $factors_count)))
        (local.set $factor_slot (i32.add (local.get $factors_data)
          (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
        ;; Decompose Power(base, integer-literal) into (base, exponent);
        ;; anything else is (factor, 1).
        (local.set $base_slot (local.get $factor_slot))
        (local.set $exp_slot (i32.const 0))
        (local.set $exp_value (i64.const 1))
        (local.set $has_i64 (i32.const 1))
        (if (i32.eq (call $value_type (local.get $factor_slot)) (global.get $TYPE_EXPRESSION))
          (then
            (local.set $pointer (call $value_data_lo (local.get $factor_slot)))
            (if (i32.eq
                  (call $symbol_description (call $expression_head (local.get $pointer)))
                  (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_POWER)))
              (then
                (local.set $power_args (call $expression_args (local.get $pointer)))
                (if (i32.eq (i32.load (call $abs
                      (i32.add (local.get $power_args) (i32.const 8)))) (i32.const 2))
                  (then
                    (local.set $power_data (i32.load (call $abs
                      (i32.add (local.get $power_args) (i32.const 16)))))
                    (local.set $exp_slot (i32.add
                      (i32.add (local.get $power_data) (global.get $GC_HEADER_SIZE))
                      (global.get $VALUE_SIZE)))
                    (if (i32.and
                          (call $expression_slot_is_numeric (local.get $exp_slot))
                          (i32.ne (i32.eq (call $value_type (local.get $exp_slot))
                            (global.get $TYPE_COMPLEX)) (i32.const 1)))
                      (then
                        (local.set $base_slot (i32.add
                          (local.get $power_data) (global.get $GC_HEADER_SIZE)))
                        (if (call $exponent_slot_to_i64 (local.get $exp_slot))
                          (then
                            (local.set $exp_value (global.get $bigint_to_i64_value))
                            (local.set $exp_slot (i32.const 0)))
                          (else (local.set $has_i64 (i32.const 0)))))
                      (else
                        ;; Non-numeric exponent: the whole Power is the base.
                        (local.set $exp_slot (i32.const 0))))))))))
        ;; Collapse into the previous entry when bases match and both
        ;; exponents are plain i64s.
        (if (i32.gt_u (local.get $count) (i32.const 0))
          (then
            (local.set $previous (i32.add (local.get $dest)
              (i32.mul (i32.sub (local.get $count) (i32.const 1)) (i32.const 16))))
            (if (i32.and
                  (i32.and
                    (i32.eqz (i32.load (call $abs
                      (i32.add (local.get $previous) (i32.const 12)))))
                    (i32.and (local.get $has_i64) (i32.eqz (local.get $exp_slot))))
                  (call $expression_values_equal
                    (i32.load (call $abs (local.get $previous)))
                    (local.get $base_slot)))
              (then
                (local.set $previous_exp (i64.or
                  (i64.extend_i32_u (i32.load (call $abs
                    (i32.add (local.get $previous) (i32.const 4)))))
                  (i64.shl (i64.extend_i32_u (i32.load (call $abs
                    (i32.add (local.get $previous) (i32.const 8))))) (i64.const 32))))
                (local.set $sum (i64.add (local.get $previous_exp) (local.get $exp_value)))
                ;; Same-sign overflow check; overflow marks the entry
                ;; incomparable rather than wrapping.
                (if (i32.and
                      (i64.gt_s (local.get $previous_exp) (i64.const 0))
                      (i32.and
                        (i64.gt_s (local.get $exp_value) (i64.const 0))
                        (i64.le_s (local.get $sum) (i64.const 0))))
                  (then
                    (i32.store (call $abs (i32.add (local.get $previous) (i32.const 12)))
                      (i32.const 0xFFFFFFFF)))
                  (else
                    (i32.store (call $abs (i32.add (local.get $previous) (i32.const 4)))
                      (i32.wrap_i64 (local.get $sum)))
                    (i32.store (call $abs (i32.add (local.get $previous) (i32.const 8)))
                      (i32.wrap_i64 (i64.shr_u (local.get $sum) (i64.const 32))))))
                (local.set $i (i32.add (local.get $i) (i32.const 1)))
                (br $walk)))))
        ;; Append a fresh entry. A short caller-owned buffer is an
        ;; internal invariant failure, never permission to overwrite the heap.
        (if (i32.ge_u (local.get $count) (local.get $capacity)) (then (unreachable)))
        (i32.store (call $abs (i32.add (local.get $dest)
          (i32.mul (local.get $count) (i32.const 16))))
          (local.get $base_slot))
        (i32.store (call $abs (i32.add
          (i32.add (local.get $dest) (i32.mul (local.get $count) (i32.const 16)))
          (i32.const 4)))
          (i32.wrap_i64 (local.get $exp_value)))
        (i32.store (call $abs (i32.add
          (i32.add (local.get $dest) (i32.mul (local.get $count) (i32.const 16)))
          (i32.const 8)))
          (i32.wrap_i64 (i64.shr_u (local.get $exp_value) (i64.const 32))))
        (i32.store (call $abs (i32.add
          (i32.add (local.get $dest) (i32.mul (local.get $count) (i32.const 16)))
          (i32.const 12)))
          (local.get $exp_slot))
        (local.set $count (i32.add (local.get $count) (i32.const 1)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $walk)
      )
    )
    (local.get $count)
  )

  ;; Read a staged entry's i64 exponent (only valid when its slot word
  ;; is 0).
  (func $staged_entry_exponent (param $entry i32) (result i64)
    (i64.or
      (i64.extend_i32_u (i32.load (call $abs (i32.add (local.get $entry) (i32.const 4)))))
      (i64.shl
        (i64.extend_i32_u (i32.load (call $abs (i32.add (local.get $entry) (i32.const 8)))))
        (i64.const 32)))
  )

  ;; Sign class of a staged entry's exponent: -1 / 0 / 1. Incomparable
  ;; sentinel entries count as huge-positive.
  (func $staged_entry_exponent_sign (param $entry i32) (result i32)
    (local $slot i32)
    (local $value i64)
    (local.set $slot (i32.load (call $abs (i32.add (local.get $entry) (i32.const 12)))))
    (if (i32.eq (local.get $slot) (i32.const 0xFFFFFFFF))
      (then (return (i32.const 1))))
    (if (local.get $slot)
      (then
        ;; Slot-carried exponent: an integer too large for i64 — its
        ;; sign decides. power_exponent_class: 1 = negative, 2 = non-neg.
        (if (i32.eq (call $power_exponent_class (local.get $slot)) (i32.const 1))
          (then (return (i32.const -1))))
        (return (i32.const 1))))
    (local.set $value (call $staged_entry_exponent (local.get $entry)))
    (if (i64.lt_s (local.get $value) (i64.const 0))
      (then (return (i32.const -1))))
    (if (i64.gt_s (local.get $value) (i64.const 0))
      (then (return (i32.const 1))))
    (i32.const 0)
  )

  ;; Are two staged factor lists the same monomial factor part?
  ;; (Same length, pairwise equal bases and exponents.) The comparisons
  ;; may signal pressure (dummy result; callers poll the flag).
  (func $staged_factors_equal
    (param $a i32) (param $a_count i32)
    (param $b i32) (param $b_count i32)
    (result i32)
    (local $i i32)
    (local $entry_a i32)
    (local $entry_b i32)
    (local $slot_a i32)
    (local $slot_b i32)
    (if (i32.ne (local.get $a_count) (local.get $b_count))
      (then (return (i32.const 0))))
    (local.set $i (i32.const 0))
    (block $done
      (loop $walk
        (br_if $done (i32.ge_u (local.get $i) (local.get $a_count)))
        (local.set $entry_a (i32.add (local.get $a) (i32.mul (local.get $i) (i32.const 16))))
        (local.set $entry_b (i32.add (local.get $b) (i32.mul (local.get $i) (i32.const 16))))
        (if (i32.eqz (call $expression_values_equal
              (i32.load (call $abs (local.get $entry_a)))
              (i32.load (call $abs (local.get $entry_b)))))
          (then (return (i32.const 0))))
        (local.set $slot_a (i32.load (call $abs (i32.add (local.get $entry_a) (i32.const 12)))))
        (local.set $slot_b (i32.load (call $abs (i32.add (local.get $entry_b) (i32.const 12)))))
        ;; Incomparable sentinels never merge.
        (if (i32.or
              (i32.eq (local.get $slot_a) (i32.const 0xFFFFFFFF))
              (i32.eq (local.get $slot_b) (i32.const 0xFFFFFFFF)))
          (then (return (i32.const 0))))
        (if (i32.and (i32.eqz (local.get $slot_a)) (i32.eqz (local.get $slot_b)))
          (then
            (if (i64.ne (call $staged_entry_exponent (local.get $entry_a))
                        (call $staged_entry_exponent (local.get $entry_b)))
              (then (return (i32.const 0)))))
          (else
            ;; i64-able exponents always use the i64 form, so a mixed
            ;; pair is unequal; two slot-carried ones compare exactly.
            (if (i32.or (i32.eqz (local.get $slot_a)) (i32.eqz (local.get $slot_b)))
              (then (return (i32.const 0))))
            (if (i32.ne (call $exact_numeric_slots_compare
                  (local.get $slot_a) (local.get $slot_b)) (i32.const 0))
              (then (return (i32.const 0))))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $walk)
      )
    )
    (i32.const 1)
  )

  ;; Canonical monomial order over staged factor lists: lex on the
  ;; exponent vector with atoms ascending (Symbols alphabetical before
  ;; opaque atoms) and, at the first differing atom, the larger
  ;; exponent first. x² < x·y < x < y < 1 in the emitted order — the
  ;; degree-0 term (empty list) always sorts last. Returns -1/0/1
  ;; ("a sorts first" is negative).
  (func $staged_factors_order_compare
    (param $a i32) (param $a_count i32)
    (param $b i32) (param $b_count i32)
    (result i32)
    (local $ia i32)
    (local $ib i32)
    (local $entry_a i32)
    (local $entry_b i32)
    (local $cmp i32)
    (local $slot_a i32)
    (local $slot_b i32)
    (local $exp_a i64)
    (local $exp_b i64)
    (local $sign i32)
    (block $done
      (loop $walk
        (br_if $done (i32.and
          (i32.ge_u (local.get $ia) (local.get $a_count))
          (i32.ge_u (local.get $ib) (local.get $b_count))))
        ;; One side exhausted: the side with remaining factors has a
        ;; positive-or-negative exponent where the other has 0.
        (if (i32.ge_u (local.get $ia) (local.get $a_count))
          (then
            (local.set $sign (call $staged_entry_exponent_sign
              (i32.add (local.get $b) (i32.mul (local.get $ib) (i32.const 16)))))
            (if (i32.gt_s (local.get $sign) (i32.const 0))
              (then (return (i32.const 1))))
            (return (i32.const -1))))
        (if (i32.ge_u (local.get $ib) (local.get $b_count))
          (then
            (local.set $sign (call $staged_entry_exponent_sign
              (i32.add (local.get $a) (i32.mul (local.get $ia) (i32.const 16)))))
            (if (i32.gt_s (local.get $sign) (i32.const 0))
              (then (return (i32.const -1))))
            (return (i32.const 1))))
        (local.set $entry_a (i32.add (local.get $a) (i32.mul (local.get $ia) (i32.const 16))))
        (local.set $entry_b (i32.add (local.get $b) (i32.mul (local.get $ib) (i32.const 16))))
        (local.set $cmp (call $expression_compare_slots
          (i32.load (call $abs (local.get $entry_a)))
          (i32.load (call $abs (local.get $entry_b)))))
        ;; Differing atoms: whichever side holds the smaller atom leads
        ;; with its exponent sign (positive → it sorts first).
        (if (i32.lt_s (local.get $cmp) (i32.const 0))
          (then
            (local.set $sign (call $staged_entry_exponent_sign (local.get $entry_a)))
            (if (i32.gt_s (local.get $sign) (i32.const 0))
              (then (return (i32.const -1))))
            (return (i32.const 1))))
        (if (i32.gt_s (local.get $cmp) (i32.const 0))
          (then
            (local.set $sign (call $staged_entry_exponent_sign (local.get $entry_b)))
            (if (i32.gt_s (local.get $sign) (i32.const 0))
              (then (return (i32.const 1))))
            (return (i32.const -1))))
        ;; Same atom: larger exponent first.
        (local.set $slot_a (i32.load (call $abs (i32.add (local.get $entry_a) (i32.const 12)))))
        (local.set $slot_b (i32.load (call $abs (i32.add (local.get $entry_b) (i32.const 12)))))
        (if (i32.and (i32.eqz (local.get $slot_a)) (i32.eqz (local.get $slot_b)))
          (then
            (local.set $exp_a (call $staged_entry_exponent (local.get $entry_a)))
            (local.set $exp_b (call $staged_entry_exponent (local.get $entry_b)))
            (if (i64.gt_s (local.get $exp_a) (local.get $exp_b))
              (then (return (i32.const -1))))
            (if (i64.lt_s (local.get $exp_a) (local.get $exp_b))
              (then (return (i32.const 1)))))
          (else
            ;; Slot-carried or sentinel exponents: order by sign class
            ;; first (huge-positive beats any i64), then exact compare
            ;; when both are slot-carried.
            (if (i32.or
                  (i32.or
                    (i32.eq (local.get $slot_a) (i32.const 0xFFFFFFFF))
                    (i32.eq (local.get $slot_b) (i32.const 0xFFFFFFFF)))
                  (i32.or (i32.eqz (local.get $slot_a)) (i32.eqz (local.get $slot_b))))
              (then
                (local.set $sign (i32.sub
                  (call $staged_entry_exponent_sign (local.get $entry_a))
                  (call $staged_entry_exponent_sign (local.get $entry_b))))
                (if (i32.gt_s (local.get $sign) (i32.const 0))
                  (then (return (i32.const -1))))
                (if (i32.lt_s (local.get $sign) (i32.const 0))
                  (then (return (i32.const 1))))
                ;; Same sign class: a slot-carried magnitude dwarfs an
                ;; i64 one; positive huge first, negative huge last.
                (if (i32.ne (i32.eqz (local.get $slot_a)) (i32.eqz (local.get $slot_b)))
                  (then
                    (local.set $sign (call $staged_entry_exponent_sign (local.get $entry_a)))
                    (if (i32.eqz (local.get $slot_a))
                      (then
                        (if (i32.gt_s (local.get $sign) (i32.const 0))
                          (then (return (i32.const 1))))
                        (return (i32.const -1)))
                      (else
                        (if (i32.gt_s (local.get $sign) (i32.const 0))
                          (then (return (i32.const -1))))
                        (return (i32.const 1)))))))
              (else
                (local.set $cmp (call $exact_numeric_slots_compare
                  (local.get $slot_a) (local.get $slot_b)))
                (if (i32.gt_s (local.get $cmp) (i32.const 0))
                  (then (return (i32.const -1))))
                (if (i32.lt_s (local.get $cmp) (i32.const 0))
                  (then (return (i32.const 1))))))))
        (local.set $ia (i32.add (local.get $ia) (i32.const 1)))
        (local.set $ib (i32.add (local.get $ib) (i32.const 1)))
        (br $walk)
      )
    )
    (i32.const 0)
  )

  ;; Compare two Add terms in canonical monomial order: factor lists
  ;; first (staged at the caller-owned staging areas), coefficients as
  ;; the tie-break, full Ring 2 slot order as the final fallback so the
  ;; order is total. May signal pressure (dummy 0; callers poll).
  (func $expression_monomial_term_compare
    (param $a_slot i32) (param $b_slot i32)
    (param $stage_a i32) (param $stage_b i32)
    (param $stage_capacity i32)
    (result i32)
    (local $a_count i32)
    (local $b_count i32)
    (local $cmp i32)
    (local $coeff_a i32)
    (local $coeff_b i32)
    (local.set $a_count (call $stage_factor_entries
      (local.get $a_slot) (local.get $stage_a) (local.get $stage_capacity)))
    (local.set $b_count (call $stage_factor_entries
      (local.get $b_slot) (local.get $stage_b) (local.get $stage_capacity)))
    (local.set $cmp (call $staged_factors_order_compare
      (local.get $stage_a) (local.get $a_count)
      (local.get $stage_b) (local.get $b_count)))
    (if (i32.ne (local.get $cmp) (i32.const 0))
      (then (return (local.get $cmp))))
    ;; Same factor part: order by coefficient (ascending), implicit 1
    ;; via the numeric comparator's own Rational handling.
    (local.set $coeff_a (call $term_split (local.get $a_slot)))
    (local.set $coeff_b (call $term_split (local.get $b_slot)))
    (if (i32.and
          (i32.ne (local.get $coeff_a) (i32.const 0))
          (i32.ne (local.get $coeff_b) (i32.const 0)))
      (then
        (local.set $cmp (call $expression_numeric_compare
          (local.get $coeff_a) (local.get $coeff_b)))
        (if (i32.ne (local.get $cmp) (i32.const 0))
          (then (return (local.get $cmp))))))
    ;; Final fallback: total Ring 2 order.
    (call $expression_compare_slots (local.get $a_slot) (local.get $b_slot))
  )

  ;; Compare two Multiply args as monomial factors: numerics first
  ;; (the coefficient), then by base ascending, then by exponent
  ;; descending, then full Ring 2 order. Allocation-free.
  (func $expression_factor_compare (param $a_slot i32) (param $b_slot i32) (result i32)
    (local $a_numeric i32)
    (local $b_numeric i32)
    (local $a_base i32)
    (local $b_base i32)
    (local $a_exp_slot i32)
    (local $b_exp_slot i32)
    (local $a_exp i64)
    (local $b_exp i64)
    (local $cmp i32)
    (local.set $a_numeric (call $expression_slot_is_numeric (local.get $a_slot)))
    (local.set $b_numeric (call $expression_slot_is_numeric (local.get $b_slot)))
    (if (i32.and (local.get $a_numeric) (local.get $b_numeric))
      (then (return (call $expression_numeric_compare (local.get $a_slot) (local.get $b_slot)))))
    (if (local.get $a_numeric) (then (return (i32.const -1))))
    (if (local.get $b_numeric) (then (return (i32.const 1))))
    ;; Decompose Power(base, integer-literal); default exponent 1.
    (local.set $a_base (local.get $a_slot))
    (local.set $a_exp (i64.const 1))
    (local.set $a_exp_slot (i32.const 0))
    (call $factor_decompose (local.get $a_slot))
    (local.set $a_base (global.get $term_factors_data))
    (local.set $a_exp_slot (global.get $term_factors_count))
    (if (i32.eqz (local.get $a_exp_slot))
      (then (local.set $a_exp (global.get $bigint_to_i64_value))))
    (call $factor_decompose (local.get $b_slot))
    (local.set $b_base (global.get $term_factors_data))
    (local.set $b_exp_slot (global.get $term_factors_count))
    (if (i32.eqz (local.get $b_exp_slot))
      (then (local.set $b_exp (global.get $bigint_to_i64_value))))
    (local.set $cmp (call $expression_compare_slots (local.get $a_base) (local.get $b_base)))
    (if (i32.ne (local.get $cmp) (i32.const 0))
      (then (return (local.get $cmp))))
    ;; Same base: exponent descending. Slot-carried exponents (huge)
    ;; order by sign class against i64 ones; two slot-carried compare
    ;; exactly.
    (if (i32.and (i32.eqz (local.get $a_exp_slot)) (i32.eqz (local.get $b_exp_slot)))
      (then
        (if (i64.gt_s (local.get $a_exp) (local.get $b_exp))
          (then (return (i32.const -1))))
        (if (i64.lt_s (local.get $a_exp) (local.get $b_exp))
          (then (return (i32.const 1)))))
      (else
        (if (i32.and
              (i32.ne (local.get $a_exp_slot) (i32.const 0))
              (i32.ne (local.get $b_exp_slot) (i32.const 0)))
          (then
            (local.set $cmp (call $exact_numeric_slots_compare
              (local.get $a_exp_slot) (local.get $b_exp_slot)))
            (if (i32.gt_s (local.get $cmp) (i32.const 0))
              (then (return (i32.const -1))))
            (if (i32.lt_s (local.get $cmp) (i32.const 0))
              (then (return (i32.const 1)))))
          (else
            ;; One huge, one i64: the huge one is bigger in magnitude;
            ;; positive-huge sorts first, negative-huge sorts last.
            (if (i32.ne (local.get $a_exp_slot) (i32.const 0))
              (then
                (if (i32.eq (call $power_exponent_class (local.get $a_exp_slot)) (i32.const 1))
                  (then (return (i32.const 1))))
                (return (i32.const -1)))
              (else
                (if (i32.eq (call $power_exponent_class (local.get $b_exp_slot)) (i32.const 1))
                  (then (return (i32.const -1))))
                (return (i32.const 1))))))))
    (call $expression_compare_slots (local.get $a_slot) (local.get $b_slot))
  )

  ;; Decompose a single factor: Power(base, numeric-integer exponent)
  ;; → base + exponent, anything else → (factor, 1). Out-params:
  ;; $term_factors_data = base slot, $term_factors_count = exponent
  ;; slot (0 = i64 exponent in $bigint_to_i64_value).
  (func $factor_decompose (param $factor_slot i32)
    (local $pointer i32)
    (local $power_args i32)
    (local $power_data i32)
    (local $exp_slot i32)
    (global.set $term_factors_data (local.get $factor_slot))
    (global.set $term_factors_count (i32.const 0))
    (global.set $bigint_to_i64_value (i64.const 1))
    (if (i32.ne (call $value_type (local.get $factor_slot)) (global.get $TYPE_EXPRESSION))
      (then (return)))
    (local.set $pointer (call $value_data_lo (local.get $factor_slot)))
    (if (i32.ne
          (call $symbol_description (call $expression_head (local.get $pointer)))
          (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_POWER)))
      (then (return)))
    (local.set $power_args (call $expression_args (local.get $pointer)))
    (if (i32.ne (i32.load (call $abs
          (i32.add (local.get $power_args) (i32.const 8)))) (i32.const 2))
      (then (return)))
    (local.set $power_data (i32.load (call $abs
      (i32.add (local.get $power_args) (i32.const 16)))))
    (local.set $exp_slot (i32.add
      (i32.add (local.get $power_data) (global.get $GC_HEADER_SIZE))
      (global.get $VALUE_SIZE)))
    ;; Only numeric non-Complex exponents split the Power; a symbolic
    ;; or Complex exponent keeps the whole Power as the base.
    (if (i32.or
          (i32.eqz (call $expression_slot_is_numeric (local.get $exp_slot)))
          (i32.eq (call $value_type (local.get $exp_slot)) (global.get $TYPE_COMPLEX)))
      (then (return)))
    (global.set $term_factors_data (i32.add
      (local.get $power_data) (global.get $GC_HEADER_SIZE)))
    (if (call $exponent_slot_to_i64 (local.get $exp_slot))
      (then (global.set $term_factors_count (i32.const 0)))
      (else
        (global.set $term_factors_count (local.get $exp_slot))
        (global.set $bigint_to_i64_value (i64.const 0))))
  )

  ;; Collect like terms in an Add's emitted arg region, in place:
  ;; group terms by identical collapsed factor lists, sum coefficients
  ;; (Ring 1 folds), drop zero-coefficient groups, compact. Returns the
  ;; surviving term count, or -1 on pressure-abort.
  ;; $stage_a / $stage_b are caller-owned committed staging areas, each
  ;; large enough for the longest term's factor entries.
  (func $expression_collect_terms
    (param $data_start i32) (param $count i32)
    (param $stage_a i32) (param $stage_b i32)
    (param $stage_capacity i32)
    (result i32)
    (local $i i32)
    (local $j i32)
    (local $slot_i i32)
    (local $slot_j i32)
    (local $count_i i32)
    (local $count_j i32)
    (local $coeff_acc i32)
    (local $coeff_operand i32)
    (local $merged i32)
    (local $coeff_slot i32)
    (local $factors_data i32)
    (local $factors_count i32)
    (local $k i32)
    (local $out i32)
    (local $new_args i32)
    (local $new_data i32)
    (local $data_size i32)
    (local $aligned i32)
    (local $dest_elem i32)
    (local $new_expression i32)

    ;; Committed accumulator + operand slots (folds allocate around them).
    (if (call $expression_walk_guard (i32.const 48))
      (then (return (i32.const -1))))
    (local.set $coeff_acc (call $carve_scratch_blob
      (i32.mul (i32.const 2) (global.get $VALUE_SIZE))))
    (local.set $coeff_operand (i32.add (local.get $coeff_acc) (global.get $VALUE_SIZE)))

    (local.set $i (i32.const 0))
    (block $outer_done
      (loop $outer
        (br_if $outer_done (i32.ge_u (local.get $i) (local.get $count)))
        (local.set $slot_i (i32.add (local.get $data_start)
          (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
        ;; Tombstoned or pure-numeric terms are left alone (the fold
        ;; pass already merged all numerics into at most one term).
        (if (i32.or
              (i32.eq (i32.load (call $abs (local.get $slot_i))) (i32.const 0x7FFFFFFF))
              (call $expression_slot_is_numeric (local.get $slot_i)))
          (then
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $outer)))
        ;; Seed the accumulator with i's coefficient.
        (local.set $coeff_slot (call $term_split (local.get $slot_i)))
        (if (local.get $coeff_slot)
          (then (memory.copy (call $abs (local.get $coeff_acc))
            (call $abs (local.get $coeff_slot)) (global.get $VALUE_SIZE)))
          (else
            (i32.store (call $abs (local.get $coeff_acc)) (global.get $TYPE_RATIONAL))
            (i32.store (call $abs (i32.add (local.get $coeff_acc) (i32.const 4)))
              (global.get $FLAG_RATIONAL_INLINE))
            (i32.store (call $abs (i32.add (local.get $coeff_acc) (i32.const 8))) (i32.const 1))
            (i32.store (call $abs (i32.add (local.get $coeff_acc) (i32.const 12))) (i32.const 0))))
        (local.set $merged (i32.const 0))
        (local.set $j (i32.add (local.get $i) (i32.const 1)))
        (block $inner_done
          (loop $inner
            (br_if $inner_done (i32.ge_u (local.get $j) (local.get $count)))
            (local.set $slot_j (i32.add (local.get $data_start)
              (i32.mul (local.get $j) (global.get $VALUE_SIZE))))
            (if (i32.or
                  (i32.eq (i32.load (call $abs (local.get $slot_j))) (i32.const 0x7FFFFFFF))
                  (call $expression_slot_is_numeric (local.get $slot_j)))
              (then
                (local.set $j (i32.add (local.get $j) (i32.const 1)))
                (br $inner)))
            ;; Stage both factor lists (committed staging — safe across
            ;; the tail-scratch compares inside).
            (local.set $count_i (call $stage_factor_entries
              (local.get $slot_i) (local.get $stage_a) (local.get $stage_capacity)))
            (local.set $count_j (call $stage_factor_entries
              (local.get $slot_j) (local.get $stage_b) (local.get $stage_capacity)))
            (if (call $staged_factors_equal
                  (local.get $stage_a) (local.get $count_i)
                  (local.get $stage_b) (local.get $count_j))
              (then
                ;; Same monomial: fold j's coefficient into the
                ;; accumulator and tombstone j.
                (local.set $coeff_slot (call $term_split (local.get $slot_j)))
                (if (local.get $coeff_slot)
                  (then (memory.copy (call $abs (local.get $coeff_operand))
                    (call $abs (local.get $coeff_slot)) (global.get $VALUE_SIZE)))
                  (else
                    (i32.store (call $abs (local.get $coeff_operand)) (global.get $TYPE_RATIONAL))
                    (i32.store (call $abs (i32.add (local.get $coeff_operand) (i32.const 4)))
                      (global.get $FLAG_RATIONAL_INLINE))
                    (i32.store (call $abs (i32.add (local.get $coeff_operand) (i32.const 8)))
                      (i32.const 1))
                    (i32.store (call $abs (i32.add (local.get $coeff_operand) (i32.const 12)))
                      (i32.const 0))))
                (if (call $expression_walk_guard
                      (call $estimate_cross_type_arith_budget
                        (local.get $coeff_acc) (local.get $coeff_operand)))
                  (then (return (i32.const -1))))
                (call $expression_fold_add_slots
                  (local.get $coeff_acc) (local.get $coeff_operand) (local.get $coeff_acc))
                (i32.store (call $abs (local.get $slot_j)) (i32.const 0x7FFFFFFF))
                (local.set $merged (i32.const 1))))
            ;; A staged compare that could not fit its products signals
            ;; pressure; abandon the whole collection.
            (if (global.get $memory_pressure_signaled)
              (then (return (i32.const -1))))
            (local.set $j (i32.add (local.get $j) (i32.const 1)))
            (br $inner)
          )
        )
        (if (local.get $merged)
          (then
            ;; Rebuild term i with the accumulated coefficient.
            (if (call $expression_value_is_zero_wide (local.get $coeff_acc))
              (then (i32.store (call $abs (local.get $slot_i)) (i32.const 0x7FFFFFFF)))
              (else
                (drop (call $term_split (local.get $slot_i)))
                (local.set $factors_data (global.get $term_factors_data))
                (local.set $factors_count (global.get $term_factors_count))
                (if (i32.and
                      (call $expression_value_is_one_wide (local.get $coeff_acc))
                      (i32.eq (local.get $factors_count) (i32.const 1)))
                  (then
                    ;; 1 · f → the factor itself.
                    (memory.copy (call $abs (local.get $slot_i))
                      (call $abs (local.get $factors_data)) (global.get $VALUE_SIZE)))
                  (else
                    ;; Multiply(coefficient, factors…) — or just the
                    ;; factors when the coefficient folded to one.
                    (local.set $k (i32.const 1))
                    (if (call $expression_value_is_one_wide (local.get $coeff_acc))
                      (then (local.set $k (i32.const 0))))
                    (local.set $data_size (i32.add (global.get $GC_HEADER_SIZE)
                      (i32.mul (i32.add (local.get $factors_count) (local.get $k))
                        (global.get $VALUE_SIZE))))
                    (local.set $aligned (i32.and
                      (i32.add (local.get $data_size) (i32.const 15))
                      (i32.const -16)))
                    (if (call $expression_walk_guard
                          (i32.add (local.get $aligned) (i32.const 32)))
                      (then (return (i32.const -1))))
                    (local.set $new_args (call $read_state (global.get $STATE_HEAP_POINTER)))
                    (local.set $new_data (call $write_array_header
                      (local.get $new_args)
                      (i32.add (local.get $factors_count) (local.get $k))
                      (i32.add (local.get $factors_count) (local.get $k))
                      (local.get $aligned)))
                    (call $write_state (global.get $STATE_HEAP_POINTER)
                      (i32.add (local.get $new_data) (local.get $aligned)))
                    (local.set $dest_elem (i32.add (local.get $new_data)
                      (global.get $GC_HEADER_SIZE)))
                    (if (local.get $k)
                      (then
                        (memory.copy (call $abs (local.get $dest_elem))
                          (call $abs (local.get $coeff_acc)) (global.get $VALUE_SIZE))
                        (local.set $dest_elem (i32.add (local.get $dest_elem)
                          (global.get $VALUE_SIZE)))))
                    (memory.copy (call $abs (local.get $dest_elem))
                      (call $abs (local.get $factors_data))
                      (i32.mul (local.get $factors_count) (global.get $VALUE_SIZE)))
                    (local.set $new_expression (call $expression_build
                      (call $symbol_registry_lookup
                        (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)))
                      (local.get $new_args)))
                    (i32.store (call $abs (local.get $slot_i)) (global.get $TYPE_EXPRESSION))
                    (i32.store (call $abs (i32.add (local.get $slot_i) (i32.const 4)))
                      (i32.const 0))
                    (i32.store (call $abs (i32.add (local.get $slot_i) (i32.const 8)))
                      (local.get $new_expression))
                    (i32.store (call $abs (i32.add (local.get $slot_i) (i32.const 12)))
                      (i32.const 0))))))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $outer)
      )
    )

    ;; Compact over tombstones.
    (local.set $out (i32.const 0))
    (local.set $i (i32.const 0))
    (block $compact_done
      (loop $compact
        (br_if $compact_done (i32.ge_u (local.get $i) (local.get $count)))
        (local.set $slot_i (i32.add (local.get $data_start)
          (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
        (if (i32.ne (i32.load (call $abs (local.get $slot_i))) (i32.const 0x7FFFFFFF))
          (then
            (if (i32.ne (local.get $out) (local.get $i))
              (then (memory.copy
                (call $abs (i32.add (local.get $data_start)
                  (i32.mul (local.get $out) (global.get $VALUE_SIZE))))
                (call $abs (local.get $slot_i))
                (global.get $VALUE_SIZE))))
            (local.set $out (i32.add (local.get $out) (i32.const 1)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $compact)
      )
    )
    (local.get $out)
  )

  ;; ==========================================================================
  ;; Expansion — Ring 3 (3b)
  ;; ==========================================================================

  ;; Decompose a value slot into its summand list: an Add-headed
  ;; expression yields its args; anything else is a single-term "sum".
  ;; Out-params in $sum_terms_data / $sum_terms_count.
  (func $sum_term_list (param $slot i32)
    (local $pointer i32)
    (local $args_array i32)
    (if (i32.eq (call $value_type (local.get $slot)) (global.get $TYPE_EXPRESSION))
      (then
        (local.set $pointer (call $value_data_lo (local.get $slot)))
        (if (i32.eq
              (call $symbol_description (call $expression_head (local.get $pointer)))
              (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_ADD)))
          (then
            (local.set $args_array (call $expression_args (local.get $pointer)))
            (global.set $sum_terms_data (i32.add
              (i32.load (call $abs (i32.add (local.get $args_array) (i32.const 16))))
              (global.get $GC_HEADER_SIZE)))
            (global.set $sum_terms_count (i32.load (call $abs
              (i32.add (local.get $args_array) (i32.const 8)))))
            (return)))))
    (global.set $sum_terms_data (local.get $slot))
    (global.set $sum_terms_count (i32.const 1))
  )

  ;; Predicted term count of Power(k-summand sum, n): the multinomial
  ;; coefficient C(n+k-1, k-1), saturating well above the cap.
  (func $multinomial_term_count (param $n i64) (param $k i32) (result i64)
    (local $accumulator i64)
    (local $i i64)
    (local.set $accumulator (i64.const 1))
    (local.set $i (i64.const 1))
    (block $done
      (loop $step
        (br_if $done (i64.ge_s (local.get $i) (i64.extend_i32_s (local.get $k))))
        (local.set $accumulator (i64.div_s
          (i64.mul (local.get $accumulator) (i64.add (local.get $n) (local.get $i)))
          (local.get $i)))
        (if (i64.gt_s (local.get $accumulator) (i64.const 0x40000000))
          (then (return (i64.const 0x40000000))))
        (local.set $i (i64.add (local.get $i) (i64.const 1)))
        (br $step)
      )
    )
    (local.get $accumulator)
  )

  ;; Distribute the product of two sums: every left term times every
  ;; right term, each pair canonicalized through the Multiply path,
  ;; the whole result canonicalized (and collected) as an Add into
  ;; $dest_slot. Terms of a canonical Add are never themselves Adds,
  ;; so the pair products cannot re-distribute — recursion is bounded.
  ;; Returns walk status: 0 ok, 1 pressure-abort.
  (func $expression_distribute_pair
    (param $left_slot i32) (param $right_slot i32) (param $dest_slot i32)
    (result i32)
    (local $left_data i32)
    (local $left_count i32)
    (local $right_data i32)
    (local $right_count i32)
    (local $total i32)
    (local $outer_array i32)
    (local $outer_data i32)
    (local $outer_aligned i32)
    (local $pair_array i32)
    (local $pair_data i32)
    (local $i i32)
    (local $j i32)
    (local $data_size i32)

    (call $sum_term_list (local.get $left_slot))
    (local.set $left_data (global.get $sum_terms_data))
    (local.set $left_count (global.get $sum_terms_count))
    (call $sum_term_list (local.get $right_slot))
    (local.set $right_data (global.get $sum_terms_data))
    (local.set $right_count (global.get $sum_terms_count))
    (local.set $total (i32.mul (local.get $left_count) (local.get $right_count)))

    ;; The outer Add args array is this call's size-parametrized carve;
    ;; the per-pair arrays and the pair canonicalizations guard
    ;; themselves.
    (local.set $outer_aligned (i32.and
      (i32.add
        (i32.add (global.get $GC_HEADER_SIZE)
          (i32.mul (local.get $total) (global.get $VALUE_SIZE)))
        (i32.const 15))
      (i32.const -16)))
    (if (call $expression_walk_guard (i32.add (local.get $outer_aligned) (i32.const 64)))
      (then (return (i32.const 1))))
    (local.set $outer_array (call $read_state (global.get $STATE_HEAP_POINTER)))
    (local.set $outer_data (call $write_array_header
      (local.get $outer_array) (local.get $total) (local.get $total)
      (local.get $outer_aligned)))
    (call $write_state (global.get $STATE_HEAP_POINTER)
      (i32.add (local.get $outer_data) (local.get $outer_aligned)))

    (local.set $i (i32.const 0))
    (block $outer_done
      (loop $outer_loop
        (br_if $outer_done (i32.ge_u (local.get $i) (local.get $left_count)))
        (local.set $j (i32.const 0))
        (block $inner_done
          (loop $inner_loop
            (br_if $inner_done (i32.ge_u (local.get $j) (local.get $right_count)))
            ;; Build the 2-arg product and canonicalize it straight into
            ;; its outer slot.
            (if (call $expression_walk_guard (i32.const 48))
              (then (return (i32.const 1))))
            (local.set $pair_array (call $read_state (global.get $STATE_HEAP_POINTER)))
            (local.set $data_size (i32.add (global.get $GC_HEADER_SIZE)
              (i32.mul (i32.const 2) (global.get $VALUE_SIZE))))
            (local.set $pair_data (call $write_array_header
              (local.get $pair_array) (i32.const 2) (i32.const 2)
              (i32.and (i32.add (local.get $data_size) (i32.const 15)) (i32.const -16))))
            (call $write_state (global.get $STATE_HEAP_POINTER)
              (i32.add (local.get $pair_data)
                (i32.and (i32.add (local.get $data_size) (i32.const 15)) (i32.const -16))))
            (memory.copy
              (call $abs (i32.add (local.get $pair_data) (global.get $GC_HEADER_SIZE)))
              (call $abs (i32.add (local.get $left_data)
                (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
              (global.get $VALUE_SIZE))
            (memory.copy
              (call $abs (i32.add
                (i32.add (local.get $pair_data) (global.get $GC_HEADER_SIZE))
                (global.get $VALUE_SIZE)))
              (call $abs (i32.add (local.get $right_data)
                (i32.mul (local.get $j) (global.get $VALUE_SIZE))))
              (global.get $VALUE_SIZE))
            (if (call $expression_canonicalize_flat
                  (call $symbol_registry_lookup
                    (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)))
                  (local.get $pair_array)
                  (i32.const 1)
                  (i32.add
                    (i32.add (local.get $outer_data) (global.get $GC_HEADER_SIZE))
                    (i32.mul
                      (i32.add (i32.mul (local.get $i) (local.get $right_count))
                        (local.get $j))
                      (global.get $VALUE_SIZE))))
              (then (return (i32.const 1))))
            (local.set $j (i32.add (local.get $j) (i32.const 1)))
            (br $inner_loop)
          )
        )
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $outer_loop)
      )
    )

    ;; Canonicalize (collect + order) the distributed sum.
    (call $expression_canonicalize_flat
      (call $symbol_registry_lookup
        (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_ADD)))
      (local.get $outer_array)
      (i32.const 0)
      (local.get $dest_slot))
  )

  ;; Is this factor Power(_, negative-integer literal)? Distribution
  ;; must not cross division shapes — that is 3d's cancellation
  ;; territory.
  (func $factor_is_negative_power (param $slot i32) (result i32)
    (local $pointer i32)
    (local $args_array i32)
    (local $data i32)
    (if (i32.ne (call $value_type (local.get $slot)) (global.get $TYPE_EXPRESSION))
      (then (return (i32.const 0))))
    (local.set $pointer (call $value_data_lo (local.get $slot)))
    (if (i32.ne
          (call $symbol_description (call $expression_head (local.get $pointer)))
          (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_POWER)))
      (then (return (i32.const 0))))
    (local.set $args_array (call $expression_args (local.get $pointer)))
    (if (i32.ne (i32.load (call $abs
          (i32.add (local.get $args_array) (i32.const 8)))) (i32.const 2))
      (then (return (i32.const 0))))
    (local.set $data (i32.load (call $abs
      (i32.add (local.get $args_array) (i32.const 16)))))
    (i32.eq
      (call $power_exponent_class (i32.add
        (i32.add (local.get $data) (global.get $GC_HEADER_SIZE))
        (global.get $VALUE_SIZE)))
      (i32.const 1))
  )

  ;; Does this value contain the formal exact-zero reciprocal that represents
  ;; division by exact zero? Pure recursive read; no allocation. Identity and
  ;; cancellation rules use it before they erase participating subterms.
  (func $expression_value_contains_undefined (param $slot i32) (result i32)
    (local $pointer i32)
    (local $head_description i32)
    (local $arguments_array i32)
    (local $argument_count i32)
    (local $arguments_data i32)
    (local $index i32)
    (local $base_slot i32)
    (local $exponent_slot i32)
    (if (i32.ne (call $value_type (local.get $slot)) (global.get $TYPE_EXPRESSION))
      (then (return (i32.const 0))))
    (local.set $pointer (call $value_data_lo (local.get $slot)))
    (local.set $head_description
      (call $symbol_description (call $expression_head (local.get $pointer))))
    (local.set $arguments_array (call $expression_args (local.get $pointer)))
    (local.set $argument_count (i32.load (call $abs
      (i32.add (local.get $arguments_array) (i32.const 8)))))
    (local.set $arguments_data (i32.add
      (i32.load (call $abs (i32.add
        (local.get $arguments_array) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (if (i32.and
          (i32.eq (local.get $head_description)
            (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_POWER)))
          (i32.eq (local.get $argument_count) (i32.const 2)))
      (then
        (local.set $base_slot (local.get $arguments_data))
        (local.set $exponent_slot
          (i32.add (local.get $base_slot) (global.get $VALUE_SIZE)))
        (if (i32.and
              (call $expression_value_is_zero_wide (local.get $base_slot))
              (i32.eq (call $power_exponent_class (local.get $exponent_slot))
                (i32.const 1)))
          (then (return (i32.const 1))))))
    (local.set $index (i32.const 0))
    (block $arguments_done
      (loop $arguments
        (br_if $arguments_done
          (i32.ge_u (local.get $index) (local.get $argument_count)))
        (if (call $expression_value_contains_undefined
              (i32.add (local.get $arguments_data)
                (i32.mul (local.get $index) (global.get $VALUE_SIZE))))
          (then (return (i32.const 1))))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $arguments)))
    (i32.const 0)
  )

  ;; Conservative proof that a real-valued factor is nonnegative. This is
  ;; deliberately narrower than sign evaluation: the same-exponent rewrite
  ;; only needs a sufficient proof, and must leave uncertain branch cases
  ;; untouched.
  (func $expression_slot_provably_nonnegative (param $slot i32) (result i32)
    (local $type i32)
    (local $header i32)
    (local $pointer i32)
    (local $head_description i32)
    (local $arguments_array i32)
    (local $argument_count i32)
    (local $arguments_data i32)
    (local $index i32)
    (local $exponent_slot i32)
    (local $exponent i64)
    (local $base_type i32)
    (local.set $type (call $value_type (local.get $slot)))
    (if (i32.eq (local.get $type) (global.get $TYPE_BIGINT))
      (then (return (i32.eqz (call $bigint_sign
        (call $value_data_lo (local.get $slot)))))))
    (if (i32.eq (local.get $type) (global.get $TYPE_RATIONAL))
      (then
        (if (call $rational_is_inline (local.get $slot))
          (then (return (i64.ge_s
            (call $rational_read_inline (local.get $slot)) (i64.const 0)))))
        (return (i32.eqz (call $bigint_sign
          (call $rational_numerator (call $value_data_lo (local.get $slot))))))))
    (if (i32.eq (local.get $type) (global.get $TYPE_ALGEBRAIC))
      (then
        (local.set $arguments_data (i32.add
          (i32.load (call $abs (i32.add
            (call $algebraic_interval_of (call $value_data_lo (local.get $slot)))
            (i32.const 16))))
          (global.get $GC_HEADER_SIZE)))
        (return (i32.eqz (call $bigint_sign
          (call $rational_numerator
            (call $value_data_lo (local.get $arguments_data))))))))
    (if (i32.ne (local.get $type) (global.get $TYPE_EXPRESSION))
      (then (return (i32.const 0))))
    (local.set $pointer (call $value_data_lo (local.get $slot)))
    (local.set $head_description
      (call $symbol_description (call $expression_head (local.get $pointer))))
    (local.set $arguments_array (call $expression_args (local.get $pointer)))
    (local.set $argument_count
      (i32.load (call $abs (i32.add (local.get $arguments_array) (i32.const 8)))))
    (local.set $arguments_data (i32.add
      (i32.load (call $abs (i32.add (local.get $arguments_array) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (if (i32.eq (local.get $head_description)
          (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)))
      (then
        (local.set $index (i32.const 0))
        (block $multiply_done
          (loop $multiply
            (br_if $multiply_done
              (i32.ge_u (local.get $index) (local.get $argument_count)))
            (if (i32.eqz (call $expression_slot_provably_nonnegative
                  (i32.add (local.get $arguments_data)
                    (i32.mul (local.get $index) (global.get $VALUE_SIZE)))))
              (then (return (i32.const 0))))
            (local.set $index (i32.add (local.get $index) (i32.const 1)))
            (br $multiply)))
        (return (i32.const 1))))
    (if (i32.ne (local.get $head_description)
          (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_POWER)))
      (then (return (i32.const 0))))
    (if (i32.ne (local.get $argument_count) (i32.const 2))
      (then (return (i32.const 0))))
    (local.set $exponent_slot
      (i32.add (local.get $arguments_data) (global.get $VALUE_SIZE)))
    (if (i32.eqz (call $exponent_slot_to_i64 (local.get $exponent_slot)))
      (then (return (i32.const 0))))
    (local.set $exponent (global.get $bigint_to_i64_value))
    (if (i64.ne (i64.and (local.get $exponent) (i64.const 1)) (i64.const 0))
      (then (return (i32.const 0))))
    (local.set $base_type (call $value_type (local.get $arguments_data)))
    (i32.or
      (i32.eq (local.get $base_type) (global.get $TYPE_SYMBOL))
      (i32.or
        (i32.eq (local.get $base_type) (global.get $TYPE_BIGINT))
        (i32.or
          (i32.eq (local.get $base_type) (global.get $TYPE_RATIONAL))
          (i32.or
            (i32.eq (local.get $base_type) (global.get $TYPE_ALGEBRAIC))
            (call $expression_slot_provably_nonnegative
              (local.get $arguments_data))))))
  )

  ;; Same-base power combination over a SORTED Multiply arg region
  ;; (factor order makes equal bases adjacent): Power(a, n)·Power(a, m)
  ;; → Power(a, n+m), a·a → Power(a, 2), a·Power(a, -1) → dropped
  ;; entirely (exponent 0). In-place with tombstones, compacted before
  ;; return. Returns the surviving count, or -1 on pressure-abort.
  (func $expression_merge_power_runs (param $data_start i32) (param $count i32) (result i32)
    (local $leader i32)
    (local $i i32)
    (local $slot_l i32)
    (local $slot_i i32)
    (local $base_l i32)
    (local $exp_slot_l i32)
    (local $exp_l i64)
    (local $base_i i32)
    (local $exp_slot_i i32)
    (local $exp_i i64)
    (local $stage i32)
    (local $exp_a i32)
    (local $exp_b i32)
    (local $combined i32)
    (local $power_args i32)
    (local $power_data i32)
    (local $new_expression i32)
    (local $out i32)
    (local $merged_any i32)

    (if (i32.le_u (local.get $count) (i32.const 1))
      (then (return (local.get $count))))

    ;; Committed staging: two exponent operand slots + the combined
    ;; result (folds allocate around them).
    (if (call $expression_walk_guard (i32.const 64))
      (then (return (i32.const -1))))
    (local.set $stage (call $carve_scratch_blob
      (i32.mul (i32.const 3) (global.get $VALUE_SIZE))))
    (local.set $exp_a (local.get $stage))
    (local.set $exp_b (i32.add (local.get $stage) (global.get $VALUE_SIZE)))
    (local.set $combined (i32.add (local.get $exp_b) (global.get $VALUE_SIZE)))

    (local.set $leader (i32.const 0))
    (local.set $i (i32.const 1))
    (block $walk_done
      (loop $walk
        (br_if $walk_done (i32.ge_u (local.get $i) (local.get $count)))
        (local.set $slot_l (i32.add (local.get $data_start)
          (i32.mul (local.get $leader) (global.get $VALUE_SIZE))))
        (local.set $slot_i (i32.add (local.get $data_start)
          (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
        ;; A tombstoned leader (both halves of a cancelled run) resets
        ;; the run at i.
        (if (i32.eq (i32.load (call $abs (local.get $slot_l))) (i32.const 0x7FFFFFFF))
          (then
            (local.set $leader (local.get $i))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $walk)))
        (call $factor_decompose (local.get $slot_l))
        (local.set $base_l (global.get $term_factors_data))
        (local.set $exp_slot_l (global.get $term_factors_count))
        (local.set $exp_l (global.get $bigint_to_i64_value))
        (call $factor_decompose (local.get $slot_i))
        (local.set $base_i (global.get $term_factors_data))
        (local.set $exp_slot_i (global.get $term_factors_count))
        (local.set $exp_i (global.get $bigint_to_i64_value))
        (if (i32.eqz (call $expression_values_equal
              (local.get $base_l) (local.get $base_i)))
          (then
            (if (global.get $memory_pressure_signaled)
              (then (return (i32.const -1))))
            (local.set $leader (local.get $i))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $walk)))
        (if (global.get $memory_pressure_signaled)
          (then (return (i32.const -1))))
        ;; Stage both exponents as value slots and fold.
        (if (local.get $exp_slot_l)
          (then (memory.copy (call $abs (local.get $exp_a))
            (call $abs (local.get $exp_slot_l)) (global.get $VALUE_SIZE)))
          (else
            (i32.store (call $abs (local.get $exp_a)) (global.get $TYPE_RATIONAL))
            (i32.store (call $abs (i32.add (local.get $exp_a) (i32.const 4)))
              (global.get $FLAG_RATIONAL_INLINE))
            (i32.store (call $abs (i32.add (local.get $exp_a) (i32.const 8)))
              (i32.wrap_i64 (local.get $exp_l)))
            (i32.store (call $abs (i32.add (local.get $exp_a) (i32.const 12)))
              (i32.wrap_i64 (i64.shr_s (local.get $exp_l) (i64.const 32))))))
        (if (local.get $exp_slot_i)
          (then (memory.copy (call $abs (local.get $exp_b))
            (call $abs (local.get $exp_slot_i)) (global.get $VALUE_SIZE)))
          (else
            (i32.store (call $abs (local.get $exp_b)) (global.get $TYPE_RATIONAL))
            (i32.store (call $abs (i32.add (local.get $exp_b) (i32.const 4)))
              (global.get $FLAG_RATIONAL_INLINE))
            (i32.store (call $abs (i32.add (local.get $exp_b) (i32.const 8)))
              (i32.wrap_i64 (local.get $exp_i)))
            (i32.store (call $abs (i32.add (local.get $exp_b) (i32.const 12)))
              (i32.wrap_i64 (i64.shr_s (local.get $exp_i) (i64.const 32))))))
        (if (call $expression_walk_guard
              (call $estimate_cross_type_arith_budget
                (local.get $exp_a) (local.get $exp_b)))
          (then (return (i32.const -1))))
        (call $expression_fold_add_slots
          (local.get $exp_a) (local.get $exp_b) (local.get $combined))
        (local.set $merged_any (i32.const 1))
        (if (call $expression_value_is_zero_wide (local.get $combined))
          (then
            ;; a^n · a^-n → 1: the run vanishes.
            (i32.store (call $abs (local.get $slot_l)) (i32.const 0x7FFFFFFF))
            (i32.store (call $abs (local.get $slot_i)) (i32.const 0x7FFFFFFF)))
          (else
            (if (call $expression_value_is_one_wide (local.get $combined))
              (then
                ;; Combined exponent 1: the bare base.
                (memory.copy (call $abs (local.get $slot_i))
                  (call $abs (local.get $base_l)) (global.get $VALUE_SIZE))
                (i32.store (call $abs (local.get $slot_l)) (i32.const 0x7FFFFFFF)))
              (else
                ;; Build Power(base, combined).
                (if (call $expression_walk_guard (i32.const 80))
                  (then (return (i32.const -1))))
                (local.set $power_args (call $read_state (global.get $STATE_HEAP_POINTER)))
                (local.set $power_data (call $write_array_header
                  (local.get $power_args) (i32.const 2) (i32.const 2) (i32.const 48)))
                (call $write_state (global.get $STATE_HEAP_POINTER)
                  (i32.add (local.get $power_data) (i32.const 48)))
                (memory.copy
                  (call $abs (i32.add (local.get $power_data) (global.get $GC_HEADER_SIZE)))
                  (call $abs (local.get $base_l)) (global.get $VALUE_SIZE))
                (memory.copy
                  (call $abs (i32.add
                    (i32.add (local.get $power_data) (global.get $GC_HEADER_SIZE))
                    (global.get $VALUE_SIZE)))
                  (call $abs (local.get $combined)) (global.get $VALUE_SIZE))
                (local.set $new_expression (call $expression_build
                  (call $symbol_registry_lookup
                    (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_POWER)))
                  (local.get $power_args)))
                (i32.store (call $abs (local.get $slot_i)) (global.get $TYPE_EXPRESSION))
                (i32.store (call $abs (i32.add (local.get $slot_i) (i32.const 4))) (i32.const 0))
                (i32.store (call $abs (i32.add (local.get $slot_i) (i32.const 8)))
                  (local.get $new_expression))
                (i32.store (call $abs (i32.add (local.get $slot_i) (i32.const 12))) (i32.const 0))
                (i32.store (call $abs (local.get $slot_l)) (i32.const 0x7FFFFFFF))))))
        ;; The merged (or vanished) run continues at i.
        (local.set $leader (local.get $i))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $walk)
      )
    )

    (if (i32.eqz (local.get $merged_any))
      (then (return (local.get $count))))

    ;; Compact over tombstones.
    (local.set $out (i32.const 0))
    (local.set $i (i32.const 0))
    (block $compact_done
      (loop $compact
        (br_if $compact_done (i32.ge_u (local.get $i) (local.get $count)))
        (local.set $slot_i (i32.add (local.get $data_start)
          (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
        (if (i32.ne (i32.load (call $abs (local.get $slot_i))) (i32.const 0x7FFFFFFF))
          (then
            (if (i32.ne (local.get $out) (local.get $i))
              (then (memory.copy
                (call $abs (i32.add (local.get $data_start)
                  (i32.mul (local.get $out) (global.get $VALUE_SIZE))))
                (call $abs (local.get $slot_i))
                (global.get $VALUE_SIZE))))
            (local.set $out (i32.add (local.get $out) (i32.const 1)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $compact)
      )
    )
    (local.get $out)
  )
  ;; Combine equal exact-rational exponents across distinct bases:
  ;; Power(x, r)·Power(y, r) → Power(x·y, r). Odd-denominator roots are
  ;; branch-safe over all reals; even-denominator roots require each base to
  ;; be provably nonnegative.
  (func $expression_merge_equal_exponents
    (param $data_start i32) (param $count i32) (result i32)
    (local $outer_index i32)
    (local $inner_index i32)
    (local $outer_slot i32)
    (local $inner_slot i32)
    (local $outer_base i32)
    (local $inner_base i32)
    (local $outer_exponent i32)
    (local $inner_exponent i32)
    (local $exponent_header i32)
    (local $denominator i32)
    (local $combined_base_slot i32)
    (local $base_arguments i32)
    (local $base_data i32)
    (local $power_arguments i32)
    (local $power_data i32)
    (local $new_expression i32)
    (local $surviving_count i32)
    (local $merged_any i32)
    (if (i32.le_u (local.get $count) (i32.const 1))
      (then (return (local.get $count))))
    (if (call $expression_walk_guard (i32.const 64))
      (then (return (i32.const -1))))
    (local.set $combined_base_slot
      (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (local.set $outer_index (i32.const 0))
    (block $outer_done
      (loop $outer
        (br_if $outer_done
          (i32.ge_u (local.get $outer_index) (local.get $count)))
        (local.set $outer_slot (i32.add (local.get $data_start)
          (i32.mul (local.get $outer_index) (global.get $VALUE_SIZE))))
        (if (i32.eq (i32.load (call $abs (local.get $outer_slot))) (i32.const 0x7FFFFFFF))
          (then
            (local.set $outer_index
              (i32.add (local.get $outer_index) (i32.const 1)))
            (br $outer)))
        (call $factor_decompose (local.get $outer_slot))
        (local.set $outer_base (global.get $term_factors_data))
        (local.set $outer_exponent (global.get $term_factors_count))
        (if (i32.or
              (i32.eqz (local.get $outer_exponent))
              (i32.ne (call $value_type (local.get $outer_exponent))
                (global.get $TYPE_RATIONAL)))
          (then
            (local.set $outer_index
              (i32.add (local.get $outer_index) (i32.const 1)))
            (br $outer)))
        (local.set $exponent_header
          (call $value_data_lo (local.get $outer_exponent)))
        (local.set $denominator
          (call $rational_denominator (local.get $exponent_header)))
        (if (call $bigint_is_one (local.get $denominator))
          (then
            (local.set $outer_index
              (i32.add (local.get $outer_index) (i32.const 1)))
            (br $outer)))
        (local.set $inner_index
          (i32.add (local.get $outer_index) (i32.const 1)))
        (block $inner_done
          (loop $inner
            (br_if $inner_done
              (i32.ge_u (local.get $inner_index) (local.get $count)))
            (local.set $inner_slot (i32.add (local.get $data_start)
              (i32.mul (local.get $inner_index) (global.get $VALUE_SIZE))))
            (if (i32.eq
                  (i32.load (call $abs (local.get $inner_slot)))
                  (i32.const 0x7FFFFFFF))
              (then
                (local.set $inner_index
                  (i32.add (local.get $inner_index) (i32.const 1)))
                (br $inner)))
            (call $factor_decompose (local.get $inner_slot))
            (local.set $inner_base (global.get $term_factors_data))
            (local.set $inner_exponent (global.get $term_factors_count))
            (if (i32.or
                  (i32.eqz (local.get $inner_exponent))
                  (i32.ne (call $value_type (local.get $inner_exponent))
                    (global.get $TYPE_RATIONAL)))
              (then
                (local.set $inner_index
                  (i32.add (local.get $inner_index) (i32.const 1)))
                (br $inner)))
            (if (i32.eqz (call $expression_values_equal
                  (local.get $outer_exponent) (local.get $inner_exponent)))
              (then
                (if (global.get $memory_pressure_signaled)
                  (then (return (i32.const -1))))
                (local.set $inner_index
                  (i32.add (local.get $inner_index) (i32.const 1)))
                (br $inner)))
            (if (global.get $memory_pressure_signaled)
              (then (return (i32.const -1))))
            (if (i32.and
                  (i32.eqz (i32.and
                    (call $bigint_limb (local.get $denominator) (i32.const 0))
                    (i32.const 1)))
                  (i32.eqz (i32.and
                    (call $expression_slot_provably_nonnegative
                      (local.get $outer_base))
                    (call $expression_slot_provably_nonnegative
                      (local.get $inner_base)))))
              (then
                (local.set $inner_index
                  (i32.add (local.get $inner_index) (i32.const 1)))
                (br $inner)))
            (if (call $expression_walk_guard (i32.const 320))
              (then (return (i32.const -1))))
            (local.set $base_arguments
              (call $read_state (global.get $STATE_HEAP_POINTER)))
            (local.set $base_data (call $write_array_header
              (local.get $base_arguments) (i32.const 2) (i32.const 2) (i32.const 48)))
            (call $write_state (global.get $STATE_HEAP_POINTER)
              (i32.add (local.get $base_data) (i32.const 48)))
            (memory.copy
              (call $abs (i32.add (local.get $base_data) (global.get $GC_HEADER_SIZE)))
              (call $abs (local.get $outer_base))
              (global.get $VALUE_SIZE))
            (memory.copy
              (call $abs (i32.add
                (i32.add (local.get $base_data) (global.get $GC_HEADER_SIZE))
                (global.get $VALUE_SIZE)))
              (call $abs (local.get $inner_base))
              (global.get $VALUE_SIZE))
            (if (call $expression_canonicalize_flat
                  (call $symbol_registry_lookup
                    (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)))
                  (local.get $base_arguments)
                  (i32.const 1)
                  (local.get $combined_base_slot))
              (then (return (i32.const -1))))
            (local.set $power_arguments
              (call $read_state (global.get $STATE_HEAP_POINTER)))
            (local.set $power_data (call $write_array_header
              (local.get $power_arguments) (i32.const 2) (i32.const 2) (i32.const 48)))
            (call $write_state (global.get $STATE_HEAP_POINTER)
              (i32.add (local.get $power_data) (i32.const 48)))
            (memory.copy
              (call $abs (i32.add (local.get $power_data) (global.get $GC_HEADER_SIZE)))
              (call $abs (local.get $combined_base_slot))
              (global.get $VALUE_SIZE))
            (memory.copy
              (call $abs (i32.add
                (i32.add (local.get $power_data) (global.get $GC_HEADER_SIZE))
                (global.get $VALUE_SIZE)))
              (call $abs (local.get $outer_exponent))
              (global.get $VALUE_SIZE))
            (local.set $new_expression (call $expression_build
              (call $symbol_registry_lookup
                (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_POWER)))
              (local.get $power_arguments)))
            (call $write_value (local.get $outer_slot)
              (global.get $TYPE_EXPRESSION) (i32.const 0)
              (local.get $new_expression) (i32.const 0))
            (i32.store (call $abs (local.get $inner_slot)) (i32.const 0x7FFFFFFF))
            (local.set $merged_any (i32.const 1))
            ;; Refresh the outer parts: a later factor with the same exponent
            ;; can join the product made above.
            (call $factor_decompose (local.get $outer_slot))
            (local.set $outer_base (global.get $term_factors_data))
            (local.set $outer_exponent (global.get $term_factors_count))
            (local.set $inner_index
              (i32.add (local.get $inner_index) (i32.const 1)))
            (br $inner)))
        (local.set $outer_index
          (i32.add (local.get $outer_index) (i32.const 1)))
        (br $outer)))
    (if (i32.eqz (local.get $merged_any))
      (then (return (local.get $count))))
    (local.set $surviving_count (i32.const 0))
    (local.set $inner_index (i32.const 0))
    (block $compact_done
      (loop $compact
        (br_if $compact_done
          (i32.ge_u (local.get $inner_index) (local.get $count)))
        (local.set $inner_slot (i32.add (local.get $data_start)
          (i32.mul (local.get $inner_index) (global.get $VALUE_SIZE))))
        (if (i32.ne
              (i32.load (call $abs (local.get $inner_slot)))
              (i32.const 0x7FFFFFFF))
          (then
            (if (i32.ne (local.get $surviving_count) (local.get $inner_index))
              (then (memory.copy
                (call $abs (i32.add (local.get $data_start)
                  (i32.mul (local.get $surviving_count) (global.get $VALUE_SIZE))))
                (call $abs (local.get $inner_slot))
                (global.get $VALUE_SIZE))))
            (local.set $surviving_count
              (i32.add (local.get $surviving_count) (i32.const 1)))))
        (local.set $inner_index
          (i32.add (local.get $inner_index) (i32.const 1)))
        (br $compact)))
    (local.get $surviving_count)
  )


  ;; Read an integer-valued exponent slot as a BigInt header (allocates
  ;; for inline values — caller guards). Returns 0 for non-integer /
  ;; non-numeric slots.
  (func $exponent_slot_to_bigint (param $slot i32) (result i32)
    (local $type i32)
    (local $header i32)
    (local.set $type (call $value_type (local.get $slot)))
    (if (i32.eq (local.get $type) (global.get $TYPE_BIGINT))
      (then (return (call $value_data_lo (local.get $slot)))))
    (if (i32.eq (local.get $type) (global.get $TYPE_RATIONAL))
      (then
        (if (call $rational_is_inline (local.get $slot))
          (then (return (call $bigint_from_i64
            (call $rational_read_inline (local.get $slot))))))
        (local.set $header (call $value_data_lo (local.get $slot)))
        (if (call $bigint_is_one (call $rational_denominator (local.get $header)))
          (then (return (call $rational_numerator (local.get $header)))))))
    (i32.const 0)
  )

  ;; ==========================================================================
  ;; Polynomial division + GCD — Ring 3 (3c)
  ;;
  ;; Polynomials are worked as COEFFICIENT LISTS in a chosen main atom
  ;; (a Symbol, or any honorary atom): committed blobs of value slots,
  ;; index = exponent, each slot a v-free coefficient tree. Degree
  ;; bookkeeping is by index, so loops terminate by construction; all
  ;; coefficient arithmetic is "build a small tree, simplify" — Ring 1
  ;; folds numerics exactly and Ring 3a/3b keep symbolic coefficients
  ;; canonical. GCD runs the primitive pseudo-remainder sequence
  ;; (multiply/subtract only — no coefficient division ever enters the
  ;; PRS), with content removal via recursive gcd + exact division;
  ;; numeric leaves bottom out in rational / Gaussian-integer gcd.
  ;; ==========================================================================

  ;; Write an inline integer Rational value slot.
  (func $write_inline_rational (param $dest_slot i32) (param $value i64)
    (i32.store (call $abs (local.get $dest_slot)) (global.get $TYPE_RATIONAL))
    (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 4)))
      (global.get $FLAG_RATIONAL_INLINE))
    (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 8)))
      (i32.wrap_i64 (local.get $value)))
    (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 12)))
      (i32.wrap_i64 (i64.shr_s (local.get $value) (i64.const 32))))
  )

  ;; Build head(a, b) RAW into dest (fixed small carves under the walk
  ;; floor; caller guards).
  (func $build_raw_expr2
    (param $head_builtin i32) (param $a_slot i32) (param $b_slot i32) (param $dest_slot i32)
    (local $new_expression i32)
    (local.set $new_expression (call $expression_build
      (call $symbol_registry_lookup (call $read_builtin (local.get $head_builtin)))
      (call $expression_alloc_args2 (local.get $a_slot) (local.get $b_slot))))
    (i32.store (call $abs (local.get $dest_slot)) (global.get $TYPE_EXPRESSION))
    (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 4))) (i32.const 0))
    (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 8)))
      (local.get $new_expression))
    (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 12))) (i32.const 0))
  )

  ;; Build head(a, b) and simplify in place — the whole of 3c's
  ;; coefficient arithmetic. Returns walk status.
  (func $build_simplified2
    (param $head_builtin i32) (param $a_slot i32) (param $b_slot i32) (param $dest_slot i32)
    (result i32)
    (if (call $expression_walk_guard (i32.const 0))
      (then (return (i32.const 1))))
    (call $build_raw_expr2
      (local.get $head_builtin) (local.get $a_slot) (local.get $b_slot) (local.get $dest_slot))
    (call $expression_simplify_into (local.get $dest_slot) (local.get $dest_slot))
  )

  ;; Build base^exponent into dest. exponent ≥ 1; RAW unless the caller
  ;; simplifies afterwards. exponent == 1 copies the base through.
  (func $build_power_i64
    (param $base_slot i32) (param $exponent i64) (param $dest_slot i32)
    (result i32)
    (local $exponent_slot i32)
    (if (i64.eq (local.get $exponent) (i64.const 1))
      (then
        (memory.copy (call $abs (local.get $dest_slot))
          (call $abs (local.get $base_slot)) (global.get $VALUE_SIZE))
        (return (i32.const 0))))
    (if (call $expression_walk_guard (i32.const 32))
      (then (return (i32.const 1))))
    (local.set $exponent_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (call $write_inline_rational (local.get $exponent_slot) (local.get $exponent))
    (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_POWER)
      (local.get $base_slot) (local.get $exponent_slot) (local.get $dest_slot))
    (i32.const 0)
  )

  ;; Does this tree CONTAIN the given atom anywhere (including inside
  ;; opaque heads)? Structural equality at every node. Descends into
  ;; Matrix atom entries (Ring 5 (5a) — an occurrence inside an entry
  ;; is a genuine occurrence, matching substitute's descent). Pure
  ;; reads (numeric-leaf compares may signal pressure — callers poll).
  (func $expression_contains_value (param $tree_slot i32) (param $needle_slot i32) (result i32)
    (local $args_array i32)
    (local $length i32)
    (local $data i32)
    (local $i i32)
    (if (call $expression_values_equal (local.get $tree_slot) (local.get $needle_slot))
      (then (return (i32.const 1))))
    (if (i32.eq (call $value_type (local.get $tree_slot)) (global.get $TYPE_MATRIX))
      (then
        (local.set $length (i32.mul
          (call $matrix_rows_of (call $value_data_lo (local.get $tree_slot)))
          (call $matrix_columns_of (call $value_data_lo (local.get $tree_slot)))))
        (local.set $data (i32.load (call $abs (i32.add
          (call $matrix_entries_of (call $value_data_lo (local.get $tree_slot)))
          (i32.const 16)))))
        (local.set $i (i32.const 0))
        (block $matrix_done
          (loop $matrix_walk
            (br_if $matrix_done (i32.ge_u (local.get $i) (local.get $length)))
            (if (call $expression_contains_value
                  (i32.add
                    (i32.add (local.get $data) (global.get $GC_HEADER_SIZE))
                    (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
                  (local.get $needle_slot))
              (then (return (i32.const 1))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $matrix_walk)))
        (return (i32.const 0))))
    (if (i32.ne (call $value_type (local.get $tree_slot)) (global.get $TYPE_EXPRESSION))
      (then (return (i32.const 0))))
    (local.set $args_array (call $expression_args
      (call $value_data_lo (local.get $tree_slot))))
    (local.set $length (i32.load (call $abs (i32.add (local.get $args_array) (i32.const 8)))))
    (local.set $data (i32.load (call $abs (i32.add (local.get $args_array) (i32.const 16)))))
    (local.set $i (i32.const 0))
    (block $done
      (loop $walk
        (br_if $done (i32.ge_u (local.get $i) (local.get $length)))
        (if (call $expression_contains_value
              (i32.add
                (i32.add (local.get $data) (global.get $GC_HEADER_SIZE))
                (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
              (local.get $needle_slot))
          (then (return (i32.const 1))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $walk)
      )
    )
    (i32.const 0)
  )

  ;; Split a canonical term into v^e · residual. Out: exponent e in
  ;; $bigint_to_i64_value (0 when v is absent), residual written into
  ;; $residual_dest. Returns 0 ok, 1 pressure, 2 unsupported (v carries
  ;; an exponent beyond i64), 3 negative exponent on v.
  ;; $stage is caller-owned committed staging for the factor entries.
  (func $term_split_by_atom
    (param $term_slot i32) (param $v_slot i32)
    (param $stage i32) (param $stage_capacity i32)
    (param $residual_dest i32)
    (result i32)
    (local $count i32)
    (local $i i32)
    (local $entry i32)
    (local $match_index i32)
    (local $exponent i64)
    (local $coeff_slot i32)
    (local $keep_count i32)
    (local $args_array i32)
    (local $args_data i32)
    (local $data_size i32)
    (local $aligned i32)
    (local $dest_cursor i32)
    (local $factor_status i32)
    (local $new_expression i32)

    (local.set $count (call $stage_factor_entries
      (local.get $term_slot) (local.get $stage) (local.get $stage_capacity)))
    (if (global.get $memory_pressure_signaled)
      (then (return (i32.const 1))))
    ;; Find v among the staged bases.
    (local.set $match_index (i32.const -1))
    (local.set $exponent (i64.const 0))
    (local.set $i (i32.const 0))
    (block $find_done
      (loop $find
        (br_if $find_done (i32.ge_u (local.get $i) (local.get $count)))
        (local.set $entry (i32.add (local.get $stage) (i32.mul (local.get $i) (i32.const 16))))
        (if (call $expression_values_equal
              (i32.load (call $abs (local.get $entry)))
              (local.get $v_slot))
          (then
            (if (i32.ne (i32.load (call $abs (i32.add (local.get $entry) (i32.const 12))))
                        (i32.const 0))
              (then (return (i32.const 2))))
            (local.set $exponent (call $staged_entry_exponent (local.get $entry)))
            (local.set $match_index (local.get $i))
            (br $find_done)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $find)
      )
    )
    (if (global.get $memory_pressure_signaled)
      (then (return (i32.const 1))))
    (if (i64.lt_s (local.get $exponent) (i64.const 0))
      (then (return (i32.const 3))))
    (global.set $bigint_to_i64_value (local.get $exponent))

    ;; No v factor: residual = the whole term.
    (if (i32.lt_s (local.get $match_index) (i32.const 0))
      (then
        (memory.copy (call $abs (local.get $residual_dest))
          (call $abs (local.get $term_slot)) (global.get $VALUE_SIZE))
        (return (i32.const 0))))

    ;; Rebuild the residual: coefficient (if any) times the non-v
    ;; factors, preserving their canonical order.
    (local.set $coeff_slot (call $term_split (local.get $term_slot)))
    (local.set $keep_count (i32.sub (local.get $count) (i32.const 1)))
    (if (local.get $coeff_slot)
      (then (local.set $keep_count (i32.add (local.get $keep_count) (i32.const 1)))))
    (if (i32.eqz (local.get $keep_count))
      (then
        (call $write_inline_rational (local.get $residual_dest) (i64.const 1))
        (return (i32.const 0))))
    (if (i32.eq (local.get $keep_count) (i32.const 1))
      (then
        (if (local.get $coeff_slot)
          (then
            (memory.copy (call $abs (local.get $residual_dest))
              (call $abs (local.get $coeff_slot)) (global.get $VALUE_SIZE))
            (return (i32.const 0))))
        ;; The single surviving factor.
        (local.set $i (i32.const 0))
        (block $single_done
          (loop $single
            (br_if $single_done (i32.ge_u (local.get $i) (local.get $count)))
            (if (i32.ne (local.get $i) (local.get $match_index))
              (then
                (local.set $entry (i32.add (local.get $stage)
                  (i32.mul (local.get $i) (i32.const 16))))
                (return (call $staged_entry_to_factor
                  (local.get $entry) (local.get $residual_dest)))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $single)))
        (return (i32.const 0))))

    ;; Multiply(coefficient?, factors…) — RAW build; the entries came
    ;; from a canonical term, so the order is already canonical.
    (local.set $data_size (i32.add (global.get $GC_HEADER_SIZE)
      (i32.mul (local.get $keep_count) (global.get $VALUE_SIZE))))
    (local.set $aligned (i32.and
      (i32.add (local.get $data_size) (i32.const 15)) (i32.const -16)))
    (if (call $expression_walk_guard
          (i32.add (local.get $aligned)
            (i32.mul (local.get $keep_count) (i32.const 64))))
      (then (return (i32.const 1))))
    (local.set $args_array (call $read_state (global.get $STATE_HEAP_POINTER)))
    (local.set $args_data (call $write_array_header
      (local.get $args_array) (local.get $keep_count) (local.get $keep_count)
      (local.get $aligned)))
    (call $write_state (global.get $STATE_HEAP_POINTER)
      (i32.add (local.get $args_data) (local.get $aligned)))
    (local.set $dest_cursor (i32.add (local.get $args_data) (global.get $GC_HEADER_SIZE)))
    (if (local.get $coeff_slot)
      (then
        (memory.copy (call $abs (local.get $dest_cursor))
          (call $abs (local.get $coeff_slot)) (global.get $VALUE_SIZE))
        (local.set $dest_cursor (i32.add (local.get $dest_cursor) (global.get $VALUE_SIZE)))))
    (local.set $i (i32.const 0))
    (block $emit_done
      (loop $emit
        (br_if $emit_done (i32.ge_u (local.get $i) (local.get $count)))
        (if (i32.ne (local.get $i) (local.get $match_index))
          (then
            (local.set $entry (i32.add (local.get $stage)
              (i32.mul (local.get $i) (i32.const 16))))
            (local.set $factor_status (call $staged_entry_to_factor
              (local.get $entry) (local.get $dest_cursor)))
            (if (local.get $factor_status)
              (then (return (local.get $factor_status))))
            (local.set $dest_cursor (i32.add (local.get $dest_cursor) (global.get $VALUE_SIZE)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $emit)
      )
    )
    (local.set $new_expression (call $expression_build
      (call $symbol_registry_lookup
        (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)))
      (local.get $args_array)))
    (i32.store (call $abs (local.get $residual_dest)) (global.get $TYPE_EXPRESSION))
    (i32.store (call $abs (i32.add (local.get $residual_dest) (i32.const 4))) (i32.const 0))
    (i32.store (call $abs (i32.add (local.get $residual_dest) (i32.const 8)))
      (local.get $new_expression))
    (i32.store (call $abs (i32.add (local.get $residual_dest) (i32.const 12))) (i32.const 0))
    (i32.const 0)
  )

  ;; Materialize a staged factor entry back into a factor value slot:
  ;; exponent 1 → the base itself; slot-carried exponent → Power(base,
  ;; slot); i64 exponent → Power(base, inline). Returns walk status.
  (func $staged_entry_to_factor (param $entry i32) (param $dest_slot i32) (result i32)
    (local $base_slot i32)
    (local $exp_slot i32)
    (local $exponent i64)
    (local $stage_slot i32)
    (local.set $base_slot (i32.load (call $abs (local.get $entry))))
    (local.set $exp_slot (i32.load (call $abs (i32.add (local.get $entry) (i32.const 12)))))
    (if (i32.eq (local.get $exp_slot) (i32.const 0xFFFFFFFF))
      (then (return (i32.const 2))))
    (if (local.get $exp_slot)
      (then
        (if (call $expression_walk_guard (i32.const 0))
          (then (return (i32.const 1))))
        (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_POWER)
          (local.get $base_slot) (local.get $exp_slot) (local.get $dest_slot))
        (return (i32.const 0))))
    (local.set $exponent (call $staged_entry_exponent (local.get $entry)))
    (call $build_power_i64 (local.get $base_slot) (local.get $exponent) (local.get $dest_slot))
  )

  ;; Degree of a canonical polynomial tree in atom v. Returns the
  ;; degree (≥ 0) or -1 pressure, -2 unsupported, -3 negative exponent.
  ;; $stage / $residual_tmp are caller-owned committed scratch.
  (func $poly_degree_in
    (param $poly_slot i32) (param $v_slot i32)
    (param $stage i32) (param $stage_capacity i32)
    (param $residual_tmp i32)
    (result i64)
    (local $terms_data i32)
    (local $terms_count i32)
    (local $i i32)
    (local $status i32)
    (local $degree i64)
    (call $sum_term_list (local.get $poly_slot))
    (local.set $terms_data (global.get $sum_terms_data))
    (local.set $terms_count (global.get $sum_terms_count))
    (local.set $degree (i64.const 0))
    (local.set $i (i32.const 0))
    (block $done
      (loop $walk
        (br_if $done (i32.ge_u (local.get $i) (local.get $terms_count)))
        (local.set $status (call $term_split_by_atom
          (i32.add (local.get $terms_data) (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
          (local.get $v_slot) (local.get $stage) (local.get $stage_capacity)
          (local.get $residual_tmp)))
        (if (local.get $status)
          (then (return (i64.sub (i64.const 0) (i64.extend_i32_s (local.get $status))))))
        (if (i64.gt_s (global.get $bigint_to_i64_value) (local.get $degree))
          (then (local.set $degree (global.get $bigint_to_i64_value))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $walk)
      )
    )
    (local.get $degree)
  )

  ;; Extract a canonical polynomial tree into a coefficient list:
  ;; $dest_list holds (degree_cap + 1) value slots (caller-carved),
  ;; index = v-exponent. Coefficients accumulate through simplified
  ;; Adds. Returns 0 ok / 1 pressure / 2 unsupported / 3 negative.
  (func $poly_extract_coefficients
    (param $poly_slot i32) (param $v_slot i32) (param $degree_cap i32)
    (param $dest_list i32) (param $stage i32) (param $stage_capacity i32)
    (param $residual_tmp i32)
    (result i32)
    (local $terms_data i32)
    (local $terms_count i32)
    (local $i i32)
    (local $status i32)
    (local $exponent i64)
    (local $coeff_slot i32)
    (local.set $i (i32.const 0))
    (block $zero_done
      (loop $zero
        (br_if $zero_done (i32.gt_u (local.get $i) (local.get $degree_cap)))
        (call $write_inline_rational
          (i32.add (local.get $dest_list) (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
          (i64.const 0))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $zero)
      )
    )
    (call $sum_term_list (local.get $poly_slot))
    (local.set $terms_data (global.get $sum_terms_data))
    (local.set $terms_count (global.get $sum_terms_count))
    (local.set $i (i32.const 0))
    (block $done
      (loop $walk
        (br_if $done (i32.ge_u (local.get $i) (local.get $terms_count)))
        (local.set $status (call $term_split_by_atom
          (i32.add (local.get $terms_data) (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
          (local.get $v_slot) (local.get $stage) (local.get $stage_capacity)
          (local.get $residual_tmp)))
        (if (local.get $status)
          (then (return (local.get $status))))
        (local.set $exponent (global.get $bigint_to_i64_value))
        (if (i64.gt_s (local.get $exponent) (i64.extend_i32_u (local.get $degree_cap)))
          (then (return (i32.const 2))))
        (local.set $coeff_slot (i32.add (local.get $dest_list)
          (i32.mul (i32.wrap_i64 (local.get $exponent)) (global.get $VALUE_SIZE))))
        (if (call $expression_value_is_zero_wide (local.get $coeff_slot))
          (then
            (memory.copy (call $abs (local.get $coeff_slot))
              (call $abs (local.get $residual_tmp)) (global.get $VALUE_SIZE)))
          (else
            (local.set $status (call $build_simplified2
              (global.get $BUILTIN_EXPRESSION_HEAD_ADD)
              (local.get $coeff_slot) (local.get $residual_tmp) (local.get $coeff_slot)))
            (if (local.get $status)
              (then (return (local.get $status))))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $walk)
      )
    )
    (i32.const 0)
  )

  ;; Highest index with a non-zero coefficient (or -1 for the zero
  ;; polynomial).
  (func $coefficient_list_degree (param $list i32) (param $cap i32) (result i32)
    (local $i i32)
    (local.set $i (local.get $cap))
    (block $done
      (loop $scan
        (br_if $done (i32.lt_s (local.get $i) (i32.const 0)))
        (if (i32.eqz (call $expression_value_is_zero_wide
              (i32.add (local.get $list) (i32.mul (local.get $i) (global.get $VALUE_SIZE)))))
          (then (return (local.get $i))))
        (local.set $i (i32.sub (local.get $i) (i32.const 1)))
        (br $scan)
      )
    )
    (i32.const -1)
  )

  ;; Rebuild Σ list[i]·v^i into dest. Terms emitted in descending i
  ;; (canonical univariate order). $simplify_top = 0 keeps the grouped
  ;; RAW form (collect's contract — simplify would re-distribute);
  ;; 1 canonicalizes. Returns walk status.
  (func $poly_from_coefficient_list
    (param $list i32) (param $degree i32) (param $v_slot i32)
    (param $dest_slot i32) (param $simplify_top i32)
    (result i32)
    (local $nonzero i32)
    (local $i i32)
    (local $coeff_slot i32)
    (local $args_array i32)
    (local $args_data i32)
    (local $data_size i32)
    (local $aligned i32)
    (local $dest_cursor i32)
    (local $power_tmp i32)
    (local $status i32)
    (local $new_expression i32)

    ;; Count surviving terms.
    (local.set $i (i32.const 0))
    (block $count_done
      (loop $count
        (br_if $count_done (i32.gt_s (local.get $i) (local.get $degree)))
        (if (i32.eqz (call $expression_value_is_zero_wide
              (i32.add (local.get $list) (i32.mul (local.get $i) (global.get $VALUE_SIZE)))))
          (then (local.set $nonzero (i32.add (local.get $nonzero) (i32.const 1)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $count)
      )
    )
    (if (i32.eqz (local.get $nonzero))
      (then
        (call $expression_write_zero (local.get $dest_slot))
        (return (i32.const 0))))

    (local.set $data_size (i32.add (global.get $GC_HEADER_SIZE)
      (i32.mul (local.get $nonzero) (global.get $VALUE_SIZE))))
    (local.set $aligned (i32.and
      (i32.add (local.get $data_size) (i32.const 15)) (i32.const -16)))
    (if (call $expression_walk_guard
          (i32.add (local.get $aligned)
            (i32.add (i32.mul (local.get $nonzero) (i32.const 128)) (i32.const 32))))
      (then (return (i32.const 1))))
    (local.set $power_tmp (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (local.set $args_array (call $read_state (global.get $STATE_HEAP_POINTER)))
    (local.set $args_data (call $write_array_header
      (local.get $args_array) (local.get $nonzero) (local.get $nonzero)
      (local.get $aligned)))
    (call $write_state (global.get $STATE_HEAP_POINTER)
      (i32.add (local.get $args_data) (local.get $aligned)))

    (local.set $dest_cursor (i32.add (local.get $args_data) (global.get $GC_HEADER_SIZE)))
    (local.set $i (local.get $degree))
    (block $emit_done
      (loop $emit
        (br_if $emit_done (i32.lt_s (local.get $i) (i32.const 0)))
        (local.set $coeff_slot (i32.add (local.get $list)
          (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
        (if (i32.eqz (call $expression_value_is_zero_wide (local.get $coeff_slot)))
          (then
            (if (i32.eqz (local.get $i))
              (then
                ;; Constant term: the coefficient itself.
                (memory.copy (call $abs (local.get $dest_cursor))
                  (call $abs (local.get $coeff_slot)) (global.get $VALUE_SIZE)))
              (else
                (local.set $status (call $build_power_i64
                  (local.get $v_slot) (i64.extend_i32_s (local.get $i))
                  (local.get $power_tmp)))
                (if (local.get $status) (then (return (local.get $status))))
                (if (call $expression_value_is_one_wide (local.get $coeff_slot))
                  (then
                    (memory.copy (call $abs (local.get $dest_cursor))
                      (call $abs (local.get $power_tmp)) (global.get $VALUE_SIZE)))
                  (else
                    (if (call $expression_walk_guard (i32.const 0))
                      (then (return (i32.const 1))))
                    (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
                      (local.get $coeff_slot) (local.get $power_tmp)
                      (local.get $dest_cursor))))))
            (local.set $dest_cursor (i32.add (local.get $dest_cursor) (global.get $VALUE_SIZE)))))
        (local.set $i (i32.sub (local.get $i) (i32.const 1)))
        (br $emit)
      )
    )

    (if (i32.eq (local.get $nonzero) (i32.const 1))
      (then
        (memory.copy (call $abs (local.get $dest_slot))
          (call $abs (i32.add (local.get $args_data) (global.get $GC_HEADER_SIZE)))
          (global.get $VALUE_SIZE)))
      (else
        (local.set $new_expression (call $expression_build
          (call $symbol_registry_lookup
            (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_ADD)))
          (local.get $args_array)))
        (i32.store (call $abs (local.get $dest_slot)) (global.get $TYPE_EXPRESSION))
        (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 4))) (i32.const 0))
        (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 8)))
          (local.get $new_expression))
        (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 12))) (i32.const 0))))
    (if (local.get $simplify_top)
      (then (return (call $expression_simplify_into
        (local.get $dest_slot) (local.get $dest_slot)))))
    (i32.const 0)
  )

  ;; Is this numeric slot integer-valued (denominators of 1 throughout)?
  (func $numeric_slot_is_integer (param $slot i32) (result i32)
    (local $type i32)
    (local $header i32)
    (local.set $type (call $value_type (local.get $slot)))
    (if (i32.eq (local.get $type) (global.get $TYPE_BIGINT))
      (then (return (i32.const 1))))
    (if (i32.eq (local.get $type) (global.get $TYPE_RATIONAL))
      (then
        (if (call $rational_is_inline (local.get $slot))
          (then (return (i32.const 1))))
        (return (call $bigint_is_one (call $rational_denominator
          (call $value_data_lo (local.get $slot)))))))
    (if (i32.eq (local.get $type) (global.get $TYPE_COMPLEX))
      (then
        (local.set $header (call $value_data_lo (local.get $slot)))
        (return (i32.and
          (call $bigint_is_one (call $rational_denominator
            (call $complex_real (local.get $header))))
          (call $bigint_is_one (call $rational_denominator
            (call $complex_imaginary (local.get $header))))))))
    (i32.const 0)
  )

  ;; Nearest integer of a Rational header as a BigInt: floor((2n+d)/(2d)).
  (func $rational_nearest_bigint (param $header i32) (result i32)
    (local $numerator i32)
    (local $denominator i32)
    (local $t i32)
    (local $two_d i32)
    (local $quotient i32)
    (local $remainder i32)
    (local.set $numerator (call $rational_numerator (local.get $header)))
    (local.set $denominator (call $rational_denominator (local.get $header)))
    (local.set $t (call $bigint_add
      (call $bigint_add (local.get $numerator) (local.get $numerator))
      (local.get $denominator)))
    (local.set $two_d (call $bigint_add (local.get $denominator) (local.get $denominator)))
    (local.set $quotient (call $bigint_div (local.get $t) (local.get $two_d)))
    (local.set $remainder (call $bigint_last_remainder))
    ;; bigint_div truncates toward zero; floor needs one less for a
    ;; negative dividend with a non-zero remainder.
    (if (i32.and
          (i32.ne (call $bigint_length (local.get $remainder)) (i32.const 0))
          (i32.ne (call $bigint_sign (local.get $t)) (i32.const 0)))
      (then (local.set $quotient (call $bigint_sub
        (local.get $quotient) (call $bigint_one)))))
    (local.get $quotient)
  )

  ;; Is this Complex header exactly zero?
  (func $complex_header_is_zero (param $header i32) (result i32)
    (i32.and
      (i32.eqz (call $bigint_length
        (call $rational_numerator (call $complex_real (local.get $header)))))
      (i32.eqz (call $bigint_length
        (call $rational_numerator (call $complex_imaginary (local.get $header))))))
  )

  ;; GCD of two exact numeric slots per the 3c coefficient-ring table:
  ;; rational/bigint pairs use gcd(n1,n2)/lcm(d1,d2); Gaussian-integer
  ;; pairs run Euclid in Z[i]; any other Complex pair is conservative 1.
  ;; gcd(x, 0) = |x| (real) / x (complex). Returns walk status.
  (func $exact_numeric_gcd (param $a_slot i32) (param $b_slot i32) (param $dest_slot i32) (result i32)
    (local $a_zero i32)
    (local $b_zero i32)
    (local $has_complex i32)
    (local $z1 i32)
    (local $z2 i32)
    (local $q i32)
    (local $r i32)
    (local $a_rational i32)
    (local $b_rational i32)
    (local $g_numerator i32)
    (local $l_denominator i32)
    (local $den_gcd i32)
    (local $result i32)

    (local.set $a_zero (call $expression_value_is_zero_wide (local.get $a_slot)))
    (local.set $b_zero (call $expression_value_is_zero_wide (local.get $b_slot)))
    (if (i32.and (local.get $a_zero) (local.get $b_zero))
      (then
        (call $expression_write_zero (local.get $dest_slot))
        (return (i32.const 0))))
    (if (call $expression_walk_guard
          (call $estimate_cross_type_arith_budget (local.get $a_slot) (local.get $b_slot)))
      (then (return (i32.const 1))))
    (if (local.get $a_zero)
      (then (return (call $numeric_gcd_normalize_copy
        (local.get $b_slot) (local.get $dest_slot)))))
    (if (local.get $b_zero)
      (then (return (call $numeric_gcd_normalize_copy
        (local.get $a_slot) (local.get $dest_slot)))))

    (local.set $has_complex (i32.or
      (i32.eq (call $value_type (local.get $a_slot)) (global.get $TYPE_COMPLEX))
      (i32.eq (call $value_type (local.get $b_slot)) (global.get $TYPE_COMPLEX))))
    (if (local.get $has_complex)
      (then
        ;; Gaussian Euclid only when both are Gaussian integers.
        (if (i32.eqz (i32.and
              (call $numeric_slot_is_integer (local.get $a_slot))
              (call $numeric_slot_is_integer (local.get $b_slot))))
          (then
            (call $write_inline_rational (local.get $dest_slot) (i64.const 1))
            (return (i32.const 0))))
        (if (i32.eq (call $value_type (local.get $a_slot)) (global.get $TYPE_COMPLEX))
          (then (local.set $z1 (call $value_data_lo (local.get $a_slot))))
          (else (local.set $z1 (call $complex_from_rational
            (call $expression_to_rational (local.get $a_slot))))))
        (if (i32.eq (call $value_type (local.get $b_slot)) (global.get $TYPE_COMPLEX))
          (then (local.set $z2 (call $value_data_lo (local.get $b_slot))))
          (else (local.set $z2 (call $complex_from_rational
            (call $expression_to_rational (local.get $b_slot))))))
        (block $euclid_done
          (loop $euclid
            (br_if $euclid_done (call $complex_header_is_zero (local.get $z2)))
            (if (call $expression_walk_guard (i32.const 0))
              (then (return (i32.const 1))))
            (local.set $q (call $complex_div (local.get $z1) (local.get $z2)))
            (local.set $q (call $complex_allocate
              (call $rational_allocate
                (call $rational_nearest_bigint (call $complex_real (local.get $q)))
                (call $bigint_one))
              (call $rational_allocate
                (call $rational_nearest_bigint (call $complex_imaginary (local.get $q)))
                (call $bigint_one))))
            (local.set $r (call $complex_sub (local.get $z1)
              (call $complex_mul (local.get $q) (local.get $z2))))
            (local.set $z1 (local.get $z2))
            (local.set $z2 (local.get $r))
            (br $euclid)
          )
        )
        ;; Sign-normalize by the unit -1 (no i-rotation): negative real
        ;; part — or zero real with negative imaginary — flips, so
        ;; gcd(2+2i, 4) lands at 2+2i rather than its -1 associate.
        (if (i32.or
              (i32.eq (call $bigint_sign
                (call $rational_numerator (call $complex_real (local.get $z1))))
                (i32.const 1))
              (i32.and
                (i32.eqz (call $bigint_length
                  (call $rational_numerator (call $complex_real (local.get $z1)))))
                (i32.eq (call $bigint_sign
                  (call $rational_numerator (call $complex_imaginary (local.get $z1))))
                  (i32.const 1))))
          (then
            (local.set $z1 (call $complex_sub
              (call $complex_from_rational
                (call $rational_allocate (call $bigint_zero) (call $bigint_one)))
              (local.get $z1)))))
        ;; Pure-real Gaussian results realize to a positive Rational.
        (if (i32.eqz (call $bigint_length
              (call $rational_numerator (call $complex_imaginary (local.get $z1)))))
          (then
            (local.set $result (call $rational_allocate
              (call $bigint_abs_copy
                (call $rational_numerator (call $complex_real (local.get $z1))))
              (call $bigint_one)))
            (i32.store (call $abs (local.get $dest_slot)) (global.get $TYPE_RATIONAL))
            (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 4))) (i32.const 0))
            (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 8)))
              (local.get $result))
            (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 12))) (i32.const 0))
            (return (i32.const 0))))
        ;; Pure-imaginary UNIT results (±i) normalize to 1: a unit gcd
        ;; carries no common factor, and returning i here fed the 3d
        ;; Divide cancellation a divisor it could divide out forever —
        ;; a non-convergent rewrite loop that presented as permanent
        ;; memory pressure (Divide(1, i)) or worse (found by Ring 4d's
        ;; complex matrix inverse). The pure-real branch above already
        ;; realizes ±1 to 1; this is its imaginary-axis mirror. Non-unit
        ;; results (2+2i) still keep their orientation — the no-i-
        ;; rotation decision (Q6) is about associates of PROPER factors.
        (if (i32.and
              (i32.eqz (call $bigint_length
                (call $rational_numerator (call $complex_real (local.get $z1)))))
              (i32.and
                (i32.and
                  (i32.eq (call $bigint_length
                    (call $rational_numerator (call $complex_imaginary (local.get $z1))))
                    (i32.const 1))
                  (i32.eq (call $bigint_limb
                    (call $rational_numerator (call $complex_imaginary (local.get $z1)))
                    (i32.const 0))
                    (i32.const 1)))
                (i32.and
                  (i32.eq (call $bigint_length
                    (call $rational_denominator (call $complex_imaginary (local.get $z1))))
                    (i32.const 1))
                  (i32.eq (call $bigint_limb
                    (call $rational_denominator (call $complex_imaginary (local.get $z1)))
                    (i32.const 0))
                    (i32.const 1)))))
          (then
            (call $write_inline_rational (local.get $dest_slot) (i64.const 1))
            (return (i32.const 0))))
        (i32.store (call $abs (local.get $dest_slot)) (global.get $TYPE_COMPLEX))
        (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 4))) (i32.const 0))
        (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 8))) (local.get $z1))
        (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 12))) (i32.const 0))
        (return (i32.const 0))))

    ;; Rational / BigInt pair: gcd(n1, n2) / lcm(d1, d2).
    (local.set $a_rational (call $expression_to_rational (local.get $a_slot)))
    (local.set $b_rational (call $expression_to_rational (local.get $b_slot)))
    (local.set $g_numerator (call $bigint_gcd
      (call $rational_numerator (local.get $a_rational))
      (call $rational_numerator (local.get $b_rational))))
    (local.set $den_gcd (call $bigint_gcd
      (call $rational_denominator (local.get $a_rational))
      (call $rational_denominator (local.get $b_rational))))
    (local.set $l_denominator (call $bigint_div
      (call $bigint_mul
        (call $rational_denominator (local.get $a_rational))
        (call $rational_denominator (local.get $b_rational)))
      (local.get $den_gcd)))
    (i32.store (call $abs (local.get $dest_slot)) (global.get $TYPE_RATIONAL))
    (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 4))) (i32.const 0))
    (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 8)))
      (call $rational_allocate (local.get $g_numerator) (local.get $l_denominator)))
    (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 12))) (i32.const 0))
    (i32.const 0)
  )

  ;; gcd(x, 0) normalization: reals copy as |x|; Complex copies as-is
  ;; (no unit rotation — Q6).
  (func $numeric_gcd_normalize_copy (param $src_slot i32) (param $dest_slot i32) (result i32)
    (local $rational i32)
    (if (i32.eq (call $value_type (local.get $src_slot)) (global.get $TYPE_COMPLEX))
      (then
        (memory.copy (call $abs (local.get $dest_slot))
          (call $abs (local.get $src_slot)) (global.get $VALUE_SIZE))
        (return (i32.const 0))))
    (local.set $rational (call $expression_to_rational (local.get $src_slot)))
    (i32.store (call $abs (local.get $dest_slot)) (global.get $TYPE_RATIONAL))
    (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 4))) (i32.const 0))
    (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 8)))
      (call $rational_allocate
        (call $bigint_abs_copy (call $rational_numerator (local.get $rational)))
        (call $bigint_abs_copy (call $rational_denominator (local.get $rational)))))
    (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 12))) (i32.const 0))
    (i32.const 0)
  )

  ;; Sum of factor-entry counts over a tree's terms — sizes the staging
  ;; and atom tables. Also tracks the largest single term's factor
  ;; count in $term_factors_count.
  (func $poly_measure_factors (param $poly_slot i32) (result i32)
    (local $terms_data i32)
    (local $terms_count i32)
    (local $i i32)
    (local $total i32)
    (local $largest i32)
    (call $sum_term_list (local.get $poly_slot))
    (local.set $terms_data (global.get $sum_terms_data))
    (local.set $terms_count (global.get $sum_terms_count))
    (local.set $i (i32.const 0))
    (block $done
      (loop $walk
        (br_if $done (i32.ge_u (local.get $i) (local.get $terms_count)))
        (drop (call $term_split
          (i32.add (local.get $terms_data) (i32.mul (local.get $i) (global.get $VALUE_SIZE)))))
        (local.set $total (i32.add (local.get $total)
          (i32.add (global.get $term_factors_count) (i32.const 1))))
        (if (i32.gt_u (global.get $term_factors_count) (local.get $largest))
          (then (local.set $largest (global.get $term_factors_count))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $walk)
      )
    )
    (global.set $term_factors_count (i32.add (local.get $largest) (i32.const 1)))
    (local.get $total)
  )

  ;; Scan a tree's terms and merge their factor atoms into the table at
  ;; $table (16-byte entries: [base_slot_ptr:4][pad:4][maxdeg:8]).
  ;; Numeric bases and slot-carried/sentinel exponents are skipped as
  ;; candidates. Returns the new entry count, or -1 on pressure.
  (func $collect_candidate_atoms
    (param $poly_slot i32) (param $table i32) (param $count i32)
    (param $stage i32) (param $stage_capacity i32)
    (result i32)
    (local $terms_data i32)
    (local $terms_count i32)
    (local $i i32)
    (local $j i32)
    (local $k i32)
    (local $entry i32)
    (local $base_slot i32)
    (local $exponent i64)
    (local $staged i32)
    (local $found i32)
    (call $sum_term_list (local.get $poly_slot))
    (local.set $terms_data (global.get $sum_terms_data))
    (local.set $terms_count (global.get $sum_terms_count))
    (local.set $i (i32.const 0))
    (block $terms_done
      (loop $terms
        (br_if $terms_done (i32.ge_u (local.get $i) (local.get $terms_count)))
        (local.set $staged (call $stage_factor_entries
          (i32.add (local.get $terms_data) (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
          (local.get $stage) (local.get $stage_capacity)))
        (if (global.get $memory_pressure_signaled)
          (then (return (i32.const -1))))
        (local.set $j (i32.const 0))
        (block $entries_done
          (loop $entries
            (br_if $entries_done (i32.ge_u (local.get $j) (local.get $staged)))
            (local.set $entry (i32.add (local.get $stage) (i32.mul (local.get $j) (i32.const 16))))
            (local.set $base_slot (i32.load (call $abs (local.get $entry))))
            ;; Skip numeric bases and non-i64 exponents.
            (if (i32.or
                  (call $expression_slot_is_numeric (local.get $base_slot))
                  (i32.ne (i32.load (call $abs (i32.add (local.get $entry) (i32.const 12))))
                          (i32.const 0)))
              (then
                (local.set $j (i32.add (local.get $j) (i32.const 1)))
                (br $entries)))
            (local.set $exponent (call $staged_entry_exponent (local.get $entry)))
            (if (i64.lt_s (local.get $exponent) (i64.const 0))
              (then (local.set $exponent (i64.sub (i64.const 0) (local.get $exponent)))))
            ;; Merge into the table.
            (local.set $found (i32.const 0))
            (local.set $k (i32.const 0))
            (block $probe_done
              (loop $probe
                (br_if $probe_done (i32.ge_u (local.get $k) (local.get $count)))
                (if (call $expression_values_equal
                      (i32.load (call $abs (i32.add (local.get $table)
                        (i32.mul (local.get $k) (i32.const 16)))))
                      (local.get $base_slot))
                  (then
                    (if (i64.gt_s (local.get $exponent)
                          (i64.load (call $abs (i32.add
                            (i32.add (local.get $table) (i32.mul (local.get $k) (i32.const 16)))
                            (i32.const 8)))))
                      (then (i64.store (call $abs (i32.add
                          (i32.add (local.get $table) (i32.mul (local.get $k) (i32.const 16)))
                          (i32.const 8)))
                        (local.get $exponent))))
                    (local.set $found (i32.const 1))
                    (br $probe_done)))
                (local.set $k (i32.add (local.get $k) (i32.const 1)))
                (br $probe)))
            (if (global.get $memory_pressure_signaled)
              (then (return (i32.const -1))))
            (if (i32.eqz (local.get $found))
              (then
                (i32.store (call $abs (i32.add (local.get $table)
                  (i32.mul (local.get $count) (i32.const 16))))
                  (local.get $base_slot))
                (i64.store (call $abs (i32.add
                  (i32.add (local.get $table) (i32.mul (local.get $count) (i32.const 16)))
                  (i32.const 8)))
                  (local.get $exponent))
                (local.set $count (i32.add (local.get $count) (i32.const 1)))))
            (local.set $j (i32.add (local.get $j) (i32.const 1)))
            (br $entries)
          )
        )
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $terms)
      )
    )
    (local.get $count)
  )

  ;; Choose the main atom: highest degree wins, ties broken by the
  ;; total slot order. $b_slot may be 0 (single-tree callers). Writes
  ;; the winning atom's value into $v_dest. Returns 0 found /
  ;; 1 pressure / 2 no candidates.
  (func $choose_main_atom
    (param $a_slot i32) (param $b_slot i32) (param $v_dest i32)
    (result i32)
    (local $budget i32)
    (local $stage_slots i32)
    (local $table i32)
    (local $stage i32)
    (local $count i32)
    (local $best i32)
    (local $k i32)
    (local $entry i32)
    (local $best_entry i32)
    (local $cmp i32)

    (local.set $budget (call $poly_measure_factors (local.get $a_slot)))
    (local.set $stage_slots (global.get $term_factors_count))
    (if (local.get $b_slot)
      (then
        (local.set $budget (i32.add (local.get $budget)
          (call $poly_measure_factors (local.get $b_slot))))
        (if (i32.gt_u (global.get $term_factors_count) (local.get $stage_slots))
          (then (local.set $stage_slots (global.get $term_factors_count))))))
    (if (call $expression_walk_guard
          (i32.add
            (i32.mul (i32.add (local.get $budget) (local.get $stage_slots)) (i32.const 16))
            (i32.const 48)))
      (then (return (i32.const 1))))
    (local.set $table (call $carve_scratch_blob
      (i32.mul (local.get $budget) (i32.const 16))))
    (local.set $stage (call $carve_scratch_blob
      (i32.mul (local.get $stage_slots) (i32.const 16))))
    (local.set $count (call $collect_candidate_atoms
      (local.get $a_slot) (local.get $table) (i32.const 0)
      (local.get $stage) (local.get $stage_slots)))
    (if (i32.lt_s (local.get $count) (i32.const 0))
      (then (return (i32.const 1))))
    (if (local.get $b_slot)
      (then
        (local.set $count (call $collect_candidate_atoms
          (local.get $b_slot) (local.get $table) (local.get $count)
          (local.get $stage) (local.get $stage_slots)))
        (if (i32.lt_s (local.get $count) (i32.const 0))
          (then (return (i32.const 1))))))
    (if (i32.eqz (local.get $count))
      (then (return (i32.const 2))))
    (local.set $best (i32.const 0))
    (local.set $k (i32.const 1))
    (block $pick_done
      (loop $pick
        (br_if $pick_done (i32.ge_u (local.get $k) (local.get $count)))
        (local.set $entry (i32.add (local.get $table) (i32.mul (local.get $k) (i32.const 16))))
        (local.set $best_entry (i32.add (local.get $table) (i32.mul (local.get $best) (i32.const 16))))
        (if (i64.gt_s
              (i64.load (call $abs (i32.add (local.get $entry) (i32.const 8))))
              (i64.load (call $abs (i32.add (local.get $best_entry) (i32.const 8)))))
          (then (local.set $best (local.get $k)))
          (else
            (if (i64.eq
                  (i64.load (call $abs (i32.add (local.get $entry) (i32.const 8))))
                  (i64.load (call $abs (i32.add (local.get $best_entry) (i32.const 8)))))
              (then
                (local.set $cmp (call $expression_compare_slots
                  (i32.load (call $abs (local.get $entry)))
                  (i32.load (call $abs (local.get $best_entry)))))
                (if (i32.lt_s (local.get $cmp) (i32.const 0))
                  (then (local.set $best (local.get $k))))))))
        (local.set $k (i32.add (local.get $k) (i32.const 1)))
        (br $pick)
      )
    )
    (memory.copy (call $abs (local.get $v_dest))
      (call $abs (i32.load (call $abs (i32.add (local.get $table)
        (i32.mul (local.get $best) (i32.const 16))))))
      (global.get $VALUE_SIZE))
    (i32.const 0)
  )

  ;; Field-style polynomial division in main atom v, on coefficient
  ;; lists. Coefficient division: exact_mode 0 builds Divide trees
  ;; (numerics fold exactly; symbolic leads become rational-function
  ;; coefficients); exact_mode 1 recurses through $poly_exact_divide
  ;; (contents/primitive parts — mathematically exact). Writes the
  ;; simplified quotient and remainder trees. Returns 0 ok / 1
  ;; pressure / 2 unsupported / 3 negative exponent.
  (func $poly_field_divide
    (param $a_slot i32) (param $b_slot i32) (param $v_slot i32)
    (param $q_dest i32) (param $r_dest i32) (param $exact_mode i32)
    (result i32)
    (local $stage_slots i32)
    (local $stage i32)
    (local $residual_tmp i32)
    (local $da i64)
    (local $db i64)
    (local $da32 i32)
    (local $db32 i32)
    (local $r_list i32)
    (local $b_list i32)
    (local $q_list i32)
    (local $status i32)
    (local $dr i32)
    (local $delta i32)
    (local $i i32)
    (local $t_slot i32)
    (local $work i32)

    ;; Staging sized to the largest term in either input.
    (drop (call $poly_measure_factors (local.get $a_slot)))
    (local.set $stage_slots (global.get $term_factors_count))
    (drop (call $poly_measure_factors (local.get $b_slot)))
    (if (i32.gt_u (global.get $term_factors_count) (local.get $stage_slots))
      (then (local.set $stage_slots (global.get $term_factors_count))))
    (if (call $expression_walk_guard
          (i32.add (i32.mul (local.get $stage_slots) (i32.const 16)) (i32.const 96)))
      (then (return (i32.const 1))))
    (local.set $stage (call $carve_scratch_blob
      (i32.mul (local.get $stage_slots) (i32.const 16))))
    (local.set $residual_tmp (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (local.set $t_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (local.set $work (call $carve_scratch_blob (global.get $VALUE_SIZE)))

    (local.set $da (call $poly_degree_in
      (local.get $a_slot) (local.get $v_slot) (local.get $stage)
      (local.get $stage_slots) (local.get $residual_tmp)))
    (if (i64.lt_s (local.get $da) (i64.const 0))
      (then (return (i32.wrap_i64 (i64.sub (i64.const 0) (local.get $da))))))
    (local.set $db (call $poly_degree_in
      (local.get $b_slot) (local.get $v_slot) (local.get $stage)
      (local.get $stage_slots) (local.get $residual_tmp)))
    (if (i64.lt_s (local.get $db) (i64.const 0))
      (then (return (i32.wrap_i64 (i64.sub (i64.const 0) (local.get $db))))))
    (if (i32.or
          (i64.gt_s (local.get $da) (i64.const 1048576))
          (i64.gt_s (local.get $db) (i64.const 1048576)))
      (then (return (i32.const 2))))
    (local.set $da32 (i32.wrap_i64 (local.get $da)))
    (local.set $db32 (i32.wrap_i64 (local.get $db)))

    (if (call $expression_walk_guard
          (i32.add
            (i32.mul (i32.add (i32.mul (local.get $da32) (i32.const 2))
              (i32.add (local.get $db32) (i32.const 3)))
              (global.get $VALUE_SIZE))
            (i32.const 96)))
      (then (return (i32.const 1))))
    (local.set $r_list (call $carve_scratch_blob
      (i32.mul (i32.add (local.get $da32) (i32.const 1)) (global.get $VALUE_SIZE))))
    (local.set $b_list (call $carve_scratch_blob
      (i32.mul (i32.add (local.get $db32) (i32.const 1)) (global.get $VALUE_SIZE))))
    (local.set $q_list (call $carve_scratch_blob
      (i32.mul (i32.add (local.get $da32) (i32.const 1)) (global.get $VALUE_SIZE))))

    (local.set $status (call $poly_extract_coefficients
      (local.get $a_slot) (local.get $v_slot) (local.get $da32)
      (local.get $r_list) (local.get $stage) (local.get $stage_slots)
      (local.get $residual_tmp)))
    (if (local.get $status) (then (return (local.get $status))))
    (local.set $status (call $poly_extract_coefficients
      (local.get $b_slot) (local.get $v_slot) (local.get $db32)
      (local.get $b_list) (local.get $stage) (local.get $stage_slots)
      (local.get $residual_tmp)))
    (if (local.get $status) (then (return (local.get $status))))
    (local.set $i (i32.const 0))
    (block $q_zero_done
      (loop $q_zero
        (br_if $q_zero_done (i32.gt_u (local.get $i) (local.get $da32)))
        (call $write_inline_rational
          (i32.add (local.get $q_list) (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
          (i64.const 0))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $q_zero)
      )
    )

    ;; Long division.
    (block $divide_done
      (loop $divide
        (local.set $dr (call $coefficient_list_degree (local.get $r_list) (local.get $da32)))
        (br_if $divide_done (i32.lt_s (local.get $dr) (local.get $db32)))
        (br_if $divide_done (i32.lt_s (local.get $dr) (i32.const 0)))
        (local.set $delta (i32.sub (local.get $dr) (local.get $db32)))
        ;; t = lead(r) / lead(b)
        (if (local.get $exact_mode)
          (then (local.set $status (call $poly_exact_divide
            (i32.add (local.get $r_list) (i32.mul (local.get $dr) (global.get $VALUE_SIZE)))
            (i32.add (local.get $b_list) (i32.mul (local.get $db32) (global.get $VALUE_SIZE)))
            (local.get $t_slot))))
          (else (local.set $status (call $build_simplified2
            (global.get $BUILTIN_EXPRESSION_HEAD_DIVIDE)
            (i32.add (local.get $r_list) (i32.mul (local.get $dr) (global.get $VALUE_SIZE)))
            (i32.add (local.get $b_list) (i32.mul (local.get $db32) (global.get $VALUE_SIZE)))
            (local.get $t_slot)))))
        (if (local.get $status) (then (return (local.get $status))))
        (memory.copy
          (call $abs (i32.add (local.get $q_list)
            (i32.mul (local.get $delta) (global.get $VALUE_SIZE))))
          (call $abs (local.get $t_slot))
          (global.get $VALUE_SIZE))
        ;; r[delta + i] -= t · b[i] for i < db; the lead cancels exactly.
        (local.set $i (i32.const 0))
        (block $step_done
          (loop $step
            (br_if $step_done (i32.ge_s (local.get $i) (local.get $db32)))
            (local.set $status (call $build_simplified2
              (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
              (local.get $t_slot)
              (i32.add (local.get $b_list) (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
              (local.get $work)))
            (if (local.get $status) (then (return (local.get $status))))
            (local.set $status (call $build_simplified2
              (global.get $BUILTIN_EXPRESSION_HEAD_SUBTRACT)
              (i32.add (local.get $r_list)
                (i32.mul (i32.add (local.get $delta) (local.get $i)) (global.get $VALUE_SIZE)))
              (local.get $work)
              (i32.add (local.get $r_list)
                (i32.mul (i32.add (local.get $delta) (local.get $i)) (global.get $VALUE_SIZE)))))
            (if (local.get $status) (then (return (local.get $status))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $step)
          )
        )
        (call $write_inline_rational
          (i32.add (local.get $r_list) (i32.mul (local.get $dr) (global.get $VALUE_SIZE)))
          (i64.const 0))
        (br $divide)
      )
    )

    (local.set $status (call $poly_from_coefficient_list
      (local.get $q_list) (local.get $da32) (local.get $v_slot)
      (local.get $q_dest) (i32.const 1)))
    (if (local.get $status) (then (return (local.get $status))))
    (call $poly_from_coefficient_list
      (local.get $r_list) (local.get $da32) (local.get $v_slot)
      (local.get $r_dest) (i32.const 1))
  )

  ;; Exact division of one tree by another (the divisor is known to
  ;; divide the dividend — content / primitive-part paths). Numeric
  ;; pairs fold through Divide; otherwise recurse via field division
  ;; in the divisor's main atom with exact coefficient division.
  (func $poly_exact_divide
    (param $c_slot i32) (param $g_slot i32) (param $dest_slot i32)
    (result i32)
    (local $v_slot i32)
    (local $r_tmp i32)
    (local $status i32)
    (local $reciprocal i32)
    (local $one_slot i32)
    (local $cap_state i32)
    (if (call $expression_value_is_one_wide (local.get $g_slot))
      (then
        (memory.copy (call $abs (local.get $dest_slot))
          (call $abs (local.get $c_slot)) (global.get $VALUE_SIZE))
        (return (i32.const 0))))
    (if (i32.and
          (call $expression_slot_is_numeric (local.get $c_slot))
          (call $expression_slot_is_numeric (local.get $g_slot)))
      (then (return (call $build_simplified2
        (global.get $BUILTIN_EXPRESSION_HEAD_DIVIDE)
        (local.get $c_slot) (local.get $g_slot) (local.get $dest_slot)))))
    ;; Numeric divisor with a symbolic dividend: multiply by the exact
    ;; reciprocal. (A Divide tree here would desugar straight back into
    ;; the 3d cancellation hook, whose exact-divide is this function —
    ;; an unbounded mutual recursion.) The rescale runs cap-free: it
    ;; never changes the term count.
    (if (call $expression_slot_is_numeric (local.get $g_slot))
      (then
        (if (call $expression_walk_guard (i32.const 48))
          (then (return (i32.const 1))))
        (local.set $reciprocal (call $carve_scratch_blob
          (i32.mul (i32.const 2) (global.get $VALUE_SIZE))))
        (local.set $one_slot (i32.add (local.get $reciprocal) (global.get $VALUE_SIZE)))
        (call $write_inline_rational (local.get $one_slot) (i64.const 1))
        (local.set $status (call $build_simplified2
          (global.get $BUILTIN_EXPRESSION_HEAD_DIVIDE)
          (local.get $one_slot) (local.get $g_slot) (local.get $reciprocal)))
        (if (local.get $status) (then (return (local.get $status))))
        (local.set $cap_state (global.get $expansion_cap_disabled))
        (global.set $expansion_cap_disabled (i32.const 1))
        (local.set $status (call $build_simplified2
          (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
          (local.get $c_slot) (local.get $reciprocal) (local.get $dest_slot)))
        (global.set $expansion_cap_disabled (local.get $cap_state))
        (return (local.get $status))))
    (if (call $expression_walk_guard (i32.const 32))
      (then (return (i32.const 1))))
    (local.set $v_slot (call $carve_scratch_blob
      (i32.mul (i32.const 2) (global.get $VALUE_SIZE))))
    (local.set $r_tmp (i32.add (local.get $v_slot) (global.get $VALUE_SIZE)))
    (local.set $status (call $choose_main_atom
      (local.get $g_slot) (i32.const 0) (local.get $v_slot)))
    (if (i32.eq (local.get $status) (i32.const 1))
      (then (return (i32.const 1))))
    (if (i32.eq (local.get $status) (i32.const 2))
      (then
        ;; No atoms in g (numeric-only after all): plain divide.
        (return (call $build_simplified2
          (global.get $BUILTIN_EXPRESSION_HEAD_DIVIDE)
          (local.get $c_slot) (local.get $g_slot) (local.get $dest_slot)))))
    (call $poly_field_divide
      (local.get $c_slot) (local.get $g_slot) (local.get $v_slot)
      (local.get $dest_slot) (local.get $r_tmp) (i32.const 1))
  )

  ;; Semantic polynomial GCD over canonical simplified trees. Result is
  ;; primitive-recursive standard form (numeric content handled by the
  ;; recursion's numeric leaves); the API wrapper applies the final
  ;; sign/content normalization. Unsupported shapes return the
  ;; conservative 1. Returns walk status (0 ok / 1 pressure).
  (func $poly_gcd_semantic
    (param $a_slot i32) (param $b_slot i32) (param $dest_slot i32)
    (result i32)
    (local $v_slot i32)
    (local $residual_tmp i32)
    (local $stage_slots i32)
    (local $stage i32)
    (local $da i64)
    (local $db i64)
    (local $da32 i32)
    (local $db32 i32)
    (local $swap i32)
    (local $a_list i32)
    (local $b_list i32)
    (local $work_list i32)
    (local $cont_a i32)
    (local $cont_b i32)
    (local $d_slot i32)
    (local $status i32)
    (local $i i32)
    (local $dw i32)
    (local $delta i32)
    (local $lead_w i32)
    (local $lead_b i32)
    (local $t1 i32)
    (local $g_tree i32)

    ;; Trivial and numeric leaves.
    (if (call $expression_value_is_zero_wide (local.get $a_slot))
      (then
        (memory.copy (call $abs (local.get $dest_slot))
          (call $abs (local.get $b_slot)) (global.get $VALUE_SIZE))
        (return (i32.const 0))))
    (if (call $expression_value_is_zero_wide (local.get $b_slot))
      (then
        (memory.copy (call $abs (local.get $dest_slot))
          (call $abs (local.get $a_slot)) (global.get $VALUE_SIZE))
        (return (i32.const 0))))
    (if (i32.and
          (call $expression_slot_is_numeric (local.get $a_slot))
          (call $expression_slot_is_numeric (local.get $b_slot)))
      (then (return (call $exact_numeric_gcd
        (local.get $a_slot) (local.get $b_slot) (local.get $dest_slot)))))

    (if (call $expression_walk_guard (i32.const 160))
      (then (return (i32.const 1))))
    (local.set $v_slot (call $carve_scratch_blob
      (i32.mul (i32.const 8) (global.get $VALUE_SIZE))))
    (local.set $residual_tmp (i32.add (local.get $v_slot) (global.get $VALUE_SIZE)))
    (local.set $cont_a (i32.add (local.get $residual_tmp) (global.get $VALUE_SIZE)))
    (local.set $cont_b (i32.add (local.get $cont_a) (global.get $VALUE_SIZE)))
    (local.set $d_slot (i32.add (local.get $cont_b) (global.get $VALUE_SIZE)))
    (local.set $lead_w (i32.add (local.get $d_slot) (global.get $VALUE_SIZE)))
    (local.set $t1 (i32.add (local.get $lead_w) (global.get $VALUE_SIZE)))
    (local.set $g_tree (i32.add (local.get $t1) (global.get $VALUE_SIZE)))

    (local.set $status (call $choose_main_atom
      (local.get $a_slot) (local.get $b_slot) (local.get $v_slot)))
    (if (i32.eq (local.get $status) (i32.const 1))
      (then (return (i32.const 1))))
    (if (i32.eq (local.get $status) (i32.const 2))
      (then
        ;; No workable atoms (opaque towers): conservative 1.
        (call $write_inline_rational (local.get $dest_slot) (i64.const 1))
        (return (i32.const 0))))

    ;; Staging for extraction.
    (drop (call $poly_measure_factors (local.get $a_slot)))
    (local.set $stage_slots (global.get $term_factors_count))
    (drop (call $poly_measure_factors (local.get $b_slot)))
    (if (i32.gt_u (global.get $term_factors_count) (local.get $stage_slots))
      (then (local.set $stage_slots (global.get $term_factors_count))))
    (if (call $expression_walk_guard
          (i32.add (i32.mul (local.get $stage_slots) (i32.const 16)) (i32.const 32)))
      (then (return (i32.const 1))))
    (local.set $stage (call $carve_scratch_blob
      (i32.mul (local.get $stage_slots) (i32.const 16))))

    (local.set $da (call $poly_degree_in
      (local.get $a_slot) (local.get $v_slot) (local.get $stage)
      (local.get $stage_slots) (local.get $residual_tmp)))
    (local.set $db (call $poly_degree_in
      (local.get $b_slot) (local.get $v_slot) (local.get $stage)
      (local.get $stage_slots) (local.get $residual_tmp)))
    ;; Unsupported shapes: conservative 1.
    (if (i32.or (i64.lt_s (local.get $da) (i64.const 0))
                (i64.lt_s (local.get $db) (i64.const 0)))
      (then
        (if (i32.or (i64.eq (local.get $da) (i64.const -1))
                    (i64.eq (local.get $db) (i64.const -1)))
          (then (return (i32.const 1))))
        (call $write_inline_rational (local.get $dest_slot) (i64.const 1))
        (return (i32.const 0))))
    (if (i32.or
          (i64.gt_s (local.get $da) (i64.const 1024))
          (i64.gt_s (local.get $db) (i64.const 1024)))
      (then
        (call $write_inline_rational (local.get $dest_slot) (i64.const 1))
        (return (i32.const 0))))

    ;; Ensure deg(a) ≥ deg(b) by swapping the TREES.
    (if (i64.lt_s (local.get $da) (local.get $db))
      (then
        (local.set $swap (local.get $a_slot))
        (local.set $a_slot (local.get $b_slot))
        (local.set $b_slot (local.get $swap))
        (local.set $da (local.get $db))
        (local.set $db (call $poly_degree_in
          (local.get $b_slot) (local.get $v_slot) (local.get $stage)
          (local.get $stage_slots) (local.get $residual_tmp)))))
    (local.set $da32 (i32.wrap_i64 (local.get $da)))
    (local.set $db32 (i32.wrap_i64 (local.get $db)))

    ;; deg(b) == 0: gcd(a, b) = gcd(content_v(a), b).
    (if (i32.eqz (local.get $db32))
      (then
        (if (call $expression_walk_guard
              (i32.mul (i32.add (local.get $da32) (i32.const 1)) (global.get $VALUE_SIZE)))
          (then (return (i32.const 1))))
        (local.set $a_list (call $carve_scratch_blob
          (i32.mul (i32.add (local.get $da32) (i32.const 1)) (global.get $VALUE_SIZE))))
        (local.set $status (call $poly_extract_coefficients
          (local.get $a_slot) (local.get $v_slot) (local.get $da32)
          (local.get $a_list) (local.get $stage) (local.get $stage_slots)
          (local.get $residual_tmp)))
        (if (local.get $status)
          (then
            (if (i32.eq (local.get $status) (i32.const 1))
              (then (return (i32.const 1))))
            (call $write_inline_rational (local.get $dest_slot) (i64.const 1))
            (return (i32.const 0))))
        (local.set $status (call $coefficient_list_content
          (local.get $a_list) (local.get $da32) (local.get $cont_a)))
        (if (local.get $status) (then (return (local.get $status))))
        (return (call $poly_gcd_semantic
          (local.get $cont_a) (local.get $b_slot) (local.get $dest_slot)))))

    ;; Extract both lists (b's fits in a cap of da too).
    (if (call $expression_walk_guard
          (i32.mul (i32.mul (i32.add (local.get $da32) (i32.const 1)) (i32.const 3))
            (global.get $VALUE_SIZE)))
      (then (return (i32.const 1))))
    (local.set $a_list (call $carve_scratch_blob
      (i32.mul (i32.add (local.get $da32) (i32.const 1)) (global.get $VALUE_SIZE))))
    (local.set $b_list (call $carve_scratch_blob
      (i32.mul (i32.add (local.get $da32) (i32.const 1)) (global.get $VALUE_SIZE))))
    (local.set $work_list (call $carve_scratch_blob
      (i32.mul (i32.add (local.get $da32) (i32.const 1)) (global.get $VALUE_SIZE))))
    (local.set $status (call $poly_extract_coefficients
      (local.get $a_slot) (local.get $v_slot) (local.get $da32)
      (local.get $a_list) (local.get $stage) (local.get $stage_slots)
      (local.get $residual_tmp)))
    (if (local.get $status)
      (then
        (if (i32.eq (local.get $status) (i32.const 1))
          (then (return (i32.const 1))))
        (call $write_inline_rational (local.get $dest_slot) (i64.const 1))
        (return (i32.const 0))))
    (local.set $status (call $poly_extract_coefficients
      (local.get $b_slot) (local.get $v_slot) (local.get $da32)
      (local.get $b_list) (local.get $stage) (local.get $stage_slots)
      (local.get $residual_tmp)))
    (if (local.get $status)
      (then
        (if (i32.eq (local.get $status) (i32.const 1))
          (then (return (i32.const 1))))
        (call $write_inline_rational (local.get $dest_slot) (i64.const 1))
        (return (i32.const 0))))

    ;; Contents, their gcd, and primitive parts.
    (local.set $status (call $coefficient_list_content
      (local.get $a_list) (local.get $da32) (local.get $cont_a)))
    (if (local.get $status) (then (return (local.get $status))))
    (local.set $status (call $coefficient_list_content
      (local.get $b_list) (local.get $da32) (local.get $cont_b)))
    (if (local.get $status) (then (return (local.get $status))))
    (local.set $status (call $poly_gcd_semantic
      (local.get $cont_a) (local.get $cont_b) (local.get $d_slot)))
    (if (local.get $status) (then (return (local.get $status))))
    (local.set $status (call $coefficient_list_exact_divide
      (local.get $a_list) (local.get $da32) (local.get $cont_a)))
    (if (local.get $status) (then (return (local.get $status))))
    (local.set $status (call $coefficient_list_exact_divide
      (local.get $b_list) (local.get $da32) (local.get $cont_b)))
    (if (local.get $status) (then (return (local.get $status))))

    ;; Primitive pseudo-remainder sequence on (a_list, b_list).
    (block $prs_done
      (loop $prs
        ;; Pseudo-remainder of a_list by b_list into work_list.
        (local.set $i (i32.const 0))
        (block $copy_done
          (loop $copy
            (br_if $copy_done (i32.gt_s (local.get $i) (local.get $da32)))
            (memory.copy
              (call $abs (i32.add (local.get $work_list)
                (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
              (call $abs (i32.add (local.get $a_list)
                (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
              (global.get $VALUE_SIZE))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $copy)
          )
        )
        (block $prem_done
          (loop $prem
            (local.set $dw (call $coefficient_list_degree
              (local.get $work_list) (local.get $da32)))
            (br_if $prem_done (i32.lt_s (local.get $dw) (local.get $db32)))
            (local.set $delta (i32.sub (local.get $dw) (local.get $db32)))
            (memory.copy (call $abs (local.get $lead_w))
              (call $abs (i32.add (local.get $work_list)
                (i32.mul (local.get $dw) (global.get $VALUE_SIZE))))
              (global.get $VALUE_SIZE))
            (local.set $lead_b (i32.add (local.get $b_list)
              (i32.mul (local.get $db32) (global.get $VALUE_SIZE))))
            ;; W[i] = lead_b·W[i] − lead_w·B[i−δ]
            (local.set $i (i32.const 0))
            (block $prem_row_done
              (loop $prem_row
                (br_if $prem_row_done (i32.ge_s (local.get $i) (local.get $dw)))
                (local.set $status (call $build_simplified2
                  (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
                  (local.get $lead_b)
                  (i32.add (local.get $work_list)
                    (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
                  (i32.add (local.get $work_list)
                    (i32.mul (local.get $i) (global.get $VALUE_SIZE)))))
                (if (local.get $status) (then (return (local.get $status))))
                (if (i32.ge_s (local.get $i) (local.get $delta))
                  (then
                    (local.set $status (call $build_simplified2
                      (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
                      (local.get $lead_w)
                      (i32.add (local.get $b_list)
                        (i32.mul (i32.sub (local.get $i) (local.get $delta))
                          (global.get $VALUE_SIZE)))
                      (local.get $t1)))
                    (if (local.get $status) (then (return (local.get $status))))
                    (local.set $status (call $build_simplified2
                      (global.get $BUILTIN_EXPRESSION_HEAD_SUBTRACT)
                      (i32.add (local.get $work_list)
                        (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
                      (local.get $t1)
                      (i32.add (local.get $work_list)
                        (i32.mul (local.get $i) (global.get $VALUE_SIZE)))))
                    (if (local.get $status) (then (return (local.get $status))))))
                (local.set $i (i32.add (local.get $i) (i32.const 1)))
                (br $prem_row)
              )
            )
            (call $write_inline_rational
              (i32.add (local.get $work_list)
                (i32.mul (local.get $dw) (global.get $VALUE_SIZE)))
              (i64.const 0))
            (br $prem)
          )
        )
        ;; R zero → gcd of primitive parts is b_list.
        (local.set $dw (call $coefficient_list_degree (local.get $work_list) (local.get $da32)))
        (if (i32.lt_s (local.get $dw) (i32.const 0))
          (then
            (local.set $status (call $poly_from_coefficient_list
              (local.get $b_list) (local.get $db32) (local.get $v_slot)
              (local.get $g_tree) (i32.const 1)))
            (if (local.get $status) (then (return (local.get $status))))
            (br $prs_done)))
        ;; Strip R's content; R becomes the new b.
        (local.set $status (call $coefficient_list_content
          (local.get $work_list) (local.get $da32) (local.get $t1)))
        (if (local.get $status) (then (return (local.get $status))))
        (local.set $status (call $coefficient_list_exact_divide
          (local.get $work_list) (local.get $da32) (local.get $t1)))
        (if (local.get $status) (then (return (local.get $status))))
        ;; a ← b, b ← R.
        (local.set $i (i32.const 0))
        (block $rotate_done
          (loop $rotate
            (br_if $rotate_done (i32.gt_s (local.get $i) (local.get $da32)))
            (memory.copy
              (call $abs (i32.add (local.get $a_list)
                (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
              (call $abs (i32.add (local.get $b_list)
                (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
              (global.get $VALUE_SIZE))
            (memory.copy
              (call $abs (i32.add (local.get $b_list)
                (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
              (call $abs (i32.add (local.get $work_list)
                (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
              (global.get $VALUE_SIZE))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $rotate)
          )
        )
        (local.set $db32 (local.get $dw))
        ;; Degree 0 remainder: primitive parts are coprime.
        (if (i32.eqz (local.get $db32))
          (then
            (call $write_inline_rational (local.get $g_tree) (i64.const 1))
            (br $prs_done)))
        (br $prs)
      )
    )

    ;; result = d · primitive-part gcd.
    (call $build_simplified2 (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
      (local.get $d_slot) (local.get $g_tree) (local.get $dest_slot))
  )

  ;; ==========================================================================
  ;; Divide cancellation — Ring 3 (3d)
  ;; ==========================================================================

  ;; Is the leading term's coefficient (first term under canonical lex
  ;; order) a negative real? Purely-real Complex counts as real;
  ;; non-real Complex never reads as negative (Q6 — no unit rotation).
  (func $leading_coefficient_is_negative_real (param $poly_slot i32) (result i32)
    (local $coeff_slot i32)
    (local $header i32)
    (local $real i32)
    (call $sum_term_list (local.get $poly_slot))
    (local.set $coeff_slot (call $term_split (global.get $sum_terms_data)))
    (if (i32.eqz (local.get $coeff_slot))
      (then (return (i32.const 0))))
    (if (i32.eq (call $value_type (local.get $coeff_slot)) (global.get $TYPE_COMPLEX))
      (then
        (local.set $header (call $value_data_lo (local.get $coeff_slot)))
        (if (i32.eqz (call $complex_is_real (local.get $header)))
          (then (return (i32.const 0))))
        (return (i32.eq (call $bigint_sign
          (call $rational_numerator (call $complex_real (local.get $header))))
          (i32.const 1)))))
    (if (i32.eq (call $value_type (local.get $coeff_slot)) (global.get $TYPE_BIGINT))
      (then (return (i32.eq (call $bigint_sign
        (call $value_data_lo (local.get $coeff_slot))) (i32.const 1)))))
    (if (i32.eq (call $value_type (local.get $coeff_slot)) (global.get $TYPE_RATIONAL))
      (then
        (if (call $rational_is_inline (local.get $coeff_slot))
          (then (return (i64.lt_s
            (call $rational_read_inline (local.get $coeff_slot)) (i64.const 0)))))
        (return (i32.eq (call $bigint_sign
          (call $rational_numerator (call $value_data_lo (local.get $coeff_slot))))
          (i32.const 1)))))
    (i32.const 0)
  )

  ;; GCD cancellation over the desugared Divide shape. Runs on a sorted
  ;; and power-merged Multiply arg region containing negative-integer
  ;; Power factors: numerator = product of the other factors,
  ;; denominator = product of the negative powers' bases^|k|. When both
  ;; are polynomial-shaped, divide through by their GCD and normalize
  ;; the denominator's sign (real-negative leading → flip both).
  ;; Returns 0 = not applicable / unchanged (caller builds normally),
  ;; 1 = pressure-abort, 2 = handled (dest written).
  (func $multiply_divide_cancellation
    (param $data_start i32) (param $count i32) (param $dest_slot i32)
    (result i32)
    (local $i i32)
    (local $slot i32)
    (local $negative_count i32)
    (local $positive_count i32)
    (local $scratch i32)
    (local $numerator i32)
    (local $denominator i32)
    (local $gcd_slot i32)
    (local $factor_tmp i32)
    (local $minus_one i32)
    (local $args_array i32)
    (local $args_data i32)
    (local $data_size i32)
    (local $aligned i32)
    (local $cursor i32)
    (local $status i32)
    (local $changed i32)
    (local $exponent i64)
    (local $new_expression i32)

    ;; Scan: count negative-integer-power factors; any slot-carried
    ;; (huge) negative exponent disables the rewrite.
    (local.set $i (i32.const 0))
    (block $scan_done
      (loop $scan
        (br_if $scan_done (i32.ge_u (local.get $i) (local.get $count)))
        (local.set $slot (i32.add (local.get $data_start)
          (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
        (if (call $factor_is_negative_power (local.get $slot))
          (then
            (call $factor_decompose (local.get $slot))
            (if (global.get $term_factors_count)
              (then (return (i32.const 0))))
            (local.set $negative_count (i32.add (local.get $negative_count) (i32.const 1)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $scan)
      )
    )
    (if (i32.eqz (local.get $negative_count))
      (then (return (i32.const 0))))
    (local.set $positive_count (i32.sub (local.get $count) (local.get $negative_count)))

    (if (call $expression_walk_guard (i32.const 96))
      (then (return (i32.const 1))))
    (local.set $scratch (call $carve_scratch_blob
      (i32.mul (i32.const 5) (global.get $VALUE_SIZE))))
    (local.set $numerator (local.get $scratch))
    (local.set $denominator (i32.add (local.get $numerator) (global.get $VALUE_SIZE)))
    (local.set $gcd_slot (i32.add (local.get $denominator) (global.get $VALUE_SIZE)))
    (local.set $factor_tmp (i32.add (local.get $gcd_slot) (global.get $VALUE_SIZE)))
    (local.set $minus_one (i32.add (local.get $factor_tmp) (global.get $VALUE_SIZE)))

    ;; Numerator = product of the non-negative-power factors.
    (call $write_inline_rational (local.get $numerator) (i64.const 1))
    (local.set $i (i32.const 0))
    (block $numer_done
      (loop $numer
        (br_if $numer_done (i32.ge_u (local.get $i) (local.get $count)))
        (local.set $slot (i32.add (local.get $data_start)
          (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
        (if (i32.eqz (call $factor_is_negative_power (local.get $slot)))
          (then
            (if (call $expression_value_is_one_wide (local.get $numerator))
              (then (memory.copy (call $abs (local.get $numerator))
                (call $abs (local.get $slot)) (global.get $VALUE_SIZE)))
              (else
                (local.set $status (call $build_simplified2
                  (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
                  (local.get $numerator) (local.get $slot) (local.get $numerator)))
                (if (local.get $status) (then (return (local.get $status))))))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $numer)
      )
    )
    ;; Denominator = product of bases^|k|.
    (call $write_inline_rational (local.get $denominator) (i64.const 1))
    (local.set $i (i32.const 0))
    (block $denom_done
      (loop $denom
        (br_if $denom_done (i32.ge_u (local.get $i) (local.get $count)))
        (local.set $slot (i32.add (local.get $data_start)
          (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
        (if (call $factor_is_negative_power (local.get $slot))
          (then
            (call $factor_decompose (local.get $slot))
            (local.set $exponent (i64.sub (i64.const 0) (global.get $bigint_to_i64_value)))
            (local.set $status (call $build_power_i64
              (global.get $term_factors_data) (local.get $exponent) (local.get $factor_tmp)))
            (if (local.get $status) (then (return (local.get $status))))
            (if (call $expression_value_is_one_wide (local.get $denominator))
              (then
                (local.set $status (call $expression_simplify_into
                  (local.get $factor_tmp) (local.get $denominator))))
              (else
                (local.set $status (call $build_simplified2
                  (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
                  (local.get $denominator) (local.get $factor_tmp) (local.get $denominator)))))
            (if (local.get $status) (then (return (local.get $status))))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $denom)
      )
    )

    ;; Cancellation may remove common factors only on the defined domain.
    ;; A zero denominator has no defined point, so keep the original
    ;; numerator and formal reciprocal unchanged.
    (if (call $expression_value_is_zero_wide (local.get $denominator)) (then (return (i32.const 0))))

    ;; Both sides must be polynomial-shaped; otherwise leave the
    ;; original form alone ("didn't simplify" beats "crashed").
    (if (i32.or
          (i32.eq (call $expression_polynomial_kind (local.get $numerator))
                  (global.get $POLY_KIND_NOT_POLYNOMIAL))
          (i32.eq (call $expression_polynomial_kind (local.get $denominator))
                  (global.get $POLY_KIND_NOT_POLYNOMIAL)))
      (then (return (i32.const 0))))

    ;; Cancel by the GCD.
    (local.set $status (call $poly_gcd_semantic
      (local.get $numerator) (local.get $denominator) (local.get $gcd_slot)))
    (if (local.get $status) (then (return (local.get $status))))
    (local.set $changed (i32.const 0))
    (if (i32.eqz (call $expression_value_is_one_wide (local.get $gcd_slot)))
      (then
        (local.set $status (call $poly_exact_divide
          (local.get $numerator) (local.get $gcd_slot) (local.get $numerator)))
        (if (local.get $status) (then (return (local.get $status))))
        (local.set $status (call $poly_exact_divide
          (local.get $denominator) (local.get $gcd_slot) (local.get $denominator)))
        (if (local.get $status) (then (return (local.get $status))))
        (local.set $changed (i32.const 1))))

    ;; Sign normalization: a symbolic denominator with a negative real
    ;; leading coefficient flips both sides.
    (if (i32.and
          (i32.eqz (call $expression_slot_is_numeric (local.get $denominator)))
          (call $leading_coefficient_is_negative_real (local.get $denominator)))
      (then
        (call $write_inline_rational (local.get $minus_one) (i64.const -1))
        (local.set $status (call $build_simplified2
          (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
          (local.get $numerator) (local.get $minus_one) (local.get $numerator)))
        (if (local.get $status) (then (return (local.get $status))))
        (call $write_inline_rational (local.get $minus_one) (i64.const -1))
        (local.set $status (call $build_simplified2
          (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
          (local.get $denominator) (local.get $minus_one) (local.get $denominator)))
        (if (local.get $status) (then (return (local.get $status))))
        (local.set $changed (i32.const 1))))
    (if (i32.eqz (local.get $changed))
      (then (return (i32.const 0))))

    ;; Rebuild: numerator alone when the denominator is 1; otherwise
    ;; Multiply(numerator, Power(denominator, -1)) re-simplified (the
    ;; re-entry finds a coprime, sign-normalized pair and stabilizes —
    ;; idempotence).
    (if (call $expression_value_is_one_wide (local.get $denominator))
      (then
        (memory.copy (call $abs (local.get $dest_slot))
          (call $abs (local.get $numerator)) (global.get $VALUE_SIZE))
        (return (i32.const 2))))
    (call $write_inline_rational (local.get $minus_one) (i64.const -1))
    (if (call $expression_walk_guard (i32.const 96))
      (then (return (i32.const 1))))
    (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_POWER)
      (local.get $denominator) (local.get $minus_one) (local.get $factor_tmp))
    (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)
      (local.get $numerator) (local.get $factor_tmp) (local.get $dest_slot))
    (local.set $status (call $expression_simplify_into
      (local.get $dest_slot) (local.get $dest_slot)))
    (if (local.get $status) (then (return (local.get $status))))
    (i32.const 2)
  )

  ;; Content of a coefficient list: the recursive gcd fold of its
  ;; non-zero entries. Returns walk status; content written to $dest.
  (func $coefficient_list_content
    (param $list i32) (param $cap i32) (param $dest i32)
    (result i32)
    (local $i i32)
    (local $seeded i32)
    (local $slot i32)
    (local $status i32)
    (call $write_inline_rational (local.get $dest) (i64.const 0))
    (local.set $i (i32.const 0))
    (block $done
      (loop $walk
        (br_if $done (i32.gt_s (local.get $i) (local.get $cap)))
        (local.set $slot (i32.add (local.get $list)
          (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
        (if (i32.eqz (call $expression_value_is_zero_wide (local.get $slot)))
          (then
            (if (i32.eqz (local.get $seeded))
              (then
                (memory.copy (call $abs (local.get $dest))
                  (call $abs (local.get $slot)) (global.get $VALUE_SIZE))
                (local.set $seeded (i32.const 1)))
              (else
                (local.set $status (call $poly_gcd_semantic
                  (local.get $dest) (local.get $slot) (local.get $dest)))
                (if (local.get $status) (then (return (local.get $status))))))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $walk)
      )
    )
    (if (i32.eqz (local.get $seeded))
      (then (call $write_inline_rational (local.get $dest) (i64.const 1))))
    (i32.const 0)
  )

  ;; Divide every entry of a coefficient list by the (exactly dividing)
  ;; content. In place. Returns walk status.
  (func $coefficient_list_exact_divide
    (param $list i32) (param $cap i32) (param $content i32)
    (result i32)
    (local $i i32)
    (local $slot i32)
    (local $status i32)
    (if (call $expression_value_is_one_wide (local.get $content))
      (then (return (i32.const 0))))
    (local.set $i (i32.const 0))
    (block $done
      (loop $walk
        (br_if $done (i32.gt_s (local.get $i) (local.get $cap)))
        (local.set $slot (i32.add (local.get $list)
          (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
        (if (i32.eqz (call $expression_value_is_zero_wide (local.get $slot)))
          (then
            (local.set $status (call $poly_exact_divide
              (local.get $slot) (local.get $content) (local.get $slot)))
            (if (local.get $status) (then (return (local.get $status))))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $walk)
      )
    )
    (i32.const 0)
  )

  ;; Desugar Subtract(a, b) → simplified Add(a, Negate(b)).
  ;; Builds the Add tree and delegates to simplify_into so Add's
  ;; canonicalizer does the flattening/folding/sorting. If b is itself
  ;; a numeric, the Negate gets simplified away by the Negate rule
  ;; elsewhere; if it's a Symbol or Expression, Negate stays and Add
  ;; sees two operands. Returns walk status: 0 ok, 1 pressure-abort.
  (func $expression_desugar_subtract
    (param $a_slot i32) (param $b_slot i32) (param $dest_slot i32) (result i32)
    (local $negate_args_array i32)
    (local $negated_slot i32)
    (local $negate_data i32)
    (local $negate_expression i32)
    (local $add_args_array i32)
    (local $add_data i32)
    (local $data_size i32)
    (local $aligned i32)
    (local $scratch_slot i32)

    ;; Fast path: both operands exact numeric → fold directly via a + (-b).
    (if (i32.and
          (call $expression_slot_is_numeric (local.get $a_slot))
          (call $expression_slot_is_numeric (local.get $b_slot)))
      (then
        (if (call $expression_walk_guard
              (i32.add (i32.const 32)
                (call $estimate_cross_type_arith_budget
                  (local.get $a_slot) (local.get $b_slot))))
          (then (return (i32.const 1))))
        ;; Committed scratch slot for -b (folds allocate around it).
        (local.set $negated_slot (call $carve_scratch_blob (global.get $VALUE_SIZE)))
        (if (call $expression_negate_numeric (local.get $b_slot) (local.get $negated_slot))
          (then (return (i32.const 1))))
        (call $expression_fold_add_slots
          (local.get $a_slot) (local.get $negated_slot) (local.get $dest_slot))
        (return (i32.const 0))))

    ;; Slow path: the fixed carves below (two args arrays + two
    ;; expression nodes, ~160 bytes) fit under the walk floor.
    (if (call $expression_walk_guard (i32.const 0))
      (then (return (i32.const 1))))

    ;; Build Negate(b) — one-arg array holding a copy of b.
    (local.set $negate_args_array (call $read_state (global.get $STATE_HEAP_POINTER)))
    (local.set $data_size (i32.add (global.get $GC_HEADER_SIZE) (global.get $VALUE_SIZE)))
    (local.set $aligned (i32.and
      (i32.add (local.get $data_size) (i32.const 15))
      (i32.const -16)))
    (local.set $negate_data (call $write_array_header
      (local.get $negate_args_array) (i32.const 1) (i32.const 1) (local.get $aligned)))
    (call $write_state (global.get $STATE_HEAP_POINTER)
      (i32.add (local.get $negate_data) (local.get $aligned)))
    (memory.copy
      (call $abs (i32.add (local.get $negate_data) (global.get $GC_HEADER_SIZE)))
      (call $abs (local.get $b_slot))
      (global.get $VALUE_SIZE))
    (local.set $negate_expression (call $expression_build
      (call $symbol_registry_lookup
        (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_NEGATE)))
      (local.get $negate_args_array)))

    ;; Build Add(a, Negate(b)) — two-arg array.
    (local.set $add_args_array (call $read_state (global.get $STATE_HEAP_POINTER)))
    (local.set $data_size (i32.add (global.get $GC_HEADER_SIZE)
      (i32.mul (i32.const 2) (global.get $VALUE_SIZE))))
    (local.set $aligned (i32.and
      (i32.add (local.get $data_size) (i32.const 15))
      (i32.const -16)))
    (local.set $add_data (call $write_array_header
      (local.get $add_args_array) (i32.const 2) (i32.const 2) (local.get $aligned)))
    (call $write_state (global.get $STATE_HEAP_POINTER)
      (i32.add (local.get $add_data) (local.get $aligned)))

    ;; a goes at position 0, Negate(b) at position 1.
    (memory.copy
      (call $abs (i32.add (local.get $add_data) (global.get $GC_HEADER_SIZE)))
      (call $abs (local.get $a_slot))
      (global.get $VALUE_SIZE))
    (local.set $scratch_slot (i32.add
      (i32.add (local.get $add_data) (global.get $GC_HEADER_SIZE))
      (global.get $VALUE_SIZE)))
    (i32.store (call $abs (local.get $scratch_slot)) (global.get $TYPE_EXPRESSION))
    (i32.store (call $abs (i32.add (local.get $scratch_slot) (i32.const 4))) (i32.const 0))
    (i32.store (call $abs (i32.add (local.get $scratch_slot) (i32.const 8))) (local.get $negate_expression))
    (i32.store (call $abs (i32.add (local.get $scratch_slot) (i32.const 12))) (i32.const 0))

    ;; Now call the Add canonicalizer directly so flatten/fold/sort fire.
    (if (call $expression_canonicalize_flat
          (call $symbol_registry_lookup
            (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_ADD)))
          (local.get $add_args_array)
          (i32.const 0)  ;; is_multiply = false
          (local.get $dest_slot))
      (then (return (i32.const 1))))

    ;; The outer Negate we just built might itself be simplifiable
    ;; (Negate(Negate(x)) or numeric-valued). Re-simplify once more on
    ;; the dest to catch those. Idempotence guarantees termination.
    (call $expression_simplify_into
      (local.get $dest_slot)
      (local.get $dest_slot))
  )

  ;; Desugar Divide(a, b) → simplified Multiply(a, Power(b, -1)).
  ;; Special case: if both a and b are numeric, fold directly via Ring 1
  ;; Rational division so Divide(6, 2) → 3 instead of Multiply(6, Power(2, -1)).
  ;; Returns walk status: 0 ok, 1 pressure-abort.
  (func $expression_desugar_divide
    (param $a_slot i32) (param $b_slot i32) (param $dest_slot i32) (result i32)
    (local $power_args_array i32)
    (local $power_data i32)
    (local $power_expression i32)
    (local $mul_args_array i32)
    (local $mul_data i32)
    (local $data_size i32)
    (local $aligned i32)
    (local $exponent_slot i32)
    (local $arg_slot i32)
    (local $a_rational i32)
    (local $b_rational i32)
    (local $result_rational i32)

    ;; Fast path: both operands exact numeric (Rational / BigInt) → use
    ;; Ring 1 $rational_div to fold directly to a Rational. Covers
    ;; Divide(6, 2) → 3 and Divide(1, 2) → 1/2 cases.
    ;; Complex division falls through to the general Power(b, -1) path.
    ;; A ZERO divisor also falls through: $rational_div on a zero
    ;; divisor would mint a corrupt 1/0 Rational (violating Ring 1's
    ;; denominator > 0 invariant — this fold once did exactly that);
    ;; the symbolic Multiply(a, Power(0, -1)) form is the honest
    ;; result, since the Power fold refuses zero-to-negative too.
    (if (i32.and
          (i32.and
            (i32.or
              (i32.eq (call $value_type (local.get $a_slot)) (global.get $TYPE_RATIONAL))
              (i32.eq (call $value_type (local.get $a_slot)) (global.get $TYPE_BIGINT)))
            (i32.or
              (i32.eq (call $value_type (local.get $b_slot)) (global.get $TYPE_RATIONAL))
              (i32.eq (call $value_type (local.get $b_slot)) (global.get $TYPE_BIGINT))))
          (i32.eqz (call $expression_value_is_zero_wide (local.get $b_slot))))
      (then
        (if (call $expression_walk_guard
              (call $estimate_cross_type_arith_budget
                (local.get $a_slot) (local.get $b_slot)))
          (then (return (i32.const 1))))
        (local.set $a_rational (call $expression_to_rational (local.get $a_slot)))
        (local.set $b_rational (call $expression_to_rational (local.get $b_slot)))
        (local.set $result_rational (call $rational_div
          (local.get $a_rational) (local.get $b_rational)))
        (i32.store (call $abs (local.get $dest_slot)) (global.get $TYPE_RATIONAL))
        (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 4))) (i32.const 0))
        (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 8))) (local.get $result_rational))
        (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 12))) (i32.const 0))
        (return (i32.const 0))))

    ;; Slow path: fixed carves (two args arrays + two expression nodes)
    ;; fit under the walk floor.
    (if (call $expression_walk_guard (i32.const 0))
      (then (return (i32.const 1))))

    ;; Build Power(b, -1).
    ;; Allocate Power's args array.
    (local.set $power_args_array (call $read_state (global.get $STATE_HEAP_POINTER)))
    (local.set $data_size (i32.add (global.get $GC_HEADER_SIZE)
      (i32.mul (i32.const 2) (global.get $VALUE_SIZE))))
    (local.set $aligned (i32.and
      (i32.add (local.get $data_size) (i32.const 15))
      (i32.const -16)))
    (local.set $power_data (call $write_array_header
      (local.get $power_args_array) (i32.const 2) (i32.const 2) (local.get $aligned)))
    (call $write_state (global.get $STATE_HEAP_POINTER)
      (i32.add (local.get $power_data) (local.get $aligned)))

    ;; First Power arg = b.
    (memory.copy
      (call $abs (i32.add (local.get $power_data) (global.get $GC_HEADER_SIZE)))
      (call $abs (local.get $b_slot))
      (global.get $VALUE_SIZE))
    ;; Second Power arg = inline Rational(-1).
    (local.set $exponent_slot (i32.add
      (i32.add (local.get $power_data) (global.get $GC_HEADER_SIZE))
      (global.get $VALUE_SIZE)))
    (i32.store (call $abs (local.get $exponent_slot)) (global.get $TYPE_RATIONAL))
    (i32.store (call $abs (i32.add (local.get $exponent_slot) (i32.const 4)))
      (global.get $FLAG_RATIONAL_INLINE))
    (i32.store (call $abs (i32.add (local.get $exponent_slot) (i32.const 8))) (i32.const -1))
    (i32.store (call $abs (i32.add (local.get $exponent_slot) (i32.const 12))) (i32.const -1))
    (local.set $power_expression (call $expression_build
      (call $symbol_registry_lookup
        (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_POWER)))
      (local.get $power_args_array)))

    ;; Build Multiply(a, Power(b, -1)).
    (local.set $mul_args_array (call $read_state (global.get $STATE_HEAP_POINTER)))
    (local.set $data_size (i32.add (global.get $GC_HEADER_SIZE)
      (i32.mul (i32.const 2) (global.get $VALUE_SIZE))))
    (local.set $aligned (i32.and
      (i32.add (local.get $data_size) (i32.const 15))
      (i32.const -16)))
    (local.set $mul_data (call $write_array_header
      (local.get $mul_args_array) (i32.const 2) (i32.const 2) (local.get $aligned)))
    (call $write_state (global.get $STATE_HEAP_POINTER)
      (i32.add (local.get $mul_data) (local.get $aligned)))

    ;; First Multiply arg = a.
    (memory.copy
      (call $abs (i32.add (local.get $mul_data) (global.get $GC_HEADER_SIZE)))
      (call $abs (local.get $a_slot))
      (global.get $VALUE_SIZE))
    ;; Second = Power(b, -1) expression.
    (local.set $arg_slot (i32.add
      (i32.add (local.get $mul_data) (global.get $GC_HEADER_SIZE))
      (global.get $VALUE_SIZE)))
    (i32.store (call $abs (local.get $arg_slot)) (global.get $TYPE_EXPRESSION))
    (i32.store (call $abs (i32.add (local.get $arg_slot) (i32.const 4))) (i32.const 0))
    (i32.store (call $abs (i32.add (local.get $arg_slot) (i32.const 8))) (local.get $power_expression))
    (i32.store (call $abs (i32.add (local.get $arg_slot) (i32.const 12))) (i32.const 0))

    ;; Simplify the reciprocal before Multiply canonicalization. Sending the
    ;; raw Power through divide cancellation can rebuild the same Divide shape
    ;; when either operand is algebraic, so the final re-simplify re-enters this
    ;; function without consuming progress. A numeric reciprocal becomes an
    ;; exact tower value here; a symbolic reciprocal remains a Power.
    (if (call $expression_simplify_into
          (local.get $arg_slot) (local.get $arg_slot))
      (then (return (i32.const 1))))

    ;; Canonicalize via Multiply.
    (if (call $expression_canonicalize_flat
          (call $symbol_registry_lookup
            (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)))
          (local.get $mul_args_array)
          (i32.const 1)  ;; is_multiply = true
          (local.get $dest_slot))
      (then (return (i32.const 1))))

    ;; Re-simplify to catch secondary simplifications from cancellation.
    (call $expression_simplify_into
      (local.get $dest_slot)
      (local.get $dest_slot))
  )

  ;; Apply Add / Multiply canonicalization:
  ;;   1. Flatten nested same-head sub-expressions.
  ;;   2. Separate numeric args from non-numeric.
  ;;   3. Fold all numerics into a single value.
  ;;   4. Apply identity / annihilation to drop or return early.
  ;;   5. Write the final result into dest_slot.
  ;; is_multiply = 0 for Add, 1 for Multiply.
  ;; Returns walk status: 0 ok, 1 pressure-abort.
  (func $expression_canonicalize_flat
    (param $head_sym i32)
    (param $args_array i32)
    (param $is_multiply i32)
    (param $dest_slot i32)
    (result i32)
    (local $total i32)
    (local $scratch_buffer i32)  ;; pointer to work area holding flattened slots
    (local $i i32)
    (local $slot i32)
    (local $fold_slot i32)       ;; slot holding running folded numeric
    (local $has_numeric i32)
    (local $non_numeric_count i32)
    (local $final_count i32)
    (local $new_array i32)
    (local $new_data i32)
    (local $new_expression i32)
    (local $needs_fold_slot i32)
    (local $final_data_size i32)
    (local $final_aligned i32)
    (local $src_slot i32)
    (local $dest_elem i32)
    (local $max_entries i32)
    (local $stage_a i32)
    (local $collected i32)
    (local $has_add_factor i32)
    (local $blocked i32)
    (local $predicted i64)
    (local $accumulator i32)
    (local $has_undefined_term i32)

    (local.set $total (call $expression_flatten_count
      (local.get $args_array) (local.get $head_sym)))

    ;; Zero-arg case: identity. Add() → 0, Multiply() → 1.
    (if (i32.eqz (local.get $total))
      (then
        (if (local.get $is_multiply)
          (then (call $expression_write_one (local.get $dest_slot)))
          (else (call $expression_write_zero (local.get $dest_slot))))
        (return (i32.const 0))))

    ;; Admission guard for this node's size-parametrized carves: the
    ;; scratch blob ((2·total+1) slots + header) plus the final args
    ;; array and expression node. 48·total + 112 over-covers all three.
    (if (call $expression_walk_guard
          (i32.add (i32.mul (local.get $total) (i32.const 48)) (i32.const 112)))
      (then (return (i32.const 1))))

    ;; Committed scratch blob for the flattened slots (real OBJ_SCRATCH
    ;; header — the heap walk must parse over this buffer).
    ;; Layout: [total VALUE_SIZE slots][1 fold slot][total non_numeric slots].
    (local.set $scratch_buffer (call $carve_scratch_blob (i32.mul
      (i32.add (i32.mul (i32.const 2) (local.get $total)) (i32.const 1))
      (global.get $VALUE_SIZE))))

    ;; Flatten into the first `total` slots of the scratch buffer.
    ;; Treats scratch_buffer as the start of slot[0]; flatten_into writes
    ;; to dest_data + (index * VALUE_SIZE).
    (drop (call $expression_flatten_into
      (local.get $args_array)
      (local.get $head_sym)
      (local.get $scratch_buffer)
      (i32.const 0)))

    ;; Order-preserving fold:
    ;;   1. First pass: compute the running fold of numeric args. Track
    ;;      where the FIRST numeric appeared; only that position keeps
    ;;      the fold result. Other numeric positions become "empty".
    ;;   2. Second pass: build the final arg list in input order, keeping
    ;;      non-numerics as-is and replacing the first-numeric slot with
    ;;      the fold. Subsequent numerics are dropped.
    ;;
    ;; This preserves relative position: Add(Pi, 1) stays Add(Pi, 1);
    ;; Add(1, Pi, 2) becomes Add(3, Pi); Add(1, 2, 3) becomes 6.
    ;; Commutative sort is 2d.3's job; 2d.2 only flattens and folds.
    ;;
    ;; Layout in scratch:
    ;;   scratch_buffer[0 .. total-1] = flattened args
    ;;   scratch_buffer[total]         = fold_slot (running numeric fold)
    (local.set $fold_slot (i32.add (local.get $scratch_buffer)
      (i32.mul (local.get $total) (global.get $VALUE_SIZE))))

    (local.set $i (i32.const 0))
    (local.set $has_numeric (i32.const 0))
    (local.set $non_numeric_count (i32.const 0))  ;; reused as first-numeric-index
    (local.set $final_count (i32.const 0))        ;; reused as numeric-count
    (block $split_done
      (loop $split
        (br_if $split_done (i32.ge_u (local.get $i) (local.get $total)))
        (local.set $slot (i32.add (local.get $scratch_buffer)
          (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
        (if (call $expression_value_contains_undefined (local.get $slot))
          (then
            (local.set $has_undefined_term (i32.const 1))))
        (if (call $expression_slot_is_numeric (local.get $slot))
          (then
            (if (i32.eqz (local.get $has_numeric))
              (then
                (memory.copy
                  (call $abs (local.get $fold_slot))
                  (call $abs (local.get $slot))
                  (global.get $VALUE_SIZE))
                (local.set $has_numeric (i32.const 1))
                (local.set $non_numeric_count (local.get $i)))  ;; first-numeric-index
              (else
                ;; Folds allocate proportionally to coefficient size —
                ;; guard each with the value-parametrized estimate.
                (if (call $expression_walk_guard
                      (call $estimate_cross_type_arith_budget
                        (local.get $fold_slot) (local.get $slot)))
                  (then (return (i32.const 1))))
                (if (local.get $is_multiply)
                  (then (call $expression_fold_mul_slots
                    (local.get $fold_slot) (local.get $slot) (local.get $fold_slot)))
                  (else (call $expression_fold_add_slots
                    (local.get $fold_slot) (local.get $slot) (local.get $fold_slot))))))
            (local.set $final_count (i32.add (local.get $final_count) (i32.const 1)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $split)
      )
    )

    ;; Apply identity / annihilation based on fold result.
    ;; needs_fold_slot = 1 means keep the fold result in the output;
    ;; 0 means drop it (fold was identity and there are non-numerics).
    (local.set $needs_fold_slot (i32.const 1))
    (if (local.get $has_numeric)
      (then
        (if (local.get $is_multiply)
          (then
            ;; Multiply: fold == 0 → annihilate (return 0). Complex-
            ;; aware: i·x + (−i)·x style folds can leave Complex(0,0).
            ;; A formal zero divisor blocks annihilation because 0·(0^-1)
            ;; is undefined, not zero.
            (if (i32.and
                  (call $expression_value_is_zero_wide (local.get $fold_slot))
                  (i32.eqz (local.get $has_undefined_term)))
              (then
                (call $expression_write_zero (local.get $dest_slot))
                (return (i32.const 0))))
            ;; Multiply: fold == 1 and there are non-numerics → drop.
            (if (i32.and
                  (call $expression_value_is_one_wide (local.get $fold_slot))
                  (i32.lt_u (local.get $final_count) (local.get $total)))
              (then (local.set $needs_fold_slot (i32.const 0)))))
          (else
            ;; Add: fold == 0 and there are non-numerics → drop.
            (if (i32.and
                  (call $expression_value_is_zero_wide (local.get $fold_slot))
                  (i32.lt_u (local.get $final_count) (local.get $total)))
              (then (local.set $needs_fold_slot (i32.const 0)))))))
      (else (local.set $needs_fold_slot (i32.const 0))))

    ;; Compute final_count = total - (numerics_to_drop).
    ;; If needs_fold_slot: drop all numerics except one (the folded slot).
    ;; If !needs_fold_slot: drop all numerics.
    ;; Let numeric_count = $final_count (set above); non_numeric_count in
    ;; the tree = total - numeric_count.
    (local.set $final_count
      (if (result i32) (local.get $needs_fold_slot)
        (then (i32.add
          (i32.sub (local.get $total) (local.get $final_count))  ;; non-numerics
          (i32.const 1)))                                         ;; + fold slot
        (else (i32.sub (local.get $total) (local.get $final_count)))))  ;; non-numerics only

    ;; Edge case: Add(0) or Multiply(1) (sole numeric that's the identity).
    ;; final_count == 0 but there was a numeric → return the fold slot anyway.
    (if (i32.eqz (local.get $final_count))
      (then
        (if (local.get $is_multiply)
          (then (call $expression_write_one (local.get $dest_slot)))
          (else (call $expression_write_zero (local.get $dest_slot))))
        (return (i32.const 0))))

    ;; final_count == 1 → return the single surviving arg. Walk input to
    ;; find it — it's either the fold slot (if needs_fold_slot) or the
    ;; only non-numeric.
    (if (i32.eq (local.get $final_count) (i32.const 1))
      (then
        (if (local.get $needs_fold_slot)
          (then
            ;; Only numerics were present, collapsed to a single fold.
            (memory.copy
              (call $abs (local.get $dest_slot))
              (call $abs (local.get $fold_slot))
              (global.get $VALUE_SIZE)))
          (else
            ;; Find the single non-numeric in the flattened scratch.
            (local.set $i (i32.const 0))
            (block $single_done
              (loop $single_find
                (br_if $single_done (i32.ge_u (local.get $i) (local.get $total)))
                (local.set $slot (i32.add (local.get $scratch_buffer)
                  (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
                (if (i32.eqz (call $expression_slot_is_numeric (local.get $slot)))
                  (then
                    ;; Ring 3 (3d): a lone surviving Power(D, -k) in a
                    ;; Multiply is the bare-reciprocal Divide shape —
                    ;; give the cancellation/sign hook its shot (e.g.
                    ;; 1/(1-x) → -1/(x-1)) before collapsing.
                    (if (local.get $is_multiply)
                      (then
                        (local.set $collected (call $multiply_divide_cancellation
                          (local.get $slot) (i32.const 1) (local.get $dest_slot)))
                        (if (i32.eq (local.get $collected) (i32.const 1))
                          (then (return (i32.const 1))))
                        (if (i32.eq (local.get $collected) (i32.const 2))
                          (then (br $single_done)))))
                    (memory.copy
                      (call $abs (local.get $dest_slot))
                      (call $abs (local.get $slot))
                      (global.get $VALUE_SIZE))
                    (br $single_done)))
                (local.set $i (i32.add (local.get $i) (i32.const 1)))
                (br $single_find)))))
        (return (i32.const 0))))

    ;; final_count > 1: build a new Expression preserving input order.
    ;; For each input slot: if numeric AND it's the first-numeric-index
    ;; AND needs_fold_slot, write the fold; if numeric at another index,
    ;; skip; if non-numeric, copy through.
    (local.set $new_array (call $read_state (global.get $STATE_HEAP_POINTER)))
    (local.set $final_data_size (i32.add (global.get $GC_HEADER_SIZE)
      (i32.mul (local.get $final_count) (global.get $VALUE_SIZE))))
    (local.set $final_aligned (i32.and
      (i32.add (local.get $final_data_size) (i32.const 15))
      (i32.const -16)))
    (local.set $new_data (call $write_array_header
      (local.get $new_array) (local.get $final_count) (local.get $final_count) (local.get $final_aligned)))
    (call $write_state (global.get $STATE_HEAP_POINTER)
      (i32.add (local.get $new_data) (local.get $final_aligned)))

    ;; Fill, preserving input order.
    ;; $non_numeric_count holds first-numeric-index from the split pass.
    (local.set $i (i32.const 0))           ;; input index
    (local.set $final_count (i32.const 0))  ;; output index (reused local)
    (block $emit_done
      (loop $emit
        (br_if $emit_done (i32.ge_u (local.get $i) (local.get $total)))
        (local.set $src_slot (i32.add (local.get $scratch_buffer)
          (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
        (if (call $expression_slot_is_numeric (local.get $src_slot))
          (then
            ;; Numeric input: emit the fold slot only at the first-numeric
            ;; position AND only if needs_fold_slot is set.
            (if (i32.and
                  (local.get $needs_fold_slot)
                  (i32.eq (local.get $i) (local.get $non_numeric_count)))
              (then
                (local.set $dest_elem (i32.add
                  (i32.add (local.get $new_data) (global.get $GC_HEADER_SIZE))
                  (i32.mul (local.get $final_count) (global.get $VALUE_SIZE))))
                (memory.copy
                  (call $abs (local.get $dest_elem))
                  (call $abs (local.get $fold_slot))
                  (global.get $VALUE_SIZE))
                (local.set $final_count (i32.add (local.get $final_count) (i32.const 1))))))
          (else
            ;; Non-numeric: copy through.
            (local.set $dest_elem (i32.add
              (i32.add (local.get $new_data) (global.get $GC_HEADER_SIZE))
              (i32.mul (local.get $final_count) (global.get $VALUE_SIZE))))
            (memory.copy
              (call $abs (local.get $dest_elem))
              (call $abs (local.get $src_slot))
              (global.get $VALUE_SIZE))
            (local.set $final_count (i32.add (local.get $final_count) (i32.const 1)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $emit)
      )
    )

    ;; Ring 3 (3b): Multiply-over-Add distribution. When the arg list
    ;; contains Add factors, no negative-power factor blocks it (those
    ;; are division shapes — 3d's cancellation territory), and the
    ;; predicted product of summand counts fits the expansion cap (or
    ;; expand disabled the cap), distribute pairwise left-to-right;
    ;; every distribute_pair collects through the Add canonicalizer.
    (if (local.get $is_multiply)
      (then
        (local.set $has_add_factor (i32.const 0))
        (local.set $blocked (i32.const 0))
        (local.set $predicted (i64.const 1))
        (local.set $i (i32.const 0))
        (block $scan_done
          (loop $scan
            (br_if $scan_done (i32.ge_u (local.get $i) (local.get $final_count)))
            (local.set $src_slot (i32.add
              (i32.add (local.get $new_data) (global.get $GC_HEADER_SIZE))
              (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
            (call $sum_term_list (local.get $src_slot))
            (if (i32.gt_u (global.get $sum_terms_count) (i32.const 1))
              (then
                (local.set $has_add_factor (i32.const 1))
                (local.set $predicted (i64.mul (local.get $predicted)
                  (i64.extend_i32_u (global.get $sum_terms_count))))
                (if (i64.gt_s (local.get $predicted) (i64.const 0x40000000))
                  (then (local.set $predicted (i64.const 0x40000000))))))
            (if (call $factor_is_negative_power (local.get $src_slot))
              (then (local.set $blocked (i32.const 1))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $scan)
          )
        )
        (if (i32.and
              (local.get $has_add_factor)
              (i32.and
                (i32.eqz (local.get $blocked))
                (i32.or
                  (global.get $expansion_cap_disabled)
                  (i64.le_s (local.get $predicted)
                    (i64.extend_i32_u (global.get $MAX_EXPANSION_TERMS))))))
          (then
            (if (call $expression_walk_guard (i32.const 32))
              (then (return (i32.const 1))))
            (local.set $accumulator (call $carve_scratch_blob (global.get $VALUE_SIZE)))
            (memory.copy (call $abs (local.get $accumulator))
              (call $abs (i32.add (local.get $new_data) (global.get $GC_HEADER_SIZE)))
              (global.get $VALUE_SIZE))
            (local.set $i (i32.const 1))
            (block $chain_done
              (loop $chain
                (br_if $chain_done (i32.ge_u (local.get $i) (local.get $final_count)))
                (if (call $expression_distribute_pair
                      (local.get $accumulator)
                      (i32.add
                        (i32.add (local.get $new_data) (global.get $GC_HEADER_SIZE))
                        (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
                      (local.get $accumulator))
                  (then (return (i32.const 1))))
                (local.set $i (i32.add (local.get $i) (i32.const 1)))
                (br $chain)
              )
            )
            (memory.copy (call $abs (local.get $dest_slot))
              (call $abs (local.get $accumulator))
              (global.get $VALUE_SIZE))
            (return (i32.const 0))))))

    ;; Ring 3 (3a): staging areas for the monomial machinery — two
    ;; committed regions each large enough for the longest term's
    ;; factor entries (16 bytes per factor). Multiply's factor
    ;; comparator stages nothing; Add's collection and term order do.
    (local.set $stage_a (i32.const 0))
    (if (i32.eqz (local.get $is_multiply))
      (then
        (local.set $max_entries (i32.const 1))
        (local.set $i (i32.const 0))
        (block $measure_done
          (loop $measure
            (br_if $measure_done (i32.ge_u (local.get $i) (local.get $final_count)))
            (drop (call $term_split (i32.add
              (i32.add (local.get $new_data) (global.get $GC_HEADER_SIZE))
              (i32.mul (local.get $i) (global.get $VALUE_SIZE)))))
            (if (i32.gt_u (global.get $term_factors_count) (local.get $max_entries))
              (then (local.set $max_entries (global.get $term_factors_count))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $measure)))
        (if (call $expression_walk_guard
              (i32.add (i32.mul (local.get $max_entries) (i32.const 32)) (i32.const 16)))
          (then (return (i32.const 1))))
        (local.set $stage_a (call $carve_scratch_blob
          (i32.mul (local.get $max_entries) (i32.const 32))))

        (if (i32.eqz (local.get $has_undefined_term))
          (then
        ;; Collect like terms: group by collapsed factor list, sum
        ;; coefficients, drop zeroes, compact.
        (local.set $collected (call $expression_collect_terms
          (i32.add (local.get $new_data) (global.get $GC_HEADER_SIZE))
          (local.get $final_count)
          (local.get $stage_a)
          (i32.add (local.get $stage_a)
            (i32.mul (local.get $max_entries) (i32.const 16)))
          (local.get $max_entries)))
        (if (i32.lt_s (local.get $collected) (i32.const 0))
          (then (return (i32.const 1))))
        (local.set $final_count (local.get $collected))
        ;; Everything cancelled → 0; a single survivor collapses.
        (if (i32.eqz (local.get $final_count))
          (then
            (call $expression_write_zero (local.get $dest_slot))
            (return (i32.const 0))))
        (if (i32.eq (local.get $final_count) (i32.const 1))
          (then
            (memory.copy
              (call $abs (local.get $dest_slot))
              (call $abs (i32.add (local.get $new_data) (global.get $GC_HEADER_SIZE)))
              (global.get $VALUE_SIZE))
            (return (i32.const 0))))
        ;; Shrink the array's live length over any dropped terms
        ;; (capacity keeps the original emit size).
        (i32.store (call $abs (i32.add (local.get $new_array) (i32.const 8)))
          (local.get $final_count))))))

    ;; Canonical order. Multiply args sort in monomial-factor order
    ;; (coefficient first, base ascending, exponent descending); Add
    ;; terms sort in canonical monomial order (lex on exponent vectors,
    ;; constant term last). Ring 2's numerics-first class order is
    ;; subsumed by both.
    (if (call $expression_sort_slots
          (i32.add (local.get $new_data) (global.get $GC_HEADER_SIZE))
          (local.get $final_count)
          (local.get $is_multiply)
          (local.get $stage_a)
          (i32.add (local.get $stage_a)
            (i32.mul (local.get $max_entries) (i32.const 16)))
          (local.get $max_entries))
      (then (return (i32.const 1))))

    ;; Ring 3 (3b): same-base power combination on the sorted Multiply
    ;; args (equal bases are adjacent under factor order):
    ;; Power(a, n)·Power(a, m) → Power(a, n+m), a·a → Power(a, 2),
    ;; a·Power(a, -1) → gone.
    ;; Do not combine a retained zero with its formal reciprocal: their
    ;; exponents cancel algebraically, but the product is undefined.
    (if (i32.and
          (local.get $is_multiply)
          (i32.eqz (local.get $has_undefined_term)))
      (then
        (local.set $collected (call $expression_merge_power_runs
          (i32.add (local.get $new_data) (global.get $GC_HEADER_SIZE))
          (local.get $final_count)))
        (if (i32.lt_s (local.get $collected) (i32.const 0))
          (then (return (i32.const 1))))
        (if (i32.ne (local.get $collected) (local.get $final_count))
          (then
            (local.set $final_count (local.get $collected))
            (if (i32.eqz (local.get $final_count))
              (then
                (call $expression_write_one (local.get $dest_slot))
                (return (i32.const 0))))
            (if (i32.eq (local.get $final_count) (i32.const 1))
              (then
                (memory.copy
                  (call $abs (local.get $dest_slot))
                  (call $abs (i32.add (local.get $new_data) (global.get $GC_HEADER_SIZE)))
                  (global.get $VALUE_SIZE))
                (return (i32.const 0))))
            (i32.store (call $abs (i32.add (local.get $new_array) (i32.const 8)))
              (local.get $final_count))))
        ;; Same-exponent radical combination follows same-base merging.
        (local.set $collected (call $expression_merge_equal_exponents
          (i32.add (local.get $new_data) (global.get $GC_HEADER_SIZE))
          (local.get $final_count)))
        (if (i32.lt_s (local.get $collected) (i32.const 0))
          (then (return (i32.const 1))))
        (if (i32.ne (local.get $collected) (local.get $final_count))
          (then
            (local.set $final_count (local.get $collected))
            (if (i32.eqz (local.get $final_count))
              (then
                (call $expression_write_one (local.get $dest_slot))
                (return (i32.const 0))))
            (if (i32.eq (local.get $final_count) (i32.const 1))
              (then
                (memory.copy
                  (call $abs (local.get $dest_slot))
                  (call $abs (i32.add
                    (local.get $new_data) (global.get $GC_HEADER_SIZE)))
                  (global.get $VALUE_SIZE))
                (return (i32.const 0))))
            (i32.store
              (call $abs (i32.add (local.get $new_array) (i32.const 8)))
              (local.get $final_count))))
        ;; Ring 3 (3d): GCD cancellation over the desugared Divide
        ;; shape — Multiply(numerator…, Power(denominator, -k)…).
        (local.set $collected (call $multiply_divide_cancellation
          (i32.add (local.get $new_data) (global.get $GC_HEADER_SIZE))
          (local.get $final_count)
          (local.get $dest_slot)))
        (if (i32.eq (local.get $collected) (i32.const 1))
          (then (return (i32.const 1))))
        (if (i32.eq (local.get $collected) (i32.const 2))
          (then (return (i32.const 0))))))

    ;; Build the Expression and write into dest.
    (local.set $new_expression (call $expression_build
      (local.get $head_sym) (local.get $new_array)))
    (i32.store (call $abs (local.get $dest_slot)) (global.get $TYPE_EXPRESSION))
    (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 4))) (i32.const 0))
    (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 8))) (local.get $new_expression))
    (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 12))) (i32.const 0))
    (i32.const 0)
  )

  ;; Classify a value subtree for the radical decision pass.
  ;; Bit 0: entirely in fromExpression's exact-real input language.
  ;; Bit 1: contains at least one genuinely fractional Power exponent.
  ;; A maximal subtree is eligible exactly when the result is 3.
  (func $expression_numeric_radical_shape (param $slot i32) (result i32)
    (local $type i32)
    (local $header i32)
    (local $head i32)
    (local $arguments_array i32)
    (local $argument_count i32)
    (local $arguments_data i32)
    (local $argument_shape i32)
    (local $result i32)
    (local $index i32)
    (local $exponent_slot i32)
    (local $exponent_type i32)
    (local.set $type (call $value_type (local.get $slot)))
    (if (i32.or
          (i32.eq (local.get $type) (global.get $TYPE_BIGINT))
          (i32.or
            (i32.eq (local.get $type) (global.get $TYPE_RATIONAL))
            (i32.eq (local.get $type) (global.get $TYPE_ALGEBRAIC))))
      (then (return (i32.const 1))))
    (if (i32.ne (local.get $type) (global.get $TYPE_EXPRESSION))
      (then (return (i32.const 0))))
    (local.set $header (call $value_data_lo (local.get $slot)))
    (local.set $head (call $expression_head (local.get $header)))
    (local.set $arguments_array (call $expression_args (local.get $header)))
    (local.set $argument_count
      (i32.load (call $abs (i32.add (local.get $arguments_array) (i32.const 8)))))
    (local.set $arguments_data (i32.add
      (i32.load (call $abs (i32.add (local.get $arguments_array) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (if (i32.eq (local.get $head) (call $symbol_registry_lookup
          (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_POWER))))
      (then
        (if (i32.ne (local.get $argument_count) (i32.const 2))
          (then (return (i32.const 0))))
        (local.set $argument_shape
          (call $expression_numeric_radical_shape (local.get $arguments_data)))
        (if (i32.eqz (local.get $argument_shape))
          (then (return (i32.const 0))))
        (local.set $exponent_slot
          (i32.add (local.get $arguments_data) (global.get $VALUE_SIZE)))
        (local.set $exponent_type (call $value_type (local.get $exponent_slot)))
        (if (i32.eq (local.get $exponent_type) (global.get $TYPE_BIGINT))
          (then (return (local.get $argument_shape))))
        (if (i32.ne (local.get $exponent_type) (global.get $TYPE_RATIONAL))
          (then (return (i32.const 0))))
        (if (call $rational_is_inline (local.get $exponent_slot))
          (then (return (local.get $argument_shape))))
        (if (call $rational_denominator_is_one
              (call $value_data_lo (local.get $exponent_slot)))
          (then (return (local.get $argument_shape))))
        (return (i32.or (local.get $argument_shape) (i32.const 2)))))
    (if (i32.eqz (local.get $argument_count))
      (then (return (i32.const 0))))
    (if (i32.eq (local.get $head) (call $symbol_registry_lookup
          (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_NEGATE))))
      (then
        (if (i32.ne (local.get $argument_count) (i32.const 1))
          (then (return (i32.const 0)))))
      (else
        (if (i32.or
              (i32.eq (local.get $head) (call $symbol_registry_lookup
                (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_SUBTRACT))))
              (i32.eq (local.get $head) (call $symbol_registry_lookup
                (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_DIVIDE)))))
          (then
            (if (i32.ne (local.get $argument_count) (i32.const 2))
              (then (return (i32.const 0)))))
          (else
            (if (i32.eqz (i32.or
                  (i32.eq (local.get $head) (call $symbol_registry_lookup
                    (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_ADD))))
                  (i32.eq (local.get $head) (call $symbol_registry_lookup
                    (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY))))))
              (then (return (i32.const 0))))))))

    (local.set $result (i32.const 1))
    (local.set $index (i32.const 0))
    (block $arguments_done
      (loop $arguments
        (br_if $arguments_done
          (i32.ge_u (local.get $index) (local.get $argument_count)))
        (local.set $argument_shape (call $expression_numeric_radical_shape
          (i32.add (local.get $arguments_data)
            (i32.mul (local.get $index) (global.get $VALUE_SIZE)))))
        (if (i32.eqz (local.get $argument_shape))
          (then (return (i32.const 0))))
        (local.set $result (i32.or (local.get $result) (local.get $argument_shape)))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $arguments)))
    (local.get $result)
  )
  ;; Fold Exp(i * Pi * q), q rational, through the existing exact
  ;; cosine/sine-of-turns engine. Returns 0 when the shape does not match,
  ;; 1 after writing the exact result, and 2 on pressure.
  (func $expression_fold_root_of_unity
    (param $argument_slot i32) (param $destination_slot i32) (result i32)
    (local $expression_pointer i32)
    (local $args_array i32)
    (local $data i32)
    (local $coefficient_slot i32)
    (local $pi_slot i32)
    (local $complex_header i32)
    (local $real_slot i32)
    (local $imaginary_slot i32)
    (local $turns_slot i32)
    (local $cosine_slot i32)
    (local $sine_slot i32)
    (local $saved_pending i32)
    (local $status i32)
    (if (i32.ne (call $value_type (local.get $argument_slot))
          (global.get $TYPE_EXPRESSION))
      (then (return (i32.const 0))))
    (local.set $expression_pointer (call $value_data_lo (local.get $argument_slot)))
    (if (i32.ne
          (call $symbol_description
            (call $expression_head (local.get $expression_pointer)))
          (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)))
      (then (return (i32.const 0))))
    (local.set $args_array (call $expression_args (local.get $expression_pointer)))
    (if (i32.ne
          (i32.load (call $abs (i32.add (local.get $args_array) (i32.const 8))))
          (i32.const 2))
      (then (return (i32.const 0))))
    (local.set $data (i32.add
      (i32.load (call $abs (i32.add (local.get $args_array) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))
    (local.set $coefficient_slot (local.get $data))
    (local.set $pi_slot (i32.add (local.get $data) (global.get $VALUE_SIZE)))
    (if (i32.or
          (i32.ne (call $value_type (local.get $coefficient_slot))
            (global.get $TYPE_COMPLEX))
          (i32.or
            (i32.ne (call $value_type (local.get $pi_slot))
              (global.get $TYPE_SYMBOL))
            (i32.ne
              (call $symbol_description (call $value_data_lo (local.get $pi_slot)))
              (call $read_builtin (global.get $BUILTIN_EXACT_CONSTANT_PI)))))
      (then (return (i32.const 0))))
    (if (call $expression_walk_guard (i32.const 1024))
      (then (return (i32.const 2))))
    (local.set $real_slot (call $carve_scratch_blob (i32.const 80)))
    (local.set $imaginary_slot (i32.add (local.get $real_slot) (i32.const 16)))
    (local.set $turns_slot (i32.add (local.get $real_slot) (i32.const 32)))
    (local.set $cosine_slot (i32.add (local.get $real_slot) (i32.const 48)))
    (local.set $sine_slot (i32.add (local.get $real_slot) (i32.const 64)))
    (local.set $complex_header (call $value_data_lo (local.get $coefficient_slot)))
    (call $write_value (local.get $real_slot)
      (global.get $TYPE_RATIONAL) (i32.const 0)
      (call $complex_real (local.get $complex_header)) (i32.const 0))
    (if (i32.eqz (call $rational_is_zero (local.get $real_slot)))
      (then (return (i32.const 0))))
    (call $write_value (local.get $imaginary_slot)
      (global.get $TYPE_RATIONAL) (i32.const 0)
      (call $complex_imaginary (local.get $complex_header)) (i32.const 0))
    (call $write_value (local.get $turns_slot)
      (global.get $TYPE_RATIONAL) (i32.const 0)
      (call $rational_div
        (call $complex_imaginary (local.get $complex_header))
        (call $rational_new
          (call $bigint_from_i64 (i64.const 2)) (call $bigint_one)))
      (i32.const 0))
    (local.set $saved_pending
      (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (memory.copy (call $abs (local.get $cosine_slot))
      (call $abs (local.get $turns_slot)) (global.get $VALUE_SIZE))
    (call $write_ctx (global.get $CTX_PENDING_POINTER)
      (i32.add (local.get $cosine_slot) (global.get $VALUE_SIZE)))
    (local.set $status (call $algebraic_turns_method
      (global.get $TYPE_OBJECT) (i32.const 0)
      (global.get $METHOD_EXACT_ALGEBRAIC_COSINE_OF_TURNS)
      (i32.const 1) (local.get $cosine_slot)))
    (if (local.get $status)
      (then
        (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $saved_pending))
        (return (i32.const 2))))
    (memory.copy (call $abs (local.get $sine_slot))
      (call $abs (local.get $turns_slot)) (global.get $VALUE_SIZE))
    (call $write_ctx (global.get $CTX_PENDING_POINTER)
      (i32.add (local.get $sine_slot) (global.get $VALUE_SIZE)))
    (local.set $status (call $algebraic_turns_method
      (global.get $TYPE_OBJECT) (i32.const 0)
      (global.get $METHOD_EXACT_ALGEBRAIC_SINE_OF_TURNS)
      (i32.const 1) (local.get $sine_slot)))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $saved_pending))
    (if (local.get $status) (then (return (i32.const 2))))
    (if (call $complex_algebraic_write_result
          (local.get $cosine_slot) (local.get $sine_slot)
          (local.get $destination_slot))
      (then (return (i32.const 2))))
    (i32.const 1)
  )

  ;; Top-level simplifier. Given a source value slot, write the simplified
  ;; version into dest_slot. Returns walk status: 0 ok, 1 pressure-abort.
  (func $expression_simplify_into (param $src_slot i32) (param $dest_slot i32) (result i32)
    (call $expression_simplify_into_mode
      (local.get $src_slot) (local.get $dest_slot) (i32.const 1))
  )

  ;; Internal form carries whether this node is the root of a maximal
  ;; simplifiable region. Numeric-radical parents suppress speculative work in
  ;; their children so one exact evaluation covers the whole subtree.
  (func $expression_simplify_into_mode
    (param $src_slot i32) (param $dest_slot i32) (param $allow_radical_fold i32)
    (result i32)
    (if (i32.ne (call $value_type (local.get $src_slot)) (global.get $TYPE_EXPRESSION))
      (then
        (memory.copy
          (call $abs (local.get $dest_slot))
          (call $abs (local.get $src_slot))
          (global.get $VALUE_SIZE))
        (return (i32.const 0))))
    (if (call $expression_simplify_tree
          (call $value_data_lo (local.get $src_slot))
          (local.get $dest_slot)
          (local.get $allow_radical_fold))
      (then (return (i32.const 1))))
    ;; A fold whose Euler
    ;; arithmetic ends in a Complex with an exactly zero imaginary part
    ;; realizes to its real part, so every consumer (including
    ;; toApproximation's classification) sees the canonical real value.
    (if (i32.eq (call $value_type (local.get $dest_slot)) (global.get $TYPE_COMPLEX))
      (then
        (if (i32.eqz (call $bigint_length (call $rational_numerator
              (call $complex_imaginary (call $value_data_lo (local.get $dest_slot))))))
          (then
            (call $write_value (local.get $dest_slot)
              (global.get $TYPE_RATIONAL) (i32.const 0)
              (call $complex_real (call $value_data_lo (local.get $dest_slot)))
              (i32.const 0))))))
    (i32.const 0)
  )

  ;; Simplify an Expression. Walks children bottom-up, then applies 2d.1
  ;; identity rules on the simplified form. Returns walk status: 0 ok,
  ;; 1 pressure-abort.
  (func $expression_simplify_tree
    (param $expression_pointer i32)
    (param $dest_slot i32)
    (param $allow_radical_fold i32)
    (result i32)
    (local $head i32)
    (local $args_array i32)
    (local $length i32)
    (local $old_data i32)
    (local $new_array i32)
    (local $new_data i32)
    (local $new_size i32)
    (local $new_aligned i32)
    (local $i i32)
    (local $src_element i32)
    (local $dest_element i32)
    (local $new_expression i32)
    (local $head_description i32)
    (local $first_arg_slot i32)
    (local $second_arg_slot i32)
    (local $exponent_class i32)
    (local $exp_bigint i32)
    (local $abs_exp i32)
    (local $result_header i32)
    (local $inner_args i32)
    (local $inner_data i32)
    (local $work_array i32)
    (local $work_data i32)
    (local $work_aligned i32)
    (local $accumulator i32)
    (local $predicted i64)
    (local $exponent_value i64)
    (local $radical_shape i32)
    (local $radical_checkpoint i32)
    (local $radical_out_slot i32)
    (local $radical_status i32)
    (local $root_of_unity_status i32)

    (local.set $head (call $expression_head (local.get $expression_pointer)))
    (local.set $args_array (call $expression_args (local.get $expression_pointer)))
    (local.set $length (i32.load (call $abs (i32.add (local.get $args_array) (i32.const 8)))))
    (local.set $old_data (i32.load (call $abs (i32.add (local.get $args_array) (i32.const 16)))))
    (call $write_value (local.get $dest_slot)
      (global.get $TYPE_EXPRESSION) (i32.const 0)
      (local.get $expression_pointer) (i32.const 0))
    (local.set $radical_shape
      (call $expression_numeric_radical_shape (local.get $dest_slot)))

    ;; Per-node admission: the fresh args Array below is this node's
    ;; size-parametrized carve; the walk floor absorbs the fixed rest.
    (local.set $new_size (i32.add (global.get $GC_HEADER_SIZE)
      (i32.mul (local.get $length) (global.get $VALUE_SIZE))))
    (local.set $new_aligned (i32.and
      (i32.add (local.get $new_size) (i32.const 15))
      (i32.const -16)))
    (if (call $expression_walk_guard (local.get $new_aligned))
      (then (return (i32.const 1))))

    ;; Allocate a fresh args Array for simplified children (same pattern as
    ;; substitute: always build fresh). Kept even for zero-length so
    ;; downstream head-rules (like collapsing Add()) can examine the shape.
    (local.set $new_array (call $read_state (global.get $STATE_HEAP_POINTER)))
    (local.set $new_data (call $write_array_header
      (local.get $new_array) (local.get $length) (local.get $length) (local.get $new_aligned)))
    (call $write_state (global.get $STATE_HEAP_POINTER)
      (i32.add (local.get $new_data) (local.get $new_aligned)))

    ;; Recurse on each arg.
    (local.set $i (i32.const 0))
    (block $done
      (loop $walk
        (br_if $done (i32.ge_u (local.get $i) (local.get $length)))
        (local.set $src_element (i32.add
          (i32.add (local.get $old_data) (global.get $GC_HEADER_SIZE))
          (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
        (local.set $dest_element (i32.add
          (i32.add (local.get $new_data) (global.get $GC_HEADER_SIZE))
          (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
        (if (call $expression_simplify_into_mode
              (local.get $src_element)
              (local.get $dest_element)
              (i32.ne (local.get $radical_shape) (i32.const 3)))
          (then (return (i32.const 1))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $walk)
      )
    )
    ;; Decide one maximal numeric-radical subtree exactly. Rational-valued
    ;; results replace the tree. Irrational or invalid-domain results leave the
    ;; symbolic form for the ordinary canonical rules below.
    (if (i32.and
          (local.get $allow_radical_fold)
          (i32.eq (local.get $radical_shape) (i32.const 3)))
      (then
        (local.set $radical_checkpoint
          (call $read_state (global.get $STATE_HEAP_POINTER)))
        (local.set $new_expression
          (call $expression_build (local.get $head) (local.get $new_array)))
        (call $write_value (local.get $dest_slot)
          (global.get $TYPE_EXPRESSION) (i32.const 0)
          (local.get $new_expression) (i32.const 0))
        (if (call $expression_walk_guard (i32.add (global.get $VALUE_SIZE) (i32.const 32)))
          (then
            (call $write_state
              (global.get $STATE_HEAP_POINTER) (local.get $radical_checkpoint))
            (return (i32.const 1))))
        (local.set $radical_out_slot
          (call $carve_scratch_blob (global.get $VALUE_SIZE)))
        (local.set $radical_status (call $algebraic_evaluate_node
          (local.get $dest_slot) (local.get $radical_out_slot) (i32.const 1)))
        (if (i32.eq (local.get $radical_status) (i32.const 1))
          (then
            (call $write_state
              (global.get $STATE_HEAP_POINTER) (local.get $radical_checkpoint))
            (return (i32.const 1))))
        (if (i32.and
              (i32.eqz (local.get $radical_status))
              (i32.or
                (i32.eq (call $value_type (local.get $radical_out_slot))
                  (global.get $TYPE_RATIONAL))
                (i32.eq (call $value_type (local.get $radical_out_slot))
                  (global.get $TYPE_BIGINT))))
          (then
            (memory.copy
              (call $abs (local.get $dest_slot))
              (call $abs (local.get $radical_out_slot))
              (global.get $VALUE_SIZE))
            (return (i32.const 0))))
        (call $write_state
          (global.get $STATE_HEAP_POINTER) (local.get $radical_checkpoint))))

    ;; Identity rules operate on the simplified children in new_data.
    ;; For quick access, precompute pointers to the first two arg slots.
    (local.set $first_arg_slot (i32.add (local.get $new_data) (global.get $GC_HEADER_SIZE)))
    (local.set $second_arg_slot (i32.add (local.get $first_arg_slot) (global.get $VALUE_SIZE)))

    ;; Look up the head's description string to dispatch on rule.
    (local.set $head_description (call $symbol_description (local.get $head)))
    ;; Exp(i * Pi * q) is a root of unity for rational q.
    (if (i32.and
          (i32.eq (local.get $head_description)
            (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_EXP)))
          (i32.eq (local.get $length) (i32.const 1)))
      (then
        (local.set $root_of_unity_status
          (call $expression_fold_root_of_unity
            (local.get $first_arg_slot) (local.get $dest_slot)))
        (if (i32.eq (local.get $root_of_unity_status) (i32.const 2))
          (then (return (i32.const 1))))
        (if (i32.eq (local.get $root_of_unity_status) (i32.const 1))
          (then (return (i32.const 0))))))
    ;; Exp(0) is the multiplicative identity.
    (if (i32.and
          (i32.eq (local.get $head_description)
            (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_EXP)))
          (i32.and
            (i32.eq (local.get $length) (i32.const 1))
            (i32.eq (call $algebraic_slot_is_exact_zero
              (local.get $first_arg_slot)) (i32.const 1))))
      (then
        (call $write_inline_rational (local.get $dest_slot) (i64.const 1))
        (return (i32.const 0))))

    ;; Ring 2 (2d.3): Subtract / Divide desugar. Rewrite to Add(a, Negate(b))
    ;; or Multiply(a, Power(b, -1)) so the Add/Multiply canonicalizer handles
    ;; the rest (flatten into surrounding Add/Multiply, fold constants, etc.).
    ;; The raw user-written tree preserves Subtract/Divide; this rewrite only
    ;; fires at simplify time.
    (if (i32.and
          (i32.eq (local.get $head_description)
                  (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_SUBTRACT)))
          (i32.eq (local.get $length) (i32.const 2)))
      (then
        (return (call $expression_desugar_subtract
          (local.get $first_arg_slot) (local.get $second_arg_slot) (local.get $dest_slot)))))
    (if (i32.and
          (i32.eq (local.get $head_description)
                  (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_DIVIDE)))
          (i32.eq (local.get $length) (i32.const 2)))
      (then
        (return (call $expression_desugar_divide
          (local.get $first_arg_slot) (local.get $second_arg_slot) (local.get $dest_slot)))))

    ;; Identity rules — each is an independent (if head==X (then ...))
    ;; block that returns early on a match. Flat structure avoids deep
    ;; nesting and the paren-balancing hazards it brings.

    ;; Rule: Negate(numeric) → -numeric. Folds Negate applied to a pure
    ;; numeric operand into the negated value.
    (if (i32.and
          (i32.eq (local.get $head_description)
                  (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_NEGATE)))
          (i32.and
            (i32.eq (local.get $length) (i32.const 1))
            (call $expression_slot_is_numeric (local.get $first_arg_slot))))
      (then
        ;; Compute via Multiply(-1, x) fold path — promotes types correctly.
        (return (call $expression_negate_numeric
          (local.get $first_arg_slot) (local.get $dest_slot)))))

    ;; Rule: Negate(Negate(x)) → x.
    (if (i32.and
          (i32.eq (local.get $head_description)
                  (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_NEGATE)))
          (i32.and
            (i32.eq (local.get $length) (i32.const 1))
            (i32.eq (call $value_type (local.get $first_arg_slot))
                    (global.get $TYPE_EXPRESSION))))
      (then
        (if (i32.eq
              (call $symbol_description (call $expression_head
                (call $value_data_lo (local.get $first_arg_slot))))
              (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_NEGATE)))
          (then
            (local.set $args_array (call $expression_args
              (call $value_data_lo (local.get $first_arg_slot))))
            (if (i32.eq (i32.load (call $abs
                  (i32.add (local.get $args_array) (i32.const 8)))) (i32.const 1))
              (then
                (local.set $old_data (i32.load (call $abs
                  (i32.add (local.get $args_array) (i32.const 16)))))
                (memory.copy
                  (call $abs (local.get $dest_slot))
                  (call $abs (i32.add (local.get $old_data) (global.get $GC_HEADER_SIZE)))
                  (global.get $VALUE_SIZE))
                (return (i32.const 0))))))))

    ;; Ring 3 (3a): Negate(x) for any remaining x → Multiply(-1, x), so
    ;; subtraction participates in monomial collection (x - x → 0) and
    ;; the -1 coefficient is visible to the polynomial machinery.
    ;; Negate(numeric) folded above; Negate(Negate(x)) unwrapped above.
    ;; The Multiply canonicalizer then flattens and folds, so
    ;; Negate(Multiply(2, x)) lands directly at Multiply(-2, x).
    (if (i32.and
          (i32.eq (local.get $head_description)
                  (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_NEGATE)))
          (i32.eq (local.get $length) (i32.const 1)))
      (then
        (local.set $new_array (call $read_state (global.get $STATE_HEAP_POINTER)))
        (local.set $new_size (i32.add (global.get $GC_HEADER_SIZE)
          (i32.mul (i32.const 2) (global.get $VALUE_SIZE))))
        (local.set $new_aligned (i32.and
          (i32.add (local.get $new_size) (i32.const 15))
          (i32.const -16)))
        (local.set $new_data (call $write_array_header
          (local.get $new_array) (i32.const 2) (i32.const 2) (local.get $new_aligned)))
        (call $write_state (global.get $STATE_HEAP_POINTER)
          (i32.add (local.get $new_data) (local.get $new_aligned)))
        (local.set $src_element (i32.add (local.get $new_data) (global.get $GC_HEADER_SIZE)))
        (i32.store (call $abs (local.get $src_element)) (global.get $TYPE_RATIONAL))
        (i32.store (call $abs (i32.add (local.get $src_element) (i32.const 4)))
          (global.get $FLAG_RATIONAL_INLINE))
        (i32.store (call $abs (i32.add (local.get $src_element) (i32.const 8))) (i32.const -1))
        (i32.store (call $abs (i32.add (local.get $src_element) (i32.const 12))) (i32.const -1))
        (memory.copy
          (call $abs (i32.add (local.get $src_element) (global.get $VALUE_SIZE)))
          (call $abs (local.get $first_arg_slot))
          (global.get $VALUE_SIZE))
        (return (call $expression_canonicalize_flat
          (call $symbol_registry_lookup
            (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)))
          (local.get $new_array)
          (i32.const 1)
          (local.get $dest_slot)))))

    ;; Ring 4 (4b) + Ring 5 (5a): Conjugate rules. Numeric and Matrix
    ;; atoms fold; Conjugate(Conjugate(x)) collapses; distribution
    ;; pushes Conjugate through Add, Multiply, and integer-exponent
    ;; Power down to the atoms (owed by Ring 4's Q5). What remains —
    ;; Conjugate(Symbol) and Conjugate over opaque heads — stays
    ;; symbolic, an honorary atom to collection.

    ;; Rule: Conjugate(numeric) → conjugated numeric. Identity on
    ;; Rational/BigInt; flips the imaginary component on Complex.
    ;; Users can build Conjugate(Complex(...)) via Expression.make
    ;; directly, and every other head folds numeric arguments.
    (if (i32.and
          (i32.eq (local.get $head_description)
                  (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_CONJUGATE)))
          (i32.and
            (i32.eq (local.get $length) (i32.const 1))
            (call $expression_slot_is_numeric (local.get $first_arg_slot))))
      (then
        (return (call $expression_conjugate_numeric
          (local.get $first_arg_slot) (local.get $dest_slot)))))

    ;; Rule: Conjugate(Conjugate(x)) → x.
    (if (i32.and
          (i32.eq (local.get $head_description)
                  (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_CONJUGATE)))
          (i32.and
            (i32.eq (local.get $length) (i32.const 1))
            (i32.eq (call $value_type (local.get $first_arg_slot))
                    (global.get $TYPE_EXPRESSION))))
      (then
        (if (i32.eq
              (call $symbol_description (call $expression_head
                (call $value_data_lo (local.get $first_arg_slot))))
              (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_CONJUGATE)))
          (then
            (local.set $args_array (call $expression_args
              (call $value_data_lo (local.get $first_arg_slot))))
            (if (i32.eq (i32.load (call $abs
                  (i32.add (local.get $args_array) (i32.const 8)))) (i32.const 1))
              (then
                (local.set $old_data (i32.load (call $abs
                  (i32.add (local.get $args_array) (i32.const 16)))))
                (memory.copy
                  (call $abs (local.get $dest_slot))
                  (call $abs (i32.add (local.get $old_data) (global.get $GC_HEADER_SIZE)))
                  (global.get $VALUE_SIZE))
                (return (i32.const 0))))))))

    ;; Ring 5 (5a): Conjugate(Matrix atom) → entry-conjugated Matrix
    ;; (conjugateTranspose minus the transpose). Completes the
    ;; numeric-fold story for honorary atoms.
    (if (i32.and
          (i32.eq (local.get $head_description)
                  (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_CONJUGATE)))
          (i32.and
            (i32.eq (local.get $length) (i32.const 1))
            (i32.eq (call $value_type (local.get $first_arg_slot))
                    (global.get $TYPE_MATRIX))))
      (then
        (local.set $result_header (call $value_data_lo (local.get $first_arg_slot)))
        (local.set $i (i32.mul
          (call $matrix_rows_of (local.get $result_header))
          (call $matrix_columns_of (local.get $result_header))))
        (if (call $expression_walk_guard
              (i32.add (call $estimate_array_size (local.get $i)) (i32.const 96)))
          (then (return (i32.const 1))))
        (local.set $work_array (call $allocate_array (local.get $i)))
        (local.set $work_data (i32.load (call $abs (i32.add (local.get $work_array) (i32.const 16)))))
        (local.set $old_data (i32.load (call $abs (i32.add
          (call $matrix_entries_of (local.get $result_header)) (i32.const 16)))))
        (local.set $src_element (i32.const 0))
        (block $conj_entries_done
          (loop $conj_entries
            (br_if $conj_entries_done (i32.ge_u (local.get $src_element) (local.get $i)))
            (if (call $matrix_entry_unary (i32.const 1)
                  (i32.add
                    (i32.add (local.get $old_data) (global.get $GC_HEADER_SIZE))
                    (i32.mul (local.get $src_element) (global.get $VALUE_SIZE)))
                  (i32.add
                    (i32.add (local.get $work_data) (global.get $GC_HEADER_SIZE))
                    (i32.mul (local.get $src_element) (global.get $VALUE_SIZE))))
              (then (return (i32.const 1))))
            (local.set $src_element (i32.add (local.get $src_element) (i32.const 1)))
            (br $conj_entries)))
        (call $expression_freeze_args_array (local.get $work_array))
        (i32.store (call $abs (local.get $dest_slot)) (global.get $TYPE_MATRIX))
        (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 4))) (i32.const 0))
        (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 8)))
          (call $matrix_allocate
            (call $matrix_rows_of (local.get $result_header))
            (call $matrix_columns_of (local.get $result_header))
            (local.get $work_array)))
        (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 12))) (i32.const 0))
        (return (i32.const 0))))

    ;; Ring 5 (5a): Conjugate(Power(b, n)) → Power(Conjugate(b), n)
    ;; for integer-classed n, positive or negative — real integer
    ;; exponents commute with conjugation. Rational and symbolic
    ;; exponents stay opaque (branch-cut territory).
    (if (i32.and
          (i32.eq (local.get $head_description)
                  (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_CONJUGATE)))
          (i32.and
            (i32.eq (local.get $length) (i32.const 1))
            (i32.eq (call $value_type (local.get $first_arg_slot))
                    (global.get $TYPE_EXPRESSION))))
      (then
        (if (i32.eq
              (call $symbol_description (call $expression_head
                (call $value_data_lo (local.get $first_arg_slot))))
              (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_POWER)))
          (then
            (local.set $inner_args (call $expression_args
              (call $value_data_lo (local.get $first_arg_slot))))
            (if (i32.eq (i32.load (call $abs
                  (i32.add (local.get $inner_args) (i32.const 8)))) (i32.const 2))
              (then
                (local.set $inner_data (i32.add
                  (i32.load (call $abs (i32.add (local.get $inner_args) (i32.const 16))))
                  (global.get $GC_HEADER_SIZE)))
                (if (i32.ne (call $power_exponent_class
                      (i32.add (local.get $inner_data) (global.get $VALUE_SIZE)))
                    (i32.const 0))
                  (then
                    ;; Stage Conjugate(base) in a committed slot and
                    ;; simplify it (folding/distribution recurse), then
                    ;; rebuild Power and re-simplify in place so the
                    ;; Power rules see the conjugated base.
                    (if (call $expression_walk_guard (i32.const 224))
                      (then (return (i32.const 1))))
                    (local.set $accumulator (call $carve_scratch_blob (global.get $VALUE_SIZE)))
                    (i32.store (call $abs (local.get $accumulator)) (global.get $TYPE_EXPRESSION))
                    (i32.store (call $abs (i32.add (local.get $accumulator) (i32.const 4)))
                      (i32.const 0))
                    (i32.store (call $abs (i32.add (local.get $accumulator) (i32.const 8)))
                      (call $expression_build
                        (local.get $head)
                        (call $expression_alloc_args1 (local.get $inner_data))))
                    (i32.store (call $abs (i32.add (local.get $accumulator) (i32.const 12)))
                      (i32.const 0))
                    (if (call $expression_simplify_into
                          (local.get $accumulator) (local.get $accumulator))
                      (then (return (i32.const 1))))
                    (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_POWER)
                      (local.get $accumulator)
                      (i32.add (local.get $inner_data) (global.get $VALUE_SIZE))
                      (local.get $dest_slot))
                    (return (call $expression_simplify_into
                      (local.get $dest_slot) (local.get $dest_slot)))))))))))

    ;; Ring 5 (5a): Conjugate distributes over Add and Multiply —
    ;; Conjugate(Add(a, …)) → Add(Conjugate(a), …). Each child
    ;; conjugate re-simplifies (numeric folds, nested distribution),
    ;; then the canonicalizer flattens/folds/sorts. Owed to Ring 5 by
    ;; Ring 4's Q5.
    (if (i32.and
          (i32.eq (local.get $head_description)
                  (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_CONJUGATE)))
          (i32.and
            (i32.eq (local.get $length) (i32.const 1))
            (i32.eq (call $value_type (local.get $first_arg_slot))
                    (global.get $TYPE_EXPRESSION))))
      (then
        ;; exponent_class doubles as the canonicalize mode here:
        ;; 0 = Add, 1 = Multiply, -1 = neither (rule does not fire).
        (local.set $exponent_class (i32.const -1))
        (if (i32.eq
              (call $symbol_description (call $expression_head
                (call $value_data_lo (local.get $first_arg_slot))))
              (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_ADD)))
          (then (local.set $exponent_class (i32.const 0))))
        (if (i32.eq
              (call $symbol_description (call $expression_head
                (call $value_data_lo (local.get $first_arg_slot))))
              (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)))
          (then (local.set $exponent_class (i32.const 1))))
        (if (i32.ne (local.get $exponent_class) (i32.const -1))
          (then
            (local.set $inner_args (call $expression_args
              (call $value_data_lo (local.get $first_arg_slot))))
            (local.set $i (i32.load (call $abs
              (i32.add (local.get $inner_args) (i32.const 8)))))
            (local.set $inner_data (i32.add
              (i32.load (call $abs (i32.add (local.get $inner_args) (i32.const 16))))
              (global.get $GC_HEADER_SIZE)))
            ;; Outer array for the conjugated children, plus per-child
            ;; Conjugate wrapper (args1 + node) headroom; each child's
            ;; re-simplify guards its own walk.
            (local.set $work_aligned (i32.and
              (i32.add
                (i32.add (global.get $GC_HEADER_SIZE)
                  (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
                (i32.const 15))
              (i32.const -16)))
            (if (call $expression_walk_guard
                  (i32.add (i32.add (local.get $work_aligned) (i32.const 32))
                    (i32.mul (local.get $i) (i32.const 96))))
              (then (return (i32.const 1))))
            (local.set $work_array (call $read_state (global.get $STATE_HEAP_POINTER)))
            (local.set $work_data (call $write_array_header
              (local.get $work_array) (local.get $i) (local.get $i)
              (local.get $work_aligned)))
            (call $write_state (global.get $STATE_HEAP_POINTER)
              (i32.add (local.get $work_data) (local.get $work_aligned)))
            (local.set $src_element (i32.const 0))
            (block $conj_children_done
              (loop $conj_children
                (br_if $conj_children_done
                  (i32.ge_u (local.get $src_element) (local.get $i)))
                (local.set $dest_element (i32.add (local.get $work_data)
                  (i32.add (global.get $GC_HEADER_SIZE)
                    (i32.mul (local.get $src_element) (global.get $VALUE_SIZE)))))
                (i32.store (call $abs (local.get $dest_element))
                  (global.get $TYPE_EXPRESSION))
                (i32.store (call $abs (i32.add (local.get $dest_element) (i32.const 4)))
                  (i32.const 0))
                (i32.store (call $abs (i32.add (local.get $dest_element) (i32.const 8)))
                  (call $expression_build
                    (local.get $head)
                    (call $expression_alloc_args1
                      (i32.add (local.get $inner_data)
                        (i32.mul (local.get $src_element) (global.get $VALUE_SIZE))))))
                (i32.store (call $abs (i32.add (local.get $dest_element) (i32.const 12)))
                  (i32.const 0))
                (if (call $expression_simplify_into
                      (local.get $dest_element) (local.get $dest_element))
                  (then (return (i32.const 1))))
                (local.set $src_element (i32.add (local.get $src_element) (i32.const 1)))
                (br $conj_children)))
            (if (i32.eqz (local.get $exponent_class))
              (then (return (call $expression_canonicalize_flat
                (call $symbol_registry_lookup
                  (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_ADD)))
                (local.get $work_array) (i32.const 0) (local.get $dest_slot)))))
            (return (call $expression_canonicalize_flat
              (call $symbol_registry_lookup
                (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)))
              (local.get $work_array) (i32.const 1) (local.get $dest_slot)))))))

    ;; Rule: Power(x, 0) → 1, Power(x, 1) → x, Power(1, x) → 1.
    (if (i32.and
          (i32.eq (local.get $head_description)
                  (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_POWER)))
          (i32.eq (local.get $length) (i32.const 2)))
      (then
        (if (call $expression_value_is_zero_wide (local.get $second_arg_slot))
          (then
            (if (i32.or
                  (call $expression_value_contains_undefined
                    (i32.add (local.get $old_data) (global.get $GC_HEADER_SIZE)))
                  (call $expression_value_contains_undefined
                    (i32.add
                      (i32.add (local.get $old_data) (global.get $GC_HEADER_SIZE))
                      (global.get $VALUE_SIZE))))
              (then
                (call $write_value (local.get $dest_slot)
                  (global.get $TYPE_EXPRESSION) (i32.const 0)
                  (local.get $expression_pointer) (i32.const 0))
                (return (i32.const 0))))
            (call $expression_write_one (local.get $dest_slot))
            (return (i32.const 0))))
        (if (call $expression_value_is_one_wide (local.get $second_arg_slot))
          (then
            (memory.copy
              (call $abs (local.get $dest_slot))
              (call $abs (local.get $first_arg_slot))
              (global.get $VALUE_SIZE))
            (return (i32.const 0))))
        (if (i32.and
              (call $expression_value_is_one_wide (local.get $first_arg_slot))
              (i32.eqz (call $expression_value_contains_undefined
                (i32.add
                  (i32.add (local.get $old_data) (global.get $GC_HEADER_SIZE))
                  (global.get $VALUE_SIZE)))))
          (then (call $expression_write_one (local.get $dest_slot)) (return (i32.const 0))))))

    ;; Principal Log of exact one folds to zero.
    (if (i32.and
          (i32.eq (local.get $head_description)
                  (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_LOG)))
          (i32.eq (local.get $length) (i32.const 1)))
      (then
        (if (call $expression_value_is_one_wide (i32.add
              (i32.add (local.get $new_data) (global.get $GC_HEADER_SIZE))
              (i32.const 0)))
          (then
            (call $write_inline_rational (local.get $dest_slot) (i64.const 0))
            (return (i32.const 0))))))

    ;; Verified symbolic integration: the safe Integral rules (zero
    ;; integrand, equal bounds, linearity, constant factors out). Never
    ;; the integration search.
    (if (i32.eq (local.get $head_description)
          (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_INTEGRAL)))
      (then
        (local.set $root_of_unity_status (call $integration_simplify_integral
          (local.get $new_data) (local.get $length) (local.get $dest_slot)))
        (if (i32.eq (local.get $root_of_unity_status) (i32.const 2))
          (then (return (i32.const 1))))
        (if (i32.eq (local.get $root_of_unity_status) (i32.const 1))
          (then (return (i32.const 0))))))
    ;; Ring 3 (3b): Power rewrites. Mutually exclusive by base shape;
    ;; each returns on a match.

    ;; Power(sum, -k) for integer k >= 2 canonicalizes to
    ;; Power(expansion of sum^k, -1): Divide-lowering already produces the
    ;; reciprocal-of-expanded form, so both spellings of one value meet in
    ;; one normal form (required by the integration verification gate).
    (if (i32.and
          (i32.eq (local.get $head_description)
                  (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_POWER)))
          (i32.eq (local.get $length) (i32.const 2)))
      (then
        (local.set $first_arg_slot (i32.add
          (i32.add (local.get $new_data) (global.get $GC_HEADER_SIZE))
          (i32.const 0)))
        (local.set $second_arg_slot (i32.add (local.get $first_arg_slot)
          (global.get $VALUE_SIZE)))
        (if (i32.and
              (i32.eq (call $power_exponent_class (local.get $second_arg_slot))
                (i32.const 1))
              (i32.eq (call $value_type (local.get $first_arg_slot))
                (global.get $TYPE_EXPRESSION)))
          (then
            (if (i32.and
                  (call $approximation_head_is
                    (call $value_data_lo (local.get $first_arg_slot))
                    (global.get $BUILTIN_EXPRESSION_HEAD_ADD))
                  (i32.ge_s
                    (call $pow_exponent_value (call $bigint_abs_copy
                      (call $exponent_slot_to_bigint (local.get $second_arg_slot))))
                    (i32.const 2)))
              (then
                (if (call $expression_walk_guard (i32.const 512))
                  (then (return (i32.const 1))))
                (local.set $work_data (call $carve_scratch_blob
                  (i32.mul (i32.const 2) (global.get $VALUE_SIZE))))
                (call $write_inline_rational
                  (i32.add (local.get $work_data) (global.get $VALUE_SIZE))
                  (i64.extend_i32_s (call $pow_exponent_value (call $bigint_abs_copy
                    (call $exponent_slot_to_bigint (local.get $second_arg_slot))))))
                (if (call $build_simplified2 (global.get $BUILTIN_EXPRESSION_HEAD_POWER)
                      (local.get $first_arg_slot)
                      (i32.add (local.get $work_data) (global.get $VALUE_SIZE))
                      (local.get $work_data))
                  (then (return (i32.const 1))))
                ;; Only adopt the expansion when it actually flattened the
                ;; sum power (the cap may have kept it symbolic).
                (if (i32.eqz (i32.and
                      (i32.eq (call $value_type (local.get $work_data))
                        (global.get $TYPE_EXPRESSION))
                      (call $approximation_head_is
                        (call $value_data_lo (local.get $work_data))
                        (global.get $BUILTIN_EXPRESSION_HEAD_POWER))))
                  (then
                    (call $write_inline_rational
                      (i32.add (local.get $work_data) (global.get $VALUE_SIZE))
                      (i64.const -1))
                    (call $build_raw_expr2 (global.get $BUILTIN_EXPRESSION_HEAD_POWER)
                      (local.get $work_data)
                      (i32.add (local.get $work_data) (global.get $VALUE_SIZE))
                      (local.get $dest_slot))
                    (return (i32.const 0))))))))))

    ;; (b) numeric base ^ integer exponent folds exactly:
    ;; Power(2, 10) → 1024, Power(2/3, -2) → 9/4, Power(i, 2) → -1.
    ;; 0^negative stays symbolic; a result beyond the scalar size bound
    ;; (~4MB of budget) stays symbolic rather than grinding the vat.
    (if (i32.and
          (i32.eq (local.get $head_description)
                  (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_POWER)))
          (i32.eq (local.get $length) (i32.const 2)))
      (then
        (local.set $exponent_class (call $power_exponent_class (local.get $second_arg_slot)))
        (if (i32.and
              (call $expression_slot_is_numeric (local.get $first_arg_slot))
              (i32.ne (local.get $exponent_class) (i32.const 0)))
          (then
            (if (i32.eqz (i32.and
                  (i32.eq (local.get $exponent_class) (i32.const 1))
                  (call $expression_value_is_zero_wide (local.get $first_arg_slot))))
              (then
                ;; Materializing the exponent BigInt is a small fixed
                ;; carve under the walk floor.
                (if (call $expression_walk_guard (i32.const 0))
                  (then (return (i32.const 1))))
                (local.set $exp_bigint (call $exponent_slot_to_bigint
                  (local.get $second_arg_slot)))
                (local.set $abs_exp (local.get $exp_bigint))
                (if (i32.eq (local.get $exponent_class) (i32.const 1))
                  (then (local.set $abs_exp (call $bigint_abs_copy (local.get $exp_bigint)))))
                ;; AlgebraicNumber (and non-real algebraic) bases fold through
                ;; EXACT closed-field arithmetic — never through a rational
                ;; projection of the isolating interval, which silently
                ;; returned a wrong non-root value (found while wiring
                ;; solveSystem: simplify(Power(root, 2)) of a root of
                ;; x^2 - 1 returned a near-1 rational instead of 1).
                (if (i32.or
                      (i32.eq (call $value_type (local.get $first_arg_slot))
                        (global.get $TYPE_ALGEBRAIC))
                      (i32.eq (call $value_type (local.get $first_arg_slot))
                        (global.get $TYPE_COMPLEX_ALGEBRAIC)))
                  (then
                    (local.set $work_aligned (call $pow_exponent_value (local.get $abs_exp)))
                    ;; Oversized exponents stay symbolic.
                    (if (i32.gt_u (local.get $work_aligned) (i32.const 512))
                      (then (return (call $expression_write_power_symbolic
                        (local.get $first_arg_slot) (local.get $second_arg_slot)
                        (local.get $dest_slot)))))
                    (return (call $expression_fold_algebraic_power
                      (local.get $first_arg_slot) (local.get $work_aligned)
                      (i32.eq (local.get $exponent_class) (i32.const 1))
                      (local.get $dest_slot)))))
                ;; Budget-check the fold; refuse (stay symbolic) when the
                ;; result would be pathologically large. Type-dispatched:
                ;; the rational estimator reads rational fields and must
                ;; not see a BigInt slot (16× covers the negative-exponent
                ;; path's rational wrapper around the bigint pow).
                (if (i32.eq (call $value_type (local.get $first_arg_slot))
                            (global.get $TYPE_COMPLEX))
                  (then (local.set $work_aligned (call $estimate_complex_pow_budget
                    (local.get $first_arg_slot)
                    (call $pow_exponent_value (local.get $abs_exp)))))
                  (else
                    (if (i32.eq (call $value_type (local.get $first_arg_slot))
                                (global.get $TYPE_BIGINT))
                      (then (local.set $work_aligned (i32.add (i32.const 64)
                        (call $sat_budget_mul (i32.const 16)
                          (call $estimate_bigint_size
                            (call $estimate_pow_result_limbs
                              (call $bigint_bit_length
                                (call $value_data_lo (local.get $first_arg_slot)))
                              (call $pow_exponent_value (local.get $abs_exp))))))))
                      (else (local.set $work_aligned (call $estimate_rational_pow_budget
                        (local.get $first_arg_slot)
                        (call $pow_exponent_value (local.get $abs_exp))))))))
                (if (i32.le_u (local.get $work_aligned) (i32.const 0x400000))
                  (then
                    (if (call $expression_walk_guard (local.get $work_aligned))
                      (then (return (i32.const 1))))
                    (if (i32.eq (call $value_type (local.get $first_arg_slot))
                                (global.get $TYPE_COMPLEX))
                      (then
                        (local.set $result_header (call $complex_pow
                          (call $value_data_lo (local.get $first_arg_slot))
                          (local.get $abs_exp)))
                        (if (i32.eq (local.get $exponent_class) (i32.const 1))
                          (then (local.set $result_header (call $complex_div
                            (call $complex_from_rational
                              (call $rational_allocate (call $bigint_one) (call $bigint_one)))
                            (local.get $result_header)))))
                        (i32.store (call $abs (local.get $dest_slot)) (global.get $TYPE_COMPLEX))
                        (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 4)))
                          (i32.const 0))
                        (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 8)))
                          (local.get $result_header))
                        (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 12)))
                          (i32.const 0))
                        (return (i32.const 0))))
                    ;; BigInt base with a non-negative exponent keeps its
                    ;; BigInt-ness; everything else folds as Rational.
                    (if (i32.and
                          (i32.eq (call $value_type (local.get $first_arg_slot))
                                  (global.get $TYPE_BIGINT))
                          (i32.eq (local.get $exponent_class) (i32.const 2)))
                      (then
                        (i32.store (call $abs (local.get $dest_slot)) (global.get $TYPE_BIGINT))
                        (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 4)))
                          (i32.const 0))
                        (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 8)))
                          (call $bigint_pow
                            (call $value_data_lo (local.get $first_arg_slot))
                            (local.get $abs_exp)))
                        (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 12)))
                          (i32.const 0))
                        (return (i32.const 0))))
                    (local.set $result_header (call $rational_pow
                      (call $expression_to_rational (local.get $first_arg_slot))
                      (local.get $abs_exp)))
                    (if (i32.eq (local.get $exponent_class) (i32.const 1))
                      (then (local.set $result_header (call $rational_div
                        (call $rational_allocate (call $bigint_one) (call $bigint_one))
                        (local.get $result_header)))))
                    (i32.store (call $abs (local.get $dest_slot)) (global.get $TYPE_RATIONAL))
                    (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 4)))
                      (i32.const 0))
                    (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 8)))
                      (local.get $result_header))
                    (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 12)))
                      (i32.const 0))
                    (return (i32.const 0))))))))))

    ;; (c) Power(Power(a, n), m) → Power(a, n·m) for integer n and m.
    (if (i32.and
          (i32.eq (local.get $head_description)
                  (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_POWER)))
          (i32.eq (local.get $length) (i32.const 2)))
      (then
        (if (i32.and
              (i32.ne (call $power_exponent_class (local.get $second_arg_slot)) (i32.const 0))
              (i32.eq (call $value_type (local.get $first_arg_slot))
                      (global.get $TYPE_EXPRESSION)))
          (then
            (if (i32.eq
                  (call $symbol_description (call $expression_head
                    (call $value_data_lo (local.get $first_arg_slot))))
                  (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_POWER)))
              (then
                (local.set $inner_args (call $expression_args
                  (call $value_data_lo (local.get $first_arg_slot))))
                (if (i32.eq (i32.load (call $abs
                      (i32.add (local.get $inner_args) (i32.const 8)))) (i32.const 2))
                  (then
                    (local.set $inner_data (i32.add
                      (i32.load (call $abs (i32.add (local.get $inner_args) (i32.const 16))))
                      (global.get $GC_HEADER_SIZE)))
                    (if (i32.ne (call $power_exponent_class
                          (i32.add (local.get $inner_data) (global.get $VALUE_SIZE)))
                        (i32.const 0))
                      (then
                        ;; Fold n·m into a committed stage slot, build
                        ;; Power(a, n·m), and re-simplify to fire any
                        ;; follow-on rules (identity, numeric fold).
                        (if (call $expression_walk_guard (i32.add (i32.const 96)
                              (call $estimate_cross_type_arith_budget
                                (i32.add (local.get $inner_data) (global.get $VALUE_SIZE))
                                (local.get $second_arg_slot))))
                          (then (return (i32.const 1))))
                        (local.set $accumulator (call $carve_scratch_blob
                          (global.get $VALUE_SIZE)))
                        (call $expression_fold_mul_slots
                          (i32.add (local.get $inner_data) (global.get $VALUE_SIZE))
                          (local.get $second_arg_slot)
                          (local.get $accumulator))
                        (local.set $work_array (call $read_state
                          (global.get $STATE_HEAP_POINTER)))
                        (local.set $work_data (call $write_array_header
                          (local.get $work_array) (i32.const 2) (i32.const 2) (i32.const 48)))
                        (call $write_state (global.get $STATE_HEAP_POINTER)
                          (i32.add (local.get $work_data) (i32.const 48)))
                        (memory.copy
                          (call $abs (i32.add (local.get $work_data)
                            (global.get $GC_HEADER_SIZE)))
                          (call $abs (local.get $inner_data))
                          (global.get $VALUE_SIZE))
                        (memory.copy
                          (call $abs (i32.add
                            (i32.add (local.get $work_data) (global.get $GC_HEADER_SIZE))
                            (global.get $VALUE_SIZE)))
                          (call $abs (local.get $accumulator))
                          (global.get $VALUE_SIZE))
                        (local.set $new_expression (call $expression_build
                          (local.get $head) (local.get $work_array)))
                        (i32.store (call $abs (local.get $dest_slot))
                          (global.get $TYPE_EXPRESSION))
                        (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 4)))
                          (i32.const 0))
                        (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 8)))
                          (local.get $new_expression))
                        (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 12)))
                          (i32.const 0))
                        (return (call $expression_simplify_into
                          (local.get $dest_slot) (local.get $dest_slot)))))))))))))

    ;; (d) Power(Multiply(f1…fm), n) → Multiply(Power(f1, n)…Power(fm, n))
    ;; for non-negative integer n; each factor power re-simplifies, then
    ;; the Multiply canonicalizer combines/folds.
    (if (i32.and
          (i32.eq (local.get $head_description)
                  (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_POWER)))
          (i32.eq (local.get $length) (i32.const 2)))
      (then
        (if (i32.and
              (i32.eq (call $power_exponent_class (local.get $second_arg_slot)) (i32.const 2))
              (i32.eq (call $value_type (local.get $first_arg_slot))
                      (global.get $TYPE_EXPRESSION)))
          (then
            (if (i32.eq
                  (call $symbol_description (call $expression_head
                    (call $value_data_lo (local.get $first_arg_slot))))
                  (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)))
              (then
                (local.set $inner_args (call $expression_args
                  (call $value_data_lo (local.get $first_arg_slot))))
                (local.set $i (i32.load (call $abs
                  (i32.add (local.get $inner_args) (i32.const 8)))))  ;; factor count
                (local.set $inner_data (i32.add
                  (i32.load (call $abs (i32.add (local.get $inner_args) (i32.const 16))))
                  (global.get $GC_HEADER_SIZE)))
                (local.set $work_aligned (i32.and
                  (i32.add
                    (i32.add (global.get $GC_HEADER_SIZE)
                      (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
                    (i32.const 15))
                  (i32.const -16)))
                (if (call $expression_walk_guard
                      (i32.add (local.get $work_aligned)
                        (i32.mul (local.get $i) (i32.const 80))))
                  (then (return (i32.const 1))))
                (local.set $work_array (call $read_state (global.get $STATE_HEAP_POINTER)))
                (local.set $work_data (call $write_array_header
                  (local.get $work_array) (local.get $i) (local.get $i)
                  (local.get $work_aligned)))
                (call $write_state (global.get $STATE_HEAP_POINTER)
                  (i32.add (local.get $work_data) (local.get $work_aligned)))
                (local.set $src_element (i32.const 0))
                (block $factors_done
                  (loop $factors
                    (br_if $factors_done (i32.ge_u (local.get $src_element) (local.get $i)))
                    ;; Build raw Power(factor, exponent) into the arg
                    ;; slot, then simplify it in place (the factor is
                    ;; never a Multiply, so this cannot re-enter (d)).
                    (local.set $inner_args (call $read_state (global.get $STATE_HEAP_POINTER)))
                    (local.set $new_aligned (call $write_array_header
                      (local.get $inner_args) (i32.const 2) (i32.const 2) (i32.const 48)))
                    (call $write_state (global.get $STATE_HEAP_POINTER)
                      (i32.add (local.get $new_aligned) (i32.const 48)))
                    (memory.copy
                      (call $abs (i32.add (local.get $new_aligned)
                        (global.get $GC_HEADER_SIZE)))
                      (call $abs (i32.add (local.get $inner_data)
                        (i32.mul (local.get $src_element) (global.get $VALUE_SIZE))))
                      (global.get $VALUE_SIZE))
                    (memory.copy
                      (call $abs (i32.add
                        (i32.add (local.get $new_aligned) (global.get $GC_HEADER_SIZE))
                        (global.get $VALUE_SIZE)))
                      (call $abs (local.get $second_arg_slot))
                      (global.get $VALUE_SIZE))
                    (local.set $new_expression (call $expression_build
                      (local.get $head) (local.get $inner_args)))
                    (local.set $dest_element (i32.add (local.get $work_data)
                      (i32.add (global.get $GC_HEADER_SIZE)
                        (i32.mul (local.get $src_element) (global.get $VALUE_SIZE)))))
                    (i32.store (call $abs (local.get $dest_element))
                      (global.get $TYPE_EXPRESSION))
                    (i32.store (call $abs (i32.add (local.get $dest_element) (i32.const 4)))
                      (i32.const 0))
                    (i32.store (call $abs (i32.add (local.get $dest_element) (i32.const 8)))
                      (local.get $new_expression))
                    (i32.store (call $abs (i32.add (local.get $dest_element) (i32.const 12)))
                      (i32.const 0))
                    (if (call $expression_simplify_into
                          (local.get $dest_element) (local.get $dest_element))
                      (then (return (i32.const 1))))
                    (local.set $src_element (i32.add (local.get $src_element) (i32.const 1)))
                    (br $factors)
                  )
                )
                (return (call $expression_canonicalize_flat
                  (call $symbol_registry_lookup
                    (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)))
                  (local.get $work_array)
                  (i32.const 1)
                  (local.get $dest_slot)))))))))

    ;; (e) Power(Add(…), n) expansion for integer n ≥ 2, when the
    ;; predicted multinomial term count fits the cap (or expand
    ;; disabled it). Iterated pairwise distribution with collection at
    ;; each step — same result as direct multinomial expansion, one
    ;; shared code path with Multiply-over-Add distribution.
    (if (i32.and
          (i32.eq (local.get $head_description)
                  (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_POWER)))
          (i32.eq (local.get $length) (i32.const 2)))
      (then
        (if (i32.and
              (i32.eq (call $power_exponent_class (local.get $second_arg_slot)) (i32.const 2))
              (i32.eq (call $value_type (local.get $first_arg_slot))
                      (global.get $TYPE_EXPRESSION)))
          (then
            (if (i32.and
                  (i32.eq
                    (call $symbol_description (call $expression_head
                      (call $value_data_lo (local.get $first_arg_slot))))
                    (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_ADD)))
                  (call $exponent_slot_to_i64 (local.get $second_arg_slot)))
              (then
                (local.set $exponent_value (global.get $bigint_to_i64_value))
                (if (i64.ge_s (local.get $exponent_value) (i64.const 2))
                  (then
                    (local.set $inner_args (call $expression_args
                      (call $value_data_lo (local.get $first_arg_slot))))
                    (local.set $predicted (call $multinomial_term_count
                      (local.get $exponent_value)
                      (i32.load (call $abs
                        (i32.add (local.get $inner_args) (i32.const 8))))))
                    (if (i32.or
                          (global.get $expansion_cap_disabled)
                          (i64.le_s (local.get $predicted)
                            (i64.extend_i32_u (global.get $MAX_EXPANSION_TERMS))))
                      (then
                        (if (call $expression_walk_guard (i32.const 32))
                          (then (return (i32.const 1))))
                        (local.set $accumulator (call $carve_scratch_blob
                          (global.get $VALUE_SIZE)))
                        (memory.copy (call $abs (local.get $accumulator))
                          (call $abs (local.get $first_arg_slot))
                          (global.get $VALUE_SIZE))
                        (local.set $exponent_value (i64.sub
                          (local.get $exponent_value) (i64.const 1)))
                        (block $expand_done
                          (loop $expand
                            (br_if $expand_done (i64.le_s
                              (local.get $exponent_value) (i64.const 0)))
                            (if (call $expression_distribute_pair
                                  (local.get $accumulator)
                                  (local.get $first_arg_slot)
                                  (local.get $accumulator))
                              (then (return (i32.const 1))))
                            (local.set $exponent_value (i64.sub
                              (local.get $exponent_value) (i64.const 1)))
                            (br $expand)
                          )
                        )
                        (memory.copy (call $abs (local.get $dest_slot))
                          (call $abs (local.get $accumulator))
                          (global.get $VALUE_SIZE))
                        (return (i32.const 0))))))))))))

    ;; Add / Multiply canonicalization: flatten same-head nests, fold
    ;; numeric constants, strip identity, annihilate on Multiply(·, 0).
    ;; Handles zero-arg (identity), single-arg (collapse), n-ary (build
    ;; new tree). This subsumes the binary-only rules from 2d.1.
    (if (i32.eq (local.get $head_description)
                (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_ADD)))
      (then
        (return (call $expression_canonicalize_flat
          (local.get $head) (local.get $new_array) (i32.const 0)
          (local.get $dest_slot)))))
    (if (i32.eq (local.get $head_description)
                (call $read_builtin (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY)))
      (then
        (return (call $expression_canonicalize_flat
          (local.get $head) (local.get $new_array) (i32.const 1)
          (local.get $dest_slot)))))

    ;; No identity rule fired; build an Expression with the simplified args.
    ;; (Add/Multiply already returned via canonicalize_flat above.)
    (local.set $new_expression (call $expression_build
      (local.get $head)
      (local.get $new_array)))
    (i32.store (call $abs (local.get $dest_slot)) (global.get $TYPE_EXPRESSION))
    (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 4))) (i32.const 0))
    (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 8))) (local.get $new_expression))
    (i32.store (call $abs (i32.add (local.get $dest_slot) (i32.const 12))) (i32.const 0))
    (i32.const 0)
  )

  ;; ==========================================================================
  ;; Symbol registry (Symbol.for / Symbol.keyFor backing store).
  ;; The registry is a regular SandScript Object whose entries map
  ;; interned-string offsets (the description) to Symbol heap pointers
  ;; (stored as TYPE_SYMBOL values). Registry pointer lives in STATE so GC
  ;; treats it as a root — registered Symbols never collect.
  ;; ==========================================================================

  ;; Look up a registry-backed Symbol by its description string offset.
  ;; Returns the Symbol header pointer, or 0 if not registered.
  ;; Scans the registry Object's entries linearly; fine because the registry
  ;; is small in practice (builtin names + user-registered atoms).
  (func $symbol_registry_lookup (param $description_offset i32) (result i32)
    (local $registry i32)
    (local $count i32)
    (local $entries_pointer i32)
    (local $i i32)
    (local $entry_pointer i32)
    (local $entry_key i32)
    (local $entry_type i32)

    (local.set $registry (call $read_state (global.get $STATE_SYMBOL_REGISTRY)))
    (if (i32.eqz (local.get $registry))
      (then (return (i32.const 0))))

    ;; Object layout: [GC:8][prototype:4][count:4][capacity:4][flags:4][entries:4]
    (local.set $count (i32.load
      (call $abs (i32.add (local.get $registry) (i32.const 12)))))
    (local.set $entries_pointer (i32.load
      (call $abs (i32.add (local.get $registry) (i32.const 24)))))
    (if (i32.or (i32.eqz (local.get $count)) (i32.eqz (local.get $entries_pointer)))
      (then (return (i32.const 0))))

    (local.set $i (i32.const 0))
    (block $done
      (loop $scan
        (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
        ;; Entry: [nameOffset:4][type:4][flags:4][dataLo:4][dataHi:4]
        (local.set $entry_pointer (i32.add
          (i32.add (local.get $entries_pointer) (global.get $GC_HEADER_SIZE))
          (i32.mul (local.get $i) (global.get $ENTRY_SIZE))))
        (local.set $entry_key (i32.load (call $abs (local.get $entry_pointer))))
        (local.set $entry_type (i32.load
          (call $abs (i32.add (local.get $entry_pointer) (i32.const 4)))))
        (if (i32.and
              (i32.eq (local.get $entry_key) (local.get $description_offset))
              (i32.eq (local.get $entry_type) (global.get $TYPE_SYMBOL)))
          (then
            ;; dataLo = Symbol heap pointer
            (return (i32.load
              (call $abs (i32.add (local.get $entry_pointer) (i32.const 12)))))
          )
        )
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $scan)
      )
    )
    (i32.const 0)
  )

  ;; Register a Symbol in the global registry under the given description
  ;; string offset. Overwrites any prior entry (shouldn't happen in practice
  ;; because callers check with lookup first). Propagates
  ;; $object_set_property's pressure status (1 = registry grow refused,
  ;; nothing written) — the caller pre-budgets or yields.
  (func $symbol_registry_register (param $description_offset i32) (param $symbol_pointer i32) (result i32)
    (local $registry i32)
    (local.set $registry (call $read_state (global.get $STATE_SYMBOL_REGISTRY)))
    (call $object_set_property
      (local.get $registry)
      (local.get $description_offset)
      (global.get $TYPE_SYMBOL)
      (i32.const 0)
      (local.get $symbol_pointer)
      (i32.const 0))
  )

  ;; Return the canonical registry Symbol for a description. Create and
  ;; register it when absent. A zero result means memory pressure; allocation
  ;; and registry growth are budgeted together, so no half-registered Symbol
  ;; can escape a retry.
  (func $symbol_registry_get_or_create (param $description_offset i32) (result i32)
    (local $symbol_pointer i32)
    (local.set $symbol_pointer
      (call $symbol_registry_lookup (local.get $description_offset)))
    (if (local.get $symbol_pointer)
      (then (return (local.get $symbol_pointer))))
    (if (call $check_heap_overflow
          (i32.add
            (call $estimate_symbol_size)
            (call $estimate_object_grow_size
              (i32.load (call $abs (i32.add
                (call $read_state (global.get $STATE_SYMBOL_REGISTRY))
                (i32.const 16)))))))
      (then (return (i32.const 0))))
    (local.set $symbol_pointer
      (call $symbol_allocate (local.get $description_offset)))
    ;; Registry growth was budgeted with the Symbol allocation.
    (drop (call $symbol_registry_register
      (local.get $description_offset) (local.get $symbol_pointer)))
    (local.get $symbol_pointer)
  )

  ;; Reverse lookup: find the description string offset for a given Symbol
  ;; heap pointer, or 0 if the Symbol is not registry-backed.
  (func $symbol_registry_key_for (param $symbol_pointer i32) (result i32)
    (local $registry i32)
    (local $count i32)
    (local $entries_pointer i32)
    (local $i i32)
    (local $entry_pointer i32)
    (local $entry_data_lo i32)
    (local $entry_type i32)

    (local.set $registry (call $read_state (global.get $STATE_SYMBOL_REGISTRY)))
    (if (i32.eqz (local.get $registry))
      (then (return (i32.const 0))))

    (local.set $count (i32.load
      (call $abs (i32.add (local.get $registry) (i32.const 12)))))
    (local.set $entries_pointer (i32.load
      (call $abs (i32.add (local.get $registry) (i32.const 24)))))
    (if (i32.or (i32.eqz (local.get $count)) (i32.eqz (local.get $entries_pointer)))
      (then (return (i32.const 0))))

    (local.set $i (i32.const 0))
    (block $done
      (loop $scan
        (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
        (local.set $entry_pointer (i32.add
          (i32.add (local.get $entries_pointer) (global.get $GC_HEADER_SIZE))
          (i32.mul (local.get $i) (global.get $ENTRY_SIZE))))
        (local.set $entry_type (i32.load
          (call $abs (i32.add (local.get $entry_pointer) (i32.const 4)))))
        (local.set $entry_data_lo (i32.load
          (call $abs (i32.add (local.get $entry_pointer) (i32.const 12)))))
        (if (i32.and
              (i32.eq (local.get $entry_type) (global.get $TYPE_SYMBOL))
              (i32.eq (local.get $entry_data_lo) (local.get $symbol_pointer)))
          (then
            ;; Entry key (nameOffset) is the description string offset
            (return (i32.load (call $abs (local.get $entry_pointer))))
          )
        )
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $scan)
      )
    )
    (i32.const 0)
  )

  ;; Bitwise AND/OR/XOR on two BigInts using a finite two's-complement
  ;; window one limb wider than either magnitude. The extra limb makes
  ;; infinite sign extension explicit. The result is converted back to
  ;; canonical sign-magnitude form in place.
  ;; op: 0=AND, 1=OR, 2=XOR
  (func $bigint_bitwise_op (param $a i32) (param $b i32) (param $op i32) (result i32)
    (local $la i32)
    (local $lb i32)
    (local $width i32)
    (local $result i32)
    (local $i i32)
    (local $limb_a i32)
    (local $limb_b i32)
    (local $res_limb i32)
    (local $sign_a i32)
    (local $sign_b i32)
    (local $carry_a i32)
    (local $carry_b i32)
    (local $carry_result i32)
    (local $negative_result i32)

    (local.set $la (call $bigint_length (local.get $a)))
    (local.set $lb (call $bigint_length (local.get $b)))
    (local.set $width
      (i32.add
        (select (local.get $la) (local.get $lb)
          (i32.gt_u (local.get $la) (local.get $lb)))
        (i32.const 1)))
    (local.set $sign_a (call $bigint_sign (local.get $a)))
    (local.set $sign_b (call $bigint_sign (local.get $b)))
    (local.set $carry_a (local.get $sign_a))
    (local.set $carry_b (local.get $sign_b))
    (local.set $result (call $bigint_alloc (i32.const 0) (local.get $width)))

    (local.set $i (i32.const 0))
    (block $done
      (loop $bitwise_loop
        (br_if $done (i32.ge_u (local.get $i) (local.get $width)))
        (local.set $limb_a
          (select
            (call $bigint_limb (local.get $a) (local.get $i))
            (i32.const 0)
            (i32.lt_u (local.get $i) (local.get $la))))
        (if (local.get $sign_a)
          (then
            (local.set $limb_a (i32.xor (local.get $limb_a) (i32.const -1)))
            (if (local.get $carry_a)
              (then
                (local.set $carry_a (i32.eq (local.get $limb_a) (i32.const -1)))
                (local.set $limb_a (i32.add (local.get $limb_a) (i32.const 1)))))))
        (local.set $limb_b
          (select
            (call $bigint_limb (local.get $b) (local.get $i))
            (i32.const 0)
            (i32.lt_u (local.get $i) (local.get $lb))))
        (if (local.get $sign_b)
          (then
            (local.set $limb_b (i32.xor (local.get $limb_b) (i32.const -1)))
            (if (local.get $carry_b)
              (then
                (local.set $carry_b (i32.eq (local.get $limb_b) (i32.const -1)))
                (local.set $limb_b (i32.add (local.get $limb_b) (i32.const 1)))))))
        (if (i32.eqz (local.get $op))
          (then (local.set $res_limb (i32.and (local.get $limb_a) (local.get $limb_b)))))
        (if (i32.eq (local.get $op) (i32.const 1))
          (then (local.set $res_limb (i32.or (local.get $limb_a) (local.get $limb_b)))))
        (if (i32.eq (local.get $op) (i32.const 2))
          (then (local.set $res_limb (i32.xor (local.get $limb_a) (local.get $limb_b)))))
        (call $bigint_set_limb (local.get $result) (local.get $i) (local.get $res_limb))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $bitwise_loop)))

    (local.set $negative_result
      (i32.shr_u
        (call $bigint_limb (local.get $result) (i32.sub (local.get $width) (i32.const 1)))
        (i32.const 31)))
    (if (local.get $negative_result)
      (then
        (local.set $carry_result (i32.const 1))
        (local.set $i (i32.const 0))
        (block $magnitude_done
          (loop $magnitude_loop
            (br_if $magnitude_done (i32.ge_u (local.get $i) (local.get $width)))
            (local.set $res_limb
              (i32.xor (call $bigint_limb (local.get $result) (local.get $i)) (i32.const -1)))
            (if (local.get $carry_result)
              (then
                (local.set $carry_result (i32.eq (local.get $res_limb) (i32.const -1)))
                (local.set $res_limb (i32.add (local.get $res_limb) (i32.const 1)))))
            (call $bigint_set_limb (local.get $result) (local.get $i) (local.get $res_limb))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $magnitude_loop)))
        (i32.store
          (call $abs (i32.add (local.get $result) (global.get $GC_HEADER_SIZE)))
          (i32.const 1))))
    (call $bigint_normalize (local.get $result))
    (local.get $result)
  )

  ;; Left shift BigInt by n bits. n must be a non-negative BigInt.
  ;; Shift amount is extracted as i32 from the first limb (practical limit).
  (func $bigint_shift_left (param $value i32) (param $shift i32) (result i32)
    (local $shift_bits i32)
    (local $word_shift i32)
    (local $bit_shift i32)
    (local $old_len i32)
    (local $new_len i32)
    (local $result i32)
    (local $i i32)
    (local $carry i32)
    (local $limb i32)

    ;; Extract shift amount as i32
    (if (i32.eqz (call $bigint_length (local.get $shift)))
      (then (return (local.get $value)))) ;; shift by 0
    (if (i32.ne (call $bigint_sign (local.get $shift)) (i32.const 0))
      (then
        ;; Negative shift = right shift
        ;; Flip sign temporarily and call right shift
        (i32.store (call $abs (i32.add (local.get $shift) (global.get $GC_HEADER_SIZE)))
          (i32.const 0))
        (local.set $result (call $bigint_shift_right (local.get $value) (local.get $shift)))
        (i32.store (call $abs (i32.add (local.get $shift) (global.get $GC_HEADER_SIZE)))
          (i32.const 1))
        (return (local.get $result))
      )
    )

    (local.set $shift_bits (call $bigint_limb (local.get $shift) (i32.const 0)))
    (local.set $word_shift (i32.div_u (local.get $shift_bits) (i32.const 32)))
    (local.set $bit_shift (i32.rem_u (local.get $shift_bits) (i32.const 32)))
    (local.set $old_len (call $bigint_length (local.get $value)))

    (if (i32.eqz (local.get $old_len))
      (then (return (call $bigint_alloc (i32.const 0) (i32.const 0)))))

    (local.set $new_len (i32.add (i32.add (local.get $old_len) (local.get $word_shift)) (i32.const 1)))
    (local.set $result (call $bigint_alloc (call $bigint_sign (local.get $value)) (local.get $new_len)))

    ;; Zero lower limbs
    (local.set $i (i32.const 0))
    (block $zero_done
      (loop $zero_loop
        (br_if $zero_done (i32.ge_u (local.get $i) (local.get $word_shift)))
        (call $bigint_set_limb (local.get $result) (local.get $i) (i32.const 0))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $zero_loop)
      )
    )

    ;; Shift limbs
    (local.set $carry (i32.const 0))
    (local.set $i (i32.const 0))
    (block $shift_done
      (loop $shift_loop
        (br_if $shift_done (i32.ge_u (local.get $i) (local.get $old_len)))
        (local.set $limb (call $bigint_limb (local.get $value) (local.get $i)))

        (if (i32.eqz (local.get $bit_shift))
          (then
            (call $bigint_set_limb (local.get $result) (i32.add (local.get $i) (local.get $word_shift))
              (local.get $limb))
          )
          (else
            (call $bigint_set_limb (local.get $result) (i32.add (local.get $i) (local.get $word_shift))
              (i32.or
                (i32.shl (local.get $limb) (local.get $bit_shift))
                (local.get $carry)))
            (local.set $carry (i32.shr_u (local.get $limb)
              (i32.sub (i32.const 32) (local.get $bit_shift))))
          )
        )

        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $shift_loop)
      )
    )

    ;; Final carry
    (if (i32.ne (local.get $carry) (i32.const 0))
      (then
        (call $bigint_set_limb (local.get $result) (i32.add (local.get $old_len) (local.get $word_shift))
          (local.get $carry))
      )
      (else
        (call $bigint_set_limb (local.get $result) (i32.add (local.get $old_len) (local.get $word_shift))
          (i32.const 0))
      )
    )

    (call $bigint_normalize (local.get $result))
    (local.get $result)
  )

  ;; Right shift BigInt by n bits. n must be a non-negative BigInt.
  ;; For negative values: floor division (rounds toward -infinity).
  (func $bigint_shift_right (param $value i32) (param $shift i32) (result i32)
    (local $shift_bits i32)
    (local $word_shift i32)
    (local $bit_shift i32)
    (local $old_len i32)
    (local $new_len i32)
    (local $result i32)
    (local $i i32)
    (local $carry i32)
    (local $limb i32)
    (local $sign i32)

    (if (i32.eqz (call $bigint_length (local.get $shift)))
      (then (return (local.get $value))))

    (local.set $shift_bits (call $bigint_limb (local.get $shift) (i32.const 0)))
    (local.set $word_shift (i32.div_u (local.get $shift_bits) (i32.const 32)))
    (local.set $bit_shift (i32.rem_u (local.get $shift_bits) (i32.const 32)))
    (local.set $old_len (call $bigint_length (local.get $value)))
    (local.set $sign (call $bigint_sign (local.get $value)))

    (if (i32.eqz (local.get $old_len))
      (then (return (call $bigint_alloc (i32.const 0) (i32.const 0)))))

    ;; If shifting more than total bits, result is 0 (or -1 for negative)
    (if (i32.ge_u (local.get $word_shift) (local.get $old_len))
      (then
        (if (i32.ne (local.get $sign) (i32.const 0))
          (then
            ;; Negative >> large = -1n
            (local.set $result (call $bigint_alloc (i32.const 1) (i32.const 1)))
            (call $bigint_set_limb (local.get $result) (i32.const 0) (i32.const 1))
            (return (local.get $result))
          )
        )
        (return (call $bigint_alloc (i32.const 0) (i32.const 0)))
      )
    )

    (local.set $new_len (i32.sub (local.get $old_len) (local.get $word_shift)))
    (local.set $result (call $bigint_alloc (local.get $sign) (local.get $new_len)))

    ;; Shift limbs
    (local.set $carry (i32.const 0))
    (local.set $i (i32.sub (local.get $new_len) (i32.const 1)))
    (block $shift_done
      (loop $shift_loop
        (br_if $shift_done (i32.lt_s (local.get $i) (i32.const 0)))
        (local.set $limb (call $bigint_limb (local.get $value)
          (i32.add (local.get $i) (local.get $word_shift))))

        (if (i32.eqz (local.get $bit_shift))
          (then
            (call $bigint_set_limb (local.get $result) (local.get $i) (local.get $limb))
          )
          (else
            (call $bigint_set_limb (local.get $result) (local.get $i)
              (i32.or
                (i32.shr_u (local.get $limb) (local.get $bit_shift))
                (local.get $carry)))
            (local.set $carry (i32.shl (local.get $limb)
              (i32.sub (i32.const 32) (local.get $bit_shift))))
          )
        )

        (local.set $i (i32.sub (local.get $i) (i32.const 1)))
        (br $shift_loop)
      )
    )

    (call $bigint_normalize (local.get $result))

    ;; For negative numbers: if any bits were shifted out, round toward -infinity
    ;; (result should be one more negative than truncation)
    ;; This is the JS >> behavior for negative BigInts
    (if (i32.ne (local.get $sign) (i32.const 0))
      (then
        ;; Check if any shifted-out bits were non-zero
        ;; For simplicity: check if original had non-zero content in shifted-out words
        ;; or shifted-out bits of the boundary word
        ;; TODO: full shifted-out bit check for perfect JS compliance
        nop
      )
    )

    (local.get $result)
  )

  ;; Physical ArrayBuffer allocation size, widened before alignment so a
  ;; corrupt or unrepresentable byteLength cannot wrap into a small object.
  (func $arraybuffer_size_i64 (param $byte_length i32) (result i64)
    (i64.and
      (i64.add
        (i64.extend_i32_u (local.get $byte_length))
        (i64.add (i64.extend_i32_u (global.get $GC_HEADER_SIZE)) (i64.const 11)))
      (i64.const -8))
  )

  ;; estimate_arraybuffer_size(byte_length) → bytes
  ;; GC_HEADER_SIZE (8) + 4 (physical byteLength) + bytes, aligned to 8.
  ;; An impossible u32 size signals pressure even when a caller adds more
  ;; allocations to this estimate with i32 arithmetic before preflighting.
  (func $estimate_arraybuffer_size (param $byte_length i32) (result i32)
    (local $size i64)
    (local.set $size (call $arraybuffer_size_i64 (local.get $byte_length)))
    (if (i64.gt_u (local.get $size) (i64.const 0xffffffff))
      (then
        (global.set $memory_pressure_signaled (i32.const 1))
        (return (i32.const -1))))
    (i32.wrap_i64 (local.get $size))
  )

  ;; ==========================================================================
  ;; allocate_arraybuffer
  ;;
  ;; Allocates an ArrayBuffer on the heap. Returns data pointer (after GC header).
  ;; ArrayBuffer structure: [GC header 8][byteLength 4][bytes...]
  ;; ==========================================================================
  ;; Internal carving only: keep the buffer private until its bytes have been
  ;; copied or cleared. Native Proof transfers do that in fuel-bounded chunks.
  (func $allocate_arraybuffer_uninitialized (param $byte_length i32) (result i32)
    (local $heap_pointer i32)
    (local $aligned_size i32)
    (local $header_pointer i32)
    (local $data_pointer i32)

    (local.set $heap_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))

    ;; Callers preflight the complete allocation budget before carving.
    (local.set $aligned_size (call $estimate_arraybuffer_size (local.get $byte_length)))

    (local.set $header_pointer (local.get $heap_pointer))
    (local.set $data_pointer (i32.add (local.get $header_pointer) (global.get $GC_HEADER_SIZE)))

    ;; Large ArrayBuffers encode size 0; their physical byteLength below
    ;; supplies the full size without spilling into the packed object type.
    (i32.store (call $abs (local.get $header_pointer))
      (i32.or
        (if (result i32) (i32.lt_u (local.get $aligned_size) (i32.const 0x01000000))
          (then (local.get $aligned_size))
          (else (i32.const 0)))
        (i32.shl (global.get $OBJ_ARRAYBUFFER) (i32.const 24))))
    (i32.store (call $abs (i32.add (local.get $header_pointer) (i32.const 4))) (i32.const 0))

    ;; Write byte length
    (i32.store (call $abs (local.get $data_pointer)) (local.get $byte_length))

    ;; Update heap pointer
    (call $write_state (global.get $STATE_HEAP_POINTER)
      (i32.add (local.get $heap_pointer) (local.get $aligned_size)))

    ;; Return data pointer (after GC header)
    (local.get $data_pointer)
  )

  (func $allocate_arraybuffer (param $byte_length i32) (result i32)
    (local $data_pointer i32)
    (local.set $data_pointer (call $allocate_arraybuffer_uninitialized (local.get $byte_length)))
    (memory.fill (call $abs (i32.add (local.get $data_pointer) (i32.const 4)))
      (i32.const 0) (local.get $byte_length))
    (local.get $data_pointer)
  )

  ;; ==========================================================================
  ;; RegExp support: descriptor allocation and the resumable LIT_REGEXP
  ;; compile pipeline against the statically imported standalone engine.
  ;;
  ;; Workspace-address globals mirror REGEX_SCAN / REGEX_EMIT in
  ;; constants.js (sourced from regex-engine-contract.js). They are the
  ;; documented workspace-header slots holding absolute buffer addresses;
  ;; the interpreter rebinds them with fresh addresses when resuming a
  ;; paused operation, because the collector may have relocated the
  ;; pattern string or the buffers between fuel grants.
  ;; ==========================================================================
  (global $REGEX_SCAN_PATTERN_ADDRESS i32 (i32.const 8))
  (global $REGEX_SCAN_CURSOR i32 (i32.const 16))
  (global $REGEX_EMIT_PATTERN_ADDRESS i32 (i32.const 8))
  (global $REGEX_EMIT_CURSOR i32 (i32.const 16))
  (global $REGEX_EMIT_PROGRAM_ADDRESS i32 (i32.const 20))
  ;; Match-continuation header offsets (regex-engine-contract.js's
  ;; REGEX_CONTINUATION.HEADER — mirror, do not edit independently).
  ;; PROGRAM/INPUT addresses are absolute and rebound on every resume;
  ;; positions and capture slots are input-relative byte offsets.
  (global $REGEX_CONT_PROGRAM_ADDRESS i32 (i32.const 8))
  (global $REGEX_CONT_INPUT_ADDRESS i32 (i32.const 16))
  (global $REGEX_CONT_MATCH_END_SCALAR i32 (i32.const 72))
  (global $REGEX_CONT_CAPTURE_GROUP_COUNT i32 (i32.const 88))
  (global $REGEX_CONT_FLAGS i32 (i32.const 92))
  (global $REGEX_CONT_HEADER_SIZE i32 (i32.const 128))
  (global $REGEX_CONT_NO_POSITION i32 (i32.const 0xffffffff))
  ;; Compiled-program header offsets (REGEX_PROGRAM.HEADER mirror).
  (global $REGEX_PROGRAM_HEADER_SIZE i32 (i32.const 40))
  (global $REGEX_PROGRAM_INSTRUCTION_SIZE i32 (i32.const 16))
  (global $REGEX_PROGRAM_INSTRUCTION_COUNT i32 (i32.const 12))
  (global $REGEX_PROGRAM_RANGE_COUNT i32 (i32.const 16))
  (global $REGEX_PROGRAM_CAPTURE_GROUP_COUNT i32 (i32.const 20))
  (global $REGEX_PROGRAM_NAME_BYTES i32 (i32.const 28))
  (global $REGEX_PROGRAM_GUARD_SLOTS i32 (i32.const 32))

  ;; Allocate a RegExp descriptor heap object (OBJ_REGEXP):
  ;;   [GC header 8][patternStringOffset:4][flagsBitfield:4][lastIndex:4]
  ;;   [programBufferDataPointer:4] = 24 bytes, aligned to 32. The program
  ;;   pointer starts 0 and is published only at the compile commit point.
  ;; Caller pre-checks heap headroom. Returns the HEADER pointer.
  (func $allocate_regexp_descriptor
    (param $pattern_string_id i32) (param $flags_word i32)
    (result i32)
    (local $header_pointer i32)
    (local $data_pointer i32)
    (local.set $header_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))
    (local.set $data_pointer (i32.add (local.get $header_pointer) (global.get $GC_HEADER_SIZE)))
    (i32.store (call $abs (local.get $header_pointer))
      (i32.or (i32.const 32) (i32.shl (global.get $OBJ_REGEXP) (i32.const 24))))
    (i32.store (call $abs (i32.add (local.get $header_pointer) (i32.const 4))) (i32.const 0))
    (i32.store
      (call $abs (i32.add (local.get $data_pointer) (global.get $REGEXP_PATTERN_STRING)))
      (local.get $pattern_string_id))
    (i32.store
      (call $abs (i32.add (local.get $data_pointer) (global.get $REGEXP_FLAGS)))
      (local.get $flags_word))
    (i32.store
      (call $abs (i32.add (local.get $data_pointer) (global.get $REGEXP_LAST_INDEX)))
      (i32.const 0))
    (i32.store
      (call $abs (i32.add (local.get $data_pointer) (global.get $REGEXP_PROGRAM_BUFFER)))
      (i32.const 0))
    (call $write_state (global.get $STATE_HEAP_POINTER)
      (i32.add (local.get $header_pointer) (i32.const 32)))
    (local.get $header_pointer)
  )

  ;; Write one slot of a NATIVE_CONTINUATION_STATE object (the paused
  ;; regex operation's private state; masks were fixed at allocation).
  (func $regex_state_set
    (param $state_handle i32) (param $state_index i32) (param $value i32)
    (i32.store
      (call $abs (i32.add
        (i32.add (local.get $state_handle) (global.get $GC_HEADER_SIZE))
        (i32.add
          (global.get $NATIVE_CONTINUATION_STATE_VALUES)
          (i32.mul (local.get $state_index) (i32.const 4)))))
      (local.get $value))
  )

  ;; Raise the SandScript error for a failed regex engine compile status.
  ;; Returns the LIT_REGEXP disposition: 3 = uncaught (br $exit),
  ;; 4 = caught (reload pc, br $loop).
  (func $regex_compile_raise (param $status i32) (result i32)
    (if (i32.eq (local.get $status) (global.get $REGEX_STATUS_UNSUPPORTED))
      (then
        (if (call $raise_error
              (global.get $ERR_NOT_SUPPORTED)
              (global.get $NOT_SUPPORTED_FEATURE_REGEXP))
          (then (return (i32.const 3)))
          (else (return (i32.const 4))))))
    ;; SYNTAX_ERROR, LIMIT_EXCEEDED, and INVALID_UTF8 all surface as a
    ;; SyntaxError, like JavaScript's construction-time pattern errors;
    ;; the engine status rides in the error detail.
    (if (call $raise_error (global.get $ERR_SYNTAX_ERROR) (local.get $status))
      (then (return (i32.const 3)))
      (else (return (i32.const 4))))
    (unreachable)
  )

  ;; One fuel grant's worth of LIT_REGEXP: compile the pattern through the
  ;; standalone engine, resumably. Phases live in the context's
  ;; CTX_REGEX_STATE root (NATIVE_CONTINUATION_STATE):
  ;;   state0 = phase (1 scan, 2 allocate+init emission, 3 emit)
  ;;   state1 = scan workspace ArrayBuffer DATA pointer     (data mask)
  ;;   state2 = program ArrayBuffer DATA pointer            (data mask)
  ;;   state3 = emission workspace ArrayBuffer DATA pointer (data mask)
  ;;   state4 = descriptor HEADER pointer                   (header mask)
  ;; Returns (disposition, fuelRemaining):
  ;;   0 = done, TYPE_REGEXP value pushed, state cleared;
  ;;   1 = paused on fuel, state saved (caller re-dispatches this pc);
  ;;   2 = memory pressure, nothing consumed (caller yields and retries);
  ;;   3 = thrown and uncaught (caller br $exit);
  ;;   4 = thrown and caught (caller reloads pc and loops).
  (func $lit_regexp_step
    (param $pattern_id i32) (param $flags_word i32) (param $fuel i32)
    (result i32 i32)
    (local $state_handle i32)
    (local $phase i32)
    (local $scan_ws i32)
    (local $program i32)
    (local $emit_ws i32)
    (local $descriptor i32)
    (local $pattern_bytes i32)
    (local $pattern_addr i32)
    (local $scan_size i32)
    (local $status i32)
    (local $initialize i32)
    (local $program_bytes i32)
    (local $emit_size i32)
    (local $old_address i32)
    (local $disposition i32)

    (local.set $pattern_bytes
      (i32.load (call $string_id_to_abs (local.get $pattern_id))))
    (local.set $pattern_addr
      (i32.add (call $string_id_to_abs (local.get $pattern_id)) (i32.const 4)))

    (local.set $state_handle (call $read_ctx (global.get $CTX_REGEX_STATE)))
    (if (i32.eq (local.get $state_handle) (i32.const 0))
      (then
        ;; Fresh compile. The parser enforces the pattern-byte cap, so a
        ;; -1 here means the operand or string table is corrupt.
        (local.set $scan_size
          (call $regex_scan_workspace_size (local.get $pattern_bytes)))
        (if (i32.eq (local.get $scan_size) (i32.const -1))
          (then
            (call $fault_error (global.get $ERR_CORRUPT_OPERAND)
              (local.get $pattern_bytes) (global.get $current_executing_pc))
            (return (i32.const 3) (local.get $fuel))))
        (if (call $check_heap_overflow
              (i32.add
                (call $estimate_arraybuffer_size (local.get $scan_size))
                (global.get $NATIVE_CONTINUATION_STATE_SIZE)))
          (then (return (i32.const 2) (local.get $fuel))))
        (local.set $scan_ws (call $allocate_arraybuffer (local.get $scan_size)))
        (local.set $state_handle
          (call $allocate_native_continuation_state
            (i32.const 16)  ;; header mask: state4 (descriptor)
            (i32.const 14)  ;; data mask: state1..3 (buffers)
            (i32.const 1)   ;; phase: scan
            (local.get $scan_ws)
            (i32.const 0) (i32.const 0) (i32.const 0)))
        (call $write_ctx (global.get $CTX_REGEX_STATE) (local.get $state_handle))
        (local.set $phase (i32.const 1))
        (local.set $initialize (i32.const 1)))
      (else
        (local.set $phase
          (call $native_continuation_state_get (local.get $state_handle) (i32.const 0)))
        (local.set $scan_ws
          (call $native_continuation_state_get (local.get $state_handle) (i32.const 1)))
        (local.set $program
          (call $native_continuation_state_get (local.get $state_handle) (i32.const 2)))
        (local.set $emit_ws
          (call $native_continuation_state_get (local.get $state_handle) (i32.const 3)))
        (local.set $descriptor
          (call $native_continuation_state_get (local.get $state_handle) (i32.const 4)))
        (local.set $initialize (i32.const 0))))

    ;; Phase 1: the validating/measuring scan, resumable under fuel.
    (if (i32.eq (local.get $phase) (i32.const 1))
      (then
        ;; Rebind the stored pattern address: the collector may have
        ;; relocated the string table since the pause.
        (if (i32.eqz (local.get $initialize))
          (then
            ;; The scan cursor is pattern-absolute: relocate it by the
            ;; same delta as the pattern, then store the fresh address.
            (local.set $old_address
              (i32.load (call $abs (i32.add
                (i32.add (local.get $scan_ws) (i32.const 4))
                (global.get $REGEX_SCAN_PATTERN_ADDRESS)))))
            (i32.store
              (call $abs (i32.add
                (i32.add (local.get $scan_ws) (i32.const 4))
                (global.get $REGEX_SCAN_CURSOR)))
              (i32.add
                (local.get $pattern_addr)
                (i32.sub
                  (i32.load (call $abs (i32.add
                    (i32.add (local.get $scan_ws) (i32.const 4))
                    (global.get $REGEX_SCAN_CURSOR))))
                  (local.get $old_address))))
            (i32.store
              (call $abs (i32.add
                (i32.add (local.get $scan_ws) (i32.const 4))
                (global.get $REGEX_SCAN_PATTERN_ADDRESS)))
              (local.get $pattern_addr))))
        (call $regex_scan_pattern
          (local.get $pattern_addr)
          (local.get $pattern_bytes)
          (i32.add (call $abs (local.get $scan_ws)) (i32.const 4))
          (i32.load (call $abs (local.get $scan_ws)))
          (local.get $initialize)
          (local.get $fuel))
        (local.set $fuel)
        (local.set $status)
        (if (i32.eq (local.get $status) (global.get $REGEX_STATUS_PAUSED))
          (then (return (i32.const 1) (local.get $fuel))))
        (if (i32.ne (local.get $status) (global.get $REGEX_STATUS_OK))
          (then
            (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
            (return (call $regex_compile_raise (local.get $status)) (local.get $fuel))))
        (local.set $phase (i32.const 2))
        (call $regex_state_set (local.get $state_handle) (i32.const 0) (i32.const 2))))

    ;; Phase 2: exact-size allocation of the program, emission workspace,
    ;; and descriptor, then emission initialization. No fuel is charged
    ;; here; a pressure yield retries this phase without repeating the
    ;; scan's charged work.
    (if (i32.eq (local.get $phase) (i32.const 2))
      (then
        (local.set $program_bytes
          (call $regex_measured_program_size
            (i32.add (call $abs (local.get $scan_ws)) (i32.const 4))
            (i32.load (call $abs (local.get $scan_ws)))
            (local.get $pattern_bytes)))
        (local.set $emit_size
          (call $regex_emission_workspace_size (local.get $pattern_bytes)))
        (if (i32.or
              (i32.eq (local.get $program_bytes) (i32.const -1))
              (i32.eq (local.get $emit_size) (i32.const -1)))
          (then
            (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
            (return
              (call $regex_compile_raise (global.get $REGEX_STATUS_LIMIT_EXCEEDED))
              (local.get $fuel))))
        (if (call $check_heap_overflow
              (i32.add
                (i32.add
                  (call $estimate_arraybuffer_size (local.get $program_bytes))
                  (call $estimate_arraybuffer_size (local.get $emit_size)))
                (i32.const 32)))
          (then (return (i32.const 2) (local.get $fuel))))
        (local.set $program (call $allocate_arraybuffer (local.get $program_bytes)))
        (local.set $emit_ws (call $allocate_arraybuffer (local.get $emit_size)))
        (local.set $descriptor
          (call $allocate_regexp_descriptor
            (local.get $pattern_id) (local.get $flags_word)))
        ;; Write the program header (magic, version, counts, flags) from
        ;; the completed scan before the emission workspace binds to it.
        (local.set $status
          (call $regex_initialize_program_emission
            (i32.add (call $abs (local.get $scan_ws)) (i32.const 4))
            (i32.load (call $abs (local.get $scan_ws)))
            (local.get $pattern_bytes)
            (i32.add (call $abs (local.get $program)) (i32.const 4))
            (i32.load (call $abs (local.get $program)))
            (local.get $flags_word)))
        (if (i32.ne (local.get $status) (global.get $REGEX_STATUS_OK))
          (then
            (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
            (call $fault_error (global.get $ERR_CORRUPT_OPERAND)
              (local.get $status) (global.get $current_executing_pc))
            (return (i32.const 3) (local.get $fuel))))
        (local.set $status
          (call $regex_initialize_emission_workspace
            (i32.add (call $abs (local.get $scan_ws)) (i32.const 4))
            (i32.load (call $abs (local.get $scan_ws)))
            (local.get $pattern_bytes)
            (i32.add (call $abs (local.get $program)) (i32.const 4))
            (i32.load (call $abs (local.get $program)))
            (i32.add (call $abs (local.get $emit_ws)) (i32.const 4))
            (i32.load (call $abs (local.get $emit_ws)))))
        (if (i32.ne (local.get $status) (global.get $REGEX_STATUS_OK))
          (then
            ;; The scan accepted this pattern; a failed emission init is
            ;; substrate corruption, not guest error.
            (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
            (call $fault_error (global.get $ERR_CORRUPT_OPERAND)
              (local.get $status) (global.get $current_executing_pc))
            (return (i32.const 3) (local.get $fuel))))
        (call $regex_state_set (local.get $state_handle) (i32.const 2) (local.get $program))
        (call $regex_state_set (local.get $state_handle) (i32.const 3) (local.get $emit_ws))
        (call $regex_state_set (local.get $state_handle) (i32.const 4) (local.get $descriptor))
        (call $regex_state_set (local.get $state_handle) (i32.const 0) (i32.const 3))
        (local.set $phase (i32.const 3))
        (local.set $initialize (i32.const 1))))

    ;; Phase 3: resumable bytecode emission, then validation and commit.
    (if (i32.eq (local.get $phase) (i32.const 3))
      (then
        ;; Rebind stored absolute addresses unless this grant just
        ;; initialized them (relocation may have happened at any pause).
        (if (i32.eqz (local.get $initialize))
          (then
            ;; The emit cursor is pattern-absolute: relocate by delta.
            (local.set $old_address
              (i32.load (call $abs (i32.add
                (i32.add (local.get $emit_ws) (i32.const 4))
                (global.get $REGEX_EMIT_PATTERN_ADDRESS)))))
            (i32.store
              (call $abs (i32.add
                (i32.add (local.get $emit_ws) (i32.const 4))
                (global.get $REGEX_EMIT_CURSOR)))
              (i32.add
                (local.get $pattern_addr)
                (i32.sub
                  (i32.load (call $abs (i32.add
                    (i32.add (local.get $emit_ws) (i32.const 4))
                    (global.get $REGEX_EMIT_CURSOR))))
                  (local.get $old_address))))
            (i32.store
              (call $abs (i32.add
                (i32.add (local.get $emit_ws) (i32.const 4))
                (global.get $REGEX_EMIT_PATTERN_ADDRESS)))
              (local.get $pattern_addr))
            (i32.store
              (call $abs (i32.add
                (i32.add (local.get $emit_ws) (i32.const 4))
                (global.get $REGEX_EMIT_PROGRAM_ADDRESS)))
              (i32.add (call $abs (local.get $program)) (i32.const 4)))))
        (call $regex_emit_pattern
          (i32.add (call $abs (local.get $emit_ws)) (i32.const 4))
          (i32.load (call $abs (local.get $emit_ws)))
          (local.get $fuel))
        (local.set $fuel)
        (local.set $status)
        (if (i32.eq (local.get $status) (global.get $REGEX_STATUS_PAUSED))
          (then (return (i32.const 1) (local.get $fuel))))
        (if (i32.ne (local.get $status) (global.get $REGEX_STATUS_OK))
          (then
            ;; The measuring scan accepted this pattern, so emission can
            ;; only fail on substrate corruption.
            (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
            (call $fault_error (global.get $ERR_CORRUPT_OPERAND)
              (local.get $status) (global.get $current_executing_pc))
            (return (i32.const 3) (local.get $fuel))))
        ;; The same gate every program crosses before execution.
        (local.set $status
          (call $regex_validate_program
            (i32.add (call $abs (local.get $program)) (i32.const 4))
            (i32.load (call $abs (local.get $program)))))
        (if (i32.ne (local.get $status) (global.get $REGEX_STATUS_OK))
          (then
            (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
            (call $fault_error (global.get $ERR_CORRUPT_OPERAND)
              (local.get $status) (global.get $current_executing_pc))
            (return (i32.const 3) (local.get $fuel))))
        ;; Commit: publish the program pointer, release the paused-state
        ;; root, push the RegExp value.
        (i32.store
          (call $abs (i32.add
            (i32.add (local.get $descriptor) (global.get $GC_HEADER_SIZE))
            (global.get $REGEXP_PROGRAM_BUFFER)))
          (local.get $program))
        (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
        (call $pending_push
          (global.get $TYPE_REGEXP) (i32.const 0)
          (local.get $descriptor) (i32.const 0))
        (return (i32.const 0) (local.get $fuel))))

    ;; Unknown phase: the state root was corrupted.
    (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
    (call $fault_error (global.get $ERR_CORRUPT_OPERAND)
      (local.get $phase) (global.get $current_executing_pc))
    (return (i32.const 3) (local.get $fuel))
  )

  ;; Parse a runtime flags string ("gim"…) into the engine's flag word.
  ;; Returns the word, or -1 for a deliberately unsupported flag (u, v),
  ;; or -2 for an unknown letter, a duplicate, or a non-ASCII byte.
  ;; Flags are ASCII by construction, so a byte loop is exact.
  (func $regexp_parse_flags (param $flags_id i32) (result i32)
    (local $len_pointer i32)
    (local $len i32)
    (local $index i32)
    (local $byte i32)
    (local $bit i32)
    (local $word i32)
    (local.set $len_pointer (call $string_id_to_abs (local.get $flags_id)))
    (local.set $len (i32.load (local.get $len_pointer)))
    (local.set $index (i32.const 0))
    (block $done
      (loop $next
        (br_if $done (i32.ge_u (local.get $index) (local.get $len)))
        (local.set $byte
          (i32.load8_u
            (i32.add
              (i32.add (local.get $len_pointer) (i32.const 4))
              (local.get $index))))
        (local.set $bit (i32.const 0))
        (if (i32.eq (local.get $byte) (i32.const 0x67)) ;; g
          (then (local.set $bit (global.get $REGEXP_FLAG_GLOBAL))))
        (if (i32.eq (local.get $byte) (i32.const 0x69)) ;; i
          (then (local.set $bit (global.get $REGEXP_FLAG_IGNORE_CASE))))
        (if (i32.eq (local.get $byte) (i32.const 0x6D)) ;; m
          (then (local.set $bit (global.get $REGEXP_FLAG_MULTILINE))))
        (if (i32.eq (local.get $byte) (i32.const 0x73)) ;; s
          (then (local.set $bit (global.get $REGEXP_FLAG_DOT_ALL))))
        (if (i32.eq (local.get $byte) (i32.const 0x64)) ;; d
          (then (local.set $bit (global.get $REGEXP_FLAG_HAS_INDICES))))
        (if (i32.eq (local.get $byte) (i32.const 0x79)) ;; y
          (then (local.set $bit (global.get $REGEXP_FLAG_STICKY))))
        (if (i32.or
              (i32.eq (local.get $byte) (i32.const 0x75))   ;; u
              (i32.eq (local.get $byte) (i32.const 0x76))) ;; v
          (then (return (i32.const -1))))
        (if (i32.eqz (local.get $bit))
          (then (return (i32.const -2))))
        (if (i32.and (local.get $word) (local.get $bit))
          (then (return (i32.const -2))))
        (local.set $word (i32.or (local.get $word) (local.get $bit)))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $next)))
    (local.get $word)
  )

  ;; Render a flag word as its canonical letters (JS .flags order:
  ;; d g i m s y). Interns via heap-tail scratch; returns the string id,
  ;; or 0 with the pressure flag raised (callers yield and retry).
  (func $regexp_flags_string (param $flags_word i32) (result i32)
    (local $scratch i32)
    (local $len i32)
    (if (i32.ge_u
          (i32.add (call $read_state (global.get $STATE_HEAP_POINTER)) (i32.const 8))
          (call $read_state (global.get $STATE_CODE_POINTER)))
      (then
        (global.set $memory_pressure_signaled (i32.const 1))
        (return (i32.const 0))))
    (local.set $scratch
      (call $abs (call $read_state (global.get $STATE_HEAP_POINTER))))
    (local.set $len (i32.const 0))
    (if (i32.and (local.get $flags_word) (global.get $REGEXP_FLAG_HAS_INDICES))
      (then
        (i32.store8 (i32.add (local.get $scratch) (local.get $len)) (i32.const 0x64))
        (local.set $len (i32.add (local.get $len) (i32.const 1)))))
    (if (i32.and (local.get $flags_word) (global.get $REGEXP_FLAG_GLOBAL))
      (then
        (i32.store8 (i32.add (local.get $scratch) (local.get $len)) (i32.const 0x67))
        (local.set $len (i32.add (local.get $len) (i32.const 1)))))
    (if (i32.and (local.get $flags_word) (global.get $REGEXP_FLAG_IGNORE_CASE))
      (then
        (i32.store8 (i32.add (local.get $scratch) (local.get $len)) (i32.const 0x69))
        (local.set $len (i32.add (local.get $len) (i32.const 1)))))
    (if (i32.and (local.get $flags_word) (global.get $REGEXP_FLAG_MULTILINE))
      (then
        (i32.store8 (i32.add (local.get $scratch) (local.get $len)) (i32.const 0x6D))
        (local.set $len (i32.add (local.get $len) (i32.const 1)))))
    (if (i32.and (local.get $flags_word) (global.get $REGEXP_FLAG_DOT_ALL))
      (then
        (i32.store8 (i32.add (local.get $scratch) (local.get $len)) (i32.const 0x73))
        (local.set $len (i32.add (local.get $len) (i32.const 1)))))
    (if (i32.and (local.get $flags_word) (global.get $REGEXP_FLAG_STICKY))
      (then
        (i32.store8 (i32.add (local.get $scratch) (local.get $len)) (i32.const 0x79))
        (local.set $len (i32.add (local.get $len) (i32.const 1)))))
    (call $intern_string (local.get $scratch) (local.get $len))
  )

  ;; The script-visible .source text (ECMA-262 EscapeRegExpPattern): an
  ;; empty pattern renders as "(?:)" and every unescaped "/" is escaped,
  ;; so the result re-reads as a regex literal. Multibyte UTF-8 is safe
  ;; to scan bytewise (continuation bytes are >= 0x80). Returns the
  ;; string id, or 0 with the pressure flag raised.
  (func $regexp_source_string (param $pattern_id i32) (result i32)
    (local $pattern_pointer i32)
    (local $pattern_len i32)
    (local $index i32)
    (local $byte i32)
    (local $escaped i32)
    (local $extra i32)
    (local $scratch i32)
    (local $write i32)
    (local.set $pattern_pointer (call $string_id_to_abs (local.get $pattern_id)))
    (local.set $pattern_len (i32.load (local.get $pattern_pointer)))
    (if (i32.eqz (local.get $pattern_len))
      (then (return (call $read_builtin (global.get $BUILTIN_LIT_REGEXP_EMPTY_SOURCE)))))
    ;; Count unescaped slashes ($escaped tracks "previous byte opened an
    ;; escape", i.e. an odd backslash run).
    (local.set $index (i32.const 0))
    (local.set $escaped (i32.const 0))
    (local.set $extra (i32.const 0))
    (block $count_done
      (loop $count_next
        (br_if $count_done (i32.ge_u (local.get $index) (local.get $pattern_len)))
        (local.set $byte
          (i32.load8_u
            (i32.add
              (i32.add (local.get $pattern_pointer) (i32.const 4))
              (local.get $index))))
        (if (local.get $escaped)
          (then (local.set $escaped (i32.const 0)))
          (else
            (if (i32.eq (local.get $byte) (i32.const 0x5C)) ;; backslash
              (then (local.set $escaped (i32.const 1))))
            (if (i32.eq (local.get $byte) (i32.const 0x2F)) ;; slash
              (then (local.set $extra (i32.add (local.get $extra) (i32.const 1)))))))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $count_next)))
    (if (i32.eqz (local.get $extra))
      (then (return (local.get $pattern_id))))
    ;; Rebuild with each unescaped "/" as "\/".
    (if (i32.ge_u
          (i32.add
            (call $read_state (global.get $STATE_HEAP_POINTER))
            (i32.add (local.get $pattern_len) (local.get $extra)))
          (call $read_state (global.get $STATE_CODE_POINTER)))
      (then
        (global.set $memory_pressure_signaled (i32.const 1))
        (return (i32.const 0))))
    (local.set $scratch
      (call $abs (call $read_state (global.get $STATE_HEAP_POINTER))))
    (local.set $index (i32.const 0))
    (local.set $escaped (i32.const 0))
    (local.set $write (i32.const 0))
    (block $copy_done
      (loop $copy_next
        (br_if $copy_done (i32.ge_u (local.get $index) (local.get $pattern_len)))
        (local.set $byte
          (i32.load8_u
            (i32.add
              (i32.add (local.get $pattern_pointer) (i32.const 4))
              (local.get $index))))
        (if (local.get $escaped)
          (then (local.set $escaped (i32.const 0)))
          (else
            (if (i32.eq (local.get $byte) (i32.const 0x5C))
              (then (local.set $escaped (i32.const 1))))
            (if (i32.eq (local.get $byte) (i32.const 0x2F))
              (then
                (i32.store8 (i32.add (local.get $scratch) (local.get $write)) (i32.const 0x5C))
                (local.set $write (i32.add (local.get $write) (i32.const 1)))))))
        (i32.store8 (i32.add (local.get $scratch) (local.get $write)) (local.get $byte))
        (local.set $write (i32.add (local.get $write) (i32.const 1)))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $copy_next)))
    (call $intern_string (local.get $scratch) (local.get $write))
  )

  ;; "/source/flags" for string coercion, using the script-visible source
  ;; text. Returns the string id, or 0 with the pressure flag raised.
  (func $regexp_to_string_id (param $descriptor i32) (result i32)
    (local $data i32)
    (local $source_id i32)
    (local $source_pointer i32)
    (local $source_len i32)
    (local $flags_id i32)
    (local $flags_pointer i32)
    (local $flags_len i32)
    (local $scratch i32)
    (local $len i32)
    (local.set $data (i32.add (local.get $descriptor) (global.get $GC_HEADER_SIZE)))
    (local.set $source_id
      (call $regexp_source_string
        (i32.load (call $abs (i32.add (local.get $data) (global.get $REGEXP_PATTERN_STRING))))))
    (if (i32.eqz (local.get $source_id))
      (then (return (i32.const 0))))
    (local.set $flags_id
      (call $regexp_flags_string
        (i32.load (call $abs (i32.add (local.get $data) (global.get $REGEXP_FLAGS))))))
    (if (i32.eqz (local.get $flags_id))
      (then (return (i32.const 0))))
    (local.set $source_pointer (call $string_id_to_abs (local.get $source_id)))
    (local.set $source_len (i32.load (local.get $source_pointer)))
    (local.set $flags_pointer (call $string_id_to_abs (local.get $flags_id)))
    (local.set $flags_len (i32.load (local.get $flags_pointer)))
    (local.set $len
      (i32.add (i32.add (local.get $source_len) (local.get $flags_len)) (i32.const 2)))
    (if (i32.ge_u
          (i32.add (call $read_state (global.get $STATE_HEAP_POINTER)) (local.get $len))
          (call $read_state (global.get $STATE_CODE_POINTER)))
      (then
        (global.set $memory_pressure_signaled (i32.const 1))
        (return (i32.const 0))))
    (local.set $scratch
      (call $abs (call $read_state (global.get $STATE_HEAP_POINTER))))
    (i32.store8 (local.get $scratch) (i32.const 0x2F)) ;; /
    (memory.copy
      (i32.add (local.get $scratch) (i32.const 1))
      (i32.add (local.get $source_pointer) (i32.const 4))
      (local.get $source_len))
    (i32.store8
      (i32.add (i32.add (local.get $scratch) (i32.const 1)) (local.get $source_len))
      (i32.const 0x2F)) ;; /
    (memory.copy
      (i32.add (i32.add (local.get $scratch) (i32.const 2)) (local.get $source_len))
      (i32.add (local.get $flags_pointer) (i32.const 4))
      (local.get $flags_len))
    (call $intern_string (local.get $scratch) (local.get $len))
  )

  ;; Shared body of `new RegExp(...)` and call-form `RegExp(...)`: resolve
  ;; the pattern and flags arguments from their still-on-stack slots, then
  ;; drive the same resumable engine compile as LIT_REGEXP. The pending
  ;; pointer is restored over the constructor and arguments first, so they
  ;; stay GC-rooted (and forwarded) across every pause; on completion the
  ;; result value replaces the constructor slot. Dispositions mirror
  ;; $lit_regexp_step: 0 done, 1 fuel pause, 2 pressure, 3 uncaught,
  ;; 4 caught.
  (func $regexp_construct_step
    (param $constructor_pointer i32)
    (param $argc i32)
    (param $entry_pending_pointer i32)
    (param $fuel i32)
    (result i32 i32)
    (local $pattern_id i32)
    (local $flags_word i32)
    (local $arg_pointer i32)
    (local $arg_type i32)
    (local $descriptor_data i32)
    (local $parsed i32)
    (local $disposition i32)
    ;; Root the constructor and arguments across engine pauses.
    (call $write_ctx (global.get $CTX_PENDING_POINTER)
      (local.get $entry_pending_pointer))

    ;; Pattern argument: absent/undefined = empty pattern; a string is the
    ;; pattern text; a RegExp clones its source (and flags when no flags
    ;; argument is given, matching JS).
    (local.set $pattern_id (call $read_builtin (global.get $BUILTIN_LIT_EMPTY_STRING)))
    (local.set $flags_word (i32.const 0))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $arg_pointer
          (i32.add (local.get $constructor_pointer) (global.get $VALUE_SIZE)))
        (local.set $arg_type (call $value_type (local.get $arg_pointer)))
        (if (i32.eq (local.get $arg_type) (global.get $TYPE_STRING))
          (then
            (local.set $pattern_id (call $value_data_lo (local.get $arg_pointer))))
          (else
            (if (i32.eq (local.get $arg_type) (global.get $TYPE_REGEXP))
              (then
                (local.set $descriptor_data
                  (i32.add (call $value_data_lo (local.get $arg_pointer))
                    (global.get $GC_HEADER_SIZE)))
                (local.set $pattern_id
                  (i32.load (call $abs (i32.add (local.get $descriptor_data)
                    (global.get $REGEXP_PATTERN_STRING)))))
                (local.set $flags_word
                  (i32.load (call $abs (i32.add (local.get $descriptor_data)
                    (global.get $REGEXP_FLAGS))))))
              (else
                (if (i32.ne (local.get $arg_type) (global.get $TYPE_UNDEFINED))
                  (then
                    (if (call $throw_type_error_with_message
                          (global.get $BUILTIN_MSG_REGEXP_PATTERN))
                      (then (return (i32.const 3) (local.get $fuel)))
                      (else (return (i32.const 4) (local.get $fuel))))))))))))

    ;; Flags argument: absent/undefined keeps the default (0, or the cloned
    ;; RegExp's word); a string re-parses; anything else is a TypeError.
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then
        (local.set $arg_pointer
          (i32.add (local.get $constructor_pointer)
            (i32.mul (global.get $VALUE_SIZE) (i32.const 2))))
        (local.set $arg_type (call $value_type (local.get $arg_pointer)))
        (if (i32.eq (local.get $arg_type) (global.get $TYPE_STRING))
          (then
            (local.set $parsed
              (call $regexp_parse_flags (call $value_data_lo (local.get $arg_pointer))))
            (if (i32.eq (local.get $parsed) (i32.const -1))
              (then
                (if (call $raise_error
                      (global.get $ERR_NOT_SUPPORTED)
                      (global.get $NOT_SUPPORTED_FEATURE_REGEXP))
                  (then (return (i32.const 3) (local.get $fuel)))
                  (else (return (i32.const 4) (local.get $fuel))))))
            (if (i32.eq (local.get $parsed) (i32.const -2))
              (then
                (if (call $raise_error (global.get $ERR_SYNTAX_ERROR) (i32.const 0))
                  (then (return (i32.const 3) (local.get $fuel)))
                  (else (return (i32.const 4) (local.get $fuel))))))
            (local.set $flags_word (local.get $parsed)))
          (else
            (if (i32.ne (local.get $arg_type) (global.get $TYPE_UNDEFINED))
              (then
                (if (call $throw_type_error_with_message
                      (global.get $BUILTIN_MSG_REGEXP_FLAGS))
                  (then (return (i32.const 3) (local.get $fuel)))
                  (else (return (i32.const 4) (local.get $fuel))))))))))

    ;; Compile through the shared LIT_REGEXP machinery. Pauses park state
    ;; in CTX_REGEX_STATE; this function re-runs from the top on resume
    ;; (argument re-validation is cheap and cannot newly fail mid-flight).
    (call $lit_regexp_step
      (local.get $pattern_id) (local.get $flags_word) (local.get $fuel))
    (local.set $fuel)
    (local.set $disposition)
    (if (i32.eqz (local.get $disposition))
      (then
        ;; The result was pushed above the arguments: move it down over
        ;; the constructor slot and drop everything else.
        (i64.store (call $abs (local.get $constructor_pointer))
          (i64.load (call $abs (local.get $entry_pending_pointer))))
        (i64.store (call $abs (i32.add (local.get $constructor_pointer) (i32.const 8)))
          (i64.load (call $abs (i32.add (local.get $entry_pending_pointer) (i32.const 8)))))
        (call $write_ctx (global.get $CTX_PENDING_POINTER)
          (i32.add (local.get $constructor_pointer) (global.get $VALUE_SIZE)))))
    (return (local.get $disposition) (local.get $fuel))
  )

  ;; ==========================================================================
  ;; Schema — the JSON Schema engine's language surface.
  ;; Every fuel-carrying
  ;; operation (compile, validate, the one-shots) runs the statically
  ;; imported engine inline from CALL/CALL_METHOD/NEW and parks in
  ;; CTX_REGEX_STATE (NATIVE_CONTINUATION_STATE), sharing the root with
  ;; the RegExp arms: one operation is in flight per context at a time,
  ;; and phase numbers are disjoint (regex 1-10, schema 16+) so a mixed-up
  ;; root faults loud instead of resuming the wrong machine.
  ;;
  ;; Compile state (header mask 8 = state3, data mask 22 = state1/2/4):
  ;;   state0 = phase | kind << 8 | flags        (see SCHEMA_PH_* below)
  ;;   state1 = input msgpack ArrayBuffer DATA pointer
  ;;   state2 = compile workspace, then emission workspace (DATA)
  ;;   state3 = descriptor HEADER pointer
  ;;   state4 = program ArrayBuffer DATA pointer (0 until measured)
  ;; Validate state (header mask 8, data mask 6):
  ;;   state1 = document buffer DATA pointer (encoded, or the ref's parent)
  ;;   state2 = continuation ArrayBuffer DATA pointer
  ;;   state3 = descriptor HEADER pointer
  ;;   state4 = document byte offset inside state1's payload
  ;; ==========================================================================

  ;; state0 packing: phase in bits 0-7, result kind in bits 8-11, flags above.
  (global $SCHEMA_PH_VALIDATE_RUN i32 (i32.const 17))
  (global $SCHEMA_PH_VALIDATE_MATERIALIZE i32 (i32.const 18))
  (global $SCHEMA_PH_COMPILE_MEASURE i32 (i32.const 20))
  (global $SCHEMA_PH_COMPILE_EMIT i32 (i32.const 21))
  (global $SCHEMA_PH_COMPILE_TO_VALIDATE i32 (i32.const 22))
  (global $SCHEMA_PH_COMPILE_MEASURED i32 (i32.const 23))
  (global $SCHEMA_KIND_TEST i32 (i32.const 0))
  (global $SCHEMA_KIND_VALIDATE i32 (i32.const 1))
  (global $SCHEMA_KIND_ASSERT i32 (i32.const 2))
  (global $SCHEMA_KIND_ERRORS i32 (i32.const 3))
  (global $SCHEMA_KIND_COMPILE i32 (i32.const 4))
  (global $SCHEMA_KIND_MATCH i32 (i32.const 5))
  (global $SCHEMA_KIND_MATCH_ALL i32 (i32.const 6))
  (global $SCHEMA_FLAG_ONE_SHOT i32 (i32.const 0x1000))
  (global $SCHEMA_FLAG_DOC_REF i32 (i32.const 0x2000))
  (global $SCHEMA_FLAG_SET i32 (i32.const 0x4000))


  ;; Scratch channels for option parsing (a WAT function returns one value).
  (global $schema_opt_bits (mut i32) (i32.const 0))
  (global $msgpack_encode_json_numbers (mut i32) (i32.const 0))  ;; see $msgpack_encode_value's float arm
  (global $schema_prototype_pointer (mut i32) (i32.const 0))  ;; instanceof scratch
  (global $schema_opt_max_depth (mut i32) (i32.const 0))
  (global $schema_opt_max_errors (mut i32) (i32.const 0))
  (global $schema_opt_arena (mut i32) (i32.const 0))
  (global $schema_opt_schemas (mut i32) (i32.const 0))   ;; bundle array HEADER pointer or 0
  (global $schema_opt_base_uri (mut i32) (i32.const 0))  ;; value pointer of baseUri or 0

  ;; Descriptor: [source value:16][program:4][options:4][maxDepth:4]
  ;; [maxErrors:4][arena:4][compileFuel:4]. Caller pre-checks headroom.
  (func $allocate_schema_descriptor
    (param $source_value i32) (param $options i32)
    (param $max_depth i32) (param $max_errors i32) (param $arena i32)
    (result i32)
    (local $header i32) (local $data i32)
    (local.set $header (call $read_state (global.get $STATE_HEAP_POINTER)))
    (local.set $data (i32.add (local.get $header) (global.get $GC_HEADER_SIZE)))
    (i32.store (call $abs (local.get $header))
      (i32.or (i32.const 48) (i32.shl (global.get $OBJ_SCHEMA) (i32.const 24))))
    (i32.store (call $abs (i32.add (local.get $header) (i32.const 4))) (i32.const 0))
    (i64.store (call $abs (i32.add (local.get $data) (global.get $SCHEMA_SOURCE)))
      (i64.load (call $abs (local.get $source_value))))
    (i64.store (call $abs (i32.add (i32.add (local.get $data) (global.get $SCHEMA_SOURCE)) (i32.const 8)))
      (i64.load (call $abs (i32.add (local.get $source_value) (i32.const 8)))))
    (i32.store (call $abs (i32.add (local.get $data) (global.get $SCHEMA_PROGRAM_BUFFER))) (i32.const 0))
    (i32.store (call $abs (i32.add (local.get $data) (global.get $SCHEMA_OPTIONS))) (local.get $options))
    (i32.store (call $abs (i32.add (local.get $data) (global.get $SCHEMA_MAX_DEPTH))) (local.get $max_depth))
    (i32.store (call $abs (i32.add (local.get $data) (global.get $SCHEMA_MAX_ERRORS))) (local.get $max_errors))
    (i32.store (call $abs (i32.add (local.get $data) (global.get $SCHEMA_ARENA_BYTES))) (local.get $arena))
    (i32.store (call $abs (i32.add (local.get $data) (global.get $SCHEMA_COMPILE_FUEL))) (i32.const 0))
    (i32.store (call $abs (i32.add (local.get $data) (i32.const 40))) (i32.const 0))
    (call $write_state (global.get $STATE_HEAP_POINTER) (i32.add (local.get $header) (i32.const 48)))
    (local.get $header))

  (func $schema_descriptor_field (param $descriptor i32) (param $field i32) (result i32)
    (i32.load (call $abs (i32.add (i32.add (local.get $descriptor) (global.get $GC_HEADER_SIZE)) (local.get $field)))))

  ;; Does the interned string contain the builtin literal as a substring?
  (func $string_contains_builtin (param $string_id i32) (param $builtin i32) (result i32)
    (local $hay i32) (local $hay_len i32) (local $needle i32) (local $needle_len i32) (local $i i32) (local $j i32)
    (local.set $hay (call $string_id_to_abs (local.get $string_id)))
    (local.set $hay_len (i32.load (local.get $hay)))
    (local.set $hay (i32.add (local.get $hay) (i32.const 4)))
    (local.set $needle (call $string_id_to_abs (call $read_builtin (local.get $builtin))))
    (local.set $needle_len (i32.load (local.get $needle)))
    (local.set $needle (i32.add (local.get $needle) (i32.const 4)))
    (if (i32.gt_u (local.get $needle_len) (local.get $hay_len)) (then (return (i32.const 0))))
    (block $done (loop $outer
      (br_if $done (i32.gt_u (i32.add (local.get $i) (local.get $needle_len)) (local.get $hay_len)))
      (local.set $j (i32.const 0))
      (block $mismatch (loop $inner
        (br_if $mismatch (i32.ge_u (local.get $j) (local.get $needle_len)))
        (br_if $mismatch (i32.ne
          (i32.load8_u (i32.add (local.get $hay) (i32.add (local.get $i) (local.get $j))))
          (i32.load8_u (i32.add (local.get $needle) (local.get $j)))))
        (local.set $j (i32.add (local.get $j) (i32.const 1)))
        (br $inner)))
      (if (i32.eq (local.get $j) (local.get $needle_len)) (then (return (i32.const 1))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $outer)))
    (i32.const 0))

  ;; Dialect option bits from options.dialect, else the schema's $schema.
  (func $schema_dialect_bits (param $dialect_id i32) (result i32)
    (if (call $string_contains_builtin (local.get $dialect_id) (global.get $BUILTIN_LIT_DIALECT_04))
      (then (return (global.get $SCHEMA_OPT_DIALECT_04))))
    (if (i32.or
          (call $string_contains_builtin (local.get $dialect_id) (global.get $BUILTIN_LIT_DIALECT_06))
          (call $string_contains_builtin (local.get $dialect_id) (global.get $BUILTIN_LIT_DIALECT_07)))
      (then (return (global.get $SCHEMA_OPT_DIALECT_07))))
    (i32.const 0))

  ;; Value slot of an object's own/inherited property, or 0.
  (func $schema_option_slot (param $object_pointer i32) (param $key_builtin i32) (result i32)
    (local $entry i32)
    (if (i32.eqz (local.get $object_pointer)) (then (return (i32.const 0))))
    (local.set $entry (call $object_find_string_entry (local.get $object_pointer) (call $read_builtin (local.get $key_builtin))))
    (if (i32.eqz (local.get $entry)) (then (return (i32.const 0))))
    (if (i32.eq (call $value_type (i32.add (local.get $entry) (i32.const 4))) (global.get $TYPE_UNDEFINED))
      (then (return (i32.const 0))))
    (i32.add (local.get $entry) (i32.const 4)))

  ;; Parse compile options into the $schema_opt_* channels. Returns 0, or
  ;; a builtin message id for a TypeError the caller throws.
  (func $schema_read_options (param $schema_slot i32) (param $options_pointer i32) (result i32)
    (local $slot i32) (local $bits i32) (local $n f64)
    (local $dialect_source i32)
    (global.set $schema_opt_bits (i32.const 0))
    (global.set $schema_opt_max_depth (global.get $SCHEMA_LIMITS_DEFAULT_MAX_DEPTH))
    (global.set $schema_opt_max_errors (global.get $SCHEMA_LIMITS_DEFAULT_ERROR_CAPACITY))
    (global.set $schema_opt_arena (global.get $SCHEMA_LIMITS_DEFAULT_ARENA_BYTES))
    (global.set $schema_opt_schemas (i32.const 0))
    (global.set $schema_opt_base_uri (i32.const 0))
    (local.set $slot (call $schema_option_slot (local.get $options_pointer) (global.get $BUILTIN_KEY_STRICT)))
    (if (local.get $slot)
      (then (if (call $value_data_lo (local.get $slot)) (then (local.set $bits (i32.or (local.get $bits) (global.get $SCHEMA_OPT_STRICT)))))))
    (local.set $slot (call $schema_option_slot (local.get $options_pointer) (global.get $BUILTIN_FORMATS)))
    (if (local.get $slot)
      (then
        (if (i32.and (i32.eq (call $value_type (local.get $slot)) (global.get $TYPE_STRING))
                     (i32.eq (call $value_data_lo (local.get $slot)) (call $read_builtin (global.get $BUILTIN_LIT_ANNOTATE))))
          (then (local.set $bits (i32.or (local.get $bits) (global.get $SCHEMA_OPT_FORMAT_ANNOTATE)))))))
    ;; dialect: the option wins; else the root schema's $schema string
    (local.set $dialect_source (i32.const 0))
    (local.set $slot (call $schema_option_slot (local.get $options_pointer) (global.get $BUILTIN_KEY_DIALECT)))
    (if (i32.and (i32.ne (local.get $slot) (i32.const 0)) (i32.eq (call $value_type (local.get $slot)) (global.get $TYPE_STRING)))
      (then (local.set $dialect_source (call $value_data_lo (local.get $slot))))
      (else
        (if (i32.eq (call $value_type (local.get $schema_slot)) (global.get $TYPE_OBJECT))
          (then
            (local.set $slot (call $schema_option_slot (call $value_data_lo (local.get $schema_slot)) (global.get $BUILTIN_KEY_DOLLAR_SCHEMA)))
            (if (i32.and (i32.ne (local.get $slot) (i32.const 0)) (i32.eq (call $value_type (local.get $slot)) (global.get $TYPE_STRING)))
              (then (local.set $dialect_source (call $value_data_lo (local.get $slot)))))))))
    (if (local.get $dialect_source)
      (then (local.set $bits (i32.or (local.get $bits) (call $schema_dialect_bits (local.get $dialect_source))))))
    (global.set $schema_opt_bits (local.get $bits))
    (local.set $slot (call $schema_option_slot (local.get $options_pointer) (global.get $BUILTIN_KEY_MAX_DEPTH)))
    (if (local.get $slot)
      (then
        (if (i32.eqz (call $value_is_numeric (local.get $slot))) (then (return (global.get $BUILTIN_MSG_SCHEMA_OPTIONS))))
        (local.set $n (call $value_to_f64 (local.get $slot)))
        (if (i32.or (f64.lt (local.get $n) (f64.const 1)) (f64.gt (local.get $n) (f64.const 65536))) (then (return (global.get $BUILTIN_MSG_SCHEMA_LIMIT))))
        (global.set $schema_opt_max_depth (i32.trunc_f64_u (local.get $n)))))
    (local.set $slot (call $schema_option_slot (local.get $options_pointer) (global.get $BUILTIN_KEY_MAX_ERRORS)))
    (if (local.get $slot)
      (then
        (if (i32.eqz (call $value_is_numeric (local.get $slot))) (then (return (global.get $BUILTIN_MSG_SCHEMA_OPTIONS))))
        (local.set $n (call $value_to_f64 (local.get $slot)))
        (if (i32.or (f64.lt (local.get $n) (f64.const 0)) (f64.gt (local.get $n) (f64.const 65536))) (then (return (global.get $BUILTIN_MSG_SCHEMA_LIMIT))))
        (global.set $schema_opt_max_errors (i32.trunc_f64_u (local.get $n)))))
    (local.set $slot (call $schema_option_slot (local.get $options_pointer) (global.get $BUILTIN_KEY_ARENA_BYTES)))
    (if (local.get $slot)
      (then
        (if (i32.eqz (call $value_is_numeric (local.get $slot))) (then (return (global.get $BUILTIN_MSG_SCHEMA_OPTIONS))))
        (local.set $n (call $value_to_f64 (local.get $slot)))
        (if (i32.or (f64.lt (local.get $n) (f64.const 0)) (f64.gt (local.get $n) (f64.const 268435456))) (then (return (global.get $BUILTIN_MSG_SCHEMA_LIMIT))))
        (global.set $schema_opt_arena (i32.trunc_f64_u (local.get $n)))))
    (local.set $slot (call $schema_option_slot (local.get $options_pointer) (global.get $BUILTIN_KEY_SCHEMAS)))
    (if (local.get $slot)
      (then
        (if (i32.ne (call $value_type (local.get $slot)) (global.get $TYPE_ARRAY)) (then (return (global.get $BUILTIN_MSG_SCHEMA_BUNDLE))))
        (global.set $schema_opt_schemas (call $value_data_lo (local.get $slot)))))
    (local.set $slot (call $schema_option_slot (local.get $options_pointer) (global.get $BUILTIN_KEY_BASE_URI)))
    (if (local.get $slot)
      (then
        (if (i32.ne (call $value_type (local.get $slot)) (global.get $TYPE_STRING)) (then (return (global.get $BUILTIN_MSG_SCHEMA_OPTIONS))))
        (global.set $schema_opt_base_uri (local.get $slot))))
    (i32.const 0))

  ;; Encode the compile input as msgpack: the schema alone, or the bundle
  ;; [schema, baseUri|nil, [uri, document]...] when a bundle option is set.
  ;; Returns the ArrayBuffer DATA pointer, or 0 (pressure flag set, or an
  ;; error staged with $set_error).
  (func $schema_encode_input (param $schema_slot i32) (param $set i32) (result i32)
    (local $out i32) (local $visited i32) (local $pos i32) (local $count i32) (local $i i32)
    (local $array i32) (local $elem_base i32) (local $elem i32) (local $data_ptr i32) (local $buffer i32)
    (if (call $check_heap_overflow
          (i32.add
            (call $estimate_arraybuffer_size (i32.const 4096))
            (i32.add
              (call $estimate_arraybuffer_size (i32.const 1024))
              (i32.mul (call $estimate_typed_array_descriptor_size) (i32.const 2)))))
      (then (return (i32.const 0))))
    (local.set $out (call $json_alloc_buffer (i32.const 4096)))
    (local.set $visited (call $json_alloc_buffer (i32.const 1024)))
    (local.set $pos (i32.const 0))
    (if (i32.or (local.get $set) (i32.or (global.get $schema_opt_schemas) (global.get $schema_opt_base_uri)))
      (then
        (local.set $array (global.get $schema_opt_schemas))
        (local.set $count (i32.const 0))
        (if (local.get $array)
          (then (local.set $count (i32.load (call $abs (i32.add (local.get $array) (i32.const 8)))))))
        (local.set $count (i32.add (local.get $count) (i32.const 2)))
        (if (i32.lt_u (local.get $count) (i32.const 16))
          (then (local.set $pos (call $json_write_byte (local.get $out) (local.get $pos) (i32.or (i32.const 0x90) (local.get $count)))))
          (else
            (local.set $pos (call $json_write_byte (local.get $out) (local.get $pos) (i32.const 0xdd)))
            (if (i32.ne (local.get $pos) (i32.const -1))
              (then (local.set $pos (call $json_write_byte (local.get $out) (local.get $pos) (i32.shr_u (local.get $count) (i32.const 24))))))
            (if (i32.ne (local.get $pos) (i32.const -1))
              (then (local.set $pos (call $json_write_byte (local.get $out) (local.get $pos) (i32.and (i32.shr_u (local.get $count) (i32.const 16)) (i32.const 255))))))
            (if (i32.ne (local.get $pos) (i32.const -1))
              (then (local.set $pos (call $json_write_byte (local.get $out) (local.get $pos) (i32.and (i32.shr_u (local.get $count) (i32.const 8)) (i32.const 255))))))
            (if (i32.ne (local.get $pos) (i32.const -1))
              (then (local.set $pos (call $json_write_byte (local.get $out) (local.get $pos) (i32.and (local.get $count) (i32.const 255))))))))
        (if (i32.eq (local.get $pos) (i32.const -1)) (then (return (i32.const 0))))
        (local.set $pos (call $msgpack_encode_value (local.get $schema_slot) (local.get $out) (local.get $pos) (local.get $visited)))
        (if (i32.eq (local.get $pos) (i32.const -1)) (then (return (i32.const 0))))
        (if (global.get $schema_opt_base_uri)
          (then (local.set $pos (call $msgpack_encode_value (global.get $schema_opt_base_uri) (local.get $out) (local.get $pos) (local.get $visited))))
          (else (local.set $pos (call $json_write_byte (local.get $out) (local.get $pos) (i32.const 0xc0)))))
        (if (i32.eq (local.get $pos) (i32.const -1)) (then (return (i32.const 0))))
        (if (local.get $array)
          (then
            (local.set $elem_base (i32.add (i32.load (call $abs (i32.add (local.get $array) (i32.const 16)))) (global.get $GC_HEADER_SIZE)))
            (local.set $count (i32.load (call $abs (i32.add (local.get $array) (i32.const 8)))))
            (local.set $i (i32.const 0))
            (block $done (loop $loop
              (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
              (local.set $elem (i32.add (local.get $elem_base) (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
              ;; every entry is a [uri, document] pair
              (if (i32.ne (call $value_type (local.get $elem)) (global.get $TYPE_ARRAY))
                (then
                  (call $set_error (global.get $ERR_TYPE_ERROR) (i32.const 0))
                  (return (i32.const 0))))
              (if (i32.ne (i32.load (call $abs (i32.add (call $value_data_lo (local.get $elem)) (i32.const 8)))) (i32.const 2))
                (then
                  (call $set_error (global.get $ERR_TYPE_ERROR) (i32.const 0))
                  (return (i32.const 0))))
              (local.set $pos (call $msgpack_encode_value (local.get $elem) (local.get $out) (local.get $pos) (local.get $visited)))
              (if (i32.eq (local.get $pos) (i32.const -1)) (then (return (i32.const 0))))
              (local.set $i (i32.add (local.get $i) (i32.const 1)))
              (br $loop))))))
      (else
        (local.set $pos (call $msgpack_encode_value (local.get $schema_slot) (local.get $out) (local.get $pos) (local.get $visited)))
        (if (i32.eq (local.get $pos) (i32.const -1)) (then (return (i32.const 0))))))
    (if (call $check_heap_overflow (call $estimate_arraybuffer_size (local.get $pos)))
      (then (return (i32.const 0))))
    (local.set $data_ptr (call $json_buffer_data_ptr (local.get $out)))
    (local.set $buffer (call $allocate_arraybuffer (local.get $pos)))
    (if (local.get $pos)
      (then (memory.copy (call $abs (i32.add (local.get $buffer) (i32.const 4))) (call $abs (local.get $data_ptr)) (local.get $pos))))
    (local.get $buffer))

  ;; Raise the SandScript error for a failed compile status, reading the
  ;; workspace diagnostic. Returns 3 (uncaught) or 4 (caught).
  (func $schema_compile_raise (param $status i32) (param $ws_abs i32) (result i32)
    (local $code i32) (local $keyword i32) (local $offset i32) (local $detail i32) (local $error i32) (local $len i32) (local $id i32)
    (call $schema_compile_diagnostic (local.get $ws_abs))
    (local.set $offset) (local.set $keyword) (local.set $code)
    (local.set $detail (i32.load (i32.add (local.get $ws_abs) (global.get $SCHEMA_WH_DIAGNOSTIC_DETAIL))))
    (if (i32.and (i32.eq (local.get $code) (global.get $SCHEMA_DIAG_REGEX)) (i32.eq (local.get $detail) (global.get $REGEX_STATUS_UNSUPPORTED)))
      (then
        (if (call $raise_error (global.get $ERR_NOT_SUPPORTED) (global.get $NOT_SUPPORTED_FEATURE_REGEXP))
          (then (return (i32.const 3)))
          (else (return (i32.const 4))))))
    (if (i32.or (i32.eq (local.get $status) (global.get $SCHEMA_STATUS_LIMIT_EXCEEDED))
                (i32.eq (local.get $status) (global.get $SCHEMA_STATUS_BUFFER_TOO_SMALL)))
      (then
        (if (call $throw_range_error_with_message (global.get $BUILTIN_MSG_SCHEMA_LIMIT))
          (then (return (i32.const 3)))
          (else (return (i32.const 4))))))
    ;; SyntaxError { message, keyword, code }
    (if (call $check_heap_overflow (i32.add (global.get $OBJECT_HEADER_SIZE) (i32.const 176)))
      (then
        ;; no headroom for the error object: the plain-detail path
        (if (call $raise_error (global.get $ERR_SYNTAX_ERROR) (local.get $code))
          (then (return (i32.const 3)))
          (else (return (i32.const 4))))))
    (local.set $error (call $allocate_error_object (call $read_state (global.get $STATE_SYNTAX_ERROR_PROTOTYPE)) (global.get $BUILTIN_MSG_SCHEMA_INVALID)))
    (if (local.get $keyword)
      (then
        (if (i32.eqz (call $check_concat_scratch_overflow (i32.const 1024)))
          (then
            (local.set $len (call $schema_keyword_name (local.get $keyword) (call $abs (call $read_state (global.get $STATE_HEAP_POINTER))) (i32.const 1024)))
            (if (i32.gt_s (local.get $len) (i32.const 0))
              (then
                (local.set $id (call $intern_string (call $abs (call $read_state (global.get $STATE_HEAP_POINTER))) (local.get $len)))
                (if (local.get $id)
                  (then (drop (call $object_set_property (local.get $error) (call $read_builtin (global.get $BUILTIN_KEY_KEYWORD))
                                (global.get $TYPE_STRING) (i32.const 0) (local.get $id) (i32.const 0)))))))))))
    (drop (call $object_set_property (local.get $error) (call $read_builtin (global.get $BUILTIN_KEY_DIAGNOSTIC))
            (global.get $TYPE_FLOAT) (i32.const 0)
            (i32.wrap_i64 (i64.reinterpret_f64 (f64.convert_i32_u (local.get $code))))
            (i32.wrap_i64 (i64.shr_u (i64.reinterpret_f64 (f64.convert_i32_u (local.get $code))) (i64.const 32)))))
    (if (call $throw_allocated_error (local.get $error))
      (then (return (i32.const 3)))
      (else (return (i32.const 4))))
    (unreachable))

  ;; Materialize the stored error records of a finished VALIDATE-mode
  ;; continuation as an array of { instancePath, schemaPath, keyword,
  ;; params, message } objects. Returns (array HEADER pointer, remaining fuel),
  ;; or (0, fuel) on pressure / (-1, fuel) on substrate fault. Partial decoded
  ;; objects are garbage on retry; the finished validation remains settled.
  (func $schema_materialize_errors (param $program_abs i32) (param $cont_abs i32) (param $start i32) (param $count i32) (param $fuel i32) (result i32 i32)
    (local $stored i32) (local $array i32) (local $elem_base i32) (local $i i32) (local $cap i32) (local $n i32)
    (local $scratch i32) (local $staged i32) (local $buffer i32) (local $slot i32) (local $object i32)
    (local $work i64) (local $overflow i32)
    (local.set $stored (i32.add (local.get $start) (local.get $count)))
    (if (call $check_heap_overflow (call $estimate_array_size (local.get $count))) (then (return (i32.const 0) (local.get $fuel))))
    (local.set $array (call $allocate_array (local.get $count)))
    (local.set $elem_base (i32.add (i32.add (local.get $array) (global.get $ARRAY_HEADER_SIZE)) (i32.const 8)))
    (local.set $i (local.get $start))
    (block $done (loop $loop
      (br_if $done (i32.ge_u (local.get $i) (local.get $stored)))
      ;; render into heap-tail scratch, growing the window as needed
      (local.set $cap (i32.const 8192))
      (block $rendered (loop $grow
        (if (call $check_concat_scratch_overflow (i32.add (local.get $cap) (call $estimate_arraybuffer_size (local.get $cap))))
          (then (return (i32.const 0) (local.get $fuel))))
        (local.set $scratch (call $abs (call $read_state (global.get $STATE_HEAP_POINTER))))
        (call $schema_render_error_complete (local.get $program_abs) (local.get $cont_abs) (local.get $i) (local.get $scratch) (local.get $cap))
        (local.set $overflow) (local.set $work) (local.set $n)
        ;; Debit even failed windows before growth, pressure, faults, or return.
        (local.set $fuel (call $schema_debit_work (local.get $fuel) (local.get $work) (local.get $overflow)))
        (br_if $rendered (i32.ge_s (local.get $n) (i32.const 0)))
        (if (i32.or (i32.ne (local.get $n) (i32.const -1)) (i32.ge_u (local.get $cap) (i32.const 0x1000000)))
          (then
            (call $set_error (global.get $ERR_CORRUPT_OPERAND) (local.get $n))
            (return (i32.const -1) (local.get $fuel))))
        (local.set $cap (i32.shl (local.get $cap) (i32.const 1)))
        (br $grow)))
      ;; move the bytes clear of the buffer about to be carved, then copy in
      (local.set $staged (i32.add (local.get $scratch) (call $estimate_arraybuffer_size (local.get $n))))
      (memory.copy (local.get $staged) (local.get $scratch) (local.get $n))
      (local.set $buffer (call $allocate_arraybuffer (local.get $n)))
      (memory.copy (call $abs (i32.add (local.get $buffer) (i32.const 4))) (local.get $staged) (local.get $n))
      (if (call $msgpack_decode_any
            (call $abs (i32.add (local.get $buffer) (i32.const 4)))
            (call $abs (i32.add (i32.add (local.get $buffer) (i32.const 4)) (local.get $n)))
            (local.get $buffer))
        (then
          (if (global.get $memory_pressure_signaled) (then (return (i32.const 0) (local.get $fuel))))
          (call $set_error (global.get $ERR_CORRUPT_OPERAND) (i32.const 0))
          (return (i32.const -1) (local.get $fuel))))
      (local.set $slot (call $pending_pop))
      (local.set $object (call $value_data_lo (local.get $slot)))
      (call $write_value (i32.add (local.get $elem_base) (i32.mul (i32.sub (local.get $i) (local.get $start)) (global.get $VALUE_SIZE)))
        (global.get $TYPE_OBJECT) (i32.const 0) (local.get $object) (i32.const 0))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $loop)))
    (local.get $array) (local.get $fuel))

  ;; A set's result: match → the matching route indices; matchAll → one
  ;; { index, valid, errors } per route. Returns (array HEADER pointer, fuel),
  ;; (0, fuel) on pressure, or (-1, fuel) on a substrate fault.
  (func $schema_materialize_set (param $kind i32) (param $program_abs i32) (param $cont_abs i32) (param $fuel i32) (result i32 i32)
    (local $routes i32) (local $i i32) (local $count i32) (local $array i32) (local $elem_base i32) (local $rt i32) (local $object i32)
    (local $errors i32) (local $valid i32) (local $bits i64)
    (local.set $routes (call $schema_program_route_count (local.get $program_abs)))
    (if (i32.eq (local.get $kind) (global.get $SCHEMA_KIND_MATCH))
      (then
        (local.set $i (i32.const 0))
        (block $cd (loop $cl
          (br_if $cd (i32.ge_u (local.get $i) (local.get $routes)))
          (local.set $count (i32.add (local.get $count) (i32.load (call $schema_route_result (local.get $cont_abs) (local.get $i)))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $cl)))
        (if (call $check_heap_overflow (call $estimate_array_size (local.get $count))) (then (return (i32.const 0) (local.get $fuel))))
        (local.set $array (call $allocate_array (local.get $count)))
        (local.set $elem_base (i32.add (i32.add (local.get $array) (global.get $ARRAY_HEADER_SIZE)) (i32.const 8)))
        (local.set $i (i32.const 0))
        (local.set $count (i32.const 0))
        (block $wd (loop $wl
          (br_if $wd (i32.ge_u (local.get $i) (local.get $routes)))
          (if (i32.load (call $schema_route_result (local.get $cont_abs) (local.get $i)))
            (then
              (local.set $bits (i64.reinterpret_f64 (f64.convert_i32_u (local.get $i))))
              (call $write_value (i32.add (local.get $elem_base) (i32.mul (local.get $count) (global.get $VALUE_SIZE)))
                (global.get $TYPE_FLOAT) (i32.const 0) (i32.wrap_i64 (local.get $bits)) (i32.wrap_i64 (i64.shr_u (local.get $bits) (i64.const 32))))
              (local.set $count (i32.add (local.get $count) (i32.const 1)))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $wl)))
        (return (local.get $array) (local.get $fuel))))
    ;; matchAll
    (if (call $check_heap_overflow (call $estimate_array_size (local.get $routes))) (then (return (i32.const 0) (local.get $fuel))))
    (local.set $array (call $allocate_array (local.get $routes)))
    (local.set $elem_base (i32.add (i32.add (local.get $array) (global.get $ARRAY_HEADER_SIZE)) (i32.const 8)))
    (local.set $i (i32.const 0))
    (block $rd (loop $rl
      (br_if $rd (i32.ge_u (local.get $i) (local.get $routes)))
      (local.set $rt (call $schema_route_result (local.get $cont_abs) (local.get $i)))
      (local.set $valid (i32.load (local.get $rt)))
      (call $schema_materialize_errors (local.get $program_abs) (local.get $cont_abs)
        (i32.load offset=4 (local.get $rt)) (select (i32.const 0) (i32.load offset=8 (local.get $rt)) (local.get $valid)) (local.get $fuel))
      (local.set $fuel) (local.set $errors)
      (if (i32.le_s (local.get $errors) (i32.const 0)) (then (return (local.get $errors) (local.get $fuel))))
      (if (call $check_heap_overflow (call $estimate_object_size (i32.const 3))) (then (return (i32.const 0) (local.get $fuel))))
      (local.set $object (call $allocate_object (i32.const 3)))
      (local.set $bits (i64.reinterpret_f64 (f64.convert_i32_u (local.get $i))))
      (drop (call $object_set_property (local.get $object) (call $read_builtin (global.get $BUILTIN_MATCH_INDEX))
              (global.get $TYPE_FLOAT) (i32.const 0) (i32.wrap_i64 (local.get $bits)) (i32.wrap_i64 (i64.shr_u (local.get $bits) (i64.const 32)))))
      (drop (call $object_set_property (local.get $object) (call $read_builtin (global.get $BUILTIN_KEY_VALID))
              (global.get $TYPE_BOOLEAN) (i32.const 0) (local.get $valid) (i32.const 0)))
      (drop (call $object_set_property (local.get $object) (call $read_builtin (global.get $BUILTIN_ERRORS))
              (global.get $TYPE_ARRAY) (i32.const 0) (local.get $errors) (i32.const 0)))
      (call $write_value (i32.add (local.get $elem_base) (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
        (global.get $TYPE_OBJECT) (i32.const 0) (local.get $object) (i32.const 0))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $rl)))
    (local.get $array) (local.get $fuel))

  ;; Throw disposition helper: 3 uncaught / 4 caught from a $throw_* result.
  (func $schema_throw_disposition (param $uncaught i32) (result i32)
    (select (i32.const 3) (i32.const 4) (local.get $uncaught)))

  ;; Consume atomic source work with no future engine step to spend its debt:
  ;; failed setup totals and EVERY complete rendering attempt. Successful setup
  ;; and resumed validation still spend their own debt inside the engine.
  ;; Compare unsigned work against the representable subtraction range BEFORE
  ;; subtracting: an i64 charge may itself have its sign bit set. Overflow and
  ;; unrepresentable remaining fuel clamp without replacing the source error.
  (func $schema_debit_work (param $fuel i32) (param $work i64) (param $overflow i32) (result i32)
    (if (i32.or (local.get $overflow)
          (i64.gt_u (local.get $work)
            (i64.sub (i64.extend_i32_s (local.get $fuel)) (i64.const -2147483648))))
      (then (return (i32.const -2147483648))))
    (i32.wrap_i64 (i64.sub (i64.extend_i32_s (local.get $fuel)) (local.get $work))))

  ;; One fuel grant's worth of a Schema operation. The disposition protocol
  ;; mirrors $lit_regexp_step: 0 done (result written at $result_slot, the
  ;; pending pointer set just past it), 1 paused on fuel, 2 memory pressure
  ;; (fuel includes work before refusal), 3 thrown uncaught, 4 thrown and caught.
  ;;   $receiver_pointer — descriptor HEADER for instance methods (unused
  ;;     for statics and the constructor)
  ;;   $args_base — first argument value slot; $argc arguments follow
  ;;   $entry_pending_pointer — pending pointer rooting callee + args
  (func $schema_op_step
    (param $method_id i32) (param $receiver_pointer i32) (param $result_slot i32)
    (param $argc i32) (param $args_base i32) (param $entry_pending_pointer i32)
    (param $fuel i32)
    (result i32 i32)
    (local $state i32) (local $word i32) (local $phase i32) (local $kind i32) (local $flags i32)
    (local $input i32) (local $ws i32) (local $descriptor i32) (local $program i32) (local $cont i32)
    (local $schema_slot i32) (local $options_pointer i32) (local $value_slot i32) (local $validate_options i32)
    (local $arg i32) (local $type i32) (local $msg i32) (local $status i32) (local $bytes i32) (local $ws_size i32)
    (local $program_size i32) (local $ews_size i32) (local $initialize i32) (local $err_cap i32)
    (local $doc_abs i32) (local $doc_len i32) (local $doc_ref i32) (local $prog_abs i32) (local $prog_len i32)
    (local $cont_abs i32) (local $cont_len i32) (local $required i32) (local $arena i32) (local $max_depth i32)
    (local $result i32) (local $errors i32) (local $object i32) (local $error i32) (local $disposition i32)
    (local $mode i32) (local $one_shot i32) (local $descriptor_data i32)
    (local $is_set i32) (local $route_slot i32) (local $routes i32) (local $route i32) (local $rt i32)

    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $entry_pending_pointer))
    (local.set $state (call $read_ctx (global.get $CTX_REGEX_STATE)))

    ;; ---- argument shape per method (re-derived on every grant) ----------
    ;; Absent arguments read as 0 (no slot) rather than a stack slot past
    ;; argc, which is not rooted and may hold anything.
    (local.set $one_shot (i32.const 0))
    (local.set $schema_slot (i32.const 0))
    (local.set $value_slot (i32.const 0))
    (local.set $options_pointer (i32.const 0))
    (local.set $validate_options (i32.const 0))
    (if (i32.or (i32.eq (local.get $method_id) (global.get $METHOD_SCHEMA_CONSTRUCTOR))
                (i32.or (i32.eq (local.get $method_id) (global.get $METHOD_SCHEMA_COMPILE))
                        (i32.eq (local.get $method_id) (global.get $METHOD_SCHEMA_COMPILE_SET))))
      (then
        (local.set $kind (global.get $SCHEMA_KIND_COMPILE))
        (if (i32.ge_u (local.get $argc) (i32.const 1)) (then (local.set $schema_slot (local.get $args_base))))
        (if (i32.ge_u (local.get $argc) (i32.const 2)) (then (local.set $options_pointer (i32.add (local.get $args_base) (global.get $VALUE_SIZE))))))
      (else
        (if (i32.or (i32.eq (local.get $method_id) (global.get $METHOD_SCHEMA_TEST_STATIC))
                    (i32.eq (local.get $method_id) (global.get $METHOD_SCHEMA_VALIDATE_STATIC)))
          (then
            (local.set $one_shot (i32.const 1))
            (local.set $kind (select (global.get $SCHEMA_KIND_TEST) (global.get $SCHEMA_KIND_VALIDATE)
                                     (i32.eq (local.get $method_id) (global.get $METHOD_SCHEMA_TEST_STATIC))))
            (if (i32.ge_u (local.get $argc) (i32.const 1)) (then (local.set $schema_slot (local.get $args_base))))
            (if (i32.ge_u (local.get $argc) (i32.const 2)) (then (local.set $value_slot (i32.add (local.get $args_base) (global.get $VALUE_SIZE)))))
            (if (i32.ge_u (local.get $argc) (i32.const 3))
              (then
                (local.set $options_pointer (i32.add (local.get $args_base) (i32.mul (global.get $VALUE_SIZE) (i32.const 2))))
                (local.set $validate_options (local.get $options_pointer)))))
          (else
            (local.set $kind (global.get $SCHEMA_KIND_TEST))
            (if (i32.eq (local.get $method_id) (global.get $METHOD_SCHEMA_VALIDATE)) (then (local.set $kind (global.get $SCHEMA_KIND_VALIDATE))))
            (if (i32.eq (local.get $method_id) (global.get $METHOD_SCHEMA_ASSERT)) (then (local.set $kind (global.get $SCHEMA_KIND_ASSERT))))
            (if (i32.eq (local.get $method_id) (global.get $METHOD_SCHEMA_ERRORS)) (then (local.set $kind (global.get $SCHEMA_KIND_ERRORS))))
            (if (i32.eq (local.get $method_id) (global.get $METHOD_SCHEMA_MATCH)) (then (local.set $kind (global.get $SCHEMA_KIND_MATCH))))
            (if (i32.eq (local.get $method_id) (global.get $METHOD_SCHEMA_MATCH_ALL)) (then (local.set $kind (global.get $SCHEMA_KIND_MATCH_ALL))))
            (if (i32.ge_u (local.get $argc) (i32.const 1)) (then (local.set $value_slot (local.get $args_base))))
            (if (i32.ge_u (local.get $argc) (i32.const 2)) (then (local.set $validate_options (i32.add (local.get $args_base) (global.get $VALUE_SIZE)))))
            (local.set $descriptor (local.get $receiver_pointer))
            ;; on a set, test(value, index): the second argument is the route
            (local.set $is_set (i32.and (call $schema_descriptor_field (local.get $descriptor) (global.get $SCHEMA_OPTIONS)) (global.get $SCHEMA_OPT_SET)))
            (if (i32.and (i32.ne (local.get $is_set) (i32.const 0)) (i32.eq (local.get $kind) (global.get $SCHEMA_KIND_TEST)))
              (then
                (local.set $route_slot (local.get $validate_options))
                (local.set $validate_options (i32.const 0))))))))
    ;; option objects: undefined or an object
    (if (local.get $options_pointer)
      (then
        (local.set $type (call $value_type (local.get $options_pointer)))
        (if (i32.eq (local.get $type) (global.get $TYPE_UNDEFINED))
          (then (local.set $options_pointer (i32.const 0)))
          (else
            (if (i32.ne (local.get $type) (global.get $TYPE_OBJECT))
              (then (return (call $schema_throw_disposition (call $throw_type_error_with_message (global.get $BUILTIN_MSG_SCHEMA_OPTIONS))) (local.get $fuel))))
            (local.set $options_pointer (call $value_data_lo (local.get $options_pointer)))))))
    (if (local.get $validate_options)
      (then
        (local.set $type (call $value_type (local.get $validate_options)))
        (if (i32.eq (local.get $type) (global.get $TYPE_UNDEFINED))
          (then (local.set $validate_options (i32.const 0)))
          (else
            (if (i32.ne (local.get $type) (global.get $TYPE_OBJECT))
              (then (return (call $schema_throw_disposition (call $throw_type_error_with_message (global.get $BUILTIN_MSG_SCHEMA_OPTIONS))) (local.get $fuel))))
            (local.set $validate_options (call $value_data_lo (local.get $validate_options)))))))

    ;; ---- resume or begin ---------------------------------------------------
    (if (local.get $state)
      (then
        (local.set $word (call $native_continuation_state_get (local.get $state) (i32.const 0)))
        (local.set $phase (i32.and (local.get $word) (i32.const 0xff)))
        (local.set $flags (local.get $word))
        (if (i32.or (i32.lt_u (local.get $phase) (i32.const 16))
                    (i32.gt_u (local.get $phase) (i32.const 23)))
          (then
            ;; A RegExp/Proof phase in the Schema arm: corrupted root
            (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
            (call $fault_error (global.get $ERR_CORRUPT_OPERAND) (local.get $phase) (global.get $current_executing_pc))
            (return (i32.const 3) (local.get $fuel))))
        (local.set $input (call $native_continuation_state_get (local.get $state) (i32.const 1)))
        (local.set $ws (call $native_continuation_state_get (local.get $state) (i32.const 2)))
        (local.set $descriptor (call $native_continuation_state_get (local.get $state) (i32.const 3)))
        (local.set $program (call $native_continuation_state_get (local.get $state) (i32.const 4)))
        (local.set $initialize (i32.const 0)))
      (else
        (if (i32.or (i32.eq (local.get $kind) (global.get $SCHEMA_KIND_COMPILE)) (local.get $one_shot))
          (then
            ;; ---- compile begin ----
            (if (i32.eqz (local.get $schema_slot))
              (then (return (call $schema_throw_disposition (call $throw_type_error_with_message (global.get $BUILTIN_MSG_SCHEMA_SOURCE))) (local.get $fuel))))
            (local.set $type (call $value_type (local.get $schema_slot)))
            (if (i32.eq (local.get $method_id) (global.get $METHOD_SCHEMA_COMPILE_SET))
              (then
                (if (i32.ne (local.get $type) (global.get $TYPE_ARRAY))
                  (then (return (call $schema_throw_disposition (call $throw_type_error_with_message (global.get $BUILTIN_MSG_SCHEMA_SET_SOURCE))) (local.get $fuel)))))
              (else
                (if (i32.and (i32.ne (local.get $type) (global.get $TYPE_OBJECT))
                      (i32.and (i32.ne (local.get $type) (global.get $TYPE_BOOLEAN))
                               (i32.ne (i32.and (local.get $type) (i32.const 0xff)) (global.get $TYPE_MSGPACK_REF))))
                  (then (return (call $schema_throw_disposition (call $throw_type_error_with_message (global.get $BUILTIN_MSG_SCHEMA_SOURCE))) (local.get $fuel))))))
            (local.set $msg (call $schema_read_options (local.get $schema_slot) (local.get $options_pointer)))
            (if (i32.eq (local.get $method_id) (global.get $METHOD_SCHEMA_COMPILE_SET))
              (then (global.set $schema_opt_bits (i32.or (global.get $schema_opt_bits) (global.get $SCHEMA_OPT_SET)))))
            (if (local.get $msg)
              (then
                (if (i32.eq (local.get $msg) (global.get $BUILTIN_MSG_SCHEMA_LIMIT))
                  (then (return (call $schema_throw_disposition (call $throw_range_error_with_message (local.get $msg))) (local.get $fuel))))
                (return (call $schema_throw_disposition (call $throw_type_error_with_message (local.get $msg))) (local.get $fuel))))
            (global.set $msgpack_encode_json_numbers (i32.const 1))
            (local.set $input (call $schema_encode_input (local.get $schema_slot)
              (i32.eq (local.get $method_id) (global.get $METHOD_SCHEMA_COMPILE_SET))))
            (global.set $msgpack_encode_json_numbers (i32.const 0))
            (if (i32.eqz (local.get $input))
              (then
                (if (global.get $memory_pressure_signaled) (then (return (i32.const 2) (local.get $fuel))))
                (if (call $throw_type_error_with_message (global.get $BUILTIN_MSG_SCHEMA_BUNDLE))
                  (then (return (i32.const 3) (local.get $fuel)))
                  (else (return (i32.const 4) (local.get $fuel))))))
            (local.set $bytes (i32.load (call $abs (local.get $input))))
            (local.set $ws_size (call $schema_compile_workspace_size (local.get $bytes)))
            (if (i32.lt_s (local.get $ws_size) (i32.const 0))
              (then (return (call $schema_throw_disposition (call $throw_range_error_with_message (global.get $BUILTIN_MSG_SCHEMA_LIMIT))) (local.get $fuel))))
            (if (call $check_heap_overflow
                  (i32.add (call $estimate_arraybuffer_size (local.get $ws_size))
                           (i32.add (global.get $NATIVE_CONTINUATION_STATE_SIZE) (i32.const 48))))
              (then (return (i32.const 2) (local.get $fuel))))
            (local.set $ws (call $allocate_arraybuffer (local.get $ws_size)))
            (local.set $descriptor (call $allocate_schema_descriptor (local.get $schema_slot) (global.get $schema_opt_bits)
                                     (global.get $schema_opt_max_depth) (global.get $schema_opt_max_errors) (global.get $schema_opt_arena)))
            (local.set $flags (i32.or (global.get $SCHEMA_PH_COMPILE_MEASURE)
                                (i32.or (i32.shl (local.get $kind) (i32.const 8))
                                        (select (global.get $SCHEMA_FLAG_ONE_SHOT) (i32.const 0) (local.get $one_shot)))))
            (local.set $state (call $allocate_native_continuation_state
              (i32.const 8) (i32.const 22)
              (local.get $flags) (local.get $input) (local.get $ws) (local.get $descriptor) (i32.const 0)))
            (call $write_ctx (global.get $CTX_REGEX_STATE) (local.get $state))
            (local.set $phase (global.get $SCHEMA_PH_COMPILE_MEASURE))
            (local.set $program (i32.const 0))
            (local.set $initialize (i32.const 1)))
          (else
            ;; ---- validate begin on an existing descriptor ----
            (local.set $phase (i32.const 0))
            (local.set $flags (i32.shl (local.get $kind) (i32.const 8)))))))

    ;; ---- compile: measure -------------------------------------------------
    (if (i32.eq (local.get $phase) (global.get $SCHEMA_PH_COMPILE_MEASURE))
      (then
        (local.set $bytes (i32.load (call $abs (local.get $input))))
        (call $schema_measure_schema
          (i32.add (call $abs (local.get $input)) (i32.const 4)) (local.get $bytes)
          (i32.add (call $abs (local.get $ws)) (i32.const 4)) (i32.load (call $abs (local.get $ws)))
          (call $schema_descriptor_field (local.get $descriptor) (global.get $SCHEMA_OPTIONS))
          (local.get $initialize) (local.get $fuel))
        (local.set $fuel)
        (local.set $status)
        (if (i32.eq (local.get $status) (global.get $SCHEMA_STATUS_PAUSED)) (then (return (i32.const 1) (local.get $fuel))))
        (if (i32.ne (local.get $status) (global.get $SCHEMA_STATUS_OK))
          (then
            (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
            (return (call $schema_compile_raise (local.get $status) (i32.add (call $abs (local.get $ws)) (i32.const 4))) (local.get $fuel))))
        (local.set $phase (global.get $SCHEMA_PH_COMPILE_MEASURED))
        (call $native_continuation_state_set (local.get $state) (i32.const 0)
          (i32.or (i32.and (local.get $flags) (i32.const -256)) (local.get $phase)))))

    ;; ---- compile: allocate program + emission workspace (no fuel) -----------
    (if (i32.eq (local.get $phase) (global.get $SCHEMA_PH_COMPILE_MEASURED))
      (then
        (local.set $program_size (call $schema_measured_program_size (i32.add (call $abs (local.get $ws)) (i32.const 4))))
        (local.set $ews_size (call $schema_emission_workspace_size (i32.add (call $abs (local.get $ws)) (i32.const 4))))
        (if (i32.or (i32.lt_s (local.get $program_size) (i32.const 0)) (i32.lt_s (local.get $ews_size) (i32.const 0)))
          (then
            (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
            (return (call $schema_throw_disposition (call $throw_range_error_with_message (global.get $BUILTIN_MSG_SCHEMA_LIMIT))) (local.get $fuel))))
        (if (call $check_heap_overflow
              (i32.add (call $estimate_arraybuffer_size (local.get $program_size))
                       (call $estimate_arraybuffer_size (local.get $ews_size))))
          (then (return (i32.const 2) (local.get $fuel))))
        (local.set $program (call $allocate_arraybuffer (local.get $program_size)))
        (local.set $arg (call $allocate_arraybuffer (local.get $ews_size)))
        (local.set $status (call $schema_initialize_emission
          (i32.add (call $abs (local.get $ws)) (i32.const 4))
          (i32.add (call $abs (local.get $arg)) (i32.const 4)) (local.get $ews_size)
          (i32.add (call $abs (local.get $program)) (i32.const 4)) (local.get $program_size)))
        (if (i32.ne (local.get $status) (global.get $SCHEMA_STATUS_OK))
          (then
            ;; $arg is the fresh emission workspace, not the spent measurement.
            (local.set $fuel (call $schema_debit_work (local.get $fuel)
              (call $schema_compile_work_charged (i32.add (call $abs (local.get $arg)) (i32.const 4)))
              (call $schema_compile_work_overflow (i32.add (call $abs (local.get $arg)) (i32.const 4)))))
            (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
            (call $fault_error (global.get $ERR_CORRUPT_OPERAND) (local.get $status) (global.get $current_executing_pc))
            (return (i32.const 3) (local.get $fuel))))
        (local.set $ws (local.get $arg))
        (call $native_continuation_state_set (local.get $state) (i32.const 2) (local.get $ws))
        (call $native_continuation_state_set (local.get $state) (i32.const 4) (local.get $program))
        (local.set $phase (global.get $SCHEMA_PH_COMPILE_EMIT))
        (call $native_continuation_state_set (local.get $state) (i32.const 0)
          (i32.or (i32.and (local.get $flags) (i32.const -256)) (local.get $phase)))))

    ;; ---- compile: emit ------------------------------------------------------
    (if (i32.eq (local.get $phase) (global.get $SCHEMA_PH_COMPILE_EMIT))
      (then
        (call $schema_emit_program
          (i32.add (call $abs (local.get $ws)) (i32.const 4)) (i32.load (call $abs (local.get $ws)))
          (i32.add (call $abs (local.get $input)) (i32.const 4))
          (i32.add (call $abs (local.get $program)) (i32.const 4))
          (local.get $fuel))
        (local.set $fuel)
        (local.set $status)
        (if (i32.eq (local.get $status) (global.get $SCHEMA_STATUS_PAUSED)) (then (return (i32.const 1) (local.get $fuel))))
        (if (i32.ne (local.get $status) (global.get $SCHEMA_STATUS_OK))
          (then
            (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
            (return (call $schema_compile_raise (local.get $status) (i32.add (call $abs (local.get $ws)) (i32.const 4))) (local.get $fuel))))
        ;; commit: publish the program on the descriptor
        (i32.store (call $abs (i32.add (i32.add (local.get $descriptor) (global.get $GC_HEADER_SIZE)) (global.get $SCHEMA_PROGRAM_BUFFER)))
          (local.get $program))
        (if (i32.eqz (i32.and (local.get $flags) (global.get $SCHEMA_FLAG_ONE_SHOT)))
          (then
            (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
            (call $write_value (local.get $result_slot) (global.get $TYPE_SCHEMA) (i32.const 0) (local.get $descriptor) (i32.const 0))
            (call $write_ctx (global.get $CTX_PENDING_POINTER) (i32.add (local.get $result_slot) (global.get $VALUE_SIZE)))
            (return (i32.const 0) (local.get $fuel))))
        (local.set $phase (global.get $SCHEMA_PH_COMPILE_TO_VALIDATE))
        (call $native_continuation_state_set (local.get $state) (i32.const 0)
          (i32.or (i32.and (local.get $flags) (i32.const -256)) (local.get $phase)))))

    ;; ---- validate: begin (fresh instance call, or a one-shot after compile) --
    (if (i32.or (i32.eqz (local.get $phase)) (i32.eq (local.get $phase) (global.get $SCHEMA_PH_COMPILE_TO_VALIDATE)))
      (then
        (if (i32.eqz (local.get $value_slot))
          (then
            (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
            (call $set_error (global.get $ERR_ARITY) (i32.const 1))
            (return (call $schema_throw_disposition (call $throw_from_set_error)) (local.get $fuel))))
        (local.set $descriptor_data (i32.add (local.get $descriptor) (global.get $GC_HEADER_SIZE)))
        (local.set $is_set (i32.and (call $schema_descriptor_field (local.get $descriptor) (global.get $SCHEMA_OPTIONS)) (global.get $SCHEMA_OPT_SET)))
        ;; sets answer match/matchAll/test(value, index); schemas the rest
        (if (i32.ne (i32.ne (local.get $is_set) (i32.const 0))
                    (i32.or (i32.eq (local.get $kind) (global.get $SCHEMA_KIND_MATCH))
                            (i32.or (i32.eq (local.get $kind) (global.get $SCHEMA_KIND_MATCH_ALL))
                                    (i32.and (i32.ne (local.get $is_set) (i32.const 0)) (i32.eq (local.get $kind) (global.get $SCHEMA_KIND_TEST))))))
          (then
            (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
            (return (call $schema_throw_disposition (call $throw_type_error_with_message (global.get $BUILTIN_MSG_SCHEMA_SET_METHOD))) (local.get $fuel))))
        (local.set $routes (i32.const 1))
        (if (local.get $is_set)
          (then
            (local.set $routes (call $schema_program_route_count
              (i32.add (call $abs (call $schema_descriptor_field (local.get $descriptor) (global.get $SCHEMA_PROGRAM_BUFFER))) (i32.const 4))))
            (if (i32.eq (local.get $kind) (global.get $SCHEMA_KIND_TEST))
              (then
                (if (i32.or (i32.eqz (local.get $route_slot)) (i32.eqz (call $value_is_numeric (local.get $route_slot))))
                  (then
                    (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
                    (return (call $schema_throw_disposition (call $throw_range_error_with_message (global.get $BUILTIN_MSG_SCHEMA_ROUTE_INDEX))) (local.get $fuel))))
                (if (i32.or (f64.lt (call $value_to_f64 (local.get $route_slot)) (f64.const 0))
                            (i32.or (f64.ge (call $value_to_f64 (local.get $route_slot)) (f64.convert_i32_u (local.get $routes)))
                                    (f64.ne (call $value_to_f64 (local.get $route_slot)) (f64.nearest (call $value_to_f64 (local.get $route_slot))))))
                  (then
                    (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
                    (return (call $schema_throw_disposition (call $throw_range_error_with_message (global.get $BUILTIN_MSG_SCHEMA_ROUTE_INDEX))) (local.get $fuel))))))))
        (local.set $err_cap (call $schema_descriptor_field (local.get $descriptor) (global.get $SCHEMA_MAX_ERRORS)))
        (local.set $arg (call $schema_option_slot (local.get $validate_options) (global.get $BUILTIN_KEY_MAX_ERRORS)))
        (if (local.get $arg)
          (then
            (if (i32.eqz (call $value_is_numeric (local.get $arg)))
              (then
                (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
                (return (call $schema_throw_disposition (call $throw_type_error_with_message (global.get $BUILTIN_MSG_SCHEMA_OPTIONS))) (local.get $fuel))))
            (local.set $err_cap (i32.trunc_f64_u (f64.min (f64.max (call $value_to_f64 (local.get $arg)) (f64.const 0)) (f64.const 65536))))))
        (if (i32.or (i32.eq (local.get $kind) (global.get $SCHEMA_KIND_TEST)) (i32.eq (local.get $kind) (global.get $SCHEMA_KIND_MATCH)))
          (then (local.set $err_cap (i32.const 0))))
        ;; maxErrors is per route: a set stores up to that many for every route
        (if (i32.eq (local.get $kind) (global.get $SCHEMA_KIND_MATCH_ALL))
          (then
            (local.set $err_cap (i32.mul (local.get $err_cap) (local.get $routes)))
            (if (i32.gt_u (local.get $err_cap) (i32.const 65536)) (then (local.set $err_cap (i32.const 65536))))))
        ;; document bytes: a msgpack ref is used in place; anything else is encoded
        (local.set $type (call $value_type (local.get $value_slot)))
        (if (i32.eq (i32.and (local.get $type) (i32.const 0xff)) (global.get $TYPE_MSGPACK_REF))
          (then
            (local.set $input (call $value_data_lo (local.get $value_slot)))
            (local.set $arg (call $value_data_hi (local.get $value_slot)))
            (local.set $doc_ref (i32.const 1)))
          (else
            (if (call $check_heap_overflow
                  (i32.add (call $estimate_arraybuffer_size (i32.const 4096))
                           (i32.add (call $estimate_arraybuffer_size (i32.const 1024))
                                    (i32.mul (call $estimate_typed_array_descriptor_size) (i32.const 2)))))
              (then (return (i32.const 2) (local.get $fuel))))
            (global.set $msgpack_encode_json_numbers (i32.const 1))
            (local.set $arg (call $msgpack_encode (local.get $value_slot)))
            (global.set $msgpack_encode_json_numbers (i32.const 0))
            (if (i32.eqz (local.get $arg))
              (then
                (if (global.get $memory_pressure_signaled) (then (return (i32.const 2) (local.get $fuel))))
                (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
                (return (call $schema_throw_disposition (call $throw_from_set_error)) (local.get $fuel))))
            ;; typed-array descriptor [buffer:4][offset:4][length:4]
            (local.set $input (i32.load (call $abs (local.get $arg))))
            (local.set $arg (i32.const 0))
            (local.set $doc_ref (i32.const 0))))
        ;; continuation
        (local.set $prog_abs (i32.add (call $abs (call $schema_descriptor_field (local.get $descriptor) (global.get $SCHEMA_PROGRAM_BUFFER))) (i32.const 4)))
        (local.set $prog_len (i32.load (call $abs (call $schema_descriptor_field (local.get $descriptor) (global.get $SCHEMA_PROGRAM_BUFFER)))))
        (local.set $max_depth (call $schema_descriptor_field (local.get $descriptor) (global.get $SCHEMA_MAX_DEPTH)))
        (local.set $arena (call $schema_descriptor_field (local.get $descriptor) (global.get $SCHEMA_ARENA_BYTES)))
        (local.set $cont_len (call $schema_continuation_size (local.get $prog_abs) (local.get $prog_len) (local.get $max_depth) (local.get $err_cap) (local.get $arena)))
        (if (i32.lt_s (local.get $cont_len) (i32.const 0))
          (then
            (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
            (return (call $schema_throw_disposition (call $throw_range_error_with_message (global.get $BUILTIN_MSG_SCHEMA_LIMIT))) (local.get $fuel))))
        (if (call $check_heap_overflow (i32.add (call $estimate_arraybuffer_size (local.get $cont_len)) (global.get $NATIVE_CONTINUATION_STATE_SIZE)))
          (then (return (i32.const 2) (local.get $fuel))))
        (local.set $cont (call $allocate_arraybuffer (local.get $cont_len)))
        (local.set $flags (i32.or (global.get $SCHEMA_PH_VALIDATE_RUN)
                            (i32.or (i32.shl (local.get $kind) (i32.const 8))
                              (i32.or (select (global.get $SCHEMA_FLAG_DOC_REF) (i32.const 0) (local.get $doc_ref))
                                (i32.or (select (global.get $SCHEMA_FLAG_SET) (i32.const 0) (local.get $is_set))
                                        (i32.shl (local.get $err_cap) (i32.const 16)))))))
        (local.set $state (call $allocate_native_continuation_state
          (i32.const 8) (i32.const 6)
          (local.get $flags) (local.get $input) (local.get $cont) (local.get $descriptor) (local.get $arg)))
        (call $write_ctx (global.get $CTX_REGEX_STATE) (local.get $state))
        (local.set $ws (local.get $cont))
        (local.set $program (local.get $arg))
        (local.set $phase (global.get $SCHEMA_PH_VALIDATE_RUN))
        (local.set $initialize (i32.const 1))))

    ;; ---- validate: run ----------------------------------------------------
    (if (i32.eq (local.get $phase) (global.get $SCHEMA_PH_VALIDATE_RUN))
      (then
        (local.set $cont (local.get $ws))
        (local.set $kind (i32.and (i32.shr_u (local.get $flags) (i32.const 8)) (i32.const 15)))
        (local.set $err_cap (i32.shr_u (local.get $flags) (i32.const 16)))
        (local.set $mode (select (global.get $SCHEMA_MODE_TEST) (global.get $SCHEMA_MODE_VALIDATE)
          (i32.or (i32.eq (local.get $kind) (global.get $SCHEMA_KIND_TEST)) (i32.eq (local.get $kind) (global.get $SCHEMA_KIND_MATCH)))))
        (local.set $prog_abs (i32.add (call $abs (call $schema_descriptor_field (local.get $descriptor) (global.get $SCHEMA_PROGRAM_BUFFER))) (i32.const 4)))
        (local.set $prog_len (i32.load (call $abs (call $schema_descriptor_field (local.get $descriptor) (global.get $SCHEMA_PROGRAM_BUFFER)))))
        (local.set $doc_abs (i32.add (i32.add (call $abs (local.get $input)) (i32.const 4)) (local.get $program)))
        (if (i32.and (local.get $flags) (global.get $SCHEMA_FLAG_DOC_REF))
          (then
            (local.set $doc_len (i32.sub
              (call $msgpack_skip_value (local.get $doc_abs) (i32.add (i32.add (call $abs (local.get $input)) (i32.const 4)) (i32.load (call $abs (local.get $input)))))
              (local.get $doc_abs))))
          (else (local.set $doc_len (i32.sub (i32.load (call $abs (local.get $input))) (local.get $program)))))
        (local.set $cont_abs (i32.add (call $abs (local.get $cont)) (i32.const 4)))
        (local.set $cont_len (i32.load (call $abs (local.get $cont))))
        (if (local.get $initialize)
          (then
            (local.set $status (call $schema_initialize_validation
              (local.get $prog_abs) (local.get $prog_len) (local.get $doc_abs) (local.get $doc_len)
              (i32.or (local.get $mode) (global.get $SCHEMA_MODE_TRUSTED))
              (call $schema_descriptor_field (local.get $descriptor) (global.get $SCHEMA_MAX_DEPTH))
              (local.get $err_cap)
              (call $schema_descriptor_field (local.get $descriptor) (global.get $SCHEMA_ARENA_BYTES))
              (local.get $cont_abs) (local.get $cont_len)))
            (if (i32.ne (local.get $status) (global.get $SCHEMA_STATUS_OK))
              (then
                (local.set $fuel (call $schema_debit_work (local.get $fuel)
                  (call $schema_validation_work_charged (local.get $cont_abs))
                  (call $schema_validation_work_overflow (local.get $cont_abs))))
                (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
                (if (i32.eq (local.get $status) (global.get $SCHEMA_STATUS_CORRUPT_DOCUMENT))
                  (then (return (call $schema_throw_disposition (call $throw_type_error_with_message (global.get $BUILTIN_MSG_SCHEMA_SOURCE))) (local.get $fuel))))
                (return (call $schema_throw_disposition (call $throw_range_error_with_message (global.get $BUILTIN_MSG_SCHEMA_LIMIT))) (local.get $fuel)))))
          (else
            (drop (call $schema_rebind_validation (local.get $cont_abs) (local.get $prog_abs) (local.get $doc_abs)))))
        (block $settled (loop $run
          (call $schema_run_validation (local.get $cont_abs) (local.get $cont_len) (local.get $fuel))
          (local.set $fuel)
          (local.set $status)
          (if (i32.eq (local.get $status) (global.get $SCHEMA_STATUS_PAUSED)) (then (return (i32.const 1) (local.get $fuel))))
          (br_if $settled (i32.ne (local.get $status) (global.get $SCHEMA_STATUS_LIMIT_EXCEEDED)))
          ;; arena exhausted: re-run with a bigger arena on a fresh continuation
          (local.set $required (i32.load (i32.add (local.get $cont_abs) (global.get $SCHEMA_CH_ARENA_REQUIRED))))
          (local.set $arena (i32.load (i32.add (local.get $cont_abs) (global.get $SCHEMA_CH_ARENA_CAPACITY))))
          (br_if $settled (i32.le_u (local.get $required) (local.get $arena)))
          (local.set $arena (select (local.get $required) (i32.shl (local.get $arena) (i32.const 1)) (i32.gt_u (local.get $required) (i32.shl (local.get $arena) (i32.const 1)))))
          (local.set $cont_len (call $schema_continuation_size (local.get $prog_abs) (local.get $prog_len)
            (call $schema_descriptor_field (local.get $descriptor) (global.get $SCHEMA_MAX_DEPTH)) (local.get $err_cap) (local.get $arena)))
          (br_if $settled (i32.lt_s (local.get $cont_len) (i32.const 0)))
          (if (call $check_heap_overflow (call $estimate_arraybuffer_size (local.get $cont_len)))
            (then (return (i32.const 2) (local.get $fuel))))
          (local.set $cont (call $allocate_arraybuffer (local.get $cont_len)))
          (call $native_continuation_state_set (local.get $state) (i32.const 2) (local.get $cont))
          (local.set $cont_abs (i32.add (call $abs (local.get $cont)) (i32.const 4)))
          (local.set $status (call $schema_initialize_validation
            (local.get $prog_abs) (local.get $prog_len) (local.get $doc_abs) (local.get $doc_len)
            (i32.or (local.get $mode) (global.get $SCHEMA_MODE_TRUSTED))
            (call $schema_descriptor_field (local.get $descriptor) (global.get $SCHEMA_MAX_DEPTH))
            (local.get $err_cap) (local.get $arena)
            (local.get $cont_abs) (local.get $cont_len)))
          (if (i32.ne (local.get $status) (global.get $SCHEMA_STATUS_OK))
            (then
              ;; The previous arena attempt was already debited by run_validation.
              (local.set $fuel (call $schema_debit_work (local.get $fuel)
                (call $schema_validation_work_charged (local.get $cont_abs))
                (call $schema_validation_work_overflow (local.get $cont_abs))))
              (br $settled)))
          (br $run)))
        (if (i32.and (i32.ne (local.get $status) (global.get $SCHEMA_STATUS_VALID)) (i32.ne (local.get $status) (global.get $SCHEMA_STATUS_INVALID)))
          (then
            (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
            (if (i32.eq (local.get $status) (global.get $SCHEMA_STATUS_UNSUPPORTED))
              (then
                (if (call $raise_error (global.get $ERR_NOT_SUPPORTED) (global.get $NOT_SUPPORTED_FEATURE_SCHEMA))
                  (then (return (i32.const 3) (local.get $fuel)))
                  (else (return (i32.const 4) (local.get $fuel))))))
            (if (i32.or (i32.eq (local.get $status) (global.get $SCHEMA_STATUS_LIMIT_EXCEEDED))
                        (i32.eq (local.get $status) (global.get $SCHEMA_STATUS_BUFFER_TOO_SMALL)))
              (then (return (call $schema_throw_disposition (call $throw_range_error_with_message (global.get $BUILTIN_MSG_SCHEMA_LIMIT))) (local.get $fuel))))
            (call $fault_error (global.get $ERR_CORRUPT_OPERAND) (local.get $status) (global.get $current_executing_pc))
            (return (i32.const 3) (local.get $fuel))))
        (if (i32.eq (local.get $kind) (global.get $SCHEMA_KIND_TEST))
          (then
            (local.set $result (i32.eq (local.get $status) (global.get $SCHEMA_STATUS_VALID)))
            (if (i32.and (local.get $flags) (global.get $SCHEMA_FLAG_SET))
              (then
                ;; test(value, index): the route's own verdict
                (local.set $route (i32.trunc_f64_u (call $value_to_f64 (i32.add (local.get $args_base) (global.get $VALUE_SIZE)))))
                (local.set $result (i32.load (call $schema_route_result (local.get $cont_abs) (local.get $route))))))
            (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
            (call $write_value (local.get $result_slot) (global.get $TYPE_BOOLEAN) (i32.const 0) (local.get $result) (i32.const 0))
            (call $write_ctx (global.get $CTX_PENDING_POINTER) (i32.add (local.get $result_slot) (global.get $VALUE_SIZE)))
            (return (i32.const 0) (local.get $fuel))))
        (local.set $phase (global.get $SCHEMA_PH_VALIDATE_MATERIALIZE))
        (call $native_continuation_state_set (local.get $state) (i32.const 0)
          (i32.or (i32.and (local.get $flags) (i32.const -256)) (local.get $phase)))))

    ;; ---- validate: render and materialize the settled result ----------------
    (if (i32.eq (local.get $phase) (global.get $SCHEMA_PH_VALIDATE_MATERIALIZE))
      (then
        (local.set $cont (local.get $ws))
        (local.set $kind (i32.and (i32.shr_u (local.get $flags) (i32.const 8)) (i32.const 15)))
        (local.set $cont_abs (i32.add (call $abs (local.get $cont)) (i32.const 4)))
        (local.set $prog_abs (i32.add (call $abs (call $schema_descriptor_field (local.get $descriptor) (global.get $SCHEMA_PROGRAM_BUFFER))) (i32.const 4)))
        (local.set $status (i32.load (i32.add (local.get $cont_abs) (global.get $SCHEMA_CH_RESULT))))
        (if (i32.or (i32.eq (local.get $kind) (global.get $SCHEMA_KIND_MATCH)) (i32.eq (local.get $kind) (global.get $SCHEMA_KIND_MATCH_ALL)))
          (then
            (call $schema_materialize_set (local.get $kind) (local.get $prog_abs) (local.get $cont_abs) (local.get $fuel))
            (local.set $fuel) (local.set $result)
            (if (i32.eqz (local.get $result)) (then (return (i32.const 2) (local.get $fuel))))
            (if (i32.eq (local.get $result) (i32.const -1))
              (then
                (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
                (call $fault_error (global.get $ERR_CORRUPT_OPERAND) (i32.const 0) (global.get $current_executing_pc))
                (return (i32.const 3) (local.get $fuel))))
            (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
            (call $write_value (local.get $result_slot) (global.get $TYPE_ARRAY) (i32.const 0) (local.get $result) (i32.const 0))
            (call $write_ctx (global.get $CTX_PENDING_POINTER) (i32.add (local.get $result_slot) (global.get $VALUE_SIZE)))
            (return (i32.const 0) (local.get $fuel))))
        (call $schema_materialize_errors (local.get $prog_abs) (local.get $cont_abs) (i32.const 0)
          (call $schema_error_stored (local.get $cont_abs)) (local.get $fuel))
        (local.set $fuel) (local.set $errors)
        (if (i32.eqz (local.get $errors)) (then (return (i32.const 2) (local.get $fuel))))
        (if (i32.eq (local.get $errors) (i32.const -1))
          (then
            (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
            (call $fault_error (global.get $ERR_CORRUPT_OPERAND) (i32.const 0) (global.get $current_executing_pc))
            (return (i32.const 3) (local.get $fuel))))
        (if (i32.eq (local.get $kind) (global.get $SCHEMA_KIND_ERRORS))
          (then
            (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
            (call $write_value (local.get $result_slot) (global.get $TYPE_ARRAY) (i32.const 0) (local.get $errors) (i32.const 0))
            (call $write_ctx (global.get $CTX_PENDING_POINTER) (i32.add (local.get $result_slot) (global.get $VALUE_SIZE)))
            (return (i32.const 0) (local.get $fuel))))
        (if (i32.eq (local.get $kind) (global.get $SCHEMA_KIND_ASSERT))
          (then
            (if (i32.eq (local.get $status) (global.get $SCHEMA_STATUS_VALID))
              (then
                (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
                (i64.store (call $abs (local.get $result_slot)) (i64.load (call $abs (local.get $value_slot))))
                (i64.store (call $abs (i32.add (local.get $result_slot) (i32.const 8))) (i64.load (call $abs (i32.add (local.get $value_slot) (i32.const 8)))))
                (call $write_ctx (global.get $CTX_PENDING_POINTER) (i32.add (local.get $result_slot) (global.get $VALUE_SIZE)))
                (return (i32.const 0) (local.get $fuel))))
            (if (call $check_heap_overflow (i32.add (global.get $OBJECT_HEADER_SIZE) (i32.const 176)))
              (then (return (i32.const 2) (local.get $fuel))))
            (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
            (local.set $error (call $allocate_error_object (call $read_state (global.get $STATE_TYPE_ERROR_PROTOTYPE)) (global.get $BUILTIN_MSG_SCHEMA_ASSERT)))
            (drop (call $object_set_property (local.get $error) (call $read_builtin (global.get $BUILTIN_ERRORS))
                    (global.get $TYPE_ARRAY) (i32.const 0) (local.get $errors) (i32.const 0)))
            (return (call $schema_throw_disposition (call $throw_allocated_error (local.get $error))) (local.get $fuel))))
        ;; { valid, errors, errorCount }
        (if (call $check_heap_overflow (call $estimate_object_size (i32.const 3))) (then (return (i32.const 2) (local.get $fuel))))
        (local.set $object (call $allocate_object (i32.const 3)))
        (drop (call $object_set_property (local.get $object) (call $read_builtin (global.get $BUILTIN_KEY_VALID))
                (global.get $TYPE_BOOLEAN) (i32.const 0) (i32.eq (local.get $status) (global.get $SCHEMA_STATUS_VALID)) (i32.const 0)))
        (drop (call $object_set_property (local.get $object) (call $read_builtin (global.get $BUILTIN_ERRORS))
                (global.get $TYPE_ARRAY) (i32.const 0) (local.get $errors) (i32.const 0)))
        (drop (call $object_set_property (local.get $object) (call $read_builtin (global.get $BUILTIN_KEY_ERROR_COUNT))
                (global.get $TYPE_FLOAT) (i32.const 0)
                (i32.wrap_i64 (i64.reinterpret_f64 (f64.convert_i32_u (call $schema_error_count (local.get $cont_abs)))))
                (i32.wrap_i64 (i64.shr_u (i64.reinterpret_f64 (f64.convert_i32_u (call $schema_error_count (local.get $cont_abs)))) (i64.const 32)))))
        (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
        (call $write_value (local.get $result_slot) (global.get $TYPE_OBJECT) (i32.const 0) (local.get $object) (i32.const 0))
        (call $write_ctx (global.get $CTX_PENDING_POINTER) (i32.add (local.get $result_slot) (global.get $VALUE_SIZE)))
        (return (i32.const 0) (local.get $fuel))))

    ;; unknown phase: the state root was corrupted
    (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
    (call $fault_error (global.get $ERR_CORRUPT_OPERAND) (local.get $phase) (global.get $current_executing_pc))
    (return (i32.const 3) (local.get $fuel)))

  ;; `new Schema(schema, options)` / `Schema(schema, options)`: the
  ;; constructor form of compile. Mirrors $regexp_construct_step: the
  ;; result lands over the constructor slot.
  (func $schema_construct_step
    (param $constructor_pointer i32) (param $argc i32) (param $entry_pending_pointer i32) (param $fuel i32)
    (result i32 i32)
    (call $schema_op_step
      (global.get $METHOD_SCHEMA_CONSTRUCTOR) (i32.const 0)
      (local.get $constructor_pointer)
      (local.get $argc)
      (i32.add (local.get $constructor_pointer) (global.get $VALUE_SIZE))
      (local.get $entry_pending_pointer)
      (local.get $fuel)))

  ;; Schema.isSchema(value) — plain table method.
  (func $schema_is_schema_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32) (local $argument1_pointer i32) (local $is i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (local.set $is (i32.const 0))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $is (i32.eq (call $value_type (local.get $argument1_pointer)) (global.get $TYPE_SCHEMA)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (local.get $is) (i32.const 0))
    (i32.const 0))

  ;; Is this method id one of the fuel-carrying Schema arms (dispatched
  ;; inline, never through $builtin_table)?
  (func $is_schema_inline_method (param $method_id i32) (result i32)
    (i32.or
      (i32.or
        (i32.or
          (i32.eq (local.get $method_id) (global.get $METHOD_SCHEMA_COMPILE))
          (i32.eq (local.get $method_id) (global.get $METHOD_SCHEMA_COMPILE_SET)))
        (i32.or
          (i32.eq (local.get $method_id) (global.get $METHOD_SCHEMA_TEST_STATIC))
          (i32.eq (local.get $method_id) (global.get $METHOD_SCHEMA_VALIDATE_STATIC))))
      (call $is_schema_instance_method (local.get $method_id))))

  ;; Instance-method ids need a TYPE_SCHEMA receiver.
  (func $is_schema_instance_method (param $method_id i32) (result i32)
    (i32.or
      (i32.or
        (i32.or
          (i32.eq (local.get $method_id) (global.get $METHOD_SCHEMA_TEST))
          (i32.eq (local.get $method_id) (global.get $METHOD_SCHEMA_VALIDATE)))
        (i32.or
          (i32.eq (local.get $method_id) (global.get $METHOD_SCHEMA_ASSERT))
          (i32.eq (local.get $method_id) (global.get $METHOD_SCHEMA_ERRORS))))
      (i32.or
        (i32.eq (local.get $method_id) (global.get $METHOD_SCHEMA_MATCH))
        (i32.eq (local.get $method_id) (global.get $METHOD_SCHEMA_MATCH_ALL)))))

  ;; The dialect literal for a descriptor's option bits.
  (func $schema_dialect_string (param $descriptor i32) (result i32)
    (local $options i32)
    (local.set $options (call $schema_descriptor_field (local.get $descriptor) (global.get $SCHEMA_OPTIONS)))
    (if (i32.and (local.get $options) (global.get $SCHEMA_OPT_DIALECT_04))
      (then (return (call $read_builtin (global.get $BUILTIN_LIT_DIALECT_04)))))
    (if (i32.and (local.get $options) (global.get $SCHEMA_OPT_DIALECT_07))
      (then (return (call $read_builtin (global.get $BUILTIN_LIT_DIALECT_07)))))
    (call $read_builtin (global.get $BUILTIN_LIT_DIALECT_2020)))

  ;; Count the Unicode scalars strictly before $byte_offset in an interned
  ;; string's body. The offset must lie on a scalar boundary (engine spans
  ;; always do); counting non-continuation bytes is exact because stored
  ;; strings are validated UTF-8.
  (func $utf8_byte_offset_to_char_index
    (param $string_id i32) (param $byte_offset i32) (result i32)
    (local $bytes_abs i32)
    (local $i i32)
    (local $count i32)
    (local.set $bytes_abs
      (i32.add (call $string_id_to_abs (local.get $string_id)) (i32.const 4)))
    (block $done
      (loop $walk
        (br_if $done (i32.ge_u (local.get $i) (local.get $byte_offset)))
        (local.set $count (i32.add (local.get $count)
          (i32.ne
            (i32.and
              (i32.load8_u (i32.add (local.get $bytes_abs) (local.get $i)))
              (i32.const 0xC0))
            (i32.const 0x80))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $walk)))
    (local.get $count)
  )

  ;; Worst-case heap bytes of $allocate_object(capacity): 32-byte header +
  ;; 16-aligned entries block (GC 8 + capacity * ENTRY_SIZE).
  (func $estimate_plain_object_size (param $capacity i32) (result i32)
    (i32.add
      (global.get $OBJECT_HEADER_SIZE)
      (i32.and
        (i32.add
          (i32.add (i32.const 8)
            (i32.mul (local.get $capacity) (global.get $ENTRY_SIZE)))
          (i32.const 15))
        (i32.const -16)))
  )

  ;; Build exec's result: the [full, ...captures] array plus its hidden
  ;; metadata — a meta object (index/input/groups, indices under d) keyed
  ;; by the bootstrap match-meta symbol in the array's sym-entries block
  ;; (GET_PROP's TYPE_ARRAY arm resolves those four names through it).
  ;; Unset captures materialize as undefined; participating empty captures
  ;; as "". All scalar indices derive from the engine's byte spans against
  ;; the rooted subject. Returns the array HEADER pointer, or 0 on memory
  ;; pressure — the caller yields and retries this phase without
  ;; re-running the match; partially built objects are unrooted garbage
  ;; the collector reclaims, and interned strings dedup on retry.
  (func $regexp_exec_materialize
    (param $subject_id i32)
    (param $continuation i32)   ;; match continuation ArrayBuffer DATA pointer
    (param $descriptor i32)     ;; RegExp descriptor HEADER pointer
    (result i32)
    (local $cont_payload i32)   ;; absolute
    (local $n i32)              ;; capture groups + 1
    (local $has_indices i32)
    (local $program i32)
    (local $prog_payload i32)   ;; absolute
    (local $name_bytes i32)
    (local $names_base i32)     ;; absolute
    (local $named_count i32)
    (local $walk i32)
    (local $estimate i32)
    (local $subject_abs i32)
    (local $array_pointer i32)
    (local $elem_base i32)
    (local $i i32)
    (local $cap_start i32)
    (local $cap_end i32)
    (local $sid i32)
    (local $groups_object i32)
    (local $indices_array i32)
    (local $indices_elem_base i32)
    (local $indices_groups_object i32)
    (local $indices_meta_object i32)
    (local $pair_array i32)
    (local $pair_elem_base i32)
    (local $meta_object i32)
    (local $name_id i32)
    (local $group_index i32)
    (local $value_slot i32)
    (local $bits i64)
    (local $scalar i32)

    (local.set $cont_payload
      (i32.add (call $abs (local.get $continuation)) (i32.const 4)))
    (local.set $n (i32.add
      (i32.load (i32.add (local.get $cont_payload)
        (global.get $REGEX_CONT_CAPTURE_GROUP_COUNT)))
      (i32.const 1)))
    (local.set $has_indices (i32.and
      (i32.load (i32.add (local.get $cont_payload) (global.get $REGEX_CONT_FLAGS)))
      (global.get $REGEXP_FLAG_HAS_INDICES)))

    ;; Name records live in the retained program after the instruction and
    ;; range sections: [group:4][byteLength:4][utf8 bytes], unaligned stride.
    (local.set $program (i32.load (call $abs (i32.add
      (i32.add (local.get $descriptor) (global.get $GC_HEADER_SIZE))
      (global.get $REGEXP_PROGRAM_BUFFER)))))
    (local.set $prog_payload (i32.add (call $abs (local.get $program)) (i32.const 4)))
    (local.set $name_bytes
      (i32.load (i32.add (local.get $prog_payload) (global.get $REGEX_PROGRAM_NAME_BYTES))))
    (local.set $names_base (i32.add
      (i32.add (local.get $prog_payload) (global.get $REGEX_PROGRAM_HEADER_SIZE))
      (i32.add
        (i32.mul
          (i32.load (i32.add (local.get $prog_payload) (global.get $REGEX_PROGRAM_INSTRUCTION_COUNT)))
          (global.get $REGEX_PROGRAM_INSTRUCTION_SIZE))
        (i32.mul
          (i32.load (i32.add (local.get $prog_payload) (global.get $REGEX_PROGRAM_RANGE_COUNT)))
          (i32.const 8)))))
    (block $names_counted
      (loop $count_names
        (br_if $names_counted (i32.ge_u (local.get $walk) (local.get $name_bytes)))
        (local.set $named_count (i32.add (local.get $named_count) (i32.const 1)))
        (local.set $walk (i32.add (local.get $walk)
          (i32.add (i32.const 8)
            (i32.load (i32.add
              (i32.add (local.get $names_base) (local.get $walk))
              (i32.const 4))))))
        (br $count_names)))

    ;; One pressure gate covering every heap allocation this pass makes
    ;; (string interns carry their own gate inside $intern_string).
    (local.set $estimate (i32.add
      (i32.add
        (call $estimate_array_size (local.get $n))
        (call $estimate_plain_object_size (i32.const 4)))
      (i32.const 96)))  ;; result array's lazily allocated sym-entries block
    (if (local.get $named_count)
      (then (local.set $estimate (i32.add (local.get $estimate)
        (call $estimate_plain_object_size (local.get $named_count))))))
    (if (local.get $has_indices)
      (then
        (local.set $estimate (i32.add (local.get $estimate)
          (i32.add
            (call $estimate_array_size (local.get $n))
            (i32.mul (local.get $n) (call $estimate_array_size (i32.const 2))))))
        (if (local.get $named_count)
          (then (local.set $estimate (i32.add (local.get $estimate)
            (i32.add
              (i32.add
                (call $estimate_plain_object_size (local.get $named_count))
                (call $estimate_plain_object_size (i32.const 1)))
              (i32.const 96))))))))  ;; indices array's sym-entries block
    (if (call $check_heap_overflow (local.get $estimate))
      (then (return (i32.const 0))))

    (local.set $subject_abs
      (i32.add (call $string_id_to_abs (local.get $subject_id)) (i32.const 4)))

    ;; Result array elements from the candidate capture slots (byte-offset
    ;; pairs at the head of the continuation's payload).
    (local.set $array_pointer (call $allocate_array (local.get $n)))
    (local.set $elem_base (i32.add
      (i32.add (local.get $array_pointer) (global.get $ARRAY_HEADER_SIZE))
      (i32.const 8)))
    (local.set $i (i32.const 0))
    (block $elems_done
      (loop $fill_elems
        (br_if $elems_done (i32.ge_u (local.get $i) (local.get $n)))
        (local.set $cap_start (i32.load (i32.add
          (i32.add (local.get $cont_payload) (global.get $REGEX_CONT_HEADER_SIZE))
          (i32.shl (local.get $i) (i32.const 3)))))
        (local.set $cap_end (i32.load (i32.add
          (i32.add
            (i32.add (local.get $cont_payload) (global.get $REGEX_CONT_HEADER_SIZE))
            (i32.shl (local.get $i) (i32.const 3)))
          (i32.const 4))))
        (if (i32.or
              (i32.eq (local.get $cap_start) (global.get $REGEX_CONT_NO_POSITION))
              (i32.eq (local.get $cap_end) (global.get $REGEX_CONT_NO_POSITION)))
          (then
            (call $write_value
              (i32.add (local.get $elem_base) (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
              (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0)))
          (else
            (local.set $sid (call $intern_string
              (i32.add (local.get $subject_abs) (local.get $cap_start))
              (i32.sub (local.get $cap_end) (local.get $cap_start))))
            (if (i32.eqz (local.get $sid)) (then (return (i32.const 0))))
            (call $write_value
              (i32.add (local.get $elem_base) (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
              (global.get $TYPE_STRING) (i32.const 0) (local.get $sid) (i32.const 0))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $fill_elems)))

    ;; .groups — named captures share the numbered slots' values.
    ;; Duplicate names cannot occur (the compiler validates them).
    (if (local.get $named_count)
      (then
        (local.set $groups_object (call $allocate_object (local.get $named_count)))
        (local.set $walk (i32.const 0))
        (block $groups_done
          (loop $fill_groups
            (br_if $groups_done (i32.ge_u (local.get $walk) (local.get $name_bytes)))
            (local.set $group_index
              (i32.load (i32.add (local.get $names_base) (local.get $walk))))
            (local.set $sid (i32.load (i32.add
              (i32.add (local.get $names_base) (local.get $walk))
              (i32.const 4))))
            (local.set $name_id (call $intern_string
              (i32.add (i32.add (local.get $names_base) (local.get $walk)) (i32.const 8))
              (local.get $sid)))
            (if (i32.eqz (local.get $name_id)) (then (return (i32.const 0))))
            (local.set $value_slot (i32.add (local.get $elem_base)
              (i32.mul (local.get $group_index) (global.get $VALUE_SIZE))))
            (if (call $object_set_property
                  (local.get $groups_object) (local.get $name_id)
                  (call $value_type (local.get $value_slot)) (i32.const 0)
                  (call $value_data_lo (local.get $value_slot)) (i32.const 0))
              (then (return (i32.const 0))))
            (local.set $walk (i32.add (local.get $walk)
              (i32.add (i32.const 8) (local.get $sid))))
            (br $fill_groups)))))

    ;; .indices (d flag) — [startScalar, endScalar] pairs, undefined for
    ;; unset captures, plus its own hidden {groups} metadata when named
    ;; captures exist (JS: indices.groups mirrors groups' shape).
    (if (local.get $has_indices)
      (then
        (local.set $indices_array (call $allocate_array (local.get $n)))
        (local.set $indices_elem_base (i32.add
          (i32.add (local.get $indices_array) (global.get $ARRAY_HEADER_SIZE))
          (i32.const 8)))
        (local.set $i (i32.const 0))
        (block $indices_done
          (loop $fill_indices
            (br_if $indices_done (i32.ge_u (local.get $i) (local.get $n)))
            (local.set $cap_start (i32.load (i32.add
              (i32.add (local.get $cont_payload) (global.get $REGEX_CONT_HEADER_SIZE))
              (i32.shl (local.get $i) (i32.const 3)))))
            (local.set $cap_end (i32.load (i32.add
              (i32.add
                (i32.add (local.get $cont_payload) (global.get $REGEX_CONT_HEADER_SIZE))
                (i32.shl (local.get $i) (i32.const 3)))
              (i32.const 4))))
            (if (i32.or
                  (i32.eq (local.get $cap_start) (global.get $REGEX_CONT_NO_POSITION))
                  (i32.eq (local.get $cap_end) (global.get $REGEX_CONT_NO_POSITION)))
              (then
                (call $write_value
                  (i32.add (local.get $indices_elem_base)
                    (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
                  (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0)))
              (else
                (local.set $pair_array (call $allocate_array (i32.const 2)))
                (local.set $pair_elem_base (i32.add
                  (i32.add (local.get $pair_array) (global.get $ARRAY_HEADER_SIZE))
                  (i32.const 8)))
                (local.set $bits (i64.reinterpret_f64 (f64.convert_i32_u
                  (call $utf8_byte_offset_to_char_index
                    (local.get $subject_id) (local.get $cap_start)))))
                (call $write_value (local.get $pair_elem_base)
                  (global.get $TYPE_FLOAT) (i32.const 0)
                  (i32.wrap_i64 (local.get $bits))
                  (i32.wrap_i64 (i64.shr_u (local.get $bits) (i64.const 32))))
                (local.set $bits (i64.reinterpret_f64 (f64.convert_i32_u
                  (call $utf8_byte_offset_to_char_index
                    (local.get $subject_id) (local.get $cap_end)))))
                (call $write_value
                  (i32.add (local.get $pair_elem_base) (global.get $VALUE_SIZE))
                  (global.get $TYPE_FLOAT) (i32.const 0)
                  (i32.wrap_i64 (local.get $bits))
                  (i32.wrap_i64 (i64.shr_u (local.get $bits) (i64.const 32))))
                (call $write_value
                  (i32.add (local.get $indices_elem_base)
                    (i32.mul (local.get $i) (global.get $VALUE_SIZE)))
                  (global.get $TYPE_ARRAY) (i32.const 0) (local.get $pair_array) (i32.const 0))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $fill_indices)))
        (if (local.get $named_count)
          (then
            (local.set $indices_groups_object
              (call $allocate_object (local.get $named_count)))
            (local.set $walk (i32.const 0))
            (block $indices_groups_done
              (loop $fill_indices_groups
                (br_if $indices_groups_done
                  (i32.ge_u (local.get $walk) (local.get $name_bytes)))
                (local.set $group_index
                  (i32.load (i32.add (local.get $names_base) (local.get $walk))))
                (local.set $sid (i32.load (i32.add
                  (i32.add (local.get $names_base) (local.get $walk))
                  (i32.const 4))))
                (local.set $name_id (call $intern_string
                  (i32.add (i32.add (local.get $names_base) (local.get $walk)) (i32.const 8))
                  (local.get $sid)))
                (if (i32.eqz (local.get $name_id)) (then (return (i32.const 0))))
                (local.set $value_slot (i32.add (local.get $indices_elem_base)
                  (i32.mul (local.get $group_index) (global.get $VALUE_SIZE))))
                (if (call $object_set_property
                      (local.get $indices_groups_object) (local.get $name_id)
                      (call $value_type (local.get $value_slot)) (i32.const 0)
                      (call $value_data_lo (local.get $value_slot)) (i32.const 0))
                  (then (return (i32.const 0))))
                (local.set $walk (i32.add (local.get $walk)
                  (i32.add (i32.const 8) (local.get $sid))))
                (br $fill_indices_groups)))
            (local.set $indices_meta_object (call $allocate_object (i32.const 1)))
            (if (call $object_set_property
                  (local.get $indices_meta_object)
                  (call $read_builtin (global.get $BUILTIN_MATCH_GROUPS))
                  (global.get $TYPE_OBJECT) (i32.const 0)
                  (local.get $indices_groups_object) (i32.const 0))
              (then (return (i32.const 0))))
            (if (call $sym_block_set
                  (i32.add (local.get $indices_array) (global.get $ARRAY_SYM_ENTRIES_OFFSET))
                  (call $read_state (global.get $STATE_REGEXP_MATCH_META_SYMBOL))
                  (global.get $TYPE_OBJECT) (i32.const 0)
                  (local.get $indices_meta_object) (i32.const 0))
              (then (return (i32.const 0))))))))

    ;; The meta object: .index in Unicode scalars (the epic's deliberate
    ;; divergence from JS's UTF-16 units), .input, .groups, .indices.
    ;; Absent named captures / d flag omit their properties — GET_PROP's
    ;; metadata arm then reads undefined, matching JS.
    (local.set $meta_object (call $allocate_object (i32.const 4)))
    (local.set $scalar (call $utf8_byte_offset_to_char_index
      (local.get $subject_id)
      (i32.load (i32.add (local.get $cont_payload) (global.get $REGEX_CONT_HEADER_SIZE)))))
    (local.set $bits (i64.reinterpret_f64 (f64.convert_i32_u (local.get $scalar))))
    (if (call $object_set_property
          (local.get $meta_object) (call $read_builtin (global.get $BUILTIN_MATCH_INDEX))
          (global.get $TYPE_FLOAT) (i32.const 0)
          (i32.wrap_i64 (local.get $bits))
          (i32.wrap_i64 (i64.shr_u (local.get $bits) (i64.const 32))))
      (then (return (i32.const 0))))
    (if (call $object_set_property
          (local.get $meta_object) (call $read_builtin (global.get $BUILTIN_MATCH_INPUT))
          (global.get $TYPE_STRING) (i32.const 0) (local.get $subject_id) (i32.const 0))
      (then (return (i32.const 0))))
    (if (local.get $groups_object)
      (then
        (if (call $object_set_property
              (local.get $meta_object) (call $read_builtin (global.get $BUILTIN_MATCH_GROUPS))
              (global.get $TYPE_OBJECT) (i32.const 0) (local.get $groups_object) (i32.const 0))
          (then (return (i32.const 0))))))
    (if (local.get $indices_array)
      (then
        (if (call $object_set_property
              (local.get $meta_object) (call $read_builtin (global.get $BUILTIN_MATCH_INDICES))
              (global.get $TYPE_ARRAY) (i32.const 0) (local.get $indices_array) (i32.const 0))
          (then (return (i32.const 0))))))
    (if (call $sym_block_set
          (i32.add (local.get $array_pointer) (global.get $ARRAY_SYM_ENTRIES_OFFSET))
          (call $read_state (global.get $STATE_REGEXP_MATCH_META_SYMBOL))
          (global.get $TYPE_OBJECT) (i32.const 0) (local.get $meta_object) (i32.const 0))
      (then (return (i32.const 0))))
    (local.get $array_pointer)
  )

  ;; Single commit point shared by every exec/test completion: mutate
  ;; lastIndex per g/y semantics, write the result value over the callee
  ;; slot, and pop the pending stack to just above it. Returns 0 (the
  ;; done disposition) so callers can tail it directly.
  (func $regexp_match_commit
    (param $descriptor i32)
    (param $method_id i32)
    (param $result_slot i32)
    (param $g_or_y i32)
    (param $matched i32)
    (param $match_end_scalar i32)
    (param $result_value i32)   ;; exec's array HEADER pointer when matched
    (result i32)
    ;; lastIndex commits only for g/y: end-of-match scalar on a match
    ;; (no empty-match bump here — exec/test mirror JS, where advancement
    ;; belongs to the string-method loops), 0 on a miss.
    (if (local.get $g_or_y)
      (then
        (i32.store
          (call $abs (i32.add
            (i32.add (local.get $descriptor) (global.get $GC_HEADER_SIZE))
            (global.get $REGEXP_LAST_INDEX)))
          (select (local.get $match_end_scalar) (i32.const 0) (local.get $matched)))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_REGEXP_TEST))
      (then
        (call $write_value (local.get $result_slot)
          (global.get $TYPE_BOOLEAN) (i32.const 0) (local.get $matched) (i32.const 0)))
      (else
        (if (local.get $matched)
          (then
            (call $write_value (local.get $result_slot)
              (global.get $TYPE_ARRAY) (i32.const 0) (local.get $result_value) (i32.const 0)))
          (else
            (call $write_value (local.get $result_slot)
              (global.get $TYPE_NULL) (i32.const 0) (i32.const 0) (i32.const 0))))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER)
      (i32.add (local.get $result_slot) (global.get $VALUE_SIZE)))
    (i32.const 0)
  )

  ;; One fuel grant's worth of re.exec(s) / re.test(s): resolve the rooted
  ;; subject, drive the engine's resumable ordered-Pike match, then commit
  ;; lastIndex and the result at the operation's single commit point.
  ;; Dispatched inline from CALL/CALL_METHOD (never via $builtin_table —
  ;; $builtin_sig cannot carry fuel or a pause disposition).
  ;; Phases park in CTX_REGEX_STATE (NATIVE_CONTINUATION_STATE), disjoint
  ;; from the compile phases 1-3 so a mixed-up root fails loud:
  ;;   state0 = phase (4 = engine match running, 5 = match complete)
  ;;   state1 = match continuation ArrayBuffer DATA pointer (data mask)
  ;;   state2 = final engine status once phase 5 (MATCH / NO_MATCH)
  ;; The descriptor and arguments stay rooted on the pending stack; the
  ;; subject is re-coerced on every grant (deterministic, so a resume
  ;; lands on identical bytes even if the collector dropped the previous
  ;; intern during a pause) and the continuation's absolute program/input
  ;; addresses are rebound before every engine call.
  ;; Returns (disposition, fuelRemaining):
  ;;   0 = done, result written at $result_slot, pending popped above it;
  ;;   1 = paused on fuel, state saved (caller re-dispatches this pc);
  ;;   2 = memory pressure (caller yields; this pc retries);
  ;;   3 = thrown and uncaught; 4 = thrown and caught.
  (func $regexp_match_step
    (param $descriptor i32)
    (param $method_id i32)
    (param $result_slot i32)
    (param $argc i32)
    (param $args_base i32)
    (param $entry_pending_pointer i32)
    (param $fuel i32)
    ;; Non-zero: the subject string id (already a string — the string
    ;; receiver of a delegating non-global String.prototype.match, which
    ;; is RegExpExec by specification). Zero: coerce the first argument.
    (param $subject_override i32)
    (result i32 i32)
    (local $state_handle i32)
    (local $phase i32)
    (local $continuation i32)
    (local $match_status i32)
    (local $subject_id i32)
    (local $descriptor_data i32)
    (local $program i32)
    (local $prog_payload i32)
    (local $flags_word i32)
    (local $g_or_y i32)
    (local $start_scalar i32)
    (local $start_byte i32)
    (local $subject_abs i32)
    (local $subject_len i32)
    (local $cont_bytes i32)
    (local $status i32)
    (local $cont_payload i32)
    (local $result_value i32)
    (local $match_end_scalar i32)

    ;; Root the callee-and-arguments window across every pause.
    (call $write_ctx (global.get $CTX_PENDING_POINTER)
      (local.get $entry_pending_pointer))

    ;; Subject: the override when delegating, else the first argument
    ;; coerced to a string (JS ToString), the pinned builtin "undefined"
    ;; when absent.
    (if (local.get $subject_override)
      (then
        (local.set $subject_id (local.get $subject_override)))
      (else
        (if (i32.ge_u (local.get $argc) (i32.const 1))
          (then
            (local.set $subject_id (call $value_to_string (local.get $args_base)))
            (if (i32.eqz (local.get $subject_id))
              (then (return (i32.const 2) (local.get $fuel)))))
          (else
            (local.set $subject_id
              (call $read_builtin (global.get $BUILTIN_TYPEOF_UNDEFINED)))))))
    (local.set $subject_abs (call $string_id_to_abs (local.get $subject_id)))
    (local.set $subject_len (i32.load (local.get $subject_abs)))
    (local.set $subject_abs (i32.add (local.get $subject_abs) (i32.const 4)))

    (local.set $descriptor_data
      (i32.add (local.get $descriptor) (global.get $GC_HEADER_SIZE)))
    (local.set $program (i32.load (call $abs (i32.add
      (local.get $descriptor_data) (global.get $REGEXP_PROGRAM_BUFFER)))))
    (if (i32.eqz (local.get $program))
      (then
        ;; Descriptors publish their program at the compile commit point;
        ;; a zero here is substrate corruption, not guest error.
        (call $fault_error (global.get $ERR_CORRUPT_OPERAND)
          (i32.const 0) (global.get $current_executing_pc))
        (return (i32.const 3) (local.get $fuel))))
    (local.set $flags_word (i32.load (call $abs (i32.add
      (local.get $descriptor_data) (global.get $REGEXP_FLAGS)))))
    (local.set $g_or_y (i32.and (local.get $flags_word)
      (i32.or (global.get $REGEXP_FLAG_GLOBAL) (global.get $REGEXP_FLAG_STICKY))))

    (local.set $state_handle (call $read_ctx (global.get $CTX_REGEX_STATE)))
    (if (i32.eq (local.get $state_handle) (i32.const 0))
      (then
        ;; Fresh match. g/y read the search origin from lastIndex (scalar
        ;; units); other flag sets always start at 0. An origin past the
        ;; end is an immediate miss that resets lastIndex (JS semantics).
        (local.set $start_scalar (i32.const 0))
        (if (local.get $g_or_y)
          (then (local.set $start_scalar (i32.load (call $abs (i32.add
            (local.get $descriptor_data) (global.get $REGEXP_LAST_INDEX)))))))
        (local.set $start_byte (call $utf8_char_to_byte_offset
          (local.get $subject_id) (local.get $start_scalar)))
        (if (i32.eq (local.get $start_byte) (i32.const -1))
          (then
            (return
              (call $regexp_match_commit
                (local.get $descriptor) (local.get $method_id)
                (local.get $result_slot) (local.get $g_or_y)
                (i32.const 0) (i32.const 0) (i32.const 0))
              (local.get $fuel))))
        ;; Continuation sized from the actual compiled program, never a
        ;; global maximum.
        (local.set $prog_payload
          (i32.add (call $abs (local.get $program)) (i32.const 4)))
        (local.set $cont_bytes (call $regex_continuation_size
          (i32.load (i32.add (local.get $prog_payload)
            (global.get $REGEX_PROGRAM_INSTRUCTION_COUNT)))
          (i32.load (i32.add (local.get $prog_payload)
            (global.get $REGEX_PROGRAM_CAPTURE_GROUP_COUNT)))
          (i32.load (i32.add (local.get $prog_payload)
            (global.get $REGEX_PROGRAM_GUARD_SLOTS)))))
        (if (i32.eq (local.get $cont_bytes) (i32.const -1))
          (then
            (call $fault_error (global.get $ERR_CORRUPT_OPERAND)
              (i32.const 1) (global.get $current_executing_pc))
            (return (i32.const 3) (local.get $fuel))))
        (if (call $check_heap_overflow (i32.add
              (call $estimate_arraybuffer_size (local.get $cont_bytes))
              (global.get $NATIVE_CONTINUATION_STATE_SIZE)))
          (then (return (i32.const 2) (local.get $fuel))))
        (local.set $continuation (call $allocate_arraybuffer (local.get $cont_bytes)))
        (local.set $status (call $regex_initialize_match
          (local.get $prog_payload)
          (i32.load (call $abs (local.get $program)))
          (local.get $subject_abs)
          (local.get $subject_len)
          (local.get $start_byte)
          (local.get $start_scalar)
          (i32.add (call $abs (local.get $continuation)) (i32.const 4))
          (i32.load (call $abs (local.get $continuation)))))
        (if (i32.ne (local.get $status) (global.get $REGEX_STATUS_OK))
          (then
            ;; The engine validated this program at compile commit and
            ;; stored strings are validated UTF-8, so any failure here is
            ;; substrate corruption.
            (call $fault_error (global.get $ERR_CORRUPT_OPERAND)
              (local.get $status) (global.get $current_executing_pc))
            (return (i32.const 3) (local.get $fuel))))
        (local.set $state_handle (call $allocate_native_continuation_state
          (i32.const 0)   ;; header mask: none
          (i32.const 2)   ;; data mask: state1 (continuation buffer)
          (i32.const 4)   ;; phase: engine match running
          (local.get $continuation)
          (i32.const 0) (i32.const 0) (i32.const 0)))
        (call $write_ctx (global.get $CTX_REGEX_STATE) (local.get $state_handle))
        (local.set $phase (i32.const 4)))
      (else
        (local.set $phase
          (call $native_continuation_state_get (local.get $state_handle) (i32.const 0)))
        (local.set $continuation
          (call $native_continuation_state_get (local.get $state_handle) (i32.const 1)))
        (local.set $match_status
          (call $native_continuation_state_get (local.get $state_handle) (i32.const 2)))
        ;; A compile-phase root (1-3) or missing buffer here means the
        ;; state machine is corrupt — a match only follows a committed
        ;; compile, and the two never overlap in one context.
        (if (i32.or
              (i32.or
                (i32.lt_u (local.get $phase) (i32.const 4))
                (i32.gt_u (local.get $phase) (i32.const 5)))
              (i32.eqz (local.get $continuation)))
          (then
            (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
            (call $fault_error (global.get $ERR_CORRUPT_OPERAND)
              (local.get $phase) (global.get $current_executing_pc))
            (return (i32.const 3) (local.get $fuel))))))

    (local.set $cont_payload
      (i32.add (call $abs (local.get $continuation)) (i32.const 4)))

    ;; Phase 4: drive the engine. Rebind the continuation's absolute
    ;; program/input addresses first — the collector may have moved either
    ;; since the last grant; every position inside is input-relative.
    (if (i32.eq (local.get $phase) (i32.const 4))
      (then
        (i32.store
          (i32.add (local.get $cont_payload) (global.get $REGEX_CONT_PROGRAM_ADDRESS))
          (i32.add (call $abs (local.get $program)) (i32.const 4)))
        (i32.store
          (i32.add (local.get $cont_payload) (global.get $REGEX_CONT_INPUT_ADDRESS))
          (local.get $subject_abs))
        (call $regex_run_match
          (local.get $cont_payload)
          (i32.load (call $abs (local.get $continuation)))
          (local.get $fuel))
        (local.set $fuel)
        (local.set $status)
        (if (i32.eq (local.get $status) (global.get $REGEX_STATUS_PAUSED))
          (then (return (i32.const 1) (local.get $fuel))))
        (if (i32.and
              (i32.ne (local.get $status) (global.get $REGEX_STATUS_MATCH))
              (i32.ne (local.get $status) (global.get $REGEX_STATUS_NO_MATCH)))
          (then
            (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
            (call $fault_error (global.get $ERR_CORRUPT_OPERAND)
              (local.get $status) (global.get $current_executing_pc))
            (return (i32.const 3) (local.get $fuel))))
        (local.set $match_status (local.get $status))
        (call $native_continuation_state_set
          (local.get $state_handle) (i32.const 2) (local.get $match_status))
        (call $native_continuation_state_set
          (local.get $state_handle) (i32.const 0) (i32.const 5))))

    ;; Phase 5: materialize and commit. Script-visible mutation happens
    ;; only past this point; a pressure yield during materialization
    ;; retries here without re-running the engine.
    (if (i32.eq (local.get $match_status) (global.get $REGEX_STATUS_NO_MATCH))
      (then
        (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
        (return
          (call $regexp_match_commit
            (local.get $descriptor) (local.get $method_id)
            (local.get $result_slot) (local.get $g_or_y)
            (i32.const 0) (i32.const 0) (i32.const 0))
          (local.get $fuel))))
    (local.set $match_end_scalar (i32.load (i32.add
      (local.get $cont_payload) (global.get $REGEX_CONT_MATCH_END_SCALAR))))
    (if (i32.eq (local.get $method_id) (global.get $METHOD_REGEXP_TEST))
      (then
        (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
        (return
          (call $regexp_match_commit
            (local.get $descriptor) (local.get $method_id)
            (local.get $result_slot) (local.get $g_or_y)
            (i32.const 1) (local.get $match_end_scalar) (i32.const 0))
          (local.get $fuel))))
    (local.set $result_value (call $regexp_exec_materialize
      (local.get $subject_id) (local.get $continuation) (local.get $descriptor)))
    (if (i32.eqz (local.get $result_value))
      (then (return (i32.const 2) (local.get $fuel))))
    (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
    (return
      (call $regexp_match_commit
        (local.get $descriptor) (local.get $method_id)
        (local.get $result_slot) (local.get $g_or_y)
        (i32.const 1) (local.get $match_end_scalar) (local.get $result_value))
      (local.get $fuel))
  )

  ;; ==========================================================================
  ;; RegExp string methods
  ;;
  ;; match / matchAll / search / regexp split / regexp replace(All), plus
  ;; the lazy matchAll iterator's next(). Every operation is an
  ;; interpreter-side fuel-resumable loop around the engine's ordered
  ;; Pike match; phases park in CTX_REGEX_STATE exactly like exec/test.
  ;; Phase numbering is disjoint from both the compile phases (1-3) and
  ;; exec/test's (4-5) so a mixed-up root fails loud:
  ;;   6 = engine attempt running
  ;;   7 = attempt finished (status parked where noted); consumption
  ;;       pending — pressure-retry safe, the engine never re-runs
  ;;   8 = replace callback returned (harvest in the op-root array)
  ;;   9 = post-loop finalize (tail work)  10 = commit
  ;; ==========================================================================

  ;; UTF-8 length of the scalar starting at $byte_offset. $content_abs
  ;; is the absolute address of the string's first content byte; the
  ;; caller guarantees $byte_offset < the string's byte length.
  (func $regexp_scalar_len_at
    (param $content_abs i32) (param $byte_offset i32) (result i32)
    (local $b0 i32)
    (local.set $b0 (i32.load8_u
      (i32.add (local.get $content_abs) (local.get $byte_offset))))
    (if (i32.lt_u (local.get $b0) (i32.const 0x80)) (then (return (i32.const 1))))
    (if (i32.lt_u (local.get $b0) (i32.const 0xE0)) (then (return (i32.const 2))))
    (if (i32.lt_u (local.get $b0) (i32.const 0xF0)) (then (return (i32.const 3))))
    (i32.const 4)
  )

  ;; Checked continuation size for a committed program (-1 = corrupt).
  (func $regexp_continuation_bytes (param $program i32) (result i32)
    (local $prog_payload i32)
    (local.set $prog_payload
      (i32.add (call $abs (local.get $program)) (i32.const 4)))
    (call $regex_continuation_size
      (i32.load (i32.add (local.get $prog_payload)
        (global.get $REGEX_PROGRAM_INSTRUCTION_COUNT)))
      (i32.load (i32.add (local.get $prog_payload)
        (global.get $REGEX_PROGRAM_CAPTURE_GROUP_COUNT)))
      (i32.load (i32.add (local.get $prog_payload)
        (global.get $REGEX_PROGRAM_GUARD_SLOTS))))
  )

  ;; Initialize one engine attempt into an existing continuation buffer.
  ;; Returns the engine status.
  (func $regexp_init_attempt
    (param $program i32) (param $continuation i32)
    (param $subject_id i32) (param $start_byte i32) (param $start_scalar i32)
    (result i32)
    (local $subject_abs i32)
    (local.set $subject_abs (call $string_id_to_abs (local.get $subject_id)))
    (call $regex_initialize_match
      (i32.add (call $abs (local.get $program)) (i32.const 4))
      (i32.load (call $abs (local.get $program)))
      (i32.add (local.get $subject_abs) (i32.const 4))
      (i32.load (local.get $subject_abs))
      (local.get $start_byte)
      (local.get $start_scalar)
      (i32.add (call $abs (local.get $continuation)) (i32.const 4))
      (i32.load (call $abs (local.get $continuation))))
  )

  ;; Rebind the continuation's absolute program/input addresses (the
  ;; collector may have moved either since the last grant) and drive the
  ;; engine. Returns (status, fuelRemaining).
  (func $regexp_run_attempt
    (param $program i32) (param $continuation i32)
    (param $subject_id i32) (param $fuel i32)
    (result i32 i32)
    (local $cont_payload i32)
    (local.set $cont_payload
      (i32.add (call $abs (local.get $continuation)) (i32.const 4)))
    (i32.store
      (i32.add (local.get $cont_payload) (global.get $REGEX_CONT_PROGRAM_ADDRESS))
      (i32.add (call $abs (local.get $program)) (i32.const 4)))
    (i32.store
      (i32.add (local.get $cont_payload) (global.get $REGEX_CONT_INPUT_ADDRESS))
      (i32.add (call $string_id_to_abs (local.get $subject_id)) (i32.const 4)))
    (call $regex_run_match
      (local.get $cont_payload)
      (i32.load (call $abs (local.get $continuation)))
      (local.get $fuel))
  )

  ;; Ensure the pattern argument is a RegExp. A non-RegExp argument
  ;; compiles through the shared literal machinery (JS: match/matchAll/
  ;; search construct RegExp(ToString(arg)); undefined -> empty pattern)
  ;; and the committed descriptor overwrites the rooted argument slot so
  ;; later grants short-circuit. Returns (descriptor, disposition, fuel);
  ;; the descriptor is valid only when disposition == 0.
  (func $regexp_coerce_pattern_arg
    (param $args_base i32) (param $extra_flags i32)
    (param $entry_pending_pointer i32) (param $fuel i32)
    (result i32 i32 i32)
    (local $pattern_id i32)
    (local $disposition i32)
    (local $descriptor i32)
    (local $arg_type i32)
    (local.set $arg_type (call $value_type (local.get $args_base)))
    (if (i32.eq (local.get $arg_type) (global.get $TYPE_REGEXP))
      (then (return
        (call $value_data_lo (local.get $args_base))
        (i32.const 0) (local.get $fuel))))
    (if (i32.eq (local.get $arg_type) (global.get $TYPE_UNDEFINED))
      (then
        ;; RegExp(undefined) is the empty pattern, NOT "undefined".
        (local.set $pattern_id (call $intern_string (i32.const 0) (i32.const 0))))
      (else
        (local.set $pattern_id (call $value_to_string (local.get $args_base)))))
    (if (i32.eqz (local.get $pattern_id))
      (then (return (i32.const 0) (i32.const 2) (local.get $fuel))))
    (call $lit_regexp_step
      (local.get $pattern_id) (local.get $extra_flags) (local.get $fuel))
    (local.set $fuel)
    (local.set $disposition)
    (if (i32.ne (local.get $disposition) (i32.const 0))
      (then (return (i32.const 0) (local.get $disposition) (local.get $fuel))))
    ;; The literal step pushed the committed RegExp at the entry pointer.
    (local.set $descriptor
      (call $value_data_lo (local.get $entry_pending_pointer)))
    (call $write_ctx (global.get $CTX_PENDING_POINTER)
      (local.get $entry_pending_pointer))
    (call $write_value (local.get $args_base)
      (global.get $TYPE_REGEXP) (i32.const 0)
      (local.get $descriptor) (i32.const 0))
    (return (local.get $descriptor) (i32.const 0) (local.get $fuel))
  )

  ;; One fuel grant of "str".search(re): a single engine attempt from
  ;; position 0 — lastIndex is neither read nor written (JS saves and
  ;; restores it; net effect identical). Result: the match's start index
  ;; in Unicode scalars, or -1. Dispositions match $regexp_match_step.
  (func $regexp_string_search_step
    (param $subject_id i32) (param $result_slot i32)
    (param $argc i32) (param $args_base i32)
    (param $entry_pending_pointer i32) (param $fuel i32)
    (result i32 i32)
    (local $descriptor i32)
    (local $disposition i32)
    (local $state_handle i32)
    (local $phase i32)
    (local $continuation i32)
    (local $program i32)
    (local $cont_bytes i32)
    (local $status i32)
    (local $bits i64)

    (call $write_ctx (global.get $CTX_PENDING_POINTER)
      (local.get $entry_pending_pointer))
    ;; argc==0: materialize a synthetic undefined argument slot so the
    ;; coercion path has a rooted slot to rewrite. Initialized only when
    ;; no operation state is parked (a fresh call).
    (if (i32.eqz (local.get $argc))
      (then
        (if (i32.eqz (call $read_ctx (global.get $CTX_REGEX_STATE)))
          (then
            (call $write_value (local.get $entry_pending_pointer)
              (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))))
        (local.set $args_base (local.get $entry_pending_pointer))
        (local.set $entry_pending_pointer
          (i32.add (local.get $entry_pending_pointer) (global.get $VALUE_SIZE)))
        (call $write_ctx (global.get $CTX_PENDING_POINTER)
          (local.get $entry_pending_pointer))))

    (call $regexp_coerce_pattern_arg
      (local.get $args_base) (i32.const 0)
      (local.get $entry_pending_pointer) (local.get $fuel))
    (local.set $fuel)
    (local.set $disposition)
    (local.set $descriptor)
    (if (i32.ne (local.get $disposition) (i32.const 0))
      (then (return (local.get $disposition) (local.get $fuel))))

    (local.set $program (i32.load (call $abs (i32.add
      (i32.add (local.get $descriptor) (global.get $GC_HEADER_SIZE))
      (global.get $REGEXP_PROGRAM_BUFFER)))))
    (if (i32.eqz (local.get $program))
      (then
        (call $fault_error (global.get $ERR_CORRUPT_OPERAND)
          (i32.const 0) (global.get $current_executing_pc))
        (return (i32.const 3) (local.get $fuel))))

    (local.set $state_handle (call $read_ctx (global.get $CTX_REGEX_STATE)))
    (if (i32.eq (local.get $state_handle) (i32.const 0))
      (then
        (local.set $cont_bytes (call $regexp_continuation_bytes (local.get $program)))
        (if (i32.eq (local.get $cont_bytes) (i32.const -1))
          (then
            (call $fault_error (global.get $ERR_CORRUPT_OPERAND)
              (i32.const 1) (global.get $current_executing_pc))
            (return (i32.const 3) (local.get $fuel))))
        (if (call $check_heap_overflow (i32.add
              (call $estimate_arraybuffer_size (local.get $cont_bytes))
              (global.get $NATIVE_CONTINUATION_STATE_SIZE)))
          (then (return (i32.const 2) (local.get $fuel))))
        (local.set $continuation (call $allocate_arraybuffer (local.get $cont_bytes)))
        (local.set $status (call $regexp_init_attempt
          (local.get $program) (local.get $continuation)
          (local.get $subject_id) (i32.const 0) (i32.const 0)))
        (if (i32.ne (local.get $status) (global.get $REGEX_STATUS_OK))
          (then
            (call $fault_error (global.get $ERR_CORRUPT_OPERAND)
              (local.get $status) (global.get $current_executing_pc))
            (return (i32.const 3) (local.get $fuel))))
        (local.set $state_handle (call $allocate_native_continuation_state
          (i32.const 0) (i32.const 2)
          (i32.const 6) (local.get $continuation)
          (i32.const 0) (i32.const 0) (i32.const 0)))
        (call $write_ctx (global.get $CTX_REGEX_STATE) (local.get $state_handle)))
      (else
        (local.set $phase
          (call $native_continuation_state_get (local.get $state_handle) (i32.const 0)))
        (local.set $continuation
          (call $native_continuation_state_get (local.get $state_handle) (i32.const 1)))
        (if (i32.or
              (i32.ne (local.get $phase) (i32.const 6))
              (i32.eqz (local.get $continuation)))
          (then
            (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
            (call $fault_error (global.get $ERR_CORRUPT_OPERAND)
              (local.get $phase) (global.get $current_executing_pc))
            (return (i32.const 3) (local.get $fuel))))))

    (call $regexp_run_attempt
      (local.get $program) (local.get $continuation)
      (local.get $subject_id) (local.get $fuel))
    (local.set $fuel)
    (local.set $status)
    (if (i32.eq (local.get $status) (global.get $REGEX_STATUS_PAUSED))
      (then (return (i32.const 1) (local.get $fuel))))
    (if (i32.eq (local.get $status) (global.get $REGEX_STATUS_MATCH))
      (then
        (local.set $bits (i64.reinterpret_f64 (f64.convert_i32_u
          (call $utf8_byte_offset_to_char_index
            (local.get $subject_id)
            (i32.load (i32.add
              (i32.add (call $abs (local.get $continuation)) (i32.const 4))
              (global.get $REGEX_CONT_HEADER_SIZE)))))))
        (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
        (call $write_value (local.get $result_slot)
          (global.get $TYPE_FLOAT) (i32.const 0)
          (i32.wrap_i64 (local.get $bits))
          (i32.wrap_i64 (i64.shr_u (local.get $bits) (i64.const 32))))
        (call $write_ctx (global.get $CTX_PENDING_POINTER)
          (i32.add (local.get $result_slot) (global.get $VALUE_SIZE)))
        (return (i32.const 0) (local.get $fuel))))
    (if (i32.eq (local.get $status) (global.get $REGEX_STATUS_NO_MATCH))
      (then
        (local.set $bits (i64.reinterpret_f64 (f64.const -1)))
        (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
        (call $write_value (local.get $result_slot)
          (global.get $TYPE_FLOAT) (i32.const 0)
          (i32.wrap_i64 (local.get $bits))
          (i32.wrap_i64 (i64.shr_u (local.get $bits) (i64.const 32))))
        (call $write_ctx (global.get $CTX_PENDING_POINTER)
          (i32.add (local.get $result_slot) (global.get $VALUE_SIZE)))
        (return (i32.const 0) (local.get $fuel))))
    (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
    (call $fault_error (global.get $ERR_CORRUPT_OPERAND)
      (local.get $status) (global.get $current_executing_pc))
    (return (i32.const 3) (local.get $fuel))
  )

  ;; One fuel grant of "str".match(re). Non-global delegates to the
  ;; exec step (JS: match without g IS RegExpExec, lastIndex rules
  ;; included). Global runs the collect-all loop: full-match strings
  ;; only, empty matches advance one Unicode scalar, the result is null
  ;; when nothing matched, and lastIndex commits to 0 at the single
  ;; commit point (the spec's start-reset plus final failing exec).
  (func $regexp_string_match_step
    (param $subject_id i32) (param $result_slot i32)
    (param $argc i32) (param $args_base i32)
    (param $entry_pending_pointer i32) (param $fuel i32)
    (result i32 i32)
    (local $descriptor i32)
    (local $disposition i32)
    (local $state_handle i32)
    (local $phase i32)
    (local $continuation i32)
    (local $result_array i32)
    (local $program i32)
    (local $flags_word i32)
    (local $cont_bytes i32)
    (local $status i32)
    (local $cont_payload i32)
    (local $ms i32)
    (local $me i32)
    (local $sid i32)
    (local $arr_len i32)
    (local $arr_cap i32)
    (local $origin i32)
    (local $origin_scalar i32)
    (local $subject_abs i32)
    (local $subject_len i32)

    (call $write_ctx (global.get $CTX_PENDING_POINTER)
      (local.get $entry_pending_pointer))
    (if (i32.eqz (local.get $argc))
      (then
        (if (i32.eqz (call $read_ctx (global.get $CTX_REGEX_STATE)))
          (then
            (call $write_value (local.get $entry_pending_pointer)
              (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))))
        (local.set $args_base (local.get $entry_pending_pointer))
        (local.set $argc (i32.const 1))
        (local.set $entry_pending_pointer
          (i32.add (local.get $entry_pending_pointer) (global.get $VALUE_SIZE)))
        (call $write_ctx (global.get $CTX_PENDING_POINTER)
          (local.get $entry_pending_pointer))))

    (call $regexp_coerce_pattern_arg
      (local.get $args_base) (i32.const 0)
      (local.get $entry_pending_pointer) (local.get $fuel))
    (local.set $fuel)
    (local.set $disposition)
    (local.set $descriptor)
    (if (i32.ne (local.get $disposition) (i32.const 0))
      (then (return (local.get $disposition) (local.get $fuel))))

    (local.set $flags_word (i32.load (call $abs (i32.add
      (i32.add (local.get $descriptor) (global.get $GC_HEADER_SIZE))
      (global.get $REGEXP_FLAGS)))))
    (if (i32.eqz (i32.and (local.get $flags_word) (global.get $REGEXP_FLAG_GLOBAL)))
      (then
        ;; Non-global match IS RegExpExec on the receiver string.
        (return (call $regexp_match_step
          (local.get $descriptor)
          (global.get $METHOD_REGEXP_EXEC)
          (local.get $result_slot)
          (local.get $argc)
          (local.get $args_base)
          (local.get $entry_pending_pointer)
          (local.get $fuel)
          (local.get $subject_id)))))

    (local.set $program (i32.load (call $abs (i32.add
      (i32.add (local.get $descriptor) (global.get $GC_HEADER_SIZE))
      (global.get $REGEXP_PROGRAM_BUFFER)))))
    (if (i32.eqz (local.get $program))
      (then
        (call $fault_error (global.get $ERR_CORRUPT_OPERAND)
          (i32.const 0) (global.get $current_executing_pc))
        (return (i32.const 3) (local.get $fuel))))
    (local.set $subject_abs (call $string_id_to_abs (local.get $subject_id)))
    (local.set $subject_len (i32.load (local.get $subject_abs)))
    (local.set $subject_abs (i32.add (local.get $subject_abs) (i32.const 4)))

    (local.set $state_handle (call $read_ctx (global.get $CTX_REGEX_STATE)))
    (if (i32.eq (local.get $state_handle) (i32.const 0))
      (then
        (local.set $cont_bytes (call $regexp_continuation_bytes (local.get $program)))
        (if (i32.eq (local.get $cont_bytes) (i32.const -1))
          (then
            (call $fault_error (global.get $ERR_CORRUPT_OPERAND)
              (i32.const 1) (global.get $current_executing_pc))
            (return (i32.const 3) (local.get $fuel))))
        (if (call $check_heap_overflow (i32.add
              (i32.add
                (call $estimate_arraybuffer_size (local.get $cont_bytes))
                (call $estimate_array_size (i32.const 4)))
              (global.get $NATIVE_CONTINUATION_STATE_SIZE)))
          (then (return (i32.const 2) (local.get $fuel))))
        (local.set $continuation (call $allocate_arraybuffer (local.get $cont_bytes)))
        (local.set $result_array (call $allocate_array (i32.const 4)))
        (i32.store (call $abs (i32.add (local.get $result_array) (i32.const 8)))
          (i32.const 0))
        (local.set $status (call $regexp_init_attempt
          (local.get $program) (local.get $continuation)
          (local.get $subject_id) (i32.const 0) (i32.const 0)))
        (if (i32.ne (local.get $status) (global.get $REGEX_STATUS_OK))
          (then
            (call $fault_error (global.get $ERR_CORRUPT_OPERAND)
              (local.get $status) (global.get $current_executing_pc))
            (return (i32.const 3) (local.get $fuel))))
        ;; state: [phase, continuation(data), resultArray(header), 0, 0]
        (local.set $state_handle (call $allocate_native_continuation_state
          (i32.const 4) (i32.const 2)
          (i32.const 6) (local.get $continuation)
          (local.get $result_array) (i32.const 0) (i32.const 0)))
        (call $write_ctx (global.get $CTX_REGEX_STATE) (local.get $state_handle))
        (local.set $phase (i32.const 6)))
      (else
        (local.set $phase
          (call $native_continuation_state_get (local.get $state_handle) (i32.const 0)))
        (local.set $continuation
          (call $native_continuation_state_get (local.get $state_handle) (i32.const 1)))
        (local.set $result_array
          (call $native_continuation_state_get (local.get $state_handle) (i32.const 2)))
        (if (i32.or
              (i32.or
                (i32.lt_u (local.get $phase) (i32.const 6))
                (i32.gt_u (local.get $phase) (i32.const 9)))
              (i32.or
                (i32.eqz (local.get $continuation))
                (i32.eqz (local.get $result_array))))
          (then
            (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
            (call $fault_error (global.get $ERR_CORRUPT_OPERAND)
              (local.get $phase) (global.get $current_executing_pc))
            (return (i32.const 3) (local.get $fuel))))))

    (local.set $cont_payload
      (i32.add (call $abs (local.get $continuation)) (i32.const 4)))

    (block $finalize
      (loop $drive
        (if (i32.eq (local.get $phase) (i32.const 9))
          (then (br $finalize)))
        (if (i32.eq (local.get $phase) (i32.const 6))
          (then
            (call $regexp_run_attempt
              (local.get $program) (local.get $continuation)
              (local.get $subject_id) (local.get $fuel))
            (local.set $fuel)
            (local.set $status)
            (local.set $cont_payload
              (i32.add (call $abs (local.get $continuation)) (i32.const 4)))
            (if (i32.eq (local.get $status) (global.get $REGEX_STATUS_PAUSED))
              (then (return (i32.const 1) (local.get $fuel))))
            (if (i32.eq (local.get $status) (global.get $REGEX_STATUS_NO_MATCH))
              (then
                (local.set $phase (i32.const 9))
                (call $native_continuation_state_set
                  (local.get $state_handle) (i32.const 0) (local.get $phase))
                (br $finalize)))
            (if (i32.ne (local.get $status) (global.get $REGEX_STATUS_MATCH))
              (then
                (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
                (call $fault_error (global.get $ERR_CORRUPT_OPERAND)
                  (local.get $status) (global.get $current_executing_pc))
                (return (i32.const 3) (local.get $fuel))))
            (local.set $phase (i32.const 7))
            (call $native_continuation_state_set
              (local.get $state_handle) (i32.const 0) (local.get $phase))))
        ;; Phase 7: consume the found match. Everything before the next
        ;; attempt's initialization is pressure-retry safe: the spans
        ;; stay in the continuation until then, and the initialization
        ;; itself allocates nothing.
        (local.set $ms (i32.load (i32.add (local.get $cont_payload)
          (global.get $REGEX_CONT_HEADER_SIZE))))
        (local.set $me (i32.load (i32.add
          (i32.add (local.get $cont_payload) (global.get $REGEX_CONT_HEADER_SIZE))
          (i32.const 4))))
        (local.set $sid (call $intern_string
          (i32.add (local.get $subject_abs) (local.get $ms))
          (i32.sub (local.get $me) (local.get $ms))))
        (if (i32.eqz (local.get $sid))
          (then (return (i32.const 2) (local.get $fuel))))
        (local.set $arr_len (i32.load (call $abs
          (i32.add (local.get $result_array) (i32.const 8)))))
        (local.set $arr_cap (i32.load (call $abs
          (i32.add (local.get $result_array) (i32.const 12)))))
        (if (i32.gt_u (i32.add (local.get $arr_len) (i32.const 1)) (local.get $arr_cap))
          (then
            (if (call $check_heap_overflow (call $estimate_array_push_budget
                  (local.get $arr_cap) (i32.add (local.get $arr_len) (i32.const 1))))
              (then (return (i32.const 2) (local.get $fuel))))))
        (drop (call $array_push_value
          (local.get $result_array)
          (global.get $TYPE_STRING) (i32.const 0) (local.get $sid) (i32.const 0)))
        ;; Advance: past the match, or one scalar past an empty match.
        (local.set $origin (local.get $me))
        (local.set $origin_scalar (i32.load (i32.add
          (local.get $cont_payload) (global.get $REGEX_CONT_MATCH_END_SCALAR))))
        (if (i32.eq (local.get $me) (local.get $ms))
          (then
            (if (i32.ge_u (local.get $me) (local.get $subject_len))
              (then (local.set $origin (i32.add (local.get $subject_len) (i32.const 1))))
              (else
                (local.set $origin (i32.add (local.get $me)
                  (call $regexp_scalar_len_at
                    (local.get $subject_abs) (local.get $me))))
                (local.set $origin_scalar
                  (i32.add (local.get $origin_scalar) (i32.const 1)))))))
        (if (i32.gt_u (local.get $origin) (local.get $subject_len))
          (then
            (local.set $phase (i32.const 9))
            (call $native_continuation_state_set
              (local.get $state_handle) (i32.const 0) (local.get $phase))
            (br $finalize)))
        (local.set $status (call $regexp_init_attempt
          (local.get $program) (local.get $continuation)
          (local.get $subject_id) (local.get $origin) (local.get $origin_scalar)))
        (if (i32.ne (local.get $status) (global.get $REGEX_STATUS_OK))
          (then
            (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
            (call $fault_error (global.get $ERR_CORRUPT_OPERAND)
              (local.get $status) (global.get $current_executing_pc))
            (return (i32.const 3) (local.get $fuel))))
        (local.set $phase (i32.const 6))
        (call $native_continuation_state_set
          (local.get $state_handle) (i32.const 0) (local.get $phase))
        (br $drive)))

    ;; Finalize: null when nothing matched; lastIndex commits to 0.
    (i32.store
      (call $abs (i32.add
        (i32.add (local.get $descriptor) (global.get $GC_HEADER_SIZE))
        (global.get $REGEXP_LAST_INDEX)))
      (i32.const 0))
    (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
    (if (i32.eqz (i32.load (call $abs
          (i32.add (local.get $result_array) (i32.const 8)))))
      (then
        (call $write_value (local.get $result_slot)
          (global.get $TYPE_NULL) (i32.const 0) (i32.const 0) (i32.const 0)))
      (else
        (call $write_value (local.get $result_slot)
          (global.get $TYPE_ARRAY) (i32.const 0)
          (local.get $result_array) (i32.const 0))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER)
      (i32.add (local.get $result_slot) (global.get $VALUE_SIZE)))
    (return (i32.const 0) (local.get $fuel))
  )

  ;; One fuel grant of "str".matchAll(re): validate the global flag,
  ;; clone the RegExp (shared pattern string and immutable program
  ;; buffer, copied flags, copied lastIndex), and build the lazy
  ;; iterator object. All matching happens in the iterator's next()
  ;; (JS %RegExpStringIterator% semantics); the original RegExp is
  ;; never touched after this call.
  (func $regexp_string_match_all_step
    (param $subject_id i32) (param $result_slot i32)
    (param $argc i32) (param $args_base i32)
    (param $entry_pending_pointer i32) (param $fuel i32)
    (result i32 i32)
    (local $descriptor i32)
    (local $disposition i32)
    (local $descriptor_data i32)
    (local $flags_word i32)
    (local $clone i32)
    (local $clone_data i32)
    (local $object_pointer i32)

    (call $write_ctx (global.get $CTX_PENDING_POINTER)
      (local.get $entry_pending_pointer))
    (if (i32.eqz (local.get $argc))
      (then
        (if (i32.eqz (call $read_ctx (global.get $CTX_REGEX_STATE)))
          (then
            (call $write_value (local.get $entry_pending_pointer)
              (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))))
        (local.set $args_base (local.get $entry_pending_pointer))
        (local.set $entry_pending_pointer
          (i32.add (local.get $entry_pending_pointer) (global.get $VALUE_SIZE)))
        (call $write_ctx (global.get $CTX_PENDING_POINTER)
          (local.get $entry_pending_pointer))))

    ;; A string pattern compiles WITH the global flag (JS: RegExp(S, "g")).
    (call $regexp_coerce_pattern_arg
      (local.get $args_base) (global.get $REGEXP_FLAG_GLOBAL)
      (local.get $entry_pending_pointer) (local.get $fuel))
    (local.set $fuel)
    (local.set $disposition)
    (local.set $descriptor)
    (if (i32.ne (local.get $disposition) (i32.const 0))
      (then (return (local.get $disposition) (local.get $fuel))))

    (local.set $descriptor_data
      (i32.add (local.get $descriptor) (global.get $GC_HEADER_SIZE)))
    (local.set $flags_word (i32.load (call $abs (i32.add
      (local.get $descriptor_data) (global.get $REGEXP_FLAGS)))))
    (if (i32.eqz (i32.and (local.get $flags_word) (global.get $REGEXP_FLAG_GLOBAL)))
      (then
        (if (call $throw_type_error_with_message
              (global.get $BUILTIN_MSG_MATCHALL_GLOBAL))
          (then (return (i32.const 3) (local.get $fuel)))
          (else (return (i32.const 4) (local.get $fuel))))))

    ;; One gate for the clone descriptor, the iterator object, and its
    ;; sym-entries block (Symbol.iterator -> return-self).
    (if (call $check_heap_overflow (i32.add
          (i32.add (i32.const 32) (call $estimate_object_size (i32.const 4)))
          (call $estimate_object_sym_entries_size)))
      (then (return (i32.const 2) (local.get $fuel))))

    (local.set $clone (call $allocate_regexp_descriptor
      (i32.load (call $abs (i32.add
        (local.get $descriptor_data) (global.get $REGEXP_PATTERN_STRING))))
      (local.get $flags_word)))
    (local.set $clone_data
      (i32.add (local.get $clone) (global.get $GC_HEADER_SIZE)))
    (i32.store
      (call $abs (i32.add (local.get $clone_data) (global.get $REGEXP_LAST_INDEX)))
      (i32.load (call $abs (i32.add
        (local.get $descriptor_data) (global.get $REGEXP_LAST_INDEX)))))
    (i32.store
      (call $abs (i32.add (local.get $clone_data) (global.get $REGEXP_PROGRAM_BUFFER)))
      (i32.load (call $abs (i32.add
        (local.get $descriptor_data) (global.get $REGEXP_PROGRAM_BUFFER)))))

    (local.set $object_pointer (call $allocate_object (i32.const 4)))
    (drop (call $object_set_property
      (local.get $object_pointer)
      (call $read_builtin (global.get $BUILTIN_ITER_HIDDEN_REGEXP))
      (global.get $TYPE_REGEXP) (i32.const 0)
      (local.get $clone) (i32.const 0)))
    (drop (call $object_set_property
      (local.get $object_pointer)
      (call $read_builtin (global.get $BUILTIN_ITER_HIDDEN_STRING))
      (global.get $TYPE_STRING) (i32.const 0)
      (local.get $subject_id) (i32.const 0)))
    (drop (call $object_set_property
      (local.get $object_pointer)
      (call $read_builtin (global.get $BUILTIN_ITER_HIDDEN_DONE))
      (global.get $TYPE_RATIONAL) (global.get $FLAG_RATIONAL_INLINE)
      (i32.const 0) (i32.const 0)))
    (drop (call $object_set_property
      (local.get $object_pointer)
      (call $read_builtin (global.get $BUILTIN_ITER_NEXT_KEY))
      (global.get $TYPE_BOUND_METHOD)
      (global.get $TYPE_OBJECT)
      (local.get $object_pointer)
      (global.get $METHOD_REGEXP_STRING_ITERATOR_NEXT)))
    (call $object_set_sym_entry
      (local.get $object_pointer)
      (call $read_state (global.get $STATE_WELL_KNOWN_ITERATOR_SYMBOL))
      (global.get $TYPE_BOUND_METHOD)
      (global.get $TYPE_OBJECT)
      (local.get $object_pointer)
      (global.get $METHOD_ITERATOR_RETURN_SELF))

    (call $write_value (local.get $result_slot)
      (global.get $TYPE_OBJECT) (i32.const 0)
      (local.get $object_pointer) (i32.const 0))
    (call $write_ctx (global.get $CTX_PENDING_POINTER)
      (i32.add (local.get $result_slot) (global.get $VALUE_SIZE)))
    (return (i32.const 0) (local.get $fuel))
  )

  ;; One fuel grant of a matchAll iterator's next(): one engine match
  ;; over the iterator's cloned RegExp, materialized as a full exec
  ;; result inside {value, done}. Empty matches advance the clone's
  ;; lastIndex one extra Unicode scalar (the spec's AdvanceStringIndex);
  ;; exhaustion sets @done and resets the clone's lastIndex.
  (func $regexp_string_iterator_next_step
    (param $iterator_pointer i32) (param $result_slot i32)
    (param $entry_pending_pointer i32) (param $fuel i32)
    (result i32 i32)
    (local $entry_pointer i32)
    (local $clone i32)
    (local $clone_data i32)
    (local $subject_id i32)
    (local $done_flag i32)
    (local $program i32)
    (local $state_handle i32)
    (local $phase i32)
    (local $continuation i32)
    (local $match_status i32)
    (local $cont_bytes i32)
    (local $status i32)
    (local $cont_payload i32)
    (local $start_scalar i32)
    (local $start_byte i32)
    (local $exec_array i32)
    (local $object_pointer i32)
    (local $ms i32)
    (local $me i32)
    (local $end_scalar i32)

    (call $write_ctx (global.get $CTX_PENDING_POINTER)
      (local.get $entry_pending_pointer))

    ;; The iterator's hidden slots. These objects are built only by the
    ;; matchAll factory; a missing slot is corruption, not guest error.
    (local.set $entry_pointer (call $object_find_string_entry
      (local.get $iterator_pointer)
      (call $read_builtin (global.get $BUILTIN_ITER_HIDDEN_REGEXP))))
    (if (i32.or
          (i32.eqz (local.get $entry_pointer))
          (i32.ne
            (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 4))))
            (global.get $TYPE_REGEXP)))
      (then
        (call $fault_error (global.get $ERR_CORRUPT_OPERAND)
          (i32.const 2) (global.get $current_executing_pc))
        (return (i32.const 3) (local.get $fuel))))
    (local.set $clone
      (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 12)))))
    (local.set $clone_data (i32.add (local.get $clone) (global.get $GC_HEADER_SIZE)))
    (local.set $entry_pointer (call $object_find_string_entry
      (local.get $iterator_pointer)
      (call $read_builtin (global.get $BUILTIN_ITER_HIDDEN_STRING))))
    (if (i32.eqz (local.get $entry_pointer))
      (then
        (call $fault_error (global.get $ERR_CORRUPT_OPERAND)
          (i32.const 3) (global.get $current_executing_pc))
        (return (i32.const 3) (local.get $fuel))))
    (local.set $subject_id
      (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 12)))))
    (local.set $entry_pointer (call $object_find_string_entry
      (local.get $iterator_pointer)
      (call $read_builtin (global.get $BUILTIN_ITER_HIDDEN_DONE))))
    (if (i32.eqz (local.get $entry_pointer))
      (then
        (call $fault_error (global.get $ERR_CORRUPT_OPERAND)
          (i32.const 4) (global.get $current_executing_pc))
        (return (i32.const 3) (local.get $fuel))))
    (local.set $done_flag
      (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 12)))))

    (if (local.get $done_flag)
      (then
        (if (call $check_heap_overflow (call $estimate_object_size (i32.const 2)))
          (then (return (i32.const 2) (local.get $fuel))))
        (local.set $object_pointer (call $allocate_object (i32.const 2)))
        (drop (call $object_set_property
          (local.get $object_pointer)
          (call $read_builtin (global.get $BUILTIN_ITER_VALUE_KEY))
          (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0)))
        (drop (call $object_set_property
          (local.get $object_pointer)
          (call $read_builtin (global.get $BUILTIN_ITER_DONE_KEY))
          (global.get $TYPE_BOOLEAN) (i32.const 0) (i32.const 1) (i32.const 0)))
        (call $write_value (local.get $result_slot)
          (global.get $TYPE_OBJECT) (i32.const 0)
          (local.get $object_pointer) (i32.const 0))
        (call $write_ctx (global.get $CTX_PENDING_POINTER)
          (i32.add (local.get $result_slot) (global.get $VALUE_SIZE)))
        (return (i32.const 0) (local.get $fuel))))

    (local.set $program (i32.load (call $abs (i32.add
      (local.get $clone_data) (global.get $REGEXP_PROGRAM_BUFFER)))))
    (if (i32.eqz (local.get $program))
      (then
        (call $fault_error (global.get $ERR_CORRUPT_OPERAND)
          (i32.const 5) (global.get $current_executing_pc))
        (return (i32.const 3) (local.get $fuel))))

    (local.set $state_handle (call $read_ctx (global.get $CTX_REGEX_STATE)))
    (if (i32.eq (local.get $state_handle) (i32.const 0))
      (then
        (local.set $start_scalar (i32.load (call $abs (i32.add
          (local.get $clone_data) (global.get $REGEXP_LAST_INDEX)))))
        (local.set $start_byte (call $utf8_char_to_byte_offset
          (local.get $subject_id) (local.get $start_scalar)))
        (if (i32.eq (local.get $start_byte) (i32.const -1))
          (then
            ;; Origin past the end: an immediate miss with no engine run.
            ;; Build the done-result first, then commit the mutations.
            (if (call $check_heap_overflow (call $estimate_object_size (i32.const 2)))
              (then (return (i32.const 2) (local.get $fuel))))
            (local.set $object_pointer (call $allocate_object (i32.const 2)))
            (drop (call $object_set_property
              (local.get $object_pointer)
              (call $read_builtin (global.get $BUILTIN_ITER_VALUE_KEY))
              (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0)))
            (drop (call $object_set_property
              (local.get $object_pointer)
              (call $read_builtin (global.get $BUILTIN_ITER_DONE_KEY))
              (global.get $TYPE_BOOLEAN) (i32.const 0) (i32.const 1) (i32.const 0)))
            (i32.store
              (call $abs (i32.add (local.get $clone_data) (global.get $REGEXP_LAST_INDEX)))
              (i32.const 0))
            (drop (call $object_set_property
              (local.get $iterator_pointer)
              (call $read_builtin (global.get $BUILTIN_ITER_HIDDEN_DONE))
              (global.get $TYPE_RATIONAL) (global.get $FLAG_RATIONAL_INLINE)
              (i32.const 1) (i32.const 0)))
            (call $write_value (local.get $result_slot)
              (global.get $TYPE_OBJECT) (i32.const 0)
              (local.get $object_pointer) (i32.const 0))
            (call $write_ctx (global.get $CTX_PENDING_POINTER)
              (i32.add (local.get $result_slot) (global.get $VALUE_SIZE)))
            (return (i32.const 0) (local.get $fuel))))
        (local.set $cont_bytes (call $regexp_continuation_bytes (local.get $program)))
        (if (i32.eq (local.get $cont_bytes) (i32.const -1))
          (then
            (call $fault_error (global.get $ERR_CORRUPT_OPERAND)
              (i32.const 1) (global.get $current_executing_pc))
            (return (i32.const 3) (local.get $fuel))))
        (if (call $check_heap_overflow (i32.add
              (call $estimate_arraybuffer_size (local.get $cont_bytes))
              (global.get $NATIVE_CONTINUATION_STATE_SIZE)))
          (then (return (i32.const 2) (local.get $fuel))))
        (local.set $continuation (call $allocate_arraybuffer (local.get $cont_bytes)))
        (local.set $status (call $regexp_init_attempt
          (local.get $program) (local.get $continuation)
          (local.get $subject_id) (local.get $start_byte) (local.get $start_scalar)))
        (if (i32.ne (local.get $status) (global.get $REGEX_STATUS_OK))
          (then
            (call $fault_error (global.get $ERR_CORRUPT_OPERAND)
              (local.get $status) (global.get $current_executing_pc))
            (return (i32.const 3) (local.get $fuel))))
        (local.set $state_handle (call $allocate_native_continuation_state
          (i32.const 0) (i32.const 2)
          (i32.const 6) (local.get $continuation)
          (i32.const 0) (i32.const 0) (i32.const 0)))
        (call $write_ctx (global.get $CTX_REGEX_STATE) (local.get $state_handle))
        (local.set $phase (i32.const 6)))
      (else
        (local.set $phase
          (call $native_continuation_state_get (local.get $state_handle) (i32.const 0)))
        (local.set $continuation
          (call $native_continuation_state_get (local.get $state_handle) (i32.const 1)))
        (local.set $match_status
          (call $native_continuation_state_get (local.get $state_handle) (i32.const 2)))
        (if (i32.or
              (i32.or
                (i32.lt_u (local.get $phase) (i32.const 6))
                (i32.gt_u (local.get $phase) (i32.const 7)))
              (i32.eqz (local.get $continuation)))
          (then
            (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
            (call $fault_error (global.get $ERR_CORRUPT_OPERAND)
              (local.get $phase) (global.get $current_executing_pc))
            (return (i32.const 3) (local.get $fuel))))))

    (if (i32.eq (local.get $phase) (i32.const 6))
      (then
        (call $regexp_run_attempt
          (local.get $program) (local.get $continuation)
          (local.get $subject_id) (local.get $fuel))
        (local.set $fuel)
        (local.set $status)
        (if (i32.eq (local.get $status) (global.get $REGEX_STATUS_PAUSED))
          (then (return (i32.const 1) (local.get $fuel))))
        (if (i32.and
              (i32.ne (local.get $status) (global.get $REGEX_STATUS_MATCH))
              (i32.ne (local.get $status) (global.get $REGEX_STATUS_NO_MATCH)))
          (then
            (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
            (call $fault_error (global.get $ERR_CORRUPT_OPERAND)
              (local.get $status) (global.get $current_executing_pc))
            (return (i32.const 3) (local.get $fuel))))
        (local.set $match_status (local.get $status))
        (call $native_continuation_state_set
          (local.get $state_handle) (i32.const 2) (local.get $match_status))
        (call $native_continuation_state_set
          (local.get $state_handle) (i32.const 0) (i32.const 7))))

    (local.set $cont_payload
      (i32.add (call $abs (local.get $continuation)) (i32.const 4)))
    (if (i32.eq (local.get $match_status) (global.get $REGEX_STATUS_NO_MATCH))
      (then
        (if (call $check_heap_overflow (call $estimate_object_size (i32.const 2)))
          (then (return (i32.const 2) (local.get $fuel))))
        (local.set $object_pointer (call $allocate_object (i32.const 2)))
        (drop (call $object_set_property
          (local.get $object_pointer)
          (call $read_builtin (global.get $BUILTIN_ITER_VALUE_KEY))
          (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0)))
        (drop (call $object_set_property
          (local.get $object_pointer)
          (call $read_builtin (global.get $BUILTIN_ITER_DONE_KEY))
          (global.get $TYPE_BOOLEAN) (i32.const 0) (i32.const 1) (i32.const 0)))
        ;; Commit: exhaust the iterator, reset the clone (JS: the failing
        ;; exec writes lastIndex = 0 on the global clone).
        (i32.store
          (call $abs (i32.add (local.get $clone_data) (global.get $REGEXP_LAST_INDEX)))
          (i32.const 0))
        (drop (call $object_set_property
          (local.get $iterator_pointer)
          (call $read_builtin (global.get $BUILTIN_ITER_HIDDEN_DONE))
          (global.get $TYPE_RATIONAL) (global.get $FLAG_RATIONAL_INLINE)
          (i32.const 1) (i32.const 0)))
        (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
        (call $write_value (local.get $result_slot)
          (global.get $TYPE_OBJECT) (i32.const 0)
          (local.get $object_pointer) (i32.const 0))
        (call $write_ctx (global.get $CTX_PENDING_POINTER)
          (i32.add (local.get $result_slot) (global.get $VALUE_SIZE)))
        (return (i32.const 0) (local.get $fuel))))

    ;; Match: a full exec result inside {value, done: false}.
    (if (call $check_heap_overflow (call $estimate_object_size (i32.const 2)))
      (then (return (i32.const 2) (local.get $fuel))))
    (local.set $exec_array (call $regexp_exec_materialize
      (local.get $subject_id) (local.get $continuation) (local.get $clone)))
    (if (i32.eqz (local.get $exec_array))
      (then (return (i32.const 2) (local.get $fuel))))
    (local.set $object_pointer (call $allocate_object (i32.const 2)))
    (drop (call $object_set_property
      (local.get $object_pointer)
      (call $read_builtin (global.get $BUILTIN_ITER_VALUE_KEY))
      (global.get $TYPE_ARRAY) (i32.const 0)
      (local.get $exec_array) (i32.const 0)))
    (drop (call $object_set_property
      (local.get $object_pointer)
      (call $read_builtin (global.get $BUILTIN_ITER_DONE_KEY))
      (global.get $TYPE_BOOLEAN) (i32.const 0) (i32.const 0) (i32.const 0)))
    ;; Commit the clone's lastIndex: the match end, plus one scalar for
    ;; an empty match (the spec's AdvanceStringIndex on the iterator).
    (local.set $ms (i32.load (i32.add (local.get $cont_payload)
      (global.get $REGEX_CONT_HEADER_SIZE))))
    (local.set $me (i32.load (i32.add
      (i32.add (local.get $cont_payload) (global.get $REGEX_CONT_HEADER_SIZE))
      (i32.const 4))))
    (local.set $end_scalar (i32.load (i32.add
      (local.get $cont_payload) (global.get $REGEX_CONT_MATCH_END_SCALAR))))
    (if (i32.eq (local.get $ms) (local.get $me))
      (then (local.set $end_scalar (i32.add (local.get $end_scalar) (i32.const 1)))))
    (i32.store
      (call $abs (i32.add (local.get $clone_data) (global.get $REGEXP_LAST_INDEX)))
      (local.get $end_scalar))
    (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
    (call $write_value (local.get $result_slot)
      (global.get $TYPE_OBJECT) (i32.const 0)
      (local.get $object_pointer) (i32.const 0))
    (call $write_ctx (global.get $CTX_PENDING_POINTER)
      (i32.add (local.get $result_slot) (global.get $VALUE_SIZE)))
    (return (i32.const 0) (local.get $fuel))
  )

  ;; ToUint32 of a split limit argument. Absent/undefined -> 2^32-1
  ;; (JS), strings parse numerically, non-numeric non-coercible values
  ;; follow ToNumber(NaN) -> 0. (Objects do not run script valueOf here,
  ;; matching the interpreter's native coercions elsewhere.)
  (func $regexp_split_limit (param $value_pointer i32) (result i32)
    (local $arg_type i32)
    (local $limit_f f64)
    (local.set $arg_type (call $value_type (local.get $value_pointer)))
    (if (i32.eq (local.get $arg_type) (global.get $TYPE_UNDEFINED))
      (then (return (i32.const -1))))
    (if (i32.eq (local.get $arg_type) (global.get $TYPE_NULL))
      (then (return (i32.const 0))))
    (if (i32.eq (local.get $arg_type) (global.get $TYPE_BOOLEAN))
      (then (return (i32.ne (call $value_data_lo (local.get $value_pointer)) (i32.const 0)))))
    (if (i32.eq (local.get $arg_type) (global.get $TYPE_STRING))
      (then
        (local.set $limit_f (call $parse_float
          (call $value_data_lo (local.get $value_pointer)))))
      (else
        (if (call $value_is_numeric (local.get $value_pointer))
          (then (local.set $limit_f (call $value_to_f64 (local.get $value_pointer))))
          (else (return (i32.const 0))))))
    ;; ToUint32: NaN saturates to 0 through trunc_sat; the i64 wrap
    ;; yields the spec's mod-2^32 for every |value| below 2^63.
    (i32.wrap_i64 (i64.trunc_sat_f64_s (local.get $limit_f)))
  )

  ;; Find a named capture's group index in the retained program's name
  ;; records ([group:4][byteLength:4][utf8], unaligned stride). Returns
  ;; the group index, or -1 when the name is absent.
  (func $regexp_named_group_find
    (param $program i32) (param $name_abs i32) (param $name_len i32)
    (result i32)
    (local $prog_payload i32)
    (local $name_bytes i32)
    (local $names_base i32)
    (local $walk i32)
    (local $record_len i32)
    (local $j i32)
    (local $mismatch i32)
    (local.set $prog_payload (i32.add (call $abs (local.get $program)) (i32.const 4)))
    (local.set $name_bytes
      (i32.load (i32.add (local.get $prog_payload) (global.get $REGEX_PROGRAM_NAME_BYTES))))
    (local.set $names_base (i32.add
      (i32.add (local.get $prog_payload) (global.get $REGEX_PROGRAM_HEADER_SIZE))
      (i32.add
        (i32.mul
          (i32.load (i32.add (local.get $prog_payload) (global.get $REGEX_PROGRAM_INSTRUCTION_COUNT)))
          (global.get $REGEX_PROGRAM_INSTRUCTION_SIZE))
        (i32.mul
          (i32.load (i32.add (local.get $prog_payload) (global.get $REGEX_PROGRAM_RANGE_COUNT)))
          (i32.const 8)))))
    (block $done
      (loop $scan
        (br_if $done (i32.ge_u (local.get $walk) (local.get $name_bytes)))
        (local.set $record_len (i32.load (i32.add
          (i32.add (local.get $names_base) (local.get $walk))
          (i32.const 4))))
        (if (i32.eq (local.get $record_len) (local.get $name_len))
          (then
            (local.set $mismatch (i32.const 0))
            (local.set $j (i32.const 0))
            (block $cmp_done
              (loop $cmp
                (br_if $cmp_done (i32.ge_u (local.get $j) (local.get $name_len)))
                (if (i32.ne
                      (i32.load8_u (i32.add
                        (i32.add (i32.add (local.get $names_base) (local.get $walk)) (i32.const 8))
                        (local.get $j)))
                      (i32.load8_u (i32.add (local.get $name_abs) (local.get $j))))
                  (then
                    (local.set $mismatch (i32.const 1))
                    (br $cmp_done)))
                (local.set $j (i32.add (local.get $j) (i32.const 1)))
                (br $cmp)))
            (if (i32.eqz (local.get $mismatch))
              (then (return (i32.load
                (i32.add (local.get $names_base) (local.get $walk))))))))
        (local.set $walk (i32.add (local.get $walk)
          (i32.add (i32.const 8) (local.get $record_len))))
        (br $scan)))
    (i32.const -1)
  )

  ;; Token-expand a replacement string against the current match (JS
  ;; GetSubstitution: $$ $& $` $' $1-$99 $<name>; invalid forms stay
  ;; literal; unset captures and unknown names in a named pattern expand
  ;; empty; $<...> in a pattern WITHOUT named groups is literal). Write
  ;; pass when $dest_abs is non-zero, measuring pass otherwise; returns
  ;; the expanded byte count. Neither pass allocates.
  (func $regexp_expand_replacement
    (param $repl_id i32) (param $subject_id i32)
    (param $continuation i32) (param $program i32)
    (param $dest_abs i32)
    (result i32)
    (local $repl_abs i32)
    (local $repl_len i32)
    (local $subject_abs i32)
    (local $subject_len i32)
    (local $cont_payload i32)
    (local $ncaps i32)
    (local $has_names i32)
    (local $ms i32)
    (local $me i32)
    (local $i i32)
    (local $out i32)
    (local $b i32)
    (local $b2 i32)
    (local $n i32)
    (local $gt i32)
    (local $group i32)
    (local $span_start i32)
    (local $span_end i32)
    (local $piece_len i32)
    (local.set $repl_abs
      (i32.add (call $string_id_to_abs (local.get $repl_id)) (i32.const 4)))
    (local.set $repl_len
      (i32.load (call $string_id_to_abs (local.get $repl_id))))
    (local.set $subject_abs (call $string_id_to_abs (local.get $subject_id)))
    (local.set $subject_len (i32.load (local.get $subject_abs)))
    (local.set $subject_abs (i32.add (local.get $subject_abs) (i32.const 4)))
    (local.set $cont_payload
      (i32.add (call $abs (local.get $continuation)) (i32.const 4)))
    (local.set $ncaps (i32.load (i32.add
      (local.get $cont_payload) (global.get $REGEX_CONT_CAPTURE_GROUP_COUNT))))
    (local.set $has_names (i32.ne
      (i32.load (i32.add
        (i32.add (call $abs (local.get $program)) (i32.const 4))
        (global.get $REGEX_PROGRAM_NAME_BYTES)))
      (i32.const 0)))
    (local.set $ms (i32.load (i32.add
      (local.get $cont_payload) (global.get $REGEX_CONT_HEADER_SIZE))))
    (local.set $me (i32.load (i32.add
      (i32.add (local.get $cont_payload) (global.get $REGEX_CONT_HEADER_SIZE))
      (i32.const 4))))
    (block $scan_done
      (loop $scan
        (br_if $scan_done (i32.ge_u (local.get $i) (local.get $repl_len)))
        (local.set $b (i32.load8_u (i32.add (local.get $repl_abs) (local.get $i))))
        (if (i32.or
              (i32.ne (local.get $b) (i32.const 0x24))  ;; '$'
              (i32.ge_u (i32.add (local.get $i) (i32.const 1)) (local.get $repl_len)))
          (then
            ;; Literal byte (including a trailing lone '$').
            (if (local.get $dest_abs)
              (then (i32.store8
                (i32.add (local.get $dest_abs) (local.get $out))
                (local.get $b))))
            (local.set $out (i32.add (local.get $out) (i32.const 1)))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $scan)))
        (local.set $b2 (i32.load8_u (i32.add
          (local.get $repl_abs) (i32.add (local.get $i) (i32.const 1)))))
        ;; $$ -> one dollar
        (if (i32.eq (local.get $b2) (i32.const 0x24))
          (then
            (if (local.get $dest_abs)
              (then (i32.store8
                (i32.add (local.get $dest_abs) (local.get $out))
                (i32.const 0x24))))
            (local.set $out (i32.add (local.get $out) (i32.const 1)))
            (local.set $i (i32.add (local.get $i) (i32.const 2)))
            (br $scan)))
        ;; $& / $` / $' -> whole match, prefix, suffix
        (if (i32.or
              (i32.eq (local.get $b2) (i32.const 0x26))   ;; '&'
              (i32.or
                (i32.eq (local.get $b2) (i32.const 0x60))  ;; '`'
                (i32.eq (local.get $b2) (i32.const 0x27)))) ;; '\''
          (then
            (if (i32.eq (local.get $b2) (i32.const 0x26))
              (then
                (local.set $span_start (local.get $ms))
                (local.set $span_end (local.get $me))))
            (if (i32.eq (local.get $b2) (i32.const 0x60))
              (then
                (local.set $span_start (i32.const 0))
                (local.set $span_end (local.get $ms))))
            (if (i32.eq (local.get $b2) (i32.const 0x27))
              (then
                (local.set $span_start (local.get $me))
                (local.set $span_end (local.get $subject_len))))
            (local.set $piece_len (i32.sub (local.get $span_end) (local.get $span_start)))
            (if (local.get $dest_abs)
              (then (memory.copy
                (i32.add (local.get $dest_abs) (local.get $out))
                (i32.add (local.get $subject_abs) (local.get $span_start))
                (local.get $piece_len))))
            (local.set $out (i32.add (local.get $out) (local.get $piece_len)))
            (local.set $i (i32.add (local.get $i) (i32.const 2)))
            (br $scan)))
        ;; $<name> -> named capture (literal when the pattern has none)
        (if (i32.and
              (i32.eq (local.get $b2) (i32.const 0x3C))  ;; '<'
              (local.get $has_names))
          (then
            (local.set $gt (i32.add (local.get $i) (i32.const 2)))
            (block $gt_done
              (loop $find_gt
                (br_if $gt_done (i32.ge_u (local.get $gt) (local.get $repl_len)))
                (br_if $gt_done (i32.eq
                  (i32.load8_u (i32.add (local.get $repl_abs) (local.get $gt)))
                  (i32.const 0x3E)))  ;; '>'
                (local.set $gt (i32.add (local.get $gt) (i32.const 1)))
                (br $find_gt)))
            (if (i32.lt_u (local.get $gt) (local.get $repl_len))
              (then
                (local.set $group (call $regexp_named_group_find
                  (local.get $program)
                  (i32.add (local.get $repl_abs) (i32.add (local.get $i) (i32.const 2)))
                  (i32.sub (local.get $gt) (i32.add (local.get $i) (i32.const 2)))))
                (if (i32.ge_s (local.get $group) (i32.const 0))
                  (then
                    (local.set $span_start (i32.load (i32.add
                      (i32.add (local.get $cont_payload) (global.get $REGEX_CONT_HEADER_SIZE))
                      (i32.shl (local.get $group) (i32.const 3)))))
                    (local.set $span_end (i32.load (i32.add
                      (i32.add
                        (i32.add (local.get $cont_payload) (global.get $REGEX_CONT_HEADER_SIZE))
                        (i32.shl (local.get $group) (i32.const 3)))
                      (i32.const 4))))
                    (if (i32.and
                          (i32.ne (local.get $span_start) (global.get $REGEX_CONT_NO_POSITION))
                          (i32.ne (local.get $span_end) (global.get $REGEX_CONT_NO_POSITION)))
                      (then
                        (local.set $piece_len
                          (i32.sub (local.get $span_end) (local.get $span_start)))
                        (if (local.get $dest_abs)
                          (then (memory.copy
                            (i32.add (local.get $dest_abs) (local.get $out))
                            (i32.add (local.get $subject_abs) (local.get $span_start))
                            (local.get $piece_len))))
                        (local.set $out (i32.add (local.get $out) (local.get $piece_len)))))))
                ;; Unknown name or unset capture: expands empty.
                (local.set $i (i32.add (local.get $gt) (i32.const 1)))
                (br $scan)))
            ;; No closing '>': literal fallthrough below.
            ))
        ;; $1 - $99 -> numbered capture (two digits win when valid)
        (if (i32.and
              (i32.ge_u (local.get $b2) (i32.const 0x30))
              (i32.le_u (local.get $b2) (i32.const 0x39)))
          (then
            (local.set $n (i32.sub (local.get $b2) (i32.const 0x30)))
            (local.set $group (i32.const -1))
            (local.set $piece_len (i32.const 2))  ;; token length
            (if (i32.lt_u (i32.add (local.get $i) (i32.const 2)) (local.get $repl_len))
              (then
                (local.set $b (i32.load8_u (i32.add
                  (local.get $repl_abs) (i32.add (local.get $i) (i32.const 2)))))
                (if (i32.and
                      (i32.ge_u (local.get $b) (i32.const 0x30))
                      (i32.le_u (local.get $b) (i32.const 0x39)))
                  (then
                    (local.set $b (i32.add
                      (i32.mul (local.get $n) (i32.const 10))
                      (i32.sub (local.get $b) (i32.const 0x30))))
                    (if (i32.and
                          (i32.ge_u (local.get $b) (i32.const 1))
                          (i32.le_u (local.get $b) (local.get $ncaps)))
                      (then
                        (local.set $group (local.get $b))
                        (local.set $piece_len (i32.const 3))))))))
            (if (i32.and
                  (i32.lt_s (local.get $group) (i32.const 0))
                  (i32.and
                    (i32.ge_u (local.get $n) (i32.const 1))
                    (i32.le_u (local.get $n) (local.get $ncaps))))
              (then (local.set $group (local.get $n))))
            (if (i32.ge_s (local.get $group) (i32.const 0))
              (then
                (local.set $span_start (i32.load (i32.add
                  (i32.add (local.get $cont_payload) (global.get $REGEX_CONT_HEADER_SIZE))
                  (i32.shl (local.get $group) (i32.const 3)))))
                (local.set $span_end (i32.load (i32.add
                  (i32.add
                    (i32.add (local.get $cont_payload) (global.get $REGEX_CONT_HEADER_SIZE))
                    (i32.shl (local.get $group) (i32.const 3)))
                  (i32.const 4))))
                (if (i32.and
                      (i32.ne (local.get $span_start) (global.get $REGEX_CONT_NO_POSITION))
                      (i32.ne (local.get $span_end) (global.get $REGEX_CONT_NO_POSITION)))
                  (then
                    (local.set $n (i32.sub (local.get $span_end) (local.get $span_start)))
                    (if (local.get $dest_abs)
                      (then (memory.copy
                        (i32.add (local.get $dest_abs) (local.get $out))
                        (i32.add (local.get $subject_abs) (local.get $span_start))
                        (local.get $n))))
                    (local.set $out (i32.add (local.get $out) (local.get $n)))))
                (local.set $i (i32.add (local.get $i) (local.get $piece_len)))
                (br $scan)))))
        ;; Any other $x: the dollar is literal.
        (if (local.get $dest_abs)
          (then (i32.store8
            (i32.add (local.get $dest_abs) (local.get $out))
            (i32.const 0x24))))
        (local.set $out (i32.add (local.get $out) (i32.const 1)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $scan)))
    (local.get $out)
  )

  ;; Ensure the replace output buffer accepts $extra more bytes. The
  ;; buffer's first twelve content bytes are the operation header
  ;; [used:4][p:4][reserved:4]. Growth reallocates, copies, and swaps
  ;; state slot 2; the old buffer stays intact until the swap so a
  ;; pressure retry re-runs safely. Returns the (possibly new) buffer,
  ;; or 0 on memory pressure.
  (func $regexp_out_ensure
    (param $state_handle i32) (param $output i32) (param $extra i32)
    (result i32)
    (local $capacity i32)
    (local $used i32)
    (local $need i32)
    (local $new_capacity i32)
    (local $new_output i32)
    (local.set $capacity
      (i32.sub (i32.load (call $abs (local.get $output))) (i32.const 12)))
    (local.set $used
      (i32.load (i32.add (call $abs (local.get $output)) (i32.const 4))))
    (local.set $need (i32.add (local.get $used) (local.get $extra)))
    (if (i32.le_u (local.get $need) (local.get $capacity))
      (then (return (local.get $output))))
    (local.set $new_capacity (local.get $capacity))
    (block $sized
      (loop $double
        (br_if $sized (i32.ge_u (local.get $new_capacity) (local.get $need)))
        (local.set $new_capacity (i32.shl (local.get $new_capacity) (i32.const 1)))
        (br $double)))
    (if (call $check_heap_overflow (call $estimate_arraybuffer_size
          (i32.add (local.get $new_capacity) (i32.const 12))))
      (then (return (i32.const 0))))
    (local.set $new_output (call $allocate_arraybuffer
      (i32.add (local.get $new_capacity) (i32.const 12))))
    (memory.copy
      (i32.add (call $abs (local.get $new_output)) (i32.const 4))
      (i32.add (call $abs (local.get $output)) (i32.const 4))
      (i32.add (local.get $used) (i32.const 12)))
    (call $native_continuation_state_set
      (local.get $state_handle) (i32.const 2) (local.get $new_output))
    (local.get $new_output)
  )

  ;; One fuel grant of "str".split(re, limit): the epic's split loop —
  ;; unanchored leftmost scans emulate the spec's sticky-clone probe
  ;; sequence exactly (a sticky ORIGINAL probes position by position);
  ;; an accepted match pushes the preceding segment plus every capture,
  ;; empty matches at the previous end skip forward one scalar, matches
  ;; starting at the end of input never split, and lastIndex is never
  ;; touched. The ToUint32 limit caps every push.
  (func $regexp_string_split_step
    (param $subject_id i32) (param $result_slot i32)
    (param $argc i32) (param $args_base i32)
    (param $entry_pending_pointer i32) (param $fuel i32)
    (result i32 i32)
    (local $descriptor i32)
    (local $program i32)
    (local $flags_word i32)
    (local $sticky i32)
    (local $limit i32)
    (local $state_handle i32)
    (local $state0 i32)
    (local $phase i32)
    (local $match_status i32)
    (local $continuation i32)
    (local $result_array i32)
    (local $p i32)
    (local $q i32)
    (local $cont_bytes i32)
    (local $status i32)
    (local $cont_payload i32)
    (local $subject_abs i32)
    (local $subject_len i32)
    (local $ms i32)
    (local $me i32)
    (local $sid i32)
    (local $ncaps i32)
    (local $cap_index i32)
    (local $cap_start i32)
    (local $cap_end i32)
    (local $arr_len i32)
    (local $arr_cap i32)
    (local $q_next i32)
    (local $q_scalar i32)

    (call $write_ctx (global.get $CTX_PENDING_POINTER)
      (local.get $entry_pending_pointer))
    ;; The dispatch arm guarantees a RegExp first argument.
    (local.set $descriptor (call $value_data_lo (local.get $args_base)))
    (local.set $program (i32.load (call $abs (i32.add
      (i32.add (local.get $descriptor) (global.get $GC_HEADER_SIZE))
      (global.get $REGEXP_PROGRAM_BUFFER)))))
    (if (i32.eqz (local.get $program))
      (then
        (call $fault_error (global.get $ERR_CORRUPT_OPERAND)
          (i32.const 0) (global.get $current_executing_pc))
        (return (i32.const 3) (local.get $fuel))))
    (local.set $flags_word (i32.load (call $abs (i32.add
      (i32.add (local.get $descriptor) (global.get $GC_HEADER_SIZE))
      (global.get $REGEXP_FLAGS)))))
    (local.set $sticky
      (i32.and (local.get $flags_word) (global.get $REGEXP_FLAG_STICKY)))
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then (local.set $limit (call $regexp_split_limit
        (i32.add (local.get $args_base) (global.get $VALUE_SIZE)))))
      (else (local.set $limit (i32.const -1))))
    (local.set $subject_abs (call $string_id_to_abs (local.get $subject_id)))
    (local.set $subject_len (i32.load (local.get $subject_abs)))
    (local.set $subject_abs (i32.add (local.get $subject_abs) (i32.const 4)))

    (local.set $state_handle (call $read_ctx (global.get $CTX_REGEX_STATE)))
    (if (i32.eq (local.get $state_handle) (i32.const 0))
      (then
        ;; limit 0: the empty array, no matching at all (JS).
        (if (i32.eqz (local.get $limit))
          (then
            (if (call $check_heap_overflow (call $estimate_array_size (i32.const 4)))
              (then (return (i32.const 2) (local.get $fuel))))
            (local.set $result_array (call $allocate_array (i32.const 4)))
            (i32.store (call $abs (i32.add (local.get $result_array) (i32.const 8)))
              (i32.const 0))
            (call $write_value (local.get $result_slot)
              (global.get $TYPE_ARRAY) (i32.const 0)
              (local.get $result_array) (i32.const 0))
            (call $write_ctx (global.get $CTX_PENDING_POINTER)
              (i32.add (local.get $result_slot) (global.get $VALUE_SIZE)))
            (return (i32.const 0) (local.get $fuel))))
        (local.set $cont_bytes (call $regexp_continuation_bytes (local.get $program)))
        (if (i32.eq (local.get $cont_bytes) (i32.const -1))
          (then
            (call $fault_error (global.get $ERR_CORRUPT_OPERAND)
              (i32.const 1) (global.get $current_executing_pc))
            (return (i32.const 3) (local.get $fuel))))
        (if (call $check_heap_overflow (i32.add
              (i32.add
                (call $estimate_arraybuffer_size (local.get $cont_bytes))
                (call $estimate_array_size (i32.const 4)))
              (global.get $NATIVE_CONTINUATION_STATE_SIZE)))
          (then (return (i32.const 2) (local.get $fuel))))
        (local.set $continuation (call $allocate_arraybuffer (local.get $cont_bytes)))
        (local.set $result_array (call $allocate_array (i32.const 4)))
        (i32.store (call $abs (i32.add (local.get $result_array) (i32.const 8)))
          (i32.const 0))
        (local.set $status (call $regexp_init_attempt
          (local.get $program) (local.get $continuation)
          (local.get $subject_id) (i32.const 0) (i32.const 0)))
        (if (i32.ne (local.get $status) (global.get $REGEX_STATUS_OK))
          (then
            (call $fault_error (global.get $ERR_CORRUPT_OPERAND)
              (local.get $status) (global.get $current_executing_pc))
            (return (i32.const 3) (local.get $fuel))))
        ;; state: [phase|status<<8, cont(data), array(header), p, q]
        (local.set $state_handle (call $allocate_native_continuation_state
          (i32.const 4) (i32.const 2)
          (i32.const 6) (local.get $continuation)
          (local.get $result_array) (i32.const 0) (i32.const 0)))
        (call $write_ctx (global.get $CTX_REGEX_STATE) (local.get $state_handle))
        (local.set $state0 (i32.const 6))
        (local.set $p (i32.const 0))
        (local.set $q (i32.const 0)))
      (else
        (local.set $state0
          (call $native_continuation_state_get (local.get $state_handle) (i32.const 0)))
        (local.set $continuation
          (call $native_continuation_state_get (local.get $state_handle) (i32.const 1)))
        (local.set $result_array
          (call $native_continuation_state_get (local.get $state_handle) (i32.const 2)))
        (local.set $p
          (call $native_continuation_state_get (local.get $state_handle) (i32.const 3)))
        (local.set $q
          (call $native_continuation_state_get (local.get $state_handle) (i32.const 4)))
        (if (i32.or
              (i32.or
                (i32.lt_u (i32.and (local.get $state0) (i32.const 0x3F)) (i32.const 6))
                (i32.gt_u (i32.and (local.get $state0) (i32.const 0x3F)) (i32.const 10)))
              (i32.or
                (i32.eqz (local.get $continuation))
                (i32.eqz (local.get $result_array))))
          (then
            (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
            (call $fault_error (global.get $ERR_CORRUPT_OPERAND)
              (local.get $state0) (global.get $current_executing_pc))
            (return (i32.const 3) (local.get $fuel))))))

    (local.set $phase (i32.and (local.get $state0) (i32.const 0x3F)))
    (local.set $match_status (i32.shr_u (local.get $state0) (i32.const 8)))
    (local.set $cont_payload
      (i32.add (call $abs (local.get $continuation)) (i32.const 4)))
    (local.set $ncaps (i32.load (i32.add
      (local.get $cont_payload) (global.get $REGEX_CONT_CAPTURE_GROUP_COUNT))))

    (block $commit
      (block $tail
        (loop $drive
          (if (i32.eq (local.get $phase) (i32.const 9)) (then (br $tail)))
          (if (i32.eq (local.get $phase) (i32.const 10)) (then (br $commit)))
          (if (i32.eq (local.get $phase) (i32.const 6))
            (then
              (call $regexp_run_attempt
                (local.get $program) (local.get $continuation)
                (local.get $subject_id) (local.get $fuel))
              (local.set $fuel)
              (local.set $status)
              (local.set $cont_payload
                (i32.add (call $abs (local.get $continuation)) (i32.const 4)))
              (if (i32.eq (local.get $status) (global.get $REGEX_STATUS_PAUSED))
                (then (return (i32.const 1) (local.get $fuel))))
              (if (i32.and
                    (i32.ne (local.get $status) (global.get $REGEX_STATUS_MATCH))
                    (i32.ne (local.get $status) (global.get $REGEX_STATUS_NO_MATCH)))
                (then
                  (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
                  (call $fault_error (global.get $ERR_CORRUPT_OPERAND)
                    (local.get $status) (global.get $current_executing_pc))
                  (return (i32.const 3) (local.get $fuel))))
              (local.set $match_status (local.get $status))
              (local.set $phase (i32.const 7))
              (local.set $state0 (i32.or (i32.const 7)
                (i32.shl (local.get $match_status) (i32.const 8))))
              (call $native_continuation_state_set
                (local.get $state_handle) (i32.const 0) (local.get $state0))))

          ;; Phase 7: consume one attempt's outcome.
          (if (i32.eq (local.get $match_status) (global.get $REGEX_STATUS_NO_MATCH))
            (then
              ;; A sticky separator probes forward one scalar at a time;
              ;; an unanchored scan already searched the rest.
              (if (i32.and
                    (i32.ne (local.get $sticky) (i32.const 0))
                    (i32.lt_u (local.get $q) (local.get $subject_len)))
                (then
                  (local.set $q_next (i32.add (local.get $q)
                    (call $regexp_scalar_len_at
                      (local.get $subject_abs) (local.get $q))))
                  (if (i32.lt_u (local.get $q_next) (local.get $subject_len))
                    (then
                      (local.set $q (local.get $q_next))
                      (call $native_continuation_state_set
                        (local.get $state_handle) (i32.const 4) (local.get $q))
                      (local.set $status (call $regexp_init_attempt
                        (local.get $program) (local.get $continuation)
                        (local.get $subject_id) (local.get $q)
                        (call $utf8_byte_offset_to_char_index
                          (local.get $subject_id) (local.get $q))))
                      (if (i32.ne (local.get $status) (global.get $REGEX_STATUS_OK))
                        (then
                          (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
                          (call $fault_error (global.get $ERR_CORRUPT_OPERAND)
                            (local.get $status) (global.get $current_executing_pc))
                          (return (i32.const 3) (local.get $fuel))))
                      (local.set $phase (i32.const 6))
                      (local.set $state0 (i32.const 6))
                      (call $native_continuation_state_set
                        (local.get $state_handle) (i32.const 0) (local.get $state0))
                      (br $drive))
                    (else
                      (local.set $phase (i32.const 9))
                      (local.set $state0 (i32.const 9))
                      (call $native_continuation_state_set
                        (local.get $state_handle) (i32.const 0) (local.get $state0))
                      (br $tail))))
                (else
                  (local.set $phase (i32.const 9))
                  (local.set $state0 (i32.const 9))
                  (call $native_continuation_state_set
                    (local.get $state_handle) (i32.const 0) (local.get $state0))
                  (br $tail)))))

          ;; A match. Matches starting at the end of input never split
          ;; (the spec probes positions strictly below the size); the
          ;; empty subject's single probe returns [] on ANY match.
          (local.set $ms (i32.load (i32.add (local.get $cont_payload)
            (global.get $REGEX_CONT_HEADER_SIZE))))
          (local.set $me (i32.load (i32.add
            (i32.add (local.get $cont_payload) (global.get $REGEX_CONT_HEADER_SIZE))
            (i32.const 4))))
          (if (i32.ge_u (local.get $ms) (local.get $subject_len))
            (then
              (if (i32.eqz (local.get $subject_len))
                (then
                  (local.set $phase (i32.const 10))
                  (local.set $state0 (i32.const 10))
                  (call $native_continuation_state_set
                    (local.get $state_handle) (i32.const 0) (local.get $state0))
                  (br $commit))
                (else
                  (local.set $phase (i32.const 9))
                  (local.set $state0 (i32.const 9))
                  (call $native_continuation_state_set
                    (local.get $state_handle) (i32.const 0) (local.get $state0))
                  (br $tail)))))
          (if (i32.eq (local.get $me) (local.get $p))
            (then
              ;; Empty progress guard (e == p): skip one scalar past the
              ;; found position.
              (local.set $q_next (i32.add (local.get $ms)
                (call $regexp_scalar_len_at
                  (local.get $subject_abs) (local.get $ms))))
              (if (i32.ge_u (local.get $q_next) (local.get $subject_len))
                (then
                  (local.set $phase (i32.const 9))
                  (local.set $state0 (i32.const 9))
                  (call $native_continuation_state_set
                    (local.get $state_handle) (i32.const 0) (local.get $state0))
                  (br $tail)))
              (local.set $q (local.get $q_next))
              (call $native_continuation_state_set
                (local.get $state_handle) (i32.const 4) (local.get $q))
              (local.set $status (call $regexp_init_attempt
                (local.get $program) (local.get $continuation)
                (local.get $subject_id) (local.get $q)
                (call $utf8_byte_offset_to_char_index
                  (local.get $subject_id) (local.get $q))))
              (if (i32.ne (local.get $status) (global.get $REGEX_STATUS_OK))
                (then
                  (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
                  (call $fault_error (global.get $ERR_CORRUPT_OPERAND)
                    (local.get $status) (global.get $current_executing_pc))
                  (return (i32.const 3) (local.get $fuel))))
              (local.set $phase (i32.const 6))
              (local.set $state0 (i32.const 6))
              (call $native_continuation_state_set
                (local.get $state_handle) (i32.const 0) (local.get $state0))
              (br $drive)))

          ;; Accept: pass A interns everything (pure, retryable), then
          ;; one growth gate covers every push, then pass B re-interns
          ;; (guaranteed table hits) and pushes without failure points.
          (drop (call $intern_string
            (i32.add (local.get $subject_abs) (local.get $p))
            (i32.sub (local.get $ms) (local.get $p))))
          (if (i32.eqz (call $intern_string
                (i32.add (local.get $subject_abs) (local.get $p))
                (i32.sub (local.get $ms) (local.get $p))))
            (then (return (i32.const 2) (local.get $fuel))))
          (local.set $cap_index (i32.const 1))
          (block $interned
            (loop $intern_caps
              (br_if $interned (i32.gt_u (local.get $cap_index) (local.get $ncaps)))
              (local.set $cap_start (i32.load (i32.add
                (i32.add (local.get $cont_payload) (global.get $REGEX_CONT_HEADER_SIZE))
                (i32.shl (local.get $cap_index) (i32.const 3)))))
              (local.set $cap_end (i32.load (i32.add
                (i32.add
                  (i32.add (local.get $cont_payload) (global.get $REGEX_CONT_HEADER_SIZE))
                  (i32.shl (local.get $cap_index) (i32.const 3)))
                (i32.const 4))))
              (if (i32.and
                    (i32.ne (local.get $cap_start) (global.get $REGEX_CONT_NO_POSITION))
                    (i32.ne (local.get $cap_end) (global.get $REGEX_CONT_NO_POSITION)))
                (then
                  (if (i32.eqz (call $intern_string
                        (i32.add (local.get $subject_abs) (local.get $cap_start))
                        (i32.sub (local.get $cap_end) (local.get $cap_start))))
                    (then (return (i32.const 2) (local.get $fuel))))))
              (local.set $cap_index (i32.add (local.get $cap_index) (i32.const 1)))
              (br $intern_caps)))
          (local.set $arr_len (i32.load (call $abs
            (i32.add (local.get $result_array) (i32.const 8)))))
          (local.set $arr_cap (i32.load (call $abs
            (i32.add (local.get $result_array) (i32.const 12)))))
          (if (i32.gt_u
                (i32.add (i32.add (local.get $arr_len) (i32.const 1)) (local.get $ncaps))
                (local.get $arr_cap))
            (then
              (if (call $check_heap_overflow (call $estimate_array_push_budget
                    (local.get $arr_cap)
                    (i32.add (i32.add (local.get $arr_len) (i32.const 1)) (local.get $ncaps))))
                (then (return (i32.const 2) (local.get $fuel))))))
          ;; Pass B.
          (local.set $sid (call $intern_string
            (i32.add (local.get $subject_abs) (local.get $p))
            (i32.sub (local.get $ms) (local.get $p))))
          (drop (call $array_push_value
            (local.get $result_array)
            (global.get $TYPE_STRING) (i32.const 0) (local.get $sid) (i32.const 0)))
          (if (i32.eq (i32.load (call $abs (i32.add (local.get $result_array) (i32.const 8))))
                (local.get $limit))
            (then
              (local.set $phase (i32.const 10))
              (local.set $state0 (i32.const 10))
              (call $native_continuation_state_set
                (local.get $state_handle) (i32.const 0) (local.get $state0))
              (br $commit)))
          (local.set $cap_index (i32.const 1))
          (block $pushed
            (loop $push_caps
              (br_if $pushed (i32.gt_u (local.get $cap_index) (local.get $ncaps)))
              (local.set $cap_start (i32.load (i32.add
                (i32.add (local.get $cont_payload) (global.get $REGEX_CONT_HEADER_SIZE))
                (i32.shl (local.get $cap_index) (i32.const 3)))))
              (local.set $cap_end (i32.load (i32.add
                (i32.add
                  (i32.add (local.get $cont_payload) (global.get $REGEX_CONT_HEADER_SIZE))
                  (i32.shl (local.get $cap_index) (i32.const 3)))
                (i32.const 4))))
              (if (i32.and
                    (i32.ne (local.get $cap_start) (global.get $REGEX_CONT_NO_POSITION))
                    (i32.ne (local.get $cap_end) (global.get $REGEX_CONT_NO_POSITION)))
                (then
                  (local.set $sid (call $intern_string
                    (i32.add (local.get $subject_abs) (local.get $cap_start))
                    (i32.sub (local.get $cap_end) (local.get $cap_start))))
                  (drop (call $array_push_value
                    (local.get $result_array)
                    (global.get $TYPE_STRING) (i32.const 0) (local.get $sid) (i32.const 0))))
                (else
                  (drop (call $array_push_value
                    (local.get $result_array)
                    (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0)))))
              (if (i32.eq
                    (i32.load (call $abs (i32.add (local.get $result_array) (i32.const 8))))
                    (local.get $limit))
                (then
                  (local.set $phase (i32.const 10))
                  (local.set $state0 (i32.const 10))
                  (call $native_continuation_state_set
                    (local.get $state_handle) (i32.const 0) (local.get $state0))
                  (br $commit)))
              (local.set $cap_index (i32.add (local.get $cap_index) (i32.const 1)))
              (br $push_caps)))
          ;; p = q = e; a probe at the very end never runs.
          (local.set $p (local.get $me))
          (local.set $q (local.get $me))
          (call $native_continuation_state_set
            (local.get $state_handle) (i32.const 3) (local.get $p))
          (call $native_continuation_state_set
            (local.get $state_handle) (i32.const 4) (local.get $q))
          (if (i32.ge_u (local.get $q) (local.get $subject_len))
            (then
              (local.set $phase (i32.const 9))
              (local.set $state0 (i32.const 9))
              (call $native_continuation_state_set
                (local.get $state_handle) (i32.const 0) (local.get $state0))
              (br $tail)))
          (local.set $status (call $regexp_init_attempt
            (local.get $program) (local.get $continuation)
            (local.get $subject_id) (local.get $q)
            (i32.load (i32.add
              (local.get $cont_payload) (global.get $REGEX_CONT_MATCH_END_SCALAR)))))
          (if (i32.ne (local.get $status) (global.get $REGEX_STATUS_OK))
            (then
              (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
              (call $fault_error (global.get $ERR_CORRUPT_OPERAND)
                (local.get $status) (global.get $current_executing_pc))
              (return (i32.const 3) (local.get $fuel))))
          (local.set $phase (i32.const 6))
          (local.set $state0 (i32.const 6))
          (call $native_continuation_state_set
            (local.get $state_handle) (i32.const 0) (local.get $state0))
          (br $drive)))

      ;; Phase 9: the unconditional final segment (limit permitting).
      (if (i32.lt_u
            (i32.load (call $abs (i32.add (local.get $result_array) (i32.const 8))))
            (local.get $limit))
        (then
          (local.set $sid (call $intern_string
            (i32.add (local.get $subject_abs) (local.get $p))
            (i32.sub (local.get $subject_len) (local.get $p))))
          (if (i32.eqz (local.get $sid))
            (then (return (i32.const 2) (local.get $fuel))))
          (local.set $arr_len (i32.load (call $abs
            (i32.add (local.get $result_array) (i32.const 8)))))
          (local.set $arr_cap (i32.load (call $abs
            (i32.add (local.get $result_array) (i32.const 12)))))
          (if (i32.gt_u (i32.add (local.get $arr_len) (i32.const 1)) (local.get $arr_cap))
            (then
              (if (call $check_heap_overflow (call $estimate_array_push_budget
                    (local.get $arr_cap) (i32.add (local.get $arr_len) (i32.const 1))))
                (then (return (i32.const 2) (local.get $fuel))))))
          (drop (call $array_push_value
            (local.get $result_array)
            (global.get $TYPE_STRING) (i32.const 0) (local.get $sid) (i32.const 0)))))
      (local.set $state0 (i32.const 10))
      (call $native_continuation_state_set
        (local.get $state_handle) (i32.const 0) (local.get $state0)))

    ;; Phase 10: commit. lastIndex is never touched by split.
    (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
    (call $write_value (local.get $result_slot)
      (global.get $TYPE_ARRAY) (i32.const 0)
      (local.get $result_array) (i32.const 0))
    (call $write_ctx (global.get $CTX_PENDING_POINTER)
      (i32.add (local.get $result_slot) (global.get $VALUE_SIZE)))
    (return (i32.const 0) (local.get $fuel))
  )

  ;; One fuel grant of "str".replace(re, replacement) or
  ;; "str".replaceAll(re, replacement) with a RegExp first argument.
  ;; String replacements token-expand (JS GetSubstitution); function
  ;; replacements stage one callback per match through a
  ;; CONTINUATION_KIND_REGEXP_REPLACE frame — the frame carries this
  ;; operation's state object while the callback runs, the OP_RETURN
  ;; handler harvests the result into the op-root array, restores the
  ;; CALL operand window, and re-arms this step at phase 8. Output
  ;; accumulates in a growable byte buffer whose content header is
  ;; [used:4][p:4][reserved:4]; one interning at phase 10 commits the
  ;; result together with lastIndex (g: 0; sticky non-global: match end
  ;; or 0; otherwise untouched).
  ;;
  ;; state: [phase|matched<<5|method<<16, cont(data), out(data),
  ;;         opRoot(header)|0, 0]
  ;; opRoot: [subject, regexp, callback, harvest, argc]
  (func $regexp_string_replace_step
    (param $subject_id i32) (param $method_id i32) (param $result_slot i32)
    (param $argc i32) (param $args_base i32)
    (param $entry_pending_pointer i32) (param $fuel i32)
    (result i32 i32)
    (local $descriptor i32)
    (local $descriptor_data i32)
    (local $program i32)
    (local $flags_word i32)
    (local $g i32)
    (local $y i32)
    (local $functional i32)
    (local $repl_slot i32)
    (local $repl_id i32)
    (local $state_handle i32)
    (local $state0 i32)
    (local $phase i32)
    (local $matched i32)
    (local $continuation i32)
    (local $output i32)
    (local $op_root i32)
    (local $root_data i32)
    (local $cont_bytes i32)
    (local $status i32)
    (local $cont_payload i32)
    (local $subject_abs i32)
    (local $subject_len i32)
    (local $start_scalar i32)
    (local $start_byte i32)
    (local $ms i32)
    (local $me i32)
    (local $used i32)
    (local $p i32)
    (local $total i32)
    (local $out_content i32)
    (local $origin i32)
    (local $origin_scalar i32)
    (local $ncaps i32)
    (local $named_count i32)
    (local $name_bytes i32)
    (local $names_base i32)
    (local $walk i32)
    (local $cap_index i32)
    (local $cap_start i32)
    (local $cap_end i32)
    (local $sid i32)
    (local $groups_object i32)
    (local $name_id i32)
    (local $closure_pointer i32)
    (local $param_count i32)
    (local $stack_pointer i32)
    (local $frame_pointer i32)
    (local $arg_index i32)
    (local $offset_scalar i32)
    (local $bits i64)
    (local $prog_payload i32)

    (call $write_ctx (global.get $CTX_PENDING_POINTER)
      (local.get $entry_pending_pointer))
    ;; The dispatch arm guarantees a RegExp first argument.
    (local.set $descriptor (call $value_data_lo (local.get $args_base)))
    (local.set $descriptor_data
      (i32.add (local.get $descriptor) (global.get $GC_HEADER_SIZE)))
    (local.set $program (i32.load (call $abs (i32.add
      (local.get $descriptor_data) (global.get $REGEXP_PROGRAM_BUFFER)))))
    (if (i32.eqz (local.get $program))
      (then
        (call $fault_error (global.get $ERR_CORRUPT_OPERAND)
          (i32.const 0) (global.get $current_executing_pc))
        (return (i32.const 3) (local.get $fuel))))
    (local.set $flags_word (i32.load (call $abs (i32.add
      (local.get $descriptor_data) (global.get $REGEXP_FLAGS)))))
    (local.set $g (i32.and (local.get $flags_word) (global.get $REGEXP_FLAG_GLOBAL)))
    (local.set $y (i32.and (local.get $flags_word) (global.get $REGEXP_FLAG_STICKY)))
    (if (i32.and
          (i32.eq (local.get $method_id) (global.get $METHOD_REPLACE_ALL))
          (i32.eqz (local.get $g)))
      (then
        (if (call $throw_type_error_with_message
              (global.get $BUILTIN_MSG_REPLACEALL_GLOBAL))
          (then (return (i32.const 3) (local.get $fuel)))
          (else (return (i32.const 4) (local.get $fuel))))))

    ;; Replacement: a function stages callbacks; anything else is
    ;; ToString'd fresh each grant (deterministic, interning dedups).
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then
        (local.set $repl_slot
          (i32.add (local.get $args_base) (global.get $VALUE_SIZE)))
        (if (i32.eq (call $value_type (local.get $repl_slot))
              (global.get $TYPE_FUNCTION))
          (then (local.set $functional (i32.const 1)))
          (else
            (local.set $repl_id (call $value_to_string (local.get $repl_slot)))
            (if (i32.eqz (local.get $repl_id))
              (then (return (i32.const 2) (local.get $fuel)))))))
      (else
        (local.set $repl_id
          (call $read_builtin (global.get $BUILTIN_TYPEOF_UNDEFINED)))))

    (local.set $subject_abs (call $string_id_to_abs (local.get $subject_id)))
    (local.set $subject_len (i32.load (local.get $subject_abs)))
    (local.set $subject_abs (i32.add (local.get $subject_abs) (i32.const 4)))

    (local.set $state_handle (call $read_ctx (global.get $CTX_REGEX_STATE)))
    (if (i32.eq (local.get $state_handle) (i32.const 0))
      (then
        ;; Fresh operation. Sticky non-global reads its origin from
        ;; lastIndex; an origin past the end is an immediate miss that
        ;; returns the subject unchanged and resets lastIndex (exec
        ;; rules).
        (local.set $start_scalar (i32.const 0))
        (local.set $start_byte (i32.const 0))
        (if (i32.and
              (i32.eqz (local.get $g))
              (i32.ne (local.get $y) (i32.const 0)))
          (then
            (local.set $start_scalar (i32.load (call $abs (i32.add
              (local.get $descriptor_data) (global.get $REGEXP_LAST_INDEX)))))
            (local.set $start_byte (call $utf8_char_to_byte_offset
              (local.get $subject_id) (local.get $start_scalar)))
            (if (i32.eq (local.get $start_byte) (i32.const -1))
              (then
                (i32.store
                  (call $abs (i32.add
                    (local.get $descriptor_data) (global.get $REGEXP_LAST_INDEX)))
                  (i32.const 0))
                (call $write_value (local.get $result_slot)
                  (global.get $TYPE_STRING) (i32.const 0)
                  (local.get $subject_id) (i32.const 0))
                (call $write_ctx (global.get $CTX_PENDING_POINTER)
                  (i32.add (local.get $result_slot) (global.get $VALUE_SIZE)))
                (return (i32.const 0) (local.get $fuel))))))
        (local.set $cont_bytes (call $regexp_continuation_bytes (local.get $program)))
        (if (i32.eq (local.get $cont_bytes) (i32.const -1))
          (then
            (call $fault_error (global.get $ERR_CORRUPT_OPERAND)
              (i32.const 1) (global.get $current_executing_pc))
            (return (i32.const 3) (local.get $fuel))))
        (if (call $check_heap_overflow (i32.add
              (i32.add
                (call $estimate_arraybuffer_size (local.get $cont_bytes))
                (call $estimate_arraybuffer_size
                  (i32.add (local.get $subject_len) (i32.const 76))))
              (i32.add
                (global.get $NATIVE_CONTINUATION_STATE_SIZE)
                (call $estimate_array_size (i32.const 5)))))
          (then (return (i32.const 2) (local.get $fuel))))
        (local.set $continuation (call $allocate_arraybuffer (local.get $cont_bytes)))
        (local.set $output (call $allocate_arraybuffer
          (i32.add (local.get $subject_len) (i32.const 76))))
        (i32.store (i32.add (call $abs (local.get $output)) (i32.const 4)) (i32.const 0))
        (i32.store (i32.add (call $abs (local.get $output)) (i32.const 8)) (i32.const 0))
        (i32.store (i32.add (call $abs (local.get $output)) (i32.const 12)) (i32.const 0))
        (local.set $op_root (i32.const 0))
        (if (local.get $functional)
          (then
            (local.set $op_root (call $allocate_array (i32.const 5)))
            (local.set $root_data (i32.add
              (i32.load (call $abs (i32.add (local.get $op_root) (i32.const 16))))
              (global.get $GC_HEADER_SIZE)))
            (call $write_value (local.get $root_data)
              (global.get $TYPE_STRING) (i32.const 0)
              (local.get $subject_id) (i32.const 0))
            (call $write_value
              (i32.add (local.get $root_data) (global.get $VALUE_SIZE))
              (global.get $TYPE_REGEXP) (i32.const 0)
              (local.get $descriptor) (i32.const 0))
            (call $write_value
              (i32.add (local.get $root_data) (i32.mul (i32.const 2) (global.get $VALUE_SIZE)))
              (call $value_type (local.get $repl_slot))
              (i32.load (call $abs (i32.add (local.get $repl_slot) (i32.const 4))))
              (call $value_data_lo (local.get $repl_slot))
              (call $value_data_hi (local.get $repl_slot)))
            (call $write_value
              (i32.add (local.get $root_data) (i32.mul (i32.const 3) (global.get $VALUE_SIZE)))
              (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0))
            (call $write_value
              (i32.add (local.get $root_data) (i32.mul (i32.const 4) (global.get $VALUE_SIZE)))
              (global.get $TYPE_RATIONAL) (global.get $FLAG_RATIONAL_INLINE)
              (local.get $argc) (i32.const 0))))
        (local.set $status (call $regexp_init_attempt
          (local.get $program) (local.get $continuation)
          (local.get $subject_id) (local.get $start_byte) (local.get $start_scalar)))
        (if (i32.ne (local.get $status) (global.get $REGEX_STATUS_OK))
          (then
            (call $fault_error (global.get $ERR_CORRUPT_OPERAND)
              (local.get $status) (global.get $current_executing_pc))
            (return (i32.const 3) (local.get $fuel))))
        (local.set $state0 (i32.or (i32.const 6)
          (i32.shl (local.get $method_id) (i32.const 16))))
        (local.set $state_handle (call $allocate_native_continuation_state
          (i32.const 8) (i32.const 6)
          (local.get $state0) (local.get $continuation)
          (local.get $output) (local.get $op_root) (i32.const 0)))
        (call $write_ctx (global.get $CTX_REGEX_STATE) (local.get $state_handle)))
      (else
        (local.set $state0
          (call $native_continuation_state_get (local.get $state_handle) (i32.const 0)))
        (local.set $continuation
          (call $native_continuation_state_get (local.get $state_handle) (i32.const 1)))
        (local.set $output
          (call $native_continuation_state_get (local.get $state_handle) (i32.const 2)))
        (local.set $op_root
          (call $native_continuation_state_get (local.get $state_handle) (i32.const 3)))
        (if (i32.or
              (i32.or
                (i32.lt_u (i32.and (local.get $state0) (i32.const 0x3F)) (i32.const 6))
                (i32.gt_u (i32.and (local.get $state0) (i32.const 0x3F)) (i32.const 10)))
              (i32.or
                (i32.eqz (local.get $continuation))
                (i32.eqz (local.get $output))))
          (then
            (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
            (call $fault_error (global.get $ERR_CORRUPT_OPERAND)
              (local.get $state0) (global.get $current_executing_pc))
            (return (i32.const 3) (local.get $fuel))))))

    (local.set $phase (i32.and (local.get $state0) (i32.const 0x3F)))
    (local.set $matched (i32.and (local.get $state0) (i32.const 0x40)))
    (local.set $cont_payload
      (i32.add (call $abs (local.get $continuation)) (i32.const 4)))
    (local.set $ncaps (i32.load (i32.add
      (local.get $cont_payload) (global.get $REGEX_CONT_CAPTURE_GROUP_COUNT))))

    (block $commit
      (block $tail
        (loop $drive
          (if (i32.eq (local.get $phase) (i32.const 9)) (then (br $tail)))
          (if (i32.eq (local.get $phase) (i32.const 10)) (then (br $commit)))
          (if (i32.eq (local.get $phase) (i32.const 6))
            (then
              (call $regexp_run_attempt
                (local.get $program) (local.get $continuation)
                (local.get $subject_id) (local.get $fuel))
              (local.set $fuel)
              (local.set $status)
              (local.set $cont_payload
                (i32.add (call $abs (local.get $continuation)) (i32.const 4)))
              (if (i32.eq (local.get $status) (global.get $REGEX_STATUS_PAUSED))
                (then (return (i32.const 1) (local.get $fuel))))
              (if (i32.eq (local.get $status) (global.get $REGEX_STATUS_NO_MATCH))
                (then
                  (local.set $phase (i32.const 9))
                  (local.set $state0 (i32.or
                    (i32.or (i32.const 9) (local.get $matched))
                    (i32.shl (local.get $method_id) (i32.const 16))))
                  (call $native_continuation_state_set
                    (local.get $state_handle) (i32.const 0) (local.get $state0))
                  (br $tail)))
              (if (i32.ne (local.get $status) (global.get $REGEX_STATUS_MATCH))
                (then
                  (call $write_ctx (global.get $CTX_REGEX_STATE) (i32.const 0))
                  (call $fault_error (global.get $ERR_CORRUPT_OPERAND)
                    (local.get $status) (global.get $current_executing_pc))
                  (return (i32.const 3) (local.get $fuel))))
              (local.set $matched (i32.const 0x40))
              (local.set $phase (i32.const 7))
              (local.set $state0 (i32.or
                (i32.or (i32.const 7) (local.get $matched))
                (i32.shl (local.get $method_id) (i32.const 16))))
              (call $native_continuation_state_set
                (local.get $state_handle) (i32.const 0) (local.get $state0))))

          (local.set $ms (i32.load (i32.add (local.get $cont_payload)
            (global.get $REGEX_CONT_HEADER_SIZE))))
          (local.set $me (i32.load (i32.add
            (i32.add (local.get $cont_payload) (global.get $REGEX_CONT_HEADER_SIZE))
            (i32.const 4))))
          (local.set $out_content (i32.add (call $abs (local.get $output)) (i32.const 4)))
          (local.set $used (i32.load (local.get $out_content)))
          (local.set $p (i32.load (i32.add (local.get $out_content) (i32.const 4))))

          (if (i32.eq (local.get $phase) (i32.const 7))
            (then
              (if (local.get $functional)
                (then
                  ;; Stage the callback for this match. Interns and the
                  ;; groups object build BEFORE the frame publishes, so a
                  ;; pressure yield retries this phase with nothing
                  ;; half-staged.
                  (local.set $root_data (i32.add
                    (i32.load (call $abs (i32.add (local.get $op_root) (i32.const 16))))
                    (global.get $GC_HEADER_SIZE)))
                  (local.set $offset_scalar (call $utf8_byte_offset_to_char_index
                    (local.get $subject_id) (local.get $ms)))
                  (if (i32.eqz (call $intern_string
                        (i32.add (local.get $subject_abs) (local.get $ms))
                        (i32.sub (local.get $me) (local.get $ms))))
                    (then (return (i32.const 2) (local.get $fuel))))
                  (local.set $cap_index (i32.const 1))
                  (block $interned
                    (loop $intern_caps
                      (br_if $interned (i32.gt_u (local.get $cap_index) (local.get $ncaps)))
                      (local.set $cap_start (i32.load (i32.add
                        (i32.add (local.get $cont_payload) (global.get $REGEX_CONT_HEADER_SIZE))
                        (i32.shl (local.get $cap_index) (i32.const 3)))))
                      (local.set $cap_end (i32.load (i32.add
                        (i32.add
                          (i32.add (local.get $cont_payload) (global.get $REGEX_CONT_HEADER_SIZE))
                          (i32.shl (local.get $cap_index) (i32.const 3)))
                        (i32.const 4))))
                      (if (i32.and
                            (i32.ne (local.get $cap_start) (global.get $REGEX_CONT_NO_POSITION))
                            (i32.ne (local.get $cap_end) (global.get $REGEX_CONT_NO_POSITION)))
                        (then
                          (if (i32.eqz (call $intern_string
                                (i32.add (local.get $subject_abs) (local.get $cap_start))
                                (i32.sub (local.get $cap_end) (local.get $cap_start))))
                            (then (return (i32.const 2) (local.get $fuel))))))
                      (local.set $cap_index (i32.add (local.get $cap_index) (i32.const 1)))
                      (br $intern_caps)))
