  ;; get(M, i, j) — the entry value at (i, j), zero-indexed. RangeError
  ;; out of bounds (or on non-integer indices).
  (func $matrix_get_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $arg1_type i32)
    (local $arg1_lo i32)
    (local $row_index i32)
    (local $column_index i32)
    (local $entries_data i32)
    (local $slot i32)
    (local.set $row_index (i32.const -1))
    (local.set $column_index (i32.const -1))
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $arg1_type (call $value_type (local.get $argument1_pointer)))
        (local.set $arg1_lo (call $value_data_lo (local.get $argument1_pointer)))))
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then (local.set $row_index (call $matrix_dimension_arg
        (i32.add (local.get $argument1_pointer) (global.get $VALUE_SIZE))))))
    (if (i32.ge_u (local.get $argc) (i32.const 3))
      (then (local.set $column_index (call $matrix_dimension_arg
        (i32.add (local.get $argument1_pointer) (i32.mul (i32.const 2) (global.get $VALUE_SIZE)))))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (i32.ne (local.get $arg1_type) (global.get $TYPE_MATRIX))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_MATRIX_NOT_MATRIX))))))
    (if (i32.or
          (i32.or
            (i32.lt_s (local.get $row_index) (i32.const 0))
            (i32.lt_s (local.get $column_index) (i32.const 0)))
          (i32.or
            (i32.ge_u (local.get $row_index) (call $matrix_rows_of (local.get $arg1_lo)))
            (i32.ge_u (local.get $column_index) (call $matrix_columns_of (local.get $arg1_lo)))))
      (then (return (i32.add (i32.const 1)
        (call $throw_range_error_with_message (global.get $BUILTIN_MSG_MATRIX_INDEX))))))
    (local.set $entries_data (i32.load (call $abs (i32.add
      (call $matrix_entries_of (local.get $arg1_lo)) (i32.const 16)))))
    (local.set $slot (call $abs (i32.add
      (i32.add (local.get $entries_data) (global.get $GC_HEADER_SIZE))
      (i32.mul
        (i32.add
          (i32.mul (local.get $row_index) (call $matrix_columns_of (local.get $arg1_lo)))
          (local.get $column_index))
        (global.get $VALUE_SIZE)))))
    (call $pending_push
      (i32.load (local.get $slot))
      (i32.load (i32.add (local.get $slot) (i32.const 4)))
      (i32.load (i32.add (local.get $slot) (i32.const 8)))
      (i32.load (i32.add (local.get $slot) (i32.const 12))))
    (i32.const 0)
  )

  (func $matrix_is_matrix
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $arg1_type i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $arg1_type (call $value_type (local.get $argument1_pointer)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0)
      (i32.eq (local.get $arg1_type) (global.get $TYPE_MATRIX))
      (i32.const 0))
    (i32.const 0)
  )

  (func $matrix_is_square
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $arg1_type i32)
    (local $arg1_lo i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $arg1_type (call $value_type (local.get $argument1_pointer)))
        (local.set $arg1_lo (call $value_data_lo (local.get $argument1_pointer)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (i32.ne (local.get $arg1_type) (global.get $TYPE_MATRIX))
      (then (return (i32.add (i32.const 1)
        (call $throw_type_error_with_message (global.get $BUILTIN_MSG_MATRIX_NOT_MATRIX))))))
    (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0)
      (i32.eq
        (call $matrix_rows_of (local.get $arg1_lo))
        (call $matrix_columns_of (local.get $arg1_lo)))
      (i32.const 0))
    (i32.const 0)
  )

  ;; equal(a, b) — the full expression-equality relation on any two
  ;; values (Matrix-vs-Matrix recurses structurally via the
  ;; $expression_values_equal Matrix branch). Mirrors
  ;; $expression_equal's pressure handling.
  (func $matrix_equal_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $argument2_pointer i32)
    (local $equal_result i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))))
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then (local.set $argument2_pointer (i32.add (local.get $argument1_pointer) (global.get $VALUE_SIZE)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (local.set $equal_result
      (call $expression_values_equal (local.get $argument1_pointer) (local.get $argument2_pointer)))
    (if (global.get $memory_pressure_signaled)
      (then (return (i32.const 0))))
    (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0)
      (local.get $equal_result)
      (i32.const 0))
    (i32.const 0)
  )

  ;; ==========================================================================
  ;; Matrix element-wise arithmetic + transpose — Ring 4 (4b)
  ;;
  ;; Per-entry ops follow the uniform dispatch rule (plan decision 10):
  ;; numeric × numeric folds via Ring 1 ($expression_fold_*_slots);
  ;; everything else — Symbol, Expression, or Matrix entries — builds a
  ;; Ring 2 Expression and runs simplify. Matrix-valued entries thus
  ;; yield symbolic entries (lazy block algebra), never recursion and
  ;; never an error.
  ;; ==========================================================================

  ;; Compute one binary entry op into dest_slot.
  ;; op_kind: 0 = add, 1 = subtract, 2 = multiply.
  ;; Returns walk status: 0 ok, 1 pressure-abort (flag already set).
  (func $matrix_entry_binary
    (param $op_kind i32)
    (param $a_slot i32) (param $b_slot i32) (param $dest_slot i32)
    (result i32)
    (local $scratch i32)
    (local $head_builtin i32)
    (if (i32.and
          (call $expression_slot_is_numeric (local.get $a_slot))
          (call $expression_slot_is_numeric (local.get $b_slot)))
      (then
        (if (i32.eq (local.get $op_kind) (i32.const 1))
          (then
            ;; subtract: negate b into committed scratch, then add. The
            ;; scratch slot must be a committed blob — the folds
            ;; allocate, so it cannot live in tail scratch.
            (if (call $expression_walk_guard (i32.const 32))
              (then (return (i32.const 1))))
            (local.set $scratch (call $carve_scratch_blob (global.get $VALUE_SIZE)))
            (if (call $expression_negate_numeric (local.get $b_slot) (local.get $scratch))
              (then (return (i32.const 1))))
            (if (call $expression_walk_guard
                  (i32.add (i32.const 32)
                    (call $estimate_cross_type_arith_budget
                      (local.get $a_slot) (local.get $scratch))))
              (then (return (i32.const 1))))
            (call $expression_fold_add_slots
              (local.get $a_slot) (local.get $scratch) (local.get $dest_slot))
            (return (i32.const 0))))
        (if (call $expression_walk_guard
              (i32.add (i32.const 32)
                (call $estimate_cross_type_arith_budget
                  (local.get $a_slot) (local.get $b_slot))))
          (then (return (i32.const 1))))
        (if (i32.eqz (local.get $op_kind))
          (then (call $expression_fold_add_slots
            (local.get $a_slot) (local.get $b_slot) (local.get $dest_slot)))
          (else (call $expression_fold_mul_slots
            (local.get $a_slot) (local.get $b_slot) (local.get $dest_slot))))
        (return (i32.const 0))))
    ;; Symbolic path: build head(a, b), simplify into dest. Guard covers
    ;; the scratch slot + args array + expression node; simplify guards
    ;; its own walk per node.
    (if (call $expression_walk_guard (i32.const 160))
      (then (return (i32.const 1))))
    (local.set $head_builtin (global.get $BUILTIN_EXPRESSION_HEAD_ADD))
    (if (i32.eq (local.get $op_kind) (i32.const 1))
      (then (local.set $head_builtin (global.get $BUILTIN_EXPRESSION_HEAD_SUBTRACT))))
    (if (i32.eq (local.get $op_kind) (i32.const 2))
      (then (local.set $head_builtin (global.get $BUILTIN_EXPRESSION_HEAD_MULTIPLY))))
    (local.set $scratch (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (i32.store (call $abs (local.get $scratch)) (global.get $TYPE_EXPRESSION))
    (i32.store (call $abs (i32.add (local.get $scratch) (i32.const 4))) (i32.const 0))
    (i32.store (call $abs (i32.add (local.get $scratch) (i32.const 8)))
      (call $expression_build
        (call $symbol_registry_lookup (call $read_builtin (local.get $head_builtin)))
        (call $expression_alloc_args2 (local.get $a_slot) (local.get $b_slot))))
    (i32.store (call $abs (i32.add (local.get $scratch) (i32.const 12))) (i32.const 0))
    (call $expression_simplify_into (local.get $scratch) (local.get $dest_slot))
  )

  ;; Compute one unary entry op into dest_slot.
  ;; op_kind: 0 = negate, 1 = conjugate.
  ;; Returns walk status: 0 ok, 1 pressure-abort.
  (func $matrix_entry_unary
    (param $op_kind i32)
    (param $a_slot i32) (param $dest_slot i32)
    (result i32)
    (local $scratch i32)
    (local $head_builtin i32)
    (if (call $expression_slot_is_numeric (local.get $a_slot))
      (then
        (if (i32.eqz (local.get $op_kind))
          (then (return (call $expression_negate_numeric
            (local.get $a_slot) (local.get $dest_slot)))))
        (return (call $expression_conjugate_numeric
          (local.get $a_slot) (local.get $dest_slot)))))
    (if (call $expression_walk_guard (i32.const 128))
      (then (return (i32.const 1))))
    (local.set $head_builtin (global.get $BUILTIN_EXPRESSION_HEAD_NEGATE))
    (if (i32.eq (local.get $op_kind) (i32.const 1))
      (then (local.set $head_builtin (global.get $BUILTIN_EXPRESSION_HEAD_CONJUGATE))))
    (local.set $scratch (call $carve_scratch_blob (global.get $VALUE_SIZE)))
    (i32.store (call $abs (local.get $scratch)) (global.get $TYPE_EXPRESSION))
    (i32.store (call $abs (i32.add (local.get $scratch) (i32.const 4))) (i32.const 0))
    (i32.store (call $abs (i32.add (local.get $scratch) (i32.const 8)))
      (call $expression_build
        (call $symbol_registry_lookup (call $read_builtin (local.get $head_builtin)))
        (call $expression_alloc_args1 (local.get $a_slot))))
    (i32.store (call $abs (i32.add (local.get $scratch) (i32.const 12))) (i32.const 0))
    (call $expression_simplify_into (local.get $scratch) (local.get $dest_slot))
