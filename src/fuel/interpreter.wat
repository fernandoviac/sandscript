              (i32.load (call $abs
                (i32.add (local.get $arg1_lo) (i32.const 32)))))
            (if (i32.ne (local.get $i32_result) (i32.const 0))
              (then
                (call $write_ctx
                  (global.get $CTX_PENDING_POINTER)
                  (local.get $stack_base))
                (call $push_bigint (local.get $i32_result))
                (return (i32.const 0))))))
        (return
          (call $stage_bigint_to_primitive
            (local.get $argument1_pointer)
            (local.get $arg1_lo)
            (local.get $pending_pointer)
            (i32.const 0)))))
    (if (i32.eq (local.get $arg1_type) (global.get $TYPE_BIGINT))
      (then
        (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
        (call $pending_push (global.get $TYPE_BIGINT) (i32.const 0) (local.get $arg1_lo) (i32.const 0))
        (return (i32.const 0))))
    (if (call $value_is_numeric (local.get $argument1_pointer))
      (then
        (local.set $result_f64 (call $value_to_f64 (local.get $argument1_pointer)))
        (if (i32.or
              (f64.ne (f64.trunc (local.get $result_f64)) (local.get $result_f64))
              (f64.eq (f64.abs (local.get $result_f64)) (f64.const inf)))
          (then
            (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
