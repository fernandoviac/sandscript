        (local.set $arg1_type (call $value_type (local.get $argument1_pointer)))
        (local.set $arg1_lo (call $value_data_lo (local.get $argument1_pointer)))))
    (local.set $receiver_pointer (call $string_id_to_seg (local.get $receiver_pointer)))
    (local.set $str_len (i32.load (call $abs (local.get $receiver_pointer))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))

    (if (call $value_is_numeric (local.get $argument1_pointer))
      (then
        (local.set $i (i32.trunc_sat_f64_s (call $value_to_f64 (local.get $argument1_pointer))))
      )
      (else
        (if (i32.eq (local.get $arg1_type) (global.get $TYPE_INTEGER))
          (then (local.set $i (local.get $arg1_lo)))
          (else (local.set $i (i32.const 0)))
        )
      )
    )

    (local.set $start_idx (call $utf8_char_to_byte_offset (call $seg_to_string_id (local.get $receiver_pointer)) (local.get $i)))

    (if (i32.or
          (i32.lt_s (local.get $i) (i32.const 0))
          (i32.lt_s (local.get $start_idx) (i32.const 0)))
      (then
        (call $pending_push (global.get $TYPE_FLOAT) (i32.const 0)
          (i32.const 0x00000000)
          (i32.const 0x7FF80000))
        (return (i32.const 0))
      )
    )

    (if (i32.ge_s (local.get $start_idx) (local.get $str_len))
      (then
        (call $pending_push (global.get $TYPE_FLOAT) (i32.const 0)
          (i32.const 0x00000000)
          (i32.const 0x7FF80000))
        (return (i32.const 0))
      )
    )

    (local.set $char_code (call $utf8_decode_at (call $seg_to_string_id (local.get $receiver_pointer)) (local.get $start_idx)))

    (call $push_f64 (f64.convert_i32_u (local.get $char_code)))
    (return (i32.const 0))
  )

  (func $string_index_of_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $arg1_type i32)
    (local $arg1_lo i32)
    (local $argument2_pointer i32)
    (local $str_len i32)
    (local $search_pointer i32)
    (local $search_len i32)
    (local $start_idx i32)
    (local $i i32)
    (local $found i32)
    (local $char_code i32)
    (local $byte_pointer i32)
    (local $element_pointer i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $arg1_type (call $value_type (local.get $argument1_pointer)))
        (local.set $arg1_lo (call $value_data_lo (local.get $argument1_pointer)))))
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then
        (local.set $argument2_pointer (i32.add (local.get $argument1_pointer) (global.get $VALUE_SIZE)))))
    (local.set $receiver_pointer (call $string_id_to_seg (local.get $receiver_pointer)))
    (local.set $str_len (i32.load (call $abs (local.get $receiver_pointer))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))

    (if (i32.ne (local.get $arg1_type) (global.get $TYPE_STRING))
      (then
        (call $push_f64 (f64.const -1))
        (return (i32.const 0))
      )
    )

    (local.set $search_pointer (call $string_id_to_seg (local.get $arg1_lo)))
    (local.set $search_len (i32.load (call $abs (local.get $search_pointer))))

    (local.set $start_idx (i32.const 0))
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then
        (if (call $value_is_numeric (local.get $argument2_pointer))
          (then
            (local.set $start_idx
              (i32.trunc_sat_f64_s (call $value_to_f64 (local.get $argument2_pointer))))
            (if (i32.lt_s (local.get $start_idx) (i32.const 0))
              (then (local.set $start_idx (i32.const 0)))
            )
          )
        )
      )
    )

    (if (i32.eqz (local.get $search_len))
      (then
        (if (i32.gt_u (local.get $start_idx) (local.get $str_len))
          (then (local.set $start_idx (local.get $str_len)))
        )
        (call $push_f64 (f64.convert_i32_s (local.get $start_idx)))
        (return (i32.const 0))
      )
    )

    (if (i32.gt_u (local.get $search_len) (local.get $str_len))
      (then
        (call $push_f64 (f64.const -1))
        (return (i32.const 0))
      )
    )

    (local.set $i (local.get $start_idx))
    (local.set $found (i32.const 0))
    (block $str_indexOf_done
      (loop $str_indexOf_loop
        (br_if $str_indexOf_done
          (i32.gt_u (local.get $i) (i32.sub (local.get $str_len) (local.get $search_len))))

        (local.set $found (i32.const 1))
        (local.set $char_code (i32.const 0))
        (block $cmp_done
          (loop $cmp_loop
            (br_if $cmp_done (i32.ge_u (local.get $char_code) (local.get $search_len)))

            (local.set $byte_pointer
              (i32.load8_u (call $abs (i32.add
                (i32.add (local.get $receiver_pointer) (i32.const 4))
                (i32.add (local.get $i) (local.get $char_code))))))

            (local.set $element_pointer
              (i32.load8_u (call $abs (i32.add
                (i32.add (local.get $search_pointer) (i32.const 4))
                (local.get $char_code)))))

            (if (i32.ne (local.get $byte_pointer) (local.get $element_pointer))
              (then
                (local.set $found (i32.const 0))
                (br $cmp_done)
              )
            )

            (local.set $char_code (i32.add (local.get $char_code) (i32.const 1)))
            (br $cmp_loop)
          )
        )

        (if (local.get $found)
          (then (br $str_indexOf_done))
        )

        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $str_indexOf_loop)
      )
    )

    (if (local.get $found)
      (then (call $push_f64 (f64.convert_i32_s (local.get $i))))
      (else (call $push_f64 (f64.const -1)))
    )
    (return (i32.const 0))
  )

  (func $string_includes_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $arg1_type i32)
    (local $arg1_lo i32)
    (local $argument2_pointer i32)
    (local $str_len i32)
    (local $search_pointer i32)
    (local $search_len i32)
    (local $i i32)
    (local $found i32)
    (local $char_code i32)
    (local $byte_pointer i32)
    (local $element_pointer i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $arg1_type (call $value_type (local.get $argument1_pointer)))
        (local.set $arg1_lo (call $value_data_lo (local.get $argument1_pointer)))))
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then
        (local.set $argument2_pointer (i32.add (local.get $argument1_pointer) (global.get $VALUE_SIZE)))))
    (local.set $receiver_pointer (call $string_id_to_seg (local.get $receiver_pointer)))
    (local.set $str_len (i32.load (call $abs (local.get $receiver_pointer))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))

    (if (i32.ne (local.get $arg1_type) (global.get $TYPE_STRING))
      (then
        (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (i32.const 0) (i32.const 0))
        (return (i32.const 0))
      )
    )

    (local.set $search_pointer (call $string_id_to_seg (local.get $arg1_lo)))
    (local.set $search_len (i32.load (call $abs (local.get $search_pointer))))

    (if (i32.eqz (local.get $search_len))
      (then
        (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (i32.const 1) (i32.const 0))
        (return (i32.const 0))
      )
    )

    (if (i32.gt_u (local.get $search_len) (local.get $str_len))
      (then
        (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (i32.const 0) (i32.const 0))
        (return (i32.const 0))
      )
    )

    (local.set $i (i32.const 0))
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then (local.set $i (call $clamp_position
        (local.get $argument2_pointer) (local.get $str_len)))))
    (local.set $found (i32.const 0))
    (block $str_incl_done
      (loop $str_incl_loop
        (br_if $str_incl_done
          (i32.gt_u (local.get $i) (i32.sub (local.get $str_len) (local.get $search_len))))

        (local.set $found (i32.const 1))
        (local.set $char_code (i32.const 0))
        (block $cmp_done2
          (loop $cmp_loop2
            (br_if $cmp_done2 (i32.ge_u (local.get $char_code) (local.get $search_len)))

            (local.set $byte_pointer
              (i32.load8_u (call $abs (i32.add
                (i32.add (local.get $receiver_pointer) (i32.const 4))
                (i32.add (local.get $i) (local.get $char_code))))))

            (local.set $element_pointer
              (i32.load8_u (call $abs (i32.add
                (i32.add (local.get $search_pointer) (i32.const 4))
                (local.get $char_code)))))

            (if (i32.ne (local.get $byte_pointer) (local.get $element_pointer))
              (then
                (local.set $found (i32.const 0))
                (br $cmp_done2)
              )
            )

            (local.set $char_code (i32.add (local.get $char_code) (i32.const 1)))
            (br $cmp_loop2)
          )
        )

        (if (local.get $found)
          (then (br $str_incl_done))
        )

        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $str_incl_loop)
      )
    )

    (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (local.get $found) (i32.const 0))
    (return (i32.const 0))
  )

  (func $string_slice_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $arg1_type i32)
    (local $arg1_lo i32)
    (local $argument2_pointer i32)
    (local $arg2_type i32)
    (local $char_count i32)
    (local $start_idx i32)
    (local $end_idx i32)
    (local $start_byte i32)
    (local $end_byte i32)
    (local $slice_len i32)
    (local $scratch_pointer i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $arg1_type (call $value_type (local.get $argument1_pointer)))
        (local.set $arg1_lo (call $value_data_lo (local.get $argument1_pointer)))))
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then
        (local.set $argument2_pointer (i32.add (local.get $argument1_pointer) (global.get $VALUE_SIZE)))
        (local.set $arg2_type (call $value_type (local.get $argument2_pointer)))))
    (local.set $receiver_pointer (call $string_id_to_seg (local.get $receiver_pointer)))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))

    (local.set $char_count (call $utf8_char_count (call $seg_to_string_id (local.get $receiver_pointer))))

    (if (call $value_is_numeric (local.get $argument1_pointer))
      (then
        (local.set $start_idx (i32.trunc_sat_f64_s (call $value_to_f64 (local.get $argument1_pointer))))
      )
      (else
        (if (i32.eq (local.get $arg1_type) (global.get $TYPE_INTEGER))
          (then (local.set $start_idx (local.get $arg1_lo)))
          (else (local.set $start_idx (i32.const 0)))
        )
      )
    )

    (if (i32.lt_s (local.get $start_idx) (i32.const 0))
      (then
        (local.set $start_idx (i32.add (local.get $char_count) (local.get $start_idx)))
        (if (i32.lt_s (local.get $start_idx) (i32.const 0))
          (then (local.set $start_idx (i32.const 0)))
        )
      )
    )

    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then
        (if (call $value_is_numeric (local.get $argument2_pointer))
          (then
            (local.set $end_idx (i32.trunc_sat_f64_s (call $value_to_f64 (local.get $argument2_pointer))))
          )
          (else
            (if (i32.eq (local.get $arg2_type) (global.get $TYPE_INTEGER))
              (then (local.set $end_idx (call $value_data_lo (local.get $argument2_pointer))))
              (else (local.set $end_idx (local.get $char_count)))
            )
          )
        )
      )
      (else
        (local.set $end_idx (local.get $char_count))
      )
    )

    (if (i32.lt_s (local.get $end_idx) (i32.const 0))
      (then
        (local.set $end_idx (i32.add (local.get $char_count) (local.get $end_idx)))
        (if (i32.lt_s (local.get $end_idx) (i32.const 0))
          (then (local.set $end_idx (i32.const 0)))
        )
      )
    )

    (if (i32.gt_s (local.get $end_idx) (local.get $char_count))
      (then (local.set $end_idx (local.get $char_count)))
    )

    (if (i32.gt_s (local.get $start_idx) (local.get $char_count))
      (then (local.set $start_idx (local.get $char_count)))
    )

    (if (i32.ge_s (local.get $start_idx) (local.get $end_idx))
      (then
        (call $pending_push (global.get $TYPE_STRING) (i32.const 0)
          (call $read_builtin (global.get $BUILTIN_LIT_EMPTY_STRING))
          (i32.const 0))
        (return (i32.const 0))
      )
    )

    (local.set $start_byte (call $utf8_char_to_byte_offset (call $seg_to_string_id (local.get $receiver_pointer)) (local.get $start_idx)))
    (local.set $end_byte (call $utf8_char_to_byte_offset (call $seg_to_string_id (local.get $receiver_pointer)) (local.get $end_idx)))

    (local.set $slice_len (i32.sub (local.get $end_byte) (local.get $start_byte)))

    (if (call $check_concat_scratch_overflow (local.get $slice_len))
      (then (return (i32.const 0)))
    )

    (local.set $scratch_pointer
      (call $abs (call $read_state (global.get $STATE_HEAP_POINTER))))
    (memory.copy
      (local.get $scratch_pointer)
      (call $abs (i32.add (local.get $receiver_pointer)
        (i32.add (i32.const 4) (local.get $start_byte))))
      (local.get $slice_len))
    (call $pending_push (global.get $TYPE_STRING) (i32.const 0)
      (call $intern_string (local.get $scratch_pointer) (local.get $slice_len))
      (i32.const 0))
    (return (i32.const 0))
  )

  (func $string_substring_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $arg1_type i32)
    (local $arg1_lo i32)
    (local $argument2_pointer i32)
    (local $arg2_type i32)
    (local $char_count i32)
    (local $start_idx i32)
    (local $end_idx i32)
    (local $i i32)
    (local $start_byte i32)
    (local $end_byte i32)
    (local $slice_len i32)
    (local $scratch_pointer i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $arg1_type (call $value_type (local.get $argument1_pointer)))
        (local.set $arg1_lo (call $value_data_lo (local.get $argument1_pointer)))))
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then
        (local.set $argument2_pointer (i32.add (local.get $argument1_pointer) (global.get $VALUE_SIZE)))
        (local.set $arg2_type (call $value_type (local.get $argument2_pointer)))))
    (local.set $receiver_pointer (call $string_id_to_seg (local.get $receiver_pointer)))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))

    (local.set $char_count (call $utf8_char_count (call $seg_to_string_id (local.get $receiver_pointer))))

    (if (call $value_is_numeric (local.get $argument1_pointer))
      (then
        (local.set $start_idx (i32.trunc_sat_f64_s (call $value_to_f64 (local.get $argument1_pointer))))
      )
      (else
        (if (i32.eq (local.get $arg1_type) (global.get $TYPE_INTEGER))
          (then (local.set $start_idx (local.get $arg1_lo)))
          (else (local.set $start_idx (i32.const 0)))
        )
      )
    )

    (if (i32.lt_s (local.get $start_idx) (i32.const 0))
      (then (local.set $start_idx (i32.const 0)))
    )

    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then
        (if (call $value_is_numeric (local.get $argument2_pointer))
          (then
            (local.set $end_idx (i32.trunc_sat_f64_s (call $value_to_f64 (local.get $argument2_pointer))))
          )
          (else
            (if (i32.eq (local.get $arg2_type) (global.get $TYPE_INTEGER))
              (then (local.set $end_idx (call $value_data_lo (local.get $argument2_pointer))))
              (else (local.set $end_idx (local.get $char_count)))
            )
          )
        )
      )
      (else
        (local.set $end_idx (local.get $char_count))
      )
    )

    (if (i32.lt_s (local.get $end_idx) (i32.const 0))
      (then (local.set $end_idx (i32.const 0)))
    )

    (if (i32.gt_s (local.get $start_idx) (local.get $char_count))
      (then (local.set $start_idx (local.get $char_count)))
    )
    (if (i32.gt_s (local.get $end_idx) (local.get $char_count))
      (then (local.set $end_idx (local.get $char_count)))
    )

    (if (i32.gt_s (local.get $start_idx) (local.get $end_idx))
      (then
        (local.set $i (local.get $start_idx))
        (local.set $start_idx (local.get $end_idx))
        (local.set $end_idx (local.get $i))
      )
    )

    (if (i32.eq (local.get $start_idx) (local.get $end_idx))
      (then
        (call $pending_push (global.get $TYPE_STRING) (i32.const 0)
          (call $read_builtin (global.get $BUILTIN_LIT_EMPTY_STRING))
          (i32.const 0))
        (return (i32.const 0))
      )
    )

    (local.set $start_byte (call $utf8_char_to_byte_offset (call $seg_to_string_id (local.get $receiver_pointer)) (local.get $start_idx)))
    (local.set $end_byte (call $utf8_char_to_byte_offset (call $seg_to_string_id (local.get $receiver_pointer)) (local.get $end_idx)))

    (local.set $slice_len (i32.sub (local.get $end_byte) (local.get $start_byte)))

    (if (call $check_concat_scratch_overflow (local.get $slice_len))
      (then (return (i32.const 0)))
    )

    (local.set $scratch_pointer
      (call $abs (call $read_state (global.get $STATE_HEAP_POINTER))))
    (memory.copy
      (local.get $scratch_pointer)
      (call $abs (i32.add (local.get $receiver_pointer)
        (i32.add (i32.const 4) (local.get $start_byte))))
      (local.get $slice_len))
    (call $pending_push (global.get $TYPE_STRING) (i32.const 0)
      (call $intern_string (local.get $scratch_pointer) (local.get $slice_len))
      (i32.const 0))
    (return (i32.const 0))
  )

  (func $string_split_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $arg1_type i32)
    (local $arg1_lo i32)
    (local $argument2_pointer i32)
    (local $str_len i32)
    (local $search_pointer i32)
    (local $search_len i32)
    (local $count i32)
    (local $i i32)
    (local $found i32)
    (local $j i32)
    (local $end_idx i32)
    (local $heap_pointer i32)
    (local $new_arr i32)
    (local $i32_result i32)
    (local $new_data i32)
    (local $match_pos i32)
    (local $element_pointer i32)
    (local $scratch_pointer i32)
    (local $start_idx i32)
    (local $slice_len i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $arg1_type (call $value_type (local.get $argument1_pointer)))
        (local.set $arg1_lo (call $value_data_lo (local.get $argument1_pointer)))))
    (if (i32.ge_u (local.get $argc) (i32.const 2))
      (then
        (local.set $argument2_pointer (i32.add (local.get $argument1_pointer) (global.get $VALUE_SIZE)))))
    (local.set $receiver_pointer (call $string_id_to_seg (local.get $receiver_pointer)))
    (local.set $str_len (i32.load (call $abs (local.get $receiver_pointer))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))

    (if (i32.ne (local.get $arg1_type) (global.get $TYPE_STRING))
      (then
        (local.set $count (i32.const 1))
      )
      (else
        (local.set $search_pointer (call $string_id_to_seg (local.get $arg1_lo)))
        (local.set $search_len (i32.load (call $abs (local.get $search_pointer))))

        (if (i32.eqz (local.get $search_len))
          (then (local.set $count (local.get $str_len)))
          (else
            (local.set $count (i32.const 1))
            (local.set $i (i32.const 0))
            (block $count_done
              (loop $count_loop
                (br_if $count_done (i32.gt_u (local.get $i)
                  (i32.sub (local.get $str_len) (local.get $search_len))))

                (local.set $found (i32.const 1))
                (local.set $j (i32.const 0))
                (block $match_done
                  (loop $match_loop
                    (br_if $match_done (i32.ge_u (local.get $j) (local.get $search_len)))
                    (if (i32.ne
                          (i32.load8_u (call $abs (i32.add
                            (i32.add (local.get $receiver_pointer) (i32.const 4))
                            (i32.add (local.get $i) (local.get $j)))))
                          (i32.load8_u (call $abs (i32.add
                            (i32.add (local.get $search_pointer) (i32.const 4))
                            (local.get $j)))))
                      (then
                        (local.set $found (i32.const 0))
                        (br $match_done)
                      )
                    )
                    (local.set $j (i32.add (local.get $j) (i32.const 1)))
                    (br $match_loop)
                  )
                )

                (if (local.get $found)
                  (then
                    (local.set $count (i32.add (local.get $count) (i32.const 1)))
                    (local.set $i (i32.add (local.get $i) (local.get $search_len)))
                  )
                  (else
                    (local.set $i (i32.add (local.get $i) (i32.const 1)))
                  )
                )
                (br $count_loop)
              )
            )
          )
        )
      )
    )

    (if (i32.and
          (i32.ge_u (local.get $argc) (i32.const 2))
          (call $value_is_numeric (local.get $argument2_pointer)))
      (then
        (local.set $end_idx
          (i32.trunc_sat_f64_s (call $value_to_f64 (local.get $argument2_pointer))))
        (if (i32.gt_u (local.get $count) (local.get $end_idx))
          (then (local.set $count (local.get $end_idx))))
      )
    )

    ;; Bounds check BEFORE the first store — the result array is sized
    ;; by the number of split pieces (up to the string's length for an
    ;; empty separator), which can exceed the dispatcher's heap-slack
    ;; headroom in one instruction. Pressure-signaled return 0: $run's
    ;; CALL_METHOD rollback restores the pending stack and retries
    ;; before any mutation.
    (if (call $check_heap_overflow (call $estimate_array_size (local.get $count)))
      (then (return (i32.const 0))))

    (local.set $heap_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))
    (local.set $new_arr (local.get $heap_pointer))

    (local.set $i32_result (i32.add (global.get $GC_HEADER_SIZE)
      (i32.mul (local.get $count) (global.get $VALUE_SIZE))))
    (local.set $new_data (call $write_array_header
      (local.get $new_arr) (local.get $count) (local.get $count) (local.get $i32_result)))

    (call $write_state (global.get $STATE_HEAP_POINTER)
      (i32.add (local.get $new_data) (local.get $i32_result)))

    (local.set $match_pos (local.get $count))

    (if (i32.ne (local.get $arg1_type) (global.get $TYPE_STRING))
      (then
        (if (i32.gt_u (local.get $match_pos) (i32.const 0))
          (then
            (local.set $element_pointer (i32.add (local.get $new_data) (global.get $GC_HEADER_SIZE)))
            (i32.store (call $abs (local.get $element_pointer)) (global.get $TYPE_STRING))
            (i32.store (call $abs (i32.add (local.get $element_pointer) (i32.const 4))) (i32.const 0))
            (i32.store (call $abs (i32.add (local.get $element_pointer) (i32.const 8)))
              (call $seg_to_string_id (local.get $receiver_pointer)))
            (i32.store (call $abs (i32.add (local.get $element_pointer) (i32.const 12))) (i32.const 0))
          )
        )
      )
      (else
        (if (i32.eqz (local.get $search_len))
          (then
            (local.set $i (i32.const 0))
            (block $char_split_done
              (loop $char_split_loop
                (br_if $char_split_done (i32.ge_u (local.get $i) (local.get $match_pos)))

                (if (call $check_concat_scratch_overflow (i32.const 1))
                  (then (return (i32.const 0)))
                )
                (local.set $scratch_pointer
                  (call $abs (call $read_state (global.get $STATE_HEAP_POINTER))))
                (i32.store8 (local.get $scratch_pointer)
                  (i32.load8_u (call $abs (i32.add
                    (i32.add (local.get $receiver_pointer) (i32.const 4))
                    (local.get $i)))))

                (local.set $element_pointer (i32.add
                  (i32.add (local.get $new_data) (global.get $GC_HEADER_SIZE))
                  (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
                (i32.store (call $abs (local.get $element_pointer)) (global.get $TYPE_STRING))
                (i32.store (call $abs (i32.add (local.get $element_pointer) (i32.const 4))) (i32.const 0))
                (i32.store (call $abs (i32.add (local.get $element_pointer) (i32.const 8))) (call $intern_string (local.get $scratch_pointer) (i32.const 1)))
                (i32.store (call $abs (i32.add (local.get $element_pointer) (i32.const 12))) (i32.const 0))

                (local.set $i (i32.add (local.get $i) (i32.const 1)))
                (br $char_split_loop)
              )
            )
          )
          (else
            (local.set $start_idx (i32.const 0))
            (local.set $count (i32.const 0))
            (local.set $i (i32.const 0))

            (block $split_done
              (loop $split_loop
                (if (i32.le_u (local.get $i)
                      (i32.sub (local.get $str_len) (local.get $search_len)))
                  (then
                    (local.set $found (i32.const 1))
                    (local.set $j (i32.const 0))
                    (block $sep_match_done
                      (loop $sep_match_loop
                        (br_if $sep_match_done (i32.ge_u (local.get $j) (local.get $search_len)))
                        (if (i32.ne
                              (i32.load8_u (call $abs (i32.add
                                (i32.add (local.get $receiver_pointer) (i32.const 4))
                                (i32.add (local.get $i) (local.get $j)))))
                              (i32.load8_u (call $abs (i32.add
                                (i32.add (local.get $search_pointer) (i32.const 4))
                                (local.get $j)))))
                          (then
                            (local.set $found (i32.const 0))
                            (br $sep_match_done)
                          )
                        )
                        (local.set $j (i32.add (local.get $j) (i32.const 1)))
                        (br $sep_match_loop)
                      )
                    )

                    (if (local.get $found)
                      (then
                        (if (i32.ge_u (local.get $count) (local.get $match_pos))
                          (then (br $split_done)))

                        (local.set $slice_len (i32.sub (local.get $i) (local.get $start_idx)))

                        (if (call $check_concat_scratch_overflow (local.get $slice_len))
                          (then (return (i32.const 0)))
                        )
                        (local.set $scratch_pointer
                          (call $abs (call $read_state (global.get $STATE_HEAP_POINTER))))
                        (memory.copy
                          (local.get $scratch_pointer)
                          (call $abs (i32.add (local.get $receiver_pointer)
                            (i32.add (i32.const 4) (local.get $start_idx))))
                          (local.get $slice_len))

                        (local.set $element_pointer (i32.add
                          (i32.add (local.get $new_data) (global.get $GC_HEADER_SIZE))
                          (i32.mul (local.get $count) (global.get $VALUE_SIZE))))
                        (i32.store (call $abs (local.get $element_pointer)) (global.get $TYPE_STRING))
                        (i32.store (call $abs (i32.add (local.get $element_pointer) (i32.const 4))) (i32.const 0))
                        (i32.store (call $abs (i32.add (local.get $element_pointer) (i32.const 8))) (call $intern_string (local.get $scratch_pointer) (local.get $slice_len)))
                        (i32.store (call $abs (i32.add (local.get $element_pointer) (i32.const 12))) (i32.const 0))

                        (local.set $count (i32.add (local.get $count) (i32.const 1)))
                        (local.set $i (i32.add (local.get $i) (local.get $search_len)))
                        (local.set $start_idx (local.get $i))
                        (br $split_loop)
                      )
                      (else
                        (local.set $i (i32.add (local.get $i) (i32.const 1)))
                        (br $split_loop)
                      )
                    )
                  )
                  (else
                    (br $split_done)
                  )
                )
              )
            )

            (if (i32.lt_u (local.get $count) (local.get $match_pos))
              (then
                (local.set $slice_len (i32.sub (local.get $str_len) (local.get $start_idx)))
                (if (call $check_concat_scratch_overflow (local.get $slice_len))
                  (then (return (i32.const 0)))
                )
                (local.set $scratch_pointer
                  (call $abs (call $read_state (global.get $STATE_HEAP_POINTER))))
                (memory.copy
                  (local.get $scratch_pointer)
                  (call $abs (i32.add (local.get $receiver_pointer)
                    (i32.add (i32.const 4) (local.get $start_idx))))
                  (local.get $slice_len))

                (local.set $element_pointer (i32.add
                  (i32.add (local.get $new_data) (global.get $GC_HEADER_SIZE))
                  (i32.mul (local.get $count) (global.get $VALUE_SIZE))))
                (i32.store (call $abs (local.get $element_pointer)) (global.get $TYPE_STRING))
                (i32.store (call $abs (i32.add (local.get $element_pointer) (i32.const 4))) (i32.const 0))
                (i32.store (call $abs (i32.add (local.get $element_pointer) (i32.const 8))) (call $intern_string (local.get $scratch_pointer) (local.get $slice_len)))
                (i32.store (call $abs (i32.add (local.get $element_pointer) (i32.const 12))) (i32.const 0))
              )
            )
          )
        )
      )
    )

    (call $pending_push (global.get $TYPE_ARRAY) (i32.const 0) (local.get $new_arr) (i32.const 0))
    (return (i32.const 0))
  )

  (func $string_trim_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $str_len i32)
    (local $start_idx i32)
    (local $char_code i32)
    (local $end_idx i32)
    (local $slice_len i32)
    (local.set $receiver_pointer (call $string_id_to_seg (local.get $receiver_pointer)))
    (local.set $str_len (i32.load (call $abs (local.get $receiver_pointer))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))

    (local.set $start_idx (i32.const 0))
    (block $trim_start_done
      (loop $trim_start_loop
        (br_if $trim_start_done (i32.ge_u (local.get $start_idx) (local.get $str_len)))
        (local.set $char_code
          (i32.load8_u (call $abs (i32.add
            (i32.add (local.get $receiver_pointer) (i32.const 4))
            (local.get $start_idx)))))
        (br_if $trim_start_done
          (i32.and
            (i32.and
              (i32.ne (local.get $char_code) (i32.const 0x20))
              (i32.ne (local.get $char_code) (i32.const 0x09)))
            (i32.and
              (i32.ne (local.get $char_code) (i32.const 0x0A))
              (i32.ne (local.get $char_code) (i32.const 0x0D)))))
        (local.set $start_idx (i32.add (local.get $start_idx) (i32.const 1)))
        (br $trim_start_loop)
      )
    )

    (local.set $end_idx (local.get $str_len))
    (block $trim_end_done
      (loop $trim_end_loop
        (br_if $trim_end_done (i32.le_u (local.get $end_idx) (local.get $start_idx)))
        (local.set $char_code
          (i32.load8_u (call $abs (i32.add
            (i32.add (local.get $receiver_pointer) (i32.const 4))
            (i32.sub (local.get $end_idx) (i32.const 1))))))
        (br_if $trim_end_done
          (i32.and
            (i32.and
              (i32.ne (local.get $char_code) (i32.const 0x20))
              (i32.ne (local.get $char_code) (i32.const 0x09)))
            (i32.and
              (i32.ne (local.get $char_code) (i32.const 0x0A))
              (i32.ne (local.get $char_code) (i32.const 0x0D)))))
        (local.set $end_idx (i32.sub (local.get $end_idx) (i32.const 1)))
        (br $trim_end_loop)
      )
    )

    (local.set $slice_len (i32.sub (local.get $end_idx) (local.get $start_idx)))

    (if (i32.le_s (local.get $slice_len) (i32.const 0))
      (then
        (call $pending_push (global.get $TYPE_STRING) (i32.const 0)
          (call $read_builtin (global.get $BUILTIN_LIT_EMPTY_STRING)) (i32.const 0))
        (return (i32.const 0))
      )
    )

    ;; Intern the trimmed slice directly from the receiver's bytes — the
    ;; $string_iterator_next_method pattern. Dedups, and the capacity
    ;; check lives in $intern_string.
    (call $pending_push (global.get $TYPE_STRING) (i32.const 0)
      (call $intern_string
        (call $abs (i32.add
          (i32.add (local.get $receiver_pointer) (i32.const 4))
          (local.get $start_idx)))
        (local.get $slice_len))
      (i32.const 0))
    (return (i32.const 0))
  )

  (func $string_to_lower_case_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $str_len i32)
    (local $new_string_pointer i32)
    (local $i i32)
    (local $j i32)
    (local $char_code i32)
    (local $slice_len i32)
    (local $count i32)
    (local.set $receiver_pointer (call $string_id_to_seg (local.get $receiver_pointer)))
    (local.set $str_len (i32.load (call $abs (local.get $receiver_pointer))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))

    (if (i32.eqz (local.get $str_len))
      (then
        (call $pending_push (global.get $TYPE_STRING) (i32.const 0)
          (call $read_builtin (global.get $BUILTIN_LIT_EMPTY_STRING))
          (i32.const 0))
        (return (i32.const 0))
      )
    )

    (if (call $check_concat_scratch_overflow
          (i32.mul (local.get $str_len) (i32.const 4)))
      (then (return (i32.const 0)))
    )

    (local.set $new_string_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))
    (local.set $i (i32.const 0))
    (local.set $j (i32.const 0))
    (block $lower_done
      (loop $lower_loop
        (br_if $lower_done (i32.ge_u (local.get $i) (local.get $str_len)))
        (local.set $char_code (call $utf8_decode_at (call $seg_to_string_id (local.get $receiver_pointer)) (local.get $i)))
