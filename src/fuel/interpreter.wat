        (if (f64.eq (local.get $result_f64) (f64.const 0))
          (then (local.set $i32_result (call $bigint_alloc (i32.const 0) (i32.const 0))))
          (else (local.set $i32_result (call $bigint_from_f64 (local.get $result_f64)))))
        (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
        (call $push_bigint (local.get $i32_result))
