        (local.set $arg1_type (call $value_type (local.get $argument1_pointer)))
        (local.set $arg1_lo (call $value_data_lo (local.get $argument1_pointer)))
        (local.set $arg1_hi (call $value_data_hi (local.get $argument1_pointer)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (i32.eq (local.get $arg1_type) (global.get $TYPE_ARRAY))
      (then (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (i32.const 1) (i32.const 0)))
      (else
        (if (i32.eq (local.get $arg1_type) (global.get $TYPE_MSGPACK_REF))
          (then
            (if (i32.eq
                  (call $msgpack_peek_type
                    (call $msgpack_ref_absolute (local.get $arg1_lo) (local.get $arg1_hi))
                    (call $msgpack_ref_parent_end (local.get $arg1_lo)))
                  (global.get $MSGPACK_ARRAY))
              (then (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (i32.const 1) (i32.const 0)))
              (else (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (i32.const 0) (i32.const 0)))
            )
          )
          (else (call $pending_push (global.get $TYPE_BOOLEAN) (i32.const 0) (i32.const 0) (i32.const 0)))
        )
      )
    )
    (return (i32.const 0))
  )

  (func $array_of
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $new_arr i32)
    (local $new_data i32)
    (local $i i32)
    (local $element_pointer i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (call $check_heap_overflow (call $estimate_array_size (local.get $argc)))
      (then (return (i32.const 0))))
    (local.set $new_arr (call $allocate_array (local.get $argc)))
    (local.set $new_data (i32.load (call $abs (i32.add (local.get $new_arr) (i32.const 16)))))
    (local.set $i (i32.const 0))
    (block $array_of_done
      (loop $array_of_copy
        (br_if $array_of_done (i32.ge_u (local.get $i) (local.get $argc)))
        (local.set $element_pointer (i32.add
          (i32.add (local.get $new_data) (global.get $GC_HEADER_SIZE))
          (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
        (i64.store (call $abs (local.get $element_pointer))
          (i64.load (call $abs (i32.add (local.get $argument1_pointer)
            (i32.mul (local.get $i) (global.get $VALUE_SIZE))))))
        (i64.store (call $abs (i32.add (local.get $element_pointer) (i32.const 8)))
          (i64.load (call $abs (i32.add
            (i32.add (local.get $argument1_pointer) (i32.const 8))
            (i32.mul (local.get $i) (global.get $VALUE_SIZE))))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $array_of_copy)
      )
    )
    (call $pending_push (global.get $TYPE_ARRAY) (i32.const 0) (local.get $new_arr) (i32.const 0))
    (return (i32.const 0))
  )

  (func $object_from_entries
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $arg1_type i32)
    (local $arg1_lo i32)
    (local $count i32)
    (local $object_pointer i32)
    (local $entries_pointer i32)
    (local $element_pointer i32)
    (local $key_offset i32)
    (local $i i32)
    (local $data_pointer i32)
    (local $new_data i32)
    (local $arr_len i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
        (local.set $arg1_type (call $value_type (local.get $argument1_pointer)))
        (local.set $arg1_lo (call $value_data_lo (local.get $argument1_pointer)))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))

    (if (i32.eq (local.get $arg1_type) (global.get $TYPE_MAP))
      (then
        (local.set $count (i32.load (call $abs (i32.add (local.get $arg1_lo) (i32.const 8)))))
        (if (call $check_heap_overflow (call $estimate_object_size (local.get $count)))
          (then (return (i32.const 0))))
        (local.set $object_pointer (call $allocate_object (local.get $count)))
        (local.set $entries_pointer (i32.load (call $abs (i32.add (local.get $arg1_lo) (i32.const 20)))))
        (local.set $count (i32.load (call $abs (i32.add (local.get $arg1_lo) (i32.const 12)))))  ;; slotCount
        (local.set $i (i32.const 0))
        (block $from_entries_map_done
          (loop $from_entries_map_walk
            (br_if $from_entries_map_done (i32.ge_u (local.get $i) (local.get $count)))
            (local.set $element_pointer (i32.add
              (i32.add (local.get $entries_pointer) (global.get $GC_HEADER_SIZE))
              (i32.mul (local.get $i) (global.get $MAP_SLOT_STRIDE))))
            (if (i32.eqz (i32.load (call $abs (local.get $element_pointer))))
              (then
                (local.set $key_offset (call $value_to_string
                  (i32.add (local.get $element_pointer) (global.get $MAP_SLOT_KEY_OFFSET))))
                (if (global.get $memory_pressure_signaled)
                  (then (return (i32.const 0))))
                (drop (call $object_set_property (local.get $object_pointer) (local.get $key_offset)
                  (i32.load (call $abs (i32.add (local.get $element_pointer) (global.get $MAP_SLOT_VALUE_OFFSET))))
                  (i32.load (call $abs (i32.add
                    (i32.add (local.get $element_pointer) (global.get $MAP_SLOT_VALUE_OFFSET)) (i32.const 4))))
                  (i32.load (call $abs (i32.add
                    (i32.add (local.get $element_pointer) (global.get $MAP_SLOT_VALUE_OFFSET)) (i32.const 8))))
                  (i32.load (call $abs (i32.add
                    (i32.add (local.get $element_pointer) (global.get $MAP_SLOT_VALUE_OFFSET)) (i32.const 12))))))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $from_entries_map_walk)
          )
        )
        (call $pending_push (global.get $TYPE_OBJECT) (i32.const 0) (local.get $object_pointer) (i32.const 0))
        (return (i32.const 0))
      )
    )
    (if (i32.eq (local.get $arg1_type) (global.get $TYPE_ARRAY))
      (then
        (local.set $count (i32.load (call $abs (i32.add (local.get $arg1_lo) (i32.const 8)))))
        (if (call $check_heap_overflow (call $estimate_object_size (local.get $count)))
          (then (return (i32.const 0))))
        (local.set $object_pointer (call $allocate_object (local.get $count)))
        (local.set $data_pointer (i32.load (call $abs (i32.add (local.get $arg1_lo) (i32.const 16)))))
        (local.set $i (i32.const 0))
        (block $from_entries_done
          (loop $from_entries_walk
            (br_if $from_entries_done (i32.ge_u (local.get $i) (local.get $count)))
            (local.set $element_pointer (i32.add
              (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
              (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
            (if (i32.ne (call $value_type (local.get $element_pointer)) (global.get $TYPE_ARRAY))
              (then
                (return (i32.add (i32.const 1) (call $throw_type_error_with_type
                  (global.get $BUILTIN_MSG_NOT_AN_OBJECT)
                  (call $value_type (local.get $element_pointer)))))))
            (local.set $new_data (call $value_data_lo (local.get $element_pointer)))
            (local.set $arr_len (i32.load (call $abs (i32.add (local.get $new_data) (i32.const 8)))))
            (local.set $entries_pointer (i32.add
              (i32.load (call $abs (i32.add (local.get $new_data) (i32.const 16))))
              (global.get $GC_HEADER_SIZE)))
            (if (i32.eqz (local.get $arr_len))
              (then
                (return (i32.add (i32.const 1) (call $throw_type_error_with_type
                  (global.get $BUILTIN_MSG_NOT_AN_OBJECT) (global.get $TYPE_UNDEFINED))))))
            (local.set $key_offset (call $value_to_string (local.get $entries_pointer)))
            (if (global.get $memory_pressure_signaled)
              (then (return (i32.const 0))))
            (if (i32.ge_u (local.get $arr_len) (i32.const 2))
              (then
                (drop (call $object_set_property (local.get $object_pointer) (local.get $key_offset)
                  (call $value_type (i32.add (local.get $entries_pointer) (global.get $VALUE_SIZE)))
                  (i32.load (call $abs (i32.add (i32.add (local.get $entries_pointer) (global.get $VALUE_SIZE)) (i32.const 4))))
                  (call $value_data_lo (i32.add (local.get $entries_pointer) (global.get $VALUE_SIZE)))
                  (call $value_data_hi (i32.add (local.get $entries_pointer) (global.get $VALUE_SIZE))))))
              (else
                (drop (call $object_set_property (local.get $object_pointer) (local.get $key_offset)
                  (global.get $TYPE_UNDEFINED) (i32.const 0) (i32.const 0) (i32.const 0)))))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br $from_entries_walk)
          )
        )
        (call $pending_push (global.get $TYPE_OBJECT) (i32.const 0) (local.get $object_pointer) (i32.const 0))
        (return (i32.const 0))
      )
    )
    (return (i32.add (i32.const 1) (call $throw_type_error_with_type
      (global.get $BUILTIN_MSG_NOT_ITERABLE) (local.get $arg1_type))))
  )

  (func $number_to_string_method
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_id i32) (param $argc i32) (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument1_pointer i32)
    (local $count i32)
    (local $key_offset i32)
    (local.set $pending_pointer (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ge_u (local.get $argc) (i32.const 1))
      (then
        (local.set $argument1_pointer (i32.sub (local.get $pending_pointer) (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (i32.eqz (call $value_is_numeric (local.get $stack_base)))
      (then
        (return (i32.add (i32.const 1) (call $throw_type_error_with_type
          (global.get $BUILTIN_MSG_CANNOT_CONVERT_TO_NUMBER)
          (call $value_type (local.get $stack_base)))))))
    (local.set $count (i32.const 10))
    (if (i32.and (i32.ge_u (local.get $argc) (i32.const 1))
          (call $value_is_numeric (local.get $argument1_pointer)))
      (then (local.set $count (i32.trunc_sat_f64_s (call $value_to_f64 (local.get $argument1_pointer))))))
    (if (i32.or (i32.lt_s (local.get $count) (i32.const 2)) (i32.gt_s (local.get $count) (i32.const 36)))
      (then
        (return (i32.add (i32.const 1) (call $throw_range_error_with_message
          (global.get $BUILTIN_MSG_INVALID_RADIX))))))
    (if (i32.eq (local.get $count) (i32.const 10))
      (then (local.set $key_offset (call $value_to_string (local.get $stack_base))))
      (else (local.set $key_offset (call $number_to_string_radix
        (call $value_to_f64 (local.get $stack_base)) (local.get $count)))))
    (if (global.get $memory_pressure_signaled)
      (then (return (i32.const 0))))
    (call $pending_push (global.get $TYPE_STRING) (i32.const 0) (local.get $key_offset) (i32.const 0))
    (return (i32.const 0))
  )

