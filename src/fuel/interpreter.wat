  ;; ==========================================================================
  ;; Constants
  ;; ==========================================================================

  ;; String-region interior layout and hash-index split:
  ;;
  ;;   [stringStart .. +8)                reserved prefix (keeps id 0 invalid)
  ;;   [stringStart+8 .. hashTableStart)  interned entries, bump-allocated
  ;;   [hashTableStart .. segmentEnd)     hash index, buckets × 8 bytes
  ;;
  ;; Each bucket: [hash:i32][offset:i32]. The bucket count is DERIVED
  ;; from the region size S = segment_size − string_start as
  ;; floor(S/16) + 1, so the index always holds strictly more buckets
  ;; than the byte region can hold entries (min real entry is 8 bytes:
  ;; 4-byte length + 1 char, 4-aligned; the 4-byte empty-string entry is
  ;; unique by dedup; S must be a multiple of 8 — the JS layout layer
  ;; validates this). Saturation is therefore structurally impossible:
  ;; both the intern probe loop and the GC rebuild always find a free
  ;; bucket, and their exhaustion paths trap. The index lives at the
  ;; REGION TAIL so its derived size can change on a string-table
  ;; resize without shifting interned ids (ids stay offsets from
  ;; string_start; data never moves relative to it).
  ;;
  ;; Derived by $derive_string_index_layout from init_regions /
  ;; refresh_string_region; mirrored in JS by constants.js
  ;; hashTableBuckets/hashTableSize.
  (global $hash_table_buckets (mut i32) (i32.const 0))
  (global $hash_table_size (mut i32) (i32.const 0))
  ;; Segment-relative start of the hash index == end of the data span.
  (global $hash_table_start_seg (mut i32) (i32.const 0))
  ;; Table-relative id of the first real interned entry.
  (global $STRING_DATA_START i32 (i32.const 8))

  ;; FNV-1a constants (32-bit)
  (global $FNV_OFFSET_BASIS i32 (i32.const 0x811c9dc5))
  (global $FNV_PRIME i32 (i32.const 0x01000193))

  ;; Header size (SANDFUEL magic + versions = 16 bytes)
  (global $HEADER_SIZE i32 (i32.const 16))

  ;; State header offsets (must match constants.js, all include HEADER_SIZE)
  ;; v6: Per-execution state moved to context. STATE is now global-only.
  (global $STATE_STRING_POINTER i32 (i32.const 0x14))   ;; 16 + 0x04
  (global $STATE_STRING_START i32 (i32.const 0x20))     ;; 16 + 0x10
  (global $STATE_SEGMENT_SIZE i32 (i32.const 0x24))     ;; 16 + 0x14

  ;; ==========================================================================
  ;; Internal: base_offset global (set by init)
  ;; ==========================================================================
  (global $base_offset (mut i32) (i32.const 0))

  ;; ==========================================================================
  ;; init_segment(base_offset)
  ;;
  ;; Initialize the interpreter for a memory segment.
  ;; Must be called before any other functions.
  ;; ==========================================================================
  (func $init_segment (export "init_segment")
    (param $base i32)
    (global.set $base_offset (local.get $base))
  )

  ;; ==========================================================================
  ;; init_regions()
  ;;
  ;; Read region base offsets from STATE into WASM globals.
  ;; Must be called after JS has written region bases to STATE.
  ;; Context base is computed in run() from the context parameter.
  ;; ==========================================================================
  (func $init_regions (export "init_regions")
    ;; $external_request_base is NOT loaded here since layout v8: it is
    ;; a per-run cache of the CURRENT context's request block
    ;; (context base + CTX_REQUEST_BLOCK), recomputed at run() entry
    ;; alongside $current_context_base.
    (global.set $error_info_base (call $read_state (global.get $STATE_ERROR_INFO_BASE)))
    (global.set $builtins_base (call $read_state (global.get $STATE_BUILTINS_BASE)))
    (global.set $string_start (call $read_state (global.get $STATE_STRING_START)))
    (global.set $segment_size (call $read_state (global.get $STATE_SEGMENT_SIZE)))
    (call $derive_string_index_layout)
  )

  ;; ==========================================================================
  ;; derive_string_index_layout()
  ;;
  ;; Compute the hash-index sizing globals from the cached string-region
  ;; bounds (see the globals' comment for the invariant). Must run after
  ;; every write of $string_start / $segment_size.
  ;; ==========================================================================
  (func $derive_string_index_layout
    (global.set $hash_table_buckets
      (i32.add
        (i32.shr_u
          (i32.sub (global.get $segment_size) (global.get $string_start))
          (i32.const 4))
        (i32.const 1)))
    (global.set $hash_table_size
      (i32.mul (global.get $hash_table_buckets) (i32.const 8)))
    (global.set $hash_table_start_seg
      (i32.sub (global.get $segment_size) (global.get $hash_table_size)))
  )

  ;; ==========================================================================
  ;; refresh_string_region()
  ;;
  ;; Re-read STATE.STRING_START and STATE.SEGMENT_SIZE into the cached
  ;; WAT globals. Called by the SS-region-resize primitive after it
  ;; moves the string table and updates the header. Both fields change
  ;; together on a resize, so the refresh is paired. Cheaper than
  ;; re-running init_regions because the other base globals don't move.
  ;; ==========================================================================
  (func $refresh_string_region (export "refresh_string_region")
    (global.set $string_start (call $read_state (global.get $STATE_STRING_START)))
    (global.set $segment_size (call $read_state (global.get $STATE_SEGMENT_SIZE)))
    (call $derive_string_index_layout)
  )

  ;; Enable the pending-base watchpoint (see the globals' comment).
  (func $watch_pending_base_enable (export "watch_pending_base_enable")
    (global.set $watch_pending_enabled (i32.const 1)))

  ;; Strict operand-stack mode: a NORMAL-execution pop at base becomes a
  ;; fatal ERR_STACK_UNDERFLOW trap instead of a counted sentinel.
  ;; ON by default; disable is the escape hatch (SS_STRICT_STACK=0).
  (func $strict_stack_enable (export "strict_stack_enable")
    (global.set $strict_stack_enabled (i32.const 1)))
  (func $strict_stack_disable (export "strict_stack_disable")
    (global.set $strict_stack_enabled (i32.const 0)))

  ;; Read the underflow counter (NORMAL-execution clamp engagements).
  (func $stack_underflow_count_get (export "stack_underflow_count")
    (result i32)
    (global.get $stack_underflow_count))

  ;; ==========================================================================
  ;; cached_* getters
  ;;
  ;; Expose the cached region globals for the host-side region-globals
  ;; audit (MemoryImage.auditRegionGlobals): every value here must equal
  ;; its STATE-header source at any host-observable quiescent point. A
  ;; mismatch means a resize/relocate path skipped init_regions /
  ;; refresh_string_region — reads then go systematically wrong while
  ;; the stored heap stays intact (the "read path" fault class).
  ;; ==========================================================================
  (func $cached_base_offset (export "cached_base_offset") (result i32)
    (global.get $base_offset))
  (func $cached_external_request_base (export "cached_external_request_base") (result i32)
    (global.get $external_request_base))
  (func $cached_error_info_base (export "cached_error_info_base") (result i32)
    (global.get $error_info_base))
  (func $cached_builtins_base (export "cached_builtins_base") (result i32)
    (global.get $builtins_base))
  (func $cached_string_start (export "cached_string_start") (result i32)
    (global.get $string_start))
  (func $cached_segment_size (export "cached_segment_size") (result i32)
    (global.get $segment_size))
  (func $cached_hash_table_start (export "cached_hash_table_start") (result i32)
    (global.get $hash_table_start_seg))

  ;; ==========================================================================
  ;; gc_shrinkable_high_water_mark() → i32
  ;;
  ;; Returns the high-water mark of the current live set as a
  ;; segment-relative offset: the smallest value an SS-region resize
  ;; can shrink `heap_end` down to without losing live data.
  ;;
  ;; The caller is responsible for having compacted the heap first
  ;; (post-compact, live data is in [heap_start, heap_pointer) and
  ;; everything past heap_pointer is reclaimable). Any allocation
  ;; between compact and reading this value will move the HWM, so
  ;; the shrink path must be quiescent. Host compaction handshakes
  ;; require the same protocol.
  ;;
  ;; Implementation: STATE_HEAP_POINTER is already the bump-allocator's
  ;; high-water mark; compactHeap updates it to the post-move position.
  ;; No new state needed (Option (a) from the plan).
  ;; ==========================================================================
  (func $gc_shrinkable_high_water_mark
        (export "gc_shrinkable_high_water_mark")
        (result i32)
    (call $read_state (global.get $STATE_HEAP_POINTER))
  )

  ;; ==========================================================================
  ;; check_concat_scratch_overflow(total_len) → i32
  ;;
  ;; Pre-check used by string-allocating opcodes that stage results
  ;; into heap-tail scratch (the bytes past STATE_HEAP_POINTER) before
  ;; calling $intern_string. Verifies the scratch write of $total_len
  ;; bytes won't overlap the bytecode region. If it would, signals
  ;; pressure (sets $memory_pressure_signaled, returns 1) and the
  ;; caller can skip the staging+intern entirely. Returns 0 on safe.
  ;;
  ;; Same shape as $string_concat's internal check, factored out so
  ;; the 8 string methods (slice, substring, toLowerCase, etc.) can
  ;; share the same intern-and-deduplicate path.
  ;; ==========================================================================
  (func $check_concat_scratch_overflow (param $total_len i32) (result i32)
    (if (i32.ge_u
          (i32.add
            (call $read_state (global.get $STATE_HEAP_POINTER))
            (local.get $total_len))
          (call $read_state (global.get $STATE_CODE_POINTER)))
      (then
        (global.set $memory_pressure_signaled (i32.const 1))
        (return (i32.const 1))
      )
    )
    (i32.const 0)
  )

  ;; ==========================================================================
  ;; memory_pressure_signaled() → i32
  ;;
  ;; Read the memory-pressure flag. Set to 1 by $intern_string or
  ;; $string_concat when a bounds check would overflow; reset to 0 by
  ;; the dispatcher's $run on entry. Exposed so the JS host can detect
  ;; pressure from parse-time interning (where there is no dispatcher
  ;; running) and surface it as a clean throw rather than letting an
  ;; id=0 sentinel propagate into the bytecode.
  ;; ==========================================================================
  (func $memory_pressure_signaled_export
        (export "memory_pressure_signaled")
        (result i32)
    (global.get $memory_pressure_signaled)
  )

  ;; ==========================================================================
  ;; clear_memory_pressure()
  ;;
  ;; Reset the pressure flag. Called by the JS host after it has read
  ;; the signal at parse time (where there is no dispatcher to reset
  ;; it). The interpreter's $run resets the flag on entry, so this
  ;; export is only needed for parse-time use.
  ;; ==========================================================================
  (func $clear_memory_pressure (export "clear_memory_pressure")
    (global.set $memory_pressure_signaled (i32.const 0))
  )

  ;; ==========================================================================
  ;; check_heap_overflow(total_size) → i32
  ;;
  ;; Pre-check used by every PRIMARY heap allocator. Verifies that bumping
  ;; STATE_HEAP_POINTER by $total_size bytes would not cross into the
  ;; bytecode region (STATE_CODE_POINTER). If it would, signals pressure
  ;; (sets $memory_pressure_signaled, returns 1) so the allocator can
  ;; return a sentinel 0 pointer and the caller can yield with
  ;; EXIT_MEMORY_PRESSURE.
  ;;
  ;; Multi-bump allocators (header + entries, array + data, etc.) compute
  ;; their total aligned size upfront and call this once, rather than
  ;; checking before each bump. Same shape as $check_concat_scratch_overflow
  ;; but for heap (committed) writes, not heap-tail scratch writes.
  ;;
  ;; The pressure flag is observed at opcode boundaries.
  ;; ==========================================================================
  (func $check_heap_overflow (param $total_size i32) (result i32)
    ;; Use ge_u (not gt_u) to match the dispatcher's per-instruction
    ;; heap-vs-code safeguard at $run line ~25366. Equal means the very
    ;; next allocation would overrun, which the dispatcher also treats
    ;; as OOM. Pre-emptively signaling pressure at the equality point
    ;; keeps the contracts aligned and avoids hitting the dispatcher
    ;; safeguard (which surfaces ERR_OUT_OF_MEMORY, bypassing pressure
    ;; recovery).
    (if (i32.or
          (global.get $memory_pressure_signaled)
          (i64.ge_u
            (i64.add
              (i64.extend_i32_u (call $read_state (global.get $STATE_HEAP_POINTER)))
              (i64.extend_i32_u (local.get $total_size)))
            (i64.extend_i32_u (call $read_state (global.get $STATE_CODE_POINTER)))))
      (then
        (global.set $memory_pressure_signaled (i32.const 1))
        (return (i32.const 1))
      )
    )
    (i32.const 0)
  )

  ;; ==========================================================================
  ;; signal_memory_pressure()
  ;;
  ;; Set the WAT-side pressure flag from JS. Used by MemoryImage.allocate
  ;; (memory-image.js) when its own JS-side overflow check fires: instead
  ;; of throwing 'Heap overflow', it calls this export and returns a
  ;; sentinel 0 pointer, letting the runtime's existing memory_pressure
  ;; recovery path handle GC + retry.
  ;; ==========================================================================
  (func $signal_memory_pressure (export "signal_memory_pressure")
    (global.set $memory_pressure_signaled (i32.const 1))
  )

  ;; ==========================================================================
  ;; Context accessor helpers (v6)
  ;;
  ;; Stack operations use current_context_base + offset to compute addresses.
  ;; These helpers provide the base addresses for each stack type.
  ;; ==========================================================================

  ;; Design B: current_context_base points at the context object, which IS the
  ;; state block (offset 0). Each stack lives in its own STACK_BLOCK heap object;
  ;; the state block stores its segment-relative base in CTX_*_BASE.
  ;;
  ;; The "*_seg" helpers return the segment-relative stack base (what the top
  ;; pointers are measured against); the plain helpers add base_offset for an
  ;; absolute address. Reading the field, not computing base + constant, is the
  ;; one change that lets a stack block relocate independently.

  ;; Get absolute address of context state block (= the context object itself)
  (func $get_context_state (result i32)
    (i32.add (global.get $base_offset) (global.get $current_context_base))
  )

  ;; Segment-relative stack bases (read from the state block)
  (func $pending_base_seg (result i32)
    (call $read_ctx (global.get $CTX_PENDING_BASE)))
  (func $call_stack_base_seg (result i32)
    (call $read_ctx (global.get $CTX_CALL_STACK_BASE)))
  (func $try_stack_base_seg (result i32)
    (call $read_ctx (global.get $CTX_TRY_STACK_BASE)))
  (func $grant_stack_base_seg (result i32)
    (call $read_ctx (global.get $CTX_GRANT_STACK_BASE)))

  ;; Get context pending stack base (absolute address)
  (func $get_pending_base (result i32)
    (i32.add (global.get $base_offset) (call $pending_base_seg)))

  ;; Get context call stack base (absolute address)
  (func $get_call_stack_base (result i32)
    (i32.add (global.get $base_offset) (call $call_stack_base_seg)))

  ;; Get context try stack base (absolute address)
  (func $get_try_stack_base (result i32)
    (i32.add (global.get $base_offset) (call $try_stack_base_seg)))

  ;; Get context grant stack base (absolute address)
  (func $get_grant_stack_base (result i32)
    (i32.add (global.get $base_offset) (call $grant_stack_base_seg)))

  ;; Read a field from the current context's state block
  (func $read_ctx (param $field_offset i32) (result i32)
    (i32.load (i32.add (call $get_context_state) (local.get $field_offset)))
  )

  ;; Write a field to the current context's state block
  (func $write_ctx (param $field_offset i32) (param $value i32)
    (i32.store (i32.add (call $get_context_state) (local.get $field_offset)) (local.get $value))
  )

  ;; ==========================================================================
  ;; init_string_table()
  ;;
  ;; Zero the hash index (at the region tail) and the reserved prefix.
  ;; Call after init_regions (needs the derived sizing globals).
  ;; ==========================================================================
  (func $init_string_table (export "init_string_table")
    (memory.fill
      (i32.add (global.get $base_offset) (global.get $hash_table_start_seg))
      (i32.const 0)
      (global.get $hash_table_size))
    (memory.fill
      (i32.add (global.get $base_offset) (global.get $string_start))
      (i32.const 0)
      (global.get $STRING_DATA_START))
  )

  ;; ==========================================================================
  ;; fnv1a(pointer, len) → hash
  ;;
  ;; Compute FNV-1a hash of bytes at pointer..pointer+len
  ;; ==========================================================================
  (func $fnv1a (param $pointer i32) (param $len i32) (result i32)
    (local $hash i32)
    (local $end i32)
    (local $byte i32)

    (local.set $hash (global.get $FNV_OFFSET_BASIS))
    (local.set $end (i32.add (local.get $pointer) (local.get $len)))

    (block $done
      (loop $loop
        (br_if $done (i32.ge_u (local.get $pointer) (local.get $end)))

        ;; hash ^= byte
        (local.set $byte (i32.load8_u (local.get $pointer)))
        (local.set $hash (i32.xor (local.get $hash) (local.get $byte)))

        ;; hash *= FNV_PRIME
        (local.set $hash (i32.mul (local.get $hash) (global.get $FNV_PRIME)))

        (local.set $pointer (i32.add (local.get $pointer) (i32.const 1)))
        (br $loop)
      )
    )

    (local.get $hash)
  )

  ;; ==========================================================================
  ;; strings_equal(pointer1, len1, pointer2, len2) → bool
  ;;
  ;; Compare two byte sequences for equality.
  ;; ==========================================================================
  (func $strings_equal
    (param $pointer1 i32) (param $len1 i32)
    (param $pointer2 i32) (param $len2 i32)
    (result i32)
    (local $end i32)

    ;; Different lengths → not equal
    (if (i32.ne (local.get $len1) (local.get $len2))
      (then (return (i32.const 0)))
    )

    ;; Compare bytes
    (local.set $end (i32.add (local.get $pointer1) (local.get $len1)))
    (block $done
      (loop $loop
        (br_if $done (i32.ge_u (local.get $pointer1) (local.get $end)))

        (if (i32.ne
              (i32.load8_u (local.get $pointer1))
              (i32.load8_u (local.get $pointer2)))
          (then (return (i32.const 0)))
        )

        (local.set $pointer1 (i32.add (local.get $pointer1) (i32.const 1)))
        (local.set $pointer2 (i32.add (local.get $pointer2) (i32.const 1)))
        (br $loop)
      )
    )

    (i32.const 1)
  )

  ;; ==========================================================================
  ;; ==========================================================================
  ;; string_id_to_abs(id) → absolute byte address
  ;;
  ;; Convert a string-table-relative id to its absolute byte address in
  ;; the WASM linear memory. Reads the cached $string_start global plus
  ;; $base_offset and adds the id.
  ;;
  ;; The id is the byte offset from $string_start to the entry's length
  ;; prefix. Valid ids satisfy STRING_DATA_START <= id <
  ;; hash_table_start_seg - string_start; ids in [0, STRING_DATA_START)
  ;; are the reserved prefix (id 0 stays the invalid/pressure
  ;; sentinel). The hash index lives at the region TAIL, past the data
  ;; span.
  ;; ==========================================================================
  (func $string_id_to_abs (param $id i32) (result i32)
    (i32.add
      (i32.add (global.get $base_offset) (global.get $string_start))
      (local.get $id)))

  ;; ==========================================================================
  ;; string_id_to_seg(id) → segment-relative offset of the entry
  ;;
  ;; Counterpart to $string_id_to_abs that returns a segment-relative
  ;; offset rather than an absolute memory address. Useful when the
  ;; caller needs a segment-relative pointer to pass downstream (e.g.
  ;; to helpers that themselves apply `call $abs`).
  ;; ==========================================================================
  (func $string_id_to_seg (param $id i32) (result i32)
    (i32.add (global.get $string_start) (local.get $id)))

  ;; ==========================================================================
  ;; string_id_bytes_seg(id) → segment-relative offset of the bytes
  ;;
  ;; Returns the segment-relative pointer to the first UTF-8 byte of the
  ;; string entry (skips the 4-byte length prefix).
  ;; ==========================================================================
  (func $string_id_bytes_seg (param $id i32) (result i32)
    (i32.add
      (i32.add (global.get $string_start) (local.get $id))
      (i32.const 4)))

  ;; ==========================================================================
  ;; seg_to_string_id(seg_offset) → table-relative id
  ;;
  ;; Inverse of $string_id_to_seg. Used by inline string-table
  ;; allocators (array.join, string_concat, etc.) that bump-allocate at
  ;; the segment-relative STATE.STRING_POINTER and need to publish the
  ;; resulting entry as a table-relative id.
  ;; ==========================================================================
  (func $seg_to_string_id (param $seg_offset i32) (result i32)
    (i32.sub (local.get $seg_offset) (global.get $string_start)))

  ;; ==========================================================================
  ;; intern_string(pointer, len) → string_id
  ;;
  ;; Intern a string. pointer/len point to UTF-8 bytes in memory.
  ;; Returns a table-relative string id (byte offset within the string
  ;; table region). If string already exists, returns existing id
  ;; (deduplication).
  ;;
  ;; String entry format: [length:i32][bytes...]
  ;; Entries are 4-byte aligned.
  ;; ==========================================================================
  (func $intern_string (export "intern_string")
    (param $pointer i32) (param $len i32)
    (result i32)
    (local $hash i32)
    (local $bucket_index i32)
    (local $hash_table_start i32)
    (local $bucket_pointer i32)
    (local $stored_hash i32)
    (local $stored_offset i32)
    (local $abs_stored_pointer i32)
    (local $stored_len i32)
    (local $probe i32)
    (local $string_pointer i32)
    (local $abs_string_pointer i32)
    (local $entry_size i32)
    (local $aligned_size i32)

    ;; Compute hash
    (local.set $hash (call $fnv1a (local.get $pointer) (local.get $len)))

    ;; bucket_index = hash % hash_table_buckets
    (local.set $bucket_index
      (i32.rem_u (local.get $hash) (global.get $hash_table_buckets))
    )

    ;; hash_table_start = base_offset + hash_table_start_seg (index at
    ;; the region tail; derived by $derive_string_index_layout)
    (local.set $hash_table_start
      (i32.add (global.get $base_offset) (global.get $hash_table_start_seg))
    )

    ;; Linear probing
    (local.set $probe (i32.const 0))
    (block $found
      (block $not_found
        (loop $probe_loop
          ;; Exhausting every bucket is a proven-impossible state: the
          ;; index is sized to hold strictly more buckets than the data
          ;; span can hold entries (see the sizing globals' comment), so
          ;; the probe always meets a free bucket or a match first. The
          ;; Reaching the probe bound means no bucket can be selected.
          ;; Trap rather than evicting a live bucket, because eviction
          ;; would silently violate string deduplication if the sizing
          ;; math ever permits a completely full table.
          (if (i32.ge_u (local.get $probe) (global.get $hash_table_buckets))
            (then (unreachable))
          )

          ;; bucket_pointer = hash_table_start + ((bucket_index + probe) % buckets) * 8
          (local.set $bucket_pointer
            (i32.add
              (local.get $hash_table_start)
              (i32.mul
                (i32.rem_u
                  (i32.add (local.get $bucket_index) (local.get $probe))
                  (global.get $hash_table_buckets)
                )
                (i32.const 8)
              )
            )
          )

          ;; Read bucket
          (local.set $stored_hash (i32.load (local.get $bucket_pointer)))
          (local.set $stored_offset (i32.load (i32.add (local.get $bucket_pointer) (i32.const 4))))

          ;; Empty bucket → insert here
          (if (i32.eqz (local.get $stored_offset))
            (then (br $not_found))
          )

          ;; Check if same string
          (if (i32.eq (local.get $stored_hash) (local.get $hash))
            (then
              ;; Compare actual bytes. stored_offset is table-relative;
              ;; convert to absolute for the byte-compare.
              (local.set $abs_stored_pointer
                (call $string_id_to_abs (local.get $stored_offset))
              )
              (local.set $stored_len (i32.load (local.get $abs_stored_pointer)))

              (if (call $strings_equal
                    (local.get $pointer)
                    (local.get $len)
                    (i32.add (local.get $abs_stored_pointer) (i32.const 4))
                    (local.get $stored_len))
                (then
                  ;; Found existing string — return its table-relative id.
                  (return (local.get $stored_offset))
                )
              )
            )
          )

          ;; Try next bucket
          (local.set $probe (i32.add (local.get $probe) (i32.const 1)))
          (br $probe_loop)
        )
      )

      ;; Not found - allocate new string entry

      ;; Read current string_pointer from state header
      (local.set $string_pointer
        (i32.load (i32.add (global.get $base_offset) (global.get $STATE_STRING_POINTER)))
      )

      ;; entry_size = 4 (length) + len (bytes)
      ;; aligned_size = (entry_size + 3) & ~3
      (local.set $entry_size (i32.add (i32.const 4) (local.get $len)))
      (local.set $aligned_size
        (i32.and
          (i32.add (local.get $entry_size) (i32.const 3))
          (i32.const 0xfffffffc)
        )
      )

      ;; Memory-pressure check: would this new allocation run into the
      ;; hash index at the region tail? If yes, set the global pressure
      ;; flag and return the sentinel id 0. The caller chain bubbles
      ;; back up to an opcode handler, which checks
      ;; $memory_pressure_signaled before consuming operands and yields
      ;; with EXIT_MEMORY_PRESSURE. Nothing is written to the string
      ;; table or bucket on this path — the state is exactly as it was
      ;; on entry, allowing an opcode-boundary retry.
      (if (i32.gt_u
            (i32.add (local.get $string_pointer) (local.get $aligned_size))
            (global.get $hash_table_start_seg))
        (then
          (global.set $memory_pressure_signaled (i32.const 1))
          (return (i32.const 0))
        )
      )

      ;; Write string entry at string_pointer
      (local.set $abs_string_pointer
        (i32.add (global.get $base_offset) (local.get $string_pointer))
      )

      ;; Write length
      (i32.store (local.get $abs_string_pointer) (local.get $len))

      ;; Copy bytes
      (memory.copy
        (i32.add (local.get $abs_string_pointer) (i32.const 4))
        (local.get $pointer)
        (local.get $len)
      )

      ;; Update bucket. The payload column stores the table-relative
      ;; id (string_pointer is segment-relative; subtract string_start).
      (i32.store (local.get $bucket_pointer) (local.get $hash))
      (i32.store (i32.add (local.get $bucket_pointer) (i32.const 4))
        (i32.sub (local.get $string_pointer) (global.get $string_start)))

      ;; Update string_pointer in state header (stays segment-relative).
      (i32.store
        (i32.add (global.get $base_offset) (global.get $STATE_STRING_POINTER))
        (i32.add (local.get $string_pointer) (local.get $aligned_size))
      )

      ;; Return the table-relative id of the entry we just allocated.
      (return (i32.sub (local.get $string_pointer) (global.get $string_start)))
    )

    ;; Unreachable
    (unreachable)
  )

  ;; ==========================================================================
  ;; read_string_len(id) → length
  ;;
  ;; Read the byte length of a string entry given its table-relative id.
  ;; ==========================================================================
  (func $read_string_len (export "read_string_len")
    (param $id i32) (result i32)
    (i32.load (call $string_id_to_abs (local.get $id)))
  )

  ;; ==========================================================================
  ;; get_string_pointer(id) → absolute_pointer
  ;;
  ;; Get absolute pointer to string bytes (after length prefix) given a
  ;; table-relative id.
  ;; ==========================================================================
  (func $get_string_pointer (export "get_string_ptr")
    (param $id i32) (result i32)
    (i32.add
      (call $string_id_to_abs (local.get $id))
      (i32.const 4)
    )
  )

  ;; ==========================================================================
  ;; string_concat(offset1, offset2) → new_string_offset
  ;;
  ;; Concatenate two strings and return the interned result.
  ;; Uses heap space beyond heap_pointer as scratch (doesn't move pointer).
  ;; ==========================================================================
  (func $string_concat (param $offset1 i32) (param $offset2 i32) (result i32)
    (local $len1 i32)
    (local $len2 i32)
    (local $total_len i32)
    (local $scratch_pointer i32)
    (local $source1_pointer i32)
    (local $source2_pointer i32)

    ;; Get lengths
    (local.set $len1 (call $read_string_len (local.get $offset1)))
    (local.set $len2 (call $read_string_len (local.get $offset2)))
    (local.set $total_len (i32.add (local.get $len1) (local.get $len2)))

    ;; Memory-pressure pre-check: would the heap-tail scratch overlap
    ;; the bytecode region? heap_pointer + total_len must stay below
    ;; code_pointer to avoid corrupting code. If it would overflow,
    ;; signal pressure and return sentinel — caller chain bubbles back
    ;; to the opcode boundary without mutating the string table.
    (if (i32.ge_u
          (i32.add
            (call $read_state (global.get $STATE_HEAP_POINTER))
            (local.get $total_len))
          (call $read_state (global.get $STATE_CODE_POINTER)))
      (then
        (global.set $memory_pressure_signaled (i32.const 1))
        (return (i32.const 0))
      )
    )

    ;; Use space beyond heap pointer as scratch (absolute address)
    (local.set $scratch_pointer
      (call $abs (call $read_state (global.get $STATE_HEAP_POINTER))))

    ;; Get source pointers (absolute)
    (local.set $source1_pointer (call $get_string_pointer (local.get $offset1)))
    (local.set $source2_pointer (call $get_string_pointer (local.get $offset2)))

    ;; Copy first string
    (memory.copy
      (local.get $scratch_pointer)
      (local.get $source1_pointer)
      (local.get $len1))

    ;; Copy second string
    (memory.copy
      (i32.add (local.get $scratch_pointer) (local.get $len1))
      (local.get $source2_pointer)
      (local.get $len2))

    ;; Intern the concatenated string (scratch_pointer is absolute, intern expects absolute).
    ;; If $intern_string detects string-table overflow it will set
    ;; $memory_pressure_signaled and return 0; we propagate that.
    (call $intern_string (local.get $scratch_pointer) (local.get $total_len))
  )

  ;; ==========================================================================
  ;; array_join(array_pointer, separator_string_id) → string_offset
  ;;
  ;; Backs Array.prototype.toString (with separator=",") and
  ;; Array.prototype.join (with the user-supplied separator). Each element
  ;; is stringified via $value_to_string; null and undefined elements
  ;; stringify to "" (matches the JS spec for Array.prototype.join).
  ;; Elements are concatenated via repeated $string_concat — O(n²) for
  ;; very long arrays but simple and correct, and matches the
  ;; concat-heavy patterns already in this module.
  ;;
  ;; Cycles (e.g. let a = []; a.push(a); String(a)) are NOT detected.
  ;; They will recurse until fuel exhausts. Matches the v1 conservatism
  ;; elsewhere in this work.
  ;; ==========================================================================
  (func $array_join (param $array_pointer i32) (param $separator i32) (result i32)
    (local $arr_len i32)
    (local $data_pointer i32)
    (local $i i32)
    (local $element_pointer i32)
    (local $element_type i32)
    (local $element_str i32)
    (local $sep_len i32)
    (local $total_len i32)
    (local $scratch_base i32)
    (local $write_pointer i32)
    (local $str_len i32)
    (local $result_id i32)
    (local $ids_array i32)
    (local $ids_data i32)

    ;; Array layout: [GC:8][length:4 @+8][capacity:4 @+12][data_pointer:4 @+16]
    (local.set $arr_len (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 8)))))
    (local.set $data_pointer (i32.load (call $abs (i32.add (local.get $array_pointer) (i32.const 16)))))

    ;; Empty array → "".
    (if (i32.eqz (local.get $arr_len))
      (then (return (call $read_builtin (global.get $BUILTIN_LIT_EMPTY_STRING))))
    )

    (local.set $sep_len (call $read_string_len (local.get $separator)))

    ;; Pass 1: stringify each element ONCE, caching the interned string
    ;; ids in a scratch heap array, and sum the total byte length.
    ;;
    ;; The cache is load-bearing, not an optimization: pass 2 writes the
    ;; joined bytes into heap-tail scratch, and re-stringifying there
    ;; would ALLOCATE mid-write ($f64_to_string and the exact-number
    ;; formatters build heap bigints), stamping GC headers straight over
    ;; the accumulated bytes. (That was a real bug: float elements made
    ;; join return header bytes — [2.0, 1].join(",") gave "\x20\x00...".)
    (if (call $check_heap_overflow (call $estimate_array_size (local.get $arr_len)))
      (then (return (i32.const 0))))
    (local.set $ids_array (call $allocate_array (local.get $arr_len)))
    (local.set $ids_data (i32.add
      (i32.load (call $abs (i32.add (local.get $ids_array) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))

    (local.set $total_len (i32.const 0))
    (local.set $i (i32.const 0))
    (block $sum_done
      (loop $sum_next
        (br_if $sum_done (i32.ge_u (local.get $i) (local.get $arr_len)))

        (local.set $element_pointer (i32.add
          (i32.add (local.get $data_pointer) (global.get $GC_HEADER_SIZE))
          (i32.mul (local.get $i) (global.get $VALUE_SIZE))))
        (local.set $element_type (call $value_type (local.get $element_pointer)))
        (if (i32.or
              (i32.eq (local.get $element_type) (global.get $TYPE_NULL))
              (i32.eq (local.get $element_type) (global.get $TYPE_UNDEFINED)))
          (then
            (local.set $element_str (call $read_builtin (global.get $BUILTIN_LIT_EMPTY_STRING))))
          (else
            (local.set $element_str (call $value_to_string (local.get $element_pointer)))
            (if (global.get $memory_pressure_signaled)
              (then (return (i32.const 0))))
          )
        )
        ;; Cache the id as a TYPE_STRING quad (keeps the walker happy if
        ;; a collection ever scans the block).
        (i32.store (call $abs (i32.add (local.get $ids_data)
          (i32.mul (local.get $i) (global.get $VALUE_SIZE)))) (global.get $TYPE_STRING))
        (i32.store (call $abs (i32.add
          (i32.add (local.get $ids_data) (i32.const 4))
          (i32.mul (local.get $i) (global.get $VALUE_SIZE)))) (i32.const 0))
        (i32.store (call $abs (i32.add
          (i32.add (local.get $ids_data) (i32.const 8))
          (i32.mul (local.get $i) (global.get $VALUE_SIZE)))) (local.get $element_str))
        (i32.store (call $abs (i32.add
          (i32.add (local.get $ids_data) (i32.const 12))
          (i32.mul (local.get $i) (global.get $VALUE_SIZE)))) (i32.const 0))

        (local.set $total_len (i32.add (local.get $total_len)
          (call $read_string_len (local.get $element_str))))
        (if (i32.gt_u (local.get $i) (i32.const 0))
          (then
            (local.set $total_len (i32.add (local.get $total_len) (local.get $sep_len))))
        )

        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $sum_next)
      )
    )

    ;; Pre-check scratch space for the final intern.
    (if (call $check_concat_scratch_overflow (local.get $total_len))
      (then (return (i32.const 0)))
    )

    ;; Pass 2: copy the cached strings' bytes into heap-tail scratch —
    ;; NO allocations happen in this loop.
    (local.set $scratch_base
      (call $abs (call $read_state (global.get $STATE_HEAP_POINTER))))
    (local.set $write_pointer (local.get $scratch_base))

    (local.set $i (i32.const 0))
    (block $write_done
      (loop $write_next
        (br_if $write_done (i32.ge_u (local.get $i) (local.get $arr_len)))

        ;; Separator before all but the first element.
        (if (i32.gt_u (local.get $i) (i32.const 0))
          (then
            (memory.copy
              (local.get $write_pointer)
              (call $abs (call $string_id_bytes_seg (local.get $separator)))
              (local.get $sep_len))
            (local.set $write_pointer (i32.add (local.get $write_pointer) (local.get $sep_len)))
          )
        )

        (local.set $element_str (i32.load (call $abs (i32.add
          (i32.add (local.get $ids_data) (i32.const 8))
          (i32.mul (local.get $i) (global.get $VALUE_SIZE))))))
        (local.set $str_len (call $read_string_len (local.get $element_str)))
        (if (local.get $str_len)
          (then
            (memory.copy
              (local.get $write_pointer)
              (call $abs (call $string_id_bytes_seg (local.get $element_str)))
              (local.get $str_len))
            (local.set $write_pointer (i32.add (local.get $write_pointer) (local.get $str_len)))
          )
        )

        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $write_next)
      )
    )

    ;; Intern the final joined bytes.
    (local.set $result_id (call $intern_string (local.get $scratch_base) (local.get $total_len)))
    (if (global.get $memory_pressure_signaled)
      (then (return (i32.const 0))))
    (local.get $result_id)
  )

  ;; array_to_string(array_pointer) → string_offset
  ;;
  ;; Convenience wrapper: $array_join(array, ","). Used by implicit
  ;; string-coercion paths (template literals, "" + arr, String(arr),
  ;; Array.prototype.toString).
  ;; ==========================================================================
  (func $array_to_string (param $array_pointer i32) (result i32)
    (local $comma_id i32)
    (local $scratch_base i32)

    ;; Intern "," — intern_string dedups, so the cost amortizes to a hash
    ;; lookup after the first call.
    (local.set $scratch_base (call $scratch_ptr (i32.const 0) (i32.const 1)))
    (i32.store8 (local.get $scratch_base) (i32.const 44)) ;; ','
    (local.set $comma_id (call $intern_string (local.get $scratch_base) (i32.const 1)))
    (call $array_join (local.get $array_pointer) (local.get $comma_id))
  )

  ;; typed_array_to_string(type, descriptor_pointer) → string_offset
  ;;
  ;; ToString for typed arrays: comma-joined decimal elements, matching
  ;; JS (Array.prototype.toString via join(",")). Same two-pass shape as
  ;; $array_join — stringify every element FIRST, caching interned ids
  ;; in a heap array, then writes into heap-tail scratch and interns once.
  ;; Elements are read as f64 via $read_typed_element, matching
  ;; $typed_array_join including its lossy BigInt64 convention.
  ;; On pressure, signal and return 0 so the coercing opcode can retry.
  ;; Explicit typed-array conversion prevents the unsupported-value
  ;; empty-string fallback from discarding the elements.




  (func $typed_array_to_string (param $type i32) (param $descriptor_pointer i32) (result i32)
    (local $arr_len i32)
    (local $data_pointer i32)
    (local $start_idx i32)
    (local $bytes_per_element i32)
    (local $i i32)
    (local $element_str i32)
    (local $total_len i32)
    (local $scratch_base i32)
    (local $write_pointer i32)
    (local $str_len i32)
    (local $result_id i32)
    (local $ids_array i32)
    (local $ids_data i32)

    ;; Descriptor layout: [buffer_ptr:4][byte_offset:4][length:4]
    (local.set $data_pointer (i32.load (call $abs (local.get $descriptor_pointer))))
    (local.set $start_idx (i32.load (call $abs (i32.add (local.get $descriptor_pointer) (i32.const 4)))))
    (local.set $arr_len (i32.load (call $abs (i32.add (local.get $descriptor_pointer) (i32.const 8)))))

    (if (i32.eqz (local.get $arr_len))
      (then (return (call $read_builtin (global.get $BUILTIN_LIT_EMPTY_STRING))))
    )

    (local.set $bytes_per_element (call $get_bytes_per_element (local.get $type)))

    ;; Pass 1: stringify each element, caching ids (load-bearing — see
    ;; $array_join's pass-1 comment).
    (if (call $check_heap_overflow (call $estimate_array_size (local.get $arr_len)))
      (then (return (i32.const 0))))
    (local.set $ids_array (call $allocate_array (local.get $arr_len)))
    (local.set $ids_data (i32.add
      (i32.load (call $abs (i32.add (local.get $ids_array) (i32.const 16))))
      (global.get $GC_HEADER_SIZE)))

    (local.set $total_len (i32.const 0))
    (local.set $i (i32.const 0))
    (block $sum_done
      (loop $sum_next
        (br_if $sum_done (i32.ge_u (local.get $i) (local.get $arr_len)))

        (local.set $element_str (call $f64_to_string
          (call $read_typed_element (local.get $type)
            (call $abs (i32.add
              (i32.add (i32.add (local.get $data_pointer) (i32.const 4)) (local.get $start_idx))
              (i32.mul (local.get $i) (local.get $bytes_per_element)))))))
        (if (global.get $memory_pressure_signaled)
          (then (return (i32.const 0))))

        (i32.store (call $abs (i32.add (local.get $ids_data)
          (i32.mul (local.get $i) (global.get $VALUE_SIZE)))) (global.get $TYPE_STRING))
        (i32.store (call $abs (i32.add
          (i32.add (local.get $ids_data) (i32.const 4))
          (i32.mul (local.get $i) (global.get $VALUE_SIZE)))) (i32.const 0))
        (i32.store (call $abs (i32.add
          (i32.add (local.get $ids_data) (i32.const 8))
          (i32.mul (local.get $i) (global.get $VALUE_SIZE)))) (local.get $element_str))
        (i32.store (call $abs (i32.add
          (i32.add (local.get $ids_data) (i32.const 12))
          (i32.mul (local.get $i) (global.get $VALUE_SIZE)))) (i32.const 0))

        (local.set $total_len (i32.add (local.get $total_len)
          (call $read_string_len (local.get $element_str))))
        (if (i32.gt_u (local.get $i) (i32.const 0))
          (then
            (local.set $total_len (i32.add (local.get $total_len) (i32.const 1)))) ;; ","
        )

        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $sum_next)
      )
    )

    (if (call $check_concat_scratch_overflow (local.get $total_len))
      (then (return (i32.const 0)))
    )

    ;; Pass 2: allocation-free write into heap-tail scratch.
    (local.set $scratch_base
      (call $abs (call $read_state (global.get $STATE_HEAP_POINTER))))
    (local.set $write_pointer (local.get $scratch_base))

    (local.set $i (i32.const 0))
    (block $write_done
      (loop $write_next
        (br_if $write_done (i32.ge_u (local.get $i) (local.get $arr_len)))

        (if (i32.gt_u (local.get $i) (i32.const 0))
          (then
            (i32.store8 (local.get $write_pointer) (i32.const 44)) ;; ','
            (local.set $write_pointer (i32.add (local.get $write_pointer) (i32.const 1)))
          )
        )

        (local.set $element_str (i32.load (call $abs (i32.add
          (i32.add (local.get $ids_data) (i32.const 8))
          (i32.mul (local.get $i) (global.get $VALUE_SIZE))))))
        (local.set $str_len (call $read_string_len (local.get $element_str)))
        (memory.copy
          (local.get $write_pointer)
          (call $abs (call $string_id_bytes_seg (local.get $element_str)))
          (local.get $str_len))
        (local.set $write_pointer (i32.add (local.get $write_pointer) (local.get $str_len)))

        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $write_next)
      )
    )

    (local.set $result_id (call $intern_string (local.get $scratch_base) (local.get $total_len)))
    (if (global.get $memory_pressure_signaled)
      (then (return (i32.const 0))))
    (local.get $result_id)
  )

  ;; value_to_string(value_pointer) → string_offset
  ;;
  ;; Convert any value to its string representation.
  ;; Returns a string table offset.
  ;; ==========================================================================
  (func $value_to_string (param $value_pointer i32) (result i32)
    (local $type i32)
    (local $data_lo i32)

    (local $component_slots i32)
    (local $real_string i32)
    (local $imaginary_string i32)
    (local $result_string i32)
    (local.set $type (call $value_type (local.get $value_pointer)))
    (local.set $data_lo (call $value_data_lo (local.get $value_pointer)))

    ;; String - already a string offset
    (if (i32.eq (local.get $type) (global.get $TYPE_STRING))
      (then (return (local.get $data_lo)))
    )

    ;; Float → f64 stringification (the approximate side).
    (if (i32.eq (local.get $type) (global.get $TYPE_FLOAT))
      (then (return (call $f64_to_string (call $read_f64 (local.get $value_pointer)))))
    )
    ;; Rational → exact decimal form ("n" or "n/d"). No precision loss at the
    ;; String(...) boundary — this is the production path used by string
    ;; coercion, template literals, and concatenation.
    (if (i32.eq (local.get $type) (global.get $TYPE_RATIONAL))
      (then (return (call $rational_to_decimal (local.get $value_pointer))))
    )
    ;; BigInt → exact decimal form.
    (if (i32.eq (local.get $type) (global.get $TYPE_BIGINT))
      (then (return (call $bigint_to_decimal (local.get $data_lo))))
    )
    ;; Integer (internal i32 tag, e.g. error-object properties like
    ;; err.offset) → decimal form via a throwaway BigInt. Without this
    ;; case such values fall through to the empty-string fallback.
    ;; Pressure pre-check for the throwaway $bigint_from_i64 (≤32
    ;; aligned bytes; 96 with slop) — unguarded conversions compound
    ;; under stringify/join unless guarded by the heap/code free span.
    (if (i32.eq (local.get $type) (global.get $TYPE_INTEGER))
      (then
        (if (call $check_heap_overflow (i32.const 96))
          (then (return (i32.const 0))))
        (return (call $bigint_to_decimal
          (call $bigint_from_i64 (i64.extend_i32_s (local.get $data_lo))))))
    )
    ;; Complex → exact "a + bi" pretty-printing.
    (if (i32.eq (local.get $type) (global.get $TYPE_COMPLEX))
      (then (return (call $complex_to_decimal (local.get $data_lo))))
    )
    ;; AlgebraicNumber → "algebraic(x^3 - 2, (5/4, 3/2))".
    (if (i32.eq (local.get $type) (global.get $TYPE_ALGEBRAIC))
      (then (return (call $algebraic_to_decimal (local.get $data_lo))))
    )
    ;; ComplexAlgebraicNumber → "complexAlgebraic(<real>, <imaginary>)".
    (if (i32.eq (local.get $type) (global.get $TYPE_COMPLEX_ALGEBRAIC))
      (then
        (if (call $check_heap_overflow (i32.const 128))
          (then (return (i32.const 0))))
        (local.set $component_slots (call $carve_scratch_blob (i32.const 32)))
        (call $complex_algebraic_component_to_slot
          (call $complex_algebraic_real_pointer (local.get $data_lo))
          (local.get $component_slots))
        (call $complex_algebraic_component_to_slot
          (call $complex_algebraic_imaginary_pointer (local.get $data_lo))
          (i32.add (local.get $component_slots) (global.get $VALUE_SIZE)))
        (local.set $real_string
          (call $value_to_string (local.get $component_slots)))
        (if (i32.eqz (local.get $real_string)) (then (return (i32.const 0))))
        (local.set $imaginary_string (call $value_to_string
          (i32.add (local.get $component_slots) (global.get $VALUE_SIZE))))
        (if (i32.eqz (local.get $imaginary_string)) (then (return (i32.const 0))))
        (local.set $result_string (call $string_concat
          (call $read_builtin (global.get $BUILTIN_COMPLEX_ALGEBRAIC_TOSTRING_PREFIX))
          (local.get $real_string)))
        (if (global.get $memory_pressure_signaled)
          (then (return (i32.const 0))))
        (local.set $result_string (call $string_concat
          (local.get $result_string)
          (call $read_builtin (global.get $BUILTIN_EXACT_COMMA_SEP))))
        (if (global.get $memory_pressure_signaled)
          (then (return (i32.const 0))))
        (local.set $result_string (call $string_concat
          (local.get $result_string) (local.get $imaginary_string)))
        (if (global.get $memory_pressure_signaled)
          (then (return (i32.const 0))))
        (return (call $string_concat
          (local.get $result_string)
          (call $read_builtin (global.get $BUILTIN_EXACT_CLOSE_PAREN))))))

    ;; RegExp → "/source/flags" (script-visible source text). May intern;
    ;; 0 propagates the pressure sentinel like the arms above.
    (if (i32.eq (local.get $type) (global.get $TYPE_REGEXP))
      (then (return (call $regexp_to_string_id (local.get $data_lo)))))

    ;; Boolean - "true" or "false"
    (if (i32.eq (local.get $type) (global.get $TYPE_BOOLEAN))
      (then
        (if (local.get $data_lo)
          (then (return (call $read_builtin (global.get $BUILTIN_LIT_TRUE))))
          (else (return (call $read_builtin (global.get $BUILTIN_LIT_FALSE))))
        )
      )
    )

    ;; Null - "null"
    (if (i32.eq (local.get $type) (global.get $TYPE_NULL))
      (then (return (call $read_builtin (global.get $BUILTIN_LIT_NULL))))
    )

    ;; Undefined - "undefined"
    (if (i32.eq (local.get $type) (global.get $TYPE_UNDEFINED))
      (then (return (call $read_builtin (global.get $BUILTIN_TYPEOF_UNDEFINED))))
    )

    ;; Object - respect an own/inherited toString override (e.g. Error
    ;; instances) before falling back to "[object <tag>]" honoring
    ;; Symbol.toStringTag (B2). May intern a fresh string for user tags
    ;; or for the override's own formatting; callers already handle the
    ;; memory-pressure signal $intern_string/$string_concat raise.
    (if (i32.eq (local.get $type) (global.get $TYPE_OBJECT))
      (then
        (if (i32.eq
              (call $find_own_bound_method (local.get $data_lo) (call $read_builtin (global.get $BUILTIN_TO_STRING_NAME)))
              (global.get $METHOD_ERROR_TO_STRING))
          (then (return (call $error_to_string_id (local.get $data_lo)))))
        (return (call $to_string_tag_literal (local.get $type) (local.get $data_lo)))
      )
    )

    ;; Map / Set - "[object Map]" / "[object Set]" (B2). Before the tag
    ;; work these fell through to the empty-string fallback.
    (if (i32.or
          (i32.eq (local.get $type) (global.get $TYPE_MAP))
          (i32.eq (local.get $type) (global.get $TYPE_SET)))
      (then (return (call $to_string_tag_literal (local.get $type) (local.get $data_lo))))
    )

    ;; Array - "[elem1,elem2,...]" matching JS Array.prototype.toString
    ;; (which delegates to .join(",")). Implemented in $array_to_string;
    ;; null/undefined elements stringify to empty per spec.
    (if (i32.eq (local.get $type) (global.get $TYPE_ARRAY))
      (then (return (call $array_to_string (local.get $data_lo))))
    )

    ;; Typed arrays use comma-joined decimal elements, matching
    ;; Array.prototype.toString semantics.
    ;; Typed arrays bypass the unsupported-value empty-string fallback;
    ;; byte concatenation and btoa depend on their actual contents.
    (if (call $is_typed_array (local.get $type))
      (then (return (call $typed_array_to_string (local.get $type) (local.get $data_lo))))
    )

    ;; Fallback for any unhandled type — keep empty-string behavior so
    ;; new value types don't break implicit coercion at this boundary.
    (call $read_builtin (global.get $BUILTIN_LIT_EMPTY_STRING))
  )

  ;; ==========================================================================
  ;; to_string_tag_literal(type, data_lo) → interned "[object <tag>]" id
  ;;
  ;; The Object.prototype.toString tag (B2). Built-in types return
  ;; whole-literal builtin strings (no allocation). TYPE_OBJECT receivers
  ;; consult Symbol.toStringTag (own or prototype, string values only —
  ;; non-string tags fall back to "Object" per spec) and build
  ;; "[object " + tag + "]" via $string_concat, which may raise the
  ;; memory-pressure signal; callers must let the dispatcher's signal
  ;; handling retry the instruction.
  ;; ==========================================================================
  (func $to_string_tag_literal (param $type i32) (param $data_lo i32) (result i32)
    (local $entry_pointer i32)
    (local $tag_id i32)
    (if (i32.eq (local.get $type) (global.get $TYPE_OBJECT))
      (then
        (local.set $entry_pointer (call $object_find_symbol_entry
          (local.get $data_lo)
          (call $read_state (global.get $STATE_WELL_KNOWN_TO_STRING_TAG_SYMBOL))))
        (if (i32.ne (local.get $entry_pointer) (i32.const 0))
          (then
            ;; Sym entry layout: [key:4][type:4][flags:4][lo:4][hi:4]
            (if (i32.eq
                  (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 4))))
                  (global.get $TYPE_STRING))
              (then
                (local.set $tag_id (i32.load (call $abs (i32.add (local.get $entry_pointer) (i32.const 12)))))
                (return (call $string_concat
                  (call $string_concat
                    (call $read_builtin (global.get $BUILTIN_LIT_OBJECT_PREFIX))
                    (local.get $tag_id))
                  (call $read_builtin (global.get $BUILTIN_LIT_CLOSE_BRACKET))))
              )
            )
          )
        )
        (return (call $read_builtin (global.get $BUILTIN_LIT_OBJECT_OBJECT)))
      )
    )
    (if (i32.eq (local.get $type) (global.get $TYPE_MAP))
      (then (return (call $read_builtin (global.get $BUILTIN_LIT_OBJECT_MAP)))))
    (if (i32.eq (local.get $type) (global.get $TYPE_SET))
      (then (return (call $read_builtin (global.get $BUILTIN_LIT_OBJECT_SET)))))
    (if (i32.eq (local.get $type) (global.get $TYPE_ARRAY))
      (then (return (call $read_builtin (global.get $BUILTIN_LIT_OBJECT_ARRAY)))))
    (if (i32.or
          (i32.or
            (i32.eq (local.get $type) (global.get $TYPE_FUNCTION))
            (i32.eq (local.get $type) (global.get $TYPE_CONSTRUCTOR)))
          (i32.eq (local.get $type) (global.get $TYPE_BOUND_METHOD)))
      (then (return (call $read_builtin (global.get $BUILTIN_LIT_OBJECT_FUNCTION)))))
    (if (i32.eq (local.get $type) (global.get $TYPE_UNDEFINED))
      (then (return (call $read_builtin (global.get $BUILTIN_LIT_OBJECT_UNDEFINED)))))
    (if (i32.eq (local.get $type) (global.get $TYPE_NULL))
      (then (return (call $read_builtin (global.get $BUILTIN_LIT_OBJECT_NULL)))))
    (if (i32.eq (local.get $type) (global.get $TYPE_BOOLEAN))
      (then (return (call $read_builtin (global.get $BUILTIN_LIT_OBJECT_BOOLEAN)))))
    (if (i32.or
          (i32.or
            (i32.eq (local.get $type) (global.get $TYPE_RATIONAL))
            (i32.eq (local.get $type) (global.get $TYPE_FLOAT)))
          (i32.eq (local.get $type) (global.get $TYPE_INTEGER)))
      (then (return (call $read_builtin (global.get $BUILTIN_LIT_OBJECT_NUMBER)))))
    (if (i32.eq (local.get $type) (global.get $TYPE_STRING))
      (then (return (call $read_builtin (global.get $BUILTIN_LIT_OBJECT_STRING)))))
    (if (i32.eq (local.get $type) (global.get $TYPE_PROMISE))
      (then (return (call $read_builtin (global.get $BUILTIN_LIT_OBJECT_PROMISE)))))
    (call $read_builtin (global.get $BUILTIN_LIT_OBJECT_OBJECT))
  )

  ;; ==========================================================================
  ;; Constants for interpreter
  ;; ==========================================================================

  ;; State header offsets (must match constants.js STATE)
  ;; All offsets include HEADER_SIZE (16 bytes)
  ;; v6: Per-execution state moved to context. STATE is now global-only.
  (global $STATE_HEAP_POINTER i32 (i32.const 0x10))      ;; 16 + 0x00
  ;; $STATE_STRING_POINTER defined above as 0x14
  (global $STATE_HEAP_START i32 (i32.const 0x18))        ;; 16 + 0x08
  (global $STATE_HEAP_END i32 (i32.const 0x1C))          ;; 16 + 0x0C
  ;; $STATE_STRING_START defined above as 0x20
  ;; $STATE_SEGMENT_SIZE defined above as 0x24
  (global $STATE_BASE_OFFSET i32 (i32.const 0x28))       ;; 16 + 0x18
  (global $STATE_CODE_POINTER i32 (i32.const 0x2C))      ;; 16 + 0x1C
  (global $STATE_CODE_BLOCK i32 (i32.const 0x30))        ;; 16 + 0x20

  ;; Region base offsets (read from STATE at init)
  ;; STATE 0x34 (16 + 0x24) RETIRED in layout v8 — was EXTERNAL_REQUEST_BASE;
  ;; the request block is per-context (CTX_REQUEST_BLOCK).
  (global $STATE_ERROR_INFO_BASE i32 (i32.const 0x38))   ;; 16 + 0x28
  (global $STATE_SCRATCH_BASE i32 (i32.const 0x3C))      ;; 16 + 0x2C
  (global $STATE_SCRATCH_REGION_SIZE i32 (i32.const 0xB8)) ;; 16 + 0xA8
  (global $STATE_BUILTINS_BASE i32 (i32.const 0x40))     ;; 16 + 0x30

  ;; Intrinsic references (prototype chain support)
  (global $STATE_OBJECT_PROTOTYPE i32 (i32.const 0x44))        ;; 16 + 0x34
  (global $STATE_FUNCTION_PROTOTYPE i32 (i32.const 0x48))      ;; 16 + 0x38
  (global $STATE_ERROR_CONSTRUCTOR i32 (i32.const 0x4C))       ;; 16 + 0x3C
  (global $STATE_TYPE_ERROR_CONSTRUCTOR i32 (i32.const 0x50))  ;; 16 + 0x40
  (global $STATE_REFERENCE_ERROR_CONSTRUCTOR i32 (i32.const 0x54)) ;; 16 + 0x44
  (global $STATE_ARRAY_PROTOTYPE i32 (i32.const 0x58))         ;; 16 + 0x48
  (global $STATE_ERROR_PROTOTYPE i32 (i32.const 0x5C))         ;; 16 + 0x4C
  (global $STATE_TYPE_ERROR_PROTOTYPE i32 (i32.const 0x60))    ;; 16 + 0x50
  (global $STATE_REFERENCE_ERROR_PROTOTYPE i32 (i32.const 0x64)) ;; 16 + 0x54
  (global $STATE_GRANT_DENIED_ERROR_PROTOTYPE i32 (i32.const 0x68)) ;; 16 + 0x58

  ;; RangeError (typed arrays)
  (global $STATE_RANGE_ERROR_PROTOTYPE i32 (i32.const 0x6C))    ;; 16 + 0x5C
  (global $STATE_RANGE_ERROR_CONSTRUCTOR i32 (i32.const 0x70))  ;; 16 + 0x60

  ;; ArrayBuffer/Uint8Array/DataView (typed arrays)
  (global $STATE_ARRAYBUFFER_PROTOTYPE i32 (i32.const 0x74))    ;; 16 + 0x64
  (global $STATE_UINT8ARRAY_PROTOTYPE i32 (i32.const 0x78))     ;; 16 + 0x68
  (global $STATE_DATAVIEW_PROTOTYPE i32 (i32.const 0x7C))       ;; 16 + 0x6C

  ;; Multi-context execution (v6)
  (global $STATE_CONTEXT_COUNT i32 (i32.const 0x80))         ;; 16 + 0x70
  ;; Layout v10: DATA pointer to the slot→pointer context table, a growable
  ;; STACK_BLOCK heap object. The collector marks it as a root and forwards
  ;; this cell with the data-pointer rule (like ROOT_SCOPE).
  (global $STATE_CONTEXT_TABLE_POINTER i32 (i32.const 0x88)) ;; 16 + 0x78
  (global $STATE_CONTEXT_GENERATION_TABLE_POINTER i32 (i32.const 0xE4))

  ;; Ring 2: Symbol registry (Symbol.for / Symbol.keyFor backing store)
  (global $STATE_SYMBOL_REGISTRY i32 (i32.const 0x90))       ;; 16 + 0x80

  ;; Well-known symbols (slice 2 of async-iteration): header pointers to
  ;; the canonical Symbol.iterator / Symbol.asyncIterator minted at boot.
  (global $STATE_WELL_KNOWN_ITERATOR_SYMBOL i32 (i32.const 0xA0))        ;; 16 + 0x90
  (global $STATE_WELL_KNOWN_ASYNC_ITERATOR_SYMBOL i32 (i32.const 0xA4))  ;; 16 + 0x94
  (global $STATE_WELL_KNOWN_TO_STRING_TAG_SYMBOL i32 (i32.const 0xC4))   ;; 16 + 0xB4

  ;; String.prototype (slice 3 of async-iteration): carries Symbol.iterator
  ;; so str[Symbol.iterator] dispatches through the standard prototype walk.
  ;; Slotted into the 0x74 STATE gap to avoid growing STATE_SIZE.
  (global $STATE_STRING_PROTOTYPE i32 (i32.const 0x84))                  ;; 16 + 0x74

  ;; Map and Set prototypes (slice 5).
  (global $STATE_MAP_PROTOTYPE i32 (i32.const 0xA8))                     ;; 16 + 0x98
  (global $STATE_SET_PROTOTYPE i32 (i32.const 0xAC))                     ;; 16 + 0x9C

  ;; TextEncoder / TextDecoder prototypes. Constructors create plain
  ;; objects whose prototype is one of these; .encode / .decode are
  ;; bound methods stored on the prototype and resolved via standard
  ;; property lookup. Strings are stored UTF-8 natively so the
  ;; codec operations reduce to memcpy + intern.
  (global $STATE_TEXT_ENCODER_PROTOTYPE i32 (i32.const 0xB0))            ;; 16 + 0xA0
  (global $STATE_TEXT_DECODER_PROTOTYPE i32 (i32.const 0xB4))            ;; 16 + 0xA4

  ;; Step ring: opt-in per-instruction binary event ring.
  ;; Size 0 = disabled (interpreter skips ring writes).
  (global $STATE_STEP_RING_BASE i32 (i32.const 0xBC))                   ;; 16 + 0xAC
  (global $STATE_STEP_RING_SIZE i32 (i32.const 0xC0))                   ;; 16 + 0xB0

  ;; Header-event ring (layout v13): opt-in ring recording writes to
  ;; global STATE.* fields (context-table growth, GC pointer forwarding)
  ;; plus GC-cycle events. Size 0 = disabled.
  (global $STATE_HEADER_EVENT_RING_BASE i32 (i32.const 0xC8))           ;; 16 + 0xB8
  (global $STATE_HEADER_EVENT_RING_SIZE i32 (i32.const 0xCC))           ;; 16 + 0xBC
  (global $STATE_SYNTAX_ERROR_PROTOTYPE i32 (i32.const 0xD0))  ;; 16 + 0xC0
  (global $STATE_SYNTAX_ERROR_CONSTRUCTOR i32 (i32.const 0xD4)) ;; 16 + 0xC4
  (global $STATE_BIGINT_CONSTRUCTOR i32 (i32.const 0xDC)) ;; 16 + 0xCC
  (global $STATE_BIGINT_PROTOTYPE i32 (i32.const 0xD8)) ;; 16 + 0xC8
  (global $STATE_WELL_KNOWN_TO_PRIMITIVE_SYMBOL i32 (i32.const 0xE0)) ;; 16 + 0xD0
  ;; RegExp.prototype intrinsic (layout v21): instanceof identity for
  ;; TYPE_REGEXP primitives and the RegExp global's .prototype target.
  (global $STATE_REGEXP_PROTOTYPE i32 (i32.const 0xE8)) ;; 16 + 0xD8
  ;; Hidden match-metadata symbol (layout v22): keys exec's result-array
  ;; metadata object in the array's sym-entries block.
  (global $STATE_REGEXP_MATCH_META_SYMBOL i32 (i32.const 0xEC)) ;; 16 + 0xDC

  ;; Context layout constants (v6)
  (global $CONTEXT_SIZE i32 (i32.const 12288))               ;; 0x3000 = 12KB per context
  (global $CONTEXT_PENDING_OFFSET i32 (i32.const 0x0000))    ;; pending stack at start
  (global $CONTEXT_CALL_STACK_OFFSET i32 (i32.const 0x1000)) ;; call stack at 4KB
  (global $CONTEXT_TRY_STACK_OFFSET i32 (i32.const 0x2000))  ;; try stack at 8KB
  (global $CONTEXT_GRANT_STACK_OFFSET i32 (i32.const 0x2400));; grant stack at 9KB

  ;; Context state block field offsets (relative to context state base)
  (global $CTX_EXIT_CONDITION i32 (i32.const 0x00)) ;; Exit condition (interpreter → host, output only)
  (global $CTX_INSTRUCTION_INDEX i32 (i32.const 0x04))
  (global $CTX_SCOPE i32 (i32.const 0x08))
  (global $CTX_PENDING_POINTER i32 (i32.const 0x0C))
  (global $CTX_CALL_STACK_POINTER i32 (i32.const 0x10))
  (global $CTX_GRANT_STACK_POINTER i32 (i32.const 0x14))
  (global $CTX_TRY_STACK_POINTER i32 (i32.const 0x18))
  (global $CTX_COMPLETION_TYPE i32 (i32.const 0x1C))
  (global $CTX_COMPLETION_VALUE i32 (i32.const 0x20))
  (global $CTX_CONTINUATION_ID i32 (i32.const 0x24))
  (global $CTX_FUEL i32 (i32.const 0x28))
  (global $CTX_WAITING_ON i32 (i32.const 0x2C))      ;; Promise data pointer (0 if not waiting)
  (global $CTX_RESPONSE_TYPE i32 (i32.const 0x34))   ;; Response type (host → interpreter, input)
  ;; Design B (heap-allocated contexts): per-stack block base + limit. Each stack
  ;; is its own STACK_BLOCK heap object; these locate it. Base = segment-relative
  ;; pointer to the block's first byte; limit = base + capacity (one-past-end).
  ;; The stack top pointer (CTX_*_POINTER above) lives between base and limit.
  (global $CTX_PENDING_BASE i32 (i32.const 0x38))
  (global $CTX_PENDING_LIMIT i32 (i32.const 0x3C))
  (global $CTX_CALL_STACK_BASE i32 (i32.const 0x40))
  (global $CTX_CALL_STACK_LIMIT i32 (i32.const 0x44))
  (global $CTX_TRY_STACK_BASE i32 (i32.const 0x48))
  (global $CTX_TRY_STACK_LIMIT i32 (i32.const 0x4C))
  (global $CTX_GRANT_STACK_BASE i32 (i32.const 0x50))
  (global $CTX_GRANT_STACK_LIMIT i32 (i32.const 0x54))
  ;; 16-byte inline completion-value storage (was PENDING_BASE - 16 in the old
  ;; slab layout; now lives in the context object so it survives per-stack blocks).
  (global $CTX_COMPLETION_VALUE_STORAGE i32 (i32.const 0x58))
  (global $CTX_REQUEST_BLOCK i32 (i32.const 0x68))  ;; 32-byte per-context request block (layout v8)
  ;; Generator-object HEADER pointer this context is the body of
  ;; (0 = not a generator context).
  (global $CTX_GENERATOR_OBJECT i32 (i32.const 0x88))
  ;; Scalar snapshot-owned marker for Runtime.invokeClosure roots (layout v19).
  (global $CTX_INVOCATION_ROOT i32 (i32.const 0x8C))
  ;; Traced root for a paused RegExp engine operation (layout v20):
  ;; NATIVE_CONTINUATION_STATE header pointer, 0 = none. Cleared at the
  ;; operation's commit point.
  (global $CTX_REGEX_STATE i32 (i32.const 0x90))
  (global $CTX_CONSTRUCTION_DUTY i32 (i32.const 0x94))

  ;; BUILTINS segment offsets (relative to builtins_base)
  ;; Typeof string offsets (pre-interned during initialization)
  (global $BUILTIN_TYPEOF_UNDEFINED i32 (i32.const 0x00))
  (global $BUILTIN_TYPEOF_BOOLEAN i32 (i32.const 0x04))
  (global $BUILTIN_TYPEOF_NUMBER i32 (i32.const 0x08))
  (global $BUILTIN_TYPEOF_STRING i32 (i32.const 0x0C))
  (global $BUILTIN_TYPEOF_OBJECT i32 (i32.const 0x10))
  (global $BUILTIN_TYPEOF_FUNCTION i32 (i32.const 0x14))
  ;; Special keywords
  (global $BUILTIN_THIS i32 (i32.const 0x18))
  (global $BUILTIN_LENGTH i32 (i32.const 0x1C))

  ;; Array method names (0x20 - 0x6F)
  (global $BUILTIN_PUSH i32 (i32.const 0x20))
  (global $BUILTIN_POP i32 (i32.const 0x24))
  (global $BUILTIN_SHIFT i32 (i32.const 0x28))
  (global $BUILTIN_UNSHIFT i32 (i32.const 0x2C))
  (global $BUILTIN_SLICE i32 (i32.const 0x30))
  (global $BUILTIN_CONCAT i32 (i32.const 0x34))
  (global $BUILTIN_JOIN i32 (i32.const 0x38))
  (global $BUILTIN_REVERSE i32 (i32.const 0x3C))
  (global $BUILTIN_INDEX_OF i32 (i32.const 0x40))
  (global $BUILTIN_INCLUDES i32 (i32.const 0x44))
  (global $BUILTIN_MAP i32 (i32.const 0x48))
  (global $BUILTIN_FILTER i32 (i32.const 0x4C))
  (global $BUILTIN_REDUCE i32 (i32.const 0x50))
  (global $BUILTIN_FOR_EACH i32 (i32.const 0x54))
  (global $BUILTIN_FIND i32 (i32.const 0x58))
  (global $BUILTIN_FIND_INDEX i32 (i32.const 0x5C))
  (global $BUILTIN_SOME i32 (i32.const 0x60))
  (global $BUILTIN_EVERY i32 (i32.const 0x64))
  (global $BUILTIN_SPLICE i32 (i32.const 0x68))
  (global $BUILTIN_SORT i32 (i32.const 0x6C))
  (global $BUILTIN_FLAT i32 (i32.const 0x70))
  (global $BUILTIN_FLAT_MAP i32 (i32.const 0x74))
  (global $BUILTIN_AT i32 (i32.const 0x78))

  ;; String method names (0x80 - 0xDF)
  (global $BUILTIN_CHAR_AT i32 (i32.const 0x80))
  (global $BUILTIN_CHAR_CODE_AT i32 (i32.const 0x84))
  (global $BUILTIN_STRING_INDEX_OF i32 (i32.const 0x88))
  (global $BUILTIN_STRING_INCLUDES i32 (i32.const 0x8C))
  (global $BUILTIN_STRING_SLICE i32 (i32.const 0x90))
  (global $BUILTIN_SUBSTRING i32 (i32.const 0x94))
  (global $BUILTIN_SPLIT i32 (i32.const 0x98))
  (global $BUILTIN_TRIM i32 (i32.const 0x9C))
  (global $BUILTIN_TO_LOWER_CASE i32 (i32.const 0xA0))
  (global $BUILTIN_TO_UPPER_CASE i32 (i32.const 0xA4))
  (global $BUILTIN_STARTS_WITH i32 (i32.const 0xA8))
  (global $BUILTIN_ENDS_WITH i32 (i32.const 0xAC))
  (global $BUILTIN_REPEAT i32 (i32.const 0xB0))
  (global $BUILTIN_PAD_START i32 (i32.const 0xB4))
  (global $BUILTIN_PAD_END i32 (i32.const 0xB8))
  (global $BUILTIN_REPLACE i32 (i32.const 0xBC))
  (global $BUILTIN_REPLACE_ALL i32 (i32.const 0x2EC))
  (global $BUILTIN_TRIM_START i32 (i32.const 0x2F0))
  (global $BUILTIN_TRIM_END i32 (i32.const 0x2F4))
  (global $BUILTIN_STRING_LAST_INDEX_OF i32 (i32.const 0x2F8))
  (global $BUILTIN_STRING_AT i32 (i32.const 0x2FC))
  (global $BUILTIN_STRING_CONCAT i32 (i32.const 0x328))

  ;; Literal strings for type conversion (0xC0 - 0xDF)
  (global $BUILTIN_LIT_NULL i32 (i32.const 0xC0))              ;; "null"
  (global $BUILTIN_LIT_TRUE i32 (i32.const 0xC4))              ;; "true"
  (global $BUILTIN_LIT_FALSE i32 (i32.const 0xC8))             ;; "false"
  (global $BUILTIN_LIT_OBJECT_OBJECT i32 (i32.const 0xCC))     ;; "[object Object]"
  (global $BUILTIN_LIT_NAN i32 (i32.const 0xD0))               ;; "NaN"
  (global $BUILTIN_LIT_INFINITY i32 (i32.const 0xD4))          ;; "Infinity"
  (global $BUILTIN_LIT_NEG_INFINITY i32 (i32.const 0xD8))      ;; "-Infinity"
  (global $BUILTIN_LIT_OBJECT_FUNCTION i32 (i32.const 0xDC))   ;; "[object Function]"
  (global $BUILTIN_LIT_EMPTY_STRING i32 (i32.const 0xE0))          ;; ""

  ;; Prototype chain related literals (0x140+)
  (global $BUILTIN_PROTOTYPE i32 (i32.const 0x140))        ;; "prototype"
  (global $BUILTIN_CONSTRUCTOR i32 (i32.const 0x144))          ;; "constructor"
  (global $BUILTIN_HAS_OWN_PROPERTY i32 (i32.const 0x148))     ;; "hasOwnProperty"
  (global $BUILTIN_GET_PROTOTYPE_OF i32 (i32.const 0x14C))     ;; "getPrototypeOf"
  (global $BUILTIN_NAME i32 (i32.const 0x150))                 ;; "name"
  (global $BUILTIN_MESSAGE i32 (i32.const 0x154))              ;; "message"
  (global $BUILTIN_LIT_ERROR i32 (i32.const 0x160))            ;; "Error"
  (global $BUILTIN_LIT_TYPE_ERROR i32 (i32.const 0x164))       ;; "TypeError"
  (global $BUILTIN_LIT_REFERENCE_ERROR i32 (i32.const 0x168))  ;; "ReferenceError"
  ;; Note: BUILTIN_LIT_OBJECT_OBJECT is already defined above at 0xCC

  ;; Error.prototype.toString() formatting.
  (global $BUILTIN_LIT_COLON_SPACE i32 (i32.const 0x3D0))      ;; ": "
  (global $BUILTIN_FIND_LAST i32 (i32.const 0x3D4))             ;; "findLast"
  (global $BUILTIN_FIND_LAST_INDEX i32 (i32.const 0x3D8))       ;; "findLastIndex"
  (global $BUILTIN_VALUES i32 (i32.const 0x3DC))                ;; "values"
  (global $BUILTIN_ENTRIES i32 (i32.const 0x3E0))               ;; "entries"
  (global $BUILTIN_TO_REVERSED i32 (i32.const 0x3E4))           ;; "toReversed"
  (global $BUILTIN_TO_SORTED i32 (i32.const 0x3E8))             ;; "toSorted"
  (global $BUILTIN_WITH_NAME i32 (i32.const 0x3EC))             ;; "with"
  (global $BUILTIN_TO_SPLICED i32 (i32.const 0x3F0))            ;; "toSpliced"
  (global $BUILTIN_MSG_INVALID_INDEX i32 (i32.const 0x3F4))     ;; "Invalid index"
  (global $BUILTIN_TO_LOCALE_STRING i32 (i32.const 0x3F8))      ;; "toLocaleString"

  ;; ArrayBuffer/Uint8Array property names (0x174+)
  (global $BUILTIN_BYTE_LENGTH i32 (i32.const 0x174))          ;; "byteLength"
  (global $BUILTIN_BYTE_OFFSET i32 (i32.const 0x178))          ;; "byteOffset"
  (global $BUILTIN_BUFFER i32 (i32.const 0x17C))               ;; "buffer"
  (global $BUILTIN_SUBARRAY i32 (i32.const 0x180))             ;; "subarray"
  (global $BUILTIN_FILL i32 (i32.const 0x184))                 ;; "fill"
  (global $BUILTIN_SET i32 (i32.const 0x188))                  ;; "set"
  (global $BUILTIN_COPY_WITHIN i32 (i32.const 0x18C))          ;; "copyWithin"
  (global $BUILTIN_LAST_INDEX_OF i32 (i32.const 0x190))        ;; "lastIndexOf"
  (global $BUILTIN_REDUCE_RIGHT i32 (i32.const 0x194))         ;; "reduceRight"
  (global $BUILTIN_FROM i32 (i32.const 0x198))                 ;; "from"
  (global $BUILTIN_OF i32 (i32.const 0x19C))                   ;; "of"

  ;; DataView (0x1A0+)
  (global $BUILTIN_DATA_VIEW i32 (i32.const 0x1A0))            ;; "DataView"
  (global $BUILTIN_GET_INT8 i32 (i32.const 0x1A4))
  (global $BUILTIN_GET_UINT8 i32 (i32.const 0x1A8))
  (global $BUILTIN_GET_INT16 i32 (i32.const 0x1AC))
  (global $BUILTIN_GET_UINT16 i32 (i32.const 0x1B0))
  (global $BUILTIN_GET_INT32 i32 (i32.const 0x1B4))
  (global $BUILTIN_GET_UINT32 i32 (i32.const 0x1B8))
  (global $BUILTIN_GET_FLOAT32 i32 (i32.const 0x1BC))
  (global $BUILTIN_GET_FLOAT64 i32 (i32.const 0x1C0))
  (global $BUILTIN_SET_INT8 i32 (i32.const 0x1C4))
  (global $BUILTIN_SET_UINT8 i32 (i32.const 0x1C8))
  (global $BUILTIN_SET_INT16 i32 (i32.const 0x1CC))
  (global $BUILTIN_SET_UINT16 i32 (i32.const 0x1D0))
