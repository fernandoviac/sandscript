              (if (i32.eqz (local.get $walk_out)) (then (return (i32.const 0))))
              (call $proof_copy_bytes (local.get $artifact_base) (i32.add (local.get $walk_out) (i32.const 8))
                (i32.add (local.get $term_reference) (i32.const 8)) (i32.sub (i32.mul (local.get $walk_n) (i32.const 4)) (i32.const 8)))))
            (call $proof_store (local.get $artifact_base) (i32.add (local.get $walk_out) (local.get $walk_i)) (local.get $walk_y))))))))
      (local.set $walk_i (i32.add (local.get $walk_i) (i32.const 4)))
      (br $walk_next)))
    (local.get $walk_out)
  )

  (func $proof_declaration_reference
    (param $artifact_base i32)
    (param $declaration_index i32)
    (result i32)
    (local $declarations i32)
    (local.set $declarations
      (call $proof_load (local.get $artifact_base) (i32.const 12)))
    (if (i32.ge_u (local.get $declaration_index)
          (call $proof_array_count (local.get $artifact_base) (local.get $declarations)))
      (then
        (global.set $proof_last_error_code (i32.const 25))
        (return (i32.const 0))))
    (call $proof_array_get (local.get $artifact_base)
      (local.get $declarations) (local.get $declaration_index))
  )

;; At most eight already-validated spine links per native probe. Longer
;; spines fall back to the persisted walker; no input-sized native loop.
(func $proof_application_spine_leaf
  (param $base i32) (param $term i32) (param $want_count i32) (result i32)
  (if (i32.ne (call $proof_load (local.get $base) (i32.add (local.get $term) (i32.const 4))) (global.get $PROOF_TERM_APPLICATION))
    (then (return (select (i32.const 0) (local.get $term) (local.get $want_count)))))
  (local.set $term (call $proof_load (local.get $base) (i32.add (local.get $term) (i32.const 8))))
  (if (i32.ne (call $proof_load (local.get $base) (i32.add (local.get $term) (i32.const 4))) (global.get $PROOF_TERM_APPLICATION))
    (then (return (select (i32.const 1) (local.get $term) (local.get $want_count)))))
  (local.set $term (call $proof_load (local.get $base) (i32.add (local.get $term) (i32.const 8))))
  (if (i32.ne (call $proof_load (local.get $base) (i32.add (local.get $term) (i32.const 4))) (global.get $PROOF_TERM_APPLICATION))
    (then (return (select (i32.const 2) (local.get $term) (local.get $want_count)))))
  (local.set $term (call $proof_load (local.get $base) (i32.add (local.get $term) (i32.const 8))))
  (if (i32.ne (call $proof_load (local.get $base) (i32.add (local.get $term) (i32.const 4))) (global.get $PROOF_TERM_APPLICATION))
    (then (return (select (i32.const 3) (local.get $term) (local.get $want_count)))))
  (local.set $term (call $proof_load (local.get $base) (i32.add (local.get $term) (i32.const 8))))
  (if (i32.ne (call $proof_load (local.get $base) (i32.add (local.get $term) (i32.const 4))) (global.get $PROOF_TERM_APPLICATION))
    (then (return (select (i32.const 4) (local.get $term) (local.get $want_count)))))
  (local.set $term (call $proof_load (local.get $base) (i32.add (local.get $term) (i32.const 8))))
  (if (i32.ne (call $proof_load (local.get $base) (i32.add (local.get $term) (i32.const 4))) (global.get $PROOF_TERM_APPLICATION))
    (then (return (select (i32.const 5) (local.get $term) (local.get $want_count)))))
  (local.set $term (call $proof_load (local.get $base) (i32.add (local.get $term) (i32.const 8))))
  (if (i32.ne (call $proof_load (local.get $base) (i32.add (local.get $term) (i32.const 4))) (global.get $PROOF_TERM_APPLICATION))
    (then (return (select (i32.const 6) (local.get $term) (local.get $want_count)))))
  (local.set $term (call $proof_load (local.get $base) (i32.add (local.get $term) (i32.const 8))))
  (if (i32.ne (call $proof_load (local.get $base) (i32.add (local.get $term) (i32.const 4))) (global.get $PROOF_TERM_APPLICATION))
    (then (return (select (i32.const 7) (local.get $term) (local.get $want_count)))))
  (local.set $term (call $proof_load (local.get $base) (i32.add (local.get $term) (i32.const 8))))
  (i32.const -1))

(func $proof_application_count_leaf
  (param $base i32) (param $term i32) (result i32)
  (call $proof_application_spine_leaf (local.get $base) (local.get $term) (i32.const 1)))

(func $proof_application_head_leaf
  (param $base i32) (param $term i32) (result i32)
  (call $proof_application_spine_leaf (local.get $base) (local.get $term) (i32.const 0)))
  (func $proof_application_count
    (param $artifact_base i32)
    (param $term_reference i32)
    (result i32)
    (local $current i32)
    (local $count i32)
    (local.set $current (local.get $term_reference))
    (block $done
      (loop $next
        (br_if $done
          (i32.ne
            (call $proof_load (local.get $artifact_base)
              (i32.add (local.get $current) (i32.const 4)))
            (global.get $PROOF_TERM_APPLICATION)))
        (local.set $count (i32.add (local.get $count) (i32.const 1)))
        (local.set $current
          (call $proof_load (local.get $artifact_base)
            (i32.add (local.get $current) (i32.const 8))))
        (br $next)))
    (local.get $count)
  )

  (func $proof_application_head
    (param $artifact_base i32)
    (param $term_reference i32)
