            (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
            (if (i32.ne
              (i32.load8_u (call $abs (i32.add (local.get $lb) (i32.add (local.get $lr) (i32.add (i32.const 16) (local.get $i))))))
              (i32.load8_u (call $abs (i32.add (local.get $rb) (i32.add (local.get $rr) (i32.add (i32.const 16) (local.get $i)))))))
              (then (return (i32.const 0))))
