    (local $index i32)
    (local $expected_word i32)
    (local.set $entry (call $string_id_to_abs (local.get $string_identifier)))
    (if (i32.ne
          (i32.load (local.get $entry))
          (local.get $expected_length))
      (then (return (i32.const 0))))
    (local.set $index (i32.const 0))
    (block $done
      (loop $next
        (br_if $done
          (i32.ge_u (local.get $index) (local.get $expected_length)))
        (if (i32.lt_u (local.get $index) (i32.const 4))
          (then (local.set $expected_word (local.get $first_word)))
          (else
            (if (i32.lt_u (local.get $index) (i32.const 8))
              (then (local.set $expected_word (local.get $second_word)))
              (else
                (if (i32.lt_u (local.get $index) (i32.const 12))
                  (then (local.set $expected_word (local.get $third_word)))
                  (else (local.set $expected_word (local.get $fourth_word))))))))
        (if (i32.ne
              (i32.load8_u
                (i32.add
                  (i32.add (local.get $entry) (i32.const 4))
                  (local.get $index)))
