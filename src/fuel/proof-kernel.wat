  (func $proof_load
    (param $artifact_base i32)
    (param $relative_offset i32)
    (result i32)
    (i32.load (call $abs (i32.add (local.get $artifact_base) (local.get $relative_offset))))
  )

  ;; A reference is canonical only when it names the first word of one of the
  ;; packed records. Merely landing in-bounds is insufficient: an interior
  ;; payload word can look like a record header and otherwise forge a graph.
  (func $proof_reference_valid
    (param $artifact_base i32)
    (param $artifact_length i32)
    (param $reference i32)
    (result i32)
    (local $offset i32)
    (local $record_words i32)
    (if (i32.or
          (i32.lt_u (local.get $reference) (i32.const 16))
          (i32.ne (i32.and (local.get $reference) (i32.const 3)) (i32.const 0)))
      (then (return (i32.const 0))))
    (local.set $offset (i32.const 16))
    (block $not_found
      (loop $next
        (br_if $not_found (i32.ge_u (local.get $offset) (local.get $artifact_length)))
        (if (i32.lt_u (i32.sub (local.get $artifact_length) (local.get $offset)) (i32.const 8))
          (then (return (i32.const 0))))
        (local.set $record_words
          (call $proof_load (local.get $artifact_base) (local.get $offset)))
        (if (i32.or (i32.lt_u (local.get $record_words) (i32.const 2))
              (i32.gt_u (local.get $record_words)
                (i32.shr_u (i32.sub (local.get $artifact_length) (local.get $offset)) (i32.const 2))))
          (then (return (i32.const 0))))
        (if (i32.eq (local.get $offset) (local.get $reference))
          (then (return (i32.const 1))))
        (local.set $offset
          (i32.add (local.get $offset) (i32.mul (local.get $record_words) (i32.const 4))))
        (br $next)
      )
    )
    (i32.const 0)
  )

  (func $proof_reference_has_tag
    (param $artifact_base i32)
    (param $artifact_length i32)
    (param $reference i32)
    (param $tag i32)
    (result i32)
    (if (i32.eqz
          (call $proof_reference_valid
            (local.get $artifact_base)
            (local.get $artifact_length)
            (local.get $reference)))
      (then (return (i32.const 0))))
    (i32.eq
      (call $proof_load (local.get $artifact_base) (i32.add (local.get $reference) (i32.const 4)))
      (local.get $tag))
  )
;; A tag probe may bypass the scheduled walker only on a current boundary hit.
(func $proof_reference_has_tag_leaf
  (param $base i32) (param $length i32) (param $reference i32) (param $tag i32) (result i32)
  (local $known i32)
  (if (i32.or (i32.eqz (global.get $proof_boundary_active_work))
      (i32.ne (local.get $base) (global.get $proof_boundary_active_base))) (then (return (i32.const -1))))
  (local.set $known (call $proof_boundary_cached (local.get $base) (local.get $length)
    (local.get $reference) (global.get $proof_boundary_active_work)))
  (if (i32.le_s (local.get $known) (i32.const 0)) (then (return (local.get $known))))
  (i32.eq (call $proof_load (local.get $base) (i32.add (local.get $reference) (i32.const 4))) (local.get $tag)))

