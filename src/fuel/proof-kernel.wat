                (i32.shr_u
                  (local.get $expected_word)
                  (i32.shl
                    (i32.and (local.get $index) (i32.const 3))
                    (i32.const 3)))
                (i32.const 255)))
          (then (return (i32.const 0))))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $next)))
    (i32.const 1)
  )

