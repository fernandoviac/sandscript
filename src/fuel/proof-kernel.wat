    (param $b i32) (param $head i32) (param $A i32) (param $left i32) (param $right i32) (param $context i32) (param $work i32) (result i32)
    (local $n i32) (local $i i32) (local $j i32) (local $k i32) (local $domains i32) (local $positions i32) (local $a i32) (local $z i32) (local $Ai i32) (local $current i32) (local $proof i32) (local $P i32) (local $domain i32)
    (local $left_type i32) (local $right_type i32)
