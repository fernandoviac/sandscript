    (if (i32.ge_u (local.get $left) (local.get $level)) (then (return (i32.const 0))))
    (if (i32.eqz (call $proof_universe_scope_valid_memo (local.get $base) (local.get $left) (local.get $count) (local.get $work) (local.get $memo)))
      (then (return (i32.const 0))))
    (if (i32.eq (local.get $kind) (i32.const 2)) (then (return (i32.const 1))))
    (local.set $right (call $proof_universe_right (local.get $base) (local.get $level)))
    (if (i32.ge_u (local.get $right) (local.get $level)) (then (return (i32.const 0))))
    (call $proof_universe_scope_valid_memo (local.get $base) (local.get $right) (local.get $count) (local.get $work) (local.get $memo)))

