        (br_if $string_done (i32.ge_u (local.get $cursor) (local.get $limit)))
        (local.set $first (i32.load8_u (call $abs (i32.add (local.get $artifact_base)
          (i32.add (local.get $reference) (i32.add (i32.const 12) (local.get $index)))))))
