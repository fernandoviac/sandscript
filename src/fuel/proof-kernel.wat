  ;; Compare a caller tree against a bounded, internally generated signature.
  ;; GLOBAL and INDUCTIVE are the same constant identity for an Eq reference.
  ;; No conversion, unfolding, proof irrelevance or caller-controlled rule applies.
  (func $proof_quotient_same
    (param $b i32) (param $actual i32) (param $expected i32) (param $work i32) (result i32)
    (local $tag i32) (local $other i32) (local $words i32) (local $i i32)
    (local $a i32) (local $e i32) (local $edge i32)
    (if (i32.eqz (call $proof_work_debit (local.get $b) (local.get $work))) (then (return (i32.const 0))))
    (if (i32.eq (local.get $actual) (local.get $expected)) (then (return (i32.const 1))))
    (if (i32.eqz (local.get $actual)) (then (return (i32.const 0))))
    (local.set $tag (call $proof_load (local.get $b) (i32.add (local.get $expected) (i32.const 4))))
    (local.set $other (call $proof_load (local.get $b) (i32.add (local.get $actual) (i32.const 4))))
    (if (i32.and (i32.eq (local.get $tag) (i32.const 3)) (i32.eq (local.get $other) (i32.const 4)))
      (then (local.set $other (i32.const 3))))
    (local.set $words (call $proof_load (local.get $b) (local.get $expected)))
    (if (i32.or (i32.ne (local.get $tag) (local.get $other))
          (i32.ne (local.get $words) (call $proof_load (local.get $b) (local.get $actual))))
      (then (return (i32.const 0))))
    (local.set $i (i32.const 8))
    (block $done (loop $next
      (br_if $done (i32.ge_u (local.get $i) (i32.mul (local.get $words) (i32.const 4))))
      (local.set $a (call $proof_load (local.get $b) (i32.add (local.get $actual) (local.get $i))))
      (local.set $e (call $proof_load (local.get $b) (i32.add (local.get $expected) (local.get $i))))
      (local.set $edge (i32.or (i32.eq (local.get $tag) (i32.const 1))
        (i32.or (i32.eq (local.get $tag) (i32.const 6)) (i32.eq (local.get $tag) (i32.const 8)))))
      (if (i32.or (i32.eq (local.get $tag) (i32.const 3)) (i32.eq (local.get $tag) (i32.const 256)))
        (then (local.set $edge (i32.ge_u (local.get $i) (i32.const 12)))))
      (if (local.get $edge)
        (then (if (i32.eqz (call $proof_quotient_same (local.get $b) (local.get $a) (local.get $e) (local.get $work)))
          (then (return (i32.const 0)))))
        (else (if (i32.ne (local.get $a) (local.get $e)) (then (return (i32.const 0))))))
      (local.set $i (i32.add (local.get $i) (i32.const 4))) (br $next)))
    (i32.const 1)
  )

  (func $proof_quotient_types
    (param $b i32) (param $eq i32) (param $quot i32) (param $mk i32) (result i32)
    (local $zero i32) (local $u i32) (local $v i32)
    (local $uargs i32) (local $vargs i32) (local $types i32) (local $t i32)
