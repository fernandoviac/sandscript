  (func $proof_state_equality_shape
    (param $b i32) (param $type i32) (result i32)
    (local $head i32) (local $decl i32) (local $ctor i32) (local $body i32) (local $i i32) (local $x i32) (local $parameters i32)
    (local.set $head (call $proof_application_head (local.get $b) (local.get $type)))
    (if (i32.ne (call $proof_load (local.get $b) (i32.add (local.get $head) (i32.const 4))) (global.get $PROOF_TERM_INDUCTIVE)) (then (return (i32.const 0))))
    (local.set $decl (call $proof_declaration_reference (local.get $b) (call $proof_load (local.get $b) (i32.add (local.get $head) (i32.const 8)))))
    (local.set $parameters (call $proof_load (local.get $b) (i32.add (local.get $decl) (i32.const 16))))
    ;; Both homogeneous equality layouts have three total family arguments:
    ;; custom Eq fixes A; canonical Eq fixes A and its left endpoint.
    (if (i32.or
      (i32.or (i32.lt_u (local.get $parameters) (i32.const 1))
        (i32.gt_u (local.get $parameters) (i32.const 2)))
      (i32.ne (i32.add (local.get $parameters)
        (call $proof_load (local.get $b) (i32.add (local.get $decl) (i32.const 20)))) (i32.const 3)))
      (then (return (i32.const 0))))
    (local.set $ctor (call $proof_load (local.get $b) (i32.add (local.get $decl) (i32.const 24))))
    (if (i32.ne (call $proof_array_count (local.get $b) (local.get $ctor)) (i32.const 1)) (then (return (i32.const 0))))
    (local.set $ctor (call $proof_array_get (local.get $b) (local.get $ctor) (i32.const 0)))
    (local.set $body (call $proof_load (local.get $b) (i32.add (local.get $ctor) (i32.const 8))))
    (if (i32.ne (call $proof_product_count (local.get $b) (local.get $body)) (i32.const 2)) (then (return (i32.const 0))))
    (local.set $body (call $proof_load (local.get $b) (i32.add (local.get $body) (i32.const 12))))
    (local.set $x (call $proof_load (local.get $b) (i32.add (local.get $body) (i32.const 8))))
    (if (i32.or (i32.ne (call $proof_load (local.get $b) (i32.add (local.get $x) (i32.const 4))) (i32.const 2)) (i32.ne (call $proof_load (local.get $b) (i32.add (local.get $x) (i32.const 8))) (i32.const 0))) (then (return (i32.const 0))))
    (local.set $body (call $proof_load (local.get $b) (i32.add (local.get $body) (i32.const 12))))
    (if (i32.ne (call $proof_application_count (local.get $b) (local.get $body)) (i32.const 3)) (then (return (i32.const 0))))
    (local.set $x (call $proof_application_head (local.get $b) (local.get $body)))
    (if (i32.or (i32.ne (call $proof_load (local.get $b) (i32.add (local.get $x) (i32.const 4))) (i32.const 4)) (i32.ne (call $proof_load (local.get $b) (i32.add (local.get $x) (i32.const 8))) (call $proof_load (local.get $b) (i32.add (local.get $head) (i32.const 8))))) (then (return (i32.const 0))))
    (block $done (loop $next
      (br_if $done (i32.eq (local.get $i) (i32.const 3)))
