            (i32.const 24))
          (global.get $OBJ_THEOREM))
      (then (return (i32.const 0))))
    (i32.eq
      (call $proof_native_handle_kind (local.get $handle))
      (global.get $PROOF_HANDLE_THEOREM))
  )

  ;; Mint a term view over a checked theorem's existing canonical artifact.
