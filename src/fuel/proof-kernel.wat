      (br_if $done (i32.eqz (local.get $remaining)))
      (local.set $chunk (select (i32.const 256) (local.get $remaining)
        (i32.gt_u (local.get $remaining) (i32.const 256))))
      (local.set $remaining (i32.sub (local.get $remaining) (local.get $chunk)))
      (if (local.get $backward) (then (local.set $offset (local.get $remaining))))
      (memory.copy
        (call $abs (i32.add (local.get $artifact_base) (i32.add (local.get $destination) (local.get $offset))))
        (call $abs (i32.add (local.get $artifact_base) (i32.add (local.get $source) (local.get $offset))))
        (local.get $chunk))
