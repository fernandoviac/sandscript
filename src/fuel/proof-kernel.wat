    (local.set $v (call $proof_make_universe_parameter (local.get $b) (i32.const 1)))
    (local.set $uargs (call $proof_make_array (local.get $b) (i32.const 1)))
    (local.set $vargs (call $proof_make_array (local.get $b) (i32.const 1)))
    (local.set $types (call $proof_make_array (local.get $b) (i32.const 6)))
    (if (global.get $proof_last_error_code) (then (return (i32.const 0))))
    (call $proof_array_set (local.get $b) (local.get $uargs) (i32.const 0) (local.get $u))
    (call $proof_array_set (local.get $b) (local.get $vargs) (i32.const 0) (local.get $v))
    (local.set $t (call $proof_quotient_type_quot (local.get $b) (local.get $eq) (local.get $quot) (local.get $mk)
      (local.get $zero) (local.get $u) (local.get $v) (local.get $uargs) (local.get $vargs)))
    (if (i32.eqz (local.get $t)) (then (return (i32.const 0))))
    (call $proof_array_set (local.get $b) (local.get $types) (i32.const 0) (local.get $t))
    (local.set $t (call $proof_quotient_type_mk (local.get $b) (local.get $eq) (local.get $quot) (local.get $mk)
      (local.get $zero) (local.get $u) (local.get $v) (local.get $uargs) (local.get $vargs)))
    (if (i32.eqz (local.get $t)) (then (return (i32.const 0))))
    (call $proof_array_set (local.get $b) (local.get $types) (i32.const 1) (local.get $t))
    (local.set $t (call $proof_quotient_type_lift (local.get $b) (local.get $eq) (local.get $quot) (local.get $mk)
      (local.get $zero) (local.get $u) (local.get $v) (local.get $uargs) (local.get $vargs)))
    (if (i32.eqz (local.get $t)) (then (return (i32.const 0))))
    (call $proof_array_set (local.get $b) (local.get $types) (i32.const 2) (local.get $t))
    (local.set $t (call $proof_quotient_type_ind (local.get $b) (local.get $eq) (local.get $quot) (local.get $mk)
      (local.get $zero) (local.get $u) (local.get $v) (local.get $uargs) (local.get $vargs)))
    (if (i32.eqz (local.get $t)) (then (return (i32.const 0))))
    (call $proof_array_set (local.get $b) (local.get $types) (i32.const 3) (local.get $t))
    (local.set $t (call $proof_quotient_type_eq (local.get $b) (local.get $eq) (local.get $quot) (local.get $mk)
      (local.get $zero) (local.get $u) (local.get $v) (local.get $uargs) (local.get $vargs)))
    (if (i32.eqz (local.get $t)) (then (return (i32.const 0))))
    (call $proof_array_set (local.get $b) (local.get $types) (i32.const 4) (local.get $t))
    (local.set $t (call $proof_quotient_type_refl (local.get $b) (local.get $eq) (local.get $quot) (local.get $mk)
      (local.get $zero) (local.get $u) (local.get $v) (local.get $uargs) (local.get $vargs)))
    (if (i32.eqz (local.get $t)) (then (return (i32.const 0))))
    (call $proof_array_set (local.get $b) (local.get $types) (i32.const 5) (local.get $t))
