        (return (i32.const 0))))
    (local.set $count (call $proof_load (local.get $artifact_base) (local.get $left_reference)))
    (if (i32.ne (local.get $count) (call $proof_load (local.get $artifact_base) (local.get $right_reference)))
      (then (global.set $proof_last_error_code (i32.const 72)) (return (i32.const 0))))
