  ;; Shared constructor-branch shape for match checking and elaboration.
  ;; Instantiates one constructor against the applied scrutinee family and
  ;; returns the dependent Product the branch body must inhabit. Returns
  ;; zero on allocation failure and one for an unreachable constructor.
  (func $proof_match_branch_shape
    (param $artifact_base i32)
    (param $declaration_index i32)
    (param $constructor i32)
    (param $constructor_index i32)
    (param $scrutinee_type i32)
    (param $universe_arguments i32)
    (param $parameter_count i32)
    (param $index_count i32)
    (param $predicate i32) (param $context_reference i32) (param $recursive_definitions i32) (param $recursive_context_size i32) (param $work i32)
    (result i32)
    (local $current i32)
    (local $field_domains i32)
    (local $field_count i32)
    (local $field_context i32)
    (local $constructor_result i32)
    (local $index i32)
    (local $shifted i32)
    (local $constructed_value i32)
    (local $expected_branch_type i32)
    (local.set $current
      (call $proof_instantiate_term_universes
        (local.get $artifact_base)
        (call $proof_load (local.get $artifact_base)
          (i32.add (local.get $constructor) (i32.const 8)))
        (local.get $universe_arguments) (local.get $work)))
    (if (i32.eqz (local.get $current)) (then (return (i32.const 0))))
    (local.set $index (i32.const 0))
    (block $parameters_done
      (loop $parameters_next
        (br_if $parameters_done
          (i32.ge_u (local.get $index) (local.get $parameter_count)))
        (local.set $current
          (call $proof_instantiate_binder
            (local.get $artifact_base)
            (call $proof_load (local.get $artifact_base)
              (i32.add (local.get $current) (i32.const 12)))
            (call $proof_application_argument
              (local.get $artifact_base)
              (local.get $scrutinee_type)
              (local.get $index))))
        (if (i32.eqz (local.get $current)) (then (return (i32.const 0))))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $parameters_next)))
    (local.set $field_count
      (call $proof_product_count
        (local.get $artifact_base) (local.get $current)))
    (local.set $field_domains
      (call $proof_make_array
        (local.get $artifact_base) (local.get $field_count)))
    (if (i32.eqz (local.get $field_domains)) (then (return (i32.const 0))))
    (local.set $index (i32.const 0))
    (block $fields_done
      (loop $fields_next
        (br_if $fields_done
          (i32.ge_u (local.get $index) (local.get $field_count)))
        (call $proof_array_set
          (local.get $artifact_base)
          (local.get $field_domains)
          (local.get $index)
          (call $proof_load (local.get $artifact_base)
            (i32.add (local.get $current) (i32.const 8))))
        (local.set $current
          (call $proof_load (local.get $artifact_base)
            (i32.add (local.get $current) (i32.const 12))))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $fields_next)))
    (local.set $constructor_result (local.get $current))
    (local.set $field_context (local.get $context_reference))
    (if (local.get $index_count) (then
      (local.set $field_context (call $proof_context_extend_telescope
        (local.get $artifact_base) (local.get $context_reference)
        (local.get $field_domains) (local.get $field_count)))
      (if (i32.eqz (local.get $field_context)) (then (return (i32.const 0))))))
    (local.set $index (i32.const 0))
    (block $result_indices_done
      (loop $result_indices_next
        (br_if $result_indices_done
          (i32.ge_u (local.get $index) (local.get $index_count)))
        (local.set $shifted
          (call $proof_shift
            (local.get $artifact_base)
            (call $proof_application_argument
              (local.get $artifact_base) (local.get $scrutinee_type)
              (i32.add (local.get $parameter_count) (local.get $index)))
            (local.get $field_count) (i32.const 0) (i32.const 0)))
        (if (i32.eqz (local.get $shifted)) (then (return (i32.const 0))))
        (if (i32.eqz
              (call $proof_terms_may_unify
                (local.get $artifact_base)
                (call $proof_application_argument
                  (local.get $artifact_base) (local.get $constructor_result)
                  (i32.add (local.get $parameter_count) (local.get $index)))
                (local.get $shifted) (local.get $field_context) (local.get $recursive_definitions) (local.get $recursive_context_size) (local.get $work)))
          (then (return (i32.const 1))))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $result_indices_next)))
    (local.set $constructed_value
      (call $proof_make_three
        (local.get $artifact_base) (global.get $PROOF_TERM_CONSTRUCTOR)
        (local.get $declaration_index) (local.get $constructor_index)
        (local.get $universe_arguments)))
    (if (i32.eqz (local.get $constructed_value))
      (then (return (i32.const 0))))
    (local.set $index (i32.const 0))
    (block $constructed_parameters_done
      (loop $constructed_parameters_next
        (br_if $constructed_parameters_done
          (i32.ge_u (local.get $index) (local.get $parameter_count)))
        (local.set $shifted
          (call $proof_shift
            (local.get $artifact_base)
            (call $proof_application_argument
              (local.get $artifact_base) (local.get $scrutinee_type)
              (local.get $index))
            (local.get $field_count) (i32.const 0) (i32.const 0)))
        (if (i32.eqz (local.get $shifted)) (then (return (i32.const 0))))
        (local.set $constructed_value
          (call $proof_make_two
            (local.get $artifact_base) (global.get $PROOF_TERM_APPLICATION)
            (local.get $constructed_value)
            (local.get $shifted)))
        (if (i32.eqz (local.get $constructed_value))
          (then (return (i32.const 0))))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $constructed_parameters_next)))
    (local.set $index (i32.const 0))
    (block $constructed_fields_done
      (loop $constructed_fields_next
        (br_if $constructed_fields_done
          (i32.ge_u (local.get $index) (local.get $field_count)))
        (local.set $constructed_value
          (call $proof_make_two
            (local.get $artifact_base) (global.get $PROOF_TERM_APPLICATION)
            (local.get $constructed_value)
            (call $proof_make_one
              (local.get $artifact_base) (global.get $PROOF_TERM_BOUND)
              (i32.sub
                (i32.sub (local.get $field_count) (local.get $index))
                (i32.const 1)))))
        (if (i32.eqz (local.get $constructed_value))
          (then (return (i32.const 0))))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $constructed_fields_next)))
    (local.set $expected_branch_type
      (call $proof_shift
        (local.get $artifact_base) (local.get $predicate)
        (local.get $field_count) (i32.const 0) (i32.const 0)))
    (if (i32.eqz (local.get $expected_branch_type))
      (then (return (i32.const 0))))
    (local.set $index (i32.const 0))
    (block $motive_indices_done
      (loop $motive_indices_next
        (br_if $motive_indices_done
          (i32.ge_u (local.get $index) (local.get $index_count)))
        (local.set $expected_branch_type
          (call $proof_make_two
            (local.get $artifact_base) (global.get $PROOF_TERM_APPLICATION)
            (local.get $expected_branch_type)
            (call $proof_application_argument
              (local.get $artifact_base) (local.get $constructor_result)
              (i32.add (local.get $parameter_count) (local.get $index)))))
        (if (i32.eqz (local.get $expected_branch_type))
          (then (return (i32.const 0))))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $motive_indices_next)))
    (local.set $expected_branch_type
      (call $proof_make_two
        (local.get $artifact_base) (global.get $PROOF_TERM_APPLICATION)
        (local.get $expected_branch_type) (local.get $constructed_value)))
    (if (i32.eqz (local.get $expected_branch_type))
      (then (return (i32.const 0))))
    (local.set $index (local.get $field_count))
    (block $wrap_fields_done
      (loop $wrap_fields_next
        (br_if $wrap_fields_done (i32.eqz (local.get $index)))
        (local.set $index (i32.sub (local.get $index) (i32.const 1)))
        (local.set $expected_branch_type
          (call $proof_make_two
            (local.get $artifact_base) (global.get $PROOF_TERM_PRODUCT)
            (call $proof_array_get (local.get $artifact_base)
              (local.get $field_domains) (local.get $index))
            (local.get $expected_branch_type)))
        (if (i32.eqz (local.get $expected_branch_type))
          (then (return (i32.const 0))))
        (br $wrap_fields_next)))
    (local.get $expected_branch_type)
  )

  ;; Check one supplied-field constructor application against an expected
  ;; inductive application. Family parameters come from the expected
  ;; application; supplied fields check left to right against successive
  ;; dependent Product domains; the residual constructor result must convert
  ;; to the expected family and indices. Emits the ordinary constructor
  ;; application. Returns zero on rejection.
  (func $proof_native_elaborate_constructor_application
    (param $artifact_base i32)
    (param $declaration_index i32)
    (param $constructor_index i32)
    (param $fields_array i32)
    (param $expected_type i32)
    (param $context_reference i32)
    (param $recursive_definitions i32)
    (param $recursive_context_size i32) (param $work i32)
    (result i32)
    (local $normalized i32)
    (local $head i32)
    (local $declaration i32)
    (local $parameter_count i32)
    (local $index_count i32)
    (local $universe_arguments i32)
    (local $constructors i32)
    (local $cursor i32)
    (local $result i32)
    (local $index i32)
    (local $count i32)
    (local $elaborated i32)
    (local.set $normalized
      (call $proof_weak_head_normalize
        (local.get $artifact_base)
        (local.get $expected_type)
        (local.get $context_reference) (local.get $recursive_definitions) (local.get $recursive_context_size) (local.get $work)))
    (if (i32.eqz (local.get $normalized))
      (then
        (global.set $proof_last_error_code (i32.const 76))
        (return (i32.const 0))))
    (local.set $head
      (call $proof_application_head
        (local.get $artifact_base) (local.get $normalized)))
    (if (i32.or
          (i32.ne
            (call $proof_load (local.get $artifact_base)
              (i32.add (local.get $head) (i32.const 4)))
            (global.get $PROOF_TERM_INDUCTIVE))
          (i32.ne
            (call $proof_load (local.get $artifact_base)
              (i32.add (local.get $head) (i32.const 8)))
            (local.get $declaration_index)))
      (then
        (global.set $proof_last_error_code (i32.const 76))
        (return (i32.const 0))))
    (local.set $declaration
      (call $proof_declaration_reference
        (local.get $artifact_base) (local.get $declaration_index)))
    (if (i32.eqz
          (i32.or
            (i32.eq
              (call $proof_load (local.get $artifact_base)
                (i32.add (local.get $declaration) (i32.const 4)))
              (global.get $PROOF_RECORD_INDUCTIVE_DECLARATION))
            (i32.eq
              (call $proof_load (local.get $artifact_base)
                (i32.add (local.get $declaration) (i32.const 4)))
              (global.get $PROOF_RECORD_COINDUCTIVE_DECLARATION))))
      (then
        (global.set $proof_last_error_code (i32.const 76))
        (return (i32.const 0))))
    (local.set $parameter_count
      (call $proof_load (local.get $artifact_base)
        (i32.add (local.get $declaration) (i32.const 16))))
    (local.set $index_count
      (call $proof_load (local.get $artifact_base)
        (i32.add (local.get $declaration) (i32.const 20))))
    (if (i32.ne
          (call $proof_application_count
            (local.get $artifact_base) (local.get $normalized))
          (i32.add (local.get $parameter_count) (local.get $index_count)))
      (then
        (global.set $proof_last_error_code (i32.const 76))
        (return (i32.const 0))))
    (local.set $universe_arguments
      (call $proof_load (local.get $artifact_base)
        (i32.add (local.get $head) (i32.const 12))))
    (local.set $constructors
      (call $proof_load (local.get $artifact_base)
        (i32.add (local.get $declaration) (i32.const 24))))
    (if (i32.ge_u
          (local.get $constructor_index)
          (call $proof_array_count
            (local.get $artifact_base) (local.get $constructors)))
      (then
        (global.set $proof_last_error_code (i32.const 76))
        (return (i32.const 0))))
    (local.set $cursor
      (call $proof_instantiate_term_universes
        (local.get $artifact_base)
        (call $proof_load (local.get $artifact_base)
          (i32.add
            (call $proof_array_get
              (local.get $artifact_base)
              (local.get $constructors)
              (local.get $constructor_index))
            (i32.const 8)))
        (local.get $universe_arguments) (local.get $work)))
    (if (i32.eqz (local.get $cursor)) (then (return (i32.const 0))))
    (local.set $result
      (call $proof_make_three
        (local.get $artifact_base) (global.get $PROOF_TERM_CONSTRUCTOR)
        (local.get $declaration_index) (local.get $constructor_index)
        (local.get $universe_arguments)))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (local.set $index (i32.const 0))
    (block $parameters_done
      (loop $parameters_next
        (br_if $parameters_done
          (i32.ge_u (local.get $index) (local.get $parameter_count)))
        (local.set $cursor
          (call $proof_instantiate_binder
            (local.get $artifact_base)
            (call $proof_load (local.get $artifact_base)
              (i32.add (local.get $cursor) (i32.const 12)))
            (call $proof_application_argument
              (local.get $artifact_base)
              (local.get $normalized)
              (local.get $index))))
        (if (i32.eqz (local.get $cursor)) (then (return (i32.const 0))))
        (local.set $result
          (call $proof_make_two
            (local.get $artifact_base) (global.get $PROOF_TERM_APPLICATION)
            (local.get $result)
            (call $proof_application_argument
              (local.get $artifact_base)
              (local.get $normalized)
              (local.get $index))))
        (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $parameters_next)))
    (local.set $count
      (call $proof_array_count
        (local.get $artifact_base) (local.get $fields_array)))
    (local.set $index (i32.const 0))
    (block $fields_done
      (loop $fields_next
        (br_if $fields_done (i32.ge_u (local.get $index) (local.get $count)))
        (if (i32.ne
              (call $proof_load (local.get $artifact_base)
                (i32.add (local.get $cursor) (i32.const 4)))
              (global.get $PROOF_TERM_PRODUCT))
          (then
            (global.set $proof_last_error_code (i32.const 76))
            (return (i32.const 0))))
        (local.set $elaborated
          (call $proof_native_elaborate_checked_term
            (local.get $artifact_base)
            (call $proof_array_get
              (local.get $artifact_base)
              (local.get $fields_array)
              (local.get $index))
            (call $proof_load (local.get $artifact_base)
              (i32.add (local.get $cursor) (i32.const 8)))
            (local.get $context_reference)
            (local.get $recursive_definitions)
            (local.get $recursive_context_size) (local.get $work)))
        (if (i32.eqz (local.get $elaborated))
          (then (return (i32.const 0))))
        (local.set $result
          (call $proof_make_two
            (local.get $artifact_base) (global.get $PROOF_TERM_APPLICATION)
            (local.get $result) (local.get $elaborated)))
        (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
        (local.set $cursor
          (call $proof_instantiate_binder
            (local.get $artifact_base)
            (call $proof_load (local.get $artifact_base)
              (i32.add (local.get $cursor) (i32.const 12)))
            (local.get $elaborated)))
        (if (i32.eqz (local.get $cursor)) (then (return (i32.const 0))))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $fields_next)))
    (if (i32.eq
          (call $proof_load (local.get $artifact_base)
            (i32.add (local.get $cursor) (i32.const 4)))
          (global.get $PROOF_TERM_PRODUCT))
      (then
        (global.set $proof_last_error_code (i32.const 76))
        (return (i32.const 0))))
    (if (i32.eqz
          (call $proof_convertible
            (local.get $artifact_base)
            (local.get $cursor)
            (local.get $normalized)
            (local.get $context_reference) (local.get $recursive_definitions) (local.get $recursive_context_size) (local.get $work)))
      (then
        (global.set $proof_last_error_code (i32.const 76))
        (return (i32.const 0))))
    (if (i32.eqz
          (call $proof_native_elaboration_check_term
            (local.get $artifact_base)
            (local.get $result)
            (local.get $expected_type)
            (local.get $context_reference)
            (local.get $recursive_definitions)
            (local.get $recursive_context_size) (local.get $work)))
      (then (return (i32.const 0))))
    (local.get $result)
  )

  ;; Lower a record literal to the ordinary constructor application. Source
  ;; names map to the canonical constructor field metadata; duplicate,
  ;; unknown, and missing fields reject. Values are reordered into
  ;; declaration order so later fields may depend on earlier ones.
(func $proof_native_elaborate_record_literal
    (param $artifact_base i32)
    (param $source_term i32)
    (param $expected_type i32)
    (param $context_reference i32)
    (param $recursive_definitions i32)
    (param $recursive_context_size i32) (param $work i32)
    (result i32)
    (local $normalized i32)
    (local $head i32)
    (local $declaration_index i32)
    (local $declaration i32)
    (local $constructors i32)
    (local $constructor i32)
    (local $metadata i32)
    (local $metadata_count i32)
    (local $names i32)
    (local $values i32)
    (local $ordered i32)
    (local $metadata_index i32)
    (local $source_index i32)
    (local $metadata_record i32)
    (local $source_record i32)
    (local $name_length i32)
    (local $byte_index i32)
    (local $mismatch i32)
    (local $match_count i32)
    (local $match_index i32)
    (local.set $normalized
      (call $proof_weak_head_normalize
        (local.get $artifact_base)
        (local.get $expected_type)
        (local.get $context_reference) (local.get $recursive_definitions) (local.get $recursive_context_size) (local.get $work)))
    (if (i32.eqz (local.get $normalized))
      (then
        (global.set $proof_last_error_code (i32.const 77))
        (return (i32.const 0))))
    (local.set $head
      (call $proof_application_head
        (local.get $artifact_base) (local.get $normalized)))
    (if (i32.ne
          (call $proof_load (local.get $artifact_base)
            (i32.add (local.get $head) (i32.const 4)))
          (global.get $PROOF_TERM_INDUCTIVE))
      (then
        (global.set $proof_last_error_code (i32.const 77))
        (return (i32.const 0))))
    (local.set $declaration_index
      (call $proof_load (local.get $artifact_base)
        (i32.add (local.get $head) (i32.const 8))))
    (local.set $declaration
      (call $proof_declaration_reference
        (local.get $artifact_base) (local.get $declaration_index)))
    (if (i32.ne
          (call $proof_load (local.get $artifact_base)
            (i32.add (local.get $declaration) (i32.const 4)))
          (global.get $PROOF_RECORD_INDUCTIVE_DECLARATION))
      (then
        (global.set $proof_last_error_code (i32.const 77))
        (return (i32.const 0))))
    (local.set $constructors
      (call $proof_load (local.get $artifact_base)
        (i32.add (local.get $declaration) (i32.const 24))))
    (if (i32.ne
          (call $proof_array_count
            (local.get $artifact_base) (local.get $constructors))
          (i32.const 1))
      (then
        (global.set $proof_last_error_code (i32.const 77))
        (return (i32.const 0))))
    (local.set $constructor
      (call $proof_array_get
        (local.get $artifact_base) (local.get $constructors) (i32.const 0)))
    (if (i32.ne
          (call $proof_load
            (local.get $artifact_base) (local.get $constructor))
          (i32.const 5))
      (then
        (global.set $proof_last_error_code (i32.const 77))
        (return (i32.const 0))))
    (local.set $metadata
      (call $proof_load (local.get $artifact_base)
        (i32.add (local.get $constructor) (i32.const 12))))
    (local.set $metadata_count
      (call $proof_array_count
        (local.get $artifact_base) (local.get $metadata)))
    (local.set $names
      (call $proof_load (local.get $artifact_base)
        (i32.add (local.get $source_term) (i32.const 8))))
    (local.set $values
      (call $proof_load (local.get $artifact_base)
        (i32.add (local.get $source_term) (i32.const 12))))
    (if (i32.or
          (i32.ne
            (call $proof_array_count
              (local.get $artifact_base) (local.get $names))
            (local.get $metadata_count))
          (i32.ne
            (call $proof_array_count
              (local.get $artifact_base) (local.get $values))
            (local.get $metadata_count)))
      (then
        (global.set $proof_last_error_code (i32.const 77))
        (return (i32.const 0))))
    (local.set $ordered
      (call $proof_make_array
        (local.get $artifact_base) (local.get $metadata_count)))
    (if (i32.eqz (local.get $ordered)) (then (return (i32.const 0))))
    (local.set $metadata_index (i32.const 0))
    (block $metadata_done
      (loop $metadata_next
        (br_if $metadata_done
          (i32.ge_u
            (local.get $metadata_index)
            (local.get $metadata_count)))
        (local.set $metadata_record
          (call $proof_array_get
            (local.get $artifact_base)
            (local.get $metadata)
            (local.get $metadata_index)))
        (local.set $name_length
          (call $proof_load (local.get $artifact_base)
            (i32.add (local.get $metadata_record) (i32.const 8))))
        (local.set $match_count (i32.const 0))
        (local.set $match_index (i32.const 0))
        (local.set $source_index (i32.const 0))
        (block $sources_done
          (loop $sources_next
            (br_if $sources_done
              (i32.ge_u
                (local.get $source_index)
                (local.get $metadata_count)))
            (local.set $source_record
              (call $proof_array_get
                (local.get $artifact_base)
                (local.get $names)
                (local.get $source_index)))
            (if (i32.eq
                  (call $proof_load (local.get $artifact_base)
                    (i32.add (local.get $source_record) (i32.const 8)))
                  (local.get $name_length))
              (then
                (local.set $mismatch (i32.const 0))
                (local.set $byte_index (i32.const 0))
                (block $bytes_done
                  (loop $bytes_next
                    (br_if $bytes_done
                      (i32.ge_u
                        (local.get $byte_index)
                        (local.get $name_length)))
                    (if (i32.ne
                          (i32.load8_u
                            (call $abs
                              (i32.add
                                (i32.add
                                  (local.get $artifact_base)
                                  (i32.add
                                    (local.get $metadata_record)
                                    (i32.const 20)))
                                (local.get $byte_index))))
                          (i32.load8_u
                            (call $abs
                              (i32.add
                                (i32.add
                                  (local.get $artifact_base)
                                  (i32.add
                                    (local.get $source_record)
                                    (i32.const 16)))
                                (local.get $byte_index)))))
                      (then
                        (local.set $mismatch (i32.const 1))
                        (br $bytes_done)))
                    (local.set $byte_index
                      (i32.add (local.get $byte_index) (i32.const 1)))
                    (br $bytes_next)))
                (if (i32.eqz (local.get $mismatch))
                  (then
                    (local.set $match_count
                      (i32.add (local.get $match_count) (i32.const 1)))
                    (local.set $match_index
                      (local.get $source_index))))))
            (local.set $source_index
              (i32.add (local.get $source_index) (i32.const 1)))
            (br $sources_next)))
        (if (i32.ne (local.get $match_count) (i32.const 1))
          (then
            (global.set $proof_last_error_code (i32.const 77))
            (return (i32.const 0))))
        (call $proof_array_set
          (local.get $artifact_base)
          (local.get $ordered)
          (local.get $metadata_index)
          (call $proof_array_get
            (local.get $artifact_base)
            (local.get $values)
            (local.get $match_index)))
        (local.set $metadata_index
          (i32.add (local.get $metadata_index) (i32.const 1)))
        (br $metadata_next)))
    (call $proof_native_elaborate_constructor_application
      (local.get $artifact_base)
      (local.get $declaration_index)
      (i32.const 0)
      (local.get $ordered)
      (local.get $expected_type)
      (local.get $context_reference)
      (local.get $recursive_definitions)
      (local.get $recursive_context_size) (local.get $work))
  )

  ;; Lower a motive-less match. The scrutinee family is inferred and a
  ;; constant motive is built by shifting the outer expected type beneath
  ;; the family indices and the scrutinee binder. Branch bodies check
  ;; recursively against the shared constructor branch shapes; the kernel
  ;; then rechecks coverage, reachability, and elimination restrictions.
  (func $proof_native_elaborate_expected_match
    (param $artifact_base i32)
    (param $source_term i32)
    (param $expected_type i32)
    (param $context_reference i32)
    (param $recursive_definitions i32)
    (param $recursive_context_size i32) (param $work i32)
    (result i32)
    (local $scrutinee i32)
    (local $scrutinee_type i32)
    (local $head i32)
    (local $declaration_index i32)
    (local $declaration i32)
    (local $parameter_count i32)
    (local $index_count i32)
    (local $universe_arguments i32)
    (local $family_cursor i32)
    (local $index_domains i32)
    (local $scrutinee_domain i32)
    (local $predicate i32)
    (local $shifted i32)
    (local $constructors i32)
    (local $constructor_count i32)
    (local $branches_source i32)
    (local $branch_count i32)
    (local $branch_index i32)
    (local $branch i32)
    (local $ordinal i32)
    (local $expected_branch_type i32)
    (local $body_result i32)
    (local $new_branches i32)
    (local $result i32)
    (local $index i32)
    (local.set $scrutinee
      (call $proof_load (local.get $artifact_base)
        (i32.add (local.get $source_term) (i32.const 8))))
    (local.set $branches_source
      (call $proof_load (local.get $artifact_base)
        (i32.add (local.get $source_term) (i32.const 12))))
    (local.set $scrutinee_type
      (call $proof_infer_term
        (local.get $artifact_base) (local.get $scrutinee)
        (local.get $context_reference)
        (local.get $recursive_definitions)
        (local.get $recursive_context_size) (local.get $work)))
    (if (i32.eqz (local.get $scrutinee_type))
      (then (return (i32.const 0))))
    (local.set $scrutinee_type
      (call $proof_weak_head_normalize
        (local.get $artifact_base)
        (local.get $scrutinee_type)
        (local.get $context_reference) (local.get $recursive_definitions) (local.get $recursive_context_size) (local.get $work)))
    (local.set $head
      (call $proof_application_head
        (local.get $artifact_base) (local.get $scrutinee_type)))
    (if (i32.ne
          (call $proof_load (local.get $artifact_base)
            (i32.add (local.get $head) (i32.const 4)))
          (global.get $PROOF_TERM_INDUCTIVE))
      (then
        (global.set $proof_last_error_code (i32.const 78))
        (return (i32.const 0))))
    (local.set $declaration_index
      (call $proof_load (local.get $artifact_base)
        (i32.add (local.get $head) (i32.const 8))))
    (local.set $declaration
      (call $proof_declaration_reference
        (local.get $artifact_base) (local.get $declaration_index)))
    (if (i32.ne
          (call $proof_load (local.get $artifact_base)
            (i32.add (local.get $declaration) (i32.const 4)))
          (global.get $PROOF_RECORD_INDUCTIVE_DECLARATION))
      (then
        (global.set $proof_last_error_code (i32.const 78))
        (return (i32.const 0))))
    (local.set $parameter_count
      (call $proof_load (local.get $artifact_base)
        (i32.add (local.get $declaration) (i32.const 16))))
    (local.set $index_count
      (call $proof_load (local.get $artifact_base)
        (i32.add (local.get $declaration) (i32.const 20))))
    (if (i32.ne
          (call $proof_application_count
            (local.get $artifact_base) (local.get $scrutinee_type))
          (i32.add (local.get $parameter_count) (local.get $index_count)))
      (then
        (global.set $proof_last_error_code (i32.const 78))
        (return (i32.const 0))))
    (local.set $universe_arguments
      (call $proof_load (local.get $artifact_base)
        (i32.add (local.get $head) (i32.const 12))))
    ;; Constant motive: family index binders, then the scrutinee binder,
    ;; then the outer expected type shifted beneath both.
    (local.set $family_cursor
      (call $proof_load (local.get $artifact_base)
        (i32.add (local.get $declaration) (i32.const 12))))
    (local.set $index (i32.const 0))
    (block $family_parameters_done
      (loop $family_parameters_next
        (br_if $family_parameters_done
          (i32.ge_u (local.get $index) (local.get $parameter_count)))
        (local.set $family_cursor
          (call $proof_instantiate_binder
            (local.get $artifact_base)
            (call $proof_load (local.get $artifact_base)
              (i32.add (local.get $family_cursor) (i32.const 12)))
            (call $proof_application_argument
              (local.get $artifact_base)
              (local.get $scrutinee_type)
              (local.get $index))))
        (if (i32.eqz (local.get $family_cursor))
          (then (return (i32.const 0))))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $family_parameters_next)))
    (local.set $index_domains
      (call $proof_make_array
        (local.get $artifact_base) (local.get $index_count)))
    (if (i32.eqz (local.get $index_domains)) (then (return (i32.const 0))))
    (local.set $index (i32.const 0))
    (block $index_domains_done
      (loop $index_domains_next
        (br_if $index_domains_done
          (i32.ge_u (local.get $index) (local.get $index_count)))
        (call $proof_array_set
          (local.get $artifact_base)
          (local.get $index_domains)
          (local.get $index)
          (call $proof_load (local.get $artifact_base)
            (i32.add (local.get $family_cursor) (i32.const 8))))
        (local.set $family_cursor
          (call $proof_load (local.get $artifact_base)
            (i32.add (local.get $family_cursor) (i32.const 12))))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $index_domains_next)))
    (local.set $scrutinee_domain
      (call $proof_make_two
        (local.get $artifact_base)
        (global.get $PROOF_TERM_INDUCTIVE)
        (local.get $declaration_index)
        (local.get $universe_arguments)))
    (if (i32.eqz (local.get $scrutinee_domain))
      (then (return (i32.const 0))))
    (local.set $index (i32.const 0))
    (block $domain_parameters_done
      (loop $domain_parameters_next
        (br_if $domain_parameters_done
          (i32.ge_u (local.get $index) (local.get $parameter_count)))
        (local.set $shifted
          (call $proof_shift
            (local.get $artifact_base)
            (call $proof_application_argument
              (local.get $artifact_base)
              (local.get $scrutinee_type)
              (local.get $index))
            (local.get $index_count) (i32.const 0) (i32.const 0)))
        (if (i32.eqz (local.get $shifted)) (then (return (i32.const 0))))
        (local.set $scrutinee_domain
          (call $proof_make_two
            (local.get $artifact_base) (global.get $PROOF_TERM_APPLICATION)
            (local.get $scrutinee_domain) (local.get $shifted)))
        (if (i32.eqz (local.get $scrutinee_domain))
          (then (return (i32.const 0))))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $domain_parameters_next)))
    (local.set $index (i32.const 0))
    (block $domain_indices_done
      (loop $domain_indices_next
        (br_if $domain_indices_done
          (i32.ge_u (local.get $index) (local.get $index_count)))
        (local.set $scrutinee_domain
          (call $proof_make_two
            (local.get $artifact_base) (global.get $PROOF_TERM_APPLICATION)
            (local.get $scrutinee_domain)
            (call $proof_make_one
              (local.get $artifact_base) (global.get $PROOF_TERM_BOUND)
              (i32.sub
                (i32.sub (local.get $index_count) (local.get $index))
                (i32.const 1)))))
        (if (i32.eqz (local.get $scrutinee_domain))
          (then (return (i32.const 0))))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $domain_indices_next)))
    (local.set $shifted
      (call $proof_shift
        (local.get $artifact_base) (local.get $expected_type)
        (i32.add (local.get $index_count) (i32.const 1))
        (i32.const 0) (i32.const 0)))
    (if (i32.eqz (local.get $shifted)) (then (return (i32.const 0))))
    (local.set $predicate
      (call $proof_make_two
        (local.get $artifact_base) (global.get $PROOF_TERM_LAMBDA)
        (local.get $scrutinee_domain) (local.get $shifted)))
    (if (i32.eqz (local.get $predicate)) (then (return (i32.const 0))))
    (local.set $index (local.get $index_count))
    (block $predicate_binders_done
      (loop $predicate_binders_next
        (br_if $predicate_binders_done (i32.eqz (local.get $index)))
        (local.set $index (i32.sub (local.get $index) (i32.const 1)))
        (local.set $predicate
          (call $proof_make_two
            (local.get $artifact_base) (global.get $PROOF_TERM_LAMBDA)
            (call $proof_array_get
              (local.get $artifact_base)
              (local.get $index_domains)
              (local.get $index))
            (local.get $predicate)))
        (if (i32.eqz (local.get $predicate)) (then (return (i32.const 0))))
        (br $predicate_binders_next)))
    (local.set $constructors
      (call $proof_load (local.get $artifact_base)
        (i32.add (local.get $declaration) (i32.const 24))))
    (local.set $constructor_count
      (call $proof_array_count
        (local.get $artifact_base) (local.get $constructors)))
    (local.set $branch_count
      (call $proof_array_count
        (local.get $artifact_base) (local.get $branches_source)))
    (local.set $new_branches
      (call $proof_make_array
        (local.get $artifact_base) (local.get $branch_count)))
    (if (i32.eqz (local.get $new_branches)) (then (return (i32.const 0))))
    (local.set $branch_index (i32.const 0))
    (block $branches_done
      (loop $branches_next
        (br_if $branches_done
          (i32.ge_u (local.get $branch_index) (local.get $branch_count)))
        (local.set $branch
          (call $proof_array_get
            (local.get $artifact_base)
            (local.get $branches_source)
            (local.get $branch_index)))
        (if (i32.ne
              (call $proof_load (local.get $artifact_base)
                (i32.add (local.get $branch) (i32.const 4)))
              (global.get $PROOF_TERM_BRANCH))
          (then
            (global.set $proof_last_error_code (i32.const 78))
            (return (i32.const 0))))
        (local.set $ordinal
          (call $proof_load (local.get $artifact_base)
            (i32.add (local.get $branch) (i32.const 8))))
        (if (i32.ge_u (local.get $ordinal) (local.get $constructor_count))
          (then
            (global.set $proof_last_error_code (i32.const 78))
            (return (i32.const 0))))
        (local.set $expected_branch_type
          (call $proof_match_branch_shape
            (local.get $artifact_base)
            (local.get $declaration_index)
            (call $proof_array_get
              (local.get $artifact_base)
              (local.get $constructors)
              (local.get $ordinal))
            (local.get $ordinal)
            (local.get $scrutinee_type)
            (local.get $universe_arguments)
            (local.get $parameter_count)
            (local.get $index_count)
            (local.get $predicate) (local.get $context_reference) (local.get $recursive_definitions) (local.get $recursive_context_size) (local.get $work)))
        (if (i32.eqz (local.get $expected_branch_type))
          (then (return (i32.const 0))))
        (if (i32.eq (local.get $expected_branch_type) (i32.const 1))
          (then
            (global.set $proof_last_error_code (i32.const 78))
            (return (i32.const 0))))
        (local.set $body_result
          (call $proof_native_elaborate_checked_term
            (local.get $artifact_base)
            (call $proof_load (local.get $artifact_base)
              (i32.add (local.get $branch) (i32.const 12)))
            (local.get $expected_branch_type)
            (local.get $context_reference)
            (local.get $recursive_definitions)
            (local.get $recursive_context_size) (local.get $work)))
        (if (i32.eqz (local.get $body_result))
          (then (return (i32.const 0))))
        (local.set $branch
          (call $proof_make_two
            (local.get $artifact_base) (global.get $PROOF_TERM_BRANCH)
            (local.get $ordinal) (local.get $body_result)))
        (if (i32.eqz (local.get $branch)) (then (return (i32.const 0))))
        (call $proof_array_set
          (local.get $artifact_base)
          (local.get $new_branches)
          (local.get $branch_index)
          (local.get $branch))
        (local.set $branch_index
          (i32.add (local.get $branch_index) (i32.const 1)))
        (br $branches_next)))
    (local.set $result
      (call $proof_make_three
        (local.get $artifact_base) (global.get $PROOF_TERM_MATCH)
        (local.get $scrutinee) (local.get $predicate)
        (local.get $new_branches)))
    (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
    (if (i32.eqz
          (call $proof_native_elaboration_check_term
            (local.get $artifact_base)
            (local.get $result)
            (local.get $expected_type)
            (local.get $context_reference)
            (local.get $recursive_definitions)
            (local.get $recursive_context_size) (local.get $work)))
      (then (return (i32.const 0))))
    (local.get $result)
  )

  (func $proof_infer_match
    (param $artifact_base i32)
    (param $term_reference i32)
    (param $context_reference i32)
    (param $recursive_definitions i32)
    (param $recursive_context_size i32) (param $work i32)
    (result i32)
    (local $scrutinee i32)
    (local $scrutinee_type i32)
    (local $scrutinee_head i32)
    (local $declaration_index i32)
    (local $declaration i32)
    (local $parameter_count i32)
    (local $index_count i32)
    (local $application_count i32)
    (local $universe_arguments i32)
    (local $predicate i32)
    (local $predicate_type i32)
    (local $index i32)
    (local $argument i32)
    (local $predicate_domain i32)
    (local $predicate_result_type i32)
    (local $predicate_context i32)
    (local $constructors i32)
    (local $constructor_count i32)
    (local $constructor_index i32)
    (local $constructor i32)
    (local $constructor_type i32)
    (local $current_constructor_type i32)
    (local $field_domains i32)
    (local $field_count i32)
    (local $constructor_result i32)
    (local $result_application_count i32)
    (local $reachable i32)
    (local $branches i32)
    (local $branch_count i32)
    (local $branch_index i32)
    (local $branch i32)
    (local $matched_branch i32)
    (local $matched_count i32)
    (local $constructed_value i32)
    (local $expected_branch_type i32)
    (local $shifted_predicate i32)
    (local $field_domain i32)
    (local.set $scrutinee
      (call $proof_load (local.get $artifact_base)
        (i32.add (local.get $term_reference) (i32.const 8))))
    (local.set $scrutinee_type
      (call $proof_infer_term
        (local.get $artifact_base) (local.get $scrutinee)
        (local.get $context_reference)
        (local.get $recursive_definitions) (local.get $recursive_context_size) (local.get $work)))
    (if (i32.eqz (local.get $scrutinee_type)) (then (return (i32.const 0))))
    (local.set $scrutinee_type
      (call $proof_weak_head_normalize
        (local.get $artifact_base) (local.get $scrutinee_type) (local.get $context_reference) (local.get $recursive_definitions) (local.get $recursive_context_size) (local.get $work)))
    (local.set $scrutinee_head
      (call $proof_application_head (local.get $artifact_base) (local.get $scrutinee_type)))
    (if (i32.ne
          (call $proof_load (local.get $artifact_base)
            (i32.add (local.get $scrutinee_head) (i32.const 4)))
          (global.get $PROOF_TERM_INDUCTIVE))
      (then
        (global.set $proof_last_error_code (i32.const 47))
        (return (i32.const 0))))
    (local.set $declaration_index
      (call $proof_load (local.get $artifact_base)
        (i32.add (local.get $scrutinee_head) (i32.const 8))))
    (local.set $declaration
      (call $proof_declaration_reference
        (local.get $artifact_base) (local.get $declaration_index)))
    (if (i32.ne
          (call $proof_load (local.get $artifact_base)
            (i32.add (local.get $declaration) (i32.const 4)))
          (global.get $PROOF_RECORD_INDUCTIVE_DECLARATION))
      (then
        (global.set $proof_last_error_code (i32.const 47))
        (return (i32.const 0))))
    (local.set $parameter_count
      (call $proof_load (local.get $artifact_base)
        (i32.add (local.get $declaration) (i32.const 16))))
    (local.set $index_count
      (call $proof_load (local.get $artifact_base)
        (i32.add (local.get $declaration) (i32.const 20))))
    (local.set $application_count
      (call $proof_application_count
        (local.get $artifact_base) (local.get $scrutinee_type)))
    (if (i32.ne (local.get $application_count)
          (i32.add (local.get $parameter_count) (local.get $index_count)))
      (then
        (global.set $proof_last_error_code (i32.const 48))
        (return (i32.const 0))))
    (local.set $universe_arguments
      (call $proof_load (local.get $artifact_base)
        (i32.add (local.get $scrutinee_head) (i32.const 12))))
    (local.set $predicate
      (call $proof_load (local.get $artifact_base)
        (i32.add (local.get $term_reference) (i32.const 12))))
    (local.set $predicate_type
      (call $proof_infer_term
        (local.get $artifact_base) (local.get $predicate)
        (local.get $context_reference)
        (local.get $recursive_definitions) (local.get $recursive_context_size) (local.get $work)))
    (local.set $predicate_type
      (call $proof_weak_head_normalize
        (local.get $artifact_base) (local.get $predicate_type) (local.get $context_reference) (local.get $recursive_definitions) (local.get $recursive_context_size) (local.get $work)))
    (local.set $index (i32.const 0))
    (block $indices_done
      (loop $indices_next
        (br_if $indices_done (i32.ge_u (local.get $index) (local.get $index_count)))
        (if (i32.ne
              (call $proof_load (local.get $artifact_base)
                (i32.add (local.get $predicate_type) (i32.const 4)))
              (global.get $PROOF_TERM_PRODUCT))
          (then
            (global.set $proof_last_error_code (i32.const 49))
            (return (i32.const 0))))
        (local.set $argument
          (call $proof_application_argument
            (local.get $artifact_base) (local.get $scrutinee_type)
            (i32.add (local.get $parameter_count) (local.get $index))))
        (if (i32.eqz
              (call $proof_check_term
                (local.get $artifact_base) (local.get $argument)
                (call $proof_load (local.get $artifact_base)
                  (i32.add (local.get $predicate_type) (i32.const 8)))
                (local.get $context_reference)
                (local.get $recursive_definitions) (local.get $recursive_context_size) (local.get $work)))
          (then
            (global.set $proof_last_error_code (i32.const 49))
            (return (i32.const 0))))
        (local.set $predicate_type
          (call $proof_weak_head_normalize
            (local.get $artifact_base)
            (call $proof_instantiate_binder
              (local.get $artifact_base)
              (call $proof_load (local.get $artifact_base)
                (i32.add (local.get $predicate_type) (i32.const 12)))
              (local.get $argument))
            (local.get $context_reference) (local.get $recursive_definitions) (local.get $recursive_context_size) (local.get $work)))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $indices_next)))
    (if (i32.or
          (i32.ne
            (call $proof_load (local.get $artifact_base)
              (i32.add (local.get $predicate_type) (i32.const 4)))
            (global.get $PROOF_TERM_PRODUCT))
          (i32.eqz
            (call $proof_convertible
              (local.get $artifact_base)
              (call $proof_load (local.get $artifact_base)
                (i32.add (local.get $predicate_type) (i32.const 8)))
              (local.get $scrutinee_type) (local.get $context_reference) (local.get $recursive_definitions) (local.get $recursive_context_size) (local.get $work))))
      (then
        (global.set $proof_last_error_code (i32.const 50))
        (global.set $proof_last_error_offset (local.get $term_reference))
        (return (i32.const 0))))
    ;; The codomain of the fully instantiated predicate type already is the
    ;; sort of the match result. Inferring it again would turn Prop into
    ;; Type(0) and incorrectly classify propositional elimination as large.
    (local.set $predicate_context (call $proof_context_extend
      (local.get $artifact_base) (local.get $context_reference)
      (call $proof_load (local.get $artifact_base)
        (i32.add (local.get $predicate_type) (i32.const 8)))))
    (if (i32.eqz (local.get $predicate_context)) (then (return (i32.const 0))))
    (local.set $predicate_result_type
      (call $proof_weak_head_normalize
        (local.get $artifact_base)
        (call $proof_load
          (local.get $artifact_base)
          (i32.add (local.get $predicate_type) (i32.const 12)))
        (local.get $predicate_context) (local.get $recursive_definitions) (local.get $recursive_context_size) (local.get $work)))
    (if (i32.ne
          (call $proof_load (local.get $artifact_base)
            (i32.add (local.get $predicate_result_type) (i32.const 4)))
          (global.get $PROOF_TERM_SORT))
      (then
        (global.set $proof_last_error_code (i32.const 51))
        (return (i32.const 0))))
    (if (i32.and
          (i32.eqz
            (call $proof_universe_is_zero (local.get $artifact_base)
              (call $proof_load (local.get $artifact_base)
                (i32.add (local.get $predicate_result_type) (i32.const 8)))
              (local.get $work)))
          (i32.eqz
            (call $proof_inductive_allows_large_elimination
              (local.get $artifact_base) (local.get $declaration) (local.get $work))))
      (then
        (global.set $proof_last_error_code (i32.const 61))
