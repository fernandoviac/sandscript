    (local.set $words (call $proof_load (local.get $base) (local.get $level)))
    (if (i32.eqz (local.get $kind)) (then (return (i32.eq (local.get $words) (i32.const 3)))))
    (if (i32.eq (local.get $kind) (i32.const 1))
