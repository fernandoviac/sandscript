      (then (return (local.get $reference))))
    (local.set $walk_n (call $proof_load (local.get $artifact_base) (local.get $reference)))
    (local.set $walk_out (local.get $reference))
    (local.set $walk_i (i32.const 8))
    (block $walk_done (loop $walk_next
      (br_if $walk_done (i32.ge_u (local.get $walk_i) (i32.mul (local.get $walk_n) (i32.const 4))))
      (if (call $proof_term_child (local.get $tag) (local.get $walk_i)) (then
        (local.set $walk_x (call $proof_load (local.get $artifact_base) (i32.add (local.get $reference) (local.get $walk_i))))
        (if (local.get $walk_x) (then
          (local.set $walk_y (call $proof_state_abstract_bound (local.get $artifact_base) (local.get $walk_x) (local.get $hypothesis) (i32.add (local.get $depth) (call $proof_term_child_binders (local.get $tag) (local.get $walk_i)))))
          (if (i32.eqz (local.get $walk_y)) (then (return (i32.const 0))))
          (if (i32.ne (local.get $walk_x) (local.get $walk_y)) (then
            (if (i32.eq (local.get $walk_out) (local.get $reference)) (then
              (local.set $walk_out (call $proof_allocate_record (local.get $artifact_base) (local.get $walk_n) (local.get $tag)))
              (if (i32.eqz (local.get $walk_out)) (then (return (i32.const 0))))
              (call $proof_copy_bytes (local.get $artifact_base) (i32.add (local.get $walk_out) (i32.const 8))
                (i32.add (local.get $reference) (i32.const 8)) (i32.sub (i32.mul (local.get $walk_n) (i32.const 4)) (i32.const 8)))))
            (call $proof_store (local.get $artifact_base) (i32.add (local.get $walk_out) (local.get $walk_i)) (local.get $walk_y))))))))
      (local.set $walk_i (i32.add (local.get $walk_i) (i32.const 4)))
      (br $walk_next)))
    (local.get $walk_out)
  )

  ;; Shared head for cases and induction: validates the hypothesis, its
  ;; inductive family, and the zero-index restriction, then returns the
  ;; normalized scrutinee type. Writes the declaration index, parameter
  ;; count, and constructors array through scratch globals.
  (global $proof_state_cases_declaration_index (mut i32) (i32.const 0))
  (global $proof_state_cases_parameter_count (mut i32) (i32.const 0))
  (global $proof_state_cases_constructors (mut i32) (i32.const 0))
  (global $proof_state_cases_universe_arguments (mut i32) (i32.const 0))
  (func $proof_state_cases_scrutinee
    (param $artifact_base i32)
    (param $goal i32)
    (param $hypothesis i32) (param $work i32)
    (result i32)
    (local $context_array i32)
    (local $scrutinee_type i32)
    (local $head i32)
    (local $declaration i32)
    (local.set $context_array
      (call $proof_state_goal_context
        (local.get $artifact_base) (local.get $goal)))
    (if (i32.ge_u
          (local.get $hypothesis)
          (call $proof_array_count
            (local.get $artifact_base) (local.get $context_array)))
      (then
        (global.set $proof_last_error_code (i32.const 82))
        (return (i32.const -1))))
    (local.set $scrutinee_type
      (call $proof_weak_head_normalize
        (local.get $artifact_base)
        (call $proof_shift
          (local.get $artifact_base)
          (call $proof_array_get
            (local.get $artifact_base)
            (local.get $context_array)
            (local.get $hypothesis))
          (i32.add (local.get $hypothesis) (i32.const 1))
          (i32.const 0) (i32.const 0))
        (local.get $context_array) (i32.const 0) (i32.const 0) (local.get $work)))
    (if (i32.eqz (local.get $scrutinee_type))
      (then (return (i32.const 0))))
    (local.set $head
      (call $proof_application_head
        (local.get $artifact_base) (local.get $scrutinee_type)))
    (if (i32.ne
          (call $proof_load
            (local.get $artifact_base)
            (i32.add (local.get $head) (i32.const 4)))
          (global.get $PROOF_TERM_INDUCTIVE))
      (then
        (global.set $proof_last_error_code (i32.const 86))
        (return (i32.const -1))))
    (global.set $proof_state_cases_declaration_index
      (call $proof_load
        (local.get $artifact_base)
        (i32.add (local.get $head) (i32.const 8))))
    (global.set $proof_state_cases_universe_arguments
      (call $proof_load
        (local.get $artifact_base)
        (i32.add (local.get $head) (i32.const 12))))
    (local.set $declaration
      (call $proof_declaration_reference
        (local.get $artifact_base)
        (global.get $proof_state_cases_declaration_index)))
    (if (i32.ne
          (call $proof_load
            (local.get $artifact_base)
            (i32.add (local.get $declaration) (i32.const 4)))
          (global.get $PROOF_RECORD_INDUCTIVE_DECLARATION))
      (then
        (global.set $proof_last_error_code (i32.const 86))
        (return (i32.const -1))))
    (if (call $proof_load
          (local.get $artifact_base)
          (i32.add (local.get $declaration) (i32.const 20)))
      (then
        (global.set $proof_last_error_code (i32.const 87))
        (return (i32.const -1))))
    (global.set $proof_state_cases_parameter_count
      (call $proof_load
        (local.get $artifact_base)
        (i32.add (local.get $declaration) (i32.const 16))))
    (global.set $proof_state_cases_constructors
      (call $proof_load
        (local.get $artifact_base)
        (i32.add (local.get $declaration) (i32.const 24))))
    (local.get $scrutinee_type)
  )

  ;; cases: replace the goal with one match on a context hypothesis. The
  ;; motive abstracts the goal target over that hypothesis; each reachable
  ;; constructor opens one goal whose target is the dependent branch type.
  (func $proof_state_cases_core
    (param $artifact_base i32)
    (param $state_root i32)
    (param $goal i32)
    (param $hypothesis i32)
    (param $build_induction i32) (param $work i32)
    (result i32)
    (local $context_array i32)
    (local $target i32)
    (local $scrutinee_type i32)
    (local $motive_body i32)
    (local $motive i32)
    (local $constructors i32)
    (local $constructor_count i32)
    (local $ordinal i32)
    (local $constructor i32)
    (local $expected_array i32)
    (local $expected i32)
    (local $reachable_count i32)
    (local $fresh_identifier i32)
    (local $context_scope i32)
    (local $context_count i32)
    (local $scope_index i32)
    (local $scope_entry i32)
    (local $branches i32)
    (local $new_goals_array i32)
    (local $goal_slot i32)
    (local $hole i32)
    (local $branch i32)
    (local $solution i32)
    (local $replacement_goal i32)
    (local $fix_type i32)
    (local $expected_shifted i32)
    (local $field_count i32)
    (local $current i32)
    (local $walk_index i32)
    (local $domain i32)
    (local $domain_head i32)
    (local $recursive_positions i32)
    (local $recursive_count i32)
    (local $hole_context i32)
    (local $hole_target i32)
    (local $ih_index i32)
    (local $ih_base i32)
    (local $argument_position i32)
    (local $branch_body i32)
    (local $recursive_call i32)
    (local $definitions i32)
    (local $recursive_definition i32)
    (local $fixed_point i32)
    (local $match_scrutinee i32)
    (local $match_motive i32)
    (local.set $context_array
      (call $proof_state_goal_context
        (local.get $artifact_base) (local.get $goal)))
    (local.set $target
      (call $proof_load
        (local.get $artifact_base)
        (i32.add (local.get $goal) (i32.const 16))))
    (local.set $scrutinee_type
      (call $proof_state_cases_scrutinee
        (local.get $artifact_base) (local.get $goal) (local.get $hypothesis) (local.get $work)))
    (if (i32.le_s (local.get $scrutinee_type) (i32.const 0))
      (then (return (local.get $scrutinee_type))))
    (local.set $constructors (global.get $proof_state_cases_constructors))
    (local.set $constructor_count
      (call $proof_array_count
        (local.get $artifact_base) (local.get $constructors)))
    (local.set $motive_body
      (call $proof_state_abstract_bound
        (local.get $artifact_base) (local.get $target)
        (local.get $hypothesis) (i32.const 0)))
    (if (i32.eqz (local.get $motive_body)) (then (return (i32.const 0))))
    (local.set $motive
      (call $proof_make_two
        (local.get $artifact_base)
        (global.get $PROOF_TERM_LAMBDA)
        (local.get $scrutinee_type)
        (local.get $motive_body)))
    (if (i32.eqz (local.get $motive)) (then (return (i32.const 0))))
    ;; First pass: dependent branch shapes; reachability decides goals.
    (local.set $expected_array
      (call $proof_make_array
        (local.get $artifact_base) (local.get $constructor_count)))
    (if (i32.eqz (local.get $expected_array)) (then (return (i32.const 0))))
    (block $shapes_done
      (loop $shapes_next
        (br_if $shapes_done
          (i32.ge_u (local.get $ordinal) (local.get $constructor_count)))
        (local.set $constructor
          (call $proof_array_get
            (local.get $artifact_base)
            (local.get $constructors)
            (local.get $ordinal)))
        (local.set $expected
          (call $proof_match_branch_shape
            (local.get $artifact_base)
            (global.get $proof_state_cases_declaration_index)
            (local.get $constructor)
            (local.get $ordinal)
            (local.get $scrutinee_type)
            (global.get $proof_state_cases_universe_arguments)
            (global.get $proof_state_cases_parameter_count)
            (i32.const 0)
            (local.get $motive) (local.get $context_array) (i32.const 0) (i32.const 0) (local.get $work)))
        (if (i32.eqz (local.get $expected)) (then (return (i32.const 0))))
        (call $proof_array_set
          (local.get $artifact_base)
          (local.get $expected_array)
          (local.get $ordinal)
          (local.get $expected))
        (if (i32.ne (local.get $expected) (i32.const 1))
          (then
            (local.set $reachable_count
              (i32.add (local.get $reachable_count) (i32.const 1)))))
        (local.set $ordinal (i32.add (local.get $ordinal) (i32.const 1)))
        (br $shapes_next)))
    (local.set $fresh_identifier
      (call $proof_state_next_metavariable
        (local.get $artifact_base)
        (call $proof_state_goals_array
          (local.get $artifact_base) (local.get $state_root))))
    (local.set $context_count
      (call $proof_array_count
        (local.get $artifact_base) (local.get $context_array)))
    (local.set $context_scope
      (call $proof_make_array
        (local.get $artifact_base) (local.get $context_count)))
    (local.set $branches
      (call $proof_make_array
        (local.get $artifact_base) (local.get $reachable_count)))
    (local.set $new_goals_array
      (call $proof_make_array
        (local.get $artifact_base) (local.get $reachable_count)))
    (if (i32.or
          (i32.eqz (local.get $context_scope))
          (i32.or
            (i32.eqz (local.get $branches))
            (i32.eqz (local.get $new_goals_array))))
      (then (return (i32.const 0))))
    (block $scope_fill_done
      (loop $scope_fill_next
        (br_if $scope_fill_done
          (i32.ge_u (local.get $scope_index) (local.get $context_count)))
        (local.set $scope_entry
          (call $proof_make_one
            (local.get $artifact_base)
            (global.get $PROOF_TERM_BOUND)
            (local.get $scope_index)))
        (if (i32.eqz (local.get $scope_entry))
          (then (return (i32.const 0))))
        (call $proof_array_set
          (local.get $artifact_base)
          (local.get $context_scope)
          (local.get $scope_index)
          (local.get $scope_entry))
        (local.set $scope_index (i32.add (local.get $scope_index) (i32.const 1)))
        (br $scope_fill_next)))
    (local.set $ordinal (i32.const 0))
    (block $branches_done
      (loop $branches_next
        (br_if $branches_done
          (i32.ge_u (local.get $ordinal) (local.get $constructor_count)))
        (local.set $expected
          (call $proof_array_get
            (local.get $artifact_base)
            (local.get $expected_array)
            (local.get $ordinal)))
        (if (i32.ne (local.get $expected) (i32.const 1))
          (then
            (local.set $hole
              (call $proof_make_three
                (local.get $artifact_base)
                (global.get $PROOF_TERM_METAVARIABLE)
                (i32.add (local.get $fresh_identifier) (local.get $ordinal))
                (local.get $context_scope)
                (i32.const 0)))
            (if (i32.eqz (local.get $hole)) (then (return (i32.const 0))))
            (if (local.get $build_induction)
              (then
                ;; Induction: the hole lives under the scrutinee binder and
                ;; the constructor-argument binders; its goal receives one
                ;; induction-hypothesis product per recursive argument.
                (local.set $expected_shifted
                  (call $proof_shift
                    (local.get $artifact_base) (local.get $expected)
                    (i32.const 1) (i32.const 0) (i32.const 0)))
                (if (i32.eqz (local.get $expected_shifted))
                  (then (return (i32.const 0))))
                (local.set $constructor
                  (call $proof_array_get
                    (local.get $artifact_base)
                    (local.get $constructors)
                    (local.get $ordinal)))
                (local.set $field_count
                  (i32.sub
                    (call $proof_product_count
                      (local.get $artifact_base)
                      (call $proof_load
                        (local.get $artifact_base)
                        (i32.add (local.get $constructor) (i32.const 8))))
                    (global.get $proof_state_cases_parameter_count)))
                (local.set $recursive_positions
                  (call $proof_make_array
                    (local.get $artifact_base) (local.get $field_count)))
                (if (i32.eqz (local.get $recursive_positions))
                  (then (return (i32.const 0))))
                (local.set $recursive_count (i32.const 0))
                (local.set $hole_context
                  (call $proof_context_extend
                    (local.get $artifact_base)
                    (local.get $context_array)
                    (local.get $scrutinee_type)))
                (if (i32.eqz (local.get $hole_context))
                  (then (return (i32.const 0))))
                (local.set $current (local.get $expected_shifted))
                (local.set $walk_index (i32.const 0))
                (block $walk_done
                  (loop $walk_next
                    (br_if $walk_done
                      (i32.ge_u
                        (local.get $walk_index) (local.get $field_count)))
                    (local.set $domain
                      (call $proof_load
                        (local.get $artifact_base)
                        (i32.add (local.get $current) (i32.const 8))))
                    (local.set $domain_head
                      (call $proof_application_head
                        (local.get $artifact_base)
                        (call $proof_weak_head_normalize
                          (local.get $artifact_base)
                          (local.get $domain)
                          (local.get $context_array) (i32.const 0) (i32.const 0) (local.get $work))))
                    (if (i32.and
                          (i32.eq
                            (call $proof_load
                              (local.get $artifact_base)
                              (i32.add (local.get $domain_head) (i32.const 4)))
                            (global.get $PROOF_TERM_INDUCTIVE))
                          (i32.eq
                            (call $proof_load
                              (local.get $artifact_base)
                              (i32.add (local.get $domain_head) (i32.const 8)))
                            (global.get $proof_state_cases_declaration_index)))
                      (then
                        (call $proof_array_set
                          (local.get $artifact_base)
                          (local.get $recursive_positions)
                          (local.get $recursive_count)
                          (local.get $walk_index))
                        (local.set $recursive_count
                          (i32.add (local.get $recursive_count) (i32.const 1)))))
                    (local.set $hole_context
                      (call $proof_context_extend
                        (local.get $artifact_base)
                        (local.get $hole_context)
                        (local.get $domain)))
                    (if (i32.eqz (local.get $hole_context))
                      (then (return (i32.const 0))))
                    (local.set $current
                      (call $proof_load
                        (local.get $artifact_base)
                        (i32.add (local.get $current) (i32.const 12))))
                    (local.set $walk_index
                      (i32.add (local.get $walk_index) (i32.const 1)))
                    (br $walk_next)))
                ;; Hole target: induction-hypothesis products over the
                ;; branch result, innermost product first.
                (local.set $hole_target
                  (call $proof_shift
                    (local.get $artifact_base) (local.get $current)
                    (local.get $recursive_count) (i32.const 0) (i32.const 0)))
                (if (i32.eqz (local.get $hole_target))
                  (then (return (i32.const 0))))
                (local.set $ih_index (local.get $recursive_count))
                (block $ih_products_done
                  (loop $ih_products_next
                    (br_if $ih_products_done
                      (i32.eqz (local.get $ih_index)))
                    (local.set $ih_index
                      (i32.sub (local.get $ih_index) (i32.const 1)))
                    (local.set $argument_position
                      (call $proof_array_get
                        (local.get $artifact_base)
                        (local.get $recursive_positions)
                        (local.get $ih_index)))
                    (local.set $ih_base
                      (call $proof_instantiate_binder
                        (local.get $artifact_base)
                        (call $proof_shift
                          (local.get $artifact_base)
                          (local.get $motive_body)
                          (i32.add (local.get $field_count) (i32.const 1))
                          (i32.const 1) (i32.const 0))
                        (call $proof_make_one
                          (local.get $artifact_base)
                          (global.get $PROOF_TERM_BOUND)
                          (i32.sub
                            (i32.sub
                              (local.get $field_count)
                              (i32.const 1))
                            (local.get $argument_position)))))
                    (if (i32.eqz (local.get $ih_base))
                      (then (return (i32.const 0))))
                    (local.set $hole_target
                      (call $proof_make_two
                        (local.get $artifact_base)
                        (global.get $PROOF_TERM_PRODUCT)
                        (call $proof_shift
                          (local.get $artifact_base)
                          (local.get $ih_base)
                          (local.get $ih_index)
                          (i32.const 0) (i32.const 0))
                        (local.get $hole_target)))
                    (if (i32.eqz (local.get $hole_target))
                      (then (return (i32.const 0))))
                    (br $ih_products_next)))
                ;; Branch body: bind the constructor arguments, then apply
                ;; the hole to one recursive call per recursive argument.
                (local.set $branch_body (local.get $hole))
                (local.set $ih_index (i32.const 0))
                (block $ih_calls_done
                  (loop $ih_calls_next
                    (br_if $ih_calls_done
                      (i32.ge_u
                        (local.get $ih_index) (local.get $recursive_count)))
                    (local.set $argument_position
                      (call $proof_array_get
                        (local.get $artifact_base)
                        (local.get $recursive_positions)
                        (local.get $ih_index)))
                    (local.set $recursive_call
                      (call $proof_make_two
                        (local.get $artifact_base)
                        (global.get $PROOF_TERM_APPLICATION)
                        (call $proof_make_one
                          (local.get $artifact_base)
                          (global.get $PROOF_TERM_RECURSIVE_REFERENCE)
                          (i32.const 0))
                        (call $proof_make_one
                          (local.get $artifact_base)
                          (global.get $PROOF_TERM_BOUND)
                          (i32.sub
                            (i32.sub
                              (local.get $field_count)
                              (i32.const 1))
                            (local.get $argument_position)))))
                    (if (i32.eqz (local.get $recursive_call))
                      (then (return (i32.const 0))))
                    (local.set $branch_body
                      (call $proof_make_two
                        (local.get $artifact_base)
                        (global.get $PROOF_TERM_APPLICATION)
                        (local.get $branch_body)
                        (local.get $recursive_call)))
                    (if (i32.eqz (local.get $branch_body))
                      (then (return (i32.const 0))))
                    (local.set $ih_index
                      (i32.add (local.get $ih_index) (i32.const 1)))
                    (br $ih_calls_next)))
                (local.set $walk_index (local.get $field_count))
                (local.set $current (local.get $expected_shifted))
                (block $lambda_domains_done
                  ;; Collect domains again for the lambda spine.
                  (loop $lambda_spine_next
                    (br_if $lambda_domains_done
                      (i32.eqz (local.get $walk_index)))
                    (local.set $walk_index
                      (i32.sub (local.get $walk_index) (i32.const 1)))
                    (local.set $domain
                      (call $proof_state_product_domain
                        (local.get $artifact_base)
                        (local.get $expected_shifted)
                        (local.get $walk_index)))
                    (local.set $branch_body
                      (call $proof_make_two
                        (local.get $artifact_base)
                        (global.get $PROOF_TERM_LAMBDA)
                        (local.get $domain)
                        (local.get $branch_body)))
                    (if (i32.eqz (local.get $branch_body))
                      (then (return (i32.const 0))))
                    (br $lambda_spine_next)))
                (local.set $branch
                  (call $proof_state_make_branch
                    (local.get $artifact_base)
                    (local.get $ordinal)
                    (local.get $branch_body)))
                (local.set $replacement_goal
                  (call $proof_state_make_goal
                    (local.get $artifact_base)
                    (i32.add (local.get $fresh_identifier) (local.get $ordinal))
                    (local.get $hole_context)
                    (local.get $hole_target)
                    (call $proof_load
                      (local.get $artifact_base)
                      (i32.add (local.get $goal) (i32.const 8)))
                    (i32.const 0))))
              (else
                ;; cases: the hole is the whole branch body at the goal
                ;; context; its target is the dependent branch type.
                (local.set $branch
                  (call $proof_state_make_branch
                    (local.get $artifact_base)
                    (local.get $ordinal)
                    (local.get $hole)))
                (local.set $replacement_goal
                  (call $proof_state_make_goal
                    (local.get $artifact_base)
                    (i32.add (local.get $fresh_identifier) (local.get $ordinal))
                    (local.get $context_array)
                    (local.get $expected)
                    (call $proof_load
                      (local.get $artifact_base)
                      (i32.add (local.get $goal) (i32.const 8)))
                    (i32.const 0)))))
            (if (i32.or
                  (i32.eqz (local.get $branch))
                  (i32.eqz (local.get $replacement_goal)))
              (then (return (i32.const 0))))
            (call $proof_array_set
              (local.get $artifact_base)
              (local.get $branches)
              (local.get $goal_slot)
              (local.get $branch))
            (call $proof_array_set
              (local.get $artifact_base)
              (local.get $new_goals_array)
              (local.get $goal_slot)
              (local.get $replacement_goal))
            (local.set $goal_slot
              (i32.add (local.get $goal_slot) (i32.const 1)))))
        (local.set $ordinal (i32.add (local.get $ordinal) (i32.const 1)))
        (br $branches_next)))
    ;; Solution term.
    (if (local.get $build_induction)
      (then
        (local.set $fix_type
          (call $proof_make_two
            (local.get $artifact_base)
            (global.get $PROOF_TERM_PRODUCT)
            (local.get $scrutinee_type)
            (local.get $motive_body)))
        (local.set $match_scrutinee
          (call $proof_make_one
            (local.get $artifact_base)
            (global.get $PROOF_TERM_BOUND)
            (i32.const 0)))
        (local.set $match_motive
          (call $proof_shift
            (local.get $artifact_base) (local.get $motive)
            (i32.const 1) (i32.const 0) (i32.const 0)))
        (if (i32.or
              (i32.eqz (local.get $fix_type))
              (i32.or
                (i32.eqz (local.get $match_scrutinee))
                (i32.eqz (local.get $match_motive))))
          (then (return (i32.const 0))))
        (local.set $solution
          (call $proof_state_make_match
            (local.get $artifact_base)
            (local.get $match_scrutinee)
            (local.get $match_motive)
            (local.get $branches)))
        (if (i32.eqz (local.get $solution)) (then (return (i32.const 0))))
        (local.set $solution
          (call $proof_make_two
            (local.get $artifact_base)
            (global.get $PROOF_TERM_LAMBDA)
            ;; Recursive references have their own namespace; the ordinary
            ;; scrutinee lambda's domain stays in the original goal context.
            (local.get $scrutinee_type)
            (local.get $solution)))
        (if (i32.eqz (local.get $solution)) (then (return (i32.const 0))))
        (local.set $recursive_definition
          (call $proof_allocate_record
            (local.get $artifact_base) (i32.const 5)
            (global.get $PROOF_TERM_RECURSIVE_DEFINITION)))
        (if (i32.eqz (local.get $recursive_definition))
          (then (return (i32.const 0))))
        (call $proof_store
          (local.get $artifact_base)
          (i32.add (local.get $recursive_definition) (i32.const 8))
          (local.get $fix_type))
        (call $proof_store
          (local.get $artifact_base)
          (i32.add (local.get $recursive_definition) (i32.const 12))
          (local.get $solution))
        (call $proof_store
          (local.get $artifact_base)
          (i32.add (local.get $recursive_definition) (i32.const 16))
          (i32.const 0))
        (local.set $definitions
          (call $proof_make_array (local.get $artifact_base) (i32.const 1)))
        (if (i32.eqz (local.get $definitions)) (then (return (i32.const 0))))
        (call $proof_array_set
          (local.get $artifact_base)
          (local.get $definitions) (i32.const 0)
          (local.get $recursive_definition))
        (local.set $fixed_point
          (call $proof_allocate_record
            (local.get $artifact_base) (i32.const 4)
            (global.get $PROOF_TERM_FIXED_POINT)))
        (if (i32.eqz (local.get $fixed_point)) (then (return (i32.const 0))))
        (call $proof_store
          (local.get $artifact_base)
          (i32.add (local.get $fixed_point) (i32.const 8))
          (local.get $definitions))
        (call $proof_store
          (local.get $artifact_base)
          (i32.add (local.get $fixed_point) (i32.const 12))
          (i32.const 0))
        (local.set $solution
          (call $proof_make_two
            (local.get $artifact_base)
            (global.get $PROOF_TERM_APPLICATION)
            (local.get $fixed_point)
            (call $proof_make_one
              (local.get $artifact_base)
              (global.get $PROOF_TERM_BOUND)
              (local.get $hypothesis)))))
      (else
        (local.set $solution
          (call $proof_state_make_match
            (local.get $artifact_base)
            (call $proof_make_one
              (local.get $artifact_base)
              (global.get $PROOF_TERM_BOUND)
              (local.get $hypothesis))
            (local.get $motive)
            (local.get $branches)))))
    (if (i32.eqz (local.get $solution)) (then (return (i32.const 0))))
    (local.set $replacement_goal
      (call $proof_state_make_goal
        (local.get $artifact_base)
        (call $proof_load
          (local.get $artifact_base)
          (i32.add (local.get $goal) (i32.const 8)))
        (local.get $context_array)
        (local.get $target)
        (call $proof_load
          (local.get $artifact_base)
          (i32.add (local.get $goal) (i32.const 20)))
        (local.get $solution)))
    (if (i32.eqz (local.get $replacement_goal))
      (then (return (i32.const 0))))
    (call $proof_state_rebuild_root
      (local.get $artifact_base)
      (local.get $state_root)
      (local.get $goal)
      (local.get $replacement_goal)
      (local.get $new_goals_array))
  )

  (func $proof_state_make_branch
    (param $artifact_base i32)
    (param $ordinal i32)
    (param $body i32)
    (result i32)
    (local $branch i32)
    (local.set $branch
      (call $proof_allocate_record
