        (call $abs (i32.add (local.get $artifact_base) (i32.add (local.get $destination) (local.get $offset))))
        (i32.const 0) (local.get $chunk))
      (local.set $offset (i32.add (local.get $offset) (local.get $chunk)))
      (br $next))))

  ;; Preserve shared arrays until their first changed entry. Later updates
  ;; mutate only the fresh scratch copy, never the original term graph.
  (func $proof_array_update_copy
    (param $artifact_base i32) (param $source_array i32)
    (param $target_array i32) (param $index i32) (param $value i32)
    (result i32)
    (local $count i32)
    (if (i32.eq
          (local.get $value)
          (call $proof_array_get
            (local.get $artifact_base) (local.get $source_array) (local.get $index)))
      (then (return (local.get $target_array))))
    (if (i32.eq (local.get $source_array) (local.get $target_array))
      (then
        (local.set $count
          (call $proof_array_count (local.get $artifact_base) (local.get $source_array)))
        (local.set $target_array
          (call $proof_make_array (local.get $artifact_base) (local.get $count)))
