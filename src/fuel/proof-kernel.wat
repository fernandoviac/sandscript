              (then (return (i32.const 0))))
            (local.set $argument_index (i32.const 0))
            (block $recursive_arguments_done
              (loop $recursive_arguments_next
                (br_if $recursive_arguments_done
                  (i32.ge_u (local.get $argument_index) (local.get $argument_count)))
                (if (i32.eqz
