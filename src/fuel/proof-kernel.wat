  ;; Original SandScript wire validation: canonical Unicode scalar UTF-8,
  ;; including embedded NUL, followed only by zero alignment padding.
  (func $proof_validate_utf8_payload
    (param $base i32) (param $start i32) (param $length i32)
    (param $capacity i32) (result i32)
    (local $i i32) (local $byte i32) (local $remaining i32)
    (local $scalar i32) (local $minimum i32)
    (if (i32.or (i32.gt_u (local.get $length) (local.get $capacity))
          (i32.gt_u (i32.sub (local.get $capacity) (local.get $length)) (i32.const 3)))
      (then (return (i32.const 0))))
