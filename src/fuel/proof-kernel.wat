      (i32.sub
        (local.get $pending_pointer)
        (i32.mul
          (local.get $argument_count)
          (global.get $VALUE_SIZE))))
    (local.set $index
      (call $proof_native_nonnegative_integer_argument
        (local.get $argument)))
    (call $write_ctx
      (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (i32.lt_s (local.get $index) (i32.const 0))
      (then
        (return
          (i32.add
            (i32.const 1)
            (call $throw_type_error_with_message
              (global.get $BUILTIN_MSG_INVALID_INDEX))))))
    (if (call $check_heap_overflow
          (i32.add
            (call $estimate_arraybuffer_size (i32.const 40))
            (i32.const 24)))
      (then (return (i32.const 0))))
    (local.set $handle
      (call $proof_native_allocate_term_handle
        (i32.const 40) (i32.const 16) (i32.const 0)))
    (local.set $artifact_base
      (call $proof_native_handle_artifact_base (local.get $handle)))
    (call $proof_native_initialize_artifact_header
      (local.get $artifact_base) (i32.const 40) (i32.const 28))
    (call $proof_store
      (local.get $artifact_base) (i32.const 16) (i32.const 3))
    (call $proof_store
      (local.get $artifact_base) (i32.const 20)
      (global.get $PROOF_TERM_BOUND))
    (call $proof_store
      (local.get $artifact_base) (i32.const 24) (local.get $index))
    (call $proof_native_write_empty_declarations
      (local.get $artifact_base) (i32.const 28))
    (call $proof_native_push_term (local.get $handle))
    (i32.const 0)
  )

  ;; Declaration compatibility is identity of the checked wire graph, not
  ;; convertibility in a merged environment (which can conflate opaque constants
  ;; or grant forged intrinsic metadata authority). Compare relative edges by
  ;; contents, scalar payload words exactly, and share the caller's work budget.
  (func $proof_wire_graph_equal_at_depth
    (param $base i32) (param $left i32) (param $right i32)
    (param $work i32) (param $depth i32) (result i32)
    (local $words i32) (local $i i32) (local $a i32) (local $b i32)
    (if (i32.eqz (call $proof_work_debit (local.get $base) (local.get $work)))
      (then (return (i32.const 0))))
    (if (i32.eq (local.get $left) (local.get $right)) (then (return (i32.const 1))))
    (if (i32.or (i32.eqz (local.get $left)) (i32.eqz (local.get $right)))
      (then (return (i32.const 0))))
    (if (i32.ge_u (local.get $depth) (i32.const 512))
      (then
        (global.set $proof_last_error_code (i32.const 29))
        (call $proof_store (local.get $base) (i32.add (local.get $work) (i32.const 16)) (i32.const 29))
        (return (i32.const 0))))
    (local.set $words (call $proof_load (local.get $base) (local.get $left)))
    (if (i32.or (i32.ne (local.get $words) (call $proof_load (local.get $base) (local.get $right)))
          (i32.ne (call $proof_load (local.get $base) (i32.add (local.get $left) (i32.const 4)))
                  (call $proof_load (local.get $base) (i32.add (local.get $right) (i32.const 4)))))
      (then (return (i32.const 0))))
    (local.set $i (i32.const 2))
    (block $done (loop $next
      (br_if $done (i32.ge_u (local.get $i) (local.get $words)))
      (local.set $a (call $proof_load (local.get $base) (i32.add (local.get $left) (i32.mul (local.get $i) (i32.const 4)))))
      (local.set $b (call $proof_load (local.get $base) (i32.add (local.get $right) (i32.mul (local.get $i) (i32.const 4)))))
      (if (call $proof_record_edge_kind (local.get $base) (local.get $left) (local.get $i))
        (then (if (i32.eqz (call $proof_wire_graph_equal_at_depth (local.get $base)
                    (local.get $a) (local.get $b) (local.get $work)
                    (i32.add (local.get $depth) (i32.const 1))))
          (then (return (i32.const 0)))))
        (else (if (i32.ne (local.get $a) (local.get $b)) (then (return (i32.const 0))))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $next)))
    (i32.const 1)
  )

  (func $proof_wire_graph_equal
    (param $base i32) (param $left i32) (param $right i32)
    (param $work i32) (result i32)
    (call $proof_wire_graph_equal_at_depth (local.get $base) (local.get $left)
      (local.get $right) (local.get $work) (i32.const 0))
  )

  (func $proof_native_declarations_compatible
    (param $artifact_base i32) (param $left_source_base i32)
    (param $left_declarations i32) (param $left_delta i32)
    (param $right_source_base i32) (param $right_declarations i32)
    (param $right_delta i32) (param $work i32) (result i32)
    (local $count i32) (local $right_count i32) (local $i i32)
    ;; Persistent environments may extend a common checked prefix. Every
    ;; overlapping declaration must retain its complete structural identity.
    (local.set $count (call $proof_array_count (local.get $left_source_base) (local.get $left_declarations)))
    (local.set $right_count (call $proof_array_count (local.get $right_source_base) (local.get $right_declarations)))
    (if (i32.lt_u (local.get $right_count) (local.get $count))
      (then (local.set $count (local.get $right_count))))
    (block $done (loop $next
      (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
      (if (i32.eqz (call $proof_wire_graph_equal (local.get $artifact_base)
            (i32.add (call $proof_array_get (local.get $left_source_base) (local.get $left_declarations) (local.get $i)) (local.get $left_delta))
            (i32.add (call $proof_array_get (local.get $right_source_base) (local.get $right_declarations) (local.get $i)) (local.get $right_delta))
            (local.get $work))) (then (return (i32.const 0))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $next)))
    (i32.const 1)
  )
  (func $proof_native_compose_binary_term
    (param $tag i32)
    (param $trailing_index i32)
    (param $has_trailing_index i32)
    (param $left_handle i32)
    (param $right_handle i32)
    (param $workspace_multiplier i32)
    (result i32)
    (local $left_length i32)
    (local $right_length i32)
    (local $left_base i32)
    (local $right_base i32)
    (local $left_declarations i32)
    (local $right_declarations i32)
    (local $left_declaration_count i32)
    (local $right_declaration_count i32)
    (local $declaration_count i32)
    (local $same_artifact i32)
    (local $declarations_from_left i32)
    (local $declaration_delta i32)
    (local $artifact_length i32)
    (local $handle i32)
    (local $artifact_base i32)
    (local $cursor i32)
    (local $left_root i32)
    (local $right_root i32)
    (local $node_reference i32)
    (local $declarations_reference i32)
    (local $source_declarations i32)
    (local $source_base i32)
    (local $index i32)
    (local $scope_owner i32)
    (local.set $scope_owner (call $proof_native_scope_union (local.get $left_handle) (local.get $right_handle)))
    (if (i32.eq (local.get $scope_owner) (i32.const -1)) (then (return (i32.const -1))))
    (local.set $left_base
      (call $proof_native_handle_artifact_base (local.get $left_handle)))
    (local.set $right_base
      (call $proof_native_handle_artifact_base (local.get $right_handle)))
    (local.set $left_declarations
      (call $proof_load (local.get $left_base) (i32.const 12)))
    (local.set $right_declarations
      (call $proof_load (local.get $right_base) (i32.const 12)))
    (local.set $left_declaration_count
      (call $proof_array_count
        (local.get $left_base) (local.get $left_declarations)))
    (local.set $right_declaration_count
      (call $proof_array_count
        (local.get $right_base) (local.get $right_declarations)))
    (local.set $same_artifact
      (i32.eq
        (call $proof_native_handle_buffer (local.get $left_handle))
        (call $proof_native_handle_buffer (local.get $right_handle))))
    (local.set $left_length
      (call $proof_native_term_records_length (local.get $left_handle)))
    (if (local.get $same_artifact)
      (then (local.set $right_length (i32.const 0)))
      (else
        (local.set $right_length
          (call $proof_native_term_records_length
            (local.get $right_handle)))))
    (if (i32.ge_u (local.get $left_declaration_count) (local.get $right_declaration_count))
      (then
        (local.set $declarations_from_left (i32.const 1))
        (local.set $declaration_count
          (local.get $left_declaration_count)))
      (else
        (local.set $declaration_count
          (local.get $right_declaration_count))))
    (local.set $artifact_length
      (i32.add
        (i32.add
          (i32.const 44)
          (i32.mul (local.get $has_trailing_index) (i32.const 4)))
        (i32.add
          (i32.add (local.get $left_length) (local.get $right_length))
          (i32.mul (local.get $declaration_count) (i32.const 4)))))
    (local.set $handle
      (call $proof_native_allocate_term_handle
        (local.get $artifact_length)
        (i32.add
          (i32.const 16)
          (i32.add (local.get $left_length) (local.get $right_length)))
        (call $proof_native_composition_workspace_size
          (local.get $artifact_length) (local.get $workspace_multiplier))))
    (i32.store (call $abs (i32.add (local.get $handle) (i32.const 20))) (local.get $scope_owner))
    (local.set $artifact_base
      (call $proof_native_handle_artifact_base (local.get $handle)))
    (local.set $cursor (i32.add (local.get $artifact_base) (i32.const 16)))
    (local.set $left_root
      (call $proof_native_copy_term_records
        (local.get $left_handle)
        (local.get $artifact_base)
        (local.get $cursor)))
    (local.set $cursor (i32.add (local.get $cursor) (local.get $left_length)))
    (if (local.get $same_artifact)
      (then
        (local.set $right_root
          (i32.add
            (call $proof_native_handle_root (local.get $right_handle))
            (i32.sub
              (local.get $left_root)
              (call $proof_native_handle_root (local.get $left_handle))))))
      (else
        (local.set $right_root
          (call $proof_native_copy_term_records
            (local.get $right_handle)
            (local.get $artifact_base)
            (local.get $cursor)))
        (local.set $cursor
          (i32.add (local.get $cursor) (local.get $right_length)))))
    (local.set $node_reference
      (i32.sub (local.get $cursor) (local.get $artifact_base)))
    (call $proof_store
      (local.get $artifact_base)
      (local.get $node_reference)
      (i32.add (i32.const 4) (local.get $has_trailing_index)))
    (call $proof_store
      (local.get $artifact_base)
      (i32.add (local.get $node_reference) (i32.const 4))
      (local.get $tag))
    (call $proof_store
      (local.get $artifact_base)
      (i32.add (local.get $node_reference) (i32.const 8))
      (local.get $left_root))
    (call $proof_store
      (local.get $artifact_base)
      (i32.add (local.get $node_reference) (i32.const 12))
      (local.get $right_root))
    (if (local.get $has_trailing_index)
      (then
        (call $proof_store
          (local.get $artifact_base)
          (i32.add (local.get $node_reference) (i32.const 16))
          (local.get $trailing_index))))
    (local.set $declarations_reference
      (i32.add
        (local.get $node_reference)
        (i32.add
          (i32.const 16)
          (i32.mul (local.get $has_trailing_index) (i32.const 4)))))
    (call $proof_store
      (local.get $artifact_base)
      (local.get $declarations_reference)
      (i32.add (local.get $declaration_count) (i32.const 3)))
    (call $proof_store
      (local.get $artifact_base)
      (i32.add (local.get $declarations_reference) (i32.const 4))
      (global.get $PROOF_RECORD_ARRAY))
    (call $proof_store
      (local.get $artifact_base)
      (i32.add (local.get $declarations_reference) (i32.const 8))
      (local.get $declaration_count))
    (if (local.get $declarations_from_left)
      (then
        (local.set $source_base (local.get $left_base))
        (local.set $source_declarations (local.get $left_declarations))
        (local.set $declaration_delta
          (i32.sub
            (local.get $left_root)
            (call $proof_native_handle_root (local.get $left_handle)))))
      (else
