      (call $proof_weak_head_normalize
        (local.get $artifact_base) (local.get $left_term) (local.get $context) (local.get $recursive_definitions) (local.get $recursive_context_size) (local.get $work)))
    (local.set $right
      (call $proof_weak_head_normalize
        (local.get $artifact_base) (local.get $right_term) (local.get $context) (local.get $recursive_definitions) (local.get $recursive_context_size) (local.get $work)))
    (if (i32.or (i32.eqz (local.get $left)) (i32.eqz (local.get $right))) (then (return (i32.const 0))))
    (local.set $left_tag
      (call $proof_load (local.get $artifact_base) (i32.add (local.get $left) (i32.const 4))))
    (local.set $right_tag
      (call $proof_load (local.get $artifact_base) (i32.add (local.get $right) (i32.const 4))))
    (if (i32.or
          (i32.eq (local.get $left_tag) (global.get $PROOF_TERM_BOUND))
          (i32.eq (local.get $right_tag) (global.get $PROOF_TERM_BOUND)))
      (then (return (i32.const 1))))
    (if (i32.and (i32.eq (local.get $left_tag) (local.get $right_tag))
      (i32.or (i32.eq (local.get $left_tag) (global.get $PROOF_TERM_NAT_LITERAL))
        (i32.eq (local.get $left_tag) (global.get $PROOF_TERM_STRING_LITERAL))))
      (then (return (call $proof_state_equality_same (local.get $artifact_base) (local.get $left) (local.get $right) (i32.const 512) (local.get $work)))))
    ;; Different structures may have equal selected fields, so a neutral
    ;; projection is not evidence that constructor indices cannot unify.
    (if (i32.or (i32.eq (local.get $left_tag) (global.get $PROOF_TERM_PROJECTION))
      (i32.eq (local.get $right_tag) (global.get $PROOF_TERM_PROJECTION)))
      (then (return (i32.const 1))))
    (local.set $left_head
      (call $proof_application_head (local.get $artifact_base) (local.get $left)))
    (local.set $right_head
      (call $proof_application_head (local.get $artifact_base) (local.get $right)))
    (local.set $left_tag
      (call $proof_load (local.get $artifact_base) (i32.add (local.get $left_head) (i32.const 4))))
    (local.set $right_tag
      (call $proof_load (local.get $artifact_base) (i32.add (local.get $right_head) (i32.const 4))))
    (if (i32.and
          (i32.eq (local.get $left_tag) (global.get $PROOF_TERM_CONSTRUCTOR))
          (i32.eq (local.get $right_tag) (global.get $PROOF_TERM_CONSTRUCTOR)))
      (then
        (if (i32.or
              (i32.ne
                (call $proof_load (local.get $artifact_base) (i32.add (local.get $left_head) (i32.const 8)))
                (call $proof_load (local.get $artifact_base) (i32.add (local.get $right_head) (i32.const 8))))
              (i32.ne
                (call $proof_load (local.get $artifact_base) (i32.add (local.get $left_head) (i32.const 12)))
                (call $proof_load (local.get $artifact_base) (i32.add (local.get $right_head) (i32.const 12)))))
          (then (return (i32.const 0))))
        (local.set $left_count
          (call $proof_application_count (local.get $artifact_base) (local.get $left)))
        (local.set $right_count
          (call $proof_application_count (local.get $artifact_base) (local.get $right)))
        (if (i32.ne (local.get $left_count) (local.get $right_count))
          (then (return (i32.const 1))))
        (local.set $index (i32.const 0))
        (block $done
          (loop $next
            (br_if $done (i32.ge_u (local.get $index) (local.get $left_count)))
            (if (i32.eqz
                  (call $proof_terms_may_unify
                    (local.get $artifact_base)
                    (call $proof_application_argument
                      (local.get $artifact_base) (local.get $left) (local.get $index))
                    (call $proof_application_argument
                      (local.get $artifact_base) (local.get $right) (local.get $index))
