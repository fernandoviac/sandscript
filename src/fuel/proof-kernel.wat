  ;; Transport the final value of a dependent telescope suffix. The motive
  ;; quantifies the old suffix, and its result uses recursively transported
  ;; preceding suffix values at the new endpoint. At reflexivity it is the
  ;; last projection. No heterogeneous equality or trusted coercion is used.
  (func $proof_state_derived_transport_suffix
    (param $base i32) (param $head i32) (param $A i32)
    (param $family i32) (param $e i32) (param $count i32) (param $context i32) (param $work i32) (result i32)
    (local $current i32) (local $domains i32) (local $target i32)
    (local $index i32) (local $argument i32) (local $value i32)
    (local $fn i32) (local $motive i32) (local $branch i32)
    (local $left i32) (local $e_type i32)
    (local $endpoint_domains i32) (local $endpoint_context i32)
    (local $suffix_context i32) (local $branch_context i32)
    (local $y_domain i32) (local $e_domain i32)
    ;; The motive lives under x:A, y:A, e:Eq A x y. Each stored
    ;; domain retains the coordinates of the prefix before its binder.
    (local.set $endpoint_domains (call $proof_make_array (local.get $base) (i32.const 3)))
    (if (i32.eqz (local.get $endpoint_domains)) (then (return (i32.const 0))))
    (call $proof_array_set (local.get $base) (local.get $endpoint_domains) (i32.const 0) (local.get $A))
    (local.set $y_domain (call $proof_shift (local.get $base) (local.get $A) (i32.const 1) (i32.const 0) (i32.const 0)))
    (if (i32.eqz (local.get $y_domain)) (then (return (i32.const 0))))
    (call $proof_array_set (local.get $base) (local.get $endpoint_domains) (i32.const 1) (local.get $y_domain))
    (local.set $value (call $proof_shift (local.get $base) (local.get $A) (i32.const 2) (i32.const 0) (i32.const 0)))
    (if (i32.eqz (local.get $value)) (then (return (i32.const 0))))
    (local.set $current (call $proof_make_one (local.get $base) (global.get $PROOF_TERM_BOUND) (i32.const 1)))
    (if (i32.eqz (local.get $current)) (then (return (i32.const 0))))
    (local.set $target (call $proof_make_one (local.get $base) (global.get $PROOF_TERM_BOUND) (i32.const 0)))
    (if (i32.eqz (local.get $target)) (then (return (i32.const 0))))
    (local.set $e_domain (call $proof_state_equality_type (local.get $base) (local.get $head) (local.get $value) (local.get $current) (local.get $target)))
    (if (i32.eqz (local.get $e_domain)) (then (return (i32.const 0))))
    (call $proof_array_set (local.get $base) (local.get $endpoint_domains) (i32.const 2) (local.get $e_domain))
    (local.set $endpoint_context (call $proof_context_extend_telescope
      (local.get $base) (local.get $context) (local.get $endpoint_domains) (i32.const 3)))
    (if (i32.eqz (local.get $endpoint_context)) (then (return (i32.const 0))))
    (local.set $value (call $proof_make_one (local.get $base) (global.get $PROOF_TERM_BOUND) (i32.const 2)))
    (if (i32.eqz (local.get $value)) (then (return (i32.const 0))))
    (local.set $current (call $proof_shift (local.get $base) (local.get $family) (i32.const 3) (i32.const 0) (i32.const 0)))
    (if (i32.eqz (local.get $current)) (then (return (i32.const 0))))
    (local.set $current (call $proof_make_two (local.get $base) (global.get $PROOF_TERM_APPLICATION) (local.get $current) (local.get $value)))
    (if (i32.eqz (local.get $current)) (then (return (i32.const 0))))
    (local.set $current (call $proof_weak_head_normalize (local.get $base) (local.get $current) (local.get $endpoint_context) (i32.const 0) (i32.const 0) (local.get $work)))
    (if (i32.eqz (local.get $current)) (then (return (i32.const 0))))
    (local.set $domains (call $proof_make_array (local.get $base) (local.get $count)))
    (if (i32.eqz (local.get $domains)) (then (return (i32.const 0))))
    (block $domains_done (loop $domain
    (br_if $domains_done (i32.ge_u (local.get $index) (local.get $count)))
    (call $proof_array_set (local.get $base) (local.get $domains) (local.get $index) (call $proof_load (local.get $base) (i32.add (local.get $current) (i32.const 8))))
    (local.set $current (call $proof_load (local.get $base) (i32.add (local.get $current) (i32.const 12))))
    (local.set $index (i32.add (local.get $index) (i32.const 1))) (br $domain)))
    (local.set $suffix_context (call $proof_context_extend_telescope
      (local.get $base) (local.get $endpoint_context) (local.get $domains) (local.get $count)))
    (if (i32.eqz (local.get $suffix_context)) (then (return (i32.const 0))))
    (local.set $target (call $proof_shift (local.get $base) (local.get $family) (i32.add (local.get $count) (i32.const 3)) (i32.const 0) (i32.const 0)))
    (if (i32.eqz (local.get $target)) (then (return (i32.const 0))))
    (local.set $value (call $proof_make_one (local.get $base) (global.get $PROOF_TERM_BOUND) (i32.add (local.get $count) (i32.const 1))))
    (if (i32.eqz (local.get $value)) (then (return (i32.const 0))))
    (local.set $target (call $proof_make_two (local.get $base) (global.get $PROOF_TERM_APPLICATION) (local.get $target) (local.get $value)))
    (if (i32.eqz (local.get $target)) (then (return (i32.const 0))))
    (local.set $target (call $proof_weak_head_normalize (local.get $base) (local.get $target) (local.get $suffix_context) (i32.const 0) (i32.const 0) (local.get $work)))
    (if (i32.eqz (local.get $target)) (then (return (i32.const 0))))
    (local.set $index (i32.const 0))
    (block $transported (loop $transport
    (br_if $transported (i32.ge_u (i32.add (local.get $index) (i32.const 1)) (local.get $count)))
    (local.set $current (call $proof_shift (local.get $base) (local.get $family) (i32.add (local.get $count) (i32.const 3)) (i32.const 0) (i32.const 0)))
    (if (i32.eqz (local.get $current)) (then (return (i32.const 0))))
    (local.set $value (call $proof_shift (local.get $base) (local.get $A) (i32.add (local.get $count) (i32.const 3)) (i32.const 0) (i32.const 0)))
    (if (i32.eqz (local.get $value)) (then (return (i32.const 0))))
    (local.set $argument (call $proof_make_one (local.get $base) (global.get $PROOF_TERM_BOUND) (local.get $count)))
    (if (i32.eqz (local.get $argument)) (then (return (i32.const 0))))
    (local.set $fn (call $proof_state_derived_transport_suffix (local.get $base) (local.get $head) (local.get $value) (local.get $current) (local.get $argument) (i32.add (local.get $index) (i32.const 1)) (local.get $suffix_context) (local.get $work)))
    (if (i32.eqz (local.get $fn)) (then (return (i32.const 0))))
    (local.set $argument (i32.const 0))
    (block $applied (loop $apply
    (br_if $applied (i32.gt_u (local.get $argument) (local.get $index)))
    (local.set $value (call $proof_make_one (local.get $base) (global.get $PROOF_TERM_BOUND) (i32.sub (i32.sub (local.get $count) (local.get $argument)) (i32.const 1))))
    (if (i32.eqz (local.get $value)) (then (return (i32.const 0))))
    (local.set $fn (call $proof_make_two (local.get $base) (global.get $PROOF_TERM_APPLICATION) (local.get $fn) (local.get $value)))
    (if (i32.eqz (local.get $fn)) (then (return (i32.const 0))))
    (local.set $argument (i32.add (local.get $argument) (i32.const 1))) (br $apply)))
    (local.set $target (call $proof_instantiate_binder (local.get $base) (call $proof_load (local.get $base) (i32.add (local.get $target) (i32.const 12))) (local.get $fn)))
    (if (i32.eqz (local.get $target)) (then (return (i32.const 0))))
    (local.set $index (i32.add (local.get $index) (i32.const 1))) (br $transport)))
    (local.set $motive (call $proof_load (local.get $base) (i32.add (local.get $target) (i32.const 8))))
    (local.set $index (local.get $count))
    (block $products_done (loop $product
    (br_if $products_done (i32.eqz (local.get $index)))
    (local.set $index (i32.sub (local.get $index) (i32.const 1)))
    (local.set $motive (call $proof_make_two (local.get $base) (global.get $PROOF_TERM_PRODUCT) (call $proof_array_get (local.get $base) (local.get $domains) (local.get $index)) (local.get $motive)))
    (if (i32.eqz (local.get $motive)) (then (return (i32.const 0))))
    (br $product)))
    (local.set $current (call $proof_shift (local.get $base) (local.get $family) (i32.const 1) (i32.const 0) (i32.const 0)))
    (if (i32.eqz (local.get $current)) (then (return (i32.const 0))))
    (local.set $value (call $proof_make_one (local.get $base) (global.get $PROOF_TERM_BOUND) (i32.const 0)))
    (if (i32.eqz (local.get $value)) (then (return (i32.const 0))))
    (local.set $current (call $proof_make_two (local.get $base) (global.get $PROOF_TERM_APPLICATION) (local.get $current) (local.get $value)))
    (if (i32.eqz (local.get $current)) (then (return (i32.const 0))))
    ;; Reflexivity has only x:A in scope, not the motive's y and e.
    (local.set $branch_context (call $proof_context_extend_telescope
      (local.get $base) (local.get $context) (local.get $endpoint_domains) (i32.const 1)))
    (if (i32.eqz (local.get $branch_context)) (then (return (i32.const 0))))
    (local.set $current (call $proof_weak_head_normalize (local.get $base) (local.get $current) (local.get $branch_context) (i32.const 0) (i32.const 0) (local.get $work)))
    (if (i32.eqz (local.get $current)) (then (return (i32.const 0))))
    (local.set $index (i32.const 0))
    (block $branch_domains_done (loop $branch_domain
    (br_if $branch_domains_done (i32.ge_u (local.get $index) (local.get $count)))
    (call $proof_array_set (local.get $base) (local.get $domains) (local.get $index) (call $proof_load (local.get $base) (i32.add (local.get $current) (i32.const 8))))
    (local.set $current (call $proof_load (local.get $base) (i32.add (local.get $current) (i32.const 12))))
    (local.set $index (i32.add (local.get $index) (i32.const 1))) (br $branch_domain)))
    (local.set $branch (call $proof_make_one (local.get $base) (global.get $PROOF_TERM_BOUND) (i32.const 0)))
    (if (i32.eqz (local.get $branch)) (then (return (i32.const 0))))
    (block $lambdas_done (loop $lambda
    (br_if $lambdas_done (i32.eqz (local.get $index)))
    (local.set $index (i32.sub (local.get $index) (i32.const 1)))
    (local.set $branch (call $proof_make_two (local.get $base) (global.get $PROOF_TERM_LAMBDA) (call $proof_array_get (local.get $base) (local.get $domains) (local.get $index)) (local.get $branch)))
    (if (i32.eqz (local.get $branch)) (then (return (i32.const 0))))
    (br $lambda)))
    ;; The canonical family fixes the left endpoint as a parameter. Recover
    ;; it from the checked evidence in the caller's complete binder context.
    (local.set $e_type (call $proof_infer_term (local.get $base) (local.get $e)
      (local.get $context) (i32.const 0) (i32.const 0) (local.get $work)))
    (if (i32.eqz (local.get $e_type)) (then (return (i32.const 0))))
    (local.set $e_type (call $proof_weak_head_normalize (local.get $base) (local.get $e_type)
      (local.get $context) (i32.const 0) (i32.const 0) (local.get $work)))
    (if (i32.eqz (local.get $e_type)) (then (return (i32.const 0))))
    (local.set $left (call $proof_application_argument (local.get $base) (local.get $e_type) (i32.const 1)))
    (call $proof_state_equality_eliminate (local.get $base) (local.get $head)
      (local.get $A) (local.get $left) (local.get $e) (local.get $motive) (local.get $branch)))

  ;; Left-to-right index equations. After introducing each equality, move
  ;; the remaining original telescope values along it before comparing the
  ;; next index. This keeps genuinely dependent index domains homogeneous.
  (func $proof_state_derived_index_equations
    (param $base i32) (param $telescope i32)
    (param $type i32) (param $parameters i32) (param $indices i32)
    (param $target i32) (param $context i32) (param $work i32) (result i32)
    (local $values i32) (local $next_values i32) (local $domains i32)
    (local $index i32) (local $tail i32) (local $argument i32)
    (local $A i32) (local $family i32) (local $value i32)
    (local $entry i32) (local $eq i32) (local $fn i32)
    (local $equation_context i32) (local $head i32)
    (local.set $equation_context (local.get $context))
    (local.set $values (call $proof_make_array (local.get $base) (local.get $indices)))
    (if (i32.eqz (local.get $values)) (then (return (i32.const 0))))
    (local.set $domains (call $proof_make_array (local.get $base) (local.get $indices)))
    (if (i32.eqz (local.get $domains)) (then (return (i32.const 0))))
    (local.set $telescope (call $proof_shift (local.get $base) (local.get $telescope) (i32.add (local.get $indices) (i32.const 1)) (i32.const 0) (i32.const 0)))
    (if (i32.eqz (local.get $telescope)) (then (return (i32.const 0))))
    (block $originals_done (loop $original
    (br_if $originals_done (i32.ge_u (local.get $index) (local.get $indices)))
    (local.set $value (call $proof_shift (local.get $base) (call $proof_application_argument (local.get $base) (local.get $type) (i32.add (local.get $parameters) (local.get $index))) (i32.add (local.get $indices) (i32.const 1)) (i32.const 0) (i32.const 0)))
    (if (i32.eqz (local.get $value)) (then (return (i32.const 0))))
    (call $proof_array_set (local.get $base) (local.get $values) (local.get $index) (local.get $value))
    (local.set $index (i32.add (local.get $index) (i32.const 1))) (br $original)))
    (local.set $index (i32.const 0))
    (block $equations_done (loop $equation
    (br_if $equations_done (i32.ge_u (local.get $index) (local.get $indices)))
    (local.set $A (call $proof_load (local.get $base) (i32.add (local.get $telescope) (i32.const 8))))
    (local.set $value (call $proof_array_get (local.get $base) (local.get $values) (local.get $index)))
    (local.set $entry (call $proof_make_one (local.get $base) (global.get $PROOF_TERM_BOUND) (local.get $indices)))
    (if (i32.eqz (local.get $entry)) (then (return (i32.const 0))))
    ;; At equation i, the new index i is Bound(indices): i preceding
    ;; equations exactly cancel its distance from the first index binder.
    (local.set $head (call $proof_state_equality_find
      (local.get $base) (i32.const 0) (local.get $A)
      (local.get $equation_context) (local.get $work)))
    (if (i32.eqz (local.get $head)) (then
      (if (i32.eqz (global.get $proof_last_error_code))
        (then (global.set $proof_last_error_code (i32.const 101))))
      (return (i32.const 0))))
    (local.set $eq (call $proof_state_equality_type (local.get $base) (local.get $head) (local.get $A) (local.get $value) (local.get $entry)))
    (if (i32.eqz (local.get $eq)) (then (return (i32.const 0))))
    (call $proof_array_set (local.get $base) (local.get $domains) (local.get $index) (local.get $eq))
    ;; Transport uses Bound(0) for the equation just introduced.
    (local.set $equation_context (call $proof_context_extend
      (local.get $base) (local.get $equation_context) (local.get $eq)))
    (if (i32.eqz (local.get $equation_context)) (then (return (i32.const 0))))
    (local.set $family (call $proof_make_two (local.get $base) (global.get $PROOF_TERM_LAMBDA) (local.get $A) (call $proof_load (local.get $base) (i32.add (local.get $telescope) (i32.const 12)))))
    (if (i32.eqz (local.get $family)) (then (return (i32.const 0))))
    (local.set $family (call $proof_shift (local.get $base) (local.get $family) (i32.const 1) (i32.const 0) (i32.const 0)))
    (if (i32.eqz (local.get $family)) (then (return (i32.const 0))))
    (local.set $A (call $proof_shift (local.get $base) (local.get $A) (i32.const 1) (i32.const 0) (i32.const 0)))
    (if (i32.eqz (local.get $A)) (then (return (i32.const 0))))
    (local.set $next_values (call $proof_make_array (local.get $base) (local.get $indices)))
    (if (i32.eqz (local.get $next_values)) (then (return (i32.const 0))))
    (local.set $tail (i32.add (local.get $index) (i32.const 1)))
    (block $tails_done (loop $tail_next
    (br_if $tails_done (i32.ge_u (local.get $tail) (local.get $indices)))
    (local.set $entry (call $proof_make_one (local.get $base) (global.get $PROOF_TERM_BOUND) (i32.const 0)))
    (if (i32.eqz (local.get $entry)) (then (return (i32.const 0))))
    (local.set $fn (call $proof_state_derived_transport_suffix (local.get $base) (local.get $head) (local.get $A) (local.get $family) (local.get $entry) (i32.sub (local.get $tail) (local.get $index)) (local.get $equation_context) (local.get $work)))
    (if (i32.eqz (local.get $fn)) (then (return (i32.const 0))))
    (local.set $argument (i32.add (local.get $index) (i32.const 1)))
    (block $arguments_done (loop $argument_next
    (br_if $arguments_done (i32.gt_u (local.get $argument) (local.get $tail)))
    (local.set $value (call $proof_shift (local.get $base) (call $proof_array_get (local.get $base) (local.get $values) (local.get $argument)) (i32.const 1) (i32.const 0) (i32.const 0)))
    (if (i32.eqz (local.get $value)) (then (return (i32.const 0))))
    (local.set $fn (call $proof_make_two (local.get $base) (global.get $PROOF_TERM_APPLICATION) (local.get $fn) (local.get $value)))
    (if (i32.eqz (local.get $fn)) (then (return (i32.const 0))))
    (local.set $argument (i32.add (local.get $argument) (i32.const 1))) (br $argument_next)))
    (call $proof_array_set (local.get $base) (local.get $next_values) (local.get $tail) (local.get $fn))
    (local.set $tail (i32.add (local.get $tail) (i32.const 1))) (br $tail_next)))
    (local.set $values (local.get $next_values))
    (local.set $telescope (call $proof_shift (local.get $base) (local.get $telescope) (i32.const 1) (i32.const 0) (i32.const 0)))
    (if (i32.eqz (local.get $telescope)) (then (return (i32.const 0))))
    (local.set $entry (call $proof_make_one (local.get $base) (global.get $PROOF_TERM_BOUND) (i32.add (local.get $indices) (i32.const 1))))
    (if (i32.eqz (local.get $entry)) (then (return (i32.const 0))))
    (local.set $telescope (call $proof_instantiate_binder (local.get $base) (call $proof_load (local.get $base) (i32.add (local.get $telescope) (i32.const 12))) (local.get $entry)))
    (if (i32.eqz (local.get $telescope)) (then (return (i32.const 0))))
    (local.set $index (i32.add (local.get $index) (i32.const 1))) (br $equation)))
    (local.set $target (call $proof_shift (local.get $base) (local.get $target) (i32.add (i32.mul (local.get $indices) (i32.const 2)) (i32.const 1)) (i32.const 0) (i32.const 0)))
    (if (i32.eqz (local.get $target)) (then (return (i32.const 0))))
    (block $wrapped (loop $wrap
    (br_if $wrapped (i32.eqz (local.get $index)))
    (local.set $index (i32.sub (local.get $index) (i32.const 1)))
    (local.set $target (call $proof_make_two (local.get $base) (global.get $PROOF_TERM_PRODUCT) (call $proof_array_get (local.get $base) (local.get $domains) (local.get $index)) (local.get $target)))
    (if (i32.eqz (local.get $target)) (then (return (i32.const 0))))
    (br $wrap)))
    (local.get $target))

  ;; Indexed elimination retains the index equations in each branch.
  ;; The proof is an ordinary match, applied to reflexivity at the original
  ;; indices; branch holes are typed by the same kernel branch-shape routine.
  (func $proof_state_derived_inversion
    (param $base i32) (param $root i32) (param $goal i32)
    (param $hypothesis i32) (param $equations i32) (param $work i32) (result i32)
    (local $context i32) (local $target i32) (local $type i32) (local $head i32)
    (local $declaration i32) (local $parameters i32) (local $indices i32)
    (local $constructors i32) (local $count i32) (local $index i32) (local $ordinal i32)
    (local $current i32) (local $domains i32) (local $actual_types i32) (local $family i32)
    (local $domain i32) (local $value i32) (local $eq_head i32) (local $eq i32)
    (local $motive i32) (local $expected i32) (local $shapes i32) (local $reachable i32)
    (local $branches i32) (local $goals i32) (local $identifier i32) (local $hole i32)
    (local $entry i32) (local $solution i32) (local $slot i32)
    (local $index_telescope i32) (local $motive_context i32)
    (local.set $context (call $proof_state_goal_context (local.get $base) (local.get $goal)))
    (local.set $target (call $proof_load (local.get $base) (i32.add (local.get $goal) (i32.const 16))))
    (local.set $type (call $proof_state_derived_hypothesis (local.get $base) (local.get $goal) (local.get $hypothesis) (local.get $work)))
    (if (i32.eqz (local.get $type)) (then (if (global.get $proof_last_error_code) (then (return (i32.const 0)))) (global.set $proof_last_error_code (i32.const 101)) (return (i32.const -1))))
    (local.set $head (call $proof_application_head (local.get $base) (local.get $type)))
    (if (i32.ne (call $proof_load (local.get $base) (i32.add (local.get $head) (i32.const 4))) (global.get $PROOF_TERM_INDUCTIVE)) (then (if (global.get $proof_last_error_code) (then (return (i32.const 0)))) (global.set $proof_last_error_code (i32.const 101)) (return (i32.const -1))))
    (local.set $declaration (call $proof_declaration_reference (local.get $base) (call $proof_load (local.get $base) (i32.add (local.get $head) (i32.const 8)))))
    (if (i32.ne (call $proof_load (local.get $base) (i32.add (local.get $declaration) (i32.const 4))) (global.get $PROOF_RECORD_INDUCTIVE_DECLARATION)) (then (if (global.get $proof_last_error_code) (then (return (i32.const 0)))) (global.set $proof_last_error_code (i32.const 101)) (return (i32.const -1))))
    (local.set $parameters (call $proof_load (local.get $base) (i32.add (local.get $declaration) (i32.const 16)))) (local.set $indices (call $proof_load (local.get $base) (i32.add (local.get $declaration) (i32.const 20))))
    (if (i32.eqz (local.get $indices)) (then
      (return (call $proof_state_cases_core (local.get $base) (local.get $root) (local.get $goal) (local.get $hypothesis) (i32.const 0) (local.get $work)))))
    (if (i32.eqz (call $proof_state_derived_walk (local.get $base) (local.get $target) (i32.const -2) (local.get $hypothesis) (i32.const 0) (local.get $context) (i32.const 0) (i32.const 0) (local.get $work))) (then (if (global.get $proof_last_error_code) (then (return (i32.const 0)))) (global.set $proof_last_error_code (i32.const 101)) (return (i32.const -1))))
    (local.set $constructors (call $proof_load (local.get $base) (i32.add (local.get $declaration) (i32.const 24))))
    (local.set $count (call $proof_array_count (local.get $base) (local.get $constructors)))
    (if (i32.eqz (local.get $count)) (then (local.set $equations (i32.const 0))))
    (local.set $current (call $proof_infer_term (local.get $base) (local.get $head) (local.get $context) (i32.const 0) (i32.const 0) (local.get $work)))
    (if (i32.eqz (local.get $current)) (then (return (i32.const 0))))
    (local.set $family (local.get $head))
    (block $params_done (loop $param
      (br_if $params_done (i32.ge_u (local.get $index) (local.get $parameters)))
      (local.set $value (call $proof_application_argument (local.get $base) (local.get $type) (local.get $index)))
      (local.set $current (call $proof_instantiate_binder (local.get $base) (call $proof_load (local.get $base) (i32.add (local.get $current) (i32.const 12))) (local.get $value))) (if (i32.eqz (local.get $current)) (then (return (i32.const 0))))
      (local.set $family (call $proof_make_two (local.get $base) (global.get $PROOF_TERM_APPLICATION) (local.get $family) (local.get $value))) (if (i32.eqz (local.get $family)) (then (return (i32.const 0))))
      (local.set $index (i32.add (local.get $index) (i32.const 1))) (br $param)))
    (local.set $index_telescope (local.get $current))
    (local.set $family (call $proof_shift (local.get $base) (local.get $family) (local.get $indices) (i32.const 0) (i32.const 0))) (if (i32.eqz (local.get $family)) (then (return (i32.const 0))))
    (local.set $domains (call $proof_make_array (local.get $base) (i32.add (local.get $indices) (i32.const 1)))) (if (i32.eqz (local.get $domains)) (then (return (i32.const 0))))
