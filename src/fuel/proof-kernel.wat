    (call $proof_native_allocate_buffer_handle (local.get $buffer) (i32.const 0)
      (global.get $PROOF_HANDLE_THEOREM) (i32.const 0))
  )

  

  ;; Wrap one rooted term argument in the sequence representation consumed by
  ;; the inductive declaration builder.
  

  ;; Append a monomorphic inductive family. The declaration's index count is
  ;; the product arity of its type after removing the declared parameters.
  
  ;; Complete a checked record environment. The caller has already published
  ;; nothing: the input handle owns a checked artifact whose last declaration
  ;; is the one-constructor inductive family, with the checker scratch arena
  ;; still owned. This function validates the source field contract, builds
  ;; one transparent projection definition per constructor field in scratch
  ;; storage, attaches canonical constructor-field metadata, composes the
  ;; extended declaration array, and compacts the reachable graph into a
  ;; fresh checked environment artifact. Returns the compact environment
  ;; handle, or zero when any contract or kernel check rejects.
  

  

  

  

  (func $proof_native_theorem_handle_valid
    (param $handle i32)
