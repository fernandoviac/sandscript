  ;; Scan an open term. Mode 0 finds one metavariable identifier, mode 1
  ;; detects free de Bruijn references, and mode 2 finds any unsolved hole.
  (func $proof_native_scan_open_term
    (param $artifact_base i32)
    (param $term_reference i32)
    (param $mode i32)
    (param $metavariable_identifier i32)
    (param $binder_depth i32)
    (result i32)
    (local $tag i32) (local $walk_result i32)
    (local $index i32)
    (local $count i32)
    (local $array_reference i32)
    (local $record_reference i32)
    (local $solution_reference i32)
    (local $ambient_index i32)
    (if (i32.eqz (local.get $term_reference)) (then (return (i32.const 0))))
    (local.set $tag
      (call $proof_load
        (local.get $artifact_base)
        (i32.add (local.get $term_reference) (i32.const 4))))
    (if (i32.eq
          (local.get $tag)
          (global.get $PROOF_RECORD_SOLVED_METAVARIABLE))
      (then
        (return
          (call $proof_native_scan_open_term
            (local.get $artifact_base)
            (call $proof_load
              (local.get $artifact_base)
              (i32.add (local.get $term_reference) (i32.const 16)))
            (local.get $mode)
            (local.get $metavariable_identifier)
            (local.get $binder_depth)))))
    (if (i32.eq (local.get $tag) (global.get $PROOF_TERM_METAVARIABLE))
      (then
        (local.set $solution_reference
          (call $proof_load
            (local.get $artifact_base)
            (i32.add (local.get $term_reference) (i32.const 16))))
        (if (local.get $solution_reference)
          (then
            (return
              (call $proof_native_scan_open_term
                (local.get $artifact_base)
                (local.get $solution_reference)
                (local.get $mode)
                (local.get $metavariable_identifier)
                (local.get $binder_depth)))))
        (if (i32.and (i32.eq (local.get $mode) (i32.const 3))
          (i32.eq (call $proof_load (local.get $artifact_base)
            (i32.add (local.get $term_reference) (i32.const 8))) (local.get $metavariable_identifier)))
          (then
            (local.set $array_reference
              (call $proof_load
                (local.get $artifact_base)
                (i32.add (local.get $term_reference) (i32.const 12))))
            (if (i32.eq
                  (local.get $array_reference)
                  (local.get $binder_depth))
              (then (return (i32.const 0))))
            (if (i32.or
                  (i32.eqz (local.get $array_reference))
                  (i32.eqz (local.get $binder_depth)))
              (then (return (i32.const 1))))
            (local.set $count
              (call $proof_array_count
                (local.get $artifact_base)
                (local.get $array_reference)))
            (if (i32.ne
                  (local.get $count)
                  (call $proof_array_count
                    (local.get $artifact_base)
                    (local.get $binder_depth)))
              (then (return (i32.const 1))))
            (local.set $index (i32.const 0))
            (block $scope_compare_done
              (loop $scope_compare_next
                (br_if $scope_compare_done
                  (i32.ge_u (local.get $index) (local.get $count)))
                (local.set $record_reference
                  (call $proof_array_get
                    (local.get $artifact_base)
                    (local.get $array_reference)
                    (local.get $index)))
                (local.set $solution_reference
                  (call $proof_array_get
                    (local.get $artifact_base)
                    (local.get $binder_depth)
                    (local.get $index)))
                (if (i32.or
                      (i32.ne
                        (call $proof_load
                          (local.get $artifact_base)
                          (i32.add (local.get $record_reference) (i32.const 4)))
                        (global.get $PROOF_TERM_BOUND))
                      (i32.or
                        (i32.ne
                          (call $proof_load
                            (local.get $artifact_base)
                            (i32.add (local.get $solution_reference) (i32.const 4)))
                          (global.get $PROOF_TERM_BOUND))
                        (i32.ne
                          (call $proof_load
                            (local.get $artifact_base)
                            (i32.add (local.get $record_reference) (i32.const 8)))
                          (call $proof_load
                            (local.get $artifact_base)
                            (i32.add (local.get $solution_reference) (i32.const 8))))))
                  (then (return (i32.const 1))))
                (local.set $index (i32.add (local.get $index) (i32.const 1)))
                (br $scope_compare_next)))
            (return (i32.const 0))))
        (if (i32.eq (local.get $mode) (i32.const 2))
          (then (return (i32.const 1))))
        (if (i32.and (i32.eq (local.get $mode) (i32.const 0))
          (i32.eq (call $proof_load (local.get $artifact_base)
            (i32.add (local.get $term_reference) (i32.const 8))) (local.get $metavariable_identifier)))
          (then (return (i32.const 1))))
        ;; A different open hole still carries semantic scope terms. Inspect
        ;; those for occurs and ambient-scope escapes rather than treating it
        ;; as an opaque leaf.
      ))
    (if (i32.eq (local.get $tag) (global.get $PROOF_TERM_BOUND))
      (then
        (if (i32.or
              (i32.ne (local.get $mode) (i32.const 1))
              (i32.lt_u
                (call $proof_load
                  (local.get $artifact_base)
                  (i32.add (local.get $term_reference) (i32.const 8)))
                (local.get $binder_depth)))
          (then (return (i32.const 0))))
        (if (i32.eqz (local.get $metavariable_identifier))
          (then (return (i32.const 1))))
        (local.set $ambient_index
          (i32.sub
            (call $proof_load
              (local.get $artifact_base)
              (i32.add (local.get $term_reference) (i32.const 8)))
            (local.get $binder_depth)))
        (local.set $count
          (call $proof_array_count
            (local.get $artifact_base)
            (local.get $metavariable_identifier)))
        (local.set $index (i32.const 0))
        (block $scope_done
          (loop $scope_next
            (br_if $scope_done (i32.ge_u (local.get $index) (local.get $count)))
            (local.set $record_reference
              (call $proof_array_get
                (local.get $artifact_base)
                (local.get $metavariable_identifier)
                (local.get $index)))
            (if (i32.and
                  (i32.eq
                    (call $proof_load
                      (local.get $artifact_base)
                      (i32.add (local.get $record_reference) (i32.const 4)))
                    (global.get $PROOF_TERM_BOUND))
                  (i32.eq
                    (call $proof_load
                      (local.get $artifact_base)
                      (i32.add (local.get $record_reference) (i32.const 8)))
                    (local.get $ambient_index)))
              (then (return (i32.const 0))))
            (local.set $index (i32.add (local.get $index) (i32.const 1)))
            (br $scope_next)))
        (return (i32.const 1))))
    (if (i32.or (i32.eq (local.get $tag) (global.get $PROOF_TERM_NAT_LITERAL))
      (i32.eq (local.get $tag) (global.get $PROOF_TERM_STRING_LITERAL)))
      (then (return (i32.const 0))))
    (local.set $count (i32.mul (call $proof_load (local.get $artifact_base) (local.get $term_reference)) (i32.const 4)))
    (local.set $index (i32.const 8))
    (block $children_done (loop $child_next
      (br_if $children_done (i32.ge_u (local.get $index) (local.get $count)))
      (if (call $proof_term_child (local.get $tag) (local.get $index)) (then
        (local.set $record_reference (call $proof_load (local.get $artifact_base) (i32.add (local.get $term_reference) (local.get $index))))
        (if (local.get $record_reference) (then
          (local.set $walk_result (call $proof_native_scan_open_term (local.get $artifact_base) (local.get $record_reference)
            (local.get $mode) (local.get $metavariable_identifier)
            (i32.add (local.get $binder_depth) (i32.and (i32.eq (local.get $mode) (i32.const 1))
              (call $proof_term_child_binders (local.get $tag) (local.get $index))))))
          (if (local.get $walk_result) (then (return (local.get $walk_result))))))))
      (local.set $index (i32.add (local.get $index) (i32.const 4))) (br $child_next)))
    (i32.const 0)
  )

  (func $proof_native_replace_metavariable_field
    (param $artifact_base i32)
    (param $field_address i32)
    (param $metavariable_identifier i32)
    (param $solution_reference i32)
    (local $term_reference i32)
    (local $tag i32)
    (local.set $term_reference
      (call $proof_load
        (local.get $artifact_base)
        (local.get $field_address)))
    (if (i32.eqz (local.get $term_reference)) (then (return)))
    (local.set $tag
      (call $proof_load
        (local.get $artifact_base)
        (i32.add (local.get $term_reference) (i32.const 4))))
    (if (i32.and
          (i32.eq (local.get $tag) (global.get $PROOF_TERM_METAVARIABLE))
          (i32.eq
            (call $proof_load
              (local.get $artifact_base)
              (i32.add (local.get $term_reference) (i32.const 8)))
            (local.get $metavariable_identifier)))
      (then
        (call $proof_store
          (local.get $artifact_base)
          (i32.add (local.get $term_reference) (i32.const 4))
          (global.get $PROOF_RECORD_SOLVED_METAVARIABLE))
        (call $proof_store
          (local.get $artifact_base)
          (i32.add (local.get $term_reference) (i32.const 16))
          (local.get $solution_reference))
        (call $proof_store
          (local.get $artifact_base)
          (local.get $field_address)
          (local.get $solution_reference))
        (return)))
    (if (i32.eq
          (local.get $tag)
          (global.get $PROOF_RECORD_SOLVED_METAVARIABLE))
      (then
        (call $proof_store
          (local.get $artifact_base)
          (local.get $field_address)
          (call $proof_load
            (local.get $artifact_base)
            (i32.add (local.get $term_reference) (i32.const 16))))
        (return)))
    (call $proof_native_replace_metavariable_term
      (local.get $artifact_base)
      (local.get $term_reference)
      (local.get $metavariable_identifier)
      (local.get $solution_reference))
  )

  (func $proof_native_replace_metavariable_term
    (param $artifact_base i32) (param $term_reference i32)
    (param $metavariable_identifier i32) (param $solution_reference i32)
    (local $tag i32) (local $count i32) (local $index i32)
    (if (i32.eqz (local.get $term_reference)) (then (return)))
    (local.set $tag (call $proof_load (local.get $artifact_base) (i32.add (local.get $term_reference) (i32.const 4))))
    (if (i32.or (i32.eq (local.get $tag) (global.get $PROOF_TERM_NAT_LITERAL))
      (i32.eq (local.get $tag) (global.get $PROOF_TERM_STRING_LITERAL)))
      (then (return)))
    (local.set $count (i32.mul (call $proof_load (local.get $artifact_base) (local.get $term_reference)) (i32.const 4)))
    (local.set $index (i32.const 8))
    (block $done (loop $next
      (br_if $done (i32.ge_u (local.get $index) (local.get $count)))
      (if (call $proof_term_child (local.get $tag) (local.get $index)) (then
        (call $proof_native_replace_metavariable_field (local.get $artifact_base)
