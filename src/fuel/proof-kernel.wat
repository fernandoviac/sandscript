        (i32.load
          (call $abs
            (i32.sub (local.get $buffer) (global.get $GC_HEADER_SIZE))))
        (i32.const 24))
      (global.get $OBJ_ARRAYBUFFER))
  )

  (func $proof_native_scope_valid (param $handle i32) (result i32)
    (local $owner i32) (local $active i32)
    (local.set $owner (i32.load (call $abs (i32.add (local.get $handle) (i32.const 20)))))
    (if (i32.eqz (local.get $owner)) (then (return (i32.const 1))))
    (local.set $active (call $proof_native_active_universe_state))
    (i32.and (i32.ne (local.get $active) (i32.const 0))
      (i32.eq (local.get $owner) (i32.add (local.get $active) (global.get $GC_HEADER_SIZE)))))

  (func $proof_native_term_handle_valid
    (param $handle i32) (result i32)
    (if (i32.eqz (call $proof_native_handle_valid_kind (local.get $handle) (global.get $PROOF_HANDLE_TERM)))
      (then (return (i32.const 0))))
    (call $proof_native_scope_valid (local.get $handle)))

  (func $proof_native_sequence_handle_valid
    (param $handle i32) (result i32)
    (if (i32.eqz (call $proof_native_handle_valid_kind (local.get $handle) (global.get $PROOF_HANDLE_SEQUENCE)))
      (then (return (i32.const 0))))
    (call $proof_native_scope_valid (local.get $handle)))

  ;; The caller reserves 24 bytes; buffer is an ArrayBuffer data pointer.
  ;; The handle owns the collector-traced buffer and optional scoped owner.
  (func $proof_native_allocate_buffer_handle
    (param $buffer i32) (param $root i32) (param $kind i32) (param $owner i32)
    (result i32)
    (local $handle i32)
    (local.set $handle (call $read_state (global.get $STATE_HEAP_POINTER)))
    (i32.store (call $abs (local.get $handle))
      (i32.or (i32.const 24) (i32.shl (global.get $OBJ_THEOREM) (i32.const 24))))
    (i32.store (call $abs (i32.add (local.get $handle) (i32.const 4))) (i32.const 0))
    (i32.store (call $abs (i32.add (local.get $handle) (global.get $GC_HEADER_SIZE)))
      (local.get $buffer))
    (i32.store (call $abs (i32.add (local.get $handle) (i32.const 12))) (local.get $root))
    (i32.store (call $abs (i32.add (local.get $handle) (i32.const 16))) (local.get $kind))
    (i32.store (call $abs (i32.add (local.get $handle) (i32.const 20))) (local.get $owner))
    (call $write_state (global.get $STATE_HEAP_POINTER)
      (i32.add (local.get $handle) (i32.const 24)))
    (local.get $handle))

  ;; Allocate a collector-compatible proof handle plus its canonical artifact
  ;; buffer. Caller has already budgeted the complete allocation.
  (func $proof_native_allocate_term_handle
    (param $artifact_length i32)
    (param $root_reference i32)
    (param $workspace_length i32)
    (result i32)
    (local $buffer i32)
    (local.set $buffer
      (call $allocate_arraybuffer
        (i32.add
          (local.get $artifact_length)
          (local.get $workspace_length))))
    (i32.store
      (call $abs (i32.add (local.get $buffer) (i32.const 12)))
      (i32.shr_u (local.get $artifact_length) (i32.const 2)))
    (call $proof_native_allocate_buffer_handle (local.get $buffer) (local.get $root_reference)
      (global.get $PROOF_HANDLE_TERM) (i32.const 0))
  )

  (func $proof_native_handle_artifact_base
    (param $handle i32)
    (result i32)
    (i32.add
      (call $proof_native_handle_buffer (local.get $handle))
      (i32.const 4))
  )

  (func $proof_native_handle_artifact_length
    (param $handle i32)
    (result i32)
    (i32.shl
      (i32.load
        (call $abs
          (i32.add
            (call $proof_native_handle_buffer (local.get $handle))
            (i32.const 12))))
      (i32.const 2))
  )

  (func $proof_native_initialize_artifact_header
    (param $artifact_base i32)
    (param $artifact_length i32)
    (param $declarations_reference i32)
    (call $proof_store
      (local.get $artifact_base) (i32.const 0)
      (global.get $PROOF_MAGIC))
    (call $proof_store
      (local.get $artifact_base) (i32.const 4)
      (global.get $PROOF_VERSION))
    (call $proof_store
      (local.get $artifact_base) (i32.const 8)
      (i32.div_u (local.get $artifact_length) (i32.const 4)))
    (call $proof_store
      (local.get $artifact_base) (i32.const 12)
      (local.get $declarations_reference))
  )

  (func $proof_native_write_empty_declarations
    (param $artifact_base i32)
    (param $reference i32)
    (call $proof_store
      (local.get $artifact_base) (local.get $reference) (i32.const 3))
    (call $proof_store
      (local.get $artifact_base)
      (i32.add (local.get $reference) (i32.const 4))
      (global.get $PROOF_RECORD_ARRAY))
    (call $proof_store
      (local.get $artifact_base)
      (i32.add (local.get $reference) (i32.const 8))
      (i32.const 0))
  )

  ;; Resolve one copied artifact reference through either a uniform relocation
  ;; delta or an explicit old-reference to new-reference table. The table is an
  ;; ArrayBuffer whose word at data + old reference contains the new reference.
  (func $proof_native_relocated_reference
    (param $reference i32)
    (param $delta i32)
    (param $reference_mapping_buffer i32)
    (result i32)
    (local $relocated_reference i32)
    (if (i32.eqz (local.get $reference))
      (then (return (i32.const 0))))
    (if (i32.eqz (local.get $reference_mapping_buffer))
      (then
        (return
          (i32.add
            (local.get $reference)
            (local.get $delta)))))
    (local.set $relocated_reference
      (i32.load
        (call $abs
          (i32.add
            (i32.add
              (local.get $reference_mapping_buffer)
              (i32.const 4))
            (local.get $reference)))))
    (if (i32.eqz (local.get $relocated_reference))
      (then (unreachable)))
    (local.get $relocated_reference)
  )

  ;; Relocate copied term and declaration graphs using the canonical edge schema.
  (func $proof_native_relocate_records
    (param $artifact_base i32) (param $start i32) (param $length i32)
    (param $delta i32) (param $reference_mapping_buffer i32)
    (local $offset i32) (local $end i32) (local $words i32)
    (local $index i32) (local $field i32)
    (local.set $offset (local.get $start))
    (local.set $end (i32.add (local.get $start) (local.get $length)))
    (block $done (loop $next
      (br_if $done (i32.ge_u (local.get $offset) (local.get $end)))
      (local.set $words (call $proof_load (local.get $artifact_base) (local.get $offset)))
      (local.set $index (i32.const 2))
      (block $fields_done (loop $fields_next
        (br_if $fields_done (i32.ge_u (local.get $index) (local.get $words)))
        (if (call $proof_record_edge_kind (local.get $artifact_base) (local.get $offset) (local.get $index))
          (then
            (local.set $field (i32.add (local.get $offset) (i32.mul (local.get $index) (i32.const 4))))
            (call $proof_store (local.get $artifact_base) (local.get $field)
              (call $proof_native_relocated_reference
                (call $proof_load (local.get $artifact_base) (local.get $field))
                (local.get $delta) (local.get $reference_mapping_buffer)))))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $fields_next)))
      (local.set $offset (i32.add (local.get $offset) (i32.mul (local.get $words) (i32.const 4))))
      (br $next)))
  )

  ;; Mark the transitive record graph rooted at the artifact root and
  ;; declaration array. The reachability table is stored after the reference
  ;; mapping in one collector-rooted ArrayBuffer.
  (func $proof_native_mark_record_reference
    (param $reachability_table_address i32)
    (param $reference i32)
    (result i32)
    (if (i32.eqz (local.get $reference))
      (then (return (i32.const 0))))
    (if (i32.load
          (call $abs
            (i32.add
              (local.get $reachability_table_address)
              (local.get $reference))))
      (then (return (i32.const 0))))
    (i32.store
      (call $abs
        (i32.add
          (local.get $reachability_table_address)
          (local.get $reference)))
      (i32.const 1))
    (i32.const 1)
  )

  (func $proof_native_mark_reachable_records
    (param $artifact_base i32) (param $artifact_length i32)
    (param $reachability_table_address i32) (param $root_reference i32)
    (param $declarations_reference i32)
    (local $record_reference i32) (local $word_count i32)
    (local $index i32) (local $changed i32)
    (drop (call $proof_native_mark_record_reference (local.get $reachability_table_address) (local.get $root_reference)))
    (drop (call $proof_native_mark_record_reference (local.get $reachability_table_address) (local.get $declarations_reference)))
    (loop $pass
      (local.set $changed (i32.const 0))
      (local.set $record_reference (i32.const 16))
      (block $done (loop $next
        (br_if $done (i32.ge_u (local.get $record_reference) (local.get $artifact_length)))
        (local.set $word_count (call $proof_load (local.get $artifact_base) (local.get $record_reference)))
        (if (i32.load (call $abs (i32.add (local.get $reachability_table_address) (local.get $record_reference))))
          (then
            (local.set $index (i32.const 2))
            (block $fields_done (loop $fields_next
              (br_if $fields_done (i32.ge_u (local.get $index) (local.get $word_count)))
              (if (call $proof_record_edge_kind (local.get $artifact_base) (local.get $record_reference) (local.get $index))
                (then
                  (local.set $changed (i32.or (local.get $changed)
                    (call $proof_native_mark_record_reference (local.get $reachability_table_address)
                      (call $proof_load (local.get $artifact_base)
                        (i32.add (local.get $record_reference) (i32.mul (local.get $index) (i32.const 4)))))))))
              (local.set $index (i32.add (local.get $index) (i32.const 1)))
              (br $fields_next)))))
        (local.set $record_reference (i32.add (local.get $record_reference) (i32.mul (local.get $word_count) (i32.const 4))))
        (br $next)))
      (br_if $pass (local.get $changed)))
  )

  ;; Rebuild one term artifact from a chosen core root and the canonical
  ;; declaration array. Records unreachable from those roots are omitted.
  (func $proof_native_compact_core_term
    (param $source_handle i32) (param $core_root i32) (param $source_length i32)
    (param $check_workspace_length i32) (result i32)
    (local $handle i32) (local $base i32) (local $length i32)
    (local.set $handle (call $proof_native_prepare_core_term (local.get $source_handle)
      (local.get $core_root) (local.get $source_length) (local.get $check_workspace_length)))
    (if (i32.le_s (local.get $handle) (i32.const 0)) (then (return (local.get $handle))))
    (local.set $base (call $proof_native_handle_artifact_base (local.get $handle)))
    (local.set $length (call $proof_native_handle_artifact_length (local.get $handle)))
    (if (call $proof_check_artifact (local.get $base) (local.get $length)
      (i32.sub (i32.load (call $abs (call $proof_native_handle_buffer (local.get $handle)))) (local.get $length)))
      (then (return (i32.const -2))))
    (local.get $handle))
  (func $proof_native_prepare_core_term
    (param $source_handle i32)
    (param $core_root i32)
    (param $source_length i32)
    (param $check_workspace_length i32)
    (result i32)
    (local $source_base i32)
    (local $source_declarations i32)
    (local $mapping_buffer i32)
    (local $reachability_table_address i32)
    (local $record_reference i32)
    (local $word_count i32)
    (local $new_reference i32)
    (local $mapped_reference i32)
    (local $new_length i32)
    (local $new_root i32)
    (local $new_declarations i32)
    (local $destination_handle i32)
    (local $destination_base i32)
    (local.set $source_base
      (call $proof_native_handle_artifact_base (local.get $source_handle)))
    (if (i32.eqz (local.get $source_length))
      (then
        (local.set $source_length
          (call $proof_native_handle_artifact_length (local.get $source_handle)))))
    (local.set $source_declarations
      (call $proof_load (local.get $source_base) (i32.const 12)))
    (if (call $check_heap_overflow
          (i32.add
            (call $estimate_arraybuffer_size
              (i32.mul (local.get $source_length) (i32.const 2)))
            (i32.add
              (call $estimate_arraybuffer_size
                (i32.mul (local.get $source_length) (i32.const 2)))
              (i32.const 24))))
      (then (return (i32.const -1))))
    (local.set $mapping_buffer
      (call $allocate_arraybuffer
        (i32.mul (local.get $source_length) (i32.const 2))))
    (memory.fill
      (call $abs
        (i32.add (local.get $mapping_buffer) (i32.const 4)))
      (i32.const 0)
      (i32.mul (local.get $source_length) (i32.const 2)))
    (local.set $reachability_table_address
      (i32.add
        (i32.add (local.get $mapping_buffer) (i32.const 4))
        (local.get $source_length)))
    (call $proof_native_mark_reachable_records
      (local.get $source_base)
      (local.get $source_length)
      (local.get $reachability_table_address)
      (local.get $core_root)
      (local.get $source_declarations))
    ;; Assign compact references in retained source order, except the
    ;; canonical declaration array, which every artifact consumer expects
    ;; as the final record: term composition copies exactly the region
    ;; before it.
    (local.set $record_reference (i32.const 16))
    (local.set $new_reference (i32.const 16))
    (block $mapping_done
      (loop $mapping_next
        (br_if $mapping_done
          (i32.ge_u
            (local.get $record_reference)
            (local.get $source_length)))
        (local.set $word_count
          (call $proof_load
            (local.get $source_base)
            (local.get $record_reference)))
        (if (i32.and
              (i32.ne
                (local.get $record_reference)
                (local.get $source_declarations))
              (i32.ne
                (i32.load8_u
                  (call $abs
                    (i32.add
                      (local.get $reachability_table_address)
                      (local.get $record_reference))))
                (i32.const 0)))
          (then
            (i32.store
              (call $abs
                (i32.add
                  (i32.add (local.get $mapping_buffer) (i32.const 4))
                  (local.get $record_reference)))
              (local.get $new_reference))
            (local.set $new_reference
              (i32.add
                (local.get $new_reference)
                (i32.mul (local.get $word_count) (i32.const 4))))))
        (local.set $record_reference
          (i32.add
            (local.get $record_reference)
            (i32.mul (local.get $word_count) (i32.const 4))))
        (br $mapping_next)))
    (i32.store
      (call $abs
        (i32.add
          (i32.add (local.get $mapping_buffer) (i32.const 4))
          (local.get $source_declarations)))
      (local.get $new_reference))
    (local.set $new_reference
      (i32.add
        (local.get $new_reference)
        (i32.mul
          (call $proof_load
            (local.get $source_base)
            (local.get $source_declarations))
          (i32.const 4))))
    (local.set $new_length (local.get $new_reference))
    (local.set $new_root
      (i32.load
        (call $abs
          (i32.add
            (i32.add (local.get $mapping_buffer) (i32.const 4))
            (local.get $core_root)))))
    (local.set $new_declarations
      (i32.load
        (call $abs
          (i32.add
            (i32.add (local.get $mapping_buffer) (i32.const 4))
            (local.get $source_declarations)))))
    (if (i32.or
          (i32.eqz (local.get $new_root))
          (i32.eqz (local.get $new_declarations)))
      (then (return (i32.const -2))))
    ;; Zero keeps the historical exact-size checking arena; negative one
    ;; selects the generous declaration-checking arena.
    (if (i32.eq (local.get $check_workspace_length) (i32.const -1))
      (then
        (local.set $check_workspace_length
          (call $proof_native_workspace_size (local.get $new_length)))))
    (if (i32.eqz (local.get $check_workspace_length))
      (then
        (local.set $check_workspace_length (local.get $new_length))))
    (if (call $check_heap_overflow
          (i32.add
            (call $estimate_arraybuffer_size
              (i32.add
                (local.get $new_length)
                (local.get $check_workspace_length)))
            (i32.const 24)))
      (then (return (i32.const -1))))
    (local.set $destination_handle
      (call $proof_native_allocate_term_handle
        (local.get $new_length)
        (local.get $new_root)
        (local.get $check_workspace_length)))
    (local.set $source_base
      (call $proof_native_handle_artifact_base (local.get $source_handle)))
    (local.set $destination_base
      (call $proof_native_handle_artifact_base
        (local.get $destination_handle)))
    (call $proof_native_initialize_artifact_header
      (local.get $destination_base)
      (local.get $new_length)
      (local.get $new_declarations))
    (local.set $record_reference (i32.const 16))
    (block $copy_done
      (loop $copy_next
        (br_if $copy_done
          (i32.ge_u
            (local.get $record_reference)
            (local.get $source_length)))
        (local.set $word_count
          (call $proof_load
            (local.get $source_base)
            (local.get $record_reference)))
        (local.set $mapped_reference
          (i32.load
            (call $abs
              (i32.add
                (i32.add (local.get $mapping_buffer) (i32.const 4))
                (local.get $record_reference)))))
        (if (local.get $mapped_reference)
          (then
            (memory.copy
              (call $abs
                (i32.add
                  (local.get $destination_base)
                  (local.get $mapped_reference)))
              (call $abs
                (i32.add
                  (local.get $source_base)
                  (local.get $record_reference)))
              (i32.mul (local.get $word_count) (i32.const 4)))))
        (local.set $record_reference
          (i32.add
            (local.get $record_reference)
            (i32.mul (local.get $word_count) (i32.const 4))))
        (br $copy_next)))
    (call $proof_native_relocate_records
      (local.get $destination_base)
      (i32.const 16)
      (i32.sub (local.get $new_length) (i32.const 16))
      (i32.const 0)
      (local.get $mapping_buffer))

    (i32.store (call $abs (i32.add (local.get $destination_handle) (i32.const 20)))
      (i32.load (call $abs (i32.add (local.get $source_handle) (i32.const 20)))))
    (local.get $destination_handle)
  )

  ;; Copy every record except the source artifact's final declaration array.
  ;; Returns the relocated root reference.
  (func $proof_native_copy_term_records
    (param $source_handle i32)
    (param $destination_base i32)
    (param $destination_start i32)
    (result i32)
    (local $source_base i32)
    (local $declarations i32)
    (local $records_length i32)
    (local $delta i32)
    (local.set $source_base
      (call $proof_native_handle_artifact_base
        (local.get $source_handle)))
    (local.set $declarations
      (call $proof_load (local.get $source_base) (i32.const 12)))
    (local.set $records_length
      (i32.sub (local.get $declarations) (i32.const 16)))
    (memory.copy
      (call $abs (local.get $destination_start))
      (call $abs (i32.add (local.get $source_base) (i32.const 16)))
      (local.get $records_length))
    (local.set $delta
      (i32.sub
        (i32.sub
          (local.get $destination_start)
          (local.get $destination_base))
        (i32.const 16)))
    (call $proof_native_relocate_records
      (local.get $destination_base)
      (i32.sub
        (local.get $destination_start)
        (local.get $destination_base))
      (local.get $records_length)
      (local.get $delta)
      (i32.const 0))
    (i32.add
      (call $proof_native_handle_root (local.get $source_handle))
      (local.get $delta))
  )

  (func $proof_native_term_records_length
    (param $handle i32)
    (result i32)
    (local $artifact_base i32)
    (local.set $artifact_base
      (call $proof_native_handle_artifact_base (local.get $handle)))
    (i32.sub
      (call $proof_load (local.get $artifact_base) (i32.const 12))
      (i32.const 16))
  )

  (func $proof_native_push_term
    (param $handle i32)
    (call $pending_push
      (global.get $TYPE_THEOREM)
      (i32.const 0)
      (local.get $handle)
      (i32.const 0))
  )

  (func $proof_native_term_proposition
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_identifier i32) (param $argument_count i32)
    (param $stack_base i32)
    (result i32)
    (local $handle i32)
    (local $artifact_base i32)
    (call $write_ctx
      (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (if (call $check_heap_overflow
          (i32.add
            (call $estimate_arraybuffer_size (i32.const 52))
            (i32.const 24)))
      (then (return (i32.const 0))))
    (local.set $handle
      (call $proof_native_allocate_term_handle
        (i32.const 52) (i32.const 28) (i32.const 0)))
    (local.set $artifact_base
      (call $proof_native_handle_artifact_base (local.get $handle)))
    (call $proof_native_initialize_artifact_header
      (local.get $artifact_base) (i32.const 52) (i32.const 40))
    (call $proof_store
      (local.get $artifact_base) (i32.const 28) (i32.const 3))
    (call $proof_store
      (local.get $artifact_base) (i32.const 32)
      (global.get $PROOF_TERM_SORT))
    (call $proof_store
      (local.get $artifact_base) (i32.const 36) (i32.const 16))
    (call $proof_native_write_level_node (local.get $artifact_base) (i32.const 16)
      (i32.const 0) (i32.const 0) (i32.const 0))
    (call $proof_native_write_empty_declarations
      (local.get $artifact_base) (i32.const 40))
    (call $proof_native_push_term (local.get $handle))
    (i32.const 0)
  )

  (func $proof_native_nonnegative_integer_argument
    (param $argument i32)
    (result i32)
    (local $number f64)
    (if (i32.eqz (call $value_is_numeric (local.get $argument)))
      (then (return (i32.const -1))))
    (local.set $number (call $value_to_f64 (local.get $argument)))
    (call $f64_index_or_negative (local.get $number))
  )

  ;; Level values use the ordinary proof-buffer envelope. Its optional owner
  ;; pointer is traced; parameter handles remain frame-owned scope capabilities.
  (func $proof_native_level_argument_owner (param $slot i32) (result i32)
    (local $handle i32)
    (if (i32.ne (call $value_type (local.get $slot)) (global.get $TYPE_THEOREM))
      (then (return (i32.const 0))))
    (local.set $handle (call $value_data_lo (local.get $slot)))
    (if (i32.eq (call $proof_native_handle_kind (local.get $handle)) (global.get $PROOF_HANDLE_UNIVERSE))
      (then (return (call $proof_native_handle_buffer (local.get $handle)))))
    (i32.load (call $abs (i32.add (local.get $handle) (i32.const 20)))))

  (func $proof_native_level_argument_length (param $slot i32) (result i32)
    (local $handle i32) (local $owner i32) (local $number i32)
    (if (i32.eq (call $value_type (local.get $slot)) (global.get $TYPE_THEOREM))
      (then
        (local.set $handle (call $value_data_lo (local.get $slot)))
        (local.set $owner (call $proof_native_level_argument_owner (local.get $slot)))
        (if (local.get $owner)
          (then
            (if (i32.ne (local.get $owner)
                  (i32.add (call $proof_native_active_universe_state) (global.get $GC_HEADER_SIZE)))
              (then (return (i32.const -1))))))
        (if (i32.eq (call $proof_native_handle_kind (local.get $handle)) (global.get $PROOF_HANDLE_UNIVERSE))
          (then
            (if (i32.eqz (call $proof_native_active_universe_state)) (then (return (i32.const -1))))
            (if (i32.ge_u (call $proof_native_handle_root (local.get $handle))
                  (call $native_continuation_state_get (call $proof_native_active_universe_state) (i32.const 4)))
              (then (return (i32.const -1))))
            (return (i32.const 16))))
        (if (call $proof_native_handle_valid_kind (local.get $handle) (global.get $PROOF_HANDLE_LEVEL))
          (then (return (call $proof_native_term_records_length (local.get $handle)))))
        (return (i32.const -1))))
    (local.set $number (call $proof_native_nonnegative_integer_argument (local.get $slot)))
    (if (i32.or (i32.lt_s (local.get $number) (i32.const 0)) (i32.gt_u (local.get $number) (i32.const 67108860)))
      (then (return (i32.const -1))))
    (i32.add (i32.const 12) (i32.mul (local.get $number) (i32.const 16))))

  ;; Allocation-free writers; the caller has validated and budgeted each input.
  (func $proof_native_write_level_node
    (param $base i32) (param $cursor i32) (param $kind i32)
    (param $left i32) (param $right i32)
    (call $proof_store (local.get $base) (local.get $cursor)
      (select (i32.const 5) (select (i32.const 4) (i32.const 3) (local.get $kind))
        (i32.ge_u (local.get $kind) (i32.const 3))))
    (call $proof_store (local.get $base) (i32.add (local.get $cursor) (i32.const 4))
      (global.get $PROOF_RECORD_UNIVERSE_LEVEL))
    (call $proof_store (local.get $base) (i32.add (local.get $cursor) (i32.const 8)) (local.get $kind))
    (if (local.get $kind)
      (then (call $proof_store (local.get $base) (i32.add (local.get $cursor) (i32.const 12)) (local.get $left))))
    (if (i32.ge_u (local.get $kind) (i32.const 3))
      (then (call $proof_store (local.get $base) (i32.add (local.get $cursor) (i32.const 16)) (local.get $right)))))

  (func $proof_native_write_numeric_level
    (param $base i32) (param $cursor i32) (param $number i32) (result i32)
    (local $root i32)
