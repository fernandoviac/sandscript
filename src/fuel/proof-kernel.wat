            (call $throw_type_error_with_message
              (global.get $BUILTIN_MSG_MISSING_ARGUMENT))))))
    (local.set $argument
      (i32.sub
        (local.get $pending_pointer)
        (global.get $VALUE_SIZE)))
    (if (i32.ne
          (call $value_type (local.get $argument))
          (global.get $TYPE_THEOREM))
      (then
        (call $write_ctx
          (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
        (return
          (i32.add
            (i32.const 1)
            (call $throw_type_error_with_message
              (global.get $BUILTIN_MSG_NOT_AN_OBJECT))))))
    (local.set $theorem_handle
      (call $value_data_lo (local.get $argument)))
    (if (i32.eqz
          (if (result i32)
            (i32.eq (local.get $method_identifier) (i32.const 0x24C))
            (then
              (call $proof_native_handle_valid_kind
                (local.get $theorem_handle) (global.get $PROOF_HANDLE_THEOREM)))
            (else
              (i32.or
                (call $proof_native_handle_valid_kind
                  (local.get $theorem_handle) (global.get $PROOF_HANDLE_ENVIRONMENT))
                (call $proof_native_state_handle_valid (local.get $theorem_handle))))))
      (then
        (call $write_ctx
          (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
        (return
          (i32.add
            (i32.const 1)
            (call $throw_type_error_with_message
              (global.get $BUILTIN_MSG_NOT_AN_OBJECT))))))
    (local.set $artifact_base
      (call $proof_native_handle_artifact_base
        (local.get $theorem_handle)))
    (local.set $artifact_length
      (call $proof_native_handle_artifact_length
        (local.get $theorem_handle)))
    (if (call $check_heap_overflow
          (i32.add
            (call $estimate_arraybuffer_size
              (local.get $artifact_length))
            (call $estimate_typed_array_descriptor_size)))
      (then (return (i32.const 0))))
    (local.set $pending_pointer
      (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (local.set $argument
      (i32.sub
        (local.get $pending_pointer)
        (global.get $VALUE_SIZE)))
    (local.set $theorem_handle
      (call $value_data_lo (local.get $argument)))
    (local.set $artifact_base
      (call $proof_native_handle_artifact_base
        (local.get $theorem_handle)))
    (local.set $buffer_pointer
      (call $allocate_arraybuffer (local.get $artifact_length)))
    (memory.copy
      (call $abs (i32.add (local.get $buffer_pointer) (i32.const 4)))
      (call $abs (local.get $artifact_base))
      (local.get $artifact_length))
    (local.set $descriptor_pointer
      (call $allocate_typed_array_descriptor
        (local.get $buffer_pointer)
        (i32.const 0)
        (local.get $artifact_length)))
    (call $write_ctx
      (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (call $pending_push
      (global.get $TYPE_UINT8ARRAY)
      (i32.const 0)
      (local.get $descriptor_pointer)
      (i32.const 0))
    (i32.const 0)
  )

  ;; Validate untrusted canonical bytes in an isolated scratch buffer. The
  ;; checker receives writable workspace after the copied artifact, never the
  ;; caller's Uint8Array storage.
  

  ;; Native checker diagnostic for probes, tests, and language tooling.
  (func $proof_native_error_code
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_identifier i32) (param $argument_count i32)
    (param $stack_base i32)
    (result i32)
    (call $write_ctx
      (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (call $pending_push
      (global.get $TYPE_INTEGER)
      (i32.const 0)
      (global.get $proof_last_error_code)
      (i32.const 0))
    (i32.const 0)
  )

  ;; Check untrusted canonical bytes and mint a theorem handle for one checked
  ;; theorem declaration. The caller's bytes are copied before validation, so
  ;; later mutation cannot alter the kernel-owned artifact.
  

  ;; Build a global-reference term over a checked theorem environment.
  ;; Solve the deterministic least concrete instance for one generalized
  ;; declaration into a caller-owned ArrayBuffer. The caller allocates and
  ;; roots the buffer, then reloads the source artifact before this call.
  (func $proof_native_solve_default_universe_instance
    (param $source_base i32)
    (param $declaration_index i32)
    (param $universe_count i32)
    (param $solution_buffer i32)
    (local $source_declarations i32)
    (local $declaration_reference i32)
    (local $universe_context_reference i32)
    (local $constraint_array_reference i32)
    (local $constraint_count i32)
    (local $constraint_index i32)
    (local $constraint_reference i32)
    (local $iteration i32)
    (local $changed i32)
    (local $left_variable i32)
    (local $left_offset i32)
    (local $relation i32)
    (local $right_variable i32)
    (local $right_offset i32)
    (local $left_level i32)
    (local $right_level i32)
    (local $candidate_level i32)
    (local.set $source_declarations
      (call $proof_load (local.get $source_base) (i32.const 12)))
    (local.set $declaration_reference
      (call $proof_array_get
        (local.get $source_base)
        (local.get $source_declarations)
        (local.get $declaration_index)))
    (local.set $universe_context_reference
      (call $proof_load
        (local.get $source_base)
        (i32.add (local.get $declaration_reference) (i32.const 8))))
    (local.set $constraint_array_reference
      (call $proof_load
        (local.get $source_base)
        (i32.add (local.get $universe_context_reference) (i32.const 12))))
    (local.set $constraint_count
      (call $proof_array_count
        (local.get $source_base)
        (local.get $constraint_array_reference)))
    (local.set $iteration (i32.const 0))
    (block $solution_done
      (loop $solution_next
        (br_if $solution_done
          (i32.ge_u
            (local.get $iteration)
            (local.get $universe_count)))
        (local.set $changed (i32.const 0))
        (local.set $constraint_index (i32.const 0))
        (block $solution_constraints_done
          (loop $solution_constraint_next
            (br_if $solution_constraints_done
              (i32.ge_u
                (local.get $constraint_index)
                (local.get $constraint_count)))
            (local.set $constraint_reference
              (call $proof_array_get
                (local.get $source_base)
                (local.get $constraint_array_reference)
                (local.get $constraint_index)))
            (local.set $left_variable
              (call $proof_load
                (local.get $source_base)
                (i32.add
                  (local.get $constraint_reference)
                  (i32.const 8))))
            (local.set $left_offset
              (call $proof_load
                (local.get $source_base)
                (i32.add
                  (local.get $constraint_reference)
                  (i32.const 12))))
            (local.set $relation
              (call $proof_load
                (local.get $source_base)
                (i32.add
                  (local.get $constraint_reference)
                  (i32.const 16))))
            (local.set $right_variable
              (call $proof_load
                (local.get $source_base)
                (i32.add
                  (local.get $constraint_reference)
                  (i32.const 20))))
            (local.set $right_offset
              (call $proof_load
                (local.get $source_base)
                (i32.add
                  (local.get $constraint_reference)
                  (i32.const 24))))
            (local.set $left_level
              (if (result i32)
                (local.get $left_variable)
                (then
                  (i32.load
                    (call $abs
                      (i32.add
                        (i32.add
                          (local.get $solution_buffer)
                          (i32.const 4))
                        (i32.mul
                          (i32.sub
                            (local.get $left_variable)
                            (i32.const 1))
                          (i32.const 4))))))
                (else (i32.const 0))))
            (local.set $right_level
              (if (result i32)
                (local.get $right_variable)
                (then
                  (i32.load
                    (call $abs
                      (i32.add
                        (i32.add
                          (local.get $solution_buffer)
                          (i32.const 4))
                        (i32.mul
                          (i32.sub
                            (local.get $right_variable)
                            (i32.const 1))
                          (i32.const 4))))))
                (else (i32.const 0))))
            (local.set $candidate_level
              (i32.sub
                (i32.add
                  (i32.add
                    (local.get $left_level)
                    (local.get $left_offset))
                  (i32.eq
                    (local.get $relation)
                    (i32.const 1)))
                (local.get $right_offset)))
            (if (i32.gt_s
                  (local.get $candidate_level)
                  (local.get $right_level))
              (then
                (if (i32.eqz (local.get $right_variable))
                  (then (unreachable)))
                (i32.store
                  (call $abs
                    (i32.add
                      (i32.add
                        (local.get $solution_buffer)
                        (i32.const 4))
                      (i32.mul
                        (i32.sub
                          (local.get $right_variable)
                          (i32.const 1))
                        (i32.const 4))))
                  (local.get $candidate_level))
                (local.set $right_level
                  (local.get $candidate_level))
                (local.set $changed (i32.const 1))))
            (if (i32.eq
                  (local.get $relation)
                  (i32.const 2))
              (then
                (local.set $candidate_level
                  (i32.sub
                    (i32.add
                      (local.get $right_level)
                      (local.get $right_offset))
                    (local.get $left_offset)))
                (if (i32.gt_s
                      (local.get $candidate_level)
                      (local.get $left_level))
                  (then
                    (if (i32.eqz (local.get $left_variable))
                      (then (unreachable)))
                    (i32.store
                      (call $abs
                        (i32.add
                          (i32.add
                            (local.get $solution_buffer)
                            (i32.const 4))
                          (i32.mul
                            (i32.sub
                              (local.get $left_variable)
                              (i32.const 1))
                            (i32.const 4))))
                      (local.get $candidate_level))
                    (local.set $changed (i32.const 1))))))
            (local.set $constraint_index
              (i32.add
                (local.get $constraint_index)
                (i32.const 1)))
            (br $solution_constraint_next)))
        (local.set $iteration
          (i32.add
            (local.get $iteration)
            (i32.const 1)))
        (br_if $solution_next (local.get $changed))))
  )

  ;; Build GLOBAL/INDUCTIVE/CONSTRUCTOR instances with exact DAG byte sizes.
  ;; environment_slot=0 denotes an open inductive reference; explicit slots
  ;; remain rooted while the optional default-solution buffer is allocated.
  ;; Returns -1 invalid, -2 memory pressure, otherwise an owned term handle.
  (func $proof_native_build_universe_reference
    (param $environment_slot i32) (param $first_level_slot i32)
    (param $explicit_count i32) (param $universe_count i32)
    (param $tag i32) (param $declaration_index i32) (param $constructor_index i32)
    (result i32)
    (local $env i32) (local $source i32) (local $declarations i32) (local $decl_count i32)
    (local $records_length i32) (local $level_bytes i32) (local $index i32)
    (local $slot i32) (local $length i32) (local $level i32) (local $number i32)
    (local $solution i32) (local $pending i32) (local $size i32) (local $handle i32)
    (local $base i32) (local $cursor i32) (local $args i32) (local $root i32)
    (local $root_size i32) (local $owner i32)
    (local.set $pending (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (block $invalid
      (if (local.get $environment_slot)
        (then
          (local.set $env (call $value_data_lo (local.get $environment_slot)))
          (br_if $invalid (i32.eqz (call $proof_native_scope_valid (local.get $env))))
          (local.set $source (call $proof_native_handle_artifact_base (local.get $env)))
          (local.set $declarations (call $proof_load (local.get $source) (i32.const 12)))
          (local.set $decl_count (call $proof_array_count (local.get $source) (local.get $declarations)))
          (local.set $records_length (call $proof_native_term_records_length (local.get $env)))))
      (if (i32.and (i32.eqz (local.get $explicit_count)) (i32.ne (local.get $universe_count) (i32.const 0)))
        (then
          (br_if $invalid (i32.eqz (local.get $env)))
          (if (call $check_heap_overflow (call $estimate_arraybuffer_size (i32.mul (local.get $universe_count) (i32.const 4))))
            (then (return (i32.const -2))))
          (local.set $solution (call $allocate_arraybuffer (i32.mul (local.get $universe_count) (i32.const 4))))
          (memory.fill (call $abs (i32.add (local.get $solution) (i32.const 4))) (i32.const 0)
            (i32.mul (local.get $universe_count) (i32.const 4)))
          (call $pending_push (global.get $TYPE_ARRAYBUFFER) (i32.const 0) (local.get $solution) (i32.const 0))
          (local.set $env (call $value_data_lo (local.get $environment_slot)))
          (local.set $source (call $proof_native_handle_artifact_base (local.get $env)))
          (call $proof_native_solve_default_universe_instance (local.get $source)
            (local.get $declaration_index) (local.get $universe_count) (local.get $solution))))
      (block $sizes_done (loop $size_next
        (br_if $sizes_done (i32.ge_u (local.get $index) (local.get $universe_count)))
        (if (local.get $explicit_count)
          (then
            (local.set $slot (i32.add (local.get $first_level_slot) (i32.mul (local.get $index) (global.get $VALUE_SIZE))))
            (local.set $length (call $proof_native_level_argument_length (local.get $slot)))
            (br_if $invalid (i32.lt_s (local.get $length) (i32.const 0))))
          (else
            (local.set $number (i32.load (call $abs (i32.add (i32.add (local.get $solution) (i32.const 4))
              (i32.mul (local.get $index) (i32.const 4))))))
            (br_if $invalid (i32.gt_u (local.get $number) (i32.const 67108860)))
            (local.set $length (i32.add (i32.const 12) (i32.mul (local.get $number) (i32.const 16))))))
        (br_if $invalid (i32.gt_u (local.get $length) (i32.sub (i32.const 1073741824) (local.get $level_bytes))))
        (local.set $level_bytes (i32.add (local.get $level_bytes) (local.get $length)))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $size_next)))
      (local.set $root_size (select (i32.const 20) (i32.const 16) (i32.eq (local.get $tag) (global.get $PROOF_TERM_CONSTRUCTOR))))
      (local.set $size (i32.add (i32.const 40) (i32.add (local.get $root_size)
        (i32.add (local.get $records_length) (i32.add (local.get $level_bytes)
          (i32.mul (i32.add (local.get $universe_count) (local.get $decl_count)) (i32.const 4)))))))
      (br_if $invalid (i32.gt_u (local.get $size) (i32.const 1073741824)))
      (if (call $check_heap_overflow (i32.add (call $estimate_arraybuffer_size (local.get $size)) (i32.const 24)))
        (then
          (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $pending))
          (return (i32.const -2))))
      (if (local.get $solution) (then (local.set $solution (call $value_data_lo (local.get $pending)))))
      (local.set $args (i32.add (i32.const 16) (i32.add (local.get $records_length) (local.get $level_bytes))))
      (local.set $root (i32.add (local.get $args) (i32.add (i32.const 12) (i32.mul (local.get $universe_count) (i32.const 4)))))
      (local.set $handle (call $proof_native_allocate_term_handle (local.get $size) (local.get $root) (i32.const 0)))
      (local.set $base (call $proof_native_handle_artifact_base (local.get $handle)))
      (if (local.get $environment_slot)
        (then
          (local.set $env (call $value_data_lo (local.get $environment_slot)))
          (local.set $source (call $proof_native_handle_artifact_base (local.get $env)))
          (local.set $declarations (call $proof_load (local.get $source) (i32.const 12)))
          (local.set $owner (i32.load (call $abs (i32.add (local.get $env) (i32.const 20)))))
          (drop (call $proof_native_copy_term_records (local.get $env) (local.get $base) (i32.add (local.get $base) (i32.const 16))))))
      (local.set $cursor (i32.add (i32.const 16) (local.get $records_length)))
      (local.set $index (i32.const 0))
      (block $levels_done (loop $level_next
        (br_if $levels_done (i32.ge_u (local.get $index) (local.get $universe_count)))
        (if (local.get $explicit_count)
          (then
            (local.set $slot (i32.add (local.get $first_level_slot) (i32.mul (local.get $index) (global.get $VALUE_SIZE))))
            (local.set $length (call $proof_native_level_argument_length (local.get $slot)))
            (local.set $level (call $proof_native_write_level_argument (local.get $base) (local.get $cursor) (local.get $slot)))
            (if (i32.eqz (local.get $owner)) (then (local.set $owner (call $proof_native_level_argument_owner (local.get $slot))))))
          (else
            (local.set $number (i32.load (call $abs (i32.add (i32.add (local.get $solution) (i32.const 4))
              (i32.mul (local.get $index) (i32.const 4))))))
            (local.set $length (i32.add (i32.const 12) (i32.mul (local.get $number) (i32.const 16))))
            (local.set $level (call $proof_native_write_numeric_level (local.get $base) (local.get $cursor) (local.get $number)))))
        (call $proof_array_set (local.get $base) (local.get $args) (local.get $index) (local.get $level))
        (local.set $cursor (i32.add (local.get $cursor) (local.get $length)))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $level_next)))
      (call $proof_store (local.get $base) (local.get $args) (i32.add (local.get $universe_count) (i32.const 3)))
      (call $proof_store (local.get $base) (i32.add (local.get $args) (i32.const 4)) (global.get $PROOF_RECORD_ARRAY))
      (call $proof_store (local.get $base) (i32.add (local.get $args) (i32.const 8)) (local.get $universe_count))
      (call $proof_store (local.get $base) (local.get $root) (i32.div_u (local.get $root_size) (i32.const 4)))
      (call $proof_store (local.get $base) (i32.add (local.get $root) (i32.const 4)) (local.get $tag))
      (call $proof_store (local.get $base) (i32.add (local.get $root) (i32.const 8)) (local.get $declaration_index))
      (if (i32.eq (local.get $tag) (global.get $PROOF_TERM_CONSTRUCTOR))
        (then
          (call $proof_store (local.get $base) (i32.add (local.get $root) (i32.const 12)) (local.get $constructor_index))
          (call $proof_store (local.get $base) (i32.add (local.get $root) (i32.const 16)) (local.get $args)))
        (else (call $proof_store (local.get $base) (i32.add (local.get $root) (i32.const 12)) (local.get $args))))
      (local.set $cursor (i32.add (local.get $root) (local.get $root_size)))
      (call $proof_store (local.get $base) (local.get $cursor) (i32.add (local.get $decl_count) (i32.const 3)))
      (call $proof_store (local.get $base) (i32.add (local.get $cursor) (i32.const 4)) (global.get $PROOF_RECORD_ARRAY))
      (call $proof_store (local.get $base) (i32.add (local.get $cursor) (i32.const 8)) (local.get $decl_count))
      (local.set $index (i32.const 0))
      (block $declarations_done (loop $declaration_next
        (br_if $declarations_done (i32.ge_u (local.get $index) (local.get $decl_count)))
        (call $proof_array_set (local.get $base) (local.get $cursor) (local.get $index)
          (call $proof_array_get (local.get $source) (local.get $declarations) (local.get $index)))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $declaration_next)))
      (call $proof_native_initialize_artifact_header (local.get $base) (local.get $size) (local.get $cursor))
      (i32.store (call $abs (i32.add (local.get $handle) (i32.const 20))) (local.get $owner))
      (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $pending))
      (return (local.get $handle)))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $pending))
    (i32.const -1))

  (func $proof_native_term_global
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_identifier i32) (param $argument_count i32)
    (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $environment_argument i32)
    (local $index_argument i32)
    (local $environment_handle i32)
    (local $declaration_index i32)
    (local $source_base i32)
    (local $source_declarations i32)
    (local $declaration_count i32)
    (local $handle i32)
    (local $declaration_reference i32)
    (local $universe_context_reference i32)
    (local $universe_count i32)
    (local $explicit_universe_count i32)
    (local.set $pending_pointer
      (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.lt_u (local.get $argument_count) (i32.const 2))
      (then
        (call $write_ctx
          (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
        (return
          (i32.add
            (i32.const 1)
            (call $throw_type_error_with_message
              (global.get $BUILTIN_MSG_MISSING_ARGUMENT))))))
    (local.set $environment_argument
      (i32.sub
        (local.get $pending_pointer)
        (i32.mul
          (local.get $argument_count)
          (global.get $VALUE_SIZE))))
    (local.set $index_argument
      (i32.add
        (local.get $environment_argument)
        (global.get $VALUE_SIZE)))
    (if (i32.ne
          (call $value_type (local.get $environment_argument))
          (global.get $TYPE_THEOREM))
      (then
        (call $write_ctx
          (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
        (return
          (i32.add
            (i32.const 1)
            (call $throw_type_error_with_message
              (global.get $BUILTIN_MSG_NOT_AN_OBJECT))))))
    (local.set $environment_handle
      (call $value_data_lo (local.get $environment_argument)))
    (if (i32.eqz
          (i32.or
            (call $proof_native_theorem_handle_valid
              (local.get $environment_handle))
            (call $proof_native_environment_handle_valid
              (local.get $environment_handle))))
      (then
        (call $write_ctx
          (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
        (return
          (i32.add
            (i32.const 1)
            (call $throw_type_error_with_message
              (global.get $BUILTIN_MSG_NOT_AN_OBJECT))))))
    (local.set $declaration_index
      (call $proof_native_nonnegative_integer_argument
        (local.get $index_argument)))
    (local.set $source_base
      (call $proof_native_handle_artifact_base
        (local.get $environment_handle)))
    (local.set $source_declarations
      (call $proof_load (local.get $source_base) (i32.const 12)))
    (local.set $declaration_count
