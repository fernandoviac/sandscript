  (func $proof_check_guarded_recursive_calls
    (param $artifact_base i32)
    (param $term_reference i32)
    (param $definitions i32)
    (param $guarded i32)
    (result i32)
    (local $tag i32)
    (local $head i32)
    (local $head_tag i32)
    (local $argument_count i32)
    (local $argument_index i32)
    (local $constructor_guarded i32)
    (local $declaration i32)
    (local $array_reference i32)
    (local $count i32)
    (local $index i32)
    (local $record i32)
    (local.set $tag
      (call $proof_load (local.get $artifact_base)
        (i32.add (local.get $term_reference) (i32.const 4))))
    (if (i32.or (i32.eq (local.get $tag) (global.get $PROOF_TERM_NAT_LITERAL))
      (i32.eq (local.get $tag) (global.get $PROOF_TERM_STRING_LITERAL)))
      (then (return (i32.const 1))))
    ;; Projection is a destructor; it never establishes a corecursion guard.
    (if (i32.eq (local.get $tag) (global.get $PROOF_TERM_PROJECTION))
      (then (return (call $proof_check_guarded_recursive_calls (local.get $artifact_base)
        (call $proof_load (local.get $artifact_base) (i32.add (local.get $term_reference) (i32.const 16)))
        (local.get $definitions) (i32.const 0)))))
    (if (i32.eq (local.get $tag) (global.get $PROOF_TERM_RECURSIVE_REFERENCE))
      (then (return (local.get $guarded))))
    (if (i32.eq (local.get $tag) (global.get $PROOF_TERM_APPLICATION))
      (then
        (local.set $head
          (call $proof_application_head
            (local.get $artifact_base) (local.get $term_reference)))
        (local.set $head_tag
          (call $proof_load (local.get $artifact_base)
            (i32.add (local.get $head) (i32.const 4))))
        (local.set $argument_count
          (call $proof_application_count
            (local.get $artifact_base) (local.get $term_reference)))
        (if (i32.eq (local.get $head_tag) (global.get $PROOF_TERM_RECURSIVE_REFERENCE))
          (then
            (if (i32.eqz (local.get $guarded)) (then (return (i32.const 0))))
            (local.set $argument_index (i32.const 0))
            (block $recursive_arguments_done
              (loop $recursive_arguments_next
                (br_if $recursive_arguments_done
                  (i32.ge_u (local.get $argument_index) (local.get $argument_count)))
                (if (i32.eqz
                      (call $proof_check_guarded_recursive_calls
                        (local.get $artifact_base)
                        (call $proof_application_argument
                          (local.get $artifact_base) (local.get $term_reference)
                          (local.get $argument_index))
                        (local.get $definitions) (local.get $guarded)))
                  (then (return (i32.const 0))))
                (local.set $argument_index
                  (i32.add (local.get $argument_index) (i32.const 1)))
                (br $recursive_arguments_next)))
            (return (i32.const 1))))
        (if (i32.eqz (call $proof_check_guarded_recursive_calls (local.get $artifact_base)
          (local.get $head) (local.get $definitions) (local.get $guarded)))
          (then (return (i32.const 0))))
        (local.set $constructor_guarded (local.get $guarded))
        (if (i32.eq (local.get $head_tag) (global.get $PROOF_TERM_CONSTRUCTOR))
          (then
            (local.set $declaration
              (call $proof_declaration_reference
                (local.get $artifact_base)
                (call $proof_load (local.get $artifact_base)
                  (i32.add (local.get $head) (i32.const 8)))))
            (if (i32.eq
                  (call $proof_load (local.get $artifact_base)
                    (i32.add (local.get $declaration) (i32.const 4)))
                  (global.get $PROOF_RECORD_COINDUCTIVE_DECLARATION))
              (then (local.set $constructor_guarded (i32.const 1))))))
        (local.set $argument_index (i32.const 0))
        (block $arguments_done
          (loop $arguments_next
            (br_if $arguments_done
              (i32.ge_u (local.get $argument_index) (local.get $argument_count)))
            (if (i32.eqz
                  (call $proof_check_guarded_recursive_calls
                    (local.get $artifact_base)
                    (call $proof_application_argument
                      (local.get $artifact_base) (local.get $term_reference)
                      (local.get $argument_index))
                    (local.get $definitions) (local.get $constructor_guarded)))
              (then (return (i32.const 0))))
            (local.set $argument_index
              (i32.add (local.get $argument_index) (i32.const 1)))
            (br $arguments_next)))
        (return (i32.const 1))))
    (if (i32.or
          (i32.eq (local.get $tag) (global.get $PROOF_TERM_PRODUCT))
          (i32.or
            (i32.eq (local.get $tag) (global.get $PROOF_TERM_LAMBDA))
            (i32.eq (local.get $tag) (global.get $PROOF_TERM_APPLICATION))))
      (then
        (return
          (i32.and
            (call $proof_check_guarded_recursive_calls
              (local.get $artifact_base)
              (call $proof_load (local.get $artifact_base)
                (i32.add (local.get $term_reference) (i32.const 8)))
              (local.get $definitions) (local.get $guarded))
            (call $proof_check_guarded_recursive_calls
              (local.get $artifact_base)
              (call $proof_load (local.get $artifact_base)
                (i32.add (local.get $term_reference) (i32.const 12)))
              (local.get $definitions) (local.get $guarded))))))
    (if (i32.eq (local.get $tag) (global.get $PROOF_TERM_LOCAL_DEFINITION))
      (then
        (return
          (i32.and
            (call $proof_check_guarded_recursive_calls
              (local.get $artifact_base)
              (call $proof_load (local.get $artifact_base)
                (i32.add (local.get $term_reference) (i32.const 8)))
              (local.get $definitions) (local.get $guarded))
            (i32.and
              (call $proof_check_guarded_recursive_calls
                (local.get $artifact_base)
                (call $proof_load (local.get $artifact_base)
                  (i32.add (local.get $term_reference) (i32.const 12)))
                (local.get $definitions) (local.get $guarded))
              (call $proof_check_guarded_recursive_calls
                (local.get $artifact_base)
                (call $proof_load (local.get $artifact_base)
                  (i32.add (local.get $term_reference) (i32.const 16)))
                (local.get $definitions) (local.get $guarded)))))))
    (if (i32.eq (local.get $tag) (global.get $PROOF_TERM_MATCH))
      (then
        (if (i32.or
              (i32.eqz
                (call $proof_check_guarded_recursive_calls
                  (local.get $artifact_base)
                  (call $proof_load (local.get $artifact_base)
                    (i32.add (local.get $term_reference) (i32.const 8)))
                  (local.get $definitions) (i32.const 0)))
              (i32.eqz
                (call $proof_check_guarded_recursive_calls
                  (local.get $artifact_base)
                  (call $proof_load (local.get $artifact_base)
                    (i32.add (local.get $term_reference) (i32.const 12)))
                  (local.get $definitions) (i32.const 0))))
          (then (return (i32.const 0))))
        (local.set $array_reference
          (call $proof_load (local.get $artifact_base)
            (i32.add (local.get $term_reference) (i32.const 16))))
        (local.set $count
          (call $proof_array_count (local.get $artifact_base) (local.get $array_reference)))
        (local.set $index (i32.const 0))
        (block $branches_done
          (loop $branches_next
            (br_if $branches_done (i32.ge_u (local.get $index) (local.get $count)))
            (local.set $record
              (call $proof_array_get
                (local.get $artifact_base) (local.get $array_reference) (local.get $index)))
            (if (i32.eqz
                  (call $proof_check_guarded_recursive_calls
                    (local.get $artifact_base)
                    (call $proof_load (local.get $artifact_base)
                      (i32.add (local.get $record) (i32.const 12)))
                    (local.get $definitions) (i32.const 0)))
              (then (return (i32.const 0))))
            (local.set $index (i32.add (local.get $index) (i32.const 1)))
            (br $branches_next)))
        (return (i32.const 1))))
    (i32.const 1)
  )

  (func $proof_check_guarded_corecursion
    (param $artifact_base i32)
    (param $term_reference i32)
    (result i32)
    (local $definitions i32)
    (local $definition_count i32)
    (local $definition_index i32)
    (local $definition i32)
