    (if (i32.ge_u (local.get $index) (call $proof_array_count (local.get $artifact_base) (local.get $arguments_array)))
      (then (global.set $proof_last_error_code (i32.const 23)) (return (i32.const 0))))
    (return (call $proof_array_get (local.get $artifact_base) (local.get $arguments_array) (local.get $index)))))
  (i32.const -1))

(func $proof_substitute_universe_memo_leaf
  (param $artifact_base i32) (param $universe_reference i32)
  (param $arguments_array i32) (param $work i32) (param $memo i32) (result i32)
