    (if (i32.lt_s (local.get $handle) (i32.const 0))
      (then (return (i32.const -1))))
    (local.set $artifact_base
      (call $proof_native_handle_artifact_base (local.get $handle)))
    (local.set $root_reference
      (call $proof_native_handle_root (local.get $handle)))
    (global.set $proof_last_error_code (i32.const 0))
    (global.set $proof_last_error_offset (i32.const 0))
    (global.set $proof_last_inferred_type (i32.const 0))
    (global.set $proof_last_expected_type (i32.const 0))
    (local.set $empty_context
      (call $proof_make_array
        (local.get $artifact_base)
        (i32.const 0)))
    (if (i32.eqz
          (call $proof_check_term
            (local.get $artifact_base)
            (call $proof_load
              (local.get $artifact_base)
              (i32.add (local.get $root_reference) (i32.const 8)))
            (call $proof_load
              (local.get $artifact_base)
              (i32.add (local.get $root_reference) (i32.const 12)))
            (local.get $empty_context)
            (i32.const 0)
            (i32.const 0) (call $proof_native_operation_work (local.get $artifact_base))))
      (then (return (i32.const -2))))
    (local.get $handle)
  )

  (func $proof_native_elaborate_term_handles (param $term_handle i32) (param $expected_type_handle i32) (result i32)
    (local $handle i32) (local $base i32) (local $length i32)
    (local.set $handle (call $proof_native_prepare_elaborated_term_handles (local.get $term_handle) (local.get $expected_type_handle)))
    (if (i32.le_s (local.get $handle) (i32.const 0)) (then (return (local.get $handle))))
    (local.set $base (call $proof_native_handle_artifact_base (local.get $handle)))
    (local.set $length (call $proof_native_handle_artifact_length (local.get $handle)))
    (if (call $proof_check_artifact (local.get $base) (local.get $length)
      (i32.sub (i32.load (call $abs (call $proof_native_handle_buffer (local.get $handle)))) (local.get $length)))
      (then (return (i32.const -2))))
    (local.get $handle))
  (func $proof_native_prepare_elaborated_term_handles
    (param $term_handle i32)
    (param $expected_type_handle i32)
    (result i32)
    (local $handle i32)
    (local $artifact_base i32)
    (local $root_reference i32)
    (local $empty_context i32)
    (local $core_root i32)
    (local $result_handle i32)
    (local.set $handle
      (call $proof_native_compose_binary_term
        (global.get $PROOF_TERM_APPLICATION)
        (i32.const 0)
        (i32.const 0)
        (local.get $term_handle)
        (local.get $expected_type_handle)
        (i32.const 16)))
    (if (i32.lt_s (local.get $handle) (i32.const 0))
      (then (return (i32.const -1))))
    (local.set $artifact_base
      (call $proof_native_handle_artifact_base (local.get $handle)))
    (local.set $root_reference
      (call $proof_native_handle_root (local.get $handle)))
    (global.set $proof_last_error_code (i32.const 0))
    (global.set $proof_last_error_offset (i32.const 0))
    (global.set $proof_last_inferred_type (i32.const 0))
    (global.set $proof_last_expected_type (i32.const 0))
    (local.set $empty_context
      (call $proof_make_array
        (local.get $artifact_base)
        (i32.const 0)))
    (local.set $core_root
      (call $proof_native_elaborate_checked_term
        (local.get $artifact_base)
        (call $proof_load
          (local.get $artifact_base)
          (i32.add (local.get $root_reference) (i32.const 8)))
        (call $proof_load
          (local.get $artifact_base)
          (i32.add (local.get $root_reference) (i32.const 12)))
        (local.get $empty_context)
        (i32.const 0)
        (i32.const 0) (call $proof_native_operation_work (local.get $artifact_base))))
    (if (i32.eqz (local.get $core_root))
      (then (return (i32.const -2))))
    ;; Preparation emits a canonical candidate; the caller must check every declaration.
    ;; Environments with
    ;; match-bodied definitions need the generous checking arena.
    (local.set $result_handle
      (call $proof_native_prepare_core_term
        (local.get $handle)
        (local.get $core_root)
        (global.get $proof_scratch_cursor)
        (i32.const -1)))
    (if (i32.lt_s (local.get $result_handle) (i32.const 0))
      (then (return (local.get $result_handle))))
    (local.get $result_handle)
  )

  

  

  (func $proof_native_array_value_address
    (param $array_pointer i32)
    (param $index i32)
    (result i32)
    (i32.add
      (i32.add
        (i32.load
          (call $abs
            (i32.add (local.get $array_pointer) (i32.const 16))))
        (global.get $GC_HEADER_SIZE))
      (i32.mul
        (local.get $index)
        (global.get $VALUE_SIZE)))
  )

  (func $proof_native_elaboration_fail
    (param $stack_base i32)
    (param $error_code i32)
    (result i32)
    (if (local.get $error_code)
      (then
        (global.set $proof_last_error_code
          (local.get $error_code))))
    (call $write_ctx
      (global.get $CTX_PENDING_POINTER)
      (local.get $stack_base))
    (i32.add
      (i32.const 1)
      (call $throw_type_error_with_message
        (global.get $BUILTIN_MSG_INVALID_INDEX)))
  )

  ;; Elaborate a product application from explicit signature metadata.
  ;; Parameter names and implicit flags define source-level argument routing;
  ;; the returned artifact contains only kernel terms and every inserted
  ;; metavariable must be solved before sealing.
  

  ;; Resolve a class goal from checked candidates inside one mutable artifact.
  ;; Candidate binders are ordered as inferred parameters followed by instance
  ;; dependencies. Every candidate attempt is transactional: the complete
  ;; artifact prefix is copied into a high-end workspace snapshot and restored
  ;; before the next candidate, so failed unification cannot leak constraints.
  ;; Unification makes solved evidence records unreachable after rewriting
  ;; their parent fields. The scratch arena remains a complete record log, so
  ;; elaboration can recover a solution by identifier without retaining a
  ;; second mutable substitution representation.
  (func $proof_native_find_solved_metavariable
    (param $artifact_base i32)
    (param $start_offset i32)
    (param $end_offset i32)
    (param $identifier i32)
    (result i32)
    (local $offset i32)
    (local $word_count i32)
    (local.set $offset (local.get $start_offset))
    (block $done
      (loop $next
        (br_if $done
          (i32.ge_u (local.get $offset) (local.get $end_offset)))
        (local.set $word_count
          (call $proof_load
            (local.get $artifact_base)
            (local.get $offset)))
        (if (i32.or
              (i32.lt_u (local.get $word_count) (i32.const 2))
              (i32.gt_u
                (i32.add
                  (local.get $offset)
                  (i32.mul
                    (local.get $word_count)
                    (i32.const 4)))
                (local.get $end_offset)))
          (then (return (i32.const 0))))
        (if (i32.and
              (i32.eq
                (call $proof_load
                  (local.get $artifact_base)
                  (i32.add
                    (local.get $offset)
                    (i32.const 4)))
                (global.get $PROOF_RECORD_SOLVED_METAVARIABLE))
              (i32.eq
                (call $proof_load
                  (local.get $artifact_base)
                  (i32.add
                    (local.get $offset)
                    (i32.const 8)))
                (local.get $identifier)))
          (then
            (return
              (call $proof_load
                (local.get $artifact_base)
                (i32.add
                  (local.get $offset)
                  (i32.const 16))))))
        (local.set $offset
          (i32.add
            (local.get $offset)
            (i32.mul
              (local.get $word_count)
              (i32.const 4))))
        (br $next)))
    (i32.const 0)
  )

  (func $proof_native_resolve_instance_in_artifact
    (param $artifact_base i32)
    (param $goal_reference i32)
    (param $candidates_reference i32)
    (param $inferred_counts_pointer i32)
    (param $instance_counts_pointer i32)
    (param $priorities_pointer i32)
    (param $depth_remaining i32)
    (param $root_reference i32)
    (param $frames_reference i32)
    (param $frame_index i32) (param $work i32)
    (result i32)
    (local $candidate_count i32)
    (local $candidate_index i32)
    (local $scan_index i32)
    (local $best_index i32)
    (local $best_priority i32)
    (local $priority i32)
    (local $slot i32)
    (local $tried_reference i32)
    (local $frame_reference i32)
    (local $prior_frame_reference i32)
    (local $candidate_reference i32)
    (local $candidate_type i32)
    (local $normalized_type i32)
    (local $domain_reference i32)
    (local $codomain_reference i32)
    (local $current_application i32)
    (local $current_type i32)
    (local $inferred_count i32)
    (local $instance_count i32)
    (local $parameter_count i32)
    (local $parameter_index i32)
    (local $instance_index i32)
    (local $metavariable_reference i32)
    (local $first_metavariable_identifier i32)
    (local $metavariables_reference i32)
    (local $domains_reference i32)
    (local $empty_scope i32)
    (local $empty_context i32)
    (local $resolved_dependency i32)
    (local $snapshot_length i32)
    (local $backup_length i32)
    (local $backup_start i32)
    (local $prior_scratch_limit i32)
    (local $candidate_succeeded i32)
    (local $candidate_scratch_start i32)
    (local $solution_reference i32)
    (local $selected_index i32)
    (local $selected_priority i32)
    (local $rerunning_selected i32)

    ;; Re-entering an equivalent goal would repeat the same candidate table.
    (local.set $scan_index (i32.const 0))
    (block $loop_check_done
      (loop $loop_check_next
        (br_if $loop_check_done
          (i32.ge_u (local.get $scan_index) (local.get $frame_index)))
        (local.set $prior_frame_reference
          (call $proof_array_get
            (local.get $artifact_base)
            (local.get $frames_reference)
            (local.get $scan_index)))
        (if (call $proof_convertible
              (local.get $artifact_base)
              (local.get $goal_reference)
              (call $proof_array_get
                (local.get $artifact_base)
                (local.get $prior_frame_reference)
                (i32.const 0))
              (local.get $empty_context) (i32.const 0) (i32.const 0) (local.get $work))
          (then
            (global.set $proof_instance_loop_reached (i32.const 1))
            (return (i32.const 0))))
        (local.set $scan_index
          (i32.add (local.get $scan_index) (i32.const 1)))
        (br $loop_check_next)))

    (local.set $candidate_count
      (call $proof_array_count
        (local.get $artifact_base)
        (local.get $candidates_reference)))
    (local.set $tried_reference
      (call $proof_make_array
        (local.get $artifact_base)
        (local.get $candidate_count)))
    (local.set $frame_reference
      (call $proof_make_array
        (local.get $artifact_base)
        (i32.const 6)))
    (if (i32.or
          (i32.eqz (local.get $tried_reference))
          (i32.eqz (local.get $frame_reference)))
      (then (return (i32.const 0))))
    (call $proof_array_set
      (local.get $artifact_base)
      (local.get $frame_reference)
      (i32.const 0)
      (local.get $goal_reference))
    (call $proof_array_set
      (local.get $artifact_base)
      (local.get $frame_reference)
      (i32.const 1)
      (local.get $tried_reference))
    (call $proof_array_set
      (local.get $artifact_base)
      (local.get $frames_reference)
      (local.get $frame_index)
      (local.get $frame_reference))

    (local.set $candidate_index (i32.const 0))
    (local.set $selected_index (i32.const -1))
    (local.set $selected_priority (i32.const -1))
    (local.set $rerunning_selected (i32.const 0))
    (block $search_done
      (loop $candidate_next
        (if (i32.ge_u
              (local.get $candidate_index)
              (local.get $candidate_count))
          (then
            (if (i32.and
                  (i32.ge_s (local.get $selected_index) (i32.const 0))
                  (i32.eqz (local.get $rerunning_selected)))
              (then
                (local.set $scan_index (i32.const 0))
                (block $prepare_rerun_done
                  (loop $prepare_rerun_next
                    (br_if $prepare_rerun_done
                      (i32.ge_u
                        (local.get $scan_index)
                        (local.get $candidate_count)))
                    (call $proof_array_set
                      (local.get $artifact_base)
                      (local.get $tried_reference)
                      (local.get $scan_index)
                      (i32.ne
                        (local.get $scan_index)
                        (local.get $selected_index)))
                    (local.set $scan_index
                      (i32.add (local.get $scan_index) (i32.const 1)))
                    (br $prepare_rerun_next)))
                (local.set $candidate_index (i32.const 0))
                (local.set $rerunning_selected (i32.const 1))
                (global.set $proof_instance_candidates_remaining
                  (i32.add
                    (global.get $proof_instance_candidates_remaining)
                    (i32.const 1))))
              (else (br $search_done)))))
        (if (i32.eqz (global.get $proof_instance_candidates_remaining))
          (then
            (global.set $proof_instance_bound_reached (i32.const 1))
            (return (i32.const 0))))

        ;; Select the untried candidate with greatest priority. Source order
        ;; breaks ties, making resolution stable across rebuilds.
        (local.set $best_index (i32.const -1))
        (local.set $best_priority (i32.const -1))
        (local.set $scan_index (i32.const 0))
        (block $priority_scan_done
          (loop $priority_scan_next
            (br_if $priority_scan_done
              (i32.ge_u
                (local.get $scan_index)
                (local.get $candidate_count)))
            (if (i32.eqz
                  (call $proof_array_get
                    (local.get $artifact_base)
                    (local.get $tried_reference)
                    (local.get $scan_index)))
              (then
                (local.set $slot
                  (call $proof_native_array_value_address
                    (local.get $priorities_pointer)
                    (local.get $scan_index)))
                (local.set $priority
                  (call $proof_native_nonnegative_integer_argument
                    (local.get $slot)))
                (if (i32.gt_s
                      (local.get $priority)
                      (local.get $best_priority))
                  (then
                    (local.set $best_priority (local.get $priority))
                    (local.set $best_index (local.get $scan_index))))))
            (local.set $scan_index
              (i32.add (local.get $scan_index) (i32.const 1)))
            (br $priority_scan_next)))
        (if (i32.lt_s (local.get $best_index) (i32.const 0))
          (then (br $search_done)))
        (if (i32.and
              (i32.and
                (i32.ge_s (local.get $selected_index) (i32.const 0))
                (i32.eqz (local.get $rerunning_selected)))
              (i32.lt_s
                (local.get $best_priority)
                (local.get $selected_priority)))
          (then
            (local.set $candidate_index (local.get $candidate_count))
            (br $candidate_next)))
        (call $proof_array_set
          (local.get $artifact_base)
          (local.get $tried_reference)
          (local.get $best_index)
          (i32.const 1))
        (local.set $candidate_index
          (i32.add (local.get $candidate_index) (i32.const 1)))
        (global.set $proof_instance_candidates_remaining
          (i32.sub
            (global.get $proof_instance_candidates_remaining)
            (i32.const 1)))
        (global.set $proof_instance_candidates_explored
          (i32.add
            (global.get $proof_instance_candidates_explored)
            (i32.const 1)))

        ;; Reserve a non-overlapping high-end snapshot and constrain all
        ;; scratch allocation for this attempt below it.
        (local.set $snapshot_length
          (global.get $proof_scratch_cursor))
        (local.set $backup_length
          (i32.and
            (i32.add (local.get $snapshot_length) (i32.const 7))
            (i32.const -8)))
        (local.set $prior_scratch_limit
          (global.get $proof_scratch_limit))
        (local.set $backup_start
          (i32.sub
            (local.get $prior_scratch_limit)
            (local.get $backup_length)))
        (if (i32.lt_u
              (local.get $backup_start)
              (local.get $snapshot_length))
          (then
            (global.set $proof_instance_bound_reached (i32.const 1))
            (return (i32.const 0))))
        (memory.copy
          (call $abs
            (i32.add
              (local.get $artifact_base)
              (local.get $backup_start)))
          (call $abs (local.get $artifact_base))
          (local.get $snapshot_length))
        (global.set $proof_scratch_limit (local.get $backup_start))
        (local.set $candidate_succeeded (i32.const 0))

        (block $candidate_failed
          (global.set $proof_last_error_code (i32.const 0))
          (local.set $candidate_scratch_start
            (local.get $snapshot_length))
          (local.set $candidate_reference
            (call $proof_array_get
              (local.get $artifact_base)
              (local.get $candidates_reference)
              (local.get $best_index)))
          (local.set $slot
            (call $proof_native_array_value_address
              (local.get $inferred_counts_pointer)
              (local.get $best_index)))
          (local.set $inferred_count
            (call $proof_native_nonnegative_integer_argument
              (local.get $slot)))
          (local.set $slot
            (call $proof_native_array_value_address
              (local.get $instance_counts_pointer)
              (local.get $best_index)))
          (local.set $instance_count
            (call $proof_native_nonnegative_integer_argument
              (local.get $slot)))
          (local.set $parameter_count
            (i32.add
              (local.get $inferred_count)
              (local.get $instance_count)))
          (local.set $metavariables_reference
            (call $proof_make_array
              (local.get $artifact_base)
              (local.get $parameter_count)))
          (local.set $domains_reference
            (call $proof_make_array
              (local.get $artifact_base)
              (local.get $instance_count)))
          (local.set $empty_scope
            (call $proof_make_array
              (local.get $artifact_base)
              (i32.const 0)))
          (local.set $empty_context
            (call $proof_make_array
              (local.get $artifact_base)
              (i32.const 0)))
          (if (i32.or
                (i32.eqz (local.get $metavariables_reference))
                (i32.or
                  (i32.eqz (local.get $domains_reference))
                  (i32.or
                    (i32.eqz (local.get $empty_scope))
                    (i32.eqz (local.get $empty_context)))))
            (then (br $candidate_failed)))
          (local.set $current_application
            (local.get $candidate_reference))
          (local.set $current_type
            (call $proof_infer_term
              (local.get $artifact_base)
              (local.get $candidate_reference)
              (local.get $empty_context)
              (i32.const 0)
              (i32.const 0) (local.get $work)))
          (if (i32.eqz (local.get $current_type))
            (then (br $candidate_failed)))
          (local.set $first_metavariable_identifier
            (global.get $proof_instance_metavariable_identifier))
          (local.set $parameter_index (i32.const 0))
          (block $parameters_done
            (loop $parameters_next
              (br_if $parameters_done
                (i32.ge_u
                  (local.get $parameter_index)
                  (local.get $parameter_count)))
              (local.set $normalized_type
                (call $proof_weak_head_normalize
                  (local.get $artifact_base)
                  (local.get $current_type)
                  (local.get $empty_context) (i32.const 0) (i32.const 0) (local.get $work)))
              (if (i32.or
                    (i32.eqz (local.get $normalized_type))
                    (i32.ne
                      (call $proof_load
                        (local.get $artifact_base)
                        (i32.add
                          (local.get $normalized_type)
                          (i32.const 4)))
                      (global.get $PROOF_TERM_PRODUCT)))
                (then (br $candidate_failed)))
              (local.set $domain_reference
                (call $proof_load
                  (local.get $artifact_base)
                  (i32.add
                    (local.get $normalized_type)
                    (i32.const 8))))
              (local.set $codomain_reference
                (call $proof_load
                  (local.get $artifact_base)
                  (i32.add
                    (local.get $normalized_type)
                    (i32.const 12))))
              (local.set $metavariable_reference
                (call $proof_make_three
                  (local.get $artifact_base)
                  (global.get $PROOF_TERM_METAVARIABLE)
                  (global.get $proof_instance_metavariable_identifier)
                  (local.get $empty_scope)
                  (i32.const 0)))
              (global.set $proof_instance_metavariable_identifier
                (i32.add
                  (global.get $proof_instance_metavariable_identifier)
                  (i32.const 1)))
              (if (i32.eqz (local.get $metavariable_reference))
                (then (br $candidate_failed)))
              (call $proof_array_set
                (local.get $artifact_base)
                (local.get $metavariables_reference)
                (local.get $parameter_index)
                (local.get $metavariable_reference))
              (if (i32.ge_u
                    (local.get $parameter_index)
                    (local.get $inferred_count))
                (then
                  (call $proof_array_set
                    (local.get $artifact_base)
                    (local.get $domains_reference)
                    (i32.sub
                      (local.get $parameter_index)
                      (local.get $inferred_count))
                    (local.get $domain_reference))))
              (local.set $current_application
                (call $proof_make_two
                  (local.get $artifact_base)
                  (global.get $PROOF_TERM_APPLICATION)
                  (local.get $current_application)
                  (local.get $metavariable_reference)))
              (local.set $current_type
                (call $proof_instantiate_binder
                  (local.get $artifact_base)
                  (local.get $codomain_reference)
                  (local.get $metavariable_reference)))
              (if (i32.or
                    (i32.eqz (local.get $current_application))
                    (i32.eqz (local.get $current_type)))
                (then (br $candidate_failed)))
              (local.set $parameter_index
                (i32.add
                  (local.get $parameter_index)
                  (i32.const 1)))
              (br $parameters_next)))

          ;; Root every mutable component before unification rewrites matching
          ;; metavariable occurrences throughout this search branch.
          (call $proof_array_set
            (local.get $artifact_base)
            (local.get $frame_reference)
            (i32.const 2)
            (local.get $current_application))
          (call $proof_array_set
            (local.get $artifact_base)
            (local.get $frame_reference)
            (i32.const 3)
            (local.get $current_type))
          (call $proof_array_set
            (local.get $artifact_base)
            (local.get $frame_reference)
            (i32.const 4)
            (local.get $metavariables_reference))
          (call $proof_array_set
            (local.get $artifact_base)
            (local.get $frame_reference)
            (i32.const 5)
            (local.get $domains_reference))
          ;; Unification rewrites only this candidate's mutable term graph.
          ;; Search frames contain scalar bookkeeping and must never be walked
          ;; as proof terms.
          (call $proof_array_set
            (local.get $artifact_base)
            (local.get $root_reference)
            (i32.const 0)
            (local.get $current_application))
          (call $proof_array_set
            (local.get $artifact_base)
            (local.get $root_reference)
            (i32.const 1)
            (local.get $current_type))
          (call $proof_array_set
            (local.get $artifact_base)
            (local.get $root_reference)
            (i32.const 2)
            (local.get $metavariables_reference))
          (call $proof_array_set
            (local.get $artifact_base)
            (local.get $root_reference)
            (i32.const 3)
            (local.get $domains_reference))
          (if (i32.eqz
                (call $proof_native_unify_terms
                  (local.get $artifact_base)
                  (local.get $current_type)
                  (local.get $goal_reference)
                  (local.get $root_reference)
                  (local.get $empty_context) (i32.const 0) (i32.const 0) (local.get $work)))
            (then (br $candidate_failed)))

          (local.set $metavariables_reference
            (call $proof_array_get
              (local.get $artifact_base)
              (local.get $frame_reference)
              (i32.const 4)))
          (local.set $domains_reference
            (call $proof_array_get
              (local.get $artifact_base)
              (local.get $frame_reference)
              (i32.const 5)))

          ;; Inferred parameters must be determined by the requested result
          ;; type before class dependencies are searched.
          (local.set $parameter_index (i32.const 0))
          (block $inferred_done
            (loop $inferred_next
              (br_if $inferred_done
                (i32.ge_u
                  (local.get $parameter_index)
                  (local.get $inferred_count)))
              (local.set $solution_reference
                (call $proof_native_find_solved_metavariable
                  (local.get $artifact_base)
                  (local.get $candidate_scratch_start)
                  (global.get $proof_scratch_cursor)
                  (i32.add
                    (local.get $first_metavariable_identifier)
                    (local.get $parameter_index))))
              (if (i32.eqz (local.get $solution_reference))
                (then (br $candidate_failed)))
              (call $proof_array_set
                (local.get $artifact_base)
                (local.get $metavariables_reference)
                (local.get $parameter_index)
                (local.get $solution_reference))
              (local.set $parameter_index
                (i32.add
                  (local.get $parameter_index)
                  (i32.const 1)))
              (br $inferred_next)))

          (local.set $instance_index (i32.const 0))
          (block $instances_done
            (loop $instances_next
              (br_if $instances_done
                (i32.ge_u
                  (local.get $instance_index)
                  (local.get $instance_count)))
              (local.set $metavariable_reference
                (call $proof_array_get
                  (local.get $artifact_base)
                  (local.get $metavariables_reference)
                  (i32.add
                    (local.get $inferred_count)
                    (local.get $instance_index))))
              (local.set $solution_reference
                (call $proof_native_find_solved_metavariable
                  (local.get $artifact_base)
                  (local.get $candidate_scratch_start)
                  (global.get $proof_scratch_cursor)
                  (i32.add
                    (i32.add
                      (local.get $first_metavariable_identifier)
                      (local.get $inferred_count))
                    (local.get $instance_index))))
              (if (local.get $solution_reference)
                (then
                  (local.set $metavariable_reference
                    (local.get $solution_reference))
                  (call $proof_array_set
                    (local.get $artifact_base)
                    (local.get $metavariables_reference)
                    (i32.add
                      (local.get $inferred_count)
                      (local.get $instance_index))
                    (local.get $solution_reference))))
              (if (i32.eq
                    (call $proof_load
                      (local.get $artifact_base)
                      (i32.add
                        (local.get $metavariable_reference)
                        (i32.const 4)))
                    (global.get $PROOF_TERM_METAVARIABLE))
                (then
                  (if (i32.eqz (local.get $depth_remaining))
                    (then
                      (global.set $proof_instance_bound_reached (i32.const 1))
                      (br $candidate_failed)))
                  (local.set $domain_reference
                    (call $proof_array_get
                      (local.get $artifact_base)
                      (local.get $domains_reference)
                      (local.get $instance_index)))
                  (local.set $resolved_dependency
                    (call $proof_native_resolve_instance_in_artifact
                      (local.get $artifact_base)
                      (local.get $domain_reference)
                      (local.get $candidates_reference)
                      (local.get $inferred_counts_pointer)
                      (local.get $instance_counts_pointer)
                      (local.get $priorities_pointer)
                      (i32.sub
                        (local.get $depth_remaining)
                        (i32.const 1))
                      (local.get $root_reference)
                      (local.get $frames_reference)
                      (i32.add
                        (local.get $frame_index)
                        (i32.const 1)) (local.get $work)))
                  (if (i32.eqz (local.get $resolved_dependency))
                    (then (br $candidate_failed)))
                  ;; Recursive search reused the mutable-root array. Restore
                  ;; this frame's graph before solving its dependency hole.
                  (local.set $current_application
                    (call $proof_array_get
                      (local.get $artifact_base)
                      (local.get $frame_reference)
                      (i32.const 2)))
                  (local.set $current_type
                    (call $proof_array_get
                      (local.get $artifact_base)
                      (local.get $frame_reference)
                      (i32.const 3)))
                  (local.set $metavariables_reference
                    (call $proof_array_get
                      (local.get $artifact_base)
                      (local.get $frame_reference)
                      (i32.const 4)))
                  (local.set $domains_reference
                    (call $proof_array_get
                      (local.get $artifact_base)
                      (local.get $frame_reference)
                      (i32.const 5)))
                  (call $proof_array_set
                    (local.get $artifact_base)
                    (local.get $root_reference)
                    (i32.const 0)
                    (local.get $current_application))
                  (call $proof_array_set
                    (local.get $artifact_base)
                    (local.get $root_reference)
                    (i32.const 1)
                    (local.get $current_type))
                  (call $proof_array_set
                    (local.get $artifact_base)
                    (local.get $root_reference)
                    (i32.const 2)
                    (local.get $metavariables_reference))
                  (call $proof_array_set
                    (local.get $artifact_base)
                    (local.get $root_reference)
                    (i32.const 3)
                    (local.get $domains_reference))
                  (local.set $metavariable_reference
                    (call $proof_array_get
                      (local.get $artifact_base)
                      (local.get $metavariables_reference)
                      (i32.add
                        (local.get $inferred_count)
                        (local.get $instance_index))))
                  (if (i32.eqz
                        (call $proof_native_unify_terms
                          (local.get $artifact_base)
                          (local.get $metavariable_reference)
                          (local.get $resolved_dependency)
                          (local.get $root_reference)
                          (local.get $empty_context) (i32.const 0) (i32.const 0) (local.get $work)))
                    (then (br $candidate_failed)))))
              (local.set $instance_index
                (i32.add
                  (local.get $instance_index)
                  (i32.const 1)))
              (br $instances_next)))

          (local.set $current_application
            (call $proof_array_get
              (local.get $artifact_base)
              (local.get $frame_reference)
              (i32.const 2)))
          (if (call $proof_native_scan_open_term
                (local.get $artifact_base)
                (local.get $current_application)
                (i32.const 2)
                (i32.const 0)
                (i32.const 0))
            (then (br $candidate_failed)))
          (global.set $proof_last_error_code (i32.const 0))
          (if (i32.eqz
                (call $proof_check_term
                  (local.get $artifact_base)
                  (local.get $current_application)
                  (local.get $goal_reference)
                  (local.get $empty_context)
                  (i32.const 0)
                  (i32.const 0) (local.get $work)))
            (then (br $candidate_failed)))
          (local.set $candidate_succeeded (i32.const 1)))

        (if (local.get $candidate_succeeded)
          (then
            (if (local.get $rerunning_selected)
              (then
                (global.set $proof_scratch_limit
                  (local.get $prior_scratch_limit))
                (return
                  (call $proof_array_get
                    (local.get $artifact_base)
                    (local.get $frame_reference)
                    (i32.const 2)))))
            (if (i32.lt_s (local.get $selected_index) (i32.const 0))
              (then
                (local.set $scan_index (i32.const 0))
                (local.set $priority (i32.const 0))
                (block $same_priority_scan_done
                  (loop $same_priority_scan_next
                    (br_if $same_priority_scan_done
                      (i32.ge_u
                        (local.get $scan_index)
                        (local.get $candidate_count)))
                    (if (i32.and
                          (i32.eqz
                            (call $proof_array_get
                              (local.get $artifact_base)
                              (local.get $tried_reference)
                              (local.get $scan_index)))
                          (i32.eq
                            (call $proof_native_nonnegative_integer_argument
                              (call $proof_native_array_value_address
                                (local.get $priorities_pointer)
                                (local.get $scan_index)))
                            (local.get $best_priority)))
                      (then
                        (local.set $priority (i32.const 1))
                        (br $same_priority_scan_done)))
                    (local.set $scan_index
                      (i32.add (local.get $scan_index) (i32.const 1)))
                    (br $same_priority_scan_next)))
                (if (i32.eqz (local.get $priority))
                  (then
                    (global.set $proof_scratch_limit
                      (local.get $prior_scratch_limit))
                    (return
                      (call $proof_array_get
                        (local.get $artifact_base)
                        (local.get $frame_reference)
                        (i32.const 2)))))
                (local.set $selected_index (local.get $best_index))
                (local.set $selected_priority (local.get $best_priority)))
              (else
                (if (i32.eq
                      (local.get $best_priority)
                      (local.get $selected_priority))
                  (then
                    (global.set $proof_instance_ambiguity_reached
                      (i32.const 1))
                    (global.set $proof_scratch_limit
                      (local.get $prior_scratch_limit))
                    (return (i32.const 0))))))))

        ;; Failed candidate: restore bytes, cursor, and allocation ceiling.
        (memory.copy
          (call $abs (local.get $artifact_base))
          (call $abs
            (i32.add
              (local.get $artifact_base)
              (local.get $backup_start)))
          (local.get $snapshot_length))
        (global.set $proof_scratch_cursor
          (local.get $snapshot_length))
        (global.set $proof_scratch_limit
          (local.get $prior_scratch_limit))
        (global.set $proof_last_error_code (i32.const 0))
        (br $candidate_next)))
    (i32.const 0)
  )

  

  ;; Return the nearest dynamically active universe-authoring continuation.
  ;; The frame-owned state handle is the scope authority; no ambient mutable
  ;; current-scope global participates in lookup.
  (func $proof_native_active_universe_state (result i32)
    (local $stack_pointer i32)
    (local $frame_pointer i32)
    (local.set $stack_pointer
      (call $read_ctx (global.get $CTX_CALL_STACK_POINTER)))
    (block $not_found
      (loop $walk
        (br_if $not_found
          (i32.le_u
            (local.get $stack_pointer)
            (call $call_stack_base_seg)))
        (local.set $stack_pointer
          (i32.sub (local.get $stack_pointer) (global.get $FRAME_SIZE)))
        (local.set $frame_pointer (call $abs (local.get $stack_pointer)))
        (if (i32.and
              (i32.ne
                (i32.and
                  (i32.load
                    (i32.add
                      (local.get $frame_pointer)
                      (global.get $FRAME_FLAGS)))
                  (global.get $FRAME_FLAG_NATIVE_CONTINUATION))
                (i32.const 0))
              (i32.eq
                (i32.load
                  (i32.add
                    (local.get $frame_pointer)
                    (global.get $FRAME_CONTINUATION_KIND)))
                (global.get $CONTINUATION_KIND_PROOF_UNIVERSES)))
          (then
            (return
              (i32.load
                (i32.add
                  (local.get $frame_pointer)
                  (global.get $FRAME_CONTINUATION_STATE_HANDLE))))))
        (br $walk)))
    (i32.const 0)
  )

  (func $proof_native_allocate_universe_handle
    (param $owner_state i32)
    (param $ordinal i32)
    (result i32)
    (local $handle i32)
    (local.set $handle
      (call $read_state (global.get $STATE_HEAP_POINTER)))
    (i32.store
      (call $abs (local.get $handle))
      (i32.or
        (i32.const 24)
        (i32.shl (global.get $OBJ_THEOREM) (i32.const 24))))
    (i32.store
      (call $abs (i32.add (local.get $handle) (i32.const 4)))
      (i32.const 0))
    ;; OBJ_THEOREM's first field is collector-declared as a data pointer.
    ;; Store the owner state's data pointer here and recover its header at use
    ;; sites; storing the header would mis-mark and mis-forward after collection.
    (i32.store
      (call $abs (i32.add (local.get $handle) (i32.const 8)))
      (i32.add
        (local.get $owner_state)
        (global.get $GC_HEADER_SIZE)))
    (i32.store
      (call $abs (i32.add (local.get $handle) (i32.const 12)))
      (local.get $ordinal))
    (i32.store
      (call $abs (i32.add (local.get $handle) (i32.const 16)))
      (global.get $PROOF_HANDLE_UNIVERSE))
    (i32.store
      (call $abs (i32.add (local.get $handle) (i32.const 20)))
      (i32.const 0))
    (call $write_state
      (global.get $STATE_HEAP_POINTER)
      (i32.add (local.get $handle) (i32.const 24)))
    (local.get $handle)
  )

  ;; Build one source-only field descriptor accepted by Proof.Term.sequence.
  (func $proof_native_field
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_identifier i32) (param $argument_count i32)
    (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $name_argument i32)
    (local $implicit_argument i32)
    (local $name_identifier i32)
    (local $name_entry i32)
    (local $name_length i32)
    (local $record_words i32)
    (local $artifact_length i32)
    (local $workspace_length i32)
    (local $handle i32)
    (local $artifact_base i32)
    (local $declarations_reference i32)
    (local.set $pending_pointer
      (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ne (local.get $argument_count) (i32.const 2))
      (then
        (call $write_ctx
          (global.get $CTX_PENDING_POINTER)
          (local.get $stack_base))
        (return
          (i32.add
            (i32.const 1)
            (call $throw_type_error_with_message
              (global.get $BUILTIN_MSG_MISSING_ARGUMENT))))))
    (local.set $name_argument
      (i32.sub
        (local.get $pending_pointer)
        (i32.mul (i32.const 2) (global.get $VALUE_SIZE))))
    (local.set $implicit_argument
      (i32.add (local.get $name_argument) (global.get $VALUE_SIZE)))
    (if (i32.or
          (i32.ne
            (call $value_type (local.get $name_argument))
            (global.get $TYPE_STRING))
          (i32.ne
            (call $value_type (local.get $implicit_argument))
            (global.get $TYPE_BOOLEAN)))
      (then
        (call $write_ctx
          (global.get $CTX_PENDING_POINTER)
          (local.get $stack_base))
        (return
          (i32.add
            (i32.const 1)
            (call $throw_type_error_with_message
              (global.get $BUILTIN_MSG_NOT_AN_OBJECT))))))
    (local.set $name_identifier
      (call $value_data_lo (local.get $name_argument)))
    (local.set $name_entry
      (call $string_id_to_abs (local.get $name_identifier)))
    (local.set $name_length (i32.load (local.get $name_entry)))
    (local.set $record_words
      (i32.add
        (i32.const 4)
        (i32.div_u
          (i32.add (local.get $name_length) (i32.const 3))
          (i32.const 4))))
    (local.set $artifact_length
      (i32.add
        (i32.const 28)
        (i32.mul (local.get $record_words) (i32.const 4))))
    (local.set $workspace_length
      (call $proof_native_workspace_size (local.get $artifact_length)))
    (if (call $check_heap_overflow
          (i32.add
            (call $estimate_arraybuffer_size
              (i32.add
                (local.get $artifact_length)
                (local.get $workspace_length)))
            (i32.const 24)))
      (then (return (i32.const 0))))
    (local.set $handle
      (call $proof_native_allocate_term_handle
        (local.get $artifact_length)
        (i32.const 16)
        (local.get $workspace_length)))
    (local.set $artifact_base
      (call $proof_native_handle_artifact_base (local.get $handle)))
    (call $proof_store
      (local.get $artifact_base) (i32.const 16) (local.get $record_words))
    (call $proof_store
      (local.get $artifact_base) (i32.const 20)
      (global.get $PROOF_RECORD_SOURCE_FIELD))
    (call $proof_store
      (local.get $artifact_base) (i32.const 24) (local.get $name_length))
    (call $proof_store
      (local.get $artifact_base) (i32.const 28)
      (call $value_data_lo (local.get $implicit_argument)))
    (memory.copy
      (call $abs (i32.add (local.get $artifact_base) (i32.const 32)))
      (i32.add (local.get $name_entry) (i32.const 4))
      (local.get $name_length))
    (local.set $declarations_reference
      (i32.add
        (i32.const 16)
        (i32.mul (local.get $record_words) (i32.const 4))))
    (call $proof_native_write_empty_declarations
      (local.get $artifact_base)
      (local.get $declarations_reference))
    (call $proof_native_initialize_artifact_header
      (local.get $artifact_base)
      (local.get $artifact_length)
      (local.get $declarations_reference))
    (call $write_ctx
      (global.get $CTX_PENDING_POINTER)
      (local.get $stack_base))
    (call $proof_native_push_term (local.get $handle))
    (i32.const 0)
  )

  ;; Start one universe-authoring transaction and stage its callback. The
  ;; binding object and every universe value are collector-visible before the
  ;; frame is published.
  (func $proof_native_universes
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_identifier i32) (param $argument_count i32)
    (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $names_argument i32)
    (local $callback_argument i32)
    (local $names i32)
    (local $names_data i32)
    (local $count i32)
    (local $index i32)
    (local $name_slot i32)
    (local $callback i32)
    (local $state_handle i32)
    (local $bindings i32)
    (local $constraints i32)
    (local $universe i32)
    (local $stack_pointer i32)
    (local $frame_pointer i32)
    (local.set $pending_pointer
      (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ne (local.get $argument_count) (i32.const 2))
      (then
        (call $write_ctx
          (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
        (return
          (i32.add
            (i32.const 1)
            (call $throw_type_error_with_message
              (global.get $BUILTIN_MSG_MISSING_ARGUMENT))))))
    (local.set $names_argument
      (i32.sub
        (local.get $pending_pointer)
        (i32.mul (i32.const 2) (global.get $VALUE_SIZE))))
    (local.set $callback_argument
      (i32.add (local.get $names_argument) (global.get $VALUE_SIZE)))
    (if (i32.or
          (i32.ne
            (call $value_type (local.get $names_argument))
            (global.get $TYPE_ARRAY))
          (i32.ne
            (call $value_type (local.get $callback_argument))
            (global.get $TYPE_FUNCTION)))
      (then
        (call $write_ctx
          (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
        (return
          (i32.add
            (i32.const 1)
            (call $throw_type_error_with_message
              (global.get $BUILTIN_MSG_NOT_AN_OBJECT))))))
    (local.set $names (call $value_data_lo (local.get $names_argument)))
    (local.set $callback (call $value_data_lo (local.get $callback_argument)))
    (local.set $count
      (i32.load (call $abs (i32.add (local.get $names) (i32.const 12)))))
    (local.set $names_data
      (i32.load (call $abs (i32.add (local.get $names) (i32.const 16)))))
    (local.set $index (i32.const 0))
    (block $names_valid
      (loop $validate_name
        (br_if $names_valid
          (i32.ge_u (local.get $index) (local.get $count)))
        (local.set $name_slot
          (i32.add
            (i32.add (local.get $names_data) (global.get $GC_HEADER_SIZE))
            (i32.mul (local.get $index) (global.get $VALUE_SIZE))))
        (if (i32.ne
              (call $value_type (local.get $name_slot))
              (global.get $TYPE_STRING))
          (then
            (call $write_ctx
              (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
            (return
              (i32.add
                (i32.const 1)
                (call $throw_type_error_with_message
                  (global.get $BUILTIN_MSG_NOT_AN_OBJECT))))))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $validate_name)))
    (if (call $check_heap_overflow
          (i32.add
            (global.get $NATIVE_CONTINUATION_STATE_SIZE)
            (i32.add
              (call $estimate_object_size (local.get $count))
              (i32.add
                (call $estimate_array_size (i32.const 0))
                (i32.mul (local.get $count) (i32.const 24))))))
      (then (return (i32.const 0))))
    (local.set $state_handle
      (call $allocate_native_continuation_state
        (i32.const 15) (i32.const 0)
        (i32.const 0) (i32.const 0) (i32.const 0)
        (call $proof_native_active_universe_state)
        (local.get $count)))
    ;; The allocation's final scalar word records the pre-transaction prefix.
    (call $native_continuation_state_set (local.get $state_handle) (i32.const 5) (i32.const -1))
    (local.set $bindings (call $allocate_object (local.get $count)))
    (local.set $constraints (call $allocate_array (i32.const 0)))
    (call $native_continuation_state_set
      (local.get $state_handle) (i32.const 0) (local.get $bindings))
    (call $native_continuation_state_set
      (local.get $state_handle) (i32.const 2) (local.get $constraints))
    (local.set $index (i32.const 0))
    (block $bindings_done
      (loop $binding_next
        (br_if $bindings_done
          (i32.ge_u (local.get $index) (local.get $count)))
        (local.set $name_slot
          (i32.add
            (i32.add (local.get $names_data) (global.get $GC_HEADER_SIZE))
            (i32.mul (local.get $index) (global.get $VALUE_SIZE))))
        (local.set $universe
          (call $proof_native_allocate_universe_handle
            (local.get $state_handle) (local.get $index)))
        (drop
          (call $object_set_property
            (local.get $bindings)
            (call $value_data_lo (local.get $name_slot))
            (global.get $TYPE_THEOREM) (i32.const 0)
            (local.get $universe) (i32.const 0)))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $binding_next)))
    (local.set $stack_pointer
      (call $read_ctx (global.get $CTX_CALL_STACK_POINTER)))
    (local.set $frame_pointer (call $abs (local.get $stack_pointer)))
    (call $publish_native_continuation_frame
      (local.get $frame_pointer) (local.get $stack_pointer)
      (local.get $stack_base)
      (i32.const 1) (i32.const 1) (i32.const 0)
      (local.get $state_handle) (i32.const 0)
      (global.get $CONTINUATION_KIND_PROOF_UNIVERSES)
      (i32.const 0) (local.get $callback)
      (i32.const 0) (i32.const 0))
    (call $pending_push
      (global.get $TYPE_OBJECT) (i32.const 0)
      (local.get $bindings) (i32.const 0))
    (global.get $STATUS_NATIVE_CONTINUATION_STAGED)
  )

  ;; Record one canonical universe constraint in callback order. Each entry is
  ;; three scalar words in the scope-owned array: left ordinal, relation code,
  ;; right ordinal.
  (func $proof_native_constrain
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_identifier i32) (param $argument_count i32)
    (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $left_argument i32)
    (local $relation_argument i32)
    (local $right_argument i32)
    (local $left_handle i32)
    (local $right_handle i32)
    (local $state_handle i32)
    (local $constraints i32)
    (local $relation i32)
    (local.set $pending_pointer
      (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (local.set $state_handle (call $proof_native_active_universe_state))
    (if (i32.or
          (i32.eqz (local.get $state_handle))
          (i32.ne (local.get $argument_count) (i32.const 3)))
      (then
        (call $write_ctx
          (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
        (return
          (i32.add
            (i32.const 1)
            (call $throw_type_error_with_message
              (global.get $BUILTIN_MSG_NOT_AN_OBJECT))))))
    (local.set $left_argument
      (i32.sub
        (local.get $pending_pointer)
        (i32.mul (i32.const 3) (global.get $VALUE_SIZE))))
    (local.set $relation_argument
      (i32.add (local.get $left_argument) (global.get $VALUE_SIZE)))
    (local.set $right_argument
      (i32.add
        (local.get $relation_argument)
        (global.get $VALUE_SIZE)))
    (if (i32.or
          (i32.or
            (i32.ne
              (call $value_type (local.get $left_argument))
              (global.get $TYPE_THEOREM))
            (i32.ne
              (call $value_type (local.get $right_argument))
              (global.get $TYPE_THEOREM)))
          (i32.ne
            (call $value_type (local.get $relation_argument))
            (global.get $TYPE_STRING)))
      (then
        (call $write_ctx
          (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
        (return
          (i32.add
            (i32.const 1)
            (call $throw_type_error_with_message
              (global.get $BUILTIN_MSG_NOT_AN_OBJECT))))))
    (local.set $left_handle (call $value_data_lo (local.get $left_argument)))
    (local.set $right_handle (call $value_data_lo (local.get $right_argument)))
    (if (i32.or
          (i32.or
            (i32.ne
              (call $proof_native_handle_kind (local.get $left_handle))
              (global.get $PROOF_HANDLE_UNIVERSE))
            (i32.ne
              (call $proof_native_handle_kind (local.get $right_handle))
              (global.get $PROOF_HANDLE_UNIVERSE)))
          (i32.or
            (i32.ne
              (i32.sub
                (call $proof_native_handle_buffer (local.get $left_handle))
                (global.get $GC_HEADER_SIZE))
              (local.get $state_handle))
            (i32.ne
              (i32.sub
                (call $proof_native_handle_buffer (local.get $right_handle))
                (global.get $GC_HEADER_SIZE))
              (local.get $state_handle))))
      (then
        (call $write_ctx
          (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
        (return
          (i32.add
            (i32.const 1)
            (call $throw_type_error_with_message
              (global.get $BUILTIN_MSG_NOT_AN_OBJECT))))))
    (if (call $proof_native_string_equals
          (call $value_data_lo (local.get $relation_argument))
          (i32.const 1) (i32.const 0x0000003c)
          (i32.const 0) (i32.const 0) (i32.const 0))
      (then (local.set $relation (i32.const 1)))
      (else
        (if (call $proof_native_string_equals
              (call $value_data_lo (local.get $relation_argument))
              (i32.const 2) (i32.const 0x00003d3c)
              (i32.const 0) (i32.const 0) (i32.const 0))
          (then
            (local.set $relation (i32.const 0)))
          (else
            (if (call $proof_native_string_equals
                  (call $value_data_lo (local.get $relation_argument))
                  (i32.const 1) (i32.const 0x0000003d)
                  (i32.const 0) (i32.const 0) (i32.const 0))
              (then
                (local.set $relation (i32.const 2)))
              (else
                (call $write_ctx
                  (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
                (return
                  (i32.add
                    (i32.const 1)
                    (call $throw_type_error_with_message
                      (global.get $BUILTIN_MSG_NOT_AN_OBJECT))))))))))
    (local.set $constraints
      (call $native_continuation_state_get
        (local.get $state_handle) (i32.const 2)))
    (if (i32.eq
          (i32.load
            (call $abs
              (i32.add (local.get $constraints) (i32.const 8))))
          (i32.load
            (call $abs
              (i32.add (local.get $constraints) (i32.const 12)))))
      (then
        (if (call $check_heap_overflow
              (call $estimate_array_grow_size
                (i32.load
                  (call $abs
                    (i32.add
                      (local.get $constraints) (i32.const 12))))))
          (then (return (i32.const 0))))))
    (drop
      (call $array_push_value
        (local.get $constraints)
        (global.get $TYPE_INTEGER) (i32.const 0)
        (call $proof_native_handle_root (local.get $left_handle))
        (i32.const 0)))
    (drop
      (call $array_push_value
        (local.get $constraints)
        (global.get $TYPE_INTEGER) (i32.const 0)
        (local.get $relation) (i32.const 0)))
    (drop
      (call $array_push_value
        (local.get $constraints)
        (global.get $TYPE_INTEGER) (i32.const 0)
        (call $proof_native_handle_root (local.get $right_handle))
        (i32.const 0)))
    (call $write_ctx
      (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (call $pending_push
      (global.get $TYPE_UNDEFINED) (i32.const 0)
      (i32.const 0) (i32.const 0))
    (i32.const 0)
  )

  ;; Materialize the scope's canonical constraint records in a temporary
  ;; kernel artifact and run the existing universe solver. This keeps one
  ;; consistency authority: Proof.constrain records authoring data, while the
  ;; kernel's normal relation checker decides whether the completed set is
  ;; satisfiable.
  

  ;; Write the active authoring scope's ordered constraint snapshot and
  ;; universe context into a declaration artifact. Returns the context
  ;; reference; callers continue at reference + 16.
  (func $proof_native_write_active_universe_context
    (param $state_handle i32)
    (param $artifact_base i32)
    (param $cursor i32)
    (result i32)
    (local $constraints i32)
    (local $constraint_data i32)
    (local $constraint_count i32)
    (local $index i32)
    (local $records_start i32)
    (local $constraints_reference i32)
    (local $context_reference i32)
    (local.set $constraints
      (call $native_continuation_state_get
        (local.get $state_handle) (i32.const 2)))
    (local.set $constraint_count
      (i32.div_u
        (i32.load
          (call $abs
            (i32.add (local.get $constraints) (i32.const 8))))
        (i32.const 3)))
    (local.set $constraint_data
      (i32.add
        (i32.load
          (call $abs
            (i32.add (local.get $constraints) (i32.const 16))))
        (global.get $GC_HEADER_SIZE)))
    (local.set $records_start (local.get $cursor))
    (local.set $index (i32.const 0))
    (block $records_done
      (loop $record_next
        (br_if $records_done
          (i32.ge_u (local.get $index) (local.get $constraint_count)))
        (call $proof_store
          (local.get $artifact_base) (local.get $cursor) (i32.const 7))
        (call $proof_store
          (local.get $artifact_base)
          (i32.add (local.get $cursor) (i32.const 4))
          (global.get $PROOF_RECORD_UNIVERSE_CONSTRAINT))
        (call $proof_store
          (local.get $artifact_base)
          (i32.add (local.get $cursor) (i32.const 8))
          (i32.add
            (call $value_data_lo
              (i32.add
                (local.get $constraint_data)
                (i32.mul
                  (i32.mul (local.get $index) (i32.const 3))
                  (global.get $VALUE_SIZE))))
            (i32.const 1)))
        (call $proof_store
          (local.get $artifact_base)
          (i32.add (local.get $cursor) (i32.const 12))
          (i32.const 0))
        (call $proof_store
          (local.get $artifact_base)
          (i32.add (local.get $cursor) (i32.const 16))
          (call $value_data_lo
            (i32.add
              (local.get $constraint_data)
              (i32.mul
                (i32.add
                  (i32.mul (local.get $index) (i32.const 3))
                  (i32.const 1))
                (global.get $VALUE_SIZE)))))
        (call $proof_store
          (local.get $artifact_base)
          (i32.add (local.get $cursor) (i32.const 20))
          (i32.add
            (call $value_data_lo
              (i32.add
                (local.get $constraint_data)
                (i32.mul
                  (i32.add
                    (i32.mul (local.get $index) (i32.const 3))
                    (i32.const 2))
                  (global.get $VALUE_SIZE))))
            (i32.const 1)))
        (call $proof_store
          (local.get $artifact_base)
          (i32.add (local.get $cursor) (i32.const 24))
          (i32.const 0))
        (local.set $cursor (i32.add (local.get $cursor) (i32.const 28)))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $record_next)))
    (local.set $constraints_reference (local.get $cursor))
    (call $proof_store
      (local.get $artifact_base) (local.get $cursor)
      (i32.add (local.get $constraint_count) (i32.const 3)))
    (call $proof_store
      (local.get $artifact_base)
      (i32.add (local.get $cursor) (i32.const 4))
      (global.get $PROOF_RECORD_ARRAY))
    (call $proof_store
      (local.get $artifact_base)
      (i32.add (local.get $cursor) (i32.const 8))
      (local.get $constraint_count))
    (local.set $index (i32.const 0))
    (block $references_done
      (loop $reference_next
        (br_if $references_done
          (i32.ge_u (local.get $index) (local.get $constraint_count)))
        (call $proof_store
          (local.get $artifact_base)
          (i32.add
            (i32.add (local.get $cursor) (i32.const 12))
            (i32.mul (local.get $index) (i32.const 4)))
          (i32.add
            (local.get $records_start)
            (i32.mul (local.get $index) (i32.const 28))))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $reference_next)))
    (local.set $cursor
      (i32.add
        (local.get $cursor)
        (i32.add
          (i32.const 12)
          (i32.mul (local.get $constraint_count) (i32.const 4)))))
    (local.set $context_reference (local.get $cursor))
    (call $proof_store
      (local.get $artifact_base) (local.get $cursor) (i32.const 4))
    (call $proof_store
      (local.get $artifact_base)
      (i32.add (local.get $cursor) (i32.const 4))
      (global.get $PROOF_RECORD_UNIVERSE_CONTEXT))
    (call $proof_store
      (local.get $artifact_base)
      (i32.add (local.get $cursor) (i32.const 8))
      (call $native_continuation_state_get
        (local.get $state_handle) (i32.const 4)))
    (call $proof_store
      (local.get $artifact_base)
      (i32.add (local.get $cursor) (i32.const 12))
      (local.get $constraints_reference))
    (local.get $context_reference)
  )

  ;; A declaration candidate after the first must extend the transaction's
  ;; immediately preceding cumulative artifact, never an independent branch.
  (func $proof_native_universe_candidate_source_valid
    (param $state_handle i32)
    (param $source_handle i32)
    (result i32)
    (local $candidate i32)
    (local.set $candidate
      (call $native_continuation_state_get
        (local.get $state_handle) (i32.const 1)))
    (if (i32.eqz (local.get $candidate))
      (then
        ;; Retry attempts may select another source until a candidate is
        ;; published; afterwards the original declaration prefix is frozen.
        (call $native_continuation_state_set (local.get $state_handle) (i32.const 5)
          (if (result i32) (local.get $source_handle)
            (then (call $proof_array_count
              (call $proof_native_handle_artifact_base (local.get $source_handle))
              (call $proof_load (call $proof_native_handle_artifact_base (local.get $source_handle)) (i32.const 12))))
            (else (i32.const 0))))
        (return (i32.const 1))))
    (i32.eq
      (call $proof_native_handle_buffer (local.get $candidate))
      (call $proof_native_handle_buffer (local.get $source_handle)))
  )

  ;; Generalize the selected transaction artifact to exactly the scoped
  ;; universes reachable from its term records. Constraint-connected variables
  ;; remain together; original binding order determines the compact ordinals.
  ;; Returns -1 for memory pressure, 0 for malformed scoped data, or the
  ;; generalized environment handle.
  ;; Recursors bind a separate local universe scope (possibly with a prepended
  ;; motive level). Their generated graphs are regenerated after the family's
  ;; authoring scope is generalized, never renumbered as family parameters.
  (func $proof_native_mark_generalizable_records
    (param $base i32) (param $length i32) (param $table i32) (param $first_declaration i32)
    (local $declarations i32) (local $index i32) (local $count i32) (local $declaration i32)
    (local.set $declarations (call $proof_load (local.get $base) (i32.const 12)))
    (local.set $count (call $proof_array_count (local.get $base) (local.get $declarations)))
    (local.set $index (local.get $first_declaration))
    (block $done (loop $next
      (br_if $done (i32.ge_u (local.get $index) (local.get $count)))
      (local.set $declaration (call $proof_array_get (local.get $base) (local.get $declarations) (local.get $index)))
      (if (i32.ne (call $proof_load (local.get $base) (i32.add (local.get $declaration) (i32.const 4)))
            (global.get $PROOF_RECORD_RECURSOR_DECLARATION))
        (then (call $proof_native_mark_reachable_records
          (local.get $base) (local.get $length) (local.get $table) (local.get $declaration) (i32.const 0))))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      (br $next))))

  

  (func $proof_native_universe_constraint_retained
    (param $artifact_base i32)
    (param $constraint_reference i32)
    (param $variable_mapping_buffer i32)
    (param $variable_count i32)
    (result i32)
    (local $left_ordinal i32)
    (local $right_ordinal i32)
    (local.set $left_ordinal
      (call $proof_load
        (local.get $artifact_base)
        (i32.add (local.get $constraint_reference) (i32.const 8))))
    (local.set $right_ordinal
      (call $proof_load
        (local.get $artifact_base)
        (i32.add (local.get $constraint_reference) (i32.const 20))))
    (if (i32.or
          (i32.eqz (local.get $left_ordinal))
          (i32.or
            (i32.eqz (local.get $right_ordinal))
            (i32.or
              (i32.gt_u (local.get $left_ordinal) (local.get $variable_count))
              (i32.gt_u (local.get $right_ordinal) (local.get $variable_count)))))
      (then (unreachable)))
    (i32.and
      (i32.ne
        (i32.load
          (call $abs
            (i32.add
              (i32.add (local.get $variable_mapping_buffer) (i32.const 4))
              (i32.mul
                (i32.sub (local.get $left_ordinal) (i32.const 1))
                (i32.const 4)))))
        (i32.const 0))
      (i32.ne
        (i32.load
          (call $abs
            (i32.add
              (i32.add (local.get $variable_mapping_buffer) (i32.const 4))
              (i32.mul
                (i32.sub (local.get $right_ordinal) (i32.const 1))
                (i32.const 4)))))
        (i32.const 0)))
  )

  (func $proof_native_is_universe_constraint_array
    (param $artifact_base i32)
    (param $artifact_length i32)
    (param $array_reference i32)
    (result i32)
    (local $record_reference i32)
    (local $word_count i32)
    (local.set $record_reference (i32.const 16))
    (block $not_found
      (loop $next
        (br_if $not_found
          (i32.ge_u (local.get $record_reference) (local.get $artifact_length)))
