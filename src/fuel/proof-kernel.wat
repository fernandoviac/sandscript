                      (local.get $constructor_count))))
                (local.set $constructor
                  (call $proof_array_get
                    (local.get $artifact_base)
                    (local.get $constructors)
                    (local.get $scan_index)))
                (local.set $inspection_result
                  (call $proof_term_depends_on_declaration
                    (local.get $artifact_base)
                    (call $proof_load
                      (local.get $artifact_base)
                      (i32.add (local.get $constructor) (i32.const 8)))
                    (local.get $dependency_index)
                    (i32.const 100000)))
                (local.set $scan_index
                  (i32.add (local.get $scan_index) (i32.const 1)))
                (br $dependency_constructors_next)))))
        (call $write_ctx
          (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
        (if (i32.lt_s (local.get $inspection_result) (i32.const 0))
          (then
            (return
              (i32.add
                (i32.const 1)
                (call $throw_type_error_with_message
                  (global.get $BUILTIN_MSG_NOT_AN_OBJECT))))))
        (call $pending_push
          (global.get $TYPE_BOOLEAN)
          (i32.const 0)
          (i32.gt_s (local.get $inspection_result) (i32.const 0))
          (i32.const 0))
        (return (i32.const 0))))
    (if (i32.eq (local.get $method_identifier) (i32.const 0x265))
      (then
        (call $write_ctx
          (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
        (call $push_f64 (f64.convert_i32_u (local.get $declaration_tag)))
        (return (i32.const 0))))
    (if (i32.eq (local.get $method_identifier) (i32.const 0x267))
      (then
        (if (i32.eqz
              (i32.or
                (i32.eq
                  (local.get $declaration_tag)
                  (global.get $PROOF_RECORD_DEFINITION_DECLARATION))
                (i32.or
                  (i32.eq
                    (local.get $declaration_tag)
                    (global.get $PROOF_RECORD_OPAQUE_DEFINITION_DECLARATION))
                  (i32.eq
                    (local.get $declaration_tag)
                    (global.get $PROOF_RECORD_THEOREM_DECLARATION)))))
          (then
            (call $write_ctx
              (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
            (call $pending_push
              (global.get $TYPE_UNDEFINED)
              (i32.const 0) (i32.const 0) (i32.const 0))
            (return (i32.const 0))))))
    (local.set $root_reference
      (call $proof_load
        (local.get $artifact_base)
        (i32.add
          (local.get $declaration)
          (if (result i32)
            (i32.eq (local.get $method_identifier) (i32.const 0x266))
            (then (i32.const 12))
            (else (i32.const 16))))))
    (if (call $check_heap_overflow (i32.const 24))
      (then (return (i32.const 0))))
    (local.set $pending_pointer
      (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (local.set $environment_argument
      (i32.sub
        (local.get $pending_pointer)
        (i32.mul
          (local.get $argument_count)
          (global.get $VALUE_SIZE))))
    (local.set $environment_handle
      (call $value_data_lo (local.get $environment_argument)))
    (local.set $artifact_base
      (call $proof_native_handle_artifact_base
        (local.get $environment_handle)))
    (local.set $declarations
      (call $proof_load (local.get $artifact_base) (i32.const 12)))
    (local.set $declaration
      (call $proof_array_get
        (local.get $artifact_base)
        (local.get $declarations)
        (local.get $declaration_index)))
    (local.set $root_reference
      (call $proof_load
        (local.get $artifact_base)
        (i32.add
          (local.get $declaration)
          (if (result i32)
            (i32.eq (local.get $method_identifier) (i32.const 0x266))
            (then (i32.const 12))
            (else (i32.const 16))))))
    (call $write_ctx
      (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (local.set $term_handle
      (call $proof_native_allocate_shared_term_handle
        (local.get $environment_handle)
        (local.get $root_reference)))
    (call $proof_native_push_term (local.get $term_handle))
    (i32.const 0)
  )

  ;; Reopen a checked theorem artifact as a declaration environment so later
  ;; declarations can depend on the sealed theorem.
  (func $proof_native_environment
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_identifier i32) (param $argument_count i32)
    (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument i32)
    (local $source_handle i32)
    (local $environment_handle i32)
    (local.set $pending_pointer
      (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ne (local.get $argument_count) (i32.const 1))
      (then
        (call $write_ctx
          (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
        (return
          (i32.add
            (i32.const 1)
            (call $throw_type_error_with_message
              (global.get $BUILTIN_MSG_MISSING_ARGUMENT))))))
    (local.set $argument
      (i32.sub
        (local.get $pending_pointer)
        (global.get $VALUE_SIZE)))
    (if (i32.ne
          (call $value_type (local.get $argument))
          (global.get $TYPE_THEOREM))
      (then
        (call $write_ctx
          (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
        (return
          (i32.add
            (i32.const 1)
            (call $throw_type_error_with_message
              (global.get $BUILTIN_MSG_NOT_AN_OBJECT))))))
    (local.set $source_handle
      (call $value_data_lo (local.get $argument)))
    (if (i32.eqz
          (call $proof_native_theorem_handle_valid
            (local.get $source_handle)))
      (then
        (call $write_ctx
          (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
        (return
          (i32.add
            (i32.const 1)
            (call $throw_type_error_with_message
              (global.get $BUILTIN_MSG_NOT_AN_OBJECT))))))
    (if (call $check_heap_overflow (i32.const 24))
      (then (return (i32.const 0))))
    (local.set $pending_pointer
      (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (local.set $argument
      (i32.sub
        (local.get $pending_pointer)
        (global.get $VALUE_SIZE)))
    (local.set $source_handle
      (call $value_data_lo (local.get $argument)))
    (call $write_ctx
      (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (local.set $environment_handle
      (call $proof_native_allocate_shared_term_handle
        (local.get $source_handle)
        (call $proof_native_handle_root (local.get $source_handle))))
    (i32.store
      (call $abs
        (i32.add (local.get $environment_handle) (i32.const 16)))
      (global.get $PROOF_HANDLE_ENVIRONMENT))
    (call $pending_push
      (global.get $TYPE_THEOREM)
      (i32.const 0)
      (local.get $environment_handle)
      (i32.const 0))
    (i32.const 0)
  )

  ;; Compose the expected-constructor source form: the environment's
  ;; declarations, the supplied field sequence, and one source record
  ;; holding the declaration index, constructor index, and field array.
  (func $proof_native_term_expected_constructor
    (param $argument_count i32)
    (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $environment_argument i32)
    (local $declaration_index_argument i32)
    (local $constructor_index_argument i32)
    (local $fields_argument i32)
    (local $environment_handle i32)
    (local $fields_handle i32)
    (local $declaration_index i32)
    (local $constructor_index i32)
    (local $handle i32)
    (local $artifact_base i32)
    (local $node_reference i32)
    (local $fields_root i32)
    (local $declarations i32)
    (local $declaration_reference i32)
    (local $environment_length i32)
    (local $fields_length i32)
    (local $declaration_count i32)
    (local $artifact_length i32)
    (local.set $pending_pointer
      (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (local.set $environment_argument
      (i32.sub
        (local.get $pending_pointer)
        (i32.mul (local.get $argument_count) (global.get $VALUE_SIZE))))
    (local.set $declaration_index_argument
      (i32.add (local.get $environment_argument) (global.get $VALUE_SIZE)))
    (local.set $constructor_index_argument
      (i32.add
        (local.get $declaration_index_argument)
        (global.get $VALUE_SIZE)))
    (local.set $fields_argument
      (i32.add
        (local.get $constructor_index_argument)
        (global.get $VALUE_SIZE)))
    (local.set $declaration_index
      (call $proof_native_nonnegative_integer_argument
        (local.get $declaration_index_argument)))
    (local.set $constructor_index
      (call $proof_native_nonnegative_integer_argument
        (local.get $constructor_index_argument)))
    (if (i32.or
          (i32.lt_s (local.get $declaration_index) (i32.const 0))
          (i32.lt_s (local.get $constructor_index) (i32.const 0)))
      (then
        (call $write_ctx
          (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
        (return
          (i32.add
            (i32.const 1)
            (call $throw_range_error_with_message
              (global.get $BUILTIN_MSG_INVALID_INDEX))))))
    (local.set $environment_handle
      (call $value_data_lo (local.get $environment_argument)))
    (local.set $fields_handle
      (call $value_data_lo (local.get $fields_argument)))
    (local.set $environment_length
      (call $proof_native_term_records_length
        (local.get $environment_handle)))
    (local.set $fields_length
      (call $proof_native_term_records_length (local.get $fields_handle)))
    (local.set $declaration_count
      (call $proof_array_count
        (call $proof_native_handle_artifact_base
          (local.get $environment_handle))
        (call $proof_load
          (call $proof_native_handle_artifact_base
            (local.get $environment_handle))
          (i32.const 12))))
    (local.set $artifact_length
      (i32.add
        (i32.const 48)
        (i32.add
          (i32.add
            (local.get $environment_length)
            (local.get $fields_length))
          (i32.mul (local.get $declaration_count) (i32.const 4)))))
    (if (call $check_heap_overflow
          (call $proof_native_composition_allocation_size
            (local.get $environment_handle) (local.get $fields_handle)
            (i32.const 1) (i32.const 0)))
      (then (return (i32.const 0))))
    (local.set $pending_pointer
      (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (local.set $environment_argument
      (i32.sub
        (local.get $pending_pointer)
        (i32.mul (local.get $argument_count) (global.get $VALUE_SIZE))))
    (local.set $fields_argument
      (i32.add
        (local.get $environment_argument)
        (i32.mul (i32.const 3) (global.get $VALUE_SIZE))))
    (local.set $environment_handle
      (call $value_data_lo (local.get $environment_argument)))
    (local.set $fields_handle
      (call $value_data_lo (local.get $fields_argument)))
    (call $write_ctx
      (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (local.set $handle
      (call $proof_native_compose_binary_term
        (global.get $PROOF_TERM_EXPECTED_CONSTRUCTOR)
        (local.get $constructor_index)
        (i32.const 1)
        (local.get $environment_handle)
        (local.get $fields_handle)
        (i32.const 0)))
    (if (i32.eq (local.get $handle) (i32.const -1))
      (then
        (return
          (i32.add
            (i32.const 1)
            (call $throw_type_error_with_message
              (global.get $BUILTIN_MSG_NOT_AN_OBJECT))))))
    (local.set $artifact_base
      (call $proof_native_handle_artifact_base (local.get $handle)))
    (local.set $node_reference
      (call $proof_native_handle_root (local.get $handle)))
    ;; Rewrite the composed node into the source layout: declaration index,
    ;; constructor index, then the field-array reference.
    (local.set $fields_root
      (call $proof_load
        (local.get $artifact_base)
        (i32.add (local.get $node_reference) (i32.const 12))))
    (call $proof_store
      (local.get $artifact_base)
      (i32.add (local.get $node_reference) (i32.const 8))
      (local.get $declaration_index))
    (call $proof_store
      (local.get $artifact_base)
      (i32.add (local.get $node_reference) (i32.const 12))
      (local.get $constructor_index))
    (call $proof_store
      (local.get $artifact_base)
      (i32.add (local.get $node_reference) (i32.const 16))
      (local.get $fields_root))
    ;; The named declaration must exist and be an inductive family with the
    ;; named constructor.
    (local.set $declarations
      (call $proof_load (local.get $artifact_base) (i32.const 12)))
    (if (i32.ge_u
          (local.get $declaration_index)
          (call $proof_array_count
            (local.get $artifact_base)
            (local.get $declarations)))
      (then
        (return
          (i32.add
            (i32.const 1)
            (call $throw_range_error_with_message
              (global.get $BUILTIN_MSG_INVALID_INDEX))))))
    (local.set $declaration_reference
      (call $proof_array_get
        (local.get $artifact_base)
        (local.get $declarations)
        (local.get $declaration_index)))
    (if (i32.eqz
          (i32.or
            (i32.eq
              (call $proof_load
                (local.get $artifact_base)
                (i32.add (local.get $declaration_reference) (i32.const 4)))
              (global.get $PROOF_RECORD_INDUCTIVE_DECLARATION))
            (i32.eq
              (call $proof_load
                (local.get $artifact_base)
                (i32.add (local.get $declaration_reference) (i32.const 4)))
              (global.get $PROOF_RECORD_COINDUCTIVE_DECLARATION))))
      (then
        (return
          (i32.add
            (i32.const 1)
            (call $throw_type_error_with_message
              (global.get $BUILTIN_MSG_NOT_AN_OBJECT))))))
    (if (i32.ge_u
          (local.get $constructor_index)
          (call $proof_array_count
            (local.get $artifact_base)
            (call $proof_load
              (local.get $artifact_base)
              (i32.add (local.get $declaration_reference) (i32.const 24)))))
      (then
        (return
          (i32.add
            (i32.const 1)
            (call $throw_range_error_with_message
              (global.get $BUILTIN_MSG_INVALID_INDEX))))))
    (call $proof_native_push_term (local.get $handle))
    (i32.const 0)
  )

  ;; Build the expected-record source form: ordered source field names as
  ;; source field descriptors beside the supplied value sequence.
  (func $proof_native_term_record
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_identifier i32) (param $argument_count i32)
    (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $names_argument i32)
    (local $values_argument i32)
    (local $names i32)
    (local $names_data i32)
    (local $count i32)
    (local $index i32)
    (local $name_slot i32)
    (local $name_entry i32)
    (local $name_length i32)
    (local $record_words i32)
    (local $names_words i32)
    (local $values_handle i32)
    (local $values_base i32)
    (local $declaration_count i32)
    (local $values_length i32)
    (local $artifact_length i32)
    (local $workspace_length i32)
    (local $root_reference i32)
    (local $names_array_reference i32)
    (local $declarations_reference i32)
    (local $handle i32)
    (local $artifact_base i32)
    (local $cursor i32)
    (local $values_root i32)
    (local.set $pending_pointer
      (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.ne (local.get $argument_count) (i32.const 2))
      (then
        (call $write_ctx
          (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
        (return
          (i32.add
            (i32.const 1)
            (call $throw_type_error_with_message
              (global.get $BUILTIN_MSG_MISSING_ARGUMENT))))))
    (local.set $names_argument
      (i32.sub
        (local.get $pending_pointer)
        (i32.mul (i32.const 2) (global.get $VALUE_SIZE))))
    (local.set $values_argument
      (i32.add (local.get $names_argument) (global.get $VALUE_SIZE)))
    (if (i32.or
          (i32.ne
            (call $value_type (local.get $names_argument))
            (global.get $TYPE_ARRAY))
          (i32.ne
            (call $value_type (local.get $values_argument))
            (global.get $TYPE_THEOREM)))
      (then
        (call $write_ctx
          (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
        (return
          (i32.add
            (i32.const 1)
            (call $throw_type_error_with_message
              (global.get $BUILTIN_MSG_NOT_AN_OBJECT))))))
    (local.set $values_handle
      (call $value_data_lo (local.get $values_argument)))
    (if (i32.eqz
          (call $proof_native_sequence_handle_valid
            (local.get $values_handle)))
      (then
        (call $write_ctx
          (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
        (return
          (i32.add
            (i32.const 1)
            (call $throw_type_error_with_message
              (global.get $BUILTIN_MSG_NOT_AN_OBJECT))))))
    (local.set $names (call $value_data_lo (local.get $names_argument)))
    (local.set $count
      (i32.load (call $abs (i32.add (local.get $names) (i32.const 12)))))
    (local.set $names_data
      (i32.load (call $abs (i32.add (local.get $names) (i32.const 16)))))
    (local.set $index (i32.const 0))
    (local.set $names_words (i32.const 0))
    (block $names_measured
      (loop $measure_name
        (br_if $names_measured
          (i32.ge_u (local.get $index) (local.get $count)))
        (local.set $name_slot
          (i32.add
            (i32.add (local.get $names_data) (global.get $GC_HEADER_SIZE))
            (i32.mul (local.get $index) (global.get $VALUE_SIZE))))
        (if (i32.ne
              (call $value_type (local.get $name_slot))
              (global.get $TYPE_STRING))
          (then
            (call $write_ctx
              (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
            (return
              (i32.add
                (i32.const 1)
                (call $throw_type_error_with_message
                  (global.get $BUILTIN_MSG_NOT_AN_OBJECT))))))
        (local.set $name_entry
          (call $string_id_to_abs
            (call $value_data_lo (local.get $name_slot))))
        (local.set $name_length (i32.load (local.get $name_entry)))
        (local.set $names_words
          (i32.add
            (local.get $names_words)
            (i32.add
              (i32.const 4)
              (i32.div_u
                (i32.add (local.get $name_length) (i32.const 3))
                (i32.const 4)))))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $measure_name)))
    (local.set $values_length
      (call $proof_native_term_records_length (local.get $values_handle)))
    (local.set $values_base
      (call $proof_native_handle_artifact_base (local.get $values_handle)))
    (local.set $declaration_count
      (call $proof_array_count
        (local.get $values_base)
        (call $proof_load (local.get $values_base) (i32.const 12))))
    (local.set $names_array_reference
      (i32.add
        (i32.add (i32.const 16) (local.get $values_length))
        (i32.mul (local.get $names_words) (i32.const 4))))
    (local.set $root_reference
      (i32.add
        (local.get $names_array_reference)
        (i32.mul
          (i32.add (local.get $count) (i32.const 3))
          (i32.const 4))))
    (local.set $declarations_reference
      (i32.add (local.get $root_reference) (i32.const 16)))
    (local.set $artifact_length
      (i32.add
        (local.get $declarations_reference)
        (i32.mul
          (i32.add (local.get $declaration_count) (i32.const 3))
          (i32.const 4))))
    (local.set $workspace_length
      (i32.const 0))
    (if (call $check_heap_overflow
          (i32.add
            (call $estimate_arraybuffer_size
              (i32.add
                (local.get $artifact_length)
                (local.get $workspace_length)))
            (i32.const 24)))
      (then (return (i32.const 0))))
    ;; Reload rooted arguments after the preflight, then drop the frame.
    (local.set $pending_pointer
      (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (local.set $names_argument
      (i32.sub
        (local.get $pending_pointer)
        (i32.mul (i32.const 2) (global.get $VALUE_SIZE))))
    (local.set $values_argument
      (i32.add (local.get $names_argument) (global.get $VALUE_SIZE)))
    (local.set $names (call $value_data_lo (local.get $names_argument)))
    (local.set $names_data
      (i32.load (call $abs (i32.add (local.get $names) (i32.const 16)))))
    (local.set $values_handle
      (call $value_data_lo (local.get $values_argument)))
    (local.set $values_base
      (call $proof_native_handle_artifact_base (local.get $values_handle)))
    (call $write_ctx
      (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (local.set $handle
      (call $proof_native_allocate_term_handle
        (local.get $artifact_length)
        (local.get $root_reference)
        (local.get $workspace_length)))
    (local.set $artifact_base
      (call $proof_native_handle_artifact_base (local.get $handle)))
    (local.set $values_root
      (call $proof_native_copy_term_records
        (local.get $values_handle)
        (local.get $artifact_base)
        (i32.add (local.get $artifact_base) (i32.const 16))))
    (local.set $cursor (i32.add (i32.const 16) (local.get $values_length)))
    (local.set $index (i32.const 0))
    (block $names_written
      (loop $write_name
        (br_if $names_written
          (i32.ge_u (local.get $index) (local.get $count)))
        (local.set $name_slot
          (i32.add
            (i32.add (local.get $names_data) (global.get $GC_HEADER_SIZE))
            (i32.mul (local.get $index) (global.get $VALUE_SIZE))))
        (local.set $name_entry
          (call $string_id_to_abs
            (call $value_data_lo (local.get $name_slot))))
        (local.set $name_length (i32.load (local.get $name_entry)))
        (local.set $record_words
          (i32.add
            (i32.const 4)
            (i32.div_u
              (i32.add (local.get $name_length) (i32.const 3))
              (i32.const 4))))
        (call $proof_store
          (local.get $artifact_base) (local.get $cursor)
          (local.get $record_words))
        (call $proof_store
          (local.get $artifact_base)
          (i32.add (local.get $cursor) (i32.const 4))
          (global.get $PROOF_RECORD_SOURCE_FIELD))
        (call $proof_store
          (local.get $artifact_base)
