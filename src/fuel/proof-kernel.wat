      (then (return (i32.const 0))))
    (local.set $value (call $proof_substitute_universe_leaf (local.get $artifact_base)
      (local.get $universe_reference) (local.get $arguments_array) (local.get $work)))
    (if (i32.ge_s (local.get $value) (i32.const 0)) (then (return (local.get $value))))
    (local.set $entry (call $proof_level_memo_find (local.get $artifact_base) (local.get $memo)
      (i32.const 5) (local.get $universe_reference) (local.get $arguments_array) (local.get $work)))
    (if (local.get $entry) (then (return (call $proof_array_get
      (local.get $artifact_base) (local.get $entry) (i32.const 3)))))
