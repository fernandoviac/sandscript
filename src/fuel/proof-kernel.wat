    (local.set $artifact_length (i32.const 48))
    (if (i32.ge_u (local.get $argument_count) (i32.const 2))
      (then
        (local.set $scope_argument
          (i32.add (local.get $argument) (global.get $VALUE_SIZE)))
        (if (i32.ne
              (call $value_type (local.get $scope_argument))
