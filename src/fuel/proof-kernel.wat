    (param $b i32) (param $head i32) (param $A i32) (param $left i32) (param $right i32) (result i32)
    
    (call $proof_make_two (local.get $b) (global.get $PROOF_TERM_APPLICATION) (call $proof_make_two (local.get $b) (global.get $PROOF_TERM_APPLICATION) (call $proof_make_two (local.get $b) (global.get $PROOF_TERM_APPLICATION) (local.get $head) (local.get $A)) (local.get $left)) (local.get $right))
  )

  (func $proof_state_equality_refl
    (param $b i32) (param $head i32) (param $A i32) (param $value i32) (result i32)
    
    (call $proof_make_two (local.get $b) (global.get $PROOF_TERM_APPLICATION) (call $proof_make_two (local.get $b) (global.get $PROOF_TERM_APPLICATION) (call $proof_make_three (local.get $b) (global.get $PROOF_TERM_CONSTRUCTOR) (call $proof_load (local.get $b) (i32.add (local.get $head) (i32.const 8))) (i32.const 0) (call $proof_load (local.get $b) (i32.add (local.get $head) (i32.const 12)))) (local.get $A)) (local.get $value))
