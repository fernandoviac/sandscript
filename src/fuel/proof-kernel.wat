          (call $abs
            (i32.add (local.get $artifact_base) (i32.add (local.get $source_array) (i32.const 12))))
          (i32.mul (local.get $count) (i32.const 4)))))
    (call $proof_array_set
      (local.get $artifact_base) (local.get $target_array) (local.get $index) (local.get $value))
    (local.get $target_array)
  )

  (func $proof_context_extend
    (param $artifact_base i32)
    (param $context_reference i32)
    (param $type_reference i32)
    (result i32)
    (local $old_count i32)
    (local $new_context i32)
    (local $index i32)
    (local.set $old_count
      (call $proof_array_count (local.get $artifact_base) (local.get $context_reference)))
    (local.set $new_context
      (call $proof_make_array (local.get $artifact_base) (i32.add (local.get $old_count) (i32.const 1))))
    (if (i32.eqz (local.get $new_context)) (then (return (i32.const 0))))
    (call $proof_array_set (local.get $artifact_base)
      (local.get $new_context) (i32.const 0) (local.get $type_reference))
    (local.set $index (i32.const 0))
    (block $copy_done
      (loop $copy_next
        (br_if $copy_done (i32.ge_u (local.get $index) (local.get $old_count)))
        (call $proof_array_set (local.get $artifact_base)
          (local.get $new_context)
          (i32.add (local.get $index) (i32.const 1))
          (call $proof_array_get (local.get $artifact_base)
            (local.get $context_reference) (local.get $index)))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $copy_next)))
    (local.get $new_context)
  )

  ;; Telescope domains are oldest first, each in its original prefix context.
  ;; Reverse the prefix once instead of repeatedly copying the parent context.
  (func $proof_context_extend_telescope
    (param $base i32) (param $context i32) (param $domains i32)
    (param $count i32) (result i32)
    (local $old_count i32) (local $extended i32) (local $index i32)
    (if (i32.eqz (local.get $count)) (then (return (local.get $context))))
    (local.set $old_count (call $proof_array_count (local.get $base) (local.get $context)))
    (local.set $extended (call $proof_make_array (local.get $base)
      (i32.add (local.get $old_count) (local.get $count))))
    (if (i32.eqz (local.get $extended)) (then (return (i32.const 0))))
    (block $done (loop $next
      (br_if $done (i32.ge_u (local.get $index) (local.get $count)))
      (call $proof_array_set (local.get $base) (local.get $extended)
        (i32.sub (i32.sub (local.get $count) (local.get $index)) (i32.const 1))
        (call $proof_array_get (local.get $base) (local.get $domains) (local.get $index)))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      (br $next)))
    (call $proof_copy_bytes (local.get $base)
      (i32.add (local.get $extended) (i32.add (i32.const 12) (i32.mul (local.get $count) (i32.const 4))))
      (i32.add (local.get $context) (i32.const 12))
      (i32.mul (local.get $old_count) (i32.const 4)))
    (local.get $extended))

