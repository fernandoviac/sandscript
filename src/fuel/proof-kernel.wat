  ;; Lean objects; normalization uses an ordered persistent max spine.
  (func $proof_make_universe_zero (param $base i32) (result i32)
    (call $proof_make_one (local.get $base)
      (global.get $PROOF_RECORD_UNIVERSE_LEVEL) (i32.const 0)))

  (func $proof_make_universe_parameter
    (param $base i32) (param $ordinal i32) (result i32)
    (call $proof_make_two (local.get $base)
      (global.get $PROOF_RECORD_UNIVERSE_LEVEL) (i32.const 1) (local.get $ordinal)))

  (func $proof_universe_successor
    (param $base i32) (param $level i32) (result i32)
    (if (i32.eqz (local.get $level)) (then (return (i32.const 0))))
    (call $proof_make_two (local.get $base)
      (global.get $PROOF_RECORD_UNIVERSE_LEVEL) (i32.const 2) (local.get $level)))

  ;; Per-primitive memo tables live only in the checking scratch arena. They
  ;; never survive an operation or certify a mutable elaboration arena. Every
  ;; probe and DAG node is charged to the caller's shared work budget.
  (func $proof_level_memo_find
    (param $base i32) (param $memo i32) (param $op i32)
    (param $left i32) (param $right i32) (param $work i32) (result i32)
    (local $entry i32)
    (local.set $entry (call $proof_array_get (local.get $base) (local.get $memo) (i32.const 0)))
    (block $missing (loop $next
      (br_if $missing (i32.eqz (local.get $entry)))
      (if (i32.eqz (call $proof_work_debit (local.get $base) (local.get $work)))
        (then (return (i32.const 0))))
      (if (i32.and
            (i32.eq (call $proof_array_get (local.get $base) (local.get $entry) (i32.const 0)) (local.get $op))
            (i32.and
              (i32.eq (call $proof_array_get (local.get $base) (local.get $entry) (i32.const 1)) (local.get $left))
              (i32.eq (call $proof_array_get (local.get $base) (local.get $entry) (i32.const 2)) (local.get $right))))
        (then (return (local.get $entry))))
      (local.set $entry (call $proof_array_get (local.get $base) (local.get $entry) (i32.const 4)))
      (br $next)))
    (i32.const 0))

  (func $proof_level_memo_put
    (param $base i32) (param $memo i32) (param $op i32)
    (param $left i32) (param $right i32) (param $value i32) (param $work i32) (result i32)
    (local $entry i32)
    (if (i32.eqz (call $proof_work_debit (local.get $base) (local.get $work)))
      (then (return (i32.const 0))))
    (local.set $entry (call $proof_make_array (local.get $base) (i32.const 5)))
    (if (i32.eqz (local.get $entry)) (then (return (i32.const 0))))
    (call $proof_array_set (local.get $base) (local.get $entry) (i32.const 0) (local.get $op))
    (call $proof_array_set (local.get $base) (local.get $entry) (i32.const 1) (local.get $left))
    (call $proof_array_set (local.get $base) (local.get $entry) (i32.const 2) (local.get $right))
    (call $proof_array_set (local.get $base) (local.get $entry) (i32.const 3) (local.get $value))
    (call $proof_array_set (local.get $base) (local.get $entry) (i32.const 4)
      (call $proof_array_get (local.get $base) (local.get $memo) (i32.const 0)))
    (call $proof_array_set (local.get $base) (local.get $memo) (i32.const 0) (local.get $entry))
    (local.get $value))

;; Scalar universe predicates avoid memo/frame allocation. Scope validation
;; still requires an authenticated record boundary; cache misses stay scheduled.
(func $proof_universe_scope_valid_leaf
  (param $base i32) (param $level i32) (param $count i32) (param $work i32) (result i32)
  (local $known i32) (local $kind i32) (local $words i32)
  (if (global.get $proof_last_error_code) (then (return (i32.const 0))))
  (local.set $known (call $proof_boundary_cached (local.get $base) (global.get $proof_scratch_cursor) (local.get $level) (local.get $work)))
  (if (i32.le_s (local.get $known) (i32.const 0)) (then (return (local.get $known))))
  (if (i32.ne (call $proof_load (local.get $base) (i32.add (local.get $level) (i32.const 4))) (global.get $PROOF_RECORD_UNIVERSE_LEVEL)) (then (return (i32.const 0))))
  (local.set $words (call $proof_load (local.get $base) (local.get $level)))
  (if (i32.lt_u (local.get $words) (i32.const 3)) (then (return (i32.const 0))))
  (local.set $kind (call $proof_universe_kind (local.get $base) (local.get $level)))
  (if (i32.eqz (local.get $kind)) (then (return (i32.eq (local.get $words) (i32.const 3)))))
  (if (i32.eq (local.get $kind) (i32.const 1)) (then
    (return (i32.and (i32.eq (local.get $words) (i32.const 4))
      (i32.lt_u (call $proof_universe_left (local.get $base) (local.get $level)) (local.get $count))))))
  (if (i32.gt_u (local.get $kind) (i32.const 4)) (then (return (i32.const 0))))
  (i32.const -1))

(func $proof_universe_is_nonzero_leaf
  (param $base i32) (param $level i32) (param $work i32) (result i32)
  (local $kind i32)
  (if (i32.or (global.get $proof_last_error_code) (i32.eqz (local.get $level))) (then (return (i32.const 0))))
  (local.set $kind (call $proof_universe_kind (local.get $base) (local.get $level)))
  (if (i32.eq (local.get $kind) (i32.const 2)) (then (return (i32.const 1))))
  (if (i32.or (i32.eq (local.get $kind) (i32.const 3)) (i32.eq (local.get $kind) (i32.const 4))) (then (return (i32.const -1))))
  (i32.const 0))

(func $proof_universe_structural_equal_leaf
  (param $base i32) (param $left i32) (param $right i32) (param $work i32) (result i32)
  (local $kind i32)
  (if (global.get $proof_last_error_code) (then (return (i32.const 0))))
  (if (i32.or (i32.eqz (local.get $left)) (i32.eqz (local.get $right))) (then (return (i32.const 0))))
  (if (i32.eq (local.get $left) (local.get $right)) (then (return (i32.const 1))))
  (local.set $kind (call $proof_universe_kind (local.get $base) (local.get $left)))
  (if (i32.ne (local.get $kind) (call $proof_universe_kind (local.get $base) (local.get $right))) (then (return (i32.const 0))))
  (if (i32.eqz (local.get $kind)) (then (return (i32.const 1))))
  (if (i32.eq (local.get $kind) (i32.const 1)) (then
    (return (i32.eq (call $proof_universe_left (local.get $base) (local.get $left))
      (call $proof_universe_left (local.get $base) (local.get $right))))))
  (i32.const -1))

(func $proof_universe_scope_valid_memo_leaf
  (param $base i32) (param $level i32) (param $count i32) (param $work i32) (param $memo i32) (result i32)
  (call $proof_universe_scope_valid_leaf (local.get $base) (local.get $level) (local.get $count) (local.get $work)))

(func $proof_universe_is_nonzero_memo_leaf
  (param $base i32) (param $level i32) (param $work i32) (param $memo i32) (result i32)
  (call $proof_universe_is_nonzero_leaf (local.get $base) (local.get $level) (local.get $work)))

(func $proof_universe_structural_equal_memo_leaf
  (param $base i32) (param $left i32) (param $right i32) (param $work i32) (param $memo i32) (result i32)
  (call $proof_universe_structural_equal_leaf (local.get $base) (local.get $left) (local.get $right) (local.get $work)))
  (func $proof_universe_scope_valid
    (param $base i32) (param $level i32) (param $count i32) (param $work i32) (result i32)
    (local $memo i32) (local $value i32)
    (if (i32.eqz (call $proof_work_debit (local.get $base) (local.get $work)))
      (then (return (i32.const 0))))
    (local.set $value (call $proof_universe_scope_valid_leaf (local.get $base) (local.get $level) (local.get $count) (local.get $work)))
    (if (i32.ge_s (local.get $value) (i32.const 0)) (then (return (local.get $value))))
    (local.set $memo (call $proof_make_array (local.get $base) (i32.const 1)))
    (if (i32.eqz (local.get $memo)) (then (return (i32.const 0))))
    (call $proof_array_set (local.get $base) (local.get $memo) (i32.const 0) (i32.const 0))
    (call $proof_universe_scope_valid_memo (local.get $base) (local.get $level) (local.get $count) (local.get $work) (local.get $memo)))

  (func $proof_universe_scope_valid_memo
    (param $base i32) (param $level i32) (param $count i32) (param $work i32) (param $memo i32) (result i32)
    (local $entry i32) (local $value i32)
    (if (i32.eqz (call $proof_work_debit (local.get $base) (local.get $work)))
      (then (return (i32.const 0))))
    (local.set $value (call $proof_universe_scope_valid_leaf (local.get $base) (local.get $level) (local.get $count) (local.get $work)))
    (if (i32.ge_s (local.get $value) (i32.const 0)) (then (return (local.get $value))))
    (local.set $entry (call $proof_level_memo_find (local.get $base) (local.get $memo)
      (i32.const 4) (local.get $level) (local.get $count) (local.get $work)))
    (if (local.get $entry) (then (return (call $proof_array_get
      (local.get $base) (local.get $entry) (i32.const 3)))))
    (if (global.get $proof_last_error_code) (then (return (i32.const 0))))
    (local.set $value (call $proof_universe_scope_valid_uncached (local.get $base) (local.get $level) (local.get $count) (local.get $work) (local.get $memo)))
    (if (global.get $proof_last_error_code) (then (return (i32.const 0))))
    (call $proof_level_memo_put (local.get $base) (local.get $memo)
      (i32.const 4) (local.get $level) (local.get $count) (local.get $value) (local.get $work)))

  (func $proof_universe_scope_valid_uncached
    (param $base i32) (param $level i32) (param $count i32) (param $work i32) (param $memo i32) (result i32)
    (local $kind i32) (local $left i32) (local $right i32) (local $words i32)
    (if (i32.eqz (call $proof_work_debit (local.get $base) (local.get $work)))
      (then (return (i32.const 0))))
    (if (i32.eqz (call $proof_reference_has_tag (local.get $base) (global.get $proof_scratch_cursor)
          (local.get $level) (global.get $PROOF_RECORD_UNIVERSE_LEVEL)))
