        (return (i32.const 1))))
    (i32.const 1)
  )

  (func $proof_infer_recursive_block
    (param $artifact_base i32)
    (param $term_reference i32)
    (param $context_reference i32) (param $work i32)
    (result i32)
    (local $definitions i32)
    (local $definition_count i32)
    (local $definition_index i32)
    (local $selected_definition i32)
    (local $definition i32)
    (local $definition_type i32)
    (local $definition_type_type i32)
    (local $normalized_type_type i32)
    (local $context_size i32)
    (local $term_tag i32)
    (local.set $definitions
      (call $proof_load (local.get $artifact_base)
        (i32.add (local.get $term_reference) (i32.const 8))))
    (if (i32.eqz
          (call $proof_reference_has_tag
            (local.get $artifact_base) (global.get $proof_scratch_cursor)
            (local.get $definitions) (global.get $PROOF_RECORD_ARRAY)))
      (then
        (global.set $proof_last_error_code (i32.const 3))
        (return (i32.const 0))))
    (local.set $definition_count
      (call $proof_array_count (local.get $artifact_base) (local.get $definitions)))
    (local.set $selected_definition
      (call $proof_load (local.get $artifact_base)
        (i32.add (local.get $term_reference) (i32.const 12))))
    (if (i32.ge_u (local.get $selected_definition) (local.get $definition_count))
      (then
        (global.set $proof_last_error_code (i32.const 44))
        (return (i32.const 0))))
    (local.set $definition_index (i32.const 0))
    (block $definition_records_done
      (loop $definition_records_next
        (br_if $definition_records_done
          (i32.ge_u (local.get $definition_index) (local.get $definition_count)))
        (if (i32.eqz
              (call $proof_reference_has_tag
                (local.get $artifact_base) (global.get $proof_scratch_cursor)
                (call $proof_array_get
                  (local.get $artifact_base) (local.get $definitions) (local.get $definition_index))
                (global.get $PROOF_TERM_RECURSIVE_DEFINITION)))
          (then
            (global.set $proof_last_error_code (i32.const 3))
            (return (i32.const 0))))
        (local.set $definition_index
          (i32.add (local.get $definition_index) (i32.const 1)))
        (br $definition_records_next)))
    (local.set $term_tag
      (call $proof_load (local.get $artifact_base)
        (i32.add (local.get $term_reference) (i32.const 4))))
    (if (i32.and
          (i32.eq (local.get $term_tag) (global.get $PROOF_TERM_FIXED_POINT))
          (i32.eqz
            (call $proof_check_structural_recursion
              (local.get $artifact_base) (local.get $term_reference))))
      (then
        (global.set $proof_last_error_code (i32.const 56))
        (return (i32.const 0))))
    (if (i32.and
          (i32.eq (local.get $term_tag) (global.get $PROOF_TERM_COFIXED_POINT))
          (i32.eqz
            (call $proof_check_guarded_corecursion
              (local.get $artifact_base) (local.get $term_reference))))
      (then
        (global.set $proof_last_error_code (i32.const 57))
        (return (i32.const 0))))
    (local.set $context_size
      (call $proof_array_count (local.get $artifact_base) (local.get $context_reference)))
    (local.set $definition_index (i32.const 0))
    (block $types_done
      (loop $types_next
        (br_if $types_done
          (i32.ge_u (local.get $definition_index) (local.get $definition_count)))
        (local.set $definition
          (call $proof_array_get (local.get $artifact_base)
            (local.get $definitions) (local.get $definition_index)))
        (local.set $definition_type
          (call $proof_load (local.get $artifact_base)
            (i32.add (local.get $definition) (i32.const 8))))
        (local.set $definition_type_type
          (call $proof_infer_term
            (local.get $artifact_base) (local.get $definition_type)
            (local.get $context_reference) (i32.const 0) (i32.const 0) (local.get $work)))
        (if (i32.eqz (local.get $definition_type_type))
          (then (return (i32.const 0))))
        (local.set $normalized_type_type
          (call $proof_weak_head_normalize
            (local.get $artifact_base) (local.get $definition_type_type) (local.get $context_reference) (i32.const 0) (i32.const 0) (local.get $work)))
        (if (i32.ne
              (call $proof_load (local.get $artifact_base)
                (i32.add (local.get $normalized_type_type) (i32.const 4)))
              (global.get $PROOF_TERM_SORT))
          (then
            (global.set $proof_last_error_code (i32.const 45))
            (return (i32.const 0))))
        (local.set $definition_index
          (i32.add (local.get $definition_index) (i32.const 1)))
        (br $types_next)))
    (local.set $definition_index (i32.const 0))
    (block $bodies_done
      (loop $bodies_next
        (br_if $bodies_done
          (i32.ge_u (local.get $definition_index) (local.get $definition_count)))
        (local.set $definition
          (call $proof_array_get (local.get $artifact_base)
            (local.get $definitions) (local.get $definition_index)))
        (if (i32.eqz
              (call $proof_check_term
                (local.get $artifact_base)
                (call $proof_load (local.get $artifact_base)
