  (func $proof_render_implicitness
    (param $cursor i32) (param $limit i32) (param $implicit i32)
    (result i32)
    (if (local.get $implicit)
      (then
        (local.set $cursor
          (call $proof_render_packed
            (local.get $cursor) (local.get $limit)
            (i32.const 0x6c706d69) (i32.const 4))))
      (else
        (local.set $cursor
          (call $proof_render_packed
            (local.get $cursor) (local.get $limit)
            (i32.const 0x6c707865) (i32.const 4)))))
    (call $proof_render_packed
      (local.get $cursor) (local.get $limit)
      (i32.const 0x74696369) (i32.const 4))
  )

  ;; record?{name := value, ...} with implicit field names in brackets.
  (func $proof_render_expected_record
    (param $artifact_base i32) (param $reference i32) (param $depth i32)
    (param $cursor i32) (param $limit i32)
    (result i32)
    (local $fields_array i32)
    (local $values_array i32)
    (local $count i32)
    (local $index i32)
    (local $descriptor i32)
    (local $implicit i32)
    (local.set $fields_array
      (call $proof_load
        (local.get $artifact_base)
        (i32.add (local.get $reference) (i32.const 8))))
    (local.set $values_array
      (call $proof_load
        (local.get $artifact_base)
        (i32.add (local.get $reference) (i32.const 12))))
    (local.set $cursor
      (call $proof_render_packed
        (local.get $cursor) (local.get $limit)
        (i32.const 0x6f636572) (i32.const 4)))
    (local.set $cursor
      (call $proof_render_packed
        (local.get $cursor) (local.get $limit)
        (i32.const 0x7b3f6472) (i32.const 4)))
    (local.set $count
      (call $proof_array_count
        (local.get $artifact_base) (local.get $values_array)))
    (block $pairs_done
      (loop $pairs_next
        (br_if $pairs_done (i32.ge_u (local.get $index) (local.get $count)))
        (if (local.get $index)
          (then
            (local.set $cursor
              (call $proof_render_packed
                (local.get $cursor) (local.get $limit)
                (i32.const 0x0000202c) (i32.const 2)))))
        (local.set $descriptor
          (call $proof_array_get
            (local.get $artifact_base)
            (local.get $fields_array)
            (local.get $index)))
        (if (i32.eq
              (call $proof_load
                (local.get $artifact_base)
                (i32.add (local.get $descriptor) (i32.const 4)))
              (global.get $PROOF_RECORD_SOURCE_FIELD))
          (then
            (local.set $implicit
              (call $proof_load
                (local.get $artifact_base)
                (i32.add (local.get $descriptor) (i32.const 12))))
            (if (local.get $implicit)
              (then
                (local.set $cursor
                  (call $proof_render_byte
                    (local.get $cursor) (local.get $limit) (i32.const 91)))))
            (local.set $cursor
              (call $proof_render_field_name
                (local.get $artifact_base)
                (i32.add (local.get $descriptor) (i32.const 16))
                (call $proof_load
                  (local.get $artifact_base)
                  (i32.add (local.get $descriptor) (i32.const 8)))
                (local.get $cursor) (local.get $limit)))
