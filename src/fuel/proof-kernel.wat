                  (call $proof_load (local.get $artifact_base)
                    (i32.add (local.get $term_reference) (i32.const 8)))
                  (local.get $definitions) (local.get $decreasing_index)
                  (local.get $smaller_indices)))
              (i32.eqz
                (call $proof_check_recursive_calls
