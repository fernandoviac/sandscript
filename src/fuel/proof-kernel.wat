      (if (i32.or (i32.ne (call $proof_load (local.get $b) (i32.add (local.get $x) (i32.const 4))) (i32.const 2)) (i32.ne (call $proof_load (local.get $b) (i32.add (local.get $x) (i32.const 8))) (i32.eqz (local.get $i)))) (then (return (i32.const 0))))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $next)))
