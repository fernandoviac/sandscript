       (i32.ne (call $proof_load (local.get $b) (i32.add (local.get $left_type) (i32.const 4))) (global.get $PROOF_TERM_PRODUCT))
       (i32.ne (call $proof_load (local.get $b) (i32.add (local.get $right_type) (i32.const 4))) (global.get $PROOF_TERM_PRODUCT)))
       (then (if (i32.eqz (global.get $proof_last_error_code)) (then (global.set $proof_last_error_code (i32.const 94)))) (return (i32.const 0))))
     (if (i32.eqz (call $proof_convertible (local.get $b) (local.get $a) (local.get $z) (local.get $context) (i32.const 0) (i32.const 0) (local.get $work))) (then
