        (i32.eqz (call $proof_native_scan_open_term (local.get $artifact_base) (local.get $right_reference) (i32.const 2) (i32.const 0) (i32.const 0))))) (then
      (if (call $proof_convertible (local.get $artifact_base) (local.get $left_reference) (local.get $right_reference)
        (local.get $context) (local.get $recursive_definitions) (local.get $recursive_context_size) (local.get $work))
