      (global.get $PROOF_TERM_METAVARIABLE))
    (call $proof_store
      (local.get $artifact_base) (i32.const 24)
      (local.get $identifier))
    (call $proof_store
      (local.get $artifact_base) (i32.const 28)
      (local.get $scope_reference))
    (call $proof_store
      (local.get $artifact_base) (i32.const 32) (i32.const 0))
    (call $proof_native_write_empty_declarations
