  (func $proof_native_binary_term_method
    (param $tag i32)
    (param $has_trailing_index i32)
    (param $right_handle_kind i32)
    (param $argument_count i32)
    (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $first_argument i32)
    (local $second_argument i32)
    (local $third_argument i32)
