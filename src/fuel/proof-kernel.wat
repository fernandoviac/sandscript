                    (local.get $cursor) (local.get $limit) (i32.const 93))))))
          (else
            (local.set $cursor
              (call $proof_render_term
                (local.get $artifact_base) (local.get $descriptor)
                (local.get $depth) (local.get $cursor) (local.get $limit)))))
