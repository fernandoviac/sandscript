  ;; Checked-term scratch arena
  ;; --------------------------------------------------------------------------

  (global $proof_allocation_failure_epoch (mut i32) (i32.const 0))
  (global $proof_scratch_cursor (mut i32) (i32.const 0))
  (global $proof_scratch_limit (mut i32) (i32.const 0))
