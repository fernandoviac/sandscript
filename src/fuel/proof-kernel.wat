  (func $proof_terms_may_unify
    (param $artifact_base i32)
    (param $left_term i32)
    (param $right_term i32)
    (param $context i32) (param $recursive_definitions i32) (param $recursive_context_size i32) (param $work i32)
    (result i32)
    (local $left i32)
    (local $right i32)
    (local $left_tag i32)
    (local $right_tag i32)
    (local $left_head i32)
    (local $right_head i32)
    (local $left_count i32)
    (local $right_count i32)
    (local $index i32)
