  ;; ==========================================================================
  ;; Source-preserving pretty printing. The renderer walks any term-handle
  ;; artifact and writes deterministic UTF-8 into heap-tail scratch. Surface
  ;; forms print their preserved names; kernel terms print fully explicit
  ;; universes, indices, and structure. Output is bounded; truncation appends
  ;; a single ellipsis. The renderer is diagnostic only and never authority.
  ;; ==========================================================================
  (func $proof_render_byte
    (param $cursor i32) (param $limit i32) (param $byte i32)
    (result i32)
    (if (i32.ge_u (local.get $cursor) (local.get $limit))
      (then (return (local.get $cursor))))
    (i32.store8 (call $abs (local.get $cursor)) (local.get $byte))
    (i32.add (local.get $cursor) (i32.const 1))
  )

  ;; Up to four little-endian packed ASCII/UTF-8 bytes.
  (func $proof_render_packed
    (param $cursor i32) (param $limit i32) (param $packed i32) (param $count i32)
    (result i32)
    (local $index i32)
    (block $done
      (loop $next
        (br_if $done (i32.ge_u (local.get $index) (local.get $count)))
        (local.set $cursor
          (call $proof_render_byte
            (local.get $cursor) (local.get $limit)
            (i32.and
              (i32.shr_u
                (local.get $packed)
                (i32.shl (local.get $index) (i32.const 3)))
              (i32.const 255))))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $next)))
    (local.get $cursor)
  )

  (func $proof_render_decimal
    (param $cursor i32) (param $limit i32) (param $value i32)
    (result i32)
    (local $start i32)
    (local $end i32)
    (local $swap_byte i32)
    (if (i32.eqz (local.get $value))
      (then
        (return
          (call $proof_render_byte
            (local.get $cursor) (local.get $limit) (i32.const 48)))))
    (local.set $start (local.get $cursor))
    (block $digits_done
      (loop $digits_next
        (br_if $digits_done (i32.eqz (local.get $value)))
        (local.set $cursor
          (call $proof_render_byte
            (local.get $cursor) (local.get $limit)
            (i32.add
              (i32.rem_u (local.get $value) (i32.const 10))
              (i32.const 48))))
        (local.set $value (i32.div_u (local.get $value) (i32.const 10)))
        (br $digits_next)))
    (local.set $end (i32.sub (local.get $cursor) (i32.const 1)))
    (block $reverse_done
      (loop $reverse_next
        (br_if $reverse_done (i32.ge_u (local.get $start) (local.get $end)))
        (local.set $swap_byte (i32.load8_u (call $abs (local.get $start))))
        (i32.store8
          (call $abs (local.get $start))
          (i32.load8_u (call $abs (local.get $end))))
        (i32.store8 (call $abs (local.get $end)) (local.get $swap_byte))
        (local.set $start (i32.add (local.get $start) (i32.const 1)))
        (local.set $end (i32.sub (local.get $end) (i32.const 1)))
        (br $reverse_next)))
    (local.get $cursor)
  )

  ;; Render exact artifact limbs using bounded heap-tail scratch. This never
  ;; allocates a heap bigint or overwrites the term's immutable payload.
  (func $proof_render_natural
    (param $base i32) (param $term i32) (param $cursor i32) (param $limit i32) (result i32)
    (local $n i32) (local $scratch i32) (local $i i32) (local $start i32) (local $end i32) (local $byte i32)
    (local $carry i64) (local $value i64)
    (local.set $n (call $proof_load (local.get $base) (i32.add (local.get $term) (i32.const 8))))
    (if (i32.eqz (local.get $n))
      (then (return (call $proof_render_byte (local.get $cursor) (local.get $limit) (i32.const 48)))))
    (if (i32.or (i32.ge_u (local.get $cursor) (local.get $limit))
      (i32.gt_u (local.get $n) (i32.div_u (i32.sub (local.get $limit) (local.get $cursor)) (i32.const 14))))
      (then (return (call $proof_render_packed (local.get $cursor) (local.get $limit) (i32.const 0x00a680e2) (i32.const 3)))))
    (local.set $scratch (i32.sub (local.get $limit) (i32.mul (local.get $n) (i32.const 4))))
    (memory.copy (call $abs (local.get $scratch))
      (call $abs (i32.add (local.get $base) (i32.add (local.get $term) (i32.const 12))))
      (i32.mul (local.get $n) (i32.const 4)))
    (local.set $start (local.get $cursor))
    (block $digits_done (loop $digit
      (br_if $digits_done (i32.eqz (local.get $n)))
      (if (i32.ge_u (local.get $cursor) (local.get $scratch)) (then (return (call $proof_render_packed (local.get $cursor) (local.get $limit) (i32.const 0x00a680e2) (i32.const 3)))))
      (local.set $carry (i64.const 0))
      (local.set $i (local.get $n))
      (block $limbs_done (loop $limb
        (br_if $limbs_done (i32.eqz (local.get $i)))
        (local.set $i (i32.sub (local.get $i) (i32.const 1)))
        (local.set $value (i64.or (i64.shl (local.get $carry) (i64.const 32))
          (i64.extend_i32_u (i32.load (call $abs (i32.add (local.get $scratch) (i32.mul (local.get $i) (i32.const 4))))))))
        (i32.store (call $abs (i32.add (local.get $scratch) (i32.mul (local.get $i) (i32.const 4))))
          (i32.wrap_i64 (i64.div_u (local.get $value) (i64.const 10))))
        (local.set $carry (i64.rem_u (local.get $value) (i64.const 10))) (br $limb)))
      (local.set $cursor (call $proof_render_byte (local.get $cursor) (local.get $scratch)
        (i32.add (i32.wrap_i64 (local.get $carry)) (i32.const 48))))
      (if (i32.eqz (i32.load (call $abs (i32.add (local.get $scratch)
        (i32.mul (i32.sub (local.get $n) (i32.const 1)) (i32.const 4))))))
        (then (local.set $n (i32.sub (local.get $n) (i32.const 1)))))
      (br $digit)))
    (local.set $end (i32.sub (local.get $cursor) (i32.const 1)))
    (block $reverse_done (loop $reverse
      (br_if $reverse_done (i32.ge_u (local.get $start) (local.get $end)))
      (local.set $byte (i32.load8_u (call $abs (local.get $start))))
      (i32.store8 (call $abs (local.get $start)) (i32.load8_u (call $abs (local.get $end))))
      (i32.store8 (call $abs (local.get $end)) (local.get $byte))
      (local.set $start (i32.add (local.get $start) (i32.const 1)))
      (local.set $end (i32.sub (local.get $end) (i32.const 1))) (br $reverse)))
    (local.get $cursor)
  )

  ;; Copy an interned string's UTF-8 bytes verbatim.
  (func $proof_render_interned_string
    (param $cursor i32) (param $limit i32) (param $identifier i32)
    (result i32)
    (local $entry i32)
    (local $length i32)
    (local $index i32)
    (local.set $entry (call $string_id_to_abs (local.get $identifier)))
    (local.set $length (i32.load (local.get $entry)))
    (block $done
      (loop $next
        (br_if $done (i32.ge_u (local.get $index) (local.get $length)))
        (local.set $cursor
          (call $proof_render_byte
            (local.get $cursor) (local.get $limit)
            (i32.load8_u
              (i32.add
                (i32.add (local.get $entry) (i32.const 4))
                (local.get $index)))))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $next)))
    (local.get $cursor)
  )

  ;; Copy zero-padded UTF-8 field-descriptor name bytes stored inside a
  ;; SOURCE_FIELD or CONSTRUCTOR_FIELD record.
  (func $proof_render_field_name
    (param $artifact_base i32) (param $name_offset i32) (param $byte_length i32)
    (param $cursor i32) (param $limit i32)
    (result i32)
    (local $index i32)
    (block $done
      (loop $next
        (br_if $done (i32.ge_u (local.get $index) (local.get $byte_length)))
        (local.set $cursor
          (call $proof_render_byte
            (local.get $cursor) (local.get $limit)
            (i32.load8_u
              (call $abs
                (i32.add
                  (i32.add (local.get $artifact_base) (local.get $name_offset))
                  (local.get $index))))))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $next)))
    (local.get $cursor)
  )

  ;; Render the DAG using explicit levels and conditional imax nodes.
  ;; Rendering inspects stored syntax only. It must not allocate or normalize:
  ;; the caller is accumulating output in heap-tail scratch.
  (func $proof_render_level
    (param $artifact_base i32) (param $reference i32)
    (param $cursor i32) (param $limit i32) (result i32)
    (call $proof_render_level_at (local.get $artifact_base) (local.get $reference)
      (local.get $cursor) (local.get $limit) (i32.const 0))
  )

  (func $proof_render_level_at
    (param $base i32) (param $reference i32)
    (param $cursor i32) (param $limit i32) (param $depth i32) (result i32)
    (local $kind i32)
    (if (i32.ge_u (local.get $cursor) (local.get $limit)) (then (return (local.get $cursor))))
    (if (i32.ge_u (local.get $depth) (i32.const 128))
      (then (return (call $proof_render_packed (local.get $cursor) (local.get $limit)
        (i32.const 0x00a680e2) (i32.const 3)))))
    (local.set $kind (call $proof_load (local.get $base) (i32.add (local.get $reference) (i32.const 8))))
    (if (i32.eqz (local.get $kind))
      (then (return (call $proof_render_byte (local.get $cursor) (local.get $limit) (i32.const 48)))))
    (if (i32.eq (local.get $kind) (i32.const 1)) (then
      (local.set $cursor (call $proof_render_byte (local.get $cursor) (local.get $limit) (i32.const 117)))
      (return (call $proof_render_decimal (local.get $cursor) (local.get $limit)
        (i32.add (call $proof_load (local.get $base) (i32.add (local.get $reference) (i32.const 12))) (i32.const 1))))))
    (if (i32.eq (local.get $kind) (i32.const 2)) (then
      (local.set $cursor (call $proof_render_packed (local.get $cursor) (local.get $limit)
        (i32.const 0x63637573) (i32.const 4)))
      (local.set $cursor (call $proof_render_byte (local.get $cursor) (local.get $limit) (i32.const 40))))
    (else
      (if (i32.eq (local.get $kind) (i32.const 4))
        (then (local.set $cursor (call $proof_render_byte (local.get $cursor) (local.get $limit) (i32.const 105)))))
      (local.set $cursor (call $proof_render_packed (local.get $cursor) (local.get $limit)
        (i32.const 0x2878616d) (i32.const 4)))))
    (local.set $cursor (call $proof_render_level_at (local.get $base)
      (call $proof_load (local.get $base) (i32.add (local.get $reference) (i32.const 12)))
      (local.get $cursor) (local.get $limit) (i32.add (local.get $depth) (i32.const 1))))
    (if (i32.ge_u (local.get $kind) (i32.const 3)) (then
      (local.set $cursor (call $proof_render_packed (local.get $cursor) (local.get $limit)
        (i32.const 0x202c) (i32.const 2)))
      (local.set $cursor (call $proof_render_level_at (local.get $base)
        (call $proof_load (local.get $base) (i32.add (local.get $reference) (i32.const 16)))
        (local.get $cursor) (local.get $limit) (i32.add (local.get $depth) (i32.const 1))))))
    (call $proof_render_byte (local.get $cursor) (local.get $limit) (i32.const 41))
  )

  ;; Render a reference's universe-argument array as {level, ...} when the
  ;; array is not empty.
  (func $proof_render_universe_arguments
    (param $artifact_base i32) (param $array_reference i32)
    (param $cursor i32) (param $limit i32)
    (result i32)
    (local $count i32)
    (local $index i32)
    (local.set $count
      (call $proof_array_count
        (local.get $artifact_base) (local.get $array_reference)))
    (if (i32.eqz (local.get $count))
      (then (return (local.get $cursor))))
    (local.set $cursor
      (call $proof_render_byte
        (local.get $cursor) (local.get $limit) (i32.const 123)))
    (block $levels_done
      (loop $levels_next
        (br_if $levels_done (i32.ge_u (local.get $index) (local.get $count)))
        (if (local.get $index)
          (then
            (local.set $cursor
              (call $proof_render_packed
                (local.get $cursor) (local.get $limit)
                (i32.const 0x0000202c) (i32.const 2)))))
        (local.set $cursor
          (call $proof_render_level
            (local.get $artifact_base)
            (call $proof_array_get
              (local.get $artifact_base)
              (local.get $array_reference)
              (local.get $index))
            (local.get $cursor) (local.get $limit)))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $levels_next)))
    (call $proof_render_byte
      (local.get $cursor) (local.get $limit) (i32.const 125))
  )

  ;; Render a branch array as "ordinal => body, ..." without brackets.
  (func $proof_render_branches
    (param $artifact_base i32) (param $array_reference i32) (param $depth i32)
    (param $cursor i32) (param $limit i32)
    (result i32)
    (local $count i32)
    (local $index i32)
    (local $branch i32)
    (local.set $count
      (call $proof_array_count
        (local.get $artifact_base) (local.get $array_reference)))
    (block $branches_done
      (loop $branches_next
        (br_if $branches_done (i32.ge_u (local.get $index) (local.get $count)))
        (if (local.get $index)
          (then
            (local.set $cursor
              (call $proof_render_packed
                (local.get $cursor) (local.get $limit)
                (i32.const 0x0000202c) (i32.const 2)))))
        (local.set $branch
          (call $proof_array_get
            (local.get $artifact_base)
            (local.get $array_reference)
            (local.get $index)))
        (local.set $cursor
          (call $proof_render_term
            (local.get $artifact_base) (local.get $branch) (local.get $depth)
            (local.get $cursor) (local.get $limit)))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $branches_next)))
    (local.get $cursor)
  )

  (func $proof_render_term
    (param $artifact_base i32) (param $reference i32) (param $depth i32)
    (param $cursor i32) (param $limit i32)
    (result i32)
    (local $tag i32)
    (local $first i32)
    (local $count i32)
    (local $index i32)
    (if (i32.gt_u (local.get $depth) (i32.const 128))
      (then
        (return
          (call $proof_render_packed
            (local.get $cursor) (local.get $limit)
            (i32.const 0x00a680e2) (i32.const 3)))))
    (local.set $depth (i32.add (local.get $depth) (i32.const 1)))
    (local.set $tag
      (call $proof_load
        (local.get $artifact_base)
        (i32.add (local.get $reference) (i32.const 4))))

    (if (i32.eq (local.get $tag) (global.get $PROOF_TERM_SORT))
      (then
        (local.set $first
          (call $proof_load
            (local.get $artifact_base)
            (i32.add (local.get $reference) (i32.const 8))))
        ;; Rendering is allocation-free while its output occupies heap-tail
        ;; scratch. Keep nontrivial levels explicit instead of normalizing.
        (if (i32.eqz (call $proof_load (local.get $artifact_base)
          (i32.add (local.get $first) (i32.const 8))))
          (then
            (return
              (call $proof_render_packed
                (local.get $cursor) (local.get $limit)
                (i32.const 0x706f7250) (i32.const 4)))))
        (local.set $cursor
          (call $proof_render_packed
            (local.get $cursor) (local.get $limit)
            (i32.const 0x74726f53) (i32.const 4)))
        (local.set $cursor
          (call $proof_render_byte
            (local.get $cursor) (local.get $limit) (i32.const 40)))
        (local.set $cursor
          (call $proof_render_level
            (local.get $artifact_base) (local.get $first)
            (local.get $cursor) (local.get $limit)))
        (return
          (call $proof_render_byte
            (local.get $cursor) (local.get $limit) (i32.const 41)))))

    (if (i32.eq (local.get $tag) (global.get $PROOF_TERM_BOUND))
      (then
        (local.set $cursor
          (call $proof_render_byte
            (local.get $cursor) (local.get $limit) (i32.const 35)))
        (return
          (call $proof_render_decimal
            (local.get $cursor) (local.get $limit)
            (call $proof_load
              (local.get $artifact_base)
              (i32.add (local.get $reference) (i32.const 8)))))))

    (if (i32.eq (local.get $tag) (global.get $PROOF_TERM_GLOBAL))
      (then
        (local.set $cursor
          (call $proof_render_packed
            (local.get $cursor) (local.get $limit)
            (i32.const 0x626f6c67) (i32.const 4)))
        (local.set $cursor
          (call $proof_render_packed
            (local.get $cursor) (local.get $limit)
            (i32.const 0x00286c61) (i32.const 3)))
        (local.set $cursor
          (call $proof_render_decimal
            (local.get $cursor) (local.get $limit)
            (call $proof_load
              (local.get $artifact_base)
              (i32.add (local.get $reference) (i32.const 8)))))
        (local.set $cursor
          (call $proof_render_byte
            (local.get $cursor) (local.get $limit) (i32.const 41)))
        (return
          (call $proof_render_universe_arguments
            (local.get $artifact_base)
            (call $proof_load
              (local.get $artifact_base)
              (i32.add (local.get $reference) (i32.const 12)))
            (local.get $cursor) (local.get $limit)))))

    (if (i32.eq (local.get $tag) (global.get $PROOF_TERM_INDUCTIVE))
      (then
        (local.set $cursor
          (call $proof_render_packed
            (local.get $cursor) (local.get $limit)
            (i32.const 0x75646e69) (i32.const 4)))
        (local.set $cursor
          (call $proof_render_packed
            (local.get $cursor) (local.get $limit)
            (i32.const 0x76697463) (i32.const 4)))
        (local.set $cursor
          (call $proof_render_packed
            (local.get $cursor) (local.get $limit)
            (i32.const 0x00002865) (i32.const 2)))
        (local.set $cursor
          (call $proof_render_decimal
            (local.get $cursor) (local.get $limit)
            (call $proof_load
              (local.get $artifact_base)
              (i32.add (local.get $reference) (i32.const 8)))))
        (local.set $cursor
          (call $proof_render_byte
            (local.get $cursor) (local.get $limit) (i32.const 41)))
        (return
          (call $proof_render_universe_arguments
            (local.get $artifact_base)
            (call $proof_load
              (local.get $artifact_base)
              (i32.add (local.get $reference) (i32.const 12)))
            (local.get $cursor) (local.get $limit)))))

    (if (i32.eq (local.get $tag) (global.get $PROOF_TERM_CONSTRUCTOR))
      (then
        (local.set $cursor
          (call $proof_render_packed
            (local.get $cursor) (local.get $limit)
            (i32.const 0x736e6f63) (i32.const 4)))
        (local.set $cursor
          (call $proof_render_packed
            (local.get $cursor) (local.get $limit)
            (i32.const 0x63757274) (i32.const 4)))
        (local.set $cursor
          (call $proof_render_packed
            (local.get $cursor) (local.get $limit)
            (i32.const 0x28726f74) (i32.const 4)))
        (local.set $cursor
          (call $proof_render_decimal
            (local.get $cursor) (local.get $limit)
            (call $proof_load
              (local.get $artifact_base)
              (i32.add (local.get $reference) (i32.const 8)))))
        (local.set $cursor
          (call $proof_render_packed
            (local.get $cursor) (local.get $limit)
            (i32.const 0x0000202c) (i32.const 2)))
        (local.set $cursor
          (call $proof_render_decimal
            (local.get $cursor) (local.get $limit)
            (call $proof_load
              (local.get $artifact_base)
              (i32.add (local.get $reference) (i32.const 12)))))
        (local.set $cursor
          (call $proof_render_byte
            (local.get $cursor) (local.get $limit) (i32.const 41)))
        (return
          (call $proof_render_universe_arguments
            (local.get $artifact_base)
            (call $proof_load
              (local.get $artifact_base)
              (i32.add (local.get $reference) (i32.const 16)))
            (local.get $cursor) (local.get $limit)))))

    (if (i32.or
          (i32.eq (local.get $tag) (global.get $PROOF_TERM_PRODUCT))
          (i32.eq (local.get $tag) (global.get $PROOF_TERM_LAMBDA)))
      (then
        (if (i32.eq (local.get $tag) (global.get $PROOF_TERM_PRODUCT))
          (then
            (local.set $cursor
              (call $proof_render_packed
                (local.get $cursor) (local.get $limit)
                (i32.const 0x0028a0ce) (i32.const 3))))
          (else
            (local.set $cursor
              (call $proof_render_packed
                (local.get $cursor) (local.get $limit)
                (i32.const 0x0028bbce) (i32.const 3)))))
        (local.set $cursor
          (call $proof_render_term
            (local.get $artifact_base)
            (call $proof_load
              (local.get $artifact_base)
              (i32.add (local.get $reference) (i32.const 8)))
            (local.get $depth) (local.get $cursor) (local.get $limit)))
        (local.set $cursor
          (call $proof_render_packed
            (local.get $cursor) (local.get $limit)
            (i32.const 0x00202e29) (i32.const 3)))
        (return
          (call $proof_render_term
            (local.get $artifact_base)
            (call $proof_load
              (local.get $artifact_base)
              (i32.add (local.get $reference) (i32.const 12)))
            (local.get $depth) (local.get $cursor) (local.get $limit)))))

    (if (i32.eq (local.get $tag) (global.get $PROOF_TERM_APPLICATION))
      (then
        (local.set $cursor
          (call $proof_render_byte
            (local.get $cursor) (local.get $limit) (i32.const 40)))
        (local.set $cursor
          (call $proof_render_term
            (local.get $artifact_base)
            (call $proof_load
              (local.get $artifact_base)
              (i32.add (local.get $reference) (i32.const 8)))
            (local.get $depth) (local.get $cursor) (local.get $limit)))
        (local.set $cursor
          (call $proof_render_byte
            (local.get $cursor) (local.get $limit) (i32.const 32)))
        (local.set $cursor
          (call $proof_render_term
            (local.get $artifact_base)
            (call $proof_load
              (local.get $artifact_base)
              (i32.add (local.get $reference) (i32.const 12)))
            (local.get $depth) (local.get $cursor) (local.get $limit)))
        (return
          (call $proof_render_byte
            (local.get $cursor) (local.get $limit) (i32.const 41)))))

    (if (i32.eq (local.get $tag) (global.get $PROOF_TERM_LOCAL_DEFINITION))
      (then
        (local.set $cursor
          (call $proof_render_packed
            (local.get $cursor) (local.get $limit)
            (i32.const 0x2874656c) (i32.const 4)))
        (local.set $cursor
          (call $proof_render_term
            (local.get $artifact_base)
            (call $proof_load
              (local.get $artifact_base)
              (i32.add (local.get $reference) (i32.const 12)))
            (local.get $depth) (local.get $cursor) (local.get $limit)))
        (local.set $cursor
          (call $proof_render_packed
            (local.get $cursor) (local.get $limit)
            (i32.const 0x00203a20) (i32.const 3)))
        (local.set $cursor
          (call $proof_render_term
            (local.get $artifact_base)
            (call $proof_load
              (local.get $artifact_base)
              (i32.add (local.get $reference) (i32.const 8)))
            (local.get $depth) (local.get $cursor) (local.get $limit)))
        (local.set $cursor
          (call $proof_render_packed
            (local.get $cursor) (local.get $limit)
            (i32.const 0x00202e29) (i32.const 3)))
        (return
          (call $proof_render_term
            (local.get $artifact_base)
            (call $proof_load
              (local.get $artifact_base)
              (i32.add (local.get $reference) (i32.const 16)))
            (local.get $depth) (local.get $cursor) (local.get $limit)))))

    (if (i32.eq (local.get $tag) (global.get $PROOF_TERM_MATCH))
      (then
        (local.set $cursor
          (call $proof_render_packed
            (local.get $cursor) (local.get $limit)
            (i32.const 0x6374616d) (i32.const 4)))
        (local.set $cursor
          (call $proof_render_packed
            (local.get $cursor) (local.get $limit)
            (i32.const 0x00002868) (i32.const 2)))
        (local.set $cursor
          (call $proof_render_term
            (local.get $artifact_base)
            (call $proof_load
              (local.get $artifact_base)
              (i32.add (local.get $reference) (i32.const 8)))
            (local.get $depth) (local.get $cursor) (local.get $limit)))
        (local.set $cursor
          (call $proof_render_packed
            (local.get $cursor) (local.get $limit)
            (i32.const 0x0000203b) (i32.const 2)))
        (local.set $cursor
          (call $proof_render_term
            (local.get $artifact_base)
            (call $proof_load
              (local.get $artifact_base)
              (i32.add (local.get $reference) (i32.const 12)))
            (local.get $depth) (local.get $cursor) (local.get $limit)))
        (local.set $cursor
          (call $proof_render_packed
            (local.get $cursor) (local.get $limit)
            (i32.const 0x0000203b) (i32.const 2)))
        (local.set $cursor
          (call $proof_render_branches
            (local.get $artifact_base)
            (call $proof_load
              (local.get $artifact_base)
              (i32.add (local.get $reference) (i32.const 16)))
            (local.get $depth) (local.get $cursor) (local.get $limit)))
        (return
          (call $proof_render_byte
            (local.get $cursor) (local.get $limit) (i32.const 41)))))

    (if (i32.or
          (i32.eq (local.get $tag) (global.get $PROOF_TERM_FIXED_POINT))
          (i32.eq (local.get $tag) (global.get $PROOF_TERM_COFIXED_POINT)))
      (then
        (if (i32.eq (local.get $tag) (global.get $PROOF_TERM_COFIXED_POINT))
          (then
            (local.set $cursor
              (call $proof_render_packed
                (local.get $cursor) (local.get $limit)
                (i32.const 0x00006f63) (i32.const 2)))))
        (local.set $cursor
          (call $proof_render_packed
            (local.get $cursor) (local.get $limit)
            (i32.const 0x65786966) (i32.const 4)))
        (local.set $cursor
          (call $proof_render_packed
            (local.get $cursor) (local.get $limit)
            (i32.const 0x696f5064) (i32.const 4)))
        (local.set $cursor
          (call $proof_render_packed
            (local.get $cursor) (local.get $limit)
            (i32.const 0x0028746e) (i32.const 3)))
        (local.set $cursor
          (call $proof_render_term
            (local.get $artifact_base)
            (call $proof_load
              (local.get $artifact_base)
