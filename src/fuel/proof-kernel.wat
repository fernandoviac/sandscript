              (call $proof_universe_left (local.get $base) (local.get $level)) (local.get $work) (local.get $memo))
          (then (return (i32.const 1))))
        (return (call $proof_universe_is_nonzero_memo (local.get $base)
          (call $proof_universe_right (local.get $base) (local.get $level)) (local.get $work) (local.get $memo)))))
    (i32.const 0))

  (func $proof_universe_structural_equal
    (param $base i32) (param $left i32) (param $right i32) (param $work i32) (result i32)
    (local $memo i32) (local $value i32)
    (if (i32.eqz (call $proof_work_debit (local.get $base) (local.get $work)))
      (then (return (i32.const 0))))
    (local.set $value (call $proof_universe_structural_equal_leaf (local.get $base) (local.get $left) (local.get $right) (local.get $work)))
    (if (i32.ge_s (local.get $value) (i32.const 0)) (then (return (local.get $value))))
    (local.set $memo (call $proof_make_array (local.get $base) (i32.const 1)))
    (if (i32.eqz (local.get $memo)) (then (return (i32.const 0))))
    (call $proof_array_set (local.get $base) (local.get $memo) (i32.const 0) (i32.const 0))
    (call $proof_universe_structural_equal_memo (local.get $base) (local.get $left) (local.get $right) (local.get $work) (local.get $memo)))

  (func $proof_universe_structural_equal_memo
    (param $base i32) (param $left i32) (param $right i32) (param $work i32) (param $memo i32) (result i32)
    (local $entry i32) (local $value i32)
    (if (i32.eqz (call $proof_work_debit (local.get $base) (local.get $work)))
      (then (return (i32.const 0))))
    (local.set $value (call $proof_universe_structural_equal_leaf (local.get $base) (local.get $left) (local.get $right) (local.get $work)))
    (if (i32.ge_s (local.get $value) (i32.const 0)) (then (return (local.get $value))))
    (local.set $entry (call $proof_level_memo_find (local.get $base) (local.get $memo)
      (i32.const 1) (local.get $left) (local.get $right) (local.get $work)))
    (if (local.get $entry) (then (return (call $proof_array_get
      (local.get $base) (local.get $entry) (i32.const 3)))))
    (if (global.get $proof_last_error_code) (then (return (i32.const 0))))
    (local.set $value (call $proof_universe_structural_equal_uncached (local.get $base) (local.get $left) (local.get $right) (local.get $work) (local.get $memo)))
    (if (global.get $proof_last_error_code) (then (return (i32.const 0))))
    (call $proof_level_memo_put (local.get $base) (local.get $memo)
      (i32.const 1) (local.get $left) (local.get $right) (local.get $value) (local.get $work)))

  (func $proof_universe_structural_equal_uncached
    (param $base i32) (param $left i32) (param $right i32) (param $work i32) (param $memo i32) (result i32)
    (local $kind i32)
    (if (i32.eqz (call $proof_work_debit (local.get $base) (local.get $work)))
      (then (return (i32.const 0))))
    (if (i32.or (i32.eqz (local.get $left)) (i32.eqz (local.get $right)))
      (then (return (i32.const 0))))
    (if (i32.eq (local.get $left) (local.get $right)) (then (return (i32.const 1))))
    (local.set $kind (call $proof_universe_kind (local.get $base) (local.get $left)))
    (if (i32.ne (local.get $kind)
          (call $proof_universe_kind (local.get $base) (local.get $right)))
      (then (return (i32.const 0))))
    (if (i32.eqz (local.get $kind)) (then (return (i32.const 1))))
    (if (i32.eq (local.get $kind) (i32.const 1))
      (then (return (i32.eq
        (call $proof_universe_left (local.get $base) (local.get $left))
        (call $proof_universe_left (local.get $base) (local.get $right))))))
    (if (i32.eqz (call $proof_universe_structural_equal_memo (local.get $base)
          (call $proof_universe_left (local.get $base) (local.get $left))
          (call $proof_universe_left (local.get $base) (local.get $right)) (local.get $work) (local.get $memo)))
      (then (return (i32.const 0))))
    (if (i32.eq (local.get $kind) (i32.const 2)) (then (return (i32.const 1))))
    (call $proof_universe_structural_equal_memo (local.get $base)
      (call $proof_universe_right (local.get $base) (local.get $left))
      (call $proof_universe_right (local.get $base) (local.get $right)) (local.get $work) (local.get $memo)))

  (func $proof_universe_offset_base (param $base i32) (param $level i32) (param $work i32) (result i32)
    (if (i32.eqz (call $proof_work_debit (local.get $base) (local.get $work)))
      (then (return (i32.const 0))))
    (block $done (loop $next
    (if (i32.eqz (call $proof_work_debit (local.get $base) (local.get $work)))
      (then (return (i32.const 0))))
      (br_if $done (i32.ne (call $proof_universe_kind (local.get $base) (local.get $level)) (i32.const 2)))
      (local.set $level (call $proof_universe_left (local.get $base) (local.get $level)))
      (br $next)))
    (local.get $level))

  (func $proof_universe_offset (param $base i32) (param $level i32) (param $work i32) (result i32)
    (local $offset i32)
    (if (i32.eqz (call $proof_work_debit (local.get $base) (local.get $work)))
      (then (return (i32.const 0))))
    (block $done (loop $next
    (if (i32.eqz (call $proof_work_debit (local.get $base) (local.get $work)))
      (then (return (i32.const 0))))
      (br_if $done (i32.ne (call $proof_universe_kind (local.get $base) (local.get $level)) (i32.const 2)))
      (local.set $offset (i32.add (local.get $offset) (i32.const 1)))
      (local.set $level (call $proof_universe_left (local.get $base) (local.get $level)))
      (br $next)))
    (local.get $offset))

  (func $proof_universe_add_offset
    (param $base i32) (param $level i32) (param $offset i32) (param $work i32) (result i32)
    (if (i32.eqz (call $proof_work_debit (local.get $base) (local.get $work)))
      (then (return (i32.const 0))))
    (block $done (loop $next
    (if (i32.eqz (call $proof_work_debit (local.get $base) (local.get $work)))
      (then (return (i32.const 0))))
      (br_if $done (i32.eqz (local.get $offset)))
      (local.set $level (call $proof_universe_successor (local.get $base) (local.get $level)))
      (if (i32.eqz (local.get $level)) (then (return (i32.const 0))))
      (local.set $offset (i32.sub (local.get $offset) (i32.const 1)))
      (br $next)))
    (local.get $level))

  (func $proof_universe_maximum
    (param $base i32) (param $left i32) (param $right i32) (param $work i32) (result i32)
    (if (i32.eqz (call $proof_work_debit (local.get $base) (local.get $work)))
      (then (return (i32.const 0))))
    (if (i32.or (i32.eqz (local.get $left)) (i32.eqz (local.get $right)))
      (then (return (i32.const 0))))
    (if (call $proof_universe_structural_equal (local.get $base) (local.get $left) (local.get $right) (local.get $work))
      (then (return (local.get $left))))
    (if (i32.eqz (call $proof_universe_kind (local.get $base) (local.get $left)))
      (then (return (local.get $right))))
    (if (i32.eqz (call $proof_universe_kind (local.get $base) (local.get $right)))
      (then (return (local.get $left))))
    (if (i32.eq (call $proof_universe_kind (local.get $base) (local.get $right)) (i32.const 3))
      (then
        (if (i32.or
              (call $proof_universe_structural_equal (local.get $base) (local.get $left)
                (call $proof_universe_left (local.get $base) (local.get $right)) (local.get $work))
              (call $proof_universe_structural_equal (local.get $base) (local.get $left)
                (call $proof_universe_right (local.get $base) (local.get $right)) (local.get $work)))
          (then (return (local.get $right))))))
    (if (i32.eq (call $proof_universe_kind (local.get $base) (local.get $left)) (i32.const 3))
      (then
        (if (i32.or
              (call $proof_universe_structural_equal (local.get $base) (local.get $right)
                (call $proof_universe_left (local.get $base) (local.get $left)) (local.get $work))
              (call $proof_universe_structural_equal (local.get $base) (local.get $right)
                (call $proof_universe_right (local.get $base) (local.get $left)) (local.get $work)))
          (then (return (local.get $left))))))
    (if (call $proof_universe_structural_equal (local.get $base)
          (call $proof_universe_offset_base (local.get $base) (local.get $left) (local.get $work))
          (call $proof_universe_offset_base (local.get $base) (local.get $right) (local.get $work)) (local.get $work))
      (then (return (select (local.get $left) (local.get $right)
        (i32.ge_u (call $proof_universe_offset (local.get $base) (local.get $left) (local.get $work))
          (call $proof_universe_offset (local.get $base) (local.get $right) (local.get $work)))))))
    (call $proof_make_three (local.get $base) (global.get $PROOF_RECORD_UNIVERSE_LEVEL)
      (i32.const 3) (local.get $left) (local.get $right)))

  (func $proof_universe_imax
    (param $base i32) (param $left i32) (param $right i32) (param $work i32) (result i32)
    (if (i32.eqz (call $proof_work_debit (local.get $base) (local.get $work)))
      (then (return (i32.const 0))))
    (if (i32.or (i32.eqz (local.get $left)) (i32.eqz (local.get $right)))
      (then (return (i32.const 0))))
    (if (call $proof_universe_is_nonzero (local.get $base) (local.get $right) (local.get $work))
      (then (return (call $proof_universe_maximum (local.get $base) (local.get $left) (local.get $right) (local.get $work)))))
    (if (i32.eqz (call $proof_universe_kind (local.get $base) (local.get $right)))
      (then (return (local.get $right))))
    (if (i32.eqz (call $proof_universe_kind (local.get $base) (local.get $left)))
      (then (return (local.get $right))))
    (if (i32.eq (call $proof_universe_kind (local.get $base) (local.get $left)) (i32.const 2))
      (then
        (if (i32.eqz (call $proof_universe_kind (local.get $base)
              (call $proof_universe_left (local.get $base) (local.get $left))))
          (then (return (local.get $right))))))
    (if (call $proof_universe_structural_equal (local.get $base) (local.get $left) (local.get $right) (local.get $work))
      (then (return (local.get $left))))
    (call $proof_make_three (local.get $base) (global.get $PROOF_RECORD_UNIVERSE_LEVEL)
      (i32.const 4) (local.get $left) (local.get $right)))

  ;; Total structural order after stripping successor offsets. Parameters are
  ;; ordered by their declaration-local ordinal, never by allocation address.
  (func $proof_universe_normal_order
    (param $base i32) (param $left i32) (param $right i32) (param $work i32) (result i32)
    (local $a i32) (local $b i32) (local $ka i32) (local $kb i32)
    (if (i32.eqz (call $proof_work_debit (local.get $base) (local.get $work)))
      (then (return (i32.const 0))))
    (local.set $a (call $proof_universe_offset_base (local.get $base) (local.get $left) (local.get $work)))
    (local.set $b (call $proof_universe_offset_base (local.get $base) (local.get $right) (local.get $work)))
    (if (call $proof_universe_structural_equal (local.get $base) (local.get $a) (local.get $b) (local.get $work))
      (then (return (i32.lt_u (call $proof_universe_offset (local.get $base) (local.get $left) (local.get $work))
        (call $proof_universe_offset (local.get $base) (local.get $right) (local.get $work))))))
    (local.set $ka (call $proof_universe_kind (local.get $base) (local.get $a)))
    (local.set $kb (call $proof_universe_kind (local.get $base) (local.get $b)))
    (if (i32.ne (local.get $ka) (local.get $kb))
      (then (return (i32.lt_u (local.get $ka) (local.get $kb)))))
    (if (i32.eq (local.get $ka) (i32.const 1))
      (then (return (i32.lt_u (call $proof_universe_left (local.get $base) (local.get $a))
        (call $proof_universe_left (local.get $base) (local.get $b))))))
    (if (call $proof_universe_structural_equal (local.get $base)
          (call $proof_universe_left (local.get $base) (local.get $a))
          (call $proof_universe_left (local.get $base) (local.get $b)) (local.get $work))
      (then (return (call $proof_universe_normal_order (local.get $base)
        (call $proof_universe_right (local.get $base) (local.get $a))
        (call $proof_universe_right (local.get $base) (local.get $b)) (local.get $work)))))
    (call $proof_universe_normal_order (local.get $base)
      (call $proof_universe_left (local.get $base) (local.get $a))
      (call $proof_universe_left (local.get $base) (local.get $b)) (local.get $work)))

  ;; Ordered union of normalized max spines, with same-base offset absorption.
  (func $proof_universe_normal_union
    (param $base i32) (param $left i32) (param $right i32) (param $work i32) (result i32)
    (if (i32.eqz (call $proof_work_debit (local.get $base) (local.get $work)))
      (then (return (i32.const 0))))
    (if (i32.or (i32.eqz (local.get $left)) (i32.eqz (local.get $right)))
      (then (return (i32.const 0))))
    (call $proof_universe_collect_max (local.get $base) (local.get $left)
      (call $proof_universe_collect_max (local.get $base) (local.get $right) (i32.const 0) (local.get $work)) (local.get $work)))

  (func $proof_universe_collect_max
    (param $base i32) (param $tree i32) (param $acc i32) (param $work i32) (result i32)
    (if (i32.eqz (call $proof_work_debit (local.get $base) (local.get $work)))
      (then (return (i32.const 0))))
    (if (i32.eq (call $proof_universe_kind (local.get $base) (local.get $tree)) (i32.const 3))
      (then (return (call $proof_universe_collect_max (local.get $base)
        (call $proof_universe_left (local.get $base) (local.get $tree))
        (call $proof_universe_collect_max (local.get $base)
          (call $proof_universe_right (local.get $base) (local.get $tree)) (local.get $acc) (local.get $work)) (local.get $work)))))
    (if (i32.eqz (local.get $acc)) (then (return (local.get $tree))))
    (call $proof_universe_merge_max (local.get $base) (local.get $tree) (local.get $acc) (local.get $work)))

  (func $proof_universe_merge_max
    (param $base i32) (param $left i32) (param $right i32) (param $work i32) (result i32)
    (local $a i32) (local $b i32) (local $at i32) (local $bt i32)
    (local $tail i32) (local $oa i32) (local $ob i32)
    (if (i32.eqz (call $proof_work_debit (local.get $base) (local.get $work)))
      (then (return (i32.const 0))))
    (if (i32.or (i32.eqz (local.get $left)) (i32.eqz (local.get $right)))
      (then (return (i32.const 0))))
    (local.set $a (local.get $left))
    (local.set $b (local.get $right))
    (if (i32.eq (call $proof_universe_kind (local.get $base) (local.get $a)) (i32.const 3))
      (then
        (local.set $at (call $proof_universe_right (local.get $base) (local.get $a)))
        (local.set $a (call $proof_universe_left (local.get $base) (local.get $a)))))
    (if (i32.eq (call $proof_universe_kind (local.get $base) (local.get $b)) (i32.const 3))
      (then
        (local.set $bt (call $proof_universe_right (local.get $base) (local.get $b)))
        (local.set $b (call $proof_universe_left (local.get $base) (local.get $b)))))
    (if (call $proof_universe_structural_equal (local.get $base)
          (call $proof_universe_offset_base (local.get $base) (local.get $a) (local.get $work))
          (call $proof_universe_offset_base (local.get $base) (local.get $b) (local.get $work)) (local.get $work))
      (then
        (local.set $a (call $proof_universe_maximum (local.get $base) (local.get $a) (local.get $b) (local.get $work)))
        (local.set $tail (local.get $at))
        (if (local.get $bt)
          (then
            (local.set $tail (local.get $bt))
            (if (local.get $at)
              (then (local.set $tail (call $proof_universe_merge_max
                (local.get $base) (local.get $at) (local.get $bt) (local.get $work)))))))
        (if (i32.eqz (local.get $tail)) (then (return (local.get $a))))
        (return (call $proof_universe_merge_max (local.get $base) (local.get $a) (local.get $tail) (local.get $work)))))
    (if (call $proof_universe_normal_order (local.get $base) (local.get $b) (local.get $a) (local.get $work))
      (then (return (call $proof_universe_merge_max (local.get $base) (local.get $right) (local.get $left) (local.get $work)))))
    (local.set $tail (local.get $right))
    (if (local.get $at)
      (then (local.set $tail (call $proof_universe_merge_max
        (local.get $base) (local.get $at) (local.get $right) (local.get $work)))))
    (if (i32.eqz (local.get $tail)) (then (return (i32.const 0))))
    ;; A constant k is dominated by any tail atom with at least k successors.
    (if (i32.eqz (call $proof_universe_kind (local.get $base)
          (call $proof_universe_offset_base (local.get $base) (local.get $a) (local.get $work))))
      (then
        (local.set $oa (call $proof_universe_offset (local.get $base) (local.get $a) (local.get $work)))
        (local.set $b (local.get $tail))
        (block $done (loop $next
    (if (i32.eqz (call $proof_work_debit (local.get $base) (local.get $work)))
      (then (return (i32.const 0))))
          (local.set $bt (i32.const 0))
          (if (i32.eq (call $proof_universe_kind (local.get $base) (local.get $b)) (i32.const 3))
            (then
              (local.set $bt (call $proof_universe_right (local.get $base) (local.get $b)))
              (local.set $b (call $proof_universe_left (local.get $base) (local.get $b)))))
          (if (i32.ge_u (call $proof_universe_offset (local.get $base) (local.get $b) (local.get $work)) (local.get $oa))
            (then (return (local.get $tail))))
          (br_if $done (i32.eqz (local.get $bt)))
          (local.set $b (local.get $bt))
          (br $next)))))
    (call $proof_universe_maximum (local.get $base) (local.get $a) (local.get $tail) (local.get $work)))

  (func $proof_universe_normalize
    (param $base i32) (param $level i32) (param $work i32) (result i32)
    (local $memo i32)
    (if (i32.eqz (call $proof_work_debit (local.get $base) (local.get $work)))
      (then (return (i32.const 0))))
    (local.set $memo (call $proof_make_array (local.get $base) (i32.const 1)))
    (if (i32.eqz (local.get $memo)) (then (return (i32.const 0))))
    (call $proof_array_set (local.get $base) (local.get $memo) (i32.const 0) (i32.const 0))
    (call $proof_universe_normalize_memo (local.get $base) (local.get $level) (local.get $work) (local.get $memo)))

  (func $proof_universe_normalize_memo
    (param $base i32) (param $level i32) (param $work i32) (param $memo i32) (result i32)
    (local $entry i32) (local $value i32)
    (if (i32.eqz (call $proof_work_debit (local.get $base) (local.get $work)))
      (then (return (i32.const 0))))
    (local.set $entry (call $proof_level_memo_find (local.get $base) (local.get $memo)
      (i32.const 0) (local.get $level) (i32.const 0) (local.get $work)))
    (if (local.get $entry) (then (return (call $proof_array_get
      (local.get $base) (local.get $entry) (i32.const 3)))))
    (if (global.get $proof_last_error_code) (then (return (i32.const 0))))
    (local.set $value (call $proof_universe_normalize_uncached (local.get $base) (local.get $level) (local.get $work) (local.get $memo)))
    (if (global.get $proof_last_error_code) (then (return (i32.const 0))))
    (call $proof_level_memo_put (local.get $base) (local.get $memo)
      (i32.const 0) (local.get $level) (i32.const 0) (local.get $value) (local.get $work)))

  (func $proof_universe_normalize_uncached
    (param $base i32) (param $level i32) (param $work i32) (param $memo i32) (result i32)
    (local $kind i32) (local $left i32) (local $right i32) (local $offset i32)
    (if (i32.eqz (call $proof_work_debit (local.get $base) (local.get $work)))
      (then (return (i32.const 0))))
    (if (i32.eqz (local.get $level)) (then (return (i32.const 0))))
    (local.set $offset (call $proof_universe_offset (local.get $base) (local.get $level) (local.get $work)))
    (local.set $left (call $proof_universe_offset_base (local.get $base) (local.get $level) (local.get $work)))
    (local.set $kind (call $proof_universe_kind (local.get $base) (local.get $left)))
    (if (i32.lt_u (local.get $kind) (i32.const 2)) (then (return (local.get $level))))
    (local.set $right (call $proof_universe_normalize_memo (local.get $base)
      (call $proof_universe_right (local.get $base) (local.get $left)) (local.get $work) (local.get $memo)))
    (local.set $left (call $proof_universe_normalize_memo (local.get $base)
      (call $proof_universe_left (local.get $base) (local.get $left)) (local.get $work) (local.get $memo)))
    (if (i32.eq (local.get $kind) (i32.const 4))
      (then (return (call $proof_universe_add_offset (local.get $base)
        (call $proof_universe_imax (local.get $base) (local.get $left) (local.get $right) (local.get $work))
        (local.get $offset) (local.get $work)))))
    (local.set $left (call $proof_universe_normal_union (local.get $base) (local.get $left) (local.get $right) (local.get $work)))
    (if (i32.eqz (local.get $offset)) (then (return (local.get $left))))
    (call $proof_universe_distribute_offset (local.get $base) (local.get $left) (local.get $offset) (local.get $work)))

  (func $proof_universe_distribute_offset
    (param $base i32) (param $level i32) (param $offset i32) (param $work i32) (result i32)
    (if (i32.eqz (call $proof_work_debit (local.get $base) (local.get $work)))
      (then (return (i32.const 0))))
    (if (i32.eqz (local.get $level)) (then (return (i32.const 0))))
    (if (i32.eq (call $proof_universe_kind (local.get $base) (local.get $level)) (i32.const 3))
      (then (return (call $proof_universe_maximum (local.get $base)
        (call $proof_universe_distribute_offset (local.get $base)
          (call $proof_universe_left (local.get $base) (local.get $level)) (local.get $offset) (local.get $work))
        (call $proof_universe_distribute_offset (local.get $base)
          (call $proof_universe_right (local.get $base) (local.get $level)) (local.get $offset) (local.get $work)) (local.get $work)))))
    (call $proof_universe_add_offset (local.get $base) (local.get $level) (local.get $offset) (local.get $work)))

  (func $proof_universe_equal
    (param $base i32) (param $left i32) (param $right i32) (param $work i32) (result i32)
    (if (i32.eqz (call $proof_work_debit (local.get $base) (local.get $work)))
      (then (return (i32.const 0))))
    (if (call $proof_universe_structural_equal (local.get $base) (local.get $left) (local.get $right) (local.get $work))
      (then (return (i32.const 1))))
    (call $proof_universe_structural_equal (local.get $base)
      (call $proof_universe_normalize (local.get $base) (local.get $left) (local.get $work))
      (call $proof_universe_normalize (local.get $base) (local.get $right) (local.get $work)) (local.get $work)))

  ;; Ordering is solely a formation/explicit-constraint predicate. Conversion
  ;; uses proof_universe_equal and does not consult constraint reachability.
  (func $proof_universe_less_equal
    (param $base i32) (param $left i32) (param $right i32) (param $work i32) (result i32)
    (local $memo i32)
    (if (i32.eqz (call $proof_work_debit (local.get $base) (local.get $work)))
      (then (return (i32.const 0))))
    (local.set $memo (call $proof_make_array (local.get $base) (i32.const 1)))
    (if (i32.eqz (local.get $memo)) (then (return (i32.const 0))))
    (call $proof_array_set (local.get $base) (local.get $memo) (i32.const 0) (i32.const 0))
    (call $proof_universe_less_equal_memo (local.get $base) (local.get $left) (local.get $right) (local.get $work) (local.get $memo)))

  (func $proof_universe_less_equal_memo
    (param $base i32) (param $left i32) (param $right i32) (param $work i32) (param $memo i32) (result i32)
    (local $entry i32) (local $value i32)
    (if (i32.eqz (call $proof_work_debit (local.get $base) (local.get $work)))
      (then (return (i32.const 0))))
    (local.set $entry (call $proof_level_memo_find (local.get $base) (local.get $memo)
      (i32.const 6) (local.get $left) (local.get $right) (local.get $work)))
    (if (local.get $entry) (then (return (call $proof_array_get
      (local.get $base) (local.get $entry) (i32.const 3)))))
    (if (global.get $proof_last_error_code) (then (return (i32.const 0))))
    (local.set $value (call $proof_universe_less_equal_uncached (local.get $base) (local.get $left) (local.get $right) (local.get $work) (local.get $memo)))
    (if (global.get $proof_last_error_code) (then (return (i32.const 0))))
    (call $proof_level_memo_put (local.get $base) (local.get $memo)
      (i32.const 6) (local.get $left) (local.get $right) (local.get $value) (local.get $work)))

  (func $proof_universe_less_equal_uncached
    (param $base i32) (param $left i32) (param $right i32) (param $work i32) (param $memo i32) (result i32)
    (if (i32.eqz (call $proof_work_debit (local.get $base) (local.get $work)))
      (then (return (i32.const 0))))
    (call $proof_universe_less_equal_core (local.get $base)
      (call $proof_universe_normalize_memo (local.get $base) (local.get $left) (local.get $work) (local.get $memo))
      (call $proof_universe_normalize_memo (local.get $base) (local.get $right) (local.get $work) (local.get $memo))
      (local.get $work) (local.get $memo)))

  (func $proof_universe_less_equal_core
    (param $base i32) (param $left i32) (param $right i32) (param $work i32) (param $memo i32) (result i32)
    (local $lk i32) (local $rk i32) (local $a i32) (local $b i32)
    (local $ao i32) (local $bo i32)
    (if (i32.eqz (call $proof_work_debit (local.get $base) (local.get $work)))
      (then (return (i32.const 0))))
    (if (i32.or (i32.eqz (local.get $left)) (i32.eqz (local.get $right)))
      (then (return (i32.const 0))))
    (if (call $proof_universe_structural_equal (local.get $base) (local.get $left) (local.get $right) (local.get $work))
      (then (return (i32.const 1))))
    (local.set $lk (call $proof_universe_kind (local.get $base) (local.get $left)))
    (local.set $rk (call $proof_universe_kind (local.get $base) (local.get $right)))
    (if (i32.eqz (local.get $lk)) (then (return (i32.const 1))))
    (if (i32.eq (local.get $lk) (i32.const 3))
      (then
        (if (i32.eqz (call $proof_universe_less_equal_memo (local.get $base)
              (call $proof_universe_left (local.get $base) (local.get $left)) (local.get $right) (local.get $work) (local.get $memo)))
          (then (return (i32.const 0))))
        (return (call $proof_universe_less_equal_memo (local.get $base)
          (call $proof_universe_right (local.get $base) (local.get $left)) (local.get $right) (local.get $work) (local.get $memo)))))
    (if (i32.eq (local.get $rk) (i32.const 3))
      (then
        (if (call $proof_universe_less_equal_memo (local.get $base) (local.get $left)
              (call $proof_universe_left (local.get $base) (local.get $right)) (local.get $work) (local.get $memo))
          (then (return (i32.const 1))))
        (if (call $proof_universe_less_equal_memo (local.get $base) (local.get $left)
              (call $proof_universe_right (local.get $base) (local.get $right)) (local.get $work) (local.get $memo))
          (then (return (i32.const 1))))))
    (if (i32.eq (local.get $lk) (i32.const 4))
      (then
        (if (i32.eqz (call $proof_universe_less_equal_memo (local.get $base)
              (call $proof_universe_left (local.get $base) (local.get $left)) (local.get $right) (local.get $work) (local.get $memo)))
          (then (return (i32.const 0))))
        (return (call $proof_universe_less_equal_memo (local.get $base)
          (call $proof_universe_right (local.get $base) (local.get $left)) (local.get $right) (local.get $work) (local.get $memo)))))
    (if (i32.eq (local.get $rk) (i32.const 4))
      (then (return (call $proof_universe_less_equal_memo (local.get $base) (local.get $left)
        (call $proof_universe_right (local.get $base) (local.get $right)) (local.get $work) (local.get $memo)))))
    (local.set $a (call $proof_universe_offset_base (local.get $base) (local.get $left) (local.get $work)))
    (local.set $b (call $proof_universe_offset_base (local.get $base) (local.get $right) (local.get $work)))
    (local.set $ao (call $proof_universe_offset (local.get $base) (local.get $left) (local.get $work)))
    (local.set $bo (call $proof_universe_offset (local.get $base) (local.get $right) (local.get $work)))
    (if (i32.or
          (call $proof_universe_structural_equal (local.get $base) (local.get $a) (local.get $b) (local.get $work))
          (i32.eqz (call $proof_universe_kind (local.get $base) (local.get $a))))
      (then (return (i32.le_u (local.get $ao) (local.get $bo)))))
    (if (i32.and (i32.eq (local.get $ao) (local.get $bo)) (i32.ne (local.get $ao) (i32.const 0)))
      (then (return (call $proof_universe_less_equal_memo (local.get $base) (local.get $a) (local.get $b) (local.get $work) (local.get $memo)))))
    (if (i32.and
          (i32.le_u (call $proof_universe_kind (local.get $base) (local.get $a)) (i32.const 1))
          (i32.le_u (call $proof_universe_kind (local.get $base) (local.get $b)) (i32.const 1)))
      (then
        (local.set $lk (i32.const 0))
        (local.set $rk (i32.const 0))
        (if (call $proof_universe_kind (local.get $base) (local.get $a))
          (then (local.set $lk (i32.add (call $proof_universe_left (local.get $base) (local.get $a)) (i32.const 1)))))
        (if (call $proof_universe_kind (local.get $base) (local.get $b))
          (then (local.set $rk (i32.add (call $proof_universe_left (local.get $base) (local.get $b)) (i32.const 1)))))
        (return (call $proof_universe_atom_less_equal (local.get $base)
          (local.get $lk) (local.get $ao) (local.get $rk) (local.get $bo) (local.get $work)))))
    (i32.const 0))

  ;; Semantic term edges only. Universes, structured names, declaration indices,
  ;; literal payloads and source-form identifiers are never term children.
  (func $proof_term_child
    (param $tag i32) (param $offset i32) (result i32)
    (if (i32.eq (local.get $tag) (global.get $PROOF_RECORD_ARRAY))
      (then (return (i32.ge_u (local.get $offset) (i32.const 12)))))
    (if (i32.eq (local.get $tag) (global.get $PROOF_TERM_PRODUCT))
      (then (return (i32.or (i32.eq (local.get $offset) (i32.const 8)) (i32.eq (local.get $offset) (i32.const 12))))))
    (if (i32.eq (local.get $tag) (global.get $PROOF_TERM_LAMBDA))
      (then (return (i32.or (i32.eq (local.get $offset) (i32.const 8)) (i32.eq (local.get $offset) (i32.const 12))))))
    (if (i32.eq (local.get $tag) (global.get $PROOF_TERM_APPLICATION))
      (then (return (i32.or (i32.eq (local.get $offset) (i32.const 8)) (i32.eq (local.get $offset) (i32.const 12))))))
    (if (i32.eq (local.get $tag) (global.get $PROOF_TERM_LOCAL_DEFINITION))
      (then (return (i32.or (i32.or (i32.eq (local.get $offset) (i32.const 8)) (i32.eq (local.get $offset) (i32.const 12))) (i32.eq (local.get $offset) (i32.const 16))))))
    (if (i32.eq (local.get $tag) (global.get $PROOF_TERM_MATCH))
      (then (return (i32.or (i32.or (i32.eq (local.get $offset) (i32.const 8)) (i32.eq (local.get $offset) (i32.const 12))) (i32.eq (local.get $offset) (i32.const 16))))))
    (if (i32.eq (local.get $tag) (global.get $PROOF_TERM_FIXED_POINT))
      (then (return (i32.eq (local.get $offset) (i32.const 8)))))
    (if (i32.eq (local.get $tag) (global.get $PROOF_TERM_COFIXED_POINT))
      (then (return (i32.eq (local.get $offset) (i32.const 8)))))
    (if (i32.eq (local.get $tag) (global.get $PROOF_TERM_BRANCH))
      (then (return (i32.eq (local.get $offset) (i32.const 12)))))
    (if (i32.eq (local.get $tag) (global.get $PROOF_TERM_RECURSIVE_DEFINITION))
      (then (return (i32.or (i32.eq (local.get $offset) (i32.const 8)) (i32.eq (local.get $offset) (i32.const 12))))))
    (if (i32.eq (local.get $tag) (global.get $PROOF_TERM_METAVARIABLE))
      (then (return (i32.or (i32.eq (local.get $offset) (i32.const 12)) (i32.eq (local.get $offset) (i32.const 16))))))
    (if (i32.eq (local.get $tag) (global.get $PROOF_RECORD_SOLVED_METAVARIABLE))
      (then (return (i32.or (i32.eq (local.get $offset) (i32.const 12)) (i32.eq (local.get $offset) (i32.const 16))))))
    (if (i32.eq (local.get $tag) (global.get $PROOF_TERM_EXPECTED_LAMBDA))
      (then (return (i32.eq (local.get $offset) (i32.const 12)))))
    (if (i32.eq (local.get $tag) (global.get $PROOF_TERM_EXPECTED_CONSTRUCTOR))
      (then (return (i32.eq (local.get $offset) (i32.const 16)))))
    (if (i32.eq (local.get $tag) (global.get $PROOF_TERM_EXPECTED_RECORD))
      (then (return (i32.eq (local.get $offset) (i32.const 12)))))
    (if (i32.eq (local.get $tag) (global.get $PROOF_TERM_EXPECTED_MATCH))
      (then (return (i32.or (i32.eq (local.get $offset) (i32.const 8)) (i32.eq (local.get $offset) (i32.const 12))))))
    (if (i32.eq (local.get $tag) (global.get $PROOF_TERM_PROJECTION))
      (then (return (i32.eq (local.get $offset) (i32.const 16)))))
    (if (i32.eq (local.get $tag) (global.get $PROOF_RECORD_RECURSOR_RULE))
      (then (return (i32.eq (local.get $offset) (i32.const 20)))))
    (i32.const 0)
  )

  (func $proof_term_child_binders
    (param $tag i32) (param $offset i32) (result i32)
    (i32.or
      (i32.and (i32.eq (local.get $offset) (i32.const 12))
        (i32.or (i32.eq (local.get $tag) (global.get $PROOF_TERM_PRODUCT))
          (i32.or (i32.eq (local.get $tag) (global.get $PROOF_TERM_LAMBDA))
            (i32.eq (local.get $tag) (global.get $PROOF_TERM_EXPECTED_LAMBDA)))))
      (i32.and (i32.eq (local.get $offset) (i32.const 16))
        (i32.eq (local.get $tag) (global.get $PROOF_TERM_LOCAL_DEFINITION))))
  )

  ;; Fixed-size binder-transform cases. -1 requests the scheduled walker;
  ;; these helpers never traverse a term, infer a type, or perform conversion.
  (func $proof_term_is_shift_invariant (param $tag i32) (result i32)
    (i32.or
      (i32.or (i32.eq (local.get $tag) (global.get $PROOF_TERM_SORT))
        (i32.eq (local.get $tag) (global.get $PROOF_TERM_GLOBAL)))
      (i32.or
        (i32.or (i32.eq (local.get $tag) (global.get $PROOF_TERM_INDUCTIVE))
          (i32.eq (local.get $tag) (global.get $PROOF_TERM_CONSTRUCTOR)))
        (i32.or
          (i32.or (i32.eq (local.get $tag) (global.get $PROOF_TERM_RECURSIVE_REFERENCE))
            (i32.eq (local.get $tag) (global.get $PROOF_TERM_NAMED_LOCAL)))
          (i32.or (i32.eq (local.get $tag) (global.get $PROOF_TERM_NAT_LITERAL))
            (i32.eq (local.get $tag) (global.get $PROOF_TERM_STRING_LITERAL)))))))

  (func $proof_shift_leaf
    (param $artifact_base i32) (param $term_reference i32) (param $amount i32)
    (param $cutoff i32) (param $depth i32) (result i32)
    (local $tag i32) (local $index i32)
    (if (i32.eqz (local.get $amount)) (then (return (local.get $term_reference))))
    (if (i32.eqz (local.get $term_reference)) (then (return (i32.const 0))))
    (local.set $tag (call $proof_load (local.get $artifact_base)
      (i32.add (local.get $term_reference) (i32.const 4))))
    (if (i32.eq (local.get $tag) (global.get $PROOF_TERM_BOUND))
      (then
        (local.set $index (call $proof_load (local.get $artifact_base)
          (i32.add (local.get $term_reference) (i32.const 8))))
        (if (i32.lt_u (local.get $index) (i32.add (local.get $cutoff) (local.get $depth)))
          (then (return (local.get $term_reference))))
        (local.set $index (i32.add (local.get $index) (local.get $amount)))
        (if (i32.lt_s (local.get $index) (i32.const 0))
          (then (global.set $proof_last_error_code (i32.const 21)) (return (i32.const 0))))
        (return (call $proof_make_one (local.get $artifact_base)
          (global.get $PROOF_TERM_BOUND) (local.get $index)))))
    (if (call $proof_term_is_shift_invariant (local.get $tag))
      (then (return (local.get $term_reference))))
    (i32.const -1))

  (func $proof_substitute_leaf
    (param $artifact_base i32) (param $term_reference i32) (param $target_index i32)
    (param $replacement i32) (param $depth i32) (param $remove_binder i32) (result i32)
    (local $tag i32) (local $index i32)
    (if (i32.eqz (local.get $term_reference)) (then (return (i32.const 0))))
    (local.set $tag (call $proof_load (local.get $artifact_base)
      (i32.add (local.get $term_reference) (i32.const 4))))
    (if (i32.eq (local.get $tag) (global.get $PROOF_TERM_BOUND))
      (then
        (local.set $index (call $proof_load (local.get $artifact_base)
          (i32.add (local.get $term_reference) (i32.const 8))))
        (if (i32.eq (local.get $index) (i32.add (local.get $target_index) (local.get $depth)))
          (then (return (call $proof_shift_leaf (local.get $artifact_base)
            (local.get $replacement) (local.get $depth) (i32.const 0) (i32.const 0)))))
        (if (i32.and (i32.ne (local.get $remove_binder) (i32.const 0))
            (i32.gt_u (local.get $index) (i32.add (local.get $target_index) (local.get $depth))))
          (then
            (local.set $index (i32.sub (local.get $index) (i32.const 1)))
            (if (i32.lt_s (local.get $index) (i32.const 0))
              (then (global.set $proof_last_error_code (i32.const 21)) (return (i32.const 0))))
            (return (call $proof_make_one (local.get $artifact_base)
              (global.get $PROOF_TERM_BOUND) (local.get $index)))))
        (return (local.get $term_reference))))
    (if (call $proof_term_is_shift_invariant (local.get $tag))
      (then (return (local.get $term_reference))))
    (i32.const -1))
  (func $proof_shift
    (param $artifact_base i32)
    (param $term_reference i32)
    (param $amount i32)
    (param $cutoff i32)
    (param $depth i32)
    (result i32)
    (local $tag i32)
    (local $walk_n i32) (local $walk_i i32) (local $walk_x i32) (local $walk_y i32) (local $walk_out i32)
    (local $index i32)
    (local $first i32) (local $second i32) (local $new_first i32) (local $new_second i32)
    (if (i32.eqz (local.get $amount))
      (then (return (local.get $term_reference))))
    (if (i32.eqz (local.get $term_reference)) (then (return (i32.const 0))))
    (local.set $tag
      (call $proof_load (local.get $artifact_base)
        (i32.add (local.get $term_reference) (i32.const 4))))
    ;; Canonical applications and binders have exactly two term fields.
    ;; Keep the generic record walker for every other (including source) shape.
    (if (i32.and
        (i32.eq (call $proof_load (local.get $artifact_base) (local.get $term_reference)) (i32.const 4))
        (i32.or (i32.eq (local.get $tag) (global.get $PROOF_TERM_APPLICATION))
          (i32.or (i32.eq (local.get $tag) (global.get $PROOF_TERM_PRODUCT))
            (i32.eq (local.get $tag) (global.get $PROOF_TERM_LAMBDA)))))
      (then
        (local.set $first (call $proof_load (local.get $artifact_base)
          (i32.add (local.get $term_reference) (i32.const 8))))
        (local.set $second (call $proof_load (local.get $artifact_base)
          (i32.add (local.get $term_reference) (i32.const 12))))
        (local.set $new_first (call $proof_shift (local.get $artifact_base)
          (local.get $first) (local.get $amount) (local.get $cutoff) (local.get $depth)))
        (if (i32.and (i32.ne (local.get $first) (i32.const 0)) (i32.eqz (local.get $new_first)))
          (then (return (i32.const 0))))
        (local.set $new_second (call $proof_shift (local.get $artifact_base)
          (local.get $second) (local.get $amount) (local.get $cutoff)
          (i32.add (local.get $depth) (call $proof_term_child_binders (local.get $tag) (i32.const 12)))))
        (if (i32.and (i32.ne (local.get $second) (i32.const 0)) (i32.eqz (local.get $new_second)))
          (then (return (i32.const 0))))
        (if (i32.and (i32.eq (local.get $first) (local.get $new_first))
            (i32.eq (local.get $second) (local.get $new_second)))
          (then (return (local.get $term_reference))))
        (return (call $proof_make_two (local.get $artifact_base) (local.get $tag)
          (local.get $new_first) (local.get $new_second)))))
    (if (i32.eq (local.get $tag) (global.get $PROOF_TERM_BOUND))
      (then
        (local.set $index
          (call $proof_load (local.get $artifact_base)
            (i32.add (local.get $term_reference) (i32.const 8))))
        (if (i32.lt_u (local.get $index) (i32.add (local.get $cutoff) (local.get $depth)))
          (then (return (local.get $term_reference))))
        (if (i32.lt_s (i32.add (local.get $index) (local.get $amount)) (i32.const 0))
          (then
            (global.set $proof_last_error_code (i32.const 21))
            (return (i32.const 0))))
        (return
          (call $proof_make_one
            (local.get $artifact_base)
            (global.get $PROOF_TERM_BOUND)
            (i32.add (local.get $index) (local.get $amount))))))
    ;; These tags have no semantic term edges at any record offset.
    (if (i32.or
      (i32.or (i32.eq (local.get $tag) (global.get $PROOF_TERM_SORT))
        (i32.eq (local.get $tag) (global.get $PROOF_TERM_GLOBAL)))
      (i32.or
        (i32.or (i32.eq (local.get $tag) (global.get $PROOF_TERM_INDUCTIVE))
          (i32.eq (local.get $tag) (global.get $PROOF_TERM_CONSTRUCTOR)))
        (i32.or
          (i32.or (i32.eq (local.get $tag) (global.get $PROOF_TERM_RECURSIVE_REFERENCE))
            (i32.eq (local.get $tag) (global.get $PROOF_TERM_NAMED_LOCAL)))
          (i32.or (i32.eq (local.get $tag) (global.get $PROOF_TERM_NAT_LITERAL))
