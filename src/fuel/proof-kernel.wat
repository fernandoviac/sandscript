  ;; Same-arena transfers keep only relative offsets across generated frames.
  ;; Each bulk instruction is its own scheduled PC, including boundary invalidation.
  (func $proof_copy_bytes
    (param $artifact_base i32) (param $destination i32) (param $source i32)
    (param $length i32)
    (local $backward i32) (local $remaining i32) (local $offset i32) (local $chunk i32)
    (if (i32.eq (local.get $destination) (local.get $source)) (then (return)))
    (local.set $backward (i32.and
      (i32.gt_u (local.get $destination) (local.get $source))
      (i32.lt_u (i32.sub (local.get $destination) (local.get $source)) (local.get $length))))
