  ;; Infer a closed term's type in a private mutable artifact copy. Kernel
  ;; inference allocates normalized terms in scratch space, so the returned
  ;; type owns the expanded artifact rather than borrowing caller storage.
  

  ;; Return a composite handle whose left child has been checked against the
  ;; right child. Both public checking and explicit coercion use this path.
  ;; Lower one transient source term against an expected canonical type.
  ;; Every returned reference is a complete core term in the same scratch
  ;; artifact and is rechecked by the kernel before publication.
  (func $proof_native_elaborate_checked_term
    (param $artifact_base i32)
    (param $source_term i32)
    (param $expected_type i32)
    (param $context_reference i32)
    (param $recursive_definitions i32)
    (param $recursive_context_size i32) (param $work i32)
    (result i32)
    (local $tag i32)
    (local $normalized_expected i32)
    (local $domain i32)
    (local $codomain i32)
    (local $new_context i32)
    (local $body_source i32)
    (local $body_result i32)
    (local $result i32)
    (local.set $tag
      (call $proof_load
        (local.get $artifact_base)
        (i32.add (local.get $source_term) (i32.const 4))))
    (if (i32.or
          (i32.eq
            (local.get $tag)
            (global.get $PROOF_TERM_EXPECTED_LAMBDA))
          (i32.eq
            (local.get $tag)
            (global.get $PROOF_TERM_LAMBDA)))
      (then
        (local.set $normalized_expected
          (call $proof_weak_head_normalize
            (local.get $artifact_base)
            (local.get $expected_type)
            (local.get $context_reference) (local.get $recursive_definitions) (local.get $recursive_context_size) (local.get $work)))
        (if (i32.or
              (i32.eqz (local.get $normalized_expected))
              (i32.ne
                (call $proof_load
                  (local.get $artifact_base)
                  (i32.add
                    (local.get $normalized_expected)
                    (i32.const 4)))
                (global.get $PROOF_TERM_PRODUCT)))
          (then
            (global.set $proof_last_error_code (i32.const 72))
            (return (i32.const 0))))
        (local.set $domain
          (call $proof_load
            (local.get $artifact_base)
            (i32.add (local.get $normalized_expected) (i32.const 8))))
        (local.set $codomain
          (call $proof_load
            (local.get $artifact_base)
            (i32.add (local.get $normalized_expected) (i32.const 12))))
        (if (i32.eq (local.get $tag) (global.get $PROOF_TERM_LAMBDA))
          (then
            (if (i32.eqz
                  (call $proof_convertible
                    (local.get $artifact_base)
                    (call $proof_load
                      (local.get $artifact_base)
                      (i32.add (local.get $source_term) (i32.const 8)))
                    (local.get $domain)
                    (local.get $context_reference) (local.get $recursive_definitions) (local.get $recursive_context_size) (local.get $work)))
              (then
                (global.set $proof_last_error_code (i32.const 72))
                (return (i32.const 0))))))
        (local.set $new_context
          (call $proof_context_extend
            (local.get $artifact_base)
            (local.get $context_reference)
            (local.get $domain)))
        (local.set $body_source
          (call $proof_load
            (local.get $artifact_base)
            (i32.add (local.get $source_term) (i32.const 12))))
        (local.set $body_result
          (call $proof_native_elaborate_checked_term
            (local.get $artifact_base)
            (local.get $body_source)
            (local.get $codomain)
            (local.get $new_context)
            (local.get $recursive_definitions)
            (local.get $recursive_context_size) (local.get $work)))
        (if (i32.eqz (local.get $body_result))
          (then (return (i32.const 0))))
        (local.set $result
          (call $proof_make_two
            (local.get $artifact_base)
            (global.get $PROOF_TERM_LAMBDA)
            (local.get $domain)
            (local.get $body_result)))
        (if (i32.eqz
              (call $proof_native_elaboration_check_term
                (local.get $artifact_base)
                (local.get $result)
                (local.get $expected_type)
                (local.get $context_reference)
                (local.get $recursive_definitions)
                (local.get $recursive_context_size) (local.get $work)))
          (then (return (i32.const 0))))
        (return (local.get $result))))
    (if (i32.eq
          (local.get $tag)
          (global.get $PROOF_TERM_EXPECTED_CONSTRUCTOR))
      (then
        (local.set $result
          (call $proof_native_elaborate_constructor_application
            (local.get $artifact_base)
            (call $proof_load (local.get $artifact_base)
              (i32.add (local.get $source_term) (i32.const 8)))
            (call $proof_load (local.get $artifact_base)
              (i32.add (local.get $source_term) (i32.const 12)))
            (call $proof_load (local.get $artifact_base)
              (i32.add (local.get $source_term) (i32.const 16)))
            (local.get $expected_type)
            (local.get $context_reference)
            (local.get $recursive_definitions)
            (local.get $recursive_context_size) (local.get $work)))
        (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
        (return (local.get $result))))
    (if (i32.eq (local.get $tag) (global.get $PROOF_TERM_EXPECTED_RECORD))
      (then
        (local.set $result
          (call $proof_native_elaborate_record_literal
            (local.get $artifact_base)
            (local.get $source_term)
            (local.get $expected_type)
            (local.get $context_reference)
            (local.get $recursive_definitions)
            (local.get $recursive_context_size) (local.get $work)))
        (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
        (return (local.get $result))))
    (if (i32.eq (local.get $tag) (global.get $PROOF_TERM_EXPECTED_MATCH))
      (then
        (local.set $result
          (call $proof_native_elaborate_expected_match
            (local.get $artifact_base)
            (local.get $source_term)
            (local.get $expected_type)
            (local.get $context_reference)
            (local.get $recursive_definitions)
            (local.get $recursive_context_size) (local.get $work)))
        (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
        (return (local.get $result))))
    (if (i32.eqz
          (call $proof_native_elaboration_check_term
            (local.get $artifact_base)
            (local.get $source_term)
            (local.get $expected_type)
            (local.get $context_reference)
            (local.get $recursive_definitions)
            (local.get $recursive_context_size) (local.get $work)))
      (then (return (i32.const 0))))
    (local.get $source_term)
  )

  ;; Elaboration builds core terms in the checker scratch arena, so their
  ;; internal references live above the composed artifact's canonical
  ;; length. Widen the reference-validation bound to the current scratch
  ;; cursor before checking; the published artifact is later compacted and
  ;; rechecked against its own exact length.
  (func $proof_native_elaboration_check_term
    (param $artifact_base i32)
    (param $term_reference i32)
    (param $expected_type i32)
    (param $context_reference i32)
    (param $recursive_definitions i32)
    (param $recursive_context_size i32) (param $work i32)
    (result i32)
    (global.set $proof_current_artifact_length
      (global.get $proof_scratch_cursor))
    (call $proof_check_term
      (local.get $artifact_base)
      (local.get $term_reference)
      (local.get $expected_type)
      (local.get $context_reference)
      (local.get $recursive_definitions)
      (local.get $recursive_context_size) (local.get $work))
  )

  ;; A term artifact requires elaboration when any record carries an
  ;; elaborator-only term tag, wherever that record sits in the graph.
  ;; Structural records live at 0x100 and above and never match.
  (func $proof_native_artifact_contains_source
    (param $artifact_base i32) (param $artifact_length i32) (result i32)
    (local $offset i32) (local $words i32) (local $tag i32)
    (local.set $offset (i32.const 16))
    (block $done (loop $next
      (br_if $done (i32.ge_u (local.get $offset) (local.get $artifact_length)))
      (local.set $words (call $proof_load (local.get $artifact_base) (local.get $offset)))
      (local.set $tag (call $proof_load (local.get $artifact_base) (i32.add (local.get $offset) (i32.const 4))))
      (if (i32.or (i32.eq (local.get $tag) (i32.const 17)) (i32.or (i32.eq (local.get $tag) (i32.const 18)) (i32.or (i32.eq (local.get $tag) (i32.const 19)) (i32.or (i32.eq (local.get $tag) (i32.const 20)) (i32.or (i32.eq (local.get $tag) (i32.const 21)) (i32.eq (local.get $tag) (i32.const 22)))))))
        (then (return (i32.const 1))))
      (local.set $offset (i32.add (local.get $offset) (i32.mul (local.get $words) (i32.const 4))))
      (br $next)))
    (i32.const 0)
  )

  (func $proof_native_check_term_handles
    (param $term_handle i32)
    (param $expected_type_handle i32)
    (result i32)
    (local $handle i32)
    (local $artifact_base i32)
    (local $root_reference i32)
    (local $empty_context i32)
    (local.set $handle
      (call $proof_native_compose_binary_term
        (global.get $PROOF_TERM_APPLICATION)
        (i32.const 0)
        (i32.const 0)
        (local.get $term_handle)
        (local.get $expected_type_handle)
