  ;; Replace one open goal's target with a new target term and republish.
  ;; Soundness needs no trust here: seal checks the final proof term
  ;; against the root proposition, so a wrong retarget fails there.
  (func $proof_state_retarget
    (param $artifact_base i32)
    (param $state_root i32)
    (param $goal i32)
    (param $new_target i32)
    (result i32)
    (local $replacement_goal i32)
    (local.set $replacement_goal
      (call $proof_state_make_goal
        (local.get $artifact_base)
        (call $proof_load
          (local.get $artifact_base)
          (i32.add (local.get $goal) (i32.const 8)))
        (call $proof_load
          (local.get $artifact_base)
          (i32.add (local.get $goal) (i32.const 12)))
        (local.get $new_target)
        (call $proof_load
          (local.get $artifact_base)
          (i32.add (local.get $goal) (i32.const 20)))
        (i32.const 0)))
    (if (i32.eqz (local.get $replacement_goal))
      (then (return (i32.const 0))))
    (call $proof_state_rebuild_root
      (local.get $artifact_base)
      (local.get $state_root)
      (local.get $goal)
      (local.get $replacement_goal)
      (i32.const 0))
  )

  ;; change: retarget to a supplied convertible term. reduce: retarget to
  ;; the weak-head normal form of the current target.
  

  

  ;; Equality tactics construct ordinary eliminators; every result passes the
