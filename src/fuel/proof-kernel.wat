  )

  (func $proof_quotient_context_valid
    (param $b i32) (param $decl i32) (param $count i32) (result i32)
    (local $uc i32)
    (local.set $uc (call $proof_load (local.get $b) (i32.add (local.get $decl) (i32.const 8))))
    (i32.and
      (i32.eq (call $proof_load (local.get $b) (i32.add (local.get $uc) (i32.const 8))) (local.get $count))
      (i32.eqz (call $proof_array_count (local.get $b)
        (call $proof_load (local.get $b) (i32.add (local.get $uc) (i32.const 12))))))
  )

  (func $proof_quotient_check_eq
    (param $b i32) (param $eq i32) (param $types i32) (param $work i32) (result i32)
    (local $decl i32) (local $ctors i32) (local $ctor i32)
    (local.set $decl (call $proof_declaration_reference (local.get $b) (local.get $eq)))
    (if (i32.ne (call $proof_load (local.get $b) (i32.add (local.get $decl) (i32.const 4))) (i32.const 0x204))
      (then (return (i32.const 0))))
    (if (i32.eqz (call $proof_quotient_context_valid (local.get $b) (local.get $decl) (i32.const 1)))
      (then (return (i32.const 0))))
    (local.set $ctors (call $proof_load (local.get $b) (i32.add (local.get $decl) (i32.const 24))))
    (if (i32.ne (call $proof_array_count (local.get $b) (local.get $ctors)) (i32.const 1)) (then (return (i32.const 0))))
    (local.set $ctor (call $proof_array_get (local.get $b) (local.get $ctors) (i32.const 0)))
    (if (i32.eqz (call $proof_quotient_same (local.get $b)
      (call $proof_load (local.get $b) (i32.add (local.get $decl) (i32.const 12)))
      (call $proof_array_get (local.get $b) (local.get $types) (i32.const 4)) (local.get $work)))
      (then (return (i32.const 0))))
    (call $proof_quotient_same (local.get $b)
      (call $proof_load (local.get $b) (i32.add (local.get $ctor) (i32.const 8)))
      (call $proof_array_get (local.get $b) (local.get $types) (i32.const 5)) (local.get $work))
  )
  (func $proof_quotient_index (param $b i32) (param $role i32) (result i32)
    (local $name i32)
    (local.set $name (call $proof_make_intrinsic_name (local.get $b) (local.get $role)))
    (if (i32.eqz (local.get $name)) (then (return (i32.const -1))))
    (call $proof_find_named_declaration (local.get $b) (local.get $b) (local.get $name))
  )

  ;; Called once by the artifact checker, before any quotient declaration can
  ;; award typing or reduction authority. No serialized initialization flag.
  ;; Empty packages are valid; every nonempty package must contain all four.
  (func $proof_validate_quotient_package
    (param $b i32) (param $work i32) (result i32)
    (local $decls i32) (local $count i32) (local $i i32) (local $d i32)
    (local $found i32) (local $eq i32) (local $quot i32) (local $mk i32)
    (local $types i32) (local $idx i32)
    (local.set $decls (call $proof_load (local.get $b) (i32.const 12)))
    (local.set $count (call $proof_array_count (local.get $b) (local.get $decls)))
    (block $bad
      (block $done (loop $next
        (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
        (br_if $bad (i32.eqz (call $proof_work_debit (local.get $b) (local.get $work))))
        (local.set $d (call $proof_array_get (local.get $b) (local.get $decls) (local.get $i)))
        (if (i32.eq (call $proof_load (local.get $b) (i32.add (local.get $d) (i32.const 4))) (i32.const 0x207))
          (then (local.set $found (i32.add (local.get $found) (i32.const 1)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $next)))
      (if (i32.eqz (local.get $found)) (then (return (i32.const 1))))
      (br_if $bad (i32.ne (local.get $found) (i32.const 4)))
      (br_if $bad (i32.eqz (call $proof_names_unique (local.get $b) (local.get $work))))
      (local.set $eq (call $proof_quotient_index (local.get $b) (i32.const 5)))
      (local.set $quot (call $proof_quotient_index (local.get $b) (i32.const 26)))
      (local.set $mk (call $proof_quotient_index (local.get $b) (i32.const 27)))
      (br_if $bad (i32.or (i32.lt_s (local.get $eq) (i32.const 0))
        (i32.or (i32.lt_s (local.get $quot) (i32.const 0)) (i32.lt_s (local.get $mk) (i32.const 0)))))
      (br_if $bad (i32.or (i32.ge_u (local.get $eq) (local.get $quot)) (i32.ge_u (local.get $quot) (local.get $mk))))
      (local.set $types (call $proof_quotient_types (local.get $b) (local.get $eq) (local.get $quot) (local.get $mk)))
      (br_if $bad (i32.eqz (local.get $types)))
      (br_if $bad (i32.eqz (call $proof_quotient_check_eq (local.get $b) (local.get $eq) (local.get $types) (local.get $work))))
      (local.set $i (i32.const 0))
      (block $package_done (loop $package_next
        (br_if $package_done (i32.eq (local.get $i) (i32.const 4)))
        (local.set $idx (call $proof_quotient_index (local.get $b) (i32.add (i32.const 26) (local.get $i))))
        (br_if $bad (i32.lt_s (local.get $idx) (i32.const 0)))
        (if (i32.ge_u (local.get $i) (i32.const 2))
          (then (br_if $bad (i32.le_u (local.get $idx) (local.get $mk)))))
        (local.set $d (call $proof_array_get (local.get $b) (local.get $decls) (local.get $idx)))
        (br_if $bad (i32.ne (call $proof_load (local.get $b) (i32.add (local.get $d) (i32.const 4))) (i32.const 0x207)))
        (br_if $bad (i32.ne (call $proof_load (local.get $b) (i32.add (local.get $d) (i32.const 16))) (local.get $i)))
        (br_if $bad (i32.eqz (call $proof_quotient_context_valid (local.get $b) (local.get $d)
          (i32.add (i32.const 1) (i32.eq (local.get $i) (i32.const 2))))))
        (br_if $bad (i32.eqz (call $proof_quotient_same (local.get $b)
          (call $proof_load (local.get $b) (i32.add (local.get $d) (i32.const 12)))
          (call $proof_array_get (local.get $b) (local.get $types) (local.get $i)) (local.get $work))))
        (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $package_next)))
      (return (i32.const 1)))
    (if (i32.eqz (global.get $proof_last_error_code)) (then (global.set $proof_last_error_code (i32.const 4))))
    (i32.const 0)
  )

  (func $proof_infer_quotient
    (param $b i32) (param $term i32) (param $context i32)
    (param $rdefs i32) (param $rsize i32) (param $work i32) (result i32)
    (local $d i32) (local $index i32) (local $args i32) (local $uc i32)
    (if (i32.eqz (call $proof_work_debit (local.get $b) (local.get $work))) (then (return (i32.const 0))))
    (local.set $index (call $proof_load (local.get $b) (i32.add (local.get $term) (i32.const 8))))
    (if (i32.eqz (call $proof_declaration_visible (local.get $b) (local.get $index)))
      (then (global.set $proof_last_error_code (i32.const 58)) (return (i32.const 0))))
    (local.set $d (call $proof_declaration_reference (local.get $b) (local.get $index)))
    (if (i32.eqz (local.get $d)) (then (return (i32.const 0))))
    (if (i32.ne (call $proof_load (local.get $b) (i32.add (local.get $d) (i32.const 4))) (i32.const 0x207))
      (then (global.set $proof_last_error_code (i32.const 4)) (return (i32.const 0))))
    (local.set $args (call $proof_load (local.get $b) (i32.add (local.get $term) (i32.const 12))))
    (local.set $uc (call $proof_load (local.get $b) (i32.add (local.get $d) (i32.const 8))))
    (if (i32.eqz (call $proof_check_universe_arguments (local.get $b) (local.get $uc) (local.get $args) (local.get $work)))
      (then (global.set $proof_last_error_code (i32.const 60)) (return (i32.const 0))))
    (call $proof_instantiate_term_universes (local.get $b)
      (call $proof_load (local.get $b) (i32.add (local.get $d) (i32.const 12))) (local.get $args) (local.get $work))
  )

  ;; The typed engine checks the complete application before conversion.
  ;; In particular it checks lift's respect proof and ind's Prop-only motive;
  ;; this reducer must not recursively infer the application being reduced.
  (func $proof_reduce_quotient
    (param $b i32) (param $term i32) (param $context i32)
    (param $rdefs i32) (param $rsize i32) (param $work i32) (result i32)
    (local $head i32) (local $d i32) (local $kind i32) (local $majorpos i32)
    (local $major i32) (local $mh i32) (local $canonical i32) (local $args i32) (local $out i32)
    (local.set $head (call $proof_application_head (local.get $b) (local.get $term)))
    (if (i32.ne (call $proof_load (local.get $b) (i32.add (local.get $head) (i32.const 4))) (i32.const 3))
      (then (return (local.get $term))))
    (local.set $d (call $proof_declaration_reference (local.get $b)
      (call $proof_load (local.get $b) (i32.add (local.get $head) (i32.const 8)))))
    (if (i32.eqz (local.get $d)) (then (return (i32.const 0))))
    (if (i32.ne (call $proof_load (local.get $b) (i32.add (local.get $d) (i32.const 4))) (i32.const 0x207))
      (then (return (local.get $term))))
    (local.set $kind (call $proof_load (local.get $b) (i32.add (local.get $d) (i32.const 16))))
    (if (i32.or (i32.lt_u (local.get $kind) (i32.const 2)) (i32.gt_u (local.get $kind) (i32.const 3)))
      (then (return (local.get $term))))
    (if (i32.eqz (call $proof_work_debit (local.get $b) (local.get $work))) (then (return (i32.const 0))))
    (local.set $args (call $proof_load (local.get $b) (i32.add (local.get $head) (i32.const 12))))
    (local.set $canonical (call $proof_find_intrinsic (local.get $b) (i32.add (i32.const 26) (local.get $kind)) (local.get $args)))
    (if (i32.eqz (local.get $canonical))
      (then (return (select (i32.const 0) (local.get $term) (global.get $proof_last_error_code)))))
    (if (i32.ne (call $proof_load (local.get $b) (i32.add (local.get $canonical) (i32.const 8)))
      (call $proof_load (local.get $b) (i32.add (local.get $head) (i32.const 8)))) (then (return (local.get $term))))
    (local.set $majorpos (i32.sub (i32.const 7) (local.get $kind)))
    (if (i32.le_u (call $proof_application_count (local.get $b) (local.get $term)) (local.get $majorpos))
      (then (return (local.get $term))))
    (local.set $major (call $proof_weak_head_normalize (local.get $b)
      (call $proof_application_argument (local.get $b) (local.get $term) (local.get $majorpos))
      (local.get $context) (local.get $rdefs) (local.get $rsize) (local.get $work)))
    (if (i32.eqz (local.get $major)) (then (return (i32.const 0))))
    (if (i32.ne (call $proof_application_count (local.get $b) (local.get $major)) (i32.const 3))
      (then (return (local.get $term))))
    (local.set $mh (call $proof_application_head (local.get $b) (local.get $major)))
    (if (i32.ne (call $proof_load (local.get $b) (i32.add (local.get $mh) (i32.const 4))) (i32.const 3))
      (then (return (local.get $term))))
    (local.set $canonical (call $proof_find_intrinsic (local.get $b) (i32.const 27)
      (call $proof_load (local.get $b) (i32.add (local.get $mh) (i32.const 12)))))
    (if (i32.eqz (local.get $canonical))
      (then (return (select (i32.const 0) (local.get $term) (global.get $proof_last_error_code)))))
    (if (i32.ne (call $proof_load (local.get $b) (i32.add (local.get $canonical) (i32.const 8)))
      (call $proof_load (local.get $b) (i32.add (local.get $mh) (i32.const 8)))) (then (return (local.get $term))))
    (local.set $out (call $proof_make_two (local.get $b) (i32.const 8)
      (call $proof_application_argument (local.get $b) (local.get $term) (i32.const 3))
      (call $proof_application_argument (local.get $b) (local.get $major) (i32.const 2))))
    (if (i32.eqz (local.get $out)) (then (return (i32.const 0))))
    (call $proof_apply_argument_range (local.get $b) (local.get $out) (local.get $term)
      (i32.add (local.get $majorpos) (i32.const 1)))
