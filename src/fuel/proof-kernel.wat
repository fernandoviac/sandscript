        (return (i32.const 1))))
    (if (i32.eq (local.get $right_tag) (global.get $PROOF_TERM_METAVARIABLE))
      (then
        (return
          (call $proof_native_unify_terms
            (local.get $artifact_base)
            (local.get $right_reference)
            (local.get $left_reference)
            (local.get $root_reference)
            (local.get $context) (local.get $recursive_definitions) (local.get $recursive_context_size) (local.get $work)))))
    ;; Closed terms use typed kernel conversion, including proof irrelevance.
    ;; Open source terms stay in the elaborator and never ask the kernel to infer holes.
    (if (i32.and
      (i32.and (i32.or (i32.le_u (local.get $left_tag) (global.get $PROOF_TERM_RECURSIVE_REFERENCE))
        (i32.and (i32.ge_u (local.get $left_tag) (global.get $PROOF_TERM_PROJECTION))
          (i32.le_u (local.get $left_tag) (global.get $PROOF_TERM_STRING_LITERAL))))
        (i32.or (i32.le_u (local.get $right_tag) (global.get $PROOF_TERM_RECURSIVE_REFERENCE))
        (i32.and (i32.ge_u (local.get $right_tag) (global.get $PROOF_TERM_PROJECTION))
