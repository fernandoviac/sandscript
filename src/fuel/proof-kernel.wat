    (i32.store
      (call $abs (i32.add (local.get $artifact_base) (local.get $relative_offset)))
      (local.get $value))
  )

  (func $proof_allocate_record
    (param $artifact_base i32)
    (param $word_count i32)
    (param $tag i32)
