        (i32.const 2) (local.get $root) (i32.const 0))
      (local.set $root (local.get $cursor))
      (local.set $cursor (i32.add (local.get $cursor) (i32.const 16)))
      (local.set $number (i32.sub (local.get $number) (i32.const 1)))
      (br $next)))
    (local.get $root))

  (func $proof_native_write_level_argument
    (param $base i32) (param $cursor i32) (param $slot i32) (result i32)
    (local $handle i32)
    (if (i32.eq (call $value_type (local.get $slot)) (global.get $TYPE_THEOREM))
      (then
        (local.set $handle (call $value_data_lo (local.get $slot)))
        (if (i32.eq (call $proof_native_handle_kind (local.get $handle)) (global.get $PROOF_HANDLE_UNIVERSE))
          (then
            (call $proof_native_write_level_node (local.get $base) (local.get $cursor)
              (i32.const 1) (call $proof_native_handle_root (local.get $handle)) (i32.const 0))
            (return (local.get $cursor))))
        (return (call $proof_native_copy_term_records (local.get $handle)
          (local.get $base) (i32.add (local.get $base) (local.get $cursor))))))
    (call $proof_native_write_numeric_level (local.get $base) (local.get $cursor)
      (call $proof_native_nonnegative_integer_argument (local.get $slot))))

  ;; op0 Type, op1 Sort, op2 successor, op3 maximum, op4 imax.
  (func $proof_native_build_level_value
    (param $op i32) (param $argc i32) (param $stack i32) (result i32)
    (local $first i32) (local $second i32) (local $a_length i32) (local $b_length i32)
    (local $handle i32) (local $base i32) (local $cursor i32) (local $size i32)
    (local $a i32) (local $b i32) (local $root i32) (local $owner i32)
    (block $invalid
      (br_if $invalid (i32.ne (local.get $argc) (select (i32.const 2) (i32.const 1) (i32.ge_u (local.get $op) (i32.const 3)))))
      (local.set $first (i32.sub (call $read_ctx (global.get $CTX_PENDING_POINTER))
        (i32.mul (local.get $argc) (global.get $VALUE_SIZE))))
      (local.set $second (i32.add (local.get $first) (global.get $VALUE_SIZE)))
      (local.set $a_length (call $proof_native_level_argument_length (local.get $first)))
      (br_if $invalid (i32.lt_s (local.get $a_length) (i32.const 0)))
      (if (i32.ge_u (local.get $op) (i32.const 3))
        (then
          (local.set $b_length (call $proof_native_level_argument_length (local.get $second)))
          (br_if $invalid (i32.lt_s (local.get $b_length) (i32.const 0)))))
      (local.set $size (i32.add (i32.const 28) (i32.add (local.get $a_length) (local.get $b_length))))
      (local.set $size (i32.add (local.get $size)
        (select (i32.const 20) (select (i32.const 12) (i32.const 16) (i32.eq (local.get $op) (i32.const 1)))
          (i32.ge_u (local.get $op) (i32.const 3)))))
      (if (i32.eqz (local.get $op)) (then (local.set $size (i32.add (local.get $size) (i32.const 12)))))
      (br_if $invalid (i32.gt_u (local.get $size) (i32.const 1073741824)))
      (if (call $check_heap_overflow (i32.add (call $estimate_arraybuffer_size (local.get $size)) (i32.const 24)))
        (then (return (i32.const 0))))
      (local.set $handle (call $proof_native_allocate_term_handle (local.get $size) (i32.const 0) (i32.const 0)))
      (local.set $base (call $proof_native_handle_artifact_base (local.get $handle)))
      (local.set $owner (call $proof_native_level_argument_owner (local.get $first)))
      (local.set $a (call $proof_native_write_level_argument (local.get $base) (i32.const 16) (local.get $first)))
      (local.set $cursor (i32.add (i32.const 16) (local.get $a_length)))
      (if (i32.ge_u (local.get $op) (i32.const 3))
        (then
          (if (i32.eqz (local.get $owner)) (then (local.set $owner (call $proof_native_level_argument_owner (local.get $second)))))
          (local.set $b (call $proof_native_write_level_argument (local.get $base) (local.get $cursor) (local.get $second)))
          (local.set $cursor (i32.add (local.get $cursor) (local.get $b_length)))))
      (local.set $root (local.get $cursor))
      (if (i32.ne (local.get $op) (i32.const 1))
        (then
          (call $proof_native_write_level_node (local.get $base) (local.get $cursor)
            (select (local.get $op) (i32.const 2) (i32.ge_u (local.get $op) (i32.const 3)))
            (local.get $a) (local.get $b))
          (local.set $a (local.get $cursor))
          (local.set $cursor (i32.add (local.get $cursor)
            (select (i32.const 20) (i32.const 16) (i32.ge_u (local.get $op) (i32.const 3)))))))
      (if (i32.le_u (local.get $op) (i32.const 1))
        (then
          (local.set $root (local.get $cursor))
          (call $proof_store (local.get $base) (local.get $cursor) (i32.const 3))
          (call $proof_store (local.get $base) (i32.add (local.get $cursor) (i32.const 4)) (global.get $PROOF_TERM_SORT))
          (call $proof_store (local.get $base) (i32.add (local.get $cursor) (i32.const 8)) (local.get $a))
          (local.set $cursor (i32.add (local.get $cursor) (i32.const 12)))))
      (call $proof_native_write_empty_declarations (local.get $base) (local.get $cursor))
      (call $proof_native_initialize_artifact_header (local.get $base) (local.get $size) (local.get $cursor))
      (i32.store (call $abs (i32.add (local.get $handle) (i32.const 12))) (local.get $root))
      (i32.store (call $abs (i32.add (local.get $handle) (i32.const 16)))
        (select (global.get $PROOF_HANDLE_LEVEL) (global.get $PROOF_HANDLE_TERM) (i32.ge_u (local.get $op) (i32.const 2))))
      (i32.store (call $abs (i32.add (local.get $handle) (i32.const 20))) (local.get $owner))
      (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack))
      (call $proof_native_push_term (local.get $handle))
      (return (i32.const 0)))
    (call $write_ctx (global.get $CTX_PENDING_POINTER) (local.get $stack))
    (i32.add (i32.const 1) (call $throw_type_error_with_message (global.get $BUILTIN_MSG_INVALID_INDEX))))

  (func $proof_native_term_type
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_identifier i32) (param $argument_count i32) (param $stack_base i32) (result i32)
    (call $proof_native_build_level_value (i32.const 0) (local.get $argument_count) (local.get $stack_base)))

  (func $proof_native_term_sort
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_identifier i32) (param $argument_count i32) (param $stack_base i32) (result i32)
    (call $proof_native_build_level_value (i32.const 1) (local.get $argument_count) (local.get $stack_base)))

  (func $proof_native_level_constructor
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_identifier i32) (param $argument_count i32) (param $stack_base i32) (result i32)
