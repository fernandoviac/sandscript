  ;; Compare an interned Sandscript string with up to sixteen packed UTF-8
  ;; bytes. Expected words use little-endian byte order.
  (func $proof_native_string_equals
    (param $string_identifier i32)
    (param $expected_length i32)
    (param $first_word i32)
    (param $second_word i32)
    (param $third_word i32)
    (param $fourth_word i32)
