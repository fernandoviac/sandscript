  ;; Instantiate a solved goal in the scope recorded at this occurrence.
  ;; A zero scope is the introduce primitive's identity embedding. Explicit
  ;; scopes are simultaneous substitutions, not sequential binder removal.
  (func $proof_state_derived_scope
    (param $base i32) (param $term i32) (param $scope i32) (result i32)
    (local $count i32) (local $index i32) (local $entry i32) (local $identity i32)
    (if (i32.eqz (local.get $scope)) (then (return (local.get $term))))
    (local.set $count (call $proof_array_count (local.get $base) (local.get $scope)))
    (local.set $identity (i32.const 1))
    (block $checked (loop $check
      (br_if $checked (i32.ge_u (local.get $index) (local.get $count)))
      (local.set $entry (call $proof_array_get (local.get $base) (local.get $scope) (local.get $index)))
      (if (i32.or
        (i32.ne (call $proof_load (local.get $base) (i32.add (local.get $entry) (i32.const 4))) (global.get $PROOF_TERM_BOUND))
        (i32.ne (call $proof_load (local.get $base) (i32.add (local.get $entry) (i32.const 8))) (local.get $index)))
        (then (local.set $identity (i32.const 0))))
      (local.set $index (i32.add (local.get $index) (i32.const 1))) (br $check)))
    (if (local.get $identity) (then (return (local.get $term))))
    (local.set $index (i32.const 0))
    (block $done (loop $next
      (br_if $done (i32.ge_u (local.get $index) (local.get $count)))
      (local.set $entry (call $proof_shift (local.get $base)
        (call $proof_array_get (local.get $base) (local.get $scope) (local.get $index))
        (local.get $count) (i32.const 0) (i32.const 0)))
      (if (i32.eqz (local.get $entry)) (then (return (i32.const 0))))
      (local.set $term (call $proof_substitute (local.get $base) (local.get $term)
        (local.get $index) (local.get $entry) (i32.const 0) (i32.const 0)))
      (if (i32.eqz (local.get $term)) (then (return (i32.const 0))))
      (local.set $index (i32.add (local.get $index) (i32.const 1))) (br $next)))
    (call $proof_shift (local.get $base) (local.get $term)
      (i32.sub (i32.const 0) (local.get $count)) (i32.const 0) (i32.const 0)))

  ;; Finish a locally constructed refinement, retaining the old goal as
  ;; solved evidence and appending the fresh, typed goal descriptors.
  (func $proof_state_derived_replace
    (param $base i32) (param $root i32) (param $goal i32)
    (param $solution i32) (param $goals i32) (result i32)
    (local $replacement i32)
    (if (i32.eqz (local.get $solution)) (then (return (i32.const 0))))
    (local.set $replacement (call $proof_state_make_goal (local.get $base)
      (call $proof_load (local.get $base) (i32.add (local.get $goal) (i32.const 8)))
      (call $proof_load (local.get $base) (i32.add (local.get $goal) (i32.const 12)))
      (call $proof_load (local.get $base) (i32.add (local.get $goal) (i32.const 16)))
      (call $proof_load (local.get $base) (i32.add (local.get $goal) (i32.const 20)))
      (local.get $solution)))
    (if (i32.eqz (local.get $replacement)) (then (return (i32.const 0))))
    (call $proof_state_rebuild_root (local.get $base) (local.get $root)
      (local.get $goal) (local.get $replacement) (local.get $goals)))

  ;; mode -1 normalizes recursively; -2 only checks a free-variable
  ;; dependency; a nonnegative mode selectively unfolds that declaration.
  (func $proof_state_derived_walk
    (param $base i32) (param $term i32) (param $mode i32)
    (param $hypothesis i32) (param $depth i32)
    (param $context i32) (param $recursive_definitions i32) (param $recursive_context_size i32) (param $work i32) (result i32)
    (local $tag i32) (local $first i32) (local $second i32) (local $third i32)
    (local $count i32) (local $index i32) (local $entry i32) (local $copy i32)
    (local $start i32) (local $end i32) (local $child_depth i32) (local $child_context i32) (local $child_definitions i32) (local $child_recursive_size i32)
    (if (i32.eqz (local.get $term)) (then (return (i32.const 0))))
    (local.set $tag (call $proof_load (local.get $base) (i32.add (local.get $term) (i32.const 4))))
    (if (i32.and (i32.eq (local.get $mode) (i32.const -1))
      (i32.or (i32.le_u (local.get $tag) (global.get $PROOF_TERM_RECURSIVE_REFERENCE))
        (i32.and (i32.ge_u (local.get $tag) (global.get $PROOF_TERM_PROJECTION))
          (i32.le_u (local.get $tag) (global.get $PROOF_TERM_STRING_LITERAL))))) (then
      (local.set $term (call $proof_weak_head_normalize (local.get $base) (local.get $term)
        (local.get $context) (local.get $recursive_definitions) (local.get $recursive_context_size) (local.get $work)))
      (if (i32.eqz (local.get $term)) (then (return (i32.const 0))))))
    (local.set $tag (call $proof_load (local.get $base) (i32.add (local.get $term) (i32.const 4))))
    (if (i32.and (i32.eq (local.get $mode) (i32.const -2))
      (i32.eq (local.get $tag) (global.get $PROOF_TERM_BOUND))) (then
      (if (i32.eq (call $proof_load (local.get $base) (i32.add (local.get $term) (i32.const 8)))
        (i32.add (local.get $hypothesis) (local.get $depth)))
        (then (global.set $proof_last_error_code (i32.const 95)) (return (i32.const 0))))
      (return (local.get $term))))
    (if (i32.and (i32.ge_s (local.get $mode) (i32.const 0))
      (i32.eq (local.get $tag) (global.get $PROOF_TERM_GLOBAL))) (then
      (if (i32.eq (call $proof_load (local.get $base) (i32.add (local.get $term) (i32.const 8))) (local.get $mode)) (then
        (return (call $proof_instantiate_term_universes (local.get $base)
          (call $proof_load (local.get $base) (i32.add
            (call $proof_declaration_reference (local.get $base) (local.get $mode)) (i32.const 16)))
          (call $proof_load (local.get $base) (i32.add (local.get $term) (i32.const 12))) (local.get $work)))))
      (return (local.get $term))))
    (if (i32.eq (local.get $tag) (global.get $PROOF_RECORD_ARRAY)) (then
      (local.set $count (call $proof_array_count (local.get $base) (local.get $term)))
      (block $done (loop $next
        (br_if $done (i32.ge_u (local.get $index) (local.get $count)))
        (local.set $entry (call $proof_state_derived_walk (local.get $base)
          (call $proof_array_get (local.get $base) (local.get $term) (local.get $index))
          (local.get $mode) (local.get $hypothesis) (local.get $depth)
          (local.get $context) (local.get $recursive_definitions) (local.get $recursive_context_size) (local.get $work)))
        (if (i32.eqz (local.get $entry)) (then (return (i32.const 0))))
        (if (i32.ne (local.get $entry) (call $proof_array_get (local.get $base) (local.get $term) (local.get $index))) (then
          (if (i32.eqz (local.get $copy)) (then
            (local.set $copy (call $proof_make_array (local.get $base) (local.get $count)))
            (if (i32.eqz (local.get $copy)) (then (return (i32.const 0))))
            (call $proof_copy_bytes (local.get $base) (i32.add (local.get $copy) (i32.const 12))
              (i32.add (local.get $term) (i32.const 12))
              (i32.mul (local.get $count) (i32.const 4)))))
          (call $proof_array_set (local.get $base) (local.get $copy) (local.get $index) (local.get $entry))))
        (local.set $index (i32.add (local.get $index) (i32.const 1))) (br $next)))
      (return (select (local.get $copy) (local.get $term) (local.get $copy)))))
    (local.set $start (i32.const 8))
    (local.set $end (i32.mul (call $proof_load (local.get $base) (local.get $term)) (i32.const 4)))
    (local.set $index (local.get $start))
    (block $fields_done (loop $field
      (br_if $fields_done (i32.ge_u (local.get $index) (local.get $end)))
      (if (call $proof_term_child (local.get $tag) (local.get $index)) (then
      (local.set $child_depth (local.get $depth))
      (if (i32.or
        (i32.and (i32.eq (local.get $index) (i32.const 12))
          (i32.or (i32.eq (local.get $tag) (global.get $PROOF_TERM_PRODUCT))
            (i32.eq (local.get $tag) (global.get $PROOF_TERM_LAMBDA))))
        (i32.and (i32.eq (local.get $index) (i32.const 16))
          (i32.eq (local.get $tag) (global.get $PROOF_TERM_LOCAL_DEFINITION))))
        (then (local.set $child_depth (i32.add (local.get $depth) (i32.const 1)))))
      (local.set $child_context (local.get $context))
      (local.set $child_definitions (local.get $recursive_definitions))
      (local.set $child_recursive_size (local.get $recursive_context_size))
      (if (call $proof_term_child_binders (local.get $tag) (local.get $index)) (then
        (local.set $child_depth (i32.add (local.get $depth) (i32.const 1)))
        (if (i32.eq (local.get $mode) (i32.const -1)) (then
          (local.set $child_context (call $proof_context_extend (local.get $base) (local.get $context)
            (call $proof_load (local.get $base) (i32.add (local.get $term) (i32.const 8)))))
          (if (i32.eqz (local.get $child_context)) (then (return (i32.const 0))))))))
      (if (i32.or (i32.eq (local.get $tag) (global.get $PROOF_TERM_FIXED_POINT))
        (i32.eq (local.get $tag) (global.get $PROOF_TERM_COFIXED_POINT))) (then
        (local.set $child_definitions (call $proof_load (local.get $base) (i32.add (local.get $term) (i32.const 8))))
        (local.set $child_recursive_size (call $proof_array_count (local.get $base) (local.get $context)))))
      (local.set $entry (call $proof_state_derived_walk (local.get $base)
        (call $proof_load (local.get $base) (i32.add (local.get $term) (local.get $index)))
        (local.get $mode) (local.get $hypothesis) (local.get $child_depth)
        (local.get $child_context) (local.get $child_definitions) (local.get $child_recursive_size) (local.get $work)))
      (if (i32.eqz (local.get $entry)) (then (return (i32.const 0))))
      (if (i32.ne (local.get $entry)
        (call $proof_load (local.get $base) (i32.add (local.get $term) (local.get $index)))) (then
        (if (i32.eqz (local.get $copy)) (then
          (local.set $count (call $proof_load (local.get $base) (local.get $term)))
          (local.set $copy (call $proof_allocate_record (local.get $base) (local.get $count) (local.get $tag)))
          (if (i32.eqz (local.get $copy)) (then (return (i32.const 0))))
          (call $proof_copy_bytes (local.get $base) (i32.add (local.get $copy) (i32.const 8))
                (i32.add (local.get $term) (i32.const 8)) (i32.sub (i32.mul (local.get $count) (i32.const 4)) (i32.const 8)))))
        (call $proof_store (local.get $base) (i32.add (local.get $copy) (local.get $index)) (local.get $entry))))
      ))
      (local.set $index (i32.add (local.get $index) (i32.const 4))) (br $field)))
    (select (local.get $copy) (local.get $term) (local.get $copy)))

  (func $proof_state_derived_hypothesis
    (param $base i32) (param $goal i32) (param $index i32) (param $work i32) (result i32)
    (local $context i32)
    (local.set $context (call $proof_state_goal_context (local.get $base) (local.get $goal)))
    (if (i32.ge_u (local.get $index) (call $proof_array_count (local.get $base) (local.get $context)))
      (then (global.set $proof_last_error_code (i32.const 82)) (return (i32.const 0))))
    (call $proof_weak_head_normalize (local.get $base)
      (call $proof_shift (local.get $base)
        (call $proof_array_get (local.get $base) (local.get $context) (local.get $index))
        (i32.add (local.get $index) (i32.const 1)) (i32.const 0) (i32.const 0)) (local.get $context) (i32.const 0) (i32.const 0) (local.get $work)))

  (func $proof_state_derived_shorten
    (param $base i32) (param $root i32) (param $goal i32) (param $clear i32) (param $work i32) (result i32)
    (local $context i32) (local $count i32) (local $index i32)
    (local $new_context i32) (local $scope i32) (local $target i32)
    (local $identifier i32) (local $hole i32) (local $entry i32) (local $goals i32)
    (local.set $context (call $proof_state_goal_context (local.get $base) (local.get $goal)))
    (local.set $count (call $proof_array_count (local.get $base) (local.get $context)))
    (if (i32.eqz (local.get $count))
      (then (global.set $proof_last_error_code (i32.const 95)) (return (i32.const -1))))
    (local.set $target (call $proof_load (local.get $base) (i32.add (local.get $goal) (i32.const 16))))
    (if (local.get $clear) (then
      (if (i32.eqz (call $proof_state_derived_walk (local.get $base) (local.get $target)
        (i32.const -2) (i32.const 0) (i32.const 0) (local.get $context) (i32.const 0) (i32.const 0) (local.get $work))) (then
        (if (global.get $proof_last_error_code) (then (return (i32.const -1))))
        (return (i32.const 0))))
      (local.set $target (call $proof_shift (local.get $base) (local.get $target)
        (i32.const -1) (i32.const 0) (i32.const 0))))
    (else
      (local.set $target (call $proof_make_two (local.get $base) (global.get $PROOF_TERM_PRODUCT)
        (call $proof_array_get (local.get $base) (local.get $context) (i32.const 0)) (local.get $target)))))
    (if (i32.eqz (local.get $target)) (then (return (i32.const 0))))
    (local.set $count (i32.sub (local.get $count) (i32.const 1)))
    (local.set $new_context (call $proof_make_array (local.get $base) (local.get $count)))
    (local.set $scope (call $proof_make_array (local.get $base) (local.get $count)))
    (local.set $goals (call $proof_make_array (local.get $base) (i32.const 1)))
    (if (i32.or (i32.eqz (local.get $new_context))
      (i32.or (i32.eqz (local.get $scope)) (i32.eqz (local.get $goals)))) (then (return (i32.const 0))))
    (block $done (loop $next
      (br_if $done (i32.ge_u (local.get $index) (local.get $count)))
      (call $proof_array_set (local.get $base) (local.get $new_context) (local.get $index)
        (call $proof_array_get (local.get $base) (local.get $context) (i32.add (local.get $index) (i32.const 1))))
      (local.set $entry (call $proof_make_one (local.get $base) (global.get $PROOF_TERM_BOUND)
        (i32.add (local.get $index) (i32.const 1))))
      (if (i32.eqz (local.get $entry)) (then (return (i32.const 0))))
      (call $proof_array_set (local.get $base) (local.get $scope) (local.get $index) (local.get $entry))
      (local.set $index (i32.add (local.get $index) (i32.const 1))) (br $next)))
    (local.set $identifier (call $proof_state_next_metavariable (local.get $base)
      (call $proof_state_goals_array (local.get $base) (local.get $root))))
    (local.set $hole (call $proof_make_three (local.get $base) (global.get $PROOF_TERM_METAVARIABLE)
      (local.get $identifier) (local.get $scope) (i32.const 0)))
    (if (i32.eqz (local.get $hole)) (then (return (i32.const 0))))
