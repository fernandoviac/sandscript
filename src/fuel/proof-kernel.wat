    (local.set $right_base
      (call $proof_native_handle_artifact_base (local.get $right_handle)))
    (local.set $left_length
      (call $proof_native_term_records_length (local.get $left_handle)))
    (if (i32.eq
          (call $proof_native_handle_buffer (local.get $left_handle))
          (call $proof_native_handle_buffer (local.get $right_handle)))
      (then (local.set $right_length (i32.const 0)))
