    (local.set $value (call $proof_substitute_universe_uncached (local.get $artifact_base) (local.get $universe_reference) (local.get $arguments_array) (local.get $work) (local.get $memo)))
    (if (global.get $proof_last_error_code) (then (return (i32.const 0))))
    (call $proof_level_memo_put (local.get $artifact_base) (local.get $memo)
      (i32.const 5) (local.get $universe_reference) (local.get $arguments_array) (local.get $value) (local.get $work)))

