    (if (i32.eqz (local.get $t12)) (then (return (i32.const 0))))
    (local.set $t13 (call $proof_make_two (local.get $b) (i32.const 8) (local.get $t11) (local.get $t12)))
    (if (i32.eqz (local.get $t13)) (then (return (i32.const 0))))
    (local.set $t14 (call $proof_make_two (local.get $b) (i32.const 8) (local.get $t13) (local.get $t10)))
    (if (i32.eqz (local.get $t14)) (then (return (i32.const 0))))
    (local.set $t15 (call $proof_make_two (local.get $b) (i32.const 8) (local.get $t14) (local.get $t1)))
    (if (i32.eqz (local.get $t15)) (then (return (i32.const 0))))
    (local.set $t16 (call $proof_make_two (local.get $b) (i32.const 8) (local.get $t2) (local.get $t15)))
    (if (i32.eqz (local.get $t16)) (then (return (i32.const 0))))
    (local.set $t17 (call $proof_make_two (local.get $b) (i32.const 6) (local.get $t10) (local.get $t16)))
    (if (i32.eqz (local.get $t17)) (then (return (i32.const 0))))
    (local.set $t18 (call $proof_make_two (local.get $b) (i32.const 8) (local.get $t6) (local.get $t12)))
    (if (i32.eqz (local.get $t18)) (then (return (i32.const 0))))
    (local.set $t19 (call $proof_make_two (local.get $b) (i32.const 8) (local.get $t18) (local.get $t10)))
    (if (i32.eqz (local.get $t19)) (then (return (i32.const 0))))
    (local.set $t20 (call $proof_make_two (local.get $b) (i32.const 8) (local.get $t10) (local.get $t1)))
    (if (i32.eqz (local.get $t20)) (then (return (i32.const 0))))
    (local.set $t21 (call $proof_make_two (local.get $b) (i32.const 6) (local.get $t19) (local.get $t20)))
    (if (i32.eqz (local.get $t21)) (then (return (i32.const 0))))
    (local.set $t22 (call $proof_make_two (local.get $b) (i32.const 6) (local.get $t17) (local.get $t21)))
    (if (i32.eqz (local.get $t22)) (then (return (i32.const 0))))
