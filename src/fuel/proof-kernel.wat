  ;; The domain of the product at one position along a product spine.
  (func $proof_state_product_domain
    (param $artifact_base i32)
    (param $product i32)
    (param $position i32)
    (result i32)
    (local $index i32)
    (block $done
      (loop $next
        (br_if $done (i32.ge_u (local.get $index) (local.get $position)))
        (local.set $product
          (call $proof_load
            (local.get $artifact_base)
            (i32.add (local.get $product) (i32.const 12))))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $next)))
    (call $proof_load
      (local.get $artifact_base)
      (i32.add (local.get $product) (i32.const 8)))
  )

