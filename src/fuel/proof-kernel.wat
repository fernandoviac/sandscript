  (local.set $limit (global.get $proof_scratch_limit))
  (local.set $state_mode (global.get $proof_state_artifact_mode))
  (global.set $proof_scratch_cursor (local.get $length))
  (global.set $proof_scratch_limit (local.get $capacity))
  (global.set $proof_state_artifact_mode (i32.const 0))
  (local.set $result (call $proof_validate_artifact (local.get $base) (local.get $length)))
  (global.set $proof_scratch_cursor (local.get $cursor))
  (global.set $proof_scratch_limit (local.get $limit))
  (global.set $proof_state_artifact_mode (local.get $state_mode))
