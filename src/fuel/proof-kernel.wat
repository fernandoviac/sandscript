  (func $proof_state_equality_find
    (param $b i32) (param $head i32) (param $A i32)
    (param $context i32) (param $work i32) (result i32)
    (local $decls i32) (local $i i32) (local $d i32) (local $candidate i32)
    (local $arguments i32) (local $count i32) (local $domain i32) (local $sort i32)
    (local $level i32) (local $empty i32)
    ;; A supplied head fixes the equality family; only its universe changes.
    ;; With no head, locate an equality family compatible with A's exact sort.
    (local.set $sort (call $proof_infer_term (local.get $b) (local.get $A)
      (local.get $context) (i32.const 0) (i32.const 0) (local.get $work)))
    (if (i32.eqz (local.get $sort)) (then (return (i32.const 0))))
    (local.set $sort (call $proof_weak_head_normalize (local.get $b) (local.get $sort)
      (local.get $context) (i32.const 0) (i32.const 0) (local.get $work)))
    (if (i32.eqz (local.get $sort)) (then (return (i32.const 0))))
    (if (i32.ne (call $proof_load (local.get $b) (i32.add (local.get $sort) (i32.const 4)))
      (global.get $PROOF_TERM_SORT)) (then (return (i32.const 0))))
    (local.set $decls (call $proof_load (local.get $b) (i32.const 12)))
    (if (local.get $head) (then
      (local.set $i (call $proof_load (local.get $b) (i32.add (local.get $head) (i32.const 8))))))
    (local.set $empty (call $proof_make_array (local.get $b) (i32.const 0)))
    (if (i32.eqz (local.get $empty)) (then (return (i32.const 0))))
    (block $done (loop $next
      (br_if $done (i32.ge_u (local.get $i) (call $proof_array_count (local.get $b) (local.get $decls))))
      (block $skip
        (local.set $d (call $proof_array_get (local.get $b) (local.get $decls) (local.get $i)))
        (br_if $skip (i32.ne (call $proof_load (local.get $b) (i32.add (local.get $d) (i32.const 4)))
          (global.get $PROOF_RECORD_INDUCTIVE_DECLARATION)))
        (local.set $candidate (call $proof_make_two (local.get $b)
          (global.get $PROOF_TERM_INDUCTIVE) (local.get $i) (local.get $empty)))
        (if (i32.eqz (local.get $candidate)) (then (return (i32.const 0))))
        (br_if $skip (i32.eqz (call $proof_state_equality_shape (local.get $b) (local.get $candidate))))
        (local.set $count (call $proof_load (local.get $b)
          (i32.add (call $proof_load (local.get $b) (i32.add (local.get $d) (i32.const 8))) (i32.const 8))))
        (local.set $domain (call $proof_load (local.get $b)
          (i32.add (call $proof_load (local.get $b) (i32.add (local.get $d) (i32.const 12))) (i32.const 8))))
        (if (i32.eqz (local.get $count)) (then
          ;; User-defined monomorphic equalities remain valid at their own sort.
          (if (call $proof_convertible (local.get $b) (local.get $domain) (local.get $sort)
            (local.get $context) (i32.const 0) (i32.const 0) (local.get $work))
            (then (return (local.get $candidate))))
          (if (global.get $proof_last_error_code) (then (return (i32.const 0))))
          (br $skip)))
        (br_if $skip (i32.ne (local.get $count) (i32.const 1)))
        (br_if $skip (i32.ne (call $proof_load (local.get $b) (i32.add (local.get $domain) (i32.const 4)))
          (global.get $PROOF_TERM_SORT)))
        (local.set $level (call $proof_load (local.get $b) (i32.add (local.get $domain) (i32.const 8))))
        ;; Core.Eq takes A : Sort u, not A : Type u. Its argument is
        ;; the inferred sort level itself (Type0 therefore supplies 1).
        (br_if $skip (i32.ne (call $proof_universe_kind (local.get $b) (local.get $level)) (i32.const 1)))
        (br_if $skip (call $proof_universe_left (local.get $b) (local.get $level)))
        (local.set $arguments (call $proof_make_array (local.get $b) (i32.const 1)))
        (if (i32.eqz (local.get $arguments)) (then (return (i32.const 0))))
        (call $proof_array_set (local.get $b) (local.get $arguments) (i32.const 0)
          (call $proof_load (local.get $b) (i32.add (local.get $sort) (i32.const 8))))
        (return (call $proof_make_two (local.get $b) (global.get $PROOF_TERM_INDUCTIVE)
          (local.get $i) (local.get $arguments))))
      (br_if $done (local.get $head))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $next)))
    (i32.const 0))

  (func $proof_state_equality_child
    (param $tag i32) (param $offset i32) (result i32)
    (if (call $proof_term_child (local.get $tag) (local.get $offset)) (then (return (i32.const 1))))
    (if (i32.eq (local.get $tag) (global.get $PROOF_TERM_SORT))
      (then (return (i32.eq (local.get $offset) (i32.const 8)))))
    (if (i32.or (i32.eq (local.get $tag) (global.get $PROOF_TERM_GLOBAL))
      (i32.eq (local.get $tag) (global.get $PROOF_TERM_INDUCTIVE)))
      (then (return (i32.eq (local.get $offset) (i32.const 12)))))
    (if (i32.eq (local.get $tag) (global.get $PROOF_TERM_CONSTRUCTOR))
      (then (return (i32.eq (local.get $offset) (i32.const 16)))))
    (if (i32.or (i32.eq (local.get $tag) (global.get $PROOF_RECORD_NAME_STRING))
      (i32.eq (local.get $tag) (global.get $PROOF_RECORD_NAME_NUMBER)))
      (then (return (i32.eq (local.get $offset) (i32.const 8)))))
    (i32.const 0)
  )

  (func $proof_state_equality_same
    (param $b i32) (param $left i32) (param $right i32) (param $fuel i32) (param $work i32) (result i32)
    (local $tag i32) (local $n i32) (local $i i32) (local $x i32) (local $y i32)
    (if (i32.eq (local.get $left) (local.get $right)) (then (return (i32.const 1))))
    (if (i32.eqz (local.get $fuel)) (then (global.set $proof_last_error_code (i32.const 74)) (return (i32.const 0))))
    (if (i32.or (i32.eqz (local.get $left)) (i32.eqz (local.get $right))) (then (return (i32.const 0))))
    (local.set $tag (call $proof_load (local.get $b) (i32.add (local.get $left) (i32.const 4))))
    (if (i32.eq (local.get $tag) (global.get $PROOF_RECORD_UNIVERSE_LEVEL)) (then
