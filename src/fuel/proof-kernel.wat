            (then (local.set $cursor (call $proof_render_byte (local.get $cursor) (local.get $limit) (i32.const 92)))))
          (local.set $cursor (call $proof_render_byte (local.get $cursor) (local.get $limit) (local.get $first)))))
        (local.set $index (i32.add (local.get $index) (i32.const 1))) (br $string_next)))
