      (local.set $tag (call $proof_load (local.get $lb) (i32.add (local.get $lr) (i32.const 4))))
      (if (i32.ne (local.get $tag) (call $proof_load (local.get $rb) (i32.add (local.get $rr) (i32.const 4)))) (then (return (i32.const 0))))
      (local.set $n (call $proof_load (local.get $lb) (i32.add (local.get $lr) (i32.const 12))))
      (if (i32.ne (local.get $n) (call $proof_load (local.get $rb) (i32.add (local.get $rr) (i32.const 12)))) (then (return (i32.const 0))))
