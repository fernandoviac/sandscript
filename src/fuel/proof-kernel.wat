      (then (return (call $proof_check_recursive_calls (local.get $artifact_base)
        (call $proof_load (local.get $artifact_base) (i32.add (local.get $term_reference) (i32.const 16)))
        (local.get $definitions) (local.get $decreasing_index) (local.get $smaller_indices)))))
    (if (i32.eq (local.get $tag) (global.get $PROOF_TERM_RECURSIVE_REFERENCE))
      (then (return (i32.const 0))))
    (if (i32.eq (local.get $tag) (global.get $PROOF_TERM_APPLICATION))
      (then
        (local.set $head
          (call $proof_application_head
            (local.get $artifact_base) (local.get $term_reference)))
        (local.set $head_tag
          (call $proof_load (local.get $artifact_base)
            (i32.add (local.get $head) (i32.const 4))))
        (if (i32.eq (local.get $head_tag) (global.get $PROOF_TERM_RECURSIVE_REFERENCE))
          (then
            (local.set $target_index
              (call $proof_load (local.get $artifact_base)
                (i32.add (local.get $head) (i32.const 8))))
            (if (i32.ge_u (local.get $target_index)
                  (call $proof_array_count (local.get $artifact_base) (local.get $definitions)))
              (then (return (i32.const 0))))
            (local.set $target_definition
              (call $proof_array_get
                (local.get $artifact_base) (local.get $definitions) (local.get $target_index)))
            (local.set $target_decreasing_argument
              (call $proof_load (local.get $artifact_base)
                (i32.add (local.get $target_definition) (i32.const 16))))
            (local.set $argument_count
              (call $proof_application_count
                (local.get $artifact_base) (local.get $term_reference)))
            (if (i32.ge_u (local.get $target_decreasing_argument) (local.get $argument_count))
              (then (return (i32.const 0))))
            (local.set $argument
              (call $proof_application_argument
                (local.get $artifact_base) (local.get $term_reference)
                (local.get $target_decreasing_argument)))
            (if (i32.ne
                  (call $proof_load (local.get $artifact_base)
