    (param $artifact_base i32) (param $universe_reference i32)
    (param $arguments_array i32) (param $work i32) (param $memo i32) (result i32)
    (local $kind i32) (local $left i32) (local $right i32)
    (if (i32.eqz (call $proof_work_debit (local.get $artifact_base) (local.get $work)))
      (then (return (i32.const 0))))
    (if (i32.eqz (local.get $universe_reference)) (then (return (i32.const 0))))
    (local.set $kind (call $proof_universe_kind (local.get $artifact_base) (local.get $universe_reference)))
    (if (i32.eqz (local.get $kind)) (then (return (local.get $universe_reference))))
    (local.set $left (call $proof_universe_left (local.get $artifact_base) (local.get $universe_reference)))
    (if (i32.eq (local.get $kind) (i32.const 1))
      (then
        (if (i32.ge_u (local.get $left)
              (call $proof_array_count (local.get $artifact_base) (local.get $arguments_array)))
          (then
            (global.set $proof_last_error_code (i32.const 23))
            (return (i32.const 0))))
        (return (call $proof_array_get (local.get $artifact_base)
          (local.get $arguments_array) (local.get $left)))))
    (local.set $left (call $proof_substitute_universe_memo
      (local.get $artifact_base) (local.get $left) (local.get $arguments_array) (local.get $work) (local.get $memo)))
    (if (i32.eqz (local.get $left)) (then (return (i32.const 0))))
    (if (i32.eq (local.get $kind) (i32.const 2))
      (then
        (if (i32.eq (local.get $left)
              (call $proof_universe_left (local.get $artifact_base) (local.get $universe_reference)))
          (then (return (local.get $universe_reference))))
        (return (call $proof_universe_successor (local.get $artifact_base) (local.get $left)))))
    (local.set $right (call $proof_substitute_universe_memo (local.get $artifact_base)
      (call $proof_universe_right (local.get $artifact_base) (local.get $universe_reference))
      (local.get $arguments_array) (local.get $work) (local.get $memo)))
    (if (i32.eqz (local.get $right)) (then (return (i32.const 0))))
    (if (i32.and
          (i32.eq (local.get $left)
            (call $proof_universe_left (local.get $artifact_base) (local.get $universe_reference)))
          (i32.eq (local.get $right)
            (call $proof_universe_right (local.get $artifact_base) (local.get $universe_reference))))
      (then (return (local.get $universe_reference))))
    (if (i32.eq (local.get $kind) (i32.const 3))
      (then (return (call $proof_universe_maximum (local.get $artifact_base) (local.get $left) (local.get $right) (local.get $work)))))
    (call $proof_universe_imax (local.get $artifact_base) (local.get $left) (local.get $right) (local.get $work)))

  (func $proof_substitute_universe_array
    (param $artifact_base i32)
    (param $source_array i32)
    (param $arguments_array i32)
    (param $work i32) (result i32)
    (local $count i32)
    (local $result i32)
    (local $index i32)
    (local $level i32)
    (if (i32.eqz (call $proof_work_debit (local.get $artifact_base) (local.get $work)))
      (then (return (i32.const 0))))
    (local.set $count
      (call $proof_array_count (local.get $artifact_base) (local.get $source_array)))
    (local.set $result
      (call $proof_make_array (local.get $artifact_base) (local.get $count)))
    (local.set $index (i32.const 0))
    (block $done
      (loop $next
    (if (i32.eqz (call $proof_work_debit (local.get $artifact_base) (local.get $work)))
      (then (return (i32.const 0))))
        (br_if $done (i32.ge_u (local.get $index) (local.get $count)))
        (local.set $level
          (call $proof_substitute_universe (local.get $artifact_base)
            (call $proof_array_get (local.get $artifact_base)
              (local.get $source_array) (local.get $index))
            (local.get $arguments_array) (local.get $work)))
        (if (i32.eqz (local.get $level)) (then (return (i32.const 0))))
        (call $proof_array_set (local.get $artifact_base)
          (local.get $result) (local.get $index) (local.get $level))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $next)))
    (local.get $result)
  )

;; No-op universe substitutions are fixed-cost and allocate nothing.
(func $proof_instantiate_term_universes_leaf
  (param $artifact_base i32) (param $term_reference i32)
  (param $arguments_array i32) (param $work i32) (result i32)
  (local $tag i32)
  (if (i32.eqz (local.get $term_reference)) (then (return (i32.const 0))))
  (if (i32.eqz (call $proof_array_count (local.get $artifact_base) (local.get $arguments_array)))
    (then (return (local.get $term_reference))))
  (local.set $tag (call $proof_load (local.get $artifact_base) (i32.add (local.get $term_reference) (i32.const 4))))
  (if (i32.or
      (i32.or (i32.eq (local.get $tag) (global.get $PROOF_TERM_BOUND))
        (i32.eq (local.get $tag) (global.get $PROOF_TERM_RECURSIVE_REFERENCE)))
      (i32.or (i32.eq (local.get $tag) (global.get $PROOF_TERM_NAMED_LOCAL))
        (i32.or (i32.eq (local.get $tag) (global.get $PROOF_TERM_NAT_LITERAL))
          (i32.eq (local.get $tag) (global.get $PROOF_TERM_STRING_LITERAL)))))
    (then (return (local.get $term_reference))))
  (if (i32.and (i32.eq (local.get $tag) (i32.const 0x10f))
      (i32.eq (call $proof_load (local.get $artifact_base) (local.get $term_reference)) (i32.const 3)))
    (then (return (local.get $term_reference))))
  (i32.const -1))
;; Cache only root instantiations of immutable input terms. Recursive descent
;; stays uncached: a 256-slot direct-mapped table amortizes repeated declaration
;; bodies without allocating a memo per child. Keys compare universe tuples
;; structurally, never by an unverified hash. The private header's third word
;; is a lifetime watermark; any rewind below it discards the whole table.
(func $proof_instantiate_term_universes
  (param $artifact_base i32) (param $term_reference i32) (param $arguments_array i32) (param $work i32) (result i32)
  (local $cache i32) (local $slot i32) (local $previous i32)
  (local $count i32) (local $index i32) (local $value i32)
  (if (i32.eqz (call $proof_work_debit (local.get $artifact_base) (local.get $work))) (then (return (i32.const 0))))
  (local.set $value (call $proof_instantiate_term_universes_leaf (local.get $artifact_base)
    (local.get $term_reference) (local.get $arguments_array) (local.get $work)))
  (if (i32.ge_s (local.get $value) (i32.const 0)) (then (return (local.get $value))))
  (if (i32.or
      (i32.eqz (i32.and (call $proof_load (local.get $artifact_base) (i32.add (local.get $work) (i32.const 24))) (i32.const 2)))
      (i32.ge_u (local.get $term_reference) (global.get $proof_current_artifact_length))) (then
    (return (call $proof_instantiate_term_universes_uncached (local.get $artifact_base)
      (local.get $term_reference) (local.get $arguments_array) (local.get $work)))))
  (local.set $cache (global.get $proof_universe_instantiation_cache))
  (if (i32.eqz (local.get $cache)) (then
    (local.set $cache (call $proof_allocate_record (local.get $artifact_base) (i32.const 771) (i32.const 0x10f)))
    (if (i32.eqz (local.get $cache)) (then (return (i32.const 0))))
    (call $proof_clear_bytes (local.get $artifact_base) (i32.add (local.get $cache) (i32.const 12)) (i32.const 3072))
    (if (global.get $proof_last_error_code) (then (return (i32.const 0))))
    (call $proof_store (local.get $artifact_base) (i32.add (local.get $cache) (i32.const 8)) (global.get $proof_scratch_cursor))
    (global.set $proof_universe_instantiation_cache (local.get $cache))))
  (local.set $slot (i32.add (i32.add (local.get $cache) (i32.const 12))
    (i32.mul (i32.shr_u (i32.mul (i32.shr_u (local.get $term_reference) (i32.const 2)) (i32.const 0x9e3779b1)) (i32.const 24)) (i32.const 12))))
  (if (i32.eq (call $proof_load (local.get $artifact_base) (local.get $slot)) (local.get $term_reference)) (then
    (local.set $previous (call $proof_load (local.get $artifact_base) (i32.add (local.get $slot) (i32.const 4))))
    (local.set $count (call $proof_array_count (local.get $artifact_base) (local.get $arguments_array)))
    (block $different
      (br_if $different (i32.ne (local.get $count) (call $proof_array_count (local.get $artifact_base) (local.get $previous))))
      (block $equal (loop $next
        (br_if $equal (i32.ge_u (local.get $index) (local.get $count)))
        (br_if $different (i32.eqz (call $proof_universe_structural_equal (local.get $artifact_base)
          (call $proof_array_get (local.get $artifact_base) (local.get $arguments_array) (local.get $index))
          (call $proof_array_get (local.get $artifact_base) (local.get $previous) (local.get $index)) (local.get $work))))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $next)))
      (return (call $proof_load (local.get $artifact_base) (i32.add (local.get $slot) (i32.const 8)))))))
  (local.set $value (call $proof_instantiate_term_universes_uncached (local.get $artifact_base)
    (local.get $term_reference) (local.get $arguments_array) (local.get $work)))
  (if (i32.or (i32.eqz (local.get $value)) (global.get $proof_last_error_code)) (then (return (i32.const 0))))
  (call $proof_store (local.get $artifact_base) (local.get $slot) (local.get $term_reference))
  (call $proof_store (local.get $artifact_base) (i32.add (local.get $slot) (i32.const 4)) (local.get $arguments_array))
  (call $proof_store (local.get $artifact_base) (i32.add (local.get $slot) (i32.const 8)) (local.get $value))
  (call $proof_store (local.get $artifact_base) (i32.add (local.get $cache) (i32.const 8)) (global.get $proof_scratch_cursor))
  (local.get $value))
  (func $proof_instantiate_term_universes_uncached
    (param $artifact_base i32) (param $term_reference i32) (param $arguments_array i32) (param $work i32) (result i32)
    (local $tag i32)
    (local $walk_n i32) (local $walk_i i32) (local $walk_x i32) (local $walk_y i32) (local $walk_out i32)
    (local $first i32) (local $second i32) (local $new_first i32) (local $new_second i32)
    (if (i32.eqz (call $proof_work_debit (local.get $artifact_base) (local.get $work)))
      (then (return (i32.const 0))))
    (if (i32.eqz (local.get $term_reference)) (then (return (i32.const 0))))
    (if (i32.eqz (call $proof_array_count (local.get $artifact_base) (local.get $arguments_array)))
      (then (return (local.get $term_reference))))
    (local.set $tag (call $proof_load (local.get $artifact_base) (i32.add (local.get $term_reference) (i32.const 4))))
    (if (i32.eq (local.get $tag) (global.get $PROOF_RECORD_UNIVERSE_LEVEL))
      (then (return (call $proof_substitute_universe (local.get $artifact_base) (local.get $term_reference) (local.get $arguments_array) (local.get $work)))))
    ;; These tags have neither semantic term nor universe edges.
    (if (i32.or
      (i32.or (i32.eq (local.get $tag) (global.get $PROOF_TERM_BOUND))
        (i32.eq (local.get $tag) (global.get $PROOF_TERM_RECURSIVE_REFERENCE)))
      (i32.or (i32.eq (local.get $tag) (global.get $PROOF_TERM_NAMED_LOCAL))
        (i32.or (i32.eq (local.get $tag) (global.get $PROOF_TERM_NAT_LITERAL))
          (i32.eq (local.get $tag) (global.get $PROOF_TERM_STRING_LITERAL)))))
      (then (return (local.get $term_reference))))
    ;; Fixed-shape term nodes avoid a generic field scan and lazy record copy.
    (if (i32.and
        (i32.eq (call $proof_load (local.get $artifact_base) (local.get $term_reference)) (i32.const 4))
        (i32.or (i32.eq (local.get $tag) (global.get $PROOF_TERM_APPLICATION))
          (i32.or (i32.eq (local.get $tag) (global.get $PROOF_TERM_PRODUCT))
            (i32.eq (local.get $tag) (global.get $PROOF_TERM_LAMBDA)))))
      (then
        (local.set $first (call $proof_load (local.get $artifact_base) (i32.add (local.get $term_reference) (i32.const 8))))
        (local.set $second (call $proof_load (local.get $artifact_base) (i32.add (local.get $term_reference) (i32.const 12))))
        (local.set $new_first (call $proof_instantiate_term_universes_uncached (local.get $artifact_base)
          (local.get $first) (local.get $arguments_array) (local.get $work)))
        (if (i32.and (i32.ne (local.get $first) (i32.const 0)) (i32.eqz (local.get $new_first)))
          (then (return (i32.const 0))))
        (local.set $new_second (call $proof_instantiate_term_universes_uncached (local.get $artifact_base)
          (local.get $second) (local.get $arguments_array) (local.get $work)))
        (if (i32.and (i32.ne (local.get $second) (i32.const 0)) (i32.eqz (local.get $new_second)))
          (then (return (i32.const 0))))
        (if (i32.and (i32.eq (local.get $first) (local.get $new_first))
            (i32.eq (local.get $second) (local.get $new_second)))
          (then (return (local.get $term_reference))))
        (return (call $proof_make_two (local.get $artifact_base) (local.get $tag)
          (local.get $new_first) (local.get $new_second)))))
    (if (i32.eq (local.get $tag) (global.get $PROOF_TERM_SORT))
      (then (local.set $walk_i (i32.const 8))))
    (if (i32.or (i32.eq (local.get $tag) (global.get $PROOF_TERM_GLOBAL))
        (i32.eq (local.get $tag) (global.get $PROOF_TERM_INDUCTIVE)))
      (then (local.set $walk_i (i32.const 12))))
    (if (i32.or (i32.eq (local.get $tag) (global.get $PROOF_TERM_CONSTRUCTOR))
        (i32.eq (local.get $tag) (global.get $PROOF_TERM_PROJECTION)))
      (then (local.set $walk_i (i32.const 16))))
    (if (local.get $walk_i) (then
      (if (i32.eq (call $proof_load (local.get $artifact_base) (local.get $term_reference))
          (i32.add (i32.shr_u (local.get $walk_i) (i32.const 2)) (i32.const 1)))
        (then
          (local.set $walk_x (call $proof_load (local.get $artifact_base)
            (i32.add (local.get $term_reference) (local.get $walk_i))))
          (if (i32.eqz (local.get $walk_x)) (then (return (local.get $term_reference))))
          (local.set $walk_y (call $proof_instantiate_term_universes_uncached (local.get $artifact_base)
            (local.get $walk_x) (local.get $arguments_array) (local.get $work)))
          (if (i32.eqz (local.get $walk_y)) (then (return (i32.const 0))))
          (if (i32.eq (local.get $walk_x) (local.get $walk_y)) (then (return (local.get $term_reference))))
          (if (i32.eq (local.get $walk_i) (i32.const 8))
            (then (return (call $proof_make_one (local.get $artifact_base) (local.get $tag) (local.get $walk_y)))))
          (if (i32.eq (local.get $walk_i) (i32.const 12))
            (then (return (call $proof_make_two (local.get $artifact_base) (local.get $tag)
              (call $proof_load (local.get $artifact_base) (i32.add (local.get $term_reference) (i32.const 8)))
              (local.get $walk_y)))))
          (return (call $proof_make_three (local.get $artifact_base) (local.get $tag)
            (call $proof_load (local.get $artifact_base) (i32.add (local.get $term_reference) (i32.const 8)))
            (call $proof_load (local.get $artifact_base) (i32.add (local.get $term_reference) (i32.const 12)))
            (local.get $walk_y)))))))
    (local.set $walk_n (call $proof_load (local.get $artifact_base) (local.get $term_reference)))
    (local.set $walk_out (local.get $term_reference))
    (local.set $walk_i (i32.const 8))
    (block $walk_done (loop $walk_next
      (br_if $walk_done (i32.ge_u (local.get $walk_i) (i32.mul (local.get $walk_n) (i32.const 4))))
      (if (call $proof_state_equality_child (local.get $tag) (local.get $walk_i)) (then
        (local.set $walk_x (call $proof_load (local.get $artifact_base) (i32.add (local.get $term_reference) (local.get $walk_i))))
        (if (local.get $walk_x) (then
          (local.set $walk_y (call $proof_instantiate_term_universes_uncached (local.get $artifact_base) (local.get $walk_x) (local.get $arguments_array) (local.get $work)))
          (if (i32.eqz (local.get $walk_y)) (then (return (i32.const 0))))
          (if (i32.ne (local.get $walk_x) (local.get $walk_y)) (then
            (if (i32.eq (local.get $walk_out) (local.get $term_reference)) (then
