    (if (i32.eqz (call $proof_work_debit (local.get $artifact_base) (local.get $work)))
      (then
        (return (i32.const 0))))
    (if (i32.or (i32.eqz (local.get $left_reference)) (i32.eqz (local.get $right_reference)))
      (then (return (i32.eq (local.get $left_reference) (local.get $right_reference)))))
