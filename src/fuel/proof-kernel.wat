  ;; Count a type's definitional telescope in its actual typing context.
  ;; Extend the context before normalizing each dependent codomain.
  ;; Negative results distinguish normalization/allocation failure from arity 0.
  (func $proof_state_apply_product_count
    (param $artifact_base i32) (param $current i32)
    (param $context i32) (param $work i32) (result i32)
    (local $count i32)
    (loop $next
      (local.set $current
        (call $proof_weak_head_normalize
          (local.get $artifact_base) (local.get $current)
          (local.get $context) (i32.const 0) (i32.const 0) (local.get $work)))
      (if (i32.or (i32.eqz (local.get $current)) (global.get $proof_last_error_code))
        (then (return (i32.const -1))))
      (if (i32.ne
        (call $proof_load (local.get $artifact_base)
          (i32.add (local.get $current) (i32.const 4)))
        (global.get $PROOF_TERM_PRODUCT))
        (then (return (local.get $count))))
      (local.set $context
        (call $proof_context_extend
          (local.get $artifact_base) (local.get $context)
          (call $proof_load (local.get $artifact_base)
            (i32.add (local.get $current) (i32.const 8)))))
      (if (i32.eqz (local.get $context)) (then (return (i32.const -1))))
      (local.set $current
        (call $proof_load (local.get $artifact_base)
          (i32.add (local.get $current) (i32.const 12))))
      (local.set $count (i32.add (local.get $count) (i32.const 1)))
      (br $next))
    (i32.const -1))

;; These two globals are call-local capabilities, EXCLUDED from runtime_globals.
;; proof_work_step installs and clears them around its inner implementation.
(global $proof_boundary_active_base (mut i32) (i32.const 0))
(global $proof_boundary_active_work (mut i32) (i32.const 0))

(func $proof_boundary_get (param $base i32) (param $work i32) (param $field i32) (result i32)
  (call $proof_load (local.get $base)
    (i32.add (local.get $work) (i32.add (global.get $PROOF_WORK_BOUNDARY_OFFSET) (local.get $field)))))
(func $proof_boundary_set (param $base i32) (param $work i32) (param $field i32) (param $value i32)
  ;; Raw write: metadata cannot recursively invalidate itself.
  (i32.store (call $abs (i32.add (local.get $base)
    (i32.add (local.get $work) (i32.add (global.get $PROOF_WORK_BOUNDARY_OFFSET) (local.get $field))))) (local.get $value)))
(func $proof_boundary_reset (param $base i32) (param $work i32) (param $cursor i32)
  (local $table i32) (local $words i32)
  (if (i32.eqz (local.get $work)) (then (return)))
  (local.set $table (call $proof_boundary_get (local.get $base) (local.get $work) (i32.const 0)))
  (local.set $words (call $proof_boundary_get (local.get $base) (local.get $work) (i32.const 4)))
  ;; Avoid reading the potentially reclaimed table header to learn its extent.
  (if (i32.or (i32.gt_u (local.get $table) (local.get $cursor))
        (i32.gt_u (i32.add (i32.const 12) (i32.shl (local.get $words) (i32.const 2)))
          (i32.sub (local.get $cursor) (local.get $table))))
    (then
      (call $proof_boundary_set (local.get $base) (local.get $work) (i32.const 0) (i32.const 0))
      (call $proof_boundary_set (local.get $base) (local.get $work) (i32.const 4) (i32.const 0))))
  (call $proof_boundary_set (local.get $base) (local.get $work) (i32.const 8) (i32.const 0))
  (call $proof_boundary_set (local.get $base) (local.get $work) (i32.const 12) (i32.const 16)))

(func $proof_boundary_before_store (param $base i32) (param $offset i32) (param $value i32)
  (local $work i32) (local $frontier i32) (local $table i32) (local $bits i32) (local $header i32)
  (local.set $work (global.get $proof_boundary_active_work))
  (if (i32.or (i32.eqz (local.get $work))
        (i32.ne (local.get $base) (global.get $proof_boundary_active_base))) (then (return)))
  (local.set $frontier (call $proof_boundary_get (local.get $base) (local.get $work) (i32.const 12)))
  (if (i32.or (i32.lt_u (local.get $offset) (i32.const 16))
        (i32.ge_u (local.get $offset) (local.get $frontier))) (then (return)))
  (if (i32.eq (call $proof_load (local.get $base) (local.get $offset)) (local.get $value)) (then (return)))
  ;; proof_store contract is word-aligned. Also invalidate if it is ever used
  ;; unaligned in the authenticated prefix; do not try to classify partial words.
  (if (i32.and (local.get $offset) (i32.const 3))
    (then (call $proof_boundary_reset (local.get $base) (local.get $work) (global.get $proof_scratch_cursor)) (return)))
  (local.set $table (call $proof_boundary_get (local.get $base) (local.get $work) (i32.const 0)))
  (if (i32.eqz (local.get $table)) (then (return)))
  (local.set $header (local.get $offset))
  (local.set $bits (call $proof_array_get (local.get $base) (local.get $table) (i32.shr_u (local.get $header) (i32.const 7))))
  (if (i32.and (local.get $bits) (i32.shl (i32.const 1) (i32.and (i32.shr_u (local.get $header) (i32.const 2)) (i32.const 31))))
    (then (call $proof_boundary_reset (local.get $base) (local.get $work) (global.get $proof_scratch_cursor))))
  ;; Membership depends on record lengths, not tags. Consumers read tags live.
)

;; Only extend a contiguous verified prefix. At most one new bitmap word is
;; initialized here; wider allocation gaps remain the scheduled scanner's job.
(func $proof_boundary_append (param $base i32) (param $reference i32) (param $next i32)
  (local $work i32) (local $table i32) (local $initialized i32)
  (local $last_slot i32) (local $slot i32)
  (local.set $work (global.get $proof_boundary_active_work))
  (if (i32.or (i32.eqz (local.get $work))
      (i32.ne (local.get $base) (global.get $proof_boundary_active_base))) (then (return)))
  (if (i32.or (i32.lt_u (local.get $reference) (i32.const 16))
      (i32.or (i32.and (local.get $reference) (i32.const 3))
        (i32.lt_u (i32.sub (local.get $next) (local.get $reference)) (i32.const 8)))) (then (return)))
  (if (i32.ne (local.get $reference)
      (call $proof_boundary_get (local.get $base) (local.get $work) (i32.const 12))) (then (return)))
  (local.set $table (call $proof_boundary_get (local.get $base) (local.get $work) (i32.const 0)))
  (if (i32.eqz (local.get $table)) (then (return)))
  (local.set $initialized (call $proof_boundary_get (local.get $base) (local.get $work) (i32.const 8)))
  (local.set $last_slot (i32.shr_u (i32.sub (local.get $next) (i32.const 1)) (i32.const 7)))
  (if (i32.ge_u (local.get $last_slot)
      (call $proof_boundary_get (local.get $base) (local.get $work) (i32.const 4))) (then (return)))
  (if (i32.gt_u (local.get $last_slot) (local.get $initialized)) (then (return)))
  (if (i32.eq (local.get $last_slot) (local.get $initialized)) (then
    (call $proof_array_set (local.get $base) (local.get $table) (local.get $initialized) (i32.const 0))
    (call $proof_boundary_set (local.get $base) (local.get $work) (i32.const 8)
      (i32.add (local.get $initialized) (i32.const 1)))))
  (local.set $slot (i32.shr_u (local.get $reference) (i32.const 7)))
  (call $proof_array_set (local.get $base) (local.get $table) (local.get $slot)
    (i32.or (call $proof_array_get (local.get $base) (local.get $table) (local.get $slot))
      (i32.shl (i32.const 1) (i32.and (i32.shr_u (local.get $reference) (i32.const 2)) (i32.const 31)))))
  (call $proof_boundary_set (local.get $base) (local.get $work) (i32.const 12) (local.get $next)))
(func $proof_boundary_before_bytes (param $destination i32) (param $count i32)
  (local $base i32) (local $work i32) (local $start i32) (local $frontier i32)
  (local $table i32) (local $offset i32) (local $last i32) (local $end i64)
  (local $first_slot i32) (local $last_slot i32) (local $low_mask i32) (local $high_mask i32)
  (local.set $work (global.get $proof_boundary_active_work))
  (if (i32.or (i32.eqz (local.get $work)) (i32.eqz (local.get $count))) (then (return)))
  (local.set $base (global.get $proof_boundary_active_base))
  (local.set $start (call $abs (i32.add (local.get $base) (i32.const 16))))
  (local.set $frontier (call $abs (i32.add (local.get $base)
    (call $proof_boundary_get (local.get $base) (local.get $work) (i32.const 12)))))
  (local.set $end (i64.add (i64.extend_i32_u (local.get $destination)) (i64.extend_i32_u (local.get $count))))
  (if (i32.eqz (i32.and (i32.lt_u (local.get $destination) (local.get $frontier))
      (i64.gt_u (local.get $end) (i64.extend_i32_u (local.get $start))))) (then (return)))
  (block $invalidate
    ;; A <=256-byte write overlaps header starts in at most three bitmap words.
    ;; Larger or prefix-crossing writes still invalidate conservatively.
    (br_if $invalidate (i32.gt_u (local.get $count) (i32.const 256)))
    (br_if $invalidate (i32.lt_u (local.get $destination) (local.get $start)))
    (br_if $invalidate (i64.gt_u (local.get $end) (i64.extend_i32_u (local.get $frontier))))
    (local.set $table (call $proof_boundary_get (local.get $base) (local.get $work) (i32.const 0)))
    (br_if $invalidate (i32.eqz (local.get $table)))
    (local.set $offset (i32.sub (local.get $destination) (i32.sub (local.get $start) (i32.const 16))))
    (local.set $last (i32.sub (i32.add (local.get $offset) (local.get $count)) (i32.const 1)))
    (local.set $offset (i32.sub (i32.and (local.get $offset) (i32.const -4)) (i32.const 4)))
    (local.set $first_slot (i32.shr_u (local.get $offset) (i32.const 7)))
    (local.set $last_slot (i32.shr_u (local.get $last) (i32.const 7)))
    (local.set $low_mask (i32.shl (i32.const -1)
      (i32.and (i32.shr_u (local.get $offset) (i32.const 2)) (i32.const 31))))
    (local.set $high_mask (i32.shr_u (i32.const -1)
      (i32.sub (i32.const 31) (i32.and (i32.shr_u (local.get $last) (i32.const 2)) (i32.const 31)))))
    (if (i32.eq (local.get $first_slot) (local.get $last_slot))
      (then
        (br_if $invalidate (i32.and (call $proof_array_get (local.get $base) (local.get $table) (local.get $first_slot))
          (i32.and (local.get $low_mask) (local.get $high_mask))))
        (return)))
    (br_if $invalidate (i32.and (call $proof_array_get (local.get $base) (local.get $table) (local.get $first_slot)) (local.get $low_mask)))
    (br_if $invalidate (i32.and (call $proof_array_get (local.get $base) (local.get $table) (local.get $last_slot)) (local.get $high_mask)))
    (if (i32.gt_u (i32.sub (local.get $last_slot) (local.get $first_slot)) (i32.const 1))
      (then (br_if $invalidate (call $proof_array_get (local.get $base) (local.get $table) (i32.add (local.get $first_slot) (i32.const 1))))))
    (return))
  (call $proof_boundary_reset (local.get $base) (local.get $work) (global.get $proof_scratch_cursor)))

(func $proof_boundary_set_cursor (param $cursor i32)
  (if (i32.and (i32.ne (global.get $proof_boundary_active_work) (i32.const 0))
        (i32.lt_u (local.get $cursor) (global.get $proof_scratch_cursor)))
    (then (call $proof_boundary_rewind (global.get $proof_boundary_active_base)
      (global.get $proof_boundary_active_work) (local.get $cursor))))
  (global.set $proof_scratch_cursor (local.get $cursor)))

;; One record-boundary probe is bounded: validate its length, mark one bit,
;; and publish the next frontier. The surrounding loop remains resumable.
(func $proof_boundary_scan_record
  (param $base i32) (param $work i32) (param $table i32)
  (param $limit i32) (param $offset i32) (result i32)
  (local $words i32) (local $slot i32)
  (if (i32.ge_u (local.get $offset) (local.get $limit)) (then (return (i32.const 0))))
  (if (i32.lt_u (i32.sub (local.get $limit) (local.get $offset)) (i32.const 8)) (then (return (i32.const 0))))
  (local.set $words (call $proof_load (local.get $base) (local.get $offset)))
  (if (i32.or (i32.lt_u (local.get $words) (i32.const 2))
      (i32.gt_u (local.get $words) (i32.shr_u (i32.sub (local.get $limit) (local.get $offset)) (i32.const 2))))
    (then (return (i32.const 0))))
  (local.set $slot (i32.shr_u (local.get $offset) (i32.const 7)))
  (call $proof_array_set (local.get $base) (local.get $table) (local.get $slot)
    (i32.or (call $proof_array_get (local.get $base) (local.get $table) (local.get $slot))
      (i32.shl (i32.const 1) (i32.and (i32.shr_u (local.get $offset) (i32.const 2)) (i32.const 31)))))
  (local.set $offset (i32.add (local.get $offset) (i32.shl (local.get $words) (i32.const 2))))
  (call $proof_boundary_set (local.get $base) (local.get $work) (i32.const 12) (local.get $offset))
  (local.get $offset))
;; Bound one scan transition to eight records, independent of record sizes.
;; Every record still passes the same extent check before its bit is published.
(func $proof_boundary_scan_chunk
  (param $base i32) (param $work i32) (param $table i32)
  (param $limit i32) (param $offset i32) (param $reference i32) (result i32)
  (if (i32.or (i32.eqz (local.get $offset)) (i32.gt_u (local.get $offset) (local.get $reference)))
    (then (return (local.get $offset))))
  (local.set $offset (call $proof_boundary_scan_record (local.get $base) (local.get $work)
    (local.get $table) (local.get $limit) (local.get $offset)))
  (if (i32.or (i32.eqz (local.get $offset)) (i32.gt_u (local.get $offset) (local.get $reference)))
    (then (return (local.get $offset))))
  (local.set $offset (call $proof_boundary_scan_record (local.get $base) (local.get $work)
    (local.get $table) (local.get $limit) (local.get $offset)))
  (if (i32.or (i32.eqz (local.get $offset)) (i32.gt_u (local.get $offset) (local.get $reference)))
    (then (return (local.get $offset))))
  (local.set $offset (call $proof_boundary_scan_record (local.get $base) (local.get $work)
    (local.get $table) (local.get $limit) (local.get $offset)))
  (if (i32.or (i32.eqz (local.get $offset)) (i32.gt_u (local.get $offset) (local.get $reference)))
    (then (return (local.get $offset))))
  (local.set $offset (call $proof_boundary_scan_record (local.get $base) (local.get $work)
    (local.get $table) (local.get $limit) (local.get $offset)))
  (if (i32.or (i32.eqz (local.get $offset)) (i32.gt_u (local.get $offset) (local.get $reference)))
    (then (return (local.get $offset))))
  (local.set $offset (call $proof_boundary_scan_record (local.get $base) (local.get $work)
    (local.get $table) (local.get $limit) (local.get $offset)))
  (if (i32.or (i32.eqz (local.get $offset)) (i32.gt_u (local.get $offset) (local.get $reference)))
    (then (return (local.get $offset))))
  (local.set $offset (call $proof_boundary_scan_record (local.get $base) (local.get $work)
    (local.get $table) (local.get $limit) (local.get $offset)))
  (if (i32.or (i32.eqz (local.get $offset)) (i32.gt_u (local.get $offset) (local.get $reference)))
    (then (return (local.get $offset))))
  (local.set $offset (call $proof_boundary_scan_record (local.get $base) (local.get $work)
    (local.get $table) (local.get $limit) (local.get $offset)))
  (if (i32.or (i32.eqz (local.get $offset)) (i32.gt_u (local.get $offset) (local.get $reference)))
    (then (return (local.get $offset))))
  (local.set $offset (call $proof_boundary_scan_record (local.get $base) (local.get $work)
    (local.get $table) (local.get $limit) (local.get $offset)))
  (local.get $offset))
(func $proof_reference_valid_indexed
  (param $artifact_base i32) (param $artifact_length i32)
  (param $reference i32) (param $work i32) (result i32)
  (local $words i32) (local $table i32) (local $i i32)
  (local $offset i32) (local $record_words i32)
  (local $cached i32)
  (local.set $cached (call $proof_boundary_cached (local.get $artifact_base)
    (local.get $artifact_length) (local.get $reference) (local.get $work)))
  (if (i32.ge_s (local.get $cached) (i32.const 0)) (then (return (local.get $cached))))
  ;; Foreign arenas retain the scheduled original scanner.
  (if (i32.or (i32.eqz (local.get $work))
        (i32.or (i32.ne (local.get $artifact_base) (global.get $proof_boundary_active_base))
          (i32.ne (local.get $work) (global.get $proof_boundary_active_work))))
    (then (return (call $proof_reference_valid
      (local.get $artifact_base) (local.get $artifact_length) (local.get $reference)))))
  (if (i32.or (i32.lt_u (local.get $reference) (i32.const 16))
        (i32.ne (i32.and (local.get $reference) (i32.const 3)) (i32.const 0)))
    (then (return (i32.const 0))))
  (if (i32.ge_u (local.get $reference) (local.get $artifact_length))
    (then (return (i32.const 0))))
  (if (i32.lt_u (i32.sub (local.get $artifact_length) (local.get $reference)) (i32.const 8))
    (then (return (i32.const 0))))
  ;; Capacity, not the untrusted requested length, controls allocation.
  (if (i32.gt_u (local.get $artifact_length) (global.get $proof_scratch_limit))
    (then (return (i32.const 0))))
  (local.set $words (i32.add (i32.shr_u (global.get $proof_scratch_limit) (i32.const 7))
    (i32.ne (i32.and (global.get $proof_scratch_limit) (i32.const 127)) (i32.const 0))))
  (if (i32.lt_u (call $proof_boundary_get (local.get $artifact_base) (local.get $work) (i32.const 4)) (local.get $words))
    (then
      ;; Growth rebuilds rather than copying old bits.
      (local.set $table (call $proof_make_array (local.get $artifact_base) (local.get $words)))
      (if (i32.eqz (local.get $table)) (then (return (i32.const 0))))
      (call $proof_boundary_set (local.get $artifact_base) (local.get $work) (i32.const 0) (local.get $table))
      (call $proof_boundary_set (local.get $artifact_base) (local.get $work) (i32.const 4) (local.get $words))
      (call $proof_boundary_set (local.get $artifact_base) (local.get $work) (i32.const 8) (i32.const 0))
      (call $proof_boundary_set (local.get $artifact_base) (local.get $work) (i32.const 12) (i32.const 16))))
  (local.set $table (call $proof_boundary_get (local.get $artifact_base) (local.get $work) (i32.const 0)))
  ;; Initialize only the checked extent. A later larger request extends this
  ;; scheduled clear before scanning; spare capacity is never consulted.
  (local.set $words (i32.add (i32.shr_u (local.get $artifact_length) (i32.const 7))
    (i32.ne (i32.and (local.get $artifact_length) (i32.const 127)) (i32.const 0))))
  (local.set $i (call $proof_boundary_get (local.get $artifact_base) (local.get $work) (i32.const 8)))
  (block $clear_done (loop $clear_next
    (br_if $clear_done (i32.ge_u (local.get $i) (local.get $words)))
    (call $proof_array_set (local.get $artifact_base) (local.get $table) (local.get $i) (i32.const 0))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (call $proof_boundary_set (local.get $artifact_base) (local.get $work) (i32.const 8) (local.get $i))
    (br $clear_next)))
  (local.set $offset (call $proof_boundary_get (local.get $artifact_base) (local.get $work) (i32.const 12)))
  (block $scan_done (loop $scan_next
    (br_if $scan_done (i32.gt_u (local.get $offset) (local.get $reference)))
    (local.set $offset (call $proof_boundary_scan_chunk (local.get $artifact_base) (local.get $work)
      (local.get $table) (local.get $artifact_length) (local.get $offset) (local.get $reference)))
    (if (i32.eqz (local.get $offset)) (then (return (i32.const 0))))
    (br $scan_next)))
  (if (i32.eqz (i32.and
        (call $proof_array_get (local.get $artifact_base) (local.get $table) (i32.shr_u (local.get $reference) (i32.const 7)))
        (i32.shl (i32.const 1) (i32.and (i32.shr_u (local.get $reference) (i32.const 2)) (i32.const 31)))))
    (then (return (i32.const 0))))
  ;; Cached membership cannot authorize truncation in this call's extent.
  (local.set $record_words (call $proof_load (local.get $artifact_base) (local.get $reference)))
  (i32.and (i32.ge_u (local.get $record_words) (i32.const 2))
    (i32.le_u (local.get $record_words) (i32.shr_u (i32.sub (local.get $artifact_length) (local.get $reference)) (i32.const 2)))))

;; Bounded bitmap lookup: callers establish table survival and an aligned
;; offset below the verified frontier, hence an initialized bitmap word.
(func $proof_boundary_marked (param $base i32) (param $table i32) (param $offset i32) (result i32)
  (i32.ne
    (i32.and
      (call $proof_array_get (local.get $base) (local.get $table) (i32.shr_u (local.get $offset) (i32.const 7)))
      (i32.shl (i32.const 1) (i32.and (i32.shr_u (local.get $offset) (i32.const 2)) (i32.const 31))))
    (i32.const 0)))

(func $proof_boundary_rewind (param $base i32) (param $work i32) (param $cursor i32)
  (local $table i32) (local $words i32) (local $frontier i32)
  (local $slot i32) (local $bit i32)
  (if (i32.eqz (local.get $work)) (then (return)))
  ;; The table and every cached argument/result precede its watermark.
  (if (i32.and (i32.ne (global.get $proof_universe_instantiation_cache) (i32.const 0))
      (i32.and (i32.eq (local.get $work) (global.get $proof_boundary_active_work))
        (i32.eq (local.get $base) (global.get $proof_boundary_active_base)))) (then
    (if (i32.lt_u (local.get $cursor) (call $proof_load (local.get $base)
        (i32.add (global.get $proof_universe_instantiation_cache) (i32.const 8))))
      (then (global.set $proof_universe_instantiation_cache (i32.const 0))))))
  (local.set $table (call $proof_boundary_get (local.get $base) (local.get $work) (i32.const 0)))
  (local.set $words (call $proof_boundary_get (local.get $base) (local.get $work) (i32.const 4)))
  ;; Check saved physical extent BEFORE consulting any possibly reclaimed bits.
  (if (i32.or (i32.eqz (local.get $table))
        (i32.or (i32.gt_u (local.get $table) (local.get $cursor))
          (i32.gt_u (i32.add (i32.const 12) (i32.shl (local.get $words) (i32.const 2)))
            (i32.sub (local.get $cursor) (local.get $table)))))
    (then (call $proof_boundary_reset (local.get $base) (local.get $work) (local.get $cursor)) (return)))
  (local.set $frontier (call $proof_boundary_get (local.get $base) (local.get $work) (i32.const 12)))
  ;; No authenticated record crosses a rewind at/after the next record boundary.
  (if (i32.ge_u (local.get $cursor) (local.get $frontier)) (then (return)))
  (if (i32.or (i32.lt_u (local.get $cursor) (i32.const 16))
        (i32.ne (i32.and (local.get $cursor) (i32.const 3)) (i32.const 0)))
    (then (call $proof_boundary_reset (local.get $base) (local.get $work) (local.get $cursor)) (return)))
  ;; An interior/unknown rewind cannot preserve any boundary capability.
  (if (i32.eqz (call $proof_boundary_marked (local.get $base) (local.get $table) (local.get $cursor)))
    (then (call $proof_boundary_reset (local.get $base) (local.get $work) (local.get $cursor)) (return)))
  (local.set $slot (i32.shr_u (local.get $cursor) (i32.const 7)))
  (local.set $bit (i32.and (i32.shr_u (local.get $cursor) (i32.const 2)) (i32.const 31)))
  (if (local.get $bit)
    (then
      ;; Keep only starts STRICTLY before cursor in this one partial word.
      (call $proof_array_set (local.get $base) (local.get $table) (local.get $slot)
        (i32.and (call $proof_array_get (local.get $base) (local.get $table) (local.get $slot))
          (i32.sub (i32.shl (i32.const 1) (local.get $bit)) (i32.const 1))))
      (call $proof_boundary_set (local.get $base) (local.get $work) (i32.const 8)
        (i32.add (local.get $slot) (i32.const 1))))
    (else
      (call $proof_boundary_set (local.get $base) (local.get $work) (i32.const 8) (local.get $slot))))
  ;; Higher words become logically uninitialized: scheduled clearing, not this
  ;; atomic leaf, removes them before any subsequent extended scan can use them.
  (call $proof_boundary_set (local.get $base) (local.get $work) (i32.const 12) (local.get $cursor)))


;; A bounded cache hit needs no suspended frame. A miss still enters the
;; scheduled scanner; membership never replaces this call's extent checks.
(func $proof_boundary_cached
  (param $base i32) (param $length i32) (param $reference i32)
  (param $work i32) (result i32)
  (local $table i32) (local $slot i32) (local $words i32)
  (if (i32.or (i32.eqz (local.get $work))
        (i32.or (i32.ne (local.get $base) (global.get $proof_boundary_active_base))
          (i32.ne (local.get $work) (global.get $proof_boundary_active_work))))
    (then (return (i32.const -1))))
  (if (i32.or (i32.lt_u (local.get $reference) (i32.const 16))
        (i32.and (local.get $reference) (i32.const 3)))
    (then (return (i32.const 0))))
  (if (i32.or (i32.ge_u (local.get $reference) (local.get $length))
        (i32.gt_u (local.get $length) (global.get $proof_scratch_limit)))
    (then (return (i32.const 0))))
  (if (i32.lt_u (i32.sub (local.get $length) (local.get $reference)) (i32.const 8))
    (then (return (i32.const 0))))
  (if (i32.ge_u (local.get $reference)
        (call $proof_boundary_get (local.get $base) (local.get $work) (i32.const 12)))
    (then (return (i32.const -1))))
  (local.set $table (call $proof_boundary_get (local.get $base) (local.get $work) (i32.const 0)))
  (local.set $slot (i32.shr_u (local.get $reference) (i32.const 7)))
  (if (i32.or (i32.eqz (local.get $table))
        (i32.ge_u (local.get $slot)
          (call $proof_boundary_get (local.get $base) (local.get $work) (i32.const 8))))
    (then (return (i32.const -1))))
  (if (i32.eqz (call $proof_boundary_marked
        (local.get $base) (local.get $table) (local.get $reference)))
    (then (return (i32.const 0))))
  (local.set $words (call $proof_load (local.get $base) (local.get $reference)))
  (i32.and (i32.ge_u (local.get $words) (i32.const 2))
    (i32.le_u (local.get $words)
      (i32.shr_u (i32.sub (local.get $length) (local.get $reference)) (i32.const 2)))))

  ;; Expose exactly one checked constructor layer for constructor-based tactics.
  ;; Nat constructor views must not be normalized again: that would fold them
  ;; back into literals. Strings alone need WHNF of their checked expansion.
  (func $proof_state_equality_constructor_view
    (param $b i32) (param $term i32) (param $context i32) (param $work i32) (result i32)
    (local $tag i32)
    (if (global.get $proof_last_error_code) (then (return (i32.const 0))))
    (local.set $term (call $proof_weak_head_normalize (local.get $b) (local.get $term)
      (local.get $context) (i32.const 0) (i32.const 0) (local.get $work)))
    (if (i32.eqz (local.get $term)) (then (return (i32.const 0))))
    (local.set $tag (call $proof_load (local.get $b) (i32.add (local.get $term) (i32.const 4))))
    (local.set $term (call $proof_expand_literal (local.get $b) (local.get $term)
      (local.get $context) (i32.const 0) (i32.const 0) (local.get $work)))
    (if (i32.eqz (local.get $term)) (then (return (i32.const 0))))
    (if (i32.eq (local.get $tag) (global.get $PROOF_TERM_STRING_LITERAL)) (then
      (local.set $term (call $proof_weak_head_normalize (local.get $b) (local.get $term)
        (local.get $context) (i32.const 0) (i32.const 0) (local.get $work)))))
    (local.get $term))

;; Resumable unsigned natural arithmetic. All limb pointers below are ARENA
;; RELATIVE offsets. Only $base is a relocatable segment address. Array records
;; own mutable scratch, literal inputs are never mutated, and every loop/call
;; outside the four audited loop-free leaves is compiled into persisted frames.
;; No memory.copy/fill, native bigint allocation, heap bump, or rewind is used.

(func $proof_nat_limb_load (param $base i32) (param $data i32) (param $index i32) (result i32)
  (call $proof_load (local.get $base) (i32.add (local.get $data) (i32.shl (local.get $index) (i32.const 2)))))
(func $proof_nat_limb_store (param $base i32) (param $data i32) (param $index i32) (param $value i32)
  (call $proof_store (local.get $base) (i32.add (local.get $data) (i32.shl (local.get $index) (i32.const 2))) (local.get $value)))
(func $proof_nat_limb_or_zero (param $base i32) (param $data i32) (param $count i32) (param $index i32) (result i32)
  (if (result i32) (i32.lt_u (local.get $index) (local.get $count))
    (then (call $proof_nat_limb_load (local.get $base) (local.get $data) (local.get $index)))
    (else (i32.const 0))))
(func $proof_nat_buffer (param $base i32) (param $capacity i32) (result i32)
  (local $record i32)
  ;; One extra limb is permitted privately for division carry.
  (if (i32.gt_u (local.get $capacity) (i32.const 33554433))
    (then (global.set $proof_last_error_code (i32.const 29)) (return (i32.const 0))))
  (local.set $record (call $proof_make_array (local.get $base) (local.get $capacity)))
  (if (i32.eqz (local.get $record)) (then (return (i32.const 0))))
  (i32.add (local.get $record) (i32.const 12)))

(func $proof_nat_zero_buffer (param $base i32) (param $data i32) (param $count i32)
  (local $index i32)
  (block $done (loop $next
    (br_if $done (i32.ge_u (local.get $index) (local.get $count)))
    (call $proof_nat_limb_store (local.get $base) (local.get $data) (local.get $index) (i32.const 0))
    (local.set $index (i32.add (local.get $index) (i32.const 1))) (br $next))))
(func $proof_nat_copy_limbs (param $base i32) (param $target i32) (param $source i32) (param $count i32)
  (local $index i32)
  (block $done (loop $next
    (br_if $done (i32.ge_u (local.get $index) (local.get $count)))
    (call $proof_nat_limb_store (local.get $base) (local.get $target) (local.get $index)
      (call $proof_nat_limb_load (local.get $base) (local.get $source) (local.get $index)))
    (local.set $index (i32.add (local.get $index) (i32.const 1))) (br $next))))
(func $proof_nat_trim (param $base i32) (param $data i32) (param $count i32) (result i32)
  (block $done (loop $next
    (br_if $done (i32.eqz (local.get $count)))
    (br_if $done (call $proof_nat_limb_load (local.get $base) (local.get $data) (i32.sub (local.get $count) (i32.const 1))))
    (local.set $count (i32.sub (local.get $count) (i32.const 1))) (br $next)))
  (local.get $count))
(func $proof_nat_compare_limbs (param $base i32) (param $left_data i32) (param $left_count i32)
  (param $right_data i32) (param $right_count i32) (result i32)
  (local $a i32) (local $b i32)
  (if (i32.lt_u (local.get $left_count) (local.get $right_count)) (then (return (i32.const -1))))
  (if (i32.gt_u (local.get $left_count) (local.get $right_count)) (then (return (i32.const 1))))
  (block $done (loop $next
    (br_if $done (i32.eqz (local.get $left_count)))
    (local.set $left_count (i32.sub (local.get $left_count) (i32.const 1)))
    (local.set $a (call $proof_nat_limb_load (local.get $base) (local.get $left_data) (local.get $left_count)))
    (local.set $b (call $proof_nat_limb_load (local.get $base) (local.get $right_data) (local.get $left_count)))
    (if (i32.lt_u (local.get $a) (local.get $b)) (then (return (i32.const -1))))
    (if (i32.gt_u (local.get $a) (local.get $b)) (then (return (i32.const 1))))
    (br $next)))
  (i32.const 0))
(func $proof_nat_finish (param $base i32) (param $data i32) (param $capacity i32) (param $count i32) (result i32)
  (local $result i32)
  (local.set $count (call $proof_nat_trim (local.get $base) (local.get $data) (local.get $count)))
  (if (i32.gt_u (local.get $count) (i32.const 33554432))
    (then (global.set $proof_last_error_code (i32.const 29)) (return (i32.const 0))))
  ;; Exact-size private buffers can become literals without copying. Never shrink
  ;; a record in place: intervening continuation frames make tail rewind unsafe.
  (if (i32.eq (local.get $capacity) (local.get $count))
    (then
      (call $proof_store (local.get $base) (i32.sub (local.get $data) (i32.const 8)) (global.get $PROOF_TERM_NAT_LITERAL))
      (return (i32.sub (local.get $data) (i32.const 12)))))
  (local.set $result (call $proof_allocate_record (local.get $base)
    (i32.add (local.get $count) (i32.const 3)) (global.get $PROOF_TERM_NAT_LITERAL)))
  (if (i32.eqz (local.get $result)) (then (return (i32.const 0))))
  (call $proof_store (local.get $base) (i32.add (local.get $result) (i32.const 8)) (local.get $count))
  (call $proof_nat_copy_limbs (local.get $base) (i32.add (local.get $result) (i32.const 12)) (local.get $data) (local.get $count))
  (local.get $result))

;; Subtraction requires left >= right. Target may alias left, never right.
(func $proof_nat_subtract_limbs (param $base i32) (param $target i32)
  (param $left_data i32) (param $left_count i32) (param $right_data i32) (param $right_count i32) (result i32)
  (local $index i32) (local $borrow i64) (local $difference i64)
  (block $done (loop $next
    (br_if $done (i32.ge_u (local.get $index) (local.get $left_count)))
    (local.set $difference (i64.sub
      (i64.extend_i32_u (call $proof_nat_limb_load (local.get $base) (local.get $left_data) (local.get $index)))
      (i64.add (local.get $borrow) (i64.extend_i32_u
        (call $proof_nat_limb_or_zero (local.get $base) (local.get $right_data) (local.get $right_count) (local.get $index))))))
    (call $proof_nat_limb_store (local.get $base) (local.get $target) (local.get $index) (i32.wrap_i64 (local.get $difference)))
    (local.set $borrow (i64.shr_u (local.get $difference) (i64.const 63)))
    (local.set $index (i32.add (local.get $index) (i32.const 1))) (br $next)))
  (call $proof_nat_trim (local.get $base) (local.get $target) (local.get $left_count)))

;; Schoolbook multiply: target must be disjoint from both inputs and have
;; left_count + right_count limbs. A column accumulator is at most 2^64 - 1.
(func $proof_nat_multiply_limbs (param $base i32) (param $target i32)
  (param $left_data i32) (param $left_count i32) (param $right_data i32) (param $right_count i32) (result i32)
  (local $i i32) (local $j i32) (local $a i64) (local $carry i64) (local $value i64) (local $length i32)
  (if (i32.or (i32.eqz (local.get $left_count)) (i32.eqz (local.get $right_count))) (then (return (i32.const 0))))
  (local.set $length (i32.add (local.get $left_count) (local.get $right_count)))
  (call $proof_nat_zero_buffer (local.get $base) (local.get $target) (local.get $length))
  (block $done (loop $row
    (br_if $done (i32.ge_u (local.get $i) (local.get $left_count)))
    (local.set $a (i64.extend_i32_u (call $proof_nat_limb_load (local.get $base) (local.get $left_data) (local.get $i))))
    (local.set $j (i32.const 0)) (local.set $carry (i64.const 0))
    (block $row_done (loop $column
      (br_if $row_done (i32.ge_u (local.get $j) (local.get $right_count)))
      (local.set $value (i64.add (i64.mul (local.get $a)
        (i64.extend_i32_u (call $proof_nat_limb_load (local.get $base) (local.get $right_data) (local.get $j))))
        (i64.add (local.get $carry) (i64.extend_i32_u (call $proof_nat_limb_load (local.get $base) (local.get $target) (i32.add (local.get $i) (local.get $j)))))))
      (call $proof_nat_limb_store (local.get $base) (local.get $target) (i32.add (local.get $i) (local.get $j)) (i32.wrap_i64 (local.get $value)))
      (local.set $carry (i64.shr_u (local.get $value) (i64.const 32)))
      (local.set $j (i32.add (local.get $j) (i32.const 1))) (br $column)))
    (call $proof_nat_limb_store (local.get $base) (local.get $target) (i32.add (local.get $i) (local.get $right_count)) (i32.wrap_i64 (local.get $carry)))
    (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $row)))
  (call $proof_nat_trim (local.get $base) (local.get $target) (local.get $length)))

;; Binary long division. Remainder is disjoint from inputs, capacity >= divisor
;; count + 1. Quotient may be zero (mod/gcd); otherwise its capacity is dividend
;; count. Before each bit 0 <= remainder < divisor, so one subtraction suffices.
(func $proof_nat_divide_limbs (param $base i32) (param $dividend i32) (param $dividend_count i32)
  (param $divisor i32) (param $divisor_count i32) (param $quotient i32) (param $remainder i32) (result i32)
  (local $bits i32) (local $count i32) (local $index i32) (local $carry i64) (local $value i64) (local $word i32)
  (if (i32.eqz (local.get $divisor_count))
    (then (global.set $proof_last_error_code (i32.const 29)) (return (i32.const 0))))
  (if (local.get $quotient) (then (call $proof_nat_zero_buffer (local.get $base) (local.get $quotient) (local.get $dividend_count))))
  (local.set $bits (i32.shl (local.get $dividend_count) (i32.const 5)))
  (if (local.get $dividend_count) (then (local.set $bits (i32.sub (local.get $bits)
    (i32.clz (call $proof_nat_limb_load (local.get $base) (local.get $dividend) (i32.sub (local.get $dividend_count) (i32.const 1))))))))
  (block $done (loop $bit
    (br_if $done (i32.eqz (local.get $bits)))
    (local.set $bits (i32.sub (local.get $bits) (i32.const 1)))
    (local.set $carry (i64.extend_i32_u (i32.and (i32.shr_u
      (call $proof_nat_limb_load (local.get $base) (local.get $dividend) (i32.shr_u (local.get $bits) (i32.const 5)))
      (i32.and (local.get $bits) (i32.const 31))) (i32.const 1))))
    (local.set $index (i32.const 0))
    (block $shift_done (loop $shift
      (br_if $shift_done (i32.ge_u (local.get $index) (local.get $count)))
      (local.set $value (i64.or (i64.shl (i64.extend_i32_u
        (call $proof_nat_limb_load (local.get $base) (local.get $remainder) (local.get $index))) (i64.const 1)) (local.get $carry)))
      (call $proof_nat_limb_store (local.get $base) (local.get $remainder) (local.get $index) (i32.wrap_i64 (local.get $value)))
      (local.set $carry (i64.shr_u (local.get $value) (i64.const 32)))
      (local.set $index (i32.add (local.get $index) (i32.const 1))) (br $shift)))
    (if (i64.ne (local.get $carry) (i64.const 0)) (then
      (call $proof_nat_limb_store (local.get $base) (local.get $remainder) (local.get $count) (i32.wrap_i64 (local.get $carry)))
      (local.set $count (i32.add (local.get $count) (i32.const 1)))))
    (if (i32.ge_s (call $proof_nat_compare_limbs (local.get $base) (local.get $remainder) (local.get $count)
          (local.get $divisor) (local.get $divisor_count)) (i32.const 0))
      (then
        (local.set $count (call $proof_nat_subtract_limbs (local.get $base) (local.get $remainder)
          (local.get $remainder) (local.get $count) (local.get $divisor) (local.get $divisor_count)))
        (if (local.get $quotient) (then
          (local.set $word (i32.shr_u (local.get $bits) (i32.const 5)))
          (call $proof_nat_limb_store (local.get $base) (local.get $quotient) (local.get $word)
            (i32.or (call $proof_nat_limb_load (local.get $base) (local.get $quotient) (local.get $word))
              (i32.shl (i32.const 1) (i32.and (local.get $bits) (i32.const 31)))))))))
    (br $bit)))
  (local.get $count))

(func $proof_nat_arithmetic (param $base i32) (param $role i32) (param $left i32) (param $right i32) (result i32)
  (local $left_data i32) (local $right_data i32) (local $left_count i32) (local $right_count i32)
  (local $capacity i32) (local $count i32) (local $target i32) (local $scratch i32) (local $third i32)
  (local $index i32) (local $a i32) (local $b i32) (local $comparison i32)
  (local $carry i64) (local $value i64) (local $amount i32) (local $words i32) (local $bits i32)
  (local $temporary i32) (local $exponent_bit i32)
  (local.set $left_count (call $proof_load (local.get $base) (i32.add (local.get $left) (i32.const 8))))
  (local.set $right_count (call $proof_load (local.get $base) (i32.add (local.get $right) (i32.const 8))))
  (local.set $left_data (i32.add (local.get $left) (i32.const 12)))
  (local.set $right_data (i32.add (local.get $right) (i32.const 12)))
  (if (i32.or (i32.eq (local.get $role) (i32.const 14)) (i32.eq (local.get $role) (i32.const 15)))
    (then
      (local.set $comparison (call $proof_nat_compare_limbs (local.get $base) (local.get $left_data) (local.get $left_count)
        (local.get $right_data) (local.get $right_count)))
      (return (if (result i32) (i32.eq (local.get $role) (i32.const 14))
        (then (i32.eqz (local.get $comparison))) (else (i32.le_s (local.get $comparison) (i32.const 0)))))))
  (if (i32.or (i32.eq (local.get $role) (i32.const 7)) (i32.eq (local.get $role) (i32.const 8)))
    (then
      (if (i32.eqz (local.get $left_count)) (then (return (local.get $right))))
      (if (i32.eqz (local.get $right_count)) (then (return (local.get $left))))
      (local.set $count (select (local.get $left_count) (local.get $right_count) (i32.gt_u (local.get $left_count) (local.get $right_count))))
      (local.set $capacity (i32.add (local.get $count) (i32.const 1)))
      (local.set $target (call $proof_nat_buffer (local.get $base) (local.get $capacity)))
      (if (i32.eqz (local.get $target)) (then (return (i32.const 0))))
      (block $add_done (loop $add
        (br_if $add_done (i32.ge_u (local.get $index) (local.get $count)))
        (local.set $value (i64.add (local.get $carry) (i64.add
          (i64.extend_i32_u (call $proof_nat_limb_or_zero (local.get $base) (local.get $left_data) (local.get $left_count) (local.get $index)))
          (i64.extend_i32_u (call $proof_nat_limb_or_zero (local.get $base) (local.get $right_data) (local.get $right_count) (local.get $index))))))
        (call $proof_nat_limb_store (local.get $base) (local.get $target) (local.get $index) (i32.wrap_i64 (local.get $value)))
        (local.set $carry (i64.shr_u (local.get $value) (i64.const 32)))
        (local.set $index (i32.add (local.get $index) (i32.const 1))) (br $add)))
      (call $proof_nat_limb_store (local.get $base) (local.get $target) (local.get $count) (i32.wrap_i64 (local.get $carry)))
      (return (call $proof_nat_finish (local.get $base) (local.get $target) (local.get $capacity) (local.get $capacity)))))
  (if (i32.eq (local.get $role) (i32.const 9))
    (then
      (if (i32.eqz (local.get $right_count)) (then (return (local.get $left))))
      (if (i32.le_s (call $proof_nat_compare_limbs (local.get $base) (local.get $left_data) (local.get $left_count)
          (local.get $right_data) (local.get $right_count)) (i32.const 0))
        (then (return (call $proof_nat_small (local.get $base) (i32.const 0)))))
      (local.set $target (call $proof_nat_buffer (local.get $base) (local.get $left_count)))
      (if (i32.eqz (local.get $target)) (then (return (i32.const 0))))
      (local.set $count (call $proof_nat_subtract_limbs (local.get $base) (local.get $target)
        (local.get $left_data) (local.get $left_count) (local.get $right_data) (local.get $right_count)))
      (return (call $proof_nat_finish (local.get $base) (local.get $target) (local.get $left_count) (local.get $count)))))
  (if (i32.eq (local.get $role) (i32.const 10))
    (then
      (if (i32.eqz (local.get $left_count)) (then (return (local.get $left))))
      (if (i32.eqz (local.get $right_count)) (then (return (local.get $right))))
      (local.set $capacity (i32.add (local.get $left_count) (local.get $right_count)))
      (local.set $target (call $proof_nat_buffer (local.get $base) (local.get $capacity)))
      (if (i32.eqz (local.get $target)) (then (return (i32.const 0))))
      (local.set $count (call $proof_nat_multiply_limbs (local.get $base) (local.get $target)
        (local.get $left_data) (local.get $left_count) (local.get $right_data) (local.get $right_count)))
      (return (call $proof_nat_finish (local.get $base) (local.get $target) (local.get $capacity) (local.get $count)))))
  (if (i32.or (i32.eq (local.get $role) (i32.const 11)) (i32.eq (local.get $role) (i32.const 12)))
    (then
      (if (i32.eqz (local.get $right_count)) (then
        (if (i32.eq (local.get $role) (i32.const 12)) (then (return (local.get $left))))
        (return (call $proof_nat_small (local.get $base) (i32.const 0)))))
      (if (i32.lt_s (call $proof_nat_compare_limbs (local.get $base) (local.get $left_data) (local.get $left_count)
          (local.get $right_data) (local.get $right_count)) (i32.const 0)) (then
        (if (i32.eq (local.get $role) (i32.const 12)) (then (return (local.get $left))))
        (return (call $proof_nat_small (local.get $base) (i32.const 0)))))
