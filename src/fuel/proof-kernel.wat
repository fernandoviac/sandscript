  (func $proof_declaration_visible
    (param $artifact_base i32)
    (param $declaration_index i32)
    (result i32)
    (local $current_index i32)
    (local $current_declaration i32)
    (local $target_declaration i32)
    (local $current_tag i32)
    (local $target_tag i32)
    (local $current_mutual i32)
    (local $target_mutual i32)
    (local $count i32)
    (local $index i32)
    (local.set $current_index (global.get $proof_current_declaration_index))
    (if (i32.eq (local.get $current_index) (i32.const -1))
      (then (return (i32.const 1))))
    (if (i32.lt_u (local.get $declaration_index) (local.get $current_index))
      (then (return (i32.const 1))))
    (local.set $current_declaration
      (call $proof_declaration_reference
        (local.get $artifact_base) (local.get $current_index)))
    (local.set $current_tag
      (call $proof_load (local.get $artifact_base)
        (i32.add (local.get $current_declaration) (i32.const 4))))
    (if (i32.and
          (i32.eq (local.get $declaration_index) (local.get $current_index))
          (i32.or
            (i32.eq (local.get $current_tag) (global.get $PROOF_RECORD_INDUCTIVE_DECLARATION))
            (i32.eq (local.get $current_tag) (global.get $PROOF_RECORD_COINDUCTIVE_DECLARATION))))
      (then (return (i32.const 1))))
    (local.set $target_declaration
      (call $proof_declaration_reference
        (local.get $artifact_base) (local.get $declaration_index)))
    (local.set $target_tag
      (call $proof_load (local.get $artifact_base)
        (i32.add (local.get $target_declaration) (i32.const 4))))
    (if (i32.ne (local.get $target_tag) (local.get $current_tag))
      (then (return (i32.const 0))))
    (if (i32.eq (local.get $current_tag) (global.get $PROOF_RECORD_RECURSOR_DECLARATION))
      (then
        ;; The checker authenticates every signature in this group before any
        ;; RHS is checked. Recursive RHSs may use only those same-group entries.
        (local.set $current_mutual (call $proof_load (local.get $artifact_base)
