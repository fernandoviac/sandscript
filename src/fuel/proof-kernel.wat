      (local.get $artifact_base)
      (local.get $declarations_reference)
      (i32.add (local.get $declaration_count) (i32.const 3)))
    (call $proof_store
      (local.get $artifact_base)
      (i32.add (local.get $declarations_reference) (i32.const 4))
      (global.get $PROOF_RECORD_ARRAY))
    (call $proof_store
      (local.get $artifact_base)
      (i32.add (local.get $declarations_reference) (i32.const 8))
      (local.get $declaration_count))
    (local.set $index (i32.const 0))
    (block $declarations_done
      (loop $declarations_next
        (br_if $declarations_done
          (i32.ge_u (local.get $index) (local.get $declaration_count)))
        (call $proof_store
          (local.get $artifact_base)
          (i32.add
            (i32.add
              (local.get $declarations_reference)
              (i32.const 12))
            (i32.mul (local.get $index) (i32.const 4)))
          (i32.add
            (call $proof_array_get
              (local.get $body_base)
              (local.get $source_declarations)
              (local.get $index))
            (local.get $declaration_delta)))
        (local.set $index
          (i32.add (local.get $index) (i32.const 1)))
        (br $declarations_next)))
    (call $proof_native_initialize_artifact_header
      (local.get $artifact_base)
      (local.get $artifact_length)
      (local.get $declarations_reference))
    (call $write_ctx
      (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (call $proof_native_push_term (local.get $handle))
    (i32.const 0)
  )

  ;; Build the canonical record arrays consumed by matches and recursive
  ;; definition blocks. Every element remains a kernel-owned term handle.
  (func $proof_native_term_sequence
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_identifier i32) (param $argument_count i32)
    (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument i32)
    (local $array_pointer i32)
    (local $array_data i32)
    (local $count i32)
    (local $index i32)
    (local $slot i32)
    (local $source_handle i32)
    (local $source_base i32)
    (local $source_root i32)
    (local $source_length i32)
    (local $source_declarations i32)
    (local $source_declaration_count i32)
    (local $records_length i32)
    (local $declaration_count i32)
    (local $declaration_source_base i32)
    (local $declaration_source_reference i32)
    (local $declaration_source_delta i32)
    (local $artifact_length i32)
    (local $workspace_length i32)
    (local $handle i32)
    (local $artifact_base i32)
    (local $cursor i32)
    (local $root_reference i32)
    (local $declarations_reference i32)
    (local $relocated_root i32)
    (local $relocation_delta i32)
    (local.set $pending_pointer
      (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.lt_u (local.get $argument_count) (i32.const 1))
      (then
        (call $write_ctx
          (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
        (return
          (i32.add
            (i32.const 1)
            (call $throw_type_error_with_message
              (global.get $BUILTIN_MSG_MISSING_ARGUMENT))))))
    (local.set $argument
      (i32.sub
        (local.get $pending_pointer)
        (i32.mul
          (local.get $argument_count)
          (global.get $VALUE_SIZE))))
    (if (i32.ne
          (call $value_type (local.get $argument))
          (global.get $TYPE_ARRAY))
      (then
        (call $write_ctx
          (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
        (return
          (i32.add
            (i32.const 1)
            (call $throw_type_error_with_message
              (global.get $BUILTIN_MSG_NOT_AN_OBJECT))))))
    (local.set $array_pointer
      (call $value_data_lo (local.get $argument)))
    (local.set $count
      (i32.load
        (call $abs
          (i32.add (local.get $array_pointer) (i32.const 8)))))
    (if (i32.gt_u (local.get $count) (i32.const 100000))
      (then
        (call $write_ctx
          (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
        (return
          (i32.add
            (i32.const 1)
            (call $throw_range_error_with_message
              (global.get $BUILTIN_MSG_INVALID_INDEX))))))
    (local.set $array_data
      (i32.load
        (call $abs
          (i32.add (local.get $array_pointer) (i32.const 16)))))
    (local.set $index (i32.const 0))
    (block $validation_done
      (loop $validation_next
        (br_if $validation_done
          (i32.ge_u (local.get $index) (local.get $count)))
        (local.set $slot
          (i32.add
            (i32.add
              (local.get $array_data)
              (global.get $GC_HEADER_SIZE))
            (i32.mul
              (local.get $index)
              (global.get $VALUE_SIZE))))
        (if (i32.ne
              (call $value_type (local.get $slot))
              (global.get $TYPE_THEOREM))
          (then
            (call $write_ctx
              (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
            (return
              (i32.add
                (i32.const 1)
                (call $throw_type_error_with_message
                  (global.get $BUILTIN_MSG_NOT_AN_OBJECT))))))
        (local.set $source_handle
          (call $value_data_lo (local.get $slot)))
        (if (i32.eqz
              (call $proof_native_term_handle_valid
                (local.get $source_handle)))
          (then
            (call $write_ctx
              (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
            (return
              (i32.add
                (i32.const 1)
                (call $throw_type_error_with_message
                  (global.get $BUILTIN_MSG_NOT_AN_OBJECT))))))
        (local.set $source_length
          (call $proof_native_term_records_length
            (local.get $source_handle)))
        (if (i32.gt_u
              (local.get $records_length)
              (i32.sub (i32.const 0x0FFFF000) (local.get $source_length)))
          (then
            (call $write_ctx
              (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
            (return
              (i32.add
                (i32.const 1)
                (call $throw_range_error_with_message
                  (global.get $BUILTIN_MSG_INVALID_INDEX))))))
        (local.set $records_length
          (i32.add
            (local.get $records_length)
            (local.get $source_length)))
        (local.set $source_base
          (call $proof_native_handle_artifact_base
            (local.get $source_handle)))
        (local.set $source_declarations
          (call $proof_load (local.get $source_base) (i32.const 12)))
        (local.set $source_declaration_count
          (call $proof_array_count
            (local.get $source_base)
            (local.get $source_declarations)))
        (if (i32.gt_u (local.get $source_declaration_count) (local.get $declaration_count))
          (then
            (local.set $declaration_count
              (local.get $source_declaration_count))))
        (local.set $index
          (i32.add (local.get $index) (i32.const 1)))
        (br $validation_next)))
    (local.set $artifact_length
      (i32.add
        (i32.const 40)
        (i32.add
          (local.get $records_length)
          (i32.add
            (i32.mul (local.get $count) (i32.const 4))
            (i32.mul
              (local.get $declaration_count)
              (i32.const 4))))))
    (local.set $workspace_length
      (global.get $PROOF_WORK_RECORD_SIZE))
    (if (call $check_heap_overflow
          (i32.add
            (call $estimate_arraybuffer_size
              (i32.add
                (local.get $artifact_length)
                (local.get $workspace_length)))
            (i32.const 24)))
      (then (return (i32.const 0))))
    (local.set $pending_pointer
      (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (local.set $argument
      (i32.sub
        (local.get $pending_pointer)
        (i32.mul
          (local.get $argument_count)
          (global.get $VALUE_SIZE))))
    (local.set $array_pointer
      (call $value_data_lo (local.get $argument)))
    (local.set $array_data
      (i32.load
        (call $abs
          (i32.add (local.get $array_pointer) (i32.const 16)))))
    (local.set $root_reference
      (i32.add (i32.const 16) (local.get $records_length)))
    (local.set $handle
      (call $proof_native_allocate_term_handle
        (local.get $artifact_length)
        (local.get $root_reference)
        (local.get $workspace_length)))
    (i32.store
      (call $abs (i32.add (local.get $handle) (i32.const 16)))
      (global.get $PROOF_HANDLE_SEQUENCE))
    (local.set $artifact_base
      (call $proof_native_handle_artifact_base (local.get $handle)))
    (global.set $proof_current_artifact_length
      (local.get $artifact_length))
    (global.set $proof_current_declaration_index (i32.const -1))
    (global.set $proof_current_universe_context (i32.const 0))
    (global.set $proof_scratch_cursor (local.get $artifact_length))
    (global.set $proof_scratch_limit
      (i32.add
        (local.get $artifact_length)
        (local.get $workspace_length)))
    (call $proof_store
      (local.get $artifact_base)
      (local.get $root_reference)
      (i32.add (local.get $count) (i32.const 3)))
    (call $proof_store
      (local.get $artifact_base)
      (i32.add (local.get $root_reference) (i32.const 4))
      (global.get $PROOF_RECORD_ARRAY))
    (call $proof_store
      (local.get $artifact_base)
      (i32.add (local.get $root_reference) (i32.const 8))
      (local.get $count))
    (local.set $cursor
      (i32.add (local.get $artifact_base) (i32.const 16)))
    (local.set $index (i32.const 0))
    (block $copy_done
      (loop $copy_next
        (br_if $copy_done
          (i32.ge_u (local.get $index) (local.get $count)))
        (local.set $slot
          (i32.add
            (i32.add
              (local.get $array_data)
              (global.get $GC_HEADER_SIZE))
            (i32.mul
              (local.get $index)
              (global.get $VALUE_SIZE))))
        (local.set $source_handle
          (call $value_data_lo (local.get $slot)))
        (local.set $source_base
          (call $proof_native_handle_artifact_base
            (local.get $source_handle)))
        (local.set $source_root
          (call $proof_native_handle_root (local.get $source_handle)))
        (local.set $source_length
          (call $proof_native_term_records_length
            (local.get $source_handle)))
        (local.set $source_declarations
          (call $proof_load (local.get $source_base) (i32.const 12)))
        (local.set $source_declaration_count
          (call $proof_array_count
            (local.get $source_base)
            (local.get $source_declarations)))
        (local.set $relocated_root
          (call $proof_native_copy_term_records
            (local.get $source_handle)
            (local.get $artifact_base)
            (local.get $cursor)))
        (local.set $relocation_delta
          (i32.sub
            (local.get $relocated_root)
            (local.get $source_root)))
        (call $proof_store
          (local.get $artifact_base)
          (i32.add
            (i32.add
              (local.get $root_reference)
              (i32.const 12))
            (i32.mul (local.get $index) (i32.const 4)))
          (local.get $relocated_root))
        (if (local.get $source_declaration_count)
          (then
            (if (i32.eqz (local.get $declaration_source_reference))
              (then
                (local.set $declaration_source_base
                  (local.get $source_base))
                (local.set $declaration_source_reference
                  (local.get $source_declarations))
                (local.set $declaration_source_delta
                  (local.get $relocation_delta)))
              (else
                (if (i32.eqz
                      (call $proof_native_declarations_compatible
                        (local.get $artifact_base)
                        (local.get $declaration_source_base)
                        (local.get $declaration_source_reference)
                        (local.get $declaration_source_delta)
                        (local.get $source_base)
                        (local.get $source_declarations)
                        (local.get $relocation_delta) (call $proof_native_operation_work (local.get $artifact_base))))
                  (then
                    (call $write_ctx
                      (global.get $CTX_PENDING_POINTER)
                      (local.get $stack_base))
                    (return
                      (i32.add
                        (i32.const 1)
                        (call $throw_type_error_with_message
                          (global.get $BUILTIN_MSG_NOT_AN_OBJECT))))))))))
        (if (i32.and (i32.ne (local.get $source_declaration_count) (i32.const 0))
              (i32.eq (local.get $source_declaration_count) (local.get $declaration_count)))
          (then
            (local.set $declaration_source_base (local.get $source_base))
            (local.set $declaration_source_reference (local.get $source_declarations))
            (local.set $declaration_source_delta (local.get $relocation_delta))))
        (local.set $cursor
          (i32.add (local.get $cursor) (local.get $source_length)))
        (local.set $index
          (i32.add (local.get $index) (i32.const 1)))
        (br $copy_next)))
    (local.set $declarations_reference
      (i32.add
        (local.get $root_reference)
        (i32.add
          (i32.const 12)
          (i32.mul (local.get $count) (i32.const 4)))))
    (call $proof_store
      (local.get $artifact_base)
      (local.get $declarations_reference)
      (i32.add (local.get $declaration_count) (i32.const 3)))
    (call $proof_store
      (local.get $artifact_base)
      (i32.add (local.get $declarations_reference) (i32.const 4))
      (global.get $PROOF_RECORD_ARRAY))
    (call $proof_store
      (local.get $artifact_base)
      (i32.add (local.get $declarations_reference) (i32.const 8))
      (local.get $declaration_count))
    (local.set $index (i32.const 0))
    (block $declarations_done
      (loop $declarations_next
        (br_if $declarations_done
          (i32.ge_u (local.get $index) (local.get $declaration_count)))
        (call $proof_store
          (local.get $artifact_base)
          (i32.add
            (i32.add
              (local.get $declarations_reference)
              (i32.const 12))
            (i32.mul (local.get $index) (i32.const 4)))
          (i32.add
            (call $proof_array_get
              (local.get $declaration_source_base)
              (local.get $declaration_source_reference)
              (local.get $index))
            (local.get $declaration_source_delta)))
        (local.set $index
          (i32.add (local.get $index) (i32.const 1)))
        (br $declarations_next)))
    (call $proof_native_initialize_artifact_header
      (local.get $artifact_base)
      (local.get $artifact_length)
      (local.get $declarations_reference))
    (call $write_ctx
      (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (call $proof_native_push_term (local.get $handle))
    (i32.const 0)
  )

  (func $proof_native_indexed_sequence_term_method
    (param $tag i32)
    (param $argument_count i32)
    (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $sequence_argument i32)
    (local $index_argument i32)
    (local $sequence_handle i32)
    (local $selected_definition i32)
    (local $source_base i32)
    (local $source_root i32)
    (local $source_length i32)
    (local $source_declarations i32)
    (local $declaration_count i32)
    (local $definition_count i32)
    (local $artifact_length i32)
    (local $workspace_length i32)
    (local $handle i32)
    (local $artifact_base i32)
    (local $relocated_root i32)
    (local $relocation_delta i32)
    (local $node_reference i32)
    (local $declarations_reference i32)
    (local $index i32)
    (local.set $pending_pointer
      (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.lt_u (local.get $argument_count) (i32.const 2))
      (then
        (call $write_ctx
          (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
        (return
          (i32.add
            (i32.const 1)
            (call $throw_type_error_with_message
              (global.get $BUILTIN_MSG_MISSING_ARGUMENT))))))
    (local.set $sequence_argument
      (i32.sub
        (local.get $pending_pointer)
        (i32.mul
          (local.get $argument_count)
          (global.get $VALUE_SIZE))))
    (local.set $index_argument
      (i32.add
        (local.get $sequence_argument)
        (global.get $VALUE_SIZE)))
    (if (i32.ne
          (call $value_type (local.get $sequence_argument))
          (global.get $TYPE_THEOREM))
      (then
        (call $write_ctx
          (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
        (return
          (i32.add
            (i32.const 1)
            (call $throw_type_error_with_message
              (global.get $BUILTIN_MSG_NOT_AN_OBJECT))))))
    (local.set $sequence_handle
      (call $value_data_lo (local.get $sequence_argument)))
    (local.set $selected_definition
      (call $proof_native_nonnegative_integer_argument
        (local.get $index_argument)))
    (if (i32.or
          (i32.eqz
            (call $proof_native_sequence_handle_valid
              (local.get $sequence_handle)))
          (i32.lt_s (local.get $selected_definition) (i32.const 0)))
      (then
        (call $write_ctx
          (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
        (return
          (i32.add
            (i32.const 1)
            (call $throw_range_error_with_message
              (global.get $BUILTIN_MSG_INVALID_INDEX))))))
    (local.set $source_base
      (call $proof_native_handle_artifact_base
        (local.get $sequence_handle)))
    (local.set $source_root
      (call $proof_native_handle_root (local.get $sequence_handle)))
    (local.set $definition_count
      (call $proof_array_count
        (local.get $source_base)
        (local.get $source_root)))
    (if (i32.ge_u
          (local.get $selected_definition)
          (local.get $definition_count))
      (then
        (call $write_ctx
          (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
        (return
          (i32.add
            (i32.const 1)
            (call $throw_range_error_with_message
              (global.get $BUILTIN_MSG_INVALID_INDEX))))))
    (local.set $source_length
      (call $proof_native_term_records_length
        (local.get $sequence_handle)))
    (local.set $source_declarations
      (call $proof_load (local.get $source_base) (i32.const 12)))
    (local.set $declaration_count
      (call $proof_array_count
        (local.get $source_base)
        (local.get $source_declarations)))
    (local.set $artifact_length
      (i32.add
        (i32.const 44)
        (i32.add
          (local.get $source_length)
          (i32.mul (local.get $declaration_count) (i32.const 4)))))
    (local.set $workspace_length
      (i32.const 0))
    (if (call $check_heap_overflow
          (i32.add
            (call $estimate_arraybuffer_size
              (i32.add
                (local.get $artifact_length)
                (local.get $workspace_length)))
            (i32.const 24)))
      (then (return (i32.const 0))))
    (local.set $pending_pointer
      (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (local.set $sequence_argument
      (i32.sub
        (local.get $pending_pointer)
        (i32.mul
          (local.get $argument_count)
          (global.get $VALUE_SIZE))))
    (local.set $sequence_handle
      (call $value_data_lo (local.get $sequence_argument)))
    (local.set $source_base
      (call $proof_native_handle_artifact_base
        (local.get $sequence_handle)))
    (local.set $source_root
      (call $proof_native_handle_root (local.get $sequence_handle)))
    (local.set $source_declarations
      (call $proof_load (local.get $source_base) (i32.const 12)))
    (local.set $node_reference
      (i32.add (i32.const 16) (local.get $source_length)))
    (local.set $handle
      (call $proof_native_allocate_term_handle
        (local.get $artifact_length)
        (local.get $node_reference)
        (local.get $workspace_length)))
    (local.set $artifact_base
      (call $proof_native_handle_artifact_base (local.get $handle)))
    (local.set $relocated_root
      (call $proof_native_copy_term_records
        (local.get $sequence_handle)
        (local.get $artifact_base)
        (i32.add (local.get $artifact_base) (i32.const 16))))
    (local.set $relocation_delta
      (i32.sub
        (local.get $relocated_root)
        (local.get $source_root)))
    (call $proof_store
      (local.get $artifact_base) (local.get $node_reference) (i32.const 4))
    (call $proof_store
      (local.get $artifact_base)
      (i32.add (local.get $node_reference) (i32.const 4))
      (local.get $tag))
    (call $proof_store
      (local.get $artifact_base)
      (i32.add (local.get $node_reference) (i32.const 8))
      (local.get $relocated_root))
    (call $proof_store
      (local.get $artifact_base)
      (i32.add (local.get $node_reference) (i32.const 12))
      (local.get $selected_definition))
    (local.set $declarations_reference
      (i32.add (local.get $node_reference) (i32.const 16)))
    (call $proof_store
      (local.get $artifact_base)
      (local.get $declarations_reference)
      (i32.add (local.get $declaration_count) (i32.const 3)))
    (call $proof_store
      (local.get $artifact_base)
      (i32.add (local.get $declarations_reference) (i32.const 4))
      (global.get $PROOF_RECORD_ARRAY))
    (call $proof_store
      (local.get $artifact_base)
      (i32.add (local.get $declarations_reference) (i32.const 8))
      (local.get $declaration_count))
    (local.set $index (i32.const 0))
    (block $declarations_done
      (loop $declarations_next
        (br_if $declarations_done
          (i32.ge_u (local.get $index) (local.get $declaration_count)))
        (call $proof_store
          (local.get $artifact_base)
          (i32.add
            (i32.add
              (local.get $declarations_reference)
              (i32.const 12))
            (i32.mul (local.get $index) (i32.const 4)))
          (i32.add
            (call $proof_array_get
              (local.get $source_base)
              (local.get $source_declarations)
              (local.get $index))
            (local.get $relocation_delta)))
        (local.set $index
          (i32.add (local.get $index) (i32.const 1)))
        (br $declarations_next)))
    (call $proof_native_initialize_artifact_header
      (local.get $artifact_base)
      (local.get $artifact_length)
      (local.get $declarations_reference))
    (call $write_ctx
      (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (call $proof_native_push_term (local.get $handle))
    (i32.const 0)
  )

  (func $proof_native_term_fixed_point
    (param $receiver_type i32) (param $receiver_pointer i32)
