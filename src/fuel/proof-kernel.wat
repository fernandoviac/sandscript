  (func $proof_check_recursive_calls
    (param $artifact_base i32)
    (param $term_reference i32)
    (param $definitions i32)
    (param $decreasing_index i32)
    (param $smaller_indices i64)
    (result i32)
    (local $tag i32)
    (local $head i32)
    (local $head_tag i32)
    (local $target_index i32)
    (local $target_definition i32)
    (local $target_decreasing_argument i32)
    (local $argument_count i32)
    (local $argument_index i32)
    (local $argument i32)
    (local $bound_index i32)
    (local $branches i32)
    (local $branch_count i32)
