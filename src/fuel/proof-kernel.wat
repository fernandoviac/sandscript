  ;; Resolve one diagnostic local name to de Bruijn indices. This is the
  ;; elaborator's binder-aware traversal: entering a dependent body raises the
  ;; depth, while applications and declaration-free leaves preserve it.
  ;; Resolution mutates only a freshly composed result artifact; caller-owned
  ;; term handles remain immutable.
  (func $proof_native_resolve_named_local
    (param $artifact_base i32)
    (param $term_reference i32)
    (param $name_identifier i32)
    (param $depth i32)
    (result i32)
    (local $tag i32)
    (local $first_count i32)
    (local $second_count i32)
    (local $third_count i32)
    (local $array_reference i32)
    (local $record_reference i32)
    (local $count i32)
    (local $index i32)
    (local $resolved_count i32)
    (if (i32.eqz (local.get $term_reference)) (then (return (i32.const 0))))
    (local.set $tag
      (call $proof_load
        (local.get $artifact_base)
        (i32.add (local.get $term_reference) (i32.const 4))))
    (if (i32.eq (local.get $tag) (global.get $PROOF_TERM_NAMED_LOCAL))
      (then
        (if (i32.eq
              (call $proof_load
                (local.get $artifact_base)
                (i32.add (local.get $term_reference) (i32.const 8)))
              (local.get $name_identifier))
          (then
            (call $proof_store
              (local.get $artifact_base)
              (i32.add (local.get $term_reference) (i32.const 4))
              (global.get $PROOF_TERM_BOUND))
            (call $proof_store
              (local.get $artifact_base)
              (i32.add (local.get $term_reference) (i32.const 8))
              (local.get $depth))
            (return (i32.const 1))))
        (return (i32.const 0))))
    (if (i32.or (i32.eq (local.get $tag) (global.get $PROOF_TERM_NAT_LITERAL))
      (i32.eq (local.get $tag) (global.get $PROOF_TERM_STRING_LITERAL)))
      (then (return (i32.const 0))))
    (local.set $count (i32.mul (call $proof_load (local.get $artifact_base) (local.get $term_reference)) (i32.const 4)))
    (local.set $index (i32.const 8))
    (block $children_done (loop $child_next
      (br_if $children_done (i32.ge_u (local.get $index) (local.get $count)))
      (if (call $proof_term_child (local.get $tag) (local.get $index)) (then
        (local.set $record_reference (call $proof_load (local.get $artifact_base) (i32.add (local.get $term_reference) (local.get $index))))
        (if (local.get $record_reference) (then
          (local.set $resolved_count (i32.add (local.get $resolved_count)
            (call $proof_native_resolve_named_local (local.get $artifact_base) (local.get $record_reference)
              (local.get $name_identifier) (i32.add (local.get $depth)
                (call $proof_term_child_binders (local.get $tag) (local.get $index))))))))))
      (local.set $index (i32.add (local.get $index) (i32.const 4))) (br $child_next)))
    (local.get $resolved_count)
  )

  (func $proof_native_term_named_local
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_identifier i32) (param $argument_count i32)
    (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument i32)
    (local $name_identifier i32)
    (local $handle i32)
    (local $artifact_base i32)
    (local.set $pending_pointer
      (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.lt_u (local.get $argument_count) (i32.const 1))
      (then
        (call $write_ctx
          (global.get $CTX_PENDING_POINTER)
          (local.get $stack_base))
        (return
          (i32.add
            (i32.const 1)
            (call $throw_type_error_with_message
              (global.get $BUILTIN_MSG_MISSING_ARGUMENT))))))
    (local.set $argument
      (i32.sub
        (local.get $pending_pointer)
        (i32.mul
          (local.get $argument_count)
          (global.get $VALUE_SIZE))))
    (if (i32.ne
          (call $value_type (local.get $argument))
          (global.get $TYPE_STRING))
      (then
        (call $write_ctx
          (global.get $CTX_PENDING_POINTER)
          (local.get $stack_base))
        (return
          (i32.add
            (i32.const 1)
            (call $throw_type_error_with_message
              (global.get $BUILTIN_MSG_NOT_AN_OBJECT))))))
    (local.set $name_identifier
      (call $value_data_lo (local.get $argument)))
    (call $write_ctx
      (global.get $CTX_PENDING_POINTER)
      (local.get $stack_base))
    (if (call $check_heap_overflow
          (i32.add
            (call $estimate_arraybuffer_size (i32.const 40))
            (i32.const 24)))
      (then (return (i32.const 0))))
    (local.set $handle
      (call $proof_native_allocate_term_handle
        (i32.const 40)
        (i32.const 16)
        (i32.const 0)))
    (local.set $artifact_base
      (call $proof_native_handle_artifact_base (local.get $handle)))
    (call $proof_native_initialize_artifact_header
      (local.get $artifact_base)
      (i32.const 40)
      (i32.const 28))
    (call $proof_store
      (local.get $artifact_base)
      (i32.const 16)
      (i32.const 3))
    (call $proof_store
      (local.get $artifact_base)
      (i32.const 20)
      (global.get $PROOF_TERM_NAMED_LOCAL))
    (call $proof_store
      (local.get $artifact_base)
      (i32.const 24)
      (local.get $name_identifier))
    (call $proof_native_write_empty_declarations
      (local.get $artifact_base)
      (i32.const 28))
    (call $proof_native_push_term (local.get $handle))
    (i32.const 0)
  )

  (func $proof_native_named_binary_term_method
    (param $tag i32)
    (param $argument_count i32)
    (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $name_argument i32)
    (local $type_argument i32)
    (local $body_argument i32)
    (local $name_identifier i32)
    (local $type_handle i32)
    (local $body_handle i32)
    (local $handle i32)
    (local $artifact_base i32)
    (local $root_reference i32)
    (local.set $pending_pointer
      (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.lt_u (local.get $argument_count) (i32.const 3))
      (then
        (call $write_ctx
          (global.get $CTX_PENDING_POINTER)
          (local.get $stack_base))
        (return
          (i32.add
            (i32.const 1)
            (call $throw_type_error_with_message
              (global.get $BUILTIN_MSG_MISSING_ARGUMENT))))))
    (local.set $name_argument
      (i32.sub
        (local.get $pending_pointer)
        (i32.mul
          (local.get $argument_count)
          (global.get $VALUE_SIZE))))
    (local.set $type_argument
      (i32.add
        (local.get $name_argument)
        (global.get $VALUE_SIZE)))
    (local.set $body_argument
      (i32.add
        (local.get $type_argument)
        (global.get $VALUE_SIZE)))
    (if (i32.ne
          (call $value_type (local.get $name_argument))
          (global.get $TYPE_STRING))
      (then
        (call $write_ctx
          (global.get $CTX_PENDING_POINTER)
          (local.get $stack_base))
        (return
          (i32.add
            (i32.const 1)
            (call $throw_type_error_with_message
              (global.get $BUILTIN_MSG_NOT_AN_OBJECT))))))
    (local.set $name_identifier
      (call $value_data_lo (local.get $name_argument)))
    (if (i32.or
          (i32.ne
            (call $value_type (local.get $type_argument))
            (global.get $TYPE_THEOREM))
          (i32.ne
            (call $value_type (local.get $body_argument))
            (global.get $TYPE_THEOREM)))
      (then
        (call $write_ctx
          (global.get $CTX_PENDING_POINTER)
          (local.get $stack_base))
        (return
          (i32.add
            (i32.const 1)
            (call $throw_type_error_with_message
              (global.get $BUILTIN_MSG_NOT_AN_OBJECT))))))
    (local.set $type_handle
      (call $value_data_lo (local.get $type_argument)))
    (local.set $body_handle
      (call $value_data_lo (local.get $body_argument)))
    (if (i32.or
          (i32.eqz
            (call $proof_native_term_handle_valid
              (local.get $type_handle)))
          (i32.eqz
            (call $proof_native_term_handle_valid
              (local.get $body_handle))))
      (then
        (call $write_ctx
          (global.get $CTX_PENDING_POINTER)
          (local.get $stack_base))
        (return
          (i32.add
            (i32.const 1)
            (call $throw_type_error_with_message
              (global.get $BUILTIN_MSG_NOT_AN_OBJECT))))))
    (if (call $check_heap_overflow
          (call $proof_native_composition_allocation_size
            (local.get $type_handle) (local.get $body_handle)
            (i32.const 0) (i32.const 0)))
      (then (return (i32.const 0))))
    (local.set $handle
      (call $proof_native_compose_binary_term
        (local.get $tag)
        (i32.const 0)
        (i32.const 0)
        (local.get $type_handle)
        (local.get $body_handle)
        (i32.const 0)))
    (call $write_ctx
      (global.get $CTX_PENDING_POINTER)
      (local.get $stack_base))
    (if (i32.lt_s (local.get $handle) (i32.const 0))
      (then
        (return
          (i32.add
            (i32.const 1)
            (call $throw_type_error_with_message
              (global.get $BUILTIN_MSG_INVALID_INDEX))))))
    (local.set $artifact_base
      (call $proof_native_handle_artifact_base (local.get $handle)))
    (local.set $root_reference
      (call $proof_native_handle_root (local.get $handle)))
    (drop
      (call $proof_native_resolve_named_local
        (local.get $artifact_base)
        (call $proof_load
          (local.get $artifact_base)
          (i32.add (local.get $root_reference) (i32.const 12)))
        (local.get $name_identifier)
        (i32.const 0)))
    (call $proof_native_push_term (local.get $handle))
    (i32.const 0)
  )

  (func $proof_native_term_named_product
