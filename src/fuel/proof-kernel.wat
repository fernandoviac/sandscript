    (local.get $arguments_array) (local.get $work)))
  (func $proof_substitute_universe
    (param $artifact_base i32) (param $universe_reference i32) (param $arguments_array i32) (param $work i32) (result i32)
    (local $memo i32) (local $value i32)
    (if (i32.eqz (call $proof_work_debit (local.get $artifact_base) (local.get $work)))
      (then (return (i32.const 0))))
    (local.set $value (call $proof_substitute_universe_leaf (local.get $artifact_base)
      (local.get $universe_reference) (local.get $arguments_array) (local.get $work)))
    (if (i32.ge_s (local.get $value) (i32.const 0)) (then (return (local.get $value))))
    (local.set $memo (call $proof_make_array (local.get $artifact_base) (i32.const 1)))
    (if (i32.eqz (local.get $memo)) (then (return (i32.const 0))))
    (call $proof_array_set (local.get $artifact_base) (local.get $memo) (i32.const 0) (i32.const 0))
    (call $proof_substitute_universe_memo (local.get $artifact_base) (local.get $universe_reference) (local.get $arguments_array) (local.get $work) (local.get $memo)))

