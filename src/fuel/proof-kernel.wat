    (call $proof_store
      (local.get $artifact_base)
      (i32.add (local.get $match) (i32.const 8))
      (local.get $scrutinee))
    (call $proof_store
      (local.get $artifact_base)
      (i32.add (local.get $match) (i32.const 12))
      (local.get $motive))
    (call $proof_store
