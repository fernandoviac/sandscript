          (local.get $argument_count)
          (global.get $VALUE_SIZE))))
    (local.set $second_argument
      (i32.add (local.get $first_argument) (global.get $VALUE_SIZE)))
    (local.set $third_argument
      (i32.add (local.get $second_argument) (global.get $VALUE_SIZE)))
    (if (i32.or
          (i32.ne
            (call $value_type (local.get $first_argument))
            (global.get $TYPE_THEOREM))
          (i32.ne
            (call $value_type (local.get $second_argument))
            (global.get $TYPE_THEOREM)))
      (then
        (call $write_ctx
          (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
        (return
          (i32.add
            (i32.const 1)
            (call $throw_type_error_with_message
              (global.get $BUILTIN_MSG_NOT_AN_OBJECT))))))
    (local.set $left_handle
      (call $value_data_lo (local.get $first_argument)))
    (local.set $right_handle
      (call $value_data_lo (local.get $second_argument)))
    (if (i32.or
          (i32.eqz
            (call $proof_native_term_handle_valid
              (local.get $left_handle)))
