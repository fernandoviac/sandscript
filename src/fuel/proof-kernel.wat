    (if (i32.eqz (local.get $t23)) (then (return (i32.const 0))))
    (local.set $t24 (call $proof_make_two (local.get $b) (i32.const 6) (local.get $t5) (local.get $t23)))
    (if (i32.eqz (local.get $t24)) (then (return (i32.const 0))))
