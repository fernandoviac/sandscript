        (local.set $cursor
          (call $proof_render_term
            (local.get $artifact_base)
            (call $proof_array_get
              (local.get $artifact_base)
              (local.get $values_array)
              (local.get $index))
            (local.get $depth) (local.get $cursor) (local.get $limit)))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $pairs_next)))
    (call $proof_render_byte
      (local.get $cursor) (local.get $limit) (i32.const 125))
  )

  (func $proof_native_term_render
    (param $receiver_type i32) (param $receiver_pointer i32)
    (param $method_identifier i32) (param $argument_count i32)
    (param $stack_base i32)
    (result i32)
    (local $pending_pointer i32)
    (local $argument i32)
    (local $handle i32)
    (local $artifact_base i32)
    (local $data_pointer i32)
    (local $limit i32)
    (local $cursor i32)
    (local.set $pending_pointer
      (call $read_ctx (global.get $CTX_PENDING_POINTER)))
    (if (i32.lt_u (local.get $argument_count) (i32.const 1))
      (then
        (call $write_ctx
          (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
        (return
          (i32.add
            (i32.const 1)
            (call $throw_type_error_with_message
              (global.get $BUILTIN_MSG_MISSING_ARGUMENT))))))
    (local.set $argument
      (i32.sub
        (local.get $pending_pointer)
        (i32.mul
          (local.get $argument_count)
          (global.get $VALUE_SIZE))))
    (if (i32.ne
          (call $value_type (local.get $argument))
          (global.get $TYPE_THEOREM))
      (then
        (call $write_ctx
          (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
        (return
          (i32.add
            (i32.const 1)
            (call $throw_type_error_with_message
              (global.get $BUILTIN_MSG_NOT_AN_OBJECT))))))
    (local.set $handle (call $value_data_lo (local.get $argument)))
    (if (i32.eqz
          (i32.or
            (call $proof_native_term_handle_valid (local.get $handle))
            (call $proof_native_sequence_handle_valid (local.get $handle))))
      (then
        (call $write_ctx
          (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
        (return
          (i32.add
            (i32.const 1)
            (call $throw_type_error_with_message
              (global.get $BUILTIN_MSG_NOT_AN_OBJECT))))))
    (if (call $check_concat_scratch_overflow (i32.const 65536))
      (then
        (call $write_ctx
          (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
        (return (i32.const 0))))
    (local.set $artifact_base
      (call $proof_native_handle_artifact_base (local.get $handle)))
    (local.set $data_pointer (call $read_state (global.get $STATE_HEAP_POINTER)))
    (local.set $limit (i32.add (local.get $data_pointer) (i32.const 65520)))
    (local.set $cursor
      (call $proof_render_term
        (local.get $artifact_base)
        (call $proof_native_handle_root (local.get $handle))
        (i32.const 0)
        (local.get $data_pointer)
        (local.get $limit)))
    (if (i32.ge_u (local.get $cursor) (local.get $limit))
      (then
        (local.set $cursor
          (call $proof_render_packed
            (local.get $cursor)
            (i32.add (local.get $limit) (i32.const 16))
            (i32.const 0x00a680e2) (i32.const 3)))))
    (call $write_ctx
      (global.get $CTX_PENDING_POINTER) (local.get $stack_base))
    (call $pending_push
      (global.get $TYPE_STRING) (i32.const 0)
      (call $intern_string
        (call $abs (local.get $data_pointer))
        (i32.sub (local.get $cursor) (local.get $data_pointer)))
      (i32.const 0))
    (i32.const 0)
  )

  ;; ==========================================================================
  ;; Interactive proof states (Slice 3, item 1). A proof state is an
  ;; immutable artifact behind PROOF_HANDLE_PROOF_STATE. The handle root is
  ;; an array [root target, goals array]; the goals array holds one GOAL
  ;; record per goal in creation order. Every tactic composes a fresh
  ;; artifact and publishes through the compactor in state mode, so a failed
  ;; tactic leaves the input state untouched.
  ;; ==========================================================================
  (func $proof_native_state_handle_valid
    (param $handle i32)
    (result i32)
    (call $proof_native_handle_valid_kind
      (local.get $handle)
      (global.get $PROOF_HANDLE_PROOF_STATE))
  )

  (func $proof_state_goals_array
    (param $artifact_base i32)
    (param $state_root i32)
    (result i32)
    (call $proof_array_get
      (local.get $artifact_base) (local.get $state_root) (i32.const 1))
  )

  (func $proof_state_root_target
    (param $artifact_base i32)
    (param $state_root i32)
    (result i32)
    (call $proof_array_get
      (local.get $artifact_base) (local.get $state_root) (i32.const 0))
  )

  ;; Reference of the open goal with the given zero-based index, or zero.
  (func $proof_state_open_goal
    (param $artifact_base i32)
    (param $goals_array i32)
    (param $open_index i32)
    (result i32)
    (local $count i32)
    (local $index i32)
    (local $goal i32)
    (local.set $count
      (call $proof_array_count
        (local.get $artifact_base) (local.get $goals_array)))
    (block $done
      (loop $next
        (br_if $done (i32.ge_u (local.get $index) (local.get $count)))
        (local.set $goal
          (call $proof_array_get
            (local.get $artifact_base)
            (local.get $goals_array)
            (local.get $index)))
        (if (i32.eqz
              (call $proof_load
                (local.get $artifact_base)
                (i32.add (local.get $goal) (i32.const 24))))
          (then
            (if (i32.eqz (local.get $open_index))
              (then (return (local.get $goal))))
            (local.set $open_index
              (i32.sub (local.get $open_index) (i32.const 1)))))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $next)))
    (i32.const 0)
  )

  (func $proof_state_open_goal_count
    (param $artifact_base i32)
    (param $goals_array i32)
    (result i32)
    (local $count i32)
    (local $index i32)
    (local $open i32)
    (local.set $count
      (call $proof_array_count
        (local.get $artifact_base) (local.get $goals_array)))
    (block $done
      (loop $next
        (br_if $done (i32.ge_u (local.get $index) (local.get $count)))
        (if (i32.eqz
              (call $proof_load
                (local.get $artifact_base)
                (i32.add
                  (call $proof_array_get
                    (local.get $artifact_base)
                    (local.get $goals_array)
                    (local.get $index))
                  (i32.const 24))))
          (then (local.set $open (i32.add (local.get $open) (i32.const 1)))))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $next)))
    (local.get $open)
  )

  (func $proof_state_next_metavariable
    (param $artifact_base i32)
    (param $goals_array i32)
    (result i32)
    (local $count i32)
    (local $index i32)
    (local $identifier i32)
    (local $maximum i32)
    (local.set $count
      (call $proof_array_count
        (local.get $artifact_base) (local.get $goals_array)))
    (block $done
      (loop $next
        (br_if $done (i32.ge_u (local.get $index) (local.get $count)))
        (local.set $identifier
          (call $proof_load
            (local.get $artifact_base)
            (i32.add
              (call $proof_array_get
                (local.get $artifact_base)
                (local.get $goals_array)
                (local.get $index))
              (i32.const 8))))
        (if (i32.gt_u (local.get $identifier) (local.get $maximum))
          (then (local.set $maximum (local.get $identifier))))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $next)))
    (i32.add (local.get $maximum) (i32.const 1))
  )

  (func $proof_state_make_goal
    (param $artifact_base i32)
    (param $metavariable_identifier i32)
    (param $context_array i32)
    (param $target_reference i32)
    (param $parent_identifier i32)
    (param $solution_reference i32)
    (result i32)
    (local $goal i32)
    (local.set $goal
      (call $proof_allocate_record
        (local.get $artifact_base) (i32.const 7)
        (global.get $PROOF_RECORD_GOAL)))
    (if (i32.eqz (local.get $goal)) (then (return (i32.const 0))))
    (call $proof_store
      (local.get $artifact_base)
      (i32.add (local.get $goal) (i32.const 8))
      (local.get $metavariable_identifier))
    (call $proof_store
      (local.get $artifact_base)
      (i32.add (local.get $goal) (i32.const 12))
      (local.get $context_array))
    (call $proof_store
      (local.get $artifact_base)
      (i32.add (local.get $goal) (i32.const 16))
      (local.get $target_reference))
    (call $proof_store
      (local.get $artifact_base)
      (i32.add (local.get $goal) (i32.const 20))
      (local.get $parent_identifier))
    (call $proof_store
      (local.get $artifact_base)
      (i32.add (local.get $goal) (i32.const 24))
      (local.get $solution_reference))
    (local.get $goal)
  )

  ;; Rebuild the goals array with one goal replaced by an updated copy and
  ;; the goals of an optional appended array. Returns the new state root.
  (func $proof_state_rebuild_root
    (param $artifact_base i32)
    (param $state_root i32)
    (param $replaced_goal i32)
    (param $replacement_goal i32)
    (param $appended_array i32)
    (result i32)
    (local $goals_array i32)
    (local $count i32)
    (local $appended_count i32)
    (local $new_goals i32)
    (local $new_root i32)
    (local $index i32)
    (local $entry i32)
    (local.set $goals_array
      (call $proof_state_goals_array
        (local.get $artifact_base) (local.get $state_root)))
    (local.set $count
      (call $proof_array_count
        (local.get $artifact_base) (local.get $goals_array)))
    (if (local.get $appended_array)
      (then
        (local.set $appended_count
          (call $proof_array_count
            (local.get $artifact_base) (local.get $appended_array)))))
    (local.set $new_goals
      (call $proof_make_array
        (local.get $artifact_base)
        (i32.add (local.get $count) (local.get $appended_count))))
    (if (i32.eqz (local.get $new_goals)) (then (return (i32.const 0))))
    (block $copy_done
      (loop $copy_next
        (br_if $copy_done (i32.ge_u (local.get $index) (local.get $count)))
        (local.set $entry
          (call $proof_array_get
            (local.get $artifact_base)
            (local.get $goals_array)
            (local.get $index)))
        (if (i32.eq (local.get $entry) (local.get $replaced_goal))
          (then (local.set $entry (local.get $replacement_goal))))
        (call $proof_array_set
          (local.get $artifact_base)
          (local.get $new_goals)
          (local.get $index)
          (local.get $entry))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $copy_next)))
    (local.set $index (i32.const 0))
    (block $append_done
      (loop $append_next
        (br_if $append_done
          (i32.ge_u (local.get $index) (local.get $appended_count)))
        (call $proof_array_set
          (local.get $artifact_base)
          (local.get $new_goals)
          (i32.add (local.get $count) (local.get $index))
          (call $proof_array_get
            (local.get $artifact_base)
            (local.get $appended_array)
            (local.get $index)))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $append_next)))
    (local.set $new_root
      (call $proof_make_array (local.get $artifact_base) (i32.const 2)))
    (if (i32.eqz (local.get $new_root)) (then (return (i32.const 0))))
    (call $proof_array_set
      (local.get $artifact_base)
      (local.get $new_root)
      (i32.const 0)
      (call $proof_state_root_target
        (local.get $artifact_base) (local.get $state_root)))
    (call $proof_array_set
      (local.get $artifact_base)
      (local.get $new_root)
      (i32.const 1)
      (local.get $new_goals))
    (local.get $new_root)
  )

  ;; Compact a state root in state mode and return the state handle, or a
  ;; negative code.
  

  ;; Follow solved-metavariable evidence to the ordinary term beneath it.
  (func $proof_state_dereference_solved
    (param $artifact_base i32)
    (param $reference i32)
    (result i32)
    (block $done
      (loop $next
        (br_if $done
          (i32.ne
            (call $proof_load
              (local.get $artifact_base)
              (i32.add (local.get $reference) (i32.const 4)))
            (global.get $PROOF_RECORD_SOLVED_METAVARIABLE)))
        (local.set $reference
          (call $proof_load
            (local.get $artifact_base)
            (i32.add (local.get $reference) (i32.const 16))))
        (br $next)))
    (local.get $reference)
  )
  ;; Substitute every argument hole of one apply chain into a term.
  ;; Unification rewrites chain argument fields with solutions, so the
  ;; chain argument is the authority: it is the solution when the hole is
  ;; solved and the original hole record when it is open. Returns the
  ;; substituted reference or zero.
  (func $proof_state_substitute_holes
    (param $artifact_base i32)
    (param $reference i32)
    (param $chain i32)
    (param $first_identifier i32)
    (param $arity i32)
    (result i32)
    (local $tag i32)
    (local $walk_n i32) (local $walk_i i32) (local $walk_x i32) (local $walk_y i32) (local $walk_out i32)
    (local $identifier i32)
    (local.set $reference
      (call $proof_state_dereference_solved
        (local.get $artifact_base) (local.get $reference)))
    (if (i32.eqz (local.get $reference)) (then (return (i32.const 0))))
    (local.set $tag
      (call $proof_load
        (local.get $artifact_base)
        (i32.add (local.get $reference) (i32.const 4))))
    (if (i32.eq (local.get $tag) (global.get $PROOF_TERM_METAVARIABLE))
      (then
        (local.set $identifier
          (call $proof_load
            (local.get $artifact_base)
            (i32.add (local.get $reference) (i32.const 8))))
        (if (i32.and
              (i32.ge_u (local.get $identifier) (local.get $first_identifier))
              (i32.lt_u
                (local.get $identifier)
                (i32.add (local.get $first_identifier) (local.get $arity))))
          (then
            (return
              (call $proof_state_dereference_solved
                (local.get $artifact_base)
                (call $proof_application_argument
                  (local.get $artifact_base)
                  (local.get $chain)
                  (i32.sub
                    (local.get $identifier)
                    (local.get $first_identifier)))))))
        (return (local.get $reference))))
    (if (i32.or (i32.eq (local.get $tag) (global.get $PROOF_TERM_NAT_LITERAL))
      (i32.eq (local.get $tag) (global.get $PROOF_TERM_STRING_LITERAL)))
      (then (return (local.get $reference))))
    (local.set $walk_n (call $proof_load (local.get $artifact_base) (local.get $reference)))
    (local.set $walk_out (local.get $reference))
    (local.set $walk_i (i32.const 8))
    (block $walk_done (loop $walk_next
      (br_if $walk_done (i32.ge_u (local.get $walk_i) (i32.mul (local.get $walk_n) (i32.const 4))))
      (if (call $proof_term_child (local.get $tag) (local.get $walk_i)) (then
        (local.set $walk_x (call $proof_load (local.get $artifact_base) (i32.add (local.get $reference) (local.get $walk_i))))
        (if (local.get $walk_x) (then
          (local.set $walk_y (call $proof_state_substitute_holes (local.get $artifact_base) (local.get $walk_x) (local.get $chain) (local.get $first_identifier) (local.get $arity)))
          (if (i32.eqz (local.get $walk_y)) (then (return (i32.const 0))))
          (if (i32.ne (local.get $walk_x) (local.get $walk_y)) (then
            (if (i32.eq (local.get $walk_out) (local.get $reference)) (then
              (local.set $walk_out (call $proof_allocate_record (local.get $artifact_base) (local.get $walk_n) (local.get $tag)))
              (if (i32.eqz (local.get $walk_out)) (then (return (i32.const 0))))
              (call $proof_copy_bytes (local.get $artifact_base) (i32.add (local.get $walk_out) (i32.const 8))
                (i32.add (local.get $reference) (i32.const 8)) (i32.sub (i32.mul (local.get $walk_n) (i32.const 4)) (i32.const 8)))))
            (call $proof_store (local.get $artifact_base) (i32.add (local.get $walk_out) (local.get $walk_i)) (local.get $walk_y))))))))
      (local.set $walk_i (i32.add (local.get $walk_i) (i32.const 4)))
      (br $walk_next)))
    (local.get $walk_out)
  )

  ;; Build the checking context object for a goal from its stored telescope.
  ;; The telescope stores the innermost hypothesis at index zero, which is
  ;; the same convention the checker context uses, so the array is usable
  ;; directly.
  (func $proof_state_goal_context
    (param $artifact_base i32)
    (param $goal i32)
    (result i32)
    (call $proof_load
      (local.get $artifact_base)
      (i32.add (local.get $goal) (i32.const 12)))
  )

  ;; Replace every metavariable record in a solution graph with the solution
  ;; of the goal that owns it. Returns the resolved reference or zero.
  (func $proof_state_resolve_term
    (param $artifact_base i32)
    (param $reference i32)
    (param $goals_array i32)
    (result i32)
    (local $tag i32)
    (local $walk_n i32) (local $walk_i i32) (local $walk_x i32) (local $walk_y i32) (local $walk_out i32)
    (local $count i32)
    (local $index i32)
    (local $goal i32)
    (local $identifier i32)
    (local $entry i32)
    (if (i32.eqz (local.get $reference)) (then (return (i32.const 0))))
    (local.set $tag
      (call $proof_load
        (local.get $artifact_base)
        (i32.add (local.get $reference) (i32.const 4))))
    ;; Unification retags a solved hole in place; follow its evidence.
    (if (i32.eq
          (local.get $tag)
          (global.get $PROOF_RECORD_SOLVED_METAVARIABLE))
      (then
        (return
          (call $proof_state_resolve_term
            (local.get $artifact_base)
            (call $proof_load
              (local.get $artifact_base)
              (i32.add (local.get $reference) (i32.const 16)))
            (local.get $goals_array)))))
    (if (i32.eq (local.get $tag) (global.get $PROOF_TERM_METAVARIABLE))
      (then
        (local.set $identifier
          (call $proof_load
            (local.get $artifact_base)
            (i32.add (local.get $reference) (i32.const 8))))
        (local.set $count
          (call $proof_array_count
            (local.get $artifact_base) (local.get $goals_array)))
        (block $goal_found
          (loop $goal_next
            (br_if $goal_found (i32.ge_u (local.get $index) (local.get $count)))
            (local.set $goal
              (call $proof_array_get
                (local.get $artifact_base)
                (local.get $goals_array)
                (local.get $index)))
            (if (i32.eq
                  (call $proof_load
                    (local.get $artifact_base)
                    (i32.add (local.get $goal) (i32.const 8)))
                  (local.get $identifier))
              (then
                (local.set $entry
                  (call $proof_state_resolve_term
                    (local.get $artifact_base)
                    (call $proof_load
                      (local.get $artifact_base)
                      (i32.add (local.get $goal) (i32.const 24)))
                    (local.get $goals_array)))
                (if (i32.eqz (local.get $entry))
                  (then (return (i32.const 0))))
                (return
                  (call $proof_state_derived_scope
                    (local.get $artifact_base)
                    (local.get $entry)
                    (call $proof_load
                      (local.get $artifact_base)
                      (i32.add (local.get $reference) (i32.const 12)))))))
            (local.set $index (i32.add (local.get $index) (i32.const 1)))
            (br $goal_next)))
        (return (i32.const 0))))
    (if (i32.or (i32.eq (local.get $tag) (global.get $PROOF_TERM_NAT_LITERAL))
      (i32.eq (local.get $tag) (global.get $PROOF_TERM_STRING_LITERAL)))
      (then (return (local.get $reference))))
    (local.set $walk_n (call $proof_load (local.get $artifact_base) (local.get $reference)))
    (local.set $walk_out (local.get $reference))
    (local.set $walk_i (i32.const 8))
    (block $walk_done (loop $walk_next
      (br_if $walk_done (i32.ge_u (local.get $walk_i) (i32.mul (local.get $walk_n) (i32.const 4))))
      (if (call $proof_term_child (local.get $tag) (local.get $walk_i)) (then
        (local.set $walk_x (call $proof_load (local.get $artifact_base) (i32.add (local.get $reference) (local.get $walk_i))))
        (if (local.get $walk_x) (then
          (local.set $walk_y (call $proof_state_resolve_term (local.get $artifact_base) (local.get $walk_x) (local.get $goals_array)))
          (if (i32.eqz (local.get $walk_y)) (then (return (i32.const 0))))
          (if (i32.ne (local.get $walk_x) (local.get $walk_y)) (then
            (if (i32.eq (local.get $walk_out) (local.get $reference)) (then
              (local.set $walk_out (call $proof_allocate_record (local.get $artifact_base) (local.get $walk_n) (local.get $tag)))
              (if (i32.eqz (local.get $walk_out)) (then (return (i32.const 0))))
              (call $proof_copy_bytes (local.get $artifact_base) (i32.add (local.get $walk_out) (i32.const 8))
                (i32.add (local.get $reference) (i32.const 8)) (i32.sub (i32.mul (local.get $walk_n) (i32.const 4)) (i32.const 8)))))
            (call $proof_store (local.get $artifact_base) (i32.add (local.get $walk_out) (local.get $walk_i)) (local.get $walk_y))))))))
      (local.set $walk_i (i32.add (local.get $walk_i) (i32.const 4)))
      (br $walk_next)))
    (local.get $walk_out)
  )

  ;; Shared argument frame for every state method: state handle plus goal
  ;; index. Returns the state handle or -1 after throwing preparation.
  (func $proof_native_state_arguments
    (param $argument i32)
    (param $argument_count i32)
    (result i32)
    (local $handle i32)
    (if (i32.lt_u (local.get $argument_count) (i32.const 1))
      (then (return (i32.const -1))))
    (if (i32.ne
          (call $value_type (local.get $argument))
          (global.get $TYPE_THEOREM))
      (then (return (i32.const -1))))
    (local.set $handle (call $value_data_lo (local.get $argument)))
