  (global $KW_EXCLUSIVE_MAXIMUM i32 (i32.const 19))
  (global $KW_MINIMUM i32 (i32.const 20))
  (global $KW_EXCLUSIVE_MINIMUM i32 (i32.const 21))
  (global $KW_MAX_LENGTH i32 (i32.const 22))
