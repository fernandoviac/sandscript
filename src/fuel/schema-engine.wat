        (local.set $cur (call $mpw_key (local.get $out) (local.get $cap) (local.get $cur) (local.get $keys) (i32.const 164) (i32.const 1)))
        (if (i32.lt_s (local.get $cur) (i32.const 0)) (then (return (i32.const -1))))
