  (global $OP_EXCLUSIVE_MINIMUM i32 (i32.const 7))
  (global $OP_EXCLUSIVE_MAXIMUM i32 (i32.const 8))
  (global $OP_MULTIPLE_OF i32 (i32.const 9))
  (global $OP_MIN_LENGTH i32 (i32.const 10))
  (global $OP_MAX_LENGTH i32 (i32.const 11))
