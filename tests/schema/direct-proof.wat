      (call $check (i32.eq (global.get $outlen) (i32.load offset=8 (i32.add (local.get $data) (local.get $at)))) (i32.const 552))
      (call $check (call $same (global.get $out) (i32.add (i32.add (local.get $data) (local.get $at)) (i32.const 12)) (global.get $outlen)) (i32.const 553))
      (call $check (i32.eq (i32.load8_u (i32.add (global.get $out) (global.get $outlen))) (i32.const 165)) (i32.const 554))
      (global.set $last_work (i64.add (global.get $last_work) (local.get $charged)))
      (local.set $at (i32.add (local.get $at) (i32.const 48))) (br $numbers)))
    (memory.fill (global.get $out) (i32.const 165) (i32.const 32))
    (memory.fill (global.get $s) (i32.const 165) (i32.const 864))
    (call $format_number (f64.const -4.9406564584124654e-324) (global.get $out) (i32.const 31) (global.get $s) (i32.const 864))
    (local.set $overflow) (local.set $charged) (global.set $outlen) (global.set $status)
    (call $expect (i32.const 7))
    (call $check (i32.and (i32.eqz (global.get $outlen)) (i64.eqz (local.get $charged))) (i32.const 555))
    (call $check (i32.eq (i32.load8_u (global.get $s)) (i32.const 165)) (i32.const 556))
    (call $check (i32.eq (i32.load8_u (global.get $out)) (i32.const 165)) (i32.const 557))
    (call $format_number (f64.const 1) (global.get $s) (i32.const 32) (global.get $s) (i32.const 864))
    (local.set $overflow) (local.set $charged) (global.set $outlen) (global.set $status)
    (call $expect (i32.const 12))
    (call $check (i32.and (i32.eqz (global.get $outlen)) (i64.eqz (local.get $charged))) (i32.const 558))
    (call $check (i32.eq (i32.load8_u (global.get $s)) (i32.const 165)) (i32.const 559)))

  (func $number_conversion_case (param $hex i32)
    (local $data i32) (local $size i32) (local $at i32) (local $p i32)
    (local $length i32) (local $charged i64) (local $overflow i32) (local $value f64) (local $expected f64)
    (local.set $data (call $fixture (select (global.get $F_numberHex) (global.get $F_numberParse) (local.get $hex))))
    (local.set $size (call $fixture_size (select (global.get $F_numberHex) (global.get $F_numberParse) (local.get $hex))))
    (global.set $s (call $alloc (i32.const 320)))
    (global.set $last_work (i64.const 0))
    (block $done (loop $records
      (br_if $done (i32.ge_u (local.get $at) (local.get $size)))
      (local.set $p (i32.add (local.get $data) (local.get $at)))
      (local.set $length (i32.load offset=4 (local.get $p)))
      (local.set $expected (f64.load offset=8 (local.get $p)))
      (memory.fill (global.get $s) (i32.const 165) (i32.const 320))
      (if (local.get $hex)
        (then
          (call $format_number_hex (local.get $expected) (global.get $s) (i32.const 320))
          (local.set $overflow) (local.set $charged) (global.set $outlen) (global.set $status)
          (call $check (i32.eq (global.get $outlen) (local.get $length)) (i32.const 560))
          (call $check (call $same (global.get $s) (i32.add (local.get $p) (i32.const 16)) (local.get $length)) (i32.const 561))
          (call $check (i32.eq (i32.load8_u (i32.add (global.get $s) (local.get $length))) (i32.const 165)) (i32.const 562)))
        (else
          (call $parse_number_utf16 (i32.add (local.get $p) (i32.const 16)) (local.get $length) (global.get $s) (i32.const 320))
          (local.set $overflow) (local.set $charged) (local.set $value) (global.set $status)
          (call $check (i32.or
            (i64.eq (i64.reinterpret_f64 (local.get $value)) (i64.reinterpret_f64 (local.get $expected)))
            (i32.and (f64.ne (local.get $value) (local.get $value)) (f64.ne (local.get $expected) (local.get $expected)))) (i32.const 563))))
      (call $expect (i32.const 0))
      (call $check (i32.eqz (local.get $overflow)) (i32.const 564))
      (if (local.get $length) (then (call $check (i64.gt_u (local.get $charged) (i64.const 0)) (i32.const 565))))
      (global.set $last_work (i64.add (global.get $last_work) (local.get $charged)))
      (local.set $at (i32.add (local.get $at) (i32.load (local.get $p)))) (br $records)))
    (memory.fill (global.get $s) (i32.const 165) (i32.const 320))
    (if (local.get $hex)
      (then
        (call $format_number_hex (f64.const 0.1) (global.get $s) (i32.const 319))
        (local.set $overflow) (local.set $charged) (global.set $outlen) (global.set $status)
        (call $expect (i32.const 7)) (call $check (i32.eqz (global.get $outlen)) (i32.const 566)))
      (else
        (call $parse_number_utf16 (global.get $s) (i32.const 1) (global.get $s) (i32.const 320))
        (local.set $overflow) (local.set $charged) (local.set $value) (global.set $status)
        (call $expect (i32.const 12)) (call $check (f64.ne (local.get $value) (local.get $value)) (i32.const 567))))
    (call $check (i64.eqz (local.get $charged)) (i32.const 568))
    (call $check (i32.eqz (local.get $overflow)) (i32.const 569))
    (local.set $at (i32.const 0))
    (block $checked (loop $canaries
      (br_if $checked (i32.eq (local.get $at) (i32.const 320)))
      (call $check (i32.eq (i32.load8_u (i32.add (global.get $s) (local.get $at))) (i32.const 165)) (i32.const 570))
      (local.set $at (i32.add (local.get $at) (i32.const 1))) (br $canaries))))

  (func (export "case_count") (result i32) (i32.const @CASE_COUNT@))
  (func (export "result_pointer") (result i32) (i32.const 1024))
  (func (export "result_size") (result i32) (i32.const 32))
  (func (export "run_case") (param $id i32) (result i32)
    ;; Every invocation starts independent and finishes all its dependencies.
    (global.set $heap (i32.const 4096)) (global.set $limit (i32.const 1073741824))
    (global.set $failure (i32.const 0)) (global.set $status (i32.const 0)) (global.set $expected (i32.const 0))
    (global.set $b (i32.const 0)) (global.set $options (i32.const 0)) (global.set $grant (i32.const 0))
    (global.set $relocate (i32.const 0)) (global.set $arena (i32.const 16384))
    (global.set $errors (i32.const 8))
    (memory.fill (i32.const 1024) (i32.const 0) (i32.const 32))
    (call $scenario (local.get $id))
    (i32.store (i32.const 1024) (local.get $id))
    (i32.store (i32.const 1028) (global.get $status))
    (i32.store (i32.const 1032) (global.get $failure))
    (i32.store (i32.const 1036) (global.get $expected))
    (if (global.get $b) (then
      (i32.store (i32.const 1040) (i32.load offset=32 (global.get $b)))
      (i64.store (i32.const 1048) (call $work))))
    (if (i32.and (i32.ge_u (local.get $id) (i32.const 26)) (i32.le_u (local.get $id) (i32.const 28)))
      (then (i64.store (i32.const 1048) (global.get $last_work))))
    ;; Final lifetime boundary: output record is the ONLY retained owner.
    (memory.fill (i32.const 4096) (i32.const 193) (i32.sub (global.get $heap) (i32.const 4096)))
    (global.set $heap (i32.const 4096))
    (global.get $failure))
)
